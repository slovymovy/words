        "fr-extract.jsonl": [
            {
                "entry_id": "a7145b1b-247c-3bf7-b20f-0d27955c8a97",
                "word": "autan",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "5eab4a62-390f-48db-bdc7-6599039c387d",
                        "entry_id": "a7145b1b-247c-3bf7-b20f-0d27955c8a97",
                        "tags": [
                            "plural"
                        ],
                        "form": "autans"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "36c00636-a7a5-36ab-b676-f9e4045a5cc5",
                        "entry_id": "a7145b1b-247c-3bf7-b20f-0d27955c8a97",
                        "glosses": [
                            "Désigne deux vents violents soufflant sur le Languedoc. L’autan blanc vient du golfe du Lion et l’autan noir vient du Sud-Ouest."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54c6c15f-0e8f-49d8-a5b4-230198cfaaf1",
                                "sense_id": "36c00636-a7a5-36ab-b676-f9e4045a5cc5",
                                "text": "Un vent d’autan."
                            }
                        ]
                    },
                    {
                        "sense_id": "c5839c97-75d2-38ea-b644-fff132c961a5",
                        "entry_id": "a7145b1b-247c-3bf7-b20f-0d27955c8a97",
                        "glosses": [
                            "Vent impétueux."
                        ],
                        "tags": [
                            "poetic"
                        ],
                        "examples": [
                            {
                                "example_id": "960d76a9-e52d-4c2f-b166-7d4b9eec91f4",
                                "sense_id": "c5839c97-75d2-38ea-b644-fff132c961a5",
                                "text": "L’autan furieux. — La fureur des autans."
                            },
                            {
                                "example_id": "a49ea9be-869f-4f43-b54a-532dc76068b1",
                                "sense_id": "c5839c97-75d2-38ea-b644-fff132c961a5",
                                "text": "Mais avant la bise venue,\nAvant que sur la terre nue\nComme un dôme, la sombre nue\nEnchaîne les tristes autans."
                            },
                            {
                                "example_id": "2edbf774-6016-4c56-8a0d-13ae1e6420aa",
                                "sense_id": "c5839c97-75d2-38ea-b644-fff132c961a5",
                                "text": "Le vieux perron croulant parmi l’effroi des lierres,\nNous parlait des autans qui chantaient dans les pierres\nDe la vieille demeure aux grilles familières."
                            },
                            {
                                "example_id": "5ba00405-6927-461f-a212-107602d22371",
                                "sense_id": "c5839c97-75d2-38ea-b644-fff132c961a5",
                                "text": "Leur cliente est une espèce d’amazone en culotte, maigre, avec un visage de jument, boucané par les autans, et des cheveux comme des barbelés."
                            },
                            {
                                "example_id": "95de5889-a8ca-4c36-8b2e-295ec9bf5b54",
                                "sense_id": "c5839c97-75d2-38ea-b644-fff132c961a5",
                                "text": "J'eusse écrit d'amour comme on chante\nSi je savais encor ce chant,\nMais l'air s'en oublie quand il vente.\nEst-ce ma faute si l’autan\nEt les bourrasques d'un printemps\nNe m'en ont laissé que l'andante?..."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ffeba2b4-6322-49e7-b25c-9c19f54c4804",
                        "source_entry_id": "a7145b1b-247c-3bf7-b20f-0d27955c8a97",
                        "target_lang_word": "tempest",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tempest",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7b24c654-0af4-3b98-89b1-06eda42e2df9",
                                        "entry_id": "da63265d-cbdf-313a-966d-c11d82ffe7a0",
                                        "glosses": [
                                            "A storm, especially one with severe winds."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3552a369-816e-4281-8d88-8cb5b1c28475",
                                                "sense_id": "7b24c654-0af4-3b98-89b1-06eda42e2df9",
                                                "text": "For a Tempeſt. Take Eurus, Zephyr, Auſter and Boreas, and caſt them together in one Verſe. Add to theſe of Rain, Lightning, and of Thunder (the loudeſt you can) quantum ſufficit. Mix your Clouds and Billows well together till they foam, and thicken your Deſcription here and there with a Quickſand. Brew your Tempeſt well in your Head, before you ſet it a blowing."
                                            },
                                            {
                                                "example_id": "57c0e3a7-3f5b-4d23-a41b-66d4bd1b405c",
                                                "sense_id": "7b24c654-0af4-3b98-89b1-06eda42e2df9",
                                                "text": "BEAT on, proud billows; Boreas blow; / Swell, curled waves, high as Jove's roof; / Your incivility doth ſhow, / That innocence is tempeſt proof; / Though ſurly Nereus frown, my thoughts are calm; / Then ſtrike, Affliction, for thy wounds are balm. [Attributed to Roger L'Estrange (1616–1704).]"
                                            },
                                            {
                                                "example_id": "2e509b5d-7843-4afa-9864-4a91d5d75f0c",
                                                "sense_id": "7b24c654-0af4-3b98-89b1-06eda42e2df9",
                                                "text": "As every sailor knows, a spicy gale in the tropic latitudes of the Pacific is far different from a tempest in the howling North Atlantic."
                                            },
                                            {
                                                "example_id": "7c05b048-c3dc-41f8-a8e7-046d3a765bec",
                                                "sense_id": "7b24c654-0af4-3b98-89b1-06eda42e2df9",
                                                "text": "The desert storm was riding in its strength; the travellers lay beneath the mastery of the fell simoom.[…]Roaring, leaping, pouncing, the tempest raged about the wanderers, drowning and blotting out their forms with sandy spume."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7a3dfed2-3eb9-350b-b2ca-ee549228a092",
                                        "entry_id": "da63265d-cbdf-313a-966d-c11d82ffe7a0",
                                        "glosses": [
                                            "Any violent tumult or commotion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "adf6c67f-2150-4840-aa45-4829cddb8a26",
                                                "sense_id": "7a3dfed2-3eb9-350b-b2ca-ee549228a092",
                                                "text": "Comforted with these reflections, the tempest of his soul subsided"
                                            },
                                            {
                                                "example_id": "5fe44a0a-adb5-4db0-b0f0-729206918e40",
                                                "sense_id": "7a3dfed2-3eb9-350b-b2ca-ee549228a092",
                                                "text": "They awaited the word \"forward\"—awaited, too, with beating hearts and set teeth the gusts of lead and iron that were to smite them at their first movement in obedience to that word. The word was not given; the tempest did not break out."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2df0ac82-fc46-3d1e-807b-e66081a538d1",
                                        "entry_id": "da63265d-cbdf-313a-966d-c11d82ffe7a0",
                                        "glosses": [
                                            "A fashionable social gathering; a drum."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "tempest",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "88894f6a-1b52-3669-9b9c-457ff92650ea",
                                        "entry_id": "44f9a718-c8c8-3617-ac99-8fd919dc78be",
                                        "glosses": [
                                            "To storm."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "rare"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b234a478-225a-3f67-be8e-3a54b12be0e6",
                                        "entry_id": "44f9a718-c8c8-3617-ac99-8fd919dc78be",
                                        "glosses": [
                                            "To disturb, as by a tempest."
                                        ],
                                        "tags": [
                                            "poetic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "198c61f0-1d29-46e3-807c-573b613d60aa",
                                                "sense_id": "b234a478-225a-3f67-be8e-3a54b12be0e6",
                                                "text": ". . . the seal\nAnd bended dolphins play; part huge of bulk,\nWallowing unwieldy, enormous in their gait,\nTempest the ocean."
                                            },
                                            {
                                                "example_id": "6da86f37-4d74-4d30-bfb9-a0f7b3079a3f",
                                                "sense_id": "b234a478-225a-3f67-be8e-3a54b12be0e6",
                                                "text": "Oh! dark lowered the clouds on that horrible eve,\nAnd the moon dimly gleamed through the tempested air."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
