                "senses": [
                    {
                        "sense_id": "8554b621-f8a2-3885-b50d-1b55907ec1af",
                        "entry_id": "3dd90e7a-df5a-35f8-a6ca-2ad4fda3977e",
                        "glosses": [
                            "muzikant die deel uitmaakt van de rock-'n-roll subcultuur"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fccf1bc1-7515-42d0-965d-c73e1fa52e14",
                                "sense_id": "8554b621-f8a2-3885-b50d-1b55907ec1af",
                                "text": "Neil Young is te zien in een speelfilm. De rocker heeft een rol bemachtigd in de western Paradox. De film gaat volgende maand in première op het festival SXSW in Austin."
                            },
                            {
                                "example_id": "d676a7c1-504e-4f3a-85e7-7a5a4cdb596a",
                                "sense_id": "8554b621-f8a2-3885-b50d-1b55907ec1af",
                                "text": "Jon Bon Jovi heeft naast muziek maken nog een grote passie: het produceren van wijn. Samen met zijn zoon Jesse en de Franse wijnmaker Gérard Bertrand lanceert de rocker aankomende zomer hun roséwijn Diving Into Hampton Water. De wijn gaat 20 euro per fles kosten."
                            },
                            {
                                "example_id": "85c48c81-f6b4-4d29-bf53-fb771f4c9f7b",
                                "sense_id": "8554b621-f8a2-3885-b50d-1b55907ec1af",
                                "text": "Neil Young is een van de grote namen op het affiche van het benefietconcert Light Up The Blues, georganiseerd door Stephen Stills. De oude rockers, die al in de jaren zestig en zeventig samen in Buffalo Springfield en Crosby, Stills, Nash and Young schitterden, delen in april het podium met Sheryl Crow, Burt Bacharach, Judy Collins, Chris Stills, Jack Black en Christina Applegate tijdens een concert in The Dolby Theatre Hollywood."
                            }
                        ]
                    }
