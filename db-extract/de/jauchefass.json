                        "tags": [],
                        "examples": [
                            {
                                "example_id": "690751b3-910a-47ca-88b5-475903d904f2",
                                "sense_id": "f4961d69-2234-3273-96f5-d18a4c649f45",
                                "text": "Das Jauchefass muss befüllt werden."
                            },
                            {
                                "example_id": "1dc2e53e-097c-483d-9ae4-b2892230b215",
                                "sense_id": "f4961d69-2234-3273-96f5-d18a4c649f45",
                                "text": "Früher benutzte man Jauchefässer aus Holz."
                            },
                            {
                                "example_id": "efbdf92a-29e8-4a86-b182-6ea10c2d5646",
                                "sense_id": "f4961d69-2234-3273-96f5-d18a4c649f45",
                                "text": "„Eine Kolonne weiblicher Häftlinge schiebt ein Jauchefass vorbei. Einige sind wie Pferde an die Deichsel vor dem Karren gespannt.“"
                            },
                            {
                                "example_id": "8d0b0c17-0f1f-49c5-bdc3-8a58f207c0d5",
                                "sense_id": "f4961d69-2234-3273-96f5-d18a4c649f45",
                                "text": "„Vor zahlreichen Präfekturen wurden Mistladungen verteilt und Jauchefässer geleert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
