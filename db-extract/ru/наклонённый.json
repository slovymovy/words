                "senses": [
                    {
                        "sense_id": "dd2e3eaa-26de-3304-a69b-5cb8a3351617",
                        "entry_id": "92e2b5a9-0912-3b56-8df9-630e6b1d1fa0",
                        "glosses": [
                            "страд. прич. прош. вр. от наклонить"
                        ],
                        "tags": [
                            "participle"
                        ],
                        "examples": [
                            {
                                "example_id": "f12b9d21-d841-4449-b99e-0279624694b3",
                                "sense_id": "dd2e3eaa-26de-3304-a69b-5cb8a3351617",
                                "text": "Южный скат наклонён к горизонту под углом 30°, а северный идёт гораздо крутее."
                            },
                            {
                                "example_id": "6e21b3f6-2b8d-49b9-8b5e-2eb9aac59e03",
                                "sense_id": "dd2e3eaa-26de-3304-a69b-5cb8a3351617",
                                "text": "Теперь Ять не видел его лица, а видел только могучий торс, наклонённую голову, вытянутые вперёд руки со сжатыми кулаками."
                            }
                        ]
                    },
                    {
                        "sense_id": "381876f0-342e-359e-a378-c7661a5ec879",
