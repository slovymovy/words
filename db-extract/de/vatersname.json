                                        "entry_id": "0e2b084b-2a44-3644-94e7-8674c991937f",
                                        "glosses": [
                                            "Nom de famille officiel indiquant la filiation paternelle."
                                        ],
                                        "tags": [
                                            "Administration"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd13b1c1-1042-4be1-92ed-71c765be22d3",
                                                "sense_id": "8eb639ac-d1d1-3c4c-b82a-17d8da9820f4",
                                                "text": "Le nom patronymique ne doit pas être confondu avec le nom d’usage. Le premier est aussi appelé nom de famille. Il est le nom officiel. »"
                                            }
