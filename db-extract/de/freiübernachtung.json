                "senses": [
                    {
                        "sense_id": "78053cde-d543-3679-9926-bfaa8dcae006",
                        "entry_id": "5ea52765-94fd-3f45-818c-584c6d772dd3",
                        "glosses": [
                            "Aufenthalt zum Schlafen während der Nacht unter freiem Himmel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2571cd4-ca64-4723-8001-048de5400b6a",
                                "sense_id": "78053cde-d543-3679-9926-bfaa8dcae006",
                                "text": "„Die zur Freiübernachtung geeigneten und nachstehend bekannt gemachten Stellen werden durch die Nationalparkverwaltung gekennzeichnet.“"
                            },
                            {
                                "example_id": "21bc7546-d0a4-4471-97d8-02f5e80dda5d",
                                "sense_id": "78053cde-d543-3679-9926-bfaa8dcae006",
                                "text": "„Diese Freiübernachtungsstelle besteht meist aus einem Überhang am Sandsteinfels oder einer Felshöhle, der sogenannten Boofe.“"
                            },
                            {
                                "example_id": "9362bb48-c4b4-4f69-abc7-6365f357c4ac",
                                "sense_id": "78053cde-d543-3679-9926-bfaa8dcae006",
                                "text": "„Die Bergsportkonzeption für den NLP mit den Abschnitten Klettergipfel und -wege (2004) sowie Freiübernachtung (2002) hat sich grundsätzlich bewährt.“"
                            },
                            {
                                "example_id": "16fd25b6-b85b-4918-a173-f9742777b83a",
                                "sense_id": "78053cde-d543-3679-9926-bfaa8dcae006",
                                "text": "„Auch gegenwärtig kommt es zwischen Bergsteigern und der Nationalparkverwaltung regelmäßig zu Konflikten z. B. um das Freischneiden von Klettergipfeln oder die Freiübernachtung am Fels.“"
                            },
                            {
                                "example_id": "1060ba71-167a-485b-961e-877f8c3daa4a",
                                "sense_id": "78053cde-d543-3679-9926-bfaa8dcae006",
                                "text": "„ Die knapp 60 legalen Boofen sind jeweils mit einem Schild als \"Freiübernachtungsstelle\" gekennzeichnet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "79fa4fa0-ef80-3b17-905f-66a2bb2f4ffd",
                        "entry_id": "5ea52765-94fd-3f45-818c-584c6d772dd3",
                        "glosses": [
                            "Übernachtung in einem Übernachtungsbetrieb, ohne dass dafür direkte Kosten anfallen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a0979d35-8978-4763-9163-63ca8bf22e51",
                                "sense_id": "79fa4fa0-ef80-3b17-905f-66a2bb2f4ffd",
                                "text": "Für Gold Crown Club-Mitglieder: Wo brauche ich nur 2000 Punkte, um eine Freiübernachtung zu erhalten?"
                            },
                            {
                                "example_id": "58a10c53-f9f9-4fe0-b048-a9b931a8dce2",
                                "sense_id": "79fa4fa0-ef80-3b17-905f-66a2bb2f4ffd",
                                "text": "Mit dem Nordic Choice Club, der die Hotelketten Clarion, Quality und Comfort umfasst, können bei genügend Übernachtungen in den Mitgliedshotels Freiübernachtungen angesammelt werden."
                            },
                            {
                                "example_id": "abbde7aa-0e41-4380-95ef-cf073d4816f0",
                                "sense_id": "79fa4fa0-ef80-3b17-905f-66a2bb2f4ffd",
                                "text": "Besonders Fluggesellschaften gewähren ihren Kunden Boni auf die erworbenen Flugmeilen in Form von Freiflügen, Freiübernachtungen und anderen Sachleistungen."
                            },
                            {
                                "example_id": "ce53c20b-1b10-4208-88be-1f7732d674a2",
                                "sense_id": "79fa4fa0-ef80-3b17-905f-66a2bb2f4ffd",
                                "text": "Außerdem bin ich als häufiger Kunde Besitzer einer Accor Kunden Karte, mit der man für jeden Aufenthalt Punkte sammelt und nach einiger Zeit so Freiübernachtungen in einem Ibis eigener Wahl erhält."
                            },
                            {
                                "example_id": "9c25ea26-1fef-435d-9ff3-8c69c3d961c1",
                                "sense_id": "79fa4fa0-ef80-3b17-905f-66a2bb2f4ffd",
                                "text": "Ab einer gewissen Zahl von Übernachtungen gibt es Vergünstigungen wie Freiübernachtungen, kostenlose Upgrades in bessere Zimmer oder auch kostenloses Internet."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
