                                    {
                                        "sense_id": "574c621a-7984-301e-bda2-77dd815362a7",
                                        "entry_id": "8fa10497-3a7a-3029-abf6-04bdd1cf66cd",
                                        "glosses": [
                                            "Science qui étudie les sociétés humaines du passé à partir de leurs vestiges matériels, notamment par la fouille, la prospection et l’analyse des sites et des objets."
                                        ],
                                        "tags": [
                                            "Sciences humaines"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2947c049-46fc-4a7b-9a18-cd477ab3b139",
                                                "sense_id": "574c621a-7984-301e-bda2-77dd815362a7",
                                                "text": "L’archéologie et l’anthropologie locales sont coutumières, on le sait, d'une grande sérénité dans l'affirmation. Ledit Poignant ne s'en est pas tenu là : à une portée de fusil du tombeau de Merlin, l'« archidruide », il a retrouvé le tombeau de « son épouse » Viviane !"
                                            },
                                            {
                                                "example_id": "4764bcc2-87bb-48ac-b49a-2b167f0adb2b",
                                                "sense_id": "574c621a-7984-301e-bda2-77dd815362a7",
                                                "text": "Je répondis pour ma mère que je me destinais à l’archéologie.\n« Les vieux murs ! s’écria Mme Poncelet. Quel curieux enfant ! »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
