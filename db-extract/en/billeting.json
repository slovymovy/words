                        ]
                    },
                    {
                        "translation_id": "24bfc1c6-2a56-4b36-aee9-91d7b791b488",
                        "source_entry_id": "d10efb94-e71c-3be5-8f07-934c30a21a48",
                        "source_sense_id": "880ce193-4140-3311-be1d-610bfaacec7e",
                        "source_sense_description": "The lodging of soldiers",
                        "target_lang_word": "cantonnement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cantonnement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "12bf246a-fd57-317d-8f8e-59ae150e15c2",
                                        "entry_id": "1eefb149-a224-3732-ae34-f6f59585ac99",
                                        "glosses": [
                                            "État des troupes cantonnées. ^([1])"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "98599efa-c447-4253-aa2e-1251c1ab1631",
                                                "sense_id": "12bf246a-fd57-317d-8f8e-59ae150e15c2",
                                                "text": "Les troupe badoises commencent ainsi à quitter nos environs pour entrer en cantonnement dans les arrondissements de Saverne et de Wissembourg. Le quartier-général badois a été transféré avant-hier à Brumath."
                                            },
                                            {
                                                "example_id": "87be9342-8174-43f3-8e2a-74abeddfe90f",
                                                "sense_id": "12bf246a-fd57-317d-8f8e-59ae150e15c2",
                                                "text": "En qualité de maréchal des logis, il s’occupait du cantonnement des troupes. Bien entendu, il choisit comme logement, pour lui, la maison de la charmante brune."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "68954e2d-c643-3a96-b7d6-e320866cdde3",
                                        "entry_id": "1eefb149-a224-3732-ae34-f6f59585ac99",
                                        "glosses": [
                                            "Lieu dans lequel les troupes cantonnent. ^([1])"
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "85f52133-4a7f-421d-85fc-3e8fdc20f7d1",
                                                "sense_id": "68954e2d-c643-3a96-b7d6-e320866cdde3",
                                                "text": "Tous nos cantonnements et camps sont bombardés : Virginy, Minaucourt, Wargemoulin sont, de nuit comme de jour, en butte aux tirs de l'artillerie de gros calibre."
                                            },
                                            {
                                                "example_id": "dd0bad48-240e-4c44-ba64-99b925771a33",
                                                "sense_id": "68954e2d-c643-3a96-b7d6-e320866cdde3",
                                                "text": "Fin février est très beau et le 2 mars nous quittons le cantonnement de Marquigny. Nous marchons en arrière-garde du bataillon et, par Louvergny, La Cassine, nous arrivons à l’étape à midi à Chémery-sur-Bar."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "563453a7-e3b6-3ca7-ac72-ab671548cfd8",
                                        "entry_id": "1eefb149-a224-3732-ae34-f6f59585ac99",
                                        "glosses": [
                                            "Espace limité, réservé à certains usages. ^([1])"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8090859c-4867-4a2e-9a33-57a8515ea0c2",
                                                "sense_id": "563453a7-e3b6-3ca7-ac72-ab671548cfd8",
                                                "text": "M. de Wit remarqua enfin, que le Cantonnement des Villes & des Provinces des Pays-Bas était chimérique, parce que l'Etablissement en était impossible, & que quand même le Concours de tous les Accidents qui causent une Révolution dans les Etats & trouveraient dans celle-ci, elle ne pouvait pas durer, par le défaut des Chefs, par la légereté des peuples, par les intérêts de commerce & de Religion contraires à ceux des sept Provinces, & qui les rend presque incompatible dans une même Union, enfin par l'inclinaison de plusieurs villes, qui étant déjà Françaises, se donneraient promptement au Roi de cette Nation"
                                            },
                                            {
                                                "example_id": "565626a4-06a1-4de1-84ed-e7c946c125fe",
                                                "sense_id": "563453a7-e3b6-3ca7-ac72-ab671548cfd8",
                                                "text": "Ils voyent dans notre Traité 50 vaisseaux Russes, qui supposent un transport; & le cantonnement des Moscovites en Livonie, leur fait soupçonner le dessein d’une irruption en Prusse, ou d’un passage par la Pologne à travers la Silesie."
                                            },
                                            {
                                                "example_id": "87ce841e-01c3-4d7d-9556-bfbec131a4de",
                                                "sense_id": "563453a7-e3b6-3ca7-ac72-ab671548cfd8",
                                                "text": "je vais rapporter deux Arrêts rendus tout récemment, qui constatent la Jurisprudence du Conseil, tant pour ce qui a rapport au Cantonnement des Usagers, que pour ce qui concerne les bois à délivrer à ces Usagers."
                                            },
                                            {
                                                "example_id": "c5651d0b-d4b6-41bb-83fc-1fd54c6e5ad6",
                                                "sense_id": "563453a7-e3b6-3ca7-ac72-ab671548cfd8",
                                                "text": "Il a été impossible que dans le partage ou le cantonnement successif qui a été fait entre les Nations, il ne soit pas resté à chacun quelque partie faible, & qu’il n’y ait pas eu quelqu’un qui soit demeuré en grande disproportion de forces vis-à-vis quelques autres, parce que comme ce sont certainement les plus forts qui ont fait les partages, ils ont, comme on nous représente le Lion de la Fable profité de leurs avantages pour se mieux partager, & pour être supérieurs en pouvoir, comme ils l’étaient par le sort des armes."
                                            },
                                            {
                                                "example_id": "42f05af1-e566-424c-b683-2f017180db24",
                                                "sense_id": "563453a7-e3b6-3ca7-ac72-ab671548cfd8",
                                                "text": "Le comte de Bassompierre a demandé le cantonnement, en vertu du nouveau code forestier."
                                            },
                                            {
                                                "example_id": "bcd8a864-d1a7-4a3a-8c4f-193fc944929c",
                                                "sense_id": "563453a7-e3b6-3ca7-ac72-ab671548cfd8",
                                                "text": "Ils se plaignent du résultat vicieux de l'expertise qui a conduit à ce résultat inouï ; savoir, que les propriétaires, qui ont à la fois le sol, la futaie, et les essences chêne, hêtre et fruitiers, obtiennent, cependant, dans le cantonnement ordonné, une part moindre que la commune, qui, cependant, n'a que l'usage du taillis, moins les essences réservées."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b7701ee1-15e7-3ff9-9ff0-4bc29a72784c",
                                        "entry_id": "1eefb149-a224-3732-ae34-f6f59585ac99",
                                        "glosses": [
                                            "Zone délimitée dans laquelle la capture d’espèces marines est soit interdite, soit limitée dans le temps ou réservée à certains engins, en vue d’une meilleure gestion des ressources halieutiques. ^([2])"
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2fbd9c51-daf4-393a-ac4e-7d0b91000395",
                                        "entry_id": "1eefb149-a224-3732-ae34-f6f59585ac99",
                                        "glosses": [
                                            "Limitation des droits d’un créancier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9850ee50-4072-450e-bfc7-63bd33bd4200",
                                                "sense_id": "2fbd9c51-daf4-393a-ac4e-7d0b91000395",
                                                "text": "Par exemple, un cantonnement peut être demandé dans le cas d’un avis à tiers détenteur."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "cantonnement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "19690e77-fc52-3efd-a800-b77ca1267ae2",
                                        "entry_id": "05d74b0e-2042-36db-9c58-7ab0d58e2693",
                                        "glosses": [
                                            "Système de subdivision des voies ferrées en cantons, permettant de garantir l’espacement des trains."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a753626e-44be-4eae-9132-19ae077c1d96",
                                                "sense_id": "19690e77-fc52-3efd-a800-b77ca1267ae2",
                                                "text": "La longueur des cantons varie en fonction de la fréquentation de la voie, de son régime d'exploitation et du système de cantonnement."
                                            }
                                        ]
