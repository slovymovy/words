                    {
                        "translation_id": "3f16dd08-8f2b-45eb-bb48-c8c99939466c",
                        "source_entry_id": "1b798a0d-b61e-378d-b35b-3293fd084815",
                        "source_sense_description": "female given name",
                        "target_lang_word": "Morgane",
