                                        "entry_id": "9007a4ee-6f36-35c6-b24f-237698a40989",
                                        "glosses": [
                                            "According to a procedure; following a procedure."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad44a1aa-c702-4ccc-a14b-408352c0070a",
                                                "sense_id": "b921a3a8-9b1e-3d9d-9668-0c227aab1fbf",
                                                "text": "The Supreme Court of Georgia held petitioner's equal protection claim procedurally barred as untimely under Georgia law, and we are now called upon to review the adequacy of the State's procedural rule to bar consideration of the constitutional issue raised. We reverse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6941d94b-b96b-39ef-9a1c-835aa2828878",
                                        "entry_id": "9007a4ee-6f36-35c6-b24f-237698a40989",
                                        "glosses": [
                                            "In a manner that is concerned with procedure."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a93eb537-27a9-417d-93f4-992a937aab86",
                                                "sense_id": "6941d94b-b96b-39ef-9a1c-835aa2828878",
                                                "text": "Near-synonyms: methodically, systematically, technically, techniquewise; see also Thesaurus:methodically"
                                            },
                                            {
                                                "example_id": "133f5978-6fb6-4eb1-a30e-cc4632dc4021",
                                                "sense_id": "6941d94b-b96b-39ef-9a1c-835aa2828878",
                                                "text": "2010, Kostadin Kratchanov, et al., Non-procedural Implementation of Local Heuristic Search in Control Network Programming, conference paper in Rossitza Setchi et al. (editors) Knowledge-Based and Intelligent Information and Engineering Systems, 14th International Conference, KES 2010, Proceedings, Part II, Springer, LNAI 6277,\nWhat actually happens is that the CNP programmer uses the tools for dynamic control to achieve, without procedurally specifying any algorithm, a behavior of the standard interpreter that corresponds to the desired heuristic or other more advanced search strategy."
                                            }
                                        ]
                                    },
