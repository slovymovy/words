                                "target_senses": [
                                    {
                                        "sense_id": "225e1127-534e-3af7-bb4d-f90b8d4e588e",
                                        "entry_id": "c44acb58-f2c4-3391-9956-29499d3fd451",
                                        "glosses": [
                                            "bespeler van een muziekinstrument met een klavier\\nVooral gebruikt in muziekgenres als pop en rock waarin iemand vaak meerdere typen klavierinstrumenten kan bespelen."
                                        ],
                                        "tags": [
                                            "beroep"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "add9fd16-e037-466d-a38a-8fefb55cd5be",
                                                "sense_id": "225e1127-534e-3af7-bb4d-f90b8d4e588e",
                                                "text": "Toen hij twee jaar geleden op reünie-tour was met de „oude mannen van Klein Orkest”, als vervangend toetsenist en enige profmuzikant van het gezelschap, speelden ze in Assen en daar zag hij in een hoekje een exacte kopie van de piano staan, als nieuw."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "458abee7-ea76-4704-9755-1502041511fb",
                        "source_entry_id": "735d148e-c6e2-34f8-9f2f-254892d5c8d6",
                        "source_sense_id": "2eda0e9b-0b98-3c43-ba81-40ee85c13902",
                        "source_sense_description": "musician who plays the keyboard",
                        "target_lang_word": "claviériste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
