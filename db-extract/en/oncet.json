                        "examples": [
                            {
                                "example_id": "05e0bf7a-c44c-4e0e-a386-9beea2856f0b",
                                "sense_id": "23cdf69e-8bb5-3b74-9b6c-caffddd96a06",
                                "text": "If we could see the last of that man, Didenhover, oncet, I'd take hold of the plough myself, and see if I couldn't make a living out of it."
                            },
                            {
                                "example_id": "adb83f79-3dc4-49a6-af64-85db24bcf564",
                                "sense_id": "23cdf69e-8bb5-3b74-9b6c-caffddd96a06",
                                "text": "\"I seen 'im oncet, in the spring, I s'pose,\" said Jim, \"what there was left of 'im."
                            },
                            {
                                "example_id": "e2ca8b87-4a92-4a94-bf52-8c327587991b",
                                "sense_id": "23cdf69e-8bb5-3b74-9b6c-caffddd96a06",
                                "text": "Jest tuk the best rooms in that new hotel, got a hoss and buggy, dressed ourselves, you and me, fit to kill, and made them Fort people take a back seat in the Lord's Tabernacle, oncet for all."
                            },
                            {
                                "example_id": "e4591951-a96d-4f72-b209-b96ae4c9174e",
                                "sense_id": "23cdf69e-8bb5-3b74-9b6c-caffddd96a06",
                                "text": "Why, Judith, Granny Peavey, our maw's mother, told us oncet about a dumb supper that her and two other gals made when she was but sixteen year old, and her sweetheart away from her in Virginny, and she didn't know whar he was at, an' they brought her tales agin him.\""
                            },
                            {
                                "example_id": "f6613ba3-4d4b-428c-ab2c-c459f527039a",
                                "sense_id": "23cdf69e-8bb5-3b74-9b6c-caffddd96a06",
                                "text": "He meets oncet in a while people, Mr. Redman; while, with us, what is it?"
                            }
                        ]
                    }
