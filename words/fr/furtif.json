    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "43da50b6-bb97-3df4-b4d6-47da73672b86",
                    "sense_definition": "Qui se fait à la dérobée, en cachette, avec rapidité et discrétion.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "discretion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a jeté un regard <w>furtif</w> vers la porte pour vérifier que personne n'arrivait."
                        },
                        {
                            "text": "Elle est sortie de la pièce d'une manière <w>furtive</w> sans attirer l'attention de ses collègues."
                        }
                    ],
                    "synonyms": [
                        "discret",
                        "dérobé"
                    ],
                    "antonyms": [
                        "ostensible",
                        "voyant"
                    ],
                    "common_phrases": [
                        "regard furtif",
                        "geste furtif"
                    ]
                },
                {
                    "sense_id": "61aeb492-815a-340a-a8ce-2b653102d91a",
                    "sense_definition": "Se dit d'un véhicule militaire conçu pour réduire sa signature et échapper à la détection radar.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "technologie_militaire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'armée de l'air utilise un avion <w>furtif</w> capable d'échapper à la surveillance des radars ennemis."
                        },
                        {
                            "text": "Ce nouveau navire militaire est doté d'une coque <w>furtive</w> qui réduit fortement sa signature électronique."
                        }
                    ],
                    "synonyms": [
                        "indétectable"
                    ],
                    "common_phrases": [
                        "avion furtif",
                        "bombardier furtif"
                    ]
                },
                {
                    "sense_id": "526b8082-fd36-3e6d-abc1-3893b4c9b6d8",
                    "sense_definition": "Se dit d'un programme malveillant qui modifie le système afin de dissimuler sa propre présence.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "informatique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce virus <w>furtif</w> s'est propagé dans le réseau sans déclencher les alertes de sécurité habituelles."
                        },
                        {
                            "text": "Les experts ont identifié un logiciel particulièrement <w>furtif</w> qui masquait les modifications apportées aux fichiers système."
                        }
                    ],
                    "common_phrases": [
                        "virus furtif"
                    ]
                }
            ]
        }
    ]
