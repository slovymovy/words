                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "98f9303c-b8fc-3ce8-8967-4849eb242f64",
                                        "entry_id": "9f0ddd35-1e68-34c3-a9f0-3fe4a4d4587b",
                                        "glosses": [
                                            "Slush."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4be757e7-6358-4b9c-8428-4ec536fed86f",
                                                "sense_id": "98f9303c-b8fc-3ce8-8967-4849eb242f64",
                                                "text": "Shoes and socks, soaked and frozen in the mud and icy slosh, did little to protect their feet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "158caacc-be5f-375d-b740-61d297ba384c",
                                        "entry_id": "9f0ddd35-1e68-34c3-a9f0-3fe4a4d4587b",
                                        "glosses": [
                                            "Inferior wine or other drink."
                                        ],
                                        "tags": [
                                            "countable",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3630eb98-ffe3-43cc-a932-0c6ae78e081d",
                                                "sense_id": "158caacc-be5f-375d-b740-61d297ba384c",
                                                "text": "In the Midi, Grenache dominates most of the traditional appellations. Corbières, Minervois, Fitou, Faugères — these were once bywords for rough-and-ready red slosh."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f14ec5c2-fc1b-3181-8da7-9b12958bea99",
                                        "entry_id": "9f0ddd35-1e68-34c3-a9f0-3fe4a4d4587b",
                                        "glosses": [
                                            "A game related to billiards."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2fe6d9f9-8826-488b-bd46-7ad3646a35c4",
                                                "sense_id": "f14ec5c2-fc1b-3181-8da7-9b12958bea99",
                                                "text": "Finally they retired, did you not? said Tetty.\nWe did indeed, said Goff, we retired to the billiard-room, for a game of slosh."
                                            }
                                        ]
                                    }
                                ]
                            },
