                "senses": [
                    {
                        "sense_id": "3fb8aaca-d10d-3830-a6c3-d40bf2913e57",
                        "entry_id": "4f581811-545e-3129-a05c-f27185e181a6",
                        "glosses": [
                            "Vorgang, der zu einer Zeichnung oder Beschreibung eines Vorhabens im Ergebnis (dem Lüftungsplan) führt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "536b798a-9927-4238-83e3-f7f767027d61",
                                "sense_id": "3fb8aaca-d10d-3830-a6c3-d40bf2913e57",
                                "text": "„Die wichtigsten zu beachtenden Normen und Richtlinien bei einer Lüftungsplanung bilden die DIN 1946 und DIN 18017.“"
                            },
                            {
                                "example_id": "f1658799-8a0d-4860-854c-93acaa1fc147",
                                "sense_id": "3fb8aaca-d10d-3830-a6c3-d40bf2913e57",
                                "text": "„Bildung von Schimmelpilz durch immer „dichtere Bauten“ kann durch Lüftungsplanung vermeiden werden.“"
                            },
                            {
                                "example_id": "3c257cd4-4bfe-447f-a9a4-b088d2c7f425",
                                "sense_id": "3fb8aaca-d10d-3830-a6c3-d40bf2913e57",
                                "text": "„Diese Lüftungsplanung war Auflage der Baugenehmigung, um dann endlich den Kraftraum umzubauen und einzurichten.“"
                            },
                            {
                                "example_id": "bee8b884-cd48-4c04-9ef4-c9a12a334b97",
                                "sense_id": "3fb8aaca-d10d-3830-a6c3-d40bf2913e57",
                                "text": "„Die EnEV-Anforderungen an die Luftdichtigkeit von Gebäuden ziehen die Notwendigkeit eines Lüftungskonzeptes und im Bedarfsfall eine Lüftungsplanung nach sich.“"
                            },
                            {
                                "example_id": "4734fdb8-6458-460d-b96a-eeb85bf5d330",
                                "sense_id": "3fb8aaca-d10d-3830-a6c3-d40bf2913e57",
                                "text": "„Mehr über die Vielfalt unserer Küchenlüftungen, ihre Besonderheiten und Eigenschaften und was Sie bei der Lüftungsplanung beachten müssen, erfahren Sie in unserer Broschüre.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
