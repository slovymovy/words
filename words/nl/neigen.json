{
    "word_family": [
        "neiging",
        "toeneigen",
        "genegen",
        "genegenheid"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "daa39df6-52df-362c-91a4-a5d8fad3d567",
                    "sense_definition": "de neiging hebben om iets te doen of een bepaalde eigenschap te vertonen",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "tendens",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij was <w>geneigd</w> om over elk klein detail problemen te maken.",
                            "target_lang_translations": {
                                "en": "He was <w>inclined</w> to make problems over every little detail."
                            }
                        },
                        {
                            "text": "In mijn enthousiasme ben ik soms <w>geneigd</w> om van de hak op de tak te springen.",
                            "target_lang_translations": {
                                "en": "In my enthusiasm, I sometimes <w>tend</w> to jump from one thing to another."
                            }
                        }
                    ],
                    "synonyms": [
                        "tenden",
                        "hellen"
                    ],
                    "common_phrases": [
                        "geneigd zijn tot",
                        "ertoe neigen"
                    ],
                    "target_lang_definitions": {
                        "en": "to have a tendency to do something or to exhibit a certain characteristic"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "tend",
                                "target_lang_sense_clarification": "to be likely to behave in a particular way"
                            },
                            {
                                "target_lang_word": "be inclined",
                                "target_lang_sense_clarification": "to have a natural tendency or preference"
                            },
                            {
                                "target_lang_word": "lean",
                                "target_lang_sense_clarification": "to have a tendency or preference toward a particular opinion"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "878ac2b3-53a1-3369-baa2-912e241b3225",
                    "sense_definition": "zichzelf of een lichaamsdeel schuin naar voren of naar beneden buigen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fysieke_beweging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De oude man moest zijn hoofd diep <w>neigen</w> om door de lage deur te kunnen.",
                            "target_lang_translations": {
                                "en": "The old man had to <w>bow</w> his head low to be able to get through the low door."
                            }
                        },
                        {
                            "text": "Zij zag hem het hoofd <w>neigen</w> als teken van respect tijdens de ceremonie.",
                            "target_lang_translations": {
                                "en": "She saw him <w>incline</w> his head as a sign of respect during the ceremony."
                            }
                        }
                    ],
                    "synonyms": [
                        "buigen",
                        "overhellen"
                    ],
                    "common_phrases": [
                        "het hoofd neigen"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vaak in formele of literaire context gebruikt"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to bend oneself or a body part diagonally forward or downward"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bow",
                                "target_lang_sense_clarification": "to bend the head or upper body forward"
                            },
                            {
                                "target_lang_word": "incline",
                                "target_lang_sense_clarification": "to bend or tilt a body part, often formal"
                            },
                            {
                                "target_lang_word": "tilt",
                                "target_lang_sense_clarification": "to move into a sloping position"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}