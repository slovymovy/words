                        "glosses": [
                            "Action de houspiller."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "43b9c552-7ad3-46d8-ab72-c5e150a17deb",
                                "sense_id": "7e68ac78-6a7e-3250-a44f-2592c6e451f3",
                                "text": "S’il est possible de faire une lecture hoplitique du houspillage de la chouette par d’autres oiseaux, il est aussi possible de lire certains récits de bataille avec les yeux d’un naturaliste."
                            },
                            {
                                "example_id": "15074f93-797c-4d7e-b40a-cdec9bb75dc8",
                                "sense_id": "7e68ac78-6a7e-3250-a44f-2592c6e451f3",
                                "text": "Le houspillage (ou mobbing en anglais) consiste en des attaques collectives (généralement simulées et bruyantes) contre des prédateurs potentiels."
                            },
                            {
                                "example_id": "26f96772-876c-4930-9750-e8177431ee43",
                                "sense_id": "7e68ac78-6a7e-3250-a44f-2592c6e451f3",
                                "text": "Bref, c’était elle qui assurait la permanence de son bureau de poste : ses collègues échappaient à l'obligation de service minimum, et ma mère se faisait pardonner dix mois de houspillages : une organisation béton!"
                            }
                        ]
                    }
