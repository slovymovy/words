                                        "glosses": [
                                            "wissenschaftlich Braktee, ein meist grünes, flächiges Organ, welches in seiner Blattachsel einen Seitenspross trägt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "277f7261-3d4a-44a1-b141-039ba8a2b54b",
                                                "sense_id": "ff495964-de8e-3e52-9f90-4bb22e0d7e9e",
                                                "text": "Die Fruchtknoten vom Hanf werden von einem Tragblatt kapuzenartig umschlossen."
                                            },
                                            {
                                                "example_id": "70e2100e-bfb1-4f29-921f-35f58e95b65c",
                                                "sense_id": "ff495964-de8e-3e52-9f90-4bb22e0d7e9e",
                                                "text": "Das Tragblatt kann ein Keimblatt, ein Niederblatt, ein Laubblatt oder ein Hochblatt sein."
                                            }
                                        ],
