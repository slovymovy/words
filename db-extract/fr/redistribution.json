        "fr-extract.jsonl": [
            {
                "entry_id": "fe78df1c-45c0-3a93-80a0-e77ff4b1664a",
                "word": "redistribution",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "b6fbc4cb-9143-451d-9742-5fb049e72204",
                        "entry_id": "fe78df1c-45c0-3a93-80a0-e77ff4b1664a",
                        "tags": [
                            "plural"
                        ],
                        "form": "redistributions"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b2fe3be4-07c7-320c-b430-d00e64359a38",
                        "entry_id": "fe78df1c-45c0-3a93-80a0-e77ff4b1664a",
                        "glosses": [
                            "Action de redistribuer, qui peut concerner, en économie, des revenus ou des biens, via des impôts et des transferts sociaux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d49eb22a-79cd-42d8-a985-40e78060b1a4",
                                "sense_id": "b2fe3be4-07c7-320c-b430-d00e64359a38",
                                "text": "La voie sociale-démocrate de la flexisécurité de l'emploi, couplée à une redistribution qui fasse prévaloir un principe de justice sociale à l'encontre des excès de la valeur actionnariale, est le chemin qui distinguera l'Europe dans la mondialisation de ce premier XXIᵉ siècle."
                            },
                            {
                                "example_id": "4ccacd39-5f0b-4026-8652-84373546886f",
                                "sense_id": "b2fe3be4-07c7-320c-b430-d00e64359a38",
                                "text": "Beaucoup d’Américains ne comprennent toujours pas qu’ils sont appauvris par un système de redistribution qui avantage outrageusement un très petit nombre de personnes extrêmement riches."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2cb6fe62-acf2-4b48-b34d-db3633c36882",
                        "source_entry_id": "fe78df1c-45c0-3a93-80a0-e77ff4b1664a",
                        "source_sense_id": "b2fe3be4-07c7-320c-b430-d00e64359a38",
                        "target_lang_word": "Umverteilung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Umverteilung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8a91568b-f481-39a9-b788-b5f941f84653",
                                        "entry_id": "b7cfa009-b486-318a-a2b4-b1fae5f3fbfd",
                                        "glosses": [
                                            "Übertragung von etwas (Arbeit, Kapital, Steuerbelastung, ...) auf andere Adressaten/Zielpersonen, neue Verteilung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ca97235-42d0-4e7c-99dc-62b5d42202db",
                                                "sense_id": "8a91568b-f481-39a9-b788-b5f941f84653",
                                                "text": "„Er verlangt nun radikaler als je zuvor Reformen, ein Ende der Ungleichheit zwischen Schwarz und Weiß und eine Umverteilung des Wohlstands in dem an Bodenschätzen so reichen Land.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
