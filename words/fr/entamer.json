    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1a06508e-e876-3a0d-8d09-cedb1e5a9348",
                    "sense_definition": "Commencer ou entreprendre une action, un processus ou une conversation.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "commencer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les deux pays ont décidé d'<w>entamer</w> des négociations pour parvenir à un accord durable."
                        },
                        {
                            "text": "Nous allons <w>entamer</w> une discussion importante au sujet du nouveau projet d'équipe."
                        }
                    ],
                    "synonyms": [
                        "commencer"
                    ],
                    "common_phrases": [
                        "entamer des négociations",
                        "entamer une discussion"
                    ]
                },
                {
                    "sense_id": "46ff9daf-08e7-38e4-94fd-79ec286afd2a",
                    "sense_definition": "Commencer à consommer ou entailler un aliment ou une matière en prélevant une première part.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "consommer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Avant de servir le dessert aux invités, il a voulu <w>entamer</w> le pain frais."
                        },
                        {
                            "text": "Elle a posé le couteau sur la table sans <w>entamer</w> le gâteau d'anniversaire."
                        }
                    ],
                    "common_phrases": [
                        "entamer le pain",
                        "entamer un gâteau"
                    ]
                },
                {
                    "sense_id": "58465be4-54ad-3866-a845-829a707be068",
                    "sense_definition": "Diminuer des ressources ou porter atteinte à un avantage, à la confiance ou à la réputation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "affaiblir",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ces dépenses imprévues risquent d'<w>entamer</w> sérieusement les économies accumulées au fil des années."
                        },
                        {
                            "text": "Ses déclarations maladroites ont fini par <w>entamer</w> la confiance des investisseurs."
                        }
                    ],
                    "common_phrases": [
                        "entamer des réserves",
                        "entamer la confiance"
                    ]
                },
                {
                    "sense_id": "1736f2ed-64cc-346b-a8ad-7f1de3b9e225",
                    "sense_definition": "Faire une incision superficielle ou blesser légèrement la chair, la peau ou une surface.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "couper",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En glissant sur le rocher tranchant, la lame lui a légèrement <w>entamé</w> la peau du bras."
                        },
                        {
                            "text": "Le ciseau de l'artisan a <w>entamé</w> le bois délicat sans le briser complètement."
                        }
                    ],
                    "common_phrases": [
                        "entamer la peau",
                        "entamer la chair"
                    ]
                },
                {
                    "sense_id": "04deb348-0cef-35bf-ace0-d03ebb2b9f31",
                    "sense_definition": "Jouer la première carte d'un tour ou d'un pli dans un jeu de cartes.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "jeu",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le joueur placé à gauche du donneur doit <w>entamer</w> le premier pli de la manche."
                        },
                        {
                            "text": "Il a choisi d'<w>entamer</w> avec son as pour prendre rapidement l'avantage dans la partie."
                        }
                    ],
                    "common_phrases": [
                        "entamer à cœur",
                        "entamer du pique"
                    ]
                }
            ]
        }
    ]
