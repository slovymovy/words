                "senses": [
                    {
                        "sense_id": "1413873f-4771-39ee-9a60-c49d85b7c101",
                        "entry_id": "a856decc-88aa-377d-9ece-477a2f36b076",
                        "glosses": [
                            "met goede manieren, getuigend van een goede opvoeding"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "43bbbcd9-5a81-4dec-ba60-7a8747ca4af8",
                                "sense_id": "1413873f-4771-39ee-9a60-c49d85b7c101",
                                "text": "Bovendien struikel en blunder ik maar zo’n beetje door het leven, en juist dat vond u het mooiste, waarschijnlijk omdat u er dan zo georganiseerd en welgemanierd bij afstak."
                            },
                            {
                                "example_id": "635c1d0c-a792-427f-b6b5-4ab170a02219",
                                "sense_id": "1413873f-4771-39ee-9a60-c49d85b7c101",
                                "text": "De overstap naar het team van Williams maakte ze toen de doorgroeimogelijkheden bij Mercedes beperkt bleken. \"Mercedes was echt geweldig: alles strak georganiseerd, heel luxe. Maar Williams is warmer, opener, een echt familiebedrijf. Het is een nieuwe uitdaging en het bedrijf is ook heel Engels: iedereen is zeer welgemanierd.\""
                            }
                        ]
                    }
                ],
