                                "example_id": "518312df-26a7-4799-952a-7a7060e1b6f2",
                                "sense_id": "6ec47ca7-eccc-3b62-b334-a453b5efce13",
                                "text": "La métrète valait vingt-sept de nos litres selon Le Littré, trente-neuf virgule trois selon le Larousse et Universalis."
                            },
                            {
                                "example_id": "1e9b1437-72e2-4eed-8fa3-c1741f85fbef",
                                "sense_id": "6ec47ca7-eccc-3b62-b334-a453b5efce13",
                                "text": "La métrète est une mesure grecque de capacité : environ 39 litres, une fois et demi l’amphora."
                            }
                        ]
                    }
