        "fr-extract.jsonl": [
            {
                "entry_id": "2cc9f341-f840-381e-8a42-e8f1ab88c29d",
                "word": "monocle",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "b271ca26-f385-4acd-b3d3-c5f525aee244",
                        "entry_id": "2cc9f341-f840-381e-8a42-e8f1ab88c29d",
                        "tags": [
                            "plural"
                        ],
                        "form": "monocles"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "bb810409-a473-3815-bf46-965b6b73fd17",
                        "entry_id": "2cc9f341-f840-381e-8a42-e8f1ab88c29d",
                        "glosses": [
                            "Petit verre d’optique qui se place dans l’arcade sourcilière."
                        ],
                        "tags": [
                            "Optique"
                        ],
                        "examples": [
                            {
                                "example_id": "9f235f04-a390-4618-8e57-def0eb66c4f4",
                                "sense_id": "bb810409-a473-3815-bf46-965b6b73fd17",
                                "text": "Il avait une face plate et régulière de magistrat, à gros favoris blonds, qu’il tâchait de rendre aiguë, en se servant d’un monocle, derrière lequel son œil pétillait."
                            },
                            {
                                "example_id": "25ea94b9-7999-4c5e-9eae-1d7b8fc17010",
                                "sense_id": "bb810409-a473-3815-bf46-965b6b73fd17",
                                "text": "Comme la vue de Swann était un peu basse, il dut se résigner à se servir de lunettes pour travailler chez lui, et à adopter, pour aller dans le monde, le monocle qui le défigurait moins."
                            },
                            {
                                "example_id": "1a309842-3f62-4d6a-aabf-4ff841972e95",
                                "sense_id": "bb810409-a473-3815-bf46-965b6b73fd17",
                                "text": "Fritz Lang rajustait son monocle et disait : « Il faut toujours finir ce qu’on a commencé »."
                            },
                            {
                                "example_id": "5e17be55-eb0a-4e92-8bfc-6281948f066e",
                                "sense_id": "bb810409-a473-3815-bf46-965b6b73fd17",
                                "text": "Son monocle a l’air de ne servir qu’à maintenir son arrogance."
                            }
                        ]
                    },
                    {
                        "sense_id": "b49e9419-91c7-313e-bd05-230c2a62ac5e",
                        "entry_id": "2cc9f341-f840-381e-8a42-e8f1ab88c29d",
                        "glosses": [
                            "Anus."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "75b8273d-2d69-3b0a-869a-21c23c972552",
                        "entry_id": "2cc9f341-f840-381e-8a42-e8f1ab88c29d",
                        "glosses": [
                            "N’importe quelle espèce de crustacés du genre Monoculus."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "1d87d04b-1767-4d34-985f-df9ea158d38a",
                                "sense_id": "75b8273d-2d69-3b0a-869a-21c23c972552",
                                "text": "La forme de ce monocle est plus arrondie que celle du rougeâtre ; sa couleur grise, lavée d’un peu de bistre, ne fait rien perdre à la coquille de sa transparence, ce qui doit engager à choisir de préférence cette espèce pour les observations anatomiques et physiologiques."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c6410a21-7c62-48d9-ae9d-5efc9fff1af7",
                        "source_entry_id": "2cc9f341-f840-381e-8a42-e8f1ab88c29d",
                        "source_sense_id": "bb810409-a473-3815-bf46-965b6b73fd17",
                        "source_sense_description": "Verre d’optique qui se place dans l’arcade sourcilière",
                        "target_lang_word": "Augenglas",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Augenglas",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "18e80be7-d1d4-34f1-bf66-50b312a114c4",
                                        "entry_id": "ae0997ff-6ee4-3043-9eed-e8c788499047",
                                        "glosses": [
                                            "Sehhilfe aus Glas"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "23fbd435-0b52-4394-b448-5d4f9fc686dd",
                                                "sense_id": "18e80be7-d1d4-34f1-bf66-50b312a114c4",
                                                "text": "„Andererseits passen sich auch die Religionen den Veränderungen an: Galt ein Augenglas im Mittelalter noch als Teufelswerk, tragen heuer auch Päpste eine Brille.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e6b373f7-244a-3806-a6be-659f06433006",
                                        "entry_id": "ae0997ff-6ee4-3043-9eed-e8c788499047",
                                        "glosses": [
                                            "Brille"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2efd75c8-fedf-489b-be98-90d33ecf21c0",
                                                "sense_id": "e6b373f7-244a-3806-a6be-659f06433006",
                                                "text": "Ich habe schon wieder meine Augengläser verlegt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "68b3927a-275d-47d5-89d5-e154087c2bc1",
                        "source_entry_id": "2cc9f341-f840-381e-8a42-e8f1ab88c29d",
                        "source_sense_id": "bb810409-a473-3815-bf46-965b6b73fd17",
                        "source_sense_description": "Verre d’optique qui se place dans l’arcade sourcilière",
                        "target_lang_word": "Monokel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Monokel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8f922816-e228-3130-8735-10e36c566f67",
                                        "entry_id": "1ec093e6-6f08-34a5-a821-a1020fcbada1",
                                        "glosses": [
                                            "heute eher unübliche Sehhilfe, die aus einem Glas besteht und die am Auge eingeklemmt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a1f0d6b-442c-4175-96c9-d70a909eb79c",
                                                "sense_id": "8f922816-e228-3130-8735-10e36c566f67",
                                                "text": "Mein alter Onkel Waldemar trug beim Zeitunglesen stets ein Monokel."
                                            },
                                            {
                                                "example_id": "f72207f3-f06b-45ed-a555-3783057a0f22",
                                                "sense_id": "8f922816-e228-3130-8735-10e36c566f67",
                                                "text": "„Alsdann wurde man wohlwollend durch ein Monokel gemustert und den ausufernden Kiegserinnerungen des alten Herrn ausgesetzt, die man ergebenst über sich ergehen ließ.“"
                                            },
                                            {
                                                "example_id": "d39c4b08-7afa-410d-8fdf-15115c1aaeed",
                                                "sense_id": "8f922816-e228-3130-8735-10e36c566f67",
                                                "text": "„In Fettpolstern steckend, in denen sich - trotz seiner athletischen Schultern - die preußische Feinheit seiner Züge verlor, glänzte sein berühmtes Monokel in der Sonne, unpassend, fast lächerlich.“"
                                            },
                                            {
                                                "example_id": "dede9ca5-326e-4a11-9d9d-0dba1c324ffc",
                                                "sense_id": "8f922816-e228-3130-8735-10e36c566f67",
                                                "text": "„Vorletztes und Letzteres unterscheiden sich übrigens dadurch, dass das Manokel vor das Auge gehalten und das Monokel unter Einsatz grimassierender Gesichtsmuskel vor dem Auge eingeklemmt wird.“"
                                            },
                                            {
                                                "example_id": "fdfa8f48-0814-4abb-ae5d-2a9032d57a4c",
                                                "sense_id": "8f922816-e228-3130-8735-10e36c566f67",
                                                "text": "„Dann putzte er das Monokel und schwieg, ohne den Blick von den Störenfrieden abzuwenden.“"
                                            },
                                            {
                                                "example_id": "c0ff0088-f4c2-4eca-8320-d11c029f1109",
                                                "sense_id": "8f922816-e228-3130-8735-10e36c566f67",
                                                "text": "„Mein Einfall war närrisch, was soll es helfen, wenn ein Herr um sechs Uhr früh in Cut und Monokel die Tür öffnet, in diesem Augenblick erscheint er mir die Rettung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
