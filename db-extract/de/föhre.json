                        "tags": [],
                        "examples": [
                            {
                                "example_id": "14c9c92e-8473-4e59-977e-561d8bd0b71b",
                                "sense_id": "1ad0404e-a34b-3d25-9c31-db639a197b99",
                                "text": "Selbst an ausgesetzten Stellen und auf Vorsprüngen in beinahe senkrechten Wänden kann man auf Föhren (Pinus nigra var. austriaca) stoßen."
                            },
                            {
                                "example_id": "82705d0e-8a76-4eb9-b113-2b2828056ecf",
                                "sense_id": "1ad0404e-a34b-3d25-9c31-db639a197b99",
                                "text": "„Nur einige Föhren und Zedern krochen kümmerlich am hohen Uferrande hin.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "f4e9d78f-315d-32a3-a810-9ac5fedb2023",
