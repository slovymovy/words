                        "glosses": [
                            "Serving to interrogate; questioning."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "892d1310-0d0f-4548-ad2b-2972ce34eeb8",
                                "sense_id": "4886a138-6dca-3261-bd31-4abc3bc71ae7",
                                "text": "an interrogatory glance"
                            },
                            {
                                "example_id": "b38183ec-5d44-4b4d-a786-2ee2844d76e9",
                                "sense_id": "4886a138-6dca-3261-bd31-4abc3bc71ae7",
                                "text": "The interrogatory stare of the cardinal is enough to bring a man to his knees."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "60767e4c-209e-39b8-afcd-7d06de3a7e90",
                "word": "interrogatory",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "8d811d10-dfbc-41fe-8364-df100769f7eb",
                        "entry_id": "60767e4c-209e-39b8-afcd-7d06de3a7e90",
                        "tags": [
                            "plural"
                        ],
                        "form": "interrogatories"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "26b03962-6ae3-3755-80ad-f5d55f73faaa",
                        "entry_id": "60767e4c-209e-39b8-afcd-7d06de3a7e90",
                        "glosses": [
                            "A formal question or set of questions submitted to opposing party to answer, generally governed by court rule."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f5e9b85-7810-4dad-b24d-f8027a811dcc",
                                "sense_id": "26b03962-6ae3-3755-80ad-f5d55f73faaa",
                                "text": "Sidney interposed with an interrogatory concerning the legality of the evidence"
                            },
                            {
                                "example_id": "0bd3e520-a692-4863-9618-2969525fa5e5",
                                "sense_id": "26b03962-6ae3-3755-80ad-f5d55f73faaa",
                                "text": "Kimberling, on the advice of his lawyer Frank Kameny, refused to answer several questions put to him on the 16-question interrogatory. After strong objections, the questions in question were withdrawn."
                            },
                            {
                                "example_id": "7c647c22-a72c-40c5-816c-29e08b9ba4de",
                                "sense_id": "26b03962-6ae3-3755-80ad-f5d55f73faaa",
                                "text": "If those attempts are unsuccessful, the attorney requesting the interrogatories may file a motion for sanctions with the court. The sanctions range from attorney fees to prohibiting the nonanswering party from presenting or defending claims."
                            }
                        ]
                    },
                    {
                        "sense_id": "42cce969-d335-3198-8ff6-b3e7079be059",
                        "entry_id": "60767e4c-209e-39b8-afcd-7d06de3a7e90",
                        "glosses": [
                            "A question; an interrogation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8253b85d-2685-4d86-972c-c50b836651e9",
                                "sense_id": "42cce969-d335-3198-8ff6-b3e7079be059",
                                "text": "But when he found that some of his interrogatories were evaded, and others answered undecisively, the look of gentleness which he had assumed, vanished, and his brow wore the cloud of disappointment and of anger."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
