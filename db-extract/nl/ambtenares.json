                    {
                        "sense_id": "fa5c2c00-b690-3db7-b428-29efb2c19b0e",
                        "entry_id": "ef96750d-d549-34c2-b6ee-603d8fad3e03",
                        "glosses": [
                            "een vrouwelijk persoon die aangesteld is in een door de overheid beheerde dienst"
                        ],
                        "tags": [
                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "d5d95e63-2323-444b-8e64-5af600350701",
                                "sense_id": "fa5c2c00-b690-3db7-b428-29efb2c19b0e",
                                "text": "Er is morgen een vergadering van alle ambtenaressen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e5a1da00-0f21-46b6-a1ce-7ed57d0f7484",
                        "source_entry_id": "ef96750d-d549-34c2-b6ee-603d8fad3e03",
                        "source_sense_id": "fa5c2c00-b690-3db7-b428-29efb2c19b0e",
                        "source_sense_description": "een vrouwelijk persoon die aangesteld is in een door de overheid beheerde dienst",
                        "target_lang_word": "Beamtin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Beamtin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "82f05ed7-af41-3e43-9578-d591a6dd6981",
                                        "entry_id": "a550b42e-1e61-301d-bdff-e27f51d81da6",
                                        "glosses": [
                                            "weibliche Person, die verbeamtet ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "488e11d4-48e5-430b-a627-3ae985f3da28",
                                                "sense_id": "82f05ed7-af41-3e43-9578-d591a6dd6981",
                                                "text": "Agnes will unbedingt Beamtin werden."
                                            },
                                            {
                                                "example_id": "0be82d2f-4fe2-41d6-8600-269e62f137af",
                                                "sense_id": "82f05ed7-af41-3e43-9578-d591a6dd6981",
                                                "text": "In unserer Behörde arbeiten mehr Beamtinnen als Beamte."
                                            },
                                            {
                                                "example_id": "d0d01b63-25bc-485c-b486-6505dfcca59e",
                                                "sense_id": "82f05ed7-af41-3e43-9578-d591a6dd6981",
                                                "text": "Sie hat sich für eine Laufbahn als Beamtin in der Stadtverwaltung entschieden."
                                            },
                                            {
                                                "example_id": "fdbc3cbf-76a5-4763-af24-8359554f99ec",
                                                "sense_id": "82f05ed7-af41-3e43-9578-d591a6dd6981",
                                                "text": "„Die Beamtin schüttelte nur den Kopf und gab ihr einen Termin.“"
                                            },
                                            {
                                                "example_id": "7a8e9c08-270c-4264-9827-cd112c6623e4",
                                                "sense_id": "82f05ed7-af41-3e43-9578-d591a6dd6981",
                                                "text": "„Es kamen eine Beamtin und ein Beamter in Zivil, sehr höflich, auf eine Weise exakt, die ihnen wahrscheinlich als ›angenehm wirkend‹ einexerziert worden war.“"
                                            },
                                            {
                                                "example_id": "669c7988-d9a9-4749-af43-b6df3cddec82",
                                                "sense_id": "82f05ed7-af41-3e43-9578-d591a6dd6981",
                                                "text": "„In dem zuständigen Amtszimmer sitzt eine junge Beamtin mit einem auffallend großen Busen.“"
                                            },
                                            {
                                                "example_id": "641b5381-823d-4d19-b07f-4bfdb3f3bf64",
                                                "sense_id": "82f05ed7-af41-3e43-9578-d591a6dd6981",
                                                "text": "„Die Beamtin gab dem Mann seine Papiere mit einem freundlichen Wort zurück.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1956f3d7-31f6-4cb4-bead-2bbc7af32115",
                        "source_entry_id": "ef96750d-d549-34c2-b6ee-603d8fad3e03",
                        "source_sense_id": "fa5c2c00-b690-3db7-b428-29efb2c19b0e",
                        "source_sense_description": "een vrouwelijk persoon die aangesteld is in een door de overheid beheerde dienst",
                        "target_lang_word": "fonctionnaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fonctionnaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a8a28888-de6e-3293-8f65-4e522bb7d3d3",
                                        "entry_id": "e5df9337-531f-347f-bc26-f21578e37951",
                                        "glosses": [
                                            "Celui, celle qui remplit une fonction de l’État."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5fd6a698-bd1b-46b9-809f-d86170dbb7ca",
                                                "sense_id": "a8a28888-de6e-3293-8f65-4e522bb7d3d3",
                                                "text": "Qu’est-ce que la vertu ? Au sens où l’entend son restaurateur, c’est sans doute la probité et le désintéressement, c’est ce genre d’intégrité qui rend un fonctionnaire ou un mandataire inaccessible à toutes les tentations, à toutes les corruptions […]."
                                            },
                                            {
                                                "example_id": "fe7b753e-9e64-4f8f-8c96-2949441a4352",
                                                "sense_id": "a8a28888-de6e-3293-8f65-4e522bb7d3d3",
                                                "text": "Mais en lui-même, il savait bien qu’il suffit de quelques fonctionnaires ignorants et brutaux pour rendre la France haïssable aux yeux de pauvres villageois illettrés et obscurs."
                                            },
                                            {
                                                "example_id": "b9e0387f-92fd-405f-8fc8-bc472d507f39",
                                                "sense_id": "a8a28888-de6e-3293-8f65-4e522bb7d3d3",
                                                "text": "Les anciens impôts basés sur le Koran sont supprimés et remplacés par des contributions nouvelles qui seront recueillies par des fonctionnaires spéciaux, au lieu de l’être par les caïds."
                                            },
                                            {
                                                "example_id": "b3d59d22-6a9f-457d-976a-30f902e3bc13",
                                                "sense_id": "a8a28888-de6e-3293-8f65-4e522bb7d3d3",
                                                "text": "Les paroles trébuchèrent, et il eut l’air étrangement déplacé, presque risible, cet appel aux sentiments d’un fonctionnaire, quand les fonctions ne peuvent être remplies qu’objectivement."
                                            },
                                            {
                                                "example_id": "13aa8cb1-a811-4b7d-bbdc-4e74b9312076",
                                                "sense_id": "a8a28888-de6e-3293-8f65-4e522bb7d3d3",
                                                "text": "Un polytechnicien, à leurs yeux, c’était quelqu’un. Mais mon sexe leur interdisait de si hautes ambitions et mon père me destina prudemment à l’administration : cependant il détestait les fonctionnaires, ces budgétivores, et c’est avec ressentiment qu’il me disait : « Toi au moins, tu auras une retraite ! »"
                                            },
                                            {
                                                "example_id": "d7826348-c571-4964-909d-19e4f5b020d8",
                                                "sense_id": "a8a28888-de6e-3293-8f65-4e522bb7d3d3",
                                                "text": "Le fonctionnaire de la police nationale est loyal envers les institutions républicaines. Il est intègre et impartial ; il ne se départit de sa dignité en aucune circonstance."
                                            },
                                            {
                                                "example_id": "3a65e13d-d0fa-4f44-8161-34209eaf3fc7",
                                                "sense_id": "a8a28888-de6e-3293-8f65-4e522bb7d3d3",
                                                "text": "Quelques très rares Annamites frayaient avec les Français. Un fonctionnaire annamitophile était en principe condamné à ne jamais « avancer ». Nous étions, du fait de la condition de ma mère, au dernier échelon de l'échelle des fonctionnaires."
                                            },
                                            {
                                                "example_id": "308994c9-0ee2-4927-8fa6-735c9a3a3cde",
                                                "sense_id": "a8a28888-de6e-3293-8f65-4e522bb7d3d3",
                                                "text": "Le moyen classique pour inciter à l’augmentation des salaires, c’est de toucher au smic et au point d’indice des fonctionnaires."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "32c9b820-551f-3ac8-b6ed-a4a6baf2da5b",
                                        "entry_id": "e5df9337-531f-347f-bc26-f21578e37951",
                                        "glosses": [
                                            "Personne lente à l’ouvrage, fainéante, rechignant au travail ; employé d’administration rêche et peu avenant."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "07d49bd9-11a7-4af1-8ec3-80b483be0713",
                                                "sense_id": "32c9b820-551f-3ac8-b6ed-a4a6baf2da5b",
                                                "text": "Celui-là ? Un vrai fonctionnaire, il n’avance que quand je le regarde !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1fd27651-483b-4c61-b63e-0935a293ef9e",
