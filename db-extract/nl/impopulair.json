                ],
                "senses": [
                    {
                        "sense_id": "f27a1737-0c1c-355f-aa7c-5e9fd88be2bd",
                        "entry_id": "8c1ae521-4a3c-3c6d-978e-877aa8115fe8",
                        "glosses": [
                            "niet geliefd bij het grote publiek"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "90d9a7a3-4881-489b-a68f-495ea56b317c",
                                "sense_id": "f27a1737-0c1c-355f-aa7c-5e9fd88be2bd",
                                "text": "De toenmalige regering van premier José María Aznar (Partido Popular) had het jaar daarvoor het zeer impopulaire besluit genomen om deel te nemen aan de Amerikaanse invasie van Irak. De suggestie dat jihadisten nu uit wraak voor Irak de aanslagen hadden gepleegd, moest snel de kop in worden gedrukt, en dus werd er meteen stellig naar de Baskische terreurorganisatie ETA gewezen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f5ce0256-94fa-4c76-90c6-5f6338119201",
                        "source_entry_id": "8c1ae521-4a3c-3c6d-978e-877aa8115fe8",
                        "source_sense_id": "f27a1737-0c1c-355f-aa7c-5e9fd88be2bd",
                        "target_lang_word": "impopular",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "impopular",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3ab6283e-93ee-3d6e-9353-758f72468020",
                                        "entry_id": "9284c100-08b0-3781-978c-2d3f4b6db6af",
                                        "glosses": [
                                            "Unpopular."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cfec466c-09f8-410f-8e4c-88909a099e4d",
                                                "sense_id": "3ab6283e-93ee-3d6e-9353-758f72468020",
                                                "text": "[…] God reckons it but Juſtice to help thoſe, who will not help themſelves by doing any Thing that may diſpleaſe him, and who, in contradiction to the greateſt Number and the greateſt Examples, dare do ſuch an impopular and ungracious Thing, as to be religious, to prefer his Law before the Licence of Men, and Salvation to come before any preſent Preferment."
                                            },
                                            {
                                                "example_id": "9ac3c9bf-2a62-4745-a3a4-57003196c3cd",
                                                "sense_id": "3ab6283e-93ee-3d6e-9353-758f72468020",
                                                "text": "But the cauſe being ſo very odious and impopular, the tryal of the Verdict was deferred from one Term to another, until upon the Duke of G⁠-⁠-⁠ft⁠-⁠n the Lord Lieutenant’s arrival, his Grace after mature advice, and permiſſion from England, was pleaſed to grant a noli proſequi."
                                            },
                                            {
                                                "example_id": "90376d76-60c5-4253-898d-c38151891756",
                                                "sense_id": "3ab6283e-93ee-3d6e-9353-758f72468020",
                                                "text": "No nation could be justified in compelling them to submit to an impopular dynasty, or to the yoke of feudal and superstitious tyranny."
                                            },
                                            {
                                                "example_id": "866f725a-8f0b-4d2e-981c-76e24c520507",
                                                "sense_id": "3ab6283e-93ee-3d6e-9353-758f72468020",
                                                "text": "The Stamp Act was an impopular tax on paper and paper products, the revenue went to the royal treasury and were used to pay for the British soldiers stationed in America."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2b55aeca-52a7-4b1d-ac3a-0eb75699585a",
                        "source_entry_id": "8c1ae521-4a3c-3c6d-978e-877aa8115fe8",
                        "source_sense_id": "f27a1737-0c1c-355f-aa7c-5e9fd88be2bd",
                        "target_lang_word": "impopulaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "impopulaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f2005261-1417-3967-80a2-85bcc003d754",
                                        "entry_id": "2f2d8b3b-0f10-39aa-9cfa-a92b0a04b779",
                                        "glosses": [
                                            "Qui déplaît au peuple, qui n’a pas l’affection du peuple."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1bd2106e-dbce-4a28-b0ef-355150d6b572",
                                                "sense_id": "f2005261-1417-3967-80a2-85bcc003d754",
                                                "text": "[…]; les taxes impopulaires, abolies en juin 1908 en don de joyeux avènement, avaient été rétablies et considérablement renforcées."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4df47e1c-929a-3568-9973-f4d94cae77e1",
                                        "entry_id": "2f2d8b3b-0f10-39aa-9cfa-a92b0a04b779",
                                        "glosses": [
                                            "Qui n’est pas conforme aux désirs du peuple."
                                        ],
