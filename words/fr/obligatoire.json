    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "845488f7-cd14-3ce8-8f19-4aaea010cef0",
                    "sense_definition": "Imposé par une loi, une règle ou un règlement ; auquel on ne peut se soustraire.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "loi_regle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le port du casque est <w>obligatoire</w> pour tous les cyclistes mineurs."
                        },
                        {
                            "text": "L'école est devenue <w>obligatoire</w> dès l'âge de trois ans en France."
                        }
                    ],
                    "synonyms": [
                        "imposé",
                        "contraignant",
                        "requis"
                    ],
                    "antonyms": [
                        "facultatif",
                        "optionnel"
                    ],
                    "common_phrases": [
                        "port obligatoire",
                        "service militaire obligatoire",
                        "passage obligatoire"
                    ]
                },
                {
                    "sense_id": "85ef3eff-9f3e-3421-b421-47a2cf1bd6ba",
                    "sense_definition": "Commandé ou exigé par la politesse, la morale ou les convenances sociales.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "convenance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une tenue correcte est <w>obligatoire</w> pour assister à ce gala de bienfaisance."
                        },
                        {
                            "text": "Sa présence à cette cérémonie officielle semblait tout à fait <w>obligatoire</w>."
                        }
                    ],
                    "synonyms": [
                        "nécessaire"
                    ],
                    "antonyms": [
                        "facultatif"
                    ],
                    "common_phrases": [
                        "tenue obligatoire",
                        "présence obligatoire"
                    ]
                },
                {
                    "sense_id": "84d8148c-6c0a-30c6-8fb8-832e4c9dc1a0",
                    "sense_definition": "Que l'on ne peut pas éviter ; inévitable ou indispensable.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "inevitable",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'apprentissage de la grammaire est une étape <w>obligatoire</w> pour bien s'exprimer."
                        },
                        {
                            "text": "Après une crise aussi importante, des réformes en profondeur devenaient <w>obligatoires</w>."
                        }
                    ],
                    "synonyms": [
                        "inévitable",
                        "inéluctable",
                        "fatal"
                    ],
                    "common_phrases": [
                        "étape obligatoire"
                    ]
                }
            ]
        }
