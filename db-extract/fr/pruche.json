        "fr-extract.jsonl": [
            {
                "entry_id": "4cfbab75-16a8-3bcc-a738-50b459c0560f",
                "word": "pruche",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "77cbb3f4-cfed-40bb-af9d-7f6565c387e1",
                        "entry_id": "4cfbab75-16a8-3bcc-a738-50b459c0560f",
                        "tags": [
                            "plural"
                        ],
                        "form": "pruches"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "25d4bc30-c74e-3455-9b7f-8d8ffca5dbbb",
                        "entry_id": "4cfbab75-16a8-3bcc-a738-50b459c0560f",
                        "glosses": [
                            "Nom utilisé au Canada pour désigner les arbres du genre Tsuga de la famille des Pinacées."
                        ],
                        "tags": [
                            "Québec"
                        ],
                        "examples": [
                            {
                                "example_id": "aacdbb54-cbff-4d01-b986-7a32308c3e57",
                                "sense_id": "25d4bc30-c74e-3455-9b7f-8d8ffca5dbbb",
                                "text": "Les saumons et les précieux poissons-chandelles remontaient par millions cette vallée, dont les flancs étaient couverts de pruches (hemlock) et de thuyas (cedar) mesurant jusqu’à quatre mètres de diamètre."
                            },
                            {
                                "example_id": "52de30f8-4940-404b-92d7-0c321d63bcdc",
                                "sense_id": "25d4bc30-c74e-3455-9b7f-8d8ffca5dbbb",
                                "text": "Alors qu’en Europe on traitait le cuir en se servant du tanin des chênes, on utilisait plutôt chez nous celui des pruches, plus abondantes et riches en acide tanique."
                            },
                            {
                                "example_id": "e4832c42-43b0-4672-bbd8-15f5483d530f",
                                "sense_id": "25d4bc30-c74e-3455-9b7f-8d8ffca5dbbb",
                                "text": "Cet insecte prolifère surtout dans le sapin baumier, la pruche et l’épinette, mais il s’alimente également sur le bouleau, l’érable et plusieurs autres feuillus."
                            },
                            {
                                "example_id": "7cc190b5-ad05-4578-b623-fbd4ca09629d",
                                "sense_id": "25d4bc30-c74e-3455-9b7f-8d8ffca5dbbb",
                                "text": "Après diner nous entrâmes dans une savanne de trois acres de large, et ensuite nous eumes une petite montée, un peu rude et rocheuse; bois, pruche, épinette, sapin beaumier, hètre et érable."
                            }
                        ]
                    },
                    {
                        "sense_id": "0e13f7ab-9a47-3d5e-8db7-051dfbd4388d",
                        "entry_id": "4cfbab75-16a8-3bcc-a738-50b459c0560f",
                        "glosses": [
                            "Bois tiré de cet arbre."
                        ],
                        "tags": [
                            "metonymically"
                        ],
                        "examples": [
                            {
                                "example_id": "fbe13cba-fca9-4025-87af-5aef70712daf",
                                "sense_id": "0e13f7ab-9a47-3d5e-8db7-051dfbd4388d",
                                "text": "En raison de sa dureté, le merisier est utilisé dans la fabrication des quilles de navires, la pruche pour les bordages et le frêne, pour les chevrons."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "951c5256-2e87-45cf-a42b-da252ac67c00",
                        "source_entry_id": "4cfbab75-16a8-3bcc-a738-50b459c0560f",
                        "target_lang_word": "hemlock",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hemlock",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c3d32d58-1739-3bbc-9bd8-a0c74d156bac",
                                        "entry_id": "13d03d27-32b0-32c6-b6b0-48c6e080fefc",
                                        "glosses": [
                                            "Any of the poisonous umbelliferous plants, of the genera",
                                            "Conium, either Conium maculatum or Conium chaerophylloides."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cf7321f6-bca9-4483-930e-2e21cbe0b70c",
                                                "sense_id": "c3d32d58-1739-3bbc-9bd8-a0c74d156bac",
                                                "text": "Have a tree or two the witches particularly like, such as the alder, larch, cypress and hemlock; then, to counteract any possible evil effects, there must be a holly, yew, hazel, elder, mountain ash or juniper."
                                            },
                                            {
                                                "example_id": "b26e7ed6-e4c0-4d6d-9728-f43a9d78df90",
                                                "sense_id": "c3d32d58-1739-3bbc-9bd8-a0c74d156bac",
                                                "text": "In the Tyrol, on May Day, it was the custom to smoke out witches by burning bundles of black and red spotted hemlock. In the eighteenth century hemlock was used for treating cancer, syphilis, and ulcers."
                                            },
                                            {
                                                "example_id": "10107c23-5924-4ddc-9cf9-89a371fdcb57",
                                                "sense_id": "c3d32d58-1739-3bbc-9bd8-a0c74d156bac",
                                                "text": "There were bunches of wild garlic to keep out evil spirits, foxgloves for healing spells and hemlock and vervain for darker magic."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5a4bb6b8-d598-370a-bde7-dc61100f9d9d",
                                        "entry_id": "13d03d27-32b0-32c6-b6b0-48c6e080fefc",
                                        "glosses": [
                                            "Any of the poisonous umbelliferous plants, of the genera",
                                            "Cicuta (water hemlock)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e1d864da-b283-3c1f-9f72-a03afd16c9c4",
                                        "entry_id": "13d03d27-32b0-32c6-b6b0-48c6e080fefc",
                                        "glosses": [
                                            "Poison obtained from these Conium and Cicuta plants."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d454045f-15d2-301b-bf04-f53ba9c128aa",
                                        "entry_id": "13d03d27-32b0-32c6-b6b0-48c6e080fefc",
                                        "glosses": [
                                            "Any of several coniferous trees, of the genus Tsuga, that grow in North America; the wood of such trees."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "690dd0f2-5a1c-436c-8023-d0b1e66b5d49",
                                                "sense_id": "d454045f-15d2-301b-bf04-f53ba9c128aa",
                                                "text": "The wind blows and the hemlocks wave their feathery leading shoots. Such a graceful profile, so elegant a tree."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
