                                "target_lang_code": "ja",
                                "target_senses": [
                                    {
                                        "sense_id": "c9e15343-5152-328c-8cac-d4189182f25d",
                                        "entry_id": "3dd3915e-8188-3e34-976e-5169188e4cb7",
