                                        "entry_id": "afe9ad56-1980-3ca3-932c-4249d8edfa61",
                                        "glosses": [
                                            "The speculative biology of extraterrestrial life forms."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e226a2ef-a1d6-4f85-9550-5b9a2efe93ba",
                                                "sense_id": "4f7ea87f-0c93-37c3-8d4b-d2b25fc54784",
                                                "text": "This massive skull is scored by deflected mass accelerator shots. The xenobiology files in your hardsuit computer can't identify the species. It must have been brought here from an unknown world."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f473b8c4-75f2-3004-b77c-c51cece315fa",
                                        "entry_id": "afe9ad56-1980-3ca3-932c-4249d8edfa61",
                                        "glosses": [
                                            "The biology of life forms with non-standard biochemistry or codes."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "598aba15-f397-45fe-9bd6-c0b39dd3f11c",
                        "source_entry_id": "4016d494-2051-3bee-8e9c-f0a47115fa31",
                        "source_sense_id": "4e699c68-684c-3630-9f72-3826efe944d3",
