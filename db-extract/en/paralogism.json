                                        "glosses": [
                                            "Raisonnement involontairement erroné, à la suite d’un mauvais enchaînement logique ou de prémisses fausses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b08ec8c-537e-454f-be84-0b59d382717e",
                                                "sense_id": "3bf2fd00-6e5c-312f-997c-66df45f5dedb",
                                                "text": "C’est à la fois sa force et le point de contracture où une paralogie peu à peu se dessine."
                                            }
                                        ]
                                    },
