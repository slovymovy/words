                        "cross_references": []
                    },
                    {
                        "translation_id": "d2993655-d7e2-4ea1-9855-ca419ee1baca",
                        "source_entry_id": "d3841d26-413e-3934-8cc4-db673178df17",
                        "source_sense_id": "6124573e-7a19-3929-b430-e1a6f60f25ad",
                        "target_lang_word": "Arboretum",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Arboretum",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6e1cb9b4-ac9d-3fae-8c32-f47b6175cd8e",
                                        "entry_id": "2ce28095-8d52-301b-9cd0-5a8a088ca8b3",
                                        "glosses": [
                                            "eine Anpflanzung verschiedenartiger, oft auch exotischer Gehölze in einer abgegrenzten natürlichen Umgebung zum Zwecke der Arterhaltung, Besichtigung oder für Lehr- und Forschungszwecke; z. B. ein botanischer Garten (für Bäume und Sträucher)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "310f0365-114a-4f27-a36b-7eabfba01921",
                                                "sense_id": "6e1cb9b4-ac9d-3fae-8c32-f47b6175cd8e",
                                                "text": "Im Arboretum Burgholz wachsen heute auf einer Fläche von rund 250 Hektar 130 verschiedene Laub- und Nadelbaumarten. Sie dienen der Öffentlichkeit als Lehr- und Anschauungsobjekt für die Vielgestaltigkeit von Holzgewächsen. Darüber hinaus steht das Arboretum auch Fachleuten aus verschiedenen Bereichen, zum Beispiel Dendrologen und Vegetationskundlern, zu Studienzwecken zur Verfügung. Die Vielfalt der Baumarten, die zu schönen und einmaligen Waldbeständen zusammengewachsen sind, ziehen auch Waldbesucher weit über die Grenzen von Wuppertal hinaus an."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "14e202a5-b76d-4261-a48a-164d07f0089d",
                        "source_entry_id": "d3841d26-413e-3934-8cc4-db673178df17",
                        "source_sense_id": "6124573e-7a19-3929-b430-e1a6f60f25ad",
