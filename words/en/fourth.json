                            "comment": "often used humorously in formal proceedings"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Согласиться с предложением или поддержать его после того, как оно уже было поддержано тремя другими участниками."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поддержать четвёртым",
                                "target_lang_sense_clarification": "о предложении на собрании"
                            }
