        "fr-extract.jsonl": [
            {
                "entry_id": "0c6ad154-a03b-3bd8-aa90-8f050aec48ff",
                "word": "accidentologie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "10f5668b-bf2a-4321-85ba-c5638c924f00",
                        "entry_id": "0c6ad154-a03b-3bd8-aa90-8f050aec48ff",
                        "tags": [
                            "plural"
                        ],
                        "form": "accidentologies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9ac04e13-c3bb-369a-af0a-da8bd712ca1d",
                        "entry_id": "0c6ad154-a03b-3bd8-aa90-8f050aec48ff",
                        "glosses": [
                            "Étude des accidents, tant du point de vue de leurs causes que de leurs effets."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "000b2790-1e3b-4b97-bb49-348e23f4b930",
                                "sense_id": "9ac04e13-c3bb-369a-af0a-da8bd712ca1d",
                                "text": "La faiblesse des instruments déployés pour mesurer et comprendre l'accidentologie confirme le fait que la politique de sécurité routière est une politique plus symbolique qu'instrumentale."
                            },
                            {
                                "example_id": "1e33b7dd-908d-4135-8445-4490ca46717f",
                                "sense_id": "9ac04e13-c3bb-369a-af0a-da8bd712ca1d",
                                "text": "La Direction Départementale des Territoires de l’Yonne met en ligne à compter du 1ᵉʳ janvier 2018, un baromètre trimestriel reprenant l’essentiel des chiffres de l’accidentologie, ainsi que les statistiques vitesses et sanctions des radars"
                            }
                        ]
                    },
                    {
                        "sense_id": "fb9025b6-bb5e-3bdf-a954-abdf31631cd5",
                        "entry_id": "0c6ad154-a03b-3bd8-aa90-8f050aec48ff",
                        "glosses": [
                            "Fréquence et gravité des accidents."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "ebc72707-2ec4-4e62-9cb0-fbc7176a7b70",
                                "sense_id": "fb9025b6-bb5e-3bdf-a954-abdf31631cd5",
                                "text": "Notre objectif est de conforter la baisse de l’accidentologie, notamment des accidents corporels."
                            },
                            {
                                "example_id": "06ee71ed-35d0-46a3-b3bb-35263706640b",
                                "sense_id": "fb9025b6-bb5e-3bdf-a954-abdf31631cd5",
                                "text": "D’autant plus dans ce contexte de reprise de l’accidentologie, en France comme dans les Vosges."
                            },
                            {
                                "example_id": "568a4091-58be-486b-bfd3-b6b690b33e37",
                                "sense_id": "fb9025b6-bb5e-3bdf-a954-abdf31631cd5",
                                "text": "En faisant la promotion de la « slow conduite », la Sécurité routière entend réduire le taux d’accidentologie sur les routes et les autoroutes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1b357fa6-ecf4-4e00-bb72-b01d26f02dbe",
                        "source_entry_id": "0c6ad154-a03b-3bd8-aa90-8f050aec48ff",
                        "target_lang_word": "Unfallforschung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Unfallforschung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "495baa8f-737c-3bc2-a72a-15b7b6d22f08",
                                        "entry_id": "8ce90eee-0d68-3e31-bd8b-14f20a26a9a5",
                                        "glosses": [
                                            "Disziplin zur Erforschung von Unfallursachen und -folgen"
                                        ],
                                        "tags": [
                                            "Wissenschaftszweig"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d398678a-c600-4510-9872-739992e76cbf",
                                                "sense_id": "495baa8f-737c-3bc2-a72a-15b7b6d22f08",
                                                "text": "„In der betrieblichen Praxis sowie in der psychologischen Unfallforschung, die um 1920 ihren Anfang nahm, richtete sich die Suche nach Ursachen für einen Unfall lange Zeit an den Maßnahmen aus, die sich am kostengünstigsten durchführen ließen.“"
                                            },
                                            {
                                                "example_id": "cbcea2b2-bd72-4a54-995b-0d5e54ad14ab",
                                                "sense_id": "495baa8f-737c-3bc2-a72a-15b7b6d22f08",
                                                "text": "„Ganz allgemein beschäftigt sich daher die Unfallchirurgie vorbeugend auch mit der Unfallforschung, der Information der Bevölkerung und den körperlichen, psychischen und geistigen Unfallursachen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ff5b5b0c-559c-45df-816d-3cc6f7b7cd12",
                        "source_entry_id": "0c6ad154-a03b-3bd8-aa90-8f050aec48ff",
