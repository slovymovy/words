                        "sense_id": "c7737b20-e71c-31b2-97c8-a8d3944c827b",
                        "entry_id": "2f87e7b9-2ee7-3ae5-9df6-48a53406baba",
                        "glosses": [
                            "Randmeer des Pazifischen Ozeans zwischen Sulawesi und den südlichen Molukken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4988daef-954d-40e5-b686-027f3d69ddf0",
                                "sense_id": "c7737b20-e71c-31b2-97c8-a8d3944c827b",
                                "text": "„Im Spätsommer 1941 schließlich wurde das sonderbare Behältnis, welches das bereits erwähnte Manuskript enthielt, in der Bandasee zwischen Celebes und den Gewürzinseln treibend von einem holländischen Perlenfischer gefunden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
