                ],
                "senses": [
                    {
                        "sense_id": "e3f9e39e-2fe8-3aa9-a250-e908efaa1e50",
                        "entry_id": "b95a7a1a-3c76-3f45-9b67-ab97b19c830d",
                        "glosses": [
                            "im Freien stehender einzelner Pfeiler mit Sakramenthäuschen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35c158ae-eef6-48fe-8ea5-2af3799314d1",
                                "sense_id": "e3f9e39e-2fe8-3aa9-a250-e908efaa1e50",
                                "text": "„Das sogenannte Schoberkreuz am nördlichen Ortsausgang von Wieting ist ein teilweise aus Marmor gearbeiteter Tabernakelbildstock.“"
                            },
                            {
                                "example_id": "9565624d-b58e-457f-8cb8-883d776afd29",
                                "sense_id": "e3f9e39e-2fe8-3aa9-a250-e908efaa1e50",
                                "text": "„Ein Tabernakelbildstock – nur diese Spielart treffen wir in Ohlsbach an – ist schematisch gesehen dreigeteilt: Fuß, Stamm und Sakramentshäuschen – entweder aus einem Block gehauen oder aus mehreren (meist zwei) Stücken zusammengesetzt, die an der Rückseite durch Eisenklammern verbunden sind.“"
                            },
                            {
                                "example_id": "bf7b6133-ead2-406e-b83e-ed821aa49fa2",
                                "sense_id": "e3f9e39e-2fe8-3aa9-a250-e908efaa1e50",
                                "text": "„Dieser Tabernakelbildstock steht an einer Stelle, an der sich wahrscheinlich in der Nähe das Weintor (Weintorgasse) befunden hat.“"
                            },
                            {
                                "example_id": "1ffece40-e3e5-4dda-8e24-bbc98296265a",
                                "sense_id": "e3f9e39e-2fe8-3aa9-a250-e908efaa1e50",
                                "text": "„Am 31.03.2011 komplettierte schließlich die in Stein gehauene Figur den Tabernakelbildstock und setzte den Schlusspunkt der gesamten Bildstockrestauration.“"
                            },
                            {
                                "example_id": "5a0fb3df-0a9b-4bf7-a496-276212d77a29",
                                "sense_id": "e3f9e39e-2fe8-3aa9-a250-e908efaa1e50",
                                "text": "„Am rechten Ortsrand von Breitenstein in der Gemeinde Frauenstein steht rechts des Wimitzbaches dieser Tabernakelbildstock, der typisch ist für das Spätmittelalter.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
