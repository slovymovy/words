                "senses": [
                    {
                        "sense_id": "06bb88b4-e538-3d29-a909-1e4d9373fbdf",
                        "entry_id": "1ad56b1a-17a4-3beb-a1c9-8fe4be199053",
                        "glosses": [
                            "Behälter zum Sammeln und Aufbewahren von Schmutzwäsche"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e2f70ffd-9274-4934-9619-4807cb9d9b70",
                                "sense_id": "06bb88b4-e538-3d29-a909-1e4d9373fbdf",
                                "text": "Er warf seine Unterhose zielsicher direkt neben den Wäschepuff."
                            },
                            {
                                "example_id": "20c1c0ba-1a71-496e-97a4-6df6c9e02d57",
                                "sense_id": "06bb88b4-e538-3d29-a909-1e4d9373fbdf",
                                "text": "„Er bekam jeden Morgen zwei frische Taschentücher herausgelegt und warf sie abends ein bißchen verknautscht, aber nicht merklich angeschmutzt in den Wäschepuff in seinem Badezimmer.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
