                "senses": [
                    {
                        "sense_id": "880078a1-559e-32d6-a65f-d570ee86e085",
                        "entry_id": "40f77c91-665f-3627-bfba-c46c4a738b1e",
                        "glosses": [
                            "anlasslose, regelmäßig durchgeführte Untersuchung, die der Vorsorge dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7468cd0f-0f2f-4c3e-acf7-9e32fbb39edd",
                                "sense_id": "880078a1-559e-32d6-a65f-d570ee86e085",
                                "text": "„Die Krankheit, die oft zufällig oder im Verlauf einer medizinischen Routineuntersuchung entdeckt wird, kann weit fortgeschritten sein, ohne irgendwelche merkbaren Symptome sichtbar werden zu lassen.“"
                            },
                            {
                                "example_id": "aa1f09bc-3957-4137-bdd2-ce9f9f8ee513",
                                "sense_id": "880078a1-559e-32d6-a65f-d570ee86e085",
                                "text": "„Chemische Wasser-Analysen sind nur begrenzt geeignet, Gifte in Flüssen aufzuspüren; bei Routineuntersuchungen können maximal 30 der rund 10 000 im Rheinwasser vorhandenen Schadstoffe erfaßt werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
