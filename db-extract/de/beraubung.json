                "senses": [
                    {
                        "sense_id": "e4c7a8a7-24b5-323a-90d2-306f23d97c60",
                        "entry_id": "751961bf-e365-32cd-8729-2af7e4f8e7f9",
                        "glosses": [
                            "rechtswidrige/unethische Entziehung von etwas (von Besitz, Rechten oder auch von immateriellen Werten wie Identität), meistens unter Einsatz von Gewalt, Zwang, durch Betrug oder ähnliche unrechtmäßige Handlungen"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "7a39a6a2-c451-3ecb-b609-5b4785999294",
                        "entry_id": "751961bf-e365-32cd-8729-2af7e4f8e7f9",
                        "glosses": [
                            "Prozess des Herunterreißens loser Gesteinsstücke, -schalen oder Kohlebrocken aus der Firste, den Stößen oder der Ortsbrust"
                        ],
                        "tags": [
                            "Bergbau"
                        ],
                        "examples": [
                            {
                                "example_id": "101b95eb-938f-44e3-bd00-62842683d698",
                                "sense_id": "7a39a6a2-c451-3ecb-b609-5b4785999294",
                                "text": "„Die Bedienung des Hammers erfolgt bei heutigen Beraubefahrzeugen mit schlagender Beraubung über einen Fußtaster oder über einen Joystick.“"
                            },
                            {
                                "example_id": "94fa4a90-a67f-4ad8-9ded-4dcdafc8cec7",
                                "sense_id": "7a39a6a2-c451-3ecb-b609-5b4785999294",
                                "text": "„Es gibt Beraubefahrzeuge, die in gewisser Weise statisch arbeiten und durch vorsichtiges Heranfahren, Teleskopieren und Zangenbewegungen ablösen. Allerdings ist diese Arbeitsweise, die mit der pickenden Beraubung mittels Hydraulikhammers vergleichbar ist, sehr zeitraubend.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
