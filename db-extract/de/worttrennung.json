                    {
                        "translation_id": "b1c7a224-250c-45b1-8c33-ba4c5d9872e9",
                        "source_entry_id": "ae52499f-e39a-3426-ab5f-da66ab851b61",
                        "source_sense_id": "fb0cd2be-1ff9-34cc-ad9f-3237bc8b8b14",
