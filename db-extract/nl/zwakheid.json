                ],
                "senses": [
                    {
                        "sense_id": "ff0baf52-1d48-3a31-94db-c4285a8c82f2",
                        "entry_id": "0f610ce7-411f-377b-a0ab-84e4c751ada7",
                        "glosses": [
                            "het zwak-zijn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61c356a9-57b9-4b8a-8ad3-162509d2cb97",
                                "sense_id": "ff0baf52-1d48-3a31-94db-c4285a8c82f2",
                                "text": "Van zwakheid wordt soms misbruik gemaakt."
                            },
                            {
                                "example_id": "0abcb905-e462-4475-9f0c-dce20858b385",
                                "sense_id": "ff0baf52-1d48-3a31-94db-c4285a8c82f2",
                                "text": "Rembrandts portret wekt de suggestie dat ze in staat was te lachen om haar merkwaardige kanten, dat ze slim genoeg was om nooit te hoeven doen alsof ze iets wist en dat ze vriendelijk en vergevingsgezind kon zijn omdat ze zich maar al te goed bewust was van haar eigen zwakheden en behoefte aan bevestiging."
                            },
                            {
                                "example_id": "7d74f0a8-1f49-46b3-8ed7-b1602cfbbcee",
                                "sense_id": "ff0baf52-1d48-3a31-94db-c4285a8c82f2",
                                "text": "Ik wist dat ze alleen maar probeerde me bang te maken, om aan te tonen dat ik dezelfde zwakheden bezat als zij; maar opgesloten zitten in een mausoleum, zonder ander gezelschap dan de doden, was een angstaanjagende ervaring."
                            },
                            {
                                "example_id": "5ab44948-5d58-46a4-b9bc-1306c88968aa",
                                "sense_id": "ff0baf52-1d48-3a31-94db-c4285a8c82f2",
                                "text": "Al was hij de vriendelijkste, zichzelf wegcijferende man van de wereld, toch waren zijn zwakheden mij duidelijk."
                            }
                        ]
                    },
                    {
                        "sense_id": "52ae04c6-ceb3-3d6e-b6ca-2978772ca57b",
                        "entry_id": "0f610ce7-411f-377b-a0ab-84e4c751ada7",
                        "glosses": [
                            "gebrek, fout"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "760eaf42-0e46-4887-b99b-5b3e9e160b26",
                                "sense_id": "52ae04c6-ceb3-3d6e-b6ca-2978772ca57b",
                                "text": "Ieder mens heeft z'n zwakheden."
                            },
                            {
                                "example_id": "dde0fa72-4a1b-4d4a-bde8-0196637ed5cc",
                                "sense_id": "52ae04c6-ceb3-3d6e-b6ca-2978772ca57b",
                                "text": "Ik geloof dat zwakheid het leven voor haar belangwekkender maakte."
                            },
                            {
                                "example_id": "5402b979-0897-4b0d-b33a-d291c709d641",
                                "sense_id": "52ae04c6-ceb3-3d6e-b6ca-2978772ca57b",
                                "text": "Hij was ongeduldig geworden over zijn eigen zwakheid en hoewel hij indertijd veel pijn geleden had, had hij er nooit rond voor uit willen komen."
                            }
                        ]
                    }
                ],
