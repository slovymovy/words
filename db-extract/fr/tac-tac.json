                "senses": [
                    {
                        "sense_id": "9a963b40-a821-3d0f-923a-0573561884c5",
                        "entry_id": "ce8538c9-d0f4-3881-b7c7-d11c9859d293",
                        "glosses": [
                            "Bruit réglé, sec et fort, qui se renouvelle à temps égaux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fee818bb-8dbb-42a7-a717-767fde78927e",
                                "sense_id": "9a963b40-a821-3d0f-923a-0573561884c5",
                                "text": "Le tac-tac assourdissant de la mitrailleuse vietnamienne."
                            },
                            {
                                "example_id": "ebf01b02-7fa8-41f5-bded-d5ed0bc49886",
                                "sense_id": "9a963b40-a821-3d0f-923a-0573561884c5",
                                "text": "N’avancez pas davantage ! cria encore Jarry en mettant fin à l’affreux tac-tac de l’engin."
                            },
                            {
                                "example_id": "0c945646-9ad4-45c7-b4ec-79c20efc90e2",
                                "sense_id": "9a963b40-a821-3d0f-923a-0573561884c5",
                                "text": "Au moment de l'absoute, alors que le curé tournait autour du catafalque en faisant cliqueter à petits coups l'encensoir sur sa chaîne, un tac-tac de talons aiguilles sur les dalles fit se retourner tout le clan : flageolante et les yeux battus, arrivait Salomé."
                            },
                            {
                                "example_id": "95199951-a7b6-4959-bd10-194febd4a78b",
                                "sense_id": "9a963b40-a821-3d0f-923a-0573561884c5",
                                "text": "Elle entendait dans sa poitrine, comme un roulement continu ; et le sang frappait à ses tempes : tac-tac, tac-tac… si ça n’était pas un rêve, si elle allait enfin pouvoir travailler paisiblement, sans se demander comment régler son loyer, ses impôts ?"
                            }
                        ]
                    },
                    {
                        "sense_id": "8f1e3edc-8689-34bf-b8cf-6765226d4eaa",
                        "entry_id": "ce8538c9-d0f4-3881-b7c7-d11c9859d293",
                        "glosses": [
                            "Jeu constitué de deux boules de plastique dur ayant connu un succès éphémère au début des années 1970 en France."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fca74786-38fa-40a6-a054-5ce955a04a6d",
                                "sense_id": "8f1e3edc-8689-34bf-b8cf-6765226d4eaa",
                                "text": "Retrouvez le tac-tac de notre enfance. C'est un jouet culte des années 70. – Le but est de faire rebondir les 2 boules une contre l'autre."
                            }
                        ]
                    }
