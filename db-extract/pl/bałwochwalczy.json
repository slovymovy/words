                                    {
                                        "sense_id": "35eb3e02-3ac3-3039-b278-d3f59ae32ba7",
                                        "entry_id": "71cda698-8a7c-3bfc-88b9-ece1d398e3d4",
                                        "glosses": [
                                            "Engaging in excessive attachment or reverence; inordinately or profanely devoted."
