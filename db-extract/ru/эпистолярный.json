                    },
                    {
                        "translation_id": "cf207ac4-6def-445d-89bb-27c02dbc48fd",
                        "source_entry_id": "7fa5aec0-6a49-363d-94f4-d7eb41fe9f53",
                        "target_lang_word": "epistolarny",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "d5a283e7-fb26-4a95-a2a9-c8c6ab7f119f",
                        "source_entry_id": "7fa5aec0-6a49-363d-94f4-d7eb41fe9f53",
                        "target_lang_word": "épistolaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "épistolaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6672a61d-165d-3af1-964f-93a15093e0a3",
                                        "entry_id": "d6dce730-69d9-3f34-ba4a-16ddaf79be8b",
                                        "glosses": [
                                            "Qui concerne la correspondance par lettres, relatif à l’écriture des lettres, à la manière de les écrire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db0d3390-63bf-4b2e-8f15-3be9ccca2a9f",
                                                "sense_id": "6672a61d-165d-3af1-964f-93a15093e0a3",
                                                "text": "[…], il se demanda ce que la duchesse de Chaulieu devait penser de son séjour au Havre aggravé par un silence épistolaire de quatorze jours, alors qu’à Paris ils s’écrivaient l’un l’autre quatre ou cinq lettres par semaine."
                                            },
                                            {
                                                "example_id": "9f6c638c-7ceb-40c3-bdf5-e439d00040a4",
                                                "sense_id": "6672a61d-165d-3af1-964f-93a15093e0a3",
                                                "text": "La dame ne comptait pas s'en tenir aux préambules épistolaires, puisqu'elle lui annonçait un prochain rendez-vous, sous prétexte de lui donner des nouvelles d'Héva, […]."
                                            },
                                            {
                                                "example_id": "2a5e265b-b2b2-4fc8-8089-af9cd61e8e9f",
                                                "sense_id": "6672a61d-165d-3af1-964f-93a15093e0a3",
                                                "text": "On peut se passer d'enseigner aux femmes le style épistolaire. Elles le savent d'instinct. Ce sont elles qui pourraient nous l'apprendre."
                                            },
                                            {
                                                "example_id": "3523fe4e-30a2-4ec9-8ca6-4e047b1c5ceb",
                                                "sense_id": "6672a61d-165d-3af1-964f-93a15093e0a3",
                                                "text": "Mon cher fils,\nJ’aime beaucoup l’échange épistolaire que nous entretenons depuis que tu vis sur un autre continent."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "épistolaire",
