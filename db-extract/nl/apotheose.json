                ],
                "translations": [
                    {
                        "translation_id": "92f0210c-394f-4978-9995-7b5cce58e950",
                        "source_entry_id": "c6a57d93-6285-37b5-b399-00642b1a3b3e",
                        "target_lang_word": "Apotheose",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Apotheose",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "72bf39c0-ac95-3b4e-a4a1-fcb0c044f9c4",
                                        "entry_id": "3477a3de-4b98-32fd-a4c1-13851a4d4b27",
                                        "glosses": [
                                            "die Erklärung eines Menschen zu einer Gottheit"
                                        ],
                                        "tags": [
                                            "gehoben"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "842b09de-e6ab-4d64-a014-a574e052769e",
                                                "sense_id": "72bf39c0-ac95-3b4e-a4a1-fcb0c044f9c4",
                                                "text": "„Die Apotheose früherer, bedeutender Persönlichkeiten war immer wieder Thema der bildenden Kunst.“"
                                            },
                                            {
                                                "example_id": "40f043b4-b029-471b-ae0f-3693bcae9a9a",
                                                "sense_id": "72bf39c0-ac95-3b4e-a4a1-fcb0c044f9c4",
                                                "text": "„Viele antike griechische Komödien enden mit einer Apotheose,“"
                                            },
                                            {
                                                "example_id": "d116e8d3-7ca5-4f40-8ae9-2199f16392fc",
                                                "sense_id": "72bf39c0-ac95-3b4e-a4a1-fcb0c044f9c4",
                                                "text": "„In Friedrich Hölderlins brennend idealistischer Romantik des Jahres 1796 wird Deutschland als ein metaphysisches Gebilde ohne politische Grenzen oder zeitliche Dauer geschildert; für ein solches Ideal zu sterben bedeutete schlichtweg Apotheose.“"
                                            },
                                            {
                                                "example_id": "2b7c1226-0096-4f51-87b6-9e6064537bba",
                                                "sense_id": "72bf39c0-ac95-3b4e-a4a1-fcb0c044f9c4",
                                                "text": "„Ich saß mitten in einer Apotheose, ja, jetzt war ich tatsächlich Gott, so göttlich beschenkt, so überhäuft.“"
                                            },
                                            {
                                                "example_id": "02198083-5447-4fcb-a6a8-f3b5164b12c6",
                                                "sense_id": "72bf39c0-ac95-3b4e-a4a1-fcb0c044f9c4",
                                                "text": "„Ich habe ihm das vor sechunddreißig Jahren gesagt, und der große Genius hat mir geglaubt und meine Sorge geteilt; nichts kann nun seiner Apotheose im Wege stehen, wenn nicht ein großer Vorhang, den zuzuziehen nicht seine Aufgabe sein sollte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0f9d643c-e25f-45a0-8dd6-ae28b6e4e270",
                        "source_entry_id": "c6a57d93-6285-37b5-b399-00642b1a3b3e",
                        "target_lang_word": "apotheosis",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "apotheosis",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3498a4ed-ddc1-3702-8ba0-62e8e6e4f8b5",
                                        "entry_id": "6192ea0d-c742-3837-a57f-2f06e5143851",
                                        "glosses": [
                                            "The fact or action of becoming or making into a god; deification."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d7071169-6394-437c-aef2-fef74e3349d4",
                                                "sense_id": "3498a4ed-ddc1-3702-8ba0-62e8e6e4f8b5",
                                                "text": "In Rome itself the official position was clear: the apotheosis of the emperor took place only after his death; this had to be officially recognized by the Senate, and only then did the emperor become a divus with an official cult."
                                            },
                                            {
                                                "example_id": "93fd5a05-ee2e-4945-a895-fea9ea4be4a1",
                                                "sense_id": "3498a4ed-ddc1-3702-8ba0-62e8e6e4f8b5",
                                                "text": "As a former mortal who underwent apotheosis, Hercules was important to the emperors."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c6d255ec-2865-3b31-ac6b-1c6af0e4cd37",
                                        "entry_id": "6192ea0d-c742-3837-a57f-2f06e5143851",
                                        "glosses": [
                                            "Glorification, exaltation; crediting someone or something with extraordinary power or status."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b43113c0-4766-499c-bb5c-0c5c7fc2fa56",
                                                "sense_id": "c6d255ec-2865-3b31-ac6b-1c6af0e4cd37",
                                                "text": "The turn of the century saw the apotheosis of digital technology."
                                            },
                                            {
                                                "example_id": "98cf8c3c-4a83-4913-8ddd-20a104146048",
                                                "sense_id": "c6d255ec-2865-3b31-ac6b-1c6af0e4cd37",
                                                "text": "In the eyes of Mr. Farquhar Fenelon Cooke the apotheosis of the Celebrity was complete. The people of Asquith were not only willing to attend the house-warming, but had been worked up to the pitch of eagerness. The Celebrity as a matter of course was master of ceremonies."
                                            },
                                            {
                                                "example_id": "e429b82c-bf74-4453-bb3f-5b31fc0d17f6",
                                                "sense_id": "c6d255ec-2865-3b31-ac6b-1c6af0e4cd37",
                                                "text": "Thereafter, the caterpillar achieved a sort of posthumous apotheosis. From local authority to the Dorchester magistrates, from the Dorchester magistrates to a Divisional Court presided over by the Lord Chief Justice of England, from the Lord Chief Justice to the House of Lords, the immolated insect has at length plodded its methodical way to the highest tribunal in the land."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "756cca97-2bc0-31dc-bcf1-68060095c853",
                                        "entry_id": "6192ea0d-c742-3837-a57f-2f06e5143851",
                                        "glosses": [
                                            "A glorified example or ideal; the apex or pinnacle (of a concept or belief)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "998a8dc9-28b2-4f1e-85d3-c421734628a1",
                                                "sense_id": "756cca97-2bc0-31dc-bcf1-68060095c853",
                                                "text": "In his despair he had nowhere to turn. It is the very apotheosis of the place and the time."
                                            },
                                            {
                                                "example_id": "25c8fe41-885d-46c3-9125-e7b9b4009c0b",
                                                "sense_id": "756cca97-2bc0-31dc-bcf1-68060095c853",
                                                "text": "In 2009, in the course of It Felt Like A Kiss, the sublime theatre event Curtis put on with Punchdrunk about the birth of hyper-consumerism, I was separated from the audience and sent down a long, dark corridor, which I took to represent the apotheosis of individualism."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f0ffc5e5-d5e1-3ce9-9194-405f48e21124",
                                        "entry_id": "6192ea0d-c742-3837-a57f-2f06e5143851",
                                        "glosses": [
                                            "The best moment or highest point in the development of something, for example of a life or career; the apex, culmination, or climax (of a development)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "355de804-bb43-44e1-8f4c-736f897e45db",
                                                "sense_id": "f0ffc5e5-d5e1-3ce9-9194-405f48e21124",
                                                "text": "The apotheosis of her career was her appointment as chairman."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6c4c0151-39ac-3e89-885d-7e846ceee6ab",
                                        "entry_id": "6192ea0d-c742-3837-a57f-2f06e5143851",
                                        "glosses": [
                                            "Release from earthly life, ascension to heaven; death."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8d77f8c8-54ec-49a6-a6e8-e5e4cc994421",
                                                "sense_id": "6c4c0151-39ac-3e89-885d-7e846ceee6ab",
                                                "text": "Bear thee grimly, demigod! Up from the spray of thy ocean-perishing — straight up, leaps thy apotheosis!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "078d8fbf-bac6-3179-8710-fd02dcf718c4",
                                        "entry_id": "6192ea0d-c742-3837-a57f-2f06e5143851",
                                        "glosses": [
                                            "The latent entity that mediates between a person's psyche and their thoughts. The id, ego and superego in Freudian Psychology are examples of this."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0c117bf4-a870-4def-80ed-abfad3f37a59",
                        "source_entry_id": "c6a57d93-6285-37b5-b399-00642b1a3b3e",
