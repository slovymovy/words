                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ce55541c-1153-40c8-b294-809e47f927bc",
                        "source_entry_id": "657ac7b0-604c-34bf-a3e2-1b74a03964c7",
                        "source_sense_description": "intervention, interposition",
                        "target_lang_word": "entremise",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "entremise",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "177f52cd-c006-37d2-bc79-af6d4db5b8c6",
                                        "entry_id": "b6a158b9-a30a-323f-bb6e-3a28fa5e80eb",
                                        "glosses": [
                                            "Action de s’entremettre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10a79047-035b-43aa-bff4-1fda9f84e24a",
                                                "sense_id": "177f52cd-c006-37d2-bc79-af6d4db5b8c6",
                                                "text": "Le Duc. – Oui, certes, c’est mon entremetteur ; mais croyez que son entremise, si elle nuit à quelqu’un, ne me nuira pas."
                                            },
                                            {
                                                "example_id": "5ff43a95-b03f-424a-86d9-9c81b41c253c",
                                                "sense_id": "177f52cd-c006-37d2-bc79-af6d4db5b8c6",
                                                "text": "Cette mécanique que Buridan enseignait rue du Fouarre, aux environs de 1350, pénétra dans l'Italie de la Renaissance, par l'entremise de Jules César Scaliger, qui en fut le porte-parole."
                                            },
                                            {
                                                "example_id": "b7b5139b-7080-4d18-9df7-7f804b6bb916",
                                                "sense_id": "177f52cd-c006-37d2-bc79-af6d4db5b8c6",
                                                "text": "Il eut recours à son entremise pour réussir."
                                            },
                                            {
                                                "example_id": "b73e9936-39a7-48a7-821c-cbb8583c877f",
                                                "sense_id": "177f52cd-c006-37d2-bc79-af6d4db5b8c6",
                                                "text": "La paix se fit par l’entremise des puissances neutres."
                                            },
                                            {
                                                "example_id": "ea555630-f8b9-47f1-950b-604816495720",
                                                "sense_id": "177f52cd-c006-37d2-bc79-af6d4db5b8c6",
                                                "text": "Il leur offrit son entremise."
                                            },
                                            {
                                                "example_id": "18392edf-dee5-4c96-b84c-78995fa4c41f",
                                                "sense_id": "177f52cd-c006-37d2-bc79-af6d4db5b8c6",
                                                "text": "J’ai conclu ce marché par l’entremise de mon correspondant."
                                            },
                                            {
                                                "example_id": "0950b985-dd00-40e4-b77d-57723da87639",
                                                "sense_id": "177f52cd-c006-37d2-bc79-af6d4db5b8c6",
                                                "text": "Mais parler de « réalité » est déjà sauter une étape. En fait, la masse ne deviendrait « réalité » que par l’entremise des êtres qui la croisent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "286997a4-9b0e-3ac2-9d28-006b2f512772",
                                        "entry_id": "b6a158b9-a30a-323f-bb6e-3a28fa5e80eb",
                                        "glosses": [
                                            "Pièce de bois que l'on rajoute contre deux autres pour les raffermir."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "87e6b42b-afb9-3c2c-bbc8-2bc748a5090d",
                                        "entry_id": "b6a158b9-a30a-323f-bb6e-3a28fa5e80eb",
                                        "glosses": [
                                            "Arc-boutant encastrés dans les baux et les barrots pour qu'ils restent parallèles."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a31b0a63-d984-3840-9b5b-c0d2ec92bdb9",
                                        "entry_id": "b6a158b9-a30a-323f-bb6e-3a28fa5e80eb",
                                        "glosses": [
                                            "Pièce de bois sur lesquelles reposent les surbaux des écoutilles."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
