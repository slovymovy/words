                        "translation_id": "9ada1f28-6862-41b3-ac5e-eae94ac9c243",
                        "source_entry_id": "5dd25ada-917f-3328-b31e-9f70152aa5b1",
                        "source_sense_id": "00a77af6-8690-3cba-bf13-e8bf48d141c8",
