    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "d33a3d53-bb52-368b-aa5c-1a7201db830d",
                "word": "rotisserie",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "8cf128e0-5513-4e82-933d-0d8837ff9b84",
                        "entry_id": "d33a3d53-bb52-368b-aa5c-1a7201db830d",
                        "tags": [
                            "plural"
                        ],
                        "form": "rotisseries"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "69682262-5f36-36b1-9529-4cc637e91704",
                        "entry_id": "d33a3d53-bb52-368b-aa5c-1a7201db830d",
                        "glosses": [
                            "A cooking device with which food is roasted on a rotating spit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0896907d-ad8d-4c03-876a-c4d55ed8e887",
                                "sense_id": "69682262-5f36-36b1-9529-4cc637e91704",
                                "text": "There will be no more misery / When the world is our rotisserie"
                            },
                            {
                                "example_id": "7478233b-cf07-47e3-b528-fd57307fe152",
                                "sense_id": "69682262-5f36-36b1-9529-4cc637e91704",
                                "text": "Rotisseries are essentially self-basting because most of the juices stay on the meat and distribute across it while the rotisserie is being turned."
                            },
                            {
                                "example_id": "ffe03066-1d77-40cb-af61-727f100c873d",
                                "sense_id": "69682262-5f36-36b1-9529-4cc637e91704",
                                "text": "Rotisseries cook with dry heat, but the continual rotation of foods as they cook helps maintain their natural juices."
                            },
                            {
                                "example_id": "9a08766a-4e30-491e-b8cb-d97f3e19b938",
                                "sense_id": "69682262-5f36-36b1-9529-4cc637e91704",
                                "text": "The Italians are famous for their little windup rotisseries that cook in wood—burning ovens."
                            },
                            {
                                "example_id": "df52f6c7-e27c-4f7a-a9d0-a26a14e97e39",
                                "sense_id": "69682262-5f36-36b1-9529-4cc637e91704",
                                "text": "Rotisserie broilers cook meats and other foods by turning them slowly in front of electric or gas-powered heating elements."
                            }
                        ]
                    },
                    {
                        "sense_id": "6e17206b-1ccb-3055-b2fd-338415c9aa1d",
                        "entry_id": "d33a3d53-bb52-368b-aa5c-1a7201db830d",
                        "glosses": [
                            "A shop or restaurant selling food cooked in this manner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10ff3c11-03b2-4e99-b40f-41ca12b0b0bc",
                                "sense_id": "6e17206b-1ccb-3055-b2fd-338415c9aa1d",
                                "text": "Restaurants, chop-houses, rotisseries, abound in every part^([of San Francisco])."
                            },
                            {
                                "example_id": "bd4f3190-7af3-4621-afd5-f3e30f1b9eb5",
                                "sense_id": "6e17206b-1ccb-3055-b2fd-338415c9aa1d",
                                "text": "We refuse to be drawn into the debate over which of St. Barts' two rotisseries is the best. They're both good."
                            },
                            {
                                "example_id": "dc80f739-986e-4e0c-a960-5ca3a5b83e28",
                                "sense_id": "6e17206b-1ccb-3055-b2fd-338415c9aa1d",
                                "text": "Rue Chaouia, opposite the central market, is the best place for a quick bite, with a line of rotisseries, stalls and restaurants serving roast chicken, brochettes and sandwiches until past midnight."
                            }
                        ]
                    },
                    {
                        "sense_id": "85a3d913-9dc5-3cc4-9c8b-6598feff52ea",
                        "entry_id": "d33a3d53-bb52-368b-aa5c-1a7201db830d",
                        "glosses": [
                            "Ellipsis of rotisserie baseball, synonym of fantasy baseball."
                        ],
                        "tags": [
                            "US",
                            "abbreviation",
                            "alt-of",
                            "ellipsis"
                        ],
                        "examples": []
                    },
