                    },
                    {
                        "form_id": "9a824e6f-b0eb-4403-9742-5066d70b85b3",
                        "entry_id": "3fcf22cd-7078-3e22-aed6-7b75f88a7aab",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Deutschlehrerinnen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "868aecf3-2f49-39b0-b97e-baf61d7a9c7a",
                        "entry_id": "3fcf22cd-7078-3e22-aed6-7b75f88a7aab",
                        "glosses": [
                            "Lehrerin, die Deutsch unterrichtet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b5a26449-9cd7-4eee-b7b0-b6989c462926",
                                "sense_id": "868aecf3-2f49-39b0-b97e-baf61d7a9c7a",
                                "text": "Um sich die Reise zu finanzieren, arbeitet sie als Deutschlehrerin an einer Nachhilfeschule."
                            },
                            {
                                "example_id": "861bdff7-026d-4807-b8db-34d28fb49d6d",
                                "sense_id": "868aecf3-2f49-39b0-b97e-baf61d7a9c7a",
                                "text": "„Davon sollten nicht zuletzt diejenigen unserer Studierenden profitieren, die Deutschlehrerinnen und Deutschlehrer werden, denn sie vermitteln ganz wesentlich zwischen Linguistik und Öffentlichkeit.“"
                            },
                            {
                                "example_id": "2c466dca-88b6-43a4-ab01-0d897d3252ea",
                                "sense_id": "868aecf3-2f49-39b0-b97e-baf61d7a9c7a",
                                "text": "„Die Deutschlehrerin gab den Inhalt dieses Gespräches weiter, und die Heimatliebe der Syrer stieß bei den Brandenburgern auf großes Verständnis und sorgte sofort für gesteigerte Toleranz im Dorf.“"
                            },
                            {
                                "example_id": "d1eb5e89-af48-4b1b-8210-10eb3ece6a93",
                                "sense_id": "868aecf3-2f49-39b0-b97e-baf61d7a9c7a",
                                "text": "„Sie ist Einzelkind, hat Hauswirtschaftslehre studiert, war Deutschlehrerin in England, hat als Kinderkrankenschwester gearbeitet und zehn Jahre lang ihren erblindeten Vater betreut.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
