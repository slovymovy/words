    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b6720440-2601-335a-8a07-b99319a38c68",
                    "sense_definition": "Discipline intellectuelle et rationnelle qui s'interroge sur la nature du monde, la pensée, la morale et l'existence humaine.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "discipline",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Socrate et Platon sont deux figures incontournables qui ont profondément marqué la <w>philosophie</w> occidentale."
                        },
                        {
                            "text": "Ce penseur contemporain consacre ses recherches aux liens entre les sciences modernes et la <w>philosophie</w>."
                        }
                    ],
                    "common_phrases": [
                        "histoire de la philosophie",
                        "étudier la philosophie"
                    ]
                },
                {
                    "sense_id": "a714a20f-df19-306a-ac45-1b3bb13a98db",
                    "sense_definition": "Ensemble d'idées, doctrine ou vision globale guidant l'action ou la conception du monde d'une personne ou d'un groupe.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "conception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sa <w>philosophie</w> de vie consiste à profiter du moment présent sans s'inquiéter inutilement de l'avenir."
                        },
                        {
                            "text": "Cette entreprise moderne applique une <w>philosophie</w> fondée sur le respect de l'environnement et de l'humain."
                        }
                    ],
                    "synonyms": [
                        "doctrine",
                        "idéologie",
                        "morale"
                    ],
                    "common_phrases": [
                        "philosophie de vie"
                    ]
                },
                {
                    "sense_id": "2686f611-ee91-34e7-9996-bfc0f73a2b1d",
                    "sense_definition": "Matière scolaire ou universitaire consacrée à l'apprentissage de cette discipline intellectuelle.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "discipline",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tous les lycéens doivent passer une épreuve écrite de <w>philosophie</w> à la fin de leur cursus scolaire."
                        },
                        {
                            "text": "Notre professeur de <w>philosophie</w> nous encourage toujours à développer notre esprit critique et argumentatif."
                        }
                    ],
                    "common_phrases": [
                        "cours de philosophie",
                        "professeur de philosophie",
                        "épreuve de philosophie"
                    ]
                },
                {
                    "sense_id": "58bddb9c-7fe1-3af8-a28e-49109edfd389",
                    "sense_definition": "Attitude de calme, de sérénité et de résignation face aux difficultés et aux imprévus de la vie.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "attitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Malgré l'échec inattendu de son projet, elle a accueilli cette déception avec <w>philosophie</w>."
                        },
                        {
                            "text": "Il faut savoir faire preuve de <w>philosophie</w> pour surmonter les petits tracas du quotidien sans stresser."
                        }
                    ],
                    "synonyms": [
                        "calme",
                        "résignation",
                        "sérénité",
                        "stoïcisme"
                    ],
                    "antonyms": [
                        "affolement",
                        "inquiétude"
                    ],
                    "common_phrases": [
                        "avec philosophie",
                        "prendre avec philosophie"
                    ]
                }
            ]
        }
    ]
}