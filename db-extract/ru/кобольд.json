                                        "entry_id": "e395b834-7b07-360b-adb9-f083e68b0ab7",
                                        "glosses": [
                                            "Génie familier de la mythologie allemande, gobelin, lutin."
                                        ],
                                        "tags": [
                                            "Fantastique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a1eed77d-e2a9-414c-8ce5-52f1fa5aa7b9",
                                                "sense_id": "232d50e0-9d93-3957-ad6c-a7efbd50b687",
                                                "text": "Dans l’herbe noire\nLes Kobolds vont.\nLe vent profond\nPleure, on veut croire."
                                            },
                                            {
                                                "example_id": "52cfc55b-65ab-4e6e-b80d-ba8e832fd488",
                                                "sense_id": "232d50e0-9d93-3957-ad6c-a7efbd50b687",
                                                "text": "Le goguelin est sans abri, depuis la disparition du bateau à voiles, même un kobold tapi derrière le fourneau ou le chauffage central n’est pas inquiétant, mais ridicule et insipide."
                                            }
                                        ]
                                    }
