            "senses": [
                {
                    "sense_id": "1d961eff-89d4-313b-b90f-25903f0f2505",
                    "sense_definition": "Créature légendaire ou mythologique, d'apparence humaine mais de très petite taille.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "mythologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans ce conte de fées, un vieux <w>nain</w> aide la princesse à traverser la forêt."
                        },
                        {
                            "text": "Blanche-Neige habite dans une petite maison cachée dans les bois avec sept <w>nains</w>."
                        }
                    ],
                    "synonyms": [
                        "gnome",
                        "lutin",
                        "farfadet",
                        "korrigan"
                    ],
                    "antonyms": [
                        "géant"
                    ],
                    "common_phrases": [
                        "sept nains"
                    ]
                },
                {
                    "sense_id": "dc078fc3-8345-34f7-a39a-40452becdd4c",
                    "sense_definition": "Personne atteinte de nanisme, d'une taille nettement inférieure à la moyenne.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "personne",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Au Moyen Âge, chaque cour royale employait un <w>nain</w> pour divertir les invités."
                        },
                        {
                            "text": "Cet acteur est un <w>nain</w> célèbre qui a joué dans de nombreux films d'aventure."
                        }
                    ],
                    "synonyms": [
                        "lilliputien",
                        "pygmée"
                    ],
                    "antonyms": [
                        "géant"
                    ]
                },
                {
                    "sense_id": "f58a9230-f510-3ef4-9e83-577d5ca3a49f",
                    "sense_definition": "Statuette décorative, souvent coiffée d'un bonnet rouge, placée à l'extérieur.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "decoration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mon voisin a installé un nouveau <w>nain</w> de jardin au milieu de sa pelouse."
                        },
                        {
                            "text": "Elle collectionne chaque <w>nain</w> en céramique qu'elle trouve dans les brocantes."
