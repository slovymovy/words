                "senses": [
                    {
                        "sense_id": "1669282d-99c5-3c44-8fd5-63eb10c307af",
                        "entry_id": "2b24590c-b9c0-3d82-a048-a3c7be67b93b",
                        "glosses": [
                            "Rendre à nouveau présent."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99816f65-3bf2-4b6e-9a91-9cb1a08cb85f",
                                "sense_id": "1669282d-99c5-3c44-8fd5-63eb10c307af",
                                "text": "De la même façon qu’il essaiera de corriger les dommages collatéraux de sa charge contre La Princesse de Clèves lors d’un discours en février 2006 (œuvre susceptible d'être au programme de concours administratifs, ce dont il s’étonnait en maniant une ironie jugée méprisante) en évoquant devant des journalistes ou des intellectuels reçus à l’Elysée son goût pour la lecture de classiques ainsi que son penchant pour les grands classiques du cinéma (y compris l’œuvre austère de Dreyer…), Nicolas Sarkozy tentera au cours du quinquennat de se « représentialiser »."
                            },
                            {
                                "example_id": "1ff7f116-cc5e-4d7a-9b1c-1e95cc4eb7ea",
                                "sense_id": "1669282d-99c5-3c44-8fd5-63eb10c307af",
                                "text": "Se représentialiser signifierait qu'il eut été président!"
                            }
                        ]
                    }
