                "senses": [
                    {
                        "sense_id": "7e8be40e-3c7d-333b-87d0-edbef2072916",
                        "entry_id": "38dcc999-5b67-3411-b991-694a1429332a",
                        "glosses": [
                            "Donner un caractère de réseau à quelque chose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3635f1b0-3c52-4e17-b64b-6d6b521a6665",
                                "sense_id": "7e8be40e-3c7d-333b-87d0-edbef2072916",
                                "text": "En effet, les technologies du numérique dans leur ensemble (et pas seulement celles du réseau) ont tendance à réticulariser tout ce qu’elles touchent, à décomposer ce qui est décomposable."
                            },
                            {
                                "example_id": "37e94815-45b1-45e1-be67-e6c54a178bf3",
                                "sense_id": "7e8be40e-3c7d-333b-87d0-edbef2072916",
                                "text": "Ils semblent se réticulariser, à la fois par la multiplication des réseaux et par la multiplication des lieux disponibles."
                            }
                        ]
                    }
