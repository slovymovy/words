                                "example_id": "d029d400-c8ae-4223-92fb-43a785eba9f5",
                                "sense_id": "129287ea-ee29-316f-81a9-bc557d56337e",
                                "text": "And Abraham stood up from before his dead, and spake unto the sons of Heth, saying,"
                            }
                        ]
                    }
