                            {
                                "example_id": "7b6d0dd9-af41-40ac-a741-4425c4bd8e53",
                                "sense_id": "2d00b991-5929-3773-9287-e62ec0ce56c5",
                                "text": "Georges Fotinos estime en outre que l’annualisation permettrait d’éviter le burnout de certains enseignants."
                            },
                            {
                                "example_id": "10746b4b-aefe-420b-b384-9aa594cc0131",
                                "sense_id": "2d00b991-5929-3773-9287-e62ec0ce56c5",
                                "text": "Mais il faut dire que j’ai subi un burnout et que j’ai passé une semaine au lit après Londres."
                            },
                            {
                                "example_id": "8c9b0e2a-89fe-4b4f-821c-320258ae6a48",
                                "sense_id": "2d00b991-5929-3773-9287-e62ec0ce56c5",
                                "text": "Selon mes observations, un burnout est indicatif d’un pardon à faire avec le parent du même sexe ; une dépression, avec le parent du sexe opposé et l’angoisse, surtout envers soi-même."
                            }
                        ]
