                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The locker room smelled pretty <w>ripe</w> after the football game.",
                            "target_lang_translations": {
                                "ru": "После футбольного матча в раздевалке пахло довольно <w>ду́рно</w>.",
                                "de": "Die Umkleidekabine roch nach dem Fußballspiel ziemlich <w>übel</w>."
                            }
                        },
                        {
                            "text": "There was a <w>ripe</w> odor coming from the garbage bin.",
                            "target_lang_translations": {
                                "ru": "Из мусорного бака доносился <w>воню́чий</w> запах.",
