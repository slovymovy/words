                        "glosses": [
                            "een tijdshoeveelheid van een bepaalde orde van grootte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "049cc6d7-d392-408c-8437-982de6d7e2f0",
                                "sense_id": "e1a951ab-50c0-3b0a-8595-4b9a68951d80",
                                "text": "En nu? Is het nog reëel om ons zorgen te maken over een eventuele ijstijd, terwijl we in het nieuws steeds weer horen over de opwarming van de aarde? Dat hangt ervan af op welke tijdsschaal we kijken."
                            },
                            {
                                "example_id": "79b4c91d-a5e7-414f-b7f0-cb05aa3df2cf",
                                "sense_id": "e1a951ab-50c0-3b0a-8595-4b9a68951d80",
                                "text": "Op een tijdsschaal van duizenden jaren is het reëler dat we ons zorgen maken over opwarming, wijzen klimaatmodellen uit."
                            }
                        ]
                    }
