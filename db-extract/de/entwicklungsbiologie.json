                            {
                                "example_id": "6f01f76c-2986-40c7-b454-8519e2621b52",
                                "sense_id": "8f52b6c6-8d5f-37ac-8061-346174b0392e",
                                "text": "„In Bereichen wie der Stammzellforschung und der Entwicklungsbiologie ist aber die Maus das Versuchstier der Wahl.“"
                            },
                            {
                                "example_id": "767406a1-7ca9-4e66-a713-8132ccaceb3e",
                                "sense_id": "8f52b6c6-8d5f-37ac-8061-346174b0392e",
                                "text": "„Das Max-Planck-Institut für Entwicklungsbiologie ist ein schicker, moderner Bau über den Hügeln von Tübingen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
