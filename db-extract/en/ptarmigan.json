                        "target_lang_word": "ptarmigan",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ptarmigan",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "70e02f0a-336e-3da6-9397-6f2363ba7aeb",
                                        "entry_id": "50f35562-32e2-37a4-89ca-f0d0ac51c5de",
                                        "glosses": [
                                            "Un des noms du lagopède."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8f4d18ef-1756-458b-8df7-1acac938deff",
                                                "sense_id": "70e02f0a-336e-3da6-9397-6f2363ba7aeb",
                                                "text": "Les perdrix, les ptarmigans, fuyant vers des régions plus tempérées, passaient en grand nombre, et fournirent une viande fraîche et saine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a398157-655b-3b05-9c3e-1ebc446199b8",
                                        "entry_id": "50f35562-32e2-37a4-89ca-f0d0ac51c5de",
                                        "glosses": [
                                            "Synonyme de lagopède alpin."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "501c548f-53de-4f84-98a7-4d79061fad75",
                                                "sense_id": "6a398157-655b-3b05-9c3e-1ebc446199b8",
                                                "text": "Parmi ces proies, le ptarmigan (lagopède des Alpes) se nourrit de baies et de feuilles vertes et le bruant des neiges surtout d'insectes phytophages."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d4f90e8a-d994-4922-88ce-a62551e117e7",
                        "source_entry_id": "45d1fb9a-f93e-3adb-97c0-9a04630f8e5d",
                        "source_sense_id": "9aecfaa0-a337-381b-b89a-0b62218d5117",
                        "source_sense_description": "a small grouse, Lagopus",
                        "target_lang_word": "lagopède",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lagopède",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "321777cf-67e0-3db9-a836-7271ea6f9d35",
                                        "entry_id": "0de1e648-e202-3fe8-b5f7-9fba0a2a1cf5",
                                        "glosses": [
                                            "Genre de petit gallinacé de la sous-famille des tétraoninés (tétras, gélinottes et alliés) comprenant trois espèces des régions boréales ou arctiques, aux pattes emplumées et au plumage hivernal presqu’entièrement d’un blanc immaculé (sauf chez le lagopède d’Écosse)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b293fa13-5b48-4b43-a4be-ed346ad21289",
                                                "sense_id": "321777cf-67e0-3db9-a836-7271ea6f9d35",
                                                "text": "En quelques jours, le lagopède a couvert de fange son habit opalin."
                                            },
                                            {
                                                "example_id": "dd83d7f3-b142-42ea-a524-8f4aca55639f",
                                                "sense_id": "321777cf-67e0-3db9-a836-7271ea6f9d35",
                                                "text": "On débusqua des lagopèdes que les rafales propulsaient. Ils venaient de passer l’hiver dans un trou de neige ménagé par leurs soins où ils avaient maintenu la juste température pour survivre."
                                            },
                                            {
                                                "example_id": "1d3c3847-71c1-49f3-b06f-9e34239b7c76",
                                                "sense_id": "321777cf-67e0-3db9-a836-7271ea6f9d35",
                                                "text": "On était le dix-huit août - juste après le Douze Glorieux, jour de l’ouverture de la chasse au lagopède d’Écosse. Ils chassaient la grouse."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "29ea50fe-6e28-42b5-8887-264d6fc446a8",
                        "source_entry_id": "45d1fb9a-f93e-3adb-97c0-9a04630f8e5d",
                        "source_sense_id": "9aecfaa0-a337-381b-b89a-0b62218d5117",
                        "source_sense_description": "a small grouse, Lagopus",
                        "target_lang_word": "Schneehuhn",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schneehuhn",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a4dff10e-063b-3361-a151-ad180539afa6",
                                        "entry_id": "f1b0620a-1f74-3e76-b640-d5a0aea1cd42",
                                        "glosses": [
                                            "kleiner Hühnervogel, der vor allem in Nordamerika, im nördlichen Teil Eurasiens sowie im Hochgebirge und Tundra Eurasiens lebt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe17c8b9-5f01-4ddf-adc0-b0cb5ca85f00",
                                                "sense_id": "a4dff10e-063b-3361-a151-ad180539afa6",
                                                "text": "„Am Nachmittag sichtete ein anderer ein ganzes Rudel Schneehühner.“"
                                            },
                                            {
                                                "example_id": "2dbab07e-3905-43c7-8dff-81ad0d0783e3",
                                                "sense_id": "a4dff10e-063b-3361-a151-ad180539afa6",
                                                "text": "„Sechzehn blutige Schneehühner brachte er mit und setzte sich in die Küche, um sie zu rupfen und auszunehmen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
