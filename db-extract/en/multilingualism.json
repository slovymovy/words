                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d2c7042c-ec6b-4fc2-b59f-b3b2909159c2",
                        "source_entry_id": "ff433e35-e7a4-3d7d-94bd-7db3531ce5b8",
                        "source_sense_id": "cd192474-ae08-3ed2-99b1-dc3dcc65fda9",
