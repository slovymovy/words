                        "examples": [
                            {
                                "example_id": "db50a471-f845-4436-915a-71c05d037784",
                                "sense_id": "c864e17c-4811-3d8f-80a5-b3298ee77730",
                                "text": "„Ein weiß-gelber Vogel mit einem bunten Federbüschel auf dem Kopf klammert sich am Gitter fest und blickt sie an.“"
                            },
                            {
                                "example_id": "b8a2219e-ca08-43ac-8eea-53f78c579a8c",
                                "sense_id": "c864e17c-4811-3d8f-80a5-b3298ee77730",
                                "text": "„Auf dem Helm thronte ein weißer Federbüschel, der beim Laufen auf und ab wippte.“"
                            },
                            {
                                "example_id": "c134dd33-7f20-494f-bc1b-25014f7785fa",
                                "sense_id": "c864e17c-4811-3d8f-80a5-b3298ee77730",
                                "text": "„Dies zeichnet sich durch glänzend schwarzes Kopfgefieder mit spreizbaren, gelbroten Federbüscheln an den Kopfseiten aus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
