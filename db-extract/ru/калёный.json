                                "target_senses": [
                                    {
                                        "sense_id": "10d1a0c8-3ec5-3987-9e01-57944f25c5bf",
                                        "entry_id": "202a70c6-d528-353c-9a3b-1b4c4464aa1d",
                                        "glosses": [
                                            "Having a specified disposition or temper."
                                        ],
                                        "tags": [
                                            "in-compounds",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ead3af5-8e7c-4641-8a00-d8ecf0c6b669",
                                                "sense_id": "10d1a0c8-3ec5-3987-9e01-57944f25c5bf",
                                                "text": "even-tempered"
                                            },
                                            {
                                                "example_id": "c638569e-398c-42bd-b20b-27b6181218ce",
                                                "sense_id": "10d1a0c8-3ec5-3987-9e01-57944f25c5bf",
                                                "text": "The Pyncheon Elm, throughout its great circumference, was all alive, and full of the morning sun and a sweet-tempered little breeze, which lingered within this verdant sphere, and set a thousand leafy tongues a-whispering all at once. This aged tree appeared to have suffered nothing from the gale."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "003f429f-cb16-38c0-bf6f-3b8987322c00",
                                        "entry_id": "202a70c6-d528-353c-9a3b-1b4c4464aa1d",
                                        "glosses": [
                                            "Pertaining to the metallurgical process for finishing metals."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3fe398db-a1b0-4ba6-a01e-111ab69d7422",
                                                "sense_id": "003f429f-cb16-38c0-bf6f-3b8987322c00",
                                                "text": "\"Not forged!\" and snatching Perth's levelled iron from the crotch, Ahab held it out, exclaiming — \"Look ye, Nantucketer; here in this hand I hold his death! Tempered in blood, and tempered by lightning are these barbs; and I swear to temper them triply in that hot place behind the fin, where the white whale most feels his accursed life!\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bdb08844-d939-3cdd-88cd-37a372ab0fd2",
                                        "entry_id": "202a70c6-d528-353c-9a3b-1b4c4464aa1d",
                                        "glosses": [
                                            "Pertaining to the industrial process for toughening glass, or to such toughened glass."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "228bf589-fdea-365d-b3f2-ad6fb735e3fc",
                                        "entry_id": "202a70c6-d528-353c-9a3b-1b4c4464aa1d",
                                        "glosses": [
                                            "Moderated or balanced by other considerations."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "966cf831-6eb4-4f86-be92-2a15076aaea2",
                                                "sense_id": "228bf589-fdea-365d-b3f2-ad6fb735e3fc",
                                                "text": "The downcast eye, the rosy blush, the retiring grace, are all proper in their season; but modesty, being the child of reason, cannot long exist with the sensibility that is not tempered by reflection."
                                            },
                                            {
                                                "example_id": "431dae96-db5d-40a6-bd1e-f5419b1453e3",
                                                "sense_id": "228bf589-fdea-365d-b3f2-ad6fb735e3fc",
                                                "text": "[N]obody knows how the wind is tempered to shorn Irish lambs, and in what marvellous places they find pasture."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc77a374-ed57-3e86-9b6c-245e0ff77fd6",
                                        "entry_id": "202a70c6-d528-353c-9a3b-1b4c4464aa1d",
                                        "glosses": [
                                            "Pertaining to the well-tempered scale, where the twelve notes per octave of the standard keyboard are tuned in such a way that it is possible to play music in any major or minor key and it will not sound perceptibly out of tune."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
