                    },
                    {
                        "translation_id": "ec834544-10a0-4cc6-a905-4f729c635274",
                        "source_entry_id": "26a611d0-5327-30a7-bfcc-415d1a910947",
                        "source_sense_id": "2c0e60b8-a61d-3a09-83be-d05deb17f85c",
