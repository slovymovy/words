                ],
                "senses": [
                    {
                        "sense_id": "13ef295b-87b9-3325-ac7c-c41efc7f010d",
                        "entry_id": "9ab031f6-88a3-342e-81ca-ea1ea04cd9ba",
                        "glosses": [
                            "делать ясным, отчетливым, хорошо видимым, различимым, прозрачным"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3dbce49d-b51d-4a00-a5db-6d609f2b560a",
                                "sense_id": "13ef295b-87b9-3325-ac7c-c41efc7f010d",
                                "text": "Мне кажется, ваша бледность проясняет тёмный воздух, как свет…"
                            }
                        ]
                    },
                    {
                        "sense_id": "da093786-9f9c-38b5-8589-098890ced5da",
                        "entry_id": "9ab031f6-88a3-342e-81ca-ea1ea04cd9ba",
                        "glosses": [
                            "делать (более) ясным, понятным"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc8acb64-ee72-4112-b753-8370efb555a2",
                                "sense_id": "da093786-9f9c-38b5-8589-098890ced5da",
                                "text": "Тем самым ребенок проясняет для себя человеческий смысл этой деятельности."
                            }
                        ]
                    },
                    {
                        "sense_id": "57942503-c41a-300d-8c7f-8ba46057e60d",
                        "entry_id": "9ab031f6-88a3-342e-81ca-ea1ea04cd9ba",
                        "glosses": [
                            "возвращать или усиливать способность ясно рассуждать, чувствовать, видеть, слышать и т. п."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ac396c3f-6b8d-48a2-807d-1191b532c8b4",
                                "sense_id": "57942503-c41a-300d-8c7f-8ba46057e60d",
                                "text": "Поэтому некоторая грубость суждений идеалисту не вредна, действуя успокоительно, проясняя взор."
                            }
                        ]
                    },
                    {
                        "sense_id": "104fab22-e1ce-35c5-9b66-4d2e661c8f91",
                        "entry_id": "9ab031f6-88a3-342e-81ca-ea1ea04cd9ba",
                        "glosses": [
                            "становиться ясным, светлым, не ненастным"
                        ],
                        "tags": [
                            "безличн., неперех."
                        ],
                        "examples": [
                            {
                                "example_id": "09e8c24f-617e-4f29-a2fb-e56d702d8726",
                                "sense_id": "104fab22-e1ce-35c5-9b66-4d2e661c8f91",
                                "text": "С вечера проясняет."
                            }
                        ]
                    }
                ],
