                {
                    "sense_id": "80155482-51bf-31b6-bed7-bae417a0f8d1",
                    "sense_definition": "Not having a name or a title, especially referring to a creative work or a person without a noble rank.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "lacking_name_or_rank",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist left the <w>untitled</w> painting for the gallery to name later.",
                            "target_lang_translations": {
                                "ru": "Художник оставил картину <w>без названия</w>, чтобы галерея дала ей имя позже."
                            }
                        },
                        {
                            "text": "She found an <w>untitled</w> document on her computer and had no idea what was inside.",
                            "target_lang_translations": {
                                "ru": "Она нашла на своем компьютере <w>неозаглавленный</w> документ и понятия не имела, что в нем."
                            }
                        },
                        {
                            "text": "The collection includes an <w>untitled</w> poem written by an anonymous author.",
                            "target_lang_translations": {
                                "ru": "В сборник вошло <w>безымянное</w> стихотворение, написанное анонимным автором."
                            }
                        }
                    ],
                    "synonyms": [
                        "unnamed"
                    ],
                    "antonyms": [
                        "titled",
                        "named"
                    ],
                    "common_phrases": [
                        "untitled",
                        "untitled document",
                        "untitled poem",
                        "untitled track"
                    ],
                    "target_lang_definitions": {
