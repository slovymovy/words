                    {
                        "sense_id": "ecdec51a-7ec7-3b5f-91b2-6e6d8dd3d79d",
                        "entry_id": "eeef7925-8717-3d27-9496-8268e177fa41",
                        "glosses": [
                            "letterlijke passage die door iemand anders aangehaald wordt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d043e970-ed8c-4063-85b5-352a7098044f",
                                "sense_id": "ecdec51a-7ec7-3b5f-91b2-6e6d8dd3d79d",
                                "text": "Volgens de quote van de buurman had hij er niets mee te maken."
                            },
                            {
                                "example_id": "060d3e55-547f-4ec3-a9a6-3b45e8f57483",
                                "sense_id": "ecdec51a-7ec7-3b5f-91b2-6e6d8dd3d79d",
                                "text": "Maar ook Malala met de wereld aan haar voeten met de quote van Beyonce er overheen: ‘Who run the world? Girls!’"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
