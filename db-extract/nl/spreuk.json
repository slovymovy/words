                "translations": [
                    {
                        "translation_id": "ffc39ff9-cb5e-4ea8-acb6-3fa72f61e6cf",
                        "source_entry_id": "a6412ba9-19cd-3c71-a946-c65a7d0ad902",
                        "source_sense_id": "877719ba-1b4e-3886-bd74-da1509e1347e",
                        "source_sense_description": "zegswijze",
                        "target_lang_word": "aphorism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aphorism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6c98d8ac-92c9-3e8a-8a3d-1bc547385616",
                                        "entry_id": "46e64c94-0de3-3675-b379-c589cfed9b97",
                                        "glosses": [
                                            "A concise, terse, laconic, or memorable expression of a general truth or principle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ab2c022-e725-4716-a6a3-f3e5034c38b7",
                                                "sense_id": "6c98d8ac-92c9-3e8a-8a3d-1bc547385616",
                                                "text": "As the promoters expected the overall size of the rail market to expand, it demonstrated the aphorism that 'a rising tide lifts all the boats' associated with the belief that improved services benefit all the participants."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "aphorism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3bc26bb8-4f6f-33aa-8534-eef34deeacff",
                                        "entry_id": "a877dc7f-8a8b-3f60-bf2a-edc1ee44ec02",
                                        "glosses": [
                                            "To speak or write aphorisms."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4e11b41-9a3e-4cc6-8fda-4e212349ec9a",
                                                "sense_id": "3bc26bb8-4f6f-33aa-8534-eef34deeacff",
                                                "text": "But after each of us had inscribed his share (once I robbed my Aegidius for the purpose), our literary union was over; each of us tore his contribution out of the book and “aphorismed” on his own from then on."
                                            },
                                            {
                                                "example_id": "c904b4c2-79e9-4d40-9723-8d39fa877e08",
                                                "sense_id": "3bc26bb8-4f6f-33aa-8534-eef34deeacff",
                                                "text": "He was thoughtful: “Preferences define superiority,” he aphorismed. “As long as preferences are not made godly edicts.\""
                                            },
                                            {
                                                "example_id": "151cd03a-bf90-49ce-98b5-f1ced1763aa7",
                                                "sense_id": "3bc26bb8-4f6f-33aa-8534-eef34deeacff",
                                                "text": "“I don't know what more to do,” she confessed. “I've aphorismed my heart out and relationships have not improved one whit, it seems.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bc0717f1-7338-4c02-8a00-a2781580d0d9",
                        "source_entry_id": "a6412ba9-19cd-3c71-a946-c65a7d0ad902",
                        "source_sense_id": "877719ba-1b4e-3886-bd74-da1509e1347e",
                        "source_sense_description": "zegswijze",
                        "target_lang_word": "proverb",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "proverb",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e809d4a7-5eef-355c-b68e-864cebe4afab",
                                        "entry_id": "0e7702dc-0bdf-3fa5-afa6-5b9bb7b9330d",
                                        "glosses": [
                                            "A commonly used sentence expressing popular wisdom."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6bbcab4-c56e-45a4-91f9-497a0ae95254",
                                                "sense_id": "e809d4a7-5eef-355c-b68e-864cebe4afab",
                                                "text": "Near-synonyms: aphorism, maxim, adage, saw, saying, apothegm, byword, paroemia, sententia (Latin)"
                                            },
                                            {
                                                "example_id": "aba53a6e-b5bf-4313-8ae1-d9ec53082da0",
                                                "sense_id": "e809d4a7-5eef-355c-b68e-864cebe4afab",
                                                "text": "As a Yiddish proverb has it: Badarf men hunik ven tsuker iz zis? Who needs honey when sugar is sweet?"
                                            },
                                            {
                                                "example_id": "c7532bcb-4657-44d8-8caa-53d768810b35",
                                                "sense_id": "e809d4a7-5eef-355c-b68e-864cebe4afab",
                                                "text": "The definition of a proverb is no simple matter and has occupied scholars from Ancient Greece until the present day. Lord John Russell defined the proverb as ‘the wisdom of many and the wit of one’. The celebrated Spanish writer Cervantes said that a proverb is ‘a short sentence drawn from long experience’. Generally it is accepted that a proverb is a short, pithy traditional saying, which contains some widely accepted knowledge, or which offers advice or presents a moral. This present volume also contains many phrases and sayings which are not strictly proverbs as we use the term today, although we may still think of them as such. This situation arises because, prior to the eighteenth century it was common for the term to include metaphors, similes, and descriptive epithets. […] The essence of a proverb lies in it being a ‘traditional saying’ i.e. something which has commonly passed from one generation to another by word of mouth. […] In his book On the Lessons in Proverbs (1852), Richard Chevenix Trenchard says that there is one quality of the proverb which is the most essential of all: \"… popularity, acceptance and adoption on the part of the people. Without this popularity, without these suffrages and this consent of the many, no saying, however seasoned with salt, however worthy on all these accounts to have become a proverb, however fulfilling all other its conditions, can yet be esteemed as such.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "01b1b55a-884e-3a01-b993-6bce7de328ef",
                                        "entry_id": "0e7702dc-0bdf-3fa5-afa6-5b9bb7b9330d",
                                        "glosses": [
                                            "Any commonly used turn of phrase expressing a metaphor, simile, or descriptive epithet."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb9a4d4d-226c-4dbf-ad04-9ae05586eb33",
                                                "sense_id": "01b1b55a-884e-3a01-b993-6bce7de328ef",
                                                "text": "The definition of a proverb is no simple matter and has occupied scholars from Ancient Greece until the present day. Lord John Russell defined the proverb as ‘the wisdom of many and the wit of one’. The celebrated Spanish writer Cervantes said that a proverb is ‘a short sentence drawn from long experience’. Generally it is accepted that a proverb is a short, pithy traditional saying, which contains some widely accepted knowledge, or which offers advice or presents a moral. This present volume also contains many phrases and sayings which are not strictly proverbs as we use the term today, although we may still think of them as such. This situation arises because, prior to the eighteenth century it was common for the term to include metaphors, similes, and descriptive epithets. […] The essence of a proverb lies in it being a ‘traditional saying’ i.e. something which has commonly passed from one generation to another by word of mouth. […] In his book On the Lessons in Proverbs (1852), Richard Chevenix Trenchard says that there is one quality of the proverb which is the most essential of all: \"… popularity, acceptance and adoption on the part of the people. Without this popularity, without these suffrages and this consent of the many, no saying, however seasoned with salt, however worthy on all these accounts to have become a proverb, however fulfilling all other its conditions, can yet be esteemed as such.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "21d8cd44-9c34-3580-81bc-b6801a6f4e76",
                                        "entry_id": "0e7702dc-0bdf-3fa5-afa6-5b9bb7b9330d",
                                        "glosses": [
                                            "A striking or paradoxical assertion; an obscure saying; an enigma; a parable."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e7d6bd2f-6e03-44fd-9e36-4be206bd19a3",
                                                "sense_id": "21d8cd44-9c34-3580-81bc-b6801a6f4e76",
                                                "text": "His disciples said unto him, Lo, now speakest thou plainly, and speakest no proverb."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3127b6f1-68f3-387a-86af-b0e02ab28958",
                                        "entry_id": "0e7702dc-0bdf-3fa5-afa6-5b9bb7b9330d",
                                        "glosses": [
                                            "A familiar illustration; a subject of contemptuous reference."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b51d0fb5-aca5-4131-b244-5df6f4cebdc6",
                                                "sense_id": "3127b6f1-68f3-387a-86af-b0e02ab28958",
                                                "text": "Thou shalt become an astonishment, a proverb, and a by word, among all nations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3f20f89d-031e-35df-9741-a4cba6a22a0d",
                                        "entry_id": "0e7702dc-0bdf-3fa5-afa6-5b9bb7b9330d",
                                        "glosses": [
                                            "A drama exemplifying a proverb."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "proverb",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ea8af62b-132b-3e52-85a8-ec244032150e",
                                        "entry_id": "e107856d-aa32-3b6b-aba8-99c50518809c",
