        "nl-extract.jsonl": [
            {
                "entry_id": "2fcfa649-c673-3da3-9b3e-29d9f813666d",
                "word": "onderdruk",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "ce424320-4640-33f3-a6da-47a0b1e0f50a",
                        "entry_id": "2fcfa649-c673-3da3-9b3e-29d9f813666d",
                        "glosses": [
                            "druk in een vat die lager is dan die van de buitenwereld"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c63cb48-8832-4958-b8f7-f0b58f2f5ae9",
                                "sense_id": "ce424320-4640-33f3-a6da-47a0b1e0f50a",
                                "text": "De oxidatie in het vat veroorzaakt een onderdruk omdat de zuurstof gebonden wordt aan de ijzeren wand."
                            }
                        ]
                    },
                    {
                        "sense_id": "5105c0e0-bd69-312e-91ce-c8e84075fc23",
                        "entry_id": "2fcfa649-c673-3da3-9b3e-29d9f813666d",
                        "glosses": [
                            "bloeddruk wanneer het hart zich weer vult met bloed na een hartslag en de druk in de slagaders daalt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9cb1942c-52fa-4f4c-bb9f-0a84a7c470a9",
                                "sense_id": "5105c0e0-bd69-312e-91ce-c8e84075fc23",
                                "text": "Een verhoogde onderdruk levert vooral risico's voor de kleine bloedvaten op."
                            },
                            {
                                "example_id": "966bf294-8812-4ddc-841a-5c6d44b72b54",
                                "sense_id": "5105c0e0-bd69-312e-91ce-c8e84075fc23",
                                "text": "Een gemiddelde verlaging van de onderdruk met 5 millimeter kwik verlaagt bij de bevolking als geheel het risico op beroertes al met eenderde en het risico op hartaanvallen met 20 procent."
                            }
                        ]
                    },
                    {
                        "sense_id": "c9ea6103-4249-3325-b4ea-ba0e081dad2f",
                        "entry_id": "2fcfa649-c673-3da3-9b3e-29d9f813666d",
                        "glosses": [
                            "afdruk in wat lichtere kleuren, zodat er weer overheen kan worden gedrukt of geschreven"
                        ],
                        "tags": [
                            "drukkerij"
                        ],
                        "examples": [
                            {
                                "example_id": "eebacb7e-1939-4a58-84ca-73318b043193",
                                "sense_id": "c9ea6103-4249-3325-b4ea-ba0e081dad2f",
                                "text": "Op een onderdruk van de plattegrond konden ze snel de actuele toestand intekenen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b25615db-001a-4b50-a50f-f9781a6b6916",
                        "source_entry_id": "2fcfa649-c673-3da3-9b3e-29d9f813666d",
