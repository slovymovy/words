                    {
                        "translation_id": "c099fdbf-40b4-4dd7-8aeb-2431897a361b",
                        "source_entry_id": "4a2e4767-6a59-320c-afe8-1b89710af26d",
                        "source_sense_id": "a280a45a-6644-391c-ad8e-6378918d18fb",
                        "target_lang_word": "Shanghai",
