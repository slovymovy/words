                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tablica",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "b90fb59c-e704-3789-8a2f-3dd81ec7bff3",
                                        "entry_id": "78d4b102-7ef9-38ed-b144-d01afa481b02",
                                        "glosses": [
                                            "miejsce do umieszczania ogłoszeń, informacji"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72a7cb26-17b7-4a77-a2e4-8d481deecc7f",
                                                "sense_id": "b90fb59c-e704-3789-8a2f-3dd81ec7bff3",
                                                "text": "Informacje zostały wywieszone na tablicy."
                                            },
                                            {
                                                "example_id": "e0eda4d7-c1e3-4f51-91c0-ca539b967e36",
                                                "sense_id": "b90fb59c-e704-3789-8a2f-3dd81ec7bff3",
                                                "text": "Zygmunt zatrzymał się przed tablicą i zaczął przebiegać oczami treść ulotki"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "5f7dfb56-2152-3874-83fd-4a150193c8b0",
                                        "entry_id": "78d4b102-7ef9-38ed-b144-d01afa481b02",
                                        "glosses": [
                                            "miejsce do pisania za pomocą kredy (czarna lub zielona deska)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11019fc2-74d3-436b-bc09-8e8f2f9df73e",
                                                "sense_id": "5f7dfb56-2152-3874-83fd-4a150193c8b0",
                                                "text": "Kredą na tablicy narysował spłaszczony perspektywicznie kwadrat, jakby widziany od góry"
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    },
                                    {
                                        "sense_id": "a28cc4e1-a18f-3fa3-9611-ffdbbd4385ca",
                                        "entry_id": "78d4b102-7ef9-38ed-b144-d01afa481b02",
                                        "glosses": [
                                            "miejsce do pisania za pomocą specjalnego pisaka (wykonana z białego plastiku)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3cddad25-7e7c-47de-9922-af339b8fc752",
                                                "sense_id": "a28cc4e1-a18f-3fa3-9611-ffdbbd4385ca",
                                                "text": "Kiedyś, kiedy zapamiętywanie niektórych wyrazów w języku niemieckim sprawiało mi trudność, zacząłem wypisywać je flamastrem na tablicy, którą można kupić w sklepie z artykułami biurowymi"
                                            }
                                        ],
                                        "sense_index_json": "\"1.3\""
                                    },
                                    {
                                        "sense_id": "f26bf97f-bc9b-3f39-9a73-905c63b6b178",
                                        "entry_id": "78d4b102-7ef9-38ed-b144-d01afa481b02",
                                        "glosses": [
                                            "zob. tablica interaktywna"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1.4\""
                                    },
                                    {
                                        "sense_id": "e1b070db-8d06-384d-8598-dd78e136ac83",
                                        "entry_id": "78d4b102-7ef9-38ed-b144-d01afa481b02",
                                        "glosses": [
                                            "zestawienie danych, wzorów"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c558820-d808-40c5-9351-dc3286a7ca94",
                                                "sense_id": "e1b070db-8d06-384d-8598-dd78e136ac83",
                                                "text": "Na tablicy matematycznej są wzory na obliczanie pól figur."
                                            }
                                        ],
                                        "sense_index_json": "\"1.5\""
                                    },
                                    {
                                        "sense_id": "71b2c468-59e1-368d-adff-977c03007c50",
                                        "entry_id": "78d4b102-7ef9-38ed-b144-d01afa481b02",
                                        "glosses": [
                                            "płyta z jakimś napisem, informacją"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a7153450-7ba0-4f43-9b11-8b1f96c7babc",
                                                "sense_id": "71b2c468-59e1-368d-adff-977c03007c50",
                                                "text": "(…) na miejscu egzekucji społeczeństwo miasta wzniosło symboliczną mogiłę opatrzoną krzyżem i pamiątkową tablicą"
                                            }
                                        ],
                                        "sense_index_json": "\"1.6\""
                                    },
                                    {
                                        "sense_id": "89b001e7-36ba-3a7d-940c-308d095d79c6",
                                        "entry_id": "78d4b102-7ef9-38ed-b144-d01afa481b02",
                                        "glosses": [
                                            "kontener danych, do których dostęp uzyskiwany jest przy pomocy, na ogół liczbowego, klucza"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c34f9eb0-7a91-4679-9392-1a9f5c9b5d98",
                                                "sense_id": "89b001e7-36ba-3a7d-940c-308d095d79c6",
                                                "text": "Tablicę można zadeklarować za pomocą instrukcji deklaracji typu"
