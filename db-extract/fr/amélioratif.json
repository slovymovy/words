            {
                "entry_id": "29e8541c-2e4f-376a-b1b7-64a7c38c1843",
                "word": "amélioratif",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "f19f90b6-2a4f-4b5c-8ba3-22a36068dff9",
                        "entry_id": "29e8541c-2e4f-376a-b1b7-64a7c38c1843",
                        "tags": [
                            "plural",
