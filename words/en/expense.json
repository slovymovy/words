{
    "word_family": [
        "expensive",
        "inexpensive",
        "expend",
        "expenditure"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "35bca17a-a2b1-3b13-bb91-68c140f59e26",
                    "sense_definition": "The money that is spent on something.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She went to great <w>expense</w> to ensure her children would get the best education.",
                            "target_lang_translations": {
                                "ru": "Она пошла на большие <w>расходы</w>, чтобы обеспечить своим детям лучшее образование.",
                                "de": "Sie nahm große <w>Ausgaben</w> in Kauf, um sicherzustellen, dass ihre Kinder die beste Bildung erhalten."
                            }
                        },
                        {
                            "text": "Buying the car was a big <w>expense</w>, but will be worth it in the long run.",
                            "target_lang_translations": {
                                "ru": "Покупка машины была большой <w>тратой</w>, но в долгосрочной перспективе она того стоит.",
                                "de": "Der Autokauf war eine große <w>Ausgabe</w>, wird sich aber auf lange Sicht lohnen."
                            }
                        }
                    ],
                    "synonyms": [
                        "cost",
                        "expenditure",
                        "outlay",
                        "charge",
                        "payment",
                        "disbursement",
                        "spending",
                        "price"
                    ],
                    "common_phrases": [
                        "at great expense",
                        "spare no expense",
                        "travel expenses",
                        "medical expenses"
                    ],
                    "target_lang_definitions": {
                        "ru": "Деньги, которые тратятся на что-либо.",
                        "de": "Geld, das für etwas ausgegeben wird."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "расход",
                                "target_lang_sense_clarification": "затрата денег или ресурсов"
                            },
                            {
                                "target_lang_word": "трата",
                                "target_lang_sense_clarification": "обычно во множественном числе: денежные траты"
                            },
                            {
                                "target_lang_word": "издержки",
                                "target_lang_sense_clarification": "затраты, связанные с производством или деятельностью"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Ausgabe",
                                "target_lang_sense_clarification": "allgemeiner Begriff für eine finanzielle Aufwendung"
                            },
                            {
                                "target_lang_word": "Aufwand",
                                "target_lang_sense_clarification": "finanzieller oder zeitlicher Einsatz für ein Ziel"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dd4b7d14-2340-3ad5-9c27-b3f0269febd3",
                    "sense_definition": "Something that is lost or damaged in order to achieve a result.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Jones reached the final at the <w>expense</w> of Smith, who couldn't beat him.",
                            "target_lang_translations": {
                                "ru": "Джонс вышел в финал за <w>счёт</w> Смита, который не смог его победить.",
                                "de": "Jones erreichte das Finale auf <w>Kosten</w> von Smith, der ihn nicht schlagen konnte."
                            }
                        },
                        {
                            "text": "He focused on his career at the <w>expense</w> of his personal health.",
                            "target_lang_translations": {
                                "ru": "Он сосредоточился на карьере в <w>ущерб</w> своему здоровью.",
                                "de": "Er konzentrierte sich auf seine Karriere auf <w>Kosten</w> seiner persönlichen Gesundheit."
                            }
                        }
                    ],
                    "synonyms": [
                        "cost"
                    ],
                    "common_phrases": [
                        "at the expense of"
                    ],
                    "target_lang_definitions": {
                        "ru": "То, чем жертвуют или что теряют ради достижения результата.",
                        "de": "Etwas, das geopfert oder verloren wird, um ein Ergebnis zu erzielen."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "счёт",
                                "target_lang_sense_clarification": "в идиоме «за счёт кого-либо/чего-либо»"
                            },
                            {
                                "target_lang_word": "ущерб",
                                "target_lang_sense_clarification": "вред, потеря; часто в выражении «в ущерб чему-либо»"
                            },
                            {
                                "target_lang_word": "цена",
                                "target_lang_sense_clarification": "в переносном смысле: то, чем приходится платить"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "auf Kosten von",
                                "target_lang_sense_clarification": "in der Redewendung 'auf Kosten von jemandem/etwas'"
                            },
                            {
                                "target_lang_word": "zu Lasten von",
                                "target_lang_sense_clarification": "etwas geschieht zum Nachteil einer anderen Sache"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "31edf576-5731-34fa-b3df-46e3c4f2177d",
                    "sense_definition": "Loss or waste.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "And moan the <w>expense</w> of many a vanished sight.",
                            "target_lang_translations": {
                                "ru": "И оплакивать <w>потерю</w> многих исчезнувших образов.",
                                "de": "Und den <w>Verlust</w> so mancher entschwundenen Aussicht beklagen."
                            }
                        },
                        {
                            "text": "The <w>expense</w> of spirit in a waste of shame.",
                            "target_lang_translations": {
                                "ru": "<w>Растрата</w> духа в пустыне позора.",
                                "de": "Die <w>Verschwendung</w> des Geistes in einer Wüste der Schande."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Found in older literature such as Shakespeare."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Потеря или напрасная трата.",
                        "de": "Verlust oder Verschwendung."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "потеря",
                                "target_lang_sense_clarification": "утрата чего-либо ценного"
                            },
                            {
                                "target_lang_word": "растрата",
                                "target_lang_sense_clarification": "бесполезное расходование (устар./поэт.)"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Verlust",
                                "target_lang_sense_clarification": "das Verlorengehen von etwas Wertvollem"
                            },
                            {
                                "target_lang_word": "Verschwendung",
                                "target_lang_sense_clarification": "sinnloses oder übermäßiges Ausgeben von Ressourcen"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c118964b-5bcb-3652-873c-f17103ef83c7",
                    "sense_definition": "To charge a cost to an expense account so that a company will pay for it.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It should be acceptable to <w>expense</w> a business lunch with a client.",
                            "target_lang_translations": {
                                "ru": "Должно быть приемлемо <w>списать</w> деловой обед с клиентом на счет компании.",
                                "de": "Es sollte akzeptabel sein, ein Geschäftsessen mit einem Kunden <w>abzurechnen</w>."
                            }
                        },
                        {
                            "text": "You can <w>expense</w> the taxi fare if you are traveling for work.",
                            "target_lang_translations": {
                                "ru": "Вы можете <w>списать</w> плату за такси, если путешествуете по работе.",
                                "de": "Sie können die Taxikosten <w>abrechnen</w>, wenn Sie geschäftlich unterwegs sind."
                            }
                        }
                    ],
                    "synonyms": [
                        "charge"
                    ],
                    "common_phrases": [
                        "expense a lunch",
                        "expense the cost"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отнести стоимость чего-либо на счет компании для возмещения.",
                        "de": "Kosten auf ein Spesenkonto buchen, damit ein Unternehmen sie erstattet."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "списывать",
                                "target_lang_sense_clarification": "относить на служебные расходы"
                            },
                            {
                                "target_lang_word": "относить на счёт",
                                "target_lang_sense_clarification": "записывать как расход компании"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "abrechnen",
                                "target_lang_sense_clarification": "Kosten bei der Firma zur Erstattung einreichen"
                            },
                            {
                                "target_lang_word": "als Spesen geltend machen",
                                "target_lang_sense_clarification": "offizielle Bezeichnung für die steuerliche oder betriebliche Geltendmachung"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}