                ],
                "senses": [
                    {
                        "sense_id": "9576fd60-a186-35a3-9f67-3f406f014078",
                        "entry_id": "a99edf6f-5378-3e9e-9dcd-5e25193ce08d",
                        "glosses": [
                            "Celui qui tient un étal."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61d4ccb1-e940-4502-8797-ff1fb1fc1786",
                                "sense_id": "9576fd60-a186-35a3-9f67-3f406f014078",
                                "text": "Va-t’en donc, et, si tu remplis fidèlement ma commission et que tu reviennes ici ensuite, tu y trouveras de la chair de Saxon à meilleur marché que celle du porc chez les étaliers de Sheffield."
                            },
                            {
                                "example_id": "0b737d43-7bb3-451a-a667-1c11f27c0603",
                                "sense_id": "9576fd60-a186-35a3-9f67-3f406f014078",
                                "text": "Tout étalier qui voudra s'établir ne pourra le faire qu'en laissant cinq étaux entre son établissement et ceux des bouchers chez lesquels il aura travaillé pendant deux mois, à moins que ce ne soit depuis plus d'un an."
                            },
                            {
                                "example_id": "7432545b-26f7-41d9-b751-9080a307eceb",
                                "sense_id": "9576fd60-a186-35a3-9f67-3f406f014078",
                                "text": "Les viandes débordent, sanglantes, jusque sous les pieds des garçons étaliers."
                            },
                            {
                                "example_id": "74c4df7a-9a53-435e-a3e8-de1705b9602c",
                                "sense_id": "9576fd60-a186-35a3-9f67-3f406f014078",
                                "text": "Chez les bouchers, quand la vieille Annou demandait une carbonade, l’étalier lui riait au nez ; il ne savait pas ce que c’était une « carbonade », ce sauvage !…"
                            }
                        ]
                    }
                ],
