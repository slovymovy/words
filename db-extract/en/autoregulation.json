                                        "glosses": [
                                            "Régulation (d’un processus, d’une fonction) par l’organisme, sans intervention extérieure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46dadc2f-9ee5-44a5-bec6-d74784fdd269",
                                                "sense_id": "02bdd924-fb60-3453-9260-8f0d8f5caae0",
                                                "text": "Autorégulation de la glycémie, de la pression artérielle."
