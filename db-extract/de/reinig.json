                "senses": [
                    {
                        "sense_id": "0e507a9a-1abf-3333-bef6-29f5a47b48da",
                        "entry_id": "4471028b-ad20-3c37-a040-ad281855c7bd",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f04e49c7-afcb-45b9-a27b-202e53455721",
                                "sense_id": "0e507a9a-1abf-3333-bef6-29f5a47b48da",
                                "text": "Frau Reinig ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "ffba7999-cbdb-4e6a-ac01-a4ad2e6e2004",
                                "sense_id": "0e507a9a-1abf-3333-bef6-29f5a47b48da",
                                "text": "Herr Reinig wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "89d1070e-ebed-4290-a953-da8d636b2c49",
                                "sense_id": "0e507a9a-1abf-3333-bef6-29f5a47b48da",
                                "text": "Die Reinigs fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "c8c56ca3-1202-4718-a800-55b592abf9f6",
                                "sense_id": "0e507a9a-1abf-3333-bef6-29f5a47b48da",
                                "text": "Der Reinig trägt nie die Schals, die die Reinig ihm strickt."
                            },
                            {
                                "example_id": "42145907-b2c8-40a7-918d-5808955bd93c",
                                "sense_id": "0e507a9a-1abf-3333-bef6-29f5a47b48da",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Reinig kommt, geht der Herr Reinig.“"
                            },
                            {
                                "example_id": "58542807-e742-4e1f-88fc-fd99de7cee33",
                                "sense_id": "0e507a9a-1abf-3333-bef6-29f5a47b48da",
                                "text": "Reinig kommt und geht."
                            },
                            {
                                "example_id": "9a64fa11-ca81-44ed-aea6-5801f59f8d86",
                                "sense_id": "0e507a9a-1abf-3333-bef6-29f5a47b48da",
                                "text": "Reinigs kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
