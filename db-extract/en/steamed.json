                        "glosses": [
                            "Otherwise heated and processed with steam, as for example with parts of wooden furniture."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "850ceaf4-355a-413e-b975-029d6afc05d1",
                                "sense_id": "4796b3b3-016e-3b14-abf1-2e0aa40adeb6",
                                "text": "Superintendent Chalmers: Why is there smoke coming out of your oven, Seymour?\nSeymour Skinner: Uh- Oh. That isn't smoke. It's steam. Steam from the steamed clams we're having. Mmm. Steamed clams."
                            }
