                                                "example_id": "b8537566-71bd-4e00-a0c0-7bf4f1518d6f",
                                                "sense_id": "01270daa-cb17-3654-81a3-0fabbd5ec5f5",
                                                "text": "Взрывная волна меня приподняла и ударила о дерево."
                                            },
                                            {
                                                "example_id": "a3f31d25-a2e0-436b-a751-f5002441d880",
                                                "sense_id": "01270daa-cb17-3654-81a3-0fabbd5ec5f5",
                                                "text": "Электромагнитные волны."
                                            },
                                            {
                                                "example_id": "fee3a8e2-3bc9-4557-8be7-03d9728df455",
                                                "sense_id": "01270daa-cb17-3654-81a3-0fabbd5ec5f5",
                                                "text": "Длина волны."
                                            }
