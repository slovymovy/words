                        {
                            "text": "Strict quarantine measures were implemented to control the spread of <w>bangs</w>.",
                            "target_lang_translations": {
                                "ru": "Были введены строгие карантинные меры для контроля распространения <w>бруцеллёза</w>."
                            }
