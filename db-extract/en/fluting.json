                                    {
                                        "sense_id": "ae7854ae-de6d-303e-85ee-ab212fe90e07",
                                        "entry_id": "fb6ed419-358c-390c-a181-fbb88f7a8b19",
                                        "glosses": [
                                            "die Eigenschaft einer Oberfläche, geriffelt zu sein"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "48de23e2-5d09-4aba-a8b5-f2010981431d",
                                                "sense_id": "ae7854ae-de6d-303e-85ee-ab212fe90e07",
                                                "text": "„Zudem wirkte die Riffelung als Versteifung und bot so bei geringerer Masse einen erhöhten mechanischen Widerstand gegen auftreffende Schläge.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3a5538b8-c74f-3ae7-a322-9f9542e48190",
                                        "entry_id": "fb6ed419-358c-390c-a181-fbb88f7a8b19",
                                        "glosses": [
                                            "Bereich mit geriffelter Oberfläche, zum Beispiel der Rand von Münzen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b40ee41-3121-4fbb-bc27-35680946c7b3",
                                                "sense_id": "3a5538b8-c74f-3ae7-a322-9f9542e48190",
                                                "text": "„Sie hat nach unten hin zwei gebogene Schenkel, welche nur am unteren Ende eine Riffelung aufweisen mit dem Zweck, dass beim Walken das Leder nicht beschädigt wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
