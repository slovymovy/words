                "senses": [
                    {
                        "sense_id": "2a85fec8-dbba-3dbc-b808-2c43296d21a4",
                        "entry_id": "a93b8712-7710-3381-a16f-5f7ec15feeaf",
                        "glosses": [
                            "Nahrungsmittel, das in einer Molkerei hergestellt wird; im Wesentlichen aus Milch bestehendes Produkt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c3f36251-27b3-4f39-bc8e-e22f63e27476",
                                "sense_id": "2a85fec8-dbba-3dbc-b808-2c43296d21a4",
                                "text": "„Joghurt ist meist ein Molkereiprodukt, und Milch dient Viren und ungesunden Bakterien, die so viele chronische Krankheiten verursachen, als Nahrung.“"
                            },
                            {
                                "example_id": "92d1529c-6561-4dd7-aec2-7846d57fb98a",
                                "sense_id": "2a85fec8-dbba-3dbc-b808-2c43296d21a4",
                                "text": "„Feta, für viele das griechische Molkereiprodukt schlechthin, wurde zu byzantinischen Zeiten erfunden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
