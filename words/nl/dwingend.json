                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De leraar stond voor de klas, de leerlingen tot stilte <w>dwingend</w> met een enkele blik.",
                            "target_lang_translations": {
                                "en": "The teacher stood in front of the class, <w>forcing</w> the students into silence with a single look."
                            }
