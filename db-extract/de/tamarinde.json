                                    {
                                        "sense_id": "6224f5ff-956b-3826-8e35-d79a7c1f6e15",
                                        "entry_id": "80171455-6d20-38bd-985b-05b78abaf5f5",
                                        "glosses": [
                                            "The fruit of this tree; the pulp is used as spice in Asian cooking and in Worcestershire sauce."
                                        ],
