                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6db20f5d-b1d7-4fdc-a6b9-48907bb97c53",
                                "sense_id": "cd24d95d-835f-3ad4-974b-32c1dff3ebe7",
                                "text": "Het duidelijke thema van Slow Down, een protestsong tegen de jachtigheid van het moderne leven, biedt in die zin zeker mogelijkheden. Hoewel het onverstandig zou zijn de song al te overvloedig visueel te decoreren. Daarvoor is de Oranje-inzending te ambachtelijk muzikaal."
                            },
                            {
                                "example_id": "b8388056-cd8a-49ae-9331-d76d4b2c281c",
                                "sense_id": "cd24d95d-835f-3ad4-974b-32c1dff3ebe7",
                                "text": "In onze neiging om nu en dan te willen ontsnappen aan de jachtigheid van de moderne tijd grijpen we graag terug naar iets wat oud is, en dan het liefst ook nog naar iets mystieks."
                            },
                            {
                                "example_id": "4887b8b3-c8dd-4777-8173-77eb051d26a3",
                                "sense_id": "cd24d95d-835f-3ad4-974b-32c1dff3ebe7",
                                "text": "Waarom nog de jachtigheid en hoge huizenprijzen als je het op andere plekken rustiger en goedkoper kon krijgen?"
                            }
                        ]
                    }
