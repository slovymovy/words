                "senses": [
                    {
                        "sense_id": "53f38061-7705-3ac2-ac90-68f68fb80ccd",
                        "entry_id": "9f400ec1-4d18-39e2-b693-a504357686b7",
                        "glosses": [
                            "sich sehr eng an den Körper schmiegendes Kleid, das aus Stretch gefertigt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "658002ba-d4ba-40f7-aee0-f8f707fa8a51",
                                "sense_id": "53f38061-7705-3ac2-ac90-68f68fb80ccd",
                                "text": "„Ich zwänge mich in das schwarze Stretchkleid.“"
                            },
                            {
                                "example_id": "9773151c-0be9-4739-9acc-23af3a48759e",
                                "sense_id": "53f38061-7705-3ac2-ac90-68f68fb80ccd",
                                "text": "„Diane Kruger […] posierte im Stretchkleid gekonnt vor den Fotografen.“"
                            },
                            {
                                "example_id": "e639f359-7783-485d-8fd8-391110965be0",
                                "sense_id": "53f38061-7705-3ac2-ac90-68f68fb80ccd",
                                "text": "„Plötzlich kommt Ramona auf die Bühne im engstmöglichen gestreiften Stretchkleid […].“"
                            },
                            {
                                "example_id": "ecb619e4-af3e-454d-930c-dd824d464362",
                                "sense_id": "53f38061-7705-3ac2-ac90-68f68fb80ccd",
                                "text": "„Soll ich mein dunkelgrünes Stretchkleid anziehen? Ach was, wir sind doch nur zum Essen verabredet.“"
                            },
                            {
                                "example_id": "cb63f9bb-4278-4eaf-9b86-fd67ab9fed34",
                                "sense_id": "53f38061-7705-3ac2-ac90-68f68fb80ccd",
                                "text": "„Nachdem sie von Anno vor allen Ohren telefonisch eingeladen worden war, ging sie an ihren Kleiderschrank, zog das kürzeste schwarze Stretchkleid mit dem tiefsten Ausschnitt heraus und wählte dazu die höchsten Stilettos, derer sie habhaft werden konnte.“"
                            },
                            {
                                "example_id": "6de8d566-7fea-4c76-9c70-58c2004ac751",
                                "sense_id": "53f38061-7705-3ac2-ac90-68f68fb80ccd",
                                "text": "„Gina trug ein rotes, enganliegendes Stretchkleid, hochgeschlossen, mit langen Ärmeln, das ihren Körper wie eine zweite Haut modellierte. Schwarze, hauchdünne Strümpfe. HighHeels.“"
                            },
                            {
                                "example_id": "9d3f8cdf-7a54-4d61-9d14-3d1436998b5e",
                                "sense_id": "53f38061-7705-3ac2-ac90-68f68fb80ccd",
                                "text": "„In Paris präsentierte der kleinwüchsige Azzedin Alaia hautenge Stretchkleider […].“"
                            },
                            {
                                "example_id": "e342255a-e073-43e8-a46a-8acba8769be4",
                                "sense_id": "53f38061-7705-3ac2-ac90-68f68fb80ccd",
                                "text": "„Während die Stretchkleider des Tunesiers Azzedine Alaïa den Körper eher noch umschmeicheln und modellieren, passen sich die Schlauchkleider von Philippe Starck dem Körper bedingungslos an.“"
                            },
                            {
                                "example_id": "be830a2c-4dc1-4ff8-b737-9d328fd4dca6",
                                "sense_id": "53f38061-7705-3ac2-ac90-68f68fb80ccd",
                                "text": "„Dem gängigen Schönheitsideal entsprechen die meisten von ihnen nicht. Und doch trägt die üppige Cindy das enge Stretchkleid mit vollendeter Würde über den Laufsteg […].“"
                            },
                            {
                                "example_id": "247c109d-03e4-4c99-aab6-339373b513b9",
                                "sense_id": "53f38061-7705-3ac2-ac90-68f68fb80ccd",
                                "text": "„Meine beste Freudin sieht in der Tat aus wie ein Filmstar. Sie trägt ein langes grünes Stretchkleid und eine Statementkette als Accessoire und hat die roten Haare zu einem hohen Dutt gebunden. Sie sieht einfach großartig aus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
