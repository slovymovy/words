{
    "word_family": [
        "spearhead",
        "spearman",
        "spearfishing"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d0a5cdab-88f6-329d-a1f3-694046e8a360",
                    "sense_definition": "A long stick with a sharp tip used as a weapon for throwing or thrusting.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "weapon_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient warrior raised his <w>spear</w> to signal the attack.",
                            "target_lang_translations": {
                                "ru": "Древний воин поднял своё <w>копьё</w>, чтобы дать сигнал к атаке.",
                                "zh": "古代战士举起<w>长矛</w>发出进攻信号。",
                                "es": "El antiguo guerrero levantó su <w>lanza</w> para señalar el ataque."
                            }
                        },
                        {
                            "text": "They found a rusty <w>spear</w> buried in the muddy riverbank.",
                            "target_lang_translations": {
                                "ru": "Они нашли ржавое <w>копьё</w>, зарытое в илистом берегу реки.",
                                "zh": "他们在泥泞的河岸里发现了一把生锈的<w>长矛</w>。",
                                "es": "Encontraron una <w>lanza</w> oxidada enterrada en la orilla fangosa del río."
                            }
                        }
                    ],
                    "common_phrases": [
                        "throw a spear",
                        "hunting spear",
                        "sharp spear"
                    ],
                    "target_lang_definitions": {
                        "ru": "Длинная палка с острым наконечником, используемая как оружие для метания или колющих ударов.",
                        "zh": "一种长柄尖头武器，用于投掷或刺击。",
                        "es": "Un palo largo con una punta afilada, utilizado como arma para lanzar o embestir."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "копьё",
                                "target_lang_sense_clarification": "основное значение"
                            },
                            {
                                "target_lang_word": "пика",
                                "target_lang_sense_clarification": "длинное колющее оружие"
                            },
                            {
                                "target_lang_word": "дротик",
                                "target_lang_sense_clarification": "метательное копьё"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "长矛",
                                "target_lang_sense_clarification": "主要指长柄武器"
                            },
                            {
                                "target_lang_word": "矛",
                                "target_lang_sense_clarification": "通用名称"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "lanza",
                                "target_lang_sense_clarification": "arma larga de asta con punta afilada"
                            },
                            {
                                "target_lang_word": "venablo",
                                "target_lang_sense_clarification": "lanza corta o arma arrojadiza"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c96c55fa-3f08-37c9-968e-9cba66bce54b",
                    "sense_definition": "A long, thin stalk or shoot of a vegetable, especially asparagus or broccoli.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "vegetable_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please serve the grilled asparagus <w>spears</w> on a separate plate.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, подайте жареные <w>побеги</w> спаржи на отдельной тарелке.",
                                "zh": "请把烤芦笋<w>嫩茎</w>放在另一个盘子里。",
                                "es": "Por favor, sirva los <w>tallos</w> de espárragos a la parrilla en un plato aparte."
                            }
                        },
                        {
                            "text": "She chopped the broccoli <w>spears</w> into small pieces for the salad.",
                            "target_lang_translations": {
                                "ru": "Она нарезала <w>стебли</w> брокколи на мелкие кусочки для салата.",
                                "zh": "她把西兰花<w>嫩茎</w>切成小块做沙拉。",
                                "es": "Ella cortó los <w>tallos</w> de brócoli en trozos pequeños para la ensalada."
                            }
                        }
                    ],
                    "common_phrases": [
                        "asparagus spear",
                        "broccoli spear"
                    ],
                    "target_lang_definitions": {
                        "ru": "Длинный тонкий стебель или побег овоща, особенно спаржи или брокколи.",
                        "zh": "蔬菜细长的茎或芽，尤指芦笋或西兰花。",
                        "es": "Un tallo o brote largo y delgado de un vegetal, especialmente de espárragos o brócoli."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "побег",
                                "target_lang_sense_clarification": "росток растения (спаржи)"
                            },
                            {
                                "target_lang_word": "стебель",
                                "target_lang_sense_clarification": "часть растения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "嫩茎",
                                "target_lang_sense_clarification": "指芦笋等植物的茎"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "tallo",
                                "target_lang_sense_clarification": "parte alargada de una planta"
                            },
                            {
                                "target_lang_word": "brote",
                                "target_lang_sense_clarification": "parte tierna que nace de la planta"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a59384e8-42b7-3a14-9870-834dd8080bca",
                    "sense_definition": "A soldier armed with a spear.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "weapon_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The king sent a thousand <w>spears</w> to defend the northern border.",
                            "target_lang_translations": {
                                "ru": "Король послал тысячу <w>копий</w> защищать северную границу.",
                                "zh": "国王派出一千名<w>长矛手</w>去保卫北部边境。",
                                "es": "El rey envió mil <w>lanceros</w> para defender la frontera norte."
                            }
                        },
                        {
                            "text": "Every <w>spear</w> in the army was ready for the coming battle.",
                            "target_lang_translations": {
                                "ru": "Каждый <w>копейщик</w> в армии был готов к предстоящей битве.",
                                "zh": "军队里的每一名<w>长矛手</w>都为即将到来的战斗做好了准备。",
                                "es": "Cada <w>lancero</w> del ejército estaba listo para la batalla que se avecinaba."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historical or literary context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Солдат, вооружённый копьём.",
                        "zh": "手持长矛的士兵。",
                        "es": "Un soldado armado con una lanza."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "копейщик",
                                "target_lang_sense_clarification": "воин"
                            },
                            {
                                "target_lang_word": "копьё",
                                "target_lang_sense_clarification": "перен. боевая единица"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "长矛手",
                                "target_lang_sense_clarification": "古代步兵"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "lancero",
                                "target_lang_sense_clarification": "soldado armado con lanza"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8d1d362f-ea55-3fad-b311-66267d4c3b7e",
                    "sense_definition": "To pierce or strike with a pointed object, often a spear or something similar.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "weapon_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He used a fork to <w>spear</w> the last pickle in the jar.",
                            "target_lang_translations": {
                                "ru": "Он использовал вилку, чтобы <w>наколоть</w> последний маринованный огурец в банке.",
                                "zh": "他用叉子<w>戳</w>起了罐子里最后一块腌黄瓜。",
                                "es": "Usó un tenedor para <w>ensartar</w> el último pepinillo del frasco."
                            }
                        },
                        {
                            "text": "The bird stood motionless in the water, waiting to <w>spear</w> a fish.",
                            "target_lang_translations": {
                                "ru": "Птица стояла неподвижно в воде, ожидая момента, чтобы <w>пронзить</w> рыбу.",
                                "zh": "那只鸟一动不动地站在水里，等着<w>刺穿</w>一条鱼。",
                                "es": "El ave permanecía inmóvil en el agua, esperando para <w>ensartar</w> un pez."
                            }
                        }
                    ],
                    "common_phrases": [
                        "spear a fish",
                        "spear a piece"
                    ],
                    "target_lang_definitions": {
                        "ru": "Протыкать или ударять заострённым предметом, часто копьём или чем-то похожим.",
                        "zh": "用尖锐物体刺穿或戳中某物。",
                        "es": "Atravesar o golpear con un objeto puntiagudo, a menudo una lanza o algo similar."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "накалывать",
                                "target_lang_sense_clarification": "на вилку или острый предмет"
                            },
                            {
                                "target_lang_word": "пронзать",
                                "target_lang_sense_clarification": "протыкать насквозь"
                            },
                            {
                                "target_lang_word": "гарпунить",
                                "target_lang_sense_clarification": "бить острогой"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "戳",
                                "target_lang_sense_clarification": "用尖物刺"
                            },
                            {
                                "target_lang_word": "刺穿",
                                "target_lang_sense_clarification": "穿透物体"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "ensartar",
                                "target_lang_sense_clarification": "atravesar con un objeto puntiagudo"
                            },
                            {
                                "target_lang_word": "pinchar",
                                "target_lang_sense_clarification": "clavar un objeto con punta"
                            },
                            {
                                "target_lang_word": "arponear",
                                "target_lang_sense_clarification": "atravesar con un arpón"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5bdf1174-4a39-39ca-b8cd-16453c558050",
                    "sense_definition": "To tackle an opponent by ramming into them with one's helmet (in football) or striking with a stick (in hockey).",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "sports_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The referee called a penalty because the defender decided to <w>spear</w> the quarterback.",
                            "target_lang_translations": {
                                "ru": "Судья назначил штрафной, потому что защитник решил <w>протаранить</w> квотербека шлемом.",
                                "zh": "裁判判了犯规，因为防守队员决定用头盔<w>冲撞</w>四分卫。",
                                "es": "El árbitro pitó una falta porque el defensa decidió <w>embestir</w> al quarterback."
                            }
                        },
                        {
                            "text": "He was ejected from the game after he tried to <w>spear</w> his opponent.",
                            "target_lang_translations": {
                                "ru": "Его удалили из игры после того, как он попытался <w>ткнуть</w> соперника клюшкой.",
                                "zh": "他因试图用球杆<w>冲撞</w>对手而被罚出场。",
                                "es": "Fue expulsado del juego después de intentar <w>golpear</w> a su oponente con el palo."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Атаковать противника ударом шлема (в футболе) или тычком клюшки (в хоккее).",
                        "zh": "在体育运动中，用头盔或器械非法冲撞对手。",
                        "es": "Atacar a un oponente embistiéndolo con el casco (en fútbol americano) o golpeando con un palo (en hockey)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "таранить",
                                "target_lang_sense_clarification": "ударить шлемом"
                            },
                            {
                                "target_lang_word": "бить колющим ударом",
                                "target_lang_sense_clarification": "клюшкой в хоккее"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "冲撞",
                                "target_lang_sense_clarification": "体育中的违规动作"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "embestir",
                                "target_lang_sense_clarification": "atacar violentamente"
                            },
                            {
                                "target_lang_word": "golpear con el palo",
                                "target_lang_sense_clarification": "término específico para faltas en hockey"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "44557b86-7e9b-376e-8480-86a71393325c",
                    "sense_definition": "Pertaining to the male line of a family.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "lineage_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In this culture, inheritance traditionally follows the <w>spear</w> side of the family.",
                            "target_lang_translations": {
                                "ru": "В этой культуре наследование традиционно следует по <w>мужской</w> линии семьи.",
                                "zh": "在这种文化中，遗产继承传统上遵循<w>父系</w>。",
                                "es": "En esta cultura, la herencia tradicionalmente sigue la <w>línea paterna</w> de la familia."
                            }
                        },
                        {
                            "text": "The genealogist traced the lineage back through the <w>spear</w> line.",
                            "target_lang_translations": {
                                "ru": "Генеалог проследил родословную по <w>мужской</w> линии.",
                                "zh": "家谱学家通过<w>父系</w>追溯了血统。",
                                "es": "El genealogista rastreó el linaje a través de la <w>línea masculina</w>."
                            }
                        }
                    ],
                    "antonyms": [
                        "distaff"
                    ],
                    "common_phrases": [
                        "spear side"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "genealogy"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к мужской линии рода.",
                        "zh": "指家族的父系血缘。",
                        "es": "Relativo a la línea masculina de una familia."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мужской",
                                "target_lang_sense_clarification": "о линии родства"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "父系",
                                "target_lang_sense_clarification": "指血缘关系"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "línea paterna",
                                "target_lang_sense_clarification": "descendencia por parte del padre"
                            },
                            {
                                "target_lang_word": "linaje masculino",
                                "target_lang_sense_clarification": "referente a la ascendencia de varones"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "4c8bba3b-58b9-3845-b036-000a23ce1b2a",
                    "sense_definition": "An English surname.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
