                {
                    "sense_id": "a183c1da-aa9f-3d34-9a2a-f59a8e26366b",
                    "sense_definition": "Действие по перемещению через какое-либо пространство или препятствие на транспортном средстве.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "travel_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Долгий <переезд> на автобусе утомил всех пассажиров.",
                            "target_lang_translations": {
                                "en": "The long bus <w>journey</w> tired out all the passengers.",
                                "de": "Die lange <w>Fahrt</w> mit dem Bus hat alle Passagiere ermüdet."
                            }
                        },
                        {
                            "text": "Безопасный <переезд> через реку возможен только на пароме.",
                            "target_lang_translations": {
                                "en": "Safe <w>crossing</w> of the river is possible only by ferry.",
                                "de": "Eine sichere <w>Überfahrt</w> über den Fluss ist nur mit der Fähre möglich."
                            }
                        }
                    ],
                    "common_phrases": [
                        "переезд через границу",
                        "утомительный переезд"
                    ],
                    "target_lang_definitions": {
                        "en": "The act of moving across a space or obstacle by vehicle.",
                        "de": "Der Vorgang, bei dem man ein Gebiet oder Hindernis mit einem Fahrzeug überquert."
                    },
                    "translations": {
