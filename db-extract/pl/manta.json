                            "ryba z gatunku manta (1.1)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "165801d5-df1d-4dfb-ab77-5d09bf8b994c",
                                "sense_id": "066b7c7a-598d-3149-9f2b-25370fb3b6b7",
                                "text": "Sfilmowano mantę, która prosiła nurków o pomoc."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "f27c8706-793c-3145-b0f7-293a51dbee64",
