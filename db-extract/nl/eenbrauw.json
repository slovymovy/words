                                "target_senses": [
                                    {
                                        "sense_id": "1d8b556a-7c9d-3f93-a61b-b298c4aa5585",
                                        "entry_id": "68643895-a17c-391d-a623-fd7cf8c7e8ab",
                                        "glosses": [
                                            "Paire de sourcils qui se rejoignent au milieu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27b2cd4d-1ae8-4bdf-93cf-8c88776608f6",
                                                "sense_id": "1d8b556a-7c9d-3f93-a61b-b298c4aa5585",
                                                "text": "Vous imaginez que les sourcils de Bernard se rejoignent pour former un monosourcil qui vous frappe et semble être la copie de sa moustache."
                                            },
                                            {
                                                "example_id": "c0b1e25a-22e5-42c6-bc45-3c45ae32b932",
                                                "sense_id": "1d8b556a-7c9d-3f93-a61b-b298c4aa5585",
                                                "text": "Son visage était un buisson de barbe et de cicatrices, dominé par deux épais sourcils qui se fondaient quasiment à la base de son nez en un monosourcil."
                                            },
                                            {
                                                "example_id": "0e3f021c-dd71-46fc-a745-64f5c2f695de",
                                                "sense_id": "1d8b556a-7c9d-3f93-a61b-b298c4aa5585",
                                                "text": "Dieu merci, quelqu'un t'a enfin débarrassée de ton monosourcil ! s'exclama Anna en pointant un ongle vert en direction des yeux de Stella."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
