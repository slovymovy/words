                                                "sense_id": "c0b0530c-157f-3e2d-82f9-19e03ca220ae",
                                                "text": "Frau Thüringer ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "640ae348-4909-408c-88d4-c06d58b38a48",
                                                "sense_id": "c0b0530c-157f-3e2d-82f9-19e03ca220ae",
                                                "text": "Herr Thüringer wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "1982c7c7-1667-4804-ada9-841837af7229",
                                                "sense_id": "c0b0530c-157f-3e2d-82f9-19e03ca220ae",
                                                "text": "Die Thüringers fliegen heute nach Liverpool."
                                            },
                                            {
                                                "example_id": "4c26e50e-22d0-434e-864a-2084ecae0699",
                                                "sense_id": "c0b0530c-157f-3e2d-82f9-19e03ca220ae",
                                                "text": "Der Thüringer trägt nie die Pullover, die die Thüringer ihm strickt."
                                            },
                                            {
                                                "example_id": "6fb64274-1a29-4a14-8f73-2b9012e8c1a4",
                                                "sense_id": "c0b0530c-157f-3e2d-82f9-19e03ca220ae",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Thüringer kommt, geht der Herr Thüringer.“"
                                            },
                                            {
                                                "example_id": "5269dea6-4983-4f04-9235-126cf6636bd9",
                                                "sense_id": "c0b0530c-157f-3e2d-82f9-19e03ca220ae",
                                                "text": "Thüringer kommt und geht."
                                            },
                                            {
                                                "example_id": "3f29548d-c3c7-493f-b866-48d7cb7aab12",
                                                "sense_id": "c0b0530c-157f-3e2d-82f9-19e03ca220ae",
                                                "text": "Thüringers kamen, sahen und siegten."
                                            }
