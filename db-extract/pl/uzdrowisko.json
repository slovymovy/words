                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e28ec885-0177-4f55-8311-df6dbd9a8b84",
                                "sense_id": "69d0177b-e74a-382c-97b3-a09093b9ec10",
                                "text": "W uzdrowisku leczy się choroby gośćcowe, stany pourazowe wymagające rehabilitacji, choroby układu pokarmowego, dróg oddechowych, układu krążenia, układu nerwowego choroby kobiece."
                            }
                        ],
