                                "example_id": "a9388975-e82b-46f4-a9a6-d36cc017035c",
                                "sense_id": "64033a53-5b3d-3d7c-8405-be374f27de42",
                                "text": "Nee, zeg het eens? zei hij, en hij kwam naast haar zitten en volgde de cirkelbeweging van het kleine schaartje."
                            }
                        ]
                    },
                    {
                        "sense_id": "ddc66d7a-b021-3c90-983b-41e2bfec98cb",
                        "entry_id": "2561583a-2fca-3397-bb35-a64e24a2be58",
                        "glosses": [
                            "een rondgaande beweging zodat men weer op de plaats van vertrek terugkomt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7fe67a06-fa0a-47bf-9280-8db903678f5d",
                                "sense_id": "ddc66d7a-b021-3c90-983b-41e2bfec98cb",
                                "text": "Juist boven zee kan de orkaan zorgen voor hoge golven en overstromingen. Meteorologen denken dat de orkaan langs de kust naar het noorden trekt en vervolgens naar de oceaan afbuigt. Er wordt zelfs rekening gehouden met een cirkelbeweging, waardoor Matthew nog eens aan land zou kunnen komen."
                            }
                        ]
                    }
