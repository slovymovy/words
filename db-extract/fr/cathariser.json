                                "example_id": "3cbe71a5-c103-45e4-9f2a-bb8c78a0964f",
                                "sense_id": "dc61d295-cd38-3ac5-84d2-a97370eed282",
                                "text": "Parce que j'aurais trop peur de me cathariser..."
