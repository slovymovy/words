                        "entry_id": "c1077ce5-1087-342d-8bf5-dfef5180d79a",
                        "glosses": [
                            "proces, w którym obywatele wybierają spośród zgłoszonych kandydatów swoich przedstawicieli do organów władzy"
                        ],
                        "tags": [],
