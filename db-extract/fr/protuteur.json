                        "glosses": [
                            "Celui qui, sans avoir été nommé tuteur, est néanmoins fondé à gérer et administrer les affaires d’un mineur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "785b007c-9094-4185-b0f1-faef412ab3a7",
                                "sense_id": "076e3ef7-9740-320c-bb40-257b69bfd3eb",
                                "text": "Celui qui épouse une tutrice devient protuteur."
                            },
                            {
                                "example_id": "d590d8fb-1eb3-4bcc-9cff-93b3f8b352a3",
                                "sense_id": "076e3ef7-9740-320c-bb40-257b69bfd3eb",
                                "text": "Deux jours après le décès, tuteur et protuteur sont nommés par un acte notarié qui fixe les responsabilités de chacun."
                            }
                        ]
                    },
                    {
                        "sense_id": "a3489684-aa8f-3726-81a2-32ecef54d74a",
