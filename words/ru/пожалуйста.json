                {
                    "sense_id": "499c4988-b81f-3cf8-bf5a-e1fd9c45809e",
                    "sense_definition": "Выражение согласия на просьбу или разрешения сделать что-либо.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "agreement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "— Можно мне войти? — <w>Пожалуйста</w>, входите.",
                            "target_lang_translations": {
                                "en": "— May I come in? — <w>Please</w>, come in.",
                                "de": "— Darf ich reinkommen? — <w>Bitte</w>, kommen Sie rein.",
                                "zh": "— 我可以进来吗？— <w>请</w>进。",
                                "nl": "— Mag ik binnenkomen? — <w>Natuurlijk</w>, kom binnen.",
                                "pl": "— Czy mogę wejść? — <w>Proszę</w>, proszę wejść.",
                                "fr": "— Puis-je entrer ? — <w>Je vous en prie</w>, entrez.",
                                "it": "— Posso entrare? — <w>Prego</w>, entri.",
                                "cs": "— Můžu vstoupit? — <w>Prosím</w>, pojďte dál.",
                                "tr": "— İçeri girebilir miyim? — <w>Buyurun</w>, girin.",
                                "es": "— ¿Puedo pasar? — <w>Adelante</w>, pasa."
                            }
                        },
                        {
                            "text": "— Я возьму эту книгу? — Да, <w>пожалуйста</w>, бери.",
                            "target_lang_translations": {
                                "en": "— Can I take this book? — Yes, <w>please do</w>, take it.",
                                "de": "— Darf ich das Buch nehmen? — Ja, <w>bitte</w>, nimm es.",
                                "zh": "— 我可以拿这本书吗？— 可以，<w>请便</w>。",
                                "nl": "— Mag ik dit boek meenemen? — Ja, <w>ga je gang</w>, neem het mee.",
                                "pl": "— Czy mogę wziąć tę książkę? — Tak, <w>proszę</w>, bierz.",
                                "fr": "— Je peux prendre ce livre ? — Oui, <w>je vous en prie</w>, prends-le.",
                                "it": "— Posso prendere questo libro? — Sì, <w>fai pure</w>.",
                                "cs": "— Můžu si vzít tuhle knihu? — Ano, <w>prosím</w>, vezmi si ji.",
                                "tr": "— Bu kitabı alabilir miyim? — Evet, <w>tabii</w>, alabilirsin.",
                                "es": "— ¿Puedo tomar este libro? — Sí, <w>por favor</w>, tómalo."
                            }
                        }
