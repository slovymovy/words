            "pos": "noun",
            "senses": [
                {
                    "sense_id": "73286ccb-dfc6-38e6-bbe9-92efd9170d5e",
                    "sense_definition": "Document récapitulatif ou état détaillé consignant des opérations financières, des résultats ou des données.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "document",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "J'ai reçu mon dernier <w>relevé</w> bancaire par courrier ce matin.",
                            "target_lang_translations": {
                                "en": "I received my latest bank <w>statement</w> by post this morning.",
                                "ru": "Сегодня утром я получил по почте свою последнюю банковскую <w>выписку</w>.",
                                "de": "Ich habe heute Morgen meinen letzten <w>Kontoauszug</w> per Post erhalten.",
                                "es": "Esta mañana he recibido por correo mi último <w>extracto</w> bancario.",
                                "zh": "今天早上，我收到了邮寄来的最新银行<w>对账单</w>。"
                            }
                        },
                        {
                            "text": "L'étudiant doit fournir un <w>relevé</w> de notes pour valider son inscription.",
                            "target_lang_translations": {
                                "en": "The student must provide a <w>transcript</w> of grades to confirm his enrolment.",
                                "ru": "Студент должен предоставить <w>ведомость</w> оценок, чтобы подтвердить своё зачисление.",
                                "de": "Der Student muss einen <w>Notenauszug</w> vorlegen, um seine Einschreibung zu bestätigen.",
                                "es": "El estudiante debe presentar un <w>certificado de notas</w> para formalizar su matrícula.",
                                "zh": "学生必须提交一份<w>成绩单</w>才能确认注册。"
                            }
                        }
                    ],
                    "synonyms": [
                        "état",
                        "bilan",
                        "récapitulatif"
                    ],
                    "common_phrases": [
                        "relevé bancaire",
                        "relevé de compte",
                        "relevé de notes",
                        "relevé d'identité bancaire"
                    ],
                    "target_lang_definitions": {
                        "en": "A summary or detailed record of financial transactions, results or data.",
                        "ru": "Документ, в котором подробно перечислены финансовые операции, результаты или данные.",
                        "de": "Zusammenfassung oder genaue Aufzeichnung von Finanzgeschäften, Ergebnissen oder Daten.",
                        "es": "Documento que resume con detalle operaciones financieras, resultados o datos.",
                        "zh": "记录财务交易、经营结果或其他数据的汇总或详细文件。"
                    },
