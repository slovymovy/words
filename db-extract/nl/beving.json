                                    {
                                        "sense_id": "7239b2b1-db7b-3dee-89c7-33a0f13ccfb6",
                                        "entry_id": "53372a1a-3ae3-35a7-b358-a4ae2e990281",
                                        "glosses": [
                                            "An earthquake."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c9cbf4dc-edd8-4171-9f66-2f6a52704c22",
                                                "sense_id": "7239b2b1-db7b-3dee-89c7-33a0f13ccfb6",
                                                "text": "Did you feel the tremor this morning?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tremor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9ad18f60-a9dc-3c78-a12d-6dd8aa702d4c",
                                        "entry_id": "2c0bdab3-6365-3597-ade2-457e663e8204",
                                        "glosses": [
                                            "To shake or quiver excessively and rapidly or involuntarily; to tremble."
                                        ],
