                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2df9dde4-7327-47d3-bf16-c9c816eeb06a",
                                                "sense_id": "da7fef6a-a951-30cf-b6d8-7139d0cec6a0",
                                                "text": "Du bist befördert worden? Das ist ja fantastisch!"
                                            },
                                            {
                                                "example_id": "61cb80ae-24d7-4a89-a6d0-622cd7ca11e2",
                                                "sense_id": "da7fef6a-a951-30cf-b6d8-7139d0cec6a0",
                                                "text": "„Für Planetenforscher sind die Saturnringe mehr als nur ein fantastisches Kunstwerk der Natur.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "020ec3fe-7329-3bcd-872e-2aa97d9a4477",
                                        "entry_id": "bb4faeb3-cc40-3483-9ddc-a44ecf22ff47",
                                        "glosses": [
                                            "veraltet, von Wahnvorstellungen erzeugt: verrückt, träumerisch"
                                        ],
                                        "tags": [],
                                        "examples": [
