                "senses": [
                    {
                        "sense_id": "2c60eb75-4e4c-322f-a8ab-f0c7f5bfa6ab",
                        "entry_id": "6b598f19-159e-37f7-9c0a-0dd2253a6073",
                        "glosses": [
                            "Volontairement exagérer quelque chose de réel (par exemple, les symptômes d'une maladie)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "414eb8b3-9326-4817-aed8-81c421c18b7f",
                                "sense_id": "2c60eb75-4e4c-322f-a8ab-f0c7f5bfa6ab",
                                "text": "L'hystérique peut simuler (sursimuler) des symptômes à l'appui des bénéfices secondaires dont il a, au moins partiellement, conscience."
                            },
                            {
                                "example_id": "24c05e4e-61f4-4819-bd97-ef189fb4c46b",
                                "sense_id": "2c60eb75-4e4c-322f-a8ab-f0c7f5bfa6ab",
                                "text": "Aussi Baudrillard déclare-t-il que ‹‹ sursimuler la féminité, c'est dire que la femme n'est qu'un modèle de simulation masculin ››."
                            }
                        ]
                    }
