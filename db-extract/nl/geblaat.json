                "forms": [],
                "senses": [
                    {
                        "sense_id": "755f615f-a9a6-3199-89a7-a43790ca6b6d",
                        "entry_id": "8f6e081a-baa6-39b3-8843-e7412a422a30",
                        "glosses": [
                            "mekkerend geluid van een schaap"
                        ],
                        "tags": [
                            "dierengeluid"
                        ],
                        "examples": [
                            {
                                "example_id": "824d836e-7d4c-4fd5-a37a-9c136a6c8d6c",
                                "sense_id": "755f615f-a9a6-3199-89a7-a43790ca6b6d",
                                "text": "De lucht was vervuld van het geloei, geknor en geblaat van de dieren."
                            }
                        ]
                    },
                    {
                        "sense_id": "4102f56b-4ea3-31ab-b191-b785a86ca090",
                        "entry_id": "8f6e081a-baa6-39b3-8843-e7412a422a30",
                        "glosses": [
                            "inhoudsloos gepraat, meestal op een luide en storende toon"
                        ],
                        "tags": [
                            "informal",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "5e60308a-2bce-4c87-85f6-aef73e9bbcbe",
                                "sense_id": "4102f56b-4ea3-31ab-b191-b785a86ca090",
                                "text": "Het geblaat van die politicus is mij een doorn in het oog."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dc953d2a-e64c-40a0-bf4d-21029d87db88",
                        "source_entry_id": "8f6e081a-baa6-39b3-8843-e7412a422a30",
                        "source_sense_id": "755f615f-a9a6-3199-89a7-a43790ca6b6d",
                        "source_sense_description": "het blaten van een schaap",
                        "target_lang_word": "Geblöke",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "0e161e62-9f63-4514-ba0a-798e9e7701e7",
                        "source_entry_id": "8f6e081a-baa6-39b3-8843-e7412a422a30",
                        "source_sense_id": "755f615f-a9a6-3199-89a7-a43790ca6b6d",
                        "source_sense_description": "het blaten van een schaap",
                        "target_lang_word": "bêlement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bêlement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2fd4a367-cead-39f4-950e-b13102f6f810",
                                        "entry_id": "a387710a-19f8-3778-ab83-d1a412633624",
                                        "glosses": [
                                            "Cri des ovins et des caprins."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77eaa6c6-076f-4095-962b-f1585ee829d2",
                                                "sense_id": "2fd4a367-cead-39f4-950e-b13102f6f810",
                                                "text": "Il ne voulait pas lâcher son mouton, mais les bêlements semblaient s’éloigner et la maudite bête tirait sur sa corde et refusait de pénétrer dans le fourré."
                                            },
                                            {
                                                "example_id": "ed5bd719-c397-43fb-98ca-a33cdf783965",
                                                "sense_id": "2fd4a367-cead-39f4-950e-b13102f6f810",
                                                "text": "Le rugissement des lions, le hennissement des chevaux, le braiement des ânes, le bêlement des béliers, le mugissement des taureaux, le grognement des cochons, des sangliers et des verrats, le raîment des cerfs, la voix grêle des gazelles, le murmure amoureux des rongeurs, les cris inarticulés des singes, les hautes clameurs des alouettes, le triste hurlement des hyènes, le glapissement des renards, le gromellement des blaireaux, &c. ; enfin tous ces accens divers dont résonnent les forêts et les déserts sauvages, ne sont dans les animaux que l’expression des desirs^([sic]) d’amour."
                                            },
                                            {
                                                "example_id": "213f3f7c-c29a-4fa9-9d65-71f3041aaa1a",
                                                "sense_id": "2fd4a367-cead-39f4-950e-b13102f6f810",
                                                "text": "On n’entend jamais, en traversant un village, le beuglement d’une vache, le bêlement d’une brebis."
                                            },
                                            {
                                                "example_id": "1ef6988b-62c4-4af1-93ec-8419cdce250f",
                                                "sense_id": "2fd4a367-cead-39f4-950e-b13102f6f810",
                                                "text": "Retourner au village, vivre avec nouveau parmi les racontars des femmes, écouter tout le jour les piaulements des dindes et des poulets, les bêlements des moutons, cela l’attirait peu."
                                            },
                                            {
                                                "example_id": "1d317a4f-7db7-46ea-b6a2-236f742e6d87",
                                                "sense_id": "2fd4a367-cead-39f4-950e-b13102f6f810",
                                                "text": "… je vais devoir faire sans la fraîcheur et la brume du matin, sans l’odeur de l’herbe meurtrie par les onglons des brebis, sans l’odeur piquante de leurs crottes et sans l’odeur âpre de leur laine. Sans leurs bêlements et leurs chevrotements, sans les blatèrements des béliers, sans le carillon des clochettes, sans le regard mystérieux des patous."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9d9adc61-ea1a-445b-9554-f76773c76043",
                        "source_entry_id": "8f6e081a-baa6-39b3-8843-e7412a422a30",
