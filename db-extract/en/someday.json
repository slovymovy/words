                                "target_senses": [
                                    {
                                        "sense_id": "f019897a-614e-3af2-a69c-8d72599247e2",
                                        "entry_id": "7fea794e-e5a6-3d07-bb33-ac8b9a031752",
                                        "glosses": [
                                            "alleen predicatief: het ~ zijn/worden over tot een vergelijk komen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f88135e3-af03-4795-a2e2-56dcf352d2af",
                                                "sense_id": "f019897a-614e-3af2-a69c-8d72599247e2",
                                                "text": "Zij konden het er niet over eens worden."
                                            },
                                            {
                                                "example_id": "a9d22361-dd42-4b40-9967-be461e37df2f",
                                                "sense_id": "f019897a-614e-3af2-a69c-8d72599247e2",
                                                "text": "Myra is een stadje in Lycië, aan de zuidkust van Turkije. Daar hebben twee bisschoppen gewoond die Nicolaas heetten. De eerste leefde in het begin van de vierde eeuw en de geleerden zijn het nog steeds niet met elkaar eens of over hem iets met zekerheid kan worden gezegd."
                                            },
                                            {
                                                "example_id": "a3f6096e-339a-45b4-bacb-83cde99a5056",
                                                "sense_id": "f019897a-614e-3af2-a69c-8d72599247e2",
                                                "text": "Den Haag is de eerste stad in Nederland die zo'n verbod invoerde. Sinds 1 januari zijn er geen fossiele reclames in bushokjes of op straat meer te zien. Het gaat bijvoorbeeld om reclames voor vliegreizen en cruisevakanties. De reisbranche was het niet eens met het verbod en spande een kort geding aan, schrijft Omroep West."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "eens",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "4f73f2e7-9e81-3518-bf04-266d3930841a",
                                        "entry_id": "1a212a50-2eae-3716-9922-4874660265f5",
                                        "glosses": [
