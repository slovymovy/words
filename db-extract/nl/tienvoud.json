                "senses": [
                    {
                        "sense_id": "ef7fa01e-5132-35fd-af72-44d83dc03448",
                        "entry_id": "c8b5f3f0-8be6-3234-8d01-bd10527d882b",
                        "glosses": [
                            "een verzameling van 10 maal zoveel exemplaren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b1c82d7-004d-470f-ac1f-85ca96a53e34",
                                "sense_id": "ef7fa01e-5132-35fd-af72-44d83dc03448",
                                "text": "Wat zes jaar geleden begon als een kleinschalig evenement met 300 deelnemers is zes jaar later uitgegroeid naar een grote organisatie met een tienvoud aan zwemmers. Meer dan 3000 mensen springen vandaag het koude water in om in actie te komen tegen ALS."
                            },
                            {
                                "example_id": "d9dc8b03-9738-4580-aebc-b721be1038d3",
                                "sense_id": "ef7fa01e-5132-35fd-af72-44d83dc03448",
                                "text": "De plannen voor het enorm ingewikkelde proces werden vaak nog in een veel te laat stadium, tijdens het bouwen, gewijzigd, aldus het BIT. Op z’n vroegst zou het project ‘operatie Basisregistratie Persoonsgegevens’ (oBRP) in 2023 zijn afgerond met nog minstens 225 miljoen aan uitgaven. Dat zou bijna een tienvoud zijn van een initiële schatting."
                            }
                        ]
                    },
                    {
                        "sense_id": "3b63472e-c96c-30d7-804b-99186625387f",
                        "entry_id": "c8b5f3f0-8be6-3234-8d01-bd10527d882b",
                        "glosses": [
                            "een getal dat bij delen door tien een resultaat oplevert zonder dat er een rest is, een getal dat eindigt op een 0"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b04fbe9f-f26b-46ba-9451-9a93031a5a95",
                                "sense_id": "3b63472e-c96c-30d7-804b-99186625387f",
                                "text": "Negentig is het tienvoud van negen."
                            }
                        ]
                    }
                ],
