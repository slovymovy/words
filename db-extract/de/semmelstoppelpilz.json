                                "target_senses": [
                                    {
                                        "sense_id": "b5b2ac81-a347-3bdc-829f-812fe7d73383",
                                        "entry_id": "43815397-56e4-388b-9042-000b0f6b4514",
                                        "glosses": [
                                            "Espèce de champignons de la famille des hydnacées, dont les spores sont portées sur des aiguillons détachables tapissant l'hyménium, au chapeau bosselé, blanc-crème, et au pied sans anneau, généralement trapu, excentré et blanchâtre (Hydnum repandum)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "665eaa43-5c6e-4d2f-b7f6-3071df3271e5",
                                                "sense_id": "b5b2ac81-a347-3bdc-829f-812fe7d73383",
                                                "text": "Le pied-de-mouton est un bon comestible sans les aiguillons."
                                            },
                                            {
                                                "example_id": "be5e2bd7-10ff-4e6b-9f32-29e3d47d43b1",
                                                "sense_id": "b5b2ac81-a347-3bdc-829f-812fe7d73383",
                                                "text": "Le pied-de-mouton est très fréquent et ne peut pas se confondre, bon comestible, il est cependant souvent un peu amer."
                                            }
                                        ]
                                    }
                                ]
