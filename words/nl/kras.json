{
    "word_family": [
        "krassen",
        "kraslot",
        "bekrassen",
        "gekrast"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ac89d12c-8684-3af6-aac7-8cead551b063",
                    "sense_definition": "Een langgerekte beschadiging op een hard, effen oppervlak veroorzaakt door een scherp voorwerp.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "beschadiging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er zit een diepe <w>kras</w> op de lak van mijn nieuwe auto.",
                            "target_lang_translations": {
                                "en": "There is a deep <w>scratch</w> on the paint of my new car."
                            }
                        },
                        {
                            "text": "Gebruik een onderzetter om een <w>kras</w> op de houten tafel te voorkomen.",
                            "target_lang_translations": {
                                "en": "Use a coaster to prevent a <w>scratch</w> on the wooden table."
                            }
                        }
                    ],
                    "common_phrases": [
                        "een diepe kras"
                    ],
                    "target_lang_definitions": {
                        "en": "An elongated damage on a hard, smooth surface caused by a sharp object."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "scratch",
                                "target_lang_sense_clarification": "a mark or shallow cut on a surface"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0aba5722-7c44-3ed7-aed3-caf605d3a017",
                    "sense_definition": "Een figuurlijke beschadiging of smet, bijvoorbeeld op iemands reputatie.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "beschadiging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dit schandaal heeft een flinke <w>kras</w> op zijn imago achtergelaten.",
                            "target_lang_translations": {
                                "en": "This scandal has left a major <w>dent</w> in his image."
                            }
                        },
                        {
                            "text": "Zijn reputatie liep door die misstap een onherstelbare <w>kras</w> op.",
                            "target_lang_translations": {
                                "en": "His reputation suffered an irreparable <w>blemish</w> due to that misstep."
                            }
                        }
                    ],
                    "common_phrases": [
                        "een kras op de reputatie"
                    ],
                    "target_lang_definitions": {
                        "en": "A figurative damage or blemish, for example on someone's reputation."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "scratch",
                                "target_lang_sense_clarification": "a minor dent or blemish on reputation"
                            },
                            {
                                "target_lang_word": "dent",
                                "target_lang_sense_clarification": "a reduction or damaging effect on reputation"
                            },
                            {
                                "target_lang_word": "blemish",
                                "target_lang_sense_clarification": "a moral defect or stain on reputation"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bf598e2a-ad96-3c8a-bd87-9476e0fb37a2",
                    "sense_definition": "Een schrapend of schor geluid, zoals van een scherp voorwerp over een oppervlak of de roep van een kraai.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "geluid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Met een luide <w>kras</w> vloog de zwarte raaf op uit de boom.",
                            "target_lang_translations": {
                                "en": "With a loud <w>croak</w>, the black raven flew up from the tree."
                            }
                        },
                        {
                            "text": "We hoorden de scherpe <w>kras</w> van de pen op het papier.",
                            "target_lang_translations": {
                                "en": "We heard the sharp <w>scratch</w> of the pen on the paper."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A scraping or harsh sound, such as from a sharp object over a surface or the call of a crow."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "scratch",
                                "target_lang_sense_clarification": "a scraping sound"
                            },
                            {
                                "target_lang_word": "screech",
                                "target_lang_sense_clarification": "a harsh, high-pitched sound"
                            },
                            {
                                "target_lang_word": "croak",
                                "target_lang_sense_clarification": "the harsh hoarse sound of a crow or raven"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "9a9dcb06-8fcc-3d4e-bc4a-c6cbd3f3f382",
                    "sense_definition": "Nog opvallend vitaal, sterk en kwiek voor iemands hoge leeftijd.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vitaliteit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wat loopt je opa nog <w>kras</w> voor zijn tachtigste!",
                            "target_lang_translations": {
                                "en": "How <w>sprightly</w> your grandfather still walks for an eighty-year-old!"
                            }
                        },
                        {
                            "text": "Zij is een <w>krasse</w> dame die nog elke dag een flinke wandeling maakt.",
                            "target_lang_translations": {
                                "en": "She is a <w>feisty</w> lady who still goes for a long walk every day."
                            }
                        }
                    ],
                    "synonyms": [
                        "levenskrachtig"
                    ],
                    "common_phrases": [
                        "een krasse knar"
                    ],
                    "target_lang_definitions": {
                        "en": "Still remarkably vital, strong, and sprightly for someone's advanced age."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "feisty",
                                "target_lang_sense_clarification": "spirited, energetic, and full of life"
                            },
                            {
                                "target_lang_word": "sprightly",
                                "target_lang_sense_clarification": "lively and full of energy, especially of an old person"
                            },
                            {
                                "target_lang_word": "hale",
                                "target_lang_sense_clarification": "strong and healthy, especially of an old person"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f8dbf16e-ffff-3a1b-81ed-6b4abe80545e",
                    "sense_definition": "Sterk, extreem of opzienbarend, meestal in een ongunstige of verbazingwekkende zin.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "extreem",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dat is wel een heel <w>kras</w> verhaal; ik kan het bijna niet geloven.",
                            "target_lang_translations": {
                                "en": "That is a very <w>bold</w> story; I can hardly believe it."
                            }
                        },
                        {
                            "text": "Er is sprake van een <w>krasse</w> tegenstelling tussen de twee standpunten.",
                            "target_lang_translations": {
                                "en": "There is a <w>stark</w> contrast between the two viewpoints."
                            }
                        }
                    ],
                    "common_phrases": [
                        "een krasse uitspraak"
                    ],
                    "target_lang_definitions": {
                        "en": "Strong, extreme, or sensational, usually in an unfavorable or astonishing sense."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "crass",
                                "target_lang_sense_clarification": "gross, extreme, or glaringly obvious"
                            },
                            {
                                "target_lang_word": "stark",
                                "target_lang_sense_clarification": "extreme, sharp, or glaring"
                            },
                            {
                                "target_lang_word": "bold",
                                "target_lang_sense_clarification": "audacious or extreme"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8075b0fa-2aa1-378d-8b50-f0b421854f04",
                    "sense_definition": "Eerste persoon enkelvoud tegenwoordige tijd van <w>krassen</w>.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "werkwoordsvorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>kras</w> de foute woorden altijd meteen door op mijn papier.",
                            "target_lang_translations": {
                                "en": "I always <w>cross</w> out the incorrect words on my paper immediately."
                            }
                        },
                        {
                            "text": "Als ik nerveus ben, <w>kras</w> ik met mijn nagels op de tafel.",
                            "target_lang_translations": {
                                "en": "When I am nervous, I <w>scratch</w> the table with my fingernails."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "first-person singular present"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "First-person singular present tense of the verb 'krassen' (to scratch, scrape, or cross out)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "scratch",
                                "target_lang_sense_clarification": "to scrape or mark with a sharp object"
                            },
                            {
                                "target_lang_word": "cross out",
                                "target_lang_sense_clarification": "to draw a line through text"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2ec01348-07a7-3b57-bbe5-268e845f4293",
                    "sense_definition": "Gebiedende wijs van <w>krassen</w>.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "werkwoordsvorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Kras</w> niet zo hard op dat papier, want er komt een gat in!",
                            "target_lang_translations": {
                                "en": "Don't <w>scratch</w> so hard on that paper, because you'll make a hole in it!"
                            }
                        },
                        {
                            "text": "<w>Kras</w> die naam maar door, want hij doet niet meer mee.",
                            "target_lang_translations": {
                                "en": "Just <w>cross</w> that name out, because he is no longer participating."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "imperative"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Imperative form of the verb 'krassen' (to scratch, scrape, or cross out)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "scratch",
                                "target_lang_sense_clarification": "to scrape or mark with a sharp object (imperative)"
                            },
                            {
                                "target_lang_word": "cross out",
                                "target_lang_sense_clarification": "to draw a line through text (imperative)"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "bcb6dd73-a565-324b-8057-89c5ec054e91",
                    "sense_definition": "Klanknabootsing van een schrapend geluid of het geluid van een kraai.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "klank",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Kras</w>, <w>kras</w>, hoorden we de schaatsen over het harde ijs glijden.",
                            "target_lang_translations": {
                                "en": "<w>Scratch</w>, <w>scratch</w>, we heard the skates glide over the hard ice."
                            }
                        },
                        {
                            "text": "De vogel riep luidkeels: <w>kras</w>, <w>kras</w>!",
                            "target_lang_translations": {
                                "en": "The bird called out loudly: <w>caw</w>, <w>caw</w>!"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Onomatopoeia of a scraping sound or the sound of a crow."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "scratch",
                                "target_lang_sense_clarification": "onomatopoeia for a scraping sound"
                            },
                            {
                                "target_lang_word": "caw",
                                "target_lang_sense_clarification": "onomatopoeia for a crow's cry"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}