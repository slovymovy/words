                ],
                "senses": [
                    {
                        "sense_id": "cd0dd8ff-a207-31f9-ae61-bde9c67a75f9",
                        "entry_id": "1dc7dc71-292b-3fc8-b79f-917e71596ae8",
                        "glosses": [
                            "Nom que les Vénitiens donnaient à certains officiers publics, qui avaient le commandement d’une flotte, d’une province, ou d’une place de guerre, ou qui étaient chargés de quelque inspection particulière."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "549aa33f-47f0-42b9-a4d7-d92eba5e98db",
                                "sense_id": "cd0dd8ff-a207-31f9-ae61-bde9c67a75f9",
                                "text": "Cette île est aujourd’hui gouvernée par un provéditeur vénitien ; elle a deux ports, entre lesquels regne un long promontoire du côte de l’orient."
                            },
                            {
                                "example_id": "34a5c07b-e2dd-45cc-87e2-8b62b9d68512",
                                "sense_id": "cd0dd8ff-a207-31f9-ae61-bde9c67a75f9",
                                "text": "L’Écolier. – Celui-là, c’est Nicolini ; celui-là, c’est le provéditeur."
                            }
                        ]
                    },
                    {
                        "sense_id": "d5c7d1bf-1b68-3198-9da4-a012715f3bd3",
                        "entry_id": "1dc7dc71-292b-3fc8-b79f-917e71596ae8",
                        "glosses": [
                            "Titre porté par certains membres du collège de pataphysique."
                        ],
                        "tags": [
                            "Par plaisanterie"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2a3da787-ce5c-4427-bb7e-c4764f6ee37e",
                        "source_entry_id": "1dc7dc71-292b-3fc8-b79f-917e71596ae8",
                        "target_lang_word": "Provveditore",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Provveditore",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "185169fe-9f59-3b1c-b1d9-6efc4851d81d",
                                        "entry_id": "aaeec478-b93b-37db-83c4-ba6bea8e1119",
                                        "glosses": [
                                            "Träger eines der zahlreichen höheren zivilen und militärischen Ämter"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f126aa89-33ae-4be1-878c-08dd6b1cc07b",
                                                "sense_id": "185169fe-9f59-3b1c-b1d9-6efc4851d81d",
                                                "text": "„Kaum war der Anker ausgeworfen, als er [der Bailo] seine Flagge als Generalkapitän der Seestreitkräfte der Republik hissen und der Provveditore die seine streichen ließ.“"
                                            },
                                            {
                                                "example_id": "6c91d6db-7f69-45fe-917a-291f64c884e8",
                                                "sense_id": "185169fe-9f59-3b1c-b1d9-6efc4851d81d",
                                                "text": "„Über das Meer wacht ihnen ein Provveditore, den sie mit sechs Galeeren nach Korfu, der Mitte ihrer Besitzungen, senden. “"
                                            },
                                            {
                                                "example_id": "4c064383-f30f-4a55-92b4-2d1c88e44ee2",
                                                "sense_id": "185169fe-9f59-3b1c-b1d9-6efc4851d81d",
                                                "text": "„Denn auf dem Rückzuge mußte das Heer sich noch einmal zum Kampfe stellen und verlor etwa die Hälfte seiner Leute, so daß der eine Provveditore sich rettete und mit über 25 000 Mann zu Fuß und zu Pferde nach Verona kam. “"
                                            },
                                            {
                                                "example_id": "3c318c49-108c-4cb4-ac82-80460ad079d3",
                                                "sense_id": "185169fe-9f59-3b1c-b1d9-6efc4851d81d",
                                                "text": "„»Voran, Herr Waser! Ihr seid mein verehrter Gast«, sagte der Schlanke, den jetzt Jenatsch und Wertmüller als den Provveditore der Republik mit höchster Ehrerbietung begrüßten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "32acd01d-d8c5-498a-b829-9733a400350c",
