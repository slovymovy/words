                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a836199-5ad5-4567-9084-160870a3d9a7",
                                "sense_id": "879eba3e-687f-3d45-bf69-745eecd7c0ce",
                                "text": "Ah, my boy, you forget the card index! Librarians invented that soothing device for the febrifuge of their souls..."
                            },
                            {
                                "example_id": "b7cd963c-522a-430d-93cd-ff862aacd66b",
                                "sense_id": "879eba3e-687f-3d45-bf69-745eecd7c0ce",
                                "text": "...therein it differs not from the mode of operation, which we observe in the famous peruvian febrifuge."
                            },
                            {
                                "example_id": "e56578b2-b89b-45b7-956f-0da742b8d0c9",
                                "sense_id": "879eba3e-687f-3d45-bf69-745eecd7c0ce",
                                "text": "And, by goodness, the door was ajar into the hall, for Constance had slipped out to the nearest pharmacy in search of a febrifuge for her fever-bound lover."
                            }
                        ]
                    }
