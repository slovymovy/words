                        "translation_id": "c0349719-492a-40ed-96dd-f6df6209162d",
                        "source_entry_id": "283300e2-a80f-33f6-a52f-d751c50d0ccf",
                        "source_sense_id": "3a43efec-e1c9-3e3a-a62c-7b532bccd464",
