{
    "word_family": [
        "bourgeois",
        "bourgeoisie"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "913b695e-a061-3a8b-8558-80bf7433277d",
                    "sense_definition": "Relating to or characteristic of the middle class, often implying pretentiousness, elitism, or a desire for high social status.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "social_status",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I do not need you or your brand new car or your <w>bougie</w> friends.",
                            "target_lang_translations": {
                                "zh": "我不需要你，也不需要你的新车，更不需要你那些<w>势利</w>的朋友。"
                            }
                        },
                        {
                            "text": "He acts so <w>bougie</w> just because he shops at expensive organic grocery stores.",
                            "target_lang_translations": {
                                "zh": "他表现得那么<w>装腔作势</w>，仅仅是因为他在昂贵的有机食品店购物。"
                            }
                        }
                    ],
                    "synonyms": [
                        "snobby",
                        "snooty",
                        "posh"
                    ],
                    "common_phrases": [
                        "bougie lifestyle",
                        "bougie attitude"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Informal term often used in African American Vernacular English."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "形容一个人表现出中产阶级式的虚荣、势利或对高社会地位的过度追求。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "势利",
                                "target_lang_sense_clarification": "形容人看重地位、虚荣。"
                            },
                            {
                                "target_lang_word": "装腔作势",
                                "target_lang_sense_clarification": "形容人故作高雅、虚伪。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2c213242-8acf-3ed2-9fe0-0ff042727baf",
                    "sense_definition": "Fancy, stylish, or high-quality in appearance.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "social_status",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They went to a <w>bougie</w> restaurant for their anniversary dinner.",
                            "target_lang_translations": {
                                "zh": "他们去了一家<w>高档</w>餐厅庆祝结婚纪念日。"
                            }
                        },
                        {
                            "text": "The hotel room had a very <w>bougie</w> design with gold accents everywhere.",
                            "target_lang_translations": {
                                "zh": "酒店房间的设计非常<w>时髦</w>，到处都是金色的装饰。"
                            }
                        }
                    ],
                    "synonyms": [
                        "classy",
                        "ritzy"
                    ],
                    "common_phrases": [
                        "bougie hotel",
                        "bougie cafe"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Informal usage."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "指外观上看起来时髦、高档或精致。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "高档",
                                "target_lang_sense_clarification": "指品质高、价格昂贵。"
                            },
                            {
                                "target_lang_word": "时髦",
                                "target_lang_sense_clarification": "指符合潮流、精致。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e55d6e46-6255-380c-9d35-0f19c622fefa",
                    "sense_definition": "A thin, flexible medical instrument used to dilate or examine a tubular anatomical structure.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "medical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The surgeon used a <w>bougie</w> to dilate the patient's esophagus during the procedure.",
                            "target_lang_translations": {
                                "zh": "手术期间，外科医生使用<w>扩张器</w>来扩张病人的食管。"
                            }
                        },
                        {
                            "text": "Medical students were taught how to properly insert a <w>bougie</w> for airway management.",
                            "target_lang_translations": {
                                "zh": "医学生们学习了如何正确插入<w>扩张器</w>以进行气道管理。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "esophageal bougie"
                    ],
                    "target_lang_definitions": {
                        "zh": "一种用于扩张或检查人体管状结构的细长医疗器械。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "扩张器",
                                "target_lang_sense_clarification": "医疗中用于扩张管腔的器械。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bec1f961-90b2-3a4a-8553-14d552e32738",
                    "sense_definition": "A wax candle.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "historical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old manuscript described the room lit only by a single flickering <w>bougie</w>.",
                            "target_lang_translations": {
                                "zh": "古老的手稿描述说，房间里只点着一支摇曳的<w>蜡烛</w>。"
                            }
                        },
                        {
                            "text": "In the eighteenth century, a <w>bougie</w> was a common source of light in wealthy homes.",
                            "target_lang_translations": {
                                "zh": "在十八世纪，<w>蜡烛</w>是富裕家庭常见的照明来源。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Refers to an older term for a candle."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "一种蜡烛。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "蜡烛",
                                "target_lang_sense_clarification": "古语中指代蜡烛。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7f4c143e-91fa-344e-bd86-01c6865d3896",
                    "sense_definition": "A person who exhibits pretentious or elitist behavior associated with the middle class.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "social_status",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Some people consider him a <w>bougie</w> because he only drinks expensive imported coffee.",
                            "target_lang_translations": {
                                "zh": "有些人认为他是个<w>势利眼</w>，因为他只喝昂贵的进口咖啡。"
                            }
                        },
                        {
                            "text": "The group of <w>bougies</w> refused to eat at the local diner.",
                            "target_lang_translations": {
                                "zh": "那群<w>势利眼</w>拒绝在当地的小餐馆吃饭。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Informal, often derogatory."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "指表现出中产阶级式虚荣或势利行为的人。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "势利眼",
                                "target_lang_sense_clarification": "指代那些虚荣、势利的人。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7b68b791-f2c8-3565-a3f7-8646de0a7396",
                    "sense_definition": "A shed used for housing cattle or sheep.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "agriculture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmer moved the sheep into the <w>bougie</w> before the storm arrived.",
                            "target_lang_translations": {
                                "zh": "暴风雨来临前，农夫把羊群赶进了<w>牲口棚</w>。"
                            }
                        },
                        {
                            "text": "The old stone <w>bougie</w> was still standing on the edge of the pasture.",
                            "target_lang_translations": {
                                "zh": "那座古老的石制<w>牲口棚</w>依然矗立在牧场边缘。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "Regional term for a farm building."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "一种用于饲养牛羊的棚舍。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "牲口棚",
                                "target_lang_sense_clarification": "指代农场中关养牲畜的建筑。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "53e4a42e-11c1-3666-bf95-8841e25d7a8b",
                    "sense_definition": "A surname of French origin.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "names",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The researcher <w>Bougie</w> published a paper on linguistics last year.",
                            "target_lang_translations": {
                                "zh": "研究员<w>布吉</w>去年发表了一篇关于语言学的论文。"
                            }
                        },
                        {
                            "text": "I met a man named Mr. <w>Bougie</w> at the conference.",
                            "target_lang_translations": {
                                "zh": "我在会议上遇到了一位名叫<w>布吉</w>先生的人。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Used as a family name."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "源自法语的姓氏。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "布吉",
                                "target_lang_sense_clarification": "音译姓氏。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eec0771d-2b1a-34bb-b1db-05ca4465687d",
                    "sense_definition": "The former name of the city of Béjaïa in Algeria.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "names",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "Historically, the port city was known as <w>Bougie</w> during the colonial period.",
                            "target_lang_translations": {
                                "zh": "在殖民时期，这座港口城市历史上被称为<w>布吉</w>。"
                            }
                        },
                        {
                            "text": "Trade routes often passed through the city of <w>Bougie</w> in North Africa.",
                            "target_lang_translations": {
                                "zh": "贸易路线经常经过北非的<w>布吉</w>城。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Refers to a historical name for a city."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "阿尔及利亚城市贝贾亚的旧称。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "布吉",
                                "target_lang_sense_clarification": "地名旧称。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}