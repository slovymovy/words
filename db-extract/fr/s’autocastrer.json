                        "sense_id": "d1dc58b8-1582-35bc-be7c-d99528706863",
                        "entry_id": "1f7e7887-2999-3201-9b2f-9d044a60e36d",
                        "glosses": [
                            "Se castrer soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19b1d32c-3be2-479c-87cb-8e5901a2a26a",
                                "sense_id": "d1dc58b8-1582-35bc-be7c-d99528706863",
                                "text": "Alors je ne vais tout de même pas m'autocastrer pour maigrir!"
                            },
                            {
                                "example_id": "9311f7cd-6b88-4dcf-8022-1996f93b5c2f",
                                "sense_id": "d1dc58b8-1582-35bc-be7c-d99528706863",
                                "text": "Il me reste plus qu'à m'autocastrer pour pouvoir la chanter et ça roule."
                            },
                            {
                                "example_id": "ff1a4bd9-85ae-44ef-b200-b685c1ebe857",
                                "sense_id": "d1dc58b8-1582-35bc-be7c-d99528706863",
                                "text": "La personne n'a plus de frein, autrement dit, elle n'a plus la capacité de s'autofrustrer (ou de s'autocastrer)."
                            }
                        ]
                    }
