                                                "sense_id": "791efeb2-4db2-35bc-ae8c-ff69e6daa8cd",
                                                "text": "Bij de fusie van de zwarte gaten ontstond een zwart gat dat meer dan 225 keer zoveel massa heeft als onze zon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3798a4a6-2a15-3314-b83a-aa156354c6eb",
                                        "entry_id": "a169a80b-24d5-3b9d-a4f7-04b72469c7fa",
                                        "glosses": [
                                            "grote hoeveelheid"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be28947c-3e09-455b-92c2-227eb4c46c80",
                                                "sense_id": "3798a4a6-2a15-3314-b83a-aa156354c6eb",
                                                "text": "Het was haar niet genoeg geweest om zich tussen de schone schijn van het leven van de Schlosses te bewegen, nee, ze had nog dichterbij willen komen, bij de littekens en de puistjes en de hete rode massa van hun hart."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a3b4fb4-aefe-3b79-bfc5-27f434147fc6",
                                        "entry_id": "a169a80b-24d5-3b9d-a4f7-04b72469c7fa",
                                        "glosses": [
                                            "menigte"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82cc4a25-62b0-4bb7-b51b-9d886870a712",
                                                "sense_id": "6a3b4fb4-aefe-3b79-bfc5-27f434147fc6",
                                                "text": "Uiteindelijk wisten naar schatting 300.000 voetballiefhebbers het stadion binnen te dringen, wat het beroemde tafereel opleverde dat een politieagent te paard probeerde de massa achter de lijnen van het veld te dwingen om de wedstrijd te kunnen laten beginnen."
                                            },
                                            {
                                                "example_id": "3d4229f8-3ad8-4ca8-bc9d-4db3cbc7041a",
                                                "sense_id": "6a3b4fb4-aefe-3b79-bfc5-27f434147fc6",
                                                "text": "Beide partijen in de toenemende strijd beschouwden de ander als een gezichtsloze, virale massa die het politieke lichaam besmette en uit de maatschappij moest worden gesneden."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "701269b9-d6eb-3a17-b7b7-7e6c8e5b6c48",
                                        "entry_id": "a169a80b-24d5-3b9d-a4f7-04b72469c7fa",
                                        "glosses": [
                                            "geleidende verbinding met de aarde"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f753c244-1978-3bf4-ba31-b7ef47ad626a",
