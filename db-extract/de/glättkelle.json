                    },
                    {
                        "translation_id": "215974b4-4b70-4b2c-93b8-7244820f2d05",
                        "source_entry_id": "8af8f4fc-1002-3946-91b8-60cc7cf67f91",
                        "source_sense_id": "773cb9e1-8d43-3db0-8d95-24dd2cfec21f",
                        "target_lang_word": "hawk",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hawk",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "96b7a6ad-9df7-3235-b6b3-8cbabc7e32a3",
                                        "entry_id": "a6d9751a-8a1d-3cae-8cbc-8044660b29bb",
                                        "glosses": [
                                            "A diurnal predatory bird of the family Accipitridae, smaller than an eagle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ecd7cb2-0d23-4aa5-a82e-bd40dc29f9f6",
                                                "sense_id": "96b7a6ad-9df7-3235-b6b3-8cbabc7e32a3",
                                                "text": "It is illegal to hunt hawks or other raptors in many parts of the world."
                                            },
                                            {
                                                "example_id": "536200d7-06e8-47fa-8225-b63a1400aa63",
                                                "sense_id": "96b7a6ad-9df7-3235-b6b3-8cbabc7e32a3",
                                                "text": "He made his hawke to fly,\nWith hogeous showte and cry."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "427b737d-1b1d-39ea-80fc-784ad52c07dd",
                                        "entry_id": "a6d9751a-8a1d-3cae-8cbc-8044660b29bb",
                                        "glosses": [
                                            "Any diurnal predatory terrestrial bird of similar size and appearance to the accipitrid hawks, such as a falcon."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0003fc77-ea55-3752-8944-a85b64ff2e47",
                                        "entry_id": "a6d9751a-8a1d-3cae-8cbc-8044660b29bb",
                                        "glosses": [
                                            "Any of various species of dragonfly of the genera Apocordulia and Austrocordulia, endemic to Australia."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c1b17e25-474f-320e-a0b8-65e6c6da3a4a",
                                        "entry_id": "a6d9751a-8a1d-3cae-8cbc-8044660b29bb",
                                        "glosses": [
                                            "An advocate of aggressive political positions and actions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b4e894b-097b-4d4f-a36d-ce7e799be7b4",
                                                "sense_id": "c1b17e25-474f-320e-a0b8-65e6c6da3a4a",
                                                "text": "A hawk by nature, Ellenborough strongly favoured presenting St Petersburg with an ultimatum warning that any further incursions into Persia would be regarded as a hostile act."
                                            },
                                            {
                                                "example_id": "64759bd4-8470-4d38-bc47-3f8e0c3f9ee5",
                                                "sense_id": "c1b17e25-474f-320e-a0b8-65e6c6da3a4a",
                                                "text": "“Everybody knows who were the hawks and who were the doves,” Bundy told the ExComm on the morning of October 28, after Khrushchev announced that he was withdrawing his missiles. “Today was the day of the doves.”"
                                            },
                                            {
                                                "example_id": "f273d976-496c-449f-bef3-71a0d4e807c2",
                                                "sense_id": "c1b17e25-474f-320e-a0b8-65e6c6da3a4a",
                                                "text": "President Donald Trump has spent years playing the role of a China hawk."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ff66c5d9-fadc-306c-8168-50b3ad27ed1e",
                                        "entry_id": "a6d9751a-8a1d-3cae-8cbc-8044660b29bb",
                                        "glosses": [
                                            "An uncooperative or purely selfish participant in an exchange or game, especially when untrusting, acquisitive or treacherous. Refers specifically to the prisoner's dilemma, a.k.a. the Hawk-Dove game."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "db5fcafa-2d72-3858-a580-719e8546651a",
                                        "entry_id": "a6d9751a-8a1d-3cae-8cbc-8044660b29bb",
                                        "glosses": [
                                            "Cold, sharp or biting wind."
                                        ],
                                        "tags": [
                                            "US",
                                            "often",
                                            "with-definite-article"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "557c9e1e-ade2-4b1b-84a2-eb6929430306",
                                                "sense_id": "db5fcafa-2d72-3858-a580-719e8546651a",
                                                "text": "[…] take-out sandwich from Arnie's on Jackson, then a brisk walk to Michigan Avenue in the face of the \"Hawk,\" blowing newspapers and skirts and the gulls wheeling over the Michigan Avenue Bridge in front of […]"
                                            },
                                            {
                                                "example_id": "4ed6d44c-644f-442f-9ca7-7064d2924a7a",
                                                "sense_id": "db5fcafa-2d72-3858-a580-719e8546651a",
                                                "text": "[…] a hand-fired coal furnace that required little attention and kept the cottage coy in spite of \"the hawk\" blowing icy blasts outside. So in spite of Thumper's continuing discomfort we enjoyed a fairly merry Christmas. But then the base daily bulletin was published with the roster of OGs (officers of the guard) for the[…]"
                                            },
                                            {
                                                "example_id": "041580d0-88a0-4a63-b7ca-79176986bd01",
                                                "sense_id": "db5fcafa-2d72-3858-a580-719e8546651a",
                                                "text": "I wanna learn by Ruby's birthday party.\" Pride turned up his collar against the hawk blowing from the river.\""
                                            },
                                            {
                                                "example_id": "43c581ab-620f-4e93-b084-fb5a7752845c",
                                                "sense_id": "db5fcafa-2d72-3858-a580-719e8546651a",
                                                "text": "[…] in Chicago […] I can't help but love winter and fall. Mostly fall, because fuck snow, and that hawk blowing off the lake is enough to make your teeth drop right out of your skull , but winter can be kind of okay if it doesn't snow a whole lot and no one asks me to go sledding or do some other Hallmark-movie nonsense."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "hawk",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5860267a-cea4-3571-9364-8921ef975db1",
                                        "entry_id": "7a9b6886-d2bf-335d-84c4-1aecea34f59d",
                                        "glosses": [
                                            "To hunt with a hawk."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2007f4ad-a25f-4d7f-a2ef-30da9304fce3",
                                                "sense_id": "5860267a-cea4-3571-9364-8921ef975db1",
                                                "text": "To hawke, or els to hunt\nFrom the auter to the funt"
                                            },
                                            {
                                                "example_id": "6c8df01a-462a-4e63-bf31-5ebff31329a5",
                                                "sense_id": "5860267a-cea4-3571-9364-8921ef975db1",
                                                "text": "He rode astride while hawking; she falconed in the ladylike position of sidesaddle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "11a28146-2572-3ca4-8a6a-798731ebaf19",
                                        "entry_id": "7a9b6886-d2bf-335d-84c4-1aecea34f59d",
                                        "glosses": [
                                            "To make an attack while on the wing; to soar and strike like a hawk."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "02cafa5d-288b-487e-9f82-6004ee470ece",
                                                "sense_id": "11a28146-2572-3ca4-8a6a-798731ebaf19",
                                                "text": "to hawk at flies"
                                            },
                                            {
                                                "example_id": "b52f80da-1523-443d-86e1-d1a6aad7d635",
                                                "sense_id": "11a28146-2572-3ca4-8a6a-798731ebaf19",
                                                "text": "A falcon, towering in her pride of place, / Was by a mousing owl hawked at and killed."
                                            },
                                            {
                                                "example_id": "f9f2a543-ff26-4013-95c5-26c773cda1e7",
                                                "sense_id": "11a28146-2572-3ca4-8a6a-798731ebaf19",
                                                "text": "But whether upward to the moon they go, Or dream the winter out in caves below, Or hawk at flies elsewhere"
                                            },
                                            {
                                                "example_id": "97ad9ebc-9ca2-4f37-a9cf-880fc4781bd0",
                                                "sense_id": "11a28146-2572-3ca4-8a6a-798731ebaf19",
                                                "text": "Dollarbirds hawk from high bare branches."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "hawk",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e09001d2-6a35-374b-a88a-f63de56f429d",
