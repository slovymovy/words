                ],
                "senses": [
                    {
                        "sense_id": "fe4eb8be-8fa1-3d10-840a-6b70b0bfc277",
                        "entry_id": "b9ca8405-b601-33a6-a4dd-227c715aa9ad",
                        "glosses": [
                            "Bildungs- und Erziehungsanstalt für Mädchen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b701a25a-4235-40e6-be85-6280e2ecda8a",
                                "sense_id": "fe4eb8be-8fa1-3d10-840a-6b70b0bfc277",
                                "text": "»Trotzkopf« Ilse wird auf das Drängen ihrer Stiefmutter hin in ein Mädchenpensionat geschickt."
                            },
                            {
                                "example_id": "2660841b-32c1-436c-a68e-bad22742c4e7",
                                "sense_id": "fe4eb8be-8fa1-3d10-840a-6b70b0bfc277",
                                "text": "„Er hielt vor dem Mädchenpensionat, in dem ich mir für den Aufenthalt ein Zimmer gebucht hatte, und stellte meine beiden Koffer vor der Tür ab.“"
                            },
                            {
                                "example_id": "b2fb3986-f993-4776-b7b2-060d9cea154e",
                                "sense_id": "fe4eb8be-8fa1-3d10-840a-6b70b0bfc277",
                                "text": "„Geboren 1891, war die Tochter von Oskar Buchheim, dem im thüringischen Gera das Hotel »Preußischer Hof« gehörte, in einem Mädchenpensionat im schweizerischen Neuchâtel aufgewachsen.“"
                            },
                            {
                                "example_id": "f66d2810-a441-42da-aadd-d66c795d37c4",
                                "sense_id": "fe4eb8be-8fa1-3d10-840a-6b70b0bfc277",
                                "text": "„Eine seltsame Kindheit war es gewiß, die E. T. A. Hoffmann in dem weiträumigen grauen Haus in der Poststraße erlebte, dessen Garten an den eines Mädchenpensionats stieß.“"
                            },
                            {
                                "example_id": "66948902-6a87-4c0c-95b6-39442e93d21c",
                                "sense_id": "fe4eb8be-8fa1-3d10-840a-6b70b0bfc277",
                                "text": "„Als er schon einen Namen hatte, lehrte er an einem vornehmen Mädchenpensionat in der Schweiz.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5e96b713-192e-4bf7-ba56-572cee712495",
                        "source_entry_id": "b9ca8405-b601-33a6-a4dd-227c715aa9ad",
                        "source_sense_id": "fe4eb8be-8fa1-3d10-840a-6b70b0bfc277",
                        "source_sense_description": "Bildungs- und Erziehungsanstalt für Mädchen",
                        "target_lang_word": "finishing school",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "finishing school",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "53ad1388-3b33-3de8-8388-83c921ab214a",
                                        "entry_id": "08fc7798-68d8-39a7-9162-02ca03c7edb4",
                                        "glosses": [
                                            "A private school intended to furnish young women with the social skills and cultural education needed in order to fulfill successfully a woman's traditional role in polite society."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4f363ad4-65be-4129-8e67-eafbf04b49ef",
                                                "sense_id": "53ad1388-3b33-3de8-8388-83c921ab214a",
                                                "text": "\"All she needs is a year or two at a fashionable finishing school, so that at eighteen she can come out with éclat,\" put in Aunt Clara."
                                            },
                                            {
                                                "example_id": "ea3ae360-8eae-4917-a9b8-8ae14ba05663",
                                                "sense_id": "53ad1388-3b33-3de8-8388-83c921ab214a",
                                                "text": "Until the 1920s, most European high schools for girls were finishing schools."
                                            },
                                            {
                                                "example_id": "25044f9b-e495-4317-beea-ddea44e8d5d1",
                                                "sense_id": "53ad1388-3b33-3de8-8388-83c921ab214a",
                                                "text": "On the advice of a well-heeled friend from Indonesia, she then decamped to Switzerland to attend the Institut Villa Pierrefeu. “They call it ‘the finishing school that refuses to be finished,’” Ms. Ho explained, the last in a dying form of pedagogy that asks wealthy women to scrutinize the folds in napkins with an intensity akin to Watson and Crick studying the double helix."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
