                "senses": [
                    {
                        "sense_id": "5d804174-8f61-3f97-a98c-05ecf78b6893",
                        "entry_id": "8f729644-c509-3bf5-b5f9-6e9276e435b1",
                        "glosses": [
                            "stały, ciepły wiatr wiejący w strefie międzyzwrotnikowej w kierunku równika"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "18f2327d-7a83-4a92-95f1-c08326948d02",
                                "sense_id": "5d804174-8f61-3f97-a98c-05ecf78b6893",
                                "text": "Na półkuli północnej pasaty wieją w kierunku równika z północnego wschodu."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "30c7dcfc-1488-4a41-9de7-71e4db8ebb92",
                        "source_entry_id": "8f729644-c509-3bf5-b5f9-6e9276e435b1",
                        "source_sense_id": "5d804174-8f61-3f97-a98c-05ecf78b6893",
                        "target_lang_word": "trade wind",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "trade wind",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e08faeac-9153-3cfc-b03b-95c69d7b6c97",
                                        "entry_id": "432450c9-6876-3ba6-b31b-356ec6074318",
                                        "glosses": [
                                            "A steady wind that blows from east to west above and below the equator."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e908df59-0e00-4131-9c2e-78a77dbd429c",
                                                "sense_id": "e08faeac-9153-3cfc-b03b-95c69d7b6c97",
                                                "text": "They rode the trade winds going west."
                                            },
                                            {
                                                "example_id": "4b1fec9c-7353-4674-8417-e4783a128cad",
                                                "sense_id": "e08faeac-9153-3cfc-b03b-95c69d7b6c97",
                                                "text": "During the summer months, from November to April, the trade wind is less steady over large parts of the ocean."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "693218aa-cb7f-464f-8277-261937221798",
                        "source_entry_id": "8f729644-c509-3bf5-b5f9-6e9276e435b1",
                        "source_sense_id": "5d804174-8f61-3f97-a98c-05ecf78b6893",
                        "target_lang_word": "alizé",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "alizé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e43089ed-7ecf-3b1a-b453-db578766eec8",
                                        "entry_id": "7417651f-22ab-30f6-b9e4-7d63f6efd88c",
                                        "glosses": [
                                            "Qualifie certains vents qui règnent entre les deux tropiques et qui soufflent de l’est à l’ouest."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "849e2574-8b00-4d57-9346-6529bbf251a7",
                                                "sense_id": "e43089ed-7ecf-3b1a-b453-db578766eec8",
                                                "text": "Je compte me servir des vents alizés, dont la direction est constante."
                                            },
                                            {
                                                "example_id": "65cf869b-bfcf-4c32-a53b-b138240df65e",
                                                "sense_id": "e43089ed-7ecf-3b1a-b453-db578766eec8",
                                                "text": "Cette zone forestière correspond à la région humide des nuages qui ceignent les flancs du pic pendant la majeure partie de l'année et qui se dissipent généralement le soir pour reparaître peu après le lever du soleil. Leur formation est due aux vents alizés du nord-est qui, dans ces parages, règnent deux jours sur trois et soufflent presque sans interruption pendant tout l'été."
                                            },
                                            {
                                                "example_id": "d5c7b7f9-f908-4e77-bb66-a4f37a875b21",
                                                "sense_id": "e43089ed-7ecf-3b1a-b453-db578766eec8",
                                                "text": "[…], le 12 mars, par 20 degrés de latitude Nord, je rencontrai les vents alizés, je pouvais compter dorénavant sur une plus faible et agréable navigation dans les mers tropicales."
                                            },
                                            {
                                                "example_id": "cdd00809-e393-4ab8-ab22-34b395c52a04",
                                                "sense_id": "e43089ed-7ecf-3b1a-b453-db578766eec8",
                                                "text": "Un paysage qu’on aurait dit taillé à la hache par quelque géant mythologique, et qui rebondissait d’îlets en remparts, laissant planer ces ombres immenses et inquiétantes, qui balayaient l’espace au gré des alizés."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "alizé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f4916fcd-a69d-30f2-8967-5db58bea8138",
                                        "entry_id": "13c5b04e-4a5b-3d72-896e-b3e65c1b1aa3",
                                        "glosses": [
                                            "Ces vents eux-mêmes."
                                        ],
                                        "tags": [
                                            "Par substantivation"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e90ad8a9-2d44-4dc1-a2dc-ee5356de6736",
                                                "sense_id": "f4916fcd-a69d-30f2-8967-5db58bea8138",
                                                "text": "[…], et dans la mer des Antilles je faisais une bonne moyenne de marche poussé par les alizés qui soufflaient frais et réguliers du Nord-Est."
                                            },
                                            {
                                                "example_id": "a357be3a-414e-4cce-9aa4-22e506c1e9b4",
                                                "sense_id": "f4916fcd-a69d-30f2-8967-5db58bea8138",
                                                "text": "Le renforcement des alizés depuis vingt ans y a créé un énorme réservoir de chaleur, « les eaux chaudes y forment une couche plus épaisse », explique Cazenave. Est-ce un effet du changement climatique ? Mystère, […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
