                "senses": [
                    {
                        "sense_id": "9b439e57-1fa1-32a6-9ade-9036aad02299",
                        "entry_id": "2ecf1660-238c-31ab-97de-babe8ae26bbc",
                        "glosses": [
                            "na een reis weer naar de oorspronkelijke plaats vliegen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c0e6a0c-85fe-4b8a-81b1-df685e0d2e35",
                                "sense_id": "9b439e57-1fa1-32a6-9ade-9036aad02299",
                                "text": "Begin twintig was ze en later die dag zou ze terugvliegen vanuit Lissabon. In de Starbucks kreeg ze oogcontact met een jongen, over en weer. Een half uur lang."
                            },
                            {
                                "example_id": "e4df29b5-c27e-47c3-9321-8fd44be54060",
                                "sense_id": "9b439e57-1fa1-32a6-9ade-9036aad02299",
                                "text": "\"Het is voor het eerst sinds de orkaan dat er een KLM-toestel op Sint-Maarten is geland\", aldus een woordvoerder van de luchtvaartmaatschappij. Het is de bedoeling het vliegtuig, met plek voor 268 passagiers, in te zetten voor meerdere pendelvluchten tussen Sint-Maarten en Aruba en/of Curaçao. \"Maandag willen we met een behoorlijk vol toestel naar Nederland terugvliegen,\" aldus de KLM-zegsman."
                            }
                        ]
                    }
