                                                "sense_id": "3c459d39-a0b9-3968-aba9-61605fed4267",
                                                "text": "Drzwi kurii zostały przeniesione i zainstalowane w bazylice św. Jana na Lateranie."
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    },
