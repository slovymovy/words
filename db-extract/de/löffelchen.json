                            {
                                "example_id": "2b70b3bf-3a9e-4f64-b59b-2c5644955739",
                                "sense_id": "99a5c2bd-f5a6-34ce-9807-5c3f66d49f35",
                                "text": "Er rührt jetzt grade mit einem kleinen Löffelchen in der Mokkatasse und unterhält sich angeregt mit den Gästen des Hauses.",
                                "translation": "Right now he is stirring with a little spoon in the Turkish coffee cup and conversing vividly with the houseguests.",
