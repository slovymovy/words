                        "tags": [],
                        "examples": [
                            {
                                "example_id": "120b50fb-2145-47ce-bed8-5564f51f412e",
                                "sense_id": "313d82d9-2e71-381b-a5a1-7016ccf0bd5f",
                                "text": "The moral philosophies are even more important to the moral scientist—the axiologist."
                            },
                            {
                                "example_id": "17dbe77d-299c-4b90-8b9c-b07d807a8022",
                                "sense_id": "313d82d9-2e71-381b-a5a1-7016ccf0bd5f",
                                "text": "It led willy-nilly to technological determinism, a philosophy that Mumford, the axiologist, generally repudiated. Even in the later pages of Technics and Civilization, he stresses the role of values in shaping technology."
                            }
                        ]
