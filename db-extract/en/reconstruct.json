                                    },
                                    {
                                        "sense_id": "d4b01a69-5a4f-301e-acf3-619a6b6fe063",
                                        "entry_id": "c3d212db-9f44-3d8d-832f-8383605ac684",
                                        "glosses": [
                                            "iets opnieuw opbouwen zoals het vroeger was geweest"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "19d4cfaa-be6f-44bf-9f9e-72f0c73e4bb3",
                                                "sense_id": "d4b01a69-5a4f-301e-acf3-619a6b6fe063",
                                                "text": "Het reconstrueren van het gebouw heeft jaren geduurd."
                                            },
                                            {
                                                "example_id": "0c63c6a9-e25d-4f73-93d9-e12877ad87a3",
                                                "sense_id": "d4b01a69-5a4f-301e-acf3-619a6b6fe063",
                                                "text": "De precieze opeenvolging van de gebeurtenissen vanaf dat moment kon later niemand meer reconstrueren."
                                            },
                                            {
                                                "example_id": "abe6d5fb-2338-4ede-bca0-775a8baaaaff",
                                                "sense_id": "d4b01a69-5a4f-301e-acf3-619a6b6fe063",
                                                "text": "Wat ik kan reconstrueren is de inhoud van haar verhaal, maar niet de taal."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0af7757e-b02e-4c11-b56e-dad317b3d46e",
