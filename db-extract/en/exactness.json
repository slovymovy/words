                "translations": [
                    {
                        "translation_id": "06a2aa23-c6d7-4277-9808-b68fde992512",
                        "source_entry_id": "94e3e193-80a6-3d59-9bc7-6e6e48f6db99",
                        "source_sense_id": "22bd1e74-a18b-31c0-b88b-df52cd9529f0",
                        "source_sense_description": "the state of being exact",
                        "target_lang_word": "exactitude",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "exactitude",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2c702fba-2d39-373b-a0fe-0e157fd7a206",
                                        "entry_id": "57b47a61-fe48-3b2b-b10c-037ecc6f5eae",
                                        "glosses": [
                                            "Qualité de celui qui est exact."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f779d5f-b5a4-41cf-9b6e-07e78b73211a",
                                                "sense_id": "2c702fba-2d39-373b-a0fe-0e157fd7a206",
                                                "text": "La collection des vice-présidents des États-Unis, qu’il avait décrite avec tant d’exactitude, formait une image persistante."
                                            },
                                            {
                                                "example_id": "8afb063d-41cc-43e8-b592-fffa816e4732",
                                                "sense_id": "2c702fba-2d39-373b-a0fe-0e157fd7a206",
                                                "text": "Mais, à part une série d’ouvrages géographiques, historiques, ethnographiques, parmi lesquels il y a des œuvres magistrales, et quelques bijoux littéraires sans prétention à l’exactitude scientifique, beaucoup de ces livres révèlent une connaissance insuffisante du sujet et n’ont souvent servi qu’à propager une foule de notions erronées […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8517f09b-dfd5-3ed5-bfa2-51ce2a08c23e",
                                        "entry_id": "57b47a61-fe48-3b2b-b10c-037ecc6f5eae",
                                        "glosses": [
                                            "Qualité de ce qui est conforme ; conformité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0eb669b2-ed73-4117-b6fa-8a5504d64702",
                                                "sense_id": "8517f09b-dfd5-3ed5-bfa2-51ce2a08c23e",
                                                "text": "L’industrie moderne est caractérisée par un souci toujours plus grand de l’exactitude ; au fur et à mesure que l’outillage devient plus scientifique, on exige que le produit présente moins de défauts cachés et que sa qualité réponde ainsi parfaitement, durant l'usage, aux apparences."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ec582b15-8b6a-3c19-be74-423e3c7b2ac5",
                                        "entry_id": "57b47a61-fe48-3b2b-b10c-037ecc6f5eae",
                                        "glosses": [
                                            "Caractère de ce qui est exact."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c3c4415-e1a4-4abb-9a3f-9cddcac91bdb",
                                                "sense_id": "ec582b15-8b6a-3c19-be74-423e3c7b2ac5",
                                                "text": "Parce que l’astronomie parvenait à calculer les tables de la lune, on a cru que le but de toute science était de prévoir avec exactitude l’avenir; […]."
                                            },
                                            {
                                                "example_id": "f858e23a-96a2-4ed1-bddb-e55b66e24624",
                                                "sense_id": "ec582b15-8b6a-3c19-be74-423e3c7b2ac5",
                                                "text": "L’exactitude d’une mesure, d’un calcul, d’une horloge, d’une balance. — L’exactitude de l’esprit, des définitions."
                                            },
                                            {
                                                "example_id": "7f7c40a8-924c-425e-a449-d7c7bf813f54",
                                                "sense_id": "ec582b15-8b6a-3c19-be74-423e3c7b2ac5",
                                                "text": "Il faut avoir de l’exactitude dans les affaires."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d507aac4-7a29-47ca-80ba-e80568dfc2a6",
                        "source_entry_id": "94e3e193-80a6-3d59-9bc7-6e6e48f6db99",
                        "source_sense_id": "22bd1e74-a18b-31c0-b88b-df52cd9529f0",
                        "source_sense_description": "the state of being exact",
                        "target_lang_word": "Genauigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Genauigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f5db2283-d6d4-32de-b0d4-a3119470b0a9",
                                        "entry_id": "52ddb228-dc4f-3aff-aad7-903d5ee30d9e",
                                        "glosses": [
                                            "das Genausein als Präzision; die Eigenschaft, dass etwas seine Aufgabe mit großer Exaktheit ausführt und es keine Abweichungen gibt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a96f2d6-5ef4-46cb-94fe-805939a8c971",
                                                "sense_id": "f5db2283-d6d4-32de-b0d4-a3119470b0a9",
                                                "text": "Die Laborwaage funktioniert mit großer Genauigkeit."
                                            },
                                            {
                                                "example_id": "3a43c00c-5332-4504-b2d2-08b51d154832",
                                                "sense_id": "f5db2283-d6d4-32de-b0d4-a3119470b0a9",
                                                "text": "„Dort erfahren Sie auch mehr zur Genauigkeiten der Angaben.“"
                                            },
                                            {
                                                "example_id": "2eff2990-3187-49ed-9ae3-2f8c1c7e7ecd",
                                                "sense_id": "f5db2283-d6d4-32de-b0d4-a3119470b0a9",
                                                "text": "„Bei der Ausrichtung geht es um Genauigkeiten von 0,01 Millimetern.“"
                                            },
                                            {
                                                "example_id": "bd4db140-5fd2-42b5-ac7f-5988545b5ee8",
                                                "sense_id": "f5db2283-d6d4-32de-b0d4-a3119470b0a9",
                                                "text": "„Es ergab sich das Diagramm 8.3.1, wobei die Genauigkeiten aller drei Voraussetzungen nach Satz 6.3.7 berechnet wurden.“"
                                            },
                                            {
                                                "example_id": "18d35a37-601f-444a-bc91-0d94f4e5e20b",
                                                "sense_id": "f5db2283-d6d4-32de-b0d4-a3119470b0a9",
                                                "text": "„Mit einfachen Registrierverfahren werden Genauigkeiten zwischen 1,5 und 3 mm erreicht.“"
                                            },
                                            {
                                                "example_id": "559a1abe-d90e-4ba9-a112-06cd3404bcdc",
                                                "sense_id": "f5db2283-d6d4-32de-b0d4-a3119470b0a9",
                                                "text": "„Wesentliche Merkmale von Ingenieurvermessungen sind zum einen die Zuverlässigkeit, d.h. die Reproduzier- und Kontrollierbarkeit, sowie die definierten Genauigkeiten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4e076441-eeb6-3631-8215-ce82db9fd1a3",
                                        "entry_id": "52ddb228-dc4f-3aff-aad7-903d5ee30d9e",
                                        "glosses": [
                                            "das Genausein als Sorgfalt; das Pflichtbewusstsein einer Person, die Aufgaben mit großer Richtigkeit erledigt und es kaum Fehler gibt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e716d9a1-a052-49a0-a3c5-e7b84c1ddd66",
                                                "sense_id": "4e076441-eeb6-3631-8215-ce82db9fd1a3",
                                                "text": "Die Arbeit im Operationssaal erfordert Fleiß und Genauigkeit."
                                            },
                                            {
                                                "example_id": "bc65e1bf-96cb-44a2-becc-d52d1720efd0",
                                                "sense_id": "4e076441-eeb6-3631-8215-ce82db9fd1a3",
                                                "text": "„Pécuchet schlug in der Universal-Biographie nach und machte sich daran, Dumas auf wissenschaftliche Genauigkeit zu prüfen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "66a78935-7c6a-4cc2-8a69-a6629f0501ea",
                        "source_entry_id": "94e3e193-80a6-3d59-9bc7-6e6e48f6db99",
                        "source_sense_id": "22bd1e74-a18b-31c0-b88b-df52cd9529f0",
                        "source_sense_description": "the state of being exact",
                        "target_lang_word": "Exaktheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Exaktheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9fadada2-b60d-352c-8615-b715062ccde2",
                                        "entry_id": "f58c7841-e55f-3a9e-a9df-d7db90696371",
                                        "glosses": [
                                            "(meist angestrebte) weitgehende Vollständigkeit und Fehlerfreiheit einer Ausführung, Wiedergabe oder Herstellung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53b9087b-f8fd-413a-9acb-3aee8785c712",
                                                "sense_id": "9fadada2-b60d-352c-8615-b715062ccde2",
                                                "text": "Bei der Deckenbemalung des Ballsaales in unserem Schloss hat Oliver mit größter Exaktheit gearbeitet."
                                            },
                                            {
                                                "example_id": "09e7849c-8e05-456f-aa5d-9a00445affcf",
                                                "sense_id": "9fadada2-b60d-352c-8615-b715062ccde2",
                                                "text": "Streng genommen kann in den Fällen einer nicht idealen Exaktheit überhaupt nicht von Exaktheit schlechthin, sondern nur von mehr oder weniger großer Exaktheit gesprochen werden."
                                            },
                                            {
                                                "example_id": "5f3025b1-70d2-48d1-b980-d69d73bd211b",
                                                "sense_id": "9fadada2-b60d-352c-8615-b715062ccde2",
                                                "text": "Eine möglichst große empirische Exaktheit der Abbildung war für die Seeleute lebensnotwendig."
                                            },
                                            {
                                                "example_id": "ddadf9d9-d7c9-4a04-bfca-2de0fdc996e3",
                                                "sense_id": "9fadada2-b60d-352c-8615-b715062ccde2",
                                                "text": "Nur wenn eine möglichst hohe Exaktheit objektiv benötigt wird, erscheint der damit einhergehende höhere Aufwand sinnvoll."
                                            },
                                            {
                                                "example_id": "26218a96-1903-4a26-baef-fba8464f872a",
                                                "sense_id": "9fadada2-b60d-352c-8615-b715062ccde2",
                                                "text": "Die Deutschen sind bekannt für ihre Ordnung und Exaktheit."
                                            },
                                            {
                                                "example_id": "15e1a9b2-aede-4644-a56b-fc0690ebeae1",
                                                "sense_id": "9fadada2-b60d-352c-8615-b715062ccde2",
                                                "text": "Ich machte Übersetzungen, langsam, aber genau, Wort für Wort, mit möglichst großer Exaktheit und Gewissenhaftigkeit."
                                            },
                                            {
                                                "example_id": "0b3b5400-b5c5-4705-938b-65bfcbfc98f1",
                                                "sense_id": "9fadada2-b60d-352c-8615-b715062ccde2",
                                                "text": "Diese Umschreibung zeichnet sich sicherlich nicht durch besondere Exaktheit aus."
                                            },
                                            {
                                                "example_id": "e76fbe38-8ac0-4070-b56f-3baafd536e31",
                                                "sense_id": "9fadada2-b60d-352c-8615-b715062ccde2",
                                                "text": "Die soziologische Voraussicht zeichnet sich heute und überhaupt durch eine sehr geringe Exaktheit aus."
                                            },
                                            {
                                                "example_id": "587b6c8d-3a5b-438e-9a72-9fb951668f45",
                                                "sense_id": "9fadada2-b60d-352c-8615-b715062ccde2",
                                                "text": "Die Singvögel können nur mit mäßiger Exaktheit (±12°) eine Schallquelle lokalisieren."
                                            },
                                            {
                                                "example_id": "5e3bb9f0-9af9-4532-b1c3-040879bb6c2b",
                                                "sense_id": "9fadada2-b60d-352c-8615-b715062ccde2",
                                                "text": "Exaktheit ist eine theorie- und modellinterne Eigenschaft. Sie findet in den Anwendungen auf die reale Erfahrung ihre Grenze."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c47e0399-e45a-35af-9de7-c022646067c0",
                                        "entry_id": "f58c7841-e55f-3a9e-a9df-d7db90696371",
                                        "glosses": [
                                            "Eindeutigkeit einer Darstellung oder Erkenntnis"
                                        ],
                                        "tags": [
                                            "Naturwissenschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9d6f6afb-f92e-4352-8c43-c8ab80d1fb5b",
                                                "sense_id": "c47e0399-e45a-35af-9de7-c022646067c0",
                                                "text": "Exaktheit ist eine theorie- und modellinterne Eigenschaft. Sie findet in den Anwendungen auf die reale Erfahrung ihre Grenze."
                                            },
                                            {
                                                "example_id": "24378f10-2368-48ce-9f5e-d8e33f68f7ee",
                                                "sense_id": "c47e0399-e45a-35af-9de7-c022646067c0",
                                                "text": "Kompromisslos exakt im Sinne einer totalen Übereinstimmung können nur Idealwissenschaften sein, weil sie ausschließlich mit Abstraktem arbeiten, das sich völlig identisch bleibt (ideale Exaktheit)."
                                            },
                                            {
                                                "example_id": "d2ccc74f-2e34-4ea0-9e2a-c0c3bdbca441",
                                                "sense_id": "c47e0399-e45a-35af-9de7-c022646067c0",
                                                "text": "Der Gegensatz zwischen der mathematischen Exaktheit der theoretischen Naturgesetze und den mit Messunsicherheiten behafteten experimentellen Daten ist grundlegend."
                                            },
                                            {
                                                "example_id": "67349eca-375e-4606-b702-96ddc3bc6b71",
                                                "sense_id": "c47e0399-e45a-35af-9de7-c022646067c0",
                                                "text": "Es zeichnet einen gebildeten Geist aus, sich mit jenem Grad an Genauigkeit zufrieden zu geben, den die Natur der Dinge zulässt, und nicht dort Exaktheit zu suchen, wo nur Annäherung möglich ist. (Aristoteles)"
                                            },
                                            {
                                                "example_id": "6ae301ef-df5b-4790-817a-ea632e4a54b2",
                                                "sense_id": "c47e0399-e45a-35af-9de7-c022646067c0",
                                                "text": "Bei der Anwendung einer Theorie auf konkrete Situationen gehen die Exaktheit der Aussagen verloren –, nur die Aussagen der Theorie selbst können exakt sein."
                                            },
                                            {
                                                "example_id": "f007a351-1502-469f-a303-53e48280cc2a",
                                                "sense_id": "c47e0399-e45a-35af-9de7-c022646067c0",
                                                "text": "Oft werden bei der Himmelsmechanik die Exaktheit ihrer Aussagen und das überraschend hohe Maß der Übereinstimmung zwischen Theorie und Wirklichkeit rühmend hervorgehoben."
                                            },
                                            {
                                                "example_id": "85fb0dd8-bd93-41ab-8343-d4696313615d",
                                                "sense_id": "c47e0399-e45a-35af-9de7-c022646067c0",
                                                "text": "Neue Entdeckungen ließen bei den Physikern Zweifel an der Exaktheit der eigenen Grundlagen aufkommen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0fba44f0-e240-45ba-ae6c-75f247316cb9",
                        "source_entry_id": "94e3e193-80a6-3d59-9bc7-6e6e48f6db99",
                        "source_sense_id": "22bd1e74-a18b-31c0-b88b-df52cd9529f0",
                        "source_sense_description": "the state of being exact",
                        "target_lang_word": "то́чность",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "то́чность",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "1191f059-190e-3dac-8968-952ee3f715ca",
                                        "entry_id": "2460ba29-3c72-3f51-9f19-1c5d8ad1f834",
                                        "glosses": [
                                            "свойство по значению прилагательного точный; выверенность, размеренность"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16a3ebaa-7b95-4c4c-8b3b-a3928ce9fecf",
                                                "sense_id": "1191f059-190e-3dac-8968-952ee3f715ca",
                                                "text": "Кроме того, он знал с точностью физиолога и боксёра, куда и как следует бить человека."
                                            },
                                            {
                                                "example_id": "08c305ce-6c41-46a0-87c8-ece16b76b494",
                                                "sense_id": "1191f059-190e-3dac-8968-952ee3f715ca",
                                                "text": "Но, каким бы инструментом ни был вооружен нейрохирург, от него требуется снайперская точность попадания в «мишень»."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce9d4a46-8c01-3e60-8fad-0115dd242034",
                                        "entry_id": "2460ba29-3c72-3f51-9f19-1c5d8ad1f834",
                                        "glosses": [
                                            "степень соответствия какому-нибудь образцу, плану или представлению"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "feba2a8d-3c81-4a78-8316-956d21361f5c",
                                                "sense_id": "ce9d4a46-8c01-3e60-8fad-0115dd242034",
                                                "text": "Противоречие между результатом опыта и теорией естественно вызвало сомнение в точности опытов."
                                            },
                                            {
                                                "example_id": "eff6774f-5b50-46a2-825c-ec4e0db2eaa8",
                                                "sense_id": "ce9d4a46-8c01-3e60-8fad-0115dd242034",
                                                "text": "Военная неэффективность «Фау-2» была видна невооруженным глазом: плохая точность попадания, малая дальность, ненадёжность."
                                            },
                                            {
                                                "example_id": "c43f21cb-f242-46a5-b96d-5108ed07d01b",
                                                "sense_id": "ce9d4a46-8c01-3e60-8fad-0115dd242034",
                                                "text": "Существенно более высокая, по сравнению с точностью кварцевых, точность атомных часов составляла одну секунду за 300 лет."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
