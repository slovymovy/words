                        "target_lang_word": "council house",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "council house",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d74204d5-2189-3f80-bc2d-412a816ab894",
                                        "entry_id": "29f8a9d0-01f5-3868-9f15-3372a9cbcd13",
                                        "glosses": [
                                            "A house built and operated by local town councils, usually of relatively low price and lived in by the working class and welfare recipients."
                                        ],
                                        "tags": [
                                            "Ireland",
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "98a3622c-6753-47ff-bb5d-6cf981b34390",
                                                "sense_id": "d74204d5-2189-3f80-bc2d-412a816ab894",
                                                "text": "The modern council house, with its bathroom and electric light, is smaller than the stockbroker's villa, but it is recognizably the same kind of house, which the farm labourer’s cottage is not."
                                            },
                                            {
                                                "example_id": "e58196c6-f660-443a-82e0-f03ac108cbd2",
                                                "sense_id": "d74204d5-2189-3f80-bc2d-412a816ab894",
                                                "text": "She maintains that the internet should face similar curbs to TV because young people are increasingly living online. \"It's totally different, someone at Google watching the video from the comfort of their office in San Francisco to someone from a council house in London, where this video is happening right outside their front door.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
