                "senses": [
                    {
                        "sense_id": "d666b5aa-676a-3c11-8ed6-c0d86f30b1b6",
                        "entry_id": "a0431ca4-f1c2-3fda-9842-fe0bb704f729",
                        "glosses": [
                            "motorgetriebenes Band, mit dem Güter über relativ kurze Strecken transportiert werden können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "148e8d88-1e7e-4963-8635-cad1cf51bd8c",
                                "sense_id": "d666b5aa-676a-3c11-8ed6-c0d86f30b1b6",
                                "text": "„Über ein Förderband rieselt Feinkohle auf einen Siebentonner-Lkw.“"
                            },
                            {
                                "example_id": "edb9c429-591e-4cf6-b9bf-47911c172dff",
                                "sense_id": "d666b5aa-676a-3c11-8ed6-c0d86f30b1b6",
                                "text": "„[A]ls Stephen an der Kasse im Supermarkt seine Waren aufs Förderband legt, verschwindet Kate mit einemmal und wird nicht mehr gefunden“"
                            },
                            {
                                "example_id": "4d16e9ef-8c8b-4721-b4f1-f579134b0dfc",
                                "sense_id": "d666b5aa-676a-3c11-8ed6-c0d86f30b1b6",
                                "text": "(übertragen:) „Der Autor Robert Rodat fabrizierte einen Plot frisch ab Förderband, mit allen üblichen Styropor-Elementen und -Figuren des Vigilante-Actionfilms“"
                            },
                            {
                                "example_id": "8dfd22f5-8bad-40f2-b598-f2fad9c887a8",
                                "sense_id": "d666b5aa-676a-3c11-8ed6-c0d86f30b1b6",
                                "text": "„Am Check-In hebt er das hellblaue Ungetüm, meine und seine Tasche auf das Förderband.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
