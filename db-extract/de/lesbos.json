                "translations": [
                    {
                        "translation_id": "901fcffb-e790-4691-9689-2fe309682398",
                        "source_entry_id": "ac1fa37d-2960-3263-b98b-87d83ee9c9c4",
                        "source_sense_id": "96151aec-2096-3510-926e-3a567058db6c",
