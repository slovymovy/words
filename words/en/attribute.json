{
    "word_family": [
        "attribution",
        "attributable",
        "attributive"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "fb8a5fb3-d0f9-3a4d-b596-6bb8ff85e356",
                    "sense_definition": "To say or believe that a situation, event, or outcome is the result of a particular thing.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "verb_cause",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>attributes</w> her success to hard work and dedication.",
                            "target_lang_translations": {
                                "ru": "Она <w>приписывает</w> свой успех упорному труду и самоотдаче.",
                                "zh": "她把成功<w>归功于</w>辛勤的工作和奉献精神。"
                            }
                        },
                        {
                            "text": "The doctors <w>attribute</w> his quick recovery to the new medicine.",
                            "target_lang_translations": {
                                "ru": "Врачи <w>приписывают</w> его быстрое выздоровление новому лекарству.",
                                "zh": "医生们将他迅速康复<w>归因于</w>这种新药。"
                            }
                        }
                    ],
                    "synonyms": [
                        "impute",
                        "lay"
                    ],
                    "common_phrases": [
                        "attribute to",
                        "attribute success to",
                        "attribute failure to"
                    ],
                    "target_lang_definitions": {
                        "ru": "Считать или утверждать, что ситуация, событие или результат являются следствием чего-либо конкретного.",
                        "zh": "认为某种情况、事件或结果是由特定原因引起的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "припи́сывать",
                                "target_lang_sense_clarification": "считать следствием"
                            },
                            {
                                "target_lang_word": "относи́ть",
                                "target_lang_sense_clarification": "объяснять причиной"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "归因于",
                                "target_lang_sense_clarification": "将结果归结为某原因"
                            },
                            {
                                "target_lang_word": "归功于",
                                "target_lang_sense_clarification": "将成功归结为某原因"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2da32320-a3a7-3b50-a3f6-1d04113f94ef",
                    "sense_definition": "To say that a work of art, text, or object was created or owned by a particular person.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "verb_authorship",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This famous painting is <w>attributed</w> to Leonardo da Vinci.",
                            "target_lang_translations": {
                                "ru": "Эта знаменитая картина <w>приписывается</w> Леонардо да Винчи.",
                                "zh": "这幅名画被<w>归于</w>列奥纳多·达·芬奇名下。"
                            }
                        },
                        {
                            "text": "The quote is often <w>attributed</w> to Shakespeare, although he may not have said it.",
                            "target_lang_translations": {
                                "ru": "Эту цитату часто <w>приписывают</w> Шекспиру, хотя он мог этого и не говорить.",
                                "zh": "这句话常被<w>归于</w>莎士比亚，尽管他可能并未说过。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "attributed to",
                        "widely attributed"
                    ],
                    "target_lang_definitions": {
                        "ru": "Утверждать, что произведение искусства, текст или объект были созданы или принадлежали определенному человеку.",
                        "zh": "认为某件艺术品、文本或物品是由特定的人创作或拥有的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "припи́сывать",
                                "target_lang_sense_clarification": "авторство"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "归于",
                                "target_lang_sense_clarification": "认定作者或来源"
                            },
                            {
                                "target_lang_word": "归功于",
                                "target_lang_sense_clarification": "认定作品归属"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "238ef181-cee8-3729-aecd-bb8967ed23b2",
                    "sense_definition": "A quality, characteristic, or feature that someone or something has.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "noun_quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His finest <w>attribute</w> is his kindness towards others.",
                            "target_lang_translations": {
                                "ru": "Его лучшее <w>качество</w> — это доброта к окружающим.",
                                "zh": "他最好的<w>特质</w>就是对他人的友善。"
                            }
                        },
                        {
                            "text": "Patience is an essential <w>attribute</w> for a good teacher.",
                            "target_lang_translations": {
                                "ru": "Терпение — неотъемлемое <w>свойство</w> хорошего учителя.",
                                "zh": "耐心是好老师必备的<w>品质</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "positive attribute",
                        "physical attribute",
                        "key attribute",
                        "personal attribute"
                    ],
                    "target_lang_definitions": {
                        "ru": "Качество, характеристика или особенность, присущая кому-либо или чему-либо.",
                        "zh": "某人或某物所具有的品质、特征或特性。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сво́йство",
                                "target_lang_sense_clarification": "характеристика"
                            },
                            {
                                "target_lang_word": "ка́чество",
                                "target_lang_sense_clarification": "существенный признак"
                            },
                            {
                                "target_lang_word": "черта́",
                                "target_lang_sense_clarification": "особенность"
                            },
                            {
                                "target_lang_word": "атрибу́т",
                                "target_lang_sense_clarification": "неотъемлемое свойство"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "特质",
                                "target_lang_sense_clarification": "独特的性质"
                            },
                            {
                                "target_lang_word": "特征",
                                "target_lang_sense_clarification": "显著的特点"
                            },
                            {
                                "target_lang_word": "品质",
                                "target_lang_sense_clarification": "人的内在素质"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8cc7676b-0690-34c5-aa28-485182fb9689",
                    "sense_definition": "A specific option, setting, or piece of data belonging to a computer file or object.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "noun_computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The file has a read-only <w>attribute</w> that prevents anyone from editing it.",
                            "target_lang_translations": {
                                "ru": "У файла есть <w>атрибут</w> «только для чтения», который не позволяет никому его редактировать.",
                                "zh": "该文件有一个只读<w>属性</w>，防止任何人对其进行编辑。"
                            }
                        },
                        {
                            "text": "You can change the font <w>attribute</w> in the document settings.",
                            "target_lang_translations": {
                                "ru": "Вы можете изменить <w>атрибут</w> шрифта в настройках документа.",
                                "zh": "你可以在文档设置中更改字体<w>属性</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "file attribute",
                        "data attribute"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "computing"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Специфический параметр, настройка или элемент данных, относящийся к компьютерному файлу или объекту.",
                        "zh": "属于计算机文件或对象的特定选项、设置或数据项。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "атрибу́т",
                                "target_lang_sense_clarification": "информатика"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "属性",
                                "target_lang_sense_clarification": "计算机数据特征"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "21baf3fb-8c15-3dba-845c-2fa80f9d5794",
                    "sense_definition": "A word, especially an adjective, that describes or qualifies a noun.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "noun_grammar",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the phrase 'red apple', the adjective 'red' functions as an <w>attribute</w>.",
                            "target_lang_translations": {
                                "ru": "В словосочетании «красное яблоко» прилагательное «красное» выполняет функцию <w>определения</w>.",
                                "zh": "在短语“红苹果”中，形容词“红”起到了<w>定语</w>的作用。"
                            }
                        },
                        {
                            "text": "The linguist analyzed the <w>attribute</w> placed before the noun.",
                            "target_lang_translations": {
                                "ru": "Лингвист проанализировал <w>атрибут</w>, стоящий перед существительным.",
                                "zh": "语言学家分析了置于名词前的<w>定语</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "qualifier"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "linguistics"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Слово, обычно прилагательное, которое описывает или уточняет существительное.",
                        "zh": "用于描述或修饰名词的词，通常指形容词。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "определе́ние",
                                "target_lang_sense_clarification": "грамматика"
                            },
                            {
                                "target_lang_word": "атрибу́т",
                                "target_lang_sense_clarification": "лингвистика"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "定语",
                                "target_lang_sense_clarification": "语法中的修饰成分"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3454ccef-efcd-318c-8a7b-fcfbc9e37946",
                    "sense_definition": "An object used in art or literature to identify a specific person, character, or office.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "noun_art",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lightning bolt is a well-known <w>attribute</w> of the god Zeus.",
                            "target_lang_translations": {
                                "ru": "Молния — известный <w>атрибут</w> бога Зевса.",
                                "zh": "闪电是众神之王宙斯广为人知的<w>象征</w>。"
                            }
                        },
                        {
                            "text": "Saints in medieval art are often depicted with a specific <w>attribute</w>.",
                            "target_lang_translations": {
                                "ru": "Святые в средневековом искусстве часто изображаются с определенным <w>атрибутом</w>.",
                                "zh": "中世纪艺术中的圣徒通常被描绘为带有特定的<w>标志</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "art"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Предмет в искусстве или литературе, используемый для идентификации конкретного лица, персонажа или должности.",
                        "zh": "艺术或文学中用于标识特定人物、角色或职位的象征性物品。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "атрибу́т",
                                "target_lang_sense_clarification": "символ"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "象征",
                                "target_lang_sense_clarification": "代表性的标志"
                            },
                            {
                                "target_lang_word": "标志",
                                "target_lang_sense_clarification": "识别特征"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}