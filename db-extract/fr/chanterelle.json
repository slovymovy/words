            {
                "entry_id": "38006b7d-9613-360b-a794-58b4a4c85b25",
                "word": "chanterelle",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "a87a3b5e-a433-4172-8666-622bab005665",
                        "entry_id": "38006b7d-9613-360b-a794-58b4a4c85b25",
                        "tags": [
                            "plural"
                        ],
                        "form": "chanterelles"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4ee47698-4e1d-3b6c-9c1d-fd9e72f321ae",
                        "entry_id": "38006b7d-9613-360b-a794-58b4a4c85b25",
                        "glosses": [
                            "Girolle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0eeade9-153b-465f-a912-d5ddecbead72",
                                "sense_id": "4ee47698-4e1d-3b6c-9c1d-fd9e72f321ae",
                                "text": "La chanterelle est un excellent champignon de couleur jaune d’œuf, à senteur forestière, qu'on se plaît d’ordinaire à consommer frais cueilli sauté à la poêle."
                            }
                        ]
                    },
                    {
                        "sense_id": "5a9b8946-2ffe-3bb6-98ce-4a0f378b25bb",
                        "entry_id": "38006b7d-9613-360b-a794-58b4a4c85b25",
                        "glosses": [
                            "Espèce de champignons à plis lamelliformes, au chapeau en forme de coupe ou d'entonnoir, et au pied sans anneau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7dedf95c-4088-468b-b1de-74bed3f7a525",
                                "sense_id": "5a9b8946-2ffe-3bb6-98ce-4a0f378b25bb",
                                "text": "Les chanterelles sont souvent comestibles mais peuvent être indigestes."
                            },
                            {
                                "example_id": "28577395-ffbb-4a5c-9a83-3c54f8386f37",
                                "sense_id": "5a9b8946-2ffe-3bb6-98ce-4a0f378b25bb",
                                "text": "Je vais communier avec les chanterelles qui naissent."
                            },
                            {
                                "example_id": "69069d24-5ec6-4a59-8ebd-4f6f56a250d1",
                                "sense_id": "5a9b8946-2ffe-3bb6-98ce-4a0f378b25bb",
                                "text": "Tout ce que nous puissions espérer à cette époque, ce sont des chanterelles."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cc6cf8e4-6dd5-45bc-9d9b-d4dba2c864fa",
                        "source_entry_id": "38006b7d-9613-360b-a794-58b4a4c85b25",
                        "target_lang_word": "Pfifferling",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pfifferling",
