                ],
                "senses": [
                    {
                        "sense_id": "d39a2cc7-eda2-34d0-b970-d7b1bafc62e8",
                        "entry_id": "67327420-aec2-3bc1-a76f-98a0040f1800",
                        "glosses": [
                            "iemand wiens taak het is inspecties uit te voeren"
                        ],
                        "tags": [
                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "559051e6-a289-4e4a-881a-9baaf12b8e49",
                                "sense_id": "d39a2cc7-eda2-34d0-b970-d7b1bafc62e8",
                                "text": "Hij is inspecteur in de bouw."
                            },
                            {
                                "example_id": "4e702e92-77a5-4f54-922f-345001ff7045",
                                "sense_id": "d39a2cc7-eda2-34d0-b970-d7b1bafc62e8",
                                "text": "Ik probeer vooral niet over te komen als een inspecteur van de Griekse Keuringsdienst, maar acteer een dolenthousiaste Nederlandse gastrofiel met een voorliefde voor de Griekse keuken."
                            }
                        ]
                    },
                    {
                        "sense_id": "08d2fee4-a415-384c-b1cb-d1cfd3fe92f9",
                        "entry_id": "67327420-aec2-3bc1-a76f-98a0040f1800",
                        "glosses": [
                            "een rang in de hiërarchie van de politie tussen brigadier en hoofdinspecteur"
                        ],
                        "tags": [
                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "81a9478b-7121-4d7c-a294-53484c431331",
                                "sense_id": "08d2fee4-a415-384c-b1cb-d1cfd3fe92f9",
                                "text": "De inspecteur komt naar me toe, steekt zijn hand uit en noemt zijn naam, Roland Huret, en inmiddels herken ik hem ook weer."
                            },
                            {
                                "example_id": "60247a6b-1a3b-4be9-9b91-41b823bea662",
                                "sense_id": "08d2fee4-a415-384c-b1cb-d1cfd3fe92f9",
                                "text": "'Hij ziet er anders uit,' had de Franse inspecteur gewaarschuwd, voordat hij me het mortuarium in Rodez binnenleidde."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "287825c5-24c7-4462-990a-9a71055ce8e9",
                        "source_entry_id": "67327420-aec2-3bc1-a76f-98a0040f1800",
                        "target_lang_word": "inspector",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inspector",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1c6fe308-f661-3305-8391-ed26ef4fed91",
                                        "entry_id": "cb77d2da-821f-3d31-9a6b-91bd8d46eceb",
                                        "glosses": [
                                            "A person employed to inspect something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fac90b57-8542-407c-8be0-2ecfe6e048aa",
                                                "sense_id": "1c6fe308-f661-3305-8391-ed26ef4fed91",
                                                "text": "Imagine a country where children do nothing but play until they start compulsory schooling at age seven. Then, without exception, they attend comprehensives until the age of 16.[…]There are no inspectors, no exams until the age of 18, no school league tables, no private tuition industry, no school uniforms.[…]"
                                            },
                                            {
                                                "example_id": "ca88941f-7061-4a50-a9b0-782a3e35c8dd",
                                                "sense_id": "1c6fe308-f661-3305-8391-ed26ef4fed91",
                                                "text": "Martin had served as inspector general since December 2023. While President Donald Trump fired inspectors general from more than a dozen federal agencies during his first week in office, the USAID watchdog had remained in place."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6079a240-d345-3fed-983b-17b5c3c185f2",
                                        "entry_id": "cb77d2da-821f-3d31-9a6b-91bd8d46eceb",
                                        "glosses": [
                                            "A police officer ranking below superintendent."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ad5b85dd-0962-3b10-8b8e-859040fb396a",
                                        "entry_id": "cb77d2da-821f-3d31-9a6b-91bd8d46eceb",
                                        "glosses": [
                                            "A software tool used to examine something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b0cf928f-a617-4478-bdd2-ad676abed471",
                                                "sense_id": "ad5b85dd-0962-3b10-8b8e-859040fb396a",
                                                "text": "Chrome has a built-in development tool called the Chrome Inspector. You can use it to examine the HTML elements in a web page; review what resources — or files, cookies, and databases — are active; follow network activity; […]"
                                            },
                                            {
                                                "example_id": "55752a7d-b5d7-4b9a-aa8e-535fdf57c37a",
                                                "sense_id": "ad5b85dd-0962-3b10-8b8e-859040fb396a",
                                                "text": "After that, with the help of the disk inspector, you can at any time compare the status of programs and system disk areas with the original one."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6dac29bc-68b8-47aa-b29f-6512cadc9135",
                        "source_entry_id": "67327420-aec2-3bc1-a76f-98a0040f1800",
                        "target_lang_word": "auditor",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "auditor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bf34d04d-f8e9-3b86-a33d-432fbe86ed96",
                                        "entry_id": "3bf89691-232f-3613-a4d3-a56aef533905",
                                        "glosses": [
                                            "One who audits bookkeeping accounts."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e2c56729-8ff7-3d6e-84b7-238dea63c2e5",
                                        "entry_id": "3bf89691-232f-3613-a4d3-a56aef533905",
                                        "glosses": [
                                            "In many jurisdictions, an elected or appointed public official in charge of the public accounts; a comptroller."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "828b2cee-e927-35e9-8bef-6ee6176d3a80",
                                        "entry_id": "3bf89691-232f-3613-a4d3-a56aef533905",
                                        "glosses": [
                                            "One who audits an academic course; who attends the lectures but does not earn academic credit."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "893a38b2-a047-349c-9b91-22ff5b4ab859",
                                        "entry_id": "3bf89691-232f-3613-a4d3-a56aef533905",
                                        "glosses": [
                                            "One who listens, typically as a member of an audience."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0bd76ce5-8330-439a-8a05-60771e8d83ec",
                                                "sense_id": "893a38b2-a047-349c-9b91-22ff5b4ab859",
                                                "text": "There is another of better notice, and whispered through the world with some attention; credulous and vulgar auditors readily believing it, and more judicious and distinctive heads not altogether rejecting it."
                                            },
                                            {
                                                "example_id": "fd77639d-a904-4564-8b7d-b0592ccdbe14",
                                                "sense_id": "893a38b2-a047-349c-9b91-22ff5b4ab859",
                                                "text": "Thus (as you will see with half an eye, my wise little auditors) these good old dames had fallen into a strange perplexity."
                                            },
                                            {
                                                "example_id": "9afe7dee-9de7-4401-bb21-4b27371ccf0d",
                                                "sense_id": "893a38b2-a047-349c-9b91-22ff5b4ab859",
                                                "text": "Sampson's tongue was still flying with rapidity, as if his auditors had not been void of a number, while Mr. Alboni and Natalie were holding a consultation aside."
                                            },
                                            {
                                                "example_id": "ea0b1e7a-b26c-4d34-a1d7-cc5ca993d56e",
                                                "sense_id": "893a38b2-a047-349c-9b91-22ff5b4ab859",
                                                "text": "As we crossed the hall the telephone-bell rang, and we were the involuntary auditors of Professor Challenger's end of the ensuing dialogue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7191255f-270b-3438-b69a-90b4ceeacc5b",
                                        "entry_id": "3bf89691-232f-3613-a4d3-a56aef533905",
                                        "glosses": [
                                            "One trained to perform spiritual guidance procedures."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d1f6bfe1-66a3-4636-95dc-9c249cf69db7",
