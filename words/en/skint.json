    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "8d9e8683-a01b-39e5-b55e-155398e0f4b0",
                    "sense_definition": "Having no money; penniless or broke.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "financial_status",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I cannot go out tonight because I am completely <w>skint</w> until payday.",
                            "target_lang_translations": {
                                "it": "Non posso uscire stasera perché sono completamente <w>al verde</w> fino al giorno di paga."
                            }
                        },
                        {
                            "text": "After paying the rent, he was <w>skint</w> and had to eat pasta for a week.",
                            "target_lang_translations": {
                                "it": "Dopo aver pagato l'affitto, era <w>al verde</w> e ha dovuto mangiare pasta per una settimana."
                            }
                        }
                    ],
                    "synonyms": [
                        "broke",
                        "penniless",
                        "impecunious"
                    ],
                    "antonyms": [
                        "wealthy",
                        "rich"
                    ],
                    "common_phrases": [
                        "completely skint",
                        "flat skint"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Commonly used in British English."
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "Senza soldi; al verde o in bolletta."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "al verde",
                                "target_lang_sense_clarification": "Espressione idiomatica comune per indicare una persona senza denaro."
                            },
                            {
                                "target_lang_word": "in bolletta",
                                "target_lang_sense_clarification": "Termine colloquiale per indicare una condizione di povertà temporanea."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d3f659ce-3e6e-3b26-ad3d-3dd4dc8b8d91",
                    "sense_definition": "Past participle of <w>skin</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physical_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hunter had already <w>skint</w> the animal before we arrived at the camp.",
                            "target_lang_translations": {
                                "it": "Il cacciatore aveva già <w>scuoiato</w> l'animale prima che arrivassimo al campo."
                            }
                        },
                        {
                            "text": "The rabbit was <w>skint</w> and prepared for the stew.",
                            "target_lang_translations": {
                                "it": "Il coniglio era stato <w>scuoiato</w> e preparato per lo stufato."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Non-standard or dialectal past participle form."
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "Participio passato non standard del verbo scuoiare."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "scuoiato",
                                "target_lang_sense_clarification": "Participio passato del verbo scuoiare, riferito all'atto di togliere la pelle a un animale."
                            }
                        ]
                    }
                }
            ]
        }
    ]
