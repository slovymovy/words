                    {
                        "sense_id": "f630f069-3ad9-363f-9ea5-6ce034e6a004",
                        "entry_id": "47a622fe-d2e0-3b1e-b963-78c81e61de6b",
                        "glosses": [
                            "zeer beroemd in de wijde omtrek en bij veel mensen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "055603ec-2a91-405c-88a8-3e208ed35ae1",
                                "sense_id": "f630f069-3ad9-363f-9ea5-6ce034e6a004",
                                "text": "Het Hinszorgel uit 1733 in de Petruskerk in Leens is wijdvermaard. Het is misschien wel het bekendste instrument van het Groninger platteland. Dat schept verwachtingen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7e53d717-b00a-417c-b7f6-c0668eb90d5e",
