                                "target_senses": [
                                    {
                                        "sense_id": "a1711276-218c-3f02-975f-f00b80b513ff",
                                        "entry_id": "790d7441-51c9-3253-875e-1f904e1dafac",
                                        "glosses": [
                                            "Feeling or characterized by ecstasy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ecb79bb-e2eb-4630-8d3b-e5e49c04f4e6",
                                                "sense_id": "a1711276-218c-3f02-975f-f00b80b513ff",
                                                "text": "[W]hilſt he heſitated there, the criſis of pleaſure overtook him, and the cloſe compreſſure of the vvarm ſurrounding fold, drevv from him the extatic guſh, even before mine vvas ready to meet it, kept up by the pain I had endur'd in the courſe of the engagement, from the unſufferable ſize of his vveapon, tho' it vvas not as yet in above half its length.",
                                                "translation": "Fanny Hill",
                                                "english": "Fanny Hill"
                                            },
                                            {
                                                "example_id": "2cca2e60-81a9-4f60-b111-d9be512eace9",
                                                "sense_id": "a1711276-218c-3f02-975f-f00b80b513ff",
                                                "text": "The moment of ejaculation in mammiferous animals is accompanied by universal excitement of the whole body, a kind of slight convulsion, which terminates in a comatose or exstatic state."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f7eca11-8dac-3192-9956-6f29db92da63",
                                        "entry_id": "790d7441-51c9-3253-875e-1f904e1dafac",
                                        "glosses": [
                                            "Extremely happy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9bd35353-c53b-4b4e-9eee-3e2f10d5f54b",
                                                "sense_id": "6f7eca11-8dac-3192-9956-6f29db92da63",
                                                "text": "Bobbie was dancing round the room on the tips of her toes uttering animal cries, apparently ecstatic in their nature."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "78100bd4-d4cb-356d-a5d1-b8c77601d555",
                                        "entry_id": "790d7441-51c9-3253-875e-1f904e1dafac",
                                        "glosses": [
                                            "Relating to, or caused by, ecstasy or excessive emotion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c013788e-8d1f-41a1-a031-a2c7567c2a36",
                                                "sense_id": "78100bd4-d4cb-356d-a5d1-b8c77601d555",
                                                "text": "ecstatic gaze    ecstatic trance"
                                            },
                                            {
                                                "example_id": "60abfc03-8985-43c2-824b-56d989af0e22",
                                                "sense_id": "78100bd4-d4cb-356d-a5d1-b8c77601d555",
                                                "text": "this ecstatic fit of love and jealousy"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ecstatic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1cd6945b-624b-3382-9f44-88324c5cdc72",
                                        "entry_id": "e8ab37ae-4e1f-3c8f-85ab-fe7137e40ee0",
                                        "glosses": [
                                            "Transports of delight; words or actions performed in a state of ecstasy."
                                        ],
                                        "tags": [
                                            "in-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ac5cae98-4b9b-45d9-87bb-aeffc227b8a9",
                                                "sense_id": "1cd6945b-624b-3382-9f44-88324c5cdc72",
                                                "text": "I think that Dante's more abstruse ecstatics / Meant to personify the Mathematics."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c28257ee-00fc-34a5-8771-b14e5ff34f57",
                                        "entry_id": "e8ab37ae-4e1f-3c8f-85ab-fe7137e40ee0",
                                        "glosses": [
                                            "A person in a state of ecstasy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "104494fa-455c-44dd-86d5-367723d7d6dc",
                                                "sense_id": "c28257ee-00fc-34a5-8771-b14e5ff34f57",
                                                "text": "If there is anything that can be called protoscripture, it is surely the utterances of ecstatics, prophets and seers..."
                                            }
