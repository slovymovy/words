                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "23ff1b7b-b959-42fc-96d0-5249eeba32a8",
                        "source_entry_id": "a6094ac5-52b4-3a6a-8b42-516a28977fca",
                        "source_sense_id": "f3d22646-a7a1-3260-8385-6c913f62d76b",
                        "source_sense_description": "derb, vulgär, abwertend: unsympathische Person",
                        "target_lang_word": "buttface",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
