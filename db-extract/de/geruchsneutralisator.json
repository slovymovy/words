                "senses": [
                    {
                        "sense_id": "deb23e09-e76d-300e-95be-e63e444b3bc2",
                        "entry_id": "132b2af9-542d-33c8-bea0-56da2c4d4be7",
                        "glosses": [
                            "Stoff oder Flüssigkeit zum Neutralisieren/Bekämpfen von (unerwünschten) Gerüchen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b248f325-bd20-458f-9b2e-8125e982cc58",
                                "sense_id": "deb23e09-e76d-300e-95be-e63e444b3bc2",
                                "text": "„Ein weiteres Gegenmittel bei hartnäckigen Gerüchen ist das Einweichen in einer Natronlösung, denn Natron ist ein hervorragender Geruchsneutralisator.“"
                            },
                            {
                                "example_id": "bcbd9e06-85a4-4a47-9ff7-0f78aa8028dc",
                                "sense_id": "deb23e09-e76d-300e-95be-e63e444b3bc2",
                                "text": "„Eine Wohltat für die angehende Ehefrau, da sie nun einen wirkungsvollen Geruchsneutralisator bei sich hatte, und nicht mehr permanent vor Übelkeit umkippen musste.“"
                            },
                            {
                                "example_id": "946e96c1-e5a4-4a7f-8fed-d3c2749ba5bf",
                                "sense_id": "deb23e09-e76d-300e-95be-e63e444b3bc2",
                                "text": "„Es bietet viele unterschiedliche Anwendungsmöglichkeiten und kann sowohl als Reinigungsmittel als auch als Geruchsneutralisator verwendet werden.“"
                            },
                            {
                                "example_id": "b2ebbd81-23c5-4a56-83f4-e25cd2ed8e1b",
                                "sense_id": "deb23e09-e76d-300e-95be-e63e444b3bc2",
                                "text": "„Ein Chemiker hat jedoch dankenswerterweise auch einen Geruchsneutralisator aus Wasserstoffperoxid, Natron und Seife entwickelt.“"
                            },
                            {
                                "example_id": "086a002f-60ca-4202-809f-c4944861dad6",
                                "sense_id": "deb23e09-e76d-300e-95be-e63e444b3bc2",
                                "text": "„Ich wusste, dass es stinken würde, also hatte ich Maskomal dabei, einen Geruchsneutralisator.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
