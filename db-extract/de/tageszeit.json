                        "examples": [
                            {
                                "example_id": "df3a6d13-d04c-4817-b806-71c66688f53a",
                                "sense_id": "6da882a5-15e3-3065-a954-5389eda80ea1",
                                "text": "Als Tageszeiten unterscheiden wir zum Beispiel Morgen, Mittag, Nachmittag, Abend und Nacht.",
                                "translation": "Among the times of day we distinguish, for example, morning, midday, afternoon, evening, and night.",
                                "english": "Among the times of day we distinguish, for example, morning, midday, afternoon, evening, and night."
                            }
                        ]
                    },
                    {
                        "sense_id": "63a8c688-f85c-3cb6-9bd8-2bc627aa072d",
                        "entry_id": "d3af3d88-bf37-34e3-9423-7f94a539c459",
