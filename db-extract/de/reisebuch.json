                "senses": [
                    {
                        "sense_id": "ed1d7c29-9983-3ce5-a1e0-0de355fca559",
                        "entry_id": "aaf9237f-a9b3-39df-bd85-a96971a6299b",
                        "glosses": [
                            "Anleitung für eine Reise"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "abf3da98-0edc-45e3-97fb-373ca757f7ed",
                                "sense_id": "ed1d7c29-9983-3ce5-a1e0-0de355fca559",
                                "text": "„Zudem bietet das Reisebuch Informatives zu Galerien und Museen, zur Film- und Musikstadt, zur Frauenszene oder zum interkulturellen Berlin.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "8f66cabd-e4bd-3bf4-b3fb-2915d3e8adb0",
                        "entry_id": "aaf9237f-a9b3-39df-bd85-a96971a6299b",
                        "glosses": [
                            "Beschreibung einer Reise"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "819c2790-bff8-4b1e-b28d-65587fd4ec2f",
                                "sense_id": "8f66cabd-e4bd-3bf4-b3fb-2915d3e8adb0",
                                "text": "Ein berühmtes Reisebuch der deutschen Literatur ist Heinrich Heines »Harzreise«."
                            },
                            {
                                "example_id": "212be62d-902e-4313-9ca3-0301d773dff1",
                                "sense_id": "8f66cabd-e4bd-3bf4-b3fb-2915d3e8adb0",
                                "text": "„Fazit: Wer Reisebücher schreiben will, hüte sich vor Journalistenschulen, hüte sich noch energischer, ein Germanistikstudium anzutreten.“"
                            },
                            {
                                "example_id": "0e830502-fa63-464d-bf3e-454578556c53",
                                "sense_id": "8f66cabd-e4bd-3bf4-b3fb-2915d3e8adb0",
                                "text": "„Seine Reisebücher machten Furore.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "d8202072-6008-393e-8af4-51b49267ce8e",
                        "entry_id": "aaf9237f-a9b3-39df-bd85-a96971a6299b",
                        "glosses": [
                            "für eine Reise geeignete Lektüre"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b729ffab-4e92-4981-a390-8e1869622d0f",
                                "sense_id": "d8202072-6008-393e-8af4-51b49267ce8e",
                                "text": "Als Reisebücher werden leichte Romane und Erzählungen bevorzugt."
