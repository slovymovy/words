                        "sense_id": "bde59555-7464-3e64-b408-0fc7de94b4d9",
                        "entry_id": "6092fc55-8177-3233-bc1e-b04e5985bd55",
                        "glosses": [
                            "Celle qui est chargée de porter un message."
