                            {
                                "example_id": "bafd8a46-6e18-4481-aa5c-b15533677bad",
                                "sense_id": "4bed9869-7968-3145-a76e-2dc1fd761a73",
                                "text": "Das Biathlon ist ein Zweifach-Kampf und gehört zu den Wintersportarten."
                            },
                            {
                                "example_id": "7a6392e5-23eb-47f0-a1de-65d145879d05",
                                "sense_id": "4bed9869-7968-3145-a76e-2dc1fd761a73",
                                "text": "Tjark betreibt Biathlon als Hobby."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "3bb45601-0d6d-3d18-b9b3-91365cb8e60b",
