                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "salary",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f97c81f1-5382-328e-b55d-b560021242cc",
                                        "entry_id": "04522e15-6ae7-32ff-bb19-b467c7ac7dcc",
                                        "glosses": [
                                            "A fixed amount of money paid to a worker, usually calculated on a monthly or annual basis, not hourly, as wages. Implies a degree of professionalism and/or autonomy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "644ab3ca-1ae0-40a2-81b1-be20b71846c2",
                                                "sense_id": "f97c81f1-5382-328e-b55d-b560021242cc",
                                                "text": "This is hire and salary, not revenge."
                                            },
                                            {
                                                "example_id": "4de70d20-c0c7-4e2b-b9e0-daf1b89d9820",
                                                "sense_id": "f97c81f1-5382-328e-b55d-b560021242cc",
                                                "text": "Andrew Houſtoun and Adam Muſhet, being Tackſmen of the Excize, did Imploy Thomas Rue to be their Collector, and gave him a Sallary of 30. pound Sterling for a year."
                                            },
                                            {
                                                "example_id": "f7d3555e-6742-4925-b704-125b0a36075e",
                                                "sense_id": "f97c81f1-5382-328e-b55d-b560021242cc",
                                                "text": "I used to say to our audiences: “It is difficult to get a man understand something, when his salary depends upon his not understanding it!”"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "salary",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ed8e74aa-92fe-3aae-a146-e4167358d407",
                                        "entry_id": "700a4a9e-5296-35c7-8eb0-6a1a2500a1cc",
                                        "glosses": [
                                            "To pay on the basis of a period of a week or longer, especially to convert from another form of compensation."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "salary",
