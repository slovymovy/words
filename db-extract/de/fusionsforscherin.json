                "senses": [
                    {
                        "sense_id": "41c00dcd-d7e6-3051-8b8a-c572d603031e",
                        "entry_id": "f142ca98-daca-3f34-a2fc-801b0f05a7e5",
                        "glosses": [
                            "Forscherin, die sich mit der Erforschung der Kernfusion beschäftigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b265c1ae-9be9-4c37-b129-a33c9bf67aab",
                                "sense_id": "41c00dcd-d7e6-3051-8b8a-c572d603031e",
                                "text": "„Weltweit arbeiten heute Fusionsforscherinnen und -forscher gemeinsam daran, die ersten Reaktoren ans Netz zu bringen.“"
                            },
                            {
                                "example_id": "49963351-d515-44fb-bbfe-e5e362734046",
                                "sense_id": "41c00dcd-d7e6-3051-8b8a-c572d603031e",
                                "text": "„Fusionsforscherin Sibylle Günter, die wissenschaftliche Direktorin des Max-Planck-Instituts für Plasmaphysik in Garching, hat McGuire jedenfalls noch auf keinem Fachkongress gesehen.“"
                            },
                            {
                                "example_id": "81393af0-98b1-4725-9a78-5c98d2842a56",
                                "sense_id": "41c00dcd-d7e6-3051-8b8a-c572d603031e",
                                "text": "„Diesen Verschmelzungsprozess versuchen Fusionsforscherinnen wie Elisabeth Wolfrum vom Max-Planck-Institut in Garching zur Stromerzeugung in einem Kraftwerk nutzbar zu machen.“"
                            },
                            {
                                "example_id": "ba62fd1f-add6-46da-a567-2707f55a82bf",
                                "sense_id": "41c00dcd-d7e6-3051-8b8a-c572d603031e",
                                "text": "„Die Fusionsenergie könnte eine willkommene Ergänzung der erneuerbaren Energien werden, schreibt die Max-Planck-Physikerin und Fusionsforscherin Sibylle Günter in einer Replik auf Ernst Ulrich von Weizsäckers kürzlich veröffentlichten Standpunkt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
