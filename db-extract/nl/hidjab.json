                        "examples": [
                            {
                                "example_id": "894bc89b-5fb0-49b5-9c4d-d6d2df2f6d71",
                                "sense_id": "621eb57c-6b49-390c-8998-66ffea1c076a",
                                "text": "Reehan wist een hidjab te stelen en bereikte ongedeerd het huis van een Syriër. Daar belde ze meteen naar haar moeder in Dohuk. De man stemde er mee in om haar en haar zoon de grens over te helpen, als ze hem tenminste 15.000 dollar (13.700 euro) zou geven."
                            },
                            {
                                "example_id": "48d4a926-7e16-49c0-ac12-fd84cab5971a",
                                "sense_id": "621eb57c-6b49-390c-8998-66ffea1c076a",
                                "text": "In de video van twee minuten zijn vijftien meisjes te zien met een zwarte hidjab, die hun naam zeggen en vertellen dat ze ontvoerd zijn in Chibok, aldus CNN. Twee moeders herkenden hun dochter, en een klasgenote van de meisjes kon een aantal van haar vriendinnen identificeren."
                            }
