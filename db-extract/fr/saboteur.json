                ],
                "senses": [
                    {
                        "sense_id": "75ab8e12-27f7-370c-b56d-b0c7ce153273",
                        "entry_id": "bf805a6c-54fe-37c9-bd85-58f9c3b62ed0",
                        "glosses": [
                            "Celui qui sabote."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "cd0fa4b0-aae5-4f25-a48f-ebcbb65bedcb",
                                "sense_id": "75ab8e12-27f7-370c-b56d-b0c7ce153273",
                                "text": "L’autre modèle courant du pervers dans l’entreprise, c’est le saboteur."
                            }
                        ]
                    },
                    {
                        "sense_id": "94be5bb9-ec29-3220-ba79-67879845115c",
                        "entry_id": "bf805a6c-54fe-37c9-bd85-58f9c3b62ed0",
                        "glosses": [
                            "Employé qui pose les sabots sur les rails pour ralentir les wagons."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1defa81b-1542-462e-8f5e-49947a5e2c43",
                                "sense_id": "94be5bb9-ec29-3220-ba79-67879845115c",
                                "text": "Pour freiner les wagons en fin de course, des agents présents entre les voies, les saboteurs ou enrayeurs, posent des sabots sur les rails."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "781e1a84-5ba4-41d0-831f-c667e1ef6275",
                        "source_entry_id": "bf805a6c-54fe-37c9-bd85-58f9c3b62ed0",
                        "target_lang_word": "Saboteur",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Saboteur",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "82cd4b9d-1557-391e-944b-57b372b6fdc2",
                                        "entry_id": "3479aa84-279e-33a3-bc44-cad53171d331",
                                        "glosses": [
                                            "jemand, der etwas sabotiert (hat)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6c373e1-c6fb-4d4a-a085-a675d0fbcc47",
                                                "sense_id": "82cd4b9d-1557-391e-944b-57b372b6fdc2",
                                                "text": "„Beim Jamming nutzen Saboteure einen Störer am Boden und überstrahlen damit das schwache Navigationssignal der Satelliten. Flugzeuge, Schiffe oder Fahrzeuge können sich dann nicht mehr genau verorten.“"
                                            },
                                            {
                                                "example_id": "eda629a3-7463-4684-857d-627aec4ce882",
                                                "sense_id": "82cd4b9d-1557-391e-944b-57b372b6fdc2",
                                                "text": "„Die Saboteure von der Fatah kamen gewöhnlich aus Syrien und operierten in kleinen Städten und Dörfern in Grenznähe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
