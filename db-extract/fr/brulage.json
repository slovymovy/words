                "senses": [
                    {
                        "sense_id": "f8cea0de-d78b-39e8-b482-90c4a75a6083",
                        "entry_id": "52085f24-0017-3f52-b64b-33f086132beb",
                        "glosses": [
                            "Action de bruler."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2c3958a-0bbf-4941-bfa7-d61cdf5d5308",
                                "sense_id": "f8cea0de-d78b-39e8-b482-90c4a75a6083",
                                "text": "Le brulage du gaz naturel, ce qu’on appelle le torchage, est habituellement considéré comme une façon à la fois sûre et efficace de se débarrasser du gaz naturel associé à la production pétrolière."
                            },
                            {
                                "example_id": "7e179e62-7ac7-475b-8d7e-c683677315cc",
                                "sense_id": "f8cea0de-d78b-39e8-b482-90c4a75a6083",
                                "text": "En 2006, la ville de Fredericton a commencé le captage des échantillons gazeux et le brulage des gaz d’enfouissement."
                            }
                        ]
                    }
                ],
