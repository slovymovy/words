                ],
                "senses": [
                    {
                        "sense_id": "a4338cc4-4dc8-3691-839e-6b41213ef97c",
                        "entry_id": "bc21e97f-ddaa-39d5-bcdf-edd6e9ce73b2",
                        "glosses": [
                            "höchstes akzeptables Ausmaß von etwas; höchste erträgliche Beanspruchung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e7c48702-b0dc-480d-9006-9b8cbcdd4587",
                                "sense_id": "a4338cc4-4dc8-3691-839e-6b41213ef97c",
                                "text": "„Unter Toleranz versteht man in diesem Zusammenhang die Fähigkeit, schädigenden Einflüssen ohne Erkrankung zu widerstehen, solange die Toleranzgrenze nicht überschritten wird.“"
                            },
                            {
                                "example_id": "0d682086-e4c5-4bc2-aa62-07bca6f7e134",
                                "sense_id": "a4338cc4-4dc8-3691-839e-6b41213ef97c",
                                "text": "„Im Anschluss daran kann ausprobiert werden, wo die individuelle Toleranzgrenze der einzelnen Lebensmittel liegt.“"
                            },
                            {
                                "example_id": "d0205a0e-e85a-43eb-b3cc-e9ca9ace3c97",
                                "sense_id": "a4338cc4-4dc8-3691-839e-6b41213ef97c",
                                "text": "„Es erfordert ein wenig Wissen und Geduld, die persönliche Toleranzgrenze auszutesten.“"
                            },
                            {
                                "example_id": "05faeb3f-7e5c-46fc-99bb-6207b85b1ced",
                                "sense_id": "a4338cc4-4dc8-3691-839e-6b41213ef97c",
                                "text": "„Die Toleranzgrenze ist bei diesen Kunden deutlich höher, sodass bei Fehlern dem Unternehmen auch eine zweite Chance zur Ausbesserung gewährt wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
