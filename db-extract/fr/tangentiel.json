                    {
                        "translation_id": "e2a0fee7-6c8a-4096-bef4-ebecaf121af6",
                        "source_entry_id": "84021946-fd95-34d1-9530-eb17abc47700",
                        "source_sense_id": "0269ba0c-2492-38a8-9c59-79b02875fab7",
                        "target_lang_word": "тангенциальный",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "тангенциальный",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "33947650-84e6-37a5-83e8-500b7f50c86c",
                                        "entry_id": "62448037-4e12-3274-9dfa-ea8805dd6081",
                                        "glosses": [
                                            "геометр. направленный по касательной в выбранной точке к какой-либо выбранной кривой (плоскости), что-либо описывающей"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72ba2b1c-6415-4456-ac51-ae67f1e9997d",
                                                "sense_id": "33947650-84e6-37a5-83e8-500b7f50c86c",
                                                "text": "Кроме сил гравитационного притяжения, на Солнце и планеты действуют тангенциальные силы приливного трения."
                                            },
                                            {
                                                "example_id": "d0dcdaf9-f7c1-4c64-96e2-7844d24fb1ea",
                                                "sense_id": "33947650-84e6-37a5-83e8-500b7f50c86c",
                                                "text": "Описанные исследования относятся к силам, возникающим при излучении, нормальном к поверхности; Пойнтинг дополнил эти опыты в том отношении, что рассмотрел случай падения пучка лучей наклонно к поглощающей поверхности; в этом случае точная сила давления разлагается на две составляющих, из которых одна направлена нормально, а другая тангенциально к поверхности; Пойнтинг закрепил поглощающее (покрытое сажей) крыло перпендикулярно коромыслу весов и направил пучок лучей под 45°к крылу; при такой постановке опыта вращение может быть вызвано только тангенциальной составляющей; из наблюдаемого отклонения энергия падающего пучка лучей была найдена равной 5,8 кал/сек, что в пределах ошибок наблюдения можно считать совпадающим с непосредственно измеренными количествами энергии 6,5."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "42157e3d-4479-3588-a161-c50bd0c2d62b",
                                        "entry_id": "62448037-4e12-3274-9dfa-ea8805dd6081",
                                        "glosses": [
                                            "матем. определяемый тангенсом угла"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c1820451-832a-374a-86c4-dbf7c3a7e3ae",
                                        "entry_id": "62448037-4e12-3274-9dfa-ea8805dd6081",
                                        "glosses": [
                                            "спец. такой, при котором плоскость распиловки, среза параллельна слоям годичных приростов"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39a1e990-5c52-4bcf-8229-eb0f464d8725",
                                                "sense_id": "c1820451-832a-374a-86c4-dbf7c3a7e3ae",
                                                "text": "Учет усушки фризы по ширине и толщине производился с подразделением на фризу радиальной и тангенциальной распиловки."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
