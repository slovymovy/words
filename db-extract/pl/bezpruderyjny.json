                "translations": [
                    {
                        "translation_id": "531dfa7d-10a7-4563-96da-fb433b312366",
                        "source_entry_id": "f92d0550-5406-3078-a347-f17e0dda76cc",
                        "source_sense_id": "ad10677e-2411-3f50-9b7e-a325743853fd",
