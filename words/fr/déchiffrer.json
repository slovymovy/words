                {
                    "sense_id": "3ac596b8-10a0-34e0-a4b0-04077159f60f",
                    "sense_definition": "Parvenir à lire une écriture difficile, effacée ou confuse.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "lecture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le médecin a une écriture si serrée que je n'arrive pas à la <w>déchiffrer</w>.",
                            "target_lang_translations": {
                                "en": "The doctor's handwriting is so cramped that I can't <w>decipher</w> it.",
                                "ru": "Почерк у врача такой убористый, что я не могу его <w>разобрать</w>.",
                                "de": "Der Arzt schreibt so eng, dass ich seine Schrift nicht <w>entziffern</w> kann.",
                                "es": "El médico tiene una letra tan apretada que no consigo <w>descifrar</w> lo que escribe.",
                                "zh": "医生的字写得太潦草了，我根本<w>辨认</w>不出来。"
                            }
                        },
                        {
                            "text": "L'historien passe ses journées à <w>déchiffrer</w> de vieux manuscrits poussiéreux.",
                            "target_lang_translations": {
                                "en": "The historian spends his days <w>deciphering</w> old, dusty manuscripts.",
                                "ru": "Историк целыми днями <w>разбирает</w> старые пыльные рукописи.",
                                "de": "Der Historiker verbringt seine Tage damit, alte, staubige Manuskripte zu <w>entziffern</w>.",
                                "es": "El historiador pasa los días <w>descifrando</w> viejos manuscritos polvorientos.",
                                "zh": "这位历史学家整天都在<w>辨认</w>布满灰尘的古老手稿。"
                            }
                        }
                    ],
                    "synonyms": [
                        "lire",
                        "décrypter"
                    ],
                    "common_phrases": [
                        "déchiffrer une écriture",
                        "déchiffrer une lettre",
                        "déchiffrer un manuscrit"
