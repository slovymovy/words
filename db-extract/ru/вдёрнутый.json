                "senses": [
                    {
                        "sense_id": "cae4b704-0c60-3a49-88a4-4dd2a16c20c6",
                        "entry_id": "5a67cf16-37b7-3743-bd6d-c787a4a8a8c8",
                        "glosses": [
                            "страд. прич. прош. вр. от вдёрнуть"
                        ],
                        "tags": [
                            "participle"
                        ],
                        "examples": [
                            {
                                "example_id": "c68f66e4-44e4-4aa0-a627-0c355a178316",
                                "sense_id": "cae4b704-0c60-3a49-88a4-4dd2a16c20c6",
                                "text": "В дополнение к её костюму надо ещё прибавить, что в ушах у ней вдёрнуто по серёжке〈…〉"
                            },
                            {
                                "example_id": "85ed200e-c377-464b-8946-69344f7612a5",
                                "sense_id": "cae4b704-0c60-3a49-88a4-4dd2a16c20c6",
                                "text": "Женщина, вдёрнутая Гришей через переднюю дверь, обернулась, и меня поразило её лицо."
                            }
                        ]
                    }
