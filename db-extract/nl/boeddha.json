                "senses": [
                    {
                        "sense_id": "80281c61-13d6-3490-b341-b243e7618402",
                        "entry_id": "89cf27c7-bdd6-36c7-bb03-387c217d4fe8",
                        "glosses": [
                            "de stichter van het boeddhisme, de Indische prins Gautama Boeddha"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5edb939e-4759-499c-8b50-02581bc7b9c5",
                                "sense_id": "80281c61-13d6-3490-b341-b243e7618402",
                                "text": "In de Lakkhanasutta, deel van de uitgebreide onderrichtingen door de Boeddha staan de zogenoemde „32 lichaamskenmerken” van de Boeddha genoemd."
                            },
                            {
                                "example_id": "2c62573c-3196-459d-bf45-a63fee959cdd",
                                "sense_id": "80281c61-13d6-3490-b341-b243e7618402",
                                "text": "⧖ Een dezer beelden, een der bekende wachters des Tempels van Boeddha, was op de beenen gezeten en negen voet hoog; de armen en beenen waren aan de gewrichten met slangen versierd, die, als de afbeelding der onsterfelijkheid, hunne staarten in den bek namen."
                            }
                        ]
                    },
                    {
                        "sense_id": "fa05ea3b-af59-3c3a-ac9e-e1d69f357051",
                        "entry_id": "89cf27c7-bdd6-36c7-bb03-387c217d4fe8",
                        "glosses": [
                            "elke volledig 'ontwaakte' persoon"
                        ],
                        "tags": [
                            "boeddhisme"
                        ],
                        "examples": [
                            {
                                "example_id": "f0ca436f-eab7-4986-98f2-127724c42489",
                                "sense_id": "fa05ea3b-af59-3c3a-ac9e-e1d69f357051",
                                "text": "Enerzijds is Maitreya inderdaad de wereldleraar en de wedergekomen Christus, maar - of het niet op kan - is hij tevens de Messias van de Joden, de Mahdi van de Mohammedanen, de vijfde Boeddha en voor de Hindoes de nieuwe incarnatie van Krishna."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "79452778-dad6-48be-80b3-6cf766191523",
                        "source_entry_id": "89cf27c7-bdd6-36c7-bb03-387c217d4fe8",
                        "target_lang_word": "Buddha",
