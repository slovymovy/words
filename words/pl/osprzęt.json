                    "sense_id": "43401be2-4b52-3d7f-a4da-52ef7a31c46e",
                    "sense_definition": "pomocnicze elementy, przyrządy i wyposażenie niezbędne do prawidłowego działania maszyny, pojazdu lub instalacji",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "technika",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Firma oferuje nowoczesny <w>osprzęt</w> elektryczny przeznaczony do montażu w nowo budowanych domach jednorodzinnych.",
                            "target_lang_translations": {
                                "ru": "Компания предлагает современную электрическую <w>арматуру</w>, предназначенную для монтажа в строящихся частных домах."
                            }
                        },
                        {
                            "text": "W 1986 roku przedsiębiorca przerzucił się na produkcję części i <w>osprzętu</w> do motocykli.",
                            "target_lang_translations": {
                                "ru": "В 1986 году предприниматель переключился на производство запчастей и <w>комплектующих</w> для мотоциклов."
                            }
                        }
                    ],
                    "synonyms": [
                        "armatura"
                    ],
                    "common_phrases": [
                        "osprzęt elektryczny",
                        "osprzęt silnika",
                        "osprzęt instalacyjny"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вспомогательные элементы, приспособления и оборудование, необходимые для правильной работы машины, транспортного средства или системы"
                    },
                    "translations": {
                        "ru": [
                            {
