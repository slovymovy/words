                        "glosses": [
                            "Destiné à éviter les regroupements sur la voie publique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7b5e7c71-3e0c-449d-9246-e6a84d798f7d",
                                "sense_id": "f3a85215-c50e-3bbf-8749-e78474b07613",
                                "text": "Mathieu Hanotin, le maire, a annoncé prendre un arrêté municipal « antiregroupement » d’une durée de quatre jours visant à donner à la police municipale les moyens juridiques pour disperser tout rassemblement susceptible d’entraîner des confrontations entre bandes."
                            },
                            {
                                "example_id": "31c7ee93-0e59-4551-b148-1a2fbd556043",
                                "sense_id": "f3a85215-c50e-3bbf-8749-e78474b07613",
                                "text": "Bousbecque: la police justifie l’utilité de l’arrêté antiregroupement."
                            },
                            {
                                "example_id": "506c3105-91b8-4661-9ca2-16e17d04f771",
                                "sense_id": "f3a85215-c50e-3bbf-8749-e78474b07613",
                                "text": "En 2020, le maire avait pris un arrêté antiregroupement, finalement annulé par la préfecture."
