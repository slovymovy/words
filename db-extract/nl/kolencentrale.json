                        "source_sense_description": "(elektrotechniek) (werktuigbouwkunde) thermische centrale die elektrische stroom opwekt door verbranding van steenkool",
                        "target_lang_word": "Kohlekraftwerk",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kohlekraftwerk",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "599ba4c4-0163-30e0-9f84-450d7d64078f",
                                        "entry_id": "40e05c20-cfc8-3d43-b371-0f4f5676fca2",
                                        "glosses": [
                                            "Kraftwerk, das Kohle zur Energiegewinnung nutzt"
                                        ],
                                        "tags": [
                                            "Energie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c2041f9e-9465-48ac-9001-613913cbdc60",
                                                "sense_id": "599ba4c4-0163-30e0-9f84-450d7d64078f",
                                                "text": "„Und Vattenfall unternimmt in Brandenburg den Versuch zu demonstrieren, dass ein Kohlekraftwerk mit CO2-Abscheidung möglich ist.“"
                                            },
                                            {
                                                "example_id": "33cb1ded-ebee-49fe-8139-9ab3a07e652f",
                                                "sense_id": "599ba4c4-0163-30e0-9f84-450d7d64078f",
                                                "text": "„Einem Ausbau von Kohlekraftwerken steht er nicht nur aus klimapolitischen Gründen äußerst skeptisch gegenüber.“"
                                            },
                                            {
                                                "example_id": "e99a6e2a-38df-4f2a-9c47-9679868c820b",
                                                "sense_id": "599ba4c4-0163-30e0-9f84-450d7d64078f",
                                                "text": "„Immer noch planen 34 Länder weltweit neue Kohlekraftwerke.“"
                                            },
                                            {
                                                "example_id": "2d60e493-8451-4cc5-a22b-de53dc93ba85",
                                                "sense_id": "599ba4c4-0163-30e0-9f84-450d7d64078f",
                                                "text": "„In NRW stehen 52 und damit deutschlandweit die meisten Kohlekraftwerke.“"
                                            },
                                            {
                                                "example_id": "be416345-89c8-4f43-a861-58c48d1a66d8",
                                                "sense_id": "599ba4c4-0163-30e0-9f84-450d7d64078f",
                                                "text": "„Moderne Gaskraftwerke emittieren weniger CO₂ als Kohlekraftwerke.“"
                                            },
                                            {
                                                "example_id": "c8049b84-b7e9-4842-9876-0419c61fc233",
                                                "sense_id": "599ba4c4-0163-30e0-9f84-450d7d64078f",
                                                "text": "[Gasembargo:] „RWE will im kommenden Winter mit Kohlekraftwerken bereitstehen, falls nicht mehr genug Strom aus Gas erzeugt werden kann.“"
                                            },
                                            {
                                                "example_id": "4badbc7c-e5c7-491d-94ac-7cd1d68f75b7",
                                                "sense_id": "599ba4c4-0163-30e0-9f84-450d7d64078f",
                                                "text": "„Kohlekraftwerke sind flexibler als Atomkraftwerke, aber bei weitem nicht in dem Maße wie Gaskraftwerke.“"
                                            },
                                            {
                                                "example_id": "eba48f54-a0c3-4f38-bbac-bc5845ed03e0",
                                                "sense_id": "599ba4c4-0163-30e0-9f84-450d7d64078f",
                                                "text": "„Die riesige Wärmepumpe soll einen wesentlichen Teil dazu beitragen, das alte Kohlekraftwerk in der Stadt überflüssig zu machen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
