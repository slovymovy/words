                "translations": [
                    {
                        "translation_id": "b82457a1-eb7f-46ab-a91f-470b00de2eda",
                        "source_entry_id": "ede147bb-ad0c-333a-a082-9d7a3e08e1ee",
                        "source_sense_id": "b189d02c-9c4b-3b85-bbf6-874f8010607b",
                        "source_sense_description": "Zusammengehörigkeit",
                        "target_lang_word": "Zusammengehörigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zusammengehörigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f872fa6f-a955-3a98-9e5e-ddc11cf2904e",
                                        "entry_id": "37ab171f-357f-31c5-ba55-bb3424a5b958",
                                        "glosses": [
                                            "enge Verbundenheit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "73a267fe-dcca-4a39-9c7a-183af5eb5820",
                                                "sense_id": "f872fa6f-a955-3a98-9e5e-ddc11cf2904e",
                                                "text": "„Diese 19. Sure soll im Jahr 616 von Muslimen, die nach Abessinien ausgewandert waren, dem dortigen christlichen Kaiser und seinen Religionsgelehrten vorgetragen worden sein; diese sollen darin ein Zeichen der Zusammengehörigkeit zwischen der neuen islamischen Gemeinde und den Christen gesehen haben.“"
                                            },
                                            {
                                                "example_id": "a732ed70-337d-4fe8-affd-d4eb663c2f09",
                                                "sense_id": "f872fa6f-a955-3a98-9e5e-ddc11cf2904e",
                                                "text": "„Er kann aus dem Wortschatz herausgelöste Komplexe untersuchen, deren Zusammengehörigkeit und Entwicklung auf Grundmotive und rekonstruierte Grundformen erläuternd zurückführen.“"
                                            },
                                            {
                                                "example_id": "7dbc98c0-03b4-4055-8ca3-f013d980a0bb",
                                                "sense_id": "f872fa6f-a955-3a98-9e5e-ddc11cf2904e",
                                                "text": "„Die Zusammengehörigkeit zwischen Eltern und Kindern war schlussendlich eine Frage des richtigen Geruchs.“"
                                            },
                                            {
                                                "example_id": "62adcc8a-d57e-4cac-af18-9ec42d9e584a",
                                                "sense_id": "f872fa6f-a955-3a98-9e5e-ddc11cf2904e",
                                                "text": "„Beide waren von einem Gefühl der Zusammengehörigkeit erfüllt, wie es sie noch nie so sicher beseligt hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
