                "senses": [
                    {
                        "sense_id": "de5500b7-48e0-38df-a7e3-01a6a75dc702",
                        "entry_id": "4cc19f05-2eb7-3d4c-a011-dfec3dc58909",
                        "glosses": [
                            "Cercler une roue avec une bande de fer."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "bd6972c5-cf84-37a5-bb82-ef766104d83d",
                        "entry_id": "4cc19f05-2eb7-3d4c-a011-dfec3dc58909",
                        "glosses": [
                            "Retoucher un outil en métal avec un marteau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e74afe6-7722-494b-8bc9-683b1ee03af4",
                                "sense_id": "bd6972c5-cf84-37a5-bb82-ef766104d83d",
                                "text": "Je les trouve assis par terre à l’ombre, la petite enclume plantée entre les jambes écartées, travaillant la faux à petits coups précis du « marteau à embattre »."
                            },
                            {
                                "example_id": "25eba073-6ab4-480a-aae5-b84fbd19d5f8",
                                "sense_id": "bd6972c5-cf84-37a5-bb82-ef766104d83d",
                                "text": "Quand la bonne femme y vint, vers les huit heures, avec un copieux déjeuner, elle le trouva assis qui embattait mélancoliquement sa faux."
                            }
                        ]
                    }
