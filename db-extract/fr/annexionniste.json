                        "sense_id": "fce5d950-092c-3262-9332-302d7030ce4c",
                        "entry_id": "bf725842-99f2-3cb7-9736-38b18578f769",
                        "glosses": [
                            "Relatif à l’annexionnisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "03e11c5b-4fa0-4bb1-b517-66d5a67b68f9",
                                "sense_id": "fce5d950-092c-3262-9332-302d7030ce4c",
                                "text": "Le voisinage de la France exposait le Hainaut aux visées annexionnistes, réelles ou supposées, de Napoléon le Petit, qui semblait de temps à autre chercher aux Belges de mauvaises querelles."
                            },
                            {
                                "example_id": "c9313246-db87-4bd0-a5d8-a9ad902e79a9",
                                "sense_id": "fce5d950-092c-3262-9332-302d7030ce4c",
                                "text": "Comme Ricasoli en Toscane Farini poursuit activement la campagne annexionniste."
                            },
                            {
                                "example_id": "a9dba43b-3a1e-48a5-8391-319ee659a6b0",
                                "sense_id": "fce5d950-092c-3262-9332-302d7030ce4c",
                                "text": "L’Ukraine se voit sacrifiée sur l’autel des ambitions annexionnistes d’un autocrate russe pour qui l’existence même d’une nation ukrainienne n’est qu’une fiction."
                            }
                        ]
                    }
