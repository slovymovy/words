                                                "example_id": "ced4b937-60a6-436c-8903-dbea1b3fba47",
                                                "sense_id": "92687dd0-6357-3066-aa90-d99eeefe4770",
                                                "text": "Der Eimer aus dem Nachbarhaus hat schon wieder auf dem Balkon gegrillt."
                                            },
                                            {
                                                "example_id": "7a57ff16-3f3e-4ac7-a08c-394075333583",
                                                "sense_id": "92687dd0-6357-3066-aa90-d99eeefe4770",
                                                "text": "Die neuen Mieter, diese Eimers, sind nicht sehr hilfsbereit."
                                            },
                                            {
                                                "example_id": "5b652868-6f0a-4351-a7d4-93c10278f796",
                                                "sense_id": "92687dd0-6357-3066-aa90-d99eeefe4770",
                                                "text": "Die kleine Eimer ist vielleicht ein Frechdachs!"
                                            },
                                            {
                                                "example_id": "0a07837d-9de7-45f5-ae21-729111320f12",
                                                "sense_id": "92687dd0-6357-3066-aa90-d99eeefe4770",
