                        "entry_id": "6ffa09ef-70d4-312a-bfe4-9a3889948f64",
                        "glosses": [
                            "release (act of letting free)"
                        ],
                        "tags": [
                            "feminine",
                            "no-diminutive"
                        ],
                        "examples": [
                            {
                                "example_id": "52e4dcf6-8d21-46e4-93e5-0a77c8e359fd",
                                "sense_id": "f1bd0d5b-68e2-3fbd-92b7-a7a4591aff8a",
                                "text": "De vrijlating van de gevangenen vond plaats na hun straf.",
                                "translation": "The release of the prisoners took place after their sentence.",
                                "english": "The release of the prisoners took place after their sentence."
                            },
                            {
                                "example_id": "001170c2-831f-4b40-9439-9bf558eec947",
                                "sense_id": "f1bd0d5b-68e2-3fbd-92b7-a7a4591aff8a",
                                "text": "De rechtbank heeft de onmiddellijke vrijlating van de verdachte bevolen.",
                                "translation": "The court ordered the immediate release of the suspect.",
                                "english": "The court ordered the immediate release of the suspect."
                            },
                            {
                                "example_id": "5487a0c8-c4be-4411-bde4-42858fd5b858",
                                "sense_id": "f1bd0d5b-68e2-3fbd-92b7-a7a4591aff8a",
                                "text": "De vrijlating van de gijzelaars was een grote opluchting voor hun families.",
                                "translation": "The release of the hostages was a huge relief for their families.",
                                "english": "The release of the hostages was a huge relief for their families."
                            },
                            {
                                "example_id": "87a313dc-63d8-4c19-8cdb-c787dc470353",
                                "sense_id": "f1bd0d5b-68e2-3fbd-92b7-a7a4591aff8a",
                                "text": "De organisatie pleit voor de vrijlating van politieke gevangenen.",
                                "translation": "The organization advocates for the release of political prisoners.",
                                "english": "The organization advocates for the release of political prisoners."
                            },
                            {
                                "example_id": "f4d913d9-1e64-4149-b4d0-87e623e709c8",
                                "sense_id": "f1bd0d5b-68e2-3fbd-92b7-a7a4591aff8a",
                                "text": "Na langdurige onderhandelingen kwam er een overeenkomst voor de vrijlating van de gegijzelde journalisten.",
                                "translation": "After prolonged negotiations, an agreement was reached for the release of the kidnapped journalists.",
                                "english": "After prolonged negotiations, an agreement was reached for the release of the kidnapped journalists."
                            },
                            {
                                "example_id": "acb53c44-2c18-4ff5-ad80-22602e7ba888",
                                "sense_id": "f1bd0d5b-68e2-3fbd-92b7-a7a4591aff8a",
                                "text": "De vrijlating van de dieren in het wild was een belangrijke mijlpaal voor het behoud van de soort.",
                                "translation": "The release of the animals into the wild was a significant milestone for species conservation.",
                                "english": "The release of the animals into the wild was a significant milestone for species conservation."
                            }
                        ]
                    }
