                                        "entry_id": "25cd0c9d-c8d9-3169-bbfe-328c0541c67d",
                                        "glosses": [
                                            "Once every year without fail, yearly"
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9c79c412-c588-4f95-837b-9a879f5cdf1b",
                                                "sense_id": "dc0b203d-d107-386d-9702-ced997c9f532",
                                                "text": "The Sunshine Festival is held annually, at the end of May."
                                            },
                                            {
                                                "example_id": "5ac428f4-7967-484e-8442-3610d6d15941",
                                                "sense_id": "dc0b203d-d107-386d-9702-ced997c9f532",
                                                "text": "The cult of the holiday camp has brought seasonal expresses to fresh destinations such as Penychain, in North Wales; over 250,000 people go by train annually to Butlin's holiday camps alone."
                                            },
                                            {
                                                "example_id": "5ba58ca0-5fd1-4d8c-a6f9-4b556b509969",
                                                "sense_id": "dc0b203d-d107-386d-9702-ced997c9f532",
                                                "text": "Minimum age of Maiasaura individuals was determined by counting the number of annually deposited lines of arrested growth (see [10 –12 ] for descriptions of skeletochronology methods)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
