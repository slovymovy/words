{
    "word_family": [
        "constraint",
        "unconstrained"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "65433d06-de91-3a58-874c-e2a6fbde57ee",
                    "sense_definition": "To keep within close bounds, limit, or restrict the freedom or capacity of something or someone.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Strict rules <w>constrain</w> the choices that students can make for their subjects.",
                            "target_lang_translations": {
                                "tr": "Katı kurallar, öğrencilerin dersleri için yapabilecekleri seçimleri <w>kısıtlar</w>."
                            }
                        },
                        {
                            "text": "Budget restrictions will severely <w>constrain</w> choices for our upcoming project.",
                            "target_lang_translations": {
                                "tr": "Bütçe kısıtlamaları, yaklaşan projemiz için seçimleri ciddi şekilde <w>sınırlandıracak</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "restrict",
                        "limit",
                        "confine"
                    ],
                    "antonyms": [
                        "liberate",
                        "release"
                    ],
                    "common_phrases": [
                        "severely constrain choices",
                        "constrain the growth",
                        "constrain development"
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir şeyin veya bir kimsenin özgürlüğünü, kapasitesini kısıtlamak, dar sınırlar içinde tutmak."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "kısıtlamak",
                                "target_lang_sense_clarification": "özgürlüğü veya alanını sınırlandırmak"
                            },
                            {
                                "target_lang_word": "sınırlandırmak",
                                "target_lang_sense_clarification": "belli limitler içinde tutmak"
                            },
                            {
                                "target_lang_word": "engellemek",
                                "target_lang_sense_clarification": "hareket kabiliyetini kısıtlamak"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1d1a6db6-fb93-3dd6-ab3e-f0689de198d7",
                    "sense_definition": "To compel or force someone to act in a certain way through pressure or obligation.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The difficult situation seemed to <w>constrain</w> him to tell the truth.",
                            "target_lang_translations": {
                                "tr": "Zor durum onu doğruyu söylemeye <w>zorluyor</w> gibi görünüyordu."
                            }
                        },
                        {
                            "text": "Duty may <w>constrain</w> us to accept decisions we do not like.",
                            "target_lang_translations": {
                                "tr": "Görev bilinci, hoşumuza gitmeyen kararları kabul etmeye bizi <w>mecbur edebilir</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "compel",
                        "force",
                        "oblige"
                    ],
                    "common_phrases": [
                        "feel constrained to"
                    ],
                    "target_lang_definitions": {
                        "tr": "Baskı veya zorunluluk yoluyla birini belirli bir şekilde davranmaya zorlamak veya mecbur etmek."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "zorlamak",
                                "target_lang_sense_clarification": "birini bir şey yapmaya mecbur etmek"
                            },
                            {
                                "target_lang_word": "mecbur etmek",
                                "target_lang_sense_clarification": "yükümlülük altında bırakmak"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1644461d-97f9-399b-b4fa-b63a8fee5914",
                    "sense_definition": "To limit or reduce an output or result due to limited availability of resources.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Lack of raw materials will <w>constrain</w> output over the next quarter.",
                            "target_lang_translations": {
                                "tr": "Hammadde eksikliği, önümüzdeki çeyrekte üretimi <w>kısıtlayacak</w>."
                            }
                        },
                        {
                            "text": "A shortage of staff continues to <w>constrain</w> production at the factory.",
                            "target_lang_translations": {
                                "tr": "Personel yetersizliği, fabrikadaki üretimi <w>sınırlandırmaya</w> devam ediyor."
                            }
                        }
                    ],
                    "synonyms": [
                        "curtail",
                        "restrict"
                    ],
                    "antonyms": [
                        "expand",
                        "boost"
                    ],
                    "common_phrases": [
                        "constrain output",
                        "constrain production"
                    ],
                    "target_lang_definitions": {
                        "tr": "Kaynak yetersizliği nedeniyle bir üretimi veya sonucu sınırlamak ya da azaltmak."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "kısıtlamak",
                                "target_lang_sense_clarification": "üretimi veya çıkışı kısıtlamak"
                            },
                            {
                                "target_lang_word": "frenlemek",
                                "target_lang_sense_clarification": "büyümeyi veya üretimi yavaşlatmak/sınırlamak"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}