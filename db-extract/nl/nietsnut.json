                                    {
                                        "sense_id": "06d2b6f6-011c-3e93-b278-6b8befb3770e",
                                        "entry_id": "8ba68290-3550-393c-9162-6b5cdb61dc10",
                                        "glosses": [
                                            "A person of little worth or usefulness."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "487cae47-c31e-4f0f-b9ba-6d4046c46b29",
                                                "sense_id": "06d2b6f6-011c-3e93-b278-6b8befb3770e",
                                                "text": "Americans might have taken some comfort from the fact that these critics also expressed similar misgivings about Rhodes Scholars coming from elsewhere. Isis, a student publication, lampooned Australians as good-for-nothings who badly needed education."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "89caedf9-92d2-4c1b-a818-80bef4bf1c1d",
                        "source_entry_id": "8edf8553-fa94-3041-9385-e7975d050024",
                        "source_sense_id": "36a7e476-3d59-3b9d-be3d-73d721e61cd1",
                        "source_sense_description": "iemand die voor niets deugt",
                        "target_lang_word": "bon à rien",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bon à rien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6db86fb2-900b-3394-bdee-9c672ae2d72b",
                                        "entry_id": "b1d730d8-68e5-38fb-8e43-697f3e672672",
                                        "glosses": [
                                            "Qui est incapable de réussir quoi que ce soit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c751c05b-694f-4397-993a-28643f0eab25",
                                                "sense_id": "6db86fb2-900b-3394-bdee-9c672ae2d72b",
                                                "text": "Cette infécondité, qui, de mois en mois, lui fit verser des torrents de larmes, entretint longtemps le mépris de Brigitte, qui lui reprochait de n’être bonne à rien, pas même à faire des enfants."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bon à rien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c3d03084-a1e8-3e01-92db-a2344b7507a4",
                                        "entry_id": "5b16881d-d1ee-3926-92da-6d3f6ea339ba",
                                        "glosses": [
                                            "Personne incapable de réussir quoi que ce soit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7cb8adb-2a0c-44a7-943a-eaca4c567519",
                                                "sense_id": "c3d03084-a1e8-3e01-92db-a2344b7507a4",
                                                "text": "Il l’insulta : « Vous voyez que ce merdeux se fout de moi et vous restez piqué comme une andouille, bon à rien, manche à couilles. »"
                                            },
                                            {
                                                "example_id": "e29b94c7-fd2b-4048-8776-0c4767819dfb",
                                                "sense_id": "c3d03084-a1e8-3e01-92db-a2344b7507a4",
                                                "text": "On recommanda bien à cette femme, une fois de plus, de quitter son compagnon, qui en dehors de son alcoolisme et de sa brutalité, n'était de toutes façons qu'un bon à rien, incapable de garder un travail fixe bien longtemps."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
