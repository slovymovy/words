                                    {
                                        "sense_id": "33948c04-75ae-3acd-a98c-90e7cf2cb337",
                                        "entry_id": "26960ae4-6674-301c-873f-f80e45e7c86e",
                                        "glosses": [
                                            "Face, one of three parts into which each zodiac sign is divided; a decan."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca67aca4-b378-47e1-985d-38765ee14898",
                                                "sense_id": "33948c04-75ae-3acd-a98c-90e7cf2cb337",
                                                "text": "If any planet be in his decanate, or face, he has the least possible essential dignity"
                                            },
                                            {
                                                "example_id": "d718b53a-bfe5-445c-a0b7-673567ca5578",
                                                "sense_id": "33948c04-75ae-3acd-a98c-90e7cf2cb337",
                                                "text": "Each 30° sign is divided into three 10° sections called decanates (figure 11 and chart 5)."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "decanate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "43490f71-d03f-3dd4-ac83-f343312ff9e7",
                                        "entry_id": "20e649a4-66b8-3c3c-8750-a18ac4896abb",
                                        "glosses": [
                                            "A group of parishes over which a dean presides; a deanery."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48417fb1-49bc-4a11-abac-d14c9b200373",
                                                "sense_id": "43490f71-d03f-3dd4-ac83-f343312ff9e7",
                                                "text": "These parishes are divided into 80 decanates or chapters. In each decanate there are from ten to eighteen parishes. At the head of each decanate stands the dean,"
                                            }
                                        ]
                                    }
