                "senses": [
                    {
                        "sense_id": "b95a424c-abda-3059-a259-237f0a0e26d6",
                        "entry_id": "8c6dcac2-dfe8-3359-934f-b1e05f237b2d",
                        "glosses": [
                            "Art bzw. Ausrichtung der Religion"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "602293ee-c0ec-4a41-be31-fd05ec800961",
                                "sense_id": "b95a424c-abda-3059-a259-237f0a0e26d6",
                                "text": "Die Religionsfreiheit im Grundgesetz ist insbesondere bei grausamen oder menschenverachtenden Glaubensrichtungen problematisch bis paradox."
                            },
                            {
                                "example_id": "516fe52f-6797-47f6-993e-485263e25ce8",
                                "sense_id": "b95a424c-abda-3059-a259-237f0a0e26d6",
                                "text": "„Abubaker C. behauptet, es gebe ein Komplott anderer Pakistani gegen ihn – ehemaliger Freunde, mit denen er sich überworfen habe und die anderen Glaubensrichtungen abgehören, also beispielsweise Schiiten sind.“"
                            },
                            {
                                "example_id": "3e8aefc1-087b-4255-bea1-bab828bc752c",
                                "sense_id": "b95a424c-abda-3059-a259-237f0a0e26d6",
                                "text": "„Das Ziel war ein säkularer Staat, der die Bevölkerung aus Arabern, Berbern und Tuareg mit ihren unterschiedlichen sozialen Regeln und muslimischen Glaubensrichtungen vereinen sollte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
