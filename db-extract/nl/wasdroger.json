                                            {
                                                "example_id": "573ebba8-003c-4819-bf56-dbf58bacbbcb",
                                                "sense_id": "5d4cba43-1a48-3eea-9a85-c6a4f0d9cdb7",
                                                "text": "Der Wäschetrockner ist eine große Hilfe für die Hausfrau."
