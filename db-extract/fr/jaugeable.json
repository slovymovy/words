                        "glosses": [
                            "Que l’on peut jauger, estimer, évaluer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc99cd50-c0f1-43d1-9a47-b51aae5756a4",
                                "sense_id": "52b5196a-8900-3176-ad67-25e90b6f8199",
                                "text": "Mais la conviction que la créativité constitue une capacité substantielle (on « en » a plus ou moins) et comme telle jaugeable par des moyens appropriés demeure sans aucun doute dominante dans la pensée sociale."
                            },
                            {
                                "example_id": "5d53ef2d-9f86-49e9-bc4a-29f932ff7d41",
                                "sense_id": "52b5196a-8900-3176-ad67-25e90b6f8199",
                                "text": "Bien entendu, sans cesse affleure la tentation de manifester publiquement cette création, de la rendre visible, jugeable, jaugeable."
                            },
                            {
                                "example_id": "fdce21be-78ed-4508-83f6-dc93505b2c5f",
                                "sense_id": "52b5196a-8900-3176-ad67-25e90b6f8199",
                                "text": "Ce qu’ils vivent au quotidien – l’agressivité des clients, la pression des employeurs, la peur d’attraper le virus – n’est pas jaugeable, ni en temps de travail, ni financièrement."
                            }
                        ]
                    }
