                        "examples": [
                            {
                                "example_id": "a5602d3e-d035-4a91-903f-4a31435fa330",
                                "sense_id": "d3652411-4967-366d-88da-83f836aad199",
                                "text": "„Schon heute könnte die EU theoretisch zwei Drittel ihres Erdgasverbrauchs aus LNG decken.“"
                            },
                            {
                                "example_id": "814e3bb3-5a00-4eec-8266-43c0dd8caf8a",
                                "sense_id": "d3652411-4967-366d-88da-83f836aad199",
                                "text": "[Schlagzeile:] „LNG aus Kanada ist nicht grün“"
                            },
                            {
                                "example_id": "016b172a-b5aa-4b2c-9371-fc450b920a84",
                                "sense_id": "d3652411-4967-366d-88da-83f836aad199",
                                "text": "„Auf einer anderen Werbetafel sind die Golfküste und ein roter Vogel abgebildet. Darüber steht: “Erhaltet die Schönheit der Golfküste. Stoppt LNG”.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
