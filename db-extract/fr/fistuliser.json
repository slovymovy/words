                        "glosses": [
                            "Provoquer une fistule."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "18018213-a368-4143-8b9a-4325200493b6",
                                "sense_id": "81c4093c-e542-3e51-8aa6-7ad2a9900637",
                                "text": "La trépanation s'est révélée comme la plus pratique pour fistuliser l'œil d'un nouveau-né glaucomateux."
                            },
                            {
                                "example_id": "946ccddb-685d-4d79-ad94-42ca4cc471a9",
                                "sense_id": "81c4093c-e542-3e51-8aa6-7ad2a9900637",
                                "text": "Même sous traitement, les adénopathies peuvent augmenter de volume, provoquer des troubles de ventilation, se fistuliser."
                            },
                            {
                                "example_id": "b996ac34-c72b-427a-929c-7b04dadb8d41",
                                "sense_id": "81c4093c-e542-3e51-8aa6-7ad2a9900637",
                                "text": "Les prothèses de l’aorte abdominale peuvent se fistuliser dans un viscère digestif."
                            }
                        ]
                    }
