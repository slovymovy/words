                "word": "lux",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "dcc55002-9f37-3c02-b332-9478b18754a0",
                        "entry_id": "3dc0f4d9-e157-3f86-b2da-00f97c49f910",
                        "glosses": [
                            "Unité de mesure d’éclairement lumineux du Système international, définie comme lumen par mètre carré, dont le symbole est lx."
                        ],
                        "tags": [
                            "physical"
                        ],
                        "examples": [
                            {
                                "example_id": "b1a63909-b2fb-4556-8f65-634c7cb9928a",
                                "sense_id": "dcc55002-9f37-3c02-b332-9478b18754a0",
                                "text": "Les besoins en énergie lumineuse varient, au cours de la période de végétation de 5000 lux (germination) à 50 000 lux (pollinisation)."
                            },
                            {
                                "example_id": "21daffe9-58de-4e94-b17e-9e7116db8173",
                                "sense_id": "dcc55002-9f37-3c02-b332-9478b18754a0",
                                "text": "Le plein soleil donne jusqu’à 100 kilolux d’éclairement, la Lune environ 0,1 lux, et le ciel étoilé à peine 1 millilux."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6078b0d1-6beb-4422-b0af-d2e3e00ec7ec",
                        "source_entry_id": "3dc0f4d9-e157-3f86-b2da-00f97c49f910",
                        "source_sense_id": "dcc55002-9f37-3c02-b332-9478b18754a0",
                        "source_sense_description": "Unité de mesure d’éclairement lumineux",
                        "target_lang_word": "Lux",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lux",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f5c8bf1a-55b6-395b-8d51-bc90790523ab",
                                        "entry_id": "501f598c-41b3-375c-afc9-5c9735d8bd6d",
                                        "glosses": [
                                            "Einheit der Beleuchtungsstärke"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d004ab39-22bf-4b80-803c-971bfa62bba3",
                                                "sense_id": "f5c8bf1a-55b6-395b-8d51-bc90790523ab",
                                                "text": "Ein Lux entspricht einem Lumen per Quadratmeter."
                                            },
                                            {
                                                "example_id": "30b9db4a-ac23-4f4f-95e4-83d6a54eeb7d",
                                                "sense_id": "f5c8bf1a-55b6-395b-8d51-bc90790523ab",
                                                "text": "„Selbst bei Wolken beträgt die Beleuchtungsstärke unter freiem Himmel 10.000 Lux“, sagt Verena Bartenbach vom Lichtlabor Bartenbach."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Lux",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "34d59950-7f30-347b-8222-6fcce329f7cd",
                                        "entry_id": "55a02831-2b1a-30e9-a006-334574f37cc3",
