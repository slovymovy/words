                ],
                "senses": [
                    {
                        "sense_id": "c79cd6c4-4d77-3eb6-bc60-23a687243d0e",
                        "entry_id": "b13422aa-4e46-33af-b927-ff681edccad1",
                        "glosses": [
                            "Anwendung für Smartphones oder Smartwatches, die beim Laufen unterstützt – etwa durch die Anzeige von Tempo, Zeit, Distanz, Kalorienverbrauch oder das Aufzeichnen der Laufstrecke mittels GPS"
                        ],
                        "tags": [
                            "Laufsport"
                        ],
                        "examples": [
                            {
                                "example_id": "0d2ff7c2-bd3c-478d-b2fb-cbe6cfcd4f17",
                                "sense_id": "c79cd6c4-4d77-3eb6-bc60-23a687243d0e",
                                "text": "„Es gibt wirklich viele Laufanwendungen für die Apple Watch.“"
                            },
                            {
                                "example_id": "31eb55f6-dac3-4717-b345-99a6b0d4d8d6",
                                "sense_id": "c79cd6c4-4d77-3eb6-bc60-23a687243d0e",
                                "text": "„Eine weitere bekannte Anwendung, die adidas Running App von Runtastic, ist Ihre grundlegende Laufanwendung, die eine Verbindung zu Google Earth herstellt, um die Routenzuordnung zu vereinfachen, insbesondere wenn Sie sich in einer brandneuen Stadt befinden.“"
                            },
                            {
                                "example_id": "2aadc04f-46ac-4752-ae6a-5af8943e5112",
                                "sense_id": "c79cd6c4-4d77-3eb6-bc60-23a687243d0e",
                                "text": "„Was als Plattform begann, auf der man sich für den gemeinsamen Lauf verabreden konnte, ist zu einer der funktionsreichsten Laufanwendungen geworden.“"
                            },
                            {
                                "example_id": "d11247fd-d01e-4530-b0d9-1937f399859d",
                                "sense_id": "c79cd6c4-4d77-3eb6-bc60-23a687243d0e",
                                "text": "„Die großen Laufuhren-Hersteller haben dies erkannt, versuchen immer mehr Daten aus den Bewegungs- und Pulsdaten zu extrahieren und erlauben (zumindest bei ihren Flaggschiff-Modellen) die freie Zusammenstellung der dargestellten Trainingsdaten innerhalb der Laufanwendung.“"
                            },
                            {
                                "example_id": "59fabc96-944e-4b62-8745-8eb2d9641c8e",
                                "sense_id": "c79cd6c4-4d77-3eb6-bc60-23a687243d0e",
                                "text": "„Denn oftmals ist das GPS bei den Laufanwendungen etwas ungenau und versaut Ihnen im schlimmsten Fall Ihre neue Bestzeit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
