                    {
                        "sense_id": "72d7155c-4b7c-3f52-9fa8-7cba93c3f2ed",
                        "entry_id": "0da0c7d9-da4a-3528-90cd-9a47530b5c57",
                        "glosses": [
                            "A small room used as an entryway or reception area to a larger room."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "47f1ad9f-6371-4113-b100-33b4e66f6ffe",
                                "sense_id": "72d7155c-4b7c-3f52-9fa8-7cba93c3f2ed",
                                "text": "Who knows. Perhaps the Ark is still waiting in some antechamber for us to discover. Perhaps there's some vital bit of evidence which eludes us. Perhaps…"
                            },
                            {
                                "example_id": "383b27b0-2292-463d-8baa-010916229c89",
                                "sense_id": "72d7155c-4b7c-3f52-9fa8-7cba93c3f2ed",
                                "text": "\"This is merely the antechamber, the entrance hall,\" said Dumbledore after a moment or two."
                            }
                        ]
                    },
                    {
                        "sense_id": "284d5e16-6eb1-33ac-adab-3c51baad56ae",
                        "entry_id": "0da0c7d9-da4a-3528-90cd-9a47530b5c57",
