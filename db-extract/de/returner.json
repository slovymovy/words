                                            {
                                                "example_id": "bf3c070d-08f1-4daf-b495-5023f17f15be",
                                                "sense_id": "2632edf6-612a-3f00-bfd0-74e7e353cc5a",
                                                "text": "Returning to school is fairly simple, but remaining there proves to be a challenge for the returners."
                                            }
                                        ]
                                    },
                                    {
