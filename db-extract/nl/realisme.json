                    {
                        "sense_id": "f5808e5a-9259-36a4-af29-dc2f4374712a",
                        "entry_id": "d4a4e29a-bfe8-3801-8f64-064c542b149a",
                        "glosses": [
                            "stroming in de kunst waarbij de werkelijkheid zo goed mogelijk wordt uitgebeeld"
                        ],
                        "tags": [],
