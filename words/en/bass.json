                        "zh": [
                            {
                                "target_lang_word": "低音谱号",
                                "target_lang_sense_clarification": "音乐符号"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0ca55e15-c3da-3792-a526-5cea9cc2eb65",
