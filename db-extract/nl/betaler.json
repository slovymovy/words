                                "sense_id": "1fa1ef73-714b-36a7-af98-86e7b72fa8ea",
                                "text": "De betaler is verantwoordelijk voor eventuele extra kosten.",
                                "translation": "The payer is responsible for any additional costs.",
                                "english": "The payer is responsible for any additional costs."
                            },
                            {
                                "example_id": "4aec77f2-e2b7-452a-b3f5-d5b382bb6aa3",
                                "sense_id": "1fa1ef73-714b-36a7-af98-86e7b72fa8ea",
                                "text": "Zorg ervoor dat de naam van de betaler duidelijk is op het formulier.",
                                "translation": "Make sure the name of the payer is clear on the form.",
                                "english": "Make sure the name of the payer is clear on the form."
                            },
                            {
                                "example_id": "6abd44e0-9d42-49fb-9b2a-cd0bc78b94a8",
                                "sense_id": "1fa1ef73-714b-36a7-af98-86e7b72fa8ea",
                                "text": "Als betaler moet je je bewust zijn van de voorwaarden.",
                                "translation": "As a payer, you should be aware of the terms.",
                                "english": "As a payer, you should be aware of the terms."
                            }
                        ]
                    }
