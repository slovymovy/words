    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "074369f5-c66a-3378-ac04-257b32a3fd4d",
                    "sense_definition": "Brief or terse, especially to the point of being rude.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "manner_of_speech",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She gave a <w>curt</w> nod and walked away without saying another word.",
                            "target_lang_translations": {
                                "ru": "Она <w>отрывисто</w> кивнула и ушла, не сказав больше ни слова."
                            }
                        },
                        {
                            "text": "His <w>curt</w> reply made it clear that he did not want to discuss the matter further.",
                            "target_lang_translations": {
                                "ru": "Его <w>резкий</w> ответ ясно дал понять, что он не хочет больше обсуждать этот вопрос."
                            }
                        }
                    ],
                    "synonyms": [
                        "brusque",
                        "short"
                    ],
                    "common_phrases": [
                        "curt reply",
                        "curt nod",
                        "curt response"
                    ],
                    "target_lang_definitions": {
                        "ru": "Краткий или резкий, особенно до такой степени, что это кажется грубым."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отрывистый",
                                "target_lang_sense_clarification": "о речи, жестах"
                            },
                            {
                                "target_lang_word": "резкий",
                                "target_lang_sense_clarification": "о тоне, ответе"
                            },
                            {
                                "target_lang_word": "сухой",
                                "target_lang_sense_clarification": "о манере общения"
                            },
                            {
                                "target_lang_word": "односложный",
                                "target_lang_sense_clarification": "о кратком ответе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a59f5716-2ccc-3851-8558-dcd489c183ac",
                    "sense_definition": "Short or concise.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "manner_of_speech",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The editor asked for a <w>curt</w> summary of the main events.",
