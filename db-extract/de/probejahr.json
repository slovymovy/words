                ],
                "senses": [
                    {
                        "sense_id": "a0a187f7-e18e-3f18-ba97-e872c30c4295",
                        "entry_id": "184f1887-fda3-3fe1-b3f6-99f510bfbb30",
                        "glosses": [
                            "Zeitraum, der ein Jahr umfasst und in dem eine Person seine Eignung für etwas zeigen soll"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a7006da9-6bb3-4158-9831-2c3de5a85b71",
                                "sense_id": "a0a187f7-e18e-3f18-ba97-e872c30c4295",
                                "text": "„Es wurde ihm nur gesagt, daß er entlassen werde, wenn er sich im Probejahr etwas zuschulden kommen lasse.“"
                            },
                            {
                                "example_id": "557bc5c4-e443-4bf3-ba2d-eaa2c8b5eff5",
                                "sense_id": "a0a187f7-e18e-3f18-ba97-e872c30c4295",
                                "text": "„Vom 17. Februar 1986 bis zum 16. Februar 1987 absolvierte der Beschwerdeführer sein ‚Probejahr‘ (Einführung in das praktische Lehramt).“"
                            },
                            {
                                "example_id": "2624680f-e6e6-4ac0-a411-ad16f2c05102",
                                "sense_id": "a0a187f7-e18e-3f18-ba97-e872c30c4295",
                                "text": "„Bei einer derartigen Sachlage könne daher nicht behauptet werden, daß der Erfolg ihrer Verwendung als Bundeslehrer ohne die Praxiszeit nur in einem beträchlich geringerem Ausmaß gegeben gewesen wäre, denn jeder Lehrer müsse nach Ablegung der Lehramtsprüfung bzw. des Hochschulstudiums und absolviertem Probejahr voll im Unterricht einsetzbar sein.“"
                            },
                            {
                                "example_id": "6730698b-5561-413f-9fe4-dfe142965cc7",
                                "sense_id": "a0a187f7-e18e-3f18-ba97-e872c30c4295",
                                "text": "„Laut dem Erlass des Bildungsressorts sollen Junglehrer, die mindestens ihren Bachelorabschluss gemacht und ihre Induktionsphase (Berufseinführung durch erfahrene Kollegen am Standort) erfolgreich abgeschlossen haben, nach einem Probejahr einen unbefristeten Vertrag bekommen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
