            {
                "entry_id": "be6f243e-bf62-310c-9762-144773a05c01",
                "word": "psychoanalysis",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "ecf3fb6d-8994-4931-ba34-a4f5abff4098",
                        "entry_id": "be6f243e-bf62-310c-9762-144773a05c01",
                        "tags": [
                            "plural"
                        ],
                        "form": "psychoanalyses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "97295354-b721-398d-b3de-1f4136bf7398",
                        "entry_id": "be6f243e-bf62-310c-9762-144773a05c01",
                        "glosses": [
                            "A family of theories and methods within the field of psychotherapy that work to find connections among patients' unconscious mental processes."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "e5717477-a0f8-4c53-95e3-bb26d89839dd",
                                "sense_id": "97295354-b721-398d-b3de-1f4136bf7398",
                                "text": "To be sure, this much I may presume you do know, namely, that psychoanalysis is a method of treating nervous patients medically."
                            },
                            {
                                "example_id": "5f75ce4e-dbbe-4787-a299-62b4e5c37c22",
                                "sense_id": "97295354-b721-398d-b3de-1f4136bf7398",
                                "text": "Psychoanalysis has sprung many surprises on us, performed more than one volte face before our indignant eyes."
                            },
                            {
                                "example_id": "d5b97b87-bac4-4b6c-b5ff-35b81ffe33ac",
                                "sense_id": "97295354-b721-398d-b3de-1f4136bf7398",
                                "text": "Psychoanalysis, the modern science of reading dreams, has taught us to take heed of these unsubstantial images. Also it has found a way to let them do their work."
                            },
                            {
                                "example_id": "825337e4-f74d-4b0d-ba7c-c82da6fc9665",
                                "sense_id": "97295354-b721-398d-b3de-1f4136bf7398",
                                "text": "Because psychophobia is so endemic to human nature, the process of psychoanalysis involves a continual exploration of the patient’s resistance to knowing what is dreaded in the unconscious mind."
                            }
                        ]
                    }
                ],
