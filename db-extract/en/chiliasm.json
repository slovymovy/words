                        "source_entry_id": "10e3b5a2-f8f6-3b3d-bcdd-fa9afeceada7",
                        "source_sense_id": "219402b5-18a1-3a1b-8ce5-f5f3e79f81a0",
                        "source_sense_description": "belief in an earthly thousand-year period of peace and prosperity",
