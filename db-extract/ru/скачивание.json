                        "glosses": [
                            "комп. процесс получения файлов, данных клиентом от сервера"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "573282bc-1105-452b-8864-ac298f406f2d",
                                "sense_id": "0fc450da-2bae-3921-b6eb-d3caee157a43",
                                "text": "Скачивание данных."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4bd7bffb-26bb-4e5c-8df8-4635f36c32cf",
                        "source_entry_id": "e45327ef-66f6-3a8e-aa9e-00b08700cab1",
                        "source_sense_id": "0fc450da-2bae-3921-b6eb-d3caee157a43",
                        "target_lang_word": "download",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "download",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e38c324d-0ad1-3f0b-800b-2c1c82bd8434",
                                        "entry_id": "ffce82e8-5e53-3518-8ccf-83a9e4bd11e6",
                                        "glosses": [
                                            "A file transfer to a given computer or device from a remote one through a network connection."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e48cba0-5b2e-4d58-a0d0-6e3e4ec1f31e",
                                                "sense_id": "e38c324d-0ad1-3f0b-800b-2c1c82bd8434",
                                                "text": "The download took longer than I expected."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bfd4ade3-b0ae-3e34-9d45-e5c8888c74bd",
                                        "entry_id": "ffce82e8-5e53-3518-8ccf-83a9e4bd11e6",
                                        "glosses": [
                                            "A file that has been or is intended to be transferred in this way."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e8d95b6-5e87-4462-a927-e0331e031d6c",
                                                "sense_id": "bfd4ade3-b0ae-3e34-9d45-e5c8888c74bd",
                                                "text": "I got the download but it wouldn't work on my computer."
                                            },
                                            {
                                                "example_id": "d69e1e4e-6215-4d49-8134-4990c12c6667",
                                                "sense_id": "bfd4ade3-b0ae-3e34-9d45-e5c8888c74bd",
                                                "text": "The blue sites will be blocked on all school computers, and no email or instant messaging will be set up or permitted. These student computers would strictly be for school use. Teachers will be able to request downloads from students' jumpdrives."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "download",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "babafcd6-6160-3d7b-883b-793575bf807c",
                                        "entry_id": "2cf1494c-b57b-3c82-b042-9a17eebe2e3e",
                                        "glosses": [
                                            "To transfer data to a given computer from a remote one via a network."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b23bd024-64db-400a-8ec9-1b3a70dab119",
                                                "sense_id": "babafcd6-6160-3d7b-883b-793575bf807c",
                                                "text": "You can download a trial version of the program for thirty days to determine whether you want to purchase the full version."
                                            },
                                            {
                                                "example_id": "ee557536-ba83-4184-a964-a5809cc2579f",
                                                "sense_id": "babafcd6-6160-3d7b-883b-793575bf807c",
                                                "text": "You can download Google's deskbar for free […]"
                                            },
                                            {
                                                "example_id": "39748ef6-65b7-41a2-8a61-a999a2cceac1",
                                                "sense_id": "babafcd6-6160-3d7b-883b-793575bf807c",
                                                "text": "Voiceover: You wouldn't steal a handbag. You wouldn't steal a car. You wouldn't steal a baby. You wouldn't shoot a policeman and then steal his helmet. You wouldn't go to the toilet in his helmet and then send it to the policeman's grieving widow and then steal it again. Downloading films is stealing. If you do it you WILL face the consequences.\nRoy: Man, these anti-piracy ads are getting really mean."
                                            },
                                            {
                                                "example_id": "6b85bbff-10ad-4219-bb6d-13d3e434940c",
                                                "sense_id": "babafcd6-6160-3d7b-883b-793575bf807c",
                                                "text": "Finally, some e-content must first be downloaded to a computer before being transferred to a tablet or other mobile device for viewing."
                                            },
                                            {
                                                "example_id": "8ca61b7d-cd47-4306-b3c5-bfc6d19ac4aa",
                                                "sense_id": "babafcd6-6160-3d7b-883b-793575bf807c",
                                                "text": "With Apple’s solar farm, customers could now be confident that downloading an app or video-chatting a friend would not increase carbon pollution, Jackson said."
                                            },
                                            {
                                                "example_id": "8db35d7d-02fa-4076-8fcd-5556cc7ffb0e",
                                                "sense_id": "babafcd6-6160-3d7b-883b-793575bf807c",
                                                "text": "That original list of 2,315 solutions was embedded in the game’s code. That means the game was playable offline and could be downloaded onto phones or computers. The solutions to the original Wordle game were predetermined through October 20, 2027. The New York Times (NYT) hasn’t said if it plans to make any more changes or additions to that initial list."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3850af38-d049-3f5f-9279-f8130ccff2c7",
                                        "entry_id": "2cf1494c-b57b-3c82-b042-9a17eebe2e3e",
                                        "glosses": [
                                            "Synonym of upload: to send data from a given computer to a remote one."
                                        ],
                                        "tags": [
                                            "nonstandard",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a7825051-c7db-3389-8947-730e0676bd2d",
                                        "entry_id": "2cf1494c-b57b-3c82-b042-9a17eebe2e3e",
                                        "glosses": [
                                            "Synonym of copy: to transfer data to or from removable media."
                                        ],
                                        "tags": [
                                            "nonstandard",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2ef5d971-dd44-4695-a2a5-97d59879c083",
                                                "sense_id": "a7825051-c7db-3389-8947-730e0676bd2d",
                                                "text": "When I was your age, there were no flash drives. I needed to download photos to a CD-ROM."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b60b7ee0-66ad-3f9b-9c2e-aa4bb1ff1a8e",
                                        "entry_id": "2cf1494c-b57b-3c82-b042-9a17eebe2e3e",
                                        "glosses": [
                                            "Synonym of install: to load software forced."
                                        ],
                                        "tags": [
                                            "nonstandard",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0e737fac-5415-3108-926c-4aad980f9d9b",
                                        "entry_id": "2cf1494c-b57b-3c82-b042-9a17eebe2e3e",
                                        "glosses": [
                                            "To load a gun (especially a muzzle-loader) with less propellant than its designed load."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "090a00e6-6d6d-396b-9f46-2643f79fa030",
                                        "entry_id": "2cf1494c-b57b-3c82-b042-9a17eebe2e3e",
                                        "glosses": [
                                            "To transfer jurisdiction and responsibility of a government asset or service to a lower level of government."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2d100617-b8cf-47d4-983d-9e725ee0b446",
                                                "sense_id": "090a00e6-6d6d-396b-9f46-2643f79fa030",
                                                "text": "In 1997, The Harris government also downloaded a number of social services to municipal governments, including affordable housing."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3ecfc6d4-efaf-44c1-ba5b-79d58f54d796",
                        "source_entry_id": "e45327ef-66f6-3a8e-aa9e-00b08700cab1",
                        "source_sense_id": "0fc450da-2bae-3921-b6eb-d3caee157a43",
                        "target_lang_word": "téléchargement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "téléchargement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "61b351a9-75bc-35a0-8360-18838b288d22",
                                        "entry_id": "d40f67a7-fef6-3b13-aa15-466a669238bb",
                                        "glosses": [
                                            "Transfert de programmes ou de données d’un ordinateur vers un autre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d333319c-af5e-4148-acb9-1e3780116edd",
                                                "sense_id": "61b351a9-75bc-35a0-8360-18838b288d22",
                                                "text": "C'est désormais au Pakistan, ou en Iran, que la fréquentation des sites de téléchargement de films X est le plus assidue. Qui sait quelles bombes mentales s'allument dans les nuits solitaires de Kaboul ou de Karachi ?"
                                            }
                                        ]
