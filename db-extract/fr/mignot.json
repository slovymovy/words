            {
                "entry_id": "03d50b9e-1aed-3bed-a54c-182d15268342",
                "word": "Mignot",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "588239df-7aa2-31be-aa04-e60f05e3de66",
                        "entry_id": "03d50b9e-1aed-3bed-a54c-182d15268342",
                        "glosses": [
                            "Nom de famille."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a94ce075-bd4f-45ca-be1a-7f5e378f5e07",
                                "sense_id": "588239df-7aa2-31be-aa04-e60f05e3de66",
                                "text": "Ce fut ce qu’on appela « la vocation d’Arsène Mignot »."
                            },
                            {
                                "example_id": "90d2fe47-b9fb-42d1-b5c9-2718aca7c814",
                                "sense_id": "588239df-7aa2-31be-aa04-e60f05e3de66",
                                "text": "« Nous nous préparons à des pics de ventes multipliées par trois durant le prochain mois », abonde David Mignot, cofondateur de YesYes."
                            },
                            {
                                "example_id": "c551044f-da00-412c-9f8f-c0ccd0f4aae0",
                                "sense_id": "588239df-7aa2-31be-aa04-e60f05e3de66",
                                "text": "C’est au tour de l'hôpital André-Mignot de Versailles (Yvelines) d’être visé par une cyberattaque, qui perturbe son activité depuis samedi soir."
                            },
                            {
                                "example_id": "8680767e-be41-4f24-8d71-cc653f098530",
                                "sense_id": "588239df-7aa2-31be-aa04-e60f05e3de66",
                                "text": "Après le bronze obtenu au Mondial, Gaëlle Mignot et David Ortiz, les cosélectionneurs ont fait appel a des nouvelles têtes, comme Carla Arbez (photo) ou Maëlle Picut."
                            }
                        ]
                    }
                ],
