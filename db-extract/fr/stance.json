                ],
                "senses": [
                    {
                        "sense_id": "6cb54885-c7fb-399f-b500-3423b9d6e47a",
                        "entry_id": "29398831-cc86-33bd-8af4-fcfe11af03f0",
                        "glosses": [
                            "Nombre déterminé de vers offrant un sens complet, et assujetti, pour la mesure des vers et l’ordre des rimes, à une règle qui s’observe dans toute la pièce."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "187610d4-63f9-4a82-a6fa-03a1b11689d0",
                                "sense_id": "6cb54885-c7fb-399f-b500-3423b9d6e47a",
                                "text": "Quatre jeunes filles, […], conduisaient le chœur, élevant au ciel pour l’âme du défunt, une hymne dont nous n’avons pu retrouver que deux ou trois stances."
                            },
                            {
                                "example_id": "990856b3-5f02-420e-86fd-a9df5f60ea2b",
                                "sense_id": "6cb54885-c7fb-399f-b500-3423b9d6e47a",
                                "text": "C’est, dit-elle, de simples stances sur lesquelles j’ai osé plaquer des réminiscences d’airs allemands."
                            },
                            {
                                "example_id": "5645cc0e-78de-4df9-8b2c-f253dacb0eef",
                                "sense_id": "6cb54885-c7fb-399f-b500-3423b9d6e47a",
                                "text": "Au lieu d’admirer les fleurs, Samuel Cramer, à qui la phrase et la période étaient venues, commença à mettre en prose et à déclamer quelques mauvaises stances composées dans sa première manière."
                            },
                            {
                                "example_id": "0e5199b0-a1a4-41e1-bbb3-27500b410fe9",
                                "sense_id": "6cb54885-c7fb-399f-b500-3423b9d6e47a",
                                "text": "Stances irrégulières, vers dont les stances diffèrent entre elles par le nombre ou la mesure des vers ou par l’entrelacement des rimes."
                            }
                        ]
                    },
                    {
                        "sense_id": "a44e599d-8359-360b-89f3-cb77c22a8639",
                        "entry_id": "29398831-cc86-33bd-8af4-fcfe11af03f0",
                        "glosses": [
                            "Position des pieds au sol lors de la frappe."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
