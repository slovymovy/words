{
    "word_family": [
        "verslaan",
        "verslagen"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1b87225f-c40f-326b-8ca9-517a91193423",
                    "sense_definition": "Het heftige, verdrietige en ontredderde gevoel na een zwaar verlies of een schokkende gebeurtenis.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>verslagenheid</w> was groot na het plotselinge overlijden van de jonge sporter.",
                            "target_lang_translations": {
                                "en": "The <w>consternation</w> was immense after the sudden death of the young athlete."
                            }
                        },
                        {
                            "text": "Het slechte nieuws zorgde voor een diepe <w>verslagenheid</w> onder alle medewerkers.",
                            "target_lang_translations": {
                                "en": "The bad news caused deep <w>dismay</w> among all employees."
                            }
                        }
                    ],
                    "synonyms": [
                        "ontsteltenis",
                        "ontreddering",
                        "verbijstering"
                    ],
                    "common_phrases": [
                        "grote verslagenheid",
                        "diepe verslagenheid"
                    ],
                    "target_lang_definitions": {
                        "en": "An intense feeling of grief, shock, and dismay following a sudden loss or tragic event."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "consternation",
                                "target_lang_sense_clarification": "dismay or shock mixed with deep distress"
                            },
                            {
                                "target_lang_word": "dismay",
                                "target_lang_sense_clarification": "deep shock and sadness"
                            },
                            {
                                "target_lang_word": "grief",
                                "target_lang_sense_clarification": "profound sorrow and emotional shock after a tragedy"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "95371c67-09ed-3034-9ea0-fda316c78b79",
                    "sense_definition": "Gemoedstoestand van neerslachtigheid of ontmoediging na een nederlaag of tegenslag.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na de zware nederlaag heerste er een merkbare <w>verslagenheid</w> in de kleedkamer.",
                            "target_lang_translations": {
                                "en": "After the heavy defeat, there was a noticeable <w>dejection</w> in the dressing room."
                            }
                        },
                        {
                            "text": "Hij zakte na herhaaldelijk falen weg in een sombere toestand van <w>verslagenheid</w>.",
                            "target_lang_translations": {
                                "en": "After repeated failures, he sank into a somber state of <w>despondency</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "neerslachtigheid",
                        "moedeloosheid"
                    ],
                    "target_lang_definitions": {
                        "en": "A state of dejection, demoralization, or despondency after a defeat or failure."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "despondency",
                                "target_lang_sense_clarification": "low spirits and loss of hope after defeat"
                            },
                            {
                                "target_lang_word": "dejection",
                                "target_lang_sense_clarification": "sadness and dispiritedness"
                            },
                            {
                                "target_lang_word": "demoralization",
                                "target_lang_sense_clarification": "loss of morale and confidence"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}