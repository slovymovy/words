                        "form": "die Sonderschulen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9a54f40f-35b7-3e17-a1e3-05dd517cced8",
                        "entry_id": "e2a92473-b40a-3ba3-859b-f15c804d04fc",
                        "glosses": [
                            "Schule für Kinder und Jugendliche, die in ihren Fähigkeiten erheblich beeinträchtigt sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8279153d-314d-4443-ac9c-1d05c231b6c7",
                                "sense_id": "9a54f40f-35b7-3e17-a1e3-05dd517cced8",
                                "text": "Die Sonderschule darf nicht als Ablage für Kinder verwendet werden, die nicht Deutsch als Muttersprache haben."
                            },
                            {
                                "example_id": "b5095592-4da3-4ca8-9d9c-e317c2111c86",
                                "sense_id": "9a54f40f-35b7-3e17-a1e3-05dd517cced8",
                                "text": "„In der ersten Klasse malte das Flüchtlingskind Ibrahim Totenköpfe und blutverschmierte Menschen, die Blumenbilder seiner Mitschüler verstand er nicht. Zwei Psychologen erklärten den Jungen zu einem Fall für die Sonderschule. Dort blieb er bis zur fünften Klasse.“"
                            },
                            {
                                "example_id": "84a51236-1a74-4fdf-a502-0088678b6bc6",
                                "sense_id": "9a54f40f-35b7-3e17-a1e3-05dd517cced8",
                                "text": "„Bundesweit besuchen fünf Prozent eines Jahrgangs eine Sonderschule, also mehr als in Berlin.“"
                            },
                            {
                                "example_id": "144b58a9-ee4c-4419-b591-f01ea2ad7e71",
                                "sense_id": "9a54f40f-35b7-3e17-a1e3-05dd517cced8",
                                "text": "„Mein Klassenlehrer in der Grundschule wollte mich auf die Sonderschule abschieben.“"
                            },
                            {
                                "example_id": "2823bad7-6148-441a-a0b0-2f6b39888299",
                                "sense_id": "9a54f40f-35b7-3e17-a1e3-05dd517cced8",
                                "text": "„Ich wusste nicht, wie es mit mir weitergehen sollte, vielleicht würde man mich ja wahrhaftig in eine Sonderschule stecken, allerdings konnte ich mir nicht vorstellen, dass Vater einem solchen Vorhaben zustimmen würde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
