                        "emoties bedwingen",
                        "woede bedwingen",
                        "zichzelf bedwingen"
                    ],
                    "target_lang_definitions": {
                        "en": "to keep emotions, impulses, or behavior under control"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "control",
                                "target_lang_sense_clarification": "to exercise influence or restraint over emotions"
                            },
                            {
                                "target_lang_word": "restrain",
                                "target_lang_sense_clarification": "to keep in check or hold back an impulse"
                            },
                            {
                                "target_lang_word": "curb",
                                "target_lang_sense_clarification": "to limit or keep something under control"
                            },
                            {
                                "target_lang_word": "suppress",
                                "target_lang_sense_clarification": "to forcibly put an end to an emotion or reaction"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d200432b-d299-3d25-a2ae-7a7008d7edc0",
                    "sense_definition": "met succes een fysieke hindernis of tegenstander overwinnen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "overwinning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De ervaren klimmers wilden dit jaar de hoogste berg <w>bedwingen</w>.",
                            "target_lang_translations": {
                                "en": "The experienced climbers wanted to <w>conquer</w> the highest mountain this year."
                            }
                        },
                        {
                            "text": "De politie moest de menigte <w>bedwingen</w> om de orde in de stad te handhaven.",
                            "target_lang_translations": {
                                "en": "The police had to <w>subdue</w> the crowd to maintain order in the city."
                            }
                        }
                    ],
                    "synonyms": [
                        "overwinnen",
                        "onderwerpen",
                        "meesteren",
                        "temmen"
                    ],
                    "antonyms": [
                        "bezwijken",
                        "verliezen"
                    ],
                    "common_phrases": [
                        "een berg bedwingen",
                        "de vlammen bedwingen",
                        "een vijand bedwingen"
                    ],
                    "target_lang_definitions": {
