                                "target_senses": [
                                    {
                                        "sense_id": "f02fe52c-d898-3b76-a0d0-beeba2a7a6e9",
                                        "entry_id": "202574d3-8489-3723-aa75-a5d86a87be30",
                                        "glosses": [
                                            "Synonym of pomelo, in all its senses including (inexact) grapefruit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "78b25a6b-6e93-4f05-a2c0-4d0161efbbc8",
                                                "sense_id": "f02fe52c-d898-3b76-a0d0-beeba2a7a6e9",
                                                "text": "Elizabeth Millar had five acres under shaddocks, callaloo, peppers and calabash."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "224dfacf-f334-4fa3-ba4b-36e8296b728b",
                        "source_entry_id": "4b9afa3e-43b3-3e2d-8cbb-bc1ad8a8726a",
                        "source_sense_id": "397a34fb-e64a-36bc-b32f-f8cb237522bc",
                        "target_lang_word": "Pampelmuse",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pampelmuse",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2572a178-f80b-3889-b5d9-27beab7d8a6c",
                                        "entry_id": "09afbe69-7998-35fc-81bc-d7b1426f78a8",
                                        "glosses": [
                                            "größte Zitrusfrucht mit einer gelben bis gelbgrünen Schale, dessen Fruchtfleisch einen säuerlich-bitterlichen Geschmack aufweist (Citrus maxima)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1cfdb7f-9c87-4eff-9522-f8a3be789d02",
                                                "sense_id": "2572a178-f80b-3889-b5d9-27beab7d8a6c",
                                                "text": "Durch die Kreuzung von Mandarine und Pampelmuse entstand die Orange."
                                            },
                                            {
                                                "example_id": "1840b440-81ca-4dfe-8471-e57392925ebf",
                                                "sense_id": "2572a178-f80b-3889-b5d9-27beab7d8a6c",
                                                "text": "„Die Obstfrau zeigte auf die hochgestellten Kisten bunt mit Äpfeln Birnen Zitronen Apfelsinen Mandarinen Pampelmusen, ich sah ihn den Kopf schütteln.“"
                                            },
                                            {
                                                "example_id": "e2f6d24b-4e10-4c11-9828-2f0dbecebc57",
                                                "sense_id": "2572a178-f80b-3889-b5d9-27beab7d8a6c",
                                                "text": "bildlich: „Ungefähr eine Stunde nach der Geburt ist die Gebärmutter ungefähr noch so groß wie eine Pampelmuse und als runder Körper zwischen Nabel und Schambein zu fühlen.“"
                                            },
                                            {
                                                "example_id": "56bcac79-86f1-4c26-a2aa-e159381e5c38",
                                                "sense_id": "2572a178-f80b-3889-b5d9-27beab7d8a6c",
                                                "text": "„Nicht nur Zitronen und Orangen gehören zur Familie der Zitrusfrüchte. Es gibt insgesamt rund 60 Sorten. Ihre Vielfalt reicht von den großen Pampelmusen über Orangen, Zitronen und Limetten bis hin zu den kleinen Kumquats.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2cc1349b-9567-30a1-964b-f6e0eab1af40",
                                        "entry_id": "09afbe69-7998-35fc-81bc-d7b1426f78a8",
                                        "glosses": [
                                            "aus Orange und der unter [1] beschriebenen Frucht gekreuzte, größere Zitrusfrucht mit gelbem oder orangerotem Fruchtfleisch und säuerlich-bitterlichem Geschmack (Citrus paradisi)"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "837f4027-0d2a-486d-844b-5aec46799c76",
                                                "sense_id": "2cc1349b-9567-30a1-964b-f6e0eab1af40",
                                                "text": "„Was wollen Sie haben? Pampelmusen? Ach, so, sie meinen Grapefruits!“"
                                            },
                                            {
                                                "example_id": "6ce43164-bfd5-4d4d-b202-9c523b97d2a5",
                                                "sense_id": "2cc1349b-9567-30a1-964b-f6e0eab1af40",
                                                "text": "„Pampalimasu, die Prachtlimone, wandelte sich sprachlich zur Pampelmuse. Zugegeben, Grapefruits sind nicht jedermanns Sache.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
