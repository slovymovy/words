                        "entry_id": "3d5a3924-c070-310b-ae27-5f413a03b9b1",
                        "glosses": [
                            "Fackel, deren Brennstoff eine Schicht aus Pech ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "335b2686-6935-478a-af44-e924ace1aedd",
                                "sense_id": "497d83dc-e1ef-3ea6-927b-de8d78539c1b",
                                "text": "„Ich sah ihnen nach, wie sie durch das Spalier der Pechfackeln schritten und Richtung Wildgehege verschwanden.“"
                            },
                            {
                                "example_id": "50a75e0d-ba7d-4de1-8ffe-ca0b72416b27",
                                "sense_id": "497d83dc-e1ef-3ea6-927b-de8d78539c1b",
                                "text": "„Langsam wandte sie sich jedoch der Ecke zu, von der sie eine Aussicht auf den von mehreren hundert Pechfackeln erglänzenden Wasserspiegel des Flusses hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
