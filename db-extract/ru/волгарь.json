                "senses": [
                    {
                        "sense_id": "85ca62d2-3ad5-37c3-a521-a1f0fc0d557e",
                        "entry_id": "dec213aa-035f-3061-bc0b-14f10077451d",
                        "glosses": [
                            "житель или уроженец Поволжья"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ac831a5b-d1d6-4edd-a0ca-5a6f6ac51b36",
                                "sense_id": "85ca62d2-3ad5-37c3-a521-a1f0fc0d557e",
                                "text": "Матросы оказались добрыми ребятами, все они были земляки мне, исконные волгари; к вечеру я чувствовал себя своим человеком среди них."
                            }
                        ]
                    },
                    {
                        "sense_id": "cbaea28d-a214-3edb-b35e-ee5a16034108",
                        "entry_id": "dec213aa-035f-3061-bc0b-14f10077451d",
                        "glosses": [
                            "судовой рабочий в Поволжье"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "02ada1f1-0f83-49cb-ae76-abf2e2f7b6a1",
                                "sense_id": "cbaea28d-a214-3edb-b35e-ee5a16034108",
                                "text": "Бурлаки, надежа-государь! Бурлаки мы, волгари…"
                            }
                        ]
                    }
                ],
