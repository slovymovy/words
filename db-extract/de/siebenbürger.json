        "de-extract.jsonl": [
            {
                "entry_id": "63f54c37-e2b3-387c-85d5-1384d288f4fe",
                "word": "Siebenbürger",
                "pos": "adj",
                "lang_code": "de",
                "forms": [
                    {
                        "form_id": "acf7aaf3-8e4b-4e3f-b10f-2f888fa9157e",
                        "entry_id": "63f54c37-e2b3-387c-85d5-1384d288f4fe",
                        "tags": [
                            "positive"
                        ],
                        "form": "Siebenbürger"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1c99ab22-d3c9-3186-9178-7af02366a551",
                        "entry_id": "63f54c37-e2b3-387c-85d5-1384d288f4fe",
                        "glosses": [
                            "die Region Siebenbürgen oder ihre Bewohner betreffend, zu ihr gehörend, aus ihr stammend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5eccab9f-ab1f-43d2-b888-39b6916a8528",
                                "sense_id": "1c99ab22-d3c9-3186-9178-7af02366a551",
                                "text": "„Er stammt aus einem Siebenbürger Dorf, seine Eltern waren arme Bauern.“"
                            },
                            {
                                "example_id": "f7fda48b-3e1a-4556-b580-5f724905a7e4",
                                "sense_id": "1c99ab22-d3c9-3186-9178-7af02366a551",
                                "text": "„Sie sandte 1554 Abgeordnete an den Siebenbürger Bischof, er möge die Sachsen in dem Bekenntniß ihres Glaubens nicht stören, darunter den Schäßburger Bürgermeister Paulus Bolkesch, der in Wittenberg studirt hatte.“"
                            },
                            {
                                "example_id": "1aa53566-ec9e-4d75-977a-3f3243e3f862",
                                "sense_id": "1c99ab22-d3c9-3186-9178-7af02366a551",
                                "text": "„Er war Elektriker aus der Region Moldawien und hatte eine Zeitlang in den Eisenbahnwerkstätten der kleinen Siebenbürger Stadt Dej gearbeitet […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [],
                "word_linkages": [
