    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0332ed71-f83e-37c2-8821-e5be1ad12d14",
                    "sense_definition": "A creature or life form that comes from another planet or world.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "extraterrestrial_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the movie, the <w>aliens</w> came to Earth in peace.",
                            "target_lang_translations": {
                                "ru": "В фильме <w>пришельцы</w> прибыли на Землю с миром.",
                                "zh": "在电影里，<w>外星人</w>和平地来到了地球。"
                            }
                        },
                        {
                            "text": "Many people believe that <w>aliens</w> have visited our planet in the past.",
                            "target_lang_translations": {
                                "ru": "Многие верят, что <w>инопланетяне</w> посещали нашу планету в прошлом.",
                                "zh": "许多人相信<w>外星人</w>过去曾造访过我们的星球。"
                            }
                        }
                    ],
                    "synonyms": [
                        "extraterrestrial"
                    ],
                    "antonyms": [
                        "earthling",
                        "human"
                    ],
                    "common_phrases": [
                        "space alien",
                        "alien invasion",
                        "alien life"
                    ],
                    "target_lang_definitions": {
                        "ru": "Существо или форма жизни, прибывшая с другой планеты или из другого мира.",
                        "zh": "来自其他星球或世界的生物或生命形式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "инопланетя́нин",
                                "target_lang_sense_clarification": "житель другой планеты"
                            },
                            {
                                "target_lang_word": "прише́лец",
                                "target_lang_sense_clarification": "существо, прибывшее извне (часто в фантастике)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "外星人",
                                "target_lang_sense_clarification": "来自外星球的智慧生命"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8131e981-582b-304c-802f-53bf8c430d81",
                    "sense_definition": "A person who is not a citizen or national of the country where they are currently living.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "foreigner_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was registered as a resident <w>alien</w> and allowed to work in the country.",
                            "target_lang_translations": {
                                "ru": "Он был зарегистрирован как постоянно проживающий <w>иностранец</w>, и ему разрешили работать в стране.",
                                "zh": "他被登记为常驻<w>外籍人士</w>，并获准在该国工作。"
                            }
                        },
                        {
                            "text": "The government passed new laws regarding the status of illegal <w>aliens</w>.",
                            "target_lang_translations": {
                                "ru": "Правительство приняло новые законы касательно статуса нелегальных <w>иностранцев</w>.",
                                "zh": "政府通过了关于非法<w>外国人</w>身份的新法律。"
                            }
                        }
                    ],
                    "synonyms": [
                        "foreigner",
                        "noncitizen",
                        "immigrant"
                    ],
                    "antonyms": [
                        "citizen",
                        "national",
                        "native"
                    ],
                    "common_phrases": [
                        "illegal alien",
                        "resident alien",
                        "enemy alien"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "legal or formal context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, не являющийся гражданином или подданным страны, в которой он в данный момент проживает.",
                        "zh": "非居住国公民或国民的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "иностра́нец",
                                "target_lang_sense_clarification": "гражданин другой страны"
                            },
                            {
                                "target_lang_word": "неграждани́н",
                                "target_lang_sense_clarification": "лицо без гражданства данной страны"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "外国人",
                                "target_lang_sense_clarification": "非本国公民"
                            },
                            {
                                "target_lang_word": "外籍人士",
                                "target_lang_sense_clarification": "法律或正式语境下的非本国公民"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "39b75146-e039-3aed-9b9f-b44a05592ecb",
                    "sense_definition": "A plant or animal species introduced to a location where it is not native.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "biology_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This <w>alien</w> species is destroying the local ecosystem by outcompeting native plants.",
                            "target_lang_translations": {
                                "ru": "Этот <w>чужеродный вид</w> разрушает местную экосистему, вытесняя местные растения.",
                                "zh": "这种<w>外来物种</w>通过排挤本地植物正在破坏当地的生态系统。"
                            }
                        },
                        {
                            "text": "Park rangers are working to remove <w>aliens</w> from the protected forest.",
                            "target_lang_translations": {
                                "ru": "Смотрители парка работают над удалением <w>чужеродных видов</w> из заповедного леса.",
                                "zh": "公园管理员正在努力清除保护林中的<w>外来物种</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "exotic"
                    ],
                    "antonyms": [
                        "native"
                    ],
                    "common_phrases": [
                        "alien species",
                        "invasive alien"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "biology / ecology"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вид растений или животных, завезённый в местность, где он не является коренным.",
                        "zh": "被引入非原产地的植物或动物物种。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чужеро́дный вид",
                                "target_lang_sense_clarification": "биологический термин"
                            },
                            {
                                "target_lang_word": "интродуце́нт",
                                "target_lang_sense_clarification": "научный термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "外来物种",
                                "target_lang_sense_clarification": "生物学或生态学术语"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "7ea18e56-2d79-34b7-b21a-fb1bf539eab3",
                    "sense_definition": "Relating to or coming from another planet or world.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "extraterrestrial_adj",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Scientists are searching for signs of <w>alien</w> intelligence in the galaxy.",
                            "target_lang_translations": {
                                "ru": "Ученые ищут признаки <w>инопланетного</w> разума в галактике.",
                                "zh": "科学家们正在银河系中搜寻<w>外星</w>智慧的迹象。"
                            }
                        },
                        {
                            "text": "The astronaut described the landscape as stark and <w>alien</w>.",
                            "target_lang_translations": {
                                "ru": "Астронавт описал пейзаж как суровый и <w>чужой</w>.",
                                "zh": "宇航员形容那片景观荒凉且<w>陌生</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "extraterrestrial"
                    ],
                    "antonyms": [
                        "terrestrial",
                        "earthly"
                    ],
                    "common_phrases": [
                        "alien civilization",
                        "alien spacecraft",
                        "alien technology"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к другой планете или миру, либо происходящий из них.",
