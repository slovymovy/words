                                    },
                                    {
                                        "sense_id": "6d34494f-6de5-3c36-a7f9-4787ef961bea",
                                        "entry_id": "7785a9fa-720c-3b3a-84be-b8c958c21d62",
                                        "glosses": [
                                            "Kurzform von Lebehoch"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71eacf02-09c7-4ffd-94f1-b0f87f61bddb",
                                                "sense_id": "6d34494f-6de5-3c36-a7f9-4787ef961bea",
                                                "text": "Wir bringen auf ihn ein Hoch! aus."
                                            },
                                            {
                                                "example_id": "3faa7b5c-0140-440d-82c7-d80f4c071e27",
                                                "sense_id": "6d34494f-6de5-3c36-a7f9-4787ef961bea",
                                                "text": "„Im Vorüberziehen an dem Hotel schwenkten sie die Hüte, zahllose Hochs ausbringend, von denen niemand recht wußte, wem sie galten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0727db64-8ae6-45c0-a722-0bd48180e1cf",
                        "source_entry_id": "0932b4e0-6917-3f70-8591-89a8443abb10",
                        "source_sense_id": "a2efdf56-0c5a-34da-98b3-fc00ce1ad6da",
                        "target_lang_word": "Hochdruckgebiet",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hochdruckgebiet",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "252aafe1-d06c-32fc-a4eb-ab97ba1ce036",
                                        "entry_id": "8d30c56b-8619-38c9-b403-4ca45e73423b",
                                        "glosses": [
                                            "ein Gebiet, in dem ein höherer Luftdruck herrscht als in dessen großräumiger Umgebung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de842524-17f2-4562-9d3f-a67ec1a5f17b",
                                                "sense_id": "252aafe1-d06c-32fc-a4eb-ab97ba1ce036",
                                                "text": "„In geraden Jahren erhalten die Tiefdruckgebiete weibliche und die Hochdruckgebiete männliche Vornamen, in ungeraden Jahren ist dies umgekehrt.“"
                                            },
                                            {
                                                "example_id": "2cacaac3-5556-4757-bd17-f26a6cb01d63",
                                                "sense_id": "252aafe1-d06c-32fc-a4eb-ab97ba1ce036",
                                                "text": "„Alle Hoffnung richtet sich jetzt auf Pfingsten: Ein Hochdruckgebiet über Mitteleuropa soll Sonne und Wärme zurückbringen.“"
                                            },
                                            {
                                                "example_id": "f381add0-9577-4e2e-ba08-32221885e58f",
                                                "sense_id": "252aafe1-d06c-32fc-a4eb-ab97ba1ce036",
                                                "text": "„Das westliche Hochdruckgebiet hat seinen Einfluß bis nach Mitteldeutschland ausgedehnt und allgemein eine Besserung des Wetters herbeigeführt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
