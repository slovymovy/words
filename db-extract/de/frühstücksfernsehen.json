                    {
                        "sense_id": "6dc338e4-85fc-3add-bc8b-39eb01188182",
                        "entry_id": "428fcd49-8992-3e71-bc3f-5418b35707d0",
                        "glosses": [
                            "in den Morgenstunden ausgestrahlte Fernsehsendung, in der über verschiedene Themen berichtet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f6d40039-3b75-4152-bdfb-07b9e0ef1f7d",
                                "sense_id": "6dc338e4-85fc-3add-bc8b-39eb01188182",
                                "text": "„Rasieren, Haare fönen, den Tee kochen, ein Sandwich toasten, das Frühstücksfernsehen, die ersten Mails am Morgen… der Start in den Tag würde ohne Energieversorgung weitaus anders verlaufen.“"
                            },
                            {
                                "example_id": "84a89b7b-2f48-4646-82f0-fd0de6692f24",
                                "sense_id": "6dc338e4-85fc-3add-bc8b-39eb01188182",
                                "text": "„Amüsant sind auch die älteren Herrschaften, die im Frühstücksfernsehen ein Buch sehen, das jemand in die Kamera hält.“"
                            },
                            {
                                "example_id": "8eaec4e9-4e5d-40a4-99cb-434eed4acf6f",
                                "sense_id": "6dc338e4-85fc-3add-bc8b-39eb01188182",
                                "text": "„Einmal war ich mit meinen Witzen zum Frühstücksfernsehen bei SAT.1 eingeladen und lernte dort eine besonders gewitzte und gut aussehende Moderatorin, Simone Panteleit, kennen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
