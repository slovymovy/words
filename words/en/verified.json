                    "sense_id": "84b43b02-e47b-3458-9b92-7c411e92dc96",
                    "sense_definition": "Simple past and past participle of <w>verify</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bank <w>verified</w> my signature before processing the check.",
