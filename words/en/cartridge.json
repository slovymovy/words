                    "sense_definition": "A <w>surname</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The local directory listed a family with the last name <w>Cartridge</w> living on the outskirts of town.",
                            "target_lang_translations": {
                                "ru": "В местном справочнике значилась семья по фамилии <w>Картридж</w>, живущая на окраине города."
                            }
                        },
                        {
                            "text": "Professor <w>Cartridge</w> published several influential papers on mechanical engineering during the late twentieth century.",
                            "target_lang_translations": {
                                "ru": "Профессор <w>Картридж</w> опубликовал несколько влиятельных работ по машиностроению в конце двадцатого века."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "English family name"
                        }
                    ],
                    "target_lang_definitions": {
