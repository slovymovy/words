        "pl-extract.jsonl": [
            {
                "entry_id": "81f068ec-8a4b-3744-841d-a3a3ea1e563b",
                "word": "bezradność",
                "pos": "noun",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "ac5e3157-272c-3a39-a0ca-ae143fa6f1cf",
                        "entry_id": "81f068ec-8a4b-3744-841d-a3a3ea1e563b",
                        "glosses": [
                            "niemożność poradzenia sobie, zwłaszcza w trudnej sytuacji"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db9097fd-4416-4157-973c-abf5517fe1e7",
                                "sense_id": "ac5e3157-272c-3a39-a0ca-ae143fa6f1cf",
                                "text": "Wyuczona bezradność jest poddaniem się, zaprzestaniem działania, które wynika z przekonania, że cokolwiek się zrobi, nie będzie to miało żadnego znaczenia."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4d49adef-5c4c-401f-9e0a-ace426c13838",
                        "source_entry_id": "81f068ec-8a4b-3744-841d-a3a3ea1e563b",
                        "source_sense_id": "ac5e3157-272c-3a39-a0ca-ae143fa6f1cf",
                        "target_lang_word": "helplessness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "helplessness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5ef55f0b-a7a5-3669-b6ef-563e50775a9f",
                                        "entry_id": "cf72660b-e338-3819-90bc-2e85cc1b091a",
                                        "glosses": [
                                            "The state of being helpless."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c6f3d3f9-e8d5-45d0-8b0f-a1cd05802842",
                                                "sense_id": "5ef55f0b-a7a5-3669-b6ef-563e50775a9f",
                                                "text": "Near-synonyms: powerlessness, impotence"
                                            },
                                            {
                                                "example_id": "c120151a-2ffd-43f8-ae3f-ed01f010b1dd",
                                                "sense_id": "5ef55f0b-a7a5-3669-b6ef-563e50775a9f",
                                                "text": "From the most ancient times to the present, in the crudest primitive tribe or the most magnificently ornamented civilization, man has found himself in a state of awed helplessness when confronted by the phenomena of strange illnesses or aberrations."
                                            },
                                            {
                                                "example_id": "141a40b2-2c9c-4665-a90d-375c7a6c5ef4",
                                                "sense_id": "5ef55f0b-a7a5-3669-b6ef-563e50775a9f",
                                                "text": "ADAM: 'You are faced with overwhelming power. Accept your helplessness.'"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "69203bdc-1918-3286-9c24-ace6121f6b3b",
                                        "entry_id": "cf72660b-e338-3819-90bc-2e85cc1b091a",
                                        "glosses": [
                                            "A feeling of inadequacy or impotence."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "804a9ee2-f9e4-4b4f-b85f-57724c80e98c",
                                                "sense_id": "69203bdc-1918-3286-9c24-ace6121f6b3b",
                                                "text": "Captain Edward Carlisle, soldier as he was, martinet as he was, felt a curious sensation of helplessness seize upon him as he met her steady gaze, her alluring smile ; he could not tell what this prisoner might do."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9f20e5f5-7d75-4c34-9857-8c4f5a0acdd1",
                        "source_entry_id": "81f068ec-8a4b-3744-841d-a3a3ea1e563b",
                        "source_sense_id": "ac5e3157-272c-3a39-a0ca-ae143fa6f1cf",
                        "target_lang_word": "Hilflosigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hilflosigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3662122e-3269-3f38-a5e3-2ce17e9c3c46",
                                        "entry_id": "77738840-b399-3f0a-938c-0b52377ad400",
                                        "glosses": [
                                            "Zustand, dass man sich selbst nicht helfen kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15718ecb-0403-42d4-968e-10a0c49137b9",
                                                "sense_id": "3662122e-3269-3f38-a5e3-2ce17e9c3c46",
                                                "text": "„Am Vorbend hält der Herzog eine Ansprache an die Mädchen und Frauen, worin er ihnen ihre Hilflosigkeit vor Augen führt.“"
                                            },
                                            {
                                                "example_id": "fae52608-9465-446e-a362-1a6f91f1e503",
                                                "sense_id": "3662122e-3269-3f38-a5e3-2ce17e9c3c46",
                                                "text": "„Oft fehlte etwas auf den Bildern, was wiederum die Hilflosigkeit symbolisierte.“"
                                            },
                                            {
                                                "example_id": "6d5d1acb-d797-40a7-a3a3-12971fd31a93",
                                                "sense_id": "3662122e-3269-3f38-a5e3-2ce17e9c3c46",
                                                "text": "„Jana sah Maxim an und spürte nichts als Hilflosigkeit.“"
                                            },
                                            {
                                                "example_id": "fa6cdf18-2efd-4dd8-8316-10224fed7792",
                                                "sense_id": "3662122e-3269-3f38-a5e3-2ce17e9c3c46",
                                                "text": "„Immer sagten sie das, diese Bündel aus Anmut, Selbstsucht und Hilflosigkeit, wenn sie darangingen, einem das Herz zu zerreißen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5758dcaa-7653-31fb-8777-6e5b0603ea8b",
                                        "entry_id": "77738840-b399-3f0a-938c-0b52377ad400",
                                        "glosses": [
                                            "Gefühl, nicht zu wissen, was man tun kann/sollte"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "245569c6-9390-4963-940a-539f60ce5b65",
                                                "sense_id": "5758dcaa-7653-31fb-8777-6e5b0603ea8b",
                                                "text": "„Jana sah Maxim an und spürte nichts als Hilflosigkeit.“"
                                            },
                                            {
                                                "example_id": "2ae0dcb7-dfe7-45b1-b1d1-90495a784701",
                                                "sense_id": "5758dcaa-7653-31fb-8777-6e5b0603ea8b",
                                                "text": "„Immer sagten sie das, diese Bündel aus Anmut, Selbstsucht und Hilflosigkeit, wenn sie darangingen, einem das Herz zu zerreißen.“"
                                            },
                                            {
                                                "example_id": "2506d29b-8426-4b84-a176-643364d8bfe0",
                                                "sense_id": "5758dcaa-7653-31fb-8777-6e5b0603ea8b",
                                                "text": "„Elisabeth überkam ein Gefühl großer Hilflosigkeit.“"
                                            },
                                            {
                                                "example_id": "10421e31-c21f-4579-87a3-371895720133",
                                                "sense_id": "5758dcaa-7653-31fb-8777-6e5b0603ea8b",
                                                "text": "„Ihr Gesicht hat die Hilflosigkeit von jemandem, an den man nicht mehr glaubt.“"
                                            },
                                            {
                                                "example_id": "3ceba5cb-ed95-483a-b25f-68037d7b78fa",
                                                "sense_id": "5758dcaa-7653-31fb-8777-6e5b0603ea8b",
                                                "text": "„Mit diesem Gesicht konnte ich Karriere machen, konnte sogar an der Sache Heuchelei begehen, die mir in all ihrer Hilflosigkeit, in ihrer Dummheit, die relativ sympathischste war: die Sache, an die Edgar Wieneken glaubte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
