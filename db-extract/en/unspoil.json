                "senses": [
                    {
                        "sense_id": "318f3154-9c8c-3331-8c70-2c340f709f1e",
                        "entry_id": "27f2f8f5-52f9-35e0-ac18-b6ac331526e1",
                        "glosses": [
                            "To make less spoiled."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "e7118a8f-5093-4b6b-91fe-7bc015c51de0",
                                "sense_id": "318f3154-9c8c-3331-8c70-2c340f709f1e",
                                "text": "The week before, watching her work, Logerwell had called out to her, \"I can tell you right now, if you mollycoddle a horse he'll turn out spoilt, and I've had to unspoil plenty of horses that've been girl-broke. […]"
                            },
                            {
                                "example_id": "93ed7c16-c41e-47d4-9485-5178622809ae",
                                "sense_id": "318f3154-9c8c-3331-8c70-2c340f709f1e",
                                "text": "A few negative people can ruin an entire office environment, which shows you how powerful negativity is. It is so bad, even positive workers can't “unspoil” it."
                            },
                            {
                                "example_id": "16dc7558-214e-4068-bc0d-c7c8398e928a",
                                "sense_id": "318f3154-9c8c-3331-8c70-2c340f709f1e",
                                "text": "As John grew into a toddler he was quite spoilt, so I took the serious responsibility of unspoiling him."
                            }
                        ]
                    }
                ],
