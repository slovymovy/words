                        "entry_id": "8ce3d033-63bc-3e57-90bd-a10924c5be33",
                        "glosses": [
                            "A marketplace or other open space in or by a city or town; an esplanade."
                        ],
                        "tags": [
                            "South-Asia"
                        ],
                        "examples": [
                            {
                                "example_id": "d793de61-6416-4140-85f3-c63adb55d8c0",
                                "sense_id": "5454db52-89ce-3278-b159-a9ba538165f2",
                                "text": "Inland, the prospect alters. There is an oval maidan, and a long sallow hospital."
                            },
                            {
                                "example_id": "6db07a0c-eddb-4256-afb8-5039e828509f",
                                "sense_id": "5454db52-89ce-3278-b159-a9ba538165f2",
                                "text": "Below on the amorphous brown-violet meidan by the railway station […]."
                            },
                            {
                                "example_id": "0e3020c5-f76a-423a-a3a4-9c9514f565d8",
                                "sense_id": "5454db52-89ce-3278-b159-a9ba538165f2",
                                "text": "M. Crawford\na gallop on the green maidan"
                            }
                        ]
                    }
                ],
