                        "source_sense_id": "785b8b73-a92f-3d95-b641-3428ff9aeb26",
                        "source_sense_description": "Verlauf der Veränderungen der auf der Erde eintreffenden Sonnenstrahlung",
                        "target_lang_word": "Milankovitch cycle",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Milankovitch cycle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ea662fda-53dd-33fd-b2b5-d760d3adc5fb",
                                        "entry_id": "02bda59b-7cca-38d4-8dfe-85d08971cc11",
                                        "glosses": [
                                            "Any of the three cyclic variations in the Earth's orbit around the Sun, respectively the obliquity of its axis, the precession of the equinoxes, and the eccentricity of its orbit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb57e9c4-f80b-4cbb-b315-059224d58023",
                                                "sense_id": "ea662fda-53dd-33fd-b2b5-d760d3adc5fb",
                                                "text": "The Milankovitch cycles alone are not enough to explain cycles of ice ages."
                                            }
                                        ]
                                    }
                                ]
                            }
