                    },
                    {
                        "translation_id": "e6d62c4d-c3b4-4356-9f35-b25439edb271",
                        "source_entry_id": "b4d58cf0-ddaa-3272-8a0a-da3eb26418ac",
                        "source_sense_id": "cc99fa40-1a25-34cf-935e-341652770e54",
                        "target_lang_word": "bitterness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bitterness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "262637ea-a4ca-36c6-842f-50e595fbaaa0",
                                        "entry_id": "5bed7d5c-8321-3898-abe5-529bf9142503",
                                        "glosses": [
                                            "The quality of having a bitter taste."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f4348d8d-4f56-3c10-ae6a-1303665434e2",
                                        "entry_id": "5bed7d5c-8321-3898-abe5-529bf9142503",
                                        "glosses": [
                                            "The quality of feeling bitter; acrimony, resentment; the quality of exhibiting such feelings."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a76c4eb6-fae0-49ce-99b3-7304010645df",
                                                "sense_id": "f4348d8d-4f56-3c10-ae6a-1303665434e2",
                                                "text": "the bitterness of his words"
                                            },
                                            {
                                                "example_id": "5d5fda39-9513-4dc5-be90-559c55f29a9d",
                                                "sense_id": "f4348d8d-4f56-3c10-ae6a-1303665434e2",
                                                "text": "She kept her bitterness about her mistreatment for the rest of her life."
                                            },
                                            {
                                                "example_id": "1028238e-3d98-47f8-b89e-cf24952a33a2",
                                                "sense_id": "f4348d8d-4f56-3c10-ae6a-1303665434e2",
                                                "text": "She suspected that during the summer her father had mentioned Brian’s windfall to Billy and that father and son had then traded snidenesses and bitternesses about the W—— Corporation and bourgeois Robin and leisure-class Brian."
                                            },
                                            {
                                                "example_id": "98ab27dc-0393-4fbc-832c-7fdfa9a6de0f",
                                                "sense_id": "f4348d8d-4f56-3c10-ae6a-1303665434e2",
                                                "text": "Speaking of the guest list, though, it is most disappointing to find some of the third tier European princelings unable to hide their bitterness at being NFI."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0c220d33-943f-301f-b76b-2ab5603e53e0",
                                        "entry_id": "5bed7d5c-8321-3898-abe5-529bf9142503",
                                        "glosses": [
                                            "The quality of eliciting a bitter, humiliating or harsh feeling."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "589138e1-db42-480a-b868-a8ab0cbb4222",
                                                "sense_id": "0c220d33-943f-301f-b76b-2ab5603e53e0",
                                                "text": "Nothing could assuage the bitterness of their defeat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c273bb5-b057-3d8a-ad8d-c74ec7dfeef7",
                                        "entry_id": "5bed7d5c-8321-3898-abe5-529bf9142503",
                                        "glosses": [
                                            "Harsh cold."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "94851eed-625f-493b-bf77-384be2295c3e",
                                                "sense_id": "7c273bb5-b057-3d8a-ad8d-c74ec7dfeef7",
                                                "text": "The bitterness of the winter caught us all by surprise."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c52e49af-72d3-4308-93c9-c42c49c49626",
                        "source_entry_id": "b4d58cf0-ddaa-3272-8a0a-da3eb26418ac",
                        "source_sense_id": "cc99fa40-1a25-34cf-935e-341652770e54",
                        "target_lang_word": "chagrin",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chagrin",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a9df4c34-ed93-39ab-896e-f90beb859c70",
                                        "entry_id": "efb309ed-7dc1-3119-8bf5-3941ea83c4b2",
                                        "glosses": [
                                            "Distress of mind caused by a failure of aims or plans, want of appreciation, mistakes etc; vexation or mortification."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "09d5972e-96c7-4960-b78c-7bba5ad11527",
                                                "sense_id": "a9df4c34-ed93-39ab-896e-f90beb859c70",
                                                "text": "much to the chagrin (of)"
                                            },
                                            {
                                                "example_id": "5c1d63fe-2ec1-4268-996a-db48bc1a2e50",
                                                "sense_id": "a9df4c34-ed93-39ab-896e-f90beb859c70",
                                                "text": "[H]e alone knew how deep was the deluded man's chagrin at the failure of the little plot which he fancied was prospering finely."
                                            },
                                            {
                                                "example_id": "0d0123bf-274f-4aea-b490-16cce5d61392",
                                                "sense_id": "a9df4c34-ed93-39ab-896e-f90beb859c70",
                                                "text": "“Mrs. Yule's chagrin and horror at what she called her son's base ingratitude knew no bounds ; at first it was even thought that she would never get over it.[…]”"
                                            },
                                            {
                                                "example_id": "48a66281-4b30-40f5-b56e-903f37cd7ee4",
                                                "sense_id": "a9df4c34-ed93-39ab-896e-f90beb859c70",
                                                "text": "And even though their numbers have been halved—that’s the unofficial tally given in one of the strategy sessions—everyone from Sansa to Daenerys to Varys is wondering who is going to rule over which pile of smoking ruins. That’s when the campaigning begins, much to Jon and Dany’s chagrin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c95b2ea7-bb90-323c-9267-cb0b325c95ff",
                                        "entry_id": "efb309ed-7dc1-3119-8bf5-3941ea83c4b2",
                                        "glosses": [
                                            "A type of leather or skin with a rough surface."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "chagrin",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4f20b76a-a7f0-3fdb-9c92-cf8f5419dbca",
                                        "entry_id": "238912da-5345-3938-81e1-ab6822bc009b",
                                        "glosses": [
                                            "To bother or vex; to mortify."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4141732f-593e-4715-b3ef-382097720163",
                                                "sense_id": "4f20b76a-a7f0-3fdb-9c92-cf8f5419dbca",
                                                "text": "But since this Infidel Minister knows the folly of these Brags; which he sees destroy’d by the Relations Printed in other Countries: They serve only, for a Subject to augment his Pride; and gives him a Pleasure, the mor to Chagrine and Mortifie the French Ambassador."
                                            },
                                            {
                                                "example_id": "44cc22b5-60f6-432d-9611-0495244beb4c",
                                                "sense_id": "4f20b76a-a7f0-3fdb-9c92-cf8f5419dbca",
                                                "text": "[…] though you send at any Time, and even received an unmannerly Answer, do not let a rash Pride drive you to return the Affront, since it is impossible for you to know what at that Instant had chagrin’d their Temper."
                                            },
                                            {
                                                "example_id": "f9fd48ec-4264-4e50-a48c-4b795fb007cf",
                                                "sense_id": "4f20b76a-a7f0-3fdb-9c92-cf8f5419dbca",
                                                "text": "Meet once a year, then part, and then\nRetiring, wish to meet again."
                                            },
                                            {
                                                "example_id": "95e72952-635c-48d3-a953-c93fddd444a0",
                                                "sense_id": "4f20b76a-a7f0-3fdb-9c92-cf8f5419dbca",
                                                "text": "He felt pretty sure that, if this interview took place, his mother's account of what passed at it would only annoy and chagrin him, though he would all the time be aware of the colouring which it received by passing through her mind."
                                            },
                                            {
                                                "example_id": "31e88b67-3065-42e7-ac2b-0f6742cf5e43",
                                                "sense_id": "4f20b76a-a7f0-3fdb-9c92-cf8f5419dbca",
                                                "text": "She would go on like that for hours, connecting one offense to another until all of the things that chagrined her were spewed out."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f6cbe08b-5603-3770-8273-dd653cdb0cb6",
                                        "entry_id": "238912da-5345-3938-81e1-ab6822bc009b",
                                        "glosses": [
                                            "To be vexed or annoyed."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "rare",
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "caf05eda-3c0b-43b8-bc64-f9e68947fc92",
                                                "sense_id": "f6cbe08b-5603-3770-8273-dd653cdb0cb6",
                                                "text": "Dear Ma’am, why will you chagrine yourself about a vile Man, that is not worth,—no, as I live and breathe,—not worth a single Sigh?—"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "chagrin",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f82daba5-0d2f-328d-a442-ed4c8c83d085",
                                        "entry_id": "3d428b8d-cafa-3b2e-82f7-bf74f86754cb",
                                        "glosses": [
                                            "Feeling chagrin; annoyed; vexed, fretful."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3aab8be6-240a-4567-8487-909de684e890",
                                                "sense_id": "f82daba5-0d2f-328d-a442-ed4c8c83d085",
                                                "text": "Dear, my dear, pity me; I am so chagrin to day, and have had the most signal affront at Court!"
                                            },
                                            {
                                                "example_id": "f3114e13-adda-4f2d-a2e8-cc7691844860",
                                                "sense_id": "f82daba5-0d2f-328d-a442-ed4c8c83d085",
                                                "text": "[…] instead of rejoycing at this Prosperity of his Family, which a true Father of his Children would have esteem’d his own, a Spirit of Envy and Discontent seized him, and he went away chagrine and melancholy."
                                            },
                                            {
                                                "example_id": "2ace5d7c-66eb-460d-9f87-3c32e2099e59",
                                                "sense_id": "f82daba5-0d2f-328d-a442-ed4c8c83d085",
                                                "text": "1728, Henry Fielding, Love in Several Masques, Act V, Scene 3, in The Works of Henry Fielding, Esq, London: W. Strahan et al., 1784, Volume I, p. 174,\nI wou’d not have your ladyship chagrin at my bride’s expression […]"
                                            },
                                            {
                                                "example_id": "16180475-0bea-4264-934f-566a320f09a8",
                                                "sense_id": "f82daba5-0d2f-328d-a442-ed4c8c83d085",
                                                "text": "All pensive, heartless, and chagrine\nI sit, devoted prey to spleen;"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
