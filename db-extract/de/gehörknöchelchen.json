                        "glosses": [
                            "kleiner Knochen, der für die Übertragung von Schwingungen vom Trommelfell zum Innenohr dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b6b8af46-6768-462c-a928-30821e332a21",
                                "sense_id": "d82624f6-ab31-379d-b3af-38e3c2e13ff8",
                                "text": "Die Gehörknöchelchen sind die kleinsten Knochen im menschlichen Körper."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "88980223-33c2-49f4-84f0-ba8733b8da27",
                        "source_entry_id": "6288c143-0f84-34bc-acac-887a919d678c",
                        "source_sense_id": "d82624f6-ab31-379d-b3af-38e3c2e13ff8",
                        "source_sense_description": "kleiner Knochen, der für die Übertragung von Schwingungen vom Trommelfell zum Innenohr dient",
                        "target_lang_word": "ossicle",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ossicle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "41340648-9a0d-35c8-8880-c117799217da",
                                        "entry_id": "5aea6ffe-b94d-35c4-80a7-280743429447",
                                        "glosses": [
                                            "A small bone (or bony structure), especially one of the three of the middle ear."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf04d9c5-6003-49b3-8886-c779e84e6dd5",
                                                "sense_id": "41340648-9a0d-35c8-8880-c117799217da",
                                                "text": "The incus is one of the three auditory ossicles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0b8676dd-2aca-3f74-a1b6-3a5547bb6073",
                                        "entry_id": "5aea6ffe-b94d-35c4-80a7-280743429447",
                                        "glosses": [
                                            "Bone-like joint or plate, especially"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "662b5368-7045-45f2-93ab-98a343faab43",
                                                "sense_id": "0b8676dd-2aca-3f74-a1b6-3a5547bb6073",
                                                "text": "The skeleton of echinoderms is made of ossicles, linked to each other via muscles and connective tissue."
                                            },
                                            {
                                                "example_id": "fbde4280-5ae5-44f2-a6b6-f4beb421d566",
                                                "sense_id": "0b8676dd-2aca-3f74-a1b6-3a5547bb6073",
                                                "text": "The eyeballs were surrounded by a ring of bones, the sclerotic ossicle, which probably protected their eyes when diving abruptly for prey."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6befbd95-1e35-3013-892e-251fe4cb48bb",
                                        "entry_id": "5aea6ffe-b94d-35c4-80a7-280743429447",
                                        "glosses": [
                                            "Bone-like joint or plate, especially:",
                                            "one of numerous small calcareous structures forming the skeleton of certain echinoderms, as the starfishes;"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e566f126-1070-3a52-9bca-ca0a499bba78",
                                        "entry_id": "5aea6ffe-b94d-35c4-80a7-280743429447",
                                        "glosses": [
                                            "Bone-like joint or plate, especially:",
                                            "one of the hard articuli or joints of the stem or branches of a crinoid or encrinite;"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "53eb07ac-a043-3e10-8113-77265ad02a52",
                                        "entry_id": "5aea6ffe-b94d-35c4-80a7-280743429447",
                                        "glosses": [
                                            "Bone-like joint or plate, especially:",
                                            "one of the several small hard chitinous parts or processes of the gastric skeleton of crustaceans, as in the stomach of a lobster or crawfish."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6e494caf-5985-4572-9adf-933adb8809af",
                        "source_entry_id": "6288c143-0f84-34bc-acac-887a919d678c",
                        "source_sense_id": "d82624f6-ab31-379d-b3af-38e3c2e13ff8",
                        "source_sense_description": "kleiner Knochen, der für die Übertragung von Schwingungen vom Trommelfell zum Innenohr dient",
                        "target_lang_word": "osselet",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "osselet",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1ed848b3-3095-32fa-9cb9-78c0f3c0432a",
                                        "entry_id": "06a7be4c-2fc1-3b83-9050-571d5bbd28a8",
                                        "glosses": [
                                            "Petit os."
                                        ],
                                        "tags": [
                                            "Squelette"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f0334ee7-bd9b-4539-9bb2-85951a3cc5bb",
                                                "sense_id": "1ed848b3-3095-32fa-9cb9-78c0f3c0432a",
                                                "text": "Les osselets de l’oreille moyenne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "377383d2-6024-3ed8-afe0-734de091cd2f",
                                        "entry_id": "06a7be4c-2fc1-3b83-9050-571d5bbd28a8",
                                        "glosses": [
                                            "Petits os du jeu d’osselets, généralement des tarses de veau ou de mouton ou des copies en métal ou en plastique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a5e74de-4322-4f05-b253-08a8478dabb9",
                                                "sense_id": "377383d2-6024-3ed8-afe0-734de091cd2f",
                                                "text": "Les tabletiers font des osselets d’ivoire."
                                            },
                                            {
                                                "example_id": "558ddc11-7098-4c86-953e-8e06e6d7d34d",
                                                "sense_id": "377383d2-6024-3ed8-afe0-734de091cd2f",
                                                "text": "Habilement, Stavro jette un osselet en l’air et avant de le rattraper, saisit tous les autres."
                                            },
                                            {
                                                "example_id": "e41a8f1f-a8fb-4861-82aa-5988b32eb620",
                                                "sense_id": "377383d2-6024-3ed8-afe0-734de091cd2f",
                                                "text": "Le reste est jeu d’enfant, et je suis avec tous mes livres comme un petit garçon qui agite des osselets."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c9fee11a-cf4e-3b79-8ef4-de066777c4a8",
                                        "entry_id": "06a7be4c-2fc1-3b83-9050-571d5bbd28a8",
                                        "glosses": [
                                            "Tumeur osseuse placée sur la partie inférieure de la jambe d’un cheval, à côté du boulet."
                                        ],
                                        "tags": [
                                            "Médecine vétérinaire"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2eff5a1b-0015-4f4b-90a9-97b6996560f0",
                                                "sense_id": "c9fee11a-cf4e-3b79-8ef4-de066777c4a8",
                                                "text": "L’osselet est une exostose."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
