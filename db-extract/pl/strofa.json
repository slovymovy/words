                        "source_sense_id": "faa92761-1f38-3046-87fd-429bea1fe2c0",
                        "target_lang_word": "verse",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verse",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c2c61d37-3b7c-3ea2-be37-59171e0a18cd",
                                        "entry_id": "ffa7cf31-78e9-31fa-a11e-5e2a48797511",
                                        "glosses": [
                                            "A poetic form with regular meter and a fixed rhyme scheme."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2c9a756d-6c92-443d-914c-b7f8f60711b6",
                                                "sense_id": "c2c61d37-3b7c-3ea2-be37-59171e0a18cd",
                                                "text": "Restoration literature is well known for its carefully constructed verse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d498750c-377c-3a90-beb7-3ae789a0740a",
                                        "entry_id": "ffa7cf31-78e9-31fa-a11e-5e2a48797511",
                                        "glosses": [
                                            "Poetic form in general."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "42585d9d-8022-495d-9f5c-3a988e04761b",
                                                "sense_id": "d498750c-377c-3a90-beb7-3ae789a0740a",
                                                "text": "The restrictions of verse have steadily been relaxed over time."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "23205b63-b834-3b9a-9b31-dd9eb1d95755",
                                        "entry_id": "ffa7cf31-78e9-31fa-a11e-5e2a48797511",
                                        "glosses": [
                                            "One of several similar units of a song, consisting of several lines, generally rhymed."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9b486bd8-3b4f-4f9f-b485-da1ffed0c0cf",
                                                "sense_id": "23205b63-b834-3b9a-9b31-dd9eb1d95755",
                                                "text": "Note the shift in tone between the first verse and the second."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "32a51f21-50d5-3a3a-a065-fe7cacb2b91b",
                                        "entry_id": "ffa7cf31-78e9-31fa-a11e-5e2a48797511",
                                        "glosses": [
                                            "A small section of a holy book (Bible, Quran etc.)"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "601993f9-0356-3d17-a3e6-91236b389797",
                                        "entry_id": "ffa7cf31-78e9-31fa-a11e-5e2a48797511",
                                        "glosses": [
                                            "A portion of an anthem to be performed by a single voice to each part."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "verse",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "16258227-5ddf-3f6d-b8c1-806ea129706e",
                                        "entry_id": "ad863303-c1a6-3133-b1bd-02af176edefe",
                                        "glosses": [
                                            "To compose verses."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a17d2d80-2a7f-4786-8c97-b703a0c097a8",
                                                "sense_id": "16258227-5ddf-3f6d-b8c1-806ea129706e",
                                                "text": "It is not rhyming and versing that maketh a poet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ee04d0b7-d95f-3d35-a9f4-c3ddde6cdab9",
                                        "entry_id": "ad863303-c1a6-3133-b1bd-02af176edefe",
                                        "glosses": [
                                            "To tell in verse, or poetry."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dfa2324f-8896-431c-aaab-e2d58fb89a65",
                                                "sense_id": "ee04d0b7-d95f-3d35-a9f4-c3ddde6cdab9",
                                                "text": "playing on pipes of corn and versing love"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9abc2d68-1cc2-3359-92c0-364bd8a639db",
                                        "entry_id": "ad863303-c1a6-3133-b1bd-02af176edefe",
                                        "glosses": [
                                            "to educate about, to teach about."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "60e1915b-8e48-466c-b537-8c461cf105fd",
                                                "sense_id": "9abc2d68-1cc2-3359-92c0-364bd8a639db",
                                                "text": "He versed us in the finer points of category theory."
                                            },
                                            {
                                                "example_id": "271ed415-5948-43ff-a1df-386695acb760",
                                                "sense_id": "9abc2d68-1cc2-3359-92c0-364bd8a639db",
                                                "text": "Not unnaturally, “Auntie” took this communication in bad part.[…]Next day she[…]tried to recover her ward by the hair of the head. Then, thwarted, the wretched creature went to the police for help; she was versed in the law, and perhaps had spared no pains to keep on good terms with the local constabulary."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "verse",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7d72a2e7-60f2-37ec-bf85-83f9a6a59bf9",
                                        "entry_id": "d68cf988-22ae-3347-82a3-4b1a95afd528",
                                        "glosses": [
                                            "To oppose, to compete against."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "proscribed",
                                            "sometimes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3a421ec3-88e2-4c01-92c6-635cf7dab7e9",
                                                "sense_id": "7d72a2e7-60f2-37ec-bf85-83f9a6a59bf9",
                                                "text": "When teams play now they \"verse\" each other. \"Who did you verse?\" (Forget \"whom\". It's long dead.) \"We're versing you next.\" Pity the Latin scholar who might feel the loss of \"versus\" more keenly than many."
                                            },
                                            {
                                                "example_id": "1b61da23-4833-45a0-9c1d-ecd96ac28e2b",
                                                "sense_id": "7d72a2e7-60f2-37ec-bf85-83f9a6a59bf9",
                                                "text": "If you've got Onslaught let me know and I'll verse you."
                                            },
                                            {
                                                "example_id": "6fe185d0-864b-4422-83ae-ef86a4a59afa",
                                                "sense_id": "7d72a2e7-60f2-37ec-bf85-83f9a6a59bf9",
                                                "text": "Ariel is worried for the race, because she is versing her best competitor, and she really wants to win."
                                            },
                                            {
                                                "example_id": "6b90a75b-7935-41bb-bc04-3abd7166f6e8",
                                                "sense_id": "7d72a2e7-60f2-37ec-bf85-83f9a6a59bf9",
                                                "text": "There was an ODI last year where the Blackcaps versed Ireland, and we almost lost, but we didn't."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0d905092-1462-42c3-8272-691f648f3aea",
                        "source_entry_id": "7b0265db-ea18-39ed-8aa1-68a38606f7df",
