                        "target_lang_word": "Respektlosigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Respektlosigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d5900f2c-7a4d-3b3d-b7d3-6c988c552021",
                                        "entry_id": "ba7cd56c-60e6-3004-9b6c-84f5ecf01859",
                                        "glosses": [
                                            "Verhalten, das einen Mangel an Respekt vor dem Gegenüber zum Ausdruck bringt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9b43119-5f24-4aa7-a2cb-efb84aec16c2",
                                                "sense_id": "d5900f2c-7a4d-3b3d-b7d3-6c988c552021",
                                                "text": "Das Aufbehalten von Baseballmützen während des Unterrichts wird von vielen Lehrern als Respektlosigkeit betrachtet."
                                            },
                                            {
                                                "example_id": "81162ee6-2340-456b-9db2-dc9fea5de97b",
                                                "sense_id": "d5900f2c-7a4d-3b3d-b7d3-6c988c552021",
                                                "text": "„Respektlosigkeit und Aggressivität nehmen nicht einfach nur zu, ich behaupte sogar, das archaische Recht des Stärkeren wird immer mehr zur Realität auf unseren Straßen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "611e1dd6-33e8-3253-befe-c864dbf43991",
                                        "entry_id": "ba7cd56c-60e6-3004-9b6c-84f5ecf01859",
                                        "glosses": [
                                            "despektierliche, würdelose Handlung oder Äußerung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2377260-55ed-40d5-8cf0-db57bd6a4d32",
                                                "sense_id": "611e1dd6-33e8-3253-befe-c864dbf43991",
                                                "text": "„Damit ist nun der Weg frei für eine Abstimmung über das sogenannte Nationalhymnen-Gesetz, das Respektlosigkeiten gegenüber der chinesischen Nationalhymne unter Strafe stellen soll.“"
                                            },
                                            {
                                                "example_id": "f0fbb8db-720b-438e-b6c3-784eac6c782d",
                                                "sense_id": "611e1dd6-33e8-3253-befe-c864dbf43991",
                                                "text": "„‚Die zahlreichen Gewalttaten, Respektlosigkeiten und Übergriffe gegen Schiedsrichter auf den Amateurplätzen schockieren auch uns, wir sind bestürzt, fassungslos und betroffen‘, heißt es in einem von DFB-Präsident Fritz Keller, den Vizepräsidenten Rainer Koch und Ronny Zimmermann sowie Generalsekretär Friedrich Curtius unterzeichneten Brief.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
