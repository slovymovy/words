                "senses": [
                    {
                        "sense_id": "78aaca95-45e9-3b1d-8695-b704ca883d44",
                        "entry_id": "4e5f7fd6-7150-3261-8a64-5405dfaa5b4a",
                        "glosses": [
                            "rodzaj instrumentu muzycznego z grupy aerofonów"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb6e2cb2-6f65-4e8e-a053-e6830a92d3e7",
                                "sense_id": "78aaca95-45e9-3b1d-8695-b704ca883d44",
                                "text": "Pierwotnie na bandoneonie miano wykonywać repertuar kościelny."
                            },
                            {
                                "example_id": "e988f1d2-2193-4cbd-888f-927a501671b7",
                                "sense_id": "78aaca95-45e9-3b1d-8695-b704ca883d44",
                                "text": "Pierwsze bandoneony powstały w Niemczech."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2502ca51-7d87-42a7-81ac-3d8ca2cc0987",
                        "source_entry_id": "4e5f7fd6-7150-3261-8a64-5405dfaa5b4a",
                        "source_sense_id": "78aaca95-45e9-3b1d-8695-b704ca883d44",
                        "target_lang_word": "bandoneon",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bandoneon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5734e817-ab92-3a6b-a185-fd23979f1818",
                                        "entry_id": "f543cd2a-4d77-3400-807d-2d8a1734b04f",
                                        "glosses": [
                                            "A small Latin American accordion played with buttons which is frequently used in tango ensembles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4875c705-8cc9-4cd1-ab13-30b91855a6b8",
                                                "sense_id": "5734e817-ab92-3a6b-a185-fd23979f1818",
                                                "text": "a. 1989, Paul Honigsheim, “Governmental Control of Music in Hitler Germany”, in Paul Honigsheim (auth.), K. Peter Etzkorn (ed.), Sociologists and Music: An Introduction to the Study of Music and Society, Second Edition, Transaction Publishers (1989), →ISBN, page 203,\nAnother indication of these changes in musical practice was the emphasis given to instruments that had either been eliminated from symphonic orchestras or had never been so used, such as mandolins of all classes (including mandolas and mandacellos with had lower ranges) and the bandoneon in all of its ranges. These instruments had always been popular with the German people, and with Hitler’s rise to power were included in various public bands."
                                            },
                                            {
                                                "example_id": "1f80c26a-3e3d-4de3-bb72-74e5f9d3007e",
                                                "sense_id": "5734e817-ab92-3a6b-a185-fd23979f1818",
                                                "text": "Piazzolla studied piano in New York with Rachmaninoff and went to France to study with Nadia Boulanger, but his first and favorite instrument was the bandoneon, an accordion-like instrument invented in 1854 by Heinrich Band that has a series of buttons instead of piano keys."
                                            },
                                            {
                                                "example_id": "355dbbc4-f408-465d-aec2-106eed816f00",
                                                "sense_id": "5734e817-ab92-3a6b-a185-fd23979f1818",
                                                "text": "Created as an aggressive dance, expressing the dancers’ sexual instincts more than their feelings, and with the addition of the bandoneon as a predominant musical instrument, the tango acquired its characteristic, definitive rhythm and sound."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "35a76381-a3aa-43dc-9efe-5804b531b557",
                        "source_entry_id": "4e5f7fd6-7150-3261-8a64-5405dfaa5b4a",
                        "source_sense_id": "78aaca95-45e9-3b1d-8695-b704ca883d44",
                        "target_lang_word": "bandonéon",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bandonéon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "93aea3fa-469e-3a5e-9b88-049ce77c590c",
                                        "entry_id": "c489667c-2b7e-3f92-a402-3967ec33ba74",
                                        "glosses": [
                                            "Instrument de musique apparenté à l’accordéon et au concertina."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c42e745-a994-4301-a41a-098a4db495d7",
                                                "sense_id": "93aea3fa-469e-3a5e-9b88-049ce77c590c",
                                                "text": "Ce soir, les tombeaux et ses légendes, qui hantent la reine des routes là-bas, au IVᵉ siècle avant Jésus, entendent avec amertume la voix du bandonéon dans le mouvement de son soufflet paresseux."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bd30def8-6ff6-4ac4-93ba-eaeba4326843",
                        "source_entry_id": "4e5f7fd6-7150-3261-8a64-5405dfaa5b4a",
                        "source_sense_id": "78aaca95-45e9-3b1d-8695-b704ca883d44",
                        "target_lang_word": "bandoneón",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bandoneón",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "0a97051d-bacd-3278-a581-c514c87725ad",
                                        "entry_id": "d0e59870-87a2-39ae-a276-b567a87ef33b",
                                        "glosses": [
                                            "Instrumento musical de viento de la familia de las armónicas de forma rectangular o hexagonal, provisto de botones en ambos lados y escala cromática. Es una variante del acordeón y se usa en la música rioplatense como el tango y la milonga."
                                        ],
                                        "tags": [
                                            "Instrumentos musicales"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cc0e48d6-c55d-485c-8635-f3f689cbe7a3",
                        "source_entry_id": "4e5f7fd6-7150-3261-8a64-5405dfaa5b4a",
                        "source_sense_id": "78aaca95-45e9-3b1d-8695-b704ca883d44",
                        "target_lang_word": "Bandoneon",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bandoneon",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8f2bacc3-f9c8-3a37-a052-8a4e32c251a5",
                                        "entry_id": "9bdea2ab-2a5e-3755-bb4a-3736012d2dbf",
                                        "glosses": [
                                            "ein wechseltöniges Handzuginstrument mit viereckigem Gehäuse, das sowohl auf der Bass- als auch auf der Diskantseite Knöpfe besitzt"
                                        ],
                                        "tags": [
                                            "Musikinstrument"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06939c96-2bb2-4778-9e30-b0b55ab08dcd",
                                                "sense_id": "8f2bacc3-f9c8-3a37-a052-8a4e32c251a5",
                                                "text": "Zu einem argentinischem Tango gehört einfach ein Bandoneon."
                                            },
                                            {
                                                "example_id": "b18e3e9f-d0e9-4e45-92a1-4a527d1162c4",
                                                "sense_id": "8f2bacc3-f9c8-3a37-a052-8a4e32c251a5",
                                                "text": "In Argentinien ist das Bandoneon durch den \"Tango Argentino\" zu einem wahren Volksinstrument geworden."
                                            },
                                            {
                                                "example_id": "fa4809be-2306-45e9-8670-e9244fe8383f",
                                                "sense_id": "8f2bacc3-f9c8-3a37-a052-8a4e32c251a5",
                                                "text": "„Janoschs Schwiegervater, ein ehemaliger Seemann und Schiffsingenieur, der aus Danzig stammte, spielte mit 96 Jahren noch brasilianisches Bandoneon und genoss das Leben in der Sonne Teneriffas.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
