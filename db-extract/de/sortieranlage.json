                        "glosses": [
                            "Maschinentechnik, die etwas sortiert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e6574581-fc6f-4568-ab0d-243fa75b4483",
                                "sense_id": "2e690837-fae0-30e0-b1be-45ec879f59c1",
                                "text": "„Während Abfälle in der Vergangenheit überwiegend auf Deponien entsorgt oder in Verbrennungsanlagen beseitigt wurden, nutzen unsere Sortieranlagen die erheblichen Verwertungspotentiale von Gewerbeabfall.“"
                            },
                            {
                                "example_id": "4564539d-353d-40a1-8f8b-3f8b2839f191",
                                "sense_id": "2e690837-fae0-30e0-b1be-45ec879f59c1",
                                "text": "„Die speziell für die >>Frankiermaschine CentorMail entwickelte FP-Sortieranlage erspart Ihnen das zeitaufwendige manuelle Sortieren der frankierten Post.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
