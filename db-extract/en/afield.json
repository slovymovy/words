    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "f582dc2c-620a-3f51-bb5c-6c9cb32bbcc8",
                "word": "afield",
                "pos": "adv",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "a9e4dda1-a58a-40f5-b9cc-96706b815e5b",
                        "entry_id": "f582dc2c-620a-3f51-bb5c-6c9cb32bbcc8",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more afield"
                    },
                    {
                        "form_id": "1a35a7ce-222b-4343-a095-3d28cbc1d114",
                        "entry_id": "f582dc2c-620a-3f51-bb5c-6c9cb32bbcc8",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most afield"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "42200a0c-a0b0-304e-aba8-5ee95a7851bd",
                        "entry_id": "f582dc2c-620a-3f51-bb5c-6c9cb32bbcc8",
                        "glosses": [
                            "Away (from the home or starting point, physical or conceptual). (Often preceded by far, farther, or further.)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f9e4b7a7-d77c-4a21-9c2b-d7471a07b607",
                                "sense_id": "42200a0c-a0b0-304e-aba8-5ee95a7851bd",
                                "text": "My fellow passengers are a mixture of people returning from a day out in the capital, locals doing short hops, and a few (like me) heading farther afield."
                            },
                            {
                                "example_id": "71981f97-7887-4f72-8a35-6f7c01630138",
                                "sense_id": "42200a0c-a0b0-304e-aba8-5ee95a7851bd",
                                "text": "This latest excursion took us farther afield than ever."
                            },
                            {
                                "example_id": "833a05fa-8b47-4936-989f-bc003cb73ce2",
                                "sense_id": "42200a0c-a0b0-304e-aba8-5ee95a7851bd",
                                "text": "His latest remarks went far afield of any mainstream conception."
                            },
                            {
                                "example_id": "df8eaf9f-9bfb-431d-a6ee-958b74bcfa76",
                                "sense_id": "42200a0c-a0b0-304e-aba8-5ee95a7851bd",
                                "text": "Whether things could have been different is an open question, and one that would take us far afield from the focus of this book."
                            },
                            {
                                "example_id": "751a4a32-84da-4335-8d26-acc8e3de60ae",
                                "sense_id": "42200a0c-a0b0-304e-aba8-5ee95a7851bd",
                                "text": "There were Christians developing notable traditions somewhat away from the Mediterranean and outside the Roman empire, in places like Armenia, or even further afield, in India"
                            }
                        ]
                    },
                    {
                        "sense_id": "ef9ac73e-4665-35a7-9e46-75ac454b59f0",
                        "entry_id": "f582dc2c-620a-3f51-bb5c-6c9cb32bbcc8",
                        "glosses": [
                            "On the field."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e7b4c8b0-4c7d-40a9-8693-6a38220ed8ac",
                                "sense_id": "ef9ac73e-4665-35a7-9e46-75ac454b59f0",
                                "text": "We now have both teams afield and can begin the match."
                            }
                        ]
                    },
                    {
                        "sense_id": "95fda723-42a8-3761-ac1b-4bc493dafb2b",
                        "entry_id": "f582dc2c-620a-3f51-bb5c-6c9cb32bbcc8",
                        "glosses": [
                            "Out in the open."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9043030f-de86-4022-9d40-63dddb5e3018",
                                "sense_id": "95fda723-42a8-3761-ac1b-4bc493dafb2b",
                                "text": "The merchant was much interested in my journey, and thought it dangerous to sleep afield."
                            },
                            {
                                "example_id": "2996fdc7-0fe3-475c-939a-97b56b1c656e",
                                "sense_id": "95fda723-42a8-3761-ac1b-4bc493dafb2b",
                                "text": "Meanwhile, witch Tituba, Tonight you sleep afield, molest not this house. Return here early for your judgement."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d1e3afb5-ec50-4272-a1ef-01ffabbb5b38",
                        "source_entry_id": "f582dc2c-620a-3f51-bb5c-6c9cb32bbcc8",
                        "source_sense_description": "digressing from the topic",
                        "target_lang_word": "weg",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "weg",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f8f9a34f-e666-387d-85b2-de397bf2ee85",
                                        "entry_id": "5504a71f-abf7-3d38-9db5-ea2c95359c50",
                                        "glosses": [
                                            "von hier aus an einen anderen Ort"
                                        ],
                                        "tags": [
                                            "Bewegungsrichtung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3339657a-279d-4794-bfb9-141083994e4d",
                                                "sense_id": "f8f9a34f-e666-387d-85b2-de397bf2ee85",
                                                "text": "Ich muss weg!"
                                            },
                                            {
                                                "example_id": "714118a2-f29c-4d6c-bb50-a5b6c7177266",
                                                "sense_id": "f8f9a34f-e666-387d-85b2-de397bf2ee85",
                                                "text": "Das Buch kann doch jetzt weg, oder?"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ba678f5f-401c-3fda-8459-bd557f4fcfc4",
                                        "entry_id": "5504a71f-abf7-3d38-9db5-ea2c95359c50",
                                        "glosses": [
                                            "an einem anderen Ort"
                                        ],
                                        "tags": [
                                            "Standort"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b4ede723-5d71-4743-9188-c33b7d727d06",
                                                "sense_id": "ba678f5f-401c-3fda-8459-bd557f4fcfc4",
                                                "text": "So, der Besuch ist jetzt wieder weg."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "228ba441-c03c-3ed5-ba40-b3f9c0165fbf",
                                        "entry_id": "5504a71f-abf7-3d38-9db5-ea2c95359c50",
                                        "glosses": [
                                            "nicht mehr da, verschwunden, verloren"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "104f2410-af46-4c03-ad72-dd6cc9badcf1",
                                                "sense_id": "228ba441-c03c-3ed5-ba40-b3f9c0165fbf",
                                                "text": "Mein Geld ist weg!"
                                            },
                                            {
                                                "example_id": "4826a69d-dc3c-4f35-b2d6-661abecc3008",
                                                "sense_id": "228ba441-c03c-3ed5-ba40-b3f9c0165fbf",
                                                "text": "Wieso sind die Schlüssel schon wieder weg?"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "58e81715-7b72-3014-9b3d-6cddc58f7880",
                                        "entry_id": "5504a71f-abf7-3d38-9db5-ea2c95359c50",
                                        "glosses": [
                                            "in größerer Entfernung von hier"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55674d03-5714-4fa4-ae6a-85666e07a35f",
                                                "sense_id": "58e81715-7b72-3014-9b3d-6cddc58f7880",
                                                "text": "Hast du den Wagen weit weg geparkt?"
                                            },
                                            {
                                                "example_id": "1a03b47d-c9d2-4bce-8c46-a7dda7d6e7a6",
                                                "sense_id": "58e81715-7b72-3014-9b3d-6cddc58f7880",
                                                "text": "Wie weit weg von hier ist das denn genau?"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "1562bdcf-93b3-399b-821b-7b734c223de5",
                                        "entry_id": "5504a71f-abf7-3d38-9db5-ea2c95359c50",
                                        "glosses": [
                                            "geistig nicht ganz präsent"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "79a1c06d-730f-4892-9d33-a93d3bf15160",
                                                "sense_id": "1562bdcf-93b3-399b-821b-7b734c223de5",
                                                "text": "Einen Moment war ich ganz weg, was hast du gesagt?"
                                            },
                                            {
                                                "example_id": "accec721-4dac-4440-b6bc-9c5fbb970a13",
                                                "sense_id": "1562bdcf-93b3-399b-821b-7b734c223de5",
                                                "text": "Ich bin hin und weg von deinen Kunstkenntnissen!"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d8b59a89-3c7a-4c17-b340-4ad703d9f381",
                        "source_entry_id": "f582dc2c-620a-3f51-bb5c-6c9cb32bbcc8",
                        "source_sense_description": "digressing from the topic",
                        "target_lang_word": "hinaus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hinaus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "74ba2f4e-f474-3da2-a0bf-f11936e23791",
                                        "entry_id": "915852a4-e318-38f2-9f6c-6c81db149a7c",
                                        "glosses": [
                                            "die Richtung beschreibend, die das Umfeld verlässt"
                                        ],
                                        "tags": [
                                            "räumlich"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "55d8ea23-7c2c-4279-b62d-27921ead378d",
                                                "sense_id": "74ba2f4e-f474-3da2-a0bf-f11936e23791",
                                                "text": "Wo ist er hin? Zum Fenster hinaus."
                                            },
                                            {
                                                "example_id": "82d2fecf-3f03-4f89-b54c-a0307b52198e",
                                                "sense_id": "74ba2f4e-f474-3da2-a0bf-f11936e23791",
                                                "text": "„Zwei Hunde lehnen am Fenster und schauen hinaus; es regnet stark.“"
                                            },
                                            {
                                                "example_id": "874eed87-d1e2-4765-a410-5ce22b24245e",
                                                "sense_id": "74ba2f4e-f474-3da2-a0bf-f11936e23791",
                                                "text": "Er ruderte nicht, er schwamm, so wie er war, aufs Meer hinaus."
                                            },
                                            {
                                                "example_id": "8006f007-dbd9-4e3f-9a06-fcae9f1ce210",
                                                "sense_id": "74ba2f4e-f474-3da2-a0bf-f11936e23791",
                                                "text": "Hinaus! Raus aus meinem Haus!"
                                            },
                                            {
                                                "example_id": "0782a2d3-01a3-4a16-b3cf-3acf4c2bbe9a",
                                                "sense_id": "74ba2f4e-f474-3da2-a0bf-f11936e23791",
                                                "text": "Der Junge will hoch hinaus, hoffen wir, dass er es schafft."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c05d501a-4412-39fd-95a7-af676b3efc82",
                                        "entry_id": "915852a4-e318-38f2-9f6c-6c81db149a7c",
                                        "glosses": [
                                            "über einen meist längeren Zeitraum hinweg"
                                        ],
                                        "tags": [
                                            "temporal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9dda57cf-1166-4f21-ae8e-984509f7cb4f",
                                                "sense_id": "c05d501a-4412-39fd-95a7-af676b3efc82",
                                                "text": "Die Schulden belasten ihn auf Jahre hinaus."
                                            },
                                            {
                                                "example_id": "fe7ec3c6-cb39-4e77-9b73-8c1a449ed109",
                                                "sense_id": "c05d501a-4412-39fd-95a7-af676b3efc82",
                                                "text": "Du musst auch über den Tag hinaus und in die weitere Zukunft blicken."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9c22dc88-e5e8-43dd-958e-3128f8f646ad",
                        "source_entry_id": "f582dc2c-620a-3f51-bb5c-6c9cb32bbcc8",
