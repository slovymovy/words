                    ]
                },
                {
                    "sense_id": "08109458-4377-3b7d-8866-53066facdb27",
                    "sense_definition": "Kurzer erläuternder Text oder eine Beschriftung direkt unter einer Abbildung oder Fotografie.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "bild_untertitel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der <w>Untertitel</w> unter dem Foto erklärt genau, wer darauf zu sehen ist."
                        },
