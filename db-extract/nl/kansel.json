                ],
                "translations": [
                    {
                        "translation_id": "9dd4e02c-15e6-41da-aaa1-e34db5599024",
                        "source_entry_id": "b3c6d0e0-d4f6-32d3-acb0-c87315a13564",
                        "source_sense_id": "e879d82d-78ec-3731-9696-af1747988c15",
                        "source_sense_description": "een kerkelijk, meestal verhoogd, meubelstuk waarvanaf de voorganger in de dienst zijn preek uitspreekt",
                        "target_lang_word": "pulpit",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pulpit",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2c4e85d0-4c93-3fa4-a24a-8a3970e06085",
                                        "entry_id": "ecc15636-b236-3de7-b75f-b48c3bd1c663",
                                        "glosses": [
                                            "A raised platform in a church, sometimes enclosed, where the minister or preacher stands when giving the sermon; also, the lectern on such a platform."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0806ffc8-a33a-4c46-b591-5e1bff235b21",
                                                "sense_id": "2c4e85d0-4c93-3fa4-a24a-8a3970e06085",
                                                "text": "Always, whether in the pulpit or on the platform, as in private conversation, there is an absolute simplicity about the man and his words; a simplicity, an earnestness, a complete honesty."
                                            },
                                            {
                                                "example_id": "c082491a-a8ff-462e-ae1f-ff46e3d1da5d",
                                                "sense_id": "2c4e85d0-4c93-3fa4-a24a-8a3970e06085",
                                                "text": "[H]is `Amens' were ejected at the pulpit with the severity of a reprimand."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c372139c-7cd9-3853-bb2f-a3c9d5a4be56",
                                        "entry_id": "ecc15636-b236-3de7-b75f-b48c3bd1c663",
                                        "glosses": [
                                            "Activity associated with or usually performed from a church pulpit; preaching, sermons, religious teaching."
                                        ],
                                        "tags": [
                                            "metonymically",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8c878c97-56d5-37cc-b26f-7eaced09cfcb",
                                        "entry_id": "ecc15636-b236-3de7-b75f-b48c3bd1c663",
                                        "glosses": [
                                            "The preaching profession, office, or role in general; the pastorate, the priesthood, the ministry."
                                        ],
                                        "tags": [
                                            "metonymically",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9b572a85-2cc1-3177-a825-41e729285229",
                                        "entry_id": "ecc15636-b236-3de7-b75f-b48c3bd1c663",
                                        "glosses": [
                                            "Preachers collectively; clergy; the priesthood."
                                        ],
                                        "tags": [
                                            "metonymically",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f528c469-b4f3-3546-9bd2-69fbb0b24893",
                                        "entry_id": "ecc15636-b236-3de7-b75f-b48c3bd1c663",
                                        "glosses": [
                                            "An individual or particular preaching position or role; a pastorate."
                                        ],
                                        "tags": [
                                            "countable",
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cba41444-abc2-4d73-b756-a4d88140dd1b",
                                                "sense_id": "f528c469-b4f3-3546-9bd2-69fbb0b24893",
                                                "text": "He seems like too timid a man to fill the pulpit at such a large church."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d14f486d-2804-31a3-bd29-96f272dbbc61",
                                        "entry_id": "ecc15636-b236-3de7-b75f-b48c3bd1c663",
                                        "glosses": [
                                            "Bully pulpit."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "755166d6-e5bd-326b-899d-5c65659f8eba",
                                        "entry_id": "ecc15636-b236-3de7-b75f-b48c3bd1c663",
                                        "glosses": [
                                            "Any lectern, podium, dais, or platform for an orator or public speaker."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "420b8807-a412-3227-9a1e-d8c95ab2c38f",
                                        "entry_id": "ecc15636-b236-3de7-b75f-b48c3bd1c663",
                                        "glosses": [
                                            "The railing at the bow of a boat, which sometimes extends past the deck; also called bow pulpit. The railing at the stern is sometimes called the stern pulpit or the pushpit."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d5402ade-2242-3f7d-b306-c199e8f2f42f",
                                        "entry_id": "ecc15636-b236-3de7-b75f-b48c3bd1c663",
                                        "glosses": [
                                            "A bow platform for harpooning."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc03fc0f-4708-4c23-ae64-56e50e4c9153",
                                                "sense_id": "d5402ade-2242-3f7d-b306-c199e8f2f42f",
                                                "text": "[Hooper:] Will you just please go to the end of the pulpit!\n[Brody:] What for?\n[Hooper:] I need to have something in the foreground to give it some scale.\n[Brody:] Foreground, my ass!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cd89dc11-75e4-3dca-85e9-6e4853594b67",
                                        "entry_id": "ecc15636-b236-3de7-b75f-b48c3bd1c663",
                                        "glosses": [
                                            "A plane's cockpit."
                                        ],
                                        "tags": [
                                            "UK",
                                            "dated",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2f6ee5b0-9a14-467d-a5d6-5201662b7567",
                                                "sense_id": "cd89dc11-75e4-3dca-85e9-6e4853594b67",
                                                "text": "In the slang of the Royal Air Force man, the cockpit of his plane is the ‘pulpit’ or ‘office’, the glass covering over it the ‘greenhouse’."
                                            }
                                        ]
                                    }
                                ]
                            }
