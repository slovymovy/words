                    {
                        "sense_id": "9e0ceb92-add0-3dfa-a32d-e32103d546a2",
                        "entry_id": "797d267d-0737-36bb-9aa0-93027b91957a",
                        "glosses": [
                            "To cough up fluid from the lungs."
                        ],
                        "tags": [
                            "ambitransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "0fa2cec5-5e8d-4a34-8407-53d92866bdee",
                                "sense_id": "9e0ceb92-add0-3dfa-a32d-e32103d546a2",
                                "text": "These rules are equally applicable to pneumonia and perhaps also to bronchitis. It will, therefore, be best to call them, not rules for consumptives, but for all persons who cough and expectorate ."
                            },
                            {
                                "example_id": "2ce36ff1-4924-4599-9e1c-7a37c70c914d",
                                "sense_id": "9e0ceb92-add0-3dfa-a32d-e32103d546a2",
                                "text": "…the gap in his upper row of teeth enabled him to expectorate in a new and admirable way."
                            }
                        ]
