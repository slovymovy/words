                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "c3fd7b3e-52d3-492c-b3c9-68d0df3e403e",
                        "source_entry_id": "6dd65066-a8ae-3b89-82d5-4dd08ee0fd15",
                        "source_sense_id": "93abe13c-28d9-3e85-8e2a-2d97e4050fc4",
                        "target_lang_word": "gardien de but",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gardien de but",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e21105a5-61b4-3ea2-ba66-009cf10507b4",
                                        "entry_id": "d56d974a-7cad-370d-8842-3336b2a2bece",
                                        "glosses": [
                                            "Joueur dont le rôle est spécifiquement d’empêcher la balle ou le palet d’entrer dans le but dans des sports collectifs tels que le handball, le football (ou soccer), le water-polo, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8fdf081b-e461-4e30-bfd2-0c79a32cbd6f",
                                                "sense_id": "e21105a5-61b4-3ea2-ba66-009cf10507b4",
                                                "text": "Le gardien de but est un joueur particulier qui se montre souvent déterminant dans le résultat d’un match."
                                            },
                                            {
                                                "example_id": "8e78f350-3eca-4359-94bc-8d231a5831b0",
                                                "sense_id": "e21105a5-61b4-3ea2-ba66-009cf10507b4",
                                                "text": "Pour cette raison, les gardiens de but ont souvent un niveau culturel supérieur à celui des autres joueurs."
                                            },
                                            {
                                                "example_id": "f124794c-4969-4494-9964-63cf80bb8397",
                                                "sense_id": "e21105a5-61b4-3ea2-ba66-009cf10507b4",
                                                "text": "Le président aurait dû tenir le même discours dimanche qu’en 1991, confie Gilles Rousset, gardien de but de l’OL durant cette saison 1990-1991."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
