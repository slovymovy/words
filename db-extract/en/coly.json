                        "sense_id": "618f2086-7cf7-37fa-b670-b5d7fc923c0a",
                        "entry_id": "72a6ee81-f8f5-3751-867f-b1e9a961ae1b",
                        "glosses": [
                            "Any bird of either of the genera Colius or Urocolius, endemic to sub-Saharan Africa."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "73bd2fdd-cf59-4143-b260-cafc9d0a4729",
                                "sense_id": "618f2086-7cf7-37fa-b670-b5d7fc923c0a",
                                "text": "First, their feathers grow continuously over their bodies without the bare spaces (apteria) between tracts most other birds have. This condition is shared only by the ostrich, the penguins, and the colies."
                            },
                            {
                                "example_id": "ef059160-5532-4ea5-a807-a5fd5b1159cc",
                                "sense_id": "618f2086-7cf7-37fa-b670-b5d7fc923c0a",
                                "text": "1999, Michael A. Mares, Mousebird, entry in Encyclopedia of Deserts, page 378,\nColiiformes is the only order of birds endemic to Africa. Six species from two genera (Urocolius and Colius) are recognized, all of which are sedentary. Mousebirds (also known as colies) range through sub-Saharan open savannas and are often common in such areas."
                            }
                        ]
                    }
