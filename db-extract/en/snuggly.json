                "forms": [
                    {
                        "form_id": "9903a055-5d31-4dcb-8452-94d5d6f4946a",
                        "entry_id": "e250e19f-74e6-37f5-b170-8bd06eefd867",
                        "tags": [
                            "plural"
                        ],
                        "form": "snugglies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "710224b0-00ef-3628-827d-3bf5734db1ff",
                        "entry_id": "e250e19f-74e6-37f5-b170-8bd06eefd867",
                        "glosses": [
                            "Plush, stuffed animal, doll, or children's toy, chiefly embraced at bedtime."
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "54967ed9-84eb-402d-9710-0a5b1a56aee5",
                                "sense_id": "710224b0-00ef-3628-827d-3bf5734db1ff",
                                "text": "My snuggly fell off the bed."
                            },
                            {
                                "example_id": "0766a456-55f0-4614-8a47-87b323bfff54",
                                "sense_id": "710224b0-00ef-3628-827d-3bf5734db1ff",
                                "text": "I lined up the snugglies for a family photo!"
                            }
                        ]
                    },
                    {
                        "sense_id": "165799f8-35bd-397e-8711-bf067dc965b2",
                        "entry_id": "e250e19f-74e6-37f5-b170-8bd06eefd867",
                        "glosses": [
                            "Anything cosy or cuddly, such as soft clothing or animals."
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "f46e3e56-8c10-418c-a007-95e749828208",
                                "sense_id": "165799f8-35bd-397e-8711-bf067dc965b2",
                                "text": "At first, you throw a couple of comfortable snugglies into the suitcase. Then you think to add some cute outfits so she'll be looking her baby best for the millions of photographs you'll take."
                            },
                            {
                                "example_id": "05b97dfb-e529-4d94-8570-aea474eb0ba1",
                                "sense_id": "165799f8-35bd-397e-8711-bf067dc965b2",
                                "text": "Carly surveyed the pile of fuzzy puppies and was overwhelmed by the cuteness. \"Look at those cuddly snugglies! I just want to hug all that clean puppy fur.\""
                            },
                            {
                                "example_id": "afd2d1b2-6791-47bc-97e9-5d6df7ecf482",
                                "sense_id": "165799f8-35bd-397e-8711-bf067dc965b2",
                                "text": "\"Once I got home and into my snugglies, I couldn't take them off.\""
                            }
                        ]
                    }
                ],
