                    {
                        "sense_id": "a4caf3c1-d552-3b94-a43a-838cc6c34f4d",
                        "entry_id": "13768bcd-2c13-30c0-8817-1589a8a47216",
                        "glosses": [
                            "The accumulation of fluid in the peritoneum"
                        ],
                        "tags": [
                            "obsolete",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "cb5b184f-68ef-4907-97c3-34e2640bf671",
                                "sense_id": "a4caf3c1-d552-3b94-a43a-838cc6c34f4d",
                                "text": "If uniformity could be preserved throughout, we ought, however, to say hydroperitoneum, in place of ascites, hydropneumonia, for edema of the lungs, hydroarachnoid, for hydrocephalus, hydropleura, for hydrothorax, and hydrovarium, for dropsy of the ovaries."
                            },
                            {
                                "example_id": "39f94279-b18d-4acb-a866-7d34fc5f5941",
                                "sense_id": "a4caf3c1-d552-3b94-a43a-838cc6c34f4d",
                                "text": "In the greater proportion of cases hydroperitoneum causes no difficulty."
                            },
                            {
                                "example_id": "56a62759-7430-448b-b4c9-3c29434f364a",
                                "sense_id": "a4caf3c1-d552-3b94-a43a-838cc6c34f4d",
                                "text": "There were fourteen cases of primary ovarian cancer, most of them associated with hydroperitoneum."
                            }
                        ]
                    }
                ],
