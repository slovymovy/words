                                            {
                                                "example_id": "f3e97915-15de-407a-a307-5dbb359fc92c",
                                                "sense_id": "cb31bf31-0d5f-3879-b73d-e2fc97c4782c",
                                                "text": "Die Meinungen zeigten eine klare Divergenz in Bezug auf das Thema."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "42206646-7b21-3d6c-aad1-b2216fcdbedf",
                                        "entry_id": "1cabbade-9e89-33b8-98a1-9a0e9ceb50ca",
                                        "glosses": [
                                            "das Nichtvorhandensein von Konvergenz; das Fehlen eines Grenzwertes"
                                        ],
                                        "tags": [
                                            "Analysis",
                                            "von Folgen und Funktionen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd8c5e1d-5f27-4ca5-9f32-bfd5a25252e1",
                                                "sense_id": "42206646-7b21-3d6c-aad1-b2216fcdbedf",
                                                "text": "Bei der durch a_n=(-1)ⁿ definierten Folge liegt Divergenz vor, da sie sich keinem festen Grenzwert nähert."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "7fae2abf-fe99-3847-8b27-d09b335b079b",
                                        "entry_id": "1cabbade-9e89-33b8-98a1-9a0e9ceb50ca",
                                        "glosses": [
                                            "ein Differentialoperator, der die Quelldichte eines Vektorfeldes beschreibt"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f0748ffa-71a7-4188-acd5-e7a50c91ff64",
                                                "sense_id": "7fae2abf-fe99-3847-8b27-d09b335b079b",
                                                "text": "Ist die Divergenz in einem Feld überall gleich Null, so bezeichnet man das Feld als quellenfrei."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
