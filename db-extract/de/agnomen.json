                "senses": [
                    {
                        "sense_id": "596f4974-a0e4-3ac1-a5a1-f59910de05bf",
                        "entry_id": "d55e3c60-5909-3c44-a369-2e1cace77670",
                        "glosses": [
                            "Beiname, der zum Namen einer Person hinzugefügt wurde, um bestimmte Eigenschaften, Verdienste oder Herkunft hervorzuheben"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "62061fc6-8fda-4e0f-a1e8-ca28666166cd",
                                "sense_id": "596f4974-a0e4-3ac1-a5a1-f59910de05bf",
                                "text": "„Bei besonderen Verdiensten konnten Ehrennamen hinzukommen, zum Beispiel Africanus. Ein solches Agnomen übernahm in der Spätantike zunehmend die Funktion des Cognomen, als auch dieses anfing, erblich zu werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
