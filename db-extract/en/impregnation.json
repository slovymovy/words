                    },
                    {
                        "sense_id": "b3febc2f-e2ea-3d88-adc6-aa96ffbf2a35",
                        "entry_id": "f2b8b91f-c813-35d3-8e7c-26211bcc7a0f",
                        "glosses": [
                            "An ore deposit, with indefinite boundaries, consisting of rock impregnated with ore."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "4a95cafa-b65a-47f1-b3d0-865124533ba4",
                                "sense_id": "b3febc2f-e2ea-3d88-adc6-aa96ffbf2a35",
                                "text": "Oil-shales are often the last relics of a former impregnation with petroleum; they are associated with phenomena—such as the intrusive asphaltites or manjacks—common to petroliferous regions, but in many cases the parent oilfields, the sources of the former impregnation, are things of the past."
                            }
                        ]
                    }
