                    },
                    {
                        "translation_id": "591c2a71-c2ba-42d0-a4c4-ec253c0ca7de",
                        "source_entry_id": "996474ed-cf1d-3758-8bb7-fe991b662454",
                        "source_sense_id": "6d03620d-ef9c-3845-adfb-b95de349d7ee",
                        "target_lang_word": "secretly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "secretly",
