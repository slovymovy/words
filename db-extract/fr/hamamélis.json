        "fr-extract.jsonl": [
            {
                "entry_id": "9f81cd66-53cf-3a8b-b121-611cf6e4fab6",
                "word": "hamamélis",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "93a5a01c-bef2-3cef-b0a6-495ea03133b6",
                        "entry_id": "9f81cd66-53cf-3a8b-b121-611cf6e4fab6",
                        "glosses": [
                            "Genre de plantes (Hamamelis) appartenant à la famille des hamamélidacées qui comprend 5 ou 6 espèces d'arbustes poussant dans les zones boisées et sur les rives des cours d'eau à l'est de l'Asie et en Amérique du Nord, dont on utilise en médecine et en cosmétologie un extrait retiré des feuilles et de l’écorce."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4274a2a8-36b3-4759-a405-6efccfe56e6e",
                                "sense_id": "93a5a01c-bef2-3cef-b0a6-495ea03133b6",
                                "text": "Je lui avais trouvé des emplâtres, des onguents à l’hamamélis qu’existaient plus chez les potards depuis des mois et des mois."
                            },
                            {
                                "example_id": "20fd8826-08ea-4721-9fd4-5b223cf7134e",
                                "sense_id": "93a5a01c-bef2-3cef-b0a6-495ea03133b6",
                                "text": "Toutes les plantes à propriétés vitaminiques P sont bénéfiques pour la circulation: vigne rouge, hamamélis, cassis (fruit), mélilot, myrtille (fruit), marronnier d'Inde."
                            },
                            {
                                "example_id": "cc693925-c2fa-4bf4-8fa0-edbf11eeb5c8",
                                "sense_id": "93a5a01c-bef2-3cef-b0a6-495ea03133b6",
                                "text": "Des champignons vénéneux et des hamamélis croissaient au bord du chemin, un peu plus bas de la douce-amère, et puis de l'actée rouge, dont les fruits toxiques ressemblent aux yeux d'une poupée."
                            }
                        ]
                    }
                ],
