                "senses": [
                    {
                        "sense_id": "2bf77364-3a6d-3440-933d-b23eb1565e81",
                        "entry_id": "38577b6a-86e9-3c29-8d6d-66d57cef9394",
                        "glosses": [
                            "Celle qui viole le serment de fidélité conjugale."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "ccff51fd-bcbf-49c1-81a6-6de987ecdf00",
                                "sense_id": "2bf77364-3a6d-3440-933d-b23eb1565e81",
                                "text": "C’est au héros lui-même qu’il réserve le rôle de donner la mort à l’adultéresse, apparemment sans trop s’inquiéter de mettre son personnage en contradiction avec lui-même."
                            },
                            {
                                "example_id": "3058dd7c-8092-4061-a09a-f574f85cfc48",
                                "sense_id": "2bf77364-3a6d-3440-933d-b23eb1565e81",
                                "text": "Peut-on fourrer dans le même sac de flammes certain pape sodomiste, criminel et voleur, et une humble adultéresse, légèrement empoisonneuse ?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e2f05b09-8793-44b4-a4af-eb18c7859baf",
                        "source_entry_id": "38577b6a-86e9-3c29-8d6d-66d57cef9394",
                        "source_sense_id": "2bf77364-3a6d-3440-933d-b23eb1565e81",
                        "target_lang_word": "Ehebrecherin",
