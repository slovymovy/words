                                    {
                                        "sense_id": "f63176ec-bc1b-3c0d-83de-096159e434cf",
                                        "entry_id": "c33b6f1f-907a-3b41-9ee2-ba33a89f785d",
                                        "glosses": [
                                            "The representation in words or pictures of goods, services, the name, the trade mark or the activities of a producer of goods or a provider of services in media products when such representation is intended by the publisher to serve advertising and might mislead the public as to its nature."
                                        ],
                                        "tags": [
                                            "collective",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a764a62-eca4-4925-8a94-8adc237d7c1e",
                                                "sense_id": "f63176ec-bc1b-3c0d-83de-096159e434cf",
                                                "text": "I have not the slightest objection to any temper Mr. Allenmay show, but when he attributes a motive, and more than hints that I am abusing these columns by surreptitious advertising, I disdain to do further battle with him."
                                            },
                                            {
                                                "example_id": "65fc1015-1564-45a0-ad99-2f016cdf33f9",
                                                "sense_id": "f63176ec-bc1b-3c0d-83de-096159e434cf",
                                                "text": "Once this lottery owned a State, and openly offered it a princely revenue of millions for a renewal of the law which gave it a respectable habitation and a convenient foothold from which it might lure its victims month by month. Now it is an outlaw, and seeks its prey by surreptitious advertising on the play-bills of theatres."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
