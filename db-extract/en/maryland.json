                    {
                        "translation_id": "cb6b7fcb-4fe4-497b-a5cd-3a6053adc45b",
                        "source_entry_id": "678d4d90-71f4-3cf3-a584-2c12a1954941",
                        "source_sense_description": "US state",
                        "target_lang_word": "Maryland",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Maryland",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "10dc76d5-7d3e-3365-8fe3-a8af327cca27",
                                        "entry_id": "adad028f-661b-3995-b74d-f348ebd80de5",
                                        "glosses": [
                                            "État du côte de l’est des États-Unis d’Amérique (code postal MD), bordé par la Pennsylvanie au nord, le Delaware à l’est, l’océan Atlantique au sud-est, la Virginie et le district de Columbia au sud-ouest, et la Virginie-Occidentale à l’ouest. Sa capitale est Annapolis."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96d11b0f-9bd2-4407-a8ba-9faf8cf7a64a",
                                                "sense_id": "10dc76d5-7d3e-3365-8fe3-a8af327cca27",
                                                "text": "J’ai déjà mentionné mon nom, Benjamin O. Lesage. Malgré la consonance française, héritage d’un aïeul huguenot émigré au siècle de Louis XIV, je suis citoyen américain, natif d’Annapolis, dans le Maryland, sur la baie de Chesapeake, modeste bras de l’Atlantique."
                                            },
                                            {
                                                "example_id": "953ef8b2-8525-45cf-ba3a-6cef0ce46a8f",
                                                "sense_id": "10dc76d5-7d3e-3365-8fe3-a8af327cca27",
                                                "text": "C’est ainsi, et c’est un comble, que le discours œnologiquement correct qui s’est imposé au pays de Rabelais, de Molière et de Gentil-Bernard est inspiré par la prose gluante de Robert Paker, le gourou du Maryland amateur d’arômes de ketchup et de senteurs de boite à épices."
                                            },
                                            {
                                                "example_id": "5966f3a7-0157-47da-9681-45ca602600de",
                                                "sense_id": "10dc76d5-7d3e-3365-8fe3-a8af327cca27",
                                                "text": "Le Maryland est devenu le premier état américain à approuver un impôt sur la publicité en ligne, un secteur largement dominé par Google et Facebook."
                                            },
                                            {
                                                "example_id": "85c3859c-581d-4caa-af41-4fec5a20be99",
                                                "sense_id": "10dc76d5-7d3e-3365-8fe3-a8af327cca27",
                                                "text": "Pour illustrer cette coopération spatiale, les journalistes qui suivent la délégation française étaient conviés, mardi, au centre de vol spatial Goddard de la Nasa, dans le Maryland."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f1e928fb-da89-31d9-a2f8-0c85e4ad0c8b",
                                        "entry_id": "adad028f-661b-3995-b74d-f348ebd80de5",
                                        "glosses": [
                                            "Village du Pays de Galles situé dans le Monmouthshire."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "20e044f0-a532-3d9d-b4e2-2ecb7022ee04",
                                        "entry_id": "adad028f-661b-3995-b74d-f348ebd80de5",
                                        "glosses": [
                                            "Comté du Liberia."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
