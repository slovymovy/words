                                "target_senses": [
                                    {
                                        "sense_id": "eb24501e-518a-3ce5-83e9-5a566f57e3b2",
                                        "entry_id": "9f42a200-ea30-3ac0-bb25-f81195b16117",
                                        "glosses": [
                                            "Électrode par laquelle entre le courant électrique continu (en suivant le sens conventionnel du courant, opposé au sens de déplacement des électrons)."
                                        ],
                                        "tags": [
                                            "Électrochimie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "036d0b10-5ea2-4058-8981-8972a2049434",
                                                "sense_id": "eb24501e-518a-3ce5-83e9-5a566f57e3b2",
                                                "text": "L’anode d’une pile ou d’une batterie correspond au pôle négatif."
                                            },
                                            {
                                                "example_id": "5d144e19-59ed-4948-8696-16d464e7e24a",
                                                "sense_id": "eb24501e-518a-3ce5-83e9-5a566f57e3b2",
                                                "text": "L’anode pour une électrolyse correspond au pôle positif."
                                            },
                                            {
                                                "example_id": "4356c226-5397-40df-9924-7e0b313e619b",
                                                "sense_id": "eb24501e-518a-3ce5-83e9-5a566f57e3b2",
                                                "text": "En employant comme anode du cuivre de bonne qualité, le peu d’impuretés entrant en solution sera éliminé du fait du mouillage."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
