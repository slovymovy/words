                                                "example_id": "efe3333c-0d66-4a93-bc04-92ec85798b4a",
                                                "sense_id": "f307c09c-691a-36ed-a109-4f2ed0821fd4",
                                                "text": "I do set my bow in the cloud."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fa657538-dc2e-3d63-ae62-4d0c7795388d",
                                        "entry_id": "45b3a335-fdc3-3f32-a733-da1ee96d6899",
                                        "glosses": [
                                            "The U-shaped piece which goes around the neck of an ox and fastens it to the yoke."
                                        ],
                                        "tags": [],
