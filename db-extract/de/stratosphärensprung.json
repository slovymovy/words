                    {
                        "sense_id": "6bc917c7-704f-3ed5-8dae-d3bc4b5c5e8e",
                        "entry_id": "a5f86927-88a4-3c1d-8b6c-28356cdf3be7",
                        "glosses": [
                            "Fallschirmsprung oberhalb der Troposphäre"
