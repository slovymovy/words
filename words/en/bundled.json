{
    "word_family": [
        "bundle"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "9a6059f3-d2b9-35e7-8326-da466517358e",
                    "sense_definition": "Arranged or tied together into a single package or group.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "group_bundled",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>bundled</w> newspapers were left on the front porch.",
                            "target_lang_translations": {
                                "ru": "<w>Связанные</w> газеты были оставлены на крыльце."
                            }
                        },
                        {
                            "text": "She carried a <w>bundled</w> collection of old letters tied with a ribbon.",
                            "target_lang_translations": {
                                "ru": "Она несла <w>связанную</w> лентой пачку старых писем."
                            }
                        }
                    ],
                    "synonyms": [
                        "packed",
                        "wrapped"
                    ],
                    "common_phrases": [
                        "bundled together",
                        "neatly bundled"
                    ],
                    "target_lang_definitions": {
                        "ru": "Связанный или упакованный вместе в один пакет или группу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "связанный",
                                "target_lang_sense_clarification": "предметы, скрепленные вместе"
                            },
                            {
                                "target_lang_word": "упакованный",
                                "target_lang_sense_clarification": "предметы, помещенные в общую упаковку"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "47f4f83f-ce33-3232-97b1-975a73c08eea",
                    "sense_definition": "Simple past and past participle of <w>bundle</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "group_bundled",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>bundled</w> his clothes into a suitcase before leaving for the airport.",
                            "target_lang_translations": {
                                "ru": "Он <w>упаковал</w> свои вещи в чемодан перед отъездом в аэропорт."
                            }
                        },
                        {
                            "text": "The company <w>bundled</w> the software with the new computer to increase sales.",
                            "target_lang_translations": {
                                "ru": "Компания <w>скомпоновала</w> программное обеспечение с новым компьютером, чтобы увеличить продажи."
                            }
                        }
                    ],
                    "common_phrases": [
                        "bundled up"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and past participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие прошедшего времени от глагола «связывать» или «упаковывать»."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "связал",
                                "target_lang_sense_clarification": "действие по скреплению предметов вместе"
                            },
                            {
                                "target_lang_word": "упаковал",
                                "target_lang_sense_clarification": "действие по помещению предметов в упаковку или багаж"
                            },
                            {
                                "target_lang_word": "скомпоновал",
                                "target_lang_sense_clarification": "действие по объединению товаров или услуг в один комплект"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}