                                        "entry_id": "343a9551-a8af-3faa-aa92-e3d9483403a3",
                                        "glosses": [
                                            "malý prostorový model bytosti"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a5d151c3-77db-41db-9ab8-738882a1517a",
                                                "sense_id": "d9d09b11-18ec-37a6-ae43-644cfabb2e97",
                                                "text": "Rozestavuje na šachovnici hrst černých a bílých figurek a porovnává jejich posice s knížkou, tiše si hvízdaje."
                                            }
                                        ]
