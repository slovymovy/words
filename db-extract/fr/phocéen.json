                        "entry_id": "7102b65a-221b-3601-b4da-6df8ce853557",
                        "glosses": [
                            "Relatif à Phocée ou à la Phocide."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "75349c2a-d56b-3211-a0d6-e1ac8d46ae4e",
                        "entry_id": "7102b65a-221b-3601-b4da-6df8ce853557",
                        "glosses": [
                            "De Marseille, marseillais."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52ba69a9-0f2f-40c2-ba6d-459d0d8a8aa8",
                                "sense_id": "75349c2a-d56b-3211-a0d6-e1ac8d46ae4e",
                                "text": "Pour les habitués de la galère, l’été phocéen n’est pas synonyme de vacances."
                            },
                            {
                                "example_id": "82b8c4a1-20ce-440c-92db-3c620d45fe02",
                                "sense_id": "75349c2a-d56b-3211-a0d6-e1ac8d46ae4e",
                                "text": "Après cinq ans, elle rentre en Île-de-France enceinte de Julien Derouault, danseur rencontré dans la ville phocéenne."
                            },
                            {
                                "example_id": "4eb28de9-98bb-41d9-988e-21cdfadd4e5b",
                                "sense_id": "75349c2a-d56b-3211-a0d6-e1ac8d46ae4e",
                                "text": "Le défenseur portugais Nuno Tavares a rejoint l’Olympique de Marseille sous la forme d’un prêt d’un an consenti par Arsenal, a annoncé samedi le club phocéen."
                            }
                        ]
                    }
