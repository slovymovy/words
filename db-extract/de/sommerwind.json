                        "glosses": [
                            "Wind, der im Sommer weht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "00c26d35-480c-436d-888d-6941b924d6d8",
                                "sense_id": "aed25962-eaa8-3530-837b-82e292ac187e",
                                "text": "„Die strenge Meeresbrise mit einem Hauch von Hafenwasser und totem Fisch verzog sich, sobald der Meltemi, der starke Sommerwind aus dem Norden, eingeschlafen war und Platz machte für eine süße Duftmischung aus Hasch und Lagerfeuer.“"
                            },
                            {
                                "example_id": "d3ffc90f-e39c-4550-9efc-6fc401f70431",
                                "sense_id": "aed25962-eaa8-3530-837b-82e292ac187e",
                                "text": "„Der weiche Sommerwind weht uns alle Gedanken aus den Seelen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
