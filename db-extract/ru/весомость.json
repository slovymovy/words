                                        "sense_id": "9869b3d5-85c8-383f-85e8-4b34b8849179",
                                        "entry_id": "f891d26d-85dd-36ea-be8c-36d207574722",
                                        "glosses": [
                                            "The fact of having a detectable weight or mass."
                                        ],
                                        "tags": [
