                                    {
                                        "sense_id": "bd2b0997-9b44-30cb-b94d-c7c9d447188a",
                                        "entry_id": "2f992d66-9c76-37f1-aba9-86f43237ebdb",
                                        "glosses": [
                                            "Dont la santé est altérée."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "47cd357a-5570-385a-884c-856c3715e0e4",
                                        "entry_id": "2f992d66-9c76-37f1-aba9-86f43237ebdb",
                                        "glosses": [
                                            "Se dit aussi des choses."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fba9bdb4-5394-4a67-a071-3e68fffb49a2",
                                                "sense_id": "47cd357a-5570-385a-884c-856c3715e0e4",
                                                "text": "Ne touchez pas son bras malade."
                                            },
                                            {
                                                "example_id": "cbdbdfea-942c-455e-8bb6-af79111b7123",
                                                "sense_id": "47cd357a-5570-385a-884c-856c3715e0e4",
                                                "text": "Ces plantes, ces arbres sont malades."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5984146c-839e-3b12-97d6-c5946f6744d8",
                                        "entry_id": "2f992d66-9c76-37f1-aba9-86f43237ebdb",
                                        "glosses": [
                                            "Fou, dérangé."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dc91d7ce-0efd-4bea-be97-8456641b610f",
                                                "sense_id": "5984146c-839e-3b12-97d6-c5946f6744d8",
                                                "text": "Mais il est malade ce type !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4dc40b0e-ea5e-31a1-8b7c-c0948153800a",
                                        "entry_id": "2f992d66-9c76-37f1-aba9-86f43237ebdb",
                                        "glosses": [
                                            "Génial, excellent, qui sort de l’ordinaire."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dda63727-c36e-4882-93cc-a212170838cb",
                                                "sense_id": "4dc40b0e-ea5e-31a1-8b7c-c0948153800a",
                                                "text": "Je suis allé voir un concert hier, c'était malade."
                                            },
                                            {
                                                "example_id": "6a5cc0ab-94a0-43c1-80e2-59ab25df8a3b",
                                                "sense_id": "4dc40b0e-ea5e-31a1-8b7c-c0948153800a",
                                                "text": "Hein, c’est malade comme idée, il faut absolument qu’on le fasse un jour."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "malade",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6bb25dcd-4440-327e-9be4-d65c1edd878e",
                                        "entry_id": "62b37a4a-7f6c-3245-ad05-706906afe9f8",
                                        "glosses": [
                                            "Personne en mauvaise santé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71fd02ac-620c-405e-8df3-8a77a9c9d2eb",
                                                "sense_id": "6bb25dcd-4440-327e-9be4-d65c1edd878e",
                                                "text": "Ultracompétente et plutôt aimable (pour peu que vous respectiez son statut), elle sait contourner le règlement pour sauver la peau d’un malade : en l'occurrence, bibi."
                                            },
                                            {
                                                "example_id": "ed23fc67-8caf-48a6-a360-b7294623c6cd",
                                                "sense_id": "6bb25dcd-4440-327e-9be4-d65c1edd878e",
                                                "text": "Mais je conseille peu l’Islande aux malades, aux invalides et à quiconque est habitué au confort des hôtels et des wagons-lits."
                                            },
                                            {
                                                "example_id": "499e964a-1643-4dcb-9a05-d59b83f411f8",
                                                "sense_id": "6bb25dcd-4440-327e-9be4-d65c1edd878e",
                                                "text": "… — (les Martiens, au moyen d’une drogue procurant des rêves magnifiques, supprimaient les malades, les infirmes et les mal nés, de sorte que, chez eux, la pitié était des plus rudimentaires) — …"
                                            },
                                            {
                                                "example_id": "4ab8ab53-624d-421a-b5b3-ef7ed91cd2c8",
                                                "sense_id": "6bb25dcd-4440-327e-9be4-d65c1edd878e",
                                                "text": "Stérilité –\nJadis masculin,\n« COVID-19 » est féminin !\n« Malade » ? Épicène !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "622f4568-081a-337c-9ce9-b97031ec3dbd",
                                        "entry_id": "62b37a4a-7f6c-3245-ad05-706906afe9f8",
                                        "glosses": [
                                            "Personne faisant l'objet des soins d'un médecin ou d'un établissement de santé. (syn. : patient)"
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c240244a-95e8-46c8-ac74-a47fc0a38276",
                                                "sense_id": "622f4568-081a-337c-9ce9-b97031ec3dbd",
                                                "text": "Que dire à ce point de vue de l’infirmerie de Gray's Inn? Pour ces 500 malades, il n’y a qu'un médecin."
                                            },
                                            {
                                                "example_id": "88c80da8-6d55-429f-acf7-2c371a5af451",
                                                "sense_id": "622f4568-081a-337c-9ce9-b97031ec3dbd",
                                                "text": "C’était un milieu agréable et sans morgue, beaucoup plus humain que celui de la Salpêtrière et où le malade n’était pas considéré comme un simple support de la maladie."
                                            },
                                            {
                                                "example_id": "cbce646f-f9d0-4be2-b796-f7dfd2ba5857",
                                                "sense_id": "622f4568-081a-337c-9ce9-b97031ec3dbd",
                                                "text": "L’état physique du malade était des plus piteux : […]. Le malade vint en septembre 1915, sur le conseil d’un de mes clients. À partir de ce moment, les progrès ont été très rapides et actuellement (1925), ce monsieur se porte parfaitement bien. C’est une vraie résurrection."
                                            },
                                            {
                                                "example_id": "cee18a0a-59b8-4e57-9703-8d30880b7e0e",
                                                "sense_id": "622f4568-081a-337c-9ce9-b97031ec3dbd",
                                                "text": "La façon dont le malade a eu connaissance de son diagnostic est très variable."
                                            },
                                            {
                                                "example_id": "9c14e259-86bd-4c69-bbe0-a6e6cb291337",
                                                "sense_id": "622f4568-081a-337c-9ce9-b97031ec3dbd",
                                                "text": "Ce matin du 29 février 1968, les médecins, les infirmières et les malades de l'Hôtel-Dieu de Limonois n'en croyaient pas leurs yeux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "96fb5749-cdb4-3298-96ea-23d320165ddb",
                                        "entry_id": "62b37a4a-7f6c-3245-ad05-706906afe9f8",
                                        "glosses": [
                                            "Personne dangereuse parce que dérangée mentalement, ou présentée comme telle."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4559cb3d-eae4-4419-8a1b-d145bda95610",
                                                "sense_id": "96fb5749-cdb4-3298-96ea-23d320165ddb",
                                                "text": "« Il me battait avec la ceinture. Il me la montrait avant, puis, après m'avoir « strapé », il me demandait de l'embrasser sur le bord de la joue... c'est un malade! Le même soir, il est venu me chercher dans mon dortoir et il m'a agressé physiquement, sexuellement, c'est allé jusqu'à la sodomie. C'est une bête... c'est un sadique, un malade! », a déclaré une victime qui a accepté de raconter son calvaire aux médias."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ac2dee8c-01ed-3109-b477-7d35fec5b84b",
                                        "entry_id": "62b37a4a-7f6c-3245-ad05-706906afe9f8",
                                        "glosses": [
                                            "Dément, personne au comportement extraordinaire ou excessif"
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a8f791a1-83d1-4612-8912-38f5c6b07c03",
                                                "sense_id": "ac2dee8c-01ed-3109-b477-7d35fec5b84b",
                                                "text": "Paul nota en traversant la foule que Sarfati n’était pas appelé autrement que « Gros Ben », et que son élection était de l’avis général considérée comme « un truc de malade."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "efed6845-452b-379f-899c-d0b16fb1b983",
                                        "entry_id": "62b37a4a-7f6c-3245-ad05-706906afe9f8",
                                        "glosses": [
                                            "Personne ne participant plus aux hostilités du fait d'une maladie et qui à ce titre ne constitue plus une cible légitime et bénéficie de la protection du droit international humanitaire si elle dépose les armes."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a0d0eb40-5054-43ad-9db6-967633eef13b",
                        "source_entry_id": "619dfa5e-76e1-374f-880c-229d2017e5bf",
                        "source_sense_id": "51bd72eb-b7e4-3f67-b8ee-9b6bff15be0f",
                        "source_sense_description": "affected with of suffering from disease",
                        "target_lang_word": "krank",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "krank",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1ef4921e-13dd-3ef1-858e-ec5f5e328651",
                                        "entry_id": "0bac2c1f-41e8-316a-87a0-09687acee3ae",
                                        "glosses": [
                                            "körperlich und/oder psychisch gesundheitlich eingeschränkt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2375c1b4-4566-46f9-8959-dc8de38c3557",
                                                "sense_id": "1ef4921e-13dd-3ef1-858e-ec5f5e328651",
                                                "text": "Er muss im Bett liegen, weil er krank ist."
                                            },
                                            {
                                                "example_id": "52f457fe-fb80-4a41-ae14-9a9519e2ef45",
                                                "sense_id": "1ef4921e-13dd-3ef1-858e-ec5f5e328651",
                                                "text": "Pflege- und Arztpersonal klagen dagegen über zu viel Arbeit. Pflege sei nur noch im Laufschritt, Gespräche zwischen Arzt und Patient nur im Minutentakt möglich. Die Folge: Ärzte und Pfleger werden selbst krank."
                                            },
                                            {
                                                "example_id": "aaa5542a-3d2d-4651-b12c-8ce89b7801f7",
                                                "sense_id": "1ef4921e-13dd-3ef1-858e-ec5f5e328651",
                                                "text": "Auch schlechte soziale Umstände, wie Armut, Lärmbelastung, enge Wohnverhältnisse, machen krank."
                                            },
                                            {
                                                "example_id": "72e4bb2b-a8a6-4a11-bc49-5982462e13ba",
                                                "sense_id": "1ef4921e-13dd-3ef1-858e-ec5f5e328651",
                                                "text": "Flüche funktionieren. Zahlreiche Fälle sind bekannt, von Menschen, die allein durch den Glauben an eine Krankheit krank wurden und im Extremfall sogar starben."
                                            },
                                            {
                                                "example_id": "730fdb98-e2c5-4c56-8b18-4b315337eec8",
                                                "sense_id": "1ef4921e-13dd-3ef1-858e-ec5f5e328651",
                                                "text": "„Alexander ist noch viel kranker, als wir angenommen haben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "95c9ecb3-fbae-3a2e-9a61-670ab560d96f",
                                        "entry_id": "0bac2c1f-41e8-316a-87a0-09687acee3ae",
                                        "glosses": [
                                            "unsinnig, absurd"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "derogatory",
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3d8b0ef6-8ff6-4601-a46c-67b2d67ad4b6",
                                                "sense_id": "95c9ecb3-fbae-3a2e-9a61-670ab560d96f",
                                                "text": "Du bist ja völlig krank im Kopf!"
                                            },
                                            {
                                                "example_id": "254c729c-1f36-40fe-97af-aef95829ec69",
                                                "sense_id": "95c9ecb3-fbae-3a2e-9a61-670ab560d96f",
                                                "text": "Bisweilen waren seine Ideen genial, rezent sind sie allerdings absurd und durchweg krank."
                                            },
                                            {
                                                "example_id": "59f07406-7ffc-4848-9661-f77a3ea3873c",
                                                "sense_id": "95c9ecb3-fbae-3a2e-9a61-670ab560d96f",
                                                "text": "„Ich kann nicht anders. Ich gehe an jede Rolle wahrhaftig ran. Ich liebe die Figuren – egal wie krank und kaputt sie sind.[…]“"
                                            },
                                            {
                                                "example_id": "570479ad-c3cd-4c3e-8e1f-13b56bc46625",
                                                "sense_id": "95c9ecb3-fbae-3a2e-9a61-670ab560d96f",
                                                "text": "„Das Heftchen soll Kindern Politik und die Demokratie näher bringen. Problem allerdings, es muss erst richtig ‚durchgegendert‘ werden, weil zu wenig Mehmet, Ayse und Behinderte vorkommen. Kranker geht’s nicht!“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "f09c8cbf-50cc-3b0b-8d58-d066b30e4b5e",
                                        "entry_id": "0bac2c1f-41e8-316a-87a0-09687acee3ae",
                                        "glosses": [
                                            "durch einen Schuss verletzt"
                                        ],
                                        "tags": [
                                            "Jägersprache",
                                            "von Wild"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b917496-8368-47c0-b386-56d8b16a5ad4",
                                                "sense_id": "f09c8cbf-50cc-3b0b-8d58-d066b30e4b5e",
                                                "text": "„Eine Nachsuche wird im ungünstigen Falle zu einer Hetze führen, wenn das kranke Wild vor dem Hund flüchtig wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            },
