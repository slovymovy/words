{
    "word_family": [
        "alphabet",
        "alphabetize",
        "alphabetization",
        "alphabetically"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "af63b57b-fcb6-35b4-8052-6cf623f8dd5b",
                    "sense_definition": "Arranged in the traditional order of the letters of an alphabet.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "ordering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please arrange the student files in <w>alphabetical</w> order by their last names.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, расположите личные дела студентов в <w>алфавитном</w> порядке по фамилиям."
                            }
                        },
                        {
                            "text": "The teacher handed out an <w>alphabetical</w> list of all the countries in Europe.",
                            "target_lang_translations": {
                                "ru": "Учитель раздал <w>алфавитный</w> список всех стран Европы."
                            }
                        }
                    ],
                    "synonyms": [
                        "alphabetic"
                    ],
                    "common_phrases": [
                        "alphabetical order",
                        "alphabetical list",
                        "alphabetical sequence"
                    ],
                    "target_lang_definitions": {
                        "ru": "Расположенный в традиционном порядке букв алфавита."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "алфавитный",
                                "target_lang_sense_clarification": "о порядке расположения"
                            },
                            {
                                "target_lang_word": "в алфавитном порядке",
                                "target_lang_sense_clarification": "устойчивое выражение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "90e40b58-ced6-328b-999a-3a698f4f4673",
                    "sense_definition": "Relating to, consisting of, or expressed by the letters of an alphabet.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "linguistics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scribe used an <w>alphabetical</w> script to record the ancient laws of the city.",
                            "target_lang_translations": {
                                "ru": "Писец использовал <w>алфавитную</w> письменность для записи древних законов города."
                            }
                        },
                        {
                            "text": "Early writing systems evolved from pictograms into <w>alphabetical</w> characters over many centuries.",
                            "target_lang_translations": {
                                "ru": "Ранние системы письма эволюционировали от пиктограмм к <w>буквенным</w> знакам на протяжении многих веков."
                            }
                        }
                    ],
                    "synonyms": [
                        "alphabetic"
                    ],
                    "common_phrases": [
                        "alphabetical characters",
                        "alphabetical writing",
                        "alphabetical symbols"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к буквам алфавита, состоящий из них или выраженный ими."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "алфавитный",
                                "target_lang_sense_clarification": "относящийся к системе письма"
                            },
                            {
                                "target_lang_word": "буквенный",
                                "target_lang_sense_clarification": "состоящий из букв"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4d9f50c9-97e9-39d5-bd92-3c2a1cf13cda",
                    "sense_definition": "Following the exact letter of a text; literal.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "interpretation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The critic argued against an <w>alphabetical</w> servility to the original manuscript's errors.",
                            "target_lang_translations": {
                                "ru": "Критик выступал против <w>буквального</w> следования ошибкам оригинальной рукописи."
                            }
                        },
                        {
                            "text": "He insisted on an <w>alphabetical</w> interpretation of the law, ignoring its underlying spirit.",
                            "target_lang_translations": {
                                "ru": "Он настаивал на <w>буквальном</w> толковании закона, игнорируя его основной дух."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used in modern English to mean literal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Следующий точному тексту; буквальный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "буквальный",
                                "target_lang_sense_clarification": "строго по тексту"
                            },
                            {
                                "target_lang_word": "дословный",
                                "target_lang_sense_clarification": "точно повторяющий оригинал"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1ef16c06-9579-37c2-ad0f-d567b0b4fd6b",
                    "sense_definition": "A type of crossword or jigsaw puzzle where the answers are placed according to their first letters.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "games",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The Sunday newspaper usually includes two <w>alphabeticals</w> for advanced puzzle solvers.",
                            "target_lang_translations": {
                                "ru": "В воскресной газете обычно печатают два <w>алфавитных кроссворда</w> для опытных любителей головоломок."
                            }
                        },
                        {
                            "text": "I spent the entire afternoon trying to complete a difficult <w>alphabetical</w> in the magazine.",
                            "target_lang_translations": {
                                "ru": "Я провел весь день, пытаясь разгадать сложный <w>алфавитный кроссворд</w> в журнале."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "primarily used in British puzzle contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Тип кроссворда или головоломки, где ответы располагаются в соответствии с их первыми буквами."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "алфавитный кроссворд",
                                "target_lang_sense_clarification": "вид головоломки"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}