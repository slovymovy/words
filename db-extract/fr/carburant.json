                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "4b753805-8a43-4bed-bde0-c612b31802c3",
                        "entry_id": "42b6651b-e8df-324c-beaa-2883160ad344",
                        "tags": [
                            "plural"
                        ],
