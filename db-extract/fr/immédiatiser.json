                "senses": [
                    {
                        "sense_id": "8e2bdafb-34e1-3cb6-b8ce-d1be81a85dda",
                        "entry_id": "97462014-15ae-36f1-92d1-ffd418a2753f",
                        "glosses": [
                            "Donner un caractère immédiat à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b49ffc4-0a82-4347-b101-46c122942e6d",
                                "sense_id": "8e2bdafb-34e1-3cb6-b8ce-d1be81a85dda",
                                "text": "Pour Daniel Stern, le socialisme n’est qu’une « tentative pour matérialiser et immédiatiser… la vie future et le paradis spirituel des chrétiens."
                            },
                            {
                                "example_id": "7e0d9129-ac05-40d4-8681-726c19a2b3ac",
                                "sense_id": "8e2bdafb-34e1-3cb6-b8ce-d1be81a85dda",
                                "text": "Alors que sa représentation persuade chacun d’avoir métaphoriquement transposé son être dans son avoir, la vie ne s’accomplit que par le mouvement inverse qui consiste à immédiatiser tout son avoir dans son être."
                            }
                        ]
                    }
