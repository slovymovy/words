                                    },
                                    {
                                        "sense_id": "5e4499b4-4e0b-35cc-a80c-9d718b12068f",
                                        "entry_id": "3a230439-2a4d-3f09-8926-6c2fbbdb316c",
                                        "glosses": [
                                            "Breakfast cereal."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8fa9e875-89a2-4ee8-9518-db08de2453ad",
                                                "sense_id": "5e4499b4-4e0b-35cc-a80c-9d718b12068f",
                                                "text": "Would you like some cereal?"
                                            },
                                            {
                                                "example_id": "3a72ef31-61ba-4684-b55e-3c4fe8fc5a99",
                                                "sense_id": "5e4499b4-4e0b-35cc-a80c-9d718b12068f",
                                                "text": "Which cereal would you like for breakfast?"
                                            },
                                            {
                                                "example_id": "937a7c96-1008-406d-b424-bdabe83b7d48",
                                                "sense_id": "5e4499b4-4e0b-35cc-a80c-9d718b12068f",
                                                "text": "a bowl of cereal"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "cereal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cd888954-782c-38a7-8bf6-50c6d31e659e",
                                        "entry_id": "48afef69-7fda-3203-808d-a9e90f888091",
                                        "glosses": [
                                            "Of or relating to cereal."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b850e9dc-287b-426b-8d72-c4ba5f46c101",
                                                "sense_id": "cd888954-782c-38a7-8bf6-50c6d31e659e",
                                                "text": "Wheat .. is, of all the cereal seeds, the best adapted to the making of bread."
                                            },
                                            {
                                                "example_id": "5ab7054c-d559-45de-8244-ff2ba58a4656",
                                                "sense_id": "cd888954-782c-38a7-8bf6-50c6d31e659e",
                                                "text": "Millet, the smallest of all the cereal seeds cultivated for food, grows on arid soils, where rice and maize cannot be successfully cultivated, […]"
                                            },
                                            {
                                                "example_id": "2f31752f-c0b3-43c7-b21a-5249d6f595e2",
                                                "sense_id": "cd888954-782c-38a7-8bf6-50c6d31e659e",
                                                "text": "The river flows on, washing the base of the sandstone fossiliferous bank at Preston-bridge,—lightening up the rich valley of Preston-haugh,—lending beauty to the open demesnes of Broomhouse, and to the sylvan and cereal grounds of Blanerne; […]"
                                            },
                                            {
                                                "example_id": "84d0de8b-e008-4e3d-a99e-fca5b6948cb1",
                                                "sense_id": "cd888954-782c-38a7-8bf6-50c6d31e659e",
                                                "text": "The species printed in small capitals are Corn-producing or Cereal Grasses, called Cereals, from Ceres, the Roman goddess of Corn."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
