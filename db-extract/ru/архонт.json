                "senses": [
                    {
                        "sense_id": "0590d03b-3f97-3718-b016-1caa83707935",
                        "entry_id": "8c482c18-5466-3bc1-aa87-cf47520c4d90",
                        "glosses": [
                            "истор. высшее должностное лицо в древнегреческих полисах"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69f70831-0ee5-4a58-99d1-792f7f5a62ba",
                                "sense_id": "0590d03b-3f97-3718-b016-1caa83707935",
                                "text": "Он сказал Моисею: «я бог Авраама, Исаака и Иакова», и имя бога не открылось им (т. е. имя неизреченного бога — архонта огдоады)."
                            }
                        ]
                    },
                    {
                        "sense_id": "4fbdfc02-497d-3b50-b616-075a90b1f8f7",
                        "entry_id": "8c482c18-5466-3bc1-aa87-cf47520c4d90",
                        "glosses": [
                            "истор. титул в Византийской империи, соответствующий князю"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "1277d03b-7408-31b4-a71c-4e104af2b3af",
                        "entry_id": "8c482c18-5466-3bc1-aa87-cf47520c4d90",
                        "glosses": [
                            "истор. церковный титул, присваиваемый мирянам за особые заслуги Константинопольским патриархом в период Османского владычества"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c9813f16-5fe6-40b2-b19a-0ee161c9a250",
                        "source_entry_id": "8c482c18-5466-3bc1-aa87-cf47520c4d90",
                        "target_lang_word": "archon",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "archon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8d9aa516-f382-38cb-b8a4-b99a0502fe4a",
                                        "entry_id": "0ef8029c-a0db-36f3-b487-c80d20c7f2ef",
                                        "glosses": [
                                            "A chief magistrate of ancient Athens."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7715cb47-2cf9-4045-a01c-a2579072bcb7",
                                                "sense_id": "8d9aa516-f382-38cb-b8a4-b99a0502fe4a",
                                                "text": "Hated by the archons of Athens for his fearless condemnation of municipal graft, he was hypocritically arraigned on a charge of corrupting Athenian youth."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "52054929-26c3-3de7-93ae-12778b417ed4",
                                        "entry_id": "0ef8029c-a0db-36f3-b487-c80d20c7f2ef",
                                        "glosses": [
                                            "A person who claims the right to rule, or to exercise power or sovereign authority over other human beings."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0c963728-5d3f-3f15-9c6a-a7c666aa0064",
                                        "entry_id": "0ef8029c-a0db-36f3-b487-c80d20c7f2ef",
                                        "glosses": [
                                            "A ruler, head of state or other leader."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3179e5e9-4fcd-4952-9cdd-fd58671cb3ae",
                                                "sense_id": "0c963728-5d3f-3f15-9c6a-a7c666aa0064",
                                                "text": "But neither the midwife’s lore nor the caudlectures saved him from the archons of Sinn Fein and their noggin of hemlock."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a503eddb-7435-3eaa-8267-72f741b4dff2",
                                        "entry_id": "0ef8029c-a0db-36f3-b487-c80d20c7f2ef",
                                        "glosses": [
                                            "A supernatural ruler of the cosmos."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c75c6116-343a-4bbb-b0f3-f921a089e72e",
                                                "sense_id": "a503eddb-7435-3eaa-8267-72f741b4dff2",
                                                "text": "Their claim to totality is like the cry of the archon Ialdabaoth that he was the Lord of the Universe and that there was nothing beyond him."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
