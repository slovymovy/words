                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "56dad42d-7df1-3145-8f4c-cfe125cb44dc",
                        "entry_id": "e90e2664-b4bb-3d80-826d-1bb393ed1cfa",
                        "glosses": [
                            "Avec âpreté, d'une manière âpre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96c5a596-9064-4310-9599-90b06249fe22",
                                "sense_id": "56dad42d-7df1-3145-8f4c-cfe125cb44dc",
                                "text": "Il avait assez écouté son père pour savoir que celui qui cherche aussi âprement l’absolu ne le trouve que dans la sensation."
                            },
                            {
                                "example_id": "82b010cf-610d-4e51-aaae-591f4a6e5026",
                                "sense_id": "56dad42d-7df1-3145-8f4c-cfe125cb44dc",
                                "text": "Le froid commence bien âprement."
                            },
                            {
                                "example_id": "09405a59-46eb-49ae-a917-fcb20f5dcba4",
                                "sense_id": "56dad42d-7df1-3145-8f4c-cfe125cb44dc",
                                "text": "Il se porte âprement, trop âprement à tout ce qu’il fait."
                            },
                            {
                                "example_id": "39af67c4-8e8e-4bf8-b6ed-5eb382919ddc",
                                "sense_id": "56dad42d-7df1-3145-8f4c-cfe125cb44dc",
                                "text": "Il l’a réprimandé âprement."
                            },
                            {
                                "example_id": "5f34b1da-378e-486d-b41e-526dbe305b61",
                                "sense_id": "56dad42d-7df1-3145-8f4c-cfe125cb44dc",
                                "text": "Un chien qui se jette âprement sur la viande."
                            }
                        ]
                    }
                ],
