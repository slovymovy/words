                "senses": [
                    {
                        "sense_id": "e0eff861-6008-30f0-8a24-2854925eda75",
                        "entry_id": "215e1787-a43f-3ed5-9c8c-97097a9e9e4a",
                        "glosses": [
                            "род закрытого спереди узкого стола, устроенного вдоль стен магазина и имеющего у стен проход для продавцов"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8fa99557-12de-4533-9e7c-a499cfefb800",
                                "sense_id": "e0eff861-6008-30f0-8a24-2854925eda75",
                                "text": "Продавец развернул на прилавке материю."
                            }
                        ]
                    },
                    {
                        "sense_id": "8d083322-e25d-3d32-9199-adbc173acb35",
                        "entry_id": "215e1787-a43f-3ed5-9c8c-97097a9e9e4a",
                        "glosses": [
                            "рег. широкая лавка, скамейка, прикреплённая к стене"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5e11e613-7b72-4678-ad4d-3930a4ea04c6",
                        "source_entry_id": "215e1787-a43f-3ed5-9c8c-97097a9e9e4a",
                        "target_lang_word": "Ladentisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ladentisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ff61fd42-b66a-3609-b70b-d8e07a90a0bb",
                                        "entry_id": "6e800a1b-ed18-37ce-9cfe-dab0100719ff",
                                        "glosses": [
                                            "Verkaufstisch in einem Geschäft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b35e542-65ad-4357-9fd9-3ce451a29552",
                                                "sense_id": "ff61fd42-b66a-3609-b70b-d8e07a90a0bb",
                                                "text": "„Im allgemeinen sind Leuchtkörper für vorwiegend direktes Licht zweckmäßig, weil hauptsächlich der Ladentisch und der Hackklotz gut beleuchtet werden müssen.“"
                                            },
                                            {
                                                "example_id": "b41204f2-ba44-4376-86de-5cda14e526bf",
                                                "sense_id": "ff61fd42-b66a-3609-b70b-d8e07a90a0bb",
                                                "text": "„Hinterm Tresen stand ein dicker Mann, die Fäuste auf den Ladentisch gestemmt.“"
                                            },
                                            {
                                                "example_id": "7b02cf03-289f-40a5-9b69-ce637c00465d",
                                                "sense_id": "ff61fd42-b66a-3609-b70b-d8e07a90a0bb",
                                                "text": "„Wir schließen auf und stehen erwartungsvoll hinter dem Ladentisch.“"
                                            },
                                            {
                                                "example_id": "d80e7bf6-7fa5-4c61-b6db-d9b582453956",
                                                "sense_id": "ff61fd42-b66a-3609-b70b-d8e07a90a0bb",
                                                "text": "„Der Ladentisch war zwei Meter in der Länge aus drei Brettern zusammengenagelt, die auf zwei Fässern auflagen.“"
                                            },
                                            {
                                                "example_id": "7afce588-ffda-48e5-a5ff-18feab62a6ba",
                                                "sense_id": "ff61fd42-b66a-3609-b70b-d8e07a90a0bb",
                                                "text": "„Chigurh pflückte sein Wechselgeld vom Ladentisch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5c950775-45be-4cc9-8619-01cade47f598",
                        "source_entry_id": "215e1787-a43f-3ed5-9c8c-97097a9e9e4a",
                        "target_lang_word": "comptoir",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "comptoir",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f21a6650-aa71-3580-bb23-41ea18016e5d",
                                        "entry_id": "017a312c-0706-32c5-b54d-ee43ee5d5e2e",
                                        "glosses": [
                                            "Sorte de bureau ou de table longue et étroite sur laquelle le marchand comptait autrefois l’argent et où, maintenant, le vendeur étale la marchandise."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fbdbf062-cc00-4415-8d3b-1288465f0542",
                                                "sense_id": "f21a6650-aa71-3580-bb23-41ea18016e5d",
                                                "text": "Autour d’une table, un groupe d’hommes étaient rassemblés, et une femme de trente à trente-cinq ans s’accoudait sur le comptoir."
                                            },
                                            {
                                                "example_id": "60e3dc30-eb4c-4240-8035-13a2819fc415",
                                                "sense_id": "f21a6650-aa71-3580-bb23-41ea18016e5d",
                                                "text": "Un couple d’amoureux s'était arrêté devant un comptoir de pizzas à emporter et se roulait une galoche sous la pluie fine."
                                            },
                                            {
                                                "example_id": "763a9db8-77a5-420b-8f1a-6f308cc87dc7",
                                                "sense_id": "f21a6650-aa71-3580-bb23-41ea18016e5d",
                                                "text": "Puis, les allées et venues des moineaux au rayon des pâtes, en face de sa caisse, retiennent son attention. Les piafs se faufilent sous les comptoirs et les plus culottés s'attaquent aux paquets de cellophane dans les rayons."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e7703147-9d3a-3582-bc5a-c21b48be81ce",
                                        "entry_id": "017a312c-0706-32c5-b54d-ee43ee5d5e2e",
                                        "glosses": [
                                            "Dans un café ou un bar, meuble haut sur lequel sont servies les boissons."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04b1c3cb-0464-4a98-867e-e2046029f3da",
                                                "sense_id": "e7703147-9d3a-3582-bc5a-c21b48be81ce",
                                                "text": "Or le bar était vide. Léon, à son comptoir dormassait, en chandail, tandis que sa chienne, près de lui, sur une chaise, veillait."
                                            },
                                            {
                                                "example_id": "c06ea1ac-9d5a-48ee-abb1-e2d3d2d5255b",
                                                "sense_id": "e7703147-9d3a-3582-bc5a-c21b48be81ce",
                                                "text": "On ne fait plus d'enfants, chez nous, sauf dans les coins pouilleux, dans les milieux de misère, certains samedis de paye, après stations devant les comptoirs des bistrots."
                                            },
                                            {
                                                "example_id": "b3d3dce3-af8e-4dff-85d7-c3a7fbd25ebb",
                                                "sense_id": "e7703147-9d3a-3582-bc5a-c21b48be81ce",
                                                "text": "Les ivrognes, maintenant accoudés au comptoir, braillaient une chanson dont ils n'avaient retenu que quelques paroles."
                                            },
                                            {
                                                "example_id": "c87034ba-ee58-4e9d-8cd3-f08352b58512",
                                                "sense_id": "e7703147-9d3a-3582-bc5a-c21b48be81ce",
                                                "text": "Il y avait peut-être en tout six tables de marbre poisseux, l’étain du comptoir très haut avait des dessins repoussés sur le bord, derrière lui fleurissaient des bouteilles de toutes les couleurs, et la fille qui s’y tenait était si jeune qu’elle semblait jouer à servir les clients."
                                            },
                                            {
                                                "example_id": "7e757a94-dd27-46f2-a85e-ef2612d05be5",
                                                "sense_id": "e7703147-9d3a-3582-bc5a-c21b48be81ce",
                                                "text": "Je commande un pastis, et je promène mon œil dans la salle. Rien que de très ordinaire : au bout du comptoir, un client quelconque joue au 421 avec une brune au décolleté vertigineux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2ffad86e-fa9c-3af9-ad58-563482ada9c4",
                                        "entry_id": "017a312c-0706-32c5-b54d-ee43ee5d5e2e",
                                        "glosses": [
                                            "Lieu, bureau où travaillent les commis, où se font et se reçoivent les paiements, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d092bb08-a0f7-40a8-9a2b-5a714f497a0a",
                                                "sense_id": "2ffad86e-fa9c-3af9-ad58-563482ada9c4",
                                                "text": "Comptoir d’escompte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1f0176eb-10c3-3881-bf35-fecebe5a42c8",
                                        "entry_id": "017a312c-0706-32c5-b54d-ee43ee5d5e2e",
                                        "glosses": [
                                            "Bureau général de commerce d’une nation en pays étranger."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6801ee47-5dd8-4ff2-8c08-bc4429294d26",
                                                "sense_id": "1f0176eb-10c3-3881-bf35-fecebe5a42c8",
                                                "text": "La plupart des passagers sont des marchands danois qui vont visiter leurs comptoirs d’Islande ou leurs pêcheries des îles Féroë."
                                            },
                                            {
                                                "example_id": "6ddb3704-e0b0-4e0c-9e44-aefa6cc65f70",
                                                "sense_id": "1f0176eb-10c3-3881-bf35-fecebe5a42c8",
                                                "text": "Les maisons anglaises et allemandes installées au Chili ne sont le plus souvent que des comptoirs de puissantes maisons métropolitaines […]"
                                            },
                                            {
                                                "example_id": "328ab3a3-bd2d-4042-9b6a-b9aa604f2f24",
                                                "sense_id": "1f0176eb-10c3-3881-bf35-fecebe5a42c8",
                                                "text": "Grâce à la compagnie, Lorient se développe et entretient des relations privilégiées avec les comptoirs, particulièrement celui de Pondichéry que le sultan du Bijapur vient de céder à la compagnie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c38f9673-a4f2-31e7-8be0-1815a3a7bf63",
                                        "entry_id": "017a312c-0706-32c5-b54d-ee43ee5d5e2e",
                                        "glosses": [
                                            "Foire commerciale."
                                        ],
                                        "tags": [
                                            "Suisse"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a0a426cf-0914-471c-b142-c247e9e5503b",
                                                "sense_id": "c38f9673-a4f2-31e7-8be0-1815a3a7bf63",
                                                "text": "FOIRES : en avril : foire suisse d'échantillons à Bâle; en juin : expositions internationales des industries d'arts graphiques à … en septembre : comptoir suisse à Lausanne; en octobre : foire suisse agricole et laitière à Saint-Gall,…."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e13673b9-5aed-3a3f-ae83-730c96869030",
                                        "entry_id": "017a312c-0706-32c5-b54d-ee43ee5d5e2e",
                                        "glosses": [
                                            "Plan de travail dans une cuisine."
                                        ],
                                        "tags": [
                                            "Québec"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6c0a0218-40b9-4352-9637-12b93824b00e",
                                                "sense_id": "e13673b9-5aed-3a3f-ae83-730c96869030",
                                                "text": "Liste des petits travaux très rentables : … Cuisine : Nouvelle porte, nouveau comptoir, évier moderne."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
