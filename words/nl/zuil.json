    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "63466def-2fe8-374c-b644-8c1962983950",
                    "sense_definition": "Een vrijstaand, verticaal en meestal rond bouwkundig onderdeel dat dient als ondersteuning of versiering.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "architectuur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De oude tempel wordt ondersteund door prachtige marmeren <w>zuilen</w>.",
                            "target_lang_translations": {
                                "en": "The ancient temple is supported by beautiful marble <w>columns</w>."
                            }
                        },
                        {
                            "text": "In het midden van de zaal staat een <w>zuil</w> van natuursteen.",
                            "target_lang_translations": {
                                "en": "In the middle of the hall stands a <w>pillar</w> made of natural stone."
                            }
                        }
                    ],
                    "synonyms": [
                        "pilaar",
                        "kolom",
                        "pijler",
                        "baluster"
                    ],
                    "common_phrases": [
                        "marmeren zuil",
                        "zuilen van de tempel"
                    ],
                    "target_lang_definitions": {
                        "en": "A free-standing, vertical, and usually round architectural component that serves as support or decoration."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "column",
                                "target_lang_sense_clarification": "architectural support or decoration"
                            },
                            {
                                "target_lang_word": "pillar",
                                "target_lang_sense_clarification": "upright structure for support"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "092a76cd-4e7e-3982-9aaa-a56c5df50395",
                    "sense_definition": "Een maatschappelijke groepering op basis van een bepaalde levensbeschouwing of politieke overtuiging.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sociologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De katholieke <w>zuil</w> had vroeger een eigen krant en een eigen omroep.",
                            "target_lang_translations": {
                                "en": "The Catholic <w>pillar</w> used to have its own newspaper and its own broadcaster."
                            }
                        },
                        {
                            "text": "In de twintigste eeuw was de Nederlandse samenleving verdeeld in verschillende <w>zuilen</w>.",
                            "target_lang_translations": {
                                "en": "In the twentieth century, Dutch society was divided into different <w>pillars</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "maatschappelijke zuil",
                        "katholieke zuil",
                        "protestantse zuil"
                    ],
                    "target_lang_definitions": {
                        "en": "A social group based on a specific worldview or political conviction, particularly in the context of Dutch pillarization."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "pillar",
                                "target_lang_sense_clarification": "social or ideological group"
                            },
                            {
                                "target_lang_word": "segment",
                                "target_lang_sense_clarification": "of a divided society"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}