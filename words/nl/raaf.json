                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "vogel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Niet elke vogel uit dit geslacht is een gewone <w>raaf</w>, er bestaan vele soorten.",
                            "target_lang_translations": {
                                "en": "Not every bird in this genus is a common <w>raven</w>; many species exist."
                            }
                        },
                        {
                            "text": "De bioloog onderzoekt het gedrag van een exotische <w>raaf</w> in bergachtige gebieden.",
                            "target_lang_translations": {
                                "en": "The biologist is studying the behavior of an exotic <w>raven</w> in mountainous regions."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "name for various other large corvid species of the genus Corvus"
                    },
                    "translations": {
                        "en": [
                            {
