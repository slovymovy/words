                            {
                                "example_id": "d34ad556-df6e-4de4-82e2-78b828ec3cff",
                                "sense_id": "989e8d24-2300-3960-b0ad-4eda4de09f5b",
                                "text": "Zakonnice trochę się boją surowej przeoryszy."
                            },
                            {
                                "example_id": "41e315cd-e7ea-4880-aba5-ddf81f6a77d6",
                                "sense_id": "989e8d24-2300-3960-b0ad-4eda4de09f5b",
