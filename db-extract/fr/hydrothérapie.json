        "fr-extract.jsonl": [
            {
                "entry_id": "2507466c-808a-324a-af8a-4c4f91cdd74b",
                "word": "hydrothérapie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "63746aa5-3d88-44a3-99e9-e613705db9c7",
                        "entry_id": "2507466c-808a-324a-af8a-4c4f91cdd74b",
                        "tags": [
                            "plural"
                        ],
                        "form": "hydrothérapies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e25f024a-ed13-3c75-8f8b-15283837726c",
                        "entry_id": "2507466c-808a-324a-af8a-4c4f91cdd74b",
                        "glosses": [
                            "Traitement des maladies par l’usage externe de l’eau froide ou chaude ou par la gymnastique aquatique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "82e59672-5f59-4919-8dbb-93d7d75713d1",
                                "sense_id": "e25f024a-ed13-3c75-8f8b-15283837726c",
                                "text": "— … C’était chez elle une habitude. En sortant de table, elle est allée prendre son bain, afin d’être plus tôt prête à partir… Vois-tu, elle se traitait par l’hydrothérapie ; il y a une source, chez eux, et elle s’y baignait régulièrement chaque jour. À peine entrée dans l’eau, elle a eu une attaque d’apoplexie."
                            },
                            {
                                "example_id": "af0cca78-0e98-4b2a-9635-5af889659243",
                                "sense_id": "e25f024a-ed13-3c75-8f8b-15283837726c",
                                "text": "À Bordeaux, elle sortait tous les deux jours pendant trois heures, sous prétexte d’aller faire de l’hydrothérapie."
                            },
                            {
                                "example_id": "3487a75e-468b-4895-bfa0-b36ebca2634f",
                                "sense_id": "e25f024a-ed13-3c75-8f8b-15283837726c",
                                "text": "Le commissaire.— Madame, au plaisir de vous revoir. Conseillez à votre mari le bromure, la marche et l’hydrothérapie."
                            },
                            {
                                "example_id": "801259bb-d670-420f-98c2-30f59d978737",
                                "sense_id": "e25f024a-ed13-3c75-8f8b-15283837726c",
                                "text": "Ayant su que je me destinais à la médecine et que je fréquentais chez le docteur Charcot, il [Guy de Maupassant] m’entreprit un certain soir sur l’hydrothérapie, qui lui tenait fort au cœur et lui paraissait destinée à remplacer tout autre remède. Il avait entendu parler d’un certain jet glacé sur la nuque, en usage, je crois, à Divonne, auquel ne résistait aucune névralgie oculaire."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "09d6da01-9d28-43db-ac3e-aaa0466ae7a5",
                        "source_entry_id": "2507466c-808a-324a-af8a-4c4f91cdd74b",
                        "source_sense_id": "e25f024a-ed13-3c75-8f8b-15283837726c",
                        "target_lang_word": "Wasserkur",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wasserkur",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "667d6edf-73c7-3854-af48-4e3aff9ea7f4",
                                        "entry_id": "8b4e7fd7-703a-39f0-9c71-7c44cb44f524",
                                        "glosses": [
                                            "die systematische Anwendung von Wasser zu Heilzwecken und zur Abhärtung des Körpers"
                                        ],
                                        "tags": [
                                            "Gesundheit"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d851c90d-cea0-40e9-9b37-1f0667ddcdd5",
                                                "sense_id": "667d6edf-73c7-3854-af48-4e3aff9ea7f4",
                                                "text": "Manche Beschwerden lassen sich schon mit einer Wasserkur beheben."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a961769e-399c-4186-bbea-da3e64443885",
                        "source_entry_id": "2507466c-808a-324a-af8a-4c4f91cdd74b",
                        "source_sense_id": "e25f024a-ed13-3c75-8f8b-15283837726c",
                        "target_lang_word": "Wasserbehandlung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wasserbehandlung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ad83c580-50e4-3733-80b0-159ef00f5f26",
                                        "entry_id": "b88b8045-fb8e-3b7c-b16d-d3276259ebf2",
                                        "glosses": [
                                            "die systematische Anwendung von Wasser zu Heilzwecken und zur Abhärtung des Körpers"
                                        ],
                                        "tags": [
                                            "Gesundheit"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5568f096-817d-446a-8cba-823f974c0f73",
                                                "sense_id": "ad83c580-50e4-3733-80b0-159ef00f5f26",
                                                "text": "Die Wasserbehandlung ist eine Reiztherapie, die über die Hautnerven auf die Nerven und Blutgefäße einwirkt."
                                            },
                                            {
                                                "example_id": "36d02e70-6372-47d4-a4eb-b665736afe6f",
                                                "sense_id": "ad83c580-50e4-3733-80b0-159ef00f5f26",
                                                "text": "In der Wasserbehandlung unterscheidet man Bäder, Abreibungen mit kaltem und warmem Wasser, Auflagen von Säckchen oder getränkten Tüchern, Umschläge, Übergießungen und Duschen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1887a471-efd9-4807-bddb-61c8110fde89",
                        "source_entry_id": "2507466c-808a-324a-af8a-4c4f91cdd74b",
