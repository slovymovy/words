                "senses": [
                    {
                        "sense_id": "9dc78f29-c184-3b28-a5d6-9aadee8e0570",
                        "entry_id": "acfc2c3a-4d77-3049-a20d-3200bc64543c",
                        "glosses": [
                            "Leiter des Justizministeriums"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c071918-52ab-43af-b08a-06f894cfbcaf",
                                "sense_id": "9dc78f29-c184-3b28-a5d6-9aadee8e0570",
                                "text": "„Gegen den hessischen Justizminister Jürgen Banzer liegt eine Strafanzeige wegen des Besitzes von Kinderpornografie vor.“"
                            },
                            {
                                "example_id": "1b3ec111-69e1-4acc-b212-345b609a1a94",
                                "sense_id": "9dc78f29-c184-3b28-a5d6-9aadee8e0570",
                                "text": "„Trump hetzt gegen Justizminister Jeff Sessions, einen bislang treuen Vasallen und beinharten Konservativen, nur weil der getan hat, was Recht und Gesetz von ihm verlangen: Trump sieht gerade in der Rechtstreue seines Justizministers den Verrat.“"
                            },
                            {
                                "example_id": "6e99e760-cb07-4623-b273-389e7528e0aa",
                                "sense_id": "9dc78f29-c184-3b28-a5d6-9aadee8e0570",
                                "text": "„Demnach beabsichtigte der Justizminister des Sindhs (PPP), Ayaz Soomro, Shahbaz Sharif, den Chief Minister des Punjab, zu einem flüchtigen Häftling zu erklären.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
