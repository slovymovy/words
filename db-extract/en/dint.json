                                "target_senses": [
                                    {
                                        "sense_id": "5b4ed42f-b0bd-3acb-9c93-897140ebb761",
                                        "entry_id": "23c7ae4c-48bb-3942-8744-97645e4be0c4",
                                        "glosses": [
                                            "углубление на твёрдой поверхности, появившееся в результате давления, удара и т. п."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb9c08cf-cf8c-46c0-bd68-cc9c1a3d0054",
                                                "sense_id": "5b4ed42f-b0bd-3acb-9c93-897140ebb761",
