                ],
                "translations": [
                    {
                        "translation_id": "8d1dbbb4-fa5d-49fa-ac2d-2596fe9dfa09",
                        "source_entry_id": "6484dcc9-9193-3e5f-9537-d2e928decbb4",
                        "source_sense_id": "e48333e6-2946-3879-affb-1d26aa64b182",
                        "source_sense_description": "iemand die beroepshalve dingen rondbrengt op de fiets",
                        "target_lang_word": "Fahrradkurier",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fahrradkurier",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "75ce60ad-f057-3153-a156-460f1dfac1f8",
                                        "entry_id": "0e0f59f1-98e6-30a7-b249-bd2ac50641d9",
                                        "glosses": [
                                            "Person, die Sendungen mit dem Fahrrad zum Adressaten bringt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c87a5b8-e122-4be4-ade1-1b926ff3032a",
                                                "sense_id": "75ce60ad-f057-3153-a156-460f1dfac1f8",
                                                "text": "„Ich entkam einem Unfall nur deshalb, weil mich ein Fahrradkurier warnte.“"
                                            },
                                            {
                                                "example_id": "e4bd67fb-0a2c-41d9-85c3-042ac445b0f7",
                                                "sense_id": "75ce60ad-f057-3153-a156-460f1dfac1f8",
                                                "text": "„Mein Magen knurrt. Nach 54 Minuten schließlich überreicht mir der Fahrradkurier Jordi zwar ein warmes, aber leider nicht mehr ganz vollständiges Gericht: Teile der Sauce sind aus dem Aluminiumbehälter herausgeflossen und haben sich in der Papiertragetasche verteilt.“"
                                            },
                                            {
                                                "example_id": "c907b502-2561-4165-8b96-babdb86aa05d",
                                                "sense_id": "75ce60ad-f057-3153-a156-460f1dfac1f8",
                                                "text": "„Ben und ich stolperten auf den Bürgersteig, ich taumelte und wäre um Haaresbreite von einem Fahrradkurier überfahren worden.“"
                                            },
                                            {
                                                "example_id": "30cfdc08-1365-4674-897a-903c19ab39f6",
                                                "sense_id": "75ce60ad-f057-3153-a156-460f1dfac1f8",
                                                "text": "„Ein paar Tage später brachte ihr ein Fahrradkurier einen kleinen Terrier aus Ton mit einem großen Stoffhalsband, an dem ein fröhlich klimperndes Glöckchen hing.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
