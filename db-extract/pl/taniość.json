                                            {
                                                "example_id": "3da56f56-397c-4b51-ab8d-6d5978d81fa7",
                                                "sense_id": "88a858f6-4854-3b55-b7da-c435bfaec1d2",
                                                "text": "這是鎮上最便宜的商店。"
                                            },
                                            {
                                                "example_id": "b0323bd9-47b4-4567-b01b-4c516da45ce5",
                                                "sense_id": "88a858f6-4854-3b55-b7da-c435bfaec1d2",
                                                "text": "这是镇上最便宜的商店。"
                                            },
                                            {
                                                "example_id": "2ae731ea-d0f1-4977-a7f1-2a4ba148cb69",
                                                "sense_id": "88a858f6-4854-3b55-b7da-c435bfaec1d2",
                                                "text": "用便宜的肉就做不出好湯。"
                                            },
                                            {
                                                "example_id": "238f7c71-b9e1-49a4-92da-714808a557db",
                                                "sense_id": "88a858f6-4854-3b55-b7da-c435bfaec1d2",
                                                "text": "用便宜的肉就做不出好汤。"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "便宜",
                                "target_lang_code": "zh",
                                "target_senses": [
                                    {
                                        "sense_id": "8a412a5e-57ab-3209-ba0f-0066138b9f5d",
