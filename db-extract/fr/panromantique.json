                                            {
                                                "example_id": "4ac6bca8-93e0-4601-9c7d-456ea337fa67",
                                                "sense_id": "a755db26-432f-3be2-8f34-5305f8a582a2",
                                                "text": "As Jessica, a twenty-one year old white woman who self-identifies as a bi- or panromantic asexual describes, […]"
                                            },
                                            {
                                                "example_id": "7032aca3-45d4-44da-8454-74c8e7fb2b1a",
                                                "sense_id": "a755db26-432f-3be2-8f34-5305f8a582a2",
                                                "text": "Neth, a 24-year-old from the West Country, describes herself as a \"panromantic asexual\"."
                                            },
                                            {
                                                "example_id": "a63be723-b66c-4c07-8788-c74d3d60ef2e",
                                                "sense_id": "a755db26-432f-3be2-8f34-5305f8a582a2",
                                                "text": "“I feel like it’s really important to say that anyone can be queer,” said Sonja Lund, a sophomore theatre major and panromantic lesbian on panel at the event."
                                            }
                                        ]
                                    }
