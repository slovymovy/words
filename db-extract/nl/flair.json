                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0a415893-0345-31ee-99c9-e3c73d9fea01",
                                        "entry_id": "1fa379a9-6dec-360b-a7cf-ce227ecbe671",
                                        "glosses": [
                                            "To add flair."
                                        ],
