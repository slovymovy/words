        "fr-extract.jsonl": [
            {
                "entry_id": "c59306bd-3b7d-3a1b-b5bf-1e369670d553",
                "word": "positivement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "c1dc9a3d-b98b-3c4b-a176-862c4aaf844f",
                        "entry_id": "c59306bd-3b7d-3a1b-b5bf-1e369670d553",
                        "glosses": [
                            "D’une manière sûre, certaine."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "a0ce75d7-8e36-4358-b8e6-f77e777bbe69",
                                "sense_id": "c1dc9a3d-b98b-3c4b-a176-862c4aaf844f",
                                "text": "Elle rougit positivement et une flamme brilla dans ses grands yeux bleus.\nLa rougeur passa vite et la flamme s'éteignit aussitôt."
                            },
                            {
                                "example_id": "e5247967-eb64-463b-98a1-bf984a9a72f7",
                                "sense_id": "c1dc9a3d-b98b-3c4b-a176-862c4aaf844f",
                                "text": "Mais on devrait se rappeler que pendant un long temps la coïncidence de la rotation de la Lune avec sa révolution sidérale, […], a été considérée comme un fait positivement miraculeux ; et qu’il y avait, même parmi les astronomes, une singulière disposition à attribuer cette merveille à l’agence directe et continue de Dieu, […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "d6744a2b-65cf-3a1d-b7fb-5fe73e22372c",
                        "entry_id": "c59306bd-3b7d-3a1b-b5bf-1e369670d553",
                        "glosses": [
                            "D’une manière précise."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "71adedee-f004-482e-ac84-63c8167c7745",
                                "sense_id": "d6744a2b-65cf-3a1d-b7fb-5fe73e22372c",
                                "text": "Vous voulez éluder un éclaircissement ; Mais il faut me répondre, et positivement."
                            },
                            {
                                "example_id": "0e6efce4-901a-4409-b2c6-1830cae0f406",
                                "sense_id": "d6744a2b-65cf-3a1d-b7fb-5fe73e22372c",
                                "text": "Père Adam soutient toujours que ce brave général qui est à présent ministre de la guerre [le comte de Saint-Germain] a commencé par être jésuite ; il le dit si positivement que j’en doute."
                            }
                        ]
                    },
                    {
                        "sense_id": "7c5992b1-7de5-3466-b4a9-d56f4b3fcd90",
                        "entry_id": "c59306bd-3b7d-3a1b-b5bf-1e369670d553",
                        "glosses": [
                            "Avec une charge d’électricité positive."
                        ],
                        "tags": [
                            "physical"
                        ],
                        "examples": [
                            {
                                "example_id": "f2f79768-97b2-4942-a3b5-860b197303d5",
                                "sense_id": "7c5992b1-7de5-3466-b4a9-d56f4b3fcd90",
                                "text": "[…]; si l'on introduit dans la cavité un corps électrisé bien isolé, l'aiguille dévie dans un sens ou dans l'autre suivant que le corps est électrisé positivement ou négativement et la déviation est indépendante de la position du corps électrisé à l'intérieur de la cavité; […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "0ba4525d-b567-3571-bd06-16148a1506dc",
                        "entry_id": "c59306bd-3b7d-3a1b-b5bf-1e369670d553",
                        "glosses": [
                            "Précisément, exactement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4bc0b95a-a20f-40c9-98dc-53179e61b28d",
                                "sense_id": "0ba4525d-b567-3571-bd06-16148a1506dc",
                                "text": "Voilà positivement ce qu’il m’a dit."
                            },
                            {
                                "example_id": "022f49b6-1d37-42b7-bdf4-70819c2ed24c",
                                "sense_id": "0ba4525d-b567-3571-bd06-16148a1506dc",
                                "text": "Il n’est pas positivement laid si vous voulez, mais il est ridicule : ce monocle, ce toupet, ce sourire !"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "075aa93f-6ebc-4601-a942-d09292b369cf",
                        "source_entry_id": "c59306bd-3b7d-3a1b-b5bf-1e369670d553",
                        "target_lang_word": "constructively",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "constructively",
