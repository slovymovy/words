                        "glosses": [
                            "Éclaireur, tirailleur, soldat qui marche sur le flanc d’une troupe pour la flanquer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4c8383e-3150-42bf-91ef-40efc47fdf06",
                                "sense_id": "15dcb5fd-9f3a-3f9f-99d0-fa3f08c31122",
                                "text": "Le 35ᵉ sans s'arrêter, se borna à poster des flanqueurs sur les hauteurs boisées du côté de l'ennemi, et le général Vinoy fit prendre position à deux batteries près du moulin, à l'ouest de Logny, pour arrêter l'ennemi s'il tentait de déboucher de Chaumont à la suite de la colonne."
                            },
                            {
                                "example_id": "6694b33c-b93f-4a95-a947-6ba66f8b196b",
                                "sense_id": "15dcb5fd-9f3a-3f9f-99d0-fa3f08c31122",
                                "text": "Tout à coup, le flanqueur de droite, main sur le casque, se met à genoux : ennemi en vue."
                            }
                        ]
                    }
