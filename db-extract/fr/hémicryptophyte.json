                    {
                        "sense_id": "baf6b604-7780-3a9a-9ef3-c5f442170675",
                        "entry_id": "8d2dbc4e-3c2d-3cd5-876f-7b72d1dbbeca",
                        "glosses": [
                            "Qualifie une plante vivace dont les parties aériennes (tiges, feuilles, fleurs, fruits) meurent entièrement durant la mauvaise saison et dont les bourgeons persistent durant la mauvaise saison au niveau du sol."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "37f770af-29c3-48a6-8061-b1e6d791f850",
                                "sense_id": "baf6b604-7780-3a9a-9ef3-c5f442170675",
                                "text": "La menthe poivrée est une plante herbacée, vivace, à drageons, hémicryptophyte."
                            },
                            {
                                "example_id": "296ef55e-5f08-4d46-8091-39b71fac7472",
                                "sense_id": "baf6b604-7780-3a9a-9ef3-c5f442170675",
                                "text": "Les Hémicryptophytes appartiennent à de nombreuses espèces. Les Rubus sont appelés à former des Ronciers impénétrables, protecteurs des habitants à enfance frêle, délicate, sans moyens de défenses. Carex pendilla forme des groupes massifs, très robustes localisés le long du ruisselet coulant au Nord-Ouest. Il occupe tout le terrain en fortes touffes bien enracinées."
                            },
                            {
                                "example_id": "5e217f7f-4c89-47f9-849f-4fe16d01136c",
                                "sense_id": "baf6b604-7780-3a9a-9ef3-c5f442170675",
                                "text": "[P]lante vivace de 10-30 cm ; hémicryptophyte stolonifère […]."
                            }
                        ]
                    }
