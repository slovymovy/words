                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "208c218b-ba81-4db2-9fe4-21b57ef7b10f",
                                                "sense_id": "5dd9d71d-8eb4-391f-b076-590fdffa53ce",
                                                "text": "Vou à casa dos parafusos para comprar uma arruela especial."
                                            },
