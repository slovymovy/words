                                "example_id": "fd856efe-6a66-4a72-b89b-68ed38eb2c30",
                                "sense_id": "88b077b1-19ac-37aa-8986-8e93bacb8d2f",
                                "text": "Alors le gonze, il s’éloigne sans avoir entendu, mais y avait une viocque qui passait juste à ce moment…"
                            },
                            {
                                "example_id": "2e140789-f879-4bac-bc27-a00acb254666",
                                "sense_id": "88b077b1-19ac-37aa-8986-8e93bacb8d2f",
                                "text": "Il a plusieurs femmes, dont une viocque qui se traîne depuis longtemps, qui fait plus grand-chose."
                            },
                            {
                                "example_id": "a1997c82-033d-4ca7-8ab3-6c6adc175929",
                                "sense_id": "88b077b1-19ac-37aa-8986-8e93bacb8d2f",
                                "text": "Tu veux pas qu’elle rapplique te filer un coup de louche… avec sa pompe à vélo, ta viocque ?"
                            }
                        ]
                    }
