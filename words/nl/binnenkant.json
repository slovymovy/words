{
    "word_family": [
        "binnen",
        "binnenshuis",
        "binnenwaarts",
        "binnenstad",
        "binnenhof"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c2fa6a2e-3e53-3c69-afa9-316b69d28c7d",
                    "sense_definition": "De zijde die zich in een afgesloten ruimte of object bevindt.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "fysieke_zijde",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>binnenkant</w> van de doos is bekleed met zacht papier.",
                            "target_lang_translations": {
                                "en": "The <w>inside</w> of the box is lined with soft paper."
                            }
                        },
                        {
                            "text": "Je kunt de jas aan de <w>binnenkant</w> dichtmaken met een extra knoop.",
                            "target_lang_translations": {
                                "en": "You can fasten the jacket on the <w>inside</w> with an extra button."
                            }
                        }
                    ],
                    "synonyms": [
                        "binnenzijde"
                    ],
                    "antonyms": [
                        "buitenkant"
                    ],
                    "common_phrases": [
                        "aan de binnenkant",
                        "binnenkant van de doos"
                    ],
                    "target_lang_definitions": {
                        "en": "The side or surface that is located within an enclosed space or object."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "inside",
                                "target_lang_sense_clarification": "the interior part of a container or object"
                            },
                            {
                                "target_lang_word": "interior",
                                "target_lang_sense_clarification": "the inner part of a building or vehicle"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "36627e7e-42f6-3abc-8b98-e4d7e78bf799",
                    "sense_definition": "De zijde die tussen twee zaken in ligt of naar het lichaam toegekeerd is.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "fysieke_zijde",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De voetballer raakte de bal met de <w>binnenkant</w> van zijn voet.",
                            "target_lang_translations": {
                                "en": "The football player hit the ball with the <w>inside</w> of his foot."
                            }
                        },
                        {
                            "text": "Hij waste de <w>binnenkant</w> van zijn dijen na het sporten.",
                            "target_lang_translations": {
                                "en": "He washed the <w>inside</w> of his thighs after exercising."
                            }
                        }
                    ],
                    "synonyms": [
                        "binnenzijde"
                    ],
                    "antonyms": [
                        "buitenkant"
                    ],
                    "common_phrases": [
                        "binnenkant van de voet",
                        "binnenkant van de dijen"
                    ],
                    "target_lang_definitions": {
                        "en": "The side that lies between two things or is turned toward the body."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "inside",
                                "target_lang_sense_clarification": "the part of a limb or body part facing inward"
                            },
                            {
                                "target_lang_word": "inner side",
                                "target_lang_sense_clarification": "the side facing towards the center or body"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d0a6c9ba-0f61-365d-8185-b9aebff1d9f3",
                    "sense_definition": "Het innerlijk of het geestelijke leven van een persoon.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "figuurlijk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Alleen qua uiterlijk leek hij op zichzelf, maar zijn <w>binnenkant</w> was totaal veranderd.",
                            "target_lang_translations": {
                                "en": "Only in appearance did he look like himself, but his <w>inner self</w> had changed completely."
                            }
                        },
                        {
                            "text": "Soms komt de <w>binnenkant</w> van een persoon niet overeen met wat hij laat zien.",
                            "target_lang_translations": {
                                "en": "Sometimes a person's <w>inside</w> does not match what they show on the outside."
                            }
                        }
                    ],
                    "antonyms": [
                        "buitenkant"
                    ],
                    "common_phrases": [
                        "de binnenkant van een persoon"
                    ],
                    "target_lang_definitions": {
                        "en": "The inner self or the spiritual/mental life of a person."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "inside",
                                "target_lang_sense_clarification": "a person's inner feelings or character"
                            },
                            {
                                "target_lang_word": "inner self",
                                "target_lang_sense_clarification": "the psychological or spiritual interior of a person"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}