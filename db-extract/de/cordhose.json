                        "glosses": [
                            "aus Cord bestehende Hose"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "262d2c95-4a36-4d7b-b637-c76fd3f3212d",
                                "sense_id": "dbb30329-0fcd-3871-a360-cb6d31e673c3",
                                "text": "„Er trägt eine rote Cordhose, einen pistazienfarbenen Pullover und dunkelblaue Sneakers.“"
                            },
                            {
                                "example_id": "29023e49-d4b0-46e8-a02b-8026e44c47f1",
                                "sense_id": "dbb30329-0fcd-3871-a360-cb6d31e673c3",
                                "text": "„Ruhig packt sie die Skistiefel, die dicke Cordhose und den Norwegerpulli in zwei Kliniktüten.“"
                            },
                            {
                                "example_id": "2c7b4b19-94a9-479e-ae5c-ee3274335fd6",
                                "sense_id": "dbb30329-0fcd-3871-a360-cb6d31e673c3",
                                "text": "„Alte, abgetragene Hawaiihemden, zerschlissene Cordhosen, ausgelatschte Schuhe waren sein Markenzeichen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
