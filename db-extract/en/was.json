                            "singular"
                        ],
                        "examples": [
                            {
                                "example_id": "19000dc4-39ed-48e8-8f71-9c51d06e51d2",
                                "sense_id": "187f63c4-357d-35cb-a383-cf2ec91d6c48",
                                "text": "You was pleased to cast a favourable eye upon me."
                            },
                            {
                                "example_id": "9ec16e60-5e13-4453-a30a-01f805730a00",
                                "sense_id": "187f63c4-357d-35cb-a383-cf2ec91d6c48",
                                "text": "\"Was you outside the Bank of England, sir?\""
                            }
                        ]
                    },
                    {
                        "sense_id": "57c1c961-1965-3be6-8ef0-5da0ceec6991",
                        "entry_id": "2b94dc81-3200-3110-b1f8-f458891012de",
                        "glosses": [
                            "first-person plural simple past indicative of be; were."
                        ],
