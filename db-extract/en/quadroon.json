                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "5554228f-ad25-3bbb-b9f8-d5d15dc03190",
                        "entry_id": "ed63741a-ab60-3e3a-bb76-6617de4c1003",
                        "glosses": [
                            "Of or related to quadroons."
                        ],
                        "tags": [
                            "dated",
                            "historical",
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "6404bf9c-9a6e-46e8-a22a-4e0af6f66d8e",
                                "sense_id": "5554228f-ad25-3bbb-b9f8-d5d15dc03190",
                                "text": "Before them, with her face upraised,\nIn timid attitude,\nLike one half curious, half amazed,\nA Quadroon maiden stood."
                            },
                            {
                                "example_id": "4dc1c757-316d-49a6-8267-c583663f0351",
                                "sense_id": "5554228f-ad25-3bbb-b9f8-d5d15dc03190",
                                "text": "\"What need you getting drunk, then, and cutting up, Prue?\" said a spruce quadroon chambermaid, dangling, as she spoke, a pair of coral ear-drops."
                            },
                            {
                                "example_id": "abc0da47-f825-4e90-af39-59fa7add3bc1",
                                "sense_id": "5554228f-ad25-3bbb-b9f8-d5d15dc03190",
                                "text": "The quadroon girl is sold at the auction-stand, the drunkard nods by the bar-room stove, […]"
                            }
                        ]
                    }
                ],
