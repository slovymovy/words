                                "target_lang_sense_clarification": "estable, seguro"
                            },
                            {
                                "target_lang_word": "imperturbable",
                                "target_lang_sense_clarification": "que no muestra alteración o duda"
                            }
                        ]
                    }
                }
            ]
        },
