                            {
                                "target_word": "pâteux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "47ec246d-d33c-3ebe-b3c3-f6b3cde84f8e",
                                        "entry_id": "fbfca513-2f0d-3c71-8b1f-39f59e61b94b",
                                        "glosses": [
                                            "Qui a la consistance ou l'aspect de la pâte."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4cceff0d-b959-3b7d-a9f6-d9140ac18961",
                                        "entry_id": "fbfca513-2f0d-3c71-8b1f-39f59e61b94b",
                                        "glosses": [
                                            "Se dit du pain qui n’est pas assez levé ou pas assez cuit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cbcf2dc8-7746-4934-b218-e720358b7e61",
                                                "sense_id": "4cceff0d-b959-3b7d-a9f6-d9140ac18961",
                                                "text": "Ce pain est pâteux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3083fb0c-eff3-384e-b1e9-91da78d6053a",
                                        "entry_id": "fbfca513-2f0d-3c71-8b1f-39f59e61b94b",
                                        "glosses": [
                                            "Qualifie les choses qui font dans la bouche le même effet que ferait de la pâte."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cdf8a06d-d271-44e7-afbc-5efc88408c42",
                                                "sense_id": "3083fb0c-eff3-384e-b1e9-91da78d6053a",
                                                "text": "Ce fruit a la chair pâteuse."
                                            },
                                            {
                                                "example_id": "f878ad9d-9c85-44cb-b5c0-6eeff790e8e4",
                                                "sense_id": "3083fb0c-eff3-384e-b1e9-91da78d6053a",
                                                "text": "Un bonbon pâteux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bf647817-3368-3cce-ad2e-799c0ff5ba1f",
                                        "entry_id": "fbfca513-2f0d-3c71-8b1f-39f59e61b94b",
                                        "glosses": [
                                            "Qualifie un liquide dans lequel des matières en suspens empêchent son entière liquidité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba0242a1-4ad7-4b4e-99e7-45e4ec1e32c1",
                                                "sense_id": "bf647817-3368-3cce-ad2e-799c0ff5ba1f",
                                                "text": "Chaque outil apporte une autre nature de formes et une autre modulation de la couleur. Et il n’y a pas que les outils, il y a aussi la matière, plus ou moins fluide ou pâteuse, et le subjectile, plus ou moins lisse ou rugueux."
                                            },
                                            {
                                                "example_id": "7a169c19-d366-4742-9c0a-0c2175066269",
                                                "sense_id": "bf647817-3368-3cce-ad2e-799c0ff5ba1f",
                                                "text": "Cette liqueur est pâteuse, ce vin est pâteux.."
                                            },
                                            {
                                                "example_id": "8441b26d-e4f5-486d-a96d-ed69d20dc2fe",
                                                "sense_id": "bf647817-3368-3cce-ad2e-799c0ff5ba1f",
                                                "text": "Encre pâteuse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d02a1de-1cc3-3049-a12e-6240780b7971",
                                        "entry_id": "fbfca513-2f0d-3c71-8b1f-39f59e61b94b",
                                        "glosses": [
                                            "Qualifie la bouche, ou ce qui en a trait, lorsqu’elle semble empâtée d’une salive épaisse."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "59226321-cd25-408d-af9f-26cd550c46c0",
                                                "sense_id": "1d02a1de-1cc3-3049-a12e-6240780b7971",
                                                "text": "Avoir la langue pâteuse."
                                            },
                                            {
                                                "example_id": "6d4f3f9a-a68e-4799-86bb-5bd60e6bbd6f",
                                                "sense_id": "1d02a1de-1cc3-3049-a12e-6240780b7971",
                                                "text": "Ma tête me faisait mal et ma bouche était pâteuse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "af84a262-1165-3096-a40c-afeb2e6a075a",
                                        "entry_id": "fbfca513-2f0d-3c71-8b1f-39f59e61b94b",
                                        "glosses": [
                                            "Qualifie un style mou, lourd, filandreux."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3dd54041-aa62-355c-9588-8fb03b9482d1",
