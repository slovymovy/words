                "senses": [
                    {
                        "sense_id": "c2c70ad8-624d-3028-84cb-649895bad397",
                        "entry_id": "dbdc6239-737f-39f4-a30e-e804bb270285",
                        "glosses": [
                            "jüdisches Mädchen, das sich am Sabbat nach deren 12. oder 13. Geburtstag auf die religiösen Vorschriften des Judentums verpflichtet"
                        ],
                        "tags": [
                            "jüdische Religion"
                        ],
                        "examples": [
                            {
                                "example_id": "73dfba78-935a-4e2e-9370-97b7c2828ae6",
                                "sense_id": "c2c70ad8-624d-3028-84cb-649895bad397",
                                "text": "Im Alter von 12 Jahren wurde ich eine Bat-Mizwa."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "28af3665-9b0e-3c66-9839-8ab408ea9999",
                        "entry_id": "dbdc6239-737f-39f4-a30e-e804bb270285",
                        "glosses": [
                            "Feier zur Einführung der »Bat-Mizwas^([1])« in die jüdische Glaubensgemeinschaft, bei der sie ihre Religionsmündigkeit erwerben"
                        ],
                        "tags": [
                            "jüdische Religion"
                        ],
                        "examples": [
                            {
                                "example_id": "f5905903-82ae-4fc3-a348-fb1eea48cd28",
                                "sense_id": "28af3665-9b0e-3c66-9839-8ab408ea9999",
                                "text": "„Meine Eltern stritten sich sogar über meine Bat-Mizwa.“"
                            },
                            {
                                "example_id": "3f3cb4c3-cdca-4d06-bc60-3eda4fbe18af",
                                "sense_id": "28af3665-9b0e-3c66-9839-8ab408ea9999",
                                "text": "„In liberalen Gemeinden gibt es allerdings eine Art Mädcheneinsegnung, die als Bat-Mizwa (Tochter der Pflicht) bezeichnet wird. In Deutschland ist eine derartige Zeremonie erstmals im Jahr 1817, und zwar in Berlin, belegt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
