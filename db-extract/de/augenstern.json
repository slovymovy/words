                "senses": [
                    {
                        "sense_id": "f64109d1-3faf-3e3e-aa69-c61615c8a73f",
                        "entry_id": "65ea8544-48fa-3936-a67e-5105b04395b7",
                        "glosses": [
                            "für „Liebling“"
                        ],
                        "tags": [
                            "familiär"
                        ],
                        "examples": [
                            {
                                "example_id": "c1416535-e86a-4d0c-9353-3aedda2e94b8",
                                "sense_id": "f64109d1-3faf-3e3e-aa69-c61615c8a73f",
                                "text": "„Schatz, du bist mein Augenstern. Dich hab' ich zum Fressen gern."
                            },
                            {
                                "example_id": "1c5549f6-d80b-44d5-8bb0-fdf191c2b42e",
                                "sense_id": "f64109d1-3faf-3e3e-aa69-c61615c8a73f",
                                "text": "„Michael war ihr Augenstern.“"
                            },
                            {
                                "example_id": "a9cd1140-a5dc-4640-8e5a-2bac36c9dd5b",
                                "sense_id": "f64109d1-3faf-3e3e-aa69-c61615c8a73f",
                                "text": "„Ihr Sohn aber, ihr Augenstern und Nesthäkchen, der lang ersehnte Sohn, von dem Gísli geträumt hatte und mit dem er zum Fischen hinausrudern wollte, der hatte quer vor der Haustür gelegen, als Skúli im Morgengrauen zum Plumpsklo wollte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "43608b95-e2ee-3059-b2da-b1a57db1d8a4",
