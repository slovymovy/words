                        "examples": [
                            {
                                "example_id": "15374ee4-185d-402b-ac32-a1f4fa027e08",
                                "sense_id": "061df0f8-92a5-3eb4-a733-18a54ffd41b2",
                                "text": "„Vor wenigen Jahren starb im Hospitale zu Paris eine Lumpensammlerin, welche auch in ihrem Elende Spuren von ihrer ehemaligen Schönheit behalten hatte und unter ihren Gewerbsgenossen allgemein die Gräfin hieß.“ (1866)"
                            },
                            {
                                "example_id": "1dd83188-1df8-410f-b99f-deb0341734fd",
                                "sense_id": "061df0f8-92a5-3eb4-a733-18a54ffd41b2",
                                "text": "„Dieser lebhafte kleine Wallach von undefinierbarer Rasse zog den Wagen einer Lumpensammlerin durch die Straßen der Stadt.“"
                            }
                        ],
