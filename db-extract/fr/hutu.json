                        "glosses": [
                            "Membre du peuple des Hutus."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a01940dd-1545-4acd-95bc-e21ddcbdac2a",
                                "sense_id": "d4495a87-7849-366a-ac92-cb316f6f6527",
                                "text": "Établi en Norvège depuis une dizaine d’années, Sadi Bugingo, un Hutu de 47 ans, a été reconnu coupable d’avoir contribué au massacre de plus d’un millier de Tutsi lors de trois attaques différentes."
                            }
                        ]
                    }
                ],
