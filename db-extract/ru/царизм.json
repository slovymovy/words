                    {
                        "translation_id": "50bbdd23-43c1-4a93-99e7-bfe93c5cadfd",
                        "source_entry_id": "efb89de6-a2cf-3f25-96e0-692dacb8ea1e",
                        "source_sense_id": "bfe2aa35-5b1a-308b-a446-9270a0aa915b",
                        "target_lang_word": "Zarismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zarismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f7e90a49-27de-3ee4-b59d-a571b0fff86a",
                                        "entry_id": "e4b1d863-56ea-3b61-ad0e-b57877f375c2",
                                        "glosses": [
                                            "Gesamtheit der Herrschafts-/Lebensverhältnisse im Zarenreich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "caf9d50b-2f59-4fe1-947a-9b0ee0b93727",
                                                "sense_id": "f7e90a49-27de-3ee4-b59d-a571b0fff86a",
                                                "text": "„Der Grund für seine Haltung war unbedingte Gegnerschaft zum verhassten Zarismus, in dem die SPD reinen Despotismus sah.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d14eeea3-09b0-4d38-b332-8adaa9393e57",
                        "source_entry_id": "efb89de6-a2cf-3f25-96e0-692dacb8ea1e",
                        "source_sense_id": "bfe2aa35-5b1a-308b-a446-9270a0aa915b",
                        "target_lang_word": "tzarisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tzarisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d7af480d-e70a-33a6-b320-a68784237470",
                                        "entry_id": "9772e061-c05b-35fa-9f33-a360c633e154",
                                        "glosses": [
                                            "Autre orthographe de tsarisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a2ebcb9-715f-49e2-aa7e-162867baa099",
                                                "sense_id": "d7af480d-e70a-33a6-b320-a68784237470",
                                                "text": "Le Tzarisme attaquera parce qu’il ne craint pas la guerre.\nLe Tzarisme renversera parce que sa force est grande.\nLe Tzarisme vaincra parce que sa puissance est une.\nLe Tzarisme réunira parce que les hommes courent aux gros rassemblements comme les eaux à la rivière.\nLe Tzarisme sera le bien-venu parmi ses nouveaux peuples parce qu’il s’en éprendra comme d’une nouvelle maîtresse. Cela est prouvé par Alexandre de Russie, par César et Napoléon.\nLe Tzarisme sera célébré dans l’histoire parce qu’il accomplira sa tâche.\nLe Tzarisme sera chanté par les civilisés parce qu’il les méprisera."
                                            },
                                            {
                                                "example_id": "d7a4dc72-a28f-48ed-b1f4-4052897aea7a",
                                                "sense_id": "d7af480d-e70a-33a6-b320-a68784237470",
                                                "text": "Bientôt sonnera l’heure de la défaite du tzarisme sous les secousses du soulèvement finlandais et de la révolution russe […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cb8f9efb-86e4-41c9-ba63-b9851f80e2ff",
                        "source_entry_id": "efb89de6-a2cf-3f25-96e0-692dacb8ea1e",
                        "source_sense_id": "bfe2aa35-5b1a-308b-a446-9270a0aa915b",
                        "target_lang_word": "tsarisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tsarisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f2341430-79fd-37bc-bed5-3fc5a5ec018c",
                                        "entry_id": "dbc77d4e-5a56-3504-8e51-e836d328e939",
                                        "glosses": [
                                            "Régime autocratique des tsars."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "388d1a32-3574-49f6-8434-5667190fb31e",
                                                "sense_id": "f2341430-79fd-37bc-bed5-3fc5a5ec018c",
                                                "text": "Il leur fallut, jusqu’au jour où le tsarisme s’effondra, renoncer à abriter les épargnants français contre les averses périodiques de papier peint, venant de Pétersbourg, échangé sur notre sol contre de beaux deniers sonnants et trébuchants."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "59e182a2-de86-3e29-aad5-525085ad804d",
                                        "entry_id": "dbc77d4e-5a56-3504-8e51-e836d328e939",
                                        "glosses": [
                                            "Période de l’histoire russe pendant laquelle les tsars régnèrent."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
