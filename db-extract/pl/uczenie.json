                                        "glosses": [
                                            "In an educated and knowledgeable manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61483042-4356-400f-8081-088ea122d3fd",
                                                "sense_id": "98ec6d5a-8b45-3674-8a66-ecfa278ba9a5",
                                                "text": "The professor spoke learnedly for an hour about his abstruse scholarship; but he couldn't string two words together to speak to the pretty woman."
                                            }
