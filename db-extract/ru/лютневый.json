                                        "entry_id": "2ca220ac-7812-32ef-8d09-87393d35a911",
                                        "glosses": [
                                            "Thick sticky clay or cement used to close up a hole or gap, especially to make something air-tight."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd3d1915-8e5e-48f6-bf73-fe1f63912313",
                                                "sense_id": "725654e0-21aa-310d-9a67-1fae93f7ba73",
                                                "text": "He employed a mixture of flour and white of egg spread upon a linen cloth to cement cracked glass vessels, and used other lutes for similar purposes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d255f373-0413-3ed5-9418-d0f7ce4eaeb6",
                                        "entry_id": "2ca220ac-7812-32ef-8d09-87393d35a911",
                                        "glosses": [
                                            "A packing ring, as of rubber, for fruit jars, etc."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8a373c88-eca3-396e-997b-d8a8e3daefca",
                                        "entry_id": "2ca220ac-7812-32ef-8d09-87393d35a911",
                                        "glosses": [
                                            "A straight-edged piece of wood for striking off superfluous clay from earth."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
