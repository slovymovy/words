                                "example_id": "ca0a78be-5d47-47e7-b777-611d1241e7a1",
                                "sense_id": "616569d3-4a64-3079-89a8-b643fa3c401d",
                                "text": "Dès qu’il tombe la veste, c’est un déconneur de premier ordre."
                            },
                            {
                                "example_id": "f4263f70-d480-4c18-a666-f17ba204d43a",
                                "sense_id": "616569d3-4a64-3079-89a8-b643fa3c401d",
                                "text": "L’humoriste n’est pas un joyeux drille. Pas un gai luron. Pas un déconneur."
                            },
                            {
                                "example_id": "36d68ede-3a51-4b05-b1a9-ed8c36d238b3",
                                "sense_id": "616569d3-4a64-3079-89a8-b643fa3c401d",
                                "text": "C'était un déconneur impénitent qui ne faisait pas spécialement rire. Anthony connaissait comme ça des tas de mecs qui plaisantaient plus par politesse qu'autre chose."
                            }
                        ]
                    }
