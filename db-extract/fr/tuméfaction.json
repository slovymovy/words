        "fr-extract.jsonl": [
            {
                "entry_id": "c8f79cd0-9fce-3506-abe4-0332a2d0d44c",
                "word": "tuméfaction",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "abf2d7f0-a656-41f5-84a7-1b36d1279564",
                        "entry_id": "c8f79cd0-9fce-3506-abe4-0332a2d0d44c",
                        "tags": [
                            "plural"
                        ],
                        "form": "tuméfactions"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "33778421-1d74-3c20-b489-d6daea1761a9",
                        "entry_id": "c8f79cd0-9fce-3506-abe4-0332a2d0d44c",
                        "glosses": [
                            "Enflure ; gonflement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ae0cd91-cdb7-4d56-b1f8-94a8cf2880cf",
                                "sense_id": "33778421-1d74-3c20-b489-d6daea1761a9",
                                "text": "Dans le ſecond tems, on obſerve dans les aînes de petits gonﬂemens douloureux qui viennent de la tuméfaction des glandes inguinales.",
                                "translation": "Dans le second temps, on observe dans les aines de petits gonflements douloureux qui viennent de la tuméfaction des glandes inguinales."
                            },
                            {
                                "example_id": "ef098662-a802-4ea1-b1c8-d4cfe2605da9",
                                "sense_id": "33778421-1d74-3c20-b489-d6daea1761a9",
                                "text": "Quoi qu’il en soit, le diagnostic n’est généralement pas difficile : les principaux éléments sont fournis par l’existence d’une dacryocystite antérieure et la présence dans l’angle interne d’une tuméfaction que le malade a pu, pendant un certain temps, faire disparaitre par la pression."
                            },
                            {
                                "example_id": "d8623481-b16f-42a1-8653-d44586236559",
                                "sense_id": "33778421-1d74-3c20-b489-d6daea1761a9",
                                "text": "Les mycocécidies sont, le plus souvent, des tuméfactions diffuses, épaississant et déformant l'organe attaqué (par exemple la « hernie » du Chou […]). Quelques mycocécidies sont, cependant, de véritables galles, c'est-à-dire des excroissances nettement délimitées et de forme plus ou moins définies."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b9da582f-b3e8-41d5-a641-915c883f7049",
                        "source_entry_id": "c8f79cd0-9fce-3506-abe4-0332a2d0d44c",
                        "source_sense_id": "33778421-1d74-3c20-b489-d6daea1761a9",
                        "target_lang_word": "tumefaction",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tumefaction",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3d9ec06d-5022-35c6-a886-2f8f548295c0",
                                        "entry_id": "fd439c64-0bd1-38be-88d9-d1bf553284af",
                                        "glosses": [
                                            "The process or result of tumefying, swelling, or rising into a tumour."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2d08b94b-8d87-4df2-b0af-dc57776db67d",
                                                "sense_id": "3d9ec06d-5022-35c6-a886-2f8f548295c0",
                                                "text": "Tumefaction, (lat[in]) a cauſing to ſwell."
                                            },
                                            {
                                                "example_id": "1e04c47a-4c8e-4d19-af5d-98b228a2f7ea",
                                                "sense_id": "3d9ec06d-5022-35c6-a886-2f8f548295c0",
                                                "text": "1731, John Arbuthnot, An Essay concerning the Nature of Aliments, London: J. Tonson, Chapter 6, Prop. 2, p. 152,\nThe common Signs and Effects of weak Fibres are Paleness, Smoothness, Coldness of the Skin, Colour of the Blood not Florid (for what maketh that is a strong action of the Solids) a weak Pulse, Tumefactions in the whole Body or Parts, Stagnation of Humours […]"
                                            },
                                            {
                                                "example_id": "c93e24f0-25ee-446a-8abd-295d5513f651",
                                                "sense_id": "3d9ec06d-5022-35c6-a886-2f8f548295c0",
                                                "text": "The livid tumefaction spread over the leg, with blisters here and there, whence there oozed a black liquid. Matters were taking a serious turn."
                                            },
                                            {
                                                "example_id": "15e63b38-afdc-470f-aac2-2c9011795f8d",
                                                "sense_id": "3d9ec06d-5022-35c6-a886-2f8f548295c0",
                                                "text": "Uttering these words, she squeezed my hand, which was now entwined with hers a scant millimeter from the straining tumefaction in my lap […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ac6a159b-5b21-4b82-8e01-27ecf693815b",
                        "source_entry_id": "c8f79cd0-9fce-3506-abe4-0332a2d0d44c",
                        "source_sense_id": "33778421-1d74-3c20-b489-d6daea1761a9",
