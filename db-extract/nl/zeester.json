                                    },
                                    {
                                        "sense_id": "fdcfe9c9-8403-3614-a4cd-55f3eeeace35",
                                        "entry_id": "da7a2df9-c8c0-3bd8-8eb0-d458168af90c",
                                        "glosses": [
                                            "Any many-armed or tentacled sea invertebrate, whether cnidarian, echinoderm, or cephalopod."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2d06ede4-3f5c-4454-b643-6a8d9fc16faf",
                                                "sense_id": "fdcfe9c9-8403-3614-a4cd-55f3eeeace35",
                                                "text": "But the largest of the star-fish kind is that sea monster called kruken, kraken or krabben. [...] As this enormous sea-animal in all probability may be reckoned of the polype, or of the star-fish, kind, it seems that the parts which are seen rising at its pleasure, and are called arms, are properly the tentacula, or feeding instruments, called horns as well as arms."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ac43489c-ac24-3215-aaac-903454b0aa38",
                                        "entry_id": "da7a2df9-c8c0-3bd8-8eb0-d458168af90c",
                                        "glosses": [
                                            "A woman (or, less commonly, a gay man) who reluctantly takes part in sexual intercourse, and lies on the back while spreading the limbs."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "44e3fa34-03be-3847-9da1-ff44bf862395",
                                        "entry_id": "da7a2df9-c8c0-3bd8-8eb0-d458168af90c",
                                        "glosses": [
                                            "The anus."
                                        ],
