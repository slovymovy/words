                                        "glosses": [
                                            "am Körper getragene Halterung zur Aufbewahrung von Munition"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f63ceedc-f405-4e67-9efe-13d3b24178b8",
