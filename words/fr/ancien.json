                {
                    "sense_id": "c0ed3e49-1fc3-37fe-9411-ef74017416cf",
                    "sense_definition": "Titre de dignité donné aux membres les plus âgés et les plus respectés d'un peuple ou d'une assemblée, chargés des fonctions importantes.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les <w>anciens</w> du peuple se sont réunis pour décider."
                        },
                        {
                            "text": "Le conseil des <w>anciens</w> a pris la décision."
                        }
                    ],
                    "common_phrases": [
                        "conseil des anciens",
                        "anciens du peuple"
                    ]
                },
                {
                    "sense_id": "f1bc57ca-cbf7-34fa-9570-2d975f1f6804",
                    "sense_definition": "Personne attachée à la tradition, opposée aux modernes.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans cette querelle, il se range du côté des <w>anciens</w>."
                        },
                        {
                            "text": "La querelle des <w>anciens</w> et des modernes a divisé les écrivains."
                        }
                    ],
                    "antonyms": [
