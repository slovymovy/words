                            {
                                "example_id": "47cefb43-8d64-4363-a443-333af1cc9bfd",
                                "sense_id": "b0d0310d-a014-3494-bf3b-12f2e411b785",
                                "text": "Wystarczy tu przypomnieć słynny termin Przybosia – turpizm, którym określał literaturę kierującą uwagę na rzeczy brzydkie, kalekie, nieskładne, brutalne; ów swoisty mizerabilizm pragnął sprostać prawdzie życia konkretnego"
                            },
                            {
                                "example_id": "a7c28780-2873-4e7e-8818-d7891e09f4ea",
                                "sense_id": "b0d0310d-a014-3494-bf3b-12f2e411b785",
                                "text": "Żałosny mizerabilizm na jednym biegunie, a zwodnicza świetność na drugim nie wystarczy Bryllowi na dłuższą metę jako pokarm wyobraźni poetyckiej"
                            }
                        ],
