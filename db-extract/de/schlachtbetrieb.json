                        "entry_id": "b7d74a8d-79f0-3faf-854f-a9e31a205b84",
                        "glosses": [
                            "Aktivität des Tötens von Tieren, um daraus Nahrungsmittel herzustellen, Unternehmen, das dies als Aufgabe hat"
                        ],
                        "tags": [
                            "auch"
                        ],
                        "examples": [
