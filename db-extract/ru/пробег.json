                    },
                    {
                        "sense_id": "32a45606-2576-38a1-bd43-799487f38b6a",
                        "entry_id": "0a8e9e8d-081b-3ad4-b716-9576a4891d2a",
                        "glosses": [
                            "спорт. состязание в беге или езде"
                        ],
                        "tags": [],
