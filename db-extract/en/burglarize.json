                    {
                        "sense_id": "59f183ea-7ced-3750-b373-766f0f9ba4ab",
                        "entry_id": "10aeb716-6d2a-3cf9-8868-6a9883fbc2e0",
                        "glosses": [
                            "in ein Haus, eine Wohnung, ein Geschäft gewaltsam eindringen, um zu stehlen: einbrechen"
                        ],
                        "tags": [
                            "intransitive",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "4b2fa235-be38-46a1-b02f-cd5f410ff7e8",
                                "sense_id": "59f183ea-7ced-3750-b373-766f0f9ba4ab",
                                "text": "Our neighbors were burglarized twice last week.",
                                "translation": "Bei unseren Nachbarn wurde letzte Woche zweimal eingebrochen."
                            },
                            {
                                "example_id": "96e58f16-7222-4c82-8fc1-8423fdeb4122",
                                "sense_id": "59f183ea-7ced-3750-b373-766f0f9ba4ab",
                                "text": "Three men burglarized a liquor store in Georgetown early Sunday morning.",
                                "translation": "Drei Männer brachen am frühen Samstagmorgen in einen Spirituosenladen in Georgetown ein."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a4671559-81fd-4a17-855a-c3b13d0e6c5c",
                        "source_entry_id": "10aeb716-6d2a-3cf9-8868-6a9883fbc2e0",
                        "source_sense_id": "59f183ea-7ced-3750-b373-766f0f9ba4ab",
                        "source_sense_description": "in ein Gebäude gewaltsam eindringen, um zu stehlen",
                        "target_lang_word": "einbrechen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "einbrechen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f52c84ac-d2ef-310a-9108-c7052c2c0aa0",
                                        "entry_id": "0c31734d-4411-399f-94a2-8dd22c20ca25",
                                        "glosses": [
                                            "in ein Gebäude (beziehungsweise bei jemandem) eindringen ohne dazu befugt zu sein, oft mit Gewalt und Zerstörung von etwas verbunden"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "82a538d7-a8cc-48b9-8cfb-574bd3725a03",
                                                "sense_id": "f52c84ac-d2ef-310a-9108-c7052c2c0aa0",
                                                "text": "Die Diebe sind durch die Terrassentür eingebrochen."
                                            },
                                            {
                                                "example_id": "fc7b4b3b-60f1-4251-ad64-514e4f40b041",
                                                "sense_id": "f52c84ac-d2ef-310a-9108-c7052c2c0aa0",
                                                "text": "Man hat bei uns eingebrochen."
                                            },
                                            {
                                                "example_id": "59c66098-5bb3-4e06-a8bf-4e48cbc133ed",
                                                "sense_id": "f52c84ac-d2ef-310a-9108-c7052c2c0aa0",
                                                "text": "„Bei den Wahlen 2013 ist sie allerdings eingebrochen und hat nur einen Sitz im Parlament errungen.“"
                                            },
                                            {
                                                "example_id": "a829654c-f5d2-4892-9097-295b73005c52",
                                                "sense_id": "f52c84ac-d2ef-310a-9108-c7052c2c0aa0",
                                                "text": "Er ist in das Haus eingebrochen."
                                            },
                                            {
                                                "example_id": "d53a95a5-41f0-4ebd-9f0f-9616b00c9097",
                                                "sense_id": "f52c84ac-d2ef-310a-9108-c7052c2c0aa0",
                                                "text": "Die Diebe brachen durch die Terrassentür ein."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d6c67910-190b-3536-ab22-1f02a9ee3309",
                                        "entry_id": "0c31734d-4411-399f-94a2-8dd22c20ca25",
                                        "glosses": [
                                            "den Halt auf einer Oberfläche verlieren und sich dann durch diese Oberfläche nach unten bewegen"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a51a6567-dce2-4cb7-b327-76165dd92321",
                                                "sense_id": "d6c67910-190b-3536-ab22-1f02a9ee3309",
                                                "text": "Er brach in das Eis ein."
                                            },
                                            {
                                                "example_id": "c770066e-f514-4ff8-bc69-fc6dd0eaa658",
                                                "sense_id": "d6c67910-190b-3536-ab22-1f02a9ee3309",
                                                "text": "Der Dachdecker ist auf dem Glasdach eingebrochen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "7246fcc4-1dba-39d7-8a2b-a553b6bd35c8",
                                        "entry_id": "0c31734d-4411-399f-94a2-8dd22c20ca25",
                                        "glosses": [
                                            "einem Reittier beibringen, geritten zu werden"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06712cae-d64d-436c-bec1-fee4e2c5fb58",
                                                "sense_id": "7246fcc4-1dba-39d7-8a2b-a553b6bd35c8",
                                                "text": "Der Hengst wurde als Zweijähriger eingebrochen."
                                            },
                                            {
                                                "example_id": "cad23d4d-e5c0-4806-95b6-7b26981de991",
                                                "sense_id": "7246fcc4-1dba-39d7-8a2b-a553b6bd35c8",
                                                "text": "Als alter Hase hat er schon viele Pferde eingebrochen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "bbe61900-caf2-3187-b339-76a4b13ee3cf",
                                        "entry_id": "0c31734d-4411-399f-94a2-8dd22c20ca25",
                                        "glosses": [
                                            "kaputtgehen und nach unten oder innen durchbrechen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b98a53a8-01b5-44c8-ae9b-29650705fe6e",
                                                "sense_id": "bbe61900-caf2-3187-b339-76a4b13ee3cf",
                                                "text": "Bei der Scheune ist das Dach eingebrochen."
                                            },
                                            {
                                                "example_id": "374f9bae-b1bd-4eef-ba3d-6493c7a9cbf5",
                                                "sense_id": "bbe61900-caf2-3187-b339-76a4b13ee3cf",
                                                "text": "Der Schlag war so brutal, dass die Schädeldecke einbrach."
                                            },
                                            {
                                                "example_id": "a34e965e-6275-45f7-a11e-b7d9edf6c0c6",
                                                "sense_id": "bbe61900-caf2-3187-b339-76a4b13ee3cf",
                                                "text": "Die Rettungskräfte hatten die Mauer eingebrochen, um an die Verschütteten zu gelangen."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "64f2971d-0eed-3613-bb3f-9814f420d8e7",
                                        "entry_id": "0c31734d-4411-399f-94a2-8dd22c20ca25",
                                        "glosses": [
                                            "von der Leistung her stark abbauen"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "41846274-c993-440c-b63a-414dee650f3d",
                                                "sense_id": "64f2971d-0eed-3613-bb3f-9814f420d8e7",
                                                "text": "Die Läuferin brach auf den letzten Metern ein."
                                            },
                                            {
                                                "example_id": "b44d7bef-4d02-4022-96b4-fec2a3c89077",
                                                "sense_id": "64f2971d-0eed-3613-bb3f-9814f420d8e7",
                                                "text": "Im letzten Jahr sind seine Leistungen dann völlig eingebrochen."
                                            },
                                            {
                                                "example_id": "eb681e70-45a1-4205-a7d7-55ab25b40622",
                                                "sense_id": "64f2971d-0eed-3613-bb3f-9814f420d8e7",
                                                "text": "Der Aktienkurs brach im Laufe der Woche ein."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "98f0659d-57c2-358b-8f97-9f98847f10ee",
                                        "entry_id": "0c31734d-4411-399f-94a2-8dd22c20ca25",
                                        "glosses": [
                                            "beginnen eines besonderen Zeitabschnittes ohne Licht, ohne Wärme"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "248e7920-92e6-4ce2-99d8-80817109a452",
                                                "sense_id": "98f0659d-57c2-358b-8f97-9f98847f10ee",
                                                "text": "Wenn die Dunkelheit einbricht, bist du aber zuhause."
                                            },
                                            {
                                                "example_id": "f73f0ea1-f7ae-4758-a0bd-147b1c8fabc0",
                                                "sense_id": "98f0659d-57c2-358b-8f97-9f98847f10ee",
                                                "text": "Letztes Jahr war der Winter zu Weihnachten schon eingebrochen."
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    }
                                ]
                            }
                        ]
                    }
