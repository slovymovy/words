                        "glosses": [
                            "Se crever mutuellement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a578a92-0365-4090-92e1-021bdcb18f64",
                                "sense_id": "b4d930cf-2d64-3c9d-a9c2-b8469951ae74",
                                "text": "Qu'est-ce qu'ils foutent les policiers dans les zones ? Qu'ils les laissent s'entrecrever !"
                            },
                            {
                                "example_id": "24209d0c-d4b2-49c9-ab78-633e2f9fbdcb",
                                "sense_id": "b4d930cf-2d64-3c9d-a9c2-b8469951ae74",
                                "text": "Faut surtout pas que les kondé se ramènent justement, faut les laisser s'entrecrever"
                            },
                            {
                                "example_id": "ab6e57e2-545a-4833-aec7-f6887ee6db0b",
                                "sense_id": "b4d930cf-2d64-3c9d-a9c2-b8469951ae74",
                                "text": "Il n'y a pas d'autres moyens pour expliquer pourquoi Muhammad, être suprême comme il n'en fut jamais, muni d'une autorité de sous-marin nucléaire, soit infoutu de gérer le bordel généré par la furie de ses bonnes femmes en son logis quand elles se crêpent le chignon, menacent de s'ébouillanter ou cherchent à s'entrecrever les yeux."
                            }
                        ]
                    }
