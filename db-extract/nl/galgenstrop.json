                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "b72276fa-c48a-37d2-bd7b-5e95506bb4a9",
                                        "entry_id": "aacea77c-6fae-387b-9154-786f39fe165a",
                                        "glosses": [
                                            "сложенная кольцом и завязанная часть верёвки, нитки, обычно с возможностью затянуть концы"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f35743d1-6b91-4fc4-8304-11420d32cdcb",
                                                "sense_id": "b72276fa-c48a-37d2-bd7b-5e95506bb4a9",
                                                "text": "Начали, — сказал Быков. Он сунул Жилину моток тонкого троса. Закрепи в шахте, — сказал он. На другом конце троса он сделал петлю и затянул ее вокруг пояса. Затем он повесил себе на шею оба тестера и перекинул ногу через перила"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0332fae6-1eb3-36bc-b001-1768b704e4af",
                                        "entry_id": "aacea77c-6fae-387b-9154-786f39fe165a",
