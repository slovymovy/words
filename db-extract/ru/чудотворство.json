                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e6fda42-7882-400f-8130-b76710b825c7",
                                "sense_id": "99dad751-4f68-3f6a-98da-1ff7d877ab33",
                                "text": "По стране [Ирландии] бродят могущественные колдуны-барды, с которыми соперничают в чудотворстве святые."
                            },
                            {
                                "example_id": "34de3d18-230c-4d7c-b7b0-2d68ca43c7c4",
                                "sense_id": "99dad751-4f68-3f6a-98da-1ff7d877ab33",
                                "text": "Чудотворство — удел великих святых, а церковь состоит в основном из людей грешных."
                            }
                        ]
                    }
