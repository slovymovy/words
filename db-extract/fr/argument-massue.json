                "senses": [
                    {
                        "sense_id": "3679920f-07a3-34f9-a1f9-58b0ce21847b",
                        "entry_id": "7a5f0acc-414f-3e89-b65b-e956d06bd052",
                        "glosses": [
                            "Assertion qui n’attend pas de réponse, et qui vise à clore un débat, au bénéfice de celui qui le profère."
                        ],
                        "tags": [
                            "rhetoric"
                        ],
                        "examples": [
                            {
                                "example_id": "9acb1953-1d59-41b2-b00e-c4143976be27",
                                "sense_id": "3679920f-07a3-34f9-a1f9-58b0ce21847b",
                                "text": "En finaud, il sortait là l’argument-massue, celui qui tirait directement au cœur de ses amis."
                            },
                            {
                                "example_id": "2291a22f-6907-44dc-98e5-28101150539c",
                                "sense_id": "3679920f-07a3-34f9-a1f9-58b0ce21847b",
                                "text": "Il faut donc trouver un argument-massue, un argument capable de semer le doute dans l’âme des ouvriers, d’ébranler leur confiance, d’amener des défections de plus en plus nombreuses, puis des désertions massives."
                            },
                            {
                                "example_id": "f0a7f791-6387-47e1-8a96-0c21baf78064",
                                "sense_id": "3679920f-07a3-34f9-a1f9-58b0ce21847b",
                                "text": "Si l'on est sincère, après l'excitation du combat, il faudra bien avouer que les arguments-massues ressemblent plus à des massues qu'à des arguments. On reviendra alors à de meilleurs sentiments."
                            }
                        ]
                    }
                ],
