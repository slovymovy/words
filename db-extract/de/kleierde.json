                        "examples": [
                            {
                                "example_id": "bc4c9e00-d64f-42dc-94cd-8622364d227f",
                                "sense_id": "29b49fe2-124c-3907-812a-a74f61d84c93",
                                "text": "„Dieses Verfahren bestand darin, daß man tiefe Gräben anlegte, die Kleierde aushob und die unfruchtbare Tonerde wieder in die Gräben warf.“"
                            },
                            {
                                "example_id": "fe32c2bb-0641-4c92-b2a3-b9aefaa1ca71",
                                "sense_id": "29b49fe2-124c-3907-812a-a74f61d84c93",
                                "text": "„Anfang November 1964 begann der Ausbau des Schulplatzes. Die Kleierde wurde von einer Planierraupe abgeschoben, Drainrohre aus Plastik verlegt und der 25x50m große Spielplatz mit einer 40 cm dicken Grandschicht aufgefüllt.“"
                            }
                        ],
