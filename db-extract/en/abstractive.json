                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c022cbf4-572b-47b5-9940-7850123ba68f",
                                                "sense_id": "fd917d18-0155-35df-8108-633165067af9",
                                                "text": "Dat was nogal een abstract betoog."
                                            },
                                            {
                                                "example_id": "c8e401c2-774e-4ba9-88b8-71002fbe7678",
                                                "sense_id": "fd917d18-0155-35df-8108-633165067af9",
                                                "text": "Risico is voor veel klimmers een abstract concept. Bergbeklimmers weten dat er verschrikkelijke dingen kunnen gebeuren maar zeggen altijd “Oh, ik ben heel voorzichtig."
                                            }
                                        ]
                                    },
