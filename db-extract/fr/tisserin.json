                                            {
                                                "example_id": "29ff67aa-44f2-4937-a761-61f4c2370d72",
                                                "sense_id": "4944b9c7-55f1-34d6-93b6-62c959b6fbd9",
                                                "text": "The Silks, varniſh'd Works, Ink, Paper, and in general every thing that comes, both from Nan-king and the other Cities of the Province, which carry on an aſtoniſhing Trade, is much more eſteem'd and dear, than what is brought from other Provinces. In the City Shang-hay only, and the Villages belonging to it, they reckon above 200,000 Weavers of Callico."
                                            }
                                        ]
                                    },
