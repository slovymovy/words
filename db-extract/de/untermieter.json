                                        "entry_id": "8942bed8-dbd0-3efa-9be8-530924cc7c0b",
                                        "glosses": [
                                            "iemand die huurt van een huurder"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac20bb2c-772f-4547-a920-d247b7281205",
                                                "sense_id": "8118219d-7d3f-3c7e-be7c-1a91245d63d7",
                                                "text": "Hij hield van de talrijke vogels, hazen, reeën, vossen en herten die zijn onderhuurders waren."
                                            },
                                            {
                                                "example_id": "2a907a88-3aab-41c1-9bcf-5ff7a12f8937",
                                                "sense_id": "8118219d-7d3f-3c7e-be7c-1a91245d63d7",
                                                "text": "Een ander maakt zich zorgen over de oncontroleerbare onderverhuur van woonruimte aan buitenlanders. Anis B. was onderhuurder van een appartement."
                                            },
                                            {
                                                "example_id": "096116ed-c673-4a8c-a840-af3edfa1bffa",
                                                "sense_id": "8118219d-7d3f-3c7e-be7c-1a91245d63d7",
                                                "text": "Tegelijkertijd zijn er volgens bronnen bij de gemeente aanwijzingen dat een onderhuurder wel degelijk feesten organiseerde in het pand."
                                            }
                                        ]
                                    }
                                ]
                            }
