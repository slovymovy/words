                "senses": [
                    {
                        "sense_id": "afcf141e-7b34-3509-b096-5de6d49af493",
                        "entry_id": "fe68410e-1425-378d-a717-70a3c787d20f",
                        "glosses": [
                            "Production de vaisseaux dans un tissu qui n’en contenait pas, ou augmentation du nombre de ceux qui existaient."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e150a924-ace6-4425-9b96-fde446e8060e",
                                "sense_id": "afcf141e-7b34-3509-b096-5de6d49af493",
                                "text": "La vascularisation sanguine de l’intestin grêle. Cette vascularisation est bien visible lorsqu’on a injecté dans les artères du mésentère, et avant de faire la coupe, de la gélatine colorée."
                            }
                        ]
                    },
                    {
                        "sense_id": "ffcd34f5-bca0-3e1b-8e5c-1a7d2ade8984",
                        "entry_id": "fe68410e-1425-378d-a717-70a3c787d20f",
                        "glosses": [
                            "Densité du réseau vasculaire d’une région anatomique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3221747a-b316-444e-a3d7-f39c533e3404",
                                "sense_id": "ffcd34f5-bca0-3e1b-8e5c-1a7d2ade8984",
                                "text": "Le muscle strié, tissu à métabolisme extrêmement actif, possède une vascularisation très développée."
                            }
                        ]
                    },
                    {
                        "sense_id": "e92194e1-8a56-32e4-88af-ee2358730cbf",
                        "entry_id": "fe68410e-1425-378d-a717-70a3c787d20f",
                        "glosses": [
                            "Présence de tissus spécialisés pour le transport de l’eau, des nutriments et des sucres dans la plante."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf144b5d-19bf-4420-b294-982408dee59f",
                                "sense_id": "e92194e1-8a56-32e4-88af-ee2358730cbf",
                                "text": "La vascularisation a commencé avec les Bryophytes (mousses et hépatiques) qui sont intermédiaires entre les organismes végétaux aquatiques et les plantes terrestres, leur reproduction nécessitant la présence d’eau."
                            }
                        ]
                    }
                ],
