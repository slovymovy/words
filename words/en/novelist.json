                    "sense_definition": "A person who writes novels.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "writer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The famous <w>novelist</w> spent three years writing her latest historical book.",
                            "target_lang_translations": {
                                "ru": "Знаменитая <w>романистка</w> потратила три года на написание своей последней исторической книги."
                            }
                        },
                        {
                            "text": "Many young writers dream of becoming a successful <w>novelist</w> one day.",
                            "target_lang_translations": {
                                "ru": "Многие молодые писатели мечтают однажды стать успешными <w>романистами</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "author",
                        "writer"
                    ],
                    "common_phrases": [
                        "famous novelist",
                        "prolific novelist",
                        "aspiring novelist"
                    ],
                    "target_lang_definitions": {
