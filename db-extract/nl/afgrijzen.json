                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7a6271a3-a5dc-4df0-822f-ee3d44875735",
                                                "sense_id": "69522ae7-40f5-3de2-a8cd-a1e63fd718d4",
                                                "text": "The Royal Navy sent six dreads and four BCs to intercept the German raiding force."
                                            }
