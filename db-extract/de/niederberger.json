                    {
                        "sense_id": "34238dc5-7877-3913-b8e3-23cf05a512ee",
                        "entry_id": "82486984-8d1f-3b31-8128-2a379ee7d2fc",
                        "glosses": [
                            "ein Einwohner oder ein Bewohner eines der Orte oder Teilorte namens Niederberg"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb3ba394-3d97-4101-ac5b-e248620f70d2",
                                "sense_id": "34238dc5-7877-3913-b8e3-23cf05a512ee",
                                "text": "„Mit Stangen („Steiben“) stochern sie im Himmel, die Niederberger Sonnesteiber. Sie versuchen, die Sonne einzufangen. Denn im Schatten der mächtigen Festung Ehrenbreitstein zu leben, damit wollten sich die Niederberger noch nie zufrieden geben – und helfen ein wenig nach, Sonne in ihr Dorf zu bringen. Die „Sonnesteiber“ sind der Kirmesverein des Koblenzer Stadtteils Niederberg.“"
                            },
                            {
                                "example_id": "e4f6a574-2f9c-4011-8c6e-c9e469b8fb76",
                                "sense_id": "34238dc5-7877-3913-b8e3-23cf05a512ee",
                                "text": "„Gegen die JSG Bendorf fanden die Niederberger schnell zu ihrem Spiel und setzten die Bendorfer stark unter Druck."
                            },
                            {
                                "example_id": "2cb1d5d9-1165-4637-9cca-bea3d9f477ba",
                                "sense_id": "34238dc5-7877-3913-b8e3-23cf05a512ee",
                                "text": "„Liebe Niederbergerinnen und Niederberger, die diesjährige Mitgliederversammlung hat auf meinen Vorschlag xyz zum neuen ersten Vorsitzenden gewählt.“"
                            }
                        ],
