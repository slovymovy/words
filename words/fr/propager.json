{
    "word_family": [
        "propagation",
        "propagateur",
        "propagande",
        "propagandiste"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ccad992a-aadb-3d8e-aeae-59cde98de087",
                    "sense_definition": "Diffuser largement, faire connaître ou transmettre quelque chose à un grand nombre d'individus (idées, nouvelles, rumeurs, maladies).",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "diffusion_large",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les réseaux sociaux permettent de <w>propager</w> des nouvelles en quelques secondes seulement."
                        },
                        {
                            "text": "Cette fausse rumeur continue de se <w>propager</w> dans toute la ville malgré nos démentis."
                        }
                    ],
                    "synonyms": [
                        "diffuser",
                        "répandre",
                        "disséminer"
                    ],
                    "antonyms": [
                        "étouffer",
                        "contenir"
                    ],
                    "common_phrases": [
                        "propager une rumeur",
                        "propager une maladie",
                        "propager des idées",
                        "se propager rapidement"
                    ]
                },
                {
                    "sense_id": "ffef83c0-3c21-3bdc-8d29-b99d592bd40b",
                    "sense_definition": "Se diffuser à travers un milieu matériel ou dans le vide, en parlant d'ondes, de son ou de lumière.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physique_ondes",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La lumière peut se <w>propager</w> dans le vide à une vitesse constante."
                        },
                        {
                            "text": "Le son se <w>propage</w> beaucoup plus vite dans l'eau que dans l'air ambiant."
                        }
                    ],
                    "synonyms": [
                        "se diffuser",
                        "rayonner"
                    ],
                    "common_phrases": [
                        "se propager dans l'air",
                        "se propager en ligne droite"
                    ]
                },
                {
                    "sense_id": "e4206d72-0d67-374c-a78a-9ffca5bc4392",
                    "sense_definition": "Multiplier des êtres vivants, en particulier des plantes ou des animaux, par voie de reproduction ou de génération.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "biologie_multiplication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le jardinier cherche à <w>propager</w> cette variété rare de rose par bouturage."
                        },
                        {
                            "text": "Cette espèce d'insecte nuisible continue de se <w>propager</w> dans les forêts de la région."
                        }
                    ],
                    "synonyms": [
                        "multiplier",
                        "reproduire"
                    ],
                    "common_phrases": [
                        "propager des plantes",
                        "propager une espèce"
                    ]
                }
            ]
        }
    ]
}