                ],
                "senses": [
                    {
                        "sense_id": "5884499d-c401-3c88-83d8-0629cbdc29ed",
                        "entry_id": "e9280da1-33f1-34fd-9003-bc8fb438e7c0",
                        "glosses": [
                            "Medusozoa vrijzwemmend, voornamelijk in zee levend ongewerveld dier met een geleiachtig lichaam in de vorm van een klok of paraplu"
                        ],
                        "tags": [
                            "neteldieren"
                        ],
                        "examples": [
                            {
                                "example_id": "3668444f-62f5-4a0e-904f-11caeed4b4b5",
                                "sense_id": "5884499d-c401-3c88-83d8-0629cbdc29ed",
                                "text": "De kwal dankt zijn gif aan een gen dat zijn voorouders honderden miljoenen jaren geleden overnamen van een bacterie."
                            },
                            {
                                "example_id": "8adc40cb-9f83-43c3-b1f8-106eb27342e5",
                                "sense_id": "5884499d-c401-3c88-83d8-0629cbdc29ed",
                                "text": "November, Den 20. hadden wy de hoochte van 36. graden 57. minuten, zagen veel quallen drijven, enen grootte menichte van Seeluysen, een gedierte de Luysen zeer gelijck, vande groote als een kleyne vliege."
                            }
                        ]
                    },
                    {
                        "sense_id": "221bbcec-fce9-357e-adc8-d2c46ab0cf5a",
                        "entry_id": "e9280da1-33f1-34fd-9003-bc8fb438e7c0",
                        "glosses": [
                            "arrogant, vervelend persoon"
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "b50417f7-9322-4a11-9479-2ef099ccd179",
                                "sense_id": "221bbcec-fce9-357e-adc8-d2c46ab0cf5a",
                                "text": "Sommige mensen vinden Louis van Gaal een kwal."
                            },
                            {
                                "example_id": "fc792d3c-5619-4bb3-8d8a-fe20b116cff3",
                                "sense_id": "221bbcec-fce9-357e-adc8-d2c46ab0cf5a",
                                "text": "De schrijver koos als hoofdpersoon van het Boekenweekgeschenk een bescheiden vrouw die literaire avondjes organiseert. „Ze heeft een beetje pech dat ze net Ilja Leonard Pfeijffer treft, een arrogante kwal.”"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1bdaaa6b-6d69-4156-8336-a7a6a4a4bf89",
                        "source_entry_id": "e9280da1-33f1-34fd-9003-bc8fb438e7c0",
                        "source_sense_id": "5884499d-c401-3c88-83d8-0629cbdc29ed",
                        "source_sense_description": "vrijzwemmend, voornamelijk in zee levend ongewerveld dier met een geleiachtig lichaam in de vorm van een klok of paraplu",
                        "target_lang_word": "Qualle",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Qualle",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5f48946e-e70f-39f3-b88f-3ac58b233f43",
                                        "entry_id": "5fec47f5-643f-30f5-b9e0-6ba580944891",
                                        "glosses": [
                                            "Wassertier mit radiär-symmetrischem Körper von gallertig-knorpeliger Konsistenz"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26f0885b-65e5-4672-b1af-7e3a572bd49c",
                                                "sense_id": "5f48946e-e70f-39f3-b88f-3ac58b233f43",
                                                "text": "Der Strand war mit Quallen übersät."
                                            },
                                            {
                                                "example_id": "dba9b5f7-4c9d-4c7c-99bf-1d1564752286",
                                                "sense_id": "5f48946e-e70f-39f3-b88f-3ac58b233f43",
                                                "text": "„Es handelt sich hierbei um Einzeller (Protozoen) wie die Foraminiferen (mit Kalkschale) und die Radiolarien (Skelett aus Kieselsäure), um Coelenteraten wie Medusen und Quallen, um Rädertierchen, Würmer aus der Gruppe der Anneliden und der Chaetognathen sowie zahlreiche Krustentiere, unter den die Copepoden überwiegen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "30b1ce3c-2069-3e66-ae82-9751df88d63b",
                                        "entry_id": "5fec47f5-643f-30f5-b9e0-6ba580944891",
                                        "glosses": [
                                            "ein Lebensstadium von Nesseltieren und Rippenquallen"
                                        ],
                                        "tags": [
                                            "jargon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "94a8e32f-74af-4b79-a041-b5237a8854a8",
                                                "sense_id": "30b1ce3c-2069-3e66-ae82-9751df88d63b",
                                                "text": "„Es handelt sich hierbei um Einzeller (Protozoen) wie die Foraminiferen (mit Kalkschale) und die Radiolarien (Skelett aus Kieselsäure), um Coelenteraten wie Medusen und Quallen, um Rädertierchen, Würmer aus der Gruppe der Anneliden und der Chaetognathen sowie zahlreiche Krustentiere, unter den die Copepoden überwiegen.“"
                                            },
                                            {
                                                "example_id": "9557a414-b77f-440c-b834-5e03ad9397e8",
                                                "sense_id": "30b1ce3c-2069-3e66-ae82-9751df88d63b",
                                                "text": "„Die zwei wichtigsten Formentypen sind Polyp und Qualle, die als unterschiedliche Lebensstadien bei ein und derselben Art auftreten können, also keine systematische Bedeutung haben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "e8808ca2-7b3e-3112-bbea-6cafe1e3fcb0",
                                        "entry_id": "5fec47f5-643f-30f5-b9e0-6ba580944891",
                                        "glosses": [
                                            "charakterloser Mensch"
                                        ],
                                        "tags": [
                                            "Schimpfwort"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "01c79e9c-77e2-45f9-b814-0d27ee4eb017",
                                                "sense_id": "e8808ca2-7b3e-3112-bbea-6cafe1e3fcb0",
                                                "text": "Er ist eine richtige Qualle."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "368c8c68-6a01-4bad-847c-f3e4e5f9fcc5",
