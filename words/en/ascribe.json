{
    "word_family": [
        "ascription",
        "ascriptive"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e3c0d381-c31a-3fb7-8a2a-04bcc7b3b2a4",
                    "sense_definition": "To consider a cause or characteristic as belonging to someone or something.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "attribute",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Experts <w>ascribe</w> the recent economic growth to new government policies."
                        },
                        {
                            "text": "Many people <w>ascribe</w> these problems to poor planning."
                        }
                    ],
                    "synonyms": [
                        "attribute",
                        "impute"
                    ],
                    "common_phrases": [
                        "ascribe to"
                    ]
                },
                {
                    "sense_id": "36ae5315-9f78-3d77-87bb-7161620a91ce",
                    "sense_definition": "To believe that a specific person is the creator or author of a work of art or literature.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "attribute",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Historians <w>ascribe</w> this painting to a student of Leonardo da Vinci."
                        },
                        {
                            "text": "It is difficult to <w>ascribe</w> the anonymous poem to any known author."
                        }
                    ],
                    "synonyms": [
                        "accredit"
                    ],
                    "common_phrases": [
                        "ascribe to"
                    ]
                },
                {
                    "sense_id": "d66b5694-f5b4-3ae2-ace9-178502be68f5",
                    "sense_definition": "To hold a particular belief or support a specific idea.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "believe",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Most scientists <w>ascribe</w> to the theory of evolution."
                        },
                        {
                            "text": "I do not <w>ascribe</w> to the view that money brings happiness."
                        }
                    ],
                    "common_phrases": [
                        "ascribe to"
                    ]
                }
            ]
        }
    ]
}