                "senses": [
                    {
                        "sense_id": "7202f187-f29f-3ab5-8b33-f10dbd0dc549",
                        "entry_id": "580a689c-2ca9-3d38-a528-df783bc7dc31",
                        "glosses": [
                            "Eine oder mehrere Personen, die ein Unternehmen / eine Firma führen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d117ef1-9577-4182-b19c-02735af5876e",
                                "sense_id": "7202f187-f29f-3ab5-8b33-f10dbd0dc549",
                                "text": "Wichtige Punkte sind auch, ob die Geschäftsleitung die branchen- bzw. handelsüblichen Sorgfaltspflichten erfüllt hat."
                            },
                            {
                                "example_id": "f696f266-fca9-438a-a43e-7acb94f1795c",
                                "sense_id": "7202f187-f29f-3ab5-8b33-f10dbd0dc549",
                                "text": "Die Entscheidung, mit welchem Inkassoinstitut zusammengearbeitet wird, wurde von der Geschäftsleitung getroffen."
                            },
                            {
                                "example_id": "39f6dbd1-5ca8-4387-a32d-cebbe8d89dce",
                                "sense_id": "7202f187-f29f-3ab5-8b33-f10dbd0dc549",
                                "text": "[…] Kaiserschnitte sind besser planbar [als natürliche Geburten] und deshalb effizienter. Das ist ein wichtiger Faktor für die Geschäftsleitung eines Krankenhauses, denn sie will vor allem Gewinne machen."
                            },
                            {
                                "example_id": "dbfc5e5f-86dc-4666-8b03-5dfa9975aee4",
                                "sense_id": "7202f187-f29f-3ab5-8b33-f10dbd0dc549",
                                "text": "Jetzt teilte die Oper mit, sie habe sich am Mittwoch […] mit der Vertretung der Bühnenarbeiter und -techniker geeinigt. Die Met gehe nun stark davon aus, auch mit den übrigen Gewerkschaften einen Kompromiss zu finden, wurde von der Geschäftsleitung bekanntgegeben."
                            },
                            {
                                "example_id": "ac61ee09-b141-4803-aa63-6b737b78b95a",
                                "sense_id": "7202f187-f29f-3ab5-8b33-f10dbd0dc549",
                                "text": "Am Tanztheater Wuppertal will die Geschäftsleitung, dass Intendantin Adolphe Binder abtritt."
                            },
                            {
                                "example_id": "ec18471e-f5ff-42ad-a2b2-ec2b73e3cf00",
                                "sense_id": "7202f187-f29f-3ab5-8b33-f10dbd0dc549",
                                "text": "Um Vorgaben der Geschäftsleitung einzuhalten und sich keines Lizenzverstoßes schuldig zu machen, verwenden einige Unternehmen viel Zeit auf die Prüfung der Lizenzen der eingesetzten Software oder lassen diese von darauf spezialisierten Unternehmen prüfen."
                            },
                            {
                                "example_id": "27eb9c41-93c2-4276-a932-b220a2398959",
                                "sense_id": "7202f187-f29f-3ab5-8b33-f10dbd0dc549",
                                "text": "„Leider muss ich Ihnen mitteilen, dass nach Rücksprache mit der Geschäftsleitung von unserer Seite aus kein Interesse an einem Interview besteht. Wir bedanken uns für Ihr Interesse und wünschen Ihnen weiterhin viel Erfolg.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
