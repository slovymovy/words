                        ],
                        "form": "die Bibliothekarin"
                    },
                    {
                        "form_id": "21306916-75c3-4ea0-8853-293005092944",
                        "entry_id": "cbcb5413-b37e-3d41-be0c-e9d7b50bc50f",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Bibliothekarinnen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7eda94cc-b1f0-3ad9-b3b1-7a19b9e1a71d",
                        "entry_id": "cbcb5413-b37e-3d41-be0c-e9d7b50bc50f",
                        "glosses": [
                            "Mitarbeiterin einer Bibliothek"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb0d211f-38e7-4d3e-9519-02df652dc071",
                                "sense_id": "7eda94cc-b1f0-3ad9-b3b1-7a19b9e1a71d",
                                "text": "Die Bibliothekarin arbeitet an einer Neufassung des Katalogs."
                            },
                            {
                                "example_id": "c2d8bfd5-8f34-4e5c-9a1d-34dcec105f17",
                                "sense_id": "7eda94cc-b1f0-3ad9-b3b1-7a19b9e1a71d",
                                "text": "Eine Bibliothekarin hilft Fragen zu unterschiedlichen Themen zu beantworten."
                            },
                            {
                                "example_id": "a4a2869d-7e6b-4719-98e8-c8fd3327e3eb",
                                "sense_id": "7eda94cc-b1f0-3ad9-b3b1-7a19b9e1a71d",
                                "text": "„Sie schrieb auch mehrmals, dass sie gerne weiter in einer Bibliothek oder einer Buchhandlung arbeiten würde, denn im Westerwald (und später in Köln) hatte sie ja viele Jahre als Bibliothekarin gearbeitet.“"
                            },
                            {
                                "example_id": "6cdcfaf7-fc79-42e0-be58-1c73da82f645",
                                "sense_id": "7eda94cc-b1f0-3ad9-b3b1-7a19b9e1a71d",
                                "text": "„Außerdem war es ja schließlich sehr gut möglich, dass diese Frau tatsächlich Bibliothekarin war, auch wenn sie dann etwas seltsame Arbeitszeiten hatte.“"
                            },
                            {
                                "example_id": "fed55233-6147-420d-a85b-20b4af6b1e60",
                                "sense_id": "7eda94cc-b1f0-3ad9-b3b1-7a19b9e1a71d",
                                "text": "„Die Bibliothekarin blickte amüsiert von einem zum anderen.“"
                            },
                            {
                                "example_id": "d81bd0ed-1761-480d-b370-495f1dc64603",
                                "sense_id": "7eda94cc-b1f0-3ad9-b3b1-7a19b9e1a71d",
                                "text": "„Janas Mutter arbeitete als Bibliothekarin.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8aee733a-a7ac-4b8d-b271-343f52e9b32a",
                        "source_entry_id": "cbcb5413-b37e-3d41-be0c-e9d7b50bc50f",
