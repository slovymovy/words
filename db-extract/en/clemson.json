                "senses": [
                    {
                        "sense_id": "013e789f-df56-3432-91f5-25f1924d5e96",
                        "entry_id": "58ce0315-e9b5-3b01-84d0-b3507bbb3406",
                        "glosses": [
                            "To perform uncharacteristically poorly, well below expectations."
                        ],
                        "tags": [
                            "US",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "53bd2dcd-bedf-4125-bd1c-a6a572871a1c",
                                "sense_id": "013e789f-df56-3432-91f5-25f1924d5e96",
                                "text": "Anyone who was watching Saturday's loss to the Steve Spurrier-led Gamecocks surely could tell within the first quarter — if not that first failed drive — that Clemson was Clemsoning once again."
                            },
                            {
                                "example_id": "85431e6c-803a-4102-846d-473a5caeb74a",
                                "sense_id": "013e789f-df56-3432-91f5-25f1924d5e96",
                                "text": "At this point, it wasn’t enough to point out that Clemson had just Clemsoned in epic fashion."
                            },
                            {
                                "example_id": "a37b12cb-7a46-4949-a0d0-3e8daae9b275",
                                "sense_id": "013e789f-df56-3432-91f5-25f1924d5e96",
                                "text": "Clemson has not “Clemsoned” since losing to GT after starting 8-0 in 2011."
                            },
                            {
                                "example_id": "0f386cc2-cbdb-436c-a04b-130a949192f9",
                                "sense_id": "013e789f-df56-3432-91f5-25f1924d5e96",
                                "text": "Dabo, you talked about people saying how possibly are you going to get ready for this game, and I know as unfair as that term has been and the way it's been applied to Clemson, the whole \"Clemsoning\" thing and losing games you're not supposed to, how does this team kind of approach that differently in you mind?"
                            }
                        ]
                    }
