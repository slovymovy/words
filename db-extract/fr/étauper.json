                "senses": [
                    {
                        "sense_id": "75184717-2561-3e12-ada7-94a258d339bf",
                        "entry_id": "a91d08c2-91cb-3ac5-b79e-c51a86660039",
                        "glosses": [
                            "Débarrasser des taupes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6db139ab-7f99-4169-90d7-592ea5804ea8",
                                "sense_id": "75184717-2561-3e12-ada7-94a258d339bf",
                                "text": "Avec quarante-dept fermes à étauper, l’homme posait des centaines de pièges."
                            },
                            {
                                "example_id": "2bb2200f-eb3a-4d6f-8bdc-c09e99666abf",
                                "sense_id": "75184717-2561-3e12-ada7-94a258d339bf",
                                "text": "Tantôt il enlevait de la cime des haies des nids de chenilles ; tantôt il traversait les prairies pour les étauper, en ouvrir les rigoles obstruées par des pluies d'orages, ou bien pour en relever les bouchures35, quand il en voyait l'épine affaissée."
                            }
                        ]
                    }
