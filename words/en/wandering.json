{
    "word_family": [
        "wander",
        "wanderer"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d61f53f3-486f-373e-9303-07a0060b868a",
                    "sense_definition": "Present participle and gerund of <w>wander</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We spent the whole afternoon <w>wandering</w> around the old city center.",
                            "target_lang_translations": {
                                "ru": "Мы провели весь день, <w>бродя</w> по старому центру города."
                            }
                        },
                        {
                            "text": "The lost child was found <w>wandering</w> alone near the forest edge.",
                            "target_lang_translations": {
                                "ru": "Потерявшегося ребенка нашли <w>блуждающим</w> в одиночестве у опушки леса."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени и герундий от <w>wander</w>."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "блужда́ющий",
                                "target_lang_sense_clarification": "причастие"
                            },
                            {
                                "target_lang_word": "скита́ющийся",
                                "target_lang_sense_clarification": "бродячий, странствующий"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "98d61a83-9d89-34c2-8bf9-cd7216ffb20c",
                    "sense_definition": "Travelling from place to place without a fixed home or specific destination.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "travel_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>wandering</w> tribe set up their camp near the river for the summer.",
                            "target_lang_translations": {
                                "ru": "<w>Кочевое</w> племя разбило лагерь у реки на лето."
                            }
                        },
                        {
                            "text": "He lived the life of a <w>wandering</w> musician, playing songs in every town he visited.",
                            "target_lang_translations": {
                                "ru": "Он жил жизнью <w>странствующего</w> музыканта, играя песни в каждом городе, который посещал."
                            }
                        }
                    ],
                    "synonyms": [
                        "roaming",
                        "nomadic",
                        "itinerant",
                        "wayfaring"
                    ],
                    "antonyms": [
                        "settled",
                        "stationary"
                    ],
                    "common_phrases": [
                        "wandering eye",
                        "wandering star",
                        "wandering minstrel"
                    ],
                    "target_lang_definitions": {
                        "ru": "Путешествующий с места на место без постоянного дома или конкретного пункта назначения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стра́нствующий",
                                "target_lang_sense_clarification": "путешествующий"
                            },
                            {
                                "target_lang_word": "кочево́й",
                                "target_lang_sense_clarification": "кочующий"
                            },
                            {
                                "target_lang_word": "скита́ющийся",
                                "target_lang_sense_clarification": "бродячий/бездомный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d6cdfd23-cc73-341f-9e03-3d3952d0571a",
                    "sense_definition": "Abnormally capable of moving or being displaced within the body.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "medical_condition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor diagnosed the patient with a <w>wandering</w> kidney that caused intermittent pain.",
                            "target_lang_translations": {
                                "ru": "Врач диагностировал у пациента <w>блуждающую</w> почку, которая вызывала периодические боли."
                            }
                        },
                        {
                            "text": "Surgery was required to fix the <w>wandering</w> spleen in its proper position.",
                            "target_lang_translations": {
                                "ru": "Потребовалась операция, чтобы зафиксировать <w>блуждающую</w> селезенку в правильном положении."
                            }
                        }
                    ],
                    "synonyms": [
                        "floating"
                    ],
                    "common_phrases": [
                        "wandering kidney",
                        "wandering pacemaker"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "medicine"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Аномально подвижный или смещенный внутри тела (об органе)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "блужда́ющий",
                                "target_lang_sense_clarification": "медицинский термин"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2103b485-575e-3801-ab4a-25a130039490",
                    "sense_definition": "The act of travelling or moving around without a preset route or destination.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "travel_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His <w>wanderings</w> took him to many strange and distant lands over the years.",
                            "target_lang_translations": {
                                "ru": "Его <w>странствия</w> привели его во многие странные и далекие земли за эти годы."
                            }
                        },
                        {
                            "text": "After hours of aimless <w>wandering</w>, they finally found the path back to the village.",
                            "target_lang_translations": {
                                "ru": "После нескольких часов бесцельного <w>блуждания</w> они наконец нашли тропинку обратно в деревню."
                            }
                        }
                    ],
                    "synonyms": [
                        "roaming",
                        "rambling"
                    ],
                    "target_lang_definitions": {
                        "ru": "Путешествие или перемещение без заранее заданного маршрута или цели."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стра́нствия",
                                "target_lang_sense_clarification": "путешествия, поездки"
                            },
                            {
                                "target_lang_word": "скита́ния",
                                "target_lang_sense_clarification": "бродяжничество/мытарства"
                            },
                            {
                                "target_lang_word": "блужда́ния",
                                "target_lang_sense_clarification": "бесцельное перемещение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "15d3b987-df61-36f8-95ce-0c52a46b955f",
                    "sense_definition": "The state of having aimless or unfocused thoughts.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mental_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teacher scolded the student for the constant <w>wandering</w> of his attention.",
                            "target_lang_translations": {
                                "ru": "Учитель отругал ученика за постоянное <w>блуждание</w> внимания."
                            }
                        },
                        {
                            "text": "Meditation is often used to control the <w>wandering</w> of the mind.",
                            "target_lang_translations": {
                                "ru": "Медитация часто используется для контроля <w>блуждания</w> ума."
                            }
                        }
                    ],
                    "antonyms": [
                        "focus",
                        "concentration"
                    ],
                    "common_phrases": [
                        "mind wandering"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние бесцельных или несфокусированных мыслей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "блужда́ние",
                                "target_lang_sense_clarification": "о мыслях/сознании"
                            },
                            {
                                "target_lang_word": "рассе́янность",
                                "target_lang_sense_clarification": "отвлечённость, невнимательность"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}