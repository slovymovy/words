                    }
                ],
                "senses": [
                    {
                        "sense_id": "cf6e1cd5-eb4c-3de4-9d4f-52f570d98028",
                        "entry_id": "f94f3dc2-8a54-3ac4-8aad-b1da4c6668cb",
                        "glosses": [
                            "Qui pétrit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "42518e36-6026-49c9-aea6-33b416a1c489",
                                "sense_id": "cf6e1cd5-eb4c-3de4-9d4f-52f570d98028",
                                "text": "Un robot pétrisseur est un appareil électrique servant à pétrir la pâte afin de lui donner une texture homogène et élastique."
                            },
                            {
                                "example_id": "3b4c0f8e-3b98-4781-9795-e30ede77d36a",
                                "sense_id": "cf6e1cd5-eb4c-3de4-9d4f-52f570d98028",
                                "text": "Le crochet pétrisseur blanc du KitchenAid Artisan ne fait pas véritablement la fonction de pétrin …"
                            },
                            {
                                "example_id": "2a813203-4e57-4f5a-9974-9f128348198c",
                                "sense_id": "cf6e1cd5-eb4c-3de4-9d4f-52f570d98028",
                                "text": "Dans cette vidéo, Spareka vous montre comment changer le bras pétrisseur et la cuve de sa machine à pain."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "491cf64d-e2a6-3cbd-988d-6f4022dd3973",
                "word": "pétrisseur",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "cf988302-9b1b-44d5-bfeb-07ef1e77b703",
                        "entry_id": "491cf64d-e2a6-3cbd-988d-6f4022dd3973",
                        "tags": [
                            "plural"
                        ],
                        "form": "pétrisseurs"
                    },
                    {
                        "form_id": "4d79f3b0-d8d1-4750-8108-22ff8e827a7c",
                        "entry_id": "491cf64d-e2a6-3cbd-988d-6f4022dd3973",
                        "tags": [
                            "feminine"
                        ],
                        "form": "pétrisseuse"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "facf2a1d-fc6e-3ef2-b321-aa6c173b1431",
                        "entry_id": "491cf64d-e2a6-3cbd-988d-6f4022dd3973",
                        "glosses": [
                            "Celui qui dans une boulangerie pétrit la pâte."
                        ],
                        "tags": [
                            "Métier"
                        ],
                        "examples": [
                            {
                                "example_id": "9423284e-4f5a-4b0c-9094-29d3b2813d75",
                                "sense_id": "facf2a1d-fc6e-3ef2-b321-aa6c173b1431",
                                "text": "[…] votre partenaire de recherche d’emploi en contrat d’intérim, CDD, CDI, recrute, pour l’un de ses clients spécialisé dans la production de pain industriel un Boulanger / Pétrisseur (H/F) pour une mission d’intérim."
                            },
                            {
                                "example_id": "ecedcc28-dac3-4ca1-9991-af96ec07a50b",
                                "sense_id": "facf2a1d-fc6e-3ef2-b321-aa6c173b1431",
                                "text": "M. Lambert , est-il dit dans le Bazar parisien (1822, 1823), pag. 332, avait, dès 1796, conçu l’idée d’un pétrin mobile, quand la société d’encouragement proposa un prix de 1,500 francs pour une machine qui pût, sans efforts pénibles de la part du pétrisseur, amener une pâte à l’état le plus parfait de pâte ferme ou molle à volonté."
                            }
                        ]
                    },
                    {
                        "sense_id": "318bb59b-dc8b-3177-b896-e9ba66084af8",
                        "entry_id": "491cf64d-e2a6-3cbd-988d-6f4022dd3973",
                        "glosses": [
                            "Celui qui pétrit toute autre matière."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "00fcae9d-3e56-44ea-a599-e85089a0fd43",
                                "sense_id": "318bb59b-dc8b-3177-b896-e9ba66084af8",
                                "text": "Il établissait entre l’invisible pétrisseur de glaise et moi une proximité physique que je retrouve aujourd’hui, avec cependant moins de trouble, au contact de certains objets usés par la main de l’homme et, en particulier, des vieux outils."
                            },
                            {
                                "example_id": "0e31b202-03b3-4b2a-95fb-d3770e89e803",
                                "sense_id": "318bb59b-dc8b-3177-b896-e9ba66084af8",
                                "text": "Maintenant, – toi qui vas hors des routes tracées,\nÔ pétrisseur de bronze, ô mouleur de pensées,\nConsidère combien les hommes sont petits,\nEt maintiens-toi superbe au-dessus des partis !"
                            },
                            {
                                "example_id": "be08d3c9-916d-4a19-aa2c-3ad6ae38d87d",
                                "sense_id": "318bb59b-dc8b-3177-b896-e9ba66084af8",
                                "text": "Gandhi n’est pas, comme nos révolutionnaires d’Europe, un fabricant de lois et de décrets. Il est le pétrisseur d’une nouvelle humanité."
                            }
                        ]
                    },
                    {
                        "sense_id": "064a721b-3482-3f17-9d20-953a791f3e10",
                        "entry_id": "491cf64d-e2a6-3cbd-988d-6f4022dd3973",
                        "glosses": [
                            "Ustensile ou appareil utilisé pour pétrir une pâte."
                        ],
                        "tags": [
                            "Électroménager"
                        ],
                        "examples": [
                            {
                                "example_id": "3d7c333b-73ef-45e3-970a-86d1309f5833",
                                "sense_id": "064a721b-3482-3f17-9d20-953a791f3e10",
                                "text": "Ce pétrisseur de pâte en inox vous permettra de pétrir avec force et régularité les pâtes à pain mais aussi pâtes brisées, feuilletées…"
                            },
                            {
                                "example_id": "f88883cd-c25a-4810-a517-cfc4f9692d23",
                                "sense_id": "064a721b-3482-3f17-9d20-953a791f3e10",
                                "text": "Le pétrisseur Bialetti Red a une puissance de 600 Watts et il est doué de 3 accessoires pour pétrissages de toutes les consistances : crochet pour pétrissages durs ; crochet pour pétrissages doux ; crochet pour pétrissages légers."
                            }
                        ]
                    }
                ],
