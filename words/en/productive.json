{
    "word_family": [
        "produce",
        "product",
        "production",
        "productivity",
        "producer",
        "productively",
        "reproductive",
        "counterproductive"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "df6ca70a-e75b-3401-8040-55e834c7d57d",
                    "sense_definition": "Yielding good or useful results; constructive and efficient.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We had a very <w>productive</w> meeting and solved several problems.",
                            "target_lang_translations": {
                                "ru": "У нас была очень <w>продукти́вная</w> встреча, и мы решили несколько проблем.",
                                "zh": "我们开了一次非常<w>富有成效的</w>会议，解决了几个问题。"
                            }
                        },
                        {
                            "text": "I hope you have a <w>productive</w> day at work.",
                            "target_lang_translations": {
                                "ru": "Надеюсь, у тебя будет <w>плодотво́рный</w> рабочий день.",
                                "zh": "希望你今天工作<w>富有成效</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "fruitful",
                        "efficient",
                        "constructive"
                    ],
                    "antonyms": [
                        "unproductive",
                        "counterproductive",
                        "fruitless",
                        "nonproductive"
                    ],
                    "common_phrases": [
                        "productive meeting",
                        "productive day",
                        "highly productive",
                        "productive discussion"
                    ],
                    "target_lang_definitions": {
                        "ru": "Приносящий хорошие или полезные результаты; конструктивный и эффективный.",
                        "zh": "产生良好或有用结果的；有建设性的且高效的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "продукти́вный",
                                "target_lang_sense_clarification": "эффективный, полезный"
                            },
                            {
                                "target_lang_word": "плодотво́рный",
                                "target_lang_sense_clarification": "приносящий плоды, успешный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "富有成效的",
                                "target_lang_sense_clarification": "指工作或会议效果好"
                            },
                            {
                                "target_lang_word": "多产的",
                                "target_lang_sense_clarification": "指产出丰富"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4a487a98-5b29-3796-9978-4d2a15a3b6d9",
                    "sense_definition": "Capable of producing something in large quantities, such as crops or offspring; fertile.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmers moved to more <w>productive</w> land near the river.",
                            "target_lang_translations": {
                                "ru": "Фермеры переехали на более <w>плодоро́дные</w> земли у реки.",
                                "zh": "农民们搬到了河边更<w>肥沃的</w>土地上。"
                            }
                        },
                        {
                            "text": "This variety of apple tree is extremely <w>productive</w>.",
                            "target_lang_translations": {
                                "ru": "Этот сорт яблони чрезвычайно <w>урожа́йный</w>.",
                                "zh": "这个品种的苹果树非常<w>高产</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "fertile",
                        "prolific",
                        "fruitful",
                        "yielding"
                    ],
                    "antonyms": [
                        "barren",
                        "sterile",
                        "unproductive"
                    ],
                    "common_phrases": [
                        "productive soil",
                        "productive land",
                        "productive agriculture"
                    ],
                    "target_lang_definitions": {
                        "ru": "Способный производить что-либо в больших количествах, например, урожай или потомство; плодоро́дный.",
                        "zh": "能够大量生产某物（如农作物或后代）的；肥沃的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "плодоро́дный",
                                "target_lang_sense_clarification": "о земле или почве"
                            },
                            {
                                "target_lang_word": "урожа́йный",
                                "target_lang_sense_clarification": "о растениях или годе"
                            },
                            {
                                "target_lang_word": "продукти́вный",
                                "target_lang_sense_clarification": "о скоте или сортах"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "肥沃的",
                                "target_lang_sense_clarification": "指土地或土壤"
                            },
                            {
                                "target_lang_word": "高产的",
                                "target_lang_sense_clarification": "指农作物或品种"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "532f1b91-98ff-3411-9944-578c31d9fcb7",
                    "sense_definition": "Relating to the creation of goods or services in an economy.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government aims to increase the <w>productive</w> capacity of the industry.",
                            "target_lang_translations": {
                                "ru": "Правительство стремится увеличить <w>произво́дственные</w> мощности промышленности.",
                                "zh": "政府旨在提高该行业的<w>生产</w>能力。"
                            }
                        },
                        {
                            "text": "Investment in education increases the <w>productive</w> potential of the workforce.",
                            "target_lang_translations": {
                                "ru": "Инвестиции в образование повышают <w>производи́тельный</w> потенциал рабочей силы.",
                                "zh": "对教育的投资提高了劳动力的<w>生产</w>潜力。"
                            }
                        }
                    ],
                    "antonyms": [
                        "unproductive"
                    ],
                    "common_phrases": [
                        "productive capacity",
                        "productive forces",
                        "productive sector"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к созданию товаров или услуг в экономике.",
                        "zh": "与经济中商品或服务的创造相关的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "производи́тельный",
                                "target_lang_sense_clarification": "создающий ценность, рабочий"
                            },
                            {
                                "target_lang_word": "произво́дственный",
                                "target_lang_sense_clarification": "относящийся к производству"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "生产性的",
                                "target_lang_sense_clarification": "指与生产活动相关"
                            },
                            {
                                "target_lang_word": "生产力的",
                                "target_lang_sense_clarification": "指创造价值的能力"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1d0f4d1b-4506-3e9e-9d29-e0924392b073",
                    "sense_definition": "Describing a cough that brings up mucus or fluid from the lungs.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patient presented with a fever and a <w>productive</w> cough.",
                            "target_lang_translations": {
                                "ru": "У пациента наблюдалась температура и <w>вла́жный</w> кашель.",
                                "zh": "病人表现出发烧和<w>有痰的</w>咳嗽。"
                            }
                        },
                        {
                            "text": "If the cough becomes <w>productive</w>, you should see a doctor.",
                            "target_lang_translations": {
                                "ru": "Если кашель станет <w>вла́жным</w>, вам следует обратиться к врачу.",
                                "zh": "如果咳嗽变得<w>有痰</w>，你应该去看医生。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "productive cough"
                    ],
                    "target_lang_definitions": {
                        "ru": "Описывает кашель, при котором выделяется мокрота или жидкость из легких.",
                        "zh": "描述一种会带出肺部粘液或液体的咳嗽。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вла́жный",
                                "target_lang_sense_clarification": "с мокротой (о кашле)"
                            },
                            {
                                "target_lang_word": "продукти́вный",
                                "target_lang_sense_clarification": "медицинский термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "有痰的",
                                "target_lang_sense_clarification": "指伴有分泌物的咳嗽"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e6be1863-6465-35ca-a688-1b8541475561",
                    "sense_definition": "Describing a grammatical rule or affix that can be used freely to form new words.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The suffix \"-able\" is highly <w>productive</w> in English.",
                            "target_lang_translations": {
                                "ru": "Суффикс \"-able\" очень <w>продукти́вен</w> в английском языке.",
                                "zh": "后缀“-able”在英语中非常<w>能产</w>。"
                            }
                        },
                        {
                            "text": "Some prefixes are no longer <w>productive</w> and cannot be used to make new words.",
                            "target_lang_translations": {
                                "ru": "Некоторые приставки больше не <w>продукти́вны</w> и не могут использоваться для образования новых слов.",
                                "zh": "一些前缀已不再<w>能产</w>，不能用于构成新词。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Описывает грамматическое правило или аффикс, которые могут свободно использоваться для образования новых слов.",
                        "zh": "描述一种可以自由用于构成新词的语法规则或词缀。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "продукти́вный",
                                "target_lang_sense_clarification": "словообразовательный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "能产的",
                                "target_lang_sense_clarification": "语言学术语，指构词能力强"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8070594b-a5c9-300b-9687-120fc5aa6507",
                    "sense_definition": "Relating to a specific type of set in mathematical logic.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The professor explained the properties of a <w>productive</w> set.",
                            "target_lang_translations": {
                                "ru": "Профессор объяснил свойства <w>продукти́вного</w> множества.",
                                "zh": "教授解释了<w>能产</w>集合的性质。"
                            }
                        },
                        {
                            "text": "This theorem applies to recursively enumerable sets that are <w>productive</w>.",
                            "target_lang_translations": {
                                "ru": "Эта теорема применима к рекурсивно перечислимым множествам, которые являются <w>продукти́вными</w>.",
                                "zh": "该定理适用于<w>能产的</w>递归可枚举集合。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к определенному типу множеств в математической логике.",
                        "zh": "与数理逻辑中特定类型的集合相关的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "продукти́вный",
                                "target_lang_sense_clarification": "математический термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "能产的",
                                "target_lang_sense_clarification": "数学逻辑术语"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}