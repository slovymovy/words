                        "sense_id": "da9173d2-ac67-3394-b2d6-f44b1a3d4843",
                        "entry_id": "3c2d607d-c3f4-3d5b-96b2-bbe3b643c3a0",
                        "glosses": [
                            "Igniting spontaneously upon contact with an oxidizer."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "75246b12-bb32-48c6-a8bd-f1173fd82246",
                                "sense_id": "da9173d2-ac67-3394-b2d6-f44b1a3d4843",
                                "text": "Although the LF₂-LH₂ cryogenic combination is hypergolic, the toxicity of the fuel and the products of combustion have made the use of this system impractical. In general, the commonly used hypergolic propellants are considered conventionally storable, that is, they do not need special refrigeration equipment to keep them liquid."
                            }
                        ]
                    },
                    {
                        "sense_id": "71a61e46-031f-3b2f-b2c9-e8220214ca2f",
                        "entry_id": "3c2d607d-c3f4-3d5b-96b2-bbe3b643c3a0",
                        "glosses": [
                            "Involving such a hypergolic agent."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "2c2eeb19-734f-464a-bf95-7801080444da",
                                "sense_id": "71a61e46-031f-3b2f-b2c9-e8220214ca2f",
                                "text": "The chemical reaction range of hypergolic mixtures varies from slow and barely visible to an instantaneous and highly visible explosive force."
                            }
                        ]
                    }
