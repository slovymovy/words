                "forms": [],
                "senses": [
                    {
                        "sense_id": "762edd57-4973-3cc3-9474-8bc2f5af21b1",
                        "entry_id": "9a3e339b-b673-33ad-84f1-f2f968c5d651",
                        "glosses": [
