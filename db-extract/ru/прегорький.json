                "senses": [
                    {
                        "sense_id": "dc2549d2-9e69-3f6b-b749-3c18b3880722",
                        "entry_id": "3dd7d457-ba8b-3420-aacb-ce7fdcb9b569",
                        "glosses": [
                            "превосх. ст. к прил. горький"
                        ],
                        "tags": [
                            "superlative"
                        ],
                        "examples": [
                            {
                                "example_id": "56909a72-669f-4fa3-947a-2f2ea3f3f6c6",
                                "sense_id": "dc2549d2-9e69-3f6b-b749-3c18b3880722",
                                "text": "Я так почитал сию женщину, что признанием её не смел и помыслить воспользоваться; но, условясь с нею о нашей переписке, простился, оставя её в прегорьких слезах."
                            },
                            {
                                "example_id": "cb80fd81-efd9-4b70-b887-254d411b5ddd",
                                "sense_id": "dc2549d2-9e69-3f6b-b749-3c18b3880722",
                                "text": "― Я, друг, ― ха-роший парень! И жизнь моя, братец, ― горькая, прегорькая!.."
                            }
                        ]
                    }
