                "senses": [
                    {
                        "sense_id": "d3b9c4f4-55cf-35e3-a875-51846adc4f28",
                        "entry_id": "fc474c27-9a3d-3397-a176-bb73e62c2f70",
                        "glosses": [
                            "Having qualities resembling those of steel, especially hardness and resoluteness."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3bfbd8e3-d565-4a5b-a55b-0e8d887b42cc",
                                "sense_id": "d3b9c4f4-55cf-35e3-a875-51846adc4f28",
                                "text": "steely grey hair"
                            },
                            {
                                "example_id": "73c9b54b-f278-4b7c-960a-d7f1186f1934",
                                "sense_id": "d3b9c4f4-55cf-35e3-a875-51846adc4f28",
                                "text": "The bully backed down before his steely gaze."
                            },
                            {
                                "example_id": "5708696e-eed6-45be-93a0-cb637ace4f35",
                                "sense_id": "d3b9c4f4-55cf-35e3-a875-51846adc4f28",
                                "text": "She would unarm her noble heart of that steely resistance against the sweet blows of love.",
                                "translation": "The New Arcadia",
                                "english": "The New Arcadia"
                            },
                            {
                                "example_id": "70386ee6-7fc1-4aff-9882-d0d5cdc6ee86",
                                "sense_id": "d3b9c4f4-55cf-35e3-a875-51846adc4f28",
                                "text": "Freddie Woodman was ultimately the hero after making a superb 74th-minute penalty save to deny Adalberto Peñaranda. Woodman, the son of former Northampton Town goalkeeper Andy and godson of Southgate, made a steely left-handed save from the spot-kick after Dominic Calvert-Lewin had given England a first-half lead."
                            }
                        ]
                    },
                    {
                        "sense_id": "6a563849-7a00-3d60-841a-13e5e880f007",
                        "entry_id": "fc474c27-9a3d-3397-a176-bb73e62c2f70",
                        "glosses": [
                            "Made of steel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2f65f0d-9139-4235-8337-2debc8c4fb8c",
                                "sense_id": "6a563849-7a00-3d60-841a-13e5e880f007",
                                "text": "Broach'd with the steely point of Clifford's lance."
                            },
                            {
                                "example_id": "cd4cfe28-4db0-4794-b410-b44e1da41ab5",
                                "sense_id": "6a563849-7a00-3d60-841a-13e5e880f007",
                                "text": "Around his shop the steely sparkles flew."
                            },
                            {
                                "example_id": "22e2b319-9798-4b09-b898-665ebf70b0df",
                                "sense_id": "6a563849-7a00-3d60-841a-13e5e880f007",
                                "text": "And in the master's chambers / They gathered for the feast / They stab it with their steely knives / But they just can't kill the beast"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
