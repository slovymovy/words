                ],
                "senses": [
                    {
                        "sense_id": "80e9096a-1081-345a-80d4-1c8bb288a14d",
                        "entry_id": "02106a30-1798-3aa6-a74f-0d52d8c05e2a",
                        "glosses": [
                            "Alternative spelling of likable."
                        ],
                        "tags": [
                            "UK",
                            "alt-of",
                            "alternative",
                            "often"
                        ],
                        "examples": [
                            {
                                "example_id": "41bfeb86-9c5c-4887-9628-7d23d6851c1f",
                                "sense_id": "80e9096a-1081-345a-80d4-1c8bb288a14d",
                                "text": "All the better that she was no dandy; all the likeabler that she spoke little; all the safer that she ruled the father an’ was a mistress in the house."
                            },
                            {
                                "example_id": "586636f0-3d69-4519-9880-4de8f70ae9dc",
                                "sense_id": "80e9096a-1081-345a-80d4-1c8bb288a14d",
                                "text": "He was about the likeablest cuss I ever met. We got to be good friends."
                            },
                            {
                                "example_id": "9cedb9ed-1f2c-487b-afd1-e6604b5bc0ca",
                                "sense_id": "80e9096a-1081-345a-80d4-1c8bb288a14d",
                                "text": "He was a most likeable and generous man, a Whitworth Scholar, and possessed of a fund of knowledge which seemed to cover every subject under the sun."
                            },
                            {
                                "example_id": "19d21ec1-25db-4c11-a3ec-10c747d0b310",
                                "sense_id": "80e9096a-1081-345a-80d4-1c8bb288a14d",
                                "text": "My associate, Jack Cloherty, spent a month establishing the links between Ashland the senator, an investigation which took Cloherty from Capitol Hill to Kentucky. The likeabler Cook, of course, had an explanation for everything. He acknowledged that he has accepted speech material from Ashland, but denied that it came in the form of ready-made speeches."
                            }
                        ]
                    }
                ],
