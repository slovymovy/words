{
    "word_family": [
        "haste",
        "hasty"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2076f51a-9a18-322c-8a40-b26f315c9c57",
                    "sense_definition": "To move or act in a quick fashion.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children <w>hasten</w> toward the playground as soon as the school bell rings.",
                            "target_lang_translations": {
                                "tr": "Okul zili çalar çalmaz çocuklar oyun alanına doğru <w>acele ediyorlar</w>.",
                                "ru": "Дети <w>спешат</w> на игровую площадку, как только звенит школьный звонок."
                            }
                        },
                        {
                            "text": "We must <w>hasten</w> to the station if we want to catch the last train.",
                            "target_lang_translations": {
                                "tr": "Son trene yetişmek istiyorsak istasyona <w>acele etmeliyiz</w>.",
                                "ru": "Нам нужно <w>поторопиться</w> на вокзал, если мы хотим успеть на последний поезд."
                            }
                        }
                    ],
                    "synonyms": [
                        "dart",
                        "race",
                        "move quickly",
                        "zoom"
                    ],
                    "common_phrases": [
                        "hasten away",
                        "hasten back"
                    ],
                    "target_lang_definitions": {
                        "tr": "Hızlı bir şekilde hareket etmek veya davranmak.",
                        "ru": "Быстро передвигаться или действовать, торопиться."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "acele etmek",
                                "target_lang_sense_clarification": "Bir yere gitmek için hızlı davranmak."
                            },
                            {
                                "target_lang_word": "koşturmak",
                                "target_lang_sense_clarification": "Bir yere varmak için hızlı hareket etmek."
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "спешить",
                                "target_lang_sense_clarification": "быстро двигаться или действовать"
                            },
                            {
                                "target_lang_word": "торопиться",
                                "target_lang_sense_clarification": "стараться успеть, делать что-либо быстрее"
                            },
                            {
                                "target_lang_word": "поспешить",
                                "target_lang_sense_clarification": "ускорить шаг, быстро направиться куда-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c38879e4-9863-3dc0-9e35-61018108de1f",
                    "sense_definition": "To make someone speed up or make something happen quicker.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "speed",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The warm weather will <w>hasten</w> the melting of the snow in the mountains.",
                            "target_lang_translations": {
                                "tr": "Sıcak hava dağlardaki karların erimesini <w>hızlandıracak</w>.",
                                "ru": "Теплая погода <w>ускорит</w> таяние снега в горах."
                            }
                        },
                        {
                            "text": "New technology can <w>hasten</w> the production process significantly.",
                            "target_lang_translations": {
                                "tr": "Yeni teknoloji üretim sürecini önemli ölçüde <w>hızlandırabilir</w>.",
                                "ru": "Новые технологии могут существенно <w>ускорить</w> процесс производства."
                            }
                        }
                    ],
                    "synonyms": [
                        "accelerate",
                        "quicken",
                        "speed up"
                    ],
                    "common_phrases": [
                        "hasten progress"
                    ],
                    "target_lang_definitions": {
                        "tr": "Birinin hızlanmasını sağlamak veya bir şeyin daha çabuk gerçekleşmesine neden olmak.",
                        "ru": "Ускорять наступление чего-либо или поторапливать кого-либо."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "hızlandırmak",
                                "target_lang_sense_clarification": "Bir sürecin veya olayın daha çabuk olmasını sağlamak."
                            },
                            {
                                "target_lang_word": "çabuklaştırmak",
                                "target_lang_sense_clarification": "Bir işin süresini kısaltmak."
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "ускорять",
                                "target_lang_sense_clarification": "делать процесс более быстрым"
                            },
                            {
                                "target_lang_word": "приближать",
                                "target_lang_sense_clarification": "делать так, чтобы событие произошло скорее"
                            },
                            {
                                "target_lang_word": "торопить",
                                "target_lang_sense_clarification": "побуждать кого-либо или что-либо двигаться быстрее"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "30132e3c-9c3a-3c80-bc34-6cced42fc94b",
                    "sense_definition": "To cause some scheduled event to happen earlier.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "speed",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company decided to <w>hasten</w> the launch date of their new product.",
                            "target_lang_translations": {
                                "tr": "Şirket, yeni ürünlerinin lansman tarihini <w>öne çekmeye</w> karar verdi.",
                                "ru": "Компания решила <w>перенести на более ранний срок</w> дату запуска своего нового продукта."
                            }
                        },
                        {
                            "text": "They tried to <w>hasten</w> the end of the meeting to avoid the heavy traffic.",
                            "target_lang_translations": {
                                "tr": "Yoğun trafikten kaçınmak için toplantının bitişini <w>öne çekmeye</w> çalıştılar.",
                                "ru": "Они попытались <w>ускорить</w> окончание встречи, чтобы не попасть в сильные пробки."
                            }
                        }
                    ],
                    "synonyms": [
                        "hurry",
                        "rush"
                    ],
                    "common_phrases": [
                        "hasten completion"
                    ],
                    "target_lang_definitions": {
                        "tr": "Planlanmış bir olayın daha erken gerçekleşmesine neden olmak.",
                        "ru": "Переносить запланированное событие на более ранний срок."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "öne çekmek",
                                "target_lang_sense_clarification": "Bir etkinliğin tarihini veya saatini erkene almak."
                            },
                            {
                                "target_lang_word": "erkene almak",
                                "target_lang_sense_clarification": "Bir planı normalden daha önce başlatmak."
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "переносить на более ранний срок",
                                "target_lang_sense_clarification": "назначать событие на более раннее время"
                            },
                            {
                                "target_lang_word": "приближать",
                                "target_lang_sense_clarification": "ускорять наступление запланированного срока"
                            },
                            {
                                "target_lang_word": "ускорять",
                                "target_lang_sense_clarification": "делать так, чтобы завершение или начало наступило раньше"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "8da08ee9-c770-382c-927d-cdde449deb0a",
                    "sense_definition": "A surname from Dutch.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "names",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The family <w>Hastens</w> has lived in this town for over three generations.",
                            "target_lang_translations": {
                                "tr": "<w>Hastens</w> ailesi üç nesilden fazladır bu kasabada yaşıyor.",
                                "ru": "Семья <w>Хастенс</w> живет в этом городе уже более трех поколений."
                            }
                        },
                        {
                            "text": "I met a researcher named Dr. <w>Hastens</w> at the conference last week.",
                            "target_lang_translations": {
                                "tr": "Geçen hafta konferansta Dr. <w>Hastens</w> adında bir araştırmacıyla tanıştım.",
                                "ru": "На прошлой неделе на конференции я познакомился с исследователем по фамилии <w>Хастенс</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Used as a family name."
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Hollanda kökenli bir soyadı.",
                        "ru": "Нидерландская фамилия."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "Hastens",
                                "target_lang_sense_clarification": "Özel isim olduğu için çevrilmez."
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "Хастенс",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}