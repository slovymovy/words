                        "cross_references": [
                            {
                                "target_word": "муслин",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "4af248dd-b714-384e-8359-836c8dcde1fc",
                                        "entry_id": "d786ae12-95c5-3200-9275-7d6a7b5218df",
                                        "glosses": [
                                            "текст. мягкая тонкая ткань — хлопчатобумажная, шерстяная, шелковая или синтетическая"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e333307-1670-44a3-9db3-18e49677f95a",
                                                "sense_id": "4af248dd-b714-384e-8359-836c8dcde1fc",
                                                "text": "Из всех шкапов вылезают длинные полосы всевозможных материй, шёлка, бархата, тюля, муслина, кружева в одном из углов набросана целая гора самых разнообразных мехов, в другом свалена куча парчи, церковных материй, индийских тканей, экзотических бус..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a22dfdd1-314f-3e3d-91cf-16996a691346",
                                        "entry_id": "d786ae12-95c5-3200-9275-7d6a7b5218df",
                                        "glosses": [
                                            "текст. изделия из такой ткани"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f6a5278-8b5e-4656-b230-76c266e8f9d3",
                                                "sense_id": "a22dfdd1-314f-3e3d-91cf-16996a691346",
                                                "text": "В нарядах их вкусу было пропасть: муслины, атласы, кисеи были таких бледных модных цветов, каким даже и названья нельзя было прибрать (до такой степени дошла тонкость вкуса)."
                                            },
                                            {
                                                "example_id": "bd78dc30-d7a7-48b5-9052-f3d66bb52c2f",
                                                "sense_id": "a22dfdd1-314f-3e3d-91cf-16996a691346",
                                                "text": "За ореховой рамой в светлой пустоте отраженной комнаты стояла тоненькая невысокая девушка, одетая в дешёвый белый муслин с розовыми цветочками."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
