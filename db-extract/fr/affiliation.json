        "fr-extract.jsonl": [
            {
                "entry_id": "6f98e62a-7035-34ea-b4bd-026c1f471d49",
                "word": "affiliation",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "4b0e9b00-64c3-4d1a-bc08-59c24a350df0",
                        "entry_id": "6f98e62a-7035-34ea-b4bd-026c1f471d49",
                        "tags": [
                            "plural"
                        ],
                        "form": "affiliations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9381b634-a931-3706-835e-16e0eaec6047",
                        "entry_id": "6f98e62a-7035-34ea-b4bd-026c1f471d49",
                        "glosses": [
                            "Action d’affilier, de s’affilier à une compagnie, à une corporation, à une communauté."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a76552a-d484-48cc-a1aa-82d74d767161",
                                "sense_id": "9381b634-a931-3706-835e-16e0eaec6047",
                                "text": "Affiliation à un complot, à une société secrète."
                            },
                            {
                                "example_id": "b09300ed-e941-4b25-a4eb-efb9e693577d",
                                "sense_id": "9381b634-a931-3706-835e-16e0eaec6047",
                                "text": "Il y a affiliation entre ces deux communautés religieuses, entre plusieurs loges de francs-maçons."
                            },
                            {
                                "example_id": "e1b5454d-6dc9-4560-bbea-8c2e9e29a465",
                                "sense_id": "9381b634-a931-3706-835e-16e0eaec6047",
                                "text": "Réussir à l'université passerait donc par un processus d'affiliation institutionnelle et intellectuelle."
                            },
                            {
                                "example_id": "d88bc6f5-a3fa-49ed-a62b-c1ea06e22d17",
                                "sense_id": "9381b634-a931-3706-835e-16e0eaec6047",
                                "text": "Le 19 juillet dernier, la plateforme d'échanges de crypto-monnaies Coinbase a fait bien des malheureux. Et pour une fois il ne s'agissait pas des détenteurs de cryptos, déjà largement mis à mal par la chute des cours entamée en mai. Non, cette fois-ci les victimes sont les influenceurs cryptos. Coinbase leur annonce qu'elle suspend l'octroi de commissions qu'elle leur délivre aux Etats-Unis. Et ce pour au moins le reste de l'année selon Business Insider. Les crypto influenceurs qui jusqu'alors touchaient de l'argent en partageant à leur communauté leurs liens affiliés sont privés d'une source de revenus parfois considérable. Heureusement pour eux, Coinbase n'est pas le seul acteur du monde des cryptos à proposer un programme d'affiliation, et l'affiliation n'est pas le seul moyen pour eux de monnayer leur influence."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3f9569cd-7b8f-47f5-8d3b-44be46db1742",
                        "source_entry_id": "6f98e62a-7035-34ea-b4bd-026c1f471d49",
                        "source_sense_id": "9381b634-a931-3706-835e-16e0eaec6047",
                        "target_lang_word": "Verwandtschaft",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verwandtschaft",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "da2a67c9-94ba-3201-8822-632cff3600ad",
                                        "entry_id": "00dfaf51-53c3-3866-a4a8-195666db4dd2",
                                        "glosses": [
                                            "die Tatsache, miteinander verwandt zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e18e5f7-0a09-4928-83f4-0120edbb3e0a",
                                                "sense_id": "da2a67c9-94ba-3201-8822-632cff3600ad",
                                                "text": "Die Verwandtschaft zwischen den beiden ist nicht sehr eng."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "403abb5c-f670-35af-99c9-a21f995838d1",
                                        "entry_id": "00dfaf51-53c3-3866-a4a8-195666db4dd2",
                                        "glosses": [
                                            "Personen, die miteinander oder mit jemandem verwandt sind"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f7abc43-af8b-4963-9a60-5247ad12847a",
                                                "sense_id": "403abb5c-f670-35af-99c9-a21f995838d1",
                                                "text": "Heute kommt unsere Verwandtschaft zu Besuch."
                                            },
                                            {
                                                "example_id": "885515af-0e17-441c-a0cd-aaae8a51d71e",
                                                "sense_id": "403abb5c-f670-35af-99c9-a21f995838d1",
                                                "text": "„Einige Gäste aus der allernächsten Verwandtschaft waren noch geblieben und sassen im grossen Salon.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "558eacf6-0daf-3766-9f66-840e2f3cf9b6",
                                        "entry_id": "00dfaf51-53c3-3866-a4a8-195666db4dd2",
                                        "glosses": [
                                            "Ähnlichkeit"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "085493eb-f491-4035-b0cb-97b28300610d",
                                                "sense_id": "558eacf6-0daf-3766-9f66-840e2f3cf9b6",
                                                "text": "Tintenfische heißen wohl deshalb so, weil man zwischen ihnen und den Fischen eine gewisse Verwandtschaft sah."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "83e8e44a-3688-459d-957a-a0fe7cffa321",
                        "source_entry_id": "6f98e62a-7035-34ea-b4bd-026c1f471d49",
                        "source_sense_id": "9381b634-a931-3706-835e-16e0eaec6047",
