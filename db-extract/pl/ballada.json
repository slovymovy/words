                    {
                        "sense_id": "04722932-c335-3022-924c-9fb37d737cb0",
                        "entry_id": "6337ed12-51e5-3e3b-ac38-d10d53ea41ca",
                        "glosses": [
                            "wierszowany utwór opisujący niezwykłe wydarzenia"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1aa63368-0f9f-434d-9a49-feb38cc16b06",
                                "sense_id": "04722932-c335-3022-924c-9fb37d737cb0",
                                "text": "„Król elfów” Goethego jest słynną balladą."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "bc906598-65aa-3726-b69a-9f348241763d",
                        "entry_id": "6337ed12-51e5-3e3b-ac38-d10d53ea41ca",
                        "glosses": [
                            "nastrojowy utwór"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "534124c4-f59a-463e-ac5d-1df5d1ea10ac",
                                "sense_id": "bc906598-65aa-3726-b69a-9f348241763d",
                                "text": "Był to pogłos jakiejś rockowej ballady, której słowa wydały się Kubie dziwnie znajome"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8506ade0-39a2-47ea-9f5d-ee604caf454b",
                        "source_entry_id": "6337ed12-51e5-3e3b-ac38-d10d53ea41ca",
                        "source_sense_id": "04722932-c335-3022-924c-9fb37d737cb0",
                        "target_lang_word": "ballade",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ballade",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8aa9b750-aafb-38ea-8da6-cbcf1bdab524",
                                        "entry_id": "98a9ea0d-dde9-36df-a588-da4358f5a8b3",
                                        "glosses": [
                                            "Poème à forme fixe, composé de couplets faits sur les mêmes rimes avec refrain et d’un envoi."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7af9b839-5af1-4000-94bd-e5f430e5cdf8",
                                                "sense_id": "8aa9b750-aafb-38ea-8da6-cbcf1bdab524",
                                                "text": "[…] il était à peine remis de cette émotion, lorsque, d’une voix douce et à la fois profonde, la jeune fille commença une ballade dont les paroles avaient, avec la situation où il se trouvait, une telle analogie, qu’on eût pu croire que la mystérieuse virtuose improvisait."
                                            },
                                            {
                                                "example_id": "809d9549-a915-48a5-ba98-9607c4882fc7",
                                                "sense_id": "8aa9b750-aafb-38ea-8da6-cbcf1bdab524",
                                                "text": "Je vais — hop ! — à l’improvisade, vous composer une ballade."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ccae359c-95ba-3f00-9237-33ba4398da98",
                                        "entry_id": "98a9ea0d-dde9-36df-a588-da4358f5a8b3",
                                        "glosses": [
                                            "Récit en vers, divisé en strophes avec ou sans refrain, reproduisant le plus souvent des traditions historiques ou légendaires."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "edc216eb-582f-4e22-b6d3-be2b31b41b4f",
                                                "sense_id": "ccae359c-95ba-3f00-9237-33ba4398da98",
                                                "text": "En ce cas, reprit le chevalier, je vais essayer une ballade composée par un Saxon que j’ai connu en Terre sainte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d7494a8a-98f1-33ed-823d-a3cdf78df935",
                                        "entry_id": "98a9ea0d-dde9-36df-a588-da4358f5a8b3",
                                        "glosses": [
                                            "Nom donné à des compositions musicales et à des chansons, bien qu’elles ne retiennent que rarement la forme fixe d’origine."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fed50f8b-113d-43ee-a38f-df449b821f0b",
                                                "sense_id": "d7494a8a-98f1-33ed-823d-a3cdf78df935",
                                                "text": "Les quatre ballades pour piano de Frédéric Chopin. – La ballade du genre humain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "127a8912-81f0-3c82-a565-be8aec7ef67e",
                                        "entry_id": "98a9ea0d-dde9-36df-a588-da4358f5a8b3",
                                        "glosses": [
                                            "Morceau de jazz, généralement de 32 mesures, joué sur tempo lent, voire très lent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "547ea248-a180-4d14-bbf5-6ef99e44dcca",
                                                "sense_id": "127a8912-81f0-3c82-a565-be8aec7ef67e",
                                                "text": "Trane dépossède littéralement le pianiste de sa musique. Attaque à main armée. À l’exception peut-être des ballades : Ruby my dear et Monk’s mood. Le saxophoniste y joue comme un digne fils de Hawkins : la mélodie d’abord. Il les respecte, les caresse, ces ballades, et ne s’envole en arpèges que lorsqu’elles veulent bien le lui permettre."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
