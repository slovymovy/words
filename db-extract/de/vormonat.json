                    }
                ],
                "senses": [
                    {
                        "sense_id": "f383cdbc-3f8b-3804-ad54-6a5bfa85bba6",
                        "entry_id": "64a214f6-64aa-32fa-b4df-d0f6201771ab",
                        "glosses": [
                            "der vorhergehende Monat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff09c961-06da-4ac7-af17-ec1a8dcd9ba0",
                                "sense_id": "f383cdbc-3f8b-3804-ad54-6a5bfa85bba6",
                                "text": "Der im Vormonat gekaufte Fernseher ist bereits jetzt beschädigt."
                            },
                            {
                                "example_id": "4d189606-0c01-4bbf-b0ae-23873901e389",
                                "sense_id": "f383cdbc-3f8b-3804-ad54-6a5bfa85bba6",
                                "text": "„Die NGOs geben ihre Kosten Anfang jedes Monats dem Innenministerium bekannt und bekommen sie für das Vormonat rückerstattet.“"
                            },
                            {
                                "example_id": "73fd1e32-1159-42e8-a363-ba96b3c22f20",
                                "sense_id": "f383cdbc-3f8b-3804-ad54-6a5bfa85bba6",
                                "text": "„ORF 2 legt auf das Vormonat 0,7 Prozentpunkte drauf und bleibt mit 23,8 Prozent das meistrezipierte Programm des Marktes.“"
                            },
                            {
                                "example_id": "e126b8e9-efa6-42a7-80a9-b7a0a26e9ef4",
                                "sense_id": "f383cdbc-3f8b-3804-ad54-6a5bfa85bba6",
                                "text": "„Die JBA übermittelt zum Ende eines jeden Monats für das Vormonat eine detaillierte Aufstellung über die erbrachten Leistungen und die angefallenen Kosten zu Informationszwecken an die Leistungsempfänger.“"
                            },
                            {
                                "example_id": "4a79584e-0d00-4770-ac61-c3d36d1c3870",
                                "sense_id": "f383cdbc-3f8b-3804-ad54-6a5bfa85bba6",
                                "text": "„Da das Delikt der Nichtentrichtung der Abgabe gem § 7 Abs 1 Wr GetränkesteuerG 1971 mit Ablauf des zehnten Tages jedes Monats für das Vormonat bereits vollendet und beendet ist, scheidet eine Scheinkonkurrenz in Form eines fortgsetzten Deliktes aus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
