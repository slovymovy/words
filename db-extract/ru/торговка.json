                                        "entry_id": "d649b526-3423-398f-a780-a2d3148f7d3b",
                                        "glosses": [
                                            "vrouw die handel drijft"
                                        ],
                                        "tags": [
                                            "beroep"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a237dea0-d74d-4d0a-a8de-d96e91c80b72",
                                                "sense_id": "ab86027f-3995-35bc-859c-0b2e08c6a904",
                                                "text": "De koningin verft haar gezicht en verkleedt zich als een oude koopvrouw en loopt over de zeven bergen naar de zeven dwergen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "302c9a92-4430-437c-b9bc-80562d1ff6bf",
                        "source_entry_id": "95cd2d76-031d-3edd-85ce-53b6dc54b96b",
                        "source_sense_id": "b75d0669-1935-370c-8092-161b2f54b3d4",
