        "fr-extract.jsonl": [
            {
                "entry_id": "bc086e99-13ec-35b5-a38e-0e9c1d6c8813",
                "word": "fraternisation",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "1e1f2494-52f9-43be-a75a-80c8d8b7ebce",
                        "entry_id": "bc086e99-13ec-35b5-a38e-0e9c1d6c8813",
                        "tags": [
                            "plural"
                        ],
                        "form": "fraternisations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6893b742-e88b-3161-b918-30761831b121",
                        "entry_id": "bc086e99-13ec-35b5-a38e-0e9c1d6c8813",
                        "glosses": [
                            "Action de fraterniser."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "29ff5629-a917-4676-b1fb-a3cc88088e81",
                                "sense_id": "6893b742-e88b-3161-b918-30761831b121",
                                "text": "Ils se montrèrent timides même, et il fallut des présents, de bons services, une fraternisation quotidienne, un long commerce d’amitiés, pour les acclimater à bord."
                            },
                            {
                                "example_id": "de4c5998-3b9c-43aa-959c-ebc677d5d98b",
                                "sense_id": "6893b742-e88b-3161-b918-30761831b121",
                                "text": "Les cas de fraternisation de tranchée à tranchée n’ont pas été rares pendant la guerre, ils auraient été plus fréquents sans les officiers qui veillaient."
                            }
                        ]
                    },
                    {
                        "sense_id": "a1e1bb64-47a6-3b00-8e8e-32f689c9185a",
                        "entry_id": "bc086e99-13ec-35b5-a38e-0e9c1d6c8813",
                        "glosses": [
                            "Union fraternelle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d30802e-eb9d-4529-a8f8-4f2a43a5a261",
                                "sense_id": "a1e1bb64-47a6-3b00-8e8e-32f689c9185a",
                                "text": "Les chinois, les arabes, les habitants de l’Inde, de l’Égypte, les Hottentots, les Indiens, les Lapons, et mille autres peuples et peuplades attestent cette malédiction jetée sur tout ce qui s’isole, sur tout ce qui ne coopère pas à la fraternisation universelle."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9546128f-f78f-4934-a7d2-75445fd3d3f2",
                        "source_entry_id": "bc086e99-13ec-35b5-a38e-0e9c1d6c8813",
                        "target_lang_word": "Verbrüderung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verbrüderung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e1517a75-3209-3717-b304-7a60c13702d7",
                                        "entry_id": "a2112b3f-d5ba-3608-a300-4db2eb1c81b8",
                                        "glosses": [
                                            "Einigung/Vereinigung von Partnern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "372a0304-79bf-48db-98a0-8200ec96e0c5",
                                                "sense_id": "e1517a75-3209-3717-b304-7a60c13702d7",
                                                "text": "„So ging das stundenlang, er säuberte die Welt, brachte den Augiasstall in Ordnung, bahnte den Weg für die Verbrüderung der Menschheit und das Reich der Gedankenfreiheit.“"
                                            },
                                            {
                                                "example_id": "14f360c0-fd12-488a-bb0d-1745562d25a9",
                                                "sense_id": "e1517a75-3209-3717-b304-7a60c13702d7",
                                                "text": "„Es war der Anblick dieser Überlegenheit, der allmählich den Stolz dieser Wilden, die sich natürlich als das stärkere Volk weit über die schwachen Oconees erhaben glaubten, auf seine gehörigen Grenzen zurückwies und den Weg zur freundschaftlichen Verbrüderung bahnte.“"
                                            },
                                            {
                                                "example_id": "4b0cad29-913c-4ee6-8f1a-ae1626a7f683",
                                                "sense_id": "e1517a75-3209-3717-b304-7a60c13702d7",
                                                "text": "„Dabei kam es nicht immer nur zur Verbrüderung der Bauern mit den Kämpfern, sondern Letztere schüchterten ein, warfen sich zu Richtern in lokalen Streitigkeiten auf und verlangten, von den Dorfbewohnern versorgt zu werden, sexuelle Dienste oft eingeschlossen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eca4a251-8861-4e0f-85ae-1123d8495934",
                        "source_entry_id": "bc086e99-13ec-35b5-a38e-0e9c1d6c8813",
                        "target_lang_word": "Fraternisierung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fraternisierung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "13348178-ecab-3593-8c35-40e853e23152",
                                        "entry_id": "239d0d46-64ab-37d0-9b96-f1154ba4b18c",
                                        "glosses": [
                                            "persönlicher Kontakt zu einer Person"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3b39380-3152-4af9-a445-4740c5e5caa6",
                                                "sense_id": "13348178-ecab-3593-8c35-40e853e23152",
                                                "text": "„Aus Sturheit oder Pflichtgefühl ließ er sie sofort festnehmen und als Gefangene abtransportieren, und damit war die kurze Fraternisierung beendet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
