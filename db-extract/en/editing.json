                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bearbeitung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3e98da50-3fa5-3a84-80e1-379242e3f48a",
                                        "entry_id": "d54128f4-5d4d-3250-a7e4-a2db3f9ee6f3",
                                        "glosses": [
                                            "Vorgang, durch den ein Gegenstand, zum Beispiel ein Dokument, in Form oder Inhalt verändert wird"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9320c17e-03a0-4870-96e9-a9738ad92118",
                                                "sense_id": "3e98da50-3fa5-3a84-80e1-379242e3f48a",
                                                "text": "Zur Bearbeitung des Manuskripts verwendete sie ein einfaches Textverarbeitungsprogramm."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a37291a2-4324-3632-8959-523d6c516553",
                                        "entry_id": "d54128f4-5d4d-3250-a7e4-a2db3f9ee6f3",
                                        "glosses": [
                                            "Modifikation eines künstlerischen Werks"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc3a7613-8b02-4929-879d-6ec7794cf761",
                                                "sense_id": "a37291a2-4324-3632-8959-523d6c516553",
                                                "text": "Die Skulptur bedarf noch weiterer Bearbeitung."
                                            },
                                            {
                                                "example_id": "8ae3c215-90ae-4351-b3c1-15cdddf32226",
                                                "sense_id": "a37291a2-4324-3632-8959-523d6c516553",
                                                "text": "Heute hören sie die Sonata facile von Wolfgang Amadeus Mozart in der Bearbeitung von Edward Grieg."
                                            },
                                            {
                                                "example_id": "eca360b1-4237-46f4-b8cb-545a4f0cb65a",
                                                "sense_id": "a37291a2-4324-3632-8959-523d6c516553",
                                                "text": "„Die Bekanntheit und die, nach Wielands Urteil, verfehlten bisherigen Bearbeitungen sind ein Grund für seine Stoffwahl.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "12696891-3733-3526-b238-266252c62a40",
                                        "entry_id": "d54128f4-5d4d-3250-a7e4-a2db3f9ee6f3",
                                        "glosses": [
                                            "Vorgang, durch den ein Werkstück in eine andere Form gebracht wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03281007-4eb2-4706-a142-a725e8cb1796",
                                                "sense_id": "12696891-3733-3526-b238-266252c62a40",
                                                "text": "Bearbeitung und Verwendung des Marmors finden wir bei den Hebräern früher als bei den Griechen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "f0530671-ae4f-304c-aa93-47ae223e0b93",
                                        "entry_id": "d54128f4-5d4d-3250-a7e4-a2db3f9ee6f3",
                                        "glosses": [
                                            "Behandlung eines bürokratischen Vorgangs"
                                        ],
                                        "tags": [
                                            "Verwaltung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9ec5d622-e1f4-4899-b3fd-c192c0210661",
                                                "sense_id": "f0530671-ae4f-304c-aa93-47ae223e0b93",
                                                "text": "Die Bearbeitung Ihrer Eingabe dauert vermutlich mehrere Wochen, da nicht nur eine Dienststelle damit befasst sein wird."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
