                    {
                        "translation_id": "9998a108-4d0c-47e1-aee4-f392431f4bb8",
                        "source_entry_id": "4090eb18-ea1f-3c4a-a821-f711aba3615d",
                        "source_sense_id": "e64d5744-2db2-3791-a573-a8108c387b83",
                        "target_lang_word": "responsable",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "responsable",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "08f4aece-5da8-3f80-b0d2-0dc61d0c075a",
                                        "entry_id": "aef1f5a1-1190-3fdf-9e8b-0131f761fb22",
                                        "glosses": [
                                            "Qui doit répondre de ses propres actions ou de celles des autres, qui doit être garant de quelque chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d5542648-54e2-4dab-8fd1-a20b54424da4",
                                                "sense_id": "08f4aece-5da8-3f80-b0d2-0dc61d0c075a",
                                                "text": "En certains cas, un maître est responsable pour ses domestiques, un père est responsable pour ses enfants mineurs."
                                            },
                                            {
                                                "example_id": "a999473a-7c09-4a4c-b0a1-4d2700fec15e",
                                                "sense_id": "08f4aece-5da8-3f80-b0d2-0dc61d0c075a",
                                                "text": "Ô phrénologues ! L’inéducabilité érigée en principe ? quel inhominalisme ! La sublime créature est éducable, voyante et libre, criminelle ou vertueuse à son choix, responsable."
                                            },
                                            {
                                                "example_id": "4e850f1c-6b39-4237-8465-d22e9ba09b8a",
                                                "sense_id": "08f4aece-5da8-3f80-b0d2-0dc61d0c075a",
                                                "text": "Il discernait qu'il avait affaire à un personnage exceptionnellement distrait, mais il n'était pas responsable d'une pareille balourdise chez cet hurluberlu qui visait à l'élégance."
                                            },
                                            {
                                                "example_id": "d94503fc-888a-40af-bfcb-347e78440d6a",
                                                "sense_id": "08f4aece-5da8-3f80-b0d2-0dc61d0c075a",
                                                "text": "Dès les premiers jours, Maeva Squiban et Natalie Griczer ont été prises dans des chutes collectives sans en être responsables."
                                            },
                                            {
                                                "example_id": "21104f4c-195e-46dc-956a-51ea1639f7c4",
                                                "sense_id": "08f4aece-5da8-3f80-b0d2-0dc61d0c075a",
                                                "text": "Les ministres sont responsables."
                                            },
                                            {
                                                "example_id": "ec0d8f10-8e61-4967-8b3a-2fd0760c277f",
                                                "sense_id": "08f4aece-5da8-3f80-b0d2-0dc61d0c075a",
                                                "text": "Je vous rends responsable de ce qu’il fera."
                                            },
                                            {
                                                "example_id": "92af938b-5b1c-49f8-b348-bc09dae70e7e",
                                                "sense_id": "08f4aece-5da8-3f80-b0d2-0dc61d0c075a",
                                                "text": "Vous êtes responsable du dépôt qu’on vous a confié."
                                            },
                                            {
                                                "example_id": "fce8fed6-df85-4cbb-a3d1-f0577aa1286e",
                                                "sense_id": "08f4aece-5da8-3f80-b0d2-0dc61d0c075a",
                                                "text": "Un fils n’est pas responsable des fautes de son père."
                                            },
                                            {
                                                "example_id": "340e1294-eb18-45d0-9b2a-33aeb51db3ac",
                                                "sense_id": "08f4aece-5da8-3f80-b0d2-0dc61d0c075a",
                                                "text": "être civilement responsable des faits, des actes de quelqu’un."
                                            },
                                            {
                                                "example_id": "7b866935-969d-43f9-b340-ea3e67335c56",
                                                "sense_id": "08f4aece-5da8-3f80-b0d2-0dc61d0c075a",
                                                "text": "responsable devant la postérité."
                                            },
                                            {
                                                "example_id": "eb1bcdc0-fa8d-482f-9a29-777b87290e90",
                                                "sense_id": "08f4aece-5da8-3f80-b0d2-0dc61d0c075a",
                                                "text": "responsable envers la patrie."
                                            },
                                            {
                                                "example_id": "b9c2a4b3-ef92-4526-9b5c-250889620033",
                                                "sense_id": "08f4aece-5da8-3f80-b0d2-0dc61d0c075a",
                                                "text": "être moralement responsable de quelque chose, En porter la responsabilité morale."
                                            },
                                            {
                                                "example_id": "86bad732-22a7-4915-839b-4c74a87860b7",
                                                "sense_id": "08f4aece-5da8-3f80-b0d2-0dc61d0c075a",
                                                "text": "être civilement responsable de quelque chose, En porter la responsabilité civile."
                                            },
                                            {
                                                "example_id": "bf0970a1-646d-46d8-af59-0873782ad03f",
                                                "sense_id": "08f4aece-5da8-3f80-b0d2-0dc61d0c075a",
                                                "text": "Il n’est pas responsable se dit d’un Homme qui ne jouit pas de toutes ses facultés, qui n’est pas maître de ses actes."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "responsable",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ddbbf757-d819-3d76-a5f3-b8ac3f704624",
                                        "entry_id": "5333b684-582c-33c6-ad67-02634261c767",
                                        "glosses": [
                                            "Personne qui est responsable de quelque chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92816974-f8fe-4b71-bc36-e7e0fb6e89fe",
                                                "sense_id": "ddbbf757-d819-3d76-a5f3-b8ac3f704624",
                                                "text": "Le responsable, comme son titre l’indique, a la « responsabilité » de gérer le projet du propriétaire-client."
                                            },
                                            {
                                                "example_id": "3477c292-79d0-4347-9cca-52cf8e07d634",
                                                "sense_id": "ddbbf757-d819-3d76-a5f3-b8ac3f704624",
                                                "text": "— Et qu'en pense le conseil d'administration ?\n— Ils voudraient que nous fassions porter le chapeau à l'un de nos sous-traitants et je dois me battre pour que nous assumions cette erreur dont nous sommes les seuls véritables responsables."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "44b66f50-1191-31e4-8f46-20a1b2147a03",
                                        "entry_id": "5333b684-582c-33c6-ad67-02634261c767",
                                        "glosses": [
                                            "Personne qui exerce une fonction importante dans une organisation, une administration."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "534e6659-a0d2-4d88-bfa7-150b586566a2",
                                                "sense_id": "44b66f50-1191-31e4-8f46-20a1b2147a03",
                                                "text": "Le trabendo mafieux ne peut pas fonctionner sans la complicité active et grassement rétribuée de certains responsables."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
