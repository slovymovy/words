                                "target_senses": [
                                    {
                                        "sense_id": "0a021fa3-21a5-37e5-8448-49cfd1d88397",
                                        "entry_id": "907190cf-c378-3f13-874c-0551e647594e",
                                        "glosses": [
                                            "Qui fortifie, relatif aux fortifications."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "359c363f-d87a-4f7d-949b-7f2e3522be35",
                                                "sense_id": "0a021fa3-21a5-37e5-8448-49cfd1d88397",
                                                "text": "Par sa composition même, cette carte est un hommage aux capacités d'ingénieurs des Européens, dont la science fortificatrice protège Mahé, et aux troupes françaises dont la vigueur offensive fait tomber les ouvrages ennemis."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fortificateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8d14813b-a4b0-32ed-a62e-b1820f441ba7",
                                        "entry_id": "b3d02b98-0d84-3a7a-a848-072f6b661c91",
                                        "glosses": [
                                            "Celui qui fortifie une place, qui s’occupe de la fortification."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e0dab03-ac6a-4e0c-9388-56e6e7fe10a7",
                                                "sense_id": "8d14813b-a4b0-32ed-a62e-b1820f441ba7",
                                                "text": "L’ignorance des fortificateurs de ce temps là estoit de hausser les contr'escarpes et ne les aplanir pas."
                                            },
                                            {
