                "forms": [],
                "senses": [
                    {
                        "sense_id": "43d264a5-7a61-37b9-84fc-e91a02170cf0",
                        "entry_id": "713460db-0936-305e-8fa6-1ee14b903c48",
                        "glosses": [
                            "Variante de encore."
                        ],
                        "tags": [
                            "alt-of",
                            "poetic"
                        ],
                        "examples": [
                            {
                                "example_id": "96de109f-05a4-4918-bb81-82031da17844",
                                "sense_id": "43d264a5-7a61-37b9-84fc-e91a02170cf0",
                                "text": "Qu’il est loin le matin des temps intarissables,\nOù rien n’était encor, ni les eaux, ni le sable,"
                            },
                            {
                                "example_id": "5bae6723-ca93-4052-acfa-631378fc3f65",
                                "sense_id": "43d264a5-7a61-37b9-84fc-e91a02170cf0",
                                "text": "Il est, seigneur Arnolphe, encor plus gai que nous,\nEt j’avais de sa part une lettre pour vous ;\nMais depuis, par une autre, il m’apprend sa venue,\nEt la raison encor ne m’en est pas connue."
                            },
                            {
                                "example_id": "e382e542-be54-44b4-a49f-c309e456753e",
                                "sense_id": "43d264a5-7a61-37b9-84fc-e91a02170cf0",
                                "text": "Pour intriguer les songes d’or ?...\nN’es-tu pas l’amour dans l’espace,\nSouffle de Messaline lasse\nMais pas rassasiée encor !"
                            }
                        ]
                    }
                ],
