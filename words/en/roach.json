                    "sense_definition": "A stratum or bed of a particular mineral or rock.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "geology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Miners located a productive <w>roach</w> of coal deep beneath the limestone layers.",
                            "target_lang_translations": {
