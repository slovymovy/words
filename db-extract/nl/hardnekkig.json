                ],
                "senses": [
                    {
                        "sense_id": "9749a0fc-2d1d-3d02-ad35-77cabd1676a5",
                        "entry_id": "565b4c93-91ec-3fa5-b267-9829ab344358",
                        "glosses": [
                            "onverbeterlijk, onverzettelijk"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "357ce932-0164-4097-98a8-53973ef0141c",
                                "sense_id": "9749a0fc-2d1d-3d02-ad35-77cabd1676a5",
                                "text": "Hardnekkige probleemgezinnen worden onder permanent toezicht gezet."
                            },
                            {
                                "example_id": "25750032-edf2-4a5a-b47c-20aca91f8450",
                                "sense_id": "9749a0fc-2d1d-3d02-ad35-77cabd1676a5",
                                "text": "Het jachtmuseum zou zelfs de hardnekkigste tegenstander van de jacht kunnen bekoren."
                            }
                        ]
                    },
                    {
                        "sense_id": "1bd10653-2704-3736-b9c5-38a893c329c2",
                        "entry_id": "565b4c93-91ec-3fa5-b267-9829ab344358",
                        "glosses": [
                            "maar blijven aanhouden, niet willen wijken van iets"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b6e33c8-5502-4002-b916-e2dd72bf9630",
                                "sense_id": "1bd10653-2704-3736-b9c5-38a893c329c2",
                                "text": "Hij is geveld door een hardnekkig virus."
                            },
                            {
                                "example_id": "acab2e14-2b0d-4baf-bb06-762b54ef3d39",
                                "sense_id": "1bd10653-2704-3736-b9c5-38a893c329c2",
                                "text": "Er circuleren hardnekkige geruchten over hem."
                            },
                            {
                                "example_id": "9832c013-912b-4d49-bef9-5a270d033aef",
                                "sense_id": "1bd10653-2704-3736-b9c5-38a893c329c2",
                                "text": "Dit product verwijdert zelfs de hardnekkigste vlekken."
                            },
                            {
                                "example_id": "0ade148a-2881-48ed-b7ed-63a6aa2757eb",
                                "sense_id": "1bd10653-2704-3736-b9c5-38a893c329c2",
                                "text": "Het zag ernaar uit dat de oorlog nog minstens twee jaar zou duren, de Engelsen waren hardnekkig op hun eiland."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
