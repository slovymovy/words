                ],
                "senses": [
                    {
                        "sense_id": "e2354a93-13eb-372c-b156-5614d42a6019",
                        "entry_id": "4e0f22ab-7da0-3d9a-b5a9-da9588f4b933",
                        "glosses": [
                            "das Maß individueller Kreativität bzw. Originalität in einem geistigen Werk, welches darüber entscheidet, ob dem Werk Urheberrechtsschutz zukommt"
                        ],
                        "tags": [
                            "Urheberrecht"
                        ],
                        "examples": [
                            {
                                "example_id": "68364b7a-e4fc-44ca-aa06-89502ff603bc",
                                "sense_id": "e2354a93-13eb-372c-b156-5614d42a6019",
                                "text": "„Der Zeichnung fehle es an der nach der Rechtsprechung des Bundesgerichtshofs zu § 2 Abs. 1 Nr. 4 UrhG erforderlichen Schöpfungshöhe.“"
                            },
                            {
                                "example_id": "e6caaa47-fb8a-4491-991f-4e4bc4863969",
                                "sense_id": "e2354a93-13eb-372c-b156-5614d42a6019",
                                "text": "„Auch wenn es vielen Web-Designern unerklärlich erschienen mag: Das reine Erscheinungsbild einer Website erreicht - zumindest in der Auslegung des Urheberrechts - nicht die notwendige Schöpfungshöhe, um den Schutz des Urheberrechts zu genießen.“"
                            },
                            {
                                "example_id": "98ec6146-a629-4991-aee6-ac36acf54a6b",
                                "sense_id": "e2354a93-13eb-372c-b156-5614d42a6019",
                                "text": "„Als Schöpfungshöhe (auch: Gestaltungshöhe, Werkhöhe) wird im deutschen Urheberrecht das Maß an Individualität (persönlicher geistiger Schöpfung) in einem Produkt geistiger Arbeit bezeichnet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
