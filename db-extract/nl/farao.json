                                "target_senses": [
                                    {
                                        "sense_id": "13d020e9-dde5-368e-b43a-a04996f5aeb2",
                                        "entry_id": "4d3b4a0b-3bb7-31ae-bfba-374c8b930d39",
                                        "glosses": [
                                            "The supreme ruler of Ancient Egypt; a formal address for the sovereign seat of power as personified by the \\\"king\\\" in an institutional role of Horus son of Osiris; often used by metonymy for Ancient Egyptian sovereignty"
                                        ],
                                        "tags": [
                                            "countable",
                                            "historical",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "784beacd-99bf-4679-95da-644d4b88d718",
                                                "sense_id": "13d020e9-dde5-368e-b43a-a04996f5aeb2",
                                                "text": "Instances: see Thesaurus:pharaoh"
                                            },
                                            {
                                                "example_id": "03bcb817-b988-43af-ba0c-aae45d51d261",
                                                "sense_id": "13d020e9-dde5-368e-b43a-a04996f5aeb2",
                                                "text": "And the Egyptians ſhall know that I am the Lord, when I haue gotten me honour vpon Pharaoh, vpon his charets, and vpon his horſemen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "77205a7b-67ea-3897-af96-b4fbf01331e9",
                                        "entry_id": "4d3b4a0b-3bb7-31ae-bfba-374c8b930d39",
                                        "glosses": [
                                            "The card game faro."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "88121ec6-f598-4c52-b976-a4201c203db2",
                                                "sense_id": "77205a7b-67ea-3897-af96-b4fbf01331e9",
                                                "text": "\"I pray, when I play pharaoh at White's, that the cards fall as they have come to my hand in this large gamble,\" Anstis said."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
