                "senses": [
                    {
                        "sense_id": "2efc75de-f04d-396d-af15-2fd3d79aa479",
                        "entry_id": "203afed8-bd47-384b-a1dc-890cec46bb71",
                        "glosses": [
                            "Relatif à la nécromancie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e1f029a-12f1-4c90-828f-b3f9dd36519d",
                                "sense_id": "2efc75de-f04d-396d-af15-2fd3d79aa479",
                                "text": "Le magnétisme animal sort à peine de sa coque nécromantique."
                            },
                            {
                                "example_id": "2c607f35-40ae-441b-8ae1-21909804a868",
                                "sense_id": "2efc75de-f04d-396d-af15-2fd3d79aa479",
                                "text": "Le procédé nécromantique doit certainement être classé parmi les plus anciens modes divinatoires."
                            },
                            {
                                "example_id": "eedcd69b-780e-4406-bb93-a92d32532a3e",
                                "sense_id": "2efc75de-f04d-396d-af15-2fd3d79aa479",
                                "text": "Je me rends compte de l’étrangeté de cette entreprise quasi nécromantique. C’est moins le spectre d’Octave que j’évoque à près d’un siècle de distance qu’Octave lui-même […]"
                            },
                            {
                                "example_id": "27ca16d8-3969-44cc-ae31-f6146e45285a",
                                "sense_id": "2efc75de-f04d-396d-af15-2fd3d79aa479",
                                "text": "Malgré ses efforts, elle ne parvenait pas à me convaincre de participer à ses expériences nécromantiques - je refusais de m’allonger sur une tombe."
                            }
                        ]
                    }
                ],
