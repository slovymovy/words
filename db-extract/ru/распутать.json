                                    {
                                        "sense_id": "7b8e9634-b2e3-32b5-8418-1f7596887d8b",
                                        "entry_id": "16225360-9ab3-305f-8f10-299388b19730",
                                        "glosses": [
                                            "To remove tangles or knots from."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "916ccb8f-c54f-4cef-99c2-9760494634b1",
                                                "sense_id": "7b8e9634-b2e3-32b5-8418-1f7596887d8b",
                                                "text": "With gentle combing, untangle your hair."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5ef04cc8-757e-3370-ac51-4319a10305f4",
                                        "entry_id": "16225360-9ab3-305f-8f10-299388b19730",
                                        "glosses": [
                                            "To remove confusion or mystery from."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2cc39077-e1db-4d6a-9aab-d22d3bb45d29",
                                                "sense_id": "5ef04cc8-757e-3370-ac51-4319a10305f4",
                                                "text": "It took a while, but he finally untangled the problem."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d89d05d5-faea-45a9-8919-bb3cff230983",
                        "source_entry_id": "5d94ac0f-2442-39da-b518-5783590d5900",
                        "source_sense_description": "приводить в порядок спутанное",
                        "target_lang_word": "untwine",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "untwine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "983ce9b5-1fd0-3cd5-b0ac-6c5df1354a2d",
                                        "entry_id": "febdc0c3-9ed4-3272-b3fe-65430431f5f8",
                                        "glosses": [
                                            "To untwist the strands of (something entwined)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "60236765-eee3-4b27-aefc-1f7f775227ab",
                                                "sense_id": "983ce9b5-1fd0-3cd5-b0ac-6c5df1354a2d",
                                                "text": "The rope must be then untwined and the middle of each strand laid across the top and stitched down along the pencil line, half the length falling on one side, half on the other."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f672ece-0027-38d5-99f0-9e96788b7035",
                                        "entry_id": "febdc0c3-9ed4-3272-b3fe-65430431f5f8",
                                        "glosses": [
                                            "To free (one thing that is entwined with another), disentangle, extricate."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8535f3fe-3aad-4edf-a54e-ce913634ea2d",
                                                "sense_id": "6f672ece-0027-38d5-99f0-9e96788b7035",
                                                "text": "Woe to the revolutionist who is not himself a creature of the revolution! If he anticipate, he is lost; for it requires, what no individual can supply, a long and powerful counter-sympathy in a nation to untwine the ties of custom which bind a people to the established and the old."
                                            },
                                            {
                                                "example_id": "611191a6-05eb-43b1-a392-4fcfb8195668",
                                                "sense_id": "6f672ece-0027-38d5-99f0-9e96788b7035",
                                                "text": "She then untwined the snake from her body, and held it by the tail high above her."
                                            },
                                            {
                                                "example_id": "2df95446-0d9e-4e71-b249-77e89624cd37",
                                                "sense_id": "6f672ece-0027-38d5-99f0-9e96788b7035",
                                                "text": "She stood her ground until he reached her and flung both arms around her neck, dragging her to the floor. She later said the police had to untwine him before he could be taken to the ambulance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f3a222b-c96f-3869-a7bd-b2ce60ece680",
                                        "entry_id": "febdc0c3-9ed4-3272-b3fe-65430431f5f8",
                                        "glosses": [
                                            "To become untwisted or disentangled."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "28ed8330-6a55-49f5-86a8-cbaa0e53f9f1",
                                                "sense_id": "4f3a222b-c96f-3869-a7bd-b2ce60ece680",
                                                "text": "As the tangled mass of men untwined, following the blast of the whistle, Sage heard Stone calling in his ear […]"
                                            },
                                            {
                                                "example_id": "520993e4-07e9-4849-83ca-08fd692373d6",
                                                "sense_id": "4f3a222b-c96f-3869-a7bd-b2ce60ece680",
                                                "text": "The zebra of their legs twined and untwined together on the bed."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f291a281-dcf6-41d8-aff3-09d3b54125fd",
                        "source_entry_id": "5d94ac0f-2442-39da-b518-5783590d5900",
                        "source_sense_description": "приводить в порядок спутанное",
                        "target_lang_word": "disentangle",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "disentangle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c0c682b3-5b60-32f8-850f-0bc3549d5d4e",
                                        "entry_id": "d406ab8b-b4de-3ffa-88fa-1e4370243ed2",
                                        "glosses": [
                                            "To free something from entanglement; to extricate or unknot."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c3486304-7490-44fc-a3ec-33d7b0ef5543",
                                                "sense_id": "c0c682b3-5b60-32f8-850f-0bc3549d5d4e",
                                                "text": "I had to disentangle him from his own shoelaces."
                                            },
                                            {
                                                "example_id": "bdf52d21-1c34-4028-bbaf-c250b0d56ccd",
                                                "sense_id": "c0c682b3-5b60-32f8-850f-0bc3549d5d4e",
                                                "text": "In my own opinion, “criminal religious movements” (CRMs) is a more accurate and useful category than “cults.” It uses, although selectively, elements from the criminological tradition. It avoids the word “cult” and tries to disentangle the category from both the folk psychology of brainwashing and the politics of “extremism” in theology."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7ed3cc8e-fef6-356d-b9ee-fa553f63729a",
                                        "entry_id": "d406ab8b-b4de-3ffa-88fa-1e4370243ed2",
                                        "glosses": [
                                            "To unravel; to separate into discrete components or units."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2110a855-1f36-4467-b209-00a0a576592c",
                                                "sense_id": "7ed3cc8e-fef6-356d-b9ee-fa553f63729a",
                                                "text": "This overlapping is reflective of hybrid languages, where certain features (phonetic, orthographic, semantic, syntactic) are also difficult to disentangle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a3ae38de-bdaf-3348-a567-0c1e1da53e4f",
                                        "entry_id": "d406ab8b-b4de-3ffa-88fa-1e4370243ed2",
                                        "glosses": [
                                            "To become free or untangled."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
