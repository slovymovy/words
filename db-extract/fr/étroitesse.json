                                                "sense_id": "959b08ff-e4e1-38cf-9133-cd0944db2569",
                                                "text": "Es herrschte bedrückende Enge."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9aa102ad-bb78-3b37-ab06-3e240435f704",
                                        "entry_id": "ff6b03cb-8eb1-3ca8-8819-d4b9741706e4",
                                        "glosses": [
                                            "schmaler Streifen von Land oder Wasser, Pass"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9fd749a3-eba9-47e4-8e7a-9532b1c3d66c",
                                                "sense_id": "9aa102ad-bb78-3b37-ab06-3e240435f704",
                                                "text": "Das Boot musste durch eine Enge geleitet werden."
                                            },
                                            {
                                                "example_id": "94fef674-2917-45f5-96a8-07f16425965d",
                                                "sense_id": "9aa102ad-bb78-3b37-ab06-3e240435f704",
                                                "text": "„Doch stattdessen nahm die Enge von Mal zu Mal zu.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
