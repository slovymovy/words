                                            {
                                                "example_id": "5f3943dc-288d-481d-9e55-3a2f42843b15",
                                                "sense_id": "c5eb3d5d-1e1b-328b-988b-4bdaee94881d",
                                                "text": "Die huichelachtige opmerking veroorzaakte veel wrevel."
