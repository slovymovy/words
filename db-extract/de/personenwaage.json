                "senses": [
                    {
                        "sense_id": "e2f83541-9e28-361f-9d0c-f3945f531a7d",
                        "entry_id": "ccdc8385-ef4a-3c85-95ec-9a91cb6f6b5a",
                        "glosses": [
                            "Waage, die das Gewicht von Personen ermittelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ed7c6a7-1926-4d47-ba63-1a91068c8ad5",
                                "sense_id": "e2f83541-9e28-361f-9d0c-f3945f531a7d",
                                "text": "Personenwaagen sind in der Regel bis max. 150 Kilogramm belastbar."
                            },
                            {
                                "example_id": "16a8f2fa-7190-4892-b748-ad91793987ef",
                                "sense_id": "e2f83541-9e28-361f-9d0c-f3945f531a7d",
                                "text": "Die Messgenauigkeit von Personenwaagen ist in der Regel 0,5 Kilogramm"
                            },
                            {
                                "example_id": "73fb2f90-d2b1-438a-9006-1f4070c480a0",
                                "sense_id": "e2f83541-9e28-361f-9d0c-f3945f531a7d",
                                "text": "Da der Patient extremes Übergewicht hatte, konnte er nicht mit einer Personenwaage gewogen werden."
                            },
                            {
                                "example_id": "a8aa91f0-af2f-4de4-95ed-373ef6ae6201",
                                "sense_id": "e2f83541-9e28-361f-9d0c-f3945f531a7d",
                                "text": "Heutzutage sind die Personenwaagen oft mit elektronischer Digitalanzeige ausgestattet."
                            },
                            {
                                "example_id": "a1510317-c5c2-49f4-b712-8477af6a8f35",
                                "sense_id": "e2f83541-9e28-361f-9d0c-f3945f531a7d",
                                "text": "„Schon Wochen vor dem Rückflug half ich ihr regelmäßig, den hellblauen Koffer und mindestens einen weiteren ins Bad zu schleppen und auf die Personenwaage zu stellen.“"
                            },
                            {
                                "example_id": "85c57ed2-c92b-4818-aefc-ddf5165d6649",
                                "sense_id": "e2f83541-9e28-361f-9d0c-f3945f531a7d",
                                "text": "„Es gibt Leute, die sich sparsamkeitshalber familienweise auf Personenwaagen quetschen und stückweise herunterspringen, um ihr Körpergewicht durch Subtraktion zu ermitteln.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
