                ],
                "senses": [
                    {
                        "sense_id": "8eb4810a-3666-3e4b-aaa5-b5b91ddf07ed",
                        "entry_id": "e4ef2848-2bb8-3403-a51e-5911321ca0fb",
                        "glosses": [
                            "eine Sprache, die in Nordwestrussland gesprochen wird; wird teilweise gemeinsam mit dem Komi-Permjakischen als Varietät des Komi betrachtet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c4c90b4-865c-49a8-9c64-1b2d139d0ce5",
                                "sense_id": "8eb4810a-3666-3e4b-aaa5-b5b91ddf07ed",
                                "text": "„Es hiesse den achtbaren Verfasser beleidigen, wenn man behauptete, er hätte das alles aus der Luft gegriffen, weil die Behörden zu Pinega das Factum für jetzt verläugnen, versteht sich in dem Sinne, dass dort jetzt nicht mehr Syrjänisch gesprochen wird.“"
                            },
                            {
                                "example_id": "756f2347-df43-44e4-96b8-5c32c550a83b",
                                "sense_id": "8eb4810a-3666-3e4b-aaa5-b5b91ddf07ed",
                                "text": "„Das Syrjänische hat zwei Modi: Indikativ und Imperativ.“"
                            },
                            {
                                "example_id": "f31460a8-e7ba-45fb-b323-f39c9e99eb1b",
                                "sense_id": "8eb4810a-3666-3e4b-aaa5-b5b91ddf07ed",
                                "text": "„Der C o n s e c u t i v des Syrjänischen, der eine Bewegung nach einem Orte bezeichnet, um das Object zu holen, wird im Ostjakischen durch denselben Dativcasus vertreten: jiña menôt, er ging nach Wasser, um Wasser zu holen, Syrjänisch valá muny.“"
                            },
                            {
                                "example_id": "2c9000e4-ebd1-4b04-b9a0-63a4e4257135",
                                "sense_id": "8eb4810a-3666-3e4b-aaa5-b5b91ddf07ed",
                                "text": "„Vor dem Hintergrund, den er in früheren Arbeiten skizziert hat, vergleicht K. zwei finnisch-ugrische Sprachen, nämlich Samisch und Syrjänisch, miteinander.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
