    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "04455527-0985-3f54-a13d-e8f90565f9d7",
                    "sense_definition": "The extent or measure of how broad or wide something is; width.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_dimension",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>breadth</w> of the corridor is exactly four and a half metres.",
                            "target_lang_translations": {
                                "ru": "<w>Ширина</w> коридора составляет ровно четыре с половиной метра."
                            }
                        },
                        {
                            "text": "The carpenter measured the <w>breadth</w> of the table to ensure it would fit through the door.",
                            "target_lang_translations": {
                                "ru": "Плотник измерил <w>ширину</w> стола, чтобы убедиться, что он пройдет в дверь."
                            }
                        }
                    ],
                    "synonyms": [
                        "width"
                    ],
                    "common_phrases": [
                        "breadth of the room",
                        "measure the breadth"
                    ],
                    "target_lang_definitions": {
                        "ru": "Протяженность или мера того, насколько что-либо широко; ширина."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ширина",
                                "target_lang_sense_clarification": "физический размер"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "44beca32-c859-31db-8527-e2926a880347",
                    "sense_definition": "The scope or range of something, especially regarding knowledge, skill, or experience.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "scope_and_range",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The candidate impressed the interviewers with the <w>breadth</w> of her knowledge in marketing.",
                            "target_lang_translations": {
                                "ru": "Кандидат впечатлила интервьюеров <w>широтой</w> своих знаний в маркетинге."
                            }
                        },
                        {
                            "text": "The university offers a great <w>breadth</w> of experience for students interested in research.",
                            "target_lang_translations": {
                                "ru": "Университет предлагает огромный <w>объем</w> опыта для студентов, интересующихся исследованиями."
                            }
                        }
                    ],
                    "synonyms": [
                        "extent",
                        "range",
                        "scope",
                        "size"
                    ],
                    "common_phrases": [
                        "breadth of knowledge",
                        "breadth of experience"
                    ],
                    "target_lang_definitions": {
                        "ru": "Масштаб или диапазон чего-либо, особенно в отношении знаний, навыков или опыта."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "широта",
                                "target_lang_sense_clarification": "кругозор, диапазон знаний"
                            },
                            {
                                "target_lang_word": "размах",
                                "target_lang_sense_clarification": "масштаб деятельности"
                            },
                            {
                                "target_lang_word": "объем",
                                "target_lang_sense_clarification": "количество или величина знаний"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6d0967cb-297d-3626-bb9d-838fb4bc33d7",
                    "sense_definition": "A piece of fabric or material of a standard width.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "textiles",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She needed one more <w>breadth</w> of silk to finish sewing the curtains.",
                            "target_lang_translations": {
                                "ru": "Ей понадобилось еще одно <w>полотнище</w> шелка, чтобы закончить шить шторы."
                            }
                        },
                        {
                            "text": "The dress was made by joining several <w>breadths</w> of linen together.",
                            "target_lang_translations": {
                                "ru": "Платье было сшито путем соединения нескольких <w>полотнищ</w> льна вместе."
                            }
                        }
                    ],
                    "common_phrases": [
                        "breadth of fabric"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отрез ткани или материала стандартной ширины."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "полотнище",
                                "target_lang_sense_clarification": "кусок ткани в полную ширину"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0d7859fa-85c1-37e8-9d89-7ee2f27caed3",
                    "sense_definition": "A style in painting where details are subordinated to the harmony of the whole composition.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "art_terminology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist achieved a remarkable <w>breadth</w> in his landscape by avoiding unnecessary details.",
                            "target_lang_translations": {
                                "ru": "Художник добился поразительной <w>широты</w> в своем пейзаже, избегая ненужных деталей."
                            }
                        },
                        {
                            "text": "Critics praised the <w>breadth</w> of the brushwork which unified the entire canvas.",
                            "target_lang_translations": {
                                "ru": "Критики хвалили <w>размах</w> кисти, который объединил все полотно."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical term in art"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Стиль в живописи, где детали подчинены гармонии всей композиции."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "широта",
                                "target_lang_sense_clarification": "манера письма без мелкой детализации"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b4c2825a-0621-3aed-a409-03be8cd4c231",
                    "sense_definition": "The length of the longest path between two vertices in a graph.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mathematics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In graph theory, calculating the <w>breadth</w> helps determine the network's diameter.",
                            "target_lang_translations": {
                                "ru": "В теории графов вычисление <w>ширины</w> помогает определить диаметр сети."
                            }
                        },
                        {
                            "text": "The algorithm was designed to find the maximum <w>breadth</w> of the given tree structure.",
                            "target_lang_translations": {
                                "ru": "Алгоритм был разработан для поиска максимальной <w>ширины</w> данной древовидной структуры."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "mathematical term"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Длина самого длинного пути между двумя вершинами в графе."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ширина",
                                "target_lang_sense_clarification": "математическая характеристика графа"
                            }
                        ]
                    }
                }
            ]
        }
