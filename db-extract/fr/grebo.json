                    {
                        "sense_id": "3095ae2a-3203-3a29-bda8-5a288257184c",
                        "entry_id": "4dd6673e-7680-33fb-a4cc-9916abae2410",
                        "glosses": [
                            "Personne membre de l’ethnie grebo."
                        ],
                        "tags": [
                            "Ethnonyme"
                        ],
                        "examples": [
                            {
                                "example_id": "2f9e463c-8ecb-43ae-bf7b-0c36818ad7d2",
                                "sense_id": "3095ae2a-3203-3a29-bda8-5a288257184c",
                                "text": "Les Grebo formaient une population de plus de 150 000 personnes occupant la rive libérienne du bas Cavally et faisant donc face au bloc krou ivoirien."
                            },
                            {
                                "example_id": "a4be6ad1-106f-461e-867f-16d30b7876e3",
                                "sense_id": "3095ae2a-3203-3a29-bda8-5a288257184c",
                                "text": "La principale explication est l’hostilité réciproque entre les sous-groupes grebo et entre les Grebo et leurs voisins ; à quoi s’ajoutent l’attrait de certains articles de commerce et la présence de l’escadre américaine anti-négrière."
                            }
                        ]
                    }
