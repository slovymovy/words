                        "examples": [
                            {
                                "example_id": "93e9a18c-4bac-4d64-9ead-90a2d8bc63a3",
                                "sense_id": "53b8278f-986e-3347-a163-8acffe8c411f",
                                "text": "„Bei den Kämpfen in Italien begegnete er dem Reitergeneral Murat und erreichte es, vom Fußvolk in die Reiterei aufzusteigen.“"
                            },
                            {
                                "example_id": "1bd30c63-0291-41ef-817d-c550e5201b6f",
                                "sense_id": "53b8278f-986e-3347-a163-8acffe8c411f",
                                "text": "„Er war und blieb ein Reitergeneral, aber er hütete sich davor, mit seiner Kavallerie in die Schusslinie der Infanterie zu geraten.“"
                            }
                        ],
