                "senses": [
                    {
                        "sense_id": "bb0ddadb-693f-3508-b8ee-d146d60092cc",
                        "entry_id": "35f63408-7590-318f-8052-4f65b7fcc515",
                        "glosses": [
                            "Palais de justice."
                        ],
                        "tags": [
                            "Justice"
                        ],
                        "examples": [
                            {
                                "example_id": "6f087d9c-75a4-4b0f-9fa0-87dd4320d4f4",
                                "sense_id": "bb0ddadb-693f-3508-b8ee-d146d60092cc",
                                "text": "Der Prozeß findet gegenwärtig im Nürnberger Justizpalast statt, ein Stockwerk höher geht die Verhandlung gegen die nationalsozialistischen Aerzte vor sich.",
                                "translation": "Le procès se déroule actuellement au palais de justice de Nuremberg, tandis qu'à l'étage supérieur se tient le procès des médecins nazis."
                            },
                            {
                                "example_id": "442ae648-0b2b-44d2-86fa-59d457529a54",
                                "sense_id": "bb0ddadb-693f-3508-b8ee-d146d60092cc",
                                "text": "Die öffentliche Meinung war entschieden gegen die Angeklagten, fast täglich fanden vor dem Justizpalast Demonstrationen statt. Wie jedesmal wurde der Ruf nach der Todesstrafe laut.",
                                "translation": "L'opinion publique était très remontée contre les accusés, des manifestations avaient lieu presque chaque jour devant le Palais de justice. Des voix s’élevèrent, comme à chaque fois, pour demander le rétablissement de la peine de mort."
                            }
                        ]
                    }
