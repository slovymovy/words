                                    {
                                        "sense_id": "74bf91bc-08f2-3ea7-a6b2-66e840a0e814",
                                        "entry_id": "407d7d0e-2aa9-35a9-b4e2-9d71abfdb2bd",
                                        "glosses": [
                                            "Free of flaws or imperfections; unsullied."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b9714f2-30b0-4941-82e1-3a08ff56779a",
                                                "sense_id": "74bf91bc-08f2-3ea7-a6b2-66e840a0e814",
                                                "text": "Such was the origin of a friendship as warm and pure as any that ancient or modern history records."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4192aff4-3b7a-3e6c-b173-9812090eda1d",
                                        "entry_id": "407d7d0e-2aa9-35a9-b4e2-9d71abfdb2bd",
                                        "glosses": [
                                            "Free of foreign material or pollutants."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c27f07db-2f3f-4a6b-ba59-1358b3ed3543",
                                                "sense_id": "4192aff4-3b7a-3e6c-b173-9812090eda1d",
                                                "text": "A guinea is pure gold if it has in it no alloy."
                                            },
                                            {
                                                "example_id": "32194e45-9da4-4fb7-bfe8-ac8e1a3b9a2e",
                                                "sense_id": "4192aff4-3b7a-3e6c-b173-9812090eda1d",
                                                "text": "As for the rest, the air here is said to be purer than elsewhere in Ireland; the water of the Nore is beautifully transparent; and the bogless state of the land helps out the rhyme."
                                            },
                                            {
                                                "example_id": "4c1b0ac8-9ca4-46c8-9c5f-ee63167daa35",
                                                "sense_id": "4192aff4-3b7a-3e6c-b173-9812090eda1d",
                                                "text": "\"Hetch Hetchy water is the purest, wholly unpolluted, and forever unpollutable.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c068a1f-69e8-32de-b6df-59dd4bb29d49",
                                        "entry_id": "407d7d0e-2aa9-35a9-b4e2-9d71abfdb2bd",
                                        "glosses": [
                                            "Free of immoral behavior or qualities; clean."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4cc5a41-c31d-40ba-9b50-518519874e84",
                                                "sense_id": "9c068a1f-69e8-32de-b6df-59dd4bb29d49",
                                                "text": "Laye hondes sodenly on no man nether be part taker of wother mens synnes. Kepe thy silfe pure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f9a705d4-d6d6-37ec-9042-e8fa98df53d2",
                                        "entry_id": "407d7d0e-2aa9-35a9-b4e2-9d71abfdb2bd",
                                        "glosses": [
                                            "Mere; that and that only."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ace7b81-f047-4f52-900c-6686dcbf569f",
                                                "sense_id": "f9a705d4-d6d6-37ec-9042-e8fa98df53d2",
                                                "text": "That idea is pure madness!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "81d3ae45-b2eb-3c75-b274-3834290fa654",
                                        "entry_id": "407d7d0e-2aa9-35a9-b4e2-9d71abfdb2bd",
                                        "glosses": [
                                            "Done for its own sake instead of serving another branch of science."
                                        ],
                                        "tags": [
                                            "of a branch of science"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "03b19cb6-d7b0-4e4e-9c53-d060396f5f1d",
                                                "sense_id": "81d3ae45-b2eb-3c75-b274-3834290fa654",
                                                "text": "The [Isaac] Newton that emerges from the [unpublished] manuscripts is far from the popular image of a rational practitioner of cold and pure reason. The architect of modern science was himself not very modern. He was obsessed with alchemy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "db18e43b-5c70-3332-ad5c-10525a193dec",
                                        "entry_id": "407d7d0e-2aa9-35a9-b4e2-9d71abfdb2bd",
                                        "glosses": [
                                            "Of a single, simple sound or tone; said of some vowels and the unaspirated consonants."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "363565a7-0f00-3906-86d9-d8b3bd1cf1bc",
                                        "entry_id": "407d7d0e-2aa9-35a9-b4e2-9d71abfdb2bd",
                                        "glosses": [
                                            "Without harmonics or overtones; not harsh or discordant."
                                        ],
                                        "tags": [
                                            "of sound"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ae8872f5-f8b8-3b4a-be2e-a2e4b4439c7d",
                                        "entry_id": "407d7d0e-2aa9-35a9-b4e2-9d71abfdb2bd",
                                        "glosses": [
                                            "A lot of."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "08143e54-ac38-401d-ad01-bbd850d03843",
                                                "sense_id": "ae8872f5-f8b8-3b4a-be2e-a2e4b4439c7d",
                                                "text": "Well when ah's youngah, ah'd just light a candle rahn de dinna table play pure crazy 8s and spades vif my brotha til we lot dozed off..."
                                            }
