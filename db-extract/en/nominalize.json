                                        "examples": [
                                            {
                                                "example_id": "ab22bf76-e422-45cc-b773-ee9bc19fd9c4",
                                                "sense_id": "9aed2164-e700-3e92-8a9f-9825e0eade7e",
                                                "text": "Dans les tournures « le beau », « le rare », « l'unique », l'adjectif est nominalisé et prend un sens abstrait."
                                            },
                                            {
                                                "example_id": "9654fd0c-7365-438e-8865-2631a62688ee",
                                                "sense_id": "9aed2164-e700-3e92-8a9f-9825e0eade7e",
                                                "text": "Ce participe passé peut se nominaliser."
                                            }
                                        ]
