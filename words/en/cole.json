        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1d57a750-5952-3ff7-b95f-d630e579e3c9",
                    "sense_definition": "A plant of the Brassica genus, such as cabbage or rape.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmer planted a field of <w>cole</w> to feed the livestock in winter.",
                            "target_lang_translations": {
                                "ru": "Фермер засадил поле <w>капустой</w>, чтобы кормить скот зимой.",
                                "fr": "L'agriculteur a planté un champ de <w>choux</w> pour nourrir le bétail en hiver."
                            }
                        },
                        {
                            "text": "In older texts, ordinary cabbage is often referred to simply as <w>cole</w>.",
                            "target_lang_translations": {
                                "ru": "В старых текстах обычную капусту часто называют просто <w>капустой</w>.",
                                "fr": "Dans les textes anciens, le chou ordinaire est souvent désigné simplement par le terme <w>chou</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "cabbage",
                        "brassica"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "or botanical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Растение рода Brassica, например, капуста или рапс.",
                        "fr": "Une plante du genre Brassica, comme le chou ou le colza."
                    },
                    "translations": {
