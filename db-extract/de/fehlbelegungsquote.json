                "senses": [
                    {
                        "sense_id": "36ab74e7-b4a5-3100-9dcc-59eef3c5b8ae",
                        "entry_id": "07ff66b3-5af5-326f-8edf-95bfbd00fcd6",
                        "glosses": [
                            "Anteil vom Staat geförderter Mietwohnungen, die von nicht Berechtigten bewohnt werden (und damit diese Wohnungen für die tatsächlich Berechtigten mit niedrigem Einkommen blockieren)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2fdf3046-3a55-4dab-b7d4-86ea45d01bd9",
                                "sense_id": "36ab74e7-b4a5-3100-9dcc-59eef3c5b8ae",
                                "text": "„Ein Problem sei auch, dass zu viele Sozialwohnungen von Menschen bewohnt würden, die eigentlich keine Sozialwohnung benötigten, sagte Föst. »Wir reden von Fehlbelegungsquoten zwischen 30 und 50 Prozent, das bedeutet, Wohnungen werden von Menschen belegt, die eigentlich gar keinen Anspruch auf diesen sozialen Wohnungsbau haben.«“"
                            },
                            {
                                "example_id": "5d084651-5204-4af5-aec7-b48869346869",
                                "sense_id": "36ab74e7-b4a5-3100-9dcc-59eef3c5b8ae",
                                "text": "„Als Hauptargument führt das IW die hohe Fehlbelegungsquote der Sozialwohnungen an. Gestützt auf eine Panelbefragung aus dem Jahr 2013 konstatiert die Studie eine Fehlbelegungsquote von 54 Prozent: […].“"
                            },
                            {
                                "example_id": "e3d9ba66-4cfd-48a8-a2f5-b1a63926d158",
                                "sense_id": "36ab74e7-b4a5-3100-9dcc-59eef3c5b8ae",
                                "text": "„Angesichts einer anzunehmenden Fehlbelegungsquote von mehr als 50 Prozent dürfen administrative Maßnahmen, wie die Anpassung der Mieten an die tatsächliche finanzielle Leistungsfähigkeit der Mieter, die sogenannte Fehlbelegungsabgabe, kein Tabu sein.“"
                            },
                            {
                                "example_id": "8e5015b2-721a-4ba4-9af8-8adb525cb8da",
                                "sense_id": "36ab74e7-b4a5-3100-9dcc-59eef3c5b8ae",
                                "text": "„Viele Punkte des Gutachtens hält der Verband für schlecht recherchiert und methodisch fragwürdig, etwa die Ermittlung der Fehlbelegungsquote.“"
                            },
                            {
                                "example_id": "2ea66d3e-6541-4a7b-a67d-c7a3e2b8b9c1",
                                "sense_id": "36ab74e7-b4a5-3100-9dcc-59eef3c5b8ae",
                                "text": "„Die hohe Fehlbelegungsquote bei den 17 gemeindeeigenen Sozialwohnungen ist Christa Kürzinger-Probst ein Dorn im Auge.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
