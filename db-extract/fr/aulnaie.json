                                "target_senses": [
                                    {
                                        "sense_id": "1974e458-897a-3841-9179-336136ceb24e",
                                        "entry_id": "a5252866-59f3-3d20-890c-a9549cd46e2f",
                                        "glosses": [
                                            "bos met elzen Alnus"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "59537925-49bb-42ef-8cd5-632b7a1f1d34",
                                                "sense_id": "1974e458-897a-3841-9179-336136ceb24e",
                                                "text": "Daar zijn kleine aarden heuveltjes waar gewoonlijk watersnippen zitten en dan is het moerassig rondom dat riet, helemaal tot aan het elzenbos daar en tot vlak bij de molen."
                                            },
                                            {
                                                "example_id": "839c282c-3182-4a12-8974-c452893b9f0c",
                                                "sense_id": "1974e458-897a-3841-9179-336136ceb24e",
                                                "text": "Hak je een els om, dan kleurt de stobbe of stam rood. Dit natuurverschijnsel was onverklaarbaar. Toen ontstond het volgende elzenpraatje. Dat rode ‘bloed’ wees op de duivel. Hij greep een geit en sleurde hem het elzenbos in. Het dier zette zich schrap. De boze trok aan zijn staart, die brak af en de elzenwortels zogen het bloed op."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
