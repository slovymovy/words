                                        "examples": [
                                            {
                                                "example_id": "f7d37d53-cb4e-4a5b-aba8-fc35bf0fc6c8",
                                                "sense_id": "bda5c96e-4f3d-3cb4-9cf0-9d3cadc41bb8",
                                                "text": "De Nederlandse Arjan Dwarshuis (30) heeft het wereldrecord vogelspotten gebroken. Hij verslaat hiermee het record dat vorig jaar werd gevestigd. Toen spotte een Amerikaan 6042 vogels in een jaar. Arjan fotografeerde gisteren vogel nummer 6119: de Buffy-crowned Wood Partridge."
                                            }
                                        ]
                                    }
                                ]
                            }
