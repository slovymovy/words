                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "antihistaminique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6930c6e5-b3ff-3ec0-a3a9-6d197fd48e63",
                                        "entry_id": "d4eb9bf9-5419-3928-9800-994b8e6d25d6",
                                        "glosses": [
                                            "Médicament qui sert à réduire ou à éliminer les effets de l'histamine, un médiateur chimique endogène libéré, entre autres, au cours des réactions allergiques."
                                        ],
                                        "tags": [
                                            "Pharmacie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c47d4ac7-0f68-4ffe-859c-57aa4336a2d9",
                                                "sense_id": "6930c6e5-b3ff-3ec0-a3a9-6d197fd48e63",
                                                "text": "Outre le GHB, de nombreuses substances sont utilisées pour soumettre chimiquement une personne. Des drogues, comme le GBL, l’ecstasy ou la MDMA, mais aussi des médicaments comme les antihistaminiques ou les benzodiazépines (Valium, Xanax…)."
                                            },
                                            {
                                                "example_id": "9ac7f1dc-6418-4273-84d9-7989ba1667dc",
                                                "sense_id": "6930c6e5-b3ff-3ec0-a3a9-6d197fd48e63",
                                                "text": "Parmi eux, l’ébastine, un antihistaminique (utilisé pour le traitement des rhinites ou de l’urticaire) et l’atovaquone (utilisée dans le traitement du paludisme)."
                                            },
                                            {
                                                "example_id": "e87266f9-8938-4a49-b8f1-57943e6e95f3",
                                                "sense_id": "6930c6e5-b3ff-3ec0-a3a9-6d197fd48e63",
                                                "text": "Un antihistaminique au long cours peut être utilisé ; il convient d’avoir recours aux médicaments les mieux tolérés (non sédatifs, non anticholinergiques)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
