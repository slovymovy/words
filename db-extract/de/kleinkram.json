                "senses": [
                    {
                        "sense_id": "4315da66-42d5-3b9f-a533-9257ceedc59b",
                        "entry_id": "a3cfd0d9-1884-3729-a642-093bb479e76c",
                        "glosses": [
                            "Menge kleiner Dinge"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d34d34c7-101f-4be2-bb8d-a1caa8d00b89",
                                "sense_id": "4315da66-42d5-3b9f-a533-9257ceedc59b",
                                "text": "Der Kleinkram kommt in die Schublade."
                            },
                            {
                                "example_id": "4abd0bef-789c-4dd0-89d5-1e317fcfe300",
                                "sense_id": "4315da66-42d5-3b9f-a533-9257ceedc59b",
                                "text": "„Ihre Mutter hatte schon recht, sie brauchte einige Sachen, aber vor allem Kleinkram: Geschirr und Besteck.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d546628e-1f72-3f84-8452-56fb88da098e",
                        "entry_id": "a3cfd0d9-1884-3729-a642-093bb479e76c",
                        "glosses": [
                            "unbedeutende Angelegenheit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3097ab2-7e9c-46b3-ab47-91b0024995e1",
                                "sense_id": "d546628e-1f72-3f84-8452-56fb88da098e",
                                "text": "„Wir hingen alle nur rum und warteten auf den Tod und vertrieben uns die Zeit mit Kleinkram.“"
                            },
                            {
                                "example_id": "6fb1f326-f8d6-4cd3-a115-acd347428952",
                                "sense_id": "d546628e-1f72-3f84-8452-56fb88da098e",
                                "text": "„Klar, das ist ein Mann, der zu leben weiß, sich wenig um Kleinkram wie Gesetze schert und im Privatleben wie ein Hollywoodstar verhält.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
