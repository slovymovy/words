{
    "word_family": [
        "hoeing"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a357bb71-0f37-3ec5-96d0-206ec240d975",
                    "sense_definition": "An agricultural hand tool with a long handle and a flat blade used for digging or removing weeds.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "gardening_tool",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "For their organic row crops, they do the weeding with <w>hoes</w>.",
                            "target_lang_translations": {
                                "ru": "На своих экологических грядках они пропалывают сорняки <w>тяпками</w>."
                            }
                        },
                        {
                            "text": "My grandfather broke up the dry soil in the vegetable patch with a long-handled <w>hoe</w>.",
                            "target_lang_translations": {
                                "ru": "Мой дедушка взрыхлил сухую землю на огороде длинной <w>мотыгой</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "garden hoe"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сельскохозяйственный ручной инструмент с длинной рукояткой и плоским лезвием для рыхления почвы и прополки сорняков."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мотыга",
                                "target_lang_sense_clarification": "ручное орудие для рыхления и окучивания"
                            },
                            {
                                "target_lang_word": "тяпка",
                                "target_lang_sense_clarification": "лёгкая мотыга для прополки и рыхления"
                            },
                            {
                                "target_lang_word": "сапка",
                                "target_lang_sense_clarification": "разновидность тяпки"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c6e0c946-b5c6-3a5e-9f6f-e381fbd06b24",
                    "sense_definition": "Any of various mechanical implements or machines used for digging or scraping soil.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "construction_machinery",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The operator drove the mechanical <w>hoe</w> over to dig the utility trench.",
                            "target_lang_translations": {
                                "ru": "Оператор подогнал механический <w>экскаватор</w>, чтобы вырыть траншею для коммуникаций."
                            }
                        },
                        {
                            "text": "The construction crew used a heavy <w>hoe</w> to clear the rocky ground.",
                            "target_lang_translations": {
                                "ru": "Строительная бригада использовала тяжёлую <w>землеройную технику</w>, чтобы расчистить каменистый грунт."
                            }
                        }
                    ],
                    "synonyms": [
                        "backhoe"
                    ],
                    "target_lang_definitions": {
                        "ru": "Механическое землеройное орудие или строительная машина (например, экскаватор с обратной лопатой) для копания грунта."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обратная лопата",
                                "target_lang_sense_clarification": "рабочее оборудование экскаватора"
                            },
                            {
                                "target_lang_word": "экскаватор",
                                "target_lang_sense_clarification": "землеройная машина"
                            }
                        ]
                    }
                },
                {
