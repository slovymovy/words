                "senses": [
                    {
                        "sense_id": "82ba58fb-b4c3-3691-960a-36791fadcb49",
                        "entry_id": "165cbf9a-2fa9-399f-be36-e6b130c59275",
                        "glosses": [
                            "zu viel produzierter Wein, der auf dem Markt nicht mehr abgesetzt werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "17594770-146a-47d4-a2e0-426636c57f7b",
                                "sense_id": "82ba58fb-b4c3-3691-960a-36791fadcb49",
                                "text": "„Die Region wurde zwar wieder ein bedeutender Weinproduzent, dem Wein haftete aber das Image eines ‚Billigweins‘ an. Das Languedoc war bis in die 1970er Jahre hauptverantwortlich für einen EG-weiten Produktionsüberschuss, der als ‚Weinsee‘ bekannt wurde.“"
                            },
                            {
                                "example_id": "32719578-4b1c-4de1-9e66-5a36f5ebb649",
                                "sense_id": "82ba58fb-b4c3-3691-960a-36791fadcb49",
                                "text": "„Nicht mehr die Produktion, die Europa jahrelang Rindfleisch- und Butterberge, Milch- und Weinseen beschert hat, wird gefördert, sondern der einzelne Betrieb, wobei auch Belange des Umweltschutzes und des Erhalts der Kulturlandschaft ein Rolle spielen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
