                    }
                ],
                "senses": [
                    {
                        "sense_id": "aec3b629-c68a-330a-accd-96be9ddfa613",
                        "entry_id": "04937b81-e59c-35f5-b5ad-6a2b1b593481",
                        "glosses": [
                            "Relatif à la race."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "37eda1e5-0c86-464d-aafb-59c27d9f2681",
                                "sense_id": "aec3b629-c68a-330a-accd-96be9ddfa613",
                                "text": "Ils sont souvent victimes de discrimination raciale."
                            },
                            {
                                "example_id": "17729e38-329c-4775-9ceb-b62379cc7dd6",
                                "sense_id": "aec3b629-c68a-330a-accd-96be9ddfa613",
                                "text": "A cette époque, aux États Unis, les Blancs qui militent aux côtés des Noirs contre les discriminations raciales, sont progressivement exclus de toute alliance de long terme avec les Noirs. La lutte contre le racisme devient un monopole Noir."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f22d6057-c8e6-4fc9-91a6-964884e80f00",
                        "source_entry_id": "04937b81-e59c-35f5-b5ad-6a2b1b593481",
                        "source_sense_id": "aec3b629-c68a-330a-accd-96be9ddfa613",
                        "target_lang_word": "racial",
