                                    {
                                        "sense_id": "802b649d-14e1-3a1d-a439-76762e8f446e",
                                        "entry_id": "ffafec29-10b6-323a-bd1c-43c86c2684ff",
                                        "glosses": [
                                            "Explosif obtenu par l’action de l’acide nitrique sur la cellulose. (note : elle n’explose que si elle est comprimée, à l’air libre elle brûle.)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "101a91d9-533b-48a0-894c-8985b0c8ade1",
                                                "sense_id": "802b649d-14e1-3a1d-a439-76762e8f446e",
                                                "text": "Il met au point la soie artificielle en 1884 et, en 1880, il est fait chevalier de la Légion d’honneur à titre civil, pour son travail sur le pyroxyle, produit explosif appelé aussi nitrocellulose, qui entre dans la fabrication des munitions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "74da0cb4-9823-3acc-82fa-77b7b31f4c7b",
                                        "entry_id": "ffafec29-10b6-323a-bd1c-43c86c2684ff",
                                        "glosses": [
                                            "Substance utilisée sous forme de collodion pour les premières pellicules photographiques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71a79727-5843-451f-8256-71770da32097",
                                                "sense_id": "74da0cb4-9823-3acc-82fa-77b7b31f4c7b",
                                                "text": "Près de quatre mille boîtiers, cinq mille plaques, et quatre-vingt-cinq kilomètres de pellicule de nitrocellulose furent détruits avant que les autorités puissent intervenir."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
