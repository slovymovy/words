                                        "sense_id": "0b28e094-5ecb-3fe7-bf30-ba8f34698784",
                                        "entry_id": "74a527b0-be77-3b8e-b8d5-09b87fcfc98e",
                                        "glosses": [
                                            "To deteriorate, to get worse, to lose strength or health, to decline in quality.",
                                            "To undergo prolonged reduction in altitude (above the orbited body)."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e540f754-b1ac-48c5-a51c-f8e3b634a243",
                                                "sense_id": "0b28e094-5ecb-3fe7-bf30-ba8f34698784",
                                                "text": "Damaged on lift-off, Skylab was left in orbit until its orbit decayed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "805d6896-17f7-3347-94c9-00cf3b385f08",
                                        "entry_id": "74a527b0-be77-3b8e-b8d5-09b87fcfc98e",
                                        "glosses": [
                                            "To rot, to go bad."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "88c9323a-2200-4126-bf7e-e8162fa8212c",
                                                "sense_id": "805d6896-17f7-3347-94c9-00cf3b385f08",
                                                "text": "The cat's body decayed rapidly."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b663e0e8-5936-323d-8cbc-e923c364a39d",
                                        "entry_id": "74a527b0-be77-3b8e-b8d5-09b87fcfc98e",
                                        "glosses": [
                                            "To change by undergoing fission, by emitting radiation, or by capturing or losing one or more electrons; to undergo radioactive decay."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "50e10599-f46a-4ad2-b47a-9c5d8d0ee4eb",
                                                "sense_id": "b663e0e8-5936-323d-8cbc-e923c364a39d",
                                                "text": "Uranium decays to radium through a long series of steps with a cumulative half-life of 4.4 billion years."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "50492066-557d-3ac2-80b2-ddb1a3a2f8ac",
                                        "entry_id": "74a527b0-be77-3b8e-b8d5-09b87fcfc98e",
                                        "glosses": [
                                            "To undergo optical decay, that is, to relax to a less excited state, usually by emitting a photon or phonon."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
