                        ]
                    },
                    {
                        "translation_id": "fd2cd6c0-39a6-4991-be54-ecc64b077635",
                        "source_entry_id": "f51b0f31-d166-395e-b125-2a08ac2b97ed",
                        "source_sense_id": "9741b2ee-22e8-3966-a5bf-918773fe4a4a",
                        "target_lang_word": "Demagoge",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Demagoge",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "21ca8b5e-6a29-3918-8544-27712e7cba76",
                                        "entry_id": "d8a032bd-c72c-3b43-b944-86346828c434",
                                        "glosses": [
                                            "jemand, der (politische) Hetze betreibt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11b706bb-0133-48be-a61c-f1884124a80e",
                                                "sense_id": "21ca8b5e-6a29-3918-8544-27712e7cba76",
                                                "text": "Manche Politiker haben das Zeug zum Demagogen."
                                            },
                                            {
                                                "example_id": "1383c123-e9ee-4c41-9ed8-c3ede119920a",
                                                "sense_id": "21ca8b5e-6a29-3918-8544-27712e7cba76",
                                                "text": "„Das Volk aber stand unter der Kontrolle seiner Klientelbindungen, und wenn es ein aufsässiger Magistrat auch verstand, diese Hürde zu überwinden und einen Entscheid in seinem Sinne in die Wege zu leiten, konnte der Senat die Angelegenheit durch einen loyalen Tribunen verhindern. Demagogen hatten geringen Spielraum.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7394e7e8-7e72-4ed9-9ea1-203ce7692c5c",
                        "source_entry_id": "f51b0f31-d166-395e-b125-2a08ac2b97ed",
                        "source_sense_id": "9741b2ee-22e8-3966-a5bf-918773fe4a4a",
                        "target_lang_word": "демагог",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "демагог",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "428b856a-bdfc-34a7-bef1-d639da616c86",
                                        "entry_id": "4829b5a1-41f4-3084-ada8-d57505a74de2",
                                        "glosses": [
                                            "истор. · политический деятель, народный вождь"
                                        ],
                                        "tags": [
                                            "в Древней Греции"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee24cd4a-489e-41ce-a01b-8f2fbd2b8fbc",
                                                "sense_id": "428b856a-bdfc-34a7-bef1-d639da616c86",
                                                "text": "Преданность харизме пророка или вож­дя на войне, или выдающегося демагога в народном собрании (Ekklesia) или в парламенте как раз и озна­чает, что человек подобного типа считается внутренне «призванным» руководителем людей, что последние под­чиняются ему не в силу обычая или установления, но потому, что верят в него."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d50c98ae-7ceb-3e1c-ba44-34f2a185adf0",
                                        "entry_id": "4829b5a1-41f4-3084-ada8-d57505a74de2",
                                        "glosses": [
                                            "неодобр. тот, кто в рассуждениях, спорах, высказываниях использует пустые, не основанные на фактах фразы"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5301d307-3a60-4018-ad49-bc6b51237ea8",
                                                "sense_id": "d50c98ae-7ceb-3e1c-ba44-34f2a185adf0",
                                                "text": "И где такие виданы министры? // Кто так из них толпе кадить бы мог? // Я допущу: успехи наши быстры, // Но где ж у нас министер-демагог?"
                                            },
                                            {
                                                "example_id": "e5d0c1a3-9fd9-46a0-bef6-59ff19e788f2",
                                                "sense_id": "d50c98ae-7ceb-3e1c-ba44-34f2a185adf0",
                                                "text": "Она таилась не в идиотских, наглых и бесстыдных газетных статьях, не в демагогах, болтающих на митингах и расхаживающих по зданию горкома в старых свитерах и джинсах, не в этих пустомелях, отрастивших неопрятные бороденки и критикующих всех и вся."
                                            },
                                            {
                                                "example_id": "0695168e-7d27-43d3-9773-92889b0ad7e0",
                                                "sense_id": "d50c98ae-7ceb-3e1c-ba44-34f2a185adf0",
                                                "text": "Василий Иванович был очень пьющим человеком, но пьяным, в общепринятом понимании, я его не видел. Была у него особенность: чем больше он пил, тем словоохотливее становился. То есть у него просто не закрывался рот. Притом он бывал таким пьяным демагогом. Эдаким начальственно-советским демагогом."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
