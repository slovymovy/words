                {
                    "sense_id": "0f0f972d-8b1f-3a32-82ea-ad86cf1c2d34",
                    "sense_definition": "present participle and gerund of <w>furrow</w>",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He listened carefully while <w>furrowing</w> his brow in deep concentration.",
                            "target_lang_translations": {
                                "es": "Escuchaba con atención mientras <w>fruncía</w> el ceño en profunda concentración."
                            }
                        },
                        {
                            "text": "The tractor was slowly <w>furrowing</w> the dry fields before planting season.",
                            "target_lang_translations": {
                                "es": "El tractor estaba <w>surcando</w> lentamente los campos secos antes de la temporada de siembra."
                            }
                        }
                    ],
                    "common_phrases": [
                        "furrowing brow",
                        "furrowing forehead"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle and gerund"
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Participio presente y gerundio de arrugar (el ceño/la frente) o surcar/arar (la tierra)."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "frunciendo",
                                "target_lang_sense_clarification": "el ceño o la frente"
                            },
                            {
                                "target_lang_word": "arrugando",
                                "target_lang_sense_clarification": "la frente o la piel"
                            },
                            {
                                "target_lang_word": "surcando",
                                "target_lang_sense_clarification": "la tierra o una superficie"
                            },
                            {
                                "target_lang_word": "arando",
                                "target_lang_sense_clarification": "haciendo surcos en la tierra"
                            }
                        ]
