                "senses": [
                    {
                        "sense_id": "8028dffb-9d4d-3924-aaa8-6db0ce879688",
                        "entry_id": "4cd783a1-0ab7-3211-a2ba-98f5b500c07d",
                        "glosses": [
                            "Baiser par la force, en parlant d’un singe."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "1f77eeef-f4b1-454c-bd14-54a6bdb4ac53",
                                "sense_id": "8028dffb-9d4d-3924-aaa8-6db0ce879688",
                                "text": "Faire bouquer un singe."
                            }
                        ]
                    },
                    {
                        "sense_id": "55405a05-f549-3115-9b70-4ed9d7bcce2f",
                        "entry_id": "4cd783a1-0ab7-3211-a2ba-98f5b500c07d",
                        "glosses": [
                            "Se servir d’un chien ou d’un furet pour faire sortir un animal de son terrier."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "05de2991-9d3c-41c1-9967-78b4374cbad3",
                                "sense_id": "55405a05-f549-3115-9b70-4ed9d7bcce2f",
                                "text": "Faire bouquer le blaireau."
                            }
                        ]
                    },
                    {
                        "sense_id": "398dd6f6-b030-3522-b4b5-5dcc56f8b82d",
                        "entry_id": "4cd783a1-0ab7-3211-a2ba-98f5b500c07d",
                        "glosses": [
                            "Céder à la force, forcer."
                        ],
                        "tags": [
                            "familiar",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "4f6b89f5-c2b1-4bdb-ad01-652594d9ff04",
                                "sense_id": "398dd6f6-b030-3522-b4b5-5dcc56f8b82d",
                                "text": "J’ai eu le plaisir de faire bouquer par ma faveur un jeune homme aussi noble et aussi riche que je suis gueux et plébéien."
                            },
                            {
                                "example_id": "99bff14c-7aa9-42ba-a5ed-83ee4d09a3dd",
                                "sense_id": "398dd6f6-b030-3522-b4b5-5dcc56f8b82d",
                                "text": "J'ai déjà fait bouquer messieurs du domaine, je l'emporterai encore sur eux, car j'ai raison."
                            },
                            {
                                "example_id": "8ea5c287-a0f5-4fb8-88ba-539dfd3009e6",
                                "sense_id": "398dd6f6-b030-3522-b4b5-5dcc56f8b82d",
                                "text": "Faire bouquer quelqu’un, le forcer à faire quelque chose qui lui déplait, ou encore, l’empêcher de faire ce qu’il voulait."
                            }
                        ]
                    }
                ],
