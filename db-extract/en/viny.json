                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b94fec3-75f8-4061-8b31-b6f3c45b1113",
                                "sense_id": "0e9ff467-8699-347a-b33a-9456b57f4475",
                                "text": "Saru boast her favor’d soil, / Orange walks, and viny fields, / That reward their planter’s toil / With every fruit luxuriance yields."
                            },
                            {
                                "example_id": "a9391f36-3f37-441e-b91c-ae890d6dd167",
                                "sense_id": "0e9ff467-8699-347a-b33a-9456b57f4475",
                                "text": "His mother didn’t mind Jacey’s excursions around the viny woods and the fields that surrounded her cottage in the hills—free herself, she wanted and expected her son to enjoy the same life, and she let him run as he would."
                            },
                            {
                                "example_id": "30e5cf39-cd2c-4678-b4a1-edd631d91a35",
                                "sense_id": "0e9ff467-8699-347a-b33a-9456b57f4475",
                                "text": "This side of Aptos is just what the doctor ordered—a flat, open beach; pretty neighborhoods tucked into green, viny hills; and a handful of motels and restaurants within view of the water."
                            }
                        ]
                    }
