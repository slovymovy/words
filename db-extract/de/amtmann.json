                            "accusative",
                            "plural"
                        ],
                        "form": "die Amtmanns"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "61ef58a9-9ebd-38c9-aff7-25c2e944f3f8",
                        "entry_id": "29634d32-664d-30e7-a8ea-0b516a233267",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "245ede68-be93-4698-9b16-cbc2703cd3d3",
                                "sense_id": "61ef58a9-9ebd-38c9-aff7-25c2e944f3f8",
                                "text": "Frau Amtmann ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "2dfd9ca4-2d7c-492e-ac0c-12b3dba0ee78",
                                "sense_id": "61ef58a9-9ebd-38c9-aff7-25c2e944f3f8",
                                "text": "Herr Amtmann wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "32638c2a-40d7-4c62-b65a-dc8facbc6aac",
                                "sense_id": "61ef58a9-9ebd-38c9-aff7-25c2e944f3f8",
                                "text": "Die Amtmanns kommen heute aus dem Oberpfälzer Wald."
                            },
                            {
                                "example_id": "73a70655-c213-47bd-9666-abadc70cf015",
                                "sense_id": "61ef58a9-9ebd-38c9-aff7-25c2e944f3f8",
                                "text": "Der Amtmann trägt nie die Schals, die die Amtmann ihm strickt."
                            },
                            {
                                "example_id": "9d60597d-4cca-4bee-ac3b-92f40e110e51",
                                "sense_id": "61ef58a9-9ebd-38c9-aff7-25c2e944f3f8",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Amtmann kommt, geht der Herr Amtmann.“"
                            },
                            {
                                "example_id": "1ec69124-a82e-41b9-897f-8323ba511c80",
                                "sense_id": "61ef58a9-9ebd-38c9-aff7-25c2e944f3f8",
                                "text": "Amtmann kommt und geht."
                            },
                            {
                                "example_id": "36dbff3c-2465-4dc8-be4a-66c70e02110b",
                                "sense_id": "61ef58a9-9ebd-38c9-aff7-25c2e944f3f8",
                                "text": "Amtmanns kamen, sahen und siegten."
                            },
                            {
                                "example_id": "4a9b02f8-6f26-4590-ad7a-b22fc69f112f",
                                "sense_id": "61ef58a9-9ebd-38c9-aff7-25c2e944f3f8",
                                "text": "An verregneten Herbsttagen ist Familie Amtmanns liebste Beschäftigung das Bemalen von Hühnereiern."
                            },
                            {
                                "example_id": "751c2139-f282-431f-8dba-fa76191a6688",
                                "sense_id": "61ef58a9-9ebd-38c9-aff7-25c2e944f3f8",
                                "text": "An verschneiten Wintertagen ist die liebste Beschäftigung von Familie Amtmann das Schmücken von Weihnachtsbäumen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
