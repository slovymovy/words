                            {
                                "example_id": "6fd4d754-f449-47ed-a8fd-e943594061df",
                                "sense_id": "3aaf2979-2d73-3792-ae9c-e749d6615683",
                                "text": "Tant de puissantes molécules dans l’écorce, la médulle et les feuilles dont les effets restent à découvrir."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7e29482b-d9c8-46f6-b05c-6f06ce84592c",
