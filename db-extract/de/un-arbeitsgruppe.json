                ],
                "senses": [
                    {
                        "sense_id": "1cc221ab-0ecf-3dd3-be10-0090d7a330c7",
                        "entry_id": "630c2e9e-e1c1-3a9f-b4f9-49d7bf51ec5c",
                        "glosses": [
                            "mehrere Angehörige der Vereinten Nationen, die zusammen etwas bewirken; eine oder mehrere Aufgaben bewältigen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4a59334-1cd5-40ee-9b40-6983e1f56a20",
                                "sense_id": "1cc221ab-0ecf-3dd3-be10-0090d7a330c7",
                                "text": "„Die UN-Hochkommissarin für Menschenrechte stattete Algerien im September einen Besuch ab und diskutierte mit den Behörden den bereits seit langem anstehenden Besuch der UN-Arbeitsgruppe zur Frage des Verschwindenlassens von Personen.“"
                            },
                            {
                                "example_id": "33127bda-14bd-414f-8b6a-5679c73e4d40",
                                "sense_id": "1cc221ab-0ecf-3dd3-be10-0090d7a330c7",
                                "text": "„Die in der UN-Arbeitsgruppe versammelten Experten diskutieren derzeit auch, welche Möglichkeiten es gibt, um einen Asteroiden auf Erdkurs abzulenken.“"
                            },
                            {
                                "example_id": "18c7165c-16fb-4d1d-8041-5d4d94e9772b",
                                "sense_id": "1cc221ab-0ecf-3dd3-be10-0090d7a330c7",
                                "text": "„Als Ziel aller Maßnahmen gegen die drohende Klimakatastrophe wird in dem von einer UN-Arbeitsgruppe vorgelegten Dokument sowohl eine Begrenzung des globalen Temperaturanstiegs um höchstens 1,5 Grad wie auch um zwei Grad genannt.“"
                            },
                            {
                                "example_id": "ab75a061-05f8-4429-a548-85ef06f42c06",
                                "sense_id": "1cc221ab-0ecf-3dd3-be10-0090d7a330c7",
                                "text": "„Seit 17 Jahren, seit 1993, tagt die UN-Arbeitsgruppe zur Reform des Sicherheitsrats.“"
                            },
                            {
                                "example_id": "150a8976-6ba0-4095-b604-833b3174f62b",
                                "sense_id": "1cc221ab-0ecf-3dd3-be10-0090d7a330c7",
                                "text": "„Die schwarz geschminkte Figur, die beim niederländischen Sinterklaas-Fest traditionell als Helfer des heiligen Nikolaus den guten Kindern Geschenke bringt und den bösen mit der Rute droht, steht unter Rassismus-Verdacht: Die Figur verunglimpfe Menschen schwarzer Hautfarbe, so auch der Vorwurf einer UN-Arbeitsgruppe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
