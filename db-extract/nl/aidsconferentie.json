                        "examples": [
                            {
                                "example_id": "80819545-af54-45fc-9dbc-c1ec1f12dd6d",
                                "sense_id": "39583df0-bae8-3422-a1ab-9168543e23d5",
                                "text": "De conferentie is de voorloper van de grote tweejaarlijkse internationale aidsconferentie 'AIDS' in 2018. Vorig jaar werd deze gehouden in het Australische Melbourne. Meerdere deelnemers, onder wie de internationaal vermaarde aidsonderzoeker Joep Lange uit Nederland, kwamen toen om bij de ramp met vlucht MH17."
                            },
                            {
                                "example_id": "8b3fa24d-87f7-4d8f-b146-ee1d143fb765",
                                "sense_id": "39583df0-bae8-3422-a1ab-9168543e23d5",
                                "text": "Amsterdam is in 2018 de gastheer van een grote tweejaarlijkse internationale aidsconferentie. In de RAI komen dan ongeveer 20.000 experts bij elkaar om te praten en kennis uit te wisselen over de strijd tegen aids, maakte het bureau Amsterdam Marketing vrijdag bekend."
                            }
