                ],
                "senses": [
                    {
                        "sense_id": "c73f5cfe-3678-314c-8802-94c0cdf17cb1",
                        "entry_id": "acc33265-f034-3946-b14f-bbac09e18c7b",
                        "glosses": [
                            "Of or relating to anarchism or anarchy."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b10738c1-76b9-41d0-88b1-ff18ce185038",
                                "sense_id": "c73f5cfe-3678-314c-8802-94c0cdf17cb1",
                                "text": "One of the commonest objections to Communism is that men are not good enough to live under a Communist state of things. They would not submit to a compulsory Communism, but they are not yet ripe for free, Anarchistic Communism. […]"
                            },
                            {
                                "example_id": "5b2314c6-4d2e-4cbb-a800-795ac884d800",
                                "sense_id": "c73f5cfe-3678-314c-8802-94c0cdf17cb1",
                                "text": "I don't feel that discouraging people from exploring where they will is in line with anarchistic thought."
                            }
                        ]
                    },
                    {
                        "sense_id": "c20db879-9313-31ef-beaf-113a9433c7a2",
                        "entry_id": "acc33265-f034-3946-b14f-bbac09e18c7b",
                        "glosses": [
                            "Anarchic; chaotic or free-spirited."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5e0cf26-46ab-47ed-abbe-1a52c7f6129b",
                                "sense_id": "c20db879-9313-31ef-beaf-113a9433c7a2",
                                "text": "With the exception of the leader's boppish title tune, the album is filled with anarchistic jazz reduxes of Nichols, Ellington, Kurt Weill, and Cole Porter."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0c2ffa1e-d2ea-48d9-b971-4bea195a86e7",
