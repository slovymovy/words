                                                "example_id": "29a176b3-8445-4e21-b7df-930073be9ce7",
                                                "sense_id": "53efb721-fee3-3d4e-9908-8e5542153894",
                                                "text": "Le ShinMaywa US-2, un avion amphibie japonais destiné aux opérations de sauvetage en mer, attire de plus en plus d’attention dans le monde."
                                            }
