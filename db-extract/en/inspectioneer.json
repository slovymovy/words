                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a867038-f5b6-4e80-8606-5c1a44aeb3ef",
                                "sense_id": "e61a9b01-8a7c-3cd5-8d27-26d715c87fb1",
                                "text": "He said that all the ship's provisions and stores would be locked up, and the keys given to the inspectioneer […]"
                            },
                            {
                                "example_id": "fe989b6e-45ba-4a17-8431-3967bea9aee4",
                                "sense_id": "e61a9b01-8a7c-3cd5-8d27-26d715c87fb1",
                                "text": "His grandfather had used it to hunt the Greenland whale in the days when the whaling-ships came to the islands for their best inspectioneers."
                            }
                        ]
                    }
