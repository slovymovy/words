                "senses": [
                    {
                        "sense_id": "3da420a7-f64f-3a19-8cd5-0deecc5b17e2",
                        "entry_id": "9ba615e7-353c-3bd7-bb95-fd8ff2ab3cd1",
                        "glosses": [
                            "État de ce qui est irréversible."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0f3911a-695a-4f1a-b261-822631205ccf",
                                "sense_id": "3da420a7-f64f-3a19-8cd5-0deecc5b17e2",
                                "text": "Or, avant même de découvrir les notions d’entropie et d’irréversibilité, notre civilisation a valorisé la flèche du temps par l’idéologie du progrès."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6f5ca321-d069-47f4-bdba-15497d9e2ae9",
                        "source_entry_id": "9ba615e7-353c-3bd7-bb95-fd8ff2ab3cd1",
                        "source_sense_id": "3da420a7-f64f-3a19-8cd5-0deecc5b17e2",
                        "target_lang_word": "Unumkehrbarkeit",
                        "target_lang_code": "de",
