                                "sense_id": "b73c830f-8ecf-370e-8b14-b70160c2a7d3",
                                "text": "daar zou ik een eed op willen doen : j’en jurerais"
                            },
                            {
                                "example_id": "93e87f43-2ef6-4812-a46b-58b621650aec",
                                "sense_id": "b73c830f-8ecf-370e-8b14-b70160c2a7d3",
                                "text": "hij zwoer een dure eed : il jura solennellement"
                            },
                            {
                                "example_id": "c724187f-771c-4802-80f0-71a8405d764a",
                                "sense_id": "b73c830f-8ecf-370e-8b14-b70160c2a7d3",
                                "text": "een eed op de bijbel afleggen : jurer sur la Bible"
                            },
                            {
                                "example_id": "3679d3a8-69a2-46b5-80e9-7c4df64ac1f3",
                                "sense_id": "b73c830f-8ecf-370e-8b14-b70160c2a7d3",
                                "text": "een eed afleggen : prêter serment"
                            },
                            {
                                "example_id": "483fe44d-65a9-406f-a3fa-ea1c1ca336a8",
                                "sense_id": "b73c830f-8ecf-370e-8b14-b70160c2a7d3",
                                "text": "iemand een eed afnemen : faire prêter serment à quelqu’un, recevoir le serment"
                            },
                            {
                                "example_id": "b0afe92b-235d-4da9-97b1-18280288f34b",
                                "sense_id": "b73c830f-8ecf-370e-8b14-b70160c2a7d3",
                                "text": "zijn eed breken : violer son serment"
                            },
                            {
                                "example_id": "bb96a75e-6031-4370-a478-44c927622f20",
                                "sense_id": "b73c830f-8ecf-370e-8b14-b70160c2a7d3",
                                "text": "iemand van zijn eed ontheffen : délier quelqu’un de son serment"
                            },
                            {
                                "example_id": "d662eb88-7d6b-491e-a757-5dd08ffc3d4b",
                                "sense_id": "b73c830f-8ecf-370e-8b14-b70160c2a7d3",
                                "text": "iemand onder ede horen : faire témoigner quelqu’un sous serment"
                            },
                            {
                                "example_id": "ba9f8215-0119-4d46-b09b-f8b5f720ec58",
                                "sense_id": "b73c830f-8ecf-370e-8b14-b70160c2a7d3",
                                "text": "onder ede staan : témoigner sous serment"
                            },
                            {
                                "example_id": "87b3b064-f71d-4976-ad05-f70120c584af",
                                "sense_id": "b73c830f-8ecf-370e-8b14-b70160c2a7d3",
                                "text": "onder ede : sous serment, sous la foi du serment"
                            },
                            {
                                "example_id": "d8a3f579-1cc9-443a-9cdb-76edb27fe542",
                                "sense_id": "b73c830f-8ecf-370e-8b14-b70160c2a7d3",
                                "text": "aanvullende eed : serment supplétoire"
                            }
                        ]
