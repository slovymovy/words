                "senses": [
                    {
                        "sense_id": "05b8ab54-2bf2-3f51-bc96-4c63612da799",
                        "entry_id": "08a5ba03-1a7f-33c2-9e0a-b7cd7cf47248",
                        "glosses": [
                            "Concevoir."
                        ],
                        "tags": [
                            "Très rare"
                        ],
                        "examples": [
                            {
                                "example_id": "c36469e4-aeb2-4c41-8d9d-378b8d382b95",
                                "sense_id": "05b8ab54-2bf2-3f51-bc96-4c63612da799",
                                "text": "Conceptionnaliser la mise en œuvre d'une esquisse modélisant l'irrigation."
                            },
                            {
                                "example_id": "faa13dd9-988b-47b8-bad0-4c1bab7cd8c9",
                                "sense_id": "05b8ab54-2bf2-3f51-bc96-4c63612da799",
                                "text": "Un design de fou, pour les amateurs de design comme moi c'est un vrai régal de pouvoir un truc aussi bien conceptionnalisé."
                            }
                        ]
                    },
                    {
                        "sense_id": "06aef312-f80e-3108-92d7-f8e204596e22",
                        "entry_id": "08a5ba03-1a7f-33c2-9e0a-b7cd7cf47248",
                        "glosses": [
                            "Conceptualiser. Note d’usage : Dans cet emploi, il y a confusion avec l'usage du mot conceptualiser, c'est à dire concevoir une abstraction"
                        ],
                        "tags": [
                            "Très rare"
                        ],
                        "examples": [
                            {
                                "example_id": "2d9b7007-71b4-455e-9499-14784cd5c6a3",
                                "sense_id": "06aef312-f80e-3108-92d7-f8e204596e22",
                                "text": "\"Par le contenu de la formation, l'école doit développer la même vision et la même culture chez tous les citoyens. C'est pourquoi, un programme d'enseignement n'est pas neutre. Il est fondé par une idéologie. Il faut d'abord conceptionnaliser le projet de société que nous voulons\", a poursuivi le ministre."
                            }
                        ]
                    }
