            {
                "entry_id": "381e2305-b623-3547-aca4-a0a278c248d8",
                "word": "sticks",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "0f2d68ff-7980-3335-b888-8246e229fc2e",
                        "entry_id": "381e2305-b623-3547-aca4-a0a278c248d8",
                        "glosses": [
                            "rural terrain, especially a woody area; any rural region."
                        ],
                        "tags": [
                            "derogatory",
                            "informal",
                            "plural",
                            "plural-only",
                            "with-definite-article"
                        ],
                        "examples": [
                            {
                                "example_id": "2f07e7c7-ca3b-4807-90f4-eb1952de9ab6",
                                "sense_id": "0f2d68ff-7980-3335-b888-8246e229fc2e",
                                "text": "We had to drive way out into the sticks to visit that customer."
                            },
                            {
                                "example_id": "6079a617-7fb2-43eb-9b95-8b929e241243",
                                "sense_id": "0f2d68ff-7980-3335-b888-8246e229fc2e",
                                "text": "\"How'd your in-laws feel about you marryin' your wife? Maybe you could pass the paper bag test and the comb test, but your old man had dark skin, kinky hair, and he was a dyed-in-wool baptist from out in the sticks.\""
                            }
                        ]
                    },
                    {
                        "sense_id": "a439d5ae-421b-398a-afc6-df165fa0bcec",
                        "entry_id": "381e2305-b623-3547-aca4-a0a278c248d8",
                        "glosses": [
                            "Hurdles or other obstacles to be jumped over."
                        ],
                        "tags": [
                            "plural",
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "4c8abf7f-e9b1-4275-ab62-6cc53380ff3a",
                                "sense_id": "a439d5ae-421b-398a-afc6-df165fa0bcec",
                                "text": "It was a maiden race over the \"sticks,\" and the trainer's instructions were to slip off and make the running throughout."
                            },
                            {
                                "example_id": "8da1922d-4be7-4142-afc1-8ec5d7ba130d",
                                "sense_id": "a439d5ae-421b-398a-afc6-df165fa0bcec",
                                "text": "Do they prefer flat or 'over the sticks' (jump races)? Does the group know what the races with jumps are called?"
                            }
                        ]
                    },
