        "fr-extract.jsonl": [
            {
                "entry_id": "43d08ed6-2955-3a2c-8470-3e9feecbcbf9",
                "word": "affaires",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "71ca9afa-72ab-4078-bfb1-810a0cd58da2",
                        "entry_id": "43d08ed6-2955-3a2c-8470-3e9feecbcbf9",
                        "tags": [
                            "singular"
                        ],
                        "form": "affaire"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "57df0493-80fc-37e5-b4f6-4476436a0c2e",
                        "entry_id": "43d08ed6-2955-3a2c-8470-3e9feecbcbf9",
                        "glosses": [
                            "Pluriel de affaire."
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "af477469-eb68-46dc-a392-62c759bfc4ad",
                                "sense_id": "57df0493-80fc-37e5-b4f6-4476436a0c2e",
                                "text": "Mais voilà, tant qu’il y aura des gogos, il y aura des affaires véreuses, des gens pour les lancer et des « experts » intéressés pour faire de très beaux rapports."
                            }
                        ]
                    },
                    {
                        "sense_id": "68cba30c-0625-3e88-bfd5-cbb17b7e70a3",
                        "entry_id": "43d08ed6-2955-3a2c-8470-3e9feecbcbf9",
                        "glosses": [
                            "Effet personnel, biens propres."
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "e3b877d9-2656-442e-b841-cc414ae6252b",
                                "sense_id": "68cba30c-0625-3e88-bfd5-cbb17b7e70a3",
                                "text": "Touche pas à mes affaires."
                            }
                        ]
                    },
                    {
                        "sense_id": "d2c8ddaa-519c-316a-9594-f3fd51c6bf65",
                        "entry_id": "43d08ed6-2955-3a2c-8470-3e9feecbcbf9",
                        "glosses": [
                            "Toutes les choses qui concernent la fortune et les intérêts du public et des particuliers."
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "e07c9c3b-65fd-472b-8a32-cf6f0c2f782f",
                                "sense_id": "d2c8ddaa-519c-316a-9594-f3fd51c6bf65",
                                "text": "Mais sur le dossier de la banquette opposée, une large feuille de papier, fixée par une épingle à l’étoffe grise, s’offrait à ses regards. Elle portait ces mots :\nChacun ses affaires. Occupez-vous des vôtres. Sinon tant pis pour vous."
                            },
                            {
                                "example_id": "3a1127f1-6796-48e9-814c-55f9bc935b1f",
                                "sense_id": "d2c8ddaa-519c-316a-9594-f3fd51c6bf65",
                                "text": "Affaires publiques, Affaires d’État."
                            },
                            {
                                "example_id": "8f7e80db-9a46-4dde-84b1-cb8095404828",
                                "sense_id": "d2c8ddaa-519c-316a-9594-f3fd51c6bf65",
                                "text": "Ce ministre est chargé de toute la conduite des affaires du royaume."
                            },
                            {
                                "example_id": "71f30610-3491-40fe-9d4a-ac61bb191d69",
                                "sense_id": "d2c8ddaa-519c-316a-9594-f3fd51c6bf65",
                                "text": "Les affaires étrangères."
                            },
                            {
                                "example_id": "6fee79fa-5b24-4508-88b2-a914e4f18cef",
                                "sense_id": "d2c8ddaa-519c-316a-9594-f3fd51c6bf65",
                                "text": "Les affaires ecclésiastiques."
                            },
                            {
                                "example_id": "e4b26ce2-3fd2-4a69-9211-d18bd52d6e9d",
                                "sense_id": "d2c8ddaa-519c-316a-9594-f3fd51c6bf65",
                                "text": "Affaires temporelles. ; Affaires spirituelles."
                            },
                            {
                                "example_id": "25f0c120-73d3-4682-a5bf-ff84e95c93d6",
                                "sense_id": "d2c8ddaa-519c-316a-9594-f3fd51c6bf65",
                                "text": "Le train, le courant des affaires."
                            },
                            {
                                "example_id": "440aef02-5d5d-4aa8-9025-231eb995f487",
                                "sense_id": "d2c8ddaa-519c-316a-9594-f3fd51c6bf65",
                                "text": "Pour les affaires urgentes."
                            },
                            {
                                "example_id": "49f6269b-d024-4a44-91a2-7046aabd3c00",
                                "sense_id": "d2c8ddaa-519c-316a-9594-f3fd51c6bf65",
                                "text": "Les affaires d’une ville, d’une communauté."
                            },
                            {
                                "example_id": "f201310a-0ddf-4fb2-8ab8-d672a045ecb3",
                                "sense_id": "d2c8ddaa-519c-316a-9594-f3fd51c6bf65",
                                "text": "Les affaires particulières et privées ; Affaires domestiques."
                            },
                            {
                                "example_id": "d875e3bd-1982-4c81-9a86-f200c9fcc193",
                                "sense_id": "d2c8ddaa-519c-316a-9594-f3fd51c6bf65",
                                "text": "Les affaires d’une succession."
                            },
                            {
                                "example_id": "dc0b819c-9312-48ce-80cb-43d768a2fc54",
                                "sense_id": "d2c8ddaa-519c-316a-9594-f3fd51c6bf65",
                                "text": "Un homme dont les affaires sont en bon état, en mauvais état."
                            },
                            {
                                "example_id": "6429a29f-a8c7-4788-9b5d-049de187411f",
                                "sense_id": "d2c8ddaa-519c-316a-9594-f3fd51c6bf65",
                                "text": "Il est bien, il est mal dans ses affaires."
                            },
                            {
                                "example_id": "12046287-d6ff-4c6e-aa7f-22adf9d5f61b",
                                "sense_id": "d2c8ddaa-519c-316a-9594-f3fd51c6bf65",
                                "text": "Il est au-dessus de ses affaires."
                            },
                            {
                                "example_id": "7a16d75d-7102-4e06-8669-687b7a295305",
                                "sense_id": "d2c8ddaa-519c-316a-9594-f3fd51c6bf65",
                                "text": "Il a bien fait ses affaires."
                            },
                            {
                                "example_id": "3116e641-7e9d-42fb-96d1-964cea40eb00",
                                "sense_id": "d2c8ddaa-519c-316a-9594-f3fd51c6bf65",
                                "text": "Donner ordre, mettre ordre à ses affaires."
                            },
                            {
                                "example_id": "0742b755-0080-4950-b2fb-5e2dd1fbfe57",
                                "sense_id": "d2c8ddaa-519c-316a-9594-f3fd51c6bf65",
                                "text": "Chacun a ses affaires, doit savoir ses affaires."
                            },
                            {
                                "example_id": "04230897-320d-484e-8e6b-c896461c4968",
                                "sense_id": "d2c8ddaa-519c-316a-9594-f3fd51c6bf65",
                                "text": "Il a soin de ses affaires."
                            },
                            {
                                "example_id": "b52aff4a-582d-4445-afcb-07d770582e8d",
                                "sense_id": "d2c8ddaa-519c-316a-9594-f3fd51c6bf65",
                                "text": "Il a donné la conduite, le maniement de ses affaires à un habile homme."
                            },
                            {
                                "example_id": "917cd2e3-4215-400c-8847-f6d493deb450",
                                "sense_id": "d2c8ddaa-519c-316a-9594-f3fd51c6bf65",
                                "text": "Ce ne sont pas là mes affaires Pourquoi en parlez-vous ? Sont-ce là vos affaires ? Mêlez-vous de vos affaires."
                            }
                        ]
                    },
                    {
                        "sense_id": "57c8437a-c14c-3344-8fac-90bfc3e525ed",
                        "entry_id": "43d08ed6-2955-3a2c-8470-3e9feecbcbf9",
                        "glosses": [
                            "Activité commerciale ou financière."
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "eefd644f-8928-4c41-97d5-c7d44b6c608c",
                                "sense_id": "57c8437a-c14c-3344-8fac-90bfc3e525ed",
                                "text": "Au cours des dernières années, les affaires avaient marché cahin-caha, avec une prédisposition romanesque à l’insécurité, dans une petite échoppe délabrée ouvrant sur la Grand’Rue."
                            },
                            {
                                "example_id": "75ab1579-b88f-4b69-9f4f-aff8bc36ab4c",
                                "sense_id": "57c8437a-c14c-3344-8fac-90bfc3e525ed",
                                "text": "En ce temps-là, qui n’est pas fort lointain, on ne disait pas encore « les affaires » avec l’accent spécial qu’on y met aujourd’hui. On disait, de façon plus modeste, et plus précise, « le commerce »."
                            },
                            {
                                "example_id": "0a6161aa-6a05-40ce-ac60-d39259e9c396",
                                "sense_id": "57c8437a-c14c-3344-8fac-90bfc3e525ed",
                                "text": "L’usage coutumier et les habitudes traditionnelles ont régi les relations commerciales et les transactions en affaires."
                            },
                            {
                                "example_id": "e5837195-7e55-43d8-b681-08c3a2d1feee",
                                "sense_id": "57c8437a-c14c-3344-8fac-90bfc3e525ed",
                                "text": "En un village de trois cents habitants, où il y avait autrefois cinq cabarets, il y en a quinze maintenant, et tous font leurs affaires."
                            },
                            {
                                "example_id": "8d737d91-85cd-4b54-9262-bfa8a1404440",
                                "sense_id": "57c8437a-c14c-3344-8fac-90bfc3e525ed",
                                "text": "Je constate que les jeunes n'ont plus tellement le sens des affaires - sauf cet arrière-arrière-demi-petit-neveu en blue jeans, mais c'est un demi-arrière-arrière-petit-neveu de Beauceron."
                            },
                            {
                                "example_id": "6c30310b-f849-422b-8881-eb705ae3e36e",
                                "sense_id": "57c8437a-c14c-3344-8fac-90bfc3e525ed",
                                "text": "Un chiffre d'affaires; un apporteur d'affaires."
                            },
                            {
                                "example_id": "bba479f3-67d6-4b4a-8bd9-b1e65dd9c38e",
                                "sense_id": "57c8437a-c14c-3344-8fac-90bfc3e525ed",
                                "text": "Le monde des affaires."
                            },
                            {
                                "example_id": "74b46bbf-7efa-41b6-afdb-a1fe68345859",
                                "sense_id": "57c8437a-c14c-3344-8fac-90bfc3e525ed",
                                "text": "Il est propre aux affaires."
                            },
                            {
                                "example_id": "733fa790-0d95-4955-ace5-6cf33975da12",
                                "sense_id": "57c8437a-c14c-3344-8fac-90bfc3e525ed",
                                "text": "On est souvent trompé par ses gens d’affaires."
                            },
                            {
                                "example_id": "596ee3bb-ef76-4a2b-9ac0-3c853e1da463",
                                "sense_id": "57c8437a-c14c-3344-8fac-90bfc3e525ed",
                                "text": "Nous avions quitté l’Inde pour revenir en France, quand, arrivé à Suez, papa perdit l’argent qu’il avait emporté. Il lui fut volé par des gens d’affaires."
                            }
                        ]
                    },
                    {
                        "sense_id": "0af8be38-6178-3a49-a4e5-c56066805a63",
                        "entry_id": "43d08ed6-2955-3a2c-8470-3e9feecbcbf9",
                        "glosses": [
                            "Règles, menstrues."
                        ],
                        "tags": [
                            "familiar",
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "edccc3ba-d18b-46e4-b4b1-ca7743500c74",
                                "sense_id": "0af8be38-6178-3a49-a4e5-c56066805a63",
                                "text": "21 mai 1940 – « Mesdemoiselles, quand vous aurez vos affaires, ne jetez rien dans la cuvette des vatères ». Le vocabulaire de grand-mère est désopilant d’horreur."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "778b10df-eef9-4568-8299-aad3459a925e",
                        "source_entry_id": "43d08ed6-2955-3a2c-8470-3e9feecbcbf9",
                        "target_lang_word": "манатки",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "манатки",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "912f0ea9-35f2-3fcb-a8c1-e5668da41f48",
                                        "entry_id": "0e0d37fa-41e1-32c9-a2c5-2517f2ebc6eb",
                                        "glosses": [
                                            "собир., прост., пренебр. мелкие вещи, пожитки"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "248d3f4d-d78c-46d0-ac79-baadf7962ee3",
                                                "sense_id": "912f0ea9-35f2-3fcb-a8c1-e5668da41f48",
                                                "text": "— Ну, брат, сбирай свои манатки. Больше тебе тут глядеть нечего."
                                            },
                                            {
                                                "example_id": "3ab20f24-86c6-4bbc-a781-fe2eac890889",
                                                "sense_id": "912f0ea9-35f2-3fcb-a8c1-e5668da41f48",
                                                "text": "Сгребли мы свои манатки, мешки с луком, чемоданишко да пешедралом до станции."
                                            },
                                            {
                                                "example_id": "f20d89f0-c529-42a0-b785-26732f2df9ab",
                                                "sense_id": "912f0ea9-35f2-3fcb-a8c1-e5668da41f48",
                                                "text": "Кроме своих манаток, мужчины несли — кто лопату, кто топор, пилу, ведро и т. д."
                                            },
                                            {
                                                "example_id": "41f318f6-5499-49b3-a6f1-cf64ebbc3bf5",
                                                "sense_id": "912f0ea9-35f2-3fcb-a8c1-e5668da41f48",
                                                "text": "Кузов хромой полуторки, прибывшей к эшелону, был дополна нагружен старыми манатками."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
