                                    {
                                        "sense_id": "2c227aa0-7855-3f1b-b529-a694e0c7c04e",
                                        "entry_id": "114e3205-8ca6-33fe-8c20-43aeff0e5541",
                                        "glosses": [
                                            "ein mit einer Lanze bewaffneter Reiter"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed161cd3-0f2c-4fa9-a15e-7d000a2ffc22",
                                                "sense_id": "2c227aa0-7855-3f1b-b529-a694e0c7c04e",
                                                "text": "„Die Lanzierer verschwanden nach und nach von den Kriegsschauplätzen des Dreißigjährigen Krieges. Die Kürassiere traten als geharnischte Reiter an ihre Stelle.“"
                                            },
                                            {
                                                "example_id": "6b098295-aed7-4488-a480-9b67f00ee0f8",
                                                "sense_id": "2c227aa0-7855-3f1b-b529-a694e0c7c04e",
                                                "text": "„Für Lanzierer aber gebraucht man Edelleute oder sonst hervorragend tüchtige Krieger; deren gibt es immer nur wenige.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
