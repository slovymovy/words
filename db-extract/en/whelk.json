                    },
                    {
                        "translation_id": "3a14bc84-6601-4492-8441-ce01824920fd",
                        "source_entry_id": "5bce6492-ecc9-3f8e-b4b2-a751659dda50",
                        "source_sense_id": "b81b8a1a-0be8-3936-89fc-74666474bcc1",
                        "source_sense_description": "edible sea snail of the family Buccinidae",
                        "target_lang_word": "buccin",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "buccin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4d5758d4-6534-34f3-9c55-df624c7277d7",
                                        "entry_id": "c958153a-0aa0-32e7-a3d3-b00ab26fb643",
                                        "glosses": [
                                            "Genre de mollusques à coquille univalve en forme de cornet et tournée en spirale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef12c715-b7b4-4ec9-9d90-2b585f0f95ee",
                                                "sense_id": "4d5758d4-6534-34f3-9c55-df624c7277d7",
                                                "text": "On trouve des buccins dans la mer, dans les rivières et dans la terre."
                                            },
                                            {
                                                "example_id": "d091ef2f-b311-469e-8fb4-679c76f23843",
                                                "sense_id": "4d5758d4-6534-34f3-9c55-df624c7277d7",
                                                "text": "Les corneilles cherchent des buccins à marée basse, en choisissant d’habitude les plus gros."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c4af769b-ff4e-3fa8-92e5-2aaf737d0dad",
                                        "entry_id": "c958153a-0aa0-32e7-a3d3-b00ab26fb643",
                                        "glosses": [
                                            "Instrument à vent, de la famille des cuivres, utilisé dans l’armée de la Rome antique."
                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e24a37fa-6ad1-49d0-b335-5822f23cf2c3",
                                                "sense_id": "c4af769b-ff4e-3fa8-92e5-2aaf737d0dad",
                                                "text": "Je pourrais vous signaler d’importants morceaux écrits pour un ensemble de trompettes complètement aphones que je nomme les clairons du Silence, à construire sur le modèle introuvable des buccins qui renversèrent autrefois les murailles de Jéricho…"
                                            },
                                            {
                                                "example_id": "90ffa4b0-fd10-46c7-b087-2e9952e5d8b5",
                                                "sense_id": "c4af769b-ff4e-3fa8-92e5-2aaf737d0dad",
                                                "text": "Une rumeur emplit le château, un vacarme de gens qui couraient, de meubles qu’on traînait, d’argenteries s’écroulant ; et, du haut des tours, des buccins sonnaient, pour avertir les esclaves dispersés."
                                            },
                                            {
                                                "example_id": "0867d80d-d741-4ca6-96d5-f4cdc52b51dd",
                                                "sense_id": "c4af769b-ff4e-3fa8-92e5-2aaf737d0dad",
                                                "text": "Rien qu’en pensant à lui, j’ai le frisson de la grandeur ; j’entends ces trompettes romaines, ces buccins dont parle Quincey et qui annoncent les personnages souverains."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ee19f4be-76bf-4071-ba44-48fb0e168c12",
                        "source_entry_id": "5bce6492-ecc9-3f8e-b4b2-a751659dda50",
                        "source_sense_id": "b81b8a1a-0be8-3936-89fc-74666474bcc1",
                        "source_sense_description": "edible sea snail of the family Buccinidae",
                        "target_lang_word": "bulot",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bulot",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bfc32914-2301-39dd-a376-e2226c23a760",
                                        "entry_id": "5ca1cba4-0e48-3fd0-9bbb-6c79ed0f8e07",
                                        "glosses": [
                                            "Un des noms vernaculaires des différents représentants de la famille des Buccinidae utilisé entre autre sur les côtes picardes, normandes ainsi que sur les côtes charentaises"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f84e9b61-809d-4ead-9187-016bc96ae54e",
                                                "sense_id": "bfc32914-2301-39dd-a376-e2226c23a760",
                                                "text": "Nos marins avaient eu la bonne fortune de trouver sur les bancs un coquillage désigné sous le nom de bulot, pouvant remplacer la boëtte."
                                            },
                                            {
                                                "example_id": "eff0dfc3-c9f0-42ac-b888-afc515aea0b6",
                                                "sense_id": "bfc32914-2301-39dd-a376-e2226c23a760",
                                                "text": "Il me semble qu’à chaque fois j’ai pris des bulots mayonnaise et un homard Thermidor, et qu’à chaque fois j’ai trouvé ça bon, je n’ai jamais éprouvé le besoin, ni même le désir d’explorer le reste de la carte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e839ff01-f85b-3e7c-8cf1-a5731cd03176",
                                        "entry_id": "5ca1cba4-0e48-3fd0-9bbb-6c79ed0f8e07",
                                        "glosses": [
                                            "Imbécile, idiot."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively",
                                            "offensive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a90f3c4-7fd0-4957-8d7d-867c88a70620",
                                                "sense_id": "e839ff01-f85b-3e7c-8cf1-a5731cd03176",
                                                "text": "Je suis montée dans l’ascenseur avec M. Ozu et il est resté bloqué entre le deuxième et le troisième pendant dix minutes parce qu’un bulot avait mal refermé la grille avant de renoncer à le prendre et de descendre par l’escalier."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
