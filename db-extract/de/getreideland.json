                "senses": [
                    {
                        "sense_id": "26f57806-f38c-30bc-8e30-a04a29de6735",
                        "entry_id": "4c93dfdd-3f6c-3ace-b7fa-223a546578f1",
                        "glosses": [
                            "Erdboden, auf dem Getreide angebaut wird beziehungsweise solcher, der sich für den Anbau desselben eignet"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "5bfaa73a-ccfc-4262-bd68-fc4df5fd4613",
                                "sense_id": "26f57806-f38c-30bc-8e30-a04a29de6735",
                                "text": "„Mitte der neunziger Jahre wurden 18 Prozent des Getreidelandes in der EU nicht bewirtschaftet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e9d56ef4-1329-3336-a4b0-8a9e852aca08",
                        "entry_id": "4c93dfdd-3f6c-3ace-b7fa-223a546578f1",
                        "glosses": [
                            "Staat, dessen Landwirtschaft größtenteils auf die Erzeugung von Getreide ausgerichtet ist, also verhältnismäßig viel Getreide produziert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2110dd4a-80db-4a4c-afcd-93069adeabb8",
                                "sense_id": "e9d56ef4-1329-3336-a4b0-8a9e852aca08",
                                "text": "„Die Schweiz galt bis in die 1880er-Jahre als Getreideland. Mit dem Bau der Eisenbahn in der Schweiz änderte sich dies. Mit Hilfe des neuen Transportmittels konnte günstiges Getreide importiert werden.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
