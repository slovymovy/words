                "senses": [
                    {
                        "sense_id": "a75308be-7103-32b1-94ae-63bc159536a0",
                        "entry_id": "e1eade90-676c-3991-9017-96c47b71052a",
                        "glosses": [
                            "anlässlich der Festspiele veranstaltetes Rennen auf leichten Wagen mit zwei Rädern, die von zwei oder vier Pferden gezogen wurden"
                        ],
                        "tags": [
                            "in der Antike"
                        ],
                        "examples": [
                            {
                                "example_id": "6c5d49b2-99b6-4c8a-92a4-c90d29750ced",
                                "sense_id": "a75308be-7103-32b1-94ae-63bc159536a0",
                                "text": "„Nur weil die Antike die Wagenrennen gepflegt hat, heißt das nicht, dass es heute leicht zu wiederholen wäre.“"
                            },
                            {
                                "example_id": "eaa4e368-42e9-4395-be29-2a495b578d7b",
                                "sense_id": "a75308be-7103-32b1-94ae-63bc159536a0",
                                "text": "„Denn auf den kargen Feldern wird ein Wagenrennen gedreht, das Filmgeschichte geschrieben hat: Das Rennen von Ben Hur und seinem Widersacher Messala.“"
                            },
                            {
                                "example_id": "3b5edfa3-6457-4735-9d0f-540d8f137a64",
                                "sense_id": "a75308be-7103-32b1-94ae-63bc159536a0",
                                "text": "„Dass die Römer der Spätantike zunehmend das Interesse verloren, sich für Kaiser und Staat kriegerisch zu engagieren, mag ein Grund für das Ende der Gladiatur gewesen sein, deren Rolle von den pompösen Wagenrennen übernommen wurde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
