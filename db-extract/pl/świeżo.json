                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gesund",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f5af937b-0168-336c-a5a3-3083b2d57756",
                                        "entry_id": "b2e5f9df-3583-3b59-b0d2-b915a0a03846",
                                        "glosses": [
                                            "frei von Krankheiten, sich wohlbefindend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ac15fbe-becd-4c26-9e41-f5ea338843cd",
                                                "sense_id": "f5af937b-0168-336c-a5a3-3083b2d57756",
                                                "text": "Ich bin vollkommen gesund."
                                            },
                                            {
                                                "example_id": "bd11925e-8bbb-457c-a192-1d88c2f290e5",
                                                "sense_id": "f5af937b-0168-336c-a5a3-3083b2d57756",
                                                "text": "Oh wie schön, dass du gesund zurückgekommen bist!"
                                            },
                                            {
                                                "example_id": "65edd283-0414-4876-bcdf-5fbbafac137a",
                                                "sense_id": "f5af937b-0168-336c-a5a3-3083b2d57756",
                                                "text": "Ein gesunder Patient ist mir natürlich lieber als ein kranker."
                                            },
                                            {
                                                "example_id": "74e37266-161b-4c4b-bf4e-6a4c1ed3e348",
                                                "sense_id": "f5af937b-0168-336c-a5a3-3083b2d57756",
                                                "text": "Damit in Coronazeiten alle gesund bleiben, heißt es 'Abstand halten', 'Mundschutz auf', 'Lüften' und 'Hände waschen'."
                                            },
                                            {
                                                "example_id": "36f22ace-a04c-4ebb-b696-e8ceb7a5fbf3",
                                                "sense_id": "f5af937b-0168-336c-a5a3-3083b2d57756",
                                                "text": "[Coronakrankheit:] „Bei vielen zuvor gesunden Patienten hat die Virusinfektion nachweislich eine Herzmuskelentzündung verursacht.“"
                                            },
                                            {
                                                "example_id": "e3c58e14-ab4d-4cc0-bec9-83797c8273e9",
                                                "sense_id": "f5af937b-0168-336c-a5a3-3083b2d57756",
                                                "text": "Wird man wirklich gesünder durch die vorbeugende Einnahme von Nahrungsrgänzungsmitteln?"
                                            },
                                            {
                                                "example_id": "b9c015f5-1216-4b0a-915f-6a18c63bbf54",
                                                "sense_id": "f5af937b-0168-336c-a5a3-3083b2d57756",
                                                "text": "Vollkornbrot soll gesünder sein als Weißbrot."
                                            },
                                            {
                                                "example_id": "c82fb4b9-3d82-4b2c-8e95-196e061c357a",
                                                "sense_id": "f5af937b-0168-336c-a5a3-3083b2d57756",
                                                "text": "„Dr. Adriane Prahl hat etwas gegen Bauchweh dabei. Damit alle schnell gesund werden, und das Fell schon morgen wieder seidig glänzt, schenkt sie den Ziegen einen Magenbitter aus.“"
                                            },
                                            {
                                                "example_id": "84986635-70ba-4a5f-a451-6d6186a11a3b",
                                                "sense_id": "f5af937b-0168-336c-a5a3-3083b2d57756",
                                                "text": "[Holocaust:] „Das Wort \"Konzentrationslager\" fehlte in [Anmerkung: bestimmten] Stellenanzeigen. Im \"Hannoverschen Kurier\" hieß es 1944 stattdessen: \"Für den Einsatz bei einer militärischen Dienststelle werden gesunde weibliche Arbeitskräfte im Alter von 20-40 J. gesucht.\"“"
                                            },
                                            {
                                                "example_id": "95b328ed-ba31-4511-ba43-530ebe1ec359",
                                                "sense_id": "f5af937b-0168-336c-a5a3-3083b2d57756",
                                                "text": "[Chinesische Straflager:] „In ihrem Buch schreibt sie: \"Seitdem ich im Straflager war, komme ich manchmal nicht vom Bett hoch. Das liegt daran, dass ich dort so lange auf kaltem Betonboden schlafen musste. Meine Glieder und Gelenke schmerzen vom Rheuma. Vorher war ich vollkommen gesund, heute bin ich mit 43 Jahren eine kranke Frau.\"“"
                                            },
                                            {
                                                "example_id": "b7b99c86-c954-4faa-80f4-8e514714a07c",
                                                "sense_id": "f5af937b-0168-336c-a5a3-3083b2d57756",
                                                "text": "„Jeder fromme Muslim, der gesund ist und es sich leisten kann, ist angehalten, mindestens einmal im Leben an der Pilgerfahrt [Anmerkung: der Hadsch] teilzunehmen.“"
                                            },
                                            {
                                                "example_id": "8427e493-1caf-4e69-8274-26e6929ea8bd",
                                                "sense_id": "f5af937b-0168-336c-a5a3-3083b2d57756",
                                                "text": "„Für zwei bis dahin völlig gesunde Männer in Katar hatte das Trinken von Hand- bzw. Flächendesinfektionsmitteln lebensgefährliche Folgen.“"
                                            },
                                            {
                                                "example_id": "45ec2933-2f6c-474e-a36a-1c769a417ab9",
                                                "sense_id": "f5af937b-0168-336c-a5a3-3083b2d57756",
                                                "text": "[Stadtpark gesperrt:] „Gestern Mittag war von einer Eiche ein starker und gesunder Ast heruntergestürzt.“"
                                            },
                                            {
                                                "example_id": "4c756227-e2c5-45fb-b42d-412fba8dd98b",
                                                "sense_id": "f5af937b-0168-336c-a5a3-3083b2d57756",
                                                "text": "„Die Borkenkäfer scheinen überall zu sein, gleichwohl ist es Müller zufolge höchst aufwändig, die befallenen Bäume zu finden: »Sie sitzen unter der Borke von Fichten, die auf den ersten Blick gesund wirken, aber bereits zum Absterben verdammt sind.«“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7fb108ef-75eb-3e33-9d24-ffbfe13e9d30",
                                        "entry_id": "b2e5f9df-3583-3b59-b0d2-b915a0a03846",
                                        "glosses": [
                                            "gut für die Gesundheit, etwas (beispielsweise Nahrung, Getränke, Licht) ist gesund für jemanden oder etwas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "22070f87-56b2-49c6-aad3-f97c6dbeec79",
                                                "sense_id": "7fb108ef-75eb-3e33-9d24-ffbfe13e9d30",
                                                "text": "Vitamine sind gesund."
                                            },
                                            {
                                                "example_id": "7ee4e9a7-b5cc-4028-ac36-9bc60bd8eeb0",
                                                "sense_id": "7fb108ef-75eb-3e33-9d24-ffbfe13e9d30",
                                                "text": "Ein Spaziergang an der frischen Luft ist gesund."
                                            },
                                            {
                                                "example_id": "2c069ccb-6d70-448f-aff9-c63a804da8d3",
                                                "sense_id": "7fb108ef-75eb-3e33-9d24-ffbfe13e9d30",
                                                "text": "Rauchen ist alles andere als gesund."
                                            },
                                            {
                                                "example_id": "6eaf37c3-6738-4614-8b87-89dbf6bbf86a",
                                                "sense_id": "7fb108ef-75eb-3e33-9d24-ffbfe13e9d30",
                                                "text": "„Das Intervallfasten soll, so die Fans, eine sehr gesunde Art sein, um abzunehmen, und sogar vor Krankheiten schützen.“"
                                            },
                                            {
                                                "example_id": "5defcea5-6c6b-42df-ba57-e3fdf8ac47fe",
                                                "sense_id": "7fb108ef-75eb-3e33-9d24-ffbfe13e9d30",
                                                "text": "„Vitaminbombe Kürbis: Welche Sorten sind besonders gesund?“"
                                            },
                                            {
                                                "example_id": "5b478ee8-d958-430e-a275-a06cd136ccb0",
                                                "sense_id": "7fb108ef-75eb-3e33-9d24-ffbfe13e9d30",
                                                "text": "Schätzchen, der Mann ist nicht gesund für dich."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "29d9b594-8a1d-3c6f-9dad-e4fb3962e0b8",
                                        "entry_id": "b2e5f9df-3583-3b59-b0d2-b915a0a03846",
                                        "glosses": [
                                            "natürlich und normal"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1f78764c-3ca7-49ab-8fd1-58331accdc52",
                                                "sense_id": "29d9b594-8a1d-3c6f-9dad-e4fb3962e0b8",
                                                "text": "„Viel unterwegs, zu viele Kohlenhydrate: Dem Sales-Manager Dirk von G. fällt es schwer, sich gesund zu ernähren.“"
                                            },
                                            {
                                                "example_id": "4190c6b4-8c6e-4620-9f0e-dc72fb085720",
                                                "sense_id": "29d9b594-8a1d-3c6f-9dad-e4fb3962e0b8",
                                                "text": "Zu der Entscheidung gehörte eine gesunde Portion Menschenverstand."
                                            },
                                            {
                                                "example_id": "6c95cbe9-330b-439a-9256-06463bea305b",
                                                "sense_id": "29d9b594-8a1d-3c6f-9dad-e4fb3962e0b8",
                                                "text": "Da haben Sie aber ein gesundes Maß an Vertrauen bewiesen."
                                            },
                                            {
                                                "example_id": "3ba358b1-28f7-4bb1-9ab7-002db4d20684",
                                                "sense_id": "29d9b594-8a1d-3c6f-9dad-e4fb3962e0b8",
                                                "text": "Das nenne ich einen gesunden Ehrgeiz!"
                                            },
                                            {
                                                "example_id": "f19bb43b-84f0-4889-ad5b-06abaa8c2c52",
                                                "sense_id": "29d9b594-8a1d-3c6f-9dad-e4fb3962e0b8",
                                                "text": "Sie kam mit einer gesunden Bräune aus dem Urlaub zurück."
                                            },
                                            {
                                                "example_id": "4f7a5196-78e4-4ce8-b94d-891a6b2d5cf0",
                                                "sense_id": "29d9b594-8a1d-3c6f-9dad-e4fb3962e0b8",
                                                "text": "Was sie da treibt, ist doch nicht mehr gesund."
                                            },
                                            {
                                                "example_id": "e23dcc08-ca47-48d8-8150-f7d43d2668fe",
                                                "sense_id": "29d9b594-8a1d-3c6f-9dad-e4fb3962e0b8",
                                                "text": "„»[…] Sollte es früher Platz für körperliche und seelische Misshandlungen gegeben haben, gehört dies für uns der Vergangenheit an. Unsere derzeitige Mannschaft hat ein gesundes Spitzensport-Klima.«“"
                                            },
                                            {
                                                "example_id": "f65972af-2935-4891-b177-441af501a8f4",
                                                "sense_id": "29d9b594-8a1d-3c6f-9dad-e4fb3962e0b8",
                                                "text": "„Um diese [Anmerkung: verschiedenen Ansätze und Blickwinkel] anzuerkennen braucht es die gesunde Selbsteinschätzung, - unsere Vorfahren hätten es Demut genannt - dass man selbst nie alles wissen kann und deshalb auch den anderen Meinungen Gehör schenken muss.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            },
