                    {
                        "translation_id": "19581d67-9f83-431b-b27d-5b659504fb46",
                        "source_entry_id": "cbe71f90-0af3-3194-9b39-1d4f35276ee9",
                        "source_sense_description": "of or pertaining to an experiment",
                        "target_lang_word": "experimentální",
