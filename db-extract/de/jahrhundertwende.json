                ],
                "senses": [
                    {
                        "sense_id": "679cece0-ccce-3106-a73d-31e066aa18cb",
                        "entry_id": "09afa6f0-0cd1-395c-aea7-19b97fd06b52",
                        "glosses": [
                            "der Übergang, die Wende von einem Jahrhundert zum nächsten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "14d72d05-d154-4264-a842-5513e2bebf22",
                                "sense_id": "679cece0-ccce-3106-a73d-31e066aa18cb",
                                "text": "Um die letzte Jahrhundertwende musste die Computerindustrie sich einiges einfallen lassen wegen der Umstellung 1999 auf 2000. Dies ging in die Geschichte als Y2K ein."
                            },
                            {
                                "example_id": "14da4baa-af49-4a53-826b-4c2314f47492",
                                "sense_id": "679cece0-ccce-3106-a73d-31e066aa18cb",
                                "text": "„Abgesehen von den Auswüchsen einer allzu gefühlsseligen oder gar chauvinistischen Deutschtümelei, wie sie sich besonders um die Jahrhundertwende und dann während des Faschismus breitmachte, ist das Zurückgreifen auf gute alte Wörter zur Bereicherung des Wortbestandes sehr zu begrüßen.“"
                            },
                            {
                                "example_id": "9d8844a7-554d-4839-9ade-6d0b2b9155ce",
                                "sense_id": "679cece0-ccce-3106-a73d-31e066aa18cb",
                                "text": "„Man müßte, um diese Art von Kaltblütigkeit zu verstehen, etwas von der Atmosphäre des norddeutschen Bürgerhauses um die Jahrhundertwende genossen haben; ich vermute, daß es sich dort zwischen Vätern und Söhnen weniger um erzieherische Vorgänge handelte als um solche unter Mitverschworenen.“"
                            },
                            {
                                "example_id": "f40c0404-5388-4b88-ab47-54f00f3f71d5",
                                "sense_id": "679cece0-ccce-3106-a73d-31e066aa18cb",
                                "text": "„Um die Jahrhundertwende war der bewaffnete Widerstand praktisch beendet.“"
                            },
                            {
                                "example_id": "0750a214-031a-4646-b605-be8030895110",
                                "sense_id": "679cece0-ccce-3106-a73d-31e066aa18cb",
                                "text": "„Um die Jahrhundertwende reist der ehemalige Burenkommandant Jacobus Petrus Jooste (1868-1945) durch Deutschland und Europa, um für die südafrikanische Burenrepublik zu werben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "780f348e-5aa2-433f-be26-1e4a8e9eea4e",
                        "source_entry_id": "09afa6f0-0cd1-395c-aea7-19b97fd06b52",
                        "source_sense_id": "679cece0-ccce-3106-a73d-31e066aa18cb",
                        "source_sense_description": "der Übergang, die Wende von einem Jahrhundert zum nächsten",
                        "target_lang_word": "turn of the century",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "turn of the century",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "74c9cf50-0868-3ad4-bccb-0f9c3d007a0c",
                                        "entry_id": "e2c2be51-683b-346c-be06-c5b4550b6a8b",
                                        "glosses": [
                                            "The beginning or end of a certain century; the transition from one century to the next; often, especially in architecture, the beginning of the 20th century."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7b796ace-e2f9-4e4d-83de-aa6aaf411161",
                                                "sense_id": "74c9cf50-0868-3ad4-bccb-0f9c3d007a0c",
                                                "text": "By the turn of the century he was starting to become well known in literary circles."
                                            },
                                            {
                                                "example_id": "291dd832-5011-497f-b963-dbcf45deff4b",
                                                "sense_id": "74c9cf50-0868-3ad4-bccb-0f9c3d007a0c",
                                                "text": "The 7th and 8th classes are identical with the Cape engines placed in service at the turn of the century, and are now outclassed for main line work but are used for shunting at the large depots and on one or two of the branch lines."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
