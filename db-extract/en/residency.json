                    {
                        "sense_id": "2ce98007-c49c-3cce-b620-0a109145700e",
                        "entry_id": "921027f1-b9d9-3429-9431-5aa8dee5c8a1",
                        "glosses": [
                            "The position of a musical artist who commonly performs at a particular venue."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "2e3fa3a9-4071-4a61-a4ef-d6d5bd92f74e",
                                "sense_id": "2ce98007-c49c-3cce-b620-0a109145700e",
                                "text": "The trance DJ was keen to secure a residency in Ibiza."
                            },
                            {
                                "example_id": "ab460866-e362-4835-8b22-9353e2ffa6a6",
                                "sense_id": "2ce98007-c49c-3cce-b620-0a109145700e",
                                "text": "After a successful Thursday-night residency at the Marquee Club—where the Yardbirds, the Animals, and the Rolling Stones first earned their reputations—England's CBS label signed the group to a recording contract."
                            }
                        ]
                    },
                    {
                        "sense_id": "c8f7b82b-c06d-34ed-977a-0a4a3a4922dd",
                        "entry_id": "921027f1-b9d9-3429-9431-5aa8dee5c8a1",
