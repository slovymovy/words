{
    "word_family": [
        "répétition",
        "répétitif",
        "répétiteur",
        "répétitrice"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "123fa515-31b6-3207-9de3-d652bcdc3afa",
                    "sense_definition": "Dire de nouveau ce que l'on a déjà dit soi-même.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'enseignant <w>répète</w> la consigne pour que tout le monde comprenne."
                        },
                        {
                            "text": "Je dois souvent <w>répéter</w> la question car il est distrait."
                        }
                    ],
                    "synonyms": [
                        "redire",
                        "réitérer"
                    ],
                    "common_phrases": [
                        "répéter la question"
                    ]
                },
                {
                    "sense_id": "0e3bbcb0-8814-3dec-b052-e260f0e28223",
                    "sense_definition": "Dire ce qu'une autre personne a dit ou reproduire des paroles entendues.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les jeunes élèves doivent écouter attentivement et <w>répéter</w> après le maître."
                        },
                        {
                            "text": "Cet oiseau domestique peut <w>répéter</w> mot pour mot chaque phrase prononcée."
                        }
                    ],
                    "synonyms": [
                        "reproduire"
                    ],
                    "common_phrases": [
                        "répéter après quelqu'un",
                        "répéter mot pour mot"
                    ]
                },
                {
                    "sense_id": "24c30781-2fad-3e78-89f3-ae74cbc6fe6b",
                    "sense_definition": "S'entraîner à exécuter une pièce, un concert ou un spectacle avant la représentation publique.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "spectacle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les comédiens se réunissent ce soir pour <w>répéter</w> une scène compliquée."
                        },
                        {
                            "text": "Le groupe a passé tout le week-end à <w>répéter</w> son nouveau morceau."
                        }
                    ],
                    "common_phrases": [
                        "répéter un rôle",
                        "répéter une scène"
                    ]
                },
                {
                    "sense_id": "5ebc7d39-ea2a-363f-89d3-fba777389307",
                    "sense_definition": "Faire une action de nouveau ou reproduire un même événement.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il faut rester vigilant pour ne jamais <w>répéter</w> la même erreur."
                        },
                        {
                            "text": "Ces pannes techniques ont tendance à se <w>répéter</w> fréquemment en hiver."
                        }
                    ],
                    "synonyms": [
                        "refaire",
                        "renouveler"
                    ],
                    "common_phrases": [
                        "répéter la même erreur"
                    ]
                },
                {
                    "sense_id": "f8bcd642-1ed5-32cf-94c9-3d5214472988",
                    "sense_definition": "Rapporter ou ébruiter des propos entendus ou une confidence.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je vais vous faire une confidence mais évitez de la <w>répéter</w>."
                        },
                        {
                            "text": "Le journaliste a refusé de <w>répéter</w> les propos entendus lors de l'entretien."
                        }
                    ],
                    "synonyms": [
                        "divulguer",
                        "rapporter",
                        "ébruiter"
                    ],
                    "antonyms": [
                        "cacher",
                        "taire"
                    ],
                    "common_phrases": [
                        "répéter un secret",
                        "répéter les propos entendus"
                    ]
                },
                {
                    "sense_id": "14f84445-3aa9-3233-bc98-bc2d67c36fa8",
                    "sense_definition": "Redire continuellement les mêmes choses ou manquer de renouvellement dans sa création.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce vieil écrivain a malheureusement tendance à se <w>répéter</w> au fil des chapitres."
                        },
                        {
                            "text": "Sans se rendre compte de rien, il se <w>répète</w> sans cesse devant ses amis."
                        }
                    ],
                    "synonyms": [
                        "radoter"
                    ],
                    "antonyms": [
                        "innover"
                    ],
                    "common_phrases": [
                        "se répéter sans cesse"
                    ]
                },
                {
                    "sense_id": "caa3cea4-f5cd-38bf-acf1-4ebaf20fb5d0",
                    "sense_definition": "Renvoyer ou reproduire par réflexion l'image ou l'apparence d'un objet.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les miroirs de la galerie semblaient <w>répéter</w> une image lumineuse jusqu'à l'infini."
                        },
                        {
                            "text": "La surface de l'eau claire <w>répétait</w> les reliefs déchiquetés de la falaise."
                        }
                    ],
                    "synonyms": [
                        "refléter",
                        "réfléchir"
                    ],
                    "common_phrases": [
                        "répéter une image"
                    ]
                },
                {
                    "sense_id": "78de8102-8f28-39ec-ab42-b2282b9841e7",
                    "sense_definition": "Exiger ou réclamer en droit la restitution de ce qui a été indûment payé ou fourni.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "droit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le créancier a intenté une action juridique pour <w>répéter</w> une somme perçue par erreur."
                        },
                        {
                            "text": "La banque cherche à <w>répéter</w> un paiement transmis par mégarde au mauvais bénéficiaire."
                        }
                    ],
                    "synonyms": [
                        "recouvrer",
                        "réclamer"
                    ],
                    "common_phrases": [
                        "répéter un paiement",
                        "répéter une somme"
                    ]
                }
            ]
        }
    ]
}