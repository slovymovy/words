                    }
                ],
                "senses": [
                    {
                        "sense_id": "28dfe2e3-a536-3e34-b77a-910f14f46ec9",
                        "entry_id": "a25dea29-87da-3db5-a12e-bef798c5a8c2",
                        "glosses": [
                            "mehrere Sätze aufweisend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e1888b0-2856-408b-bacd-ea85440d5bed",
                                "sense_id": "28dfe2e3-a536-3e34-b77a-910f14f46ec9",
                                "text": "„Das Quartett, das gespielt wurde, war mehrsätzig; es gab aber keine Pause zwischen den Sätzen, allenfalls einen Atemzug.“"
                            },
                            {
                                "example_id": "48d6b1b0-740a-4501-9f68-14b4596d6b46",
                                "sense_id": "28dfe2e3-a536-3e34-b77a-910f14f46ec9",
                                "text": "„Sie ist einsätzig und zugleich mehrsätzig, da die vier Sätze einer Sonate mit der Sonatenhauptsatzform kombiniert werden.“"
                            },
                            {
                                "example_id": "e4e2bbb8-70ac-4858-b381-7ecc8a4ee9bb",
                                "sense_id": "28dfe2e3-a536-3e34-b77a-910f14f46ec9",
                                "text": "„Auch diese Compositionen sind mehrsätzig und wir werden nicht fehl gehen, wenn wir sagen, dass sie nur selten weniger als vier Sätze enthalten.“"
                            },
                            {
