                                    {
                                        "sense_id": "b25c04dc-cd30-3947-8dd2-a3a5dc46c03e",
                                        "entry_id": "8da37231-259e-3234-a992-9e530e684437",
                                        "glosses": [
                                            "Pluriel de chose."
