                "senses": [
                    {
                        "sense_id": "fd83f93d-ee42-3979-91d1-7bfda942e6e7",
                        "entry_id": "4a5d0cb4-c879-33c9-9de2-c4cfa83948a4",
                        "glosses": [
                            "Être cohérent avec les lois de Mendel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b3cc9a08-ff29-4203-b110-b1bae1093c7c",
                                "sense_id": "fd83f93d-ee42-3979-91d1-7bfda942e6e7",
                                "text": "Ce qui prouve que le pouvoir transmetteur, caractère susceptible d’ailleurs de mendéliser — au titre de facteur dominant simple — , dépend de la constitution anatomique de l’insecte."
                            }
                        ]
                    },
                    {
                        "sense_id": "83651362-2954-3c47-93b6-1e3532d623ee",
                        "entry_id": "4a5d0cb4-c879-33c9-9de2-c4cfa83948a4",
                        "glosses": [
                            "Faire correspondre aux lois de Mendel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4bf1cc3c-c6cd-4e41-94bf-bc0bd38496a9",
                                "sense_id": "83651362-2954-3c47-93b6-1e3532d623ee",
                                "text": "On peut alors essayer de « mendéliser » ces séquences et d’y rechercher les parties codantes."
                            }
                        ]
