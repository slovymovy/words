                                        "sense_id": "efbc8167-b114-3478-af31-c71567ed0bc7",
                                        "entry_id": "6c1300cb-d501-32b9-a61c-679f8aa0f7b8",
                                        "glosses": [
                                            "The condition of being communal."
                                        ],
