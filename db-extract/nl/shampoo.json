                        "cross_references": [
                            {
                                "target_word": "shampoo",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dec85a9d-8de6-3f11-ac08-06609d30ee17",
                                        "entry_id": "276193c6-095c-3844-9f2e-2629914b8e7c",
                                        "glosses": [
                                            "A traditional Indian and Persian body massage given after pouring warm water over the body and rubbing it with extracts from herbs."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2ffe92e2-bac6-318e-a933-3c5f97405bc4",
                                        "entry_id": "276193c6-095c-3844-9f2e-2629914b8e7c",
                                        "glosses": [
                                            "A commercial liquid soaplike product for washing hair or other fibers, such as carpets."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "779f8b7c-5048-41f1-aad9-9dca33df62eb",
                                                "sense_id": "2ffe92e2-bac6-318e-a933-3c5f97405bc4",
                                                "text": "These endocrine disruptors are everywhere: plastics, shampoos, cosmetics, cushions, pesticides, canned foods and A.T.M. receipts. They often aren’t on labels and can be difficult to avoid."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "10171a9a-9084-3cd7-817a-43fca56f8d81",
                                        "entry_id": "276193c6-095c-3844-9f2e-2629914b8e7c",
                                        "glosses": [
                                            "An instance of washing the hair or other fibres with shampoo."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8a3b426f-b38d-4f0d-909b-15186a3838c0",
                                                "sense_id": "10171a9a-9084-3cd7-817a-43fca56f8d81",
                                                "text": "I’m going to give the carpet a shampoo."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "17f31656-0f85-3f24-b17d-16e14dbc0521",
                                        "entry_id": "276193c6-095c-3844-9f2e-2629914b8e7c",
                                        "glosses": [
                                            "Champagne."
                                        ],
                                        "tags": [
                                            "countable",
                                            "humorous",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "shampoo",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7ec5aa2f-1a58-3ef6-a4c4-c726e2463c45",
                                        "entry_id": "aafc41ba-ce00-3258-b78d-94f11a8494e3",
                                        "glosses": [
                                            "To wash one's own hair with shampoo."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "59dafc3e-10de-4579-914d-d517266df2b2",
                                                "sense_id": "7ec5aa2f-1a58-3ef6-a4c4-c726e2463c45",
                                                "text": "My neat-freak of a friend has been compulsively shampooing for every bath he has taken."
                                            },
                                            {
                                                "example_id": "ec0b2ffa-1e7b-4ba0-a015-c67d0dec7bae",
                                                "sense_id": "7ec5aa2f-1a58-3ef6-a4c4-c726e2463c45",
                                                "text": "You then apply the conditioner mix to shampooed hair, from root to tip, and after 10 minutes, rinse out as normal."
                                            },
                                            {
                                                "example_id": "a639291a-5030-4875-9e48-3c593e7efb74",
                                                "sense_id": "7ec5aa2f-1a58-3ef6-a4c4-c726e2463c45",
                                                "text": "WellnessTok has done it again. After convincing people to shampoo once monthly and tan with nasal spray, it now has users asking: Is sunscreen bad for you?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "77c5cf23-95dc-376f-9a2a-43039a2f1e80",
                                        "entry_id": "aafc41ba-ce00-3258-b78d-94f11a8494e3",
                                        "glosses": [
                                            "To wash (i.e. the hair, carpet, etc.) with shampoo."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "08f8dc72-2cd6-47a6-a7e0-10d123a7fc6b",
                                                "sense_id": "77c5cf23-95dc-376f-9a2a-43039a2f1e80",
                                                "text": "Each pony had his sais, his groom, who lived and ate and slept with the animal, and had betted a good deal more than he could afford on the result of the game. There was no chance of anything going wrong, but to make sure, each sais was shampooing the legs of his pony to the last minute. Behind the saises sat as many of the Skidars' regiment as had leave to attend the match […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f8ec0cc-19f6-38d2-bee3-e882fae0dec9",
                                        "entry_id": "aafc41ba-ce00-3258-b78d-94f11a8494e3",
                                        "glosses": [
                                            "To press or knead the whole surface of the body of (a person), and at the same time to stretch the limbs and joints, in connection with the hot bath."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
