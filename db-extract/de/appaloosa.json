                                    {
                                        "sense_id": "57bcb985-162b-327f-9afc-f8f7ffa9e7f7",
                                        "entry_id": "3c4f772a-52a2-3685-ad43-159a00c61033",
                                        "glosses": [
                                            "A catfish."
                                        ],
                                        "tags": [
                                            "Southern-US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e76c14e4-a29d-4f18-9761-fc87a086ca19",
                                                "sense_id": "57bcb985-162b-327f-9afc-f8f7ffa9e7f7",
                                                "text": "A big fish wends its way towards the shape the light makes, stops and sucks at air. Mottled brown and black, with a pink, appaloosa mouth."
                                            },
                                            {
                                                "example_id": "f74627cf-6ea1-43aa-ad11-8cab396aa680",
                                                "sense_id": "57bcb985-162b-327f-9afc-f8f7ffa9e7f7",
                                                "text": "On a two-day camp out at Red Bluff on the Angelina River in East Texas, we had out twelve trotlines, fishing for mud, appaloosa, blue and channel catfish."
                                            }
                                        ]
                                    }
