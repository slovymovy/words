                "senses": [
                    {
                        "sense_id": "349be78e-e870-3a49-aa65-a883ed3a700c",
                        "entry_id": "ba6418ad-1f39-361b-9b22-5de9840f1198",
                        "glosses": [
                            "птенец лебедя"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "79e7a1ac-bb2b-43a7-9940-3980ecef6341",
                                "sense_id": "349be78e-e870-3a49-aa65-a883ed3a700c",
                                "text": "Подрастут лебедята, — отец с матерью выведут их сперва на воду, а потом начнут учить летать."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "39d33a89-cc18-440f-9d9f-8a03bf11915d",
                        "source_entry_id": "ba6418ad-1f39-361b-9b22-5de9840f1198",
                        "source_sense_id": "349be78e-e870-3a49-aa65-a883ed3a700c",
                        "target_lang_word": "cygnet",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cygnet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5cc3ac51-2fdd-3ace-a035-893f631ba944",
                                        "entry_id": "8104324f-2648-30ec-afcd-28ea4328efdd",
                                        "glosses": [
                                            "The young of a swan."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1303c0e-c29e-49ba-8aef-f88d8c8a2f06",
                                                "sense_id": "5cc3ac51-2fdd-3ace-a035-893f631ba944",
                                                "text": "I am the cygnet to this pale faint swan,\nWho chants a doleful hymn to his own death,\nAnd from the organ-pipe of frailty sings\nHis soul and body to their lasting rest."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
