                        "glosses": [
                            "Liquide qui surnage lorsque le sang se coagule."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "ddc4c01d-c0ec-3e97-a89e-8f5c175184a6",
                        "entry_id": "68809d2c-4d40-3ce6-a1b0-1559f54a6cba",
                        "glosses": [
                            "Liquide que l’on extrait du sang ou que l’on prépare artificiellement pour divers emplois thérapeutiques."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "45ede465-b3c2-4dba-8e10-58fb1ddb7ea3",
                                "sense_id": "ddc4c01d-c0ec-3e97-a89e-8f5c175184a6",
                                "text": "J’ai laissé mes yeux traîner sur les étagères. Crèmes de jour, de nuit, masques hydratants, purifiants, gommages, sérums antifatigue."
                            },
                            {
                                "example_id": "cfa23a78-e8a0-4398-a8b7-435794570bcd",
                                "sense_id": "ddc4c01d-c0ec-3e97-a89e-8f5c175184a6",
                                "text": "[…] et la semaine dernière, « faute de sérum », deux de ses adjoints, « des jeunes gars brillants du Lancashire », sont morts après s’être fait piquer par des cobras dans les marais jouxtant la ville."
                            }
                        ]
                    }
