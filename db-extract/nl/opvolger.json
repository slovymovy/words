                                    {
                                        "sense_id": "f5447c16-d0d2-3148-9bc5-883100ea4e4a",
                                        "entry_id": "340a41aa-3758-365a-9459-8bd8f5059e92",
                                        "glosses": [
                                            "Personne qui succède à une autre dans une fonction, un titre, un rôle ou une institution."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "35228d8f-405a-4290-9220-380d0bbf6ab5",
                                                "sense_id": "f5447c16-d0d2-3148-9bc5-883100ea4e4a",
                                                "text": "Le Curé, en mourant, devait laisser à son successeur, un lit garni, un pot de cuivre , un crémail, quelques petits meubles de bois et une poêle à frire."
                                            },
                                            {
                                                "example_id": "efa3e8d1-6344-4bbc-92fe-5c0fa2d3bc98",
                                                "sense_id": "f5447c16-d0d2-3148-9bc5-883100ea4e4a",
                                                "text": "Les successeurs de Descartes nient l'efficace des causes secondes."
                                            },
                                            {
                                                "example_id": "a0f33bb9-0172-4af6-9299-976ac5549791",
                                                "sense_id": "f5447c16-d0d2-3148-9bc5-883100ea4e4a",
                                                "text": "En combinant avec les observations si précises de M. Edwards celles de ses devanciers et de ses successeurs, nous pouvons en tirer une conclusion générale."
                                            },
                                            {
                                                "example_id": "691c00bd-7e6f-40a3-8a6f-d18145579505",
                                                "sense_id": "f5447c16-d0d2-3148-9bc5-883100ea4e4a",
                                                "text": "L’évêque de Chartres venait de mourir et son successeur était l’un des plus vieux amis de Gévresin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "17f47750-7862-3d29-9568-774d26cd7b81",
                                        "entry_id": "340a41aa-3758-365a-9459-8bd8f5059e92",
                                        "glosses": [
                                            "Nombre ou point qui suit un autre."
