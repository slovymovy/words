                "senses": [
                    {
                        "sense_id": "4e3ad892-ea88-3e36-8b44-9e574b6c85fc",
                        "entry_id": "d267df4a-a7b8-305a-94f8-e8213bec5f67",
                        "glosses": [
                            "Tür eines Zugabteils"
                        ],
                        "tags": [
                            "Verkehr",
                            "speziell Eisenbahn"
                        ],
                        "examples": [
                            {
                                "example_id": "64a648b2-5e38-4920-b64b-162c0b8691d7",
                                "sense_id": "4e3ad892-ea88-3e36-8b44-9e574b6c85fc",
                                "text": "Auf meiner letzten Zugfahrt war die Abteiltür defekt."
                            },
                            {
                                "example_id": "44f06305-df32-4731-8493-5053cdc027cb",
                                "sense_id": "4e3ad892-ea88-3e36-8b44-9e574b6c85fc",
                                "text": "„Wir packten unsere Sachen zusammen, und ich wollte die Abteiltür öffnen, da hielt mich Papa noch zurück und sagte etwas sehr Seltsames.“"
                            },
                            {
                                "example_id": "6a22e5db-1669-41d3-b91a-f5ea82d7d032",
                                "sense_id": "4e3ad892-ea88-3e36-8b44-9e574b6c85fc",
                                "text": "„Ein Zöllner zog die Abteiltür auf, kontrollierte nach dem letzten Halt in Belgien die Pässe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
