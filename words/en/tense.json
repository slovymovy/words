            "senses": [
                {
                    "sense_id": "f33acb22-b0e0-31c2-b97f-241fead21f25",
                    "sense_definition": "A grammatical category or form of a verb used to indicate the time of an action or state.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "grammar_time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teacher explained how to use the past <w>tense</w> correctly.",
