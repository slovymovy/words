                "translations": [
                    {
                        "translation_id": "10368a81-b57b-4fc9-b209-46f1ace5a883",
                        "source_entry_id": "da555d36-dd00-39da-8d28-be632529556d",
                        "source_sense_id": "48605c4b-c3ed-3aca-a1cc-f6126b4d226b",
                        "target_lang_word": "Kommunist",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kommunist",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a31a4ad7-1e38-36f2-b76c-43b9e72f0a3b",
                                        "entry_id": "729c7f63-46de-3583-bd4d-61a348bda14f",
                                        "glosses": [
                                            "Anhänger des Kommunismus"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c9914db8-7958-4d5b-81f4-f1418d156b7a",
                                                "sense_id": "a31a4ad7-1e38-36f2-b76c-43b9e72f0a3b",
                                                "text": "„Die CIA machte sich ans Werk und kaufte sich zunächst eine neue laotische Regierung, dann baute sie eine Guerillaarmee auf, die die Kommunisten bekämpfen und den Dschungelpfad angreifen sollte.“"
                                            },
                                            {
                                                "example_id": "b9d675e1-ca8f-4fb9-b8d1-49adaeb4c288",
                                                "sense_id": "a31a4ad7-1e38-36f2-b76c-43b9e72f0a3b",
                                                "text": "„Die Kommunisten wollten diese Gottesschöpfung verbessern, sie brauchten mehr Licht.“"
                                            },
                                            {
                                                "example_id": "c19ce51c-4ce8-40b8-bdf7-6382eb419c74",
                                                "sense_id": "a31a4ad7-1e38-36f2-b76c-43b9e72f0a3b",
                                                "text": "„Auch Fischer Knudsen, letzter Kommunist in dieser Kleinstadt an der mecklenburgischen Ostseeküste, kann nicht weg aus Deutschland, die Liebe zu seiner geistesverwirrten Frau bindet ihn.“"
                                            },
                                            {
                                                "example_id": "b6d125e0-4abd-40a6-be31-efede598c043",
                                                "sense_id": "a31a4ad7-1e38-36f2-b76c-43b9e72f0a3b",
                                                "text": "„Denn auch die Kommunisten sind in Äthiopien schon längst wieder Geschichte.“"
                                            },
                                            {
                                                "example_id": "8f6b0bca-8bf4-492b-8e12-623401480455",
                                                "sense_id": "a31a4ad7-1e38-36f2-b76c-43b9e72f0a3b",
                                                "text": "„Mein Vater war Kommunist, genauer: Maoist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eae51958-33bf-49ae-8a25-31d82bc107f8",
