                                    {
                                        "sense_id": "a2150633-6fd1-38bb-9142-cead9e1bda6a",
                                        "entry_id": "97b027f9-6fc0-3017-9942-879b5372d873",
                                        "glosses": [
                                            "het blijven steken in een kinderlijke ontwikkelingsfase"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2d1fdec-830a-4984-8e57-e1bb3a0417f2",
                                                "sense_id": "a2150633-6fd1-38bb-9142-cead9e1bda6a",
                                                "text": "Over het algemeen werd gedacht dat het infantilisme een reactie was op een ongekende dreiging voor de gehele beschaving."
                                            },
                                            {
                                                "example_id": "73c3c650-9015-4b90-ac55-ba2e0da8893d",
                                                "sense_id": "a2150633-6fd1-38bb-9142-cead9e1bda6a",
                                                "text": "Infantilisme aan het begin van de crisis: Veel van de gebeurtenissen in de eerste twintig jaar van het Crisistijdperk leken onbegrijpelijk voor degenen die ervoor kwamen en degenen die erna kwamen; historici vatten ze samen onder het kopje 'crisisinfantilisme'."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
