                            },
                            {
                                "target_word": "drastique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fdfa5ed3-0ae8-361f-be03-8cce5c656e73",
                                        "entry_id": "b84a485c-44db-300a-a014-57c24be825ed",
