                "senses": [
                    {
                        "sense_id": "875adf3b-887d-3b6f-9edb-b8f14589aa79",
                        "entry_id": "997d7272-832b-3300-8595-41f43ea01af7",
                        "glosses": [
                            "jemand, der einen Ort, eine Arbeitsstelle, einen Verein etc. verlässt, um woanders ein neues Tätigkeitsfeld, bessere Bedingungen zu finden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "731ae05e-7fde-456b-865f-0c4a0f44ebb9",
                                "sense_id": "875adf3b-887d-3b6f-9edb-b8f14589aa79",
                                "text": "„Noch zählt niemand die Milliarden Mark, die mit den Abwanderern ins Ausland verschwinden. Mit dem Stichwort ‚Globalisierung‘ verbinden Wirtschaftsforscher hierzulande vornehmlich die Effekte internationaler Billigkonkurrenz und der Verlagerung von Arbeitsplätzen und Investitionen ins Ausland.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
