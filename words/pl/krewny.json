        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "3f660b71-0014-3018-969b-9c67d2bff30b",
                    "sense_definition": "połączony pokrewieństwem, bliski",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "relacje",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Okazało się, że jest nam <w>krewny</w> ze strony matki.",
                            "target_lang_translations": {
                                "en": "It turned out that he is <w>related</w> to us on our mother's side.",
                                "ru": "Оказалось, что он <w>приходится нам родственником</w> по материнской линии.",
                                "nl": "Het bleek dat hij aan ons <w>verwant</w> is via moederskant.",
                                "de": "Es stellte sich heraus, dass er mütterlicherseits mit uns <w>verwandt</w> ist.",
                                "fr": "Il s'est avéré qu'il nous était <w>apparenté</w> du côté maternel.",
                                "it": "Si è scoperto che è <w>imparentato</w> con noi da parte di madre.",
                                "cs": "Ukázalo se, že je s námi <w>příbuzný</w> z matčiny strany.",
                                "tr": "Bizimle anne tarafından <w>akraba</w> olduğu ortaya çıktı.",
                                "es": "Resultó que está <w>emparentado</w> con nosotros por parte de madre.",
                                "zh": "事实证明，他与我们母亲那边<w>有亲戚关系</w>。"
                            }
                        },
                        {
                            "text": "Był mi <w>krewny</w> po mieczu, bo nasi dziadkowie byli braćmi.",
                            "target_lang_translations": {
                                "en": "He was <w>related</w> to me on the paternal side because our grandfathers were brothers.",
                                "ru": "Он был мне <w>родней</w> по отцовской линии, так как наши дедушки были братьями.",
                                "nl": "Hij was mij in de mannelijke lijn <w>verwant</w>, omdat onze grootvaders broers waren.",
