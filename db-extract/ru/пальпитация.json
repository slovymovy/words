                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Palpitation",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cb0e230c-c5b2-3789-8e63-7e0b79f85e6b",
                                        "entry_id": "4e7b8ae7-8eb4-3837-aaac-7d7e51a823e1",
                                        "glosses": [
                                            "als unangenehm wahrgenommene Herztätigkeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a0bfd65-55e2-4551-9206-cd723ab068be",
                                                "sense_id": "cb0e230c-c5b2-3789-8e63-7e0b79f85e6b",
                                                "text": "„Die Symptome [der Alkoholintoleranz] umfassen Gesichtsröte (flushing), Steigerung der Herzfrequenz, Palpitationen („Herzklopfen“), Hitzegefühl im Magen und Muskelschwäche.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
