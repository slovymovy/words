                        "glosses": [
                            "ein Lebewesen, das ohne Luftsauerstoff nicht überleben kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee6837a2-33f0-4b0f-a288-fdfd5e871f6c",
                                "sense_id": "58c4bb4b-1abe-3906-821f-ae134ec3d396",
                                "text": "Fast alle Tiere, die meisten Pilze und viele Bakterien sind obligate Aerobier, d. h., sie haben nur einen Atmungsstoffwechsel mit molekularem Sauerstoff (O₂) (aerobe Atmung)."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "650963ac-f0a9-486d-a525-f28ba980d68e",
