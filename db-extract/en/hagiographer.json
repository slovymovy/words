                                        "sense_id": "53af4ed0-720d-31d2-86d3-2a29c0495be9",
                                        "entry_id": "06cdb040-301f-38ed-9f1d-238d43e350f8",
                                        "glosses": [
                                            "En la Biblia hebrea, autor de cualquiera de los libros comprendidos en la tercera parte de ella."
                                        ],
