    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "20656bd7-d884-382d-9e0b-43d60779fae8",
                "word": "ablative",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "72ddbfbd-c090-3eb0-b814-01eccaf7df1d",
                        "entry_id": "20656bd7-d884-382d-9e0b-43d60779fae8",
                        "glosses": [
                            "Applied to one of the cases of the noun in some languages, the fundamental meaning of the case being removal, separation, or taking away, and to a lesser degree, instrument, place, accordance, specifications, price, or measurement."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "211811aa-1082-38b9-990b-16aa517e6bcb",
                        "entry_id": "20656bd7-d884-382d-9e0b-43d60779fae8",
                        "glosses": [
                            "Pertaining to taking away or removing."
                        ],
                        "tags": [
                            "archaic",
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "5b435c9f-678a-4fe8-bb48-877d25a970ba",
                                "sense_id": "211811aa-1082-38b9-990b-16aa517e6bcb",
                                "text": "Where the heart is forestalled with misopinion, ablative directions are found needful to unteach error, ere we can learn truth."
                            }
                        ]
                    },
                    {
                        "sense_id": "63781508-446d-3de5-b0c9-e324a43a428f",
                        "entry_id": "20656bd7-d884-382d-9e0b-43d60779fae8",
                        "glosses": [
                            "Sacrificial, wearing away or being destroyed in order to protect the underlying material, as in ablative paints used for antifouling, or ablative heat shields used to protect spacecraft during reentry. ."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "565cb03e-dc1c-4d33-943d-7e64b145421d",
                                "sense_id": "63781508-446d-3de5-b0c9-e324a43a428f",
                                "text": "The inner layer of warship protection consists of ablative armor plate designed to \"boil away\" when heated. The vaporized armor material scatters a DEW beam, rendering it ineffectual."
                            }
                        ]
                    },
                    {
                        "sense_id": "1413f1dd-ef09-31f7-8c4b-e07d483b0c95",
                        "entry_id": "20656bd7-d884-382d-9e0b-43d60779fae8",
                        "glosses": [
                            "Relating to the removal of a body part, tumor, or organ."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "ab6883f5-e5d6-3fb3-8725-cb9fc141f5ee",
                        "entry_id": "20656bd7-d884-382d-9e0b-43d60779fae8",
                        "glosses": [
                            "Relating to the erosion of a land mass; relating to the melting or evaporation of a glacier."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "624c44f5-de55-4289-a4c4-342e0f7e1288",
                        "source_entry_id": "20656bd7-d884-382d-9e0b-43d60779fae8",
                        "source_sense_description": "applied to one of the cases of the noun in other language",
                        "target_lang_word": "ablatif",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ablatif",
