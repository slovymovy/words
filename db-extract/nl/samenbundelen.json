                        "examples": [
                            {
                                "example_id": "7e72245a-3f60-438c-9b10-d4f8e45257fb",
                                "sense_id": "b780f298-291d-3c25-8a7a-d9611a35413f",
                                "text": "„Waar ze in sommige landen nog echt bezig zijn met de basisbehoeften, kijken we in Nederland al naar problemen in de toekomst. Onze kracht ligt in het samenbundelen van onze kijk op de wereld.’’"
                            },
                            {
                                "example_id": "52d3fec8-814f-4072-8783-b12e0889a9db",
                                "sense_id": "b780f298-291d-3c25-8a7a-d9611a35413f",
                                "text": "Tevens denkt de commissaris aan subsidies voor het aantrekken van toponderzoekers, het inhuren van adviseurs voor innovatie en het stichten van centra waar bedrijven hun onderzoek kunnen samenbundelen."
                            }
                        ]
                    }
