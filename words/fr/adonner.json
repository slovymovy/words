            "senses": [
                {
                    "sense_id": "1161f7e3-9c56-30ef-9f39-25b019c80a28",
                    "sense_definition": "S'appliquer entièrement à une occupation, s'y livrer avec passion ou habitude.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "consécration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Depuis sa retraite, il s'<w>adonne</w> à la peinture plusieurs heures par jour."
                        },
                        {
                            "text": "Elle refuse de s'<w>adonner</w> à des activités futiles durant ses moments de répit."
                        }
                    ],
                    "synonyms": [
                        "se consacrer"
                    ],
                    "common_phrases": [
                        "s'adonner à la lecture",
                        "s'adonner à un sport"
                    ]
                },
                {
                    "sense_id": "c894f461-c4c1-3f65-9857-e0f745ba3449",
                    "sense_definition": "Tourner vers l'arrière du bâtiment d'une manière favorable à l'allure, en parlant du vent.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "navigation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dès que la brise <w>adonne</w>, l'équipage ajuste les voiles pour accélérer."
                        },
                        {
                            "text": "Le navigateur attendait patiemment que le vent <w>adonne</w> pour virer de bord."
                        }
                    ],
                    "antonyms": [
                        "refuser"
                    ],
                    "common_phrases": [
                        "le vent adonne"
                    ]
                },
                {
                    "sense_id": "81ea5793-e018-350b-be1e-0947263a99d1",
                    "sense_definition": "Être convenable, arranger ou convenir au regard des circonstances.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "convenance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Passe me voir demain matin si l'horaire t'<w>adonne</w>."
                        },
                        {
                            "text": "Cette date ne m'<w>adonne</w> pas du tout à cause d'une autre réunion."
                        }
                    ],
                    "common_phrases": [
