                "senses": [
                    {
                        "sense_id": "c3c28adb-85a1-309d-9485-e33da8830316",
                        "entry_id": "7aa20c62-9799-3ba2-b807-5f73ee1c47d9",
                        "glosses": [
                            "długa kłująca broń drzewcowa o małym grocie, używana przez pieszych i konnych Kozaków w XVI–XIX wieku, odmiana europejskiej piki"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "07957b35-5b34-4b8b-a9ee-0ff49ab4800e",
                                "sense_id": "c3c28adb-85a1-309d-9485-e33da8830316",
                                "text": "Pułki płynęły za pułkami, konni Zaporożcy zbrojni w długie spisy, pieszy lud z samopałami i fale chłopstwa zbrojnego w kosy, cepy i widły"
                            },
                            {
                                "example_id": "815ab6e9-af01-40ee-95a3-dc52b1996497",
                                "sense_id": "c3c28adb-85a1-309d-9485-e33da8830316",
                                "text": "Do miasta […] wjeżdżali kozacy na koniach. Ogromni, ciency w pasie, w czapach o czerwonych denkach, ze spisami w kulbace"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
