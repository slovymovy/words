                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "premonition",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b36becde-2032-34b2-9d0c-b137f1823b87",
                                        "entry_id": "b5160aeb-7717-31f1-a02d-870b89f5f1e0",
                                        "glosses": [
                                            "A clairvoyant or clairaudient experience, such as a dream, which resonates with some event in the future."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "06fa0608-2cce-3efa-a78c-6254bf2babe9",
                                        "entry_id": "b5160aeb-7717-31f1-a02d-870b89f5f1e0",
                                        "glosses": [
                                            "A strong intuition that something is about to happen (usually something negative, but not exclusively)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2318bcaa-5d37-40b0-829c-84c4fa1f0d49",
                                                "sense_id": "06fa0608-2cce-3efa-a78c-6254bf2babe9",
                                                "text": "The sinister face of Dr. Bauerstein recurred to me unpleasantly. A vague suspicion of everyone and everything filled my mind. Just for a moment I had a premonition of approaching evil."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d9cb7e1d-9e36-43e7-8c76-9e0858070a25",
