                                        "entry_id": "16b602d9-f40f-3280-a4a5-f94371575935",
                                        "glosses": [
                                            "Unmanageable; impervious to correction by punishment or pain."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "984a41c1-967e-4a19-a472-499717222f07",
                                                "sense_id": "4a28c422-2506-3644-a880-739db2f90763",
                                                "text": "an incorrigible youth"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "83e1d114-e5f0-3473-9a19-48b1f6d67209",
                                        "entry_id": "16b602d9-f40f-3280-a4a5-f94371575935",
                                        "glosses": [
                                            "Incurably depraved; not reformable."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0540b552-b2ba-45a3-8033-a088079dcdc7",
                                                "sense_id": "83e1d114-e5f0-3473-9a19-48b1f6d67209",
                                                "text": "His dark soul was too incorrigible to repent, even at his execution."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6d778967-d9b7-39f6-af7a-0875503afa1d",
                                        "entry_id": "16b602d9-f40f-3280-a4a5-f94371575935",
                                        "glosses": [
                                            "Unchangeably established in a belief or habit."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d51acc45-d1f4-4c13-8fa6-8701da1bf8ac",
                                                "sense_id": "6d778967-d9b7-39f6-af7a-0875503afa1d",
                                                "text": "Gordon Brown may have his grumpy, Granita moments, but as a strategist he is an incorrigible optimist."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2f795871-6f58-3cc8-9484-e316e518e933",
                                        "entry_id": "16b602d9-f40f-3280-a4a5-f94371575935",
                                        "glosses": [
                                            "Intrinsically incapable of being corrected; impossible to disprove, by its very nature."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1520e739-3cc3-4c47-9cb4-c15a8df7c118",
                                                "sense_id": "2f795871-6f58-3cc8-9484-e316e518e933",
                                                "text": "The statement \"My knee hurts\" is incorrigible."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "85d48393-daa8-3972-90ed-e40f0cb018f7",
                                        "entry_id": "16b602d9-f40f-3280-a4a5-f94371575935",
                                        "glosses": [
                                            "Impossible to cure."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1707a7f3-9476-45e5-91e0-4b16274177a1",
                                                "sense_id": "85d48393-daa8-3972-90ed-e40f0cb018f7",
                                                "text": "It may appear as an epidemic, as a hereditary complaint, or as an obstinate and incorrigible disease again and again recurring."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "incorrigible",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a5dcd2b4-ae9c-3e0d-bee6-261af74b5e00",
                                        "entry_id": "c6efdc4b-6ac7-344a-87f2-14bed07cc66e",
                                        "glosses": [
