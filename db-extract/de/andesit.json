                    },
                    {
                        "translation_id": "6d3bd740-5a52-4ac5-88a0-f7d534a5cc8c",
                        "source_entry_id": "7abf607c-ee08-340f-997a-59828adc426e",
                        "source_sense_id": "8cd25545-33e1-3eaa-b7f0-b222f50b3183",
                        "source_sense_description": "graues, magmatisches Ergussgestein, bestehend aus Plagioklas und Amphibol oder Pyroxen",
                        "target_lang_word": "andésite",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "andésite",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a36a2b49-33b7-354a-853c-d0e7e02022fe",
                                        "entry_id": "9c2710be-0206-38ec-9106-9519d6cc24e4",
                                        "glosses": [
                                            "Roche éruptive composée principalement d’andésine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "59b38669-f3d7-4cdd-ac4d-93a5f2100abb",
                                                "sense_id": "a36a2b49-33b7-354a-853c-d0e7e02022fe",
                                                "text": "L’andésite, comme la plupart des roches volcaniques, présente une texture microlitique."
                                            },
                                            {
                                                "example_id": "e9f3c664-483f-4c29-89ec-f308ff6de6c3",
                                                "sense_id": "a36a2b49-33b7-354a-853c-d0e7e02022fe",
                                                "text": "Les andésites sont caractéristiques des zones de convergence."
                                            },
                                            {
                                                "example_id": "74e0d469-c4ed-478c-a74b-b402c5cc820c",
                                                "sense_id": "a36a2b49-33b7-354a-853c-d0e7e02022fe",
                                                "text": "Les produits émis par les volcans dans ces zones sont principalement des andésites (roches des Andes), dont la composition, riche en aluminium et potassium, est chimiquement voisine de celle de la croûte continentale."
                                            },
                                            {
                                                "example_id": "ad6b5c7b-5a63-4c9d-a012-cf663baa4e24",
                                                "sense_id": "a36a2b49-33b7-354a-853c-d0e7e02022fe",
                                                "text": "Quant à la composition, le facteur dominant est la proportion en silice (SiO₂), présente sous la forme ionique, l’ion silicate SiO₄⁻, qui varie de 50 pour cent environ dans les laves basaltiques à 58 pour cent dans les andésites et est supérieure à 70 pour cent dans les laves les plus visqueuses, les rhyolites."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
