                "senses": [
                    {
                        "sense_id": "39e60c00-453e-37f7-98e3-0cf0953bc865",
                        "entry_id": "38287943-69c3-3843-981b-02a7fcd5ccdc",
                        "glosses": [
                            "ein Pfeiler, der als Bauteil ein Relief trägt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "93ccf3e4-5fd7-4a5b-a2f7-75798a36f729",
                                "sense_id": "39e60c00-453e-37f7-98e3-0cf0953bc865",
                                "text": "„Der auf drei Seiten verzierte Reliefpfeiler diente ursprünglich als Türrahmen eines nicht näher bestimmbaren Gebäudes in Sumelocenna […].“"
                            },
                            {
                                "example_id": "3432fa24-2bb2-40ab-889c-aae32f778f20",
                                "sense_id": "39e60c00-453e-37f7-98e3-0cf0953bc865",
                                "text": "„Laut Guinnessbuch der Rekorde von 1997 lautet das längste deutsche Ein-Wort-Palindrom Reliefpfeiler, wobei jedoch das Wort Retsinakanister noch länger ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
