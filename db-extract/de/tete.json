                "senses": [
                    {
                        "sense_id": "b3e4bd38-ddc6-3c33-9592-65a8ceb65bb9",
                        "entry_id": "dc0551b9-f9c5-31d8-b3da-7394584e7c70",
                        "glosses": [
                            "head (of a military unit), lead"
                        ],
                        "tags": [
                            "dated",
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "32aa54ae-edec-48a3-858a-1992023f0ffd",
                                "sense_id": "b3e4bd38-ddc6-3c33-9592-65a8ceb65bb9",
                                "text": "die Tete nehmen",
                                "translation": "to take the lead",
                                "english": "to take the lead"
                            },
                            {
                                "example_id": "3af0ae99-7c61-4ac1-9b35-4c7c7c865b57",
                                "sense_id": "b3e4bd38-ddc6-3c33-9592-65a8ceb65bb9",
                                "text": "[…]so würde es sich vielleicht empfehlen, die Fahrt gemeinschaftlich zu machen, wobei dann der landrätliche Schlitten die Tete zu nehmen und der Crampassche zu folgen hätte."
                            }
                        ]
                    },
                    {
                        "sense_id": "b28ea2b1-ebaf-352d-b05b-d525ac9b38f1",
                        "entry_id": "dc0551b9-f9c5-31d8-b3da-7394584e7c70",
                        "glosses": [
                            "synonym of Kopfnote (“top note”)"
                        ],
                        "tags": [
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "a9b75e9c-edf0-41d8-a8b4-b8b4ef3f871f",
                                "sense_id": "b28ea2b1-ebaf-352d-b05b-d525ac9b38f1",
                                "text": "Die Kopfnote, die Tete oder der Angeruch, gibt den ersten Eindruck wieder und ist oft schon entscheidend für Akzeptanz oder Ablehnung. In der Kopfnote finden sich dementsprechend hauptsächlich leicht flüchtige Stoffe."
                            }
                        ]
                    }
