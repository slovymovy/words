                    },
                    {
                        "translation_id": "9dbfb02a-8bef-4c15-b123-23be530e9b46",
                        "source_entry_id": "cebe8978-360e-3c2f-8f00-e86ca358bc84",
                        "source_sense_id": "004eed52-6a89-35be-b623-5cbed63d67be",
                        "target_lang_word": "semi-conducteur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "semi-conducteur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0b687a2d-da3d-3af2-99b3-47b0e67b453e",
                                        "entry_id": "a7bf95ae-59ef-3d26-aca5-516fab9228bf",
                                        "glosses": [
                                            "Matériau présentant une conductivité électrique intermédiaire entre les métaux et les isolants."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b7c65403-7d15-4a5c-a4c1-a57f3e05a45d",
                                                "sense_id": "0b687a2d-da3d-3af2-99b3-47b0e67b453e",
                                                "text": "Les semi-conducteurs sont primordiaux parce qu’ils offrent la possibilité de contrôler à la fois la quantité de courant électrique les traversant et la direction de ce courant."
                                            },
                                            {
                                                "example_id": "42df268a-3200-4e7c-aa38-5b05404b395e",
                                                "sense_id": "0b687a2d-da3d-3af2-99b3-47b0e67b453e",
                                                "text": "L’effet photovoltaïque se manifeste lorsqu’un semi-conducteur absorbe de la lumière. En acceptant l’énergie des photons, les électrons de la bande de valence des semi-conducteurs passent dans la bande de conduction et créent ainsi des paires électron-trou."
                                            },
                                            {
                                                "example_id": "9f2e6c20-8519-4206-b2c4-eed209a983c0",
                                                "sense_id": "0b687a2d-da3d-3af2-99b3-47b0e67b453e",
                                                "text": "L’industrie du semi-conducteur a suivi pendant longtemps la loi de Moore: environ tous les deux ans, elle est parvenue à doubler le nombre de transistors sur une puce. Mais, depuis quelques années, cette progression a été enrayée, certains éléments ayant atteint leur limite inférieure de taille."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "semi-conducteur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d91285f4-8cd8-31bb-afa3-bba072680435",
                                        "entry_id": "7a09681d-6805-3c59-a5ee-40d24d72166f",
                                        "glosses": [
                                            "Qui présente une conductivité électrique intermédiaire entre les métaux et les isolants."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "070c5b3c-f01f-411b-be14-893b7ec49cb5",
                                                "sense_id": "d91285f4-8cd8-31bb-afa3-bba072680435",
                                                "text": "Une céramique semi-conductrice."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ffb7eb9a-7ea9-4a3d-85ac-170e79e36d5e",
                        "source_entry_id": "cebe8978-360e-3c2f-8f00-e86ca358bc84",
                        "source_sense_id": "004eed52-6a89-35be-b623-5cbed63d67be",
                        "target_lang_word": "semiconductor",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "semiconductor",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "4725cd82-dd88-3578-b571-d115b0926b62",
                                        "entry_id": "afcb88f2-6e87-3f66-9ccf-d3067c1dbb0c",
                                        "glosses": [
                                            "Nombre genérico aplicado a cualquier material que conduzca la electricidad bajo ciertas condiciones, encuentran aplicación en la fabricación de componentes y dispositivos electrónicos."
                                        ],
                                        "tags": [
                                            "noun"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c3db8c5f-f080-4edb-9c34-d95ec13c992b",
                        "source_entry_id": "cebe8978-360e-3c2f-8f00-e86ca358bc84",
                        "source_sense_id": "004eed52-6a89-35be-b623-5cbed63d67be",
                        "target_lang_word": "Halbleiter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Halbleiter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a76e1f12-ef4b-36f5-8bed-5535d3eeeffd",
                                        "entry_id": "93d5900c-8f6f-3f9a-bedd-b6fefbd30a80",
                                        "glosses": [
                                            "ein Stoff/Material, der/das für den elektrischen Strom unter bestimmten Voraussetzungen leitend oder sperrend ist."
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9c694c32-eff3-49a7-9e49-06e773b31be8",
                                                "sense_id": "a76e1f12-ef4b-36f5-8bed-5535d3eeeffd",
                                                "text": "Silizium ist ein guter Halbleiter, deshalb sind viele Elektronikteile aus diesem Material."
                                            },
                                            {
                                                "example_id": "cc2bce9e-ff14-4937-8931-f8b314389eaa",
                                                "sense_id": "a76e1f12-ef4b-36f5-8bed-5535d3eeeffd",
                                                "text": "„Der Übergang von Halbleitern zu Isolatoren ist fließend. So wird beispielsweise Galliumnitrid (GaN; Einsatz in blauen LEDs) mit einer Bandlückenenergie von ≈ 3,2 eV ebenfalls zu den Halbleitern gezählt, Diamant mit einer Bandlücke von ≈ 5,5 eV aber nicht mehr.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
