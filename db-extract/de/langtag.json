                ],
                "senses": [
                    {
                        "sense_id": "0310ad6f-f252-39a9-a66c-99f415028ae9",
                        "entry_id": "86b64436-4ebd-3c16-aaf5-61b5d6ef832f",
                        "glosses": [
                            "Tag, an dem die Tageslänge der Länge der Nacht gleicht oder sie übertrifft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89d7a40b-6a60-446e-a378-50403e55c170",
                                "sense_id": "0310ad6f-f252-39a9-a66c-99f415028ae9",
                                "text": "Der Wechsel vom Langtag in den Kurztag induziert maximale Blütenbildung und kann daher in seiner Wirkung durch Gibberellin, das gleichzeitig mit der Umstellung in den Kurztag gegeben wurde, nicht verstärkt werden (…)."
                            },
                            {
                                "example_id": "0015ae91-e4f8-49fd-92b6-33bd29137f0f",
                                "sense_id": "0310ad6f-f252-39a9-a66c-99f415028ae9",
                                "text": "Im kontinuierlichen Langtag oder durch Störlicht bleiben die untersuchten Arten ebenfalls beliebig lange vegetativ."
                            },
                            {
                                "example_id": "25be18bc-c380-4531-9635-536db4ae5887",
                                "sense_id": "0310ad6f-f252-39a9-a66c-99f415028ae9",
                                "text": "Da der Langtag den Weizen zum Schossen zwingt, werden vor allem in den späten Nebentrieben weniger Spindelstufen gebildet."
                            },
                            {
                                "example_id": "8028d04c-ebeb-41d2-8a69-c343c938b391",
                                "sense_id": "0310ad6f-f252-39a9-a66c-99f415028ae9",
                                "text": "Begonien sind fakultative Kurztagpflanzen. Im Langtag über 14 h wird das vegetative Wachstum gefördert, im Kurztag unter 13 h die Blütenbildung."
                            },
                            {
                                "example_id": "c8c35d0f-03ab-40a9-ad42-eed2f03401c6",
                                "sense_id": "0310ad6f-f252-39a9-a66c-99f415028ae9",
                                "text": "Durch ein Absenken der Temperatur unter 18 °C (aber nicht unter 14 °C) werden auch im Langtag Knospen angelegt und weiterentwickelt."
                            },
                            {
                                "example_id": "4d7feed8-3309-4cd0-8099-df4f9a5d1962",
                                "sense_id": "0310ad6f-f252-39a9-a66c-99f415028ae9",
                                "text": "Zum erfolgreichen Anbau früher Kartoffelsorten ist ein Langtag von 15 bis 17 Stunden erforderlich, spätreifende Sorten erzielen sowohl unter Kurztags- als auch Langtagsbedingungen gute Ernten. Siehe dazu Photoperiodismus."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
