            "pos": "verb",
            "senses": [
                {
                    "sense_id": "02cda4b1-a686-34f0-8510-14f17c2d43ae",
                    "sense_definition": "minder gespannen of strak worden, vaak met betrekking tot aandacht of fysieke spanning",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "ontspanning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De leraar probeerde de les interessant te houden zodat de aandacht niet zou <w>verslappen</w>.",
                            "target_lang_translations": {
                                "en": "The teacher tried to keep the lesson interesting so that attention would not <w>wane</w>."
                            }
                        },
                        {
                            "text": "Je moet de aandacht niet laten <w>verslappen</w> tijdens deze belangrijke presentatie.",
                            "target_lang_translations": {
