                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e0d82fac-4984-40d5-bf5c-f64ce45e55c5",
                        "source_entry_id": "51190afe-5b13-3471-af63-b09f07b4417d",
                        "source_sense_id": "ce30e7b6-7131-3eca-a368-7135e7e2f1f3",
                        "source_sense_description": "Staatsbürger von Rumänien",
                        "target_lang_word": "Romanian",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Romanian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d9e2d90f-4988-3114-8a8f-2b16aa229c47",
                                        "entry_id": "82d0f617-029b-34bc-9a5a-d375ed3d1536",
                                        "glosses": [
                                            "Of or relating to Romania, the Romanian people, or the Romanian language."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "84d5deeb-e58b-4622-ac6c-cd53f9fbd023",
                                                "sense_id": "d9e2d90f-4988-3114-8a8f-2b16aa229c47",
                                                "text": "The oldest Romanian period (also known as Common Romanian, Proto-Romanian, Primitive Romanian) is the period prior to the separation of the four Romanian dialects: a north-Danubian dialect (Daco-Romanian) and three south-Danubian dialects (Aromanian / Macedo-Romanian, Megleno-Romanian, and Istro-Romanian)."
                                            },
                                            {
                                                "example_id": "abc6b949-f704-4d96-bd7a-097c79b592cf",
                                                "sense_id": "d9e2d90f-4988-3114-8a8f-2b16aa229c47",
                                                "text": "The leader of far-right opposition party AUR, George Simion, who has been backing Georgescu in his presidential bid, was among the first to react to CCR's decision. In a post on X, he said, \"What a disgrace! Once again, the Constitutional Court is mocking the Romanian people, is attacking our democracy and our essential rights & freedoms. We stand with Călin Georgescu!”"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Romanian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9a9d8535-eb13-3f47-b4bc-ecdbbd010314",
                                        "entry_id": "ef3b6cdc-b284-3c47-94a0-3451ba4efc8d",
                                        "glosses": [
                                            "A native of Romania."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "430be83a-de18-36f1-9eed-84a90904e26d",
                                        "entry_id": "ef3b6cdc-b284-3c47-94a0-3451ba4efc8d",
                                        "glosses": [
                                            "The official language of Romania and Moldova."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "59f80c5a-2297-4672-b277-d348aba1a0e9",
                                                "sense_id": "430be83a-de18-36f1-9eed-84a90904e26d",
                                                "text": "USR leader Elena Lasconi, who was supposed to face Georgescu in the second round of the 2024 presidential elections and is expected to run again this year, also reacted to the news, saying, “I hope the CCR's decision is just a first step. […] Romanians need to regain their trust in institutions!”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a7d39075-08b1-3804-90c6-9f933d5584c8",
                                        "entry_id": "ef3b6cdc-b284-3c47-94a0-3451ba4efc8d",
                                        "glosses": [
                                            "Ellipsis of Romanian deadlift."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "countable",
                                            "ellipsis",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d36311c4-6487-4de5-a8b2-24f7badc7659",
                                                "sense_id": "a7d39075-08b1-3804-90c6-9f933d5584c8",
                                                "text": "I think there was this one Black guy in there who was practically crying.\nI swear I could hear Sir Mixalot in my head whenever I did Romanians."
                                            },
                                            {
                                                "example_id": "b77306ef-2f0d-449d-8243-b123d497d219",
                                                "sense_id": "a7d39075-08b1-3804-90c6-9f933d5584c8",
                                                "text": "I did Romanians for a year and worked up to 250 for sets of 5. I couldn't take the DOMS anymore and dropped them."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1bf2c84d-37c6-45ed-a3a3-9cbd59bff7b5",
                        "source_entry_id": "51190afe-5b13-3471-af63-b09f07b4417d",
                        "source_sense_id": "ce30e7b6-7131-3eca-a368-7135e7e2f1f3",
                        "source_sense_description": "Staatsbürger von Rumänien",
                        "target_lang_word": "Roumain",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Roumain",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f8d56ca5-67a5-3f18-8421-a208c891e869",
                                        "entry_id": "a35f87b8-f5cf-395c-968d-ad72908eaaa1",
                                        "glosses": [
                                            "Originaire ou habitant de la Roumanie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ebc7640b-cf22-4107-ab2f-6521b8086335",
                                                "sense_id": "f8d56ca5-67a5-3f18-8421-a208c891e869",
                                                "text": "L’État national roumain, formé en 1859 par l’union de la Moldavie et de la Valachie et transformé en royaume depuis 1881, réussit enfin à englober dans sa structure toutes les provinces habitées majoritairement par des Roumains, en doublant presque sa surface géographique."
                                            },
                                            {
                                                "example_id": "83f548d0-6c3c-4ffc-bf62-35b6d8f7abd8",
                                                "sense_id": "f8d56ca5-67a5-3f18-8421-a208c891e869",
                                                "text": "Tu es fou, répondit le Roumain. Fou à lier, fondu, jobard et jobri."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Roumain",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "96035bd3-42e7-363a-bff1-f3fdf39cdffa",
                                        "entry_id": "7521bcfd-921f-3d93-a3f4-9065461a1d5d",
                                        "glosses": [
                                            "Nom de famille."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "594eef62-d082-40c8-bf8a-a8fb273fcc29",
                                                "sense_id": "96035bd3-42e7-363a-bff1-f3fdf39cdffa",
                                                "text": "Il faut « déshaïtianiser » Roumain et le placer dans un contexte mondial et latino-américain."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
