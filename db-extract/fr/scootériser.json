                "senses": [
                    {
                        "sense_id": "53a110fd-feaf-36d4-b0ea-5211361a9b8c",
                        "entry_id": "569ee4fc-46f5-33f8-a35f-ed6ef40e9c22",
                        "glosses": [
                            "Donner un caractère de scooter à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f3d672b0-aebc-403c-bb76-c36ad4a162e2",
                                "sense_id": "53a110fd-feaf-36d4-b0ea-5211361a9b8c",
                                "text": "Bouclier avant pour une Jawa 250 de 1960 + 2 latérales, capot de moteur, accessoires d'époque pour « scootériser » la moto."
                            }
                        ]
                    },
                    {
                        "sense_id": "45a66cf4-ba7e-39f5-8e5c-2fe87767fe7d",
                        "entry_id": "569ee4fc-46f5-33f8-a35f-ed6ef40e9c22",
                        "glosses": [
                            "Se doter d’un scooter."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9732dc23-1874-4b5b-b271-c1f35fdafc38",
                                "sense_id": "45a66cf4-ba7e-39f5-8e5c-2fe87767fe7d",
                                "text": "Cette année, mon Centre a déménagé (sans me le dire, ce qui m'aurait évité de scootériser en urgence pour être on time) et mon gentil ophtalmo a été remplacé par une vieille, qui roulait les R et qui venait du froid !"
                            }
                        ]
                    },
                    {
                        "sense_id": "4fbea24b-41fe-3359-aa84-0b0445a34551",
                        "entry_id": "569ee4fc-46f5-33f8-a35f-ed6ef40e9c22",
                        "glosses": [
                            "Faire du scooter."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "71204925-0db8-4f4e-a70e-e5e6f1719851",
                                "sense_id": "4fbea24b-41fe-3359-aa84-0b0445a34551",
                                "text": "Vivement le 10 septembre... pour scootériser à fond !"
                            }
                        ]
                    },
                    {
                        "sense_id": "1a3e4bcc-3eb8-3f48-9978-78275ed1f9fd",
                        "entry_id": "569ee4fc-46f5-33f8-a35f-ed6ef40e9c22",
                        "glosses": [
                            "Parcourir à scooter."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db9ef86b-770e-4eb4-bbdf-5dbf3c2394b5",
                                "sense_id": "1a3e4bcc-3eb8-3f48-9978-78275ed1f9fd",
                                "text": "Bonjour, juste pour partager le méga pied que nous avons pris à scootériser cette sublime cavité lotoise..."
                            }
                        ]
                    }
