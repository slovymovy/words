                    {
                        "translation_id": "13447af9-ff95-49fd-9c42-ed5de3ea9ecd",
                        "source_entry_id": "93a50f5b-40ab-30d3-bc9e-3f6f107a611a",
                        "source_sense_description": "синтез дочерней молекулы дезоксирибонуклеиновой кислоты на матрице родительской молекулы",
                        "target_lang_word": "replikacja",
