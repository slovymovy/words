                            {
                                "example_id": "1a81b286-8c99-4d78-9d8b-d828ed18f4e2",
                                "sense_id": "c1fbb9fe-0c24-3bab-ad4d-5e70b5b6c299",
                                "text": "I'm into the film script with Barbet, 30 or so pages; but I'm surprised—he wants a plot and an evolvement of character. shit, my characters seldom evolve, they are too fucked-up."
                            },
                            {
                                "example_id": "3c74c31f-79e9-4bba-aece-5accf7fa6d5c",
                                "sense_id": "c1fbb9fe-0c24-3bab-ad4d-5e70b5b6c299",
                                "text": "Here is an artwork revealing the method of its evolvement, allowing the viewer presence at the moment when the image is caught on the video screen and also when it is transferred onto the surface."
                            },
                            {
                                "example_id": "3baf6381-b704-4a6e-beec-a072714fe6c4",
                                "sense_id": "c1fbb9fe-0c24-3bab-ad4d-5e70b5b6c299",
                                "text": "The blessings come in the knowing that the lessons were not in vain, that the hard times and the good times were all leading to the evolvement of the spirit into a master of the highest order […]"
                            }
                        ]
                    }
