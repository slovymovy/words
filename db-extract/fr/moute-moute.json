                            {
                                "example_id": "a3d98e1d-0637-4b52-be14-a05e6563df32",
                                "sense_id": "37e6dfa8-c3c3-3447-96df-ff527dc6a6cc",
                                "text": "Dans son coin, Paul Hans fredonnait une chanson en s’épongeant le cou, chassant à grands gestes les nuées de moute-moute qui s’acharnaient sur la peau ruisselante de son visage."
                            },
                            {
                                "example_id": "0bda870e-1492-49f2-87b5-0725dc1ac9f0",
                                "sense_id": "37e6dfa8-c3c3-3447-96df-ff527dc6a6cc",
                                "text": "Le fleuve Sanaga, traversant les régions de l’Est, du Centre et du Littoral notamment, est l'un des principaux foyers des simulies, communément appelées « moute-moute », transmettant la maladie."
                            }
