                ],
                "senses": [
                    {
                        "sense_id": "93710ea3-342a-3639-932c-3b46fb1d51f3",
                        "entry_id": "a7ffe909-9e86-32c8-959a-75a7c7dfb365",
                        "glosses": [
                            "To mix, to blend."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "23ebfc4e-6db6-4a99-a0bd-43f8a5678f7a",
                                "sense_id": "93710ea3-342a-3639-932c-3b46fb1d51f3",
                                "text": "[…] Mr. Armstrong, founder of Princeton Economics International, admitted to deceiving corporate investors and improperly commingling client funds in a case that prosecutors said resulted in commodities losses of more than $700 million."
                            },
                            {
                                "example_id": "f0ac2031-c98a-4c53-b945-eabf874e6a59",
                                "sense_id": "93710ea3-342a-3639-932c-3b46fb1d51f3",
                                "text": "This vibrant stir-fry from Christian Reynoso is Chifa cooking — the cuisine that commingles Chinese and Peruvian elements — and it’s utterly delicious."
                            },
                            {
                                "example_id": "a25c39d0-c071-4083-b388-5daf56ce8da1",
                                "sense_id": "93710ea3-342a-3639-932c-3b46fb1d51f3",
                                "text": "To conclude otherwise requires accepting an attenuated fiction that commingling funds in an account, even if done decades earlier, means the account today still contains funds attributable to the sale of expropriated property."
                            }
                        ]
                    },
                    {
                        "sense_id": "c78e0872-a41b-37cd-be97-06a6e3183525",
                        "entry_id": "a7ffe909-9e86-32c8-959a-75a7c7dfb365",
                        "glosses": [
                            "To become mixed or blended."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "7d367023-752a-49bb-ae57-54d17195912f",
                                "sense_id": "c78e0872-a41b-37cd-be97-06a6e3183525",
                                "text": "In the midst of a general strike and a power blackout Eric M. Gairy talked freely about what he saw as the commingled destiny of himself and the tiny emerging independent nation of Grenada."
                            },
                            {
                                "example_id": "ee183674-b322-452a-bdde-7090a46d6b86",
                                "sense_id": "c78e0872-a41b-37cd-be97-06a6e3183525",
                                "text": "It was once considered taboo to even suggest that new motherhood was not all sunshine onesies and rainbow mobiles, and “Baby Ruby” arrives on a welcome wave of contemporary movies exploring how the joys of child rearing can commingle with misery."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "093f95f5-3609-4c93-b4c4-e29b9110bb13",
                        "source_entry_id": "a7ffe909-9e86-32c8-959a-75a7c7dfb365",
                        "source_sense_description": "mix, blend",
                        "target_lang_word": "mischen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mischen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1cf75a8b-4f14-30ab-afde-bc73792955d6",
                                        "entry_id": "c8acfc40-eb22-3f96-98f5-68589c04e650",
                                        "glosses": [
                                            "verschiedene Substanzen (beispielsweise Flüssigkeiten, Chemikalien, Pulver) zusammenschütten (meist in ein Behältnis), durcheinanderrühren/mixen, sodass ein einheitliches Gemisch entsteht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64e6756d-3088-4a2d-9607-9053e4ead4d5",
                                                "sense_id": "1cf75a8b-4f14-30ab-afde-bc73792955d6",
                                                "text": "Für Holunderblütensaft mische ich ein Teil Sirup mit fünf Teilen Wasser."
                                            },
                                            {
                                                "example_id": "3a96a737-a11d-4b35-a54d-173b7fe9663d",
                                                "sense_id": "1cf75a8b-4f14-30ab-afde-bc73792955d6",
                                                "text": "[Chemie:] „Wasser und Alkohol, zwei Flüssigkeiten, die sich augenscheinlich gut ineinander lösen, mischen sich bei genauer Betrachtung gar nicht so gut.“"
                                            },
                                            {
                                                "example_id": "3bd87dcb-104e-481a-8be9-4b5336a0814b",
                                                "sense_id": "1cf75a8b-4f14-30ab-afde-bc73792955d6",
                                                "text": "„Öl und Wasser lassen sich mit Hilfe von Tensiden (Emulgatoren) mischen.“"
                                            },
                                            {
                                                "example_id": "0f0d1f77-c8df-47fe-9390-56680d015f78",
                                                "sense_id": "1cf75a8b-4f14-30ab-afde-bc73792955d6",
                                                "text": "„Die Forscher mischten dazu Alkohol mit Wasser im Verhältnis 7:3.“"
                                            },
                                            {
                                                "example_id": "0773fdc9-3345-4812-82f9-38e66c10cd26",
                                                "sense_id": "1cf75a8b-4f14-30ab-afde-bc73792955d6",
                                                "text": "[Coronaimpfstoff:] „Die US-amerikanischen Centers for Disease Control and Prevention warnen davor, Impfstoffe zu mischen, es sei denn, es liegen »Ausnahmesituationen« vor.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e876f4c3-b9f8-3d62-a913-f8eb1cabcbfa",
                                        "entry_id": "c8acfc40-eb22-3f96-98f5-68589c04e650",
                                        "glosses": [
                                            "etwas bestimmtes (beispielsweise Beton, einen Cocktail, Gift) durch [1] herstellen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0492e75d-85e2-470b-abac-5b71645e74c0",
                                                "sense_id": "e876f4c3-b9f8-3d62-a913-f8eb1cabcbfa",
                                                "text": "Im Baumarkt kann man sich den gewünschten Farbton für seinen Lack mischen lassen."
                                            },
                                            {
                                                "example_id": "d51faf3e-227f-418a-8bb3-dcc51387ba16",
                                                "sense_id": "e876f4c3-b9f8-3d62-a913-f8eb1cabcbfa",
                                                "text": "„Dort stand nun eine Frau in schicker Anzugweste und mischte Cocktails in bunten Farben.“"
                                            },
                                            {
                                                "example_id": "f70d2d08-ea7d-4912-991b-967983b7299e",
                                                "sense_id": "e876f4c3-b9f8-3d62-a913-f8eb1cabcbfa",
                                                "text": "„Offensichtlich hat Ulrich eine großzügige Menge Wodka in den Cocktail gemischt.“"
                                            },
                                            {
                                                "example_id": "fef96187-6229-41ec-a025-6115daa1fde8",
                                                "sense_id": "e876f4c3-b9f8-3d62-a913-f8eb1cabcbfa",
                                                "text": "Man mischt Beton aus Zement, Zuschlag (einem sehr groben Sand/Kies) und Wasser im Verhältnis 15 : 35 : 10."
                                            },
                                            {
                                                "example_id": "2ce726ce-e1a6-4eb4-a190-314a50beecf1",
                                                "sense_id": "e876f4c3-b9f8-3d62-a913-f8eb1cabcbfa",
                                                "text": "„Man braucht keinen Mischer, eine Schaufel genügt, um aus Mutterboden, Sand und Kompost günstige Blumenerde zu mischen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "ffad83e2-e4a0-3f09-8b11-f6592cda2c61",
                                        "entry_id": "c8acfc40-eb22-3f96-98f5-68589c04e650",
                                        "glosses": [
                                            "vor dem Spiel die Reihenfolge von Spielkarten in Unordnung bringen"
                                        ],
                                        "tags": [
                                            "Kartenspiele"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d7b356cb-1c56-4436-8241-f4dcbaa7df4a",
                                                "sense_id": "ffad83e2-e4a0-3f09-8b11-f6592cda2c61",
                                                "text": "Ich mische die Karten und du holst schon mal zwei Bier."
                                            },
                                            {
                                                "example_id": "3c423c98-933a-4b51-98d1-7c7d8dd47c5f",
                                                "sense_id": "ffad83e2-e4a0-3f09-8b11-f6592cda2c61",
                                                "text": "„Heben Sie zwischen den Karten 5 und 6 ab und mischen Sie die beiden Hälften sorgfältig ineinander.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "f1733b39-2c28-3eb1-8fa9-eff0b5f11fe2",
                                        "entry_id": "c8acfc40-eb22-3f96-98f5-68589c04e650",
                                        "glosses": [
                                            "sich mit etwas beschäftigen/befassen, was einen nichts angeht/nicht betrifft"
                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "888e2620-33b9-4a1b-a0f7-6b72de917adf",
                                                "sense_id": "f1733b39-2c28-3eb1-8fa9-eff0b5f11fe2",
                                                "text": "„Mit wem ich schlafe, ist meine Sache. Misch dich nicht in Sachen, die dich nichts angehen!“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "c8938517-d8e4-3f99-a0e0-02920c00a6ba",
                                        "entry_id": "c8acfc40-eb22-3f96-98f5-68589c04e650",
                                        "glosses": [
                                            "sich als Einzelner oder kleine Gruppe zu einer großen Menschenmenge gesellen (oft um dort unerkannt zu bleiben)"
                                        ],
                                        "tags": [
                                            "von Personen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0c9df874-8d18-47ee-bfc9-2c03d16a2b8b",
                                                "sense_id": "c8938517-d8e4-3f99-a0e0-02920c00a6ba",
                                                "text": "„Nur wenige Touristen oder Einwohner von El Paso mischen sich unter die Besucher.“"
                                            },
                                            {
                                                "example_id": "48e8d6ce-0786-46ea-a44d-acceafc5d6f6",
                                                "sense_id": "c8938517-d8e4-3f99-a0e0-02920c00a6ba",
                                                "text": "„Eigentlich ist Karneval ein christlicher Brauch: Vor der Fastenzeit wird noch mal ausgelassen gefeiert. Doch auch Jecken anderer Religionen mischen sich inzwischen unters Narrenvolk.“"
                                            },
                                            {
                                                "example_id": "2219919a-7ec6-4f23-9a8e-87cc9af69ff8",
                                                "sense_id": "c8938517-d8e4-3f99-a0e0-02920c00a6ba",
                                                "text": "„Buntes Treiben herrscht jeden Tag im Streichelzoo: Verschiedene Arten von Ziegen und Schafen laufen hier frei herum und mischen sich unter die Besucher.“"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "8861b87c-4f70-3f6c-a074-fcfc99cc9038",
                                        "entry_id": "c8acfc40-eb22-3f96-98f5-68589c04e650",
                                        "glosses": [
                                            "Töne/Tonspuren/Geräusche so mixen, dass ein Stück entsteht"
                                        ],
                                        "tags": [
                                            "Musik/Hörspiele/etc. (im Tonstudio) mischen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "263b19b2-47a0-4911-b1d2-5b84c7c3e027",
                                                "sense_id": "8861b87c-4f70-3f6c-a074-fcfc99cc9038",
                                                "text": "[David Bowie:] „Auf Blackstar spielt er verschiedene Instrumente. Aber er spielte sie zu Hause ein und konnte sie dann im Studio mischen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    },
                                    {
                                        "sense_id": "efd206fc-02e6-3b55-a6ff-d95caaee8d03",
                                        "entry_id": "c8acfc40-eb22-3f96-98f5-68589c04e650",
                                        "glosses": [
                                            "zwei (oft gegenteilige oder unterschiedliche) Dinge vermengen/kombinieren"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9aeaac17-6e7f-4557-a55b-64c56ecd3a8b",
                                                "sense_id": "efd206fc-02e6-3b55-a6ff-d95caaee8d03",
                                                "text": "„Ihre Popsongs mischen New Wave, Gothic und klassische Lyrik.“"
                                            },
                                            {
                                                "example_id": "e271850b-a604-4b18-af1d-c8ed3963e3aa",
                                                "sense_id": "efd206fc-02e6-3b55-a6ff-d95caaee8d03",
                                                "text": "„Sie ist eine geborene Grönländerin, was bedeutet, dass sich einige friesische und dänische Einflüsse mit den asiatischen Ursprüngen mischen.“"
                                            },
                                            {
                                                "example_id": "bb0bbde8-4ef1-47ea-baa7-60d2ca21aab3",
                                                "sense_id": "efd206fc-02e6-3b55-a6ff-d95caaee8d03",
                                                "text": "[Ukrainische Flüchtlinge:] „Bei ihrer Ankunft mischen sich Freude und Erleichterung mit riesiger Wut auf Putin und die russische Invasion.“"
                                            },
                                            {
                                                "example_id": "8955d7d1-97fe-4c77-bdde-f8d68e55a29b",
                                                "sense_id": "efd206fc-02e6-3b55-a6ff-d95caaee8d03",
                                                "text": "[Ebola:] „Immer weniger Menschen stecken sich mit dem Virus an, doch in die Hoffnung mischen sich immer wieder Rückschläge.“"
                                            },
                                            {
                                                "example_id": "d6a9c925-d067-4d0c-81b5-00347c73e817",
                                                "sense_id": "efd206fc-02e6-3b55-a6ff-d95caaee8d03",
                                                "text": "„Ein Großraumbüro in einem Berliner Hinterhof. Englische und spanische Wortfetzen mischen sich mit dem Baulärm von nebenan.“"
                                            },
                                            {
                                                "example_id": "f76ec980-1e71-45e7-ab27-814eb9b75881",
                                                "sense_id": "efd206fc-02e6-3b55-a6ff-d95caaee8d03",
                                                "text": "„Festlich mischen sich helle und dunkle Glockentöne zu einem harmonischen Gesamtklang, gerade passend zum Osterfest.“"
                                            },
                                            {
                                                "example_id": "e59ceb9a-d44e-42db-a8fe-863711292bad",
                                                "sense_id": "efd206fc-02e6-3b55-a6ff-d95caaee8d03",
                                                "text": "„Bei der Pastellmalerei mischen sich die Möglichkeiten des Zeichnens mit denen der Malerei.“"
                                            },
                                            {
                                                "example_id": "a1adc6fe-5f52-48a1-b8cc-f13510ac8b2a",
                                                "sense_id": "efd206fc-02e6-3b55-a6ff-d95caaee8d03",
                                                "text": "„Die Hühner der Insel Kauai lassen gut erkennen, wie Tiere verwildern, wenn sie Haus und Hof entkommen sind - und wie sich Anlagen von Wild- und Haustieren mischen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"7\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
