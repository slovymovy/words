                    {
                        "sense_id": "5b22f09c-d75e-3d07-9818-6574cdcee95b",
                        "entry_id": "fcda2c45-8820-38d6-9a2c-65a3fb68fedb",
                        "glosses": [
                            "belasting die men heft over de verkoop van bier"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a4f745d-3728-477b-a30f-79a32c9d0fa8",
                                "sense_id": "5b22f09c-d75e-3d07-9818-6574cdcee95b",
                                "text": "Samenwerkende artsen betaald van hogere bieraccijns"
                            },
                            {
                                "example_id": "00acfd38-8dc6-4fef-ab23-4ddb1d95c989",
                                "sense_id": "5b22f09c-d75e-3d07-9818-6574cdcee95b",
                                "text": "In 2013 werd de bieraccijns ook al verhoogd en dat leidde volgens de brouwers tot een lagere bierverkoop. De hogere inkomsten aan accijns zouden teniet zijn gedaan door de lagere verkoop."
                            },
                            {
                                "example_id": "8ee5d023-06ae-468b-b2a4-1b017f64ab6b",
                                "sense_id": "5b22f09c-d75e-3d07-9818-6574cdcee95b",
                                "text": "De wereldwijde verkoop daalde zo'n 3 procent, de verkoop in West-Europa ging bijna 9 procent omlaag. Heineken zegt dat consumenten in belangrijke Europese markten minder uitgeven aan bier vanwege de bezuinigingen van overheden. In Frankrijk daalde de bierverkoop ook door de verhoging van de bieraccijns op 1 januari."
                            }
                        ]
                    }
