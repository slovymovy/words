                    {
                        "translation_id": "3c36f2d0-4757-407c-b089-3cac9bbf140d",
                        "source_entry_id": "0cd8a5e5-0dda-369e-96de-94bb44c43d44",
                        "source_sense_description": "surface of a road",
                        "target_lang_word": "ще́бень",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ще́бень",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "6b27b206-630d-34ac-948e-f95e0854559b",
                                        "entry_id": "7d7559ca-3db4-3cad-a13a-986a64443f41",
                                        "glosses": [
                                            "раздробленный, разбитый на мелкие куски камень, кирпич, употребляемый как материал для дорожных и строительных работ"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c1852ec-959e-42f7-b9e7-f1f2cef66a94",
                                                "sense_id": "6b27b206-630d-34ac-948e-f95e0854559b",
                                                "text": "Проработали целый день, щебню набили целую кучу, а между тем камня почти не убывает."
                                            },
                                            {
                                                "example_id": "af09f458-d427-4aa3-a31d-26112adaa370",
                                                "sense_id": "6b27b206-630d-34ac-948e-f95e0854559b",
                                                "text": "Бывало, вырыть могилы или прикрыть трупы щебнем не успевали ― гремела команда «По вагона-а-ам!»."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2e784f36-0a64-302b-9698-e162e9c6938c",
                                        "entry_id": "7d7559ca-3db4-3cad-a13a-986a64443f41",
                                        "glosses": [
                                            "разг. дорожное покрытие из такого материала"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2b8d56ad-417d-34b5-b931-feb73791de9c",
                                        "entry_id": "7d7559ca-3db4-3cad-a13a-986a64443f41",
                                        "glosses": [
                                            "геол., горн. осадочная горная порода, состоящая из небольших неокатанных остроугольных обломков"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4a4c51d-10c6-4ee8-ba01-5d19ef5ab6f4",
                                                "sense_id": "2b8d56ad-417d-34b5-b931-feb73791de9c",
                                                "text": "В самом деле, чтобы обнаружить бараньи лбы и шрамы, необходимо, чтобы сила воды снесла толщи ледникового щебня и валунов, покрывающие горы; иначе эти рыхлые толщи покроются ягелями и мхами и при благоприятных климатических условиях через некоторый промежуток времени следы ледников станут редкими и неясными…"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ще́бень",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "a7aba5c9-c9f4-3f90-9c3f-21a8089e6446",
                                        "entry_id": "a131676e-c443-325b-96d2-e07f64e34c17",
                                        "glosses": [
                                            "перен., собир., крим. жарг. редкие, плохие зубы; любые зубы"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "215fe22e-e140-48af-ab9d-60c1961cad73",
                                                "sense_id": "a7aba5c9-c9f4-3f90-9c3f-21a8089e6446",
                                                "text": "Какие уж тут зубы – щебень…"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ще́бень",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "c584ace8-5a53-31de-965b-47e83dbd16bc",
                                        "entry_id": "31d27669-cfc4-31c1-94f6-181c273a9a0b",
                                        "glosses": [
                                            "перен., собир., жарг. мелочь; монетки"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f13b6f7b-847b-46f0-9643-e87b5ad80dff",
                                                "sense_id": "c584ace8-5a53-31de-965b-47e83dbd16bc",
                                                "text": "У меня одна щебень в кошельке."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
