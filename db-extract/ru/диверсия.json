                    },
                    {
                        "translation_id": "09f2d24a-768b-4ebb-8ff0-d1331dd0fd86",
                        "source_entry_id": "bb335988-81c3-37c6-b838-9801e4899ec9",
                        "target_lang_word": "diversion",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "diversion",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "34efe52f-56f6-3ba3-995c-81f00fe08924",
                                        "entry_id": "a2057e60-df0f-3f79-9189-64aa7d19776d",
                                        "glosses": [
                                            "Action de détourner quelqu’un de ce qui le préoccupe, le chagrine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1dde5d3-6332-4fdb-8de0-3f17f55e895e",
                                                "sense_id": "34efe52f-56f6-3ba3-995c-81f00fe08924",
                                                "text": "Un laquais fit une heureuse diversion, en venant annoncer que le souper était servi."
                                            },
                                            {
                                                "example_id": "681c9fbc-0320-4c8e-bbde-210bf9f5a9ed",
                                                "sense_id": "34efe52f-56f6-3ba3-995c-81f00fe08924",
                                                "text": "Les fêtes en l’honneur du shah firent, au mois de juillet 1873, quelque diversion aux préoccupations universelles."
                                            },
                                            {
                                                "example_id": "46010993-9bfb-4d2b-9dc9-ee8d255a2dab",
                                                "sense_id": "34efe52f-56f6-3ba3-995c-81f00fe08924",
                                                "text": "Peut-être ma mère croyait-elle que c’était en ville que François se dévoyait auprès des filles publiques, rien que pour faire diversion à la monotonie d’un mariage banal."
                                            },
                                            {
                                                "example_id": "64c4c854-0060-45f4-b61f-6042769b7890",
                                                "sense_id": "34efe52f-56f6-3ba3-995c-81f00fe08924",
                                                "text": "Le chimpanzé est omnivore, et il est occasionnellement carnivore. Il pratique occasionnellement la chasse et l’on peut voir se manifester à la fois coopération et stratégie d’encerclement et de diversion dans la chasse aux petits potamochères."
                                            },
                                            {
                                                "example_id": "bf03ce21-f2fb-41bc-99ea-86e26d71537c",
                                                "sense_id": "34efe52f-56f6-3ba3-995c-81f00fe08924",
                                                "text": "Les préparatifs du départ apportent souvent une diversion heureuse à la tristesse de ceux qui vont se quitter, — et ce cas était le nôtre…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6ce11802-e3a0-37f6-ac31-d21d7f4b892d",
                                        "entry_id": "a2057e60-df0f-3f79-9189-64aa7d19776d",
                                        "glosses": [
                                            "Opération par laquelle on détourne l’ennemi du point qu’il occupe pour le forcer à se porter ailleurs et à s’y défendre."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2903118f-299b-42f2-b6ab-e112dc32f6c3",
                                                "sense_id": "6ce11802-e3a0-37f6-ac31-d21d7f4b892d",
                                                "text": "Opérer une diversion."
                                            },
                                            {
                                                "example_id": "d03a45d1-b1be-4020-bac2-ed6e2d3b72e8",
                                                "sense_id": "6ce11802-e3a0-37f6-ac31-d21d7f4b892d",
                                                "text": "Une heureuse diversion."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
