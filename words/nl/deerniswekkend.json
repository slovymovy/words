            "senses": [
                {
                    "sense_id": "5712c2cf-6beb-3c3f-982a-285636ef3e67",
                    "sense_definition": "Heel zielig en veel medelijden of medeleven opwekkend.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "medelijden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De zwerfhond zag er na dagen in de kou <w>deerniswekkend</w> uit.",
                            "target_lang_translations": {
                                "en": "The stray dog looked <w>pitiful</w> after days in the cold."
                            }
                        },
                        {
                            "text": "Het was een <w>deerniswekkende</w> vertoning toen de man huilend om hulp smeekte.",
                            "target_lang_translations": {
                                "en": "It was a <w>pitiable</w> spectacle when the man begged for help while crying."
                            }
                        }
                    ],
                    "synonyms": [
                        "meelijwekkend",
                        "beklagenswaardig",
                        "zielig",
                        "erbarmelijk",
                        "ellendig"
                    ],
                    "common_phrases": [
                        "deerniswekkende vertoning",
                        "deerniswekkend figuur"
                    ],
                    "target_lang_definitions": {
                        "en": "Extremely pitiful, evoking a great deal of compassion, sympathy, or sorrow."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "pitiful",
                                "target_lang_sense_clarification": "evoking pity or compassion"
                            },
                            {
                                "target_lang_word": "pitiable",
                                "target_lang_sense_clarification": "deserving pity"
                            },
                            {
                                "target_lang_word": "pathetic",
                                "target_lang_sense_clarification": "miserable and evoking sadness"
                            },
                            {
                                "target_lang_word": "heartrending",
                                "target_lang_sense_clarification": "causing great sadness or distress"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "064be3c2-2d17-3d44-a838-9a02dd4f271f",
                    "sense_definition": "Zeer matig, armzalig of onbeduidend van kwaliteit of hoeveelheid.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "armzalig",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De opbrengst van de inzamelingsactie was dit jaar een <w>deerniswekkend</w> resultaat.",
                            "target_lang_translations": {
                                "en": "The proceeds from the fundraiser were a <w>pitiful</w> result this year."
                            }
                        },
                        {
                            "text": "Zijn poging om de situatie te verklaren was een <w>deerniswekkende</w> poging.",
                            "target_lang_translations": {
                                "en": "His attempt to explain the situation was a <w>pathetic</w> attempt."
                            }
                        }
                    ],
                    "synonyms": [
                        "armzalig",
                        "erbarmelijk",
                        "treurig"
                    ],
                    "common_phrases": [
                        "deerniswekkend resultaat",
                        "deerniswekkende poging"
                    ],
                    "target_lang_definitions": {
                        "en": "Very poor, miserable, or insignificant in quality or quantity."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "pitiful",
