                        "glosses": [
                            "Remède qui permet la cautérisation."
                        ],
                        "tags": [
                            "Pharmacie"
                        ],
                        "examples": [
                            {
                                "example_id": "f2fe70b6-46bf-4474-b1cb-f089d0c8af0d",
                                "sense_id": "b801586f-0b99-318f-b20d-23b58d8948e0",
                                "text": "Des nettoyages superficiels seraient insuffisants, les cautérisants sont nécessaires. Encore faut-il ne pas dépasser le but, et ne pas créer une inflammation trop vive."
                            }
                        ]
                    }
