                        "entry_id": "be03e6e0-987c-3cc0-a649-a0620b03eefe",
                        "glosses": [
                            "Verbraucher, welcher qualitativ hochwertige Produkte erwartet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b079ce2-c788-427d-a04d-bac21fecf96f",
                                "sense_id": "52171989-b079-3f47-aabd-78e57ee7760e",
                                "text": "Der Prosument verzichtet auf qualitativ minderwertige Produkte."
                            },
                            {
                                "example_id": "00ab290a-4793-457d-bbaa-61578f8aa24a",
                                "sense_id": "52171989-b079-3f47-aabd-78e57ee7760e",
                                "text": "„Prosumenten wollen mitreden und agieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "559f62fe-4e20-39fc-bffa-edc4f053cce9",
                        "entry_id": "be03e6e0-987c-3cc0-a649-a0620b03eefe",
                        "glosses": [
                            "Verbraucher, welcher gleichzeitig (Teil-)Hersteller des/eines Produktes ist; mitmachender Nutzer; beitragender Konsument"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d49780b5-c4de-4049-b39e-3e093c6338c4",
                                "sense_id": "559f62fe-4e20-39fc-bffa-edc4f053cce9",
                                "text": "„Prosumenten wollen mitreden und agieren.“"
                            },
                            {
                                "example_id": "8fefe82f-6c9f-4a3e-9570-6e368b4b4f67",
                                "sense_id": "559f62fe-4e20-39fc-bffa-edc4f053cce9",
                                "text": "Der Prosument konsumiert nicht nur, er schafft auch eigene Produkte. Typisches Beispiel ist jemand, der auf Plattformen Videos schaut, kommeniert und auch eigene Kreationen dort einstellt."
                            },
                            {
                                "example_id": "fb7d170b-0008-4a12-bcc8-4d51fcc292a3",
                                "sense_id": "559f62fe-4e20-39fc-bffa-edc4f053cce9",
                                "text": "„Als Akteur im Bereich der Wirtschaft ist der Prosument erstens weder nur Produzent noch nur Konsument, sondern beides; zweitens […]“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
