                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lamb",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e46939ad-5473-3228-a9f3-8170ac0b014f",
                                        "entry_id": "b75494f6-3fcb-32d9-94a1-063f4c24bd5e",
                                        "glosses": [
                                            "A young sheep."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f17eb56-ea3a-4cfe-9460-1c61efca967c",
                                                "sense_id": "e46939ad-5473-3228-a9f3-8170ac0b014f",
                                                "text": "Mary had a little lamb, its fleece as white as snow."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e2e76ce1-949e-3719-bf46-764a25fc77ff",
                                        "entry_id": "b75494f6-3fcb-32d9-94a1-063f4c24bd5e",
                                        "glosses": [
                                            "A young goat; a kid."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "90d97bde-8c42-44ff-abe9-d05cebe4dbf8",
                                                "sense_id": "e2e76ce1-949e-3719-bf46-764a25fc77ff",
                                                "text": "The Holy Bible, […] (King James Version), London: […] Robert Barker, […], 1611, →OCLC, Exodus 12:5: “Your lamb shall be without blemish, a male of the first year: ye shall take it out from the sheep, or from the goats:”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "43700d80-5f6e-39b6-a03e-3e20bdd4c8be",
                                        "entry_id": "b75494f6-3fcb-32d9-94a1-063f4c24bd5e",
                                        "glosses": [
                                            "The flesh of a lamb or sheep used as food."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a143bcc2-f37b-3995-9cf5-3d25d0ab65a6",
                                        "entry_id": "b75494f6-3fcb-32d9-94a1-063f4c24bd5e",
                                        "glosses": [
                                            "A person who is meek, docile and easily led."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c8df3671-1385-36af-97cd-59e24d4fb1db",
                                        "entry_id": "b75494f6-3fcb-32d9-94a1-063f4c24bd5e",
                                        "glosses": [
                                            "Lambskin."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "280f380e-f299-43de-bb31-55d82437b64c",
                                                "sense_id": "c8df3671-1385-36af-97cd-59e24d4fb1db",
                                                "text": "They were as alike as prisoners, dressed in black silk waists and fitted skirts, with shawls of crimped black lamb across their shoulders."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "779d88d6-8b23-3c7a-89c6-a5d148b22140",
                                        "entry_id": "b75494f6-3fcb-32d9-94a1-063f4c24bd5e",
                                        "glosses": [
                                            "A simple, unsophisticated person."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c6378741-22aa-3b18-a05a-a792893fcf39",
                                        "entry_id": "b75494f6-3fcb-32d9-94a1-063f4c24bd5e",
                                        "glosses": [
                                            "One who ignorantly speculates on the stock exchange and is victimized."
                                        ],
                                        "tags": [
                                            "countable",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "19f7fe82-9f0c-36ac-a201-940faa347f10",
                                        "entry_id": "b75494f6-3fcb-32d9-94a1-063f4c24bd5e",
                                        "glosses": [
                                            "A fan of American singer, songwriter, actress, and record producer Mariah Carey (born 1969)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e4eeab8-427a-4de7-81dc-f1539ed5e515",
                                                "sense_id": "19f7fe82-9f0c-36ac-a201-940faa347f10",
                                                "text": "Part of me revels in the campiness of Mariah’s butterfly metaphors and puppies-and-kittens existence. […] But I also genuinely love her music, including this album. I’m one of her lambs."
                                            },
                                            {
                                                "example_id": "0840924d-08da-4204-aedc-606ffbbf1d59",
                                                "sense_id": "19f7fe82-9f0c-36ac-a201-940faa347f10",
                                                "text": "Her latest album, “Memoirs of an Imperfect Angel,” is her best work yet, a warmer and more subtle album that makes her more relatable to those of us who aren’t Mariah die-hards—or “lambs,” as she refers to them."
                                            },
                                            {
                                                "example_id": "b817e6ae-a779-42c4-b1b8-218331d61353",
                                                "sense_id": "19f7fe82-9f0c-36ac-a201-940faa347f10",
                                                "text": "This year, Ms. Carey debuted a new Las Vegas revue, and, to celebrate, a group of 36 “lambs,” mostly in their 30s and 40s, boarded a party bus and cruised the Vegas strip for about three hours."
                                            },
                                            {
                                                "example_id": "7df40eeb-1c84-471f-af26-0f738fb3f6a8",
                                                "sense_id": "19f7fe82-9f0c-36ac-a201-940faa347f10",
                                                "text": "But when I saw Mariah in Detroit last year during the Caution World Tour, I was a proud lamb in my tour T-shirt, my very adult body suddenly transformed into my 14-year-old self when she emerged onstage."
                                            },
                                            {
                                                "example_id": "c1e0fcd2-daac-47fa-8809-02e1765ff42c",
                                                "sense_id": "19f7fe82-9f0c-36ac-a201-940faa347f10",
                                                "text": "Pride Month begins June 1, and Mariah Carey is giving her lambs plenty of new clothes to celebrate."
                                            }
                                        ]
                                    }
                                ]
                            },
