                        ],
                        "examples": [
                            {
                                "example_id": "cfc4a171-89c9-4a15-931e-edddbaf86192",
                                "sense_id": "64385a26-2aff-327a-8af1-7e97f0a5fe8e",
                                "text": "Un monsieur, qui avait une barbiche blanche et un chapeau sur les yeux, regardait aussi cette femme. Il était arrêté. Le poids de son corps portait tantôt sur une jambe, tantôt sur l’autre, comme celui d’un échassier."
                            }
                        ]
                    },
