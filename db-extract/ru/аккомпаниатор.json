                                    {
                                        "sense_id": "e1a2f61f-2474-30b4-9a0a-518f6d682fc4",
                                        "entry_id": "dd0aa40d-ddde-35e1-95f0-b895c19e8f0b",
                                        "glosses": [
                                            "iemand die een ander begeleidt (vergezelt) (ook )"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1bb9ceb2-bffd-4cf7-a742-7bcad5165267",
                                                "sense_id": "e1a2f61f-2474-30b4-9a0a-518f6d682fc4",
                                                "text": "Op het evenement komen onder meer Antoon, Emma Heesters, Dave Roelvink en Jonna Fraser optreden. Ook is er een Bengelfestijn voor kinderen met tal van activiteiten. Laatstgenoemde is tot 12.30 uur nog gratis te bezoeken voor kinderen en maximaal twee begeleiders. Kaartjes voor het evenement zelf kosten 15 euro."
                                            },
                                            {
                                                "example_id": "2b5abd9e-1d5e-4e9d-9908-736baced24bd",
                                                "sense_id": "e1a2f61f-2474-30b4-9a0a-518f6d682fc4",
                                                "text": "Toen Henk terug was ging Rien met de begeleider mee en kreeg Henk vlug wat koffie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "945bfbd8-6154-3120-b77c-b65f791ad1da",
                                        "entry_id": "dd0aa40d-ddde-35e1-95f0-b895c19e8f0b",
                                        "glosses": [
                                            "iemand die een ander met raad en daad bijstaat, een coach"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3cc6c9c2-72cf-3a20-9eee-2dbcbe53237f",
                                        "entry_id": "dd0aa40d-ddde-35e1-95f0-b895c19e8f0b",
                                        "glosses": [
                                            "hemellichaam dat een grotere ster begeleidt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7a02d8b-3a02-42e6-a59e-4b369927b6a0",
                                                "sense_id": "3cc6c9c2-72cf-3a20-9eee-2dbcbe53237f",
                                                "text": "Toen de zwaarste van de twee, die het snelst evolueerde, tegen het eind van zijn leven opzwol tot een rode reus (dat lot staat ook onze zon te wachten), kwam de begeleider in de ijle buitenlagen van deze ster terecht."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
