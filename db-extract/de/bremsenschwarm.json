                "senses": [
                    {
                        "sense_id": "eded1c33-1993-3c44-a559-fcbbcae30709",
                        "entry_id": "2dae5477-429e-3db8-baf0-aca5e8d43532",
                        "glosses": [
                            "größere Anzahl sich wild durcheinander fortbewegender Bremsen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "09be586f-a008-46c3-8ce8-0d8a11302d04",
                                "sense_id": "eded1c33-1993-3c44-a559-fcbbcae30709",
                                "text": "„Wird ein Pferd von einem Bremsenschwarm angefallen, wird es zunächst mit den Hufen versuchen, die Insekten abzuwehren.“"
                            },
                            {
                                "example_id": "873e2a89-1873-4124-84b6-59f1c00a080d",
                                "sense_id": "eded1c33-1993-3c44-a559-fcbbcae30709",
                                "text": "„War zu Beginn von einem Heißluftballon oder gar einem Erdbeben die Rede, ist nun die Vermutung aufgestellt worden, dass ein Bremsenschwarm die Ochsen in Panik versetzte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
