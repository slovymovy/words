{
    "word_family": [
        "rappel",
        "appel",
        "appeler"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8d434d58-f98c-3ed3-99b5-98d467446ce8",
                    "sense_definition": "Téléphoner de nouveau à quelqu'un ou répondre à un appel téléphonique reçu.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je suis en réunion pour le moment, je te <w>rappelle</w> plus tard."
                        },
                        {
                            "text": "Ton père a téléphoné ce matin et il m'a demandé si tu pouvais le <w>rappeler</w>."
                        }
                    ],
                    "synonyms": [
                        "recontacter"
                    ],
                    "common_phrases": [
                        "rappeler plus tard",
                        "rappeler sur-le-champ"
                    ]
                },
                {
                    "sense_id": "855f4504-7faa-3a9c-98dc-2e29c3a402c7",
                    "sense_definition": "Faire souvenir quelqu'un d'une information, d'un événement ou d'un devoir.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "memoire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Peux-tu me <w>rappeler</w> l'heure exacte de notre rendez-vous chez le dentiste ?"
                        },
                        {
                            "text": "Le professeur a <w>rappelé</w> aux étudiants la date limite pour rendre le devoir."
                        }
                    ],
                    "synonyms": [
                        "remémorer"
                    ],
                    "common_phrases": [
                        "rappeler à l'ordre",
                        "rappeler les règles",
                        "rappeler un souvenir"
                    ]
                },
                {
                    "sense_id": "5100062d-b0c8-3daa-9ed2-bccf312b8e46",
                    "sense_definition": "Avoir présent à l'esprit, garder dans la mémoire (employé à la forme pronominale se <w>rappeler</w>).",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "memoire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je me <w>rappelle</w> très bien notre premier voyage en Italie il y a dix ans."
                        },
                        {
                            "text": "Il ne se <w>rappelle</w> plus le nom de cette ancienne camarade d'école."
                        }
                    ],
                    "synonyms": [
                        "se souvenir"
                    ],
                    "antonyms": [
                        "oublier"
                    ],
                    "common_phrases": [
                        "se rappeler un souvenir"
                    ]
                },
                {
                    "sense_id": "5fcd0976-9c65-38cf-97c8-cf77054fcd82",
                    "sense_definition": "Faire penser à quelqu'un ou à quelque chose par ressemblance ou par analogie.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "memoire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce paysage méditerranéen me <w>rappelle</w> les étés de mon enfance en Grèce."
                        },
                        {
                            "text": "Sa voix douce et calme <w>rappelle</w> celle de sa mère."
                        }
                    ],
                    "synonyms": [
                        "évoquer"
                    ]
                },
                {
                    "sense_id": "49fbb409-be76-39dc-8770-dab6e1a17e64",
                    "sense_definition": "Faire revenir une personne qui s'en va ou ordonner le retour d'un représentant ou de troupes.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "retour",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En raison de la crise diplomatique, le gouvernement a <w>rappelé</w> son ambassadeur pour consultation."
                        },
                        {
                            "text": "Le ministre a décidé de <w>rappeler</w> immédiatement les troupes déployées à l'étranger."
                        }
                    ],
                    "common_phrases": [
                        "rappeler un ambassadeur"
                    ]
                },
                {
                    "sense_id": "237994ce-0de2-3961-8a6c-92686f0cfaad",
                    "sense_definition": "Demander le retour ou le retrait du marché d'un produit défectueux ou dangereux.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "retour",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le fabricant automobile a <w>rappelé</w> des milliers de véhicules à cause d'un frein défaillant."
                        },
                        {
                            "text": "L'entreprise alimentaire a <w>rappelé</w> un lot de fromage suite à une alerte sanitaire."
                        }
                    ],
                    "synonyms": [
                        "retirer"
                    ],
                    "common_phrases": [
                        "rappeler des produits",
                        "rappeler un lot"
                    ]
                }
            ]
        }
    ]
}