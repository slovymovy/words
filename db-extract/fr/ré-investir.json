                ],
                "senses": [
                    {
                        "sense_id": "6bc8f2b8-9ed5-324e-b4b4-4f011cd1cd4d",
                        "entry_id": "37610270-2b9f-3333-9a18-97fc768cdbbc",
                        "glosses": [
                            "Investir à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "56bd98fc-6156-48fb-832c-7a83a1444f87",
                                "sense_id": "6bc8f2b8-9ed5-324e-b4b4-4f011cd1cd4d",
                                "text": "Aussi Kazantzaki va-t-il devoir ré-investir le mythe d’une charge symbolique nouvelle, le re-sémantiser, ou le ré-aimanter."
                            },
                            {
                                "example_id": "7feddfd4-d9a7-4143-9904-fc1b3a706f18",
                                "sense_id": "6bc8f2b8-9ed5-324e-b4b4-4f011cd1cd4d",
                                "text": "Il faut également aider les parents et la famille à ré-investir leur rôle."
                            },
                            {
                                "example_id": "d79b50b8-e2d6-4844-aff6-c2a9fbe33904",
                                "sense_id": "6bc8f2b8-9ed5-324e-b4b4-4f011cd1cd4d",
                                "text": "De même, dans le travail de re-médiation, l’enseignant va effectuer à nouveau (« re- ») une médiation permettant au sujet de re-mobiliser ses compétences et de ré-investir le projet."
                            }
                        ]
                    }
