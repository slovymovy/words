                    {
                        "translation_id": "2eb6abe7-a8bd-499c-b3c6-be33f75d3eb7",
                        "source_entry_id": "ef95874b-19ae-30be-915d-acfc9e07eba0",
                        "source_sense_id": "79953fa3-6023-35e4-a8ee-5c479a27f3e3",
