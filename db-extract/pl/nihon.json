                    },
                    {
                        "translation_id": "48d53de3-9968-4c2d-8d25-680262808c4e",
                        "source_entry_id": "8f042cd9-949b-3157-bc90-33521d6460bc",
                        "source_sense_id": "fd1b67f5-fcb1-3ddb-9243-f7821a230830",
                        "target_lang_word": "Nihonium",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nihonium",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "85818081-fa59-3cfd-986d-4ae5a988d3b1",
                                        "entry_id": "ac295b30-ed97-3024-a31b-507fdb3725dc",
                                        "glosses": [
                                            "chemisches Element mit der Ordnungszahl 113"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f5817f8d-5f71-4e8b-b01f-772ba03cb2ae",
                                                "sense_id": "85818081-fa59-3cfd-986d-4ae5a988d3b1",
                                                "text": "„Das Gremium hat folgendes beschlossen: Die Namen der Elemente Nihonium (Nh), Moscovium (Mc) und Oganesson (Og) werden unverändert ins Deutsche übernommen.“"
                                            },
                                            {
                                                "example_id": "6e1b6a20-2b01-4136-83a9-624d8b0679f6",
                                                "sense_id": "85818081-fa59-3cfd-986d-4ae5a988d3b1",
                                                "text": "„„Ich freue mich sehr, dass die Bezeichnung ‚Nihonium‘, die unsere Gruppe vorgeschlagen hatte, offiziell bestätigt wurde“, sagte der Wissenschaftler.“"
                                            },
                                            {
                                                "example_id": "f454eb53-b5d4-4000-baf9-b76a6e91e231",
                                                "sense_id": "85818081-fa59-3cfd-986d-4ae5a988d3b1",
                                                "text": "„Eventuell primordial gebildetes Nihonium zerfällt binnen einiger Minuten zu leichteren Elementen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
