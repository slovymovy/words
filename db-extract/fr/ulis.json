                    {
                        "sense_id": "5673c27c-5025-3e2b-a67f-d2139f8f65f6",
                        "entry_id": "c5241d11-d359-3442-907c-e593b9c60676",
                        "glosses": [
                            "Unité localisée pour l’inclusion scolaire des élèves handicapés."
                        ],
                        "tags": [
                            "Handicap"
                        ],
                        "examples": [
                            {
                                "example_id": "296dd110-b07f-496d-a6c6-2dc63c329fe4",
                                "sense_id": "5673c27c-5025-3e2b-a67f-d2139f8f65f6",
                                "text": "En outre, l’école élémentaire du Val d’or bénéficie d’une classe ULIS, un dispositif porté par l’éducation nationale permettant d’accueillir des élèves en situation de handicap afin de les faire bénéficier d’un enseignement individualisé."
                            },
                            {
                                "example_id": "e60cd485-f401-4d09-a64a-e74e8fbb6a02",
                                "sense_id": "5673c27c-5025-3e2b-a67f-d2139f8f65f6",
                                "text": "Les ULIS sont des classes particulières pour la scolarisation d’élèves en situation de handicap."
                            },
                            {
                                "example_id": "97d2d11f-de1e-45f5-a324-4aef428c5de6",
                                "sense_id": "5673c27c-5025-3e2b-a67f-d2139f8f65f6",
                                "text": "L’ULIS est à présent un dispositif et non une classe."
                            }
                        ]
                    }
