                                        "entry_id": "e91dca6d-3eb9-3c13-8e22-985c71508c1b",
                                        "glosses": [
                                            "Lager für ein Bootsruder. Eine am oberen Rand der Bordwand eines Bootes befestigte bewegliche Gabel aus Metall oder Kunststoff, die zum Einlegen eines Ruders/Riemens verwendet wird."
                                        ],
                                        "tags": [
                                            "Rudern"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5fccabf3-a07e-4467-b936-1af1aa9b3be0",
                                                "sense_id": "da5c99d7-aed4-32cd-8927-d14fe1e3b16e",
                                                "text": "Sie legten die Ruder in die Dollen."
                                            },
                                            {
                                                "example_id": "ff1a93e9-d925-4a12-986e-317b4cdfec37",
                                                "sense_id": "da5c99d7-aed4-32cd-8927-d14fe1e3b16e",
                                                "text": "Früher stellte man die Dollen aus einer Bronzelegierung her."
                                            },
                                            {
                                                "example_id": "55fc601d-008d-4992-b999-4f66b465d0bb",
                                                "sense_id": "da5c99d7-aed4-32cd-8927-d14fe1e3b16e",
                                                "text": "Heike und ich stecken jede einen Riemen in die Dollen und rudern eifrig drauflos."
                                            },
                                            {
                                                "example_id": "44877fc9-3932-4594-949d-4f69ee26ffd0",
                                                "sense_id": "da5c99d7-aed4-32cd-8927-d14fe1e3b16e",
                                                "text": "„In der Mitte waren die Seitenwände durch eine Bank verbunden, um das Kanu stabil zu halten, sogar ein Dallbord mit Dollen für zwei Riemen hatte Pencroff montiert, und am Hecksitz war ein Ruder angebracht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
