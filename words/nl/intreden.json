                        "aanbreken",
                        "starten"
                    ],
                    "antonyms": [
                        "eindigen",
                        "ophouden"
                    ],
                    "common_phrases": [
                        "de winter is ingetreden",
                        "de rust is ingetreden"
                    ],
                    "target_lang_definitions": {
