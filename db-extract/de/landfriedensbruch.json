                "senses": [
                    {
                        "sense_id": "b3204647-844f-3761-ad86-c648fc0501b5",
                        "entry_id": "2da04c35-9822-35c7-b00e-3ed953f67534",
                        "glosses": [
                            "Straftat gegen die öffentliche Ordnung oder den öffentlichen Frieden durch gewalttätige Ausschreitung"
                        ],
                        "tags": [
                            "Rechtswesen"
                        ],
                        "examples": [
                            {
                                "example_id": "b1e21fe7-b8c1-41d7-8012-79aa2374301d",
                                "sense_id": "b3204647-844f-3761-ad86-c648fc0501b5",
                                "text": "Die Staatsanwaltschaft hat Ermittlungen wegen Landfriedensbruchs aufgenommen."
                            },
                            {
                                "example_id": "9cb93e66-d7d4-4f9d-ad5b-674c967e9b61",
                                "sense_id": "b3204647-844f-3761-ad86-c648fc0501b5",
                                "text": "„Das für Sportgewalt zuständige Landeskriminalamt hat unter anderem wegen des Verdachts des schweren Landfriedensbruchs und der Körperverletzung die Ermittlungen aufgenommen und bittet Geschädigte und Zeuginnen und Zeugen, die Hinweise geben können, sich beim Hinweistelefon der Polizei Hamburg zu melden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "924559b6-fcf5-45b7-b255-0a1fe0c422e7",
                        "source_entry_id": "2da04c35-9822-35c7-b00e-3ed953f67534",
                        "source_sense_id": "b3204647-844f-3761-ad86-c648fc0501b5",
                        "source_sense_description": "Straftat gegen den öffentlichen Frieden",
                        "target_lang_word": "breach of the peace",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "breach of the peace",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f609b0d6-e036-3765-b1ab-4d5f74605e48",
                                        "entry_id": "70d0be16-8c11-3ad2-83c5-8e8792749df9",
                                        "glosses": [
                                            "The legal offense of engaging in public behavior which is violent, rowdy, or disruptive."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d13ac2c2-3ee0-4821-b74c-2c10dc30b28e",
                                                "sense_id": "f609b0d6-e036-3765-b1ab-4d5f74605e48",
                                                "text": "Four men and a woman were arrested and charged with breaches of the peace after a series of scuffles in which protesters and police received minor injuries."
                                            },
                                            {
                                                "example_id": "3cb70b21-ee73-4c94-919c-5ede684f9294",
                                                "sense_id": "f609b0d6-e036-3765-b1ab-4d5f74605e48",
                                                "text": "[T]he sheriff turned his eyes again. . . . \"What have we here?\" he cried; \"two men boxing! Has there been a breach of the peace?\""
                                            },
                                            {
                                                "example_id": "1335ad0b-c463-4f2e-8f72-1dc64beea3cf",
                                                "sense_id": "f609b0d6-e036-3765-b1ab-4d5f74605e48",
                                                "text": "Short of high treason, the gravest form of breach of the peace known to British law is riot."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b6ab43d6-92d0-32f6-a8ae-26d8faea5530",
                                        "entry_id": "70d0be16-8c11-3ad2-83c5-8e8792749df9",
                                        "glosses": [
                                            "Any public disturbance or disorderly behavior."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b51eea9e-49c4-43b3-ba83-9a3211561794",
                                                "sense_id": "b6ab43d6-92d0-32f6-a8ae-26d8faea5530",
                                                "text": "Polly's suspicions were louder, her temper became uncertain; once or twice she forgot herself and used language calculated to cause a breach of the peace."
                                            },
                                            {
                                                "example_id": "94621c6b-9bea-4dcd-a7c3-53a793afa40c",
                                                "sense_id": "b6ab43d6-92d0-32f6-a8ae-26d8faea5530",
                                                "text": "Then, suddenly, the singing fell upon us and broke the silence into ruins. It was in the nature of a breach of the peace."
                                            },
                                            {
                                                "example_id": "49ee7826-0655-4fd3-9393-c9e5dac733ce",
                                                "sense_id": "b6ab43d6-92d0-32f6-a8ae-26d8faea5530",
                                                "text": "My rural ride continues, and on a gloriously balmy day in Worth Matravers the only obvious sign of a breach of the peace is a flock of geese lolloping out of the pond, on to the lane."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
