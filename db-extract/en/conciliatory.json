                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ebc30257-6702-4eb8-878f-66e968625fd3",
                                                "sense_id": "9574315c-ee26-3814-b50c-1e76e46959e0",
                                                "text": "Neben der Kritik kamen am Donnerstag aber auch versöhnlichere Signale aus Moskau."
                                            },
                                            {
                                                "example_id": "6bd9345f-4ca4-419b-9c80-73165b54fe01",
                                                "sense_id": "9574315c-ee26-3814-b50c-1e76e46959e0",
                                                "text": "Lincolns Inaugurationsrede war gemäßigt und versöhnlich."
                                            },
                                            {
                                                "example_id": "8a474643-8b55-4308-a607-d9233e031ed0",
                                                "sense_id": "9574315c-ee26-3814-b50c-1e76e46959e0",
                                                "text": "Bei einem Besuch des Schweizer Bundespräsidenten Didier Burkhalter in Berlin schlug die Kanzlerin allerdings versöhnliche Töne an und warnte vor übertriebenen Reaktionen gegen die Schweiz."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "dac8b40d-293f-301b-98ad-5afd4153eaba",
                                        "entry_id": "d6ee5aec-8d98-3db9-a529-d7b5ee2f42ba",
                                        "glosses": [
                                            "positiv erscheinend, als Ereignis, Tatsache"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e0fce6d-8516-42c5-b26a-1adefee46bac",
                                                "sense_id": "dac8b40d-293f-301b-98ad-5afd4153eaba",
                                                "text": "Die erste Hälfte von \"Mein Bruder, der Idiot\" läuft auf eine Tragödie hinaus, doch dann steuert das Drehbuch überraschend ein versöhnliches Ende an."
                                            },
                                            {
                                                "example_id": "1d32ef76-2eb1-42f6-a4c0-041c1354d5aa",
                                                "sense_id": "dac8b40d-293f-301b-98ad-5afd4153eaba",
                                                "text": "Darum wird in der jüngeren Version ein versöhnlicher Ausgang angestrebt."
                                            },
                                            {
                                                "example_id": "3e421093-726e-48db-8310-f3f258f80aa1",
                                                "sense_id": "dac8b40d-293f-301b-98ad-5afd4153eaba",
                                                "text": "Der FSV Frankfurt und Dynamo Dresden haben mit einem 1:1 einen versöhnlichen Saisonabschluss in der Zweiten Fußball-Bundesliga gefeiert."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
