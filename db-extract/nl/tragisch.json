                                                "sense_id": "e9298703-624e-3601-8796-e5eaaf585bab",
                                                "text": "That dress is tragic."
                                            },
                                            {
                                                "example_id": "94d2dc3b-9e35-4894-bdff-adc7779be9c4",
                                                "sense_id": "e9298703-624e-3601-8796-e5eaaf585bab",
                                                "text": "He's pretty tragic these days, hanging out with people half his age."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tragic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8d36965f-8cb8-3e32-bf03-e921101ddd3f",
