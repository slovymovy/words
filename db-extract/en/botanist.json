                                "target_senses": [
                                    {
                                        "sense_id": "1994bff2-6d31-36aa-aa02-e15f1c0685c5",
                                        "entry_id": "3209abfe-92fc-3f44-907d-93316fcbd2b0",
                                        "glosses": [
                                            "weiblicher Botaniker"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d65aa1ae-4af3-4739-bc7f-8ff2837cd532",
                                                "sense_id": "1994bff2-6d31-36aa-aa02-e15f1c0685c5",
                                                "text": "Maria Sibylla Merian war unter anderem auch eine große Botanikerin."
                                            },
                                            {
                                                "example_id": "8a9e7846-235a-41aa-8c9f-e4faabd231aa",
                                                "sense_id": "1994bff2-6d31-36aa-aa02-e15f1c0685c5",
                                                "text": "„Natürlich meldete sich die Botanikerin in mir.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
