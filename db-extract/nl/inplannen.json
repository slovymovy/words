                                        "examples": [
                                            {
                                                "example_id": "55ccc348-5874-409a-9103-5cd4f704ac1e",
                                                "sense_id": "65c124df-c5b9-399f-99cf-f75ac8d483b2",
                                                "text": "He didn't really have a plan; he had a goal and a habit of control."
                                            },
                                            {
