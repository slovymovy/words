                                "target_senses": [
                                    {
                                        "sense_id": "ab753db0-ec36-3c78-ae45-718a7b33616c",
                                        "entry_id": "a096b56e-1379-3742-8fb2-b0bfc65cb0a4",
                                        "glosses": [
                                            "Fée du folklore irlandais dont le cri annonce une mort imminente."
                                        ],
                                        "tags": [
                                            "Fantastique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a1625358-a7ee-4412-af36-b8871e352953",
                                                "sense_id": "ab753db0-ec36-3c78-ae45-718a7b33616c",
                                                "text": "Le nom du second yacht, La Banshee, qui porta ses randonnées sur la mer du Nord avec Berthe et Gabrielle, fait rêver. Michel avait sûrement entendu parler en Angleterre de ces fées pareilles à de spectrales vieilles femmes, pleurant sur le seuil des maisons d’Irlande où mourra quelqu’un. Il est étrange, pour ne pas dire plus, qu’il ait donné le nom d’une de ces lugubres annonciatrices à ce frêle objet toujours menacé qu’est un bateau de plaisance."
                                            },
                                            {
                                                "example_id": "46e31250-fe62-475b-8289-be1ad8a9195c",
                                                "sense_id": "ab753db0-ec36-3c78-ae45-718a7b33616c",
                                                "text": "Alors, comme ça, je suis une banshee ?"
                                            },
                                            {
                                                "example_id": "5e6da0f9-3b24-45a5-8e41-e4bda461a7ed",
                                                "sense_id": "ab753db0-ec36-3c78-ae45-718a7b33616c",
                                                "text": "Cette fille s’était battue comme une banshee."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0033dd7c-cd13-4731-b651-c0cae0312a1a",
                        "source_entry_id": "1cf344e4-2fb0-3462-a6f5-4aa911748c3a",
                        "source_sense_description": "in Irish folklore, a female spirit",
                        "target_lang_word": "banshie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "banshie",
