                "senses": [
                    {
                        "sense_id": "b1251e52-29c9-37d9-b8ad-176c95ed9292",
                        "entry_id": "e13d1010-08a0-3799-878b-55b50a3a22d4",
                        "glosses": [
                            "das hierarchische Ordnungssystem der verschiedenen Pflanzengesellschaften nach abgestufter floristischer Ähnlichkeit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e8efd3e8-f523-4685-92cc-c94b26ccc6a2",
                                "sense_id": "b1251e52-29c9-37d9-b8ad-176c95ed9292",
                                "text": "„In der Syntaxonomie (Synsystematik) wird die Ordnung der Pflanzengesellschaften vorwiegend nach der abgestuften floristischen Ähnlichkeit durchgeführt.“"
                            },
                            {
                                "example_id": "ef9c02e3-10f9-489e-a33b-11d7954077dc",
                                "sense_id": "b1251e52-29c9-37d9-b8ad-176c95ed9292",
                                "text": "„Leider sind die wissenschaftlichen Bezeichnungen vieler Pflanzenarten, wie auch der Vegetationseinheiten immer noch nicht so weit abgeklärt, daß sie allseits als allgemein gültig akzeptiert werden. Das Ziel wird sich nie ganz erreichen lassen, […]. Dazu kommen noch in der Taxonomie wie in der Syntaxonomie zeitbedingte modische Strömungen, die bei allem Fortschritt in den Erkenntnissen der kausalen, entwicklungsgeschichtlichen oder räumlichen Zusammenhängen unübersehbar sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
