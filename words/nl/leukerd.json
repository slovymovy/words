{
    "word_family": [
        "leuk",
        "leukheid"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a7336737-28b3-3a45-bbc4-e6ada557ec9e",
                    "sense_definition": "Iemand die heel aardig, sympathiek of aantrekkelijk is.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "sympathiek-persoon",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij hebben elkaar ontmoet op vakantie en het zijn echt twee <w>leukerds</w>.",
                            "target_lang_translations": {
                                "en": "They met on holiday and they really are two <w>sweethearts</w>."
                            }
                        },
                        {
                            "text": "Wat een <w>leukerd</w> is die nieuwe collega van de marketingafdeling.",
                            "target_lang_translations": {
                                "en": "What a <w>lovely person</w> that new colleague from the marketing department is."
                            }
                        }
                    ],
                    "antonyms": [
                        "chagrijn"
                    ],
                    "common_phrases": [
                        "echte leukerd"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used informally to describe a pleasant person."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Someone who is very nice, likable, or attractive."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sweetheart",
                                "target_lang_sense_clarification": "a lovable or very nice person"
                            },
                            {
                                "target_lang_word": "lovely person",
                                "target_lang_sense_clarification": "someone who is pleasant and charming"
                            },
                            {
                                "target_lang_word": "cutie",
                                "target_lang_sense_clarification": "an attractive or endearing person"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3e3a9293-a428-3ec6-a651-09398369e878",
                    "sense_definition": "Iemand die grappig probeert te zijn, vaak op een ietwat irritante of ironische manier.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "grappenmaker",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>leukerd</w> dacht dat het grappig was om mijn sleutels te verstoppen.",
                            "target_lang_translations": {
                                "en": "The <w>joker</w> thought it was funny to hide my keys."
                            }
                        },
                        {
                            "text": "Luister eens, <w>leukerd</w>, we hebben nu geen tijd voor jouw flauwe grappen.",
                            "target_lang_translations": {
                                "en": "Listen here, <w>wise guy</w>, we don't have time for your silly jokes right now."
                            }
                        }
                    ],
                    "synonyms": [
                        "lolbroek",
                        "grapjas",
                        "grappenmaker",
                        "snaak",
                        "clown"
                    ],
                    "common_phrases": [
                        "de leukerd uithangen"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Often used ironically or mockingly."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Someone who tries to be funny, often in a somewhat annoying or ironic way."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "joker",
                                "target_lang_sense_clarification": "someone who plays pranks or tries to be funny"
                            },
                            {
                                "target_lang_word": "wise guy",
                                "target_lang_sense_clarification": "someone who makes sarcastic or annoying jokes"
                            },
                            {
                                "target_lang_word": "funny guy",
                                "target_lang_sense_clarification": "someone trying to be amusing, often ironically"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b27ce734-29c4-39ef-bbf7-de9a3a39e8fd",
                    "sense_definition": "Iemand die zichzelf heel grappig vindt maar door anderen als vervelend of storend wordt ervaren.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "grappenmaker",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De wedstrijd werd kort stilgelegd omdat een of andere <w>leukerd</w> het veld op rende.",
                            "target_lang_translations": {
                                "en": "The match was briefly halted because some <w>jokester</w> ran onto the pitch."
                            }
                        },
                        {
                            "text": "Welke <w>leukerd</w> heeft de suiker met het zout verwisseld?",
                            "target_lang_translations": {
                                "en": "Which <w>smart aleck</w> swapped the sugar with the salt?"
                            }
                        }
                    ],
                    "synonyms": [
                        "lolbroek",
                        "grapjas"
                    ],
                    "common_phrases": [
                        "flauwe leukerd"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used with a negative or sarcastic undertone."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Someone who thinks they are very funny but is perceived by others as annoying or disruptive."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "jokester",
                                "target_lang_sense_clarification": "someone making annoying or disruptive jokes"
                            },
                            {
                                "target_lang_word": "smart aleck",
                                "target_lang_sense_clarification": "an irritating person who thinks they are clever or funny"
                            },
                            {
                                "target_lang_word": "funny guy",
                                "target_lang_sense_clarification": "used sarcastically for someone causing trouble with a prank"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}