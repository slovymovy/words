                        "sense_id": "04d73a27-a4e1-3528-abda-17d6d9c9b52e",
                        "entry_id": "a2f6f82e-2d91-30bf-b2ed-b1cd2d348e42",
                        "glosses": [
                            "Semi-désert d’Afrique du Sud."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f92f3800-6e4e-459c-aa64-5dd0cefbf4a6",
                                "sense_id": "04d73a27-a4e1-3528-abda-17d6d9c9b52e",
                                "text": "Créé en 1979, le parc naturel du Karoo, au nord de la province du Cap, abrite quelques espèces rares comme le zèbre de montagne, le gnou à queue blanche, ainsi que de nombreuses springboks."
                            },
                            {
                                "example_id": "6d9b579d-c724-4450-bed9-5f904e91b6cc",
                                "sense_id": "04d73a27-a4e1-3528-abda-17d6d9c9b52e",
                                "text": "Le site sud-africain comptera près de 200 paraboles dans la région reculée du Karoo."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7905d337-57cf-4e2e-ad1d-f3bd322b9743",
