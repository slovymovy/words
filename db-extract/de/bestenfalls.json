        "de-extract.jsonl": [
            {
                "entry_id": "9e23e767-879c-37e3-8e4b-8ba65ff4e4bb",
                "word": "bestenfalls",
                "pos": "adv",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "4fc4acc2-a1e5-3662-abc3-41b578f54b9d",
                        "entry_id": "9e23e767-879c-37e3-8e4b-8ba65ff4e4bb",
                        "glosses": [
                            "im günstigsten beziehungsweise besten Fall"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95395e04-5d95-46e5-ba93-efccc4acc05f",
                                "sense_id": "4fc4acc2-a1e5-3662-abc3-41b578f54b9d",
                                "text": "Brains Äußerungen sind bestenfalls naiv, wenn nicht dumm."
                            },
                            {
                                "example_id": "fde65ec3-d8ca-47bf-bf55-ca916ab2cee5",
                                "sense_id": "4fc4acc2-a1e5-3662-abc3-41b578f54b9d",
                                "text": "Der Vorstandsvorsitzende ließ bestenfalls Bedauern erkennen, jedoch keinerlei Reue."
                            },
                            {
                                "example_id": "8c6d6d92-1440-432f-876d-770116e0cbd9",
                                "sense_id": "4fc4acc2-a1e5-3662-abc3-41b578f54b9d",
                                "text": "„Wer gefahrenträchtige Ereignisse auf sich zutreiben läßt, wird sich bestenfalls als ein gutwilliger, an der Aufgabe wachsender, wohl kaum aber als ein sehr kompetenter Krisenmanager in der akuten Situation erweisen.“"
                            },
                            {
                                "example_id": "fc880735-a166-44e4-a223-c1d0c398ebbf",
                                "sense_id": "4fc4acc2-a1e5-3662-abc3-41b578f54b9d",
                                "text": "„Bestenfalls benötigt ein Erwachsener keinen anderen Menschen, sondern kommt so gut mit sich selbst zurecht, dass ein Partner oder eine Partnerin vielmehr eine Bereicherung ist und niemand, den man dringend braucht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f636ea01-6bf6-4414-8066-a406826d527d",
                        "source_entry_id": "9e23e767-879c-37e3-8e4b-8ba65ff4e4bb",
                        "source_sense_id": "4fc4acc2-a1e5-3662-abc3-41b578f54b9d",
                        "source_sense_description": "im besten Fall",
                        "target_lang_word": "at best",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "at best",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "328bf330-6453-34e3-a550-e2b4a1a79959",
                                        "entry_id": "92ab6683-7bda-3073-8092-516b985d77b3",
                                        "glosses": [
                                            "In the most favorable of conditions, especially in a situation that is otherwise negative."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32481bbc-0c34-4b56-a12e-832a66ff3785",
                                                "sense_id": "328bf330-6453-34e3-a550-e2b4a1a79959",
                                                "text": "The signalman, as such, was unknown at first. At junctions, or for shunting, the pointsman was responsible both for setting the points and working the appropriate signals, the two being independent. As a result, accidents were comparatively frequent, and the pointsman's job was, at best, a hazardous one."
                                            },
                                            {
                                                "example_id": "eb63cad3-1d14-415d-bb8f-19782f02ec97",
                                                "sense_id": "328bf330-6453-34e3-a550-e2b4a1a79959",
                                                "text": "Steve Bruce's side have swung from highs to lows in what has been at best a wildly inconsistent start to the season. They experienced a microcosm of this within the opening 45 minutes at the Stadium of Light."
                                            },
                                            {
                                                "example_id": "42b575ab-a1d0-4ae6-bdc0-483e90011980",
                                                "sense_id": "328bf330-6453-34e3-a550-e2b4a1a79959",
                                                "text": "The power of federal officials to issue a national vaccine mandate is questionable at best."
                                            },
                                            {
                                                "example_id": "0f265140-663a-482e-8043-4f40e5f5d5cd",
                                                "sense_id": "328bf330-6453-34e3-a550-e2b4a1a79959",
                                                "text": "It recalls the business case for Scotland's reopening of the Borders Railway to Tweedbank, that British Rail closed in 1969. The review says the business case for this was at best borderline, but goes on to say that the case greatly underestimated passenger demand and that the railway Scotland built has capped its capacity."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "941f3cef-8f69-4d1b-9809-290fe1112c69",
                        "source_entry_id": "9e23e767-879c-37e3-8e4b-8ba65ff4e4bb",
                        "source_sense_id": "4fc4acc2-a1e5-3662-abc3-41b578f54b9d",
                        "source_sense_description": "im besten Fall",
                        "target_lang_word": "at the best",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
