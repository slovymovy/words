                    }
                ],
                "translations": [
                    {
                        "translation_id": "6d1ec7fa-57c7-4f5d-8e2b-896387de9e84",
                        "source_entry_id": "221452cf-2fb9-3ce1-af56-d4fbed4cc774",
                        "source_sense_id": "bdad7eb7-1c38-3b08-8013-bc4b7e356504",
                        "target_lang_word": "udder",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "udder",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3a44ee12-170a-3190-9e1c-5691d449cd0a",
                                        "entry_id": "1633f966-1eab-357a-9569-6ec27d929e30",
                                        "glosses": [
                                            "An organ formed of the mammary glands of female quadruped mammals, particularly ruminants such as cattle, goats, sheep and deer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "edaea00b-d321-4cf2-89da-2019e77cc4b7",
                                                "sense_id": "3a44ee12-170a-3190-9e1c-5691d449cd0a",
                                                "text": "squeeze the udder to get milk"
                                            },
                                            {
                                                "example_id": "d2ea100e-0291-4864-97ac-cdb9c96bf8fd",
                                                "sense_id": "3a44ee12-170a-3190-9e1c-5691d449cd0a",
                                                "text": "The udder of the hyena, tied on the left arm, enticed the affection of any desired woman."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9cec3370-1a4a-3a5b-8676-e00a3e7e64ef",
                                        "entry_id": "1633f966-1eab-357a-9569-6ec27d929e30",
                                        "glosses": [
                                            "A woman's breast."
                                        ],
                                        "tags": [
                                            "impolite",
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "38680f44-12b6-4340-95a6-82c37a888a28",
                        "source_entry_id": "221452cf-2fb9-3ce1-af56-d4fbed4cc774",
                        "source_sense_id": "bdad7eb7-1c38-3b08-8013-bc4b7e356504",
                        "target_lang_word": "ubre",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ubre",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "2413d977-7870-3b9c-90be-acfaee3bbd27",
                                        "entry_id": "d5cb1638-a544-30e6-b1ba-24de35f401d4",
                                        "glosses": [
                                            "Cada una de las tetas de la hembra en los mamíferos."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0c1b382-34cb-4e9c-9b36-b35b89b9510a",
                                                "sense_id": "2413d977-7870-3b9c-90be-acfaee3bbd27",
                                                "text": "«El lobo brinca, para morder a las vacas en la ubre y a las yeguas detrás de la oreja, donde nace la crin»."
                                            },
                                            {
                                                "example_id": "8397d812-2560-434c-bce8-55b6f809c339",
                                                "sense_id": "2413d977-7870-3b9c-90be-acfaee3bbd27",
                                                "text": "«Y cuando ya la ubre se hinchaba, enrejado el becerro a la pata de la madre, mientras esta lo acariciaba lamiéndolo, comenzaba el ordeño hasta llenar las camazas»."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "fca42329-8caa-3eb3-966a-6ceddc92262a",
                                        "entry_id": "d5cb1638-a544-30e6-b1ba-24de35f401d4",
                                        "glosses": [
                                            "Conjunto de ellas."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d23aa7a-107e-46cc-8d4e-b2404f6ba583",
                                                "sense_id": "fca42329-8caa-3eb3-966a-6ceddc92262a",
                                                "text": "«La vaca mastica plácidamente, sus ojos aguachentos fijos en América, la baba goteando de sus labios correosos. Su ubre es larga y enjuta, gris en las puntas»."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "593b50ef-c5ce-45ab-836a-6e91acee2cf7",
                        "source_entry_id": "221452cf-2fb9-3ce1-af56-d4fbed4cc774",
                        "source_sense_id": "bdad7eb7-1c38-3b08-8013-bc4b7e356504",
                        "target_lang_word": "Euter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Euter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "85b33d9a-5141-3efe-94e9-893f7f346ffc",
                                        "entry_id": "a9966352-b5b0-37dd-858d-fb0d78d183be",
                                        "glosses": [
                                            "das in der Leistengegend von Huftieren sitzende Organ, welches im wesentlichen Milchdrüsen beherbergt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "efc1ada9-cdbc-47df-bdf8-9f08759acb7d",
                                                "sense_id": "85b33d9a-5141-3efe-94e9-893f7f346ffc",
                                                "text": "Das Euter versorgt, wie auch bei den übrigen Säugetieren, über die Zitzen die Nachkommen in der ersten Lebenszeit mit Milch."
                                            },
                                            {
                                                "example_id": "f549ba01-7467-404c-ba81-2726fd01b0cc",
                                                "sense_id": "85b33d9a-5141-3efe-94e9-893f7f346ffc",
                                                "text": "„Ich trat also aus Ihrer Hütte und erblickte tatsächlich Ihre weiße Ziege, die mir den Rücken zuwandte und mir ihr pralles Euter zeigte.“"
                                            },
                                            {
                                                "example_id": "cdf65411-880c-4e8b-b5fe-c998649d3ea4",
                                                "sense_id": "85b33d9a-5141-3efe-94e9-893f7f346ffc",
                                                "text": "„Unsere Hauptarbeit besteht übrigens im Melken; am Morgen und am Abend müssen die prallen Euter geleert werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "50ab536c-c160-4815-af95-76dbcf2cfa9a",
                        "source_entry_id": "221452cf-2fb9-3ce1-af56-d4fbed4cc774",
                        "source_sense_id": "bdad7eb7-1c38-3b08-8013-bc4b7e356504",
