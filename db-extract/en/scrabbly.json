                        "glosses": [
                            "Characterized by unusual letters (those that have a high score in the game Scrabble)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f3b87509-42d7-423d-9c66-9b7d6e6945c2",
                                "sense_id": "cb2804a9-ff5b-3ec1-85d1-2b78b9015986",
                                "text": "Also, the J in JUST RELAX was convenient in that it was Scrabbly yet off to the side (thus not restricting my options much), though the X in a prime position made the entry a bit of a gamble."
                            },
                            {
                                "example_id": "47afbcfb-d2c9-44f7-8f21-9e8298016386",
                                "sense_id": "cb2804a9-ff5b-3ec1-85d1-2b78b9015986",
                                "text": "Amy Reynaldo, the Crossword Fiend blogger, labels the richest alphabetical specimens as Scrabbly, an adjective I'm happy to spread."
                            },
                            {
                                "example_id": "8fcf1ad2-37ce-43e1-a222-09475024f06c",
                                "sense_id": "cb2804a9-ff5b-3ec1-85d1-2b78b9015986",
                                "text": "The Scrabbliest of the Scrabbly"
                            }
                        ]
