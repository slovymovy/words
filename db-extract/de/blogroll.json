                        "cross_references": [
                            {
                                "target_word": "blogroll",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "944c9deb-3989-3211-8bcc-2cd17a0998cb",
                                        "entry_id": "5684ff42-ea77-396b-90d6-762cf0f47f9a",
                                        "glosses": [
                                            "Espace dans lequel un blogueur place les liens vers les blogs qu'il recommande ou lit régulièrement."
                                        ],
                                        "tags": [
                                            "Anglicism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "849ec4c6-41cd-4531-b6c3-02c4cc67a260",
                                                "sense_id": "944c9deb-3989-3211-8bcc-2cd17a0998cb",
                                                "text": "Généralement situé à droite ou à gauche sur la page principale d'un blog, le blogroll est une liste de liens vers des blogs et des sites généralement qualifiés « d’amis » (un commentaire peut d’ailleurs accompagner la citation, et donc, préciser plus ou moins positivement cette « amitié »9). Les blogrolls donnent donc accès à une information partielle mais systématique sur les dynamiques réticulaires à l’œuvre chez les blogueur-se-s, en objectivant une partie des pratiques de citations entre eux-elles."
                                            },
                                            {
                                                "example_id": "8d2391de-80ce-455e-976a-d5f7e5008879",
                                                "sense_id": "944c9deb-3989-3211-8bcc-2cd17a0998cb",
                                                "text": "L'affichage sur toutes les pages est pertinent jusqu'à un certain nombre de liens. Ce nombre est dépendant de votre thème graphique : si la liste des liens doit occuper la moitié de la hauteur et que vous considérez ceci comme gênant, alors la migration de votre blogroll vers une page dédiée s'impose."
                                            },
                                            {
                                                "example_id": "b0425522-041d-4aaa-9914-0928cca374e8",
                                                "sense_id": "944c9deb-3989-3211-8bcc-2cd17a0998cb",
                                                "text": "De la même façon, les « blogrolls » ou « blogolistes » sont à notre avis l'outil le plus fiable pour repérer les blogs incontournables d'un domaine."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
