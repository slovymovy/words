                "senses": [
                    {
                        "sense_id": "d6071340-76dc-3729-909d-9c5063119607",
                        "entry_id": "e9bdb64a-e47b-3a6c-adc5-4a4d2a39b462",
                        "glosses": [
                            "Wolf, dessen Koexistenz mit der mitteleuropäischen Gesellschaft nicht reibungsfrei verläuft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b44d9df2-e116-4455-a175-99e62899aaad",
                                "sense_id": "d6071340-76dc-3729-909d-9c5063119607",
                                "text": "„Die Behörden in Sachsen wollen einen sogenannten Problemwolf abschießen, der sich wiederholt auffällig verhielt.“"
                            },
                            {
                                "example_id": "510718e1-ec9a-41f8-ba6c-d85fa5cc659d",
                                "sense_id": "d6071340-76dc-3729-909d-9c5063119607",
                                "text": "„Dass diese damit ihre Probleme hat, wissen wir, spätestens seit der Problemwolf Kurti durch Niedersachsen zieht und damit sogar Flugzeugeinsätze provozierte.“"
                            },
                            {
                                "example_id": "f0817488-ae76-4d0f-b52b-50acf12bdda9",
                                "sense_id": "d6071340-76dc-3729-909d-9c5063119607",
                                "text": "„Wenn der [Landeswolfsbeauftragte] ihn als Problemwolf einstuft, kann er geschossen werden.“"
                            },
                            {
                                "example_id": "bc247b38-06bf-46f3-b2a9-06e983bc1c9a",
                                "sense_id": "d6071340-76dc-3729-909d-9c5063119607",
                                "text": "„Das ist Kurti, unser Problemwolf, der macht uns schon seit langem Ärger.“"
                            },
                            {
                                "example_id": "be437cda-10fc-48e9-905b-29cdf0f9fedc",
                                "sense_id": "d6071340-76dc-3729-909d-9c5063119607",
                                "text": "„Er wird kühl M75 genannt und gilt als «Problemwolf».“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
