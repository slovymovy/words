                ],
                "senses": [
                    {
                        "sense_id": "fb9bda1a-8030-33b1-a8c3-cf8a5c534a74",
                        "entry_id": "b66ec7b3-34fe-3c27-932f-eabc7e5256b1",
                        "glosses": [
                            "der Sonnenschein am Abend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f796039-5450-44e0-8710-8145d374ee5f",
                                "sense_id": "fb9bda1a-8030-33b1-a8c3-cf8a5c534a74",
                                "text": "„Angeschmiegt an eine senkrechte Felswand liegt die sandige Bucht in der Abendsonne.“"
                            },
                            {
                                "example_id": "28639d33-a94f-4281-9c28-d4412502df27",
                                "sense_id": "fb9bda1a-8030-33b1-a8c3-cf8a5c534a74",
                                "text": "„Die Abendsonne warf ihre letzten Strahlen auf den grünen Grabhügel, und drüben leuchteten die Schneeberge wie ehemals, da sie mit mir in der Abendsonne über die Hügel streifte, die nun zur Ruhe gegangen war.“"
                            },
                            {
                                "example_id": "9375b92c-6121-42af-9109-caf5647848a5",
                                "sense_id": "fb9bda1a-8030-33b1-a8c3-cf8a5c534a74",
                                "text": "„Ich saß auf einer Bank und die frühe Abendsonne leuchtete auf die Enten im Fluss.“"
                            },
                            {
                                "example_id": "eb570d1d-300b-4ea7-9fe6-bd40b7879a12",
                                "sense_id": "fb9bda1a-8030-33b1-a8c3-cf8a5c534a74",
                                "text": "„Es geht leicht bergan, die Abendsonne sinkt tiefer.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
