                    {
                        "translation_id": "1081f8f9-4bfc-4648-9e76-7a8609f3dc28",
                        "source_entry_id": "94f12e66-85b0-3553-bd53-39a8cd62f202",
                        "source_sense_description": "tight-fitting stretch pants",
                        "target_lang_word": "legging",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "legging",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "409b28ed-1a8e-3e30-a126-bc2f0e03b7aa",
                                        "entry_id": "34a872e6-fbaf-3511-95b1-095f1e248af2",
                                        "glosses": [
                                            "een broek van fijn gebreide stof, die strak om het lichaam heen zit. Op straat worden ze vrijwel alleen door vrouwen gedragen, maar op sportgebied worden ze door zowel mannen als vrouwen gedragen."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ceb36608-853c-4867-8bd8-c9b6d01f5019",
                                                "sense_id": "409b28ed-1a8e-3e30-a126-bc2f0e03b7aa",
                                                "text": "Familie Kruys-actrice Elise Schaap kan zichzelf niet meer beheersen. Dochtertje Ava (2) kreeg een legging met konijntjesmotief, T-shirt met beesten in de jungle-motief en een speldje van een vogeltje in het haar. Het 'doorcombineren' van het dierenthema loopt uit de hand."
                                            },
                                            {
                                                "example_id": "37cc7fb3-18fd-4317-b6ea-7e0ffef7838e",
                                                "sense_id": "409b28ed-1a8e-3e30-a126-bc2f0e03b7aa",
                                                "text": "'Ik ben niet zo excessief in mijn stijl. Dus is er weinig ruimte om te blunderen. Ik herinner me wel een outfit die ik regelmatig aandeed, waarvan ik nu denk dat hij misschien wat raar moet geoogd hebben: een blauw shortje van Adidas, een fifties topje van Pucci en schoenen die er helemaal niet op pasten. Maar dat was in New York en daar zijn ze vreemde combinaties wel gewoon. En toen ik zwanger was droeg ik om één of andere reden leggings tot onder de knie.'"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "071b3591-3f2c-32e4-a09d-f1f15ce33797",
                                        "entry_id": "34a872e6-fbaf-3511-95b1-095f1e248af2",
                                        "glosses": [
                                            "het neerleggen van iets"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7f0f4920-5315-41d6-9948-e4ad2b9454c4",
                        "source_entry_id": "94f12e66-85b0-3553-bd53-39a8cd62f202",
