                ],
                "senses": [
                    {
                        "sense_id": "5bb987bc-e8c5-38e0-aa33-9e2b3f07e827",
                        "entry_id": "3bf55f68-fd56-322f-a602-612ad0766026",
                        "glosses": [
                            "Mensch, der das Spielen liebt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "620278b1-e749-48c1-9b9e-6589fa4e3852",
                                "sense_id": "5bb987bc-e8c5-38e0-aa33-9e2b3f07e827",
                                "text": "„Nach dem Spielbanken-Gesetz sind nämlich die Einwohner des Ortes, in dem die Kugeln rollen, vom Besuch des Etablissements ausgeschlossen, nicht aber Spielfreunde aus der Umgebung.“"
                            },
                            {
                                "example_id": "d6ab0c88-ea93-4eed-a7c2-3e5aa9bbb56f",
                                "sense_id": "5bb987bc-e8c5-38e0-aa33-9e2b3f07e827",
                                "text": "„Um so mehr freut sich der Spielfreund, wenn er ganz unvermutet nach Jahren entdeckt, daß so ein Spiel neu herausgebracht wird.“"
                            },
                            {
                                "example_id": "889b7c7c-552c-4d8e-84a0-4357820e8227",
                                "sense_id": "5bb987bc-e8c5-38e0-aa33-9e2b3f07e827",
                                "text": "„An gesamtdeutschen Skat gar, an ein WM-Team gemeinsam mit den Spielfreunden aus Altenburg und Umgebung, ist schon gar nicht zu denken.“"
                            },
                            {
                                "example_id": "ba11ea6a-35ed-43ea-8578-14bdc96fe371",
                                "sense_id": "5bb987bc-e8c5-38e0-aa33-9e2b3f07e827",
                                "text": "„Aus der Not heraus wurde 1998 unsere Elterninitiative Spielfreunde e.V. in München – Neuhausen gegründet.“"
                            },
                            {
                                "example_id": "58b70d92-f2b0-4cb1-8db4-164c94001e2d",
                                "sense_id": "5bb987bc-e8c5-38e0-aa33-9e2b3f07e827",
                                "text": "„Zur Verstärkung des Klangkörpers sucht das Tambour- und Fanfaren-Korps Spielfreunde Uerdingen 1927 e. V noch Nachwuchs in den Bereichen Trommel, Lyra, Flöte und Fanfare sowie an Pauke und Becken."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "97cd8b0e-5786-3774-b97e-64de01f6d1d4",
                        "entry_id": "3bf55f68-fd56-322f-a602-612ad0766026",
                        "glosses": [
                            "Mensch, der gern und oft mit einem Partner spielt und entsprechend eng mit diesem verbunden ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b932658-9e90-4c72-aa8a-602ec542c1f3",
                                "sense_id": "97cd8b0e-5786-3774-b97e-64de01f6d1d4",
                                "text": "„Vielmehr ist der 13 Jahre alte Karli ein Nachbarsbub und der große Spielfreund des achtjährigen Sohnes der Frau Lilo.“"
                            },
                            {
                                "example_id": "d52be459-7cfa-4530-9334-51b90243e38a",
                                "sense_id": "97cd8b0e-5786-3774-b97e-64de01f6d1d4",
                                "text": "„Nach Jahren hatte Graeper, der noch immer in Lichtenrade wohnt, seinen Spielfreund Wolfgang Nienke wieder getroffen.“"
                            },
                            {
                                "example_id": "125b083a-9cd1-421b-9389-7a99b7a4c6b8",
                                "sense_id": "97cd8b0e-5786-3774-b97e-64de01f6d1d4",
                                "text": "„Die meisten Spielfreunde wohnen nach wie vor in Berlin, viele sind in Tempelhof geblieben.“"
                            },
                            {
                                "example_id": "0cb3b20c-35ef-4e73-b6ce-32bf9848c370",
                                "sense_id": "97cd8b0e-5786-3774-b97e-64de01f6d1d4",
                                "text": "„Er bot dem Spielfreund an, ihm die Anzahlung von zehntausend Euro zurückzugeben.“"
                            },
                            {
                                "example_id": "0f9d40b1-b5fc-4052-b02b-92acf395b85d",
                                "sense_id": "97cd8b0e-5786-3774-b97e-64de01f6d1d4",
                                "text": "„Im Verfahren ‚Vater, Tochter, Spielfreund der Tochter, Filmaufnahmen’ wird das Bild einer Verleumdungskampagne konstruiert.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
