                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ffe6920a-2016-48de-971e-b9b7596f5aa0",
                                                "sense_id": "02f1da6d-9e04-331a-b680-74b9a6273a42",
                                                "text": "I want you to have every loving brother’s sister’s cousin’s child downstairs and standing at attention at six o’clock."
                                            },
                                            {
                                                "example_id": "7cb340df-9597-42c4-b852-a738110fd413",
                                                "sense_id": "02f1da6d-9e04-331a-b680-74b9a6273a42",
                                                "text": "“Anderson,” said Beaupre, “you think we’re going to see any lovin’ Viet Congs today?”"
                                            },
                                            {
                                                "example_id": "9450c555-c8eb-4106-954d-bb8597ff38a0",
                                                "sense_id": "02f1da6d-9e04-331a-b680-74b9a6273a42",
                                                "text": "“ Eat and drink like a loving pig,” he says, patting the bulge under his parka."
                                            },
                                            {
                                                "example_id": "a7b5c334-f100-4a4a-a20e-a4a198fa17c3",
                                                "sense_id": "02f1da6d-9e04-331a-b680-74b9a6273a42",
                                                "text": "At long lovin’ last!"
                                            }
