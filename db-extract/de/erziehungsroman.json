                "senses": [
                    {
                        "sense_id": "7f634b14-a3d1-342c-98cf-a24dca805b59",
                        "entry_id": "11449f3e-ad8e-3798-9db7-b576207790d0",
                        "glosses": [
                            "Roman, in dem das Heranwachsen der Hauptfigur mit besonderem Blick auf pädagogische Methoden/Theorien beschrieben ist (nicht so sehr der innere Reifeprozess)"
                        ],
                        "tags": [
                            "Literaturwissenschaft"
                        ],
                        "examples": [
                            {
                                "example_id": "86da0538-fa6a-434e-b840-62c1332c48e5",
                                "sense_id": "7f634b14-a3d1-342c-98cf-a24dca805b59",
                                "text": "„Erziehungsratgeber sind keine Neuheiten. Seit Jean-Jacques Rousseau 1762 seinen berühmten Erziehungsroman ‚Emile oder: über die Erziehung‘ verfasste, haben Philosophen und Pädagogen Ratgeber verfasst.“"
                            },
                            {
                                "example_id": "510b95ed-2179-4db5-a20a-c690a55796cd",
                                "sense_id": "7f634b14-a3d1-342c-98cf-a24dca805b59",
                                "text": "„Wie schon für die jugendlichen Protagonisten in den Büchern, die in der Weimarer Zeit angesiedelt sind, wird auch die Entwicklung des Ludwig Kern im Stile des Erziehungsromans dargestellt.“"
                            },
                            {
                                "example_id": "402475cf-6be6-44cb-b368-d3fe535773d7",
                                "sense_id": "7f634b14-a3d1-342c-98cf-a24dca805b59",
                                "text": "„Aus Kortums Parodie des früher so beliebten Erziehungsromans wurde eine Bildergeschichte Wilhelm Buschs, deren Text größtenteils von ihm stammt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
