                "senses": [
                    {
                        "sense_id": "c57d295d-b041-32c1-90fc-71c23baf925d",
                        "entry_id": "35fb67e0-d8b9-30e1-9845-cba6501d2669",
                        "glosses": [
                            "państwo w Europie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "65d4739c-0e21-42ac-ac76-91f4d9489921",
                                "sense_id": "c57d295d-b041-32c1-90fc-71c23baf925d",
                                "text": "Estonia jest krajem europejskim."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2ba6a2fb-c3c5-4f9d-91da-929b91f2f78c",
                        "source_entry_id": "35fb67e0-d8b9-30e1-9845-cba6501d2669",
                        "source_sense_id": "c57d295d-b041-32c1-90fc-71c23baf925d",
                        "target_lang_word": "Estonia",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Estonia",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cca7b529-6ccc-35e4-b463-f149fbd370f9",
                                        "entry_id": "5c3b3b6b-ad7b-38b5-bacc-bc2bac8f0ee1",
                                        "glosses": [
                                            "A country in northeastern Europe, on the southeastern coast of the Baltic Sea. Official name: Republic of Estonia."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e01b529-6ff5-4aa9-95e1-e087ef79c338",
                                                "sense_id": "cca7b529-6ccc-35e4-b463-f149fbd370f9",
                                                "text": "“In the late 1930s, the Western democracies hesitated in the face of danger,” Prime Minister Siim Kallas of Estonia, a former Soviet republic, told me. “As a consequence, we fell under dictatorships and many people lost their lives. Action is sometimes necessary.”"
                                            },
                                            {
                                                "example_id": "31155039-f92b-4a6d-bc62-1059c9dd035e",
                                                "sense_id": "cca7b529-6ccc-35e4-b463-f149fbd370f9",
                                                "text": "While there is less income inequality in Estonia than in the United States—and, with 1.3 million people, the country is significantly smaller—the Baltic nation also has its share of cultural diversity."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8fb544a2-0bab-4213-ad11-c2d7fe8ceaac",
                        "source_entry_id": "35fb67e0-d8b9-30e1-9845-cba6501d2669",
                        "source_sense_id": "c57d295d-b041-32c1-90fc-71c23baf925d",
                        "target_lang_word": "爱沙尼亚",
                        "target_lang_code": "zh",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "014fda33-48c4-4e78-b7d4-e0f1909bd5cf",
                        "source_entry_id": "35fb67e0-d8b9-30e1-9845-cba6501d2669",
                        "source_sense_id": "c57d295d-b041-32c1-90fc-71c23baf925d",
                        "target_lang_word": "Estonsko",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Estonsko",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "be167f4d-2c1e-3ef5-a98f-259cd054ce94",
                                        "entry_id": "4651ff59-f5f3-3a1e-b5c1-97d88010735d",
                                        "glosses": [
                                            "stát v severovýchodní Evropě"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8e89303-f144-4f1b-ac6b-6bee3f2be279",
                                                "sense_id": "be167f4d-2c1e-3ef5-a98f-259cd054ce94",
                                                "text": "Bývalé sovětské republiky Litva, Lotyšsko a Estonsko jsou vůči Rusku kvůli jeho anexi ukrajinského Krymu a podpoře proruských separatistů na východě Ukrajiny velmi podezřívavé."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cc9b9c24-3611-4e3c-a38d-65dc06e57e7e",
                        "source_entry_id": "35fb67e0-d8b9-30e1-9845-cba6501d2669",
                        "source_sense_id": "c57d295d-b041-32c1-90fc-71c23baf925d",
                        "target_lang_word": "Estonie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Estonie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3d17ef44-76b0-30ab-97e1-87a890ca589d",
                                        "entry_id": "6bf91ff4-5895-322c-a9d6-07f195306991",
                                        "glosses": [
                                            "Pays d’Europe orientale, bordé par le golfe de Finlande au nord, la Russie à l’est, la Lettonie au sud, et la mer Baltique à l’ouest. Sa capitale est Tallinn."
                                        ],
                                        "tags": [
                                            "Pays"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "27508a5f-4ae5-4d5b-b190-de483ca85fe7",
                                                "sense_id": "3d17ef44-76b0-30ab-97e1-87a890ca589d",
                                                "text": "En fait, ils s’étaient rendus en Estonie chez les parents du musicien, que Jeanne et Egon n’avaient plus revus depuis la visite qui avait suivi le mariage à Dresde."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "854d6bd4-bd1f-4de1-9833-620ad341a5d0",
                        "source_entry_id": "35fb67e0-d8b9-30e1-9845-cba6501d2669",
                        "source_sense_id": "c57d295d-b041-32c1-90fc-71c23baf925d",
                        "target_lang_word": "Estonia",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Estonia",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "e0081e4b-ffbb-3a0c-8099-bee42747df18",
                                        "entry_id": "85168d22-62d1-3855-be58-434166dd7270",
                                        "glosses": [
                                            "País del noreste de Europa, que es una de las tres repúblicas bálticas y forma parte de la Unión Europea. Limita al sur con Letonia y al este con Rusia. Hasta 1991 hizo parte de la Unión Soviética."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "878fba29-4a57-433d-9479-907756114471",
                        "source_entry_id": "35fb67e0-d8b9-30e1-9845-cba6501d2669",
                        "source_sense_id": "c57d295d-b041-32c1-90fc-71c23baf925d",
                        "target_lang_word": "Estland",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Estland",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "7ed6bd23-5d44-342c-a51c-2ca5f9c4954e",
                                        "entry_id": "823cb382-c3c0-396f-ba3d-0d4f8894bd75",
                                        "glosses": [
                                            "een land in het noorden van Europa dat grenst aan Letland en Rusland"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7684e4f-1f2f-488f-bf57-7fcdffa6c521",
                                                "sense_id": "7ed6bd23-5d44-342c-a51c-2ca5f9c4954e",
                                                "text": "Ik heb vier jaar in Estland gewoond."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "17d12ed1-2315-4f04-8c8b-7ea447486b14",
                        "source_entry_id": "35fb67e0-d8b9-30e1-9845-cba6501d2669",
                        "source_sense_id": "c57d295d-b041-32c1-90fc-71c23baf925d",
                        "target_lang_word": "Estland",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Estland",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "51ba0620-7064-3df9-b8ed-2a155ec2f097",
                                        "entry_id": "165bd71e-e546-3546-84b9-6b497e66b0cc",
                                        "glosses": [
                                            "ein Land im Baltikum (Nordeuropa)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9dde040c-0a5d-4584-9353-ae0f51c8e43b",
                                                "sense_id": "51ba0620-7064-3df9-b8ed-2a155ec2f097",
                                                "text": "Das heutige Estland ist Europa wieder nähergekommen."
                                            },
                                            {
                                                "example_id": "bb50fc1e-25a0-4637-b6de-435ee8fbe5ee",
                                                "sense_id": "51ba0620-7064-3df9-b8ed-2a155ec2f097",
                                                "text": "Tallinn ist die Hauptstadt von Estland."
                                            },
                                            {
                                                "example_id": "fb42206f-2cea-4cc1-bfa8-cfbd0e09365f",
                                                "sense_id": "51ba0620-7064-3df9-b8ed-2a155ec2f097",
                                                "text": "„Haupthandelspartner Estlands sind die skandinavischen Nachbarländer Schweden und Finnland sowie die Baltikum-Nachbarstaaten Lettland und Litauen.“"
                                            },
                                            {
                                                "example_id": "492477d2-238f-44ab-97da-eb4b0131f07a",
                                                "sense_id": "51ba0620-7064-3df9-b8ed-2a155ec2f097",
                                                "text": "„In Estland und Litauen entstanden auch Lokalposten: echte Bedarfsbriefe sind jedoch nur wenige bekannt.“"
                                            },
                                            {
                                                "example_id": "1d011b8b-a9b4-48a7-8a08-c09b978dcc3f",
                                                "sense_id": "51ba0620-7064-3df9-b8ed-2a155ec2f097",
                                                "text": "„Wer in Estland russisch spricht, macht sich verdächtig: der Zuneigung zu Wladimir Putin und seinem neoimperialen Projekt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "461df7f1-6d64-4a32-8aa7-dc7d908c3a8f",
                        "source_entry_id": "35fb67e0-d8b9-30e1-9845-cba6501d2669",
                        "source_sense_id": "c57d295d-b041-32c1-90fc-71c23baf925d",
                        "target_lang_word": "Эстония",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Эстония",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "efc24030-f7a1-3c67-b660-077859c21fee",
                                        "entry_id": "ba036597-0794-3bc5-beeb-ea732922ffa2",
                                        "glosses": [
                                            "государство в Прибалтике"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ccbb61f-232e-4375-a5a3-e84a07dcce84",
                                                "sense_id": "efc24030-f7a1-3c67-b660-077859c21fee",
                                                "text": "Третьим ходатаем был король датский, Фридерик II. Эстония, как известно, принадлежала некогда его предкам."
                                            },
                                            {
                                                "example_id": "7d95f64f-bfbb-4191-be39-3d0da629cf3c",
                                                "sense_id": "efc24030-f7a1-3c67-b660-077859c21fee",
                                                "text": "Собрание членов местной эстонской колонии по вопросу о внутреннем устройстве эстонской части Прибалтийского края высказалось за необходимость образования автономной Эстонии в составе будущей великой Российской республики, подобно отдельным штатам Северной Америки."
                                            },
                                            {
