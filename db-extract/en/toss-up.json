                        "sense_id": "7470d974-9da5-309d-a03b-bc965fde3a94",
                        "entry_id": "f222f3cc-d55b-33ca-bb25-597a540de064",
                        "glosses": [
                            "A decision in which neither choice is clearly favorable or unfavorable, or for which the outcome does not matter."
                        ],
                        "tags": [
                            "idiomatic"
                        ],
                        "examples": [
                            {
                                "example_id": "a4922375-85d7-4bfa-89f6-48aa3146984b",
                                "sense_id": "7470d974-9da5-309d-a03b-bc965fde3a94",
                                "text": "It's really a toss-up between the red skirt with blue stripes and the blue skirt with red stripes. They both look good and fit well."
                            }
                        ]
                    },
                    {
                        "sense_id": "135c38d0-7d39-3f7e-bd53-816846a13f2c",
                        "entry_id": "f222f3cc-d55b-33ca-bb25-597a540de064",
                        "glosses": [
                            "Either of two outcomes that are equally likely."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c1cd05e-8953-49b4-b22e-736adc68dfa3",
                                "sense_id": "135c38d0-7d39-3f7e-bd53-816846a13f2c",
                                "text": "“He’ll do,” said the Doctor, quietly. “It must have been a toss-up all through the night. ’Think you’re to be congratulated on this case.”"
                            },
                            {
                                "example_id": "7704a797-4d0a-440f-86c3-398fe9c1b465",
                                "sense_id": "135c38d0-7d39-3f7e-bd53-816846a13f2c",
                                "text": "No longer is the best picture going to be a toss-up between that troika of national-historical heavies: Argo, Lincoln and Zero Dark Thirty. Instead, a warm welcome back for Life of Pi, widely dismissed by many as \"this year's Hugo\" but this column's dark-horse pick from October."
                            }
                        ]
                    },
                    {
                        "sense_id": "e141a12d-c27b-3969-ad43-ece125683261",
                        "entry_id": "f222f3cc-d55b-33ca-bb25-597a540de064",
                        "glosses": [
                            "The toss of a coin used to decide some issue."
