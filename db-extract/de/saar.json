                                        "entry_id": "67b7cefd-dc2b-3609-a826-2125d2ef08c9",
                                        "glosses": [
                                            "Un des seize Länder qui constituent la République fédérale d’Allemagne. Sa capitale est Sarrebruck."
                                        ],
                                        "tags": [
                                            "toponymic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f32781a4-715d-449b-8ff9-f239edce6cba",
                                                "sense_id": "8a1def9b-792f-3873-ac78-72f3ff5804af",
                                                "text": "Quand des Alsaciens ou des Mosellans se précipitaient dans le Bade-Wurtemberg, la Sarre ou la Rhénanie-Palatinat pour faire le plein, chercher du tabac ou acheter des produits d’hygiène…"
                                            }
                                        ]
