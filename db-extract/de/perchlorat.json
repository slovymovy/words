                                        "entry_id": "58606a90-96d9-32fc-8883-a98b11c92fd5",
                                        "glosses": [
                                            "Nom générique des sels d’acide perchlorique ; anion de formule ClO₄⁻."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df24649a-6da8-43dd-8cd2-5f0b79cceba4",
                                                "sense_id": "a60f5591-8b27-3661-acc7-d037881dda25",
                                                "text": "Les forces américaines avaient trouvé à son bord plus de 70 tonnes de perchlorate d'ammonium et plus de 100 tonnes d'engrais à base d'urée, des substances pouvant servir à fabriquer du carburant pour les missiles ainsi que des explosifs."
                                            },
                                            {
                                                "example_id": "44a747b6-15c0-4a1d-88d6-c83d4fea13fb",
                                                "sense_id": "a60f5591-8b27-3661-acc7-d037881dda25",
                                                "text": "Résultats d’essais effectués sur des eaux naturelles contenant des ions perchlorates, avec et sans présence de nitrates, à l’aide de résines échangeuses d’ions et de nanofiltrations."
                                            }
                                        ]
                                    }
                                ]
