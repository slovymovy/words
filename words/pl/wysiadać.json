    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "15ed8e16-ffc1-359c-8f0b-5241f6e52279",
                    "sense_definition": "opuszczać środek transportu, na przykład autobus, pociąg, samochód lub samolot",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "transport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zawsze <w>wysiadam</w> z autobusu na tym samym przystanku w centrum miasta.",
                            "target_lang_translations": {
                                "ru": "Я всегда <w>выхожу</w> из автобуса на одной и той же остановке в центре города."
                            }
                        },
                        {
                            "text": "Czy pan również <w>wysiada</w> na następnej stacji kolejowej?",
                            "target_lang_translations": {
                                "ru": "Вы тоже <w>выходите</w> на следующей железнодорожной станции?"
                            }
                        }
                    ],
                    "antonyms": [
                        "wsiadać"
                    ],
                    "common_phrases": [
                        "wysiadać z autobusu",
                        "wysiadać z pociągu",
                        "wysiadać na przystanku"
                    ],
                    "target_lang_definitions": {
                        "ru": "покидать транспортное средство (автобус, поезд, автомобиль и т. д.)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выходить",
                                "target_lang_sense_clarification": "из транспорта"
                            },
                            {
                                "target_lang_word": "сходить",
                                "target_lang_sense_clarification": "с поезда, автобуса"
                            },
                            {
                                "target_lang_word": "высаживаться",
                                "target_lang_sense_clarification": "о пассажирах, десанте"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b63e4aff-37f9-329f-adcf-d83c5a2e6b76",
                    "sense_definition": "o urządzeniu lub mechanizmie: psuć się i przestawać działać poprawnie",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "failure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Stary silnik w samochodzie powoli <w>wysiada</w> i wymaga pilnej naprawy.",
                            "target_lang_translations": {
                                "ru": "Старый двигатель в машине потихоньку <w>сдаёт</w> и требует срочного ремонта."
                            }
                        },
                        {
                            "text": "W trakcie letnich upałów często <w>wysiada</w> klimatyzacja w biurze.",
                            "target_lang_translations": {
                                "ru": "Во время летней жары в офисе часто <w>отказывает</w> кондиционер."
                            }
                        }
                    ],
                    "synonyms": [
                        "psuć się",
                        "siadać"
                    ],
                    "common_phrases": [
                        "silnik wysiada",
                        "bateria wysiada"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "potoczne określenie awarii sprzętu"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "о механизмах и приборах: ломаться, отказывать, переставать работать"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отказывать",
                                "target_lang_sense_clarification": "о технике, приборах"
                            },
                            {
                                "target_lang_word": "выходить из строя",
                                "target_lang_sense_clarification": "ломаться"
                            },
                            {
                                "target_lang_word": "сдавать",
                                "target_lang_sense_clarification": "разг., о механизмах"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "243a9ca1-9835-3d83-8590-7653cfcf3418",
                    "sense_definition": "o człowieku lub jego ciele: tracić siły, ulegać wyczerpaniu z powodu zmęczenia lub stresu",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "exhaustion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Po całym dniu ciężkiej pracy fizycznej zupełnie <w>wysiadam</w> ze zmęczenia.",
                            "target_lang_translations": {
                                "ru": "После целого дня тяжёлой физической работы я просто <w>валюсь с ног</w> от усталости."
                            }
                        },
                        {
                            "text": "Gdy żyjesz w ciągłym stresie, twoje zdrowie powoli <w>wysiada</w>.",
                            "target_lang_translations": {
                                "ru": "Когда живёшь в постоянном стрессе, здоровье постепенно <w>сдаёт</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "siadać"
                    ],
                    "common_phrases": [
                        "nerwy wysiadają",
                        "zdrowie wysiada"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "potoczne określenie skrajnego wyczerpania"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "о человеке или здоровье: терять силы, сдавать от усталости или стресса"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сдавать",
                                "target_lang_sense_clarification": "о здоровье, нервах"
                            },
                            {
                                "target_lang_word": "выдыхаться",
                                "target_lang_sense_clarification": "терять силы от усталости"
                            },
                            {
                                "target_lang_word": "валиться с ног",
                                "target_lang_sense_clarification": "от крайнего утомления"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}