                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В центре города создали зону, предназначенную только для <w>пешеходов</w>.",
                            "target_lang_translations": {
                                "en": "A zone intended only for <w>pedestrians</w> was created in the city center."
                            }
                        },
                        {
                            "text": "Уставший <w>пешеход</w> присел на скамейку в парке отдохнуть.",
                            "target_lang_translations": {
                                "en": "A tired <w>walker</w> sat down on a bench in the park to rest."
                            }
                        }
                    ],
                    "common_phrases": [
