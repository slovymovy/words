                                        "entry_id": "931ee04b-2a60-33a0-b7e2-acbb8f3939ad",
                                        "glosses": [
                                            "A waterproof garment, made from oilskin, used especially at sea."
                                        ],
                                        "tags": [
                                            "plural",
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f69a86c1-2ff9-4ce3-b8e0-ffcefedca5be",
                                                "sense_id": "8845aeaa-efc8-3084-bd38-4f105db43e91",
                                                "text": "The place had the empty and musty feel and smell usual to a dwelling no longer inhabited. Everywhere was a thick litter of discarded and ragged garments, old sea-boots, leaky oilskins -- all the worthless forecastle dunnage of a long voyage."
                                            }
