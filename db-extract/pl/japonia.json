                                "example_id": "0e8aa378-f5b2-4acc-ad1d-c8f16110395e",
                                "sense_id": "ebba677f-8ff8-390e-90e5-65363ae615f3",
                                "text": "Walutą Japonii jest jen."
                            },
                            {
                                "example_id": "08bc5596-4d12-4445-8dbf-1c9debbb5c47",
                                "sense_id": "ebba677f-8ff8-390e-90e5-65363ae615f3",
