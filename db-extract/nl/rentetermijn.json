                        "examples": [
                            {
                                "example_id": "97169522-609f-4230-9360-331d9fcd9d2c",
                                "sense_id": "238a1ca3-61c5-38f3-ad50-a18f2b27de07",
                                "text": "En onafwendbaar kwam elke maand de dag waarop de woekeraar op zijn huurkamer boven de tabakswinkel verscheen en hem het bewijs liet ondertekenen dat zijn schuld met een nieuwe rentetermijn vermeerderd was."
                            },
                            {
                                "example_id": "7e235ef7-b591-46da-88e1-ccf537cd24ac",
                                "sense_id": "238a1ca3-61c5-38f3-ad50-a18f2b27de07",
                                "text": "Maar dankzij het advies van zijn beleggingsbank Bloomfield Weiss had het bedrijf te veel schulden aangegaan en het zou moeite hebben zelfs de volgende rentetermijn te betalen."
                            }
                        ]
