    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5344481c-abd1-3167-95d7-21136f0c3e41",
                    "sense_definition": "To walk in a slow, relaxed, or casual way.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "walking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They decided to <w>saunter</w> through the park after finishing their lunch.",
                            "target_lang_translations": {
                                "pl": "Po obiedzie postanowili <w>pospacerować</w> po parku.",
                                "ru": "После обеда они решили <w>прогуляться</w> по парку."
                            }
                        },
                        {
                            "text": "He would often <w>saunter</w> down the street to greet his neighbors.",
                            "target_lang_translations": {
                                "pl": "Często <w>przechadzał się</w> ulicą, by przywitać się z sąsiadami.",
                                "ru": "Он часто <w>неспешно прохаживался</w> по улице, чтобы поздороваться с соседями."
                            }
                        }
                    ],
                    "synonyms": [
                        "amble",
                        "stroll",
                        "ramble",
                        "wander"
                    ],
                    "common_phrases": [
                        "saunter along",
                        "saunter through"
                    ],
                    "target_lang_definitions": {
                        "pl": "Poruszać się powolnym, swobodnym lub nieformalnym krokiem.",
                        "ru": "Идти не спеша, расслабленной или непринуждённой походкой."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "spacerować",
                                "target_lang_sense_clarification": "chodzić w celu rekreacji, bez pośpiechu"
                            },
                            {
                                "target_lang_word": "przechadzać się",
                                "target_lang_sense_clarification": "odbywać spokojny spacer, często w celach relaksacyjnych"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "прогуливаться",
                                "target_lang_sense_clarification": "идти неторопливо, ради отдыха"
                            },
                            {
                                "target_lang_word": "прохаживаться",
                                "target_lang_sense_clarification": "неспешно ходить взад и вперёд"
                            },
                            {
                                "target_lang_word": "фланировать",
                                "target_lang_sense_clarification": "гулять без цели, от нечего делать"
                            }
                        ]
                    }
                }
            ]
        },
        {
