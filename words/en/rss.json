    "entries": [
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "52b56de9-0370-3427-b531-fb24a9365600",
                    "sense_definition": "A standardized web feed format used to publish frequently updated works, such as blog entries, news headlines, or podcasts.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "technology_or_software_name",
                    "examples": [
                        {
                            "text": "You can subscribe to the blog using an <w>RSS</w> feed.",
                            "target_lang_translations": {
                                "zh": "你可以使用 <w>RSS</w> 供稿订阅该博客。"
                            }
                        },
                        {
                            "text": "Many readers still prefer to receive news updates through <w>RSS</w>.",
                            "target_lang_translations": {
                                "zh": "许多读者仍然更喜欢通过 <w>RSS</w> 接收新闻更新。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "RSS feed",
                        "RSS reader"
                    ],
                    "target_lang_definitions": {
                        "zh": "简易信息聚合；一种标准化的网络供稿格式，用于发布经常更新的内容（如博客文章、新闻标题或播客）。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "RSS",
                                "target_lang_sense_clarification": "网络供稿格式"
                            },
                            {
                                "target_lang_word": "简易信息聚合",
                                "target_lang_sense_clarification": "网络内容订阅格式"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "26852a79-bb68-3d0f-b1fc-7af4665b15a9",
                    "sense_definition": "An Indian right-wing, Hindu nationalist volunteer paramilitary organisation (Rashtriya Swayamsevak Sangh).",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "organization_name",
                    "examples": [
                        {
                            "text": "Several prominent politicians began their public careers as members of the <w>RSS</w>.",
                            "target_lang_translations": {
                                "zh": "几位著名的政界人士最初都是作为<w>国民志愿服务团</w>的成员开启其公众生涯的。"
                            }
                        },
                        {
                            "text": "The <w>RSS</w> holds daily gatherings across many Indian towns and cities.",
                            "target_lang_translations": {
                                "zh": "<w>国民志愿服务团</w>在印度的许多城镇每天都会举行集会。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "国民志愿服务团；印度右翼印度教民族主义准军事志愿组织。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "国民志愿服务团",
                                "target_lang_sense_clarification": "印度政治与宗教组织"
                            },
                            {
                                "target_lang_word": "RSS",
                                "target_lang_sense_clarification": "印度国民志愿服务团简称"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "45f6dda5-2274-3a13-8a3e-bc03fba75295",
                    "sense_definition": "RDF Site Summary, an early Resource Description Framework dialect used for web syndication.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "technology_or_software_name",
                    "examples": [
                        {
                            "text": "The original specification was created under the name <w>RSS</w> to stand for RDF Site Summary.",
                            "target_lang_translations": {
                                "zh": "最初的规范以 <w>RSS</w> 为名创立，代表 RDF 站点摘要。"
                            }
                        },
                        {
                            "text": "Technologists debated the exact format requirements when <w>RSS</w> was first introduced.",
                            "target_lang_translations": {
                                "zh": "在 <w>RSS</w> 刚推出时，技术专家们就确切的格式要求展开了争论。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "资源描述框架站点摘要；一种用于网络内容整合的早期RDF方言。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "RDF站点摘要",
                                "target_lang_sense_clarification": "早期网络联合技术规范"
                            },
                            {
                                "target_lang_word": "RSS",
                                "target_lang_sense_clarification": "RDF Site Summary 缩写"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "17ac3dea-0187-311d-bb5f-1b74f900b216",
                    "sense_definition": "Republic of Singapore Ship; the ship prefix used for naval vessels belonging to the Republic of Singapore Navy.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "title_or_honorific_name",
                    "examples": [
                        {
                            "text": "The vessel was formally designated as <w>RSS</w> Endurance before setting sail.",
                            "target_lang_translations": {
                                "zh": "该舰在起航前被正式命名为<w>新加坡共和国舰艇</w>“坚韧”号。"
                            }
                        },
                        {
                            "text": "Officers gathered on deck aboard the <w>RSS</w> Stalwart during the joint naval exercise.",
                            "target_lang_translations": {
                                "zh": "在联合海军演习期间，军官们聚集在<w>新加坡共和国舰艇</w>“坚毅”号的甲板上。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "新加坡共和国舰艇；新加坡共和国海军舰艇的前缀头衔。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "新加坡共和国舰艇",
                                "target_lang_sense_clarification": "新加坡海军舰艇前缀"
                            },
                            {
                                "target_lang_word": "RSS",
                                "target_lang_sense_clarification": "舰名前缀缩写"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a2ecc02b-385a-3825-b6ec-1c4f2b4a60d4",
                    "sense_definition": "Residual sum of squares; a measure of the discrepancy between data and an estimation model in statistics.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A lower <w>RSS</w> indicates a better fit between the regression model and the observations.",
                            "target_lang_translations": {
                                "zh": "更低的<w>残差平方和</w>表明回归模型与观测数据之间的拟合度更好。"
                            }
                        },
                        {
                            "text": "The algorithm minimizes the <w>RSS</w> to find optimal regression coefficients.",
                            "target_lang_translations": {
                                "zh": "该算法通过最小化<w>残差平方和</w>来寻找最优回归系数。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "残差平方和；统计学中用于衡量数据与估计模型之间偏差的指标。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "残差平方和",
                                "target_lang_sense_clarification": "统计学指标"
                            },
                            {
                                "target_lang_word": "RSS",
                                "target_lang_sense_clarification": "统计学术语缩写"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e8844043-a165-3956-b261-2c278d66d535",
                    "sense_definition": "Rapid response system; a clinical system designed to identify deteriorating hospital patients and intervene promptly.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hospital implemented an <w>RSS</w> to reduce preventable cardiac arrests on inpatient wards.",
                            "target_lang_translations": {
                                "zh": "该医院建立了一套<w>快速反应系统</w>，以减少住院病房中本可预防的心脏骤停事件。"
                            }
                        },
                        {
                            "text": "Nurses activated the <w>RSS</w> as soon as the patient showed signs of sepsis.",
                            "target_lang_translations": {
                                "zh": "患者一出现脓毒症迹象，护士便启动了<w>快速反应系统</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "快速反应系统；一种旨在识别医院患者病情恶化并迅速进行干预的临床系统。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "快速反应系统",
                                "target_lang_sense_clarification": "医疗救治系统"
                            },
                            {
                                "target_lang_word": "RSS",
                                "target_lang_sense_clarification": "医疗快速反应系统缩写"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "90619caf-59ba-38e8-8b3a-60787a77d4d5",
                    "sense_definition": "Range safety system; a system configured to terminate rocket flight safely in the event of an anomaly.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If the launch vehicle veers off course, the <w>RSS</w> is triggered automatically.",
                            "target_lang_translations": {
                                "zh": "如果运载火箭偏离轨道，<w>靶场安全系统</w>将自动触发。"
                            }
                        },
                        {
                            "text": "Technicians thoroughly tested every component of the <w>RSS</w> before the rocket launch.",
                            "target_lang_translations": {
                                "zh": "技术人员在火箭发射前彻底测试了<w>靶场安全系统</w>的每一个组件。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "靶场安全系统；一种在火箭飞行发生异常时安全终止飞行的安全保障系统。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "靶场安全系统",
                                "target_lang_sense_clarification": "航天与火箭安全系统"
                            },
                            {
                                "target_lang_word": "RSS",
                                "target_lang_sense_clarification": "靶场安全系统缩写"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a42aabf6-4dfb-3b79-b041-7c96fa42b23e",
                    "sense_definition": "Reusable spaceship; a spacecraft designed to make multiple spaceflights rather than being discarded.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Developing an efficient <w>RSS</w> could dramatically cut the overall cost of space travel.",
                            "target_lang_translations": {
                                "zh": "研发高效的<w>可重复使用宇宙飞船</w>可以大幅降低太空旅行的总体成本。"
                            }
                        },
                        {
                            "text": "The space agency hopes the new <w>RSS</w> will perform over fifty missions safely.",
                            "target_lang_translations": {
                                "zh": "航天机构希望这种新型<w>可重复使用航天器</w>能够安全执行五十多次任务。"
                            }
