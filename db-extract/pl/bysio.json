                        "examples": [
                            {
                                "example_id": "04087c33-f1c9-4d85-a10b-421fc21f12ad",
                                "sense_id": "3ab7aa36-dcfd-3a04-b406-face804d4900",
                                "text": "Kiedy przyszedł sąsiad, wszystko poszło błyskawicznie. Po chwili na ściółce leżał śliczny, brązowo-biały byczek. Ludzie dostali zakaz wstępu do chlewni. Siedziałem i patrzyłem, jak bysio próbuje stawiać pierwsze kroki, jak sam z siebie zaczyna ssać."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
