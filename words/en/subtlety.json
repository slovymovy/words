{
    "word_family": [
        "subtle",
        "subtly"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9ff4abe5-7d0d-32b3-9323-a0e72bb43702",
                    "sense_definition": "The quality of being difficult to notice or describe because it is very delicate or faint.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>subtlety</w> of the painting's colors makes it look very realistic.",
                            "target_lang_translations": {
                                "ru": "<w>Тонкость</w> цветовой гаммы картины делает её очень реалистичной."
                            }
                        },
                        {
                            "text": "He appreciated the <w>subtlety</w> of the perfume, which was barely noticeable.",
                            "target_lang_translations": {
                                "ru": "Он оценил <w>тонкость</w> аромата духов, который был едва заметен."
                            }
                        }
                    ],
                    "synonyms": [
                        "nuance",
                        "refinement"
                    ],
                    "target_lang_definitions": {
                        "ru": "Качество чего-либо, что трудно заметить или описать из-за его деликатности или едва уловимого характера."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тонкость",
                                "target_lang_sense_clarification": "свойство чего-то едва уловимого, деликатного"
                            },
                            {
                                "target_lang_word": "утончённость",
                                "target_lang_sense_clarification": "изящество и деликатность в проявлениях"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a1653b42-1e5b-3841-bbc3-383e3edae91b",
                    "sense_definition": "A small, fine detail or a complex point that is hard to understand.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "detail",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It takes time to learn all the <w>subtleties</w> of the English language.",
                            "target_lang_translations": {
                                "ru": "Требуется время, чтобы изучить все <w>тонкости</w> английского языка."
                            }
                        },
                        {
                            "text": "The lawyer explained the legal <w>subtleties</w> of the contract to his client.",
                            "target_lang_translations": {
                                "ru": "Адвокат объяснил клиенту юридические <w>тонкости</w> контракта."
                            }
                        }
                    ],
                    "synonyms": [
                        "nicety",
                        "nuance"
                    ],
                    "target_lang_definitions": {
                        "ru": "Мелкая, трудноуловимая деталь или сложный нюанс, который трудно понять."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тонкость",
                                "target_lang_sense_clarification": "мелкая подробность или частная сторона вопроса"
                            },
                            {
                                "target_lang_word": "нюанс",
                                "target_lang_sense_clarification": "оттенок смысла или мелкая деталь"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6a42c4fd-ac39-3c4c-a7b3-52f90f722202",
                    "sense_definition": "The ability to achieve goals using clever, indirect, or delicate methods.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "skill",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She handled the difficult negotiation with great <w>subtlety</w>.",
                            "target_lang_translations": {
                                "ru": "Она провела сложные переговоры с большой <w>деликатностью</w>."
                            }
                        },
                        {
                            "text": "He used <w>subtlety</w> to convince his boss without making a direct request.",
                            "target_lang_translations": {
                                "ru": "Он проявил <w>искусность</w>, чтобы убедить начальника, не делая прямой просьбы."
                            }
                        }
                    ],
                    "synonyms": [
                        "finesse",
                        "discretion",
                        "savoir-faire"
                    ],
                    "target_lang_definitions": {
                        "ru": "Способность достигать целей с помощью умных, косвенных или деликатных методов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "деликатность",
                                "target_lang_sense_clarification": "тактичность и осторожность в действиях"
                            },
                            {
                                "target_lang_word": "искусность",
                                "target_lang_sense_clarification": "умение действовать ловко и тонко"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7d72c197-a0ae-33cd-8a9a-e84b0e1064d6",
                    "sense_definition": "The quality of being clever in a deceitful or dishonest way.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "deception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The criminal used <w>subtlety</w> to trick the guards and escape.",
                            "target_lang_translations": {
                                "ru": "Преступник использовал <w>хитрость</w>, чтобы обмануть охранников и сбежать."
                            }
                        },
                        {
                            "text": "His <w>subtlety</w> in manipulating the facts was truly impressive.",
                            "target_lang_translations": {
                                "ru": "Его <w>лукавство</w> при манипулировании фактами было поистине впечатляющим."
                            }
                        }
                    ],
                    "synonyms": [
                        "cunning",
                        "artifice",
                        "deceitfulness"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Often used in older texts to describe cunning or craftiness."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Качество проявления хитрости в обманной или нечестной манере."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хитрость",
                                "target_lang_sense_clarification": "способность к обману или лукавству"
                            },
                            {
                                "target_lang_word": "лукавство",
                                "target_lang_sense_clarification": "неискренность, скрытая за внешней мягкостью"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}