                    "sense_definition": "Een plant met groene bladeren die vaak rauw gegeten wordt.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "lettuce_plant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik koop een verse krop <w>sla</w> op de markt.",
                            "target_lang_translations": {
                                "en": "I buy a fresh head of <w>lettuce</w> at the market.",
                                "ru": "Я покупаю свежий кочан <w>салата</w> на рынке.",
                                "pl": "Kupuję świeżą główkę <w>sałaty</w> na targu.",
                                "de": "Ich kaufe einen frischen Kopf <w>Salat</w> auf dem Markt.",
                                "fr": "J'achète une <w>laitue</w> fraîche au marché.",
                                "it": "Compro un cespo di <w>lattuga</w> fresco al mercato.",
                                "cs": "Kupuji na trhu čerstvou hlávku <w>salátu</w>.",
                                "tr": "Pazardan taze bir baş <w>marul</w> alıyorum.",
                                "es": "Compro una cabeza de <w>lechuga</w> fresca en el mercado."
                            }
                        },
                        {
                            "text": "Doe jij een blaadje <w>sla</w> op je broodje kaas?",
                            "target_lang_translations": {
                                "en": "Are you putting a leaf of <w>lettuce</w> on your cheese sandwich?",
                                "ru": "Ты кладешь листик <w>салата</w> на свой бутерброд с сыром?",
                                "pl": "Kładziesz liść <w>sałaty</w> na kanapkę z serem?",
                                "de": "Legst du ein Blatt <w>Salat</w> auf dein Käsebrötchen?",
                                "fr": "Mets-tu une feuille de <w>salade</w> sur ton sandwich au fromage ?",
                                "it": "Metti una foglia di <w>insalata</w> sul tuo panino al formaggio?",
                                "cs": "Dáváš si list <w>salátu</w> na svůj chleba se sýrem?",
                                "tr": "Peynirli sandviçine bir <w>marul</w> yaprağı koyuyor musun?",
                                "es": "¿Le pones una hoja de <w>lechuga</w> a tu sándwich de queso?"
                            }
                        }
                    ],
                    "common_phrases": [
                        "krop sla",
                        "blaadje sla",
                        "verse sla"
