                "senses": [
                    {
                        "sense_id": "ff29b854-0700-3e4f-ba7b-d4926c67d274",
                        "entry_id": "0f6a7a0e-ec69-3a6b-84c5-5be74e06bccb",
                        "glosses": [
                            "Poche de pantalon située à l’arrière au niveau du fessier."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b3635a55-474e-4d41-b2af-9955823a9ab0",
                                "sense_id": "ff29b854-0700-3e4f-ba7b-d4926c67d274",
                                "text": "Un peu à l’écart, la pensée ailleurs, Paul Morand, le buste en avant, les mains aux hanches dans ses poches-revolver, comme le héros de L’Homme pressé, paraissait attendre le signal d’un starter invisible."
                            },
                            {
                                "example_id": "f4c2abb4-eda6-437b-bd36-8a6453507e18",
                                "sense_id": "ff29b854-0700-3e4f-ba7b-d4926c67d274",
                                "text": "Oui, les pantalons aussi, parce qu’il y a des hommes qui mettent leur portefeuille dans leur poche-revolver."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "667fd7fa-edee-4103-8731-372fc048853d",
                        "source_entry_id": "0f6a7a0e-ec69-3a6b-84c5-5be74e06bccb",
                        "source_sense_id": "ff29b854-0700-3e4f-ba7b-d4926c67d274",
                        "target_lang_word": "Gesäßtasche",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gesäßtasche",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1f6ee877-b1ba-30e0-9d7d-87fbf53949ed",
                                        "entry_id": "ee51612c-764e-3ad5-96ca-2b49a1b15233",
                                        "glosses": [
                                            "Tasche, die auf der Rückseite einer Hose angebracht ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "94ad7927-9170-4aa4-aeca-1042704da33d",
                                                "sense_id": "1f6ee877-b1ba-30e0-9d7d-87fbf53949ed",
                                                "text": "„Dann wollte der Däne, der Jørgensen hieß, ihnen ein Foto zeigen, und es kostete ihn einige Mühe, bis er die Brieftasche aus der Gesäßtasche gezogen und ein abgegriffenes und zerkratztes Bild herausgeholt hatte.“"
                                            },
                                            {
                                                "example_id": "314f5c55-5248-4bcf-ae32-51979b43564b",
                                                "sense_id": "1f6ee877-b1ba-30e0-9d7d-87fbf53949ed",
                                                "text": "„Der Mann räuspert sich, spuckt aus, greift in die Gesäßtasche und fischt eine flache Plastikdose heraus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cf958056-f18c-4fb0-b9f3-24f22a8986a2",
                        "source_entry_id": "0f6a7a0e-ec69-3a6b-84c5-5be74e06bccb",
                        "source_sense_id": "ff29b854-0700-3e4f-ba7b-d4926c67d274",
