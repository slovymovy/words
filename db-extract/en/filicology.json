                        "glosses": [
                            "The botanical study of ferns."
                        ],
                        "tags": [
                            "rare",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "136937a1-5a27-414c-b8e6-770b4aaebc83",
                                "sense_id": "677b084b-2a30-3f61-a725-bcfbbd4f0922",
                                "text": "‡ Filicology.—That part of Botany which treats of Ferns."
                            },
                            {
                                "example_id": "ae5e0d94-acda-455c-9e67-11ed3dbf71df",
                                "sense_id": "677b084b-2a30-3f61-a725-bcfbbd4f0922",
                                "text": "I think the same plan might be pursued in general Botany, with a good effect; but it is of far greater importance in Filicology, as so many of this class of plants may be recognized by their external form alone."
                            },
                            {
                                "example_id": "dceaec45-1d60-4e66-bc4e-46c8cba5fdd2",
                                "sense_id": "677b084b-2a30-3f61-a725-bcfbbd4f0922",
                                "text": "The mode of ramification of the veins or nerves of the leaves is important in systematic Filicology, and may be observed for such purposes by immersing the dried leaflets in turpentine or oil, or mounting them in Canada balsam."
                            },
                            {
                                "example_id": "056df74c-9aa5-4c64-aff8-ee05a1123ba4",
                                "sense_id": "677b084b-2a30-3f61-a725-bcfbbd4f0922",
                                "text": "In the succeeding three years, [Howard] Palmer kept at it, generally in company with two vigorous companions, Edward Willett Dorland Holway, […] and Frederick King Butters, a younger associate in filicology at the same school [the University of Minnesota]."
                            }
                        ]
                    }
