                ],
                "senses": [
                    {
                        "sense_id": "c7e073fd-7d32-3f81-a6e2-699a20dce409",
                        "entry_id": "012d5fbf-b51a-3d2e-84db-e290d86d51e6",
                        "glosses": [
                            "Gegenstand aus Eisen, um etwas durch Kratzen zu entfernen; Gerät zum Entfernen von Schmutz an den Schuhsohlen"
                        ],
                        "tags": [
                            "auch",
                            "genauer"
                        ],
                        "examples": [
                            {
                                "example_id": "c84d3dc4-9f67-4621-ae23-24c65986baa5",
                                "sense_id": "c7e073fd-7d32-3f81-a6e2-699a20dce409",
                                "text": "„Mit Kratzeisen schabten die einen den Rumpf ab und befreiten die Planken von Moos, Algen und Muscheln.“"
                            },
                            {
                                "example_id": "61678052-ccc4-4cab-a30c-72712f6622b4",
                                "sense_id": "c7e073fd-7d32-3f81-a6e2-699a20dce409",
                                "text": "„Das Trichterauskratzen oder Ausbohren geschieht in der Maschinenformerei meist mit einem sogenannten Kratzeisen.“"
                            },
                            {
                                "example_id": "7b8f7c82-c3c4-4861-b7e7-42839eb79a26",
                                "sense_id": "c7e073fd-7d32-3f81-a6e2-699a20dce409",
                                "text": "„Die Bürsten und die Kratzeisen und die Strohdecken sind nun nichts mehr nutz; sie treten sich nur die Füße ab, wenn sie ungeduldig sind aufs Essen.“"
                            },
                            {
                                "example_id": "1e3ca07e-e921-4071-af61-f5bbf9d1cece",
                                "sense_id": "c7e073fd-7d32-3f81-a6e2-699a20dce409",
                                "text": "„Ich bekam einen dunkelgrünen schweren Schäferumhang, eine schwarze Filzkappe und einen langen Holzstecken mit einem Kratzeisen am Ende.“"
                            },
                            {
                                "example_id": "ef542bf9-8f5a-4d3c-93de-604c210caf67",
                                "sense_id": "c7e073fd-7d32-3f81-a6e2-699a20dce409",
                                "text": "„Er hatte nämlich nicht nur Farbe und Pinsel dabei, er hatte auch Kratzeisen, Schmirgelpapier und Silberputzzeug mitgebracht.“"
                            },
                            {
                                "example_id": "da1ad6cf-97e3-4737-8e03-41d69dc94726",
                                "sense_id": "c7e073fd-7d32-3f81-a6e2-699a20dce409",
                                "text": "„Um den abzukriegen, mußte man mit einer Schüssel Wasser und einem Kratzeisen hineinkriechen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
