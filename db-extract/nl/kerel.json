                "senses": [
                    {
                        "sense_id": "cfff3179-1b09-3086-8da6-6683b97202c7",
                        "entry_id": "954f1f90-23e8-306c-b05c-a21222b70f5c",
                        "glosses": [
                            "vrije man van lage geboorte"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "d7cf6261-d8db-3a46-aed9-5c4c47319930",
                        "entry_id": "954f1f90-23e8-306c-b05c-a21222b70f5c",
                        "glosses": [
                            "forse, stevige man (een echte vent)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ad8cb33-fdc2-47e3-bc5b-4db9c3fd9b78",
                                "sense_id": "d7cf6261-d8db-3a46-aed9-5c4c47319930",
                                "text": "Een brede kerel kwam het pad oplopen met twee grote emmers water in zijn handen."
                            },
                            {
                                "example_id": "655e8ac3-9a3b-460a-a909-1e9e703d7e9e",
                                "sense_id": "d7cf6261-d8db-3a46-aed9-5c4c47319930",
                                "text": "Ze waren de onbetwiste heerseressen van de barakken en hielden zonder problemen een twintigtal kerels onder de duim, hoe naar liefde snakkend die zich ook konden gedragen na meerdere maanden in de bergen."
                            }
                        ]
                    },
                    {
                        "sense_id": "08ef95a8-cf66-34d3-b640-8abeb6c201d5",
                        "entry_id": "954f1f90-23e8-306c-b05c-a21222b70f5c",
                        "glosses": [
                            "man, echtgenoot"
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "e997fdc0-6b10-3f70-b70b-a23ea9da5d90",
                        "entry_id": "954f1f90-23e8-306c-b05c-a21222b70f5c",
                        "glosses": [
                            "mannelijk persoon"
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "191e2312-d3b0-4977-bbca-5c297e279ef2",
                                "sense_id": "e997fdc0-6b10-3f70-b70b-a23ea9da5d90",
                                "text": "Hier was duidelijk het verschil in leeftijd te zien: jonge kerels willen alles uitproberen, hoe gevaarlijker hoe beter."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "40fb47f2-af98-4df2-8259-277484e37fef",
                        "source_entry_id": "954f1f90-23e8-306c-b05c-a21222b70f5c",
                        "target_lang_word": "Kerl",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kerl",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "30a61338-af3c-3372-b937-7e3e9dc03973",
                                        "entry_id": "5273b05d-4a7d-3e1e-a6ba-3be159b7faae",
                                        "glosses": [
                                            "eine (meistens männliche) Person (Dieser Begriff kann sowohl eine positive als auch eine negative Konnotation tragen je nach Eigenschaft der Männlichkeit, die angesprochen wird.)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "167a0450-b4c1-43df-94d2-386591da20ed",
                                                "sense_id": "30a61338-af3c-3372-b937-7e3e9dc03973",
                                                "text": "Letztens spricht doch so ein Kerl in der Kneipe meine Freundin an."
                                            },
                                            {
                                                "example_id": "86988a84-4437-4d3f-a8a5-73b1b1c1cca6",
                                                "sense_id": "30a61338-af3c-3372-b937-7e3e9dc03973",
                                                "text": "„Unten am Hafen stehen zwei alte Kerle mit einer Angelrute und fangen Fische.“"
                                            },
                                            {
                                                "example_id": "156ec4dd-b0b8-4b3f-b0eb-cb73c59e1c19",
                                                "sense_id": "30a61338-af3c-3372-b937-7e3e9dc03973",
                                                "text": "„Claudia hat mich zurückgenommen, sie ist ein guter Kerl, Ritchie tat auch ganz erfreut.“"
                                            },
                                            {
                                                "example_id": "3be2bd7a-d0d2-4ebf-b803-b6763aeb63ac",
                                                "sense_id": "30a61338-af3c-3372-b937-7e3e9dc03973",
                                                "text": "„Der Kerl wartete, bis sein Drink kam.“"
                                            },
                                            {
                                                "example_id": "47248036-2381-4444-8c03-6e0208fc8dc6",
                                                "sense_id": "30a61338-af3c-3372-b937-7e3e9dc03973",
                                                "text": "„Sie war einfach ein feiner Kerl.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6a76d02d-1671-4dbc-a517-74d8af517fed",
                        "source_entry_id": "954f1f90-23e8-306c-b05c-a21222b70f5c",
                        "target_lang_word": "mec",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mec",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "29f6634d-2dad-329e-81ab-7740a8adf4e1",
                                        "entry_id": "54155264-5181-3d7b-bd18-9ddcd4d24354",
                                        "glosses": [
                                            "Individu de sexe ou genre masculin."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d7a1a655-2784-4bbf-add1-c4d66773bbe5",
                                                "sense_id": "29f6634d-2dad-329e-81ab-7740a8adf4e1",
                                                "text": "Tu es dans un monde de mecs, ici. Et dans le monde des mecs, il y a des bouquins de cul et bien d'autres choses, parfois même des femmes. Mais jamais longtemps."
                                            },
                                            {
                                                "example_id": "48e3f993-7476-488d-904e-e5a339a1bfc0",
                                                "sense_id": "29f6634d-2dad-329e-81ab-7740a8adf4e1",
                                                "text": "Un mec qui sait échanger par textos, moi, je trouve ça hyperséduisant."
                                            },
                                            {
                                                "example_id": "571bbbfa-4e72-4f36-808f-fa3304a132f7",
                                                "sense_id": "29f6634d-2dad-329e-81ab-7740a8adf4e1",
                                                "text": "Moi j’en ai rien à foutre d’être quelqu’un. Je suis un mec sans ambition."
                                            },
                                            {
                                                "example_id": "6e7258a1-88a4-4ebd-8008-52c391f347b3",
                                                "sense_id": "29f6634d-2dad-329e-81ab-7740a8adf4e1",
                                                "text": "L’odeur lui rappelle la fumerie de crack qui s’est montée l’année précédente dans une des tours de la cité, un souk d’enfer, plein de mecs à moitié morts […]."
                                            },
                                            {
                                                "example_id": "32eb7442-c624-497e-bf30-87c9f90d2ebe",
                                                "sense_id": "29f6634d-2dad-329e-81ab-7740a8adf4e1",
                                                "text": "Le mec aux musettes, il s’était crevé comme une grenade lui, c’est le cas de le dire, du cou jusqu’au milieu du pantalon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "146d850a-1096-3331-a300-fb5435b0a925",
                                        "entry_id": "54155264-5181-3d7b-bd18-9ddcd4d24354",
                                        "glosses": [
                                            "Homme d’un couple (s’utilise en général avec un possessif)."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6f0b6561-aba9-4795-b6ba-8b136df09fdb",
                                                "sense_id": "146d850a-1096-3331-a300-fb5435b0a925",
                                                "text": "Quand on rencontre un nouveau mec, c'est toujours tout beau, tout feu, tout flamme… et puis après quelques années, on commence à le voir tel qu'il est après deux gastros, un enfant et un crédit immo sur 20 ans."
                                            },
                                            {
                                                "example_id": "66ea7cbf-d3a9-44fc-946c-ea6cf51c5a61",
                                                "sense_id": "146d850a-1096-3331-a300-fb5435b0a925",
                                                "text": "Mon mec à moi\nIl me parle d’aventures\nEt quand elles brillent dans ses yeux\nJ’pourrais y passer la nuit."
                                            },
                                            {
                                                "example_id": "a93dd8b1-7bc0-4753-b5d7-85a98f738885",
                                                "sense_id": "146d850a-1096-3331-a300-fb5435b0a925",
                                                "text": "C'est l’histoire d’un mec… Vous la connaissez, non ?"
                                            },
                                            {
                                                "example_id": "02ee6fbd-84fe-4255-9083-8df77268f075",
                                                "sense_id": "146d850a-1096-3331-a300-fb5435b0a925",
                                                "text": "Les mecs ça sert qu’à envoyer leur teube en snap rouge"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d2e3b310-d277-3ba4-9d98-0663852f3f44",
                                        "entry_id": "54155264-5181-3d7b-bd18-9ddcd4d24354",
                                        "glosses": [
                                            "Homme énergique, chef."
                                        ],
                                        "tags": [
                                            "dated",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "98137fc0-9986-4cde-902e-91870ea07096",
                                                "sense_id": "d2e3b310-d277-3ba4-9d98-0663852f3f44",
                                                "text": "Le monde est plein de mecs. Ils mènent tout."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a0e27648-0348-3b62-b743-ec735ea719df",
                                        "entry_id": "54155264-5181-3d7b-bd18-9ddcd4d24354",
                                        "glosses": [
                                            "Souteneur ; maquereau."
                                        ],
                                        "tags": [
                                            "dated",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "538022bc-bbc1-4b32-abca-40e0a535d811",
                                                "sense_id": "a0e27648-0348-3b62-b743-ec735ea719df",
                                                "text": "Comme des faisans à la Bourse\nLes demi-sels se croient des mecs\nMektoub ! un jour ils l’auront sec."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3e87aade-3f49-3cf5-a937-e6e04a6d7065",
                                        "entry_id": "54155264-5181-3d7b-bd18-9ddcd4d24354",
                                        "glosses": [
                                            "Acronyme de « M.E.C. » signifiant « Mis En Cause » dans les procédures judiciaires effectuées par les gendarmes et les policiers dans leurs procès verbaux."
                                        ],
                                        "tags": [
                                            "Argot de la gendarmerie ou de la police"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "13fa33b5-7d66-4aaf-89e1-9d80ab8d1fdd",
                        "source_entry_id": "954f1f90-23e8-306c-b05c-a21222b70f5c",
                        "target_lang_word": "чувак",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "чувак",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "23d1c15b-4bd3-323e-a13d-42cbfde7d2ec",
                                        "entry_id": "5ed50e42-eefa-3133-a83a-0112669763af",
                                        "glosses": [
                                            "жарг. то же, что парень; лицо мужского пола"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15d3fa68-2387-4b29-a05d-4c8991385175",
                                                "sense_id": "23d1c15b-4bd3-323e-a13d-42cbfde7d2ec",
                                                "text": "— Кончай психовать, ― сказал Фрам, ― какие-то вы странные, чуваки!"
                                            },
                                            {
                                                "example_id": "892c4ab8-b136-485f-8a8b-3788295e48c3",
                                                "sense_id": "23d1c15b-4bd3-323e-a13d-42cbfde7d2ec",
                                                "text": "И как потом у каждого из них что-то не получилось, не удалось, и вот все они мало-помалу превратились в лабухов, усвоили легко тот музыкальный жаргон, который теперь так широко подхватили пижоны, ― и человека уже называют «чуваком», о своей игре говорят: «лабать», еда и выпивка для них «бирлянство» и «кирянство», а если играют на похоронах, то это удача, и покойник для них не покойник, а «жмурик»…"
                                            },
                                            {
                                                "example_id": "8bc81a61-dd83-4d76-ab78-941b56313cf8",
                                                "sense_id": "23d1c15b-4bd3-323e-a13d-42cbfde7d2ec",
                                                "text": "Подошёл какой-то чувак и поставил на стол несколько бутылок пива."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
