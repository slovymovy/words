                        "entry_id": "9853fbae-d71c-3f72-b55f-5772e59c078c",
                        "glosses": [
                            "Turned or thrust outwards, especially:",
                            "Of or characteristic of the personality of an extrovert: outgoing, sociable."
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "de08071d-f29d-44e8-a6fc-4c3971cc7c18",
                                "sense_id": "cba88813-6ef1-3639-b724-837278e09d80",
                                "text": "She's very extroverted. She's always out meeting new people and looking for new experiences."
                            },
                            {
                                "example_id": "7f207ed2-6aba-411f-a8ff-ba628ddf3f88",
                                "sense_id": "cba88813-6ef1-3639-b724-837278e09d80",
                                "text": "This subtle but important distinction means otroverts can blend into both introverted and extroverted environments without fully belonging to either."
                            }
                        ]
