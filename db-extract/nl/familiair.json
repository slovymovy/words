                "translations": [
                    {
                        "translation_id": "9cd60e71-8922-40b2-bf50-074fef39b26e",
                        "source_entry_id": "037f8e03-00d1-3922-8ee7-fb516f6f7a95",
                        "target_lang_word": "familiär",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "familiär",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "feded4bb-424c-3416-a0a7-f27580f53ad7",
                                        "entry_id": "026630a7-7f2a-3c7d-bda4-ffacd3550a97",
                                        "glosses": [
                                            "auf die Familie bezogen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab7bc8a3-be06-4b23-b9b7-5881b24338b7",
                                                "sense_id": "feded4bb-424c-3416-a0a7-f27580f53ad7",
                                                "text": "Karl hat wohl familiäre Sorgen, aber er wollte nichts Genaues sagen."
                                            },
                                            {
                                                "example_id": "9542d7d3-19bf-4824-b0ff-bc04305d25af",
                                                "sense_id": "feded4bb-424c-3416-a0a7-f27580f53ad7",
                                                "text": "„Berthold Otto ist Begründer des freien Gesamtunterrichts, den er neben dem üblichen Fachunterricht mit allen Jahrgängen seiner Schule gemeinsam in einer Stunde am Wochenende […] in Form einer familiären Unterhaltung pflegt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6b4e28b7-a70a-3a8e-bf5c-e512e12d96d9",
                                        "entry_id": "026630a7-7f2a-3c7d-bda4-ffacd3550a97",
                                        "glosses": [
                                            "auf Freundschaft fußend; ohne Zwang"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25a6ceae-93d2-47a1-a9a5-82639a68a102",
                                                "sense_id": "6b4e28b7-a70a-3a8e-bf5c-e512e12d96d9",
                                                "text": "„Die Atmosphäre ist familiär, Hierarchien gibt es nicht, selbst die Dozenten werden mit Vornamen angeredet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "8a25dc5e-97eb-31ee-9dd6-7da1f94be444",
                                        "entry_id": "026630a7-7f2a-3c7d-bda4-ffacd3550a97",
                                        "glosses": [
                                            "(allzu) intim, eng verbunden"
                                        ],
                                        "tags": [
                                            "auch abwertend"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c7437a62-7b90-47ae-b847-9b1607baa129",
                                                "sense_id": "8a25dc5e-97eb-31ee-9dd6-7da1f94be444",
                                                "text": "Dieses familiäre Benehmen wirkte auf mich unseriös."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "7d22d8d9-9885-3037-9a66-d2580d34190e",
                                        "entry_id": "026630a7-7f2a-3c7d-bda4-ffacd3550a97",
                                        "glosses": [
                                            "auf Worte oder Wendungen bezogen, die nur in einem von besonderer Vertrautheit gekennzeichneten Umfeld — also im engen Freundeskreis oder innerhalb der Familie — verwendet werden"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "70d04054-421e-4277-8b16-5980a223f8d9",
                        "source_entry_id": "037f8e03-00d1-3922-8ee7-fb516f6f7a95",
                        "target_lang_word": "familiar",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "familiar",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b5889e5b-fd3d-30c5-a943-300a70e47d10",
                                        "entry_id": "61707c59-7fe6-3fc9-b805-cc25bc7205d0",
                                        "glosses": [
                                            "Known to one, or generally known; commonplace."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea61d5be-f9be-487d-9565-1ab679e9ad9b",
                                                "sense_id": "b5889e5b-fd3d-30c5-a943-300a70e47d10",
                                                "text": "There’s a familiar face; that tune sounds familiar."
                                            },
                                            {
                                                "example_id": "9b8c136c-a2e8-4300-85ac-dc2c9e3f6166",
                                                "sense_id": "b5889e5b-fd3d-30c5-a943-300a70e47d10",
                                                "text": "The story struck the depressingly familiar note with which true stories ring in the tried ears of experienced policemen. No one queried it. It was in the classic pattern of human weakness, mean and embarrassing and sad."
                                            },
                                            {
                                                "example_id": "43f5b669-b924-4321-88f5-ec556c5bb4e7",
                                                "sense_id": "b5889e5b-fd3d-30c5-a943-300a70e47d10",
                                                "text": "Plastics are energy-rich substances, which is why many of them burn so readily. Any organism that could unlock and use that energy would do well in the Anthropocene. Terrestrial bacteria and fungi which can manage this trick are already familiar to experts in the field."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b9381e1c-8ae4-30c4-9373-59d782d7f448",
                                        "entry_id": "61707c59-7fe6-3fc9-b805-cc25bc7205d0",
                                        "glosses": [
                                            "Acquainted."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7358f58-cb78-4b2c-a834-ecc571906571",
                                                "sense_id": "b9381e1c-8ae4-30c4-9373-59d782d7f448",
                                                "text": "I'm quite familiar with this system; she's not familiar with manual gears."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e4a8f5ff-c7d7-3bf2-9425-0d8f700482ca",
                                        "entry_id": "61707c59-7fe6-3fc9-b805-cc25bc7205d0",
                                        "glosses": [
                                            "Intimate or friendly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6c650cc-ae1a-46a5-a032-7d14049f2eea",
                                                "sense_id": "e4a8f5ff-c7d7-3bf2-9425-0d8f700482ca",
                                                "text": "We are on familiar terms now; our neighbour is not familiar"
                                            },
                                            {
                                                "example_id": "3b7a238d-4729-459b-bc93-78d5b0b2bb4b",
                                                "sense_id": "e4a8f5ff-c7d7-3bf2-9425-0d8f700482ca",
                                                "text": "Don’t be familiar with me, boy!"
                                            },
                                            {
                                                "example_id": "b89131d1-1c71-4c66-b6ba-b1a9aefe22f3",
                                                "sense_id": "e4a8f5ff-c7d7-3bf2-9425-0d8f700482ca",
                                                "text": "Be thou familiar; but by no meanes vulgar:[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "03854025-e6b5-37cf-bc60-5573d3cb9ae4",
                                        "entry_id": "61707c59-7fe6-3fc9-b805-cc25bc7205d0",
                                        "glosses": [
                                            "Of or pertaining to a family; familial."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34f43461-5d88-4199-825f-4fa1aae2c7b0",
                                                "sense_id": "03854025-e6b5-37cf-bc60-5573d3cb9ae4",
                                                "text": "1822, Lord Byron, Werner\nfamiliar feuds"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "familiar",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d1233320-cf04-3ece-bffc-5156181fed63",
                                        "entry_id": "712cd33e-0e4e-337a-b9fa-3dc38c823c23",
                                        "glosses": [
                                            "An attendant spirit, often in animal or demon form."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa87ac3a-9bd4-428a-b18e-ef2437040230",
                                                "sense_id": "d1233320-cf04-3ece-bffc-5156181fed63",
                                                "text": "The witch’s familiar was a black cat."
                                            },
                                            {
                                                "example_id": "08e390de-932a-4d1a-97f7-726b36841c5a",
                                                "sense_id": "d1233320-cf04-3ece-bffc-5156181fed63",
                                                "text": "The familiars of the magicians, on the other hand, were not in all cases evil, and often may have approximated the \"guides\" with whom present-day spiritualists are well acquainted."
                                            },
                                            {
                                                "example_id": "c602072e-1d42-48ef-8038-44527a882244",
                                                "sense_id": "d1233320-cf04-3ece-bffc-5156181fed63",
                                                "text": "\"What power hath gold?\" Catweazle wondered as he picked up his familiar and put him in his special pocket."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eca9de30-dc3f-383e-b3e8-36914bd3ecec",
                                        "entry_id": "712cd33e-0e4e-337a-b9fa-3dc38c823c23",
                                        "glosses": [
                                            "A member of one's family or household."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7f7509c3-77f9-3bce-841c-20e5a0f60e8b",
                                        "entry_id": "712cd33e-0e4e-337a-b9fa-3dc38c823c23",
                                        "glosses": [
                                            "A member of a pope's or bishop's household."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d710bc53-f47c-3175-986e-8baa678020de",
                                        "entry_id": "712cd33e-0e4e-337a-b9fa-3dc38c823c23",
                                        "glosses": [
                                            "A close friend."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "220a3b48-1e7f-42b4-8495-88abbff76ec1",
                                                "sense_id": "d710bc53-f47c-3175-986e-8baa678020de",
                                                "text": "[A] friend of mine, that finding a Receipt in Braſsivola, would needs take Hellebor in ſubſtance, & try it on his own perſon; but had not ſome of his familiars come to viſite him by chance, he had by his indiſcretion hazarded himſelfe; many ſuch I have obſerued."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2480aa6b-3e30-3aca-946a-128d59af04c8",
                                        "entry_id": "712cd33e-0e4e-337a-b9fa-3dc38c823c23",
                                        "glosses": [
                                            "The officer of the Inquisition who arrested suspected people."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f31bc201-129a-41cc-8068-5836061cd2c1",
                        "source_entry_id": "037f8e03-00d1-3922-8ee7-fb516f6f7a95",
                        "target_lang_word": "familier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "familier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f8d8fb3d-7b86-303a-aa88-e2d0032b73f0",
                                        "entry_id": "f941184c-3b95-386f-bcf8-dfa428233811",
                                        "glosses": [
                                            "Qui est considéré comme appartenant à la famille."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4651b8f5-8fff-4d45-9ad3-f0c8652a1c7c",
                                                "sense_id": "f8d8fb3d-7b86-303a-aa88-e2d0032b73f0",
                                                "text": "Aucun animal familier n’est autorisé dans l’avion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "90cc30bc-777e-3ba8-9867-8c2270313d75",
                                        "entry_id": "f941184c-3b95-386f-bcf8-dfa428233811",
                                        "glosses": [
                                            "Qui vit dans l’intimité de quelqu’un."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb58cab2-29f8-4ec1-a19d-4909b4ba67e8",
                                                "sense_id": "90cc30bc-777e-3ba8-9867-8c2270313d75",
                                                "text": "Un ami familier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c53b767a-452c-320f-be6a-c3c4fe9bdd4b",
                                        "entry_id": "f941184c-3b95-386f-bcf8-dfa428233811",
                                        "glosses": [
                                            "Qui a rapport à l’intimité d’une personne avec une autre, en parlant des choses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "424e32d2-8e4e-43f7-a8fa-3a087338a998",
                                                "sense_id": "c53b767a-452c-320f-be6a-c3c4fe9bdd4b",
                                                "text": "Ils vivent dans un commerce familier. Avoir des relations familières avec quelqu’un. La conversation prit un tour plus familier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "85c16349-8859-3317-b0d9-0ac015422992",
                                        "entry_id": "f941184c-3b95-386f-bcf8-dfa428233811",
                                        "glosses": [
                                            "Qui se comporte librement à l’égard de quelqu’un, surtout en parlant des choses."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "46d4b5cf-6c53-43ca-b54a-f023256d8895",
                                                "sense_id": "85c16349-8859-3317-b0d9-0ac015422992",
                                                "text": "Vous devenez trop familier avec vos supérieurs."
                                            },
                                            {
                                                "example_id": "7b40cdfa-ec17-4368-be61-3f809c8744e2",
                                                "sense_id": "85c16349-8859-3317-b0d9-0ac015422992",
                                                "text": "Prendre un air, un ton familier."
                                            },
                                            {
                                                "example_id": "bfe3a81b-5ecb-4ea2-b2e4-5b21d64f16db",
                                                "sense_id": "85c16349-8859-3317-b0d9-0ac015422992",
                                                "text": "S’exprimer en termes familiers."
                                            },
                                            {
                                                "example_id": "2579e6c6-5149-4b8c-8cab-598b775947c7",
                                                "sense_id": "85c16349-8859-3317-b0d9-0ac015422992",
                                                "text": "Et puis presque sans transition, ni pause, quatre femmes pénétrèrent dans la pièce, fardées, mûres, charnues, du muscle et des bijoux, fortement familières.' — (Louis-Ferdinand Céline, Voyage au bout de la nuit, Denoël et Steele, Paris, 1932 (réédition Gallimard, Folio #28, 2019, page 265)"
                                            },
                                            {
                                                "example_id": "dfc491fb-5b84-4a44-9e62-e1fdd7eee683",
                                                "sense_id": "85c16349-8859-3317-b0d9-0ac015422992",
                                                "text": "Je pensai que j’avais été trop aimable ou familière avec Adam Johnson et je rédigeai un texte froid et distant : […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "18654451-e1ae-36ef-b769-d072b550a36a",
                                        "entry_id": "f941184c-3b95-386f-bcf8-dfa428233811",
                                        "glosses": [
                                            "Qui est devenu facile, aisé, par la pratique, l’habitude."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "91502c7c-6add-4e34-a5f9-726844da365d",
                                                "sense_id": "18654451-e1ae-36ef-b769-d072b550a36a",
                                                "text": "Le débarquement d’une automobile à quai était une manœuvre peu familière aux employés de la petite station, et le train s’attardait, et Psyché devenait impatiente."
                                            },
                                            {
                                                "example_id": "f03f8921-f89a-4469-a252-b580448cca8c",
                                                "sense_id": "18654451-e1ae-36ef-b769-d072b550a36a",
                                                "text": "Il se plongeait dans l’aridité des études financières, le jargon des affaires, la jonglerie des chiffres et, lentement, ces choses, hier hermétiques, lui devenaient familières."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1f0fd3ef-ede9-3a20-93f5-58c40fb8fdda",
                                        "entry_id": "f941184c-3b95-386f-bcf8-dfa428233811",
                                        "glosses": [
                                            "Qualifie les choses devenues ordinaires ou habituelles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05cfb053-dea7-47c1-a768-22d0218f059a",
                                                "sense_id": "1f0fd3ef-ede9-3a20-93f5-58c40fb8fdda",
                                                "text": "Elles accomplissaient des tâches qui leur étaient a priori familières : elles nettoyaient le riz, pilaient l'igname et moulaient le maïs. Elles travaillaient aussi comme cuisinières, […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5147776a-f9d7-3a0a-b8c3-694bde1d4c18",
                                        "entry_id": "f941184c-3b95-386f-bcf8-dfa428233811",
                                        "glosses": [
                                            "Qualifie les choses que l’on reconnaît aisément pour les avoir vues souvent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9dfe30af-bf17-49a0-8965-98a940574063",
                                                "sense_id": "5147776a-f9d7-3a0a-b8c3-694bde1d4c18",
                                                "text": "Du lit nuptial au bobinard, il n’y eut alors qu’un pas que les péripatéticiennes vénitiennes familières du Ponte delle Tette, le pont des Tétons, eurent vite fait de franchir, boulottant du tiramisu pour se donner du nerf à l’ouvrage, tout comme leurs clients, soucieux de « tirer vers le haut » ce qui tendait à fléchir…"
                                            },
                                            {
                                                "example_id": "e7d7f25a-7ce9-41f1-a9da-a289d990b972",
                                                "sense_id": "5147776a-f9d7-3a0a-b8c3-694bde1d4c18",
                                                "text": "Cette figure m’est familière. Ces notions lui sont familières. Tout m’est familier dans cette ville, les choses et les gens."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "81b03533-fd8a-35e1-916f-bfdb1ae542a8",
                                        "entry_id": "f941184c-3b95-386f-bcf8-dfa428233811",
                                        "glosses": [
                                            "Qui se dit dans la conversation, qui ne convient qu’à la conversation, en parlant de la langue parlée, par opposition à la langue écrite."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9c59d3af-01a7-40be-8853-4e633e746618",
                                                "sense_id": "81b03533-fd8a-35e1-916f-bfdb1ae542a8",
                                                "text": "Elle est pleine : terme assez familier je vous l'accorde, pour dire que la patiente est en occlusion intestinale, comprenez de façon très grossière que le caca est québlo. D'accord d'accord, je rectifie avant que mon éditrice ne me gronde : le transit intestinal étant à l'arrêt complet, les selles ne peuvent plus s'évacuer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c6180c2b-7c4d-30d5-b526-72ce07f51b52",
                                        "entry_id": "f941184c-3b95-386f-bcf8-dfa428233811",
                                        "glosses": [
                                            "Qui est de la famille."
                                        ],
                                        "tags": [
                                            "dated",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "048bf3c7-1eed-43b6-a2d5-dd6add54d339",
                                                "sense_id": "c6180c2b-7c4d-30d5-b526-72ce07f51b52",
                                                "text": "Note : Il n’a plus ce sens que dans les expressions les dieux familiers des anciens et démon, génie familier."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "familier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0c3008d9-1c89-3ac5-b031-c515369bba8f",
                                        "entry_id": "0abd7ac8-3992-38e9-8848-68377ea9d6a7",
                                        "glosses": [
                                            "Personne très proche dans ses habitudes et ses fréquentations."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96c342db-2c0a-4af4-90d9-2e1d4cc21475",
                                                "sense_id": "0c3008d9-1c89-3ac5-b031-c515369bba8f",
                                                "text": "C’est un familier du président."
                                            },
                                            {
                                                "example_id": "598fa270-e991-435e-ba2a-d15c5689b1ad",
                                                "sense_id": "0c3008d9-1c89-3ac5-b031-c515369bba8f",
                                                "text": "Les familiers du club bénéficieront du voyage."
                                            },
                                            {
                                                "example_id": "d2b9130e-3fc9-42f9-9996-e24f5f32b681",
                                                "sense_id": "0c3008d9-1c89-3ac5-b031-c515369bba8f",
                                                "text": "Fait trop souvent oublié, Stravinski a fréquenté quelques-uns des plus fameux écrivains de son temps. Au cours de son séjour américain, il fut un familier d’Aldous Huxley, de T. S. Eliot, de l’intelligentsia anglo-saxonne."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "familier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b2be3d98-51de-3119-a50d-0f6a449eedcf",
                                        "entry_id": "2350376b-1449-390d-ba6d-dff5f4001665",
                                        "glosses": [
                                            "Créature supposée entretenir un rapport mystique avec un magicien ou sorcier."
                                        ],
                                        "tags": [
                                            "Fantastique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7f227227-55c9-4705-b4a7-a349c6a77a95",
                                                "sense_id": "b2be3d98-51de-3119-a50d-0f6a449eedcf",
                                                "text": "Le magicien peut, en se concentrant, voir à travers les yeux de son familier ; en contrepartie, il partage également la douleur que son familier ressent."
                                            }
                                        ]
                                    }
                                ]
                            }
