                "senses": [
                    {
                        "sense_id": "7d5ede16-df1c-3ed2-a28a-98cd14b0d19d",
                        "entry_id": "f40a829b-bfaa-387c-beea-bdd03bfa134b",
                        "glosses": [
                            "Humifier à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8579fdf9-de85-4611-b1bd-9ac03ec29eda",
                                "sense_id": "7d5ede16-df1c-3ed2-a28a-98cd14b0d19d",
                                "text": "La luzerne est un très bon engrais vert, mais il faut la laisser en place au moins 3 ans pour qu'elle puisse bien réhumifier le sol, je sais pas si semer par poquets est valable. on peut faire selon les années 2 ou 3 coupes à l'année. je compte en faire uniquement une petite plate-bande pour fournir du fourrage frais et sec pour....les petits cochons d'Inde de mon amie !"
                            },
                            {
                                "example_id": "4d0bf79f-b7bf-491e-b984-40de16c4fe6b",
                                "sense_id": "7d5ede16-df1c-3ed2-a28a-98cd14b0d19d",
                                "text": "Sur 10 m2, j'ai incorporé 1 m3 de brf précomposté dans 10 cm de terre pour réhumifier le sol."
                            },
                            {
                                "example_id": "6f19a913-28ac-4e71-b5fe-26f7b995c947",
                                "sense_id": "7d5ede16-df1c-3ed2-a28a-98cd14b0d19d",
                                "text": "Si tu as de la tourbe dans ton terreau, ça se réhumifie très mal, tu mets un pot à tremper dans un truc + grand et tu vois le temps qu'il mets à s'enfoncer complétement !"
                            }
                        ]
                    }
