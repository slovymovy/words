                        "sense_id": "39bca57c-ee7c-3292-8b16-9a7cef55ead9",
                        "entry_id": "fe550375-2f13-3187-bb99-0d24fe7a1433",
                        "glosses": [
                            "Organ zum Legen von Eiern (bei Insekten)"
                        ],
                        "tags": [
                            "Entomologie"
                        ],
                        "examples": [
                            {
                                "example_id": "31a3ebca-3580-438c-a02b-44d657321998",
                                "sense_id": "39bca57c-ee7c-3292-8b16-9a7cef55ead9",
                                "text": "Mit ihren spezialisierten Eiablageapparaten können Insekten ihre Eier in verschiedenste Substrate ablegen."
                            },
                            {
                                "example_id": "617e9a65-1eb9-47b4-8555-2151ab8dcc50",
                                "sense_id": "39bca57c-ee7c-3292-8b16-9a7cef55ead9",
                                "text": "„Archaischen Charakter hat auch der aus drei Gonapophysen gebaute Eiablageapparat, der im letzten Larvenstadium bei Epiophlebia superstes komplett erkennbar ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
