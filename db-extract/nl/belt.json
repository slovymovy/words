                "translations": [
                    {
                        "translation_id": "10beb8e6-ef1c-45bd-b0ce-a1aaa349b782",
                        "source_entry_id": "fd17d6c3-371e-38da-bf69-313ddc0ea40a",
                        "source_sense_id": "7baef874-ed00-331b-901f-197607944943",
