{
    "word_family": [
        "cratering"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4a20b666-8590-35fc-960b-ef052b00c1df",
                    "sense_definition": "A large bowl-shaped hole in the ground caused by an impact or explosion.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "depression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The meteorite left a massive <w>crater</w> in the middle of the desert.",
                            "target_lang_translations": {
                                "zh": "陨石在沙漠中央留下了一个巨大的<w>陨石坑</w>。"
                            }
                        },
                        {
                            "text": "Scientists studied the <w>crater</w> to learn more about the asteroid impact.",
                            "target_lang_translations": {
                                "zh": "科学家们研究了这个<w>陨石坑</w>，以了解更多关于小行星撞击的信息。"
                            }
                        }
                    ],
                    "synonyms": [],
                    "common_phrases": [
                        "impact crater"
                    ],
                    "target_lang_definitions": {
                        "zh": "由撞击或爆炸在地面上形成的碗状大坑。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "陨石坑",
                                "target_lang_sense_clarification": "指由陨石撞击形成的坑。"
                            },
                            {
                                "target_lang_word": "弹坑",
                                "target_lang_sense_clarification": "指由爆炸或炮弹轰炸形成的坑。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d8d855ab-8d90-397a-b3d9-a35cf79e3b1f",
                    "sense_definition": "The opening at the top of a volcano or geyser.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "depression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Smoke rose steadily from the volcano's <w>crater</w>.",
                            "target_lang_translations": {
                                "zh": "烟雾从火山的<w>火山口</w>中不断升起。"
                            }
                        },
                        {
                            "text": "Hikers climbed to the edge of the <w>crater</w> to see the lava inside.",
                            "target_lang_translations": {
                                "zh": "徒步旅行者爬到<w>火山口</w>边缘，观看里面的熔岩。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "volcanic crater"
                    ],
                    "target_lang_definitions": {
                        "zh": "火山或间歇泉顶部的开口。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "火山口",
                                "target_lang_sense_clarification": "火山顶部的碗状开口。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "56837d42-e99d-3348-9ef1-606a035f54fe",
                    "sense_definition": "To fail or collapse suddenly and completely.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "collapse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company's stock price <w>cratered</w> after the bad news was announced.",
                            "target_lang_translations": {
                                "zh": "坏消息公布后，该公司的股价<w>暴跌</w>。"
                            }
                        },
                        {
                            "text": "The economy began to <w>crater</w> during the global financial crisis.",
                            "target_lang_translations": {
                                "zh": "在全球金融危机期间，经济开始<w>崩溃</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "implode",
                        "tank"
                    ],
                    "target_lang_definitions": {
                        "zh": "突然且彻底地失败或崩溃。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "暴跌",
                                "target_lang_sense_clarification": "指价格或价值急剧下降。"
                            },
                            {
                                "target_lang_word": "崩溃",
                                "target_lang_sense_clarification": "指系统、经济或机构彻底瓦解。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "13631921-e5a6-3b2c-a92c-aa6f1d731290",
                    "sense_definition": "A constellation in the northern sky.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "astronomical_name",
                    "examples": [
                        {
                            "text": "The constellation <w>Crater</w> is located near the celestial equator.",
                            "target_lang_translations": {
                                "zh": "<w>巨爵座</w>位于天赤道附近。"
                            }
                        },
                        {
                            "text": "Ancient astronomers named the constellation <w>Crater</w> for its cup-like shape.",
                            "target_lang_translations": {
                                "zh": "古代天文学家因其杯状外形而将该星座命名为<w>巨爵座</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "北天的一个星座。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "巨爵座",
                                "target_lang_sense_clarification": "天文学中巨爵座的正式名称。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}