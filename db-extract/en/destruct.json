                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4efef7d4-f612-47f0-9065-4e367650d692",
                                                "sense_id": "e895feea-a9a5-3576-b1d2-95a2c79441df",
                                                "text": "Na de hardloopwedstrijd was ik gesloopt."
                                            },
                                            {
                                                "example_id": "ae7598dd-7bb9-49b6-ac95-4f48233fba11",
                                                "sense_id": "e895feea-a9a5-3576-b1d2-95a2c79441df",
                                                "text": "Na het nemen van de afslag ziet de weg naar boven er nog even mild uit, maar dan begint het asfalt al snel te welven. Er is minder dan een handvol haarspeldbochten, maar de hellingsgraden slopen de eerste reserves uit de benen."
                                            }
                                        ]
                                    }
                                ]
                            },
