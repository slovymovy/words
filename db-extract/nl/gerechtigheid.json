                ],
                "senses": [
                    {
                        "sense_id": "f3d3aec4-7aec-3922-bbae-d4553db22f6a",
                        "entry_id": "109213c4-8429-370d-a7a8-f3fb1ed9ddc0",
                        "glosses": [
                            "het handelen of behandeld worden volgens bepaalde normen aangaande wat recht en eerlijk is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2f86f224-f6e1-4e72-9f72-e9edc44ac69a",
                                "sense_id": "f3d3aec4-7aec-3922-bbae-d4553db22f6a",
                                "text": "Na jaren van onderdrukking ervoeren zij eindelijk gerechtigheid."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "42258064-4fb5-470f-8d43-8d1de696341b",
                        "source_entry_id": "109213c4-8429-370d-a7a8-f3fb1ed9ddc0",
                        "source_sense_id": "f3d3aec4-7aec-3922-bbae-d4553db22f6a",
                        "target_lang_word": "equity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "equity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e440c7f3-8277-386a-ba9e-d546bb2472c0",
                                        "entry_id": "473192a4-1899-340e-9635-f1fe0222dd34",
                                        "glosses": [
                                            "Fairness, impartiality, or justice as determined in light of \\\"natural law\\\" or \\\"natural right\\\"."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f55425f3-41ea-410e-9393-2bb6850b4a30",
                                                "sense_id": "e440c7f3-8277-386a-ba9e-d546bb2472c0",
                                                "text": "Sufficeth what they in their graue wiſedoomes ſhall proſcribe, I in no ſorte will ſeeke to acquite, nor preſumptuouſly attempte to diſpute againſt the equity of their iudgementes, but humble and proſtrate appeale to their mercies."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "824dea33-3df1-3f28-ad8b-3a51facc6523",
                                        "entry_id": "473192a4-1899-340e-9635-f1fe0222dd34",
                                        "glosses": [
                                            "Various related senses originating with the Court of Chancery in late Medieval England",
                                            "The power of a court of law having extra-statutory discretion, to decide legal matters and to provide legal relief apart from, though not in violation of, the prevailing legal code; in some cases, a court \\\"sitting in equity\\\" may provide relief to a complainant should the code be found either inapplicable or insufficient to do so."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "25fca935-bb18-4dc5-95ee-3b867cf32811",
                                                "sense_id": "824dea33-3df1-3f28-ad8b-3a51facc6523",
                                                "text": "1800, Lloyd Kenyon, 1st Baron Kenyon in Mayor, &c. of Southampton v. Graves (1800), 8 T. R. 592.\nA Court of equity knows its own province."
                                            },
                                            {
                                                "example_id": "266f7809-74ac-4b3e-875d-73b7cf77306f",
                                                "sense_id": "824dea33-3df1-3f28-ad8b-3a51facc6523",
                                                "text": "A Court of equity interposes only according to conscience."
                                            },
                                            {
                                                "example_id": "1331ccb8-599d-4347-8b91-29ec6f31aaf8",
                                                "sense_id": "824dea33-3df1-3f28-ad8b-3a51facc6523",
                                                "text": "Equity had been gradually shaping itself into a refined science which no human faculties could master without long and intense application."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "45fef218-fa41-3cbd-8642-8f3f9d6f27e9",
                                        "entry_id": "473192a4-1899-340e-9635-f1fe0222dd34",
                                        "glosses": [
                                            "Various related senses originating with the Court of Chancery in late Medieval England",
                                            "A right which accrues to a party in a transaction because of the nature of the transaction itself, and which is exercisable upon a change of circumstances or conditions; in other words, an equitable claim."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6fdb6e81-87bd-4b5e-a8e2-e529c851b568",
                                                "sense_id": "45fef218-fa41-3cbd-8642-8f3f9d6f27e9",
                                                "text": "...the mortgagor retains ‘equitable title’ or the ‘equity of redemption’….The equity of redemption permits the mortgagor to regain legal title to the mortgaged property upon satisfying the conditions of the mortgage..."
                                            },
                                            {
                                                "example_id": "04769891-3e27-4aec-98be-6a1b116a0fa6",
                                                "sense_id": "45fef218-fa41-3cbd-8642-8f3f9d6f27e9",
                                                "text": "The wife's equity does not, according to the adjudged cases, attach, except upon that part of her personal property in action which the husband cannot acquire without the assistance of a court of equity"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "866c7a8b-543f-3b58-9fb6-d7ea67774de9",
                                        "entry_id": "473192a4-1899-340e-9635-f1fe0222dd34",
                                        "glosses": [
                                            "Various related senses originating with the Court of Chancery in late Medieval England",
                                            "The body of law which was developed in the English Court of Chancery, which Court had extra-statutory discretion, and is now administered alongside the common law of Britain."
                                        ],
                                        "tags": [
                                            "England",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "22265357-3394-3136-b55b-98e233707d08",
                                        "entry_id": "473192a4-1899-340e-9635-f1fe0222dd34",
                                        "glosses": [
                                            "Various senses related to net value",
                                            "Value of property minus liens or other encumbrances."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b4b7b579-0462-4d61-a8c4-cdc5432a0015",
                                                "sense_id": "22265357-3394-3136-b55b-98e233707d08",
                                                "text": "I have a lot of equity in my house."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "669c530c-9223-3606-a12a-a9d1db089e55",
                                        "entry_id": "473192a4-1899-340e-9635-f1fe0222dd34",
                                        "glosses": [
                                            "Various senses related to net value",
                                            "Ownership, especially in terms of net monetary value of some business."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4849db8a-b98b-4604-9772-45bc9029d56a",
                                                "sense_id": "669c530c-9223-3606-a12a-a9d1db089e55",
                                                "text": "Private-equity nabobs bristle at being dubbed mere financiers. Piling debt onto companies’ balance-sheets is only a small part of what leveraged buy-outs are about, they insist. Improving the workings of the businesses they take over is just as core to their calling, if not more so. Much of their pleading is public-relations bluster."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "66555df9-19b6-3cb7-8cdb-90433b6690d2",
                                        "entry_id": "473192a4-1899-340e-9635-f1fe0222dd34",
                                        "glosses": [
                                            "Various senses related to net value",
                                            "Ownership interest in a company as determined by subtracting liabilities from assets."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7d651c60-75a6-3dfc-ace7-436c3a5f91fc",
                                        "entry_id": "473192a4-1899-340e-9635-f1fe0222dd34",
                                        "glosses": [
                                            "Various senses related to net value",
                                            "A player's expected share of the pot."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "004f9a53-c771-359f-98e0-8712147094ce",
                                        "entry_id": "473192a4-1899-340e-9635-f1fe0222dd34",
                                        "glosses": [
                                            "Equality"
                                        ],
                                        "tags": [
                                            "countable",
                                            "nonstandard",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "323a1fb8-b009-4847-a763-94d097642a3d",
                                                "sense_id": "004f9a53-c771-359f-98e0-8712147094ce",
                                                "text": "What steps the Government are taking to help ensure equity of opportunity for people from low-income families."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cdc66a11-2afa-4b3b-ac69-7ad874ed7c8a",
                        "source_entry_id": "109213c4-8429-370d-a7a8-f3fb1ed9ddc0",
                        "source_sense_id": "f3d3aec4-7aec-3922-bbae-d4553db22f6a",
                        "target_lang_word": "justicia",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "justicia",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "f4c4d898-0d77-34cf-a1a9-eca90103a109",
                                        "entry_id": "3f4aaa2f-7822-3ee1-a7f0-261d80e54234",
                                        "glosses": [
                                            "Cualidad moral que impulsa a dar a cada cual según su mérito o derecho."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b0a6b1eb-91cc-48c1-8d42-5fbb4a0158d1",
                                                "sense_id": "f4c4d898-0d77-34cf-a1a9-eca90103a109",
                                                "text": "Porque no se compadece tal gobernación inicua, tiránica, vastativa y despoblativa de tan grandes reinos poniendo a todo un mundo es aspérrima y continua, horrible y mortífera servidumbre, con la rectitud y justicia de ningunos que sean católicos cristianos ni aun que fuesen gentiles infieles, con que tuviesen alguna razón de reyes."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3826e0a3-fbba-32ee-8175-a2a4b241c904",
                                        "entry_id": "3f4aaa2f-7822-3ee1-a7f0-261d80e54234",
                                        "glosses": [
                                            "Por extensión, conformidad con la justicia₁."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e2b7496-bf09-492e-857c-7fa916eaf71e",
                                                "sense_id": "3826e0a3-fbba-32ee-8175-a2a4b241c904",
                                                "text": "El infante don Fernando consulta la justicia de su sucesión; y la embajada que envió a Barcelona, y lo que resultó. Desde entonces ya el infante mandó con gran cuidado que se viese por muy famosos letrados y se examinase el derecho y razón y la justicia que tenía a la sucesión destos reinos."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "bed641ca-c6a5-3f24-a558-43ba0c8feb58",
                                        "entry_id": "3f4aaa2f-7822-3ee1-a7f0-261d80e54234",
                                        "glosses": [
                                            "Acción o hecho conforme a la justicia₁."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d498221-f636-48f0-919b-d85e30cafea7",
                                                "sense_id": "bed641ca-c6a5-3f24-a558-43ba0c8feb58",
                                                "text": "Porque conforme a lo que está dicho, tampoco será hombre de bien el que con los buenos hechos no se huelga, pues que tampoco llamará ninguno justo al que el hacer justicia no le da contento, ni menos libre al que en los libres hechos no halla gusto, y lo mismo es en todas las demás virtudes."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "ec2595ce-1add-3efe-91f4-752fc8099c1c",
                                        "entry_id": "3f4aaa2f-7822-3ee1-a7f0-261d80e54234",
                                        "glosses": [
                                            "Condición o estado regido por la justicia₁."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d528cdfb-c093-4ccf-a5ad-b4b0d3d9aeaa",
                                                "sense_id": "ec2595ce-1add-3efe-91f4-752fc8099c1c",
                                                "text": "Porque afirma que todo lo que en las Indias se ha hecho por los españoles nulo y de ningún valor de derecho haya sido como cosa hecha sin autoridad de príncipe y contra toda natural justicia."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "932e7d1e-396b-3226-92fe-fe05c2e1d6de",
                                        "entry_id": "3f4aaa2f-7822-3ee1-a7f0-261d80e54234",
                                        "glosses": [
                                            "Ejercicio del poder para la aplicación de la ley."
                                        ],
                                        "tags": [
                                            "Política",
                                            "derecho"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f1a7643c-fe4b-4449-beca-2512f1174d38",
                                                "sense_id": "932e7d1e-396b-3226-92fe-fe05c2e1d6de",
                                                "text": "Y no es nada lo que está probado con los grandes estragos y males que aquéllos han hecho, porque todos los ministros de la justicia que hasta hoy han tenido en las Indias, por su grande y mortífera ceguedad, no se han ocupado en examinar los delictos y perdiciones y matanzas que han hecho y hoy hacen los tiranos de las India."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "09b2e654-93de-36e4-94f0-9f2c26b6f2fa",
                                        "entry_id": "3f4aaa2f-7822-3ee1-a7f0-261d80e54234",
                                        "glosses": [
                                            "En particular, resolución de un pleito o expediente."
                                        ],
                                        "tags": [
                                            "Política",
                                            "derecho"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ab4f920-f06b-484f-aaa1-4fb747d9627f",
                                                "sense_id": "09b2e654-93de-36e4-94f0-9f2c26b6f2fa",
                                                "text": "En él claman, protestan una y muchas veces; nunca quisieron los oidores hacerles justicia, porque entre ellos mesmos estaban repartidos parte de los indios que ansí, tan injusta y malamente, habían prendido los tiranos."
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    },
                                    {
                                        "sense_id": "dc24c841-68ac-357f-92f9-c0c1bff0f825",
                                        "entry_id": "3f4aaa2f-7822-3ee1-a7f0-261d80e54234",
                                        "glosses": [
                                            "Aplicación de un castigo ordenado por la justicia₆."
                                        ],
                                        "tags": [
                                            "Política",
                                            "derecho"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4cd2680f-ccf4-4a29-87ac-41bc484140cd",
                                                "sense_id": "dc24c841-68ac-357f-92f9-c0c1bff0f825",
                                                "text": "Se hizo justicia de los tiranos, que era el nombre que en aquella época se daba á todos los que usurpaban abiertamente la jurisdiccion real, aun cuando no cometieran crueldades."
                                            }
                                        ],
                                        "sense_index_json": "\"7\""
                                    },
                                    {
                                        "sense_id": "f114d138-48ab-3b83-a8c6-51e4af88b5a8",
                                        "entry_id": "3f4aaa2f-7822-3ee1-a7f0-261d80e54234",
                                        "glosses": [
                                            "En particular, ejecución ordenada por la justicia₆."
                                        ],
                                        "tags": [
                                            "Política",
                                            "derecho"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"8\""
                                    },
                                    {
                                        "sense_id": "e8e3b3aa-502a-3fb6-82e6-072848d42a74",
                                        "entry_id": "3f4aaa2f-7822-3ee1-a7f0-261d80e54234",
                                        "glosses": [
                                            "Funcionario que imparte justicia₅."
                                        ],
                                        "tags": [
                                            "Política",
                                            "derecho"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fbca3934-97c5-4420-a7eb-c64082b7d902",
                                                "sense_id": "e8e3b3aa-502a-3fb6-82e6-072848d42a74",
                                                "text": "Todos los reyes y señores naturales, ciudades, comunidades y pueblos de aquellas Indias son obligados a reconocer a los Reyes de Castilla por universales y soberanos señores y emperadores de la manera dicha después de haber recibido de su propia y libre voluntad nuestra santa fe y el sacro bautismo; y si antes que lo reciban no lo hacen ni quieren hacer, no pueden ser por algún juez o justicia punidos."
                                            }
                                        ],
                                        "sense_index_json": "\"9\""
                                    },
                                    {
                                        "sense_id": "9096fcdb-6a1e-38bf-9183-38eab3e64a4d",
                                        "entry_id": "3f4aaa2f-7822-3ee1-a7f0-261d80e54234",
                                        "glosses": [
                                            "Funcionario judicial, con atribuciones similares a las de un juez, designado localmente por el pueblo de su jurisdicción."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"10\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
