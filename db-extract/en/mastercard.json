                                                "example_id": "00efed88-3349-4912-bc69-d8a3b183d88a",
                                                "sense_id": "7efc0c52-95ec-3612-8ab1-74cf459d5b03",
                                                "text": "Une Mastercard, une Visa, une autre de l’American Express, et puis les renseignements concernant son assurance."
                                            },
                                            {
                                                "example_id": "bad525e1-7dae-4c9c-ac70-f016cf1f8194",
                                                "sense_id": "7efc0c52-95ec-3612-8ab1-74cf459d5b03",
                                                "text": "La MasterCard désigne une carte de paiement, comme les autres cartes bancaires de type Visa ou American Express."
                                            },
                                            {
                                                "example_id": "9e7ea043-c8ae-41cc-9c29-464a27f71ef4",
                                                "sense_id": "7efc0c52-95ec-3612-8ab1-74cf459d5b03",
                                                "text": "Face à Mastercard et Visa, l'opération reconquête des banques françaises"
                                            }
