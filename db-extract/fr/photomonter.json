                "senses": [
                    {
                        "sense_id": "a95311f1-4189-3fb5-8fe2-0261ed1e8c7a",
                        "entry_id": "94a9d639-512d-30e2-9003-58c5ad1f422b",
                        "glosses": [
                            "Réaliser un montage de photos avec."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b44dcd1c-69b1-43b6-b3a1-ef3a6c035cfc",
                                "sense_id": "a95311f1-4189-3fb5-8fe2-0261ed1e8c7a",
                                "text": "Tout ce qu'il fait, tout ce qu'il «photomonte» repose sur un seul postulat : « Seuls les affamés et les mécontents pourront réaliser les idées nouvelles. »"
                            },
                            {
                                "example_id": "5d233fd7-7fe5-4a72-8dd0-0141906b227c",
                                "sense_id": "a95311f1-4189-3fb5-8fe2-0261ed1e8c7a",
                                "text": "Noir et blanc, souvent retouché, ou «photomonté», il s'impose paradoxalement comme transcription du réel, comme effet de « dévoilement »."
                            }
                        ]
                    }
