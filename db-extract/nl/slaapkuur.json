                        "examples": [
                            {
                                "example_id": "d9876d26-91d2-4484-a9a4-a8e5dddd6893",
                                "sense_id": "a321ba32-5b69-3d8a-9381-637d0e2a2f9c",
                                "text": "Valerius liep vaak voorop, zegt Beekman. 'Met slaapkuren, onderzoek naar dementie, opnames vervangen door dagbehandeling, het betrekken van families bij behandelingen en het gebruik van de scanner. Wij hadden de eerste geheugenpoli van Nederland.'"
                            },
                            {
                                "example_id": "8f87401c-d6d6-4775-a823-6d45b82bfb6e",
                                "sense_id": "a321ba32-5b69-3d8a-9381-637d0e2a2f9c",
                                "text": "Prins Laurent, zoon van koning Albert II, zat in 1999 in psychiatrische kliniek La Ramée in Ukkel, naar eigen zeggen voor een slaapkuur na een emotionele ‘opdoffer’ . Sommige media stelden dat de gestrande liefde met tv-presentator Wendy van Wanten (Pin Up Club) hem opbrak."
                            }
                        ]
