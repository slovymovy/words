                                        "entry_id": "e462917b-8a58-3a31-8c1d-c1d4a429c6c2",
                                        "glosses": [
                                            "nacházející se nebo uskutečňovaný mezi planetami"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2190793e-933e-412f-81d2-e8cf0ceed9c6",
                                                "sense_id": "32355789-c779-3973-8507-8a9cccfd9d24",
                                                "text": "Na Marsu bude v únoru rušno. Po několikaměsíčním meziplanetárním letu k němu dorazí hned tři stroje různých států."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
