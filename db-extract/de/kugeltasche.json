                "senses": [
                    {
                        "sense_id": "36dd9281-4ac3-39f4-a5ed-548c65b85dd9",
                        "entry_id": "5a1d9739-936f-358a-a061-7114cd956fe5",
                        "glosses": [
                            "Tasche zur Aufbewahrung/zum Transport von Kugeln, die als Munition dienen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "17895840-b888-420b-9c52-d59dce921a51",
                                "sense_id": "36dd9281-4ac3-39f4-a5ed-548c65b85dd9",
                                "text": "„Auf dem kleinen, an der rechten Wand stehenden Tisch flackerte ein Talglicht und erhellte den Raum kaum genug, um ein paar rohgearbeitete Stühle und eine Art Eßschrank erkennen zu lassen, der links vom Eingang zwischen Kamin und Tür stand.“"
                            },
                            {
                                "example_id": "336b0f0f-a329-4186-93f4-a3addc9cb2cd",
                                "sense_id": "36dd9281-4ac3-39f4-a5ed-548c65b85dd9",
                                "text": "„Jeder der Knaben führte ebenfalls ein großes, halbmondförmiges Pulverhorn mit einer Kugeltasche und über den Sattel eines jeden war der Ueberwurf oder Karoß geschnallt, welcher sich von dem ihres Vaters nur dadurch unterschied, daß der seine von dem selteneren Leopardenfelle, dagegen die ihrigen von gewöhnlicher Art, der eine von Antilopen- und der andere von Schakalfell gefertigt waren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
