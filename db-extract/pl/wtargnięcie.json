                "translations": [
                    {
                        "translation_id": "392af0aa-a6ac-423b-bd75-777e6771ec1f",
                        "source_entry_id": "c7f71794-8da1-35a8-ba88-659debb8f67b",
                        "source_sense_id": "cf6d93f0-bbbf-315c-a3ca-f7762b0ad242",
                        "target_lang_word": "Eindringen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Eindringen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bc963f00-ac83-31d5-ae24-f88f3b585dca",
                                        "entry_id": "11a7f14b-8dc1-32bb-af34-92a34cf424e9",
                                        "glosses": [
                                            "Vorgang/Ereignis, bei der etwas in etwas eintritt/hineingelangt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec513104-7f91-4242-b575-01a564a333f8",
                                                "sense_id": "bc963f00-ac83-31d5-ae24-f88f3b585dca",
                                                "text": "Durch das Eindringen des Wassers wurde die gesamte Wohnung durchnässt."
                                            },
                                            {
                                                "example_id": "f3b2c03e-759e-406b-bb7b-931060bf1182",
                                                "sense_id": "bc963f00-ac83-31d5-ae24-f88f3b585dca",
                                                "text": "„Beim Eindringen artfremden Eiweißes (Antigene) in das Blut werden in Plasmazellen des Knochenmarks und im lymphatischen Gewebe hochspezifische Abwehrstoffe (Antitoxine, Antikörper) gebildet und in das Blut abgegeben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dfa55f9e-0d3f-4052-9328-806b9705b920",
                        "source_entry_id": "c7f71794-8da1-35a8-ba88-659debb8f67b",
                        "source_sense_id": "cf6d93f0-bbbf-315c-a3ca-f7762b0ad242",
                        "target_lang_word": "Einfall",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Einfall",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3fb786e6-3aac-3585-b493-25b64b9396dc",
                                        "entry_id": "3a75c9d7-04eb-3d07-a3e6-a4ddb1a9b054",
                                        "glosses": [
                                            "plötzlicher Gedanke"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8938c53c-ad11-4b7c-85e4-bbfb21d49350",
                                                "sense_id": "3fb786e6-3aac-3585-b493-25b64b9396dc",
                                                "text": "Nach langem, fruchtlosen Nachdenken hatte ich den rettenden Einfall."
                                            },
                                            {
                                                "example_id": "f898c9ae-c493-4cee-aa72-d8289170f800",
                                                "sense_id": "3fb786e6-3aac-3585-b493-25b64b9396dc",
                                                "text": "„Bald staunen wir kaum mehr, sondern nehmen die Einfälle als ganz selbstverständlich entgegen.“"
                                            },
                                            {
                                                "example_id": "1886f654-d513-4ca2-8e7a-527ee062eaf2",
                                                "sense_id": "3fb786e6-3aac-3585-b493-25b64b9396dc",
                                                "text": "„Es gibt eine Reihe von Einfällen, die nur in englische Köpfe passen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "61824cfd-de63-34af-85e9-7a45f0e8038e",
                                        "entry_id": "3a75c9d7-04eb-3d07-a3e6-a4ddb1a9b054",
                                        "glosses": [
                                            "Eindringen in fremdes Gebiet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1560687-8b9a-48ba-ab1b-509093500582",
                                                "sense_id": "61824cfd-de63-34af-85e9-7a45f0e8038e",
                                                "text": "Der Einfall der Hunnen in Europa löste die Völkerwanderung aus."
                                            },
                                            {
                                                "example_id": "923077d4-abd8-4c8c-84de-373d6d64d013",
                                                "sense_id": "61824cfd-de63-34af-85e9-7a45f0e8038e",
                                                "text": "„Die Folgen einer großen Seuche, die weite Bevölkerungsteile dezimierte, sowie der Einfall der Markomannen überschatteten sein Principat.“"
                                            },
                                            {
                                                "example_id": "68be6e6c-cfed-4b9b-98f5-645e2c097b8c",
                                                "sense_id": "61824cfd-de63-34af-85e9-7a45f0e8038e",
                                                "text": "„Die Insellage verschonte die Bewohner Britanniens von Einfällen von außen, obwohl es bereits in dieser Zeit vereinzelte Angriffe fränkischer und sächsischer Verbände gab.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "a1edffd9-12f4-3a92-9261-d6715805c6a6",
                                        "entry_id": "3a75c9d7-04eb-3d07-a3e6-a4ddb1a9b054",
                                        "glosses": [
                                            "das Auftreffen (zum Beispiel von Lichtstrahlen) auf eine Fläche"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9268b09a-0622-4956-879f-7a38bd001d5f",
                                                "sense_id": "a1edffd9-12f4-3a92-9261-d6715805c6a6",
                                                "text": "Bei senkrechtem Einfall der Strahlen wird kaum Licht zur Seite reflektiert."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "05939e04-c682-4bfa-be01-5a3e60cca6b3",
                        "source_entry_id": "c7f71794-8da1-35a8-ba88-659debb8f67b",
                        "source_sense_id": "cf6d93f0-bbbf-315c-a3ca-f7762b0ad242",
                        "target_lang_word": "Einmarsch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Einmarsch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "50e6c5d7-a6fb-3287-936a-16764510ba6e",
                                        "entry_id": "d1be9b37-e799-3d5d-a9df-db87d0eac4e8",
                                        "glosses": [
                                            "gemeinsames Einmarschieren mehrerer Personen in ein Gebäude oder Gebiet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b6a584a2-9de5-4b40-a541-95c20995ccd9",
                                                "sense_id": "50e6c5d7-a6fb-3287-936a-16764510ba6e",
                                                "text": "Der Einmarsch der Gladiatoren in die Arena war ein beeindruckendes Ereignis."
                                            },
                                            {
                                                "example_id": "9482cdba-7dae-45eb-be0f-60103c044607",
                                                "sense_id": "50e6c5d7-a6fb-3287-936a-16764510ba6e",
                                                "text": "„Die Wettkämpfe beginnen mit dem Einmarsch der Nationen, der feierlichen Eröffnung durch das Staatsoberhaupt, dem Hissen der Olympiafahne, dem Entzünden der olympischen Flamme und dem Ablegen des olympischen Eides.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2c0c5090-41f4-372e-b626-50b5fe308b1d",
                                        "entry_id": "d1be9b37-e799-3d5d-a9df-db87d0eac4e8",
                                        "glosses": [
                                            "gewaltsames Eindringen von militärischen Truppen in ein Gebiet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "42f86d78-6ee2-48b4-8326-56c10224f839",
                                                "sense_id": "2c0c5090-41f4-372e-b626-50b5fe308b1d",
                                                "text": "Der Einmarsch der Deutschen war ein Schreckenserlebnis für die Franzosen."
                                            },
                                            {
                                                "example_id": "20128b15-55ed-4bec-b012-1a1e587ab34f",
                                                "sense_id": "2c0c5090-41f4-372e-b626-50b5fe308b1d",
                                                "text": "„‘Wir können uns‘, so [Arseni] Jazenjuk zu Moderatorin Pinar Atalay, ‘alle sehr gut an den sowjetischen Einmarsch in die Ukraine und nach Deutschland erinnern.‘“"
                                            },
                                            {
                                                "example_id": "67052bad-cca8-43a2-9b38-c1f496d78dbf",
                                                "sense_id": "2c0c5090-41f4-372e-b626-50b5fe308b1d",
                                                "text": "„Ein jüdischer Einmarsch in dieses Gebiet würde England zum Intervenieren zwingen.“"
                                            },
                                            {
                                                "example_id": "27b874e5-b07b-471f-8b19-58ab0927af1c",
                                                "sense_id": "2c0c5090-41f4-372e-b626-50b5fe308b1d",
                                                "text": "„In Karzin wußte man, daß der Einmarsch unmittelbar bevorstand.“"
                                            },
                                            {
                                                "example_id": "1130cbdb-c826-45c0-b2e6-4f5b498326e2",
                                                "sense_id": "2c0c5090-41f4-372e-b626-50b5fe308b1d",
                                                "text": "„Man hörte, dass der Vorschlag gemacht worden sei, das Abzeichen der Einheitspartei des tschechischen Volkes, die Präsident Hácha sofort nach dem Einmarsch der Deutschen gegründet hatte, umzudrehen.“"
                                            },
                                            {
                                                "example_id": "904c0e6b-650b-430c-95a9-f72fd18b64c0",
                                                "sense_id": "2c0c5090-41f4-372e-b626-50b5fe308b1d",
                                                "text": "„Dass diese Koalition zwischen Sharifs PML und den religiösen Parteien, allen voran die Jamaat-e-Islami, zerbrach, geht auf Sharifs persönliche Sympathie für Saddam Hussein während des irakischen Einmarschs in Kuwait zurück.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
