                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c5a3d38-e51b-4af8-9021-fb0044046df8",
                                                "sense_id": "788f10b8-cd09-3633-844b-5144ff2c12f5",
                                                "text": "There had been a drop in the mother-of-pearl shell market and quite a few of the pearling luggers had turned their attention to diving for trepang, which had survived the ravages of the depression and was easy to recover, lying in shallow waters."
                                            }
                                        ]
