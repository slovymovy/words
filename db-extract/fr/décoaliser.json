                "senses": [
                    {
                        "sense_id": "0e29f21e-7883-38ae-a20b-c5f9f4a166fc",
                        "entry_id": "c2d4ca5c-0089-344b-b560-7fbcb7465602",
                        "glosses": [
                            "Cesser de coaliser."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "64a5c948-4806-4e17-8907-cac997aff844",
                                "sense_id": "0e29f21e-7883-38ae-a20b-c5f9f4a166fc",
                                "text": "C’est à elle qu’il appartient de décoaliser l’Espagne, de dicter la loi au Capet qui règne sur ce peuple superstitieux, et de faire trembler les inquisiteurs et les monstres de Madrid."
                            },
                            {
                                "example_id": "d6001408-2166-4961-8a77-b6485a650c8b",
                                "sense_id": "0e29f21e-7883-38ae-a20b-c5f9f4a166fc",
                                "text": "[…] l’accumulation n’étant pas ici agrégation, mais coalition, ce qui signifie que le tout n’est pas désagrégé jusqu’à la partie, mais décoalisé, c’est-à-dire désintégré jusqu’à la négation = 0."
                            }
                        ]
                    }
