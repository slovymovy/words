                "senses": [
                    {
                        "sense_id": "4b297f09-b4c0-3d86-9d47-673d7c11522c",
                        "entry_id": "ca6d1ce3-67fd-35d1-a19e-88a2460f0856",
                        "glosses": [
                            "to bow (to, before), to greet (to bend oneself as a gesture of respect or deference)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1da702a0-0643-4bed-aad5-dee7d09e5184",
                                "sense_id": "4b297f09-b4c0-3d86-9d47-673d7c11522c",
                                "text": "Нежданов поклонился и отправился вслед за Иваном в «зелёную» комнату, находившуюся во втором этаже.",
                                "translation": "Nezhdanov bowed, and followed Ivan into the 'green room', which was on the second storey.",
                                "english": "Nezhdanov bowed, and followed Ivan into the 'green room', which was on the second storey."
                            }
                        ]
                    },
                    {
                        "sense_id": "6a17d7bc-3422-3686-8171-753ba7f20399",
                        "entry_id": "ca6d1ce3-67fd-35d1-a19e-88a2460f0856",
                        "glosses": [
                            "to give/send regards"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "540260f1-3155-4092-8f5c-d226e71fc565",
                                "sense_id": "6a17d7bc-3422-3686-8171-753ba7f20399",
                                "text": "Поклони́тесь ему́ от меня́.",
                                "translation": "Give him my regards.",
                                "english": "Give him my regards."
                            }
                        ]
                    },
                    {
                        "sense_id": "a42ff17d-d59d-3446-9b4d-230a99169f3b",
                        "entry_id": "ca6d1ce3-67fd-35d1-a19e-88a2460f0856",
                        "glosses": [
                            "to cringe (before); to humiliate oneself (before); to humbly beg"
                        ],
