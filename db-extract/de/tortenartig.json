                        "glosses": [
                            "in der Art einer Torte; wie eine Torte (aussehend, beschaffen)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7cbb4261-002a-4b56-8f36-9b1d0d6d99e0",
                                "sense_id": "3448fb4a-26ea-365c-9c46-a96ccfd1ae4f",
                                "text": "„Friedrich zerschnitt die Erdbeeren in kleine tortenartige Stückchen und beträufelte sie mit Aprikosenlikör.“"
                            },
                            {
                                "example_id": "a8fee22a-1e02-452d-a125-6868292648af",
                                "sense_id": "3448fb4a-26ea-365c-9c46-a96ccfd1ae4f",
                                "text": "„Phosphor kommt entweder in runden, dicken Scheiben, die tortenartig zerschnitten sind, oder in Stangen gegossen in den Handel.“"
                            }
                        ],
