                ],
                "senses": [
                    {
                        "sense_id": "32edb372-87e9-3db5-bf5d-864fcfc44463",
                        "entry_id": "1a3bef39-ecc3-3e46-84bc-856d64b92870",
                        "glosses": [
                            "Insel in der Nordsee"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f58badf-0e02-4879-8cae-6c75c4a59c39",
                                "sense_id": "32edb372-87e9-3db5-bf5d-864fcfc44463",
                                "text": "Norderney liegt zwischen Juist und Baltrum."
                            },
                            {
                                "example_id": "88319a48-4acc-4ab3-948b-a5278644f785",
                                "sense_id": "32edb372-87e9-3db5-bf5d-864fcfc44463",
                                "text": "Unseren letzten Urlaub verbrachten wir auf Norderney."
                            },
                            {
                                "example_id": "61e78df9-45d7-45c1-991c-48e6ca4d455c",
                                "sense_id": "32edb372-87e9-3db5-bf5d-864fcfc44463",
                                "text": "Norderney liegt im Wattenmeer."
                            },
                            {
                                "example_id": "7586d220-43c9-47e8-a1b3-f8a750e17d81",
                                "sense_id": "32edb372-87e9-3db5-bf5d-864fcfc44463",
                                "text": "Das Lagerfeuer auf Norderney erlosch erst am frühen Morgen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "dcff569c-c6b2-3d25-a39f-33819afbfb04",
                        "entry_id": "1a3bef39-ecc3-3e46-84bc-856d64b92870",
                        "glosses": [
                            "Ort (Seebad) auf dieser Insel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1352ff5e-e30a-4bd0-aaf8-08cbb21cb585",
                                "sense_id": "dcff569c-c6b2-3d25-a39f-33819afbfb04",
                                "text": "Ich bin in Norderney geboren."
                            },
                            {
                                "example_id": "223a9b7e-d80c-4320-ae8e-c85109c15760",
                                "sense_id": "dcff569c-c6b2-3d25-a39f-33819afbfb04",
                                "text": "Ich habe in Norderney meinen Urlaub verbracht."
                            },
                            {
                                "example_id": "2b5b0c47-c3df-4f71-bace-bb25663758b7",
                                "sense_id": "dcff569c-c6b2-3d25-a39f-33819afbfb04",
                                "text": "Nach Norderney führen viele Wege."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
