                "senses": [
                    {
                        "sense_id": "f173b3cc-c214-38d1-8ac2-b3b0f2d72618",
                        "entry_id": "853538a4-9cfa-3ed1-a05b-0caf3fd575cb",
                        "glosses": [
                            "Savoir."
                        ],
                        "tags": [
                            "Par plaisanterie"
                        ],
                        "examples": [
                            {
                                "example_id": "d54363d0-9a94-4a4f-93dd-e9f87b60ec7b",
                                "sense_id": "f173b3cc-c214-38d1-8ac2-b3b0f2d72618",
                                "text": "Arborez fièrement votre sachoir dans la rue pour impressionner les croiveurs !"
                            },
                            {
                                "example_id": "342f1578-1d82-4d87-ab45-bdfbfd381ca8",
                                "sense_id": "f173b3cc-c214-38d1-8ac2-b3b0f2d72618",
                                "text": "Le jour où le savoir sera mis en valeur, les élèves de nos écoles commenceront à apprendre par plaisir. La réussite suivra d’elle-même. En attendant, nous devons nous contenter d’une société du « sachoir » rentable."
                            },
                            {
                                "example_id": "49956d12-6b78-4bbb-818c-9f7d107e2118",
                                "sense_id": "f173b3cc-c214-38d1-8ac2-b3b0f2d72618",
                                "text": "Son parti, qui a dit le contraire ? Facile d'enfoncer des portes ouvertes, de jouer au \"sachant\" face à des ignorants qui n'ont pas le \"sachoir\"... Nul !"
                            }
                        ]
                    }
                ],
