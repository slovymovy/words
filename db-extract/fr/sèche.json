                    }
                ],
                "senses": [
                    {
                        "sense_id": "3f498eee-59dc-379f-9c45-756c8d17e10a",
                        "entry_id": "43b2dfc3-c850-3032-8988-305204c78988",
                        "glosses": [
                            "Cigarette."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "23ef8435-de58-4808-bbd2-370811ac5223",
                                "sense_id": "3f498eee-59dc-379f-9c45-756c8d17e10a",
                                "text": "Je grillais une sèche sur le pas de la porte quand elle est arrivée."
                            },
                            {
                                "example_id": "62120883-051e-4889-8bf9-17361887cdb4",
                                "sense_id": "3f498eee-59dc-379f-9c45-756c8d17e10a",
                                "text": "On sonne. Je vais ouvrir, le faciès rogue, la sèche au coin de la gueule."
                            }
                        ]
                    },
                    {
                        "sense_id": "023bd230-3730-36a1-8465-13a63f3b23fd",
                        "entry_id": "43b2dfc3-c850-3032-8988-305204c78988",
                        "glosses": [
                            "Perte de poids subie par une viande à cause de l’évaporation de l’eau."
                        ],
                        "tags": [
                            "Boucherie"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "d7e8f360-db33-3776-bb99-f7e7d6627882",
                        "entry_id": "43b2dfc3-c850-3032-8988-305204c78988",
                        "glosses": [
                            "Haut-fond dangereux pour la navigation."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "39df66ce-f0c2-30bd-a187-b563147b0093",
                        "entry_id": "43b2dfc3-c850-3032-8988-305204c78988",
                        "glosses": [
                            "Maladie affectant le pin des Landes."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "8e3ff53d-d760-367a-9cf5-855a1f357877",
                        "entry_id": "43b2dfc3-c850-3032-8988-305204c78988",
                        "glosses": [
                            "Perte de gras dans le but de rendre les muscles plus apparents."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "55a31c95-435a-4417-b4d4-80fdbdc80639",
                                "sense_id": "8e3ff53d-d760-367a-9cf5-855a1f357877",
                                "text": "La principale difficulté pendant la sèche est de ne pas cataboliser, c’est à dire faire une fonte musculaire lié au régime."
                            },
                            {
                                "example_id": "f6f3040c-bc2a-4197-8995-f45146a8f469",
                                "sense_id": "8e3ff53d-d760-367a-9cf5-855a1f357877",
                                "text": "La technique du rebond en glucides, bien connue des culturistes, fait exploser les muscles quand on sort d'un régime de sèche pour attaquer la compétition."
                            }
                        ]
                    },
                    {
                        "sense_id": "a7d8bbe3-2b3a-3be8-85f4-382af34bcf7a",
                        "entry_id": "43b2dfc3-c850-3032-8988-305204c78988",
                        "glosses": [
                            "Petit gâteau sec et friable recouvert de grains de sucre, spécialité de Franche-Comté et de Suisse."
                        ],
                        "tags": [
                            "Pâtisserie"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "f8e7ade0-2210-3b45-b701-79ddab6f648c",
                        "entry_id": "43b2dfc3-c850-3032-8988-305204c78988",
                        "glosses": [
                            "Graphie ancienne de seiche."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34001ee3-119e-4f3d-b748-228c135cf06a",
                                "sense_id": "f8e7ade0-2210-3b45-b701-79ddab6f648c",
                                "text": "D’autres, armées d’un bâton que termine un fort hameçon, fouillent sous les pierres, dans les creux du rocher, et en retirent soit le congre à la peau glissante, soit le poulpe aux huit bras, la sèche ou l’encornet, qui tentent vainement d’échapper en s’entourant d’un nuage coloré."
                            }
                        ]
                    }
