                    "frequency": "Low",
                    "semantic_group_id": "mechanical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heavy gate rotates smoothly on a steel <w>pivot</w>."
                        },
                        {
                            "text": "The machine's main <w>pivot</w> requires regular lubrication to prevent wear."
                        }
                    ],
                    "synonyms": [
                        "axle",
                        "spindle",
                        "hinge"
                    ],
                    "common_phrases": [
                        "central pivot"
                    ]
                },
                {
                    "sense_id": "a5856c10-86dd-3670-940f-bded194722ff",
                    "sense_definition": "A person or thing that is central to the success or development of a situation.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "importance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was the <w>pivot</w> around which the entire project team revolved."
                        },
                        {
                            "text": "The new policy became the <w>pivot</w> of the political debate."
                        }
                    ],
                    "synonyms": [
                        "centerpiece",
                        "cornerstone",
                        "linchpin"
                    ],
                    "common_phrases": [
                        "central pivot"
                    ]
