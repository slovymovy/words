                                    {
                                        "sense_id": "c8b82b27-74bb-3333-8c13-6313de30408a",
                                        "entry_id": "a5adf3b3-6299-35f6-810d-e03322218c01",
                                        "glosses": [
                                            "Carte qui peut prendre à certains jeux n’importe quelle valeur, selon la volonté de celui qui la détient."
                                        ],
                                        "tags": [
                                            "Cartes à jouer"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "86360e91-b4ec-45bb-9126-a430adf20819",
                                                "sense_id": "c8b82b27-74bb-3333-8c13-6313de30408a",
                                                "text": "Ainsi du joker dans le jeu de cartes ou de l'avantage d'une pièce dans le jeu des échecs pour rétablir l'équilibre entre deux joueurs d'inégale force."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e217215b-2787-3efe-9d2d-3e0c27ec6d15",
                                        "entry_id": "a5adf3b3-6299-35f6-810d-e03322218c01",
                                        "glosses": [
                                            "Lettre blanche à laquelle on peut désigner l’identité de n’importe quelle lettre."
                                        ],
                                        "tags": [
                                            "Scrabble"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "41cc7567-c5d1-3f6c-8a0d-26fb2a2550a8",
                                        "entry_id": "a5adf3b3-6299-35f6-810d-e03322218c01",
                                        "glosses": [
                                            "Avantage quelconque que l’on emploie si besoin est."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6e17680e-d2eb-412f-b515-5f6013b7ae66",
                                                "sense_id": "41cc7567-c5d1-3f6c-8a0d-26fb2a2550a8",
                                                "text": "Avancer un joker, donner son joker, refuser de répondre à une question."
                                            },
                                            {
                                                "example_id": "15a661f2-a8bb-48c3-b340-7a84d7299ca4",
                                                "sense_id": "41cc7567-c5d1-3f6c-8a0d-26fb2a2550a8",
                                                "text": "Sortir son joker, se sortir d’une situation embarrassante par un moyen inattendu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "021cfe37-ca51-3e69-aee7-2f688eb8dce4",
                                        "entry_id": "a5adf3b3-6299-35f6-810d-e03322218c01",
                                        "glosses": [
                                            "Métacaractère passe-partout, utilisé pour désigner un caractère quelconque, comme le point dans /file.*/ dans les expressions rationnelles, ou un ou plusieurs caractères quelconques, comme l’astérisque dans *.txt sur un shell."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "425efeae-78d2-4f41-a1e0-bfad96c733c1",
                                                "sense_id": "021cfe37-ca51-3e69-aee7-2f688eb8dce4",
                                                "text": "Dans le cadre d’une recherche par mots-clés également, les troncatures sont des signes permettant de remplacer un ou plusieurs caractères d’un mot par un astérisque ou par une lettre « joker »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "023b2d98-e187-3a20-a13d-f18ad3547f8b",
                                        "entry_id": "a5adf3b3-6299-35f6-810d-e03322218c01",
                                        "glosses": [
                                            "(Audiovisuel) Personne choisie pour en remplacer une autre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "06482d5f-6723-44a4-8153-83621cede207",
                                                "sense_id": "023b2d98-e187-3a20-a13d-f18ad3547f8b",
                                                "text": "Après avoir fait ses armes pendant neuf ans à LCI, il devient joker à la présentation des journaux du week-end de TF1 durant l'été 2006."
                                            }
                                        ]
                                    }
                                ]
