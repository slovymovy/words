                                        "entry_id": "1c9688f0-6fd3-32a3-a786-149cd0c02d81",
                                        "glosses": [
                                            "Austrittsöffnung des Darms, durch welche der Kot den Darm verlässt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b646c9a-f457-4e68-9556-974e49d02787",
                                                "sense_id": "d067527d-703a-3846-8afe-442f17b462df",
                                                "text": "Wegen der Hygiene ist es erforderlich, sich den After sauber zu halten."
                                            },
                                            {
                                                "example_id": "8a63418a-496d-4d5b-9764-3c9ef4cdfd20",
                                                "sense_id": "d067527d-703a-3846-8afe-442f17b462df",
                                                "text": "„Mit Hilfe eines Blasebalges wurde dem Tier so viel Luft in den After gepumpt, bis er wie eine Boje auf den Wellen umherdümpelte.“"
                                            },
                                            {
                                                "example_id": "4b3adc68-9911-4085-803f-06ae43b0f123",
                                                "sense_id": "d067527d-703a-3846-8afe-442f17b462df",
                                                "text": "„Auf den im Katalog abgebildeten Stinkbomben-Schachteln ist ein Stinktier zu sehen, das einem Vagabunden in Angriffsstellung gegenübersteht, den Schweif hoch, das After in Front.“"
                                            },
                                            {
                                                "example_id": "15a2e1c0-e2c3-4ec6-a1bb-820f3d66e831",
                                                "sense_id": "d067527d-703a-3846-8afe-442f17b462df",
                                                "text": "„Die »a tergo«-Position, das Benutzen des Afters als Scheide, war ähnlich wie der homosexuelle Analverkehr geächtet, auch er aus Gründen der unterbleibenden Fortpflanzung.“"
                                            },
                                            {
                                                "example_id": "c1e8d55b-678d-46aa-b386-0ab1c357bd3f",
                                                "sense_id": "d067527d-703a-3846-8afe-442f17b462df",
                                                "text": "„Der vom Davit hängende Hai entleerte sich durch den After.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "25711be1-583e-4897-9dd2-7d6ea45dc33d",
                        "source_entry_id": "1398255c-4533-33c0-99e1-38189b69947f",
                        "source_sense_id": "e2be3f3a-58c0-3ad5-81d4-f9694341b050",
                        "target_lang_word": "Anus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Anus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0fc5a79c-17e8-313e-bec2-c0b1e786137d",
                                        "entry_id": "c06db36c-4697-37b5-afd2-27668d2722eb",
                                        "glosses": [
                                            "Austrittsöffnung des Darmes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba37160e-9a24-432f-a1c2-6041f866abec",
                                                "sense_id": "0fc5a79c-17e8-313e-bec2-c0b1e786137d",
                                                "text": "„Anus“ wird vor allem als Fachbegriff der Medizin verwendet."
                                            },
                                            {
                                                "example_id": "7c14d7d0-b771-41c1-9bab-9a17f3ffd637",
                                                "sense_id": "0fc5a79c-17e8-313e-bec2-c0b1e786137d",
                                                "text": "„Er spürt die leichten Zuckungen ihres Anus.“"
                                            },
                                            {
                                                "example_id": "eacd6552-96a9-4632-ab5e-8c99c1b84748",
                                                "sense_id": "0fc5a79c-17e8-313e-bec2-c0b1e786137d",
                                                "text": "„Und dann griff er dem Dalmatiner in den Anus.“"
                                            },
                                            {
                                                "example_id": "7f9763a5-72c9-49f5-a1d8-5e8c6ba32ce9",
                                                "sense_id": "0fc5a79c-17e8-313e-bec2-c0b1e786137d",
                                                "text": "„Ich muß mich ganz stark auf den Anus konzentrieren, damit die Soße nicht einfach hindurchleckt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
