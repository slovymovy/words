                "senses": [
                    {
                        "sense_id": "b0158151-49e5-3592-89a0-728e38f0d1e5",
                        "entry_id": "b0a719ef-0c45-3772-a846-9b4e71ea9985",
                        "glosses": [
                            "Donner un caractère keynésien à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0287b493-19ad-4633-b063-a06e3a21cdd9",
                                "sense_id": "b0158151-49e5-3592-89a0-728e38f0d1e5",
                                "text": "Il a tout intérêt à ce qu’on keynésianise et à ce qu’on le rejoigne dans sa mouise budgétaire XXL qui pétera quand les zémergents auront zémergé."
                            },
                            {
                                "example_id": "e2a40773-8459-489d-81c4-9c7cf47ec993",
                                "sense_id": "b0158151-49e5-3592-89a0-728e38f0d1e5",
                                "text": "On émet des obligations et on keynésianise à outrance vu que de toute façon le remboursement se fera après la fête avec force cotillons, champagne et dames de petite vertu ??"
                            },
                            {
                                "example_id": "1e6af382-fe09-4d74-bfba-01272eb73dea",
                                "sense_id": "b0158151-49e5-3592-89a0-728e38f0d1e5",
                                "text": "A partir de la fin des années 60, le « modèle allemand » se « social-démocratise » et « keynésianise » au moment où le SPD est aux affaires."
                            }
                        ]
                    }
