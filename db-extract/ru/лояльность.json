                    }
                ],
                "translations": [
                    {
                        "translation_id": "42c31ffc-3043-45d8-b83a-b58422008209",
                        "source_entry_id": "eee8182a-747c-307f-85f2-398baa55520c",
                        "source_sense_id": "f316f562-8177-3068-8015-b39398b32f6b",
                        "target_lang_word": "loyality",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "e0a5f30a-e4d5-4d67-890b-f507a50b95c2",
                        "source_entry_id": "eee8182a-747c-307f-85f2-398baa55520c",
                        "source_sense_id": "f316f562-8177-3068-8015-b39398b32f6b",
                        "target_lang_word": "allegiance",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "allegiance",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "09cfee9e-3a8a-324b-a14d-aaae33d9d514",
                                        "entry_id": "0f4e4914-7322-31cb-b6b1-d171d0cead2b",
                                        "glosses": [
                                            "Loyalty to some cause, nation or ruler."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "58c5adc1-1fbe-44ea-aa43-7a509f2cac78",
                                                "sense_id": "09cfee9e-3a8a-324b-a14d-aaae33d9d514",
                                                "text": "With what a feeling of joyful security did her heart go back to its old allegiance! Till now she had scarcely been aware of its strength, for she had known it but by its disappointment—now she fully admitted that early and passionate emotion with which Robert Evelyn had inspired her was indeed her destiny;..."
                                            },
                                            {
                                                "example_id": "40a84611-bc08-40ea-a677-e6b6d73e2502",
                                                "sense_id": "09cfee9e-3a8a-324b-a14d-aaae33d9d514",
                                                "text": "It was always going to be a hot occasion for Declan Rice and Jack Grealish, the one-time Ireland internationals who subsequently switched their allegiances."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a21fb714-bff1-4a12-88d7-307c21eeeb31",
                        "source_entry_id": "eee8182a-747c-307f-85f2-398baa55520c",
                        "source_sense_id": "f316f562-8177-3068-8015-b39398b32f6b",
                        "target_lang_word": "Loyalität",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Loyalität",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7ac2d3d6-238d-3818-b3cd-045fe5615974",
                                        "entry_id": "404edfe5-0147-3158-9cba-06a39dbab5d5",
                                        "glosses": [
                                            "anhaltende, zuverlässige Unterstützung für jemand oder etwas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55584a99-a2d7-4a98-99cd-5efb17b58215",
                                                "sense_id": "7ac2d3d6-238d-3818-b3cd-045fe5615974",
                                                "text": "Er erwies seinem Betrieb während seiner ganzen Zugehörigkeit Loyalität."
                                            },
                                            {
                                                "example_id": "4ac4395d-a0d0-4c2f-9eef-0b23614fcea9",
                                                "sense_id": "7ac2d3d6-238d-3818-b3cd-045fe5615974",
                                                "text": "Es ist eine Frage der Loyalität, ob wir jetzt bleiben."
                                            },
                                            {
                                                "example_id": "475c3a12-310c-4b51-97b0-a5236b25e0c7",
                                                "sense_id": "7ac2d3d6-238d-3818-b3cd-045fe5615974",
                                                "text": "Seine Loyalität konnte man sicher nicht in Frage stellen."
                                            },
                                            {
                                                "example_id": "114cc829-66a0-49dc-b9f4-75f1b8ce68e2",
                                                "sense_id": "7ac2d3d6-238d-3818-b3cd-045fe5615974",
                                                "text": "Ihr Verhalten war grausam, was seiner Loyalität keinen Abbruch tat."
                                            },
                                            {
                                                "example_id": "5461fb27-6ecd-4ae6-9b74-28855ec17376",
                                                "sense_id": "7ac2d3d6-238d-3818-b3cd-045fe5615974",
                                                "text": "„Die Tetrarchen mussten immer ihre militärische Befähigung unter Beweis stellen, um sich in kritischen Situationen auf die Loyalität der Soldaten stützen zu können.“"
                                            },
                                            {
                                                "example_id": "b9582b07-6a8c-4b6f-b954-3e5861afc3db",
                                                "sense_id": "7ac2d3d6-238d-3818-b3cd-045fe5615974",
                                                "text": "„Über meine Loyalität zu Deutschland muss sich niemand Sorgen machen.“"
                                            },
                                            {
                                                "example_id": "ad9abeae-ff61-4df1-9250-6e623e27d948",
                                                "sense_id": "7ac2d3d6-238d-3818-b3cd-045fe5615974",
                                                "text": "„Wie Moorcroft erkannten sie, daß Csomas Loyalität gegenüber den Briten aufrichtig und seine Arbeit an der tibetischen Sprache von echtem Wert war.“"
                                            },
                                            {
                                                "example_id": "430e9118-4551-4125-bf51-71c0ebabc107",
                                                "sense_id": "7ac2d3d6-238d-3818-b3cd-045fe5615974",
                                                "text": "„Damit gewinnt er die Loyalität jener Menschen, deren Häuser er im Bruderkampf noch niedergebrannt hat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "92fdd74d-e188-4861-88fe-1c4f5fe51a6b",
                        "source_entry_id": "eee8182a-747c-307f-85f2-398baa55520c",
