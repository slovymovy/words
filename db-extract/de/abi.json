                                    {
                                        "sense_id": "bc23f2c6-25b6-34b8-9937-e8fd2691a0ca",
                                        "entry_id": "983e7efc-6868-3046-805c-019eb8f4ffba",
                                        "glosses": [
                                            "Auge destinée à divers usages."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b830e59-ae5d-4618-8367-0328e43c5edd",
                                                "sense_id": "bc23f2c6-25b6-34b8-9937-e8fd2691a0ca",
                                                "text": "Bac à glace, à sable, à fleurs, à légumes, à disques ; bac de disques, de vinyles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8cbfc6cb-98d4-371e-8472-3f9cad6805b8",
                                        "entry_id": "983e7efc-6868-3046-805c-019eb8f4ffba",
                                        "glosses": [
                                            "Grand bateau plat, qui est principalement destiné à passer les gens, les animaux, les voitures, les charrettes, etc. d’un bord d’une rivière à l’autre, au moyen d’une corde qui la traverse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3ffad58-3695-4804-be13-aeb39fb0e254",
                                                "sense_id": "8cbfc6cb-98d4-371e-8472-3f9cad6805b8",
                                                "text": "Prendre passage sur un bac."
                                            },
                                            {
                                                "example_id": "90758b44-4b2f-40bf-8e1c-1bb4d305d6a3",
                                                "sense_id": "8cbfc6cb-98d4-371e-8472-3f9cad6805b8",
                                                "text": "Le bateau glissait lentement le long de la corde du bac, sous le reflet d’un nuage pâle qui surplombait l’eau en ce moment."
                                            },
                                            {
                                                "example_id": "dd02b5df-60ad-461a-ae2f-afa601dd110d",
                                                "sense_id": "8cbfc6cb-98d4-371e-8472-3f9cad6805b8",
                                                "text": "À Bénodet, nous avons traversé la rivière dans un bac."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b5e4a78c-0a51-3958-8413-b66ffd217892",
