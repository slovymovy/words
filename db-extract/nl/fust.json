                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "1d46dd75-6339-33f8-b04b-67635e196230",
                        "entry_id": "2973a5f1-0f2c-3d62-91e7-45062defdea4",
                        "glosses": [
                            "verzamelnaam voor vaten waarin alcoholische dranken bewaard worden",
                            "vat waarin alcoholische drank bewaard wordt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a17b2ee-21f3-4704-a9f7-5600c788eb00",
                                "sense_id": "1d46dd75-6339-33f8-b04b-67635e196230",
                                "text": "Ik wilde naar een bar waar je een bier bestelt en er een kerel bij krijgt. Dat bedacht ik toen ik zag hoe een oudere man een fust bier probeerde te tillen. In de hoek stond hij te sjorren aan dat fust."
                            }
                        ]
                    },
                    {
                        "sense_id": "5e386c40-d0b9-31dc-8d23-1f349d1400c4",
                        "entry_id": "2973a5f1-0f2c-3d62-91e7-45062defdea4",
                        "glosses": [
                            "verzamelnaam voor vaten waarin alcoholische dranken bewaard worden",
                            "wijn op fust verkopen - zonder te bottelen"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7ae3a027-b7d5-4ba5-a7b0-8fbcfc9f7ea8",
                        "source_entry_id": "2973a5f1-0f2c-3d62-91e7-45062defdea4",
                        "source_sense_id": "daa4b041-44fd-3bea-9028-f0849c3277f3",
                        "source_sense_description": "vat waarin alcoholische drank bewaard wordt",
                        "target_lang_word": "keg",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "keg",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "367bbd72-946b-3c35-9431-cf19e6e606c8",
                                        "entry_id": "2b6af2fd-aa53-31fd-b7ef-a5703cd323a2",
                                        "glosses": [
                                            "A round, traditionally wooden container of lesser capacity than a barrel, often used to store beer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9db22311-b984-4590-bba4-3e8479ff9c38",
                                                "sense_id": "367bbd72-946b-3c35-9431-cf19e6e606c8",
                                                "text": "He bore on his shoulder a stout keg, that seemed full of liquor, and made signs for Rip to approach and assist him with his load."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "keg",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c67db5cb-e3dd-32cd-89e7-a16c31327603",
                                        "entry_id": "af32e112-d007-3913-9046-aa50d9067e53",
                                        "glosses": [
                                            "To store in a keg."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b3a68d44-4550-4512-b0d4-47abc9db9be7",
                                                "sense_id": "c67db5cb-e3dd-32cd-89e7-a16c31327603",
                                                "text": "He gestured toward the empty chair and the other officers began passing him their kegged beef and ship's biscuit."
                                            },
                                            {
                                                "example_id": "54823a4f-0314-407d-afa2-fdff12ab2213",
                                                "sense_id": "c67db5cb-e3dd-32cd-89e7-a16c31327603",
                                                "text": "Many of us get impatient with the tedium of bottling after a year or two and start thinking about kegging our beers instead."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "040dc8e8-0fb8-3ea7-ac01-02ab417d0f53",
                                        "entry_id": "af32e112-d007-3913-9046-aa50d9067e53",
                                        "glosses": [
                                            "The pulling down of someone's trousers or kegs, oftentimes as a kind of bullying or prank."
                                        ],
                                        "tags": [
                                            "UK"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "36575508-f4e6-4991-bd95-17e8bbb2901f",
                        "source_entry_id": "2973a5f1-0f2c-3d62-91e7-45062defdea4",
                        "source_sense_id": "daa4b041-44fd-3bea-9028-f0849c3277f3",
                        "source_sense_description": "vat waarin alcoholische drank bewaard wordt",
                        "target_lang_word": "fût",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fût",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4fce0fd9-ce33-39cc-ac53-992084e7fb01",
                                        "entry_id": "9f32dd09-bf9e-392a-9efb-17cc9a75758f",
                                        "glosses": [
                                            "Troisième personne du singulier de l’imparfait du subjonctif de être."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3ba86c19-42b8-4793-be35-72ebb1c25972",
                                                "sense_id": "4fce0fd9-ce33-39cc-ac53-992084e7fb01",
                                                "text": "Il n’y avait dans la maison qu’un jeune garçon de douze ou treize ans, neveu de Kermelle, que celui-ci avait recueilli, et auquel le vicaire, digne homme s’il en fût, apprenait ce qu’il savait : le latin."
                                            },
                                            {
                                                "example_id": "42796a45-893b-4283-aa84-1d4c8fc80d4f",
                                                "sense_id": "4fce0fd9-ce33-39cc-ac53-992084e7fb01",
                                                "text": "Il aurait eu beaucoup d’esprit s’il se fût permis d’en avoir."
                                            },
                                            {
                                                "example_id": "6ec9ddc0-1aec-4217-b326-cdb643300c43",
                                                "sense_id": "4fce0fd9-ce33-39cc-ac53-992084e7fb01",
                                                "text": "— On dit que votre mari est nommé ministre. Est-ce que c’est vrai ?\nElle savait qu’on le disait, mais elle ne croyait pas que rien fût fait encore."
                                            },
                                            {
                                                "example_id": "b4b0a8c3-304c-46dc-894b-91a41b3e3867",
                                                "sense_id": "4fce0fd9-ce33-39cc-ac53-992084e7fb01",
                                                "text": "Les dernières semaines, quand elle se mit à grossir rapidement, elle se réjouit qu’André fût loin d’elle, craignant qu’il ne la trouvât enlaidie : l’ovale de son visage s’était empâté un peu, donnant une maturité plus chaude à sa beauté."
                                            },
                                            {
                                                "example_id": "a4d4b820-7777-4292-b922-e6892bd87902",
                                                "sense_id": "4fce0fd9-ce33-39cc-ac53-992084e7fb01",
                                                "text": "La Grande Sophie faisait profession d’être malade. Avait-elle fini par douter qu’elle le fût ? Il lui était si avantageux de le paraître qu’elle ne changeait rien à ses habitudes."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fût",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6f40c28f-c1e4-368f-9377-ba4ccf23a9dc",
                                        "entry_id": "3bddcfde-0c5b-3918-8fc7-a924bc732ed3",
                                        "glosses": [
                                            "Bois sur lequel est monté le canon d’un fusil, d’une arquebuse, d’un pistolet, etc."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f8fc1886-c3ec-3738-896c-2c4fa58317ba",
                                        "entry_id": "3bddcfde-0c5b-3918-8fc7-a924bc732ed3",
                                        "glosses": [
                                            "Partie en bois d'un objet."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a4f6781c-66b0-45db-8050-0b5b8d326b15",
                                                "sense_id": "f8fc1886-c3ec-3738-896c-2c4fa58317ba",
                                                "text": "Le fût d’un rabot, d’une scie, d’une charrue."
                                            },
                                            {
                                                "example_id": "d3d9aba1-7802-4779-9c0c-fe9b530f7eac",
                                                "sense_id": "f8fc1886-c3ec-3738-896c-2c4fa58317ba",
                                                "text": "Le fût d’une raquette, d’un archet de violon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "732e828a-d8ec-393c-a721-8a131282d2fc",
                                        "entry_id": "3bddcfde-0c5b-3918-8fc7-a924bc732ed3",
                                        "glosses": [
                                            "Partie du tronc d’un arbre comprise entre le sol et les premiers rameaux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e14af1e2-0da8-4fc9-9cea-cf6e656d7699",
                                                "sense_id": "732e828a-d8ec-393c-a721-8a131282d2fc",
                                                "text": "On traverse fréquemment des régions incendiées où les fûts carbonisés portent encore, comme de grosses houppes de tabac, leur ancien feuillage."
                                            },
                                            {
                                                "example_id": "197e6ab5-7ab6-44c9-a1cf-200a57edf2cc",
                                                "sense_id": "732e828a-d8ec-393c-a721-8a131282d2fc",
                                                "text": "La qualification correspond à la formation de la bille de pied recherchée, un fût net de nœuds, et précède la phase d’expansion durant laquelle le forestier favorise le développement des houppiers des tiges sélectionnées (arbres objectif)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "132bb3d4-3638-37b6-88f8-94f32d2be994",
                                        "entry_id": "3bddcfde-0c5b-3918-8fc7-a924bc732ed3",
                                        "glosses": [
                                            "Tige de la colonne, partie qui est entre la base et le chapiteau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bfe8e370-7bbd-4fbb-aaba-745ac0cb74e4",
                                                "sense_id": "132bb3d4-3638-37b6-88f8-94f32d2be994",
                                                "text": "Les fonts de Bertoncourt, près de Rethel, sont postérieurs à ceux dont nous venons de parler; […]. La cuve, octogone, repose sur un fût cylindrique dont la base est ornée d'un tore aplati, avec fleurs de lis aux angles."
                                            },
                                            {
                                                "example_id": "e5fbf79d-84bf-4f96-8fe5-1bea3ab9d14a",
                                                "sense_id": "132bb3d4-3638-37b6-88f8-94f32d2be994",
                                                "text": "Le fût de la colonne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "27e08d5b-49d2-39bd-be4b-5253d5ab9017",
                                        "entry_id": "3bddcfde-0c5b-3918-8fc7-a924bc732ed3",
                                        "glosses": [
                                            "Colonne d’un candélabre ou d'un bougeoir."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "84785e0e-02fa-4423-a08c-82d0a39cc1a5",
                                                "sense_id": "27e08d5b-49d2-39bd-be4b-5253d5ab9017",
                                                "text": "Paire de flambeaux portant une coquille sur le binet, un ornement rocaille sur le fût, et des canaux tournants sur la cloche."
                                            },
                                            {
                                                "example_id": "3f5aab07-5262-4d20-8b7a-c5b617fb9486",
                                                "sense_id": "27e08d5b-49d2-39bd-be4b-5253d5ab9017",
                                                "text": "Ensemble de signaux mécaniques unifiés. Avertissement sur fût raccourci, signal surélevé présentant le Carré et le Rappel de Ralentissement 30. L’ensemble est à commande funiculaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8923815a-78c1-3e85-a4b0-8d601a69ff15",
                                        "entry_id": "3bddcfde-0c5b-3918-8fc7-a924bc732ed3",
                                        "glosses": [
                                            "Trait vertical principal d’un caractère, aussi appelé hampe, haste ou montant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2dee5585-bfe9-4f35-b9aa-c79d84d5b231",
                                                "sense_id": "8923815a-78c1-3e85-a4b0-8d601a69ff15",
                                                "text": "Le fût du T, du L"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "55697c00-3778-3e29-bf75-0f63b55c033c",
                                        "entry_id": "3bddcfde-0c5b-3918-8fc7-a924bc732ed3",
                                        "glosses": [
                                            "Tonneau où l’on met le vin ou un autre liquide."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57c74363-bbe4-4a9b-8c9a-c1d9206360e9",
                                                "sense_id": "55697c00-3778-3e29-bf75-0f63b55c033c",
                                                "text": "On utilise sans vergogne l’arrière-pays, du moins sa partie non protégée, non mise en réserve pour accueillir des décharges intempestives, les fûts toxiques, les activités polluantes et les ayatollahs de l'écologie."
                                            },
                                            {
                                                "example_id": "8e060e05-4649-4bdb-95d3-5589c0cd932e",
                                                "sense_id": "55697c00-3778-3e29-bf75-0f63b55c033c",
                                                "text": "Trois fûts de cent litres d’essence avaient été renversés dans le faux-pont."
                                            },
                                            {
                                                "example_id": "f81d8bcf-f44c-46fb-928a-c36e84477947",
                                                "sense_id": "55697c00-3778-3e29-bf75-0f63b55c033c",
                                                "text": "Comme le veut la tradition, le maire de Munich, Dieter Reiter, a donné le coup d’envoi des festivités en perçant à coup de marteau le premier fût de bière."
                                            },
                                            {
                                                "example_id": "b9a7ae66-cf57-437e-a903-e02eaf56b42d",
                                                "sense_id": "55697c00-3778-3e29-bf75-0f63b55c033c",
                                                "text": "Double fût : Fût renfermé dans un autre qui est ordinairement en bois plus léger."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9cc47c64-bfd7-3180-8c73-eabf66de1eef",
                                        "entry_id": "3bddcfde-0c5b-3918-8fc7-a924bc732ed3",
                                        "glosses": [
                                            "Partie de la queue faisant office de manche."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4eb3da74-9f2b-317e-b712-facf2aa36eb5",
                                        "entry_id": "3bddcfde-0c5b-3918-8fc7-a924bc732ed3",
                                        "glosses": [
                                            "Partie généralement cylindrique d'un tambour sur laquelle une ou deux peaux sont tendues"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
                ],
