                        "entry_id": "3ce5ec2a-8424-3382-83ee-663fe064f70b",
                        "glosses": [
                            "To which no attention is paid; ignored, unheeded."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be07ac64-c930-4f3c-a5bd-d3cb647c93f4",
                                "sense_id": "f4324040-2664-3524-bbdf-b4a802762d62",
                                "text": "Bathsheba had too much sense to mind seriously what her servitors said about her; but too much womanly redundance of speech to leave alone what was said till it died the natural death of unminded things."
                            },
                            {
                                "example_id": "ded9ce7f-5800-4e31-8b11-242d512e2b1f",
                                "sense_id": "f4324040-2664-3524-bbdf-b4a802762d62",
                                "text": "Whatever, unknown or unminded by others, wanders by night through the labyrinth of the heart\"--that he must transmit to the hearer; he must allow the listener to share with him the gift of \"being able to give expression to his suffering.\""
                            }
                        ]
                    },
                    {
                        "sense_id": "32767ae0-29f4-3c96-b3ea-938bd36d3c31",
                        "entry_id": "3ce5ec2a-8424-3382-83ee-663fe064f70b",
                        "glosses": [
                            "Not wanting to do something; uninclined."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "899dd6c7-ce24-4525-946e-ce41f7900e26",
                                "sense_id": "32767ae0-29f4-3c96-b3ea-938bd36d3c31",
                                "text": "[…] that he had not elected English literature, that he had already wasted too much brain tissue on the question, and that he was unminded to waste any more!"
                            }
                        ]
                    }
