                ],
                "senses": [
                    {
                        "sense_id": "6e4c6125-893b-3d51-8563-1d6987df0b3c",
                        "entry_id": "d64e98ea-fe23-3e93-8694-cfdfc4ec679d",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba808e20-6307-428c-a6ba-cd464c1c9ec3",
                                "sense_id": "6e4c6125-893b-3d51-8563-1d6987df0b3c",
                                "text": "Frau Wägele ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "d165e823-fd19-4702-946b-c521ffa3500b",
                                "sense_id": "6e4c6125-893b-3d51-8563-1d6987df0b3c",
                                "text": "Herr Wägele wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "e2fe559e-84a7-4f58-a4c2-6ce44c24f70e",
                                "sense_id": "6e4c6125-893b-3d51-8563-1d6987df0b3c",
                                "text": "Die Wägeles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "c1169486-ff64-4df2-afdd-0f5a0da999ee",
                                "sense_id": "6e4c6125-893b-3d51-8563-1d6987df0b3c",
                                "text": "Der Wägele trägt nie die Pullover, die die Wägele ihm strickt."
                            },
                            {
                                "example_id": "26ad2efe-21b3-4ad5-af6f-131be396baad",
                                "sense_id": "6e4c6125-893b-3d51-8563-1d6987df0b3c",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Wägele kommt, geht der Herr Wägele.“"
                            },
                            {
                                "example_id": "04a007df-4957-4f45-b8d4-b29fb6b4c4d9",
                                "sense_id": "6e4c6125-893b-3d51-8563-1d6987df0b3c",
                                "text": "Wägele kommt und geht."
                            },
                            {
                                "example_id": "ee664911-a0f2-4628-98b0-aa91305c29e4",
                                "sense_id": "6e4c6125-893b-3d51-8563-1d6987df0b3c",
                                "text": "Wägeles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
