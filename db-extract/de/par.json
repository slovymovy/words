                "senses": [
                    {
                        "sense_id": "67997ad7-1984-3d92-a04f-2b72bb06e96f",
                        "entry_id": "b7a56575-c1e8-3276-9975-e607c799dd40",
                        "glosses": [
                            "in Abhängigkeit der Länge der Spielbahn festgelegte Anzahl von Schlägen, die von einem sehr guten Spieler (Handicap-0-Spieler, Profigolfer) vom Abschlag bis zum Einlochen erwartet wird"
                        ],
                        "tags": [
                            "Golf"
                        ],
                        "examples": [
                            {
                                "example_id": "98edd83b-6308-473a-992f-1bbfbbef5791",
                                "sense_id": "67997ad7-1984-3d92-a04f-2b72bb06e96f",
                                "text": "Die 18. Spielbahn ist ein relativ kurzes Par 5; hier werden viele Birdies erzielt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "3748166b-b9f3-3fbf-a0f6-c457146d3472",
                        "entry_id": "b7a56575-c1e8-3276-9975-e607c799dd40",
                        "glosses": [
                            "das Absolvieren einer, mehrerer oder aller Spielbahnen mit genau der vorgegebenen Schlaganzahl"
                        ],
                        "tags": [
                            "Golf"
                        ],
                        "examples": [
                            {
                                "example_id": "13736765-b269-4b73-995d-0173b355467e",
                                "sense_id": "3748166b-b9f3-3fbf-a0f6-c457146d3472",
                                "text": "Nach einem furiosen Beginn mit zahlreichen Birdies, genügte auf den letzten beiden Löchern jeweils ein sicheres Par zum Turniergewinn."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
