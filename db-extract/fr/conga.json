                "senses": [
                    {
                        "sense_id": "c9d7623b-40f7-374d-a285-d2a7d49c89cb",
                        "entry_id": "b5bcc310-c6aa-3cf2-96d5-ace78c4f492e",
                        "glosses": [
                            "Danse qui consiste en trois pas de côté avant de lever un pied et de repartir dans l’autre sens."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e25d0418-7702-4ded-909a-2f2c56f096d8",
                                "sense_id": "c9d7623b-40f7-374d-a285-d2a7d49c89cb",
                                "text": "Michael Ignatieff a dansé la conga avec une « volontaire » devant les bureaux de MuchMusic à Toronto le mois dernier."
                            }
                        ]
                    },
                    {
                        "sense_id": "8d537fcd-cbbb-3736-8bad-d29af1016526",
                        "entry_id": "b5bcc310-c6aa-3cf2-96d5-ace78c4f492e",
                        "glosses": [
                            "Genre musical créé par les esclaves cubains en 1550 basé sur un rythme binaire (2/2 2/4)."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "5a977c40-4534-395c-8c67-49be7b09a5c0",
                        "entry_id": "b5bcc310-c6aa-3cf2-96d5-ace78c4f492e",
                        "glosses": [
                            "Percussion en forme de tambour à une membrane."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "71414761-1d74-4d55-a88d-624aee4db812",
                                "sense_id": "5a977c40-4534-395c-8c67-49be7b09a5c0",
                                "text": "C’était un tube d’Ibrahim Ferrer dans lequel les trompettes vrombissaient au-dessus d’une coulée parfaite de claves, de congas et de tres."
                            },
                            {
                                "example_id": "71691fd6-30dd-41de-8c6c-37834120414f",
                                "sense_id": "5a977c40-4534-395c-8c67-49be7b09a5c0",
                                "text": "Les congas et les tambours cognait dans la tête du bon Dieu pour faire entendre que nous étions las du malheur, las de la misère, las de toutes ces punitions qui épluchaient nos cœurs."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c58630c7-de20-47af-be02-8e7bb46582f2",
                        "source_entry_id": "b5bcc310-c6aa-3cf2-96d5-ace78c4f492e",
                        "source_sense_description": "Instrument de musique",
                        "target_lang_word": "conga",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "conga",
