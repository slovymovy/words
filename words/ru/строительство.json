                },
                {
                    "sense_id": "acb7b207-d31d-30cc-b7a8-4a135283de45",
                    "sense_definition": "Отрасль экономики, науки и техники, занимающаяся возведением зданий.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "отрасль",
                    "name_type": "no",
                    "examples": [
