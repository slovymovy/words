                "senses": [
                    {
                        "sense_id": "da72e6eb-4455-375b-964b-37e2f2eaca30",
                        "entry_id": "01310cb1-dbe1-37b6-b0ad-5916a6ccf1f8",
                        "glosses": [
                            "Kreuzung aus Esel und Zebra"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "028510a3-b72e-444c-b59f-89490d2aa162",
                                "sense_id": "da72e6eb-4455-375b-964b-37e2f2eaca30",
                                "text": "Maultier und Muli kennst du sicher. Aber Zesel? Und Zorse? Das soll es wirklich geben? Ja! Es gibt tatsächlich Kreuzungen zwischen Pferd, Esel und Zebras."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3f0069da-2d8e-4f2a-9836-3dd2eb62ac00",
                        "source_entry_id": "01310cb1-dbe1-37b6-b0ad-5916a6ccf1f8",
                        "source_sense_id": "da72e6eb-4455-375b-964b-37e2f2eaca30",
                        "source_sense_description": "Kreuzung aus Esel und Zebra",
                        "target_lang_word": "zonky",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zonky",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "800a27c0-aeff-3270-a4b3-3413037940ca",
                                        "entry_id": "fa835ece-69ee-39fd-9a11-53f09a78cb36",
                                        "glosses": [
                                            "Very fatigued; zonked."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ac31d9dd-5f2a-4b0f-a97b-b4298728dfd5",
                                                "sense_id": "800a27c0-aeff-3270-a4b3-3413037940ca",
                                                "text": "And I feel kind of zonky this morning. Maybe I needed the sleep."
                                            },
                                            {
                                                "example_id": "321b3467-7098-4614-88ad-224380c0eadd",
                                                "sense_id": "800a27c0-aeff-3270-a4b3-3413037940ca",
                                                "text": "She was much better before the medicine made her all zonky."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "67122975-c26e-3041-a5e8-7ca4a8afb320",
                                        "entry_id": "fa835ece-69ee-39fd-9a11-53f09a78cb36",
                                        "glosses": [
                                            "Weird, odd, eccentric."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "56ac1e35-aa43-4bb8-b9b8-ca1b9ca660dd",
                                                "sense_id": "67122975-c26e-3041-a5e8-7ca4a8afb320",
                                                "text": "He knows all the stuff that Arthur Schlesinger Jr., knows, keeps picking up brand new, ultra-contemporary stuff that nobody else knows, and arrives at zonky conclusions couched in scholarly terms."
                                            },
                                            {
                                                "example_id": "c8cbfc58-3fae-495e-b82c-31f8f51b34c6",
                                                "sense_id": "67122975-c26e-3041-a5e8-7ca4a8afb320",
                                                "text": "[…] she doesn’t have the precision of a Jean Arthur, yet she has some of that rueful, fluffy-in-the-head charm of someone whose brains are addled by her sexual impulses, and she adds the blur in the expression and those tremulous, zonky eyes."
                                            },
                                            {
                                                "example_id": "27fcd705-c1be-42bb-b1ca-dda1eed63111",
                                                "sense_id": "67122975-c26e-3041-a5e8-7ca4a8afb320",
                                                "text": "“I tried the State Employment Office and all the guy there does is show you unemployment figures for the county and shakes his head. Makes you feel zonky.”"
                                            },
                                            {
                                                "example_id": "4ac7e185-d9c2-41e3-941b-820f8fc8e3cd",
                                                "sense_id": "67122975-c26e-3041-a5e8-7ca4a8afb320",
                                                "text": "Gradually Simon’s powers of movement returned. He felt them coming back. It was a growing warmth, an inner blooming. He was able to say, “Guess I went a little zonky back there, huh?”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
