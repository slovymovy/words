                                "target_lang_sense_clarification": "horizontaal vlak voor voorwerpen"
                            },
                            {
                                "target_lang_word": "richel",
                                "target_lang_sense_clarification": "smalle plank of rand"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8fe0ec01-3ae2-3be8-9887-c493df2a888d",
                    "sense_definition": "An underwater ridge, reef, or shelf of rocks.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "geological_features",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The boat's hull was damaged when it scraped against a hidden rocky <w>ledge</w>.",
                            "target_lang_translations": {
