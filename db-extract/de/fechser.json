                "senses": [
                    {
                        "sense_id": "c8e0832c-845e-38eb-9b42-ba18a75f4137",
                        "entry_id": "60e65a45-181e-3399-a74c-2f8e908b6c47",
                        "glosses": [
                            "Pflanzenteil, das austreiben kann und eine neue Pflanze bilden; unterirdisches Stammstück zur Vermehrung"
                        ],
                        "tags": [
                            "Weinanbau"
                        ],
                        "examples": [
                            {
                                "example_id": "45112908-7a4c-447b-becc-70f209a0c78e",
                                "sense_id": "c8e0832c-845e-38eb-9b42-ba18a75f4137",
                                "text": "„Vor Allem muß man nun für die Hopfenbestellung auf Anschaffung guter Fechser bedacht sein, die man aus berühmten Hopfenplantagen herbeischafft, und von Franken oder aus Böhmen beziehen kann.“"
                            },
                            {
                                "example_id": "a262877c-4c12-4c75-bd4a-bf8f3f176b1b",
                                "sense_id": "c8e0832c-845e-38eb-9b42-ba18a75f4137",
                                "text": "„Im März, wo die Fechser gelegt werden, muß der Boden mit dem Spaten oder Pflug, dessen Streichbreter etwas schief gestellt werden können, wenigstens 3 Fuß tief bearbeitet werden.“ (1868)"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
