                                    {
                                        "sense_id": "bce97907-8186-3da5-a763-7bd438993f98",
                                        "entry_id": "00c6a2ed-5cba-3e04-ab40-f74132775772",
                                        "glosses": [
                                            "Respect (social standing) coming from achievement or development."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "31a2c460-fd4f-4744-bb13-1040ca7650bc",
                                                "sense_id": "bce97907-8186-3da5-a763-7bd438993f98",
                                                "text": "Mount's cool finish from Kane's pass after Raheem Sterling intercepted Berat Djimsiti's pass was another illustration of his growing stature and Chelsea's rising star must surely be a certain starter when England open their Euro 2020 finals campaign against Croatia at Wembley on 13 June."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "36005f63-c724-3c14-96aa-c5796bef41f5",
                                        "entry_id": "00c6a2ed-5cba-3e04-ab40-f74132775772",
                                        "glosses": [
                                            "Statue."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "100f7b88-2a66-4908-8275-196abffc22a1",
                                                "sense_id": "36005f63-c724-3c14-96aa-c5796bef41f5",
                                                "text": "The golden ſtature of their feathered bird\nThat ſpreads her wings vpon the city wals,\nShall not defend it from our battering ſhot."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
