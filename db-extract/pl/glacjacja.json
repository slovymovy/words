                "translations": [
                    {
                        "translation_id": "dbfbde0f-9c45-4dcc-8043-ddf71438cab4",
                        "source_entry_id": "33716514-dbe9-3744-bc84-e349fa065de4",
                        "source_sense_id": "ede22d7e-f4b7-3594-8688-08c6a1f495af",
                        "target_lang_word": "glaciation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "glaciation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "43be3c70-0449-31a8-8c8b-253800c970f0",
                                        "entry_id": "ffc519c2-6f7a-37fc-bb37-96b98d13ab8a",
                                        "glosses": [
                                            "The process of covering with a glacier, or the state of being glaciated; the production of glacial phenomena; an ice age"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4afc0278-1b00-4935-bba1-2225eb9c36dc",
                                                "sense_id": "43be3c70-0449-31a8-8c8b-253800c970f0",
                                                "text": "That the habitability of our planet was severely endangered by the significant rise in oxygen levels and reduction in methane due to oxygen-producing bacteria combined with the low luminosity of the Sun in the Proterozoic era (2500– 542 million years ago) is suggested by geological evidence for severe global glaciations in this epoch."
                                            },
                                            {
                                                "example_id": "426b33a2-00e9-4c97-9ee9-ac231ef502b0",
                                                "sense_id": "43be3c70-0449-31a8-8c8b-253800c970f0",
                                                "text": "This simulation aims at describing the hydrological conditions at a Swedish deep repository of nuclear waste during a glaciation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ff6f06b-6057-345c-a9bb-b37c2c7a3bf8",
                                        "entry_id": "ffc519c2-6f7a-37fc-bb37-96b98d13ab8a",
                                        "glosses": [
                                            "A particular instance of glacier formation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6161c3f2-8ed0-4228-b8cb-a7e93ce7271f",
                                                "sense_id": "3ff6f06b-6057-345c-a9bb-b37c2c7a3bf8",
                                                "text": "Deposits of the Caribou Hills glaciation only locally retain a distinct hummocky morainal form, with filled kettle depressions and subdued knobs. Along the mountain fronts the marginal deposits of this glaciation reach an average altitude of slightly more than 3,000 feet."
                                            },
                                            {
                                                "example_id": "a25619c7-b15e-4680-a663-18086c0c86f3",
                                                "sense_id": "3ff6f06b-6057-345c-a9bb-b37c2c7a3bf8",
                                                "text": "Deposits from the glaciation are sparse, but glacial surfaces at 4150–4300 m in the Hunza area, above 2600 m in the Gilgit region, above 3200 m in the Haramosh region, above 4000 m on Deosai, and at 3200–3500 m in the Shigar valley area provide much evidence for this glaciation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba8a5bc6-9ff9-3ae1-b9ea-a13f402e3936",
                                        "entry_id": "ffc519c2-6f7a-37fc-bb37-96b98d13ab8a",
                                        "glosses": [
                                            "The act of freezing."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "048f8606-0605-4bb6-b974-0d20e4707d70",
                                                "sense_id": "ba8a5bc6-9ff9-3ae1-b9ea-a13f402e3936",
                                                "text": "For cave glaciation to occur it is necessary that the air temperature outside the caves be negative either for all or part of a year; such conditions exist in many regions of the world."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f8f4fada-0d2f-4879-b824-b067c48fda2d",
                        "source_entry_id": "33716514-dbe9-3744-bc84-e349fa065de4",
                        "source_sense_id": "ede22d7e-f4b7-3594-8688-08c6a1f495af",
