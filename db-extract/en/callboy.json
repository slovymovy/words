                                            {
                                                "example_id": "6668c3e7-78c2-4782-8efa-4b81edb4ce7f",
                                                "sense_id": "e277d7d2-48ef-35c2-830c-ce9d607bb1f9",
                                                "text": "Der Callboy bestahl seine Kundin nach dem Akt."
                                            }
