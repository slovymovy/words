                        "glosses": [
                            "In a hacking manner; brokenly or jerkily."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11bd64bb-1a0e-4eec-8139-786a61f6f36b",
                                "sense_id": "1602e07c-f009-336c-9ad8-084386894bce",
                                "text": "The furnace protested long and hackingly like the lungs of an old smoker at an early morning cigarette."
                            },
                            {
                                "example_id": "e3f4d7c6-02c8-47d4-95c1-e2c7e52f6d07",
                                "sense_id": "1602e07c-f009-336c-9ad8-084386894bce",
                                "text": "Magazine illustrations cut hackingly by her tiny, amateur fingers."
                            },
                            {
                                "example_id": "713f1df6-a0d9-4a96-951e-d5411d3e6062",
                                "sense_id": "1602e07c-f009-336c-9ad8-084386894bce",
                                "text": "He coughed again hard and hackingly, as an old lady came in for ammoniated quinine."
                            },
                            {
                                "example_id": "3dfe1f02-a50e-4863-80a6-2bb5ac4b6998",
                                "sense_id": "1602e07c-f009-336c-9ad8-084386894bce",
                                "text": "“So now everything's fine.” I uttered a hacking laugh. “No,” I said, in answer to a query from Aunt Dahlia. “I have not accidentally swallowed my tonsils, I was merely laughing hackingly. Ironical that the young blister should say that everything is fine, for at this very moment disaster stares us in the eyeball.”"
                            }
                        ]
