                                        "sense_id": "4b43b068-381d-3914-9149-6e0f7b7f2f0b",
                                        "entry_id": "95a7d478-e377-30f8-85ce-885a4a96e4d7",
                                        "glosses": [
                                            "One who gives or causes offense, or does something wrong."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32049a68-12a8-40a3-833d-863ea16435d8",
                                                "sense_id": "4b43b068-381d-3914-9149-6e0f7b7f2f0b",
                                                "text": "Almost all down trains are late, however; the empty wagon trains are probably the worst offenders and one or two hours' late running by them is not unusual."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df6cd585-9dcc-3ae5-9bce-94b285e4147a",
                                        "entry_id": "95a7d478-e377-30f8-85ce-885a4a96e4d7",
                                        "glosses": [
                                            "A person who commits an offense against the law, a lawbreaker."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
