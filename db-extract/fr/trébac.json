                        "examples": [
                            {
                                "example_id": "4cfb7e41-1ea3-4b6f-b11a-70416c2df406",
                                "sense_id": "ba98ecd9-405a-3b6d-8aa2-276b2dab3adf",
                                "text": "Une autre espèce de navire très-commune à Venise, et qui sert particulièrement à ses communications avec Trieste et les ports de l’Istrie, ce sont des trébacs de soixante à quatre-vingts tonneaux."
                            },
                            {
                                "example_id": "f96be3e9-aa34-4162-99ae-b52c3ec0848b",
                                "sense_id": "ba98ecd9-405a-3b6d-8aa2-276b2dab3adf",
                                "text": "Les lourds chariots peints, dételés, encombraient la plage, au pied des murailles, et quantité de barques et de trébacs, dont plusieurs portaient à leurs voiles des bandes noires, en signe de deuil, ne cessaient encore d’aborder."
                            }
                        ]
                    }
