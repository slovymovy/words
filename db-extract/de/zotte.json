                "senses": [
                    {
                        "sense_id": "716d873b-0caf-341a-8ad1-43ed78ad154d",
                        "entry_id": "fa706d91-cc0b-3c83-b024-aaed6718a12a",
                        "glosses": [
                            "a flock of hair or fur clotted by moisture, dirt etc."
                        ],
                        "tags": [
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "aa3e3af7-ceb8-4c9b-88a3-afaa76e528b2",
                                "sense_id": "716d873b-0caf-341a-8ad1-43ed78ad154d",
                                "text": "Der Eisbär stieg aus dem Wasser und schüttelte seine nassen Zotten.",
                                "translation": "The polar bear got out of the water and shook his wet fur.",
                                "english": "The polar bear got out of the water and shook his wet fur."
                            },
                            {
                                "example_id": "00c138a0-0485-41ef-aa46-56272aa24f7a",
                                "sense_id": "716d873b-0caf-341a-8ad1-43ed78ad154d",
                                "text": "Das Fell des Raubthiers, das buntgefleckte, und die Zotten des Forschenden, Suchenden, Erobernden!",
                                "translation": "Thus Spoke Zarathustra",
                                "english": "Thus Spoke Zarathustra"
                            }
                        ]
                    }
                ],
