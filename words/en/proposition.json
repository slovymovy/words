                                "target_lang_sense_clarification": "предварительный вариант документа"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "95d31cfc-5198-3c84-855e-d26266f343d0",
                    "sense_definition": "A statement or assertion that expresses a judgment or can be proven true or false.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "logic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In formal logic, a <w>proposition</w> must be clearly defined as either true or false.",
                            "target_lang_translations": {
                                "ru": "В формальной логике <w>суждение</w> должно быть четко определено как истинное или ложное."
                            }
                        },
                        {
                            "text": "The philosopher argued that every <w>proposition</w> carries a specific truth value.",
                            "target_lang_translations": {
                                "ru": "Философ утверждал, что каждое <w>утверждение</w> несет в себе определенное значение истинности."
                            }
                        }
                    ],
                    "synonyms": [
                        "statement"
                    ],
                    "common_phrases": [
                        "logical proposition",
                        "true proposition"
                    ],
                    "target_lang_definitions": {
                        "ru": "Утверждение или суждение, которое может быть истинным или ложным."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "утверждение",
                                "target_lang_sense_clarification": "логическое высказывание"
                            },
                            {
                                "target_lang_word": "суждение",
                                "target_lang_sense_clarification": "логическая форма мысли"
                            },
                            {
                                "target_lang_word": "положение",
                                "target_lang_sense_clarification": "тезис"
                            }
