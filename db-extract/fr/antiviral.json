                    }
                ],
                "senses": [
                    {
                        "sense_id": "6d48b533-2ac1-39b2-9427-d3476c40121b",
                        "entry_id": "238ce69a-5f2e-3e28-b984-ca02bb81dac0",
                        "glosses": [
                            "Molécule perturbant le cycle de réplication d'un ou de plusieurs virus, permettant ainsi de ralentir et plus rarement de stopper une infection virale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "710edceb-448a-4cfa-b58d-04e01a605fe4",
                                "sense_id": "6d48b533-2ac1-39b2-9427-d3476c40121b",
                                "text": "Laxatif léger, c’est également un antiviral et un cardio-protecteur."
                            },
                            {
                                "example_id": "ec449ad7-ea43-485e-8894-0cabd8c75a41",
                                "sense_id": "6d48b533-2ac1-39b2-9427-d3476c40121b",
                                "text": "Comme pour les bactéries, l’antiviral sélectionne les mutants résistants et, plus une molécule est utilisée, plus le risque de voir apparaître une souche qui échappe à son contrôle est élevé."
                            },
                            {
                                "example_id": "7b688a53-f56c-4841-a68e-f2483c04df6b",
                                "sense_id": "6d48b533-2ac1-39b2-9427-d3476c40121b",
                                "text": "Contre les virus, les deux remèdes sont les vaccins et les antiviraux."
                            }
                        ]
                    }
