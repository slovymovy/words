                        "examples": [
                            {
                                "example_id": "ae5544ce-e1af-4f7c-b274-d221fd7522ad",
                                "sense_id": "5cb81918-4843-3547-81ab-e04e9f3480c3",
                                "text": "[…] but remember still that if there be an ague, you ioyne with them the aforesayd great cooling seeds, or the lesse cooling seeds, of lettise, endive, scariole […]"
                            },
                            {
                                "example_id": "3c4691d5-73ab-41e7-b2b5-0d5c3f0873a9",
                                "sense_id": "5cb81918-4843-3547-81ab-e04e9f3480c3",
                                "text": "To have Syrup of Succory compounded with Rhubarb; Take ſome whole Barley-Corns, the Roots of Smallage, Fennel, and Sparagraſs, with some white crude Tartar, of each two Ounces; two Leaves of Succory, Dandelion, Endive or Scariole, ſmooth Sow-Thiſtle, common Lettice, and Sage […]"
                            },
                            {
                                "example_id": "6a00c3c8-6553-4f0c-81e9-c19aedb7f47e",
                                "sense_id": "5cb81918-4843-3547-81ab-e04e9f3480c3",
                                "text": "The varieties most commonly cultivated are the Broad-leaved Batavian, and Small Batavian ; the Green Curled-leaved, and the White Curled-leaved. By the French the former are called Scarioles; the latter, Cichorées."
                            }
                        ]
