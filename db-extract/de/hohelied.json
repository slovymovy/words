                "senses": [
                    {
                        "sense_id": "63bf105f-0f5b-3ad2-80e1-644f3400ea6c",
                        "entry_id": "1078f076-2472-3055-953b-75d2192eeec0",
                        "glosses": [
                            "ein Buch des Alten Testaments, das aus einer Sammlung von Liebes- und Hochzeitsliedern besteht und der Weisheitsliteratur nahesteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f3deeef-f13c-473b-8436-b9549cc12e97",
                                "sense_id": "63bf105f-0f5b-3ad2-80e1-644f3400ea6c",
                                "text": "„Das Hohelied ist auf vielerlei Weise interpretiert worden und hat eine lange Auslegungsgeschichte.“"
                            },
                            {
                                "example_id": "93be88c8-d1fc-4cc7-aecd-fff203f8d6fe",
                                "sense_id": "63bf105f-0f5b-3ad2-80e1-644f3400ea6c",
                                "text": "„Der Verfasser des Hohelieds verfügt über ursprüngliche dichterische Kraft und ist ein guter Kenner der Heiligen Schrift.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
