                                        "sense_id": "ea9fd8d9-a715-31a1-b202-6d86ea010762",
                                        "entry_id": "6ea3971a-cc3a-34df-a0d2-ac0a62ce3d95",
                                        "glosses": [
                                            "beim Drucken versehentlich unterlaufener Schreibfehler (vor allem Rechtschreibfehler)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5774c7b1-bfe9-4763-b876-2f38abc3c84f",
                                                "sense_id": "ea9fd8d9-a715-31a1-b202-6d86ea010762",
                                                "text": "Viele Druckfehler werden heute durch Rechtschreibprogramme entdeckt."
                                            },
                                            {
                                                "example_id": "dd659f95-b0e6-46d6-8f68-de5f12f612a1",
                                                "sense_id": "ea9fd8d9-a715-31a1-b202-6d86ea010762",
                                                "text": "„Er wollte mir einen Druckfehler zeigen, den er sehr komisch fand.“"
                                            },
                                            {
                                                "example_id": "6247b596-c63f-4602-a333-137a8393b7e5",
                                                "sense_id": "ea9fd8d9-a715-31a1-b202-6d86ea010762",
                                                "text": "„Er hatte sich über ein paar Druckfehler geärgert, über die Schlagzeile auf der ersten Seite hatte er sich gefreut.“"
                                            },
                                            {
                                                "example_id": "fbee7db4-c24d-42c7-8bf4-430184008496",
                                                "sense_id": "ea9fd8d9-a715-31a1-b202-6d86ea010762",
                                                "text": "„Heute als klassische Druckfehler bekannte Lapsus wie Schusterjungen und Hurenkinder hingegen begegnen zumindest in der deutschen Fassung des »Mechanismus« gar nicht.“"
                                            },
                                            {
                                                "example_id": "108a1778-91aa-4699-9952-e8820693b849",
                                                "sense_id": "ea9fd8d9-a715-31a1-b202-6d86ea010762",
                                                "text": "„Bosse gab sich damit zufrieden, dass dieser Druckfehler eben dort war, er machte sich nicht die Mühe herauszufinden, wie er dort hingeraten war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
