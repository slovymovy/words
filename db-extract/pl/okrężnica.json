                                        "entry_id": "1c57619a-cdb4-3cdf-85bb-6da8d6ceb9ca",
                                        "glosses": [
                                            "A husbandman."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "65105553-e50b-3a08-9aee-b1faa4662965",
                                        "entry_id": "1c57619a-cdb4-3cdf-85bb-6da8d6ceb9ca",
                                        "glosses": [
                                            "A European colonial settler, especially in a French colony."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ae63cc4-f8c6-4e1e-86e4-b80fca7899f5",
                                                "sense_id": "65105553-e50b-3a08-9aee-b1faa4662965",
                                                "text": "The reaction of the European colons, a mixture of shock and fear, was to demand further draconian measures and to suspend any suggestion of new reforms."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
