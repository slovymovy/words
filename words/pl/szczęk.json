                        {
                            "text": "Badania wykazały różnice w budowie <w>szczęk</w> u różnych gatunków.",
                            "target_lang_translations": {
                                "ru": "Исследования выявили различия в строении <w>челюстей</w> у разных видов."
                            }
                        }
