                        "examples": [
                            {
                                "example_id": "112d5677-5f7a-43ec-900e-b8bf681571fb",
                                "sense_id": "360131e7-0098-3bfa-bc35-110d6f0978ff",
                                "text": "Hij bracht bloemen mee om hun trouwdag te vieren."
                            }
                        ]
