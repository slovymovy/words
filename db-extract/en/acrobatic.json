                                        "examples": [
                                            {
                                                "example_id": "7b538adf-c511-46d8-a03c-5db65c3b4936",
                                                "sense_id": "ad29646f-0fdf-301e-9b9d-52370868cd70",
                                                "text": "Die Artisten begeisterten im Zirkus ihr Publikum mit akrobatischen Übungen."
