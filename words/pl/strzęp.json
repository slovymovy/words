                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "nazwisko",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Pani <w>Strzęp</w> prowadzi dzisiaj wykład.",
                            "target_lang_translations": {
                                "ru": "Госпожа <w>Струп</w> ведет сегодня лекцию."
                            }
                        },
                        {
                            "text": "Spotkałem się z panią <w>Strzęp</w> w kawiarni.",
                            "target_lang_translations": {
                                "ru": "Я встретился с госпожой <w>Струп</w> в кафе."
                            }
                        }
                    ],
                    "traits": [
