                                "target_senses": [
                                    {
                                        "sense_id": "5007614a-2c9f-346c-8148-79eed3e79820",
                                        "entry_id": "b172d598-0612-366b-bcb0-716560468eb1",
                                        "glosses": [
                                            "An engraver, designer or maker of medals."
                                        ],
                                        "tags": [
                                            "US"
