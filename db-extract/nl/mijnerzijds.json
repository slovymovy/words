                                        "entry_id": "5ba5b14f-2b9d-346c-bda7-cfd5df811693",
                                        "glosses": [
                                            "von mir aus, von meiner Seite aus, was mich betrifft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e065b7ec-3d86-4d35-b077-8de975b07088",
                                                "sense_id": "46bed290-ad3d-3140-8e82-391778a424a9",
                                                "text": "Ich möchte mich für das dumme Verhalten meinerseits entschuldigen."
                                            },
                                            {
                                                "example_id": "418c8c09-221f-400f-9985-5f8a065971cf",
                                                "sense_id": "46bed290-ad3d-3140-8e82-391778a424a9",
                                                "text": "Ich habe meinerseits keine Einwände."
                                            },
                                            {
                                                "example_id": "bdd16b10-5f36-4c22-a777-c038e844877d",
                                                "sense_id": "46bed290-ad3d-3140-8e82-391778a424a9",
                                                "text": "„Dieser schien von seinem Versprechen Abstand nehmen zu wollen, und es bedurfte einiger Überredungskunst meinerseits, ihn dazu zu bringen, sein Wort zu halten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
