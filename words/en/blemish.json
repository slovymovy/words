{
    "word_family": [
        "unblemished"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c8a4a584-5c4f-3821-a4cc-b6e9a4b2e71d",
                    "sense_definition": "A small flaw, spot, or stain that spoils the appearance of something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "flaw",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She used a concealer to hide the small <w>blemish</w> on her cheek.",
                            "target_lang_translations": {
                                "es": "Usó un corrector para disimular la pequeña <w>imperfección</w> de su mejilla."
                            }
                        },
                        {
                            "text": "The antique table had a tiny <w>blemish</w> on the surface from years of use.",
                            "target_lang_translations": {
                                "es": "La mesa antigua tenía una pequeña <w>mancha</w> en la superficie por los años de uso."
                            }
                        }
                    ],
                    "synonyms": [
                        "flaw",
                        "spot",
                        "stain",
                        "imperfection"
                    ],
                    "common_phrases": [
                        "skin blemish",
                        "minor blemish"
                    ],
                    "target_lang_definitions": {
                        "es": "Pequeño defecto, marca o mancha que arruina el aspecto de algo."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "mancha",
                                "target_lang_sense_clarification": "marca o imperfección visible en una superficie o la piel"
                            },
                            {
                                "target_lang_word": "imperfección",
                                "target_lang_sense_clarification": "pequeño defecto físico o estético"
                            },
                            {
                                "target_lang_word": "tara",
                                "target_lang_sense_clarification": "defecto de fabricación o material que disminuye el valor"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "211ec2ef-b7f3-3192-b98b-83ffea62b383",
                    "sense_definition": "A moral defect or a flaw in someone's character.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "flaw",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His dishonesty was a serious <w>blemish</w> on his otherwise respectable character.",
                            "target_lang_translations": {
                                "es": "Su deshonestidad fue una grave <w>mancha</w> en su por lo demás respetable carácter."
                            }
                        },
                        {
                            "text": "A lack of empathy is often considered a significant <w>blemish</w> in a leader.",
                            "target_lang_translations": {
                                "es": "La falta de empatía se considera a menudo un <w>defecto</w> importante en un líder."
                            }
                        }
                    ],
                    "synonyms": [
                        "defect",
                        "fault",
                        "failing"
                    ],
                    "target_lang_definitions": {
                        "es": "Defecto moral o imperfección en el carácter de una persona."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "defecto",
                                "target_lang_sense_clarification": "falta o imperfección moral"
                            },
                            {
                                "target_lang_word": "mancha",
                                "target_lang_sense_clarification": "deshonra o mácula en el historial de alguien"
                            },
                            {
                                "target_lang_word": "mácula",
                                "target_lang_sense_clarification": "falta moral o desdoro ético"
                            },
                            {
                                "target_lang_word": "tacha",
                                "target_lang_sense_clarification": "falta que hace imperfecta una conducta o carácter"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6a9f8e0e-57a1-3953-a954-421d598bcdd9",
                    "sense_definition": "To spoil or damage the appearance of something.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "spoil",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heavy rain did not <w>blemish</w> the beauty of the garden.",
                            "target_lang_translations": {
                                "es": "La fuerte lluvia no logró <w>deslucir</w> la belleza del jardín."
                            }
                        },
                        {
                            "text": "Poor construction can <w>blemish</w> the look of a modern building.",
                            "target_lang_translations": {
                                "es": "Una mala construcción puede <w>estropear</w> el aspecto de un edificio moderno."
                            }
                        }
                    ],
                    "synonyms": [
                        "mar",
                        "spoil",
                        "damage"
                    ],
                    "target_lang_definitions": {
                        "es": "Arruinar, afear o estropear la apariencia de algo."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "deslucir",
                                "target_lang_sense_clarification": "quitar el lustre, la gracia o la belleza física"
                            },
                            {
                                "target_lang_word": "estropear",
                                "target_lang_sense_clarification": "dañar el aspecto o la calidad de algo"
                            },
                            {
                                "target_lang_word": "manchar",
                                "target_lang_sense_clarification": "dejar una marca que afea una superficie"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0fdf66ad-2f9a-3089-aab1-70c3cff05147",
                    "sense_definition": "To damage or tarnish someone's reputation or character.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "spoil",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scandal served to <w>blemish</w> his long-standing reputation in the community.",
                            "target_lang_translations": {
                                "es": "El escándalo sirvió para <w>mancillar</w> su reputación de tantos años en la comunidad."
                            }
                        },
                        {
                            "text": "He feared that the false accusations would <w>blemish</w> his professional record.",
                            "target_lang_translations": {
                                "es": "Temía que las falsas acusaciones fueran a <w>manchar</w> su historial profesional."
                            }
                        }
                    ],
                    "synonyms": [
                        "tarnish",
                        "stain",
                        "sully"
                    ],
                    "target_lang_definitions": {
                        "es": "Dañar o empañar la reputación o el honor de alguien."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "manchar",
                                "target_lang_sense_clarification": "ensuciar la reputación o trayectoria"
                            },
                            {
                                "target_lang_word": "mancillar",
                                "target_lang_sense_clarification": "perjudicar o deshonrar el honor o la fama"
                            },
                            {
                                "target_lang_word": "empañar",
                                "target_lang_sense_clarification": "quitar el brillo o prestigio a un historial o reputación"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}