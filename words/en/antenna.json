{
    "word_family": [
        "antennal",
        "antennary",
        "antennule"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "00a69c3c-1432-3735-9d1a-55a779cf1ade",
                    "sense_definition": "An apparatus to receive or transmit electromagnetic waves and convert them into electrical signals.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We need to adjust the TV <w>antenna</w> to get a better picture.",
                            "target_lang_translations": {
                                "ru": "Нам нужно отрегулировать телевизионную <w>антенну</w>, чтобы улучшить изображение.",
                                "zh": "我们需要调整电视<w>天线</w>以获得更好的画面。"
                            }
                        },
                        {
                            "text": "The car has a small radio <w>antenna</w> mounted on the roof.",
                            "target_lang_translations": {
                                "ru": "На крыше автомобиля установлена небольшая радио<w>антенна</w>.",
                                "zh": "这辆车的车顶上装有一个小型收音机<w>天线</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "aerial"
                    ],
                    "common_phrases": [
                        "radio antenna",
                        "TV antenna",
                        "satellite antenna"
                    ],
                    "target_lang_definitions": {
                        "ru": "Устройство для приема или передачи электромагнитных волн и преобразования их в электрические сигналы.",
                        "zh": "用于接收或发射电磁波并将其转换为电信号的设备。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "антенна",
                                "target_lang_sense_clarification": "техническое устройство"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "天线",
                                "target_lang_sense_clarification": "无线电或电视接收设备"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "21cb8c31-908e-3dbc-a28a-0b6a2d32de6e",
                    "sense_definition": "An appendage used for sensing on the head of an insect, crab, or other animal.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The beetle lost one <w>antenna</w> during the fight with a predator.",
                            "target_lang_translations": {
                                "ru": "Жук потерял один <w>усик</w> во время схватки с хищником.",
                                "zh": "那只甲虫在与捕食者的搏斗中失去了一根<w>触角</w>。"
                            }
                        },
                        {
                            "text": "An insect uses its <w>antenna</w> to smell and feel its surroundings.",
                            "target_lang_translations": {
                                "ru": "Насекомое использует свои <w>усики</w>, чтобы обонять и осязать окружающее пространство.",
                                "zh": "昆虫利用它的<w>触角</w>来嗅探和感知周围的环境。"
                            }
                        }
                    ],
                    "synonyms": [
                        "feeler"
                    ],
                    "common_phrases": [
                        "insect antenna",
                        "long antennae"
                    ],
                    "target_lang_definitions": {
                        "ru": "Подвижный придаток на голове насекомого, ракообразного или другого животного, служащий органом чувств.",
                        "zh": "昆虫、甲壳动物或其他动物头部用于感知的附属器官。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "усик",
                                "target_lang_sense_clarification": "орган чувств насекомых"
                            },
                            {
                                "target_lang_word": "антенна",
                                "target_lang_sense_clarification": "зоологический термин"
                            },
                            {
                                "target_lang_word": "сяжок",
                                "target_lang_sense_clarification": "энтомологический термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "触角",
                                "target_lang_sense_clarification": "昆虫的感知器官"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b5b64bb1-196f-3887-940a-ecf87aff27e9",
                    "sense_definition": "The faculty of intuitive astuteness or sensitivity to the surrounding atmosphere.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her political <w>antenna</w> warned her that the situation was becoming dangerous.",
                            "target_lang_translations": {
                                "ru": "Её политическое <w>чутьё</w> предупредило её, что ситуация становится опасной.",
                                "zh": "她敏锐的政治<w>直觉</w>提醒她局势正变得危险。"
                            }
                        },
                        {
                            "text": "He has a sensitive <w>antenna</w> for detecting lies during negotiations.",
                            "target_lang_translations": {
                                "ru": "У него тонкое <w>чутьё</w> на ложь во время переговоров.",
                                "zh": "他在谈判中有一种能察觉谎言的敏锐<w>直觉</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "acumen",
                        "perspicacity"
                    ],
                    "common_phrases": [
                        "sensitive antenna",
                        "political antenna"
                    ],
                    "target_lang_definitions": {
                        "ru": "Способность интуитивно чувствовать атмосферу или ситуацию; проницательность.",
                        "zh": "对周围环境或氛围的直觉感知能力或敏锐度。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чутьё",
                                "target_lang_sense_clarification": "интуиция"
                            },
                            {
                                "target_lang_word": "интуиция",
                                "target_lang_sense_clarification": "шестое чувство"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "直觉",
                                "target_lang_sense_clarification": "对事物的敏锐感知"
                            },
                            {
                                "target_lang_word": "敏锐度",
                                "target_lang_sense_clarification": "对局势的洞察力"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2e0ec5f5-bffa-356c-9218-521fa102e7b4",
                    "sense_definition": "The spar to which a lateen sail is attached, which is then hoisted up the mast.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sailors lowered the heavy <w>antenna</w> to the deck for repairs.",
                            "target_lang_translations": {
                                "ru": "Матросы спустили тяжелый <w>рюк</w> на палубу для ремонта.",
                                "zh": "水手们把沉重的<w>帆桁</w>降到甲板上进行修理。"
                            }
                        },
                        {
                            "text": "A traditional lateen sail hangs from a long, curved <w>antenna</w>.",
                            "target_lang_translations": {
                                "ru": "Традиционный латинский парус свисает с длинного изогнутого <w>рюка</w>.",
                                "zh": "传统的三角帆悬挂在一根长而弯曲的<w>帆桁</w>上。"
                            }
                        }
                    ],
                    "synonyms": [
                        "yard"
                    ],
                    "target_lang_definitions": {
                        "ru": "Рея (рангоутное дерево), к которой крепится латинский парус.",
                        "zh": "用于悬挂三角帆的横杆，通常被升至桅杆上。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рюк",
                                "target_lang_sense_clarification": "морской термин"
                            },
                            {
                                "target_lang_word": "рей",
                                "target_lang_sense_clarification": "часть рангоута"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "帆桁",
                                "target_lang_sense_clarification": "航海术语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "beddd1c0-e94e-36a7-b466-a306bb4ca266",
                    "sense_definition": "A fragment of an oligosaccharide.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scientist analyzed the structure of the sugar <w>antenna</w> on the cell.",
                            "target_lang_translations": {
                                "ru": "Ученый проанализировал структуру сахарной <w>антенны</w> на клетке.",
                                "zh": "科学家分析了细胞上糖链<w>天线</w>的结构。"
                            }
                        },
                        {
                            "text": "This molecular <w>antenna</w> plays a key role in the chemical reaction.",
                            "target_lang_translations": {
                                "ru": "Эта молекулярная <w>антенна</w> играет ключевую роль в химической реакции.",
                                "zh": "这种分子<w>天线</w>在化学反应中起着关键作用。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фрагмент молекулы олигосахарида.",
                        "zh": "寡糖链的一个片段。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "антенна",
                                "target_lang_sense_clarification": "биохимический термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "天线",
                                "target_lang_sense_clarification": "生物化学术语"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}