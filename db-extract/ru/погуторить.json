                "senses": [
                    {
                        "sense_id": "3b9d940b-db53-3898-a5af-50793b80b652",
                        "entry_id": "2ac264a5-ddce-38db-abbd-009e24124621",
                        "glosses": [
                            "рег., прост. поговорить, побеседовать, побалагурить"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d75fc7ea-dec4-446f-8e26-d7260204aa41",
                                "sense_id": "3b9d940b-db53-3898-a5af-50793b80b652",
                                "text": "Девушки крестьянские зайдут, погуторят; странница забредёт, станет про Иерусалим рассказывать, про Киев, про святые города."
                            },
                            {
                                "example_id": "184024b1-d7eb-495c-adc2-243a622a7bb1",
                                "sense_id": "3b9d940b-db53-3898-a5af-50793b80b652",
                                "text": "— Иди, сударушка, покурим, — продолжал дед, — погуторь с Кастрюком."
                            },
                            {
                                "example_id": "cf4b8281-fc7c-465e-88b2-186f45dde9f8",
                                "sense_id": "3b9d940b-db53-3898-a5af-50793b80b652",
                                "text": "Филипп взял посох и пошел на Чухлинку погуторить со старостой."
                            }
                        ]
                    }
                ],
