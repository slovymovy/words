                "senses": [
                    {
                        "sense_id": "0f746e7d-23f3-37e7-942b-0306762f0910",
                        "entry_id": "dccc1bdc-c4cb-3bf9-980a-b2524ee30602",
                        "glosses": [
                            "Sammlung von Internetseiten, die sich untereinander zirkulär verlinken"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "ffa084d4-b84c-48a1-995e-e768670df533",
                                "sense_id": "0f746e7d-23f3-37e7-942b-0306762f0910",
                                "text": "„Mit www.blinde-kuh.de existiert sogar eine eigene Suchmaschine für Kinder und mit www.seitenstark.de ein Webring mit vielen Seiten für Kinder.“"
                            },
                            {
                                "example_id": "6c7b3eaf-a5d8-4c67-aa7b-6e59b2ecaef8",
                                "sense_id": "0f746e7d-23f3-37e7-942b-0306762f0910",
                                "text": "„Und natürlich hat die Szene mit ‚Klick Heil‘ auch schon einen eigenen Webring - auch dabei lassen sich die Teilnehmer übrigens problemlos nachvollziehen.“"
                            },
                            {
                                "example_id": "42eb3ead-0d77-4469-9980-fd4a95c9d820",
                                "sense_id": "0f746e7d-23f3-37e7-942b-0306762f0910",
                                "text": "„Individuelle Sites würden sich dagegen durch interaktive Kommunikationsformen, Zusammenschlüsse bis hin zu Webrings auszeichnen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
