                "senses": [
                    {
                        "sense_id": "a6dea38f-26e1-36d3-85f5-12dab0fddb87",
                        "entry_id": "934cb532-697e-356d-b9da-ac1a365df2d2",
                        "glosses": [
                            "Garnir de courtines, de tapisseries, de rideaux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a38f7a9-7163-4130-bd8f-aead1bb2f783",
                                "sense_id": "a6dea38f-26e1-36d3-85f5-12dab0fddb87",
                                "text": "Qu’il soit encourtiné de brocart ou de serge,\nTriste comme une tombe ou joyeux comme un nid,\nC’est là que l’homme naît, se repose et s’unit,\nEnfant, époux, vieillard, aïeule, femme ou vierge."
                            },
                            {
                                "example_id": "487e1b39-7a72-4339-9977-63493b7880ea",
                                "sense_id": "a6dea38f-26e1-36d3-85f5-12dab0fddb87",
                                "text": "[…] un lit à quenouilles encourtiné de cretonne bleue et blanche."
                            }
                        ]
                    }
                ],
