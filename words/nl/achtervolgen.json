{
    "word_family": [
        "achtervolger",
        "achtervolging"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "630af159-a728-3fd3-93d4-eba8fd296657",
                    "sense_definition": "iemand of iets proberen in te halen of te vangen door erachteraan te gaan",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "achtervolgen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De politie moest de dief door de smalle straten <w>achtervolgen</w>.",
                            "target_lang_translations": {
                                "en": "The police had to <w>chase</w> the thief through the narrow streets."
                            }
                        },
                        {
                            "text": "De hond begon de kat fanatiek te <w>achtervolgen</w> in de tuin.",
                            "target_lang_translations": {
                                "en": "The dog began to fanatically <w>pursue</w> the cat in the garden."
                            }
                        }
                    ],
                    "synonyms": [
                        "nazitten",
                        "vervolgen",
                        "achternazitten",
                        "najagen"
                    ],
                    "antonyms": [
                        "vluchten",
                        "ontsnappen"
                    ],
                    "common_phrases": [
                        "iemand achtervolgen",
                        "een verdachte achtervolgen"
                    ],
                    "target_lang_definitions": {
                        "en": "to try to catch or overtake someone or something by following them"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "chase",
                                "target_lang_sense_clarification": "to follow quickly in order to catch"
                            },
                            {
                                "target_lang_word": "pursue",
                                "target_lang_sense_clarification": "to follow urgently or formally, often with intent to capture"
                            },
                            {
                                "target_lang_word": "chase after",
                                "target_lang_sense_clarification": "to run after someone or something"
                            },
                            {
                                "target_lang_word": "follow",
                                "target_lang_sense_clarification": "to go after someone"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dcb55899-ce1d-3723-acf2-deb846b1d308",
                    "sense_definition": "voortdurend in iemands gedachten aanwezig blijven op een vervelende manier",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "mentale_toestand",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het beeld van het ernstige ongeluk <w>achtervolgde</w> hem de hele dag.",
                            "target_lang_translations": {
                                "en": "The image of the serious accident <w>haunted</w> him all day."
                            }
                        },
                        {
                            "text": "Die nare herinnering bleef haar jarenlang <w>achtervolgen</w>.",
                            "target_lang_translations": {
                                "en": "That nasty memory continued to <w>haunt</w> her for years."
                            }
                        }
                    ],
                    "synonyms": [
                        "beheksen",
                        "obsederen",
                        "kwellen"
                    ],
                    "antonyms": [
                        "vergeten",
                        "loslaten"
                    ],
                    "common_phrases": [
                        "blijven achtervolgen",
                        "een herinnering achtervolgt"
                    ],
                    "target_lang_definitions": {
                        "en": "to remain constantly and unpleasantly present in someone's thoughts"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "haunt",
                                "target_lang_sense_clarification": "of a memory or thought, to stay in the mind"
                            },
                            {
                                "target_lang_word": "dog",
                                "target_lang_sense_clarification": "to follow or plague someone persistently"
                            },
                            {
                                "target_lang_word": "plague",
                                "target_lang_sense_clarification": "to cause continual trouble or distress"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}