                            },
                            {
                                "target_lang_word": "verstärkte",
                                "target_lang_sense_clarification": "Präteritum von verstärken / stabilisieren"
                            },
                            {
                                "target_lang_word": "wappnete",
                                "target_lang_sense_clarification": "Präteritum von sich wappnen / vorbereiten"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "2656ee97-f44e-30ef-b3c4-d53061e730f4",
                    "sense_definition": "Strengthened, reinforced, or supported with braces or struts.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
