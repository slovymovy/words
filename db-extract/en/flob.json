                        "entry_id": "b1b3f53c-66a7-3fd8-960c-5ceecb75030e",
                        "glosses": [
                            "To spit or to gob."
                        ],
                        "tags": [
                            "UK",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "bb88d0a3-a7ee-467a-818f-7b9f3da87348",
                                "sense_id": "32e5eee9-cae1-3f0d-a050-8a594079ba59",
                                "text": "Every day she would flob on Zoe’s head from the flats as the little girl walked to school. And every day Tina would laugh, as if it was the funniest thing in the world."
                            },
                            {
                                "example_id": "a66ac9df-3ff7-4b96-85e6-56d8c9c27b42",
                                "sense_id": "32e5eee9-cae1-3f0d-a050-8a594079ba59",
                                "text": "I pointed out that they both looked equally unhappy, and that he was essentially kicking himself. He contemplated this for a moment, then flobbed at me and kicked the weakling slightly harder."
                            }
                        ]
                    }
