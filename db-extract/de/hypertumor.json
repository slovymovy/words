                "senses": [
                    {
                        "sense_id": "32a517e6-916a-3059-ae72-a4105c7413d2",
                        "entry_id": "a0b00364-312b-31f3-890e-1f1e22f78708",
                        "glosses": [
                            "Ansammlung extrem aggressiver Zellen, die in einem Tumor wächst und dessen Wachstum und Lebensfähigkeit dadurch schwächt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9ae7696-6c2c-4cf5-83d8-e91e4edae9b7",
                                "sense_id": "32a517e6-916a-3059-ae72-a4105c7413d2",
                                "text": "„Die Überraschung: Hypertumore tauchten häufiger bei großen Tieren auf als bei kleinen.“"
                            },
                            {
                                "example_id": "ef60dfca-b740-4a05-a0db-9f9d0f9f48bb",
                                "sense_id": "32a517e6-916a-3059-ae72-a4105c7413d2",
                                "text": "„Hypertumore wurden nach Hyperparasiten benannt. Den Parasiten von Parasiten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1832ce95-d5bd-49a5-9d14-1de3fc1d34ed",
                        "source_entry_id": "a0b00364-312b-31f3-890e-1f1e22f78708",
                        "source_sense_id": "32a517e6-916a-3059-ae72-a4105c7413d2",
                        "target_lang_word": "hypertumor",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hypertumor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "141783fc-3432-39f5-8ef3-bac01457855d",
                                        "entry_id": "de97b3d0-ea63-33bb-976f-e3b22d57ff7c",
                                        "glosses": [
                                            "A tumor that invades and destroys part of a previously existing tumor."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4992cdd-33e4-4967-b216-65bebeeaa653",
                                                "sense_id": "141783fc-3432-39f5-8ef3-bac01457855d",
                                                "text": "Clinically, hypertumors could be related to several paradoxical classes of tumors which, despite showing an aggressive histology, tend to spontaneously regress, such as some cases of neuroblastoma."
                                            },
                                            {
                                                "example_id": "93ec86d7-e81c-4beb-9e82-5c03317d9e78",
                                                "sense_id": "141783fc-3432-39f5-8ef3-bac01457855d",
                                                "text": "In particular, one will recognize a hypertumor not just as regions of nutrient deficiency but as regions of nutrient deficency that always correlate with invading cells displaying cytological or genetic features of aggressive proliferation."
                                            },
                                            {
                                                "example_id": "34cfaba1-1c4f-4db1-8cfd-f03d733702ed",
                                                "sense_id": "141783fc-3432-39f5-8ef3-bac01457855d",
                                                "text": "They argue that tumors must be drastically larger in larger animals to be lethal, giving the hypertumor more time to grow and force the parent tumor to become necrotic."
                                            },
                                            {
                                                "example_id": "bd640052-d139-4c05-9c0c-7e52e84f477c",
                                                "sense_id": "141783fc-3432-39f5-8ef3-bac01457855d",
                                                "text": "According to the hypertumor hypothesis, as tumors grow larger, younger malignant cells take over their parents and outstrip them of their blood supply, resulting in tumor ischemic necrosis."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
