                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c5613391-44d0-3717-ba6c-a26c32a018c8",
                                        "entry_id": "6e00e7ac-8623-3d40-b685-0d22d8654b33",
                                        "glosses": [
                                            "Os de la mâchoire supérieure."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a752388c-69a4-45fc-80f5-4de33c39a3da",
                                                "sense_id": "c5613391-44d0-3717-ba6c-a26c32a018c8",
                                                "text": "Le maxillaire supérieur indique la place normale de quatorze dents; l’incisive gauche fait défaut, ainsi que la première grosse molaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5438655a-d797-364e-b97e-a0fdceb57dcd",
                                        "entry_id": "6e00e7ac-8623-3d40-b685-0d22d8654b33",
                                        "glosses": [
                                            "Genre d'orchidée d'Amérique, comprenant une centaine d'espèces."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec5a0b59-b904-4b75-a52e-eb16ef767082",
                                                "sense_id": "5438655a-d797-364e-b97e-a0fdceb57dcd",
                                                "text": "Le Mexique est la patrie de cette maxillaire, dont la fleur exhale une odeur suave de cannelle."
                                            }
                                        ]
