                        "entry_id": "f330e368-794f-31a2-b0a4-00d9e7b45349",
                        "glosses": [
                            "Personne qui pleure, qui crie, animal bruyant. Braillard."
                        ],
                        "tags": [
                            "Régionalisme"
                        ],
                        "examples": [
                            {
                                "example_id": "80c13f07-a2c3-4515-8738-a84055a17e6f",
                                "sense_id": "afa6f8cf-c814-3f0e-92cf-a75b490f9027",
                                "text": "Malheur, encore un clebs ! Et un braillou ! Voilà, qu'on était tranquilles et faut que l'autre ramène son malheur."
                            },
                            {
                                "example_id": "43318504-6f2a-4af0-a290-58e4cd623511",
                                "sense_id": "afa6f8cf-c814-3f0e-92cf-a75b490f9027",
                                "text": "Les brigands ne lui faisaient pas peur : avec son détachement, il se faisait fort de mater ces « brailloux » qui n'avaient même pas d'armes."
                            }
                        ]
                    },
                    {
                        "sense_id": "9b57f1fe-8b83-302d-a37c-a841ef4e1e9b",
                        "entry_id": "f330e368-794f-31a2-b0a4-00d9e7b45349",
                        "glosses": [
                            "Jeune enfant."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "81cfedf1-f99d-4dc0-84ab-af600dd90888",
                                "sense_id": "9b57f1fe-8b83-302d-a37c-a841ef4e1e9b",
                                "text": "Elle a dit aussi : « Ce n'est pas avec un braillou pareil que tu pouvais espérer garder un mari... »"
                            }
                        ]
                    }
