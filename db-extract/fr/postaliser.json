                "senses": [
                    {
                        "sense_id": "f31f7c4c-e562-358d-a8c1-852b6952c122",
                        "entry_id": "f8767e69-4989-3438-9133-190eb09c047e",
                        "glosses": [
                            "Donner un caractère postal à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ad9aeaf-563d-402e-838f-9db9567f2dd0",
                                "sense_id": "f31f7c4c-e562-358d-a8c1-852b6952c122",
                                "text": "Privatiser La Poste, « postaliser » la société ?"
                            },
                            {
                                "example_id": "0f0fa9d5-d7f2-4d07-9cc4-29a6d4d22bd6",
                                "sense_id": "f31f7c4c-e562-358d-a8c1-852b6952c122",
                                "text": "L'ambiguïté est savamment entretenue par les dirigeants d'Elan, qui s'évertuent à postaliser le Lean pour ne pas effrayer les postiers et leurs représentants, et parallèlement à montrer aux directeurs de DOTC la vertu et la patience du jeu des Cocottes (ou Shadocks) dans les formations."
                            }
                        ]
                    },
                    {
                        "sense_id": "fdbf86ac-78b1-3b28-a401-977b836c5009",
                        "entry_id": "f8767e69-4989-3438-9133-190eb09c047e",
                        "glosses": [
                            "Confier à la poste."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f44816e3-6dd6-4d6a-b8d9-eb3829f69573",
                                "sense_id": "fdbf86ac-78b1-3b28-a401-977b836c5009",
                                "text": "Non, le petit contrat moral passé unilatéralement par Edhisto est que chaque commande passée avant 15 heures est adressée (postalisée ou livrée) le jour-même."
                            }
                        ]
                    }
