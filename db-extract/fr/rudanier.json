                        ],
                        "examples": [
                            {
                                "example_id": "0f24fdb3-b305-4350-83db-fcbf0f842c7f",
                                "sense_id": "508e99a4-6be6-300b-9123-8c7c1e882d4b",
                                "text": "Quels cris ! Quelle fureur ! Ah ! Que vous êtes bouillant, rudanier et sans-gêne avec les pauvres roturiers, monsieur le comte !"
                            },
                            {
                                "example_id": "85d047f0-acad-462c-a92c-b5bc79474abc",
                                "sense_id": "508e99a4-6be6-300b-9123-8c7c1e882d4b",
                                "text": "Il est rudanier, salace, mal odorant."
