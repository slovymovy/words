                "senses": [
                    {
                        "sense_id": "32193e84-8412-3868-bdac-dfec71a32ea7",
                        "entry_id": "ff22a6d6-7139-35ea-955d-df337d833fc9",
                        "glosses": [
                            "Qui concerne ou se trouve dans la ville italienne de Pérouse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "36884a73-da7d-4b32-a3c4-2f94f01f32de",
                                "sense_id": "32193e84-8412-3868-bdac-dfec71a32ea7",
                                "text": "La politique pérugine espère, à force d’adresse, induire la Révolution à croire qu’entre elle et l'Église, il n’y a pas divergence essentielle, et faire ainsi rentrer la Révolution dans l’Église, sans imposer à celle-ci ni à celle-là aucun sacrifice de fond."
                            }
                        ]
                    },
                    {
                        "sense_id": "00d28629-1412-3db7-8618-de68bed643d7",
                        "entry_id": "ff22a6d6-7139-35ea-955d-df337d833fc9",
                        "glosses": [
                            "Du Pérugin, peintre italien de la Renaissance."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "023b1de2-f770-4395-a640-17d294202419",
                                "sense_id": "00d28629-1412-3db7-8618-de68bed643d7",
                                "text": "Peut-on être sotte, quand on sourit avec les lèvres de Mona Lisa ? Mesquine, avec le profil d’une vierge pérugine ? Vulgaire, lorsqu’on a le galbe d’une grande dame de Largillière ?"
                            }
                        ]
                    }
                ],
