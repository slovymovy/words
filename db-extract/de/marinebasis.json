                                "example_id": "b937fd0e-f917-45f5-ac23-09c8f21eac76",
                                "sense_id": "c4046845-45ff-3a71-8e0a-829184ca814c",
                                "text": "„Es wird auch spekuliert, dass die Chinesen Gwadar als Marinebasis einrichten werden.“"
                            }
                        ],
