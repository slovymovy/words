                ],
                "senses": [
                    {
                        "sense_id": "8cd9ff08-6b0e-3679-99e3-987a52644c1a",
                        "entry_id": "51dde7cb-f0e9-3008-ad9e-d9d3f63a0fde",
                        "glosses": [
                            "stijlfiguur waarbij men een woord B bezigt in plaats van het eigenlijk bedoelde woord A, op grond van het feit dat er tussen A en B een vaste relatie (contiguïteitsrelatie), en/of een synecdoche bestaat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f948261f-5c75-47ff-bca9-9d48b259babf",
                                "sense_id": "8cd9ff08-6b0e-3679-99e3-987a52644c1a",
                                "text": "\"Ik heb Couperus gelezen\" is een metonymia van \"Ik heb een boek van Couperus gelezen\"."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "49223c3d-a5fc-440e-9a05-22eb9bc6b681",
                        "source_entry_id": "51dde7cb-f0e9-3008-ad9e-d9d3f63a0fde",
                        "source_sense_id": "8cd9ff08-6b0e-3679-99e3-987a52644c1a",
                        "target_lang_word": "Metonymie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Metonymie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "217de1f2-50e4-3a33-b4bc-1323e23f7453",
                                        "entry_id": "b253d7f1-694e-313f-b4f1-f4b47cee2e02",
                                        "glosses": [
                                            "rhetorische Figur, bei der der eigentliche Ausdruck durch einen anderen gedanklich in Verbindung stehenden Ausdruck ersetzt wird"
                                        ],
                                        "tags": [
                                            "Rhetorik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cc986100-4725-4bdd-966a-197a55049207",
                                                "sense_id": "217de1f2-50e4-3a33-b4bc-1323e23f7453",
                                                "text": "Beispiele für Metonymien sind „ein BMW“ für ein gewisses Auto, „Schiller lesen“, „ein Glas trinken“, „Europa ist reich“, „Berlin entscheidet“, „der Saal applaudiert“, etc."
                                            },
                                            {
                                                "example_id": "0a3faddc-482b-4804-9b72-882d8cf3ee57",
                                                "sense_id": "217de1f2-50e4-3a33-b4bc-1323e23f7453",
                                                "text": "Eine deutsche Boulevardzeitung prägte bei der Wahl von Joseph Ratzinger den Ausdruck „Wir sind Papst“. Dabei ist das „wir“ eine Metonymie, da damit „die Deutschen“ gemeint sind."
                                            },
                                            {
                                                "example_id": "76b111f9-32a6-479e-a963-eb3da52e5b93",
                                                "sense_id": "217de1f2-50e4-3a33-b4bc-1323e23f7453",
                                                "text": "„Ein weiteres solches Muster ist die Bedeutungsverschiebung oder Metonymie.“"
                                            },
                                            {
                                                "example_id": "54f4a6d5-a5b4-4d42-8d97-0d6600409c22",
                                                "sense_id": "217de1f2-50e4-3a33-b4bc-1323e23f7453",
                                                "text": "Dass der Jazz eine Kunstform von enormer Körperlichkeit ist – „Jazz“ ist eine Metonymie für Sex – blendet die Ausstellung weitgehend aus."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9479cb89-151d-4b55-9989-381f3f1d7178",
                        "source_entry_id": "51dde7cb-f0e9-3008-ad9e-d9d3f63a0fde",
                        "source_sense_id": "8cd9ff08-6b0e-3679-99e3-987a52644c1a",
                        "target_lang_word": "metonymy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "metonymy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e6cb9808-ea1c-34ed-97c0-8a2c772e4bdf",
                                        "entry_id": "da61170c-0f4f-310f-82ea-d1b5d5bfb662",
                                        "glosses": [
                                            "The use of a single characteristic or part of an object, concept or phenomenon to identify the entire object, concept, phenomenon or a related object."
                                        ],
                                        "tags": [
                                            "countable",
                                            "rhetoric",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "815454ee-6aa5-48a2-908c-5aa5ff85e0b9",
                                                "sense_id": "e6cb9808-ea1c-34ed-97c0-8a2c772e4bdf",
                                                "text": "Metonymy does new names impose,\nAnd things for things by near relation shews."
                                            },
                                            {
                                                "example_id": "60b907d6-1ace-496e-a9d8-5a60923b4f9b",
                                                "sense_id": "e6cb9808-ea1c-34ed-97c0-8a2c772e4bdf",
                                                "text": "...the principle of metonymy is simply to substitute for the plain name of a thing a name or phrase based on something connected with it."
                                            },
                                            {
                                                "example_id": "053dd200-5254-4067-aa19-f6893e47ac3d",
                                                "sense_id": "e6cb9808-ea1c-34ed-97c0-8a2c772e4bdf",
                                                "text": "THE KEY CONCEPT IS “metonymy.” This is the act of a word or phrase associated with a concept coming to represent the entirety of said concept. Generally, this means an extension of the original meaning. For example, “city hall” no longer means just the structure, but also the lawmakers who inhabit that structure. In the same way, “dish” started as the physical plate a meal is served on, before people started using it to represent the meal itself."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bbabde25-4491-3761-aad6-af39e35d06bf",
                                        "entry_id": "da61170c-0f4f-310f-82ea-d1b5d5bfb662",
                                        "glosses": [
                                            "A metonym."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "168907dd-9da1-4bdd-ab15-80ed84e2b171",
                        "source_entry_id": "51dde7cb-f0e9-3008-ad9e-d9d3f63a0fde",
                        "source_sense_id": "8cd9ff08-6b0e-3679-99e3-987a52644c1a",
                        "target_lang_word": "métonymie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "métonymie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "34b82916-5790-3275-ab21-ac5c4de4bab0",
                                        "entry_id": "8c748079-af95-34f5-afaf-57ab35e627b7",
                                        "glosses": [
                                            "Procédé du langage qui consiste à remplacer un mot par un autre mot qui entretient avec le premier un rapport logique, par exemple un objet par sa matière, un contenu par son contenant, la partie par le tout…"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "481b5abe-2917-4701-8203-55732cad3bd2",
                                                "sense_id": "34b82916-5790-3275-ab21-ac5c4de4bab0",
                                                "text": "L’espèce de métonymie scripturale employée ici pour exprimer l’énormité inouïe du péché que Dieu va punir, laisse dans la pensée une empreinte singulière."
                                            },
                                            {
                                                "example_id": "6167a111-6f22-4dd5-977c-f1c084c3ef15",
                                                "sense_id": "34b82916-5790-3275-ab21-ac5c4de4bab0",
                                                "text": "Si bien que, gavé d'informations tant sur le patois taafien constitué d'abréviations reposantes, d’apocopes imprévisibles, d’aphérèses inattendues et de métonymies subtiles - OP pour opération portuaire, DZ pour drop zone, bib pour médecin, bout de bois pour menuisier, pimponker pour pompier, etc., j'en passe et des meilleures - que sur le décor de mon futur séjour, j'ai fini par me demander pourquoi diable me donner le mal (de mer) d'y aller, […]."
                                            },
                                            {
                                                "example_id": "c66a71a4-ae29-4bf7-b212-ec41f6e7287f",
                                                "sense_id": "34b82916-5790-3275-ab21-ac5c4de4bab0",
                                                "text": "Remarquables sont les cas de métonymie, comme verre (matériel) et verre (récipient) en français (glass en anglais), correspondant à différents termes lexicaux en chinois : 玻璃 bōlí « verre » (matériel) vs 杯子 bēizi « verre » (récipient), ou bien, chêne (arbre) et chêne (bois de…) en français (oak en anglais), mais 橡树 xiàngshù « chêne » (arbre) et 橡木 xiàngshù « chêne » (bois de…) en chinois."
                                            },
                                            {
                                                "example_id": "3c5636c1-34cc-4893-8f17-0469ba757d57",
                                                "sense_id": "34b82916-5790-3275-ab21-ac5c4de4bab0",
                                                "text": "On sait pourtant depuis le socialiste Hollande de quoi les sans-dents sont surtout la métonymie : du capitalisme néolibéral et de ses inégalités obscènes."
                                            },
                                            {
                                                "example_id": "bef6bb80-d3ad-4205-99f3-f9cc8e1241d0",
                                                "sense_id": "34b82916-5790-3275-ab21-ac5c4de4bab0",
                                                "text": "Si l’on dit d’un malfaiteur qu’il s’est présenté « un calibre à la main », on se sert d’une métonymie caractérisée. Les pistolets étant connus par le calibre de leur canon, substituer calibre à pistolet constitue le trope."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ab3202a3-bc4a-401d-acfc-0ad282ae2ebd",
                        "source_entry_id": "51dde7cb-f0e9-3008-ad9e-d9d3f63a0fde",
                        "source_sense_id": "8cd9ff08-6b0e-3679-99e3-987a52644c1a",
                        "target_lang_word": "metonimia",
