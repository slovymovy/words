        "fr-extract.jsonl": [
            {
                "entry_id": "3a013c37-880d-33f8-a4f0-b7c90f39b2ed",
                "word": "trouple",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "d69471c7-4c06-4cd8-a5cd-9a0dad0c4c5f",
                        "entry_id": "3a013c37-880d-33f8-a4f0-b7c90f39b2ed",
                        "tags": [
                            "plural"
                        ],
                        "form": "trouples"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8ac24a4f-9094-3e9a-b5ad-c89b8363a601",
                        "entry_id": "3a013c37-880d-33f8-a4f0-b7c90f39b2ed",
                        "glosses": [
                            "Couple à trois."
                        ],
                        "tags": [
                            "Famille"
                        ],
                        "examples": [
                            {
                                "example_id": "bf932db1-848e-4cdf-ad21-c69baa3c6dd8",
                                "sense_id": "8ac24a4f-9094-3e9a-b5ad-c89b8363a601",
                                "text": "Le « trouple » ou « ménage à trois » serait l’une des possibilités ; un tel contrat serait une alternative au divorce et une solution à de nombreux drames qui abondent les rubriques faits-divers."
                            },
                            {
                                "example_id": "40b9e40f-d7cf-4303-98e6-61801ca314ae",
                                "sense_id": "8ac24a4f-9094-3e9a-b5ad-c89b8363a601",
                                "text": "Pour former un trouple, faut-il d’abord être en couple ? A première vue, oui."
                            },
                            {
                                "example_id": "f3d8f4f5-2df9-4466-896f-761afa7a939f",
                                "sense_id": "8ac24a4f-9094-3e9a-b5ad-c89b8363a601",
                                "text": "Pendant le repas, ce ne fut que des déclarations d’amour mutuel à trois. Nous formions un vrai trouple."
                            },
                            {
                                "example_id": "3b274f3c-26e5-46a3-923f-856182134294",
                                "sense_id": "8ac24a4f-9094-3e9a-b5ad-c89b8363a601",
                                "text": "Ils auraient même volontiers invité un autre garçon, sans crainte d’instiller entre eux aucune jalousie, pourvu qu’il ne se fût agi d’aucune tentative de semer le trouple."
                            },
                            {
                                "example_id": "411d71f4-6707-4d7c-8ad0-4361c38d84da",
                                "sense_id": "8ac24a4f-9094-3e9a-b5ad-c89b8363a601",
                                "text": "Quand un des membres de la rédaction était d’humeur grisâtre, c’est bien simple, il venait se remettre d’aplomb au milieu du trio des secrétaires de rédaction – nous disions “trouple”, pour “couple à trois” »."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "282d0f69-bc07-4856-aca7-39b869835db6",
                        "source_entry_id": "3a013c37-880d-33f8-a4f0-b7c90f39b2ed",
                        "source_sense_id": "8ac24a4f-9094-3e9a-b5ad-c89b8363a601",
                        "target_lang_word": "throuple",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "throuple",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "79178c28-a0de-34cc-b297-07236fe042a7",
                                        "entry_id": "493fe25d-0cdc-34de-93e6-7982f003930e",
                                        "glosses": [
                                            "Three individuals engaged in a romantic or sexual relationship."
                                        ],
                                        "tags": [
                                            "neologism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "955cd9fe-3e10-4939-a45e-1c1d64392786",
                                                "sense_id": "79178c28-a0de-34cc-b297-07236fe042a7",
                                                "text": "The Air Force veteran fatally shot by police during last week’s US Capitol riot had been in a “throuple” with her husband and their live-in girlfriend, according to reports."
                                            },
                                            {
                                                "example_id": "75da6dd8-e304-484e-b9be-5d5324a61699",
                                                "sense_id": "79178c28-a0de-34cc-b297-07236fe042a7",
                                                "text": "Nearly a year ago, I began dating two friends — I’ll call them Rachel and Dave — who were already themselves in a relationship. We all had no experience with polyamory. The throuple ended fairly quickly, with no one being at fault; the other two continued to date but broke up not too long afterward."
                                            },
                                            {
                                                "example_id": "d17f1005-d592-4e6b-b1d6-9417ec8effef",
                                                "sense_id": "79178c28-a0de-34cc-b297-07236fe042a7",
                                                "text": "But among all the throuples, polycules and nesting partners, there exists another category of polyamory that still throws many for a loop: solo polyamory, or having concurrent intimate relationships while maintaining independence."
                                            },
                                            {
                                                "example_id": "93b68513-c77e-4f64-af09-03f09bcf219d",
                                                "sense_id": "79178c28-a0de-34cc-b297-07236fe042a7",
                                                "text": "“Honeybee, if you stare at that dividend check any harder, we're gonna officially be a throuple.” [chuckles] “I'm in.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
