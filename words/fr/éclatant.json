                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il est sorti de la pièce en <w>éclatant</w> de rire après avoir entendu cette bonne nouvelle.",
                            "target_lang_translations": {
                                "en": "He left the room <w>bursting</w> into laughter after hearing the good news.",
                                "de": "Nachdem er diese gute Nachricht gehört hatte, verließ er den Raum und <w>brach</w> in Lachen <w>aus</w>.",
                                "es": "Salió de la habitación <w>estallando</w> de risa tras oír esa buena noticia.",
                                "zh": "他听到这个好消息后，一边走出房间一边<w>爆发</w>出一阵大笑。",
                                "ru": "Услышав эту радостную новость, он вышел из комнаты, <w>разражаясь</w> смехом."
                            }
