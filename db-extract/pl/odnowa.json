                                    {
                                        "sense_id": "3a384ebd-2797-3ff0-bf18-16aeb2b6236c",
                                        "entry_id": "f8d98007-ba3c-38a3-be8e-375c54ad168e",
                                        "glosses": [
                                            "The act of renewing."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "99a0d439-2945-4cc5-b16b-20d6a29d2139",
                                                "sense_id": "3a384ebd-2797-3ff0-bf18-16aeb2b6236c",
                                                "text": "The renewal of track by cranes and special tracklaying machines which lift out entire 60 ft. lengths of old track and lay in pre-assembled 60 ft. lengths of new, allows the process of renewal to proceed at a considerably faster rate than possible by older methods."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aeb0f6b8-889a-3c02-8a34-cb3502a054f3",
                                        "entry_id": "f8d98007-ba3c-38a3-be8e-375c54ad168e",
                                        "glosses": [
                                            "An offensive action made immediately after a parried one."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "de9ad10c-1954-421b-a14b-86d15a494348",
                        "source_entry_id": "80e511c2-4a58-3970-9001-6d6958b5b956",
                        "source_sense_id": "6b959ce2-d507-3f4d-bb5d-ba7dabfffd13",
                        "target_lang_word": "rénovation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rénovation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c5340440-4d85-3b39-8331-9a9a1a7329aa",
                                        "entry_id": "875b0394-b549-30f5-af03-4e2e2688a7c7",
                                        "glosses": [
                                            "Renouvellement, régénération physique ou morale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ebb818b-dbf0-4890-b781-f386baba2fc8",
                                                "sense_id": "c5340440-4d85-3b39-8331-9a9a1a7329aa",
                                                "text": "L'avènement du féminisme, mais d'un féminisme sérieux et familial, sera de toute manière indispensable à la rénovation de nos manières de vivre."
                                            },
                                            {
                                                "example_id": "8d96bf27-dbf1-474b-81b9-0124ade55845",
                                                "sense_id": "c5340440-4d85-3b39-8331-9a9a1a7329aa",
                                                "text": "En France particulièrement, deux grands géodésiens, le général François Perrier (1833-1888) et son fils le général Georges Perrier (mort en 1946), accomplirent les travaux monumentaux qui allaient aboutir à une rénovation complète de la géodésie française."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b1bc013-12fa-3452-b9c7-fe14c0d3b21c",
                                        "entry_id": "875b0394-b549-30f5-af03-4e2e2688a7c7",
                                        "glosses": [
                                            "Action de rénover un bien."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f751e70-1a46-4363-93a0-f4b7d78c3dec",
                                                "sense_id": "2b1bc013-12fa-3452-b9c7-fe14c0d3b21c",
                                                "text": "La rénovation du Grand Palais"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b8412af4-bc30-3230-a90e-f4c67f79e24f",
                                        "entry_id": "875b0394-b549-30f5-af03-4e2e2688a7c7",
                                        "glosses": [
                                            "Remplacement de pièces ou d’éléments, usagés ou non, dans une machine ou un équipement industriel, qui vise à en améliorer les performances."
                                        ],
