                        "entry_id": "9c841aba-40e7-39a9-b64b-8b86947796c9",
                        "glosses": [
                            "Einfügung, Integration von jemandem oder von etwas in eine größere Einheit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "18275247-1939-4adc-aa84-6433ca0724a4",
                                "sense_id": "0edb3ae3-34f7-3b67-a6c0-4eb6dfe1be11",
                                "text": "Die Eingliederung von Firmen in Konzerne gelingt nicht immer zufriedenstellend."
                            },
                            {
                                "example_id": "64e36779-92d9-4699-95d9-be5760e81722",
                                "sense_id": "0edb3ae3-34f7-3b67-a6c0-4eb6dfe1be11",
                                "text": "„Ja, Einwanderung und Eingliederung sind sehr wichtige Themen.“"
                            },
                            {
                                "example_id": "43ab51ff-fd7d-41cd-b432-4ac050d5cdb7",
                                "sense_id": "0edb3ae3-34f7-3b67-a6c0-4eb6dfe1be11",
                                "text": "„Durch die Eingliederung in die Europäische Union und die damit verbundene gewachsene Nähe zu Mitteleuropa haben sich nicht nur neue Möglichkeiten ergeben.“"
                            }
                        ],
