                "senses": [
                    {
                        "sense_id": "dec503b8-f2b7-36be-b683-db7d35bb1edd",
                        "entry_id": "04635000-678a-3a1a-9df5-d4b6f9b1cb28",
                        "glosses": [
                            "auf dem Erdboden zurückgelassene Spur von einem Huf"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a254b444-b4ab-4019-85d0-840f6dbdbf30",
                                "sense_id": "dec503b8-f2b7-36be-b683-db7d35bb1edd",
                                "text": "„Es gibt nur eine ganz schwache Blutspur, und der Boden in dieser Ecke des Anwesens ist zum größten Teil von Kiefernnadeln bedeckt oder aus blankem Fels; Hufabdrücke bleiben praktisch unsichtbar.“"
                            },
                            {
                                "example_id": "9703316b-0707-460f-86f9-3afb64be74d9",
                                "sense_id": "dec503b8-f2b7-36be-b683-db7d35bb1edd",
                                "text": "„Mehrere Meilen weit folgte er den Spuren, erkannte am konstanten Abstand der einzelnen Hufabdrücke, dass es sich um eine zusammengehörige Gruppe handelte; umgeworfene Steine und nicht umrittene Löcher ließen darauf schließen, dass der Trupp nachts unterwegs gewesen war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
