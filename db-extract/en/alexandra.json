                                    {
                                        "sense_id": "1369f0d3-f4a0-3286-ae05-d2c442c2feb1",
                                        "entry_id": "cc4b41ee-d2f7-3a0c-9bea-804d4c3832ac",
                                        "glosses": [
                                            "Prénom féminin français."
