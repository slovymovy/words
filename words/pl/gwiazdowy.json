                    "frequency": "Middle",
                    "semantic_group_id": "astronomia",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Stary samolot miał <w>gwiazdowy</w> silnik, którego cylindry były ułożone wokół środka.",
                            "target_lang_translations": {
                                "ru": "У старого самолёта был <w>звездообразный</w> двигатель, цилиндры которого располагались вокруг центра."
                            }
                        },
                        {
                            "text": "Komputery w naszym biurze połączono w sieć o układzie <w>gwiazdowym</w>.",
                            "target_lang_translations": {
                                "ru": "Компьютеры в нашем офисе объединили в сеть по <w>звездообразной</w> схеме."
                            }
                        }
                    ],
                    "synonyms": [
