                        "examples": [
                            {
                                "example_id": "1913c0e2-5be8-4a08-b786-fba42ae4ac85",
                                "sense_id": "ad064733-2552-3f61-9680-7255f3101ee6",
                                "text": "De kosten van dit project zijn goed calculeerbaar omdat er geen externe factoren zijn die invloed kunnen hebben op de prijs."
                            },
                            {
                                "example_id": "bc625de1-aff9-4788-aea3-d2af08239a93",
                                "sense_id": "ad064733-2552-3f61-9680-7255f3101ee6",
                                "text": "De eis van doelmatigheid klinkt eenvoudig, maar zeker bij langjarige investeringen is dat geen sinecure. (…) En juist bij langjarige investeringen is de onzekerheid te groot om die in calculeerbaar risico om te kunnen rekenen. Investeringen als die in de Afsluitdijk, de Deltawerken en de Flevopolder zouden deze horde nooit hebben kunnen nemen."
                            }
                        ]
