                        "examples": [
                            {
                                "example_id": "8ead3e6e-b0a7-4df9-bc58-250ab635f31e",
                                "sense_id": "1c0e8475-97e6-3522-a151-5a7e3739619a",
                                "text": "„Um einem Computer das Sprechen beizubringen, lässt man ihn heutzutage gewaltige Textmengen durchforsten, Zeitungsarchive, Websites oder digitale Bibliotheken zum Beispiel.“"
                            },
                            {
                                "example_id": "68860d60-8ec9-42b6-90c5-e3025dd8ae43",
                                "sense_id": "1c0e8475-97e6-3522-a151-5a7e3739619a",
                                "text": "„Programme zur Sammlung und Auswertung großer digitaler Textmengen, mit denen empirische Analysen u. a. zur Häufigkeit, Verteilung oder Kontextabhängigkeit von sprachlichen Äußerungen durchgeführt werden können, werden im Bereich der Korpuslinguistik eingesetzt.“"
                            }
                        ],
