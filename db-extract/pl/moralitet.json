                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "moralidad",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "df2dd152-afc2-3820-91cb-62c75cc84022",
                                        "entry_id": "5ef722c6-25ff-318b-ac8e-4bdfd415ac2f",
                                        "glosses": [
                                            "Actitud o condición de seguir los parámetros de la moral, de seguir la noción general de lo bueno y lo malo en un contexto determinado o las normas de conducta establecidas en cierta sociedad, cultura o época."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a6c79bd8-3664-3f25-9e96-da029e1bae4a",
                                        "entry_id": "5ef722c6-25ff-318b-ac8e-4bdfd415ac2f",
                                        "glosses": [
                                            "Mensaje moral que se deduce de un relato, fábula, ejemplo, discurso, etc."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0d747f38-1396-4398-ab8f-5d1f08010530",
                        "source_entry_id": "dbf2fa2b-e365-3930-a849-bd3da12a1cf9",
                        "source_sense_id": "832104cc-3160-33ee-8fae-bc538b00bf99",
                        "target_lang_word": "Moralität",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Moralität",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "def3d47c-d747-3a85-bc6c-acc5102d06ec",
                                        "entry_id": "ddf3c2d0-a35a-31fd-a3eb-a630c4258d8d",
                                        "glosses": [
                                            "Eigenschaft, sich dem sittlichen Empfinden (der Moral) entsprechend zu verhalten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c29c2d71-09d7-487d-abb9-2ae471885cde",
                                                "sense_id": "def3d47c-d747-3a85-bc6c-acc5102d06ec",
                                                "text": "„Schopenhauers Ethik ist bekanntermaßen eine Mitleidsethik, weil sie die Quelle von Moral und Moralität im Gefühl des Mitleids erblickt.“"
                                            },
                                            {
                                                "example_id": "3e4cfc8c-a748-465b-b601-cec3327afed4",
                                                "sense_id": "def3d47c-d747-3a85-bc6c-acc5102d06ec",
                                                "text": "„Der Begriff der Strafe, der strafenden im Unterschied zur rächenden Gerechtigkeit, ist der Ausgangspunkt des Übergangs zur Moralität, zum „moralischen Standpunkt“, in § 104.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
