                                "target_senses": [
                                    {
                                        "sense_id": "0c20ccaa-c7c2-3cec-a75e-30e9f287f230",
                                        "entry_id": "0b17402d-ef41-33c2-b21a-192b71db16a3",
                                        "glosses": [
                                            "Exhibiting prejudice or bias."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15ae27e0-3d46-4ab1-8ac4-a3028bb4329b",
                                                "sense_id": "0c20ccaa-c7c2-3cec-a75e-30e9f287f230",
                                                "text": "I must believe that the absence of specific language in our Policy Book with respect to sexual preferences cannot be construed as encouragement to prejudicial behavior or treatment."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "674c11e1-8b1b-30a9-91a8-54c0b1969e5b",
                                        "entry_id": "0b17402d-ef41-33c2-b21a-192b71db16a3",
                                        "glosses": [
                                            "Causing harm or injury; detrimental, harmful or injurious."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a87ae9e7-37d4-4450-9aa7-23e639b231cb",
                                                "sense_id": "674c11e1-8b1b-30a9-91a8-54c0b1969e5b",
                                                "text": "Were I to give you money, for whatever reason, it would be extremely prejudicial to your chances in court if you were unfortunate enough to appear there."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "26beb03e-bb85-3995-9663-e03a43e1284a",
                                        "entry_id": "0b17402d-ef41-33c2-b21a-192b71db16a3",
                                        "glosses": [
                                            "Tending to convince based on past history rather than on evidence about the case at hand."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d340d4b6-1c03-4092-8b57-f9000af91027",
                                                "sense_id": "26beb03e-bb85-3995-9663-e03a43e1284a",
                                                "text": "The judge had granted the DA a one-week extension with the caustic admonition that the case would be summarily dismissed if at that time probative, as opposed to prejudicial, evidence was not produced."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
