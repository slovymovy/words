        "fr-extract.jsonl": [
            {
                "entry_id": "51feebe4-9745-30fd-b21a-820555f9eefe",
                "word": "combine",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "620b4600-73f9-4192-b764-8784685091fc",
                        "entry_id": "51feebe4-9745-30fd-b21a-820555f9eefe",
                        "tags": [
                            "plural"
                        ],
                        "form": "combines"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "db44d96b-a06f-34c2-acce-6d4fa060873d",
                        "entry_id": "51feebe4-9745-30fd-b21a-820555f9eefe",
                        "glosses": [
                            "Astuce, souvent déloyale, employée pour parvenir à quelque fin."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "635070c6-4a00-4057-81f5-f7e3dda6bae3",
                                "sense_id": "db44d96b-a06f-34c2-acce-6d4fa060873d",
                                "text": "On croit mourir pour la patrie, et on crève pour des combines de mercantis, prompts à engraisser, à travers tous les charniers, leurs dividendes."
                            },
                            {
                                "example_id": "53d41585-a032-4ec5-aa5b-a94d8f03cc49",
                                "sense_id": "db44d96b-a06f-34c2-acce-6d4fa060873d",
                                "text": "Ici c'est l'rendez-vous d'toutes les combines, croyez-moi. Ça vous saute pas aux yeux du premier coup, mais il suffit d'observer et on entrave en un rien de temps."
                            },
                            {
                                "example_id": "cc2396e1-e5e9-460a-ad67-49ae40ff6d7f",
                                "sense_id": "db44d96b-a06f-34c2-acce-6d4fa060873d",
                                "text": "Il y exerce toute la vivacité de son esprit rebelle à ces combines, ces bassesses, ces tripotages, fricotages et grenouillages qui déshonorent à ses yeux la représentation des élus du peuple."
                            }
                        ]
                    },
                    {
                        "sense_id": "1fe191bc-087f-39d1-ba0c-5b7c8517c36f",
                        "entry_id": "51feebe4-9745-30fd-b21a-820555f9eefe",
                        "glosses": [
                            "Diminutif du sous-vêtement combinaison (sens 7). Note: Pour un seul sous-vêtement, il est commun de dire une paire de combines, alors qu'une paire de combinaisons n'est jamais une expression utilisée."
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "62b62a59-12ba-409c-b04a-50fecfc38c5c",
                                "sense_id": "1fe191bc-087f-39d1-ba0c-5b7c8517c36f",
                                "text": "Ça m'prend une paire de combines pour aller faire du skidoo à'soir."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b97ae678-720e-42c9-9408-1a2e9a39992a",
                        "source_entry_id": "51feebe4-9745-30fd-b21a-820555f9eefe",
                        "source_sense_id": "db44d96b-a06f-34c2-acce-6d4fa060873d",
                        "source_sense_description": "Astuce.",
                        "target_lang_word": "Winkelzug",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Winkelzug",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a640ce5b-8c4c-3fac-a2d6-e35b7dd46922",
                                        "entry_id": "f696a9d6-d764-3e1b-af05-4bb902196014",
                                        "glosses": [
                                            "für andere schwer durchschaubare, dem eigenen Interesse dienende Handlung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f3140bb-4d71-482c-befc-04ed6b934e12",
                                                "sense_id": "a640ce5b-8c4c-3fac-a2d6-e35b7dd46922",
                                                "text": "Seine Anwälte nutzen reichlich juristische Winkelzüge, um ihren Mandanten vor einer Bestrafung zu bewahren."
                                            },
                                            {
                                                "example_id": "7a5e2c8c-0d2d-4fe1-90ab-b2afbdd9ccc7",
                                                "sense_id": "a640ce5b-8c4c-3fac-a2d6-e35b7dd46922",
                                                "text": "„Er begriff nicht, worauf sie hinaus wollte, sie sah gar nicht zurückhaltend aus und hatte es nicht nötig, zu Winkelzügen Zuflucht zu nehmen.“"
                                            },
                                            {
                                                "example_id": "f4ec23b4-3c81-46b8-bbfd-596d64872e32",
                                                "sense_id": "a640ce5b-8c4c-3fac-a2d6-e35b7dd46922",
                                                "text": "„Muzorewa war ein Bischof und kein Politiker, er war weder den Winkelzügen eines Ian Smith gewachsen noch der Gerissenheit eines Mugabe oder Nkomo.“"
                                            },
                                            {
                                                "example_id": "87c7f359-0fcf-4014-a29f-914c6b7a90b3",
                                                "sense_id": "a640ce5b-8c4c-3fac-a2d6-e35b7dd46922",
                                                "text": "„Der Mission waren jahrelange diplomatische Winkelzüge vorangegangen, die offenbaren, wie international schon im Mittelalter Politik betrieben wurde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "643fac3d-3e80-45ba-93c5-df512769303b",
                        "source_entry_id": "51feebe4-9745-30fd-b21a-820555f9eefe",
