                ],
                "senses": [
                    {
                        "sense_id": "c18304f1-a0fd-389c-b5c9-b1fa824bbb80",
                        "entry_id": "e24dd7b4-6287-311e-80a8-315aec9f5632",
                        "glosses": [
                            "eine Stadt in Polen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e7ac4cbf-d471-42ba-87be-5e102136e26b",
                                "sense_id": "c18304f1-a0fd-389c-b5c9-b1fa824bbb80",
                                "text": "Ich wohne gern in Bromberg."
                            },
                            {
                                "example_id": "b5afc4ab-0928-4d0c-98a2-b3bc960ed54a",
                                "sense_id": "c18304f1-a0fd-389c-b5c9-b1fa824bbb80",
                                "text": "Das heutige Bromberg unterscheidet sich von dem vergangener Zeiten."
                            },
                            {
                                "example_id": "30bf7c4b-dee6-4cc5-9473-83820e8ca326",
                                "sense_id": "c18304f1-a0fd-389c-b5c9-b1fa824bbb80",
                                "text": "„Bis November 1939 wurden in Bromberg und Umgebung ungefähr 5.000 Polen und Juden erschossen.“"
                            },
                            {
                                "example_id": "53887d8b-02a8-48a7-a402-d757e0a392da",
                                "sense_id": "c18304f1-a0fd-389c-b5c9-b1fa824bbb80",
                                "text": "„Nach der Rast fuhren wir sehr gemütlich in Richtung Osten bis in die Nähe von Bromberg (Bydgoszcz).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "b16c11c1-daab-3782-8205-7af225a7e6da",
                        "entry_id": "e24dd7b4-6287-311e-80a8-315aec9f5632",
                        "glosses": [
                            "eine Marktgemeinde in Österreich"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5a68526-05b4-491e-97cb-b2d9b071c402",
                                "sense_id": "b16c11c1-daab-3782-8205-7af225a7e6da",
                                "text": "Das heutige Bromberg unterscheidet sich von dem vergangener Zeiten."
                            },
                            {
                                "example_id": "b8a53db7-4577-4473-8f18-34c054e524c6",
                                "sense_id": "b16c11c1-daab-3782-8205-7af225a7e6da",
                                "text": "„Im Zuge der neuen Partnerschaft hat sich die Marktgemeinde Bromberg neben der Umrüstung der veralteten Quecksilberdampflampen auf moderne und effiziente LED-Leuchten auch für die Sanierung der Einspeisestellen, entschlossen.“"
                            },
                            {
                                "example_id": "5af62d90-a69c-46a5-9641-02b811111978",
                                "sense_id": "b16c11c1-daab-3782-8205-7af225a7e6da",
                                "text": "Ich wohne gern in Bromberg."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "e0f75db6-0d5b-3118-998e-b05866f2b962",
                        "entry_id": "e24dd7b4-6287-311e-80a8-315aec9f5632",
                        "glosses": [
                            "eine Katastralgemeinde von Grafenschlag, Österreich"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eed6fd84-843a-496e-9852-e12259a73181",
                                "sense_id": "e0f75db6-0d5b-3118-998e-b05866f2b962",
                                "text": "Ich wohne gern in Bromberg."
                            },
                            {
                                "example_id": "6c9af3d9-a5bc-45c0-8f8e-78255392d05f",
                                "sense_id": "e0f75db6-0d5b-3118-998e-b05866f2b962",
                                "text": "Das heutige Bromberg unterscheidet sich von dem vergangener Zeiten."
                            },
                            {
                                "example_id": "aba0d178-1dec-4b39-8fb2-204a84817cf3",
                                "sense_id": "e0f75db6-0d5b-3118-998e-b05866f2b962",
                                "text": "„Der Landschaftsteich Grafenschlag befindet sich in der Nähe der Katastralgemeinde Bromberg und ist in den Sommermonaten der beliebteste Badeplatz in der Gemeinde.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
