                "senses": [
                    {
                        "sense_id": "6d4c7813-6ed5-3afc-8d4a-276514420b04",
                        "entry_id": "fa660dda-7f2e-31d5-b477-e5e7236ebf54",
                        "glosses": [
                            "niet kunnen betalen van financiële verplichtingen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5d28c08-c4e5-4ed1-9970-ead9fc9ac71d",
                                "sense_id": "6d4c7813-6ed5-3afc-8d4a-276514420b04",
                                "text": "De banken kopen de staatsleningen van insolvabele staten (en houden en passant de rente voor deze staten gezien de risico’s te laag) en staten steunen de insolvabele banken weer."
                            },
                            {
                                "example_id": "c605d448-3380-4bb1-9228-2560c401e5a1",
                                "sense_id": "6d4c7813-6ed5-3afc-8d4a-276514420b04",
                                "text": "\"Het bedrijf ging schulden aan om die investeringen te kunnen doen. Het wilde dat terugbetalen als het bedrijf zou gaan lopen. Het ging aanvankelijk ook goed, maar vorig jaar was echter een slecht jaar en toen is het bedrijf insolvabel geworden\", zegt curator Van Geel tegen RTL Z."
                            },
                            {
                                "example_id": "7838d23b-c3d7-455a-8103-3ae07edf4f5f",
                                "sense_id": "6d4c7813-6ed5-3afc-8d4a-276514420b04",
                                "text": "De Cypriotische premier Anastasiades heeft een akkoord bereikt met de EU , het IMF en de ECB. De truc is het opknippen van zijn zwaar insolvabele banken."
                            }
                        ]
                    }
                ],
