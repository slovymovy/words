                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "07604c74-2733-4469-adf2-9f59673c41fd",
                        "entry_id": "d764342d-b06c-30a7-8045-a5b671c7611c",
                        "tags": [
                            "plural"
                        ],
                        "form": "holothuries"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e18ec86a-99d2-33c8-9590-ce621a390459",
                        "entry_id": "d764342d-b06c-30a7-8045-a5b671c7611c",
                        "glosses": [
                            "Échinoderme de la classe des holothuroïdes, on en compte environ 1 250 espèces généralement divisées en cinq à sept ordres."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7b5f8a6c-55ea-4f6b-a65b-27fcdcf43446",
                                "sense_id": "e18ec86a-99d2-33c8-9590-ce621a390459",
                                "text": "On peut se faire une idée de l’importance et de l’étendue de la pêche des holothuries par le nombre de vaisseaux qu’elle attire dans les mers de la Chine."
                            },
                            {
                                "example_id": "cba80d59-5780-4581-a263-9892e6ac239f",
                                "sense_id": "e18ec86a-99d2-33c8-9590-ce621a390459",
                                "text": "Fins gourmets, les Chinois se délectent d'une holothurie vivant dans les eaux tropicales, la bêche-de-mer. Les plongeurs indigènes vont la chercher entre les rochers de deux à quatre mètres de profondeur."
                            },
                            {
                                "example_id": "bb2ef246-d55c-41a1-bcd0-3c99c2803079",
                                "sense_id": "e18ec86a-99d2-33c8-9590-ce621a390459",
                                "text": "La bêche-de-mer, c'est ce que les anglophones appellent le Cucumber Sea (ou “concombre de mer”), et les habitants d'Extrême-Orient le tripang. Il s'agit en fait d'une grosse holothurie, animal marin très proche de l’étoile de mer."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ddc4e36c-daa0-4642-8e52-7d91e82449ee",
                        "source_entry_id": "d764342d-b06c-30a7-8045-a5b671c7611c",
                        "source_sense_id": "e18ec86a-99d2-33c8-9590-ce621a390459",
                        "target_lang_word": "Seegurke",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Seegurke",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "192a63fc-95da-3d44-a697-eb71ffc3e1d0",
                                        "entry_id": "8d6e2fc6-c75b-36dc-a5e2-1d09802d3658",
                                        "glosses": [
                                            "zu den Stachelhäutern gehörendes, in Meeren lebendes wirbelloses Tier"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86470fe7-a2ec-412a-b5a7-766956175c57",
                                                "sense_id": "192a63fc-95da-3d44-a697-eb71ffc3e1d0",
                                                "text": "Sie sehen aus wie träge, stachelige Würste und leben am Meeresgrund. Doch wer eine Seegurke reizt, erfährt ihr übles Geheimnis."
                                            },
                                            {
                                                "example_id": "55e18e67-7854-4797-8742-1bfc8436811a",
                                                "sense_id": "192a63fc-95da-3d44-a697-eb71ffc3e1d0",
                                                "text": "„Noch heute ist die Zahl der Muscheln, Seegurken und Seeigel dort deutlich höher als auf nicht terrassierten Stränden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
