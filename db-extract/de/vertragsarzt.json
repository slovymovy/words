                "senses": [
                    {
                        "sense_id": "502321e8-205e-38d9-8c97-007915b453b4",
                        "entry_id": "01145097-8966-3995-9b6e-5bc58d9e3915",
                        "glosses": [
                            "Mediziner, der Mitglieder einer (in Deutschland „gesetzlichen“) Krankenversicherung behandelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f6cd088-12ce-41cf-8d79-9e4839c0a02c",
                                "sense_id": "502321e8-205e-38d9-8c97-007915b453b4",
                                "text": "„Für die Zulassung als Vertragsarzt darf bei der Entscheidung zwischen mehreren Bewerbern das Alter allein nicht ausschlaggebend sein.“"
                            },
                            {
                                "example_id": "c32b6e71-530d-4bc0-bffd-b5619e5982f5",
                                "sense_id": "502321e8-205e-38d9-8c97-007915b453b4",
                                "text": "„Erstmals hat jetzt ein Oberlandesgericht entschieden, dass sich die Vertragsärzte der gesetzlichen Krankenkassen nach den Korruptionsvorschriften strafbar machen können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
