                            {
                                "example_id": "55f4cba3-d0a4-45c1-bbc0-673b7bdb8118",
                                "sense_id": "a459b2cf-5063-3591-89c9-48b4e5470296",
                                "text": "Katański kronikarz zanotował, że ów wieczór 21 kwietnia był ciepły, pogodny, tłumy zbiegły się na powitanie wodza, ten zaś przejechał ulicami w otwartej karecie, z obnażoną szpadą, potrząsał złotą grzywą i swoim pięknym głosem obwieszczał wojnę"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
