                                "target_senses": [
                                    {
                                        "sense_id": "ff6cf1f2-d324-376f-8a90-9b1e0d600c29",
                                        "entry_id": "d30bef46-9cab-3f1f-a853-2aa948a84f02",
                                        "glosses": [
                                            "A cord of great toughness made from the intestines of animals, especially of sheep, used for strings of musical instruments, racquets, sutures etc."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9ebbae2c-5d71-4b76-9d36-f743de5c4a6a",
                                                "sense_id": "ff6cf1f2-d324-376f-8a90-9b1e0d600c29",
                                                "text": "The thing about Proust is his combination of the utmost sensibility with the utmost tenacity. He searches out these butterfly shades to the last grain. He is as tough as catgut & as evanescent as a butterfly's bloom."
                                            },
                                            {
                                                "example_id": "3d046bde-c7ff-4b82-b7c5-1c7c5ef24297",
                                                "sense_id": "ff6cf1f2-d324-376f-8a90-9b1e0d600c29",
                                                "text": "Eventually they carved small paddles to strike the ball and refined this implement with a mesh of catgut."
                                            },
                                            {
                                                "example_id": "c850c773-5e94-4452-8062-f01084639f78",
                                                "sense_id": "ff6cf1f2-d324-376f-8a90-9b1e0d600c29",
                                                "text": "The absorbable suture, catgut, is made of collagen derived from sheep intestinal submucosa. It is usually treated with a chromic salt to increase its strength and is crosslinked to retard resorption. Such treatment extends the life of catgut suture from 3–7 days up to 20–40 days."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "59e9eeb7-a478-39ea-bc5c-c8924e1cb1bc",
                                        "entry_id": "d30bef46-9cab-3f1f-a853-2aa948a84f02",
                                        "glosses": [
                                            "The material from which such cords are made."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4a127f48-092c-355b-9507-0cb5e3d7dd50",
                                        "entry_id": "d30bef46-9cab-3f1f-a853-2aa948a84f02",
                                        "glosses": [
                                            "A sort of linen or canvas, with wide interstices."
                                        ],
                                        "tags": [
