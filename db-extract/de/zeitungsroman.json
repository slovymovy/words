                "senses": [
                    {
                        "sense_id": "0f93fbbe-a732-360f-b423-6502f5f6b5bd",
                        "entry_id": "d232ca26-7df7-370b-af7d-f99c0c1baded",
                        "glosses": [
                            "abgedruckter Roman in einer Zeitung, der fortlaufend veröffentlicht wird"
                        ],
                        "tags": [
                            "Literaturwissenschaft"
                        ],
                        "examples": [
                            {
                                "example_id": "14c7b705-bcc8-43e5-ac13-97e4a99bc3dd",
                                "sense_id": "0f93fbbe-a732-360f-b423-6502f5f6b5bd",
                                "text": "Im \"Hamburger Abendblatt\" erschien 1668 der erste Zeitungsroman \"Entdeckung der Insul Pines\" in drei Fortsetzungen."
                            },
                            {
                                "example_id": "c78c8081-87bc-445c-8246-2f3f41a37286",
                                "sense_id": "0f93fbbe-a732-360f-b423-6502f5f6b5bd",
                                "text": "„Jetzt aber, im Jahre 1927, ahnt wohl niemand, daß der Autor eines gefälligen, recht nichtssagenden Zeitungsromans während des Erscheinungszeitraums bereits an einem ganz anderen Manuskript sitzt, das nichts mehr von der mondänen, verspielten und leicht versnobten Gesellschaft widerspiegelt, in der er gerade Kai und Lilian hat leben und lieben lassen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
