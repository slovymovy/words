                    "sense_definition": "Een lang, smal stuk materiaal, zoals papier, stof of land.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "material_strip",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij knipte een lange <w>strook</w> van het rode papier.",
                            "target_lang_translations": {
                                "en": "She cut a long <w>strip</w> off the red paper.",
                                "ru": "Она отрезала длинную <w>полосу</w> от красной бумаги.",
                                "pl": "Odcięła długi <w>pasek</w> czerwonego papieru.",
                                "de": "Sie schnitt einen langen <w>Streifen</w> von dem roten Papier ab.",
                                "fr": "Elle a coupé une longue <w>bande</w> de papier rouge.",
                                "it": "Lei ha tagliato una lunga <w>striscia</w> di carta rossa.",
                                "cs": "Ustřihla dlouhý <w>pruh</w> červeného papíru.",
                                "tr": "Kırmızı kağıttan uzun bir <w>şerit</w> kesti.",
                                "es": "Ella cortó una <w>tira</w> larga del papel rojo.",
                                "zh": "她从红纸上剪下了一长<w>条</w>。"
                            }
                        },
                        {
                            "text": "Langs de rivier ligt een groene <w>strook</w> gras.",
                            "target_lang_translations": {
                                "en": "Along the river lies a green <w>strip</w> of grass.",
                                "ru": "Вдоль реки лежит зеленая <w>полоса</w> травы.",
                                "pl": "Wzdłuż rzeki ciągnie się zielony <w>pas</w> trawy.",
                                "de": "Entlang des Flusses liegt ein grüner <w>Streifen</w> Gras.",
                                "fr": "Le long de la rivière se trouve une <w>bande</w> d'herbe verte.",
                                "it": "Lungo il fiume si trova una verde <w>striscia</w> d'erba.",
                                "cs": "Podél řeky leží zelený <w>pruh</w> trávy.",
                                "tr": "Nehir boyunca yeşil bir çimen <w>şeridi</w> uzanıyor.",
                                "es": "A lo largo del río hay una <w>franja</w> verde de césped.",
                                "zh": "河边有一<w>带</w>绿草地。"
                            }
                        }
