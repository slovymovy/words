                    }
                ],
                "senses": [
                    {
                        "sense_id": "1781c756-e471-3b04-9a3e-c3d16a7c28de",
                        "entry_id": "7d45fd9d-7cd7-3932-98e5-7a8834ce3dcf",
                        "glosses": [
                            "устар. злой волшебник, колдун, чёрный маг"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a03532b-5e27-4853-8148-8934b257ed41",
                                "sense_id": "1781c756-e471-3b04-9a3e-c3d16a7c28de",
                                "text": "Покойный дядя его жил в этом же доме и слыл в нашем уезде чернокнижником; я, сударь, сам некогда учился в университете; хотя немного поотстал, но чернокнижию не верю; однако же мало ли что может причиниться человеку, особливо такому философу, как ваш приятель!"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "44c7ad76-e869-4d54-bd60-ea0ce14b0425",
                        "source_entry_id": "7d45fd9d-7cd7-3932-98e5-7a8834ce3dcf",
                        "source_sense_id": "1781c756-e471-3b04-9a3e-c3d16a7c28de",
                        "target_lang_word": "black magician",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "black magician",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9b766463-580b-3b71-8d07-29360f47d2f8",
                                        "entry_id": "a459c89a-2778-3feb-8ef9-49b82f231ca9",
                                        "glosses": [
                                            "A practitioner of black magic."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c13deb2f-e43c-433e-837b-8d1dfe5fd49a",
                                                "sense_id": "9b766463-580b-3b71-8d07-29360f47d2f8",
                                                "text": "Antlers and horns have been the insignia of devils and black magicians from time immemorial, and are worn by present-day witch doctors."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "baacfa47-c8f4-4808-967f-fb516fbdf6f8",
                        "source_entry_id": "7d45fd9d-7cd7-3932-98e5-7a8834ce3dcf",
                        "source_sense_id": "1781c756-e471-3b04-9a3e-c3d16a7c28de",
                        "target_lang_word": "magicien",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "magicien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "622dfbc0-6407-3133-8af0-911ab8ecddd4",
                                        "entry_id": "465dd709-4d88-39b9-b312-ba23b8d864fc",
                                        "glosses": [
                                            "Qui tient de la magie."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9836a4b6-2bee-396c-a3d0-da1395c99f39",
                                        "entry_id": "465dd709-4d88-39b9-b312-ba23b8d864fc",
                                        "glosses": [
                                            "Dont le caractère est illusoire et relève de la poudre aux yeux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8c4a56e-b4a6-44de-993a-2b74e0c2a62a",
                                                "sense_id": "9836a4b6-2bee-396c-a3d0-da1395c99f39",
                                                "text": "On propageait, sous le manteau, des renseignements magiciens."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "magicien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "efdf6d9d-c624-34a3-930f-f7f1c7b56926",
                                        "entry_id": "4a23136b-f2c5-385b-a213-81c7a24f48a2",
                                        "glosses": [
                                            "Celui qui pratique la magie."
                                        ],
                                        "tags": [
                                            "Fantastique",
                                            "Jeux de rôle",
                                            "Jeux de rôle d’action-aventure"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c23e54b4-9aaa-4afc-a1b9-3e2f1ea77048",
                                                "sense_id": "efdf6d9d-c624-34a3-930f-f7f1c7b56926",
                                                "text": "D’ici furent dirigés ces inquisiteurs qui allèrent brûler Vaudois, cathares, fraticelles, béguins, sorciers, envoûteurs, magiciens, flagellants, ou juifs convertis, mais soupçonnés de sortilèges."
                                            },
                                            {
                                                "example_id": "7dc16a7f-a5e4-40d7-98ca-f5a8ffafcb2a",
                                                "sense_id": "efdf6d9d-c624-34a3-930f-f7f1c7b56926",
                                                "text": "Comme un jeune premier qui s’éveille dans le jardin d’une magicienne, je faillis soupirer : « Où suis-je ? » car mon enchanteresse demeurait immobile et je ne savais pas bien où j’étais entré."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "30cbb83a-4768-30d5-8921-6882895b7b4e",
                                        "entry_id": "4a23136b-f2c5-385b-a213-81c7a24f48a2",
                                        "glosses": [
                                            "Illusionniste qui produit ses effets à l’aide d’accessoires truqués."
                                        ],
                                        "tags": [
                                            "Prestidigitation"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "908ee15b-fa88-3bd9-86a4-003d9a24f8b8",
                                        "entry_id": "4a23136b-f2c5-385b-a213-81c7a24f48a2",
                                        "glosses": [
                                            "Celui qui, dans un art ou tout autre domaine, a le talent de produire des effets d’une telle beauté qu’on est tenté de les qualifier de magiques."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5d279ece-b130-4cf3-b329-6473c53a5b62",
                                                "sense_id": "908ee15b-fa88-3bd9-86a4-003d9a24f8b8",
                                                "text": "D’un côté, il y a le polytechnicien originaire du Maroc, devenu le chouchou des milieux financiers, un magicien à qui l’on prête des milliards les yeux fermés."
                                            },
                                            {
                                                "example_id": "9ec19fa8-aa7a-4ffc-ad61-fda607741f3e",
                                                "sense_id": "908ee15b-fa88-3bd9-86a4-003d9a24f8b8",
                                                "text": "Ce peintre, ce musicien, ce poète est un véritable magicien."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "852dc572-d6f6-44ac-97de-95e0a538bf7b",
                        "source_entry_id": "7d45fd9d-7cd7-3932-98e5-7a8834ce3dcf",
                        "source_sense_id": "1781c756-e471-3b04-9a3e-c3d16a7c28de",
                        "target_lang_word": "nécromancien",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nécromancien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "58ab4ddf-82d0-3e15-a326-f10dfb830345",
                                        "entry_id": "e0cd0c58-9e28-3ce3-87d3-02bcae5919ed",
                                        "glosses": [
                                            "Personne qui pratique la nécromancie, la manipulation des morts."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2770fc72-6b19-4606-8c65-6d53af80511e",
                                                "sense_id": "58ab4ddf-82d0-3e15-a326-f10dfb830345",
                                                "text": "Je lui avais attribué, dans mon esprit, la silhouette médiévale d’un nécromancien. Il nous aurait reçus, drapé dans une robe de soie constellée d’étoiles et marquée aux équations de la Kabbale, que je n’en eusse pas été surpris."
                                            },
                                            {
                                                "example_id": "1a8d5d22-2345-4b7e-80c2-2ea137b7e895",
                                                "sense_id": "58ab4ddf-82d0-3e15-a326-f10dfb830345",
                                                "text": "Deux demeures bien connues de lui l’attirent. L’une à l’est, près de Bouvines : Fées. L’autre à l’ouest, Grand-Gué, entre le cap Gris-Nez et Dunkerque. Toutes deux sont, peut-être littéralement, habitées par des ombres, mais ce n’est pas pour ces disparues qu’il s’y rend (Michel n’a rien d’un nécromancien), mais par fidélité aux quelques vivants qu’il y trouve encore."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a1b7e2b-22aa-3b8c-b696-95327ea5359c",
                                        "entry_id": "e0cd0c58-9e28-3ce3-87d3-02bcae5919ed",
                                        "glosses": [
                                            "Magicien."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d93d26aa-92d2-49b4-9c11-d6192ef6beb1",
                        "source_entry_id": "7d45fd9d-7cd7-3932-98e5-7a8834ce3dcf",
                        "source_sense_id": "1781c756-e471-3b04-9a3e-c3d16a7c28de",
                        "target_lang_word": "démoniste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "démoniste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "aa8c5bf9-06f8-3630-84d4-4b802c605f4e",
                                        "entry_id": "87587135-e47d-31f8-9f96-2c192bd3a3a6",
                                        "glosses": [
                                            "Celui ou celle qui croit à l’existence des démons bons ou mauvais."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f64e37e2-9c7d-38bf-8b1b-e9c85b58e32f",
                                        "entry_id": "87587135-e47d-31f8-9f96-2c192bd3a3a6",
                                        "glosses": [
                                            "Magicien ou magicienne capable d’invoquer et de contrôler des créatures surnaturelles."
                                        ],
                                        "tags": [
                                            "Fantastique",
                                            "Jeux de rôle",
                                            "Jeux de rôle d’action-aventure"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "979c33c7-5065-47ac-b0aa-5acf7d431760",
                                                "sense_id": "f64e37e2-9c7d-38bf-8b1b-e9c85b58e32f",
                                                "text": "Souvent confondu avec le Mage par les débutants, le Démoniste est un lanceur de sorts maléfique invoquant une multitude de démons et faisant pleuvoir la pestilence sur ses ennemis."
