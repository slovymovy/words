                ],
                "senses": [
                    {
                        "sense_id": "2426f211-5695-3fb7-984f-39082b95a977",
                        "entry_id": "79d1e2c7-c659-3d64-8e0b-65ff8f2b3dad",
                        "glosses": [
                            "Kunststoffgerät, das im besonderen (Gehäuse, Laufrad) aus Kunststoff besteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c932c3bd-1710-417a-bb85-78cea8dd4ed7",
                                "sense_id": "2426f211-5695-3fb7-984f-39082b95a977",
                                "text": "„Die Kunststoffventilatoren kommen hauptsächlich in Abzugsschränken und Hauben zum Einsatz.“"
                            },
                            {
                                "example_id": "a2594ab0-c359-4a9f-96a9-b44bc59b6f95",
                                "sense_id": "2426f211-5695-3fb7-984f-39082b95a977",
                                "text": "„Die Kunststoffventilatoren sind einseitig saugende Radialventilatoren und bestehen aus einem gesinterten Gehäuse aus PE, das absolut wasserdicht ist und mit seinen Anschlüssen von ø 125 - 250 mm eine breite Palette von Einsatzmöglichkeiten bietet “"
                            },
                            {
                                "example_id": "dc31763b-fabc-45db-910a-c99a8c564d62",
                                "sense_id": "2426f211-5695-3fb7-984f-39082b95a977",
                                "text": "„Alle Kunststoffventilatoren können mit Splitterschutz als Zubehör ausgestattet werden.“"
                            },
                            {
                                "example_id": "92fea257-7059-4e2d-9b48-c4d48c4eeb2e",
                                "sense_id": "2426f211-5695-3fb7-984f-39082b95a977",
                                "text": "„Heute ist das Unternehmen führend im Bereich Kunststoffventilatoren, der Marktanteil liegt hier bei 70 Prozent.“"
                            },
                            {
                                "example_id": "9ea90084-70b2-49f9-b806-588a7ce7daba",
                                "sense_id": "2426f211-5695-3fb7-984f-39082b95a977",
                                "text": "„Die PLE verarbeitet Kunststoff, vorzugsweise im Anlagenbau: Rohrleitungsbau,Lüftungsbau. Ebenso produzieren wir Komponenten: Kunststoffventilatoren, Apparate, Behälter und Sonderformteile.“"
                            },
                            {
                                "example_id": "8161f848-a6a2-49fa-a21a-8ef222245090",
                                "sense_id": "2426f211-5695-3fb7-984f-39082b95a977",
                                "text": "„BSH-Kunststoffventilatoren sind in fast allen Industriezweigen und überall dort zu finden, wo aggressive Medien abgesaugt bzw. gefördert werden müssen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
