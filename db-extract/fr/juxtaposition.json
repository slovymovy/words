                    }
                ],
                "senses": [
                    {
                        "sense_id": "ef97a1b5-3cb0-3246-a2e2-1a0b3a8eab1b",
                        "entry_id": "106f8b86-9432-3556-b799-ecd6d7c6771b",
                        "glosses": [
                            "Action de mettre l’une à côté de l’autre deux ou plusieurs choses."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf85811f-741c-4e56-a7b8-f4c049358d98",
                                "sense_id": "ef97a1b5-3cb0-3246-a2e2-1a0b3a8eab1b",
                                "text": "…puis on réunissait par juxtaposition un certain nombre de brins pour former un fil."
                            }
                        ]
                    },
                    {
                        "sense_id": "d2a4c782-4745-32e5-b802-edd1b34564f5",
                        "entry_id": "106f8b86-9432-3556-b799-ecd6d7c6771b",
                        "glosses": [
                            "Résultat de cette action."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e5566047-a67d-4d59-bc7d-73ccfa426934",
                        "source_entry_id": "106f8b86-9432-3556-b799-ecd6d7c6771b",
                        "target_lang_word": "juxtaposition",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "juxtaposition",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "59815e80-ee25-37ac-9c8d-fcbd33d4f220",
                                        "entry_id": "1aca8d4d-ef47-3ef7-aa17-c5ccf479c1dc",
                                        "glosses": [
                                            "The nearness of objects with little or no delimiter."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1718b68b-fd56-462e-849c-0dd78853bd62",
                                                "sense_id": "59815e80-ee25-37ac-9c8d-fcbd33d4f220",
                                                "text": "It is the object of the mechanical atomistic philosophy to confound synthesis with synartesis, or rather with mere juxtaposition of corpuscles separated by invisible interspaces."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "511e044a-27cb-3c53-b6be-fa5f43e4c78d",
                                        "entry_id": "1aca8d4d-ef47-3ef7-aa17-c5ccf479c1dc",
                                        "glosses": [
                                            "The nearness of objects with little or no delimiter.",
                                            "An absence of linking elements in a group of words that are listed together."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff861bd1-55b2-49f7-befd-014b8cccf66b",
                                                "sense_id": "511e044a-27cb-3c53-b6be-fa5f43e4c78d",
                                                "text": "Example: mother father instead of mother and father"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b043dd1-d1fd-3739-abd8-bfd21a1c81cd",
                                        "entry_id": "1aca8d4d-ef47-3ef7-aa17-c5ccf479c1dc",
                                        "glosses": [
                                            "The nearness of objects with little or no delimiter.",
                                            "An absence of operators in an expression."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9c54d87d-8588-4426-80f0-40181769918d",
                                                "sense_id": "2b043dd1-d1fd-3739-abd8-bfd21a1c81cd",
                                                "text": "Using juxtaposition for multiplication saves space when writing longer expressions. a#92;timesb collapses to ab."
                                            },
                                            {
                                                "example_id": "7b159419-838b-4186-b401-c8e387e02ece",
                                                "sense_id": "2b043dd1-d1fd-3739-abd8-bfd21a1c81cd",
                                                "text": "A fundamental operation on strings is string concatenation which we will denote by juxtaposition."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0ab28f05-babe-3824-a4f6-be4db0dd4d6b",
                                        "entry_id": "1aca8d4d-ef47-3ef7-aa17-c5ccf479c1dc",
                                        "glosses": [
                                            "The extra emphasis given to a comparison when the contrasted objects are close together."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0eadf954-4370-49ed-9bb4-69f2a0965014",
                                                "sense_id": "0ab28f05-babe-3824-a4f6-be4db0dd4d6b",
                                                "text": "There was a poignant juxtaposition between the boys laughing in the street and the girl crying on the balcony above."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "516ca8d6-c0db-3033-be47-346af0dd473e",
                                        "entry_id": "1aca8d4d-ef47-3ef7-aa17-c5ccf479c1dc",
                                        "glosses": [
                                            "The extra emphasis given to a comparison when the contrasted objects are close together.",
                                            "Two or more contrasting sounds, colours, styles etc. placed together for stylistic effect."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f4bdb039-cd7a-420f-8dcc-9d6c33c855be",
                                                "sense_id": "516ca8d6-c0db-3033-be47-346af0dd473e",
                                                "text": "The juxtaposition of the bright yellows on the dark background made the painting appear three dimensional."
                                            },
                                            {
                                                "example_id": "245a9792-38f6-48c7-849c-6e4cd0dca0e3",
                                                "sense_id": "516ca8d6-c0db-3033-be47-346af0dd473e",
                                                "text": "Her mother favored a multiyear project: obscenities carved in intricate and clever juxtapositions, descending every finger, curling in lettered whorls across the palm, fanning in offensive rays across the opisthenar, which is the name for the back of the hand, a word that Leilani knew because she had studied the structure of the human hand in detail, the better to understand her difference."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d56ba2c7-34e2-3da9-99ae-ed50e1f762e2",
                                        "entry_id": "1aca8d4d-ef47-3ef7-aa17-c5ccf479c1dc",
                                        "glosses": [
                                            "The extra emphasis given to a comparison when the contrasted objects are close together.",
                                            "The close placement of two ideas to imply a link that may not exist."
                                        ],
                                        "tags": [
                                            "countable",
                                            "rhetoric",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f8a32f9c-9fef-481e-9d63-83782a491ce1",
                                                "sense_id": "d56ba2c7-34e2-3da9-99ae-ed50e1f762e2",
                                                "text": "Example: In 1965 the government was elected; in 1965 the economy took a dive."
                                            }
                                        ]
                                    }
                                ]
                            },
