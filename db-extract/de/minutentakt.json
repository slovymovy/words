                ],
                "senses": [
                    {
                        "sense_id": "3457b8ec-2652-39a1-a349-ef6af108ad71",
                        "entry_id": "21e94800-2b61-38c4-ab41-6d1a7cb06e43",
                        "glosses": [
                            "jede Minute tritt etwas neu ein; jede Minute wiederholt sich etwas"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0399f38b-eea8-4001-a053-f22d19f43470",
                                "sense_id": "3457b8ec-2652-39a1-a349-ef6af108ad71",
                                "text": "Im Minutentakt baute sie am Fließband Teile zusammen."
                            },
                            {
                                "example_id": "9514b714-9455-4117-aecf-0ce5941b6534",
                                "sense_id": "3457b8ec-2652-39a1-a349-ef6af108ad71",
                                "text": "Am Hauptbahnhof rollen im Minutentakt neue Züge an."
                            },
                            {
                                "example_id": "e2376737-a4dc-4ea7-a355-17b008a2f102",
                                "sense_id": "3457b8ec-2652-39a1-a349-ef6af108ad71",
                                "text": "Pflege- und Arztpersonal klagen … über zu viel Arbeit. Pflege sei nur noch im Laufschritt, Gespräche zwischen Arzt und Patient nur im Minutentakt möglich."
                            },
                            {
                                "example_id": "b64d2b43-27a0-4da4-a7f8-dedf0d69edf4",
                                "sense_id": "3457b8ec-2652-39a1-a349-ef6af108ad71",
                                "text": "Es geht Schlag auf Schlag, ein Bewerber nach dem anderen. Ausbildungsplatzsuche im Minutentakt. Beim Job Speed Dating in Köln bieten Arbeitgeber und Arbeitssuchende die Möglichkeit, schneller in Kontakt zu treten."
                            },
                            {
                                "example_id": "760a9c62-aed7-4be2-ab4f-14bbb70db10a",
                                "sense_id": "3457b8ec-2652-39a1-a349-ef6af108ad71",
                                "text": "Zu den Stoßzeiten morgens und nachmittags starten und landen die Flugzeuge hier in Berlin-Tegel fast im Minutentakt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
