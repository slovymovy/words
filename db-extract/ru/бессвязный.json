                    }
                ],
                "translations": [
                    {
                        "translation_id": "245b5060-f05b-4f26-9b7c-0b68eddd0c3f",
                        "source_entry_id": "c3dd4d66-8950-3696-a998-5ec73ee4ffdc",
                        "source_sense_id": "71474755-ae43-3d64-bbc5-ba952fa7302f",
                        "target_lang_word": "incohérent",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "incohérent",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "950b2376-4e9c-3c25-9f3f-98f0799b0951",
                                        "entry_id": "ff095faa-a658-3ba3-8b9f-35710af7e2cd",
                                        "glosses": [
                                            "Qui manque de cohérence, de suite, de liaison."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f675826e-5d7a-4e3b-8e11-d2e5f60ec475",
                                                "sense_id": "950b2376-4e9c-3c25-9f3f-98f0799b0951",
                                                "text": "Couches de terrains incohérentes."
                                            },
                                            {
                                                "example_id": "51be1f82-98fa-43e6-be31-24c3f1ba6d9d",
                                                "sense_id": "950b2376-4e9c-3c25-9f3f-98f0799b0951",
                                                "text": "Langage incohérent."
                                            },
                                            {
                                                "example_id": "eff6d5d8-a523-45d6-ad7a-ffb09a0a43c0",
                                                "sense_id": "950b2376-4e9c-3c25-9f3f-98f0799b0951",
                                                "text": "Figures, images incohérentes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "844c4c57-7cc6-30e9-a9ef-47726c1566d5",
                                        "entry_id": "ff095faa-a658-3ba3-8b9f-35710af7e2cd",
                                        "glosses": [
                                            "Qui manque de logique, de réflexion ou de rationalité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55a676a5-1154-410f-9099-816cec24f954",
                                                "sense_id": "844c4c57-7cc6-30e9-a9ef-47726c1566d5",
                                                "text": "Paris m’étonna. Il me fit l’effet d’un grand bruit et d’une grande folie. Les individus et les foules passaient bizarres, incohérents, effrénés, se hâtant vers des besognes que je me figurais terribles et monstrueuses."
                                            },
                                            {
                                                "example_id": "efb32952-e006-40ff-8868-eef990c3da8c",
                                                "sense_id": "844c4c57-7cc6-30e9-a9ef-47726c1566d5",
                                                "text": "C’était une réponse si incohérente qu’il faisait ainsi, que maître Faramont n’en comprenait presque pas le sens."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "20dfe8a4-4ced-4f36-a1be-da421fda4e7c",
                        "source_entry_id": "c3dd4d66-8950-3696-a998-5ec73ee4ffdc",
                        "source_sense_id": "71474755-ae43-3d64-bbc5-ba952fa7302f",
                        "target_lang_word": "décousu",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "décousu",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "269489ea-5e07-32f0-bf88-a0051970b65f",
                                        "entry_id": "63aeb1cf-028c-39d3-aa0c-9f5967d30035",
                                        "glosses": [
                                            "Manque de cohérence, de structure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "212d0ffc-680e-44dd-9977-f68d879d2067",
                                                "sense_id": "269489ea-5e07-32f0-bf88-a0051970b65f",
                                                "text": "Comment expliquer une telle coexistence entre la motivation dynamique de la quête et le décousu qui la nie ?"
                                            },
                                            {
                                                "example_id": "c3e84fd9-c905-4310-be59-44e109f74f9a",
                                                "sense_id": "269489ea-5e07-32f0-bf88-a0051970b65f",
                                                "text": "On remarquait un certain décousu dans ses propos."
                                            },
                                            {
                                                "example_id": "08bf446b-ad9a-42ea-9c54-cbe5ac6f13fe",
                                                "sense_id": "269489ea-5e07-32f0-bf88-a0051970b65f",
                                                "text": "Cette alliance bizarre paraissait être le résultat d’une volonté puissante agissant incessamment sur un caractère faible, sur cette inconsistance particulière aux Slaves qui, tout en leur laissant un courage héroïque sur les champs de bataille, leur donne un incroyable décousu dans la conduite, une mollesse morale dont les causes devraient occuper les physiologistes, car les physiologistes sont à la politique ce que les entomologistes sont à l’agriculture."
                                            },
                                            {
                                                "example_id": "64d74cbe-1681-41ca-8340-c29b7af083b3",
                                                "sense_id": "269489ea-5e07-32f0-bf88-a0051970b65f",
                                                "text": "J'espère que l'on me pardonnera le décousu inévitable d'un récit fait dans de semblables conditions, dont tout le mérite consiste dans la sincérité des impressions et une certaine expérience du pays."
                                            },
                                            {
                                                "example_id": "11d8ce6b-5d70-4e20-8135-4d28b1812d7c",
                                                "sense_id": "269489ea-5e07-32f0-bf88-a0051970b65f",
                                                "text": "Sainte-Beuve, Théophile Gautier, me plurent un peu trop. Leur affectation d’immoralité m’empêcha de voir le décousu de leur philosophie."
                                            },
                                            {
                                                "example_id": "33f8b1e3-767a-490b-b258-94c523461862",
                                                "sense_id": "269489ea-5e07-32f0-bf88-a0051970b65f",
                                                "text": "L'organisation des idées lui fait défaut, certes. Son décousu, le coq-à-l'âne, il ne les jugule pas encore. Il le sait mais l'enthousiasme prend toujours le dessus."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "décousu",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "24165770-d426-3f5e-b732-e0d836946054",
                                        "entry_id": "a68c7059-e9e6-3862-a5dc-58cbf7033815",
                                        "glosses": [
                                            "Participe passé masculin singulier de découdre."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "décousu",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6fd33849-c818-37d9-a91a-818453cd4dca",
                                        "entry_id": "024274ec-08ea-3cb3-b2ae-cc282ba5880d",
                                        "glosses": [
                                            "Caractérise des propos sans suite, un style qui n’a pas de liaison, des événements non reliés entre eux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d9f4c0b-bfd8-4fad-9b75-cbc68af23c1a",
                                                "sense_id": "6fd33849-c818-37d9-a91a-818453cd4dca",
                                                "text": "Phrases décousues."
                                            },
                                            {
                                                "example_id": "3676bd6a-f558-4467-89dc-f0ed85b240b8",
                                                "sense_id": "6fd33849-c818-37d9-a91a-818453cd4dca",
                                                "text": "Conversation décousue."
                                            },
                                            {
                                                "example_id": "75237ab7-a59f-4ece-af1b-ffd4bc349c0d",
                                                "sense_id": "6fd33849-c818-37d9-a91a-818453cd4dca",
                                                "text": "Des idées décousues."
                                            },
                                            {
                                                "example_id": "921b2cf0-d3ac-4f7a-a6c2-3ca3eff547e9",
                                                "sense_id": "6fd33849-c818-37d9-a91a-818453cd4dca",
                                                "text": "En temps de paix, la vie est harmonieuse et composée. On rencontre les mêmes gens, on les retrouve, on les perd de vue, on les retrouve encore. Les histoires se nouent et se dénouent harmonieusement, comme dans les tragédies classiques. Mais à la guerre, tout est décousu, sans lien, sans suite, sans cohérence."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
