            "senses": [
                {
                    "sense_id": "b6c5b3ee-3a2c-3db2-8c05-08274b8dfc09",
                    "sense_definition": "Formation végétale dense et basse, constituée d'arbustes épineux et de buissons, typique des régions méditerranéennes.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vegetation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les randonneurs sentaient les herbes sauvages en marchant à travers le <w>maquis</w> corse."
                        },
                        {
                            "text": "Le troupeau de chèvres a disparu au milieu du <w>maquis</w> impénétrable."
                        }
                    ],
                    "synonyms": [
                        "broussaille"
                    ],
                    "common_phrases": [
                        "maquis corse"
                    ]
                },
                {
                    "sense_id": "3ea175dc-38bf-3b0b-8fd5-861e8ab27833",
                    "sense_definition": "Groupe ou organisation clandestine de résistants armés luttant contre un occupant ou un régime autoritaire.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "resistance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De nombreux jeunes hommes ont rejoint le <w>maquis</w> pour combattre l'occupant allemand."
                        },
                        {
                            "text": "Les combattants du <w>maquis</w> organisaient des sabotages réguliers de voies ferrées."
                        }
                    ],
                    "synonyms": [
                        "guérilla"
                    ],
                    "common_phrases": [
