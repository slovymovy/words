                "senses": [
                    {
                        "sense_id": "e7d1fede-0c7c-3674-afae-d93285efcf0c",
                        "entry_id": "9c342d15-449c-3de6-b427-572aefa552f5",
                        "glosses": [
                            "The state of being objective, just, unbiased, and not influenced by irrational emotions or personal prejudices."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "444800de-6f53-46d8-9d6b-a8987d5713ab",
                                "sense_id": "e7d1fede-0c7c-3674-afae-d93285efcf0c",
                                "text": "maintain objectivity"
                            },
                            {
                                "example_id": "cc371a79-ca3a-4c4d-bab0-fdcceca09d7a",
                                "sense_id": "e7d1fede-0c7c-3674-afae-d93285efcf0c",
                                "text": "sense of objectivity"
                            },
                            {
                                "example_id": "0c9723d3-31ca-4dca-961a-bdc3c8d21059",
                                "sense_id": "e7d1fede-0c7c-3674-afae-d93285efcf0c",
                                "text": "The scientist’s objectivity was questioned after the funding controversy."
                            },
                            {
                                "example_id": "c73f2e30-f1f0-4930-9942-6f066761b2ef",
                                "sense_id": "e7d1fede-0c7c-3674-afae-d93285efcf0c",
                                "text": "Good journalism requires strict objectivity."
                            }
                        ]
                    },
                    {
                        "sense_id": "e2525c76-8311-3dc4-8d0f-4cfc268076f3",
                        "entry_id": "9c342d15-449c-3de6-b427-572aefa552f5",
                        "glosses": [
                            "The world as it really is; reality."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9ba3c9bd-67bb-452f-af99-12c7f46002b5",
                        "source_entry_id": "9c342d15-449c-3de6-b427-572aefa552f5",
                        "source_sense_description": "The state of being objective",
                        "target_lang_word": "objectiviteit",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "objectiviteit",
