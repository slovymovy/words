                                "target_senses": [
                                    {
                                        "sense_id": "864e4e77-468a-37ae-a259-33382c5718f8",
                                        "entry_id": "06be9e8a-6940-3a2b-9750-25046c3aabfc",
                                        "glosses": [
                                            "During the off-season."
                                        ],
