                    }
                ],
                "senses": [
                    {
                        "sense_id": "4677dbdb-2c11-3411-ba53-f9cb188ab19d",
                        "entry_id": "7f95aea5-5d71-335f-a1c7-433e53ffe917",
                        "glosses": [
                            "Nest einer Krähe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e12a8ed-e5fe-4b1b-b4e6-ee6c839eab0e",
                                "sense_id": "4677dbdb-2c11-3411-ba53-f9cb188ab19d",
                                "text": "Bei der Gartenarbeit entdeckte sie ein Krähennest in einem Baum."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "811cf343-fd54-3323-a02c-10f5b321469c",
                        "entry_id": "7f95aea5-5d71-335f-a1c7-433e53ffe917",
                        "glosses": [
                            "korbartiger, hochgelegener Ausguck"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ac8f299-c756-4d52-94de-76882c7c2afd",
                                "sense_id": "811cf343-fd54-3323-a02c-10f5b321469c",
                                "text": "„Das Bild war vermutlich aus dem Krähennest aufgenommen, von der Besatzung war niemand zu erkennen - doch, auf der Flakplattform des Vorschiffes kauerten, von sprühender Gischt verdeckt, zwei Gestalten und winkten zu den Fotografen hinauf.“"
                            },
                            {
                                "example_id": "8adddc40-ab65-4e76-8832-066be4f7554c",
                                "sense_id": "811cf343-fd54-3323-a02c-10f5b321469c",
                                "text": "„Der Marsgast im Krähennest schreit sich die Stimme heiser.“"
                            },
                            {
                                "example_id": "d0b8f39a-64ea-4b4a-b2bb-7fb1f2ec2d62",
                                "sense_id": "811cf343-fd54-3323-a02c-10f5b321469c",
                                "text": "„Biologe Boisseau hat vom Krähennest aus mit dem Fernglas eine Schule Weißschnauzendelfine entdeckt, die näher kommen und in der Bugwelle des Seglers reiten.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d78854fb-b656-48e0-823d-f4f3a51d6e66",
                        "source_entry_id": "7f95aea5-5d71-335f-a1c7-433e53ffe917",
                        "source_sense_id": "811cf343-fd54-3323-a02c-10f5b321469c",
                        "source_sense_description": "Seefahrt: korbartiger, hochgelegener Ausguck",
                        "target_lang_word": "crow's nest",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "crow's nest",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "29152f04-155b-3037-b12b-0a66f7403bd5",
                                        "entry_id": "04728479-5730-374e-92da-a152f4937954",
                                        "glosses": [
                                            "A small open-top shelter, originally a cask, on the top of the foremast, large enough to accommodate a lookout. It was used by whalers to watch for a blow (spout), or in icebound waters to seek a channel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dff382d6-4e8a-4055-9494-f894bd0ea6d2",
                                                "sense_id": "29152f04-155b-3037-b12b-0a66f7403bd5",
                                                "text": "When Captain Sleet in person stood his mast-head in this crow’s-nest of his, he tells us that he always had a rifle with him (also fixed in the rack), together with a powder flask and shot, for the purpose of popping off the stray narwhales, or vagrant sea unicorns infesting those waters; […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "66b36b7f-9320-4179-a275-63b2fd791e8e",
                        "source_entry_id": "7f95aea5-5d71-335f-a1c7-433e53ffe917",
                        "source_sense_id": "811cf343-fd54-3323-a02c-10f5b321469c",
                        "source_sense_description": "Seefahrt: korbartiger, hochgelegener Ausguck",
                        "target_lang_word": "nid-de-pie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "1fe73444-4a1d-420a-bd6c-c5ff38cbff99",
                        "source_entry_id": "7f95aea5-5d71-335f-a1c7-433e53ffe917",
                        "source_sense_id": "811cf343-fd54-3323-a02c-10f5b321469c",
                        "source_sense_description": "Seefahrt: korbartiger, hochgelegener Ausguck",
                        "target_lang_word": "vigie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vigie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8333f790-e8e6-3577-9a4d-cd2649507049",
                                        "entry_id": "ba332f55-2dd7-39a2-9473-01725d6cbcc7",
                                        "glosses": [
                                            "Sentinelle, marin qui surveille les alentours."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "164168c3-8a0a-40c2-abf5-41968789cf75",
                                                "sense_id": "8333f790-e8e6-3577-9a4d-cd2649507049",
                                                "text": "Tous, d’ailleurs, comme autant de vigies, fouillaient l’horizon du regard."
                                            },
                                            {
                                                "example_id": "f85c00ca-a185-4316-a2c5-09254ee68ae5",
                                                "sense_id": "8333f790-e8e6-3577-9a4d-cd2649507049",
                                                "text": "Le soir la vigie signale à quelques encablures de la côte une goélette immobile qui semble donner de la bande. […]. Comme le schooner peut avoir besoin de secours, nous approchons en sondant prudemment."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f57bd716-ba20-39cf-b273-d774a6c1098a",
                                        "entry_id": "ba332f55-2dd7-39a2-9473-01725d6cbcc7",
                                        "glosses": [
                                            "Poste d’observation d'un navire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff05606a-4d07-4afd-95bd-f31b3974ca5f",
                                                "sense_id": "f57bd716-ba20-39cf-b273-d774a6c1098a",
                                                "text": "Le matelot de vigie signala un énorme poisson qui s’ébattait dans le sillage du yacht."
                                            },
                                            {
                                                "example_id": "9e6b3869-dc34-4bde-ab8f-fdc360280dab",
                                                "sense_id": "f57bd716-ba20-39cf-b273-d774a6c1098a",
                                                "text": "Par brume la vigie faite par un seul homme ne semble pas constituer une surveillance suffisante, même à bord d'un petit bâtiment. Les prescriptions de l'art. 24 tendent à exiger le fonctionnement d'une vigie à l'arrière."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "404823d3-0e15-3d6a-bafa-290318c30060",
                                        "entry_id": "ba332f55-2dd7-39a2-9473-01725d6cbcc7",
                                        "glosses": [
                                            "Poste d’observation, mirador."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cc0e66c2-a71b-40da-a406-725bb63e214e",
                                                "sense_id": "404823d3-0e15-3d6a-bafa-290318c30060",
                                                "text": "Le clocher de Saint-Martial de Toull s’élevait à l’horizon comme une vigie de sauvetage."
                                            },
                                            {
                                                "example_id": "69ea6de2-06f0-4037-a466-82781a2329bf",
                                                "sense_id": "404823d3-0e15-3d6a-bafa-290318c30060",
                                                "text": "Le clocher n’est autre qu’une épaisse tourelle fortifiée, percée de meurtrières hautes servant à la fois de vigie et de remparts."
                                            },
                                            {
                                                "example_id": "97d8e782-f8b0-449d-9928-29d99f5b5f41",
                                                "sense_id": "404823d3-0e15-3d6a-bafa-290318c30060",
                                                "text": "Tout au sommet de la dune, une vigie recouvre, très au loin, le pays; rien ne peut lui échapper."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "59b1f9b5-82b5-390c-8142-da75ed06c283",
                                        "entry_id": "ba332f55-2dd7-39a2-9473-01725d6cbcc7",
                                        "glosses": [
                                            "Pointes de rochers isolées au milieu de la mer et à fleur de l'eau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23fc7b9d-2e51-435e-865e-f5085beefb1c",
                                                "sense_id": "59b1f9b5-82b5-390c-8142-da75ed06c283",
                                                "text": "A peu près à 80 lieues dans le N quelques degrés O des Bermudes , il y a une vigie découverte en 1787, située par 36°-15' IN , et par 66°-3o' à l'O de Paris."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f35923e-914f-328a-9258-24c37abeaf5b",
                                        "entry_id": "ba332f55-2dd7-39a2-9473-01725d6cbcc7",
                                        "glosses": [
                                            "Loge établie au sommet d’un fourgon."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
