                ],
                "senses": [
                    {
                        "sense_id": "cbbe2645-dd99-3d62-a04d-aaa97dfb7a7c",
                        "entry_id": "9a925867-8ac3-3144-bbe6-9102fa7f7991",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab56cdf3-1605-4373-9c8f-75d91154a019",
                                "sense_id": "cbbe2645-dd99-3d62-a04d-aaa97dfb7a7c",
                                "text": "Frau Maentele ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "76542d15-627b-4e0a-9667-6c83c94b0f5e",
                                "sense_id": "cbbe2645-dd99-3d62-a04d-aaa97dfb7a7c",
                                "text": "Herr Maentele wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "76a44327-52e6-4962-83e4-44e27d198c17",
                                "sense_id": "cbbe2645-dd99-3d62-a04d-aaa97dfb7a7c",
                                "text": "Die Maenteles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "f75cd0cd-a2b4-451f-b018-ddbfbb14f460",
                                "sense_id": "cbbe2645-dd99-3d62-a04d-aaa97dfb7a7c",
                                "text": "Der Maentele trägt nie die Schals, die die Maentele ihm strickt."
                            },
                            {
                                "example_id": "4f93aac7-82a4-4928-ab41-6b8b70fb8452",
                                "sense_id": "cbbe2645-dd99-3d62-a04d-aaa97dfb7a7c",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Maentele kommt, geht der Herr Maentele.“"
                            },
                            {
                                "example_id": "a1c94dda-710b-4ce0-979b-a08711e787b1",
                                "sense_id": "cbbe2645-dd99-3d62-a04d-aaa97dfb7a7c",
                                "text": "Maentele kommt und geht."
                            },
                            {
                                "example_id": "efde0cb5-7037-42de-bf03-53f6804f05c7",
                                "sense_id": "cbbe2645-dd99-3d62-a04d-aaa97dfb7a7c",
                                "text": "Maenteles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
