    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "f735b3f6-3720-3164-abfd-204798ecbc48",
                "word": "verst",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "f58e7b62-16b2-4a3e-8381-280c2ddf387c",
                        "entry_id": "f735b3f6-3720-3164-abfd-204798ecbc48",
                        "tags": [
                            "plural"
                        ],
                        "form": "versts"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "aa35af8c-5933-3f64-9980-1aed7785b6e8",
                        "entry_id": "f735b3f6-3720-3164-abfd-204798ecbc48",
                        "glosses": [
                            "A Russian unit of length, equivalent to about 1.07 kilometres or about ²⁄₃ of a mile."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc0ab0f2-e595-4490-b3be-7e6a21a8b432",
                                "sense_id": "aa35af8c-5933-3f64-9980-1aed7785b6e8",
                                "text": "|The hill Pulkowa, twelve miles (seventeen wersts) south of Admiralty Palace in St. Petersburg, […]"
                            },
                            {
                                "example_id": "ad6237cd-7a6b-4a8b-b91b-3290fc10166b",
                                "sense_id": "aa35af8c-5933-3f64-9980-1aed7785b6e8",
                                "text": "Her particular part of the country was a few hundred versts the other side of Tamboff, with some fifteen miles of agrarian disturbance between her and the nearest neighbour."
                            },
                            {
                                "example_id": "96e2c63e-a497-4e93-91ab-44d4a126667d",
                                "sense_id": "aa35af8c-5933-3f64-9980-1aed7785b6e8",
                                "text": "‘Is it much further, Michael?’ she asked the clerk, to dispel the thoughts that frightened her. ‘They say it's seven versts from this village.’"
                            },
                            {
                                "example_id": "7d4c918c-05e2-4dbc-a0ac-66cd2a3f6e00",
                                "sense_id": "aa35af8c-5933-3f64-9980-1aed7785b6e8",
                                "text": "You have to tramp three or four versts to get to the exhibition of war loot, past Fabergé eggs and the Impressionists."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fd0eb4a5-656a-4f89-9b75-5bc7302beb14",
                        "source_entry_id": "f735b3f6-3720-3164-abfd-204798ecbc48",
                        "source_sense_id": "aa35af8c-5933-3f64-9980-1aed7785b6e8",
                        "source_sense_description": "unit of length",
                        "target_lang_word": "versta",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "4719b774-b910-448a-b283-3651e0bbc73d",
                        "source_entry_id": "f735b3f6-3720-3164-abfd-204798ecbc48",
                        "source_sense_id": "aa35af8c-5933-3f64-9980-1aed7785b6e8",
                        "source_sense_description": "unit of length",
                        "target_lang_word": "werst",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "werst",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "dfaee96d-cbff-3778-98e5-0b71740c8ed2",
                                        "entry_id": "ea67b505-d56d-3c22-b092-b997585b7d22",
                                        "glosses": [
                                            "oude Russische lengtemaat uit tsaristische tijden. Een werst = 1066,78 meter"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "76deb7b9-23e6-4591-afe7-54ae7e425a9c",
                                                "sense_id": "dfaee96d-cbff-3778-98e5-0b71740c8ed2",
                                                "text": "Dus onder het gezang pak ik het ventje handig beet\nDaar vliegt hij uit de trojka met een griezelige kreet\nDe wolven hebben alle aandacht voor die lekkernij\nNog vierentachtig werst en o, wat zijn wij heden blij\nDrs. P."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "da92e21f-f2c4-4c43-85f3-37ad7beb0a42",
                        "source_entry_id": "f735b3f6-3720-3164-abfd-204798ecbc48",
                        "source_sense_id": "aa35af8c-5933-3f64-9980-1aed7785b6e8",
                        "source_sense_description": "unit of length",
                        "target_lang_word": "verste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "69112fbd-d22d-3e85-933c-58a3763c5bcf",
                                        "entry_id": "b2bef8e6-9690-3c50-8fb3-2566805d24d8",
                                        "glosses": [
                                            "Mesure itinéraire de Russie, qui vaut 1067 mètres."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7745bddb-a58e-4f2b-a258-a5c22ee793f4",
                                                "sense_id": "69112fbd-d22d-3e85-933c-58a3763c5bcf",
                                                "text": "Des centaines de verstes dans la steppe déserte, monotone, brûlée de soleil, ne sauraient vous accabler autant qu’un homme qui s’incruste chez vous pour parler sans fin, et dont on ignore quand il s’en ira."
                                            },
                                            {
                                                "example_id": "b0e55829-d1ac-4943-9f16-01f1fb1f267f",
                                                "sense_id": "69112fbd-d22d-3e85-933c-58a3763c5bcf",
                                                "text": "J’aurais voulu visiter le fameux sanctuaire d’Atesh-Gâh ; mais il est à vingt-deux verstes de la ville, et le temps m’eût manqué."
                                            },
                                            {
                                                "example_id": "053eed01-28fa-4f41-9d5e-b7957517b3db",
                                                "sense_id": "69112fbd-d22d-3e85-933c-58a3763c5bcf",
                                                "text": "Le 23, nous arrivons à Medvegegare et descendons, toujours au milieu des gardes rouges. Nous gagnons la campagne et continuons à totaliser ; les verstes sont interminables."
                                            },
                                            {
                                                "example_id": "6f09f360-8d3e-473c-9fd2-209a2c45c76c",
                                                "sense_id": "69112fbd-d22d-3e85-933c-58a3763c5bcf",
                                                "text": "Je l’ai laissée chez sa sœur aînée, à quelques verstes de ses parents qui n’ont jamais rien su."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b442b8dd-6bc9-44d8-bfa5-62ffcf1ddd7a",
                        "source_entry_id": "f735b3f6-3720-3164-abfd-204798ecbc48",
                        "source_sense_id": "aa35af8c-5933-3f64-9980-1aed7785b6e8",
                        "source_sense_description": "unit of length",
                        "target_lang_word": "Werst",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Werst",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cde40ed6-c188-3557-9228-549b70a41698",
                                        "entry_id": "deff8d00-e17d-3a9b-aac1-5919fe2d2904",
                                        "glosses": [
                                            "altes Längenmaß im zaristischen Russland, das ab 1835 1.066,78 Metern, vorher 1.077 Metern entsprach"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39c05845-812b-4262-a687-1dea8941563e",
                                                "sense_id": "cde40ed6-c188-3557-9228-549b70a41698",
                                                "text": "„In der Gegend von Pérékop: der alte See (Staroy Osero) von 15 Wersten im Umfange, der das beste Salz und das meiste von demjenigen liefert, was in das Innere des Reichs gebracht wird“."
                                            },
                                            {
                                                "example_id": "395b7171-f649-4e6e-8b9b-1acb9bc4d854",
                                                "sense_id": "cde40ed6-c188-3557-9228-549b70a41698",
                                                "text": "„Nachdem wir von der Höhe hinabgestiegen waren und etwa 35 Werst zurückgelegt hatten, lagerten wir uns am linken Ufer des Tentek, der, nachdem er hier alle seine Zuflüsse in ein Strombett vereinigt hat, nach NNO. fliesst.“"
                                            },
                                            {
                                                "example_id": "da03f9de-3af9-452d-8cb6-643679de945d",
                                                "sense_id": "cde40ed6-c188-3557-9228-549b70a41698",
                                                "text": "„Von einem Gehangrande zum anderen ist bei kleinen Flüssen von 50 bis 100 Wersten Länge 1 bis 1¹⁄₂ Werst, bei größeren Flüssen von 400 bis 600 Wersten Länge 2 bis 3 Wersten Zwischenraum.“"
                                            },
                                            {
                                                "example_id": "cd5959dc-0367-42e1-a43d-9e0f4ec3a3c0",
                                                "sense_id": "cde40ed6-c188-3557-9228-549b70a41698",
                                                "text": "„Gegen Osten, 15 Werst von hier, befindet sich die Stadt Paisbat, aus welcher der Vitriol erhalten wird.“"
                                            },
                                            {
                                                "example_id": "bfa81bcc-3ee4-44ca-a2e1-e56735ce0d4e",
                                                "sense_id": "cde40ed6-c188-3557-9228-549b70a41698",
                                                "text": "„Sie tauchten eine Werst abseits der Heerstraße auf und zogen sich, sobald ein Schuss fiel, in die Wälder zurück.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f5f86782-61e3-4756-9791-e5997c26cc0f",
