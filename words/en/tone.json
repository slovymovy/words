                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "sound_quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please leave a message after you hear the <w>tone</w>.",
                            "target_lang_translations": {
