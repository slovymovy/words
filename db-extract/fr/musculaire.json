                "forms": [
                    {
                        "form_id": "7829c415-c323-44c3-8cf8-393bea544134",
                        "entry_id": "dd569fc6-aeb9-3cbf-be66-123068f70849",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "musculaires"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1d6cfe3d-aecf-3c6b-bda1-3a8b4552beba",
                        "entry_id": "dd569fc6-aeb9-3cbf-be66-123068f70849",
                        "glosses": [
                            "Des muscles ; relatif aux muscles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0551617d-cb56-4d99-8f3d-a8a7626d0d4b",
                                "sense_id": "1d6cfe3d-aecf-3c6b-bda1-3a8b4552beba",
                                "text": "Petit, maigre, s'il ne possédait pas une grande force musculaire, en revanche, son énergie morale le mettait au-dessus de toutes les épreuves et de tous les événements."
                            },
                            {
                                "example_id": "4f805d27-5ca3-4c1c-a542-376cca0570ad",
                                "sense_id": "1d6cfe3d-aecf-3c6b-bda1-3a8b4552beba",
                                "text": "Comme Tonsard, que son renom dispensait de toute preuve de férocité, comme tous ceux qui sont gardés par une opinion publique quelconque, Socquard ne déployait jamais sa triomphante force musculaire, à moins que des amis ne l’en priassent."
                            },
                            {
                                "example_id": "d6ef9434-9d28-46cc-93bf-2e66b6793037",
                                "sense_id": "1d6cfe3d-aecf-3c6b-bda1-3a8b4552beba",
                                "text": "On peut en conclure que les perméants hydrophiles utilisés ne donnent pas lieu à une adsorption sensible sur les structures musculaires (auquel cas R aurait une tendance à augmenter dans le domaine des concentrations faibles)."
                            },
                            {
                                "example_id": "0964081e-3b51-4046-a580-155f7e84584e",
                                "sense_id": "1d6cfe3d-aecf-3c6b-bda1-3a8b4552beba",
                                "text": "Les victimes de violences sexuelles dans l’enfance ont un risque plus important de souffrir de douleurs chroniques ; celles-ci peuvent être ostéo-articulaires, musculaires, migraineuses, abdominales, gastriques, pelviennes…"
                            }
                        ]
                    },
                    {
                        "sense_id": "eaf0c30e-f3fd-3ea5-b63f-552792773cea",
                        "entry_id": "dd569fc6-aeb9-3cbf-be66-123068f70849",
                        "glosses": [
                            "Se dit d’un véhicule qui est mût par la seule force de ou des personnes qui l’occupe."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ef5778af-8e76-4f92-96d9-fbb763c5c43d",
                        "source_entry_id": "dd569fc6-aeb9-3cbf-be66-123068f70849",
                        "source_sense_description": "En rapport aux muscles",
                        "target_lang_word": "muskulär",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "muskulär",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0591b1c4-9000-3830-8a21-ae2c2c4a2e4a",
                                        "entry_id": "8f61b3ec-3e8d-3c44-95eb-400b9cf58e93",
                                        "glosses": [
                                            "zu den Muskeln gehörig, die Muskulatur betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dcf1ac4a-a7fe-400d-87e5-bafb90b0ce67",
                                                "sense_id": "0591b1c4-9000-3830-8a21-ae2c2c4a2e4a",
                                                "text": "Trainer Thomas Schaaf muss auf Aaron Hunt und Petri Pasanen verzichten, sein Kapitän Frank Baumann wurde dagegen nach muskulären Problemen rechtzeitig fit."
                                            },
                                            {
                                                "example_id": "b5e4c34a-276d-461b-94fa-50c407dba80c",
                                                "sense_id": "0591b1c4-9000-3830-8a21-ae2c2c4a2e4a",
                                                "text": "Beim David-System handelt es sich um spezielle, computergestützte Geräte, die eine biomechanische Funktionsanalyse der Wirbelsäule möglich machen und muskuläre sowie Beweglichkeits-Defizite aufspüren können."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7daf20ac-03f7-4939-8115-215b8038ffe9",
                        "source_entry_id": "dd569fc6-aeb9-3cbf-be66-123068f70849",
