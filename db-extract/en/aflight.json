    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "ae5c0fa2-78c8-305e-8df0-4796817f3142",
                "word": "aflight",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "ee298478-91bf-323e-aebc-1a87450a30d8",
                        "entry_id": "ae5c0fa2-78c8-305e-8df0-4796817f3142",
                        "glosses": [
                            "Flying."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "7eeab60e-e402-47a8-b71c-f5d663afad46",
                                "sense_id": "ee298478-91bf-323e-aebc-1a87450a30d8",
                                "text": "1874, Ambrose Bierce (as Dod Grile), “The Legend of Immortal Truth” in Cobwebs, London: “Fun” Office, ca. 1884, p. 114,\nThen, like a rocket set aflight, / She sprang, and streaked it for the light!"
                            },
                            {
                                "example_id": "65ab3ca0-e001-41d5-8927-786a47d98e0e",
                                "sense_id": "ee298478-91bf-323e-aebc-1a87450a30d8",
                                "text": "The elderly Pollyana of the infant aviation had photographs of their glider of 1902 aflight at Kitty Hawk."
                            },
                            {
                                "example_id": "8e929d63-5414-4c62-815e-2e49075cd10b",
                                "sense_id": "ee298478-91bf-323e-aebc-1a87450a30d8",
                                "text": "[…] the Vestibule was full of birds and the birds were all aflight."
                            }
                        ]
                    },
                    {
                        "sense_id": "20b5a272-9346-38bf-9bb9-996171d152c2",
                        "entry_id": "ae5c0fa2-78c8-305e-8df0-4796817f3142",
                        "glosses": [
                            "Covered or filled (with something flying)."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "426dd247-42d2-42a4-85cb-6a95e2e689bc",
                                "sense_id": "20b5a272-9346-38bf-9bb9-996171d152c2",
                                "text": "curved attics aflight with / angels"
                            },
                            {
                                "example_id": "9557bbb2-036d-4345-91e4-5899a0f73f84",
                                "sense_id": "20b5a272-9346-38bf-9bb9-996171d152c2",
                                "text": "In the distance the billabong was white with egrets and aflight with ducks;"
                            },
                            {
                                "example_id": "1581e40c-02e6-42f4-b6f6-d17ee83bb5c6",
                                "sense_id": "20b5a272-9346-38bf-9bb9-996171d152c2",
                                "text": "[I] saw a stream of animals, hooved, padded, clawed and dashing, splashing through the ponds for Various Aquatic Birds, setting the night aflight—"
                            }
                        ]
                    },
                    {
                        "sense_id": "a3354f94-44ac-3f05-b402-755548775e40",
                        "entry_id": "ae5c0fa2-78c8-305e-8df0-4796817f3142",
                        "glosses": [
                            "Fleeing."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "fe21f0e2-241e-4dbd-a4f1-66b310dc675b",
                                "sense_id": "a3354f94-44ac-3f05-b402-755548775e40",
                                "text": "1915, Marvin M. Taylor, “The Roll of the War Drums” in Donald Tulloch (ed.), Songs and Poems of the Great World War, Worcester, MA: Davis Press, p. 17,\nLike shepherdless sheep from wolves aflight"
                            },
                            {
                                "example_id": "9eea06b4-7d41-4948-8575-792f226cbe5b",
                                "sense_id": "a3354f94-44ac-3f05-b402-755548775e40",
                                "text": "The five now aflight from Massacre Canyon would have posses beating the bush for them."
                            }
                        ]
                    },
                    {
                        "sense_id": "5050783f-fae0-39a9-b102-abb6eb4459bd",
                        "entry_id": "ae5c0fa2-78c8-305e-8df0-4796817f3142",
                        "glosses": [
                            "Showing distress, anxiety or other strong emotion."
                        ],
                        "tags": [
                            "not-comparable",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "d073abd5-82e8-4e37-939f-5c915bdff19d",
                                "sense_id": "5050783f-fae0-39a9-b102-abb6eb4459bd",
                                "text": "1547, uncredited translator, A Simple, and Religious Consultation by Hermann of Wied, London: John Day, “Of the crosse, and aflictions,”\n[…] when the crosse, and afliction cometh vpon them, their mynde is aflight, it considereth not that the thynges, whiche it suffereth, be the scourges of Goddes wrath,"
                            },
                            {
                                "example_id": "8f3703b7-49d1-4d1b-b328-fdbe5cb76b80",
                                "sense_id": "5050783f-fae0-39a9-b102-abb6eb4459bd",
                                "text": "1817, anonymous (attributed to James Athearn Jones), Hardenbrass and Haverill, London: Sherwood, Neely, and Jones, Volume 2, Chapter 1, p. 7,\n“ […] I dare not leave her without locking the door; for the poor thing is quite aflight, and talks about nothing but guns and swords, and bloody knives, and rapes, and other weapons.”"
                            },
                            {
                                "example_id": "d647b703-20ff-4aab-9a2f-c1fa733f830f",
                                "sense_id": "5050783f-fae0-39a9-b102-abb6eb4459bd",
                                "text": "I made this in the night, / When my mind was aflight,"
                            }
                        ]
                    }
