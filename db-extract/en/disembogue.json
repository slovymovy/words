                "senses": [
                    {
                        "sense_id": "db1f9615-87e7-363c-ab78-da27607234c3",
                        "entry_id": "cd025ea4-d9b5-340d-b236-908061eef395",
                        "glosses": [
                            "To come out into the open sea from a river etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "086dfdcb-64fe-47de-8ce0-a288314eb4d3",
                                "sense_id": "db1f9615-87e7-363c-ab78-da27607234c3",
                                "text": "The ships disembogued from the harbour."
                            },
                            {
                                "example_id": "a38af7b5-2cf8-41ed-9301-ececa6e31f38",
                                "sense_id": "db1f9615-87e7-363c-ab78-da27607234c3",
                                "text": "No, no, but you call careening of an old morphewed lady to make her disembogue again – there's roughcast phrase to your plastic."
                            }
                        ]
                    },
                    {
                        "sense_id": "90dff5f2-c2f5-3125-9150-6d477a18eed7",
                        "entry_id": "cd025ea4-d9b5-340d-b236-908061eef395",
                        "glosses": [
                            "To pour out, to debouch; to flow out through a narrow opening into a larger space."
                        ],
                        "tags": [
                            "of a river or waters"
                        ],
                        "examples": [
                            {
                                "example_id": "2c981c22-2024-4ca4-bafa-26810b3629e7",
                                "sense_id": "90dff5f2-c2f5-3125-9150-6d477a18eed7",
                                "text": "You yeoman phevvterer, conduct mee to / The Lady of the manſion, or my poniard / Shall diſemboge thy ſoule."
                            },
                            {
                                "example_id": "469cc05f-f85c-42b0-8016-b2fe022c91c1",
                                "sense_id": "90dff5f2-c2f5-3125-9150-6d477a18eed7",
                                "text": "The river of Behut, near the pergunnah of Shoor, unites with the Chinaub, and then after running twenty-seven coss, they disembogue themselves into the river Sinde, near Ooch."
                            },
                            {
                                "example_id": "756e7ed1-9ed6-4c58-9429-96ac187d20b1",
                                "sense_id": "90dff5f2-c2f5-3125-9150-6d477a18eed7",
                                "text": "Keängsoo is easy of approach : but though the two largest rivers of China, the Yellow river, and the Yangtsze keäng, both disembogue themselves into the sea within its confines, yet it possesses but one good port, which is Shanghae heën, near the frontiers of Chekeäng."
                            },
                            {
                                "example_id": "cec3179f-f59d-463a-bf0b-3194d11a664f",
                                "sense_id": "90dff5f2-c2f5-3125-9150-6d477a18eed7",
                                "text": "‘Oh piffle, Durfeys – it flows to the westward and disembogues along the Pepper Coast.’"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8f14da63-416b-42cd-8786-36a98329a995",
                        "source_entry_id": "cd025ea4-d9b5-340d-b236-908061eef395",
                        "source_sense_description": "(of a river or waters) to pour out, to debouch",
                        "target_lang_word": "münden",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "münden",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1c9e7bed-d4a5-39b9-98a9-04b6775dd040",
                                        "entry_id": "392cfa9a-eb61-3cff-9f68-975bc9afb000",
                                        "glosses": [
                                            "in ein anderes Gewässer hineinfließen"
                                        ],
                                        "tags": [
                                            "von Fließgewässern"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7755a2f4-fb90-4766-a35a-01a4b0240513",
                                                "sense_id": "1c9e7bed-d4a5-39b9-98a9-04b6775dd040",
                                                "text": "Die Mosel mündet in Koblenz in den Rhein."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "92dc0cc7-84dd-3101-939d-5ea304b21201",
                                        "entry_id": "392cfa9a-eb61-3cff-9f68-975bc9afb000",
                                        "glosses": [
                                            "in etwas anderes übergehen"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "03ec7342-f998-41f8-875a-5421c1c4f635",
                                                "sense_id": "92dc0cc7-84dd-3101-939d-5ea304b21201",
                                                "text": "„Diese Überlegungen münden dann in ein Plädoyer für eine erneuerte Sozial- und Kapitalismuskritik.“"
                                            },
                                            {
                                                "example_id": "63d97d3a-01bc-4e94-87fc-cf1e000e1e0d",
                                                "sense_id": "92dc0cc7-84dd-3101-939d-5ea304b21201",
                                                "text": "„In den Jahren 1962 bis 1968 diskutierte man im finnischen Reichstag (Parlament) über eine Schulstrukturreform, die schließlich in der Einführung von Gemeinschaftsschulen im ganzen Land mündete.“"
                                            },
                                            {
                                                "example_id": "af0480cf-9935-46a3-8212-ccb0e01e5cf9",
                                                "sense_id": "92dc0cc7-84dd-3101-939d-5ea304b21201",
                                                "text": "„So begannen im Spätsommer es Jahres 55 v. Chr. die ersten Maßnahmen zur Ausdehnung des römischen Machtbereichs auf Britannien, die 100 Jahre später in die Eroberung eines Großteils der Insel mündeten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
