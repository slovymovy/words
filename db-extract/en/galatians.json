                    {
                        "translation_id": "3d33a76a-ea54-443b-b9b0-ccd44cd1369a",
                        "source_entry_id": "623ae341-dda9-31d2-a689-06ba6bcccdd1",
                        "source_sense_id": "231ab9bc-5ff9-3723-8867-b69e3f7e98dd",
                        "source_sense_description": "book of the Bible",
                        "target_lang_word": "Galater",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Galater",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4df4e624-38c1-3600-ad17-b9e0e0c48317",
                                        "entry_id": "bee3ef9f-77f7-3426-9863-b1640a2f9eec",
                                        "glosses": [
                                            "Angehöriger der nach Kleinasien ausgewanderten keltischen Bevölkerung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d3f9afa-d4a9-4cb6-a065-c7b9c51967de",
                                                "sense_id": "4df4e624-38c1-3600-ad17-b9e0e0c48317",
                                                "text": "„Jeder der drei Stämme der Galater teilte sich jeweils in vier Gruppen auf und jede dieser Gruppen wurde von einem Tetrarchen regiert.“"
                                            },
                                            {
                                                "example_id": "6327b0bd-a78f-4574-97c1-72b21b25828f",
                                                "sense_id": "4df4e624-38c1-3600-ad17-b9e0e0c48317",
                                                "text": "„Die Kelten, die auf den Balkan und nach Kleinasien zogen, hießen bei den Griechen Galater, und ihre Sprache, das Galatische, hielt sich bis ins 5. Jahrhundert nach Christus.“"
                                            },
                                            {
                                                "example_id": "0c93186c-a39e-4f62-a322-d7c84cac722a",
                                                "sense_id": "4df4e624-38c1-3600-ad17-b9e0e0c48317",
                                                "text": "„Der seleukidische König Antiochos II. hielt sich eine aus Galatern rekrutierte Leibgarde.“"
                                            },
                                            {
                                                "example_id": "62837747-a379-4943-8722-7f6b55418d7d",
                                                "sense_id": "4df4e624-38c1-3600-ad17-b9e0e0c48317",
                                                "text": "„Das Volk der Volker lebte zuerst in der Umgebung von Rhein, Leine und Main und im THüringer Wald, später zogen Kontingente der Bevölkerung nach Aquitanien in Frankreich und als Galater nach Galatien in der heutigen Türkei.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
