{
    "word_family": [
        "gallnut",
        "gallfly",
        "gallstone",
        "gallbladder"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f193a337-aea6-3992-bf12-451251069c9b",
                    "sense_definition": "Impudence or brazenness; audacious behavior or nerve.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "boldness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He had the <w>gall</w> to ask for a promotion after missing work for a week.",
                            "target_lang_translations": {
                                "ru": "У него хватило <w>наглости</w> попросить о повышении после того, как он неделю прогулял работу."
                            }
                        },
                        {
                            "text": "Nobody could believe her sheer <w>gall</w> when she blamed others for her own mistake.",
                            "target_lang_translations": {
                                "ru": "Никто не мог поверить в её вопиющую <w>дерзость</w>, когда она обвинила других в собственной ошибке."
                            }
                        }
                    ],
                    "common_phrases": [
                        "have the gall",
                        "sheer gall",
                        "unmitigated gall"
                    ],
                    "target_lang_definitions": {
                        "ru": "Дерзость, наглость или возмутительное бесстыдство в поведении."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наглость",
                                "target_lang_sense_clarification": "дерзкое, бесстыдное поведение"
                            },
                            {
                                "target_lang_word": "дерзость",
                                "target_lang_sense_clarification": "смелость, граничащая с неуважением"
                            },
                            {
                                "target_lang_word": "нахальство",
                                "target_lang_sense_clarification": "беспардонность"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b1920a5f-45a9-3732-ab9a-2583a6a2fc80",
                    "sense_definition": "Bile produced by the liver, known for its bitter taste.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "biology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bitter fluid known as <w>gall</w> helps animals break down fats during digestion.",
                            "target_lang_translations": {
                                "ru": "Горькая жидкость, известная как <w>жёлчь</w>, помогает животным расщеплять жиры во время пищеварения."
                            }
                        },
                        {
                            "text": "The hunter carefully removed the digestive organs to avoid tainting the meat with <w>gall</w>.",
                            "target_lang_translations": {
                                "ru": "Охотник осторожно извлёк органы пищеварения, чтобы не испортить мясо <w>жёлчью</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Горькая жидкость, вырабатываемая печенью; жёлчь."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жёлчь",
                                "target_lang_sense_clarification": "секрет печени"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7e4909db-104f-3f01-8c9e-4e4d131b4ece",
                    "sense_definition": "An abnormal swelling or growth on a plant caused by insects, fungi, or bacteria.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "botany",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The botanist pointed out a round <w>gall</w> forming on the underside of the oak leaf.",
                            "target_lang_translations": {
                                "ru": "Ботаник указал на круглый <w>галл</w>, образовавшийся на нижней стороне дубового листа."
                            }
                        },
                        {
                            "text": "Certain tiny wasps induce the tree to create a protective <w>gall</w> around their larvae.",
                            "target_lang_translations": {
                                "ru": "Некоторые крошечные осы побуждают дерево образовывать защитный <w>галл</w> вокруг их личинок."
                            }
                        }
                    ],
                    "synonyms": [
                        "nutgall"
                    ],
                    "common_phrases": [
                        "oak gall"
                    ],
                    "target_lang_definitions": {
                        "ru": "Патологический нарост или опухоль на органах растений, вызываемый паразитами."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "галл",
                                "target_lang_sense_clarification": "патологический нарост на растении"
                            },
                            {
                                "target_lang_word": "чернильный орешек",
                                "target_lang_sense_clarification": "нарост на листьях дуба"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "37529dda-c6dc-3ccf-8b27-e93006c9ca0a",
                    "sense_definition": "A painful sore or wound on the skin caused by rubbing or friction.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "physical_sore",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rough leather of the strap rubbed his neck until a painful <w>gall</w> formed.",
                            "target_lang_translations": {
                                "ru": "Грубая кожа ремня натирала ему шею, пока не образовалась болезненная <w>потёртость</w>."
                            }
                        },
                        {
                            "text": "The doctor applied an ointment over the open <w>gall</w> on the runner's heel.",
                            "target_lang_translations": {
                                "ru": "Врач нанёс мазь на открытую <w>ссадину</w> на пятке бегуна."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Болезненное повреждение кожи, потёртость или ссадина от трения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "потёртость",
                                "target_lang_sense_clarification": "ссадина от трения на коже"
                            },
                            {
                                "target_lang_word": "ссадина",
                                "target_lang_sense_clarification": "повреждение кожного покрова"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f9e9c712-29fb-39fb-935e-036e91854b10",
                    "sense_definition": "The gallbladder.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "biology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ancient anatomists described the position of the <w>gall</w> in relation to the liver.",
                            "target_lang_translations": {
                                "ru": "Древние анатомы описывали расположение <w>жёлчного пузыря</w> относительно печени."
                            }
                        },
                        {
                            "text": "The blade pierced the warrior deeply, striking through into the <w>gall</w>.",
                            "target_lang_translations": {
                                "ru": "Клинок глубоко вонзился в воина, поразив <w>жёлчный пузырь</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used in modern medical contexts outside archaic or literary writing."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Жёлчный пузырь (в устаревшем или анатомическом контексте)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жёлчный пузырь",
                                "target_lang_sense_clarification": "орган пищеварительной системы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "675d8cc3-52f7-3b7e-8838-2d477f47a2e4",
                    "sense_definition": "Something extremely bitter, distressing, or hard to bear.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "bitterness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His unexpected betrayal turned all her happy memories into pure <w>gall</w>.",
                            "target_lang_translations": {
                                "ru": "Его неожиданное предательство превратило все её счастливые воспоминания в чистую <w>горечь</w>."
                            }
                        },
                        {
                            "text": "The ancient text spoke of drinking a mixture of <w>gall</w> and wormwood.",
                            "target_lang_translations": {
                                "ru": "В древнем тексте говорилось о питье смеси из <w>жёлчи</w> и полыни."
                            }
                        }
                    ],
                    "common_phrases": [
                        "gall and wormwood"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used chiefly in literary or biblical styles."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Нечто крайне горькое, мучительное или невыносимое."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "горечь",
                                "target_lang_sense_clarification": "душевная боль, тяжесть"
                            },
                            {
                                "target_lang_word": "жёлчь",
                                "target_lang_sense_clarification": "в переносном смысле: злоба, яд"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "48c8794a-93cb-3449-abe5-104f6488aca9",
                    "sense_definition": "A sore on a horse caused by chafing from harness or saddle equipment.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "physical_sore",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rider loosened the girth when he noticed a deep <w>gall</w> on the mare's flank.",
                            "target_lang_translations": {
                                "ru": "Всадник ослабил подпругу, когда заметил глубокую <w>потёртость</w> на боку кобылы."
                            }
                        },
                        {
                            "text": "An ill-fitting saddle will quickly create a tender <w>gall</w> across the horse's back.",
                            "target_lang_translations": {
                                "ru": "Плохо пригнанное седло быстро натрёт болезненный <w>намин</w> на спине лошади."
                            }
                        }
                    ],
                    "common_phrases": [
                        "saddle gall"
                    ],
                    "target_lang_definitions": {
                        "ru": "Потёртость или язва на теле лошади от сбруи или седла."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "потёртость",
                                "target_lang_sense_clarification": "на коже лошади от сбруи"
                            },
                            {
                                "target_lang_word": "намин",
                                "target_lang_sense_clarification": "болезненная потёртость у животных"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4fe2bcb3-09db-3ab8-915a-a639b484c7a3",
                    "sense_definition": "A state or feeling of exasperation, annoyance, or resentment.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "annoyance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It stirred his <w>gall</w> to watch unworthy rivals receive all the credit.",
                            "target_lang_translations": {
                                "ru": "В нём вскипала <w>жёлчь</w>, когда он видел, как недостойным соперникам достаются все почести."
                            }
                        },
                        {
                            "text": "She spoke with noticeable <w>gall</w> whenever the topic of the inheritance arose.",
                            "target_lang_translations": {
                                "ru": "Она говорила с заметным <w>раздражением</w> всякий раз, когда заходила речь о наследстве."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Now mostly replaced by modern terms for exasperation."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Чувство сильного раздражения, досады или озлобленности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жёлчь",
                                "target_lang_sense_clarification": "раздражение, язвительность"
                            },
                            {
                                "target_lang_word": "раздражение",
                                "target_lang_sense_clarification": "чувство досады"
                            },
                            {
                                "target_lang_word": "досада",
                                "target_lang_sense_clarification": "чувство неудовольствия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "59bb8f74-2d2b-349f-bebf-9f4c07b90cf3",
                    "sense_definition": "A surface defect or wear scar caused by friction and material adhesion between sliding metal parts.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "engineering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The engineer inspected the cylinder for any visible <w>gall</w> caused by metal-on-metal contact.",
                            "target_lang_translations": {
                                "ru": "Инженер осмотрел цилиндр на предмет видимых <w>задиров</w>, вызванных трением металла о металл."
                            }
                        },
                        {
                            "text": "Without proper lubrication, each tiny <w>gall</w> on the shaft eventually seized the machine.",
                            "target_lang_translations": {
                                "ru": "Без надлежащей смазки каждый мелкий <w>задир</w> на валу в итоге привёл к заклиниванию механизма."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Повреждение или след задира на металлической поверхности от трения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "задир",
                                "target_lang_sense_clarification": "дефект поверхности от схватывания металла"
                            },
                            {
                                "target_lang_word": "истирание",
                                "target_lang_sense_clarification": "износ от трения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2f98e602-ecff-380a-87a1-278b6e73590d",
                    "sense_definition": "A localized knot, lump, or uneven flaw on a surface resembling a plant growth.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "flaw",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Select horsehair for fishing line that is smooth and free from any knot or <w>gall</w>.",
                            "target_lang_translations": {
                                "ru": "Выбирайте для лески конский волос — гладкий, без узелков и <w>утолщений</w>."
                            }
                        },
                        {
                            "text": "The carpenter discarded timber boards bearing an unsightly <w>gall</w> along the grain.",
                            "target_lang_translations": {
                                "ru": "Плотник отбраковал доски с некрасивыми <w>наростами</w> вдоль волокон древесины."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in historical crafts and trades."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Утолщение, нарост или дефект на поверхности волокна или дерева."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нарост",
                                "target_lang_sense_clarification": "неровность или утолщение"
                            },
                            {
                                "target_lang_word": "утолщение",
                                "target_lang_sense_clarification": "неровность на волокне"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4dfdcc97-2f99-3840-8984-87ea8ed67f22",
                    "sense_definition": "To irritate, annoy, or vex someone intensely.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "annoyance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It <w>galled</w> her to admit that her political rival had formulated the better proposal.",
                            "target_lang_translations": {
                                "ru": "Её <w>уязвляло</w> признание того, что её политический соперник сформулировал более удачное предложение."
                            }
                        },
                        {
                            "text": "His smug and self-satisfied attitude never failed to <w>gall</w> everyone in the meeting.",
                            "target_lang_translations": {
                                "ru": "Его напыщенный и самодовольный вид неизменно <w>раздражал</w> всех присутствующих на собрании."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сильно раздражать, уязвлять или выводить из себя."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "язвить",
                                "target_lang_sense_clarification": "задевать за живое"
                            },
                            {
                                "target_lang_word": "раздражать",
                                "target_lang_sense_clarification": "вызывать досаду"
                            },
                            {
                                "target_lang_word": "задевать",
                                "target_lang_sense_clarification": "уязвлять самолюбие"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "342e6188-d3f8-311f-8b65-ccc4e773d697",
                    "sense_definition": "To chafe or wear away skin through continual rubbing and friction.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "physical_sore",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The stiff collar began to <w>gall</w> his neck after hours of marching in the heat.",
                            "target_lang_translations": {
                                "ru": "Жёсткий воротник начал <w>натирать</w> ему шею после нескольких часов марша на жаре."
                            }
                        },
                        {
                            "text": "Ill-fitting hiking boots will invariably <w>gall</w> your ankles over long distances.",
                            "target_lang_translations": {
                                "ru": "Неподходящие туристические ботинки на длинных дистанциях неизбежно <w>натрут</w> вам лодыжки."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Натирать кожу непрерывным трением до ссадин."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "натирать",
                                "target_lang_sense_clarification": "повреждать кожу трением"
                            },
                            {
                                "target_lang_word": "тереть",
                                "target_lang_sense_clarification": "вызывать раздражение кожи трением"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a99c458f-be60-3a56-8f90-67c551b5443d",
                    "sense_definition": "To cause continuous bodily discomfort, pain, or distress.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "physical_sore",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tight wool uniform continued to <w>gall</w> the young soldier throughout inspection.",
                            "target_lang_translations": {
                                "ru": "Тесная шерстяная форма продолжала <w>мучить</w> молодого солдата на протяжении всего смотра."
                            }
                        },
                        {
                            "text": "Although the cut had begun healing, the persistent ache began to <w>gall</w> his shoulder.",
                            "target_lang_translations": {
                                "ru": "Хотя порез начал затягиваться, непрекращающаяся ноющая боль стала <w>донимать</w> его плечо."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Predominantly historical or literary usage."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причинять постоянную телесную боль, дискомфорт или мучение."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мучить",
                                "target_lang_sense_clarification": "причинять физический дискомфорт"
                            },
                            {
                                "target_lang_word": "донимать",
                                "target_lang_sense_clarification": "беспокоить болью"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5537c447-fcf6-3bbc-a793-db112fcb761f",
                    "sense_definition": "To harass or inflict damage upon an enemy through repeated attacks.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "military",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Archers hidden in the tree line began to <w>gall</w> the advancing army's exposed flanks.",
                            "target_lang_translations": {
                                "ru": "Лучники, укрывшиеся среди деревьев, принялись <w>тревожить</w> открытые фланги наступающей армии."
                            }
                        },
                        {
                            "text": "Light cavalry squadrons were sent forward specifically to <w>gall</w> the retreating troops.",
                            "target_lang_translations": {
                                "ru": "Эскадроны лёгкой кавалерии были отправлены вперёд специально для того, чтобы <w>изнурять</w> отступающие войска."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used primarily in historical and military accounts."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Изнурять или тревожить противника постоянными атаками или обстрелом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тревожить",
                                "target_lang_sense_clarification": "беспокоить противника набегами"
                            },
                            {
                                "target_lang_word": "изнурять",
                                "target_lang_sense_clarification": "ослаблять непрерывными атаками"
                            },
