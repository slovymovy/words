                "senses": [
                    {
                        "sense_id": "d2e47e7e-8d57-3a97-a36a-d700568dd82e",
                        "entry_id": "d31160e3-3214-3fb6-90a5-0dacfa941cc6",
                        "glosses": [
                            "совершённый без закона, не по закону"
                        ],
                        "tags": [],
