                ],
                "senses": [
                    {
                        "sense_id": "d9c2d597-c719-3f88-8dd4-39350fcb9a2b",
                        "entry_id": "8e3d8cf6-65d7-3472-8af7-0fd60826b5e7",
                        "glosses": [
                            "To drive back or beat back; to repulse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e0fd711-5050-4fe2-accc-eb7489473d73",
                                "sense_id": "d9c2d597-c719-3f88-8dd4-39350fcb9a2b",
                                "text": "Who him r'encountring fierce, as hauke in flight, / Perforce rebutted backe."
                            }
                        ]
                    },
                    {
                        "sense_id": "2d3c5a53-aa95-35f9-9eef-8e90ee9b88e7",
                        "entry_id": "8e3d8cf6-65d7-3472-8af7-0fd60826b5e7",
                        "glosses": [
                            "To deny the truth of something, especially by presenting arguments that disprove it."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf645448-3df2-4eaf-add8-cc05fe800477",
                                "sense_id": "2d3c5a53-aa95-35f9-9eef-8e90ee9b88e7",
                                "text": "Rebutting allegations that Scotland's railways had been deliberately run down, he pointed out that in the past nine years over £70m had been spent on their development."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a9ec8b30-fbbe-4db1-8f3e-185025d9a423",
                        "source_entry_id": "8e3d8cf6-65d7-3472-8af7-0fd60826b5e7",
                        "source_sense_description": "deny the truth of something",
                        "target_lang_word": "réfuter",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "réfuter",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "784f48f0-59a1-3fcf-8adc-e426d508daa1",
                                        "entry_id": "2b3facc4-c428-3815-901b-c800268080bf",
                                        "glosses": [
                                            "Combattre, détruire par des raisons convaincantes ce qu’un autre a avancé ; prouver que ce qu’un adversaire a dit est mal fondé ou n’est pas vrai."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b74e6b9-a8ee-44aa-8767-d75e1fbe8696",
                                                "sense_id": "784f48f0-59a1-3fcf-8adc-e426d508daa1",
                                                "text": "J'ai réfuté ces accusations, je ne suis pas raciste."
                                            },
                                            {
                                                "example_id": "22af28c9-e400-4962-93d1-6e48cbe4ef27",
                                                "sense_id": "784f48f0-59a1-3fcf-8adc-e426d508daa1",
                                                "text": "Combault réfutant l’assertion du tribunal, qu’il y avait dans l’Internationale des chefs et des dirigés dit : « Chacun de nous est libre et agit librement ; il n’y a aucune pression de pensée, entre les Internationaux... »"
                                            },
                                            {
                                                "example_id": "1f9c93f3-4453-4329-8328-2170bb7090bf",
                                                "sense_id": "784f48f0-59a1-3fcf-8adc-e426d508daa1",
                                                "text": "Donner des démentis est à la portée du premier imbécile venu. C'est une forme de l’idémisme, de l'automatisme mental. Mais réfuter une objection ! Voilà qui n'est pas votre fait."
                                            },
                                            {
                                                "example_id": "623cf3a3-23fa-4553-9dea-bac6837cd9a2",
                                                "sense_id": "784f48f0-59a1-3fcf-8adc-e426d508daa1",
                                                "text": "Elle adorait inconsciemment les nouvelles fausses, celles qu’aucune vraisemblance ne peut soutenir. Les lui réfutait-on ? Elle n’entendait pas, à moins que ce ne fût son fils."
                                            },
                                            {
                                                "example_id": "bf2d71da-4243-4669-bd40-dffa01da513a",
                                                "sense_id": "784f48f0-59a1-3fcf-8adc-e426d508daa1",
                                                "text": "Certaines thèses avancées par les théoriciens du complot font appel à de nombreux faits troublants que seules de laborieuses analyses poussées pourraient clairement réfuter."
                                            },
                                            {
                                                "example_id": "e83b9f16-20bf-4d64-9218-9d3244b57ea9",
                                                "sense_id": "784f48f0-59a1-3fcf-8adc-e426d508daa1",
                                                "text": "Réfuter un livre, réfuter un auteur : combattre ce qui a été avancé dans un livre, ce qu’un auteur a proposé, soutenu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a17355ef-40a0-3d5b-8580-69e409197c1b",
                                        "entry_id": "2b3facc4-c428-3815-901b-c800268080bf",
                                        "glosses": [
                                            "Démontrer le contraire de."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5b5a70d-4297-488c-a204-c50645b286d9",
                                                "sense_id": "a17355ef-40a0-3d5b-8580-69e409197c1b",
                                                "text": "Réfuter une conjecture."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
