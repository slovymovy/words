        "fr-extract.jsonl": [
            {
                "entry_id": "933ad95b-f345-32e6-8d15-603475b104da",
                "word": "koulak",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "12b1261f-d865-4a79-bba9-78873aecbb5b",
                        "entry_id": "933ad95b-f345-32e6-8d15-603475b104da",
                        "tags": [
                            "plural"
                        ],
                        "form": "koulaks"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1b5f47c9-8b08-38c4-8a92-c3654a67d7eb",
                        "entry_id": "933ad95b-f345-32e6-8d15-603475b104da",
                        "glosses": [
                            "Paysan aisé dans la Russie tsariste et post-tsariste."
                        ],
                        "tags": [
                            "Communisme",
                            "URSS"
                        ],
                        "examples": [
                            {
                                "example_id": "c57297bf-0e7d-4400-a066-7749d5286057",
                                "sense_id": "1b5f47c9-8b08-38c4-8a92-c3654a67d7eb",
                                "text": "La collectivisation stalinienne de la propriété privée des koulaks au profit des kolkhozes a entraîné la déportation, l’incarcération voire la mort de cinq millions de paysans, particulièrement en Ukraine."
                            },
                            {
                                "example_id": "c3dc6f48-0b27-4d44-bd37-f763538c2b21",
                                "sense_id": "1b5f47c9-8b08-38c4-8a92-c3654a67d7eb",
                                "text": "Le vieux village avec son église bien en évidence, avec les belles maisons du chef de la police, du pope et du koulak, au premier plan ; et ses isbas à demi écroulées, au plan arrière, ce village-là, commence à disparaître."
                            },
                            {
                                "example_id": "dd18f15e-572a-4cf4-9529-ca63666288cf",
                                "sense_id": "1b5f47c9-8b08-38c4-8a92-c3654a67d7eb",
                                "text": "Son corps bascula sur le vieux koulak, qui cessa de jouer, gêné par le visage ensanglanté."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b13e7c02-6b2a-4656-b2ec-2019b9b0330a",
                        "source_entry_id": "933ad95b-f345-32e6-8d15-603475b104da",
                        "source_sense_id": "1b5f47c9-8b08-38c4-8a92-c3654a67d7eb",
                        "target_lang_word": "Kulak",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "9a7f243d-fb6c-4144-b30b-21004a538bc2",
                        "source_entry_id": "933ad95b-f345-32e6-8d15-603475b104da",
                        "source_sense_id": "1b5f47c9-8b08-38c4-8a92-c3654a67d7eb",
                        "target_lang_word": "kulak",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kulak",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b347a4ed-b392-3cc9-85af-8f644c5c484b",
                                        "entry_id": "d18e6ccd-9d78-3c6a-b38c-766dc9eb70da",
                                        "glosses": [
                                            "A prosperous peasant in the Russian Empire or the Soviet Union, who owned land and could hire workers."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b48c7c21-13c1-437b-8384-4f5a35d3061a",
                                                "sense_id": "b347a4ed-b392-3cc9-85af-8f644c5c484b",
                                                "text": "The “internal organs,” as the CHEKA and the GPU and the KGB used to style themselves, were asked to police the mind for heresy as much as to torture kulaks to relinquish the food they withheld from the cities."
                                            },
                                            {
                                                "example_id": "da027c23-6761-479f-8452-697ca026e004",
                                                "sense_id": "b347a4ed-b392-3cc9-85af-8f644c5c484b",
                                                "text": "We are the “upper middle class”, the new kulaks whose antisocial self-interest and lack of submission to the aims of the revolutionary vanguard must be extinguished."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "93368f2e-b9be-4825-b56c-b2fcf005a464",
                        "source_entry_id": "933ad95b-f345-32e6-8d15-603475b104da",
                        "source_sense_id": "1b5f47c9-8b08-38c4-8a92-c3654a67d7eb",
                        "target_lang_word": "kułak",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kułak",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "930bc794-c835-3ee7-8fbb-0ec976e917d9",
                                        "entry_id": "3a991ed7-e0af-316f-b9ff-077872187437",
                                        "glosses": [
                                            "majętny chłop tępiony przez władzę radziecką"
                                        ],
                                        "tags": [
                                            "scornfully"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4294f0e8-6d35-48a5-963c-d053097d7436",
                                                "sense_id": "930bc794-c835-3ee7-8fbb-0ec976e917d9",
                                                "text": "Uporczywa nagonka propagandowa na kułaków miała uzasadniać brutalną rozprawę z nimi"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            },
