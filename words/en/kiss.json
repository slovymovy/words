{
    "word_family": [
        "kissable",
        "kisser"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "fc821801-f48f-3e2e-b852-535872aaae02",
                    "sense_definition": "To touch someone or something with the lips, usually to show love, affection, or as a greeting.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "physical_affection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She leaned over and <w>kissed</w> her sleeping child on the forehead.",
                            "target_lang_translations": {
                                "ru": "Она наклонилась и <w>поцеловала</w> своего спящего ребенка в лоб.",
                                "zh": "她俯下身，在熟睡孩子的额头上<w>亲</w>了一下。"
                            }
                        },
                        {
                            "text": "He <w>kissed</w> his wife goodbye before leaving for work.",
                            "target_lang_translations": {
                                "ru": "Он <w>поцеловал</w> жену на прощание перед уходом на работу.",
                                "zh": "他出门上班前<w>亲吻</w>了妻子以示告别。"
                            }
                        }
                    ],
                    "synonyms": [
                        "smooch"
                    ],
                    "common_phrases": [
                        "kiss goodbye",
                        "kiss hello",
                        "kiss the bride"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прикасаться к кому-либо или чему-либо губами, обычно чтобы выразить любовь, привязанность или в качестве приветствия.",
                        "zh": "用嘴唇触碰某人或某物，通常用于表达爱意、亲昵或作为问候。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "целова́ть",
                                "target_lang_sense_clarification": "несовершенный вид"
                            },
                            {
                                "target_lang_word": "поцелова́ть",
                                "target_lang_sense_clarification": "совершенный вид"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "亲",
                                "target_lang_sense_clarification": "动词，口语中常用的表达"
                            },
                            {
                                "target_lang_word": "亲吻",
                                "target_lang_sense_clarification": "动词，较正式的表达"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "94703121-3daf-3ae8-ae2e-910d5013b51f",
                    "sense_definition": "Of two or more people, to touch each other's lips together to express love or passion.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "physical_affection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The young couple <w>kissed</w> passionately under the streetlights.",
                            "target_lang_translations": {
                                "ru": "Молодая пара страстно <w>целовалась</w> под светом уличных фонарей.",
                                "zh": "年轻情侣在路灯下热烈地<w>接吻</w>。"
                            }
                        },
                        {
                            "text": "They decided to <w>kiss</w> and make up after their long argument.",
                            "target_lang_translations": {
                                "ru": "Они решили <w>поцеловаться</w> и помириться после долгой ссоры.",
                                "zh": "经过长时间的争吵后，他们决定<w>亲嘴</w>言和。"
                            }
                        }
                    ],
                    "synonyms": [
                        "smooch",
                        "snog"
                    ],
                    "common_phrases": [
                        "kiss and make up"
                    ],
                    "target_lang_definitions": {
                        "ru": "О двух или более людях: прикасаться губами друг к другу, выражая любовь или страсть.",
                        "zh": "指两人或多人互相用嘴唇触碰，以表达爱意或激情。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "целова́ться",
                                "target_lang_sense_clarification": "несовершенный вид"
                            },
                            {
                                "target_lang_word": "поцелова́ться",
                                "target_lang_sense_clarification": "совершенный вид"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "接吻",
                                "target_lang_sense_clarification": "动词，指双方的亲吻行为"
                            },
                            {
                                "target_lang_word": "亲嘴",
                                "target_lang_sense_clarification": "动词，口语表达"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b9ccffa7-3eab-3db1-b83a-e21f2facce9b",
                    "sense_definition": "To touch something lightly or gently; to come into contact briefly.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "light_touch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The gentle morning breeze <w>kissed</w> her face as she opened the window.",
                            "target_lang_translations": {
                                "ru": "Нежный утренний ветерок <w>коснулся</w> её лица, когда она открыла окно.",
                                "zh": "她打开窗户时，清晨的微风<w>轻触</w>着她的脸庞。"
                            }
                        },
                        {
                            "text": "The golf ball just <w>kissed</w> the edge of the cup but did not drop in.",
                            "target_lang_translations": {
                                "ru": "Мяч для гольфа лишь <w>коснулся</w> края лунки, но не упал в неё.",
                                "zh": "高尔夫球只是<w>掠过</w>了洞口边缘，但没有掉进去。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Легко или нежно прикасаться к чему-либо; вступать в кратковременный контакт.",
                        "zh": "轻微或柔和地触碰某物；短暂地接触。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "каса́ться",
                                "target_lang_sense_clarification": "несовершенный вид"
                            },
                            {
                                "target_lang_word": "косну́ться",
                                "target_lang_sense_clarification": "совершенный вид"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "轻触",
                                "target_lang_sense_clarification": "动词，指轻微的接触"
                            },
                            {
                                "target_lang_word": "掠过",
                                "target_lang_sense_clarification": "动词，指物体轻微擦过表面"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1fc2c8f7-cf0e-3fe1-9cb3-c856fb01d3c1",
                    "sense_definition": "A touch with the lips, usually to express love, affection, or as a greeting.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "physical_affection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She gave her father a quick <w>kiss</w> on the cheek.",
                            "target_lang_translations": {
                                "ru": "Она быстро <w>поцеловала</w> отца в щеку.",
                                "zh": "她在父亲的脸颊上快速地落下一<w>吻</w>。"
                            }
                        },
                        {
                            "text": "The actress blew a <w>kiss</w> to her fans as she walked down the red carpet.",
                            "target_lang_translations": {
                                "ru": "Актриса послала воздушный <w>поцелуй</w> своим фанатам, идя по красной ковровой дорожке.",
                                "zh": "女演员走在红毯上时，向粉丝们送出了一个飞<w>吻</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "smooch",
                        "peck"
                    ],
                    "common_phrases": [
                        "blow a kiss",
                        "give a kiss",
                        "first kiss"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прикосновение губами, обычно для выражения любви, привязанности или в качестве приветствия.",
                        "zh": "用嘴唇的触碰，通常用于表达爱意、亲昵或作为问候。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поцелу́й",
                                "target_lang_sense_clarification": "существительное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "吻",
                                "target_lang_sense_clarification": "名词，指亲吻的动作"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1875c0dd-96e3-3e76-afa2-d58a9ce81e76",
                    "sense_definition": "An 'X' mark placed at the end of a letter or message to represent a kiss.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "symbolic_mark",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She signed the birthday card with lots of hugs and <w>kisses</w>.",
                            "target_lang_translations": {
                                "ru": "Она подписала поздравительную открытку, послав множество объятий и <w>поцелуев</w>.",
                                "zh": "她在生日卡片上签了名，并送上许多拥抱和<w>吻</w>。"
                            }
                        },
                        {
                            "text": "He put a small <w>kiss</w> at the bottom of the note to show he cared.",
                            "target_lang_translations": {
                                "ru": "Он поставил маленький <w>крестик</w> внизу записки, чтобы показать свою заботу.",
                                "zh": "他在便条底部画了一个小小的<w>吻</w>以表达关怀。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "hugs and kisses"
                    ],
                    "target_lang_definitions": {
                        "ru": "Знак «X», который ставят в конце письма или сообщения для обозначения поцелуя.",
                        "zh": "写在信件或消息末尾的“X”符号，代表亲吻。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поцелу́й",
                                "target_lang_sense_clarification": "символическое значение"
                            },
                            {
                                "target_lang_word": "кре́стик",
                                "target_lang_sense_clarification": "знак в письме"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "吻",
                                "target_lang_sense_clarification": "指代信件末尾的符号"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0a36b10d-7293-3f2c-8692-15c1ae01c1a2",
                    "sense_definition": "A type of small, cone-shaped chocolate candy.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "candy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bowl on the table was filled with silver-wrapped chocolate <w>kisses</w>.",
                            "target_lang_translations": {
                                "ru": "Ваза на столе была наполнена шоколадными <w>конфетами</w> в серебристой обертке.",
                                "zh": "桌上的碗里装满了银色包装的<w>巧克力</w>。"
                            }
                        },
                        {
                            "text": "She ate a chocolate <w>kiss</w> for a quick sweet treat.",
                            "target_lang_translations": {
                                "ru": "Она съела шоколадную <w>конфету</w> как быстрое лакомство.",
                                "zh": "她吃了一颗<w>巧克力</w>作为快速的甜点。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "primarily US"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Разновидность маленьких шоколадных конфет конической формы.",
                        "zh": "一种圆锥形的小块巧克力糖果。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шокола́дная конфе́та",
                                "target_lang_sense_clarification": "сладость"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "巧克力",
                                "target_lang_sense_clarification": "指代这种特定形状的糖果"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "0add47ee-c6a2-334c-8082-1fe211276864",
                    "sense_definition": "A surname of Hungarian origin.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "We invited Mr. <w>Kiss</w> to speak at the conference next week.",
                            "target_lang_translations": {
                                "ru": "Мы пригласили господина <w>Киша</w> выступить на конференции на следующей неделе.",
                                "zh": "我们邀请了<w>基什</w>先生在下周的会议上发言。"
                            }
                        },
                        {
                            "text": "The <w>Kiss</w> family has lived in this neighborhood for fifty years.",
                            "target_lang_translations": {
                                "ru": "Семья <w>Киш</w> живет в этом районе уже пятьдесят лет.",
                                "zh": "<w>基什</w>一家在这个社区已经住了五十年了。"
                            }
                        }
                    ],
