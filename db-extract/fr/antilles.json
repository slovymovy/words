                                    {
                                        "sense_id": "43022933-975d-3ab8-add3-40fedd7fc239",
                                        "entry_id": "402f5736-9ccc-320f-9ae7-799b629d7e0a",
                                        "glosses": [
                                            "eilandengroep in de Caribische Zee, van Cuba in het noordwesten tot Barbados en Trinidad in het zuidoosten"
                                        ],
                                        "tags": [
                                            "toponymic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4cf92e81-3500-4f0a-94c9-60f06b54f99b",
                                                "sense_id": "43022933-975d-3ab8-add3-40fedd7fc239",
                                                "text": "Empirisch archeologisch onderzoek is nodig om de scheefgegroeide historische constructie recht te zetten en een waarheidsgetrouw beeld te schetsen van de leefgewoonten en gebruiken van de indiaanse samenlevingen die al zo’n 8000 jaar de Antillen kenmerkten voordat Columbus daar aankwam. Een diversiteit aan inheemse culturen heeft het Caraïbische landschap ingericht en sociale netwerken opgebouwd waarvan de Spanjaarden meteen na de kolonisatie gebruik maakten."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "48ea22bd-50f6-3aa6-b5f1-e52282a0bc55",
                                        "entry_id": "402f5736-9ccc-320f-9ae7-799b629d7e0a",
                                        "glosses": [
                                            "aanduiding voor de eilanden Curaçao, Aruba, Bonaire, Sint-Maarten, Saba en Sint-Eustatius die ooit de Nederlandse Antillen vormden"
                                        ],
                                        "tags": [
                                            "toponymic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "43e1db6a-55f7-4d28-b892-e229b5f4bfc0",
                                                "sense_id": "48ea22bd-50f6-3aa6-b5f1-e52282a0bc55",
                                                "text": "Het advies richt zich in eerste instantie op de circa 300.000 koloniale voorwerpen in de rijkscollectie, maar kan volgens de commissie ook richtinggevend zijn voor lokale overheden, provincies, universiteiten, stichtingen en particulieren met erfgoed uit Nederlands-Indië, Suriname en de Antillen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
