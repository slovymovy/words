                "senses": [
                    {
                        "sense_id": "271d2cd3-fbc4-38a2-88e7-8620acfec81f",
                        "entry_id": "59735e8b-f0c5-3396-8c58-dee08499fb0d",
                        "glosses": [
                            "einfach geschnittenes Kleid (ohne oder mit wenig Taillierung), das vorne geknöpft wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "85443fa0-605b-409f-b50f-d28e1cee8e45",
                                "sense_id": "271d2cd3-fbc4-38a2-88e7-8620acfec81f",
                                "text": "Meine Großmutter hat früher geblümte Kittelkleider getragen."
                            },
                            {
                                "example_id": "defa0c66-747f-467a-8d09-4a244e5a79d5",
                                "sense_id": "271d2cd3-fbc4-38a2-88e7-8620acfec81f",
                                "text": "Kittelkleider würde man sicher nicht auf einer Fashion-Show erwarten, nicht auf dem Laufsteg und schon gar nicht im Publikum."
                            },
                            {
                                "example_id": "835af2d1-9ad4-4e76-81b1-7e0e01065377",
                                "sense_id": "271d2cd3-fbc4-38a2-88e7-8620acfec81f",
                                "text": "„Gebeugte Mütterchen in für Südafrika typischen Kittelkleidern – einer Mischung aus afrikanischem Mustermix und nordeuropäisch geblümter Hausfrauenuniform – erkundigten sich verschmitzt, ob sie mitfahren könnten.“"
                            },
                            {
                                "example_id": "b4ebaf5c-89ff-4f08-bb44-a7b72b5312d4",
                                "sense_id": "271d2cd3-fbc4-38a2-88e7-8620acfec81f",
                                "text": "[Mode:] „[…] Andere trugen brave Kittelkleider mit roten Schottenkaros und schmal geschnittene blaue Wollmäntel. Willhelm bewies damit einmal mehr seinen Sinn für originelle Muster- und Stilkombinationen […]“"
                            },
                            {
                                "example_id": "36e77eec-bab2-428c-a6c6-8c7ecb5531ff",
                                "sense_id": "271d2cd3-fbc4-38a2-88e7-8620acfec81f",
                                "text": "[Otello:] „Leider muss sie gegen ihre Erscheinung, die ihr Regisseur und Kostümbildnerin verpasst haben, ansingen. Elza van den Heever ist eine große kräftige, junge Frau: das Kittelkleid und der graue Kapuzenpulli, das man ihr verpasst hat, machen die Partie unnötig klein.“"
                            },
                            {
                                "example_id": "ce9e4b8f-1379-4775-98cf-25ee6c905a45",
                                "sense_id": "271d2cd3-fbc4-38a2-88e7-8620acfec81f",
                                "text": "„Die winzige Szene […] zeigt, warum der ausgerechnet dieser wegen der Corona-Schutzmaßnahmen umständliche und virtuell im Internet abgehaltene Nominierungskongress der US-Demokraten ein so verblüffender Erfolg ist. Niemand, der im ursprünglich gebuchten Kongresszentrum von Milwaukee auf die Bühne getreten wäre, hätte das in einem solchen Witz von Kittelkleid getan. In den eigenen vier Wänden aber geht das.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
