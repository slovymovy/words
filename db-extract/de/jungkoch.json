                "senses": [
                    {
                        "sense_id": "bed7b953-aa76-3d36-9aa5-f6c0959dc1e4",
                        "entry_id": "e6d578a8-b6eb-338b-92f5-c3214ab5a041",
                        "glosses": [
                            "angestellter Koch in den ersten ein bis zwei Berufsjahren nach der abgeschlossenen Ausbildung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c62ab31-00b1-425d-9539-9f49a71214f3",
                                "sense_id": "bed7b953-aa76-3d36-9aa5-f6c0959dc1e4",
                                "text": "„»Ich habe hier als Jungkoch angefangen und mich durch die Hierarchie gearbeitet«, erzählt der 29-Jährige.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "548b83de-d327-33a7-9b8b-7caf018ec151",
                        "entry_id": "e6d578a8-b6eb-338b-92f5-c3214ab5a041",
                        "glosses": [
                            "junger, selbständig arbeitender Koch"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f338a920-697e-4441-906f-333339aebf01",
                                "sense_id": "548b83de-d327-33a7-9b8b-7caf018ec151",
                                "text": "„Der sympathische Jungkoch mag es am liebsten deftig – und das möchte er auch seinen Gästen bieten.“"
                            },
                            {
                                "example_id": "9605a4b7-17a9-42c0-8258-c6ab7f93e2b9",
                                "sense_id": "548b83de-d327-33a7-9b8b-7caf018ec151",
                                "text": "„Diese Woche bezieht der ambitionierte Jungkoch in einem schmucken Häuschen im nahen Freienbach sein neues Lokal […].“"
                            },
                            {
                                "example_id": "7f70da73-34a1-4753-812e-46cbc6fbb370",
                                "sense_id": "548b83de-d327-33a7-9b8b-7caf018ec151",
                                "text": "„Alpenländische Küche neu interpretiert, so stellt sich der Jungkoch das vor.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
