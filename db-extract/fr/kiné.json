            {
                "entry_id": "055af241-dcb3-378d-8bc8-040b9587eece",
                "word": "kiné",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "e3bcf714-22bd-4f77-a902-5716234fd883",
                        "entry_id": "055af241-dcb3-378d-8bc8-040b9587eece",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "kinés"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0548ab3e-e7d7-3792-9632-b3589e0a04ed",
                        "entry_id": "055af241-dcb3-378d-8bc8-040b9587eece",
                        "glosses": [
                            "Kinésithérapeute."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ab4cec4-2118-46e3-8642-47e33075b148",
                                "sense_id": "0548ab3e-e7d7-3792-9632-b3589e0a04ed",
                                "text": "Parfois, on la raccompagne même en voiture quand elle sort de chez le kiné."
                            },
                            {
                                "example_id": "d33c2442-bd74-4aed-a95d-519e7aa6ac4d",
                                "sense_id": "0548ab3e-e7d7-3792-9632-b3589e0a04ed",
                                "text": "« Les salons de massage n’ont pas d’ordre professionnel comme les esthéticiens ou les kinés », regrette-t-il."
                            },
                            {
                                "example_id": "22a7d8a0-ef27-48f5-8d2a-ca52ad50e968",
                                "sense_id": "0548ab3e-e7d7-3792-9632-b3589e0a04ed",
                                "text": "Lorsqu’il passe devant le bâtiment quelques minutes plus tard, il lit les plaques qui encadrent la porte vitrée. Il y en a cinq : deux dentistes, un kiné, un médecin, un orthophoniste — il n’a jamais entendu parler de ce métier."
                            },
                            {
                                "example_id": "23673493-dfd1-4945-ae03-298cbf48244f",
                                "sense_id": "0548ab3e-e7d7-3792-9632-b3589e0a04ed",
                                "text": "Il s’agit alors de travailler en équipe autour du patient ; le chirurgien, le kiné, le psychologue, le Réseau prévention main : le chirurgien et le kiné garantissent alors la prise en charge du corps, le psychologue celle de sa souffrance psychique et le Réseau prévention main, quant à lui, maintient le socle professionnel et social."
                            }
                        ]
                    },
                    {
                        "sense_id": "8a174230-e7fe-3e4d-9168-4adbb7a854f4",
                        "entry_id": "055af241-dcb3-378d-8bc8-040b9587eece",
                        "glosses": [
                            "Kinésithérapie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cba4025c-8cb8-41f9-b08b-cf4f61340299",
                                "sense_id": "8a174230-e7fe-3e4d-9168-4adbb7a854f4",
                                "text": "Nos compétences vont au-delà de la kiné de désencombrement, répond Yvan Tourjansky, président de l’union régionale des kinésithérapeutes libéraux d’Île-de-France."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b9321c6b-ae73-4114-ade4-b61e4a984973",
                        "source_entry_id": "055af241-dcb3-378d-8bc8-040b9587eece",
                        "target_lang_word": "physio",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "physio",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6153bf8d-58d4-3fa3-b118-856a4e810861",
                                        "entry_id": "702c7b2a-81ba-32c4-8744-7b99750b4b76",
                                        "glosses": [
                                            "Clipping of physiotherapist."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "clipping",
                                            "colloquial",
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ac728fea-86f2-4579-8126-0a13c7ea48a2",
                                                "sense_id": "6153bf8d-58d4-3fa3-b118-856a4e810861",
                                                "text": "I remembered her offer, however, and eight years later during a prolonged attack I put myself into the hands of Jenny, a wiry, little Indian physio whose manipulations and exercises returned my neck to its normal state."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6b2d44ca-5daa-3405-af76-a0d0c4609600",
                                        "entry_id": "702c7b2a-81ba-32c4-8744-7b99750b4b76",
