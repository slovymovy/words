                        "entry_id": "f7bdd358-28d8-34c4-8313-bee6daeff897",
                        "glosses": [
                            "iemand die in de privéwoning van een leerling les geeft"
                        ],
                        "tags": [
                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "71d4c2a4-1313-40bd-9a56-811fbf90b1c4",
                                "sense_id": "dfac729d-3484-3f25-8cc2-47a0abb6efbc",
                                "text": "De oude Anton, de vroegere huisleraar van Andrej, hielp Pierre uit het rijtuig, zei dat de vorst thuis was en bracht hem naar een nette kleine vestibule."
                            },
                            {
                                "example_id": "0c5617b4-6af0-4994-b0be-d98d2fbf9c06",
                                "sense_id": "dfac729d-3484-3f25-8cc2-47a0abb6efbc",
                                "text": "Het ”stift” werd inderdaad een intellectuele kweekvijver door de combinatie van godgeleerdheid, filosofie en kennis van de muziek. Friedrich Hölderlin verkoos echter het dichterschap boven de pastorie en verdiende zijn dagelijks brood als huisleraar in het gezin van bankier Gontard."
                            }
                        ]
                    }
