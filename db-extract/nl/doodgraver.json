                    {
                        "sense_id": "fd6d5716-9452-3b98-86a2-66c8bb0be878",
                        "entry_id": "d0b5aec1-6c4c-3778-ab3f-510fe53ed6f7",
                        "glosses": [
                            "persoon die een graf graaft"
                        ],
                        "tags": [
                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "78e51823-350e-4808-94a2-c331d84987e1",
                                "sense_id": "fd6d5716-9452-3b98-86a2-66c8bb0be878",
                                "text": "De doodgraver had een veel hoger tractement dan de koster, namelijk 312 gulden per jaar."
                            }
                        ]
                    },
                    {
                        "sense_id": "20ccd8a8-5630-3149-855d-116d27d6a921",
                        "entry_id": "d0b5aec1-6c4c-3778-ab3f-510fe53ed6f7",
                        "glosses": [
                            "Nicrophorus kever uit een geslacht van kevers uit de familie aaskevers. Soorten uit dit geslacht hebben een voor insecten uitzonderlijke vorm van broedzorg"
                        ],
                        "tags": [
                            "kevers"
                        ],
                        "examples": [
                            {
                                "example_id": "4696c7ab-3a55-4ccc-b925-d509111699f7",
                                "sense_id": "20ccd8a8-5630-3149-855d-116d27d6a921",
                                "text": "De doodgraver legt haar eieren in dode dieren."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7da7a9c5-a33d-44c4-a493-d8fa2942b4bc",
                        "source_entry_id": "d0b5aec1-6c4c-3778-ab3f-510fe53ed6f7",
                        "source_sense_id": "fd6d5716-9452-3b98-86a2-66c8bb0be878",
                        "source_sense_description": "(beroep) persoon",
                        "target_lang_word": "Totengräber",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Totengräber",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c83b4997-7003-36e7-8a42-7140a7db8f70",
                                        "entry_id": "c4f2d118-fb98-3e1c-8186-688674ad2c7d",
                                        "glosses": [
                                            "Person, die auf dem Friedhof die Gräber aushebt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fefad7c9-d4ec-4732-a116-dafee955faf6",
                                                "sense_id": "c83b4997-7003-36e7-8a42-7140a7db8f70",
                                                "text": "Der Totengräber war im Mittelalter ein verachteter, unehrlicher Beruf."
                                            },
                                            {
                                                "example_id": "2e441696-1703-479b-bb21-1542acacf3e1",
                                                "sense_id": "c83b4997-7003-36e7-8a42-7140a7db8f70",
                                                "text": "„Der Totengräber hatte das befürchtet und die Abschlüsse schon gekürzt gehabt.“"
                                            },
                                            {
                                                "example_id": "322b5200-a4a1-4d62-9746-f7ef8105e12c",
                                                "sense_id": "c83b4997-7003-36e7-8a42-7140a7db8f70",
                                                "text": "„Das wenigstens behauptet unser rührigster Agent, der Totengräber Liebermann vom Stadtfriedhof, und der muß es wissen; er ist achtzig Jahre alt, hat über zehntausend Leichen eingegraben, sich von seiner Provision an Grabdenkmälern ein Haus am Fluß mit einem Garten und Forellenzucht gekauft und ist durch seinen Beruf ein abgeklärter Schnapstrinker geworden.“"
                                            },
                                            {
                                                "example_id": "d134a5c9-17f8-4dd8-98b2-ad758412fe2d",
                                                "sense_id": "c83b4997-7003-36e7-8a42-7140a7db8f70",
                                                "text": "„Eines Abends kam der Totengräber, der seine Hütte in einer Friedhofsecke hatte, in Schweiß gebadet in die Pfarre gelaufen und erzählte, daß der Kapitän seinen Grabstein umgeworfen und schon eine Hand herausgestreckt habe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "70a10a9e-4950-3f4d-89b4-6dd989f0f3a7",
                                        "entry_id": "c4f2d118-fb98-3e1c-8186-688674ad2c7d",
                                        "glosses": [
                                            "ein Aaskäfer"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f42d29ba-f4a3-4eda-a0e7-3d99cdb86ed4",
                                                "sense_id": "70a10a9e-4950-3f4d-89b4-6dd989f0f3a7",
                                                "text": "Totengräber nutzen Tierkadaver zur Aufzucht ihrer Larven."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "58edb051-a834-34bd-9047-a3abd0de7ed4",
                                        "entry_id": "c4f2d118-fb98-3e1c-8186-688674ad2c7d",
                                        "glosses": [
                                            "jemand, der einen schlechten Einfluss ausübt, eine Sache ins Grab bringt"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "71a1cf2c-553f-4959-870b-6e0c85785c37",
                                                "sense_id": "58edb051-a834-34bd-9047-a3abd0de7ed4",
                                                "text": "Man warf ihm vor, Totengräber der Demokratie zu sein."
                                            },
                                            {
                                                "example_id": "78c6dc11-0ee5-48e9-a477-de82f91579e5",
                                                "sense_id": "58edb051-a834-34bd-9047-a3abd0de7ed4",
                                                "text": "Man warf ihm vor, Totengräber der Nation zu sein."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
