                "senses": [
                    {
                        "sense_id": "0c827780-404a-332b-9662-a08c7a259993",
                        "entry_id": "2864739d-e625-35a2-bdd0-fb3e6c563db1",
                        "glosses": [
                            "A Mercedes-Benz automobile."
                        ],
                        "tags": [
                            "Commonwealth",
                            "UK",
                            "especially",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "daabe604-e354-4f81-b461-e7b0e85606a2",
                                "sense_id": "0c827780-404a-332b-9662-a08c7a259993",
                                "text": "His dad's well rich: he's got a Merc and two BMWs."
                            },
                            {
                                "example_id": "6af06d2f-4205-44d8-9b89-c07239cef25d",
                                "sense_id": "0c827780-404a-332b-9662-a08c7a259993",
                                "text": "Some people might like to get a train to work / Or drive in, in a Beamer or a Merc"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "842fcec7-ea20-4a60-b160-fe4754e2e9e8",
                        "source_entry_id": "2864739d-e625-35a2-bdd0-fb3e6c563db1",
                        "source_sense_id": "0c827780-404a-332b-9662-a08c7a259993",
                        "source_sense_description": "Translations",
                        "target_lang_word": "Merco",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Merco",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9b91334b-80bc-302c-8dbb-5a7851268ed2",
                                        "entry_id": "42bfa5a8-cfcb-33ee-b9af-7dc14163ff97",
                                        "glosses": [
                                            "Véhicule de la marque de voitures Mercedes-Benz."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "79668c1a-dd89-49f4-ac2d-0f0fcc3944e5",
                                                "sense_id": "9b91334b-80bc-302c-8dbb-5a7851268ed2",
                                                "text": "J’ai enclenché la marche arrière et rentré la Merco dans la cour."
                                            },
                                            {
                                                "example_id": "3eafa045-0d25-4ba2-80ec-7c03383c770c",
                                                "sense_id": "9b91334b-80bc-302c-8dbb-5a7851268ed2",
                                                "text": "N’est-il pas riche ! Qu’il leur achète à elles toutes des Mercos !"
                                            },
                                            {
                                                "example_id": "6569b511-b9bb-41da-8a06-1d2da9ac8c24",
                                                "sense_id": "9b91334b-80bc-302c-8dbb-5a7851268ed2",
                                                "text": "Je ne sais pas exactement ce que ça coûte de faire repeindre une Porsche, mais ce bouffon d’agent immobilier ne risque pas de s’en tirer à meilleur compte qu’Ola avec sa Merco."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
