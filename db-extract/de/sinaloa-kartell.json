                "senses": [
                    {
                        "sense_id": "dce281ea-9ece-3b6f-b116-d2f22d562a5c",
                        "entry_id": "006799d4-55a7-3c25-a1b6-52f94a592e7c",
                        "glosses": [
                            "aus dem mexikanischen Bundesstaat Sinaloa heraus operierendes Drogenkartell"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f5fec114-0157-4a2a-9576-d627f3cc068b",
                                "sense_id": "dce281ea-9ece-3b6f-b116-d2f22d562a5c",
                                "text": "„Heute hat das Sinaloa-Kartell alle Konkurrenten aus dem Feld geschlagen und übt die uneingeschränkte Macht aus, zumindest bis zum nächsten Umbruch.“"
                            },
                            {
                                "example_id": "da40b9e1-3455-4f03-8060-f8cd013d31ea",
                                "sense_id": "dce281ea-9ece-3b6f-b116-d2f22d562a5c",
                                "text": "„Alle zwölf waren Sicarios des Sinaloa-Kartells, die normalerweise in Baltimore lebten und ihrem Geschäft nachgingen.“"
                            }
                        ],
