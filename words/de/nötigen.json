                    "frequency": "Middle",
                    "semantic_group_id": "Zwang",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der Räuber bedrohte die Angestellten mit einer Waffe und <w>nötigte</w> sie zur Herausgabe der Kasse."
                        },
                        {
                            "text": "Niemand darf einen Zeugen vor Gericht durch Drohungen zur Aussage <w>nötigen</w>."
                        }
                    ],
                    "synonyms": [
                        "zwingen",
                        "erpressen"
                    ],
                    "common_phrases": [
