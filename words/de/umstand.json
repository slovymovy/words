                    "frequency": "Middle",
                    "semantic_group_id": "aufwand",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Bitte machen Sie sich meinetwegen keine <w>Umstände</w>, ein Glas Wasser reicht völlig aus."
                        },
                        {
                            "text": "Die Einreise erfolgte überraschend schnell und ganz ohne bürokratische <w>Umstände</w>."
                        }
                    ],
                    "synonyms": [
                        "Mühe",
                        "Förmlichkeit"
                    ],
                    "common_phrases": [
