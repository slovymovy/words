                        ],
                        "form": "das Mannschaftsspiel"
                    },
                    {
                        "form_id": "bb679ae2-3f81-4233-aad0-d58f9a5abd98",
                        "entry_id": "4b5c0829-5667-3d2b-a73d-db90adce6112",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Mannschaftsspiele"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a0207322-16d9-3808-92d2-f6cab0356ac5",
                        "entry_id": "4b5c0829-5667-3d2b-a73d-db90adce6112",
                        "glosses": [
                            "Sportspielform und deren Metapher, wobei die Beteiligten in einer festgelegten Konstellation innerhalb einer Gruppe mit definierten Teilaufgaben an einer gemeinsamen Aufgabe zusammenarbeiten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cdac0c23-047b-4ae2-8849-713df7dfb1b0",
                                "sense_id": "a0207322-16d9-3808-92d2-f6cab0356ac5",
                                "text": "Fußball ist wohl das bekannteste Mannschaftsspiel."
                            },
                            {
                                "example_id": "0a964ae1-d1fd-43b3-bfae-eabd40ec0ddb",
                                "sense_id": "a0207322-16d9-3808-92d2-f6cab0356ac5",
                                "text": "„Im Gesellschaftsspiel, im Mannschaftsspiel, in jedem Spiel, das künstlerischen Gesetzen gehorcht, […] besonders überall da, wo der Spielende einer Spieltradition begegnet, ist der Schöpfer der Regeln nur in Ausnahmefällen mit dem Spieler identisch.“"
                            },
                            {
                                "example_id": "e097447a-18b1-4b52-b2eb-d192a5a545d9",
                                "sense_id": "a0207322-16d9-3808-92d2-f6cab0356ac5",
                                "text": "„Das Parteienspiel Völkerball kennzeichnet sich durch seinen Spielgedanken (Vernichtung eines anderen Volkes unter ihrem König), das Mannschaftspiel Fußball durch sein Vokabular (schießen, bomben, angreifen, verteidigen) als symbolisches Kriegsspiel, […].“"
                            },
                            {
                                "example_id": "50e20d2a-49ef-4a48-9929-913e514515d3",
                                "sense_id": "a0207322-16d9-3808-92d2-f6cab0356ac5",
                                "text": "„Das Ungewisse und Zufällige bilden das Geheimnis des Mannschaftsspiels.“"
                            },
                            {
                                "example_id": "f02e5214-9173-4061-ad7a-134cfbe8608d",
                                "sense_id": "a0207322-16d9-3808-92d2-f6cab0356ac5",
                                "text": "„Im Prinzip ist das Szenario übertragbar auf viele Mannschaftsspiele abseits des Fußballs.“"
                            },
                            {
                                "example_id": "5ae0ae61-9ae7-4ca0-9e3c-59609e1ca01f",
                                "sense_id": "a0207322-16d9-3808-92d2-f6cab0356ac5",
                                "text": "„So trainieren sie zweimal täglich, essen zwischendrin vom Teamkoch auf Hochleistungssportler abgestimmte Mahlzeiten und jagen der Utopie vom perfekten Mannschaftsspiel nach.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "20a9506c-95d8-3b6d-99f4-5b3ba627e4ed",
                        "entry_id": "4b5c0829-5667-3d2b-a73d-db90adce6112",
                        "glosses": [
                            "gutes Zusammenspiel der Sportler innerhalb ihres Teams, der Vertreter einer Regierung im Rahmen ihres Wählerauftrags oder einer anderen ähnlich strukturierten Gruppe mit einem gemeinsamen Handlungsziel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd1d7963-4950-4376-88ba-497dc9534898",
                                "sense_id": "20a9506c-95d8-3b6d-99f4-5b3ba627e4ed",
                                "text": "„Fußball ist ein Mannschaftsspiel, das Kollektiv entscheidet über Sieg und Niederlage, sagte Iniesta auf einer Pressekonferenz.“"
                            },
                            {
                                "example_id": "867259c6-a37a-4d26-8a41-5c978ad76df7",
                                "sense_id": "20a9506c-95d8-3b6d-99f4-5b3ba627e4ed",
                                "text": "„Der 23-Jährige fand ins Mannschaftsspiel.“"
                            },
                            {
                                "example_id": "4ca21df5-297d-4ad5-bfc8-3a3345a345a9",
                                "sense_id": "20a9506c-95d8-3b6d-99f4-5b3ba627e4ed",
                                "text": "„Fußball ist ein Mannschaftsspiel, das hat Wolfgang Niersbach verinnerlicht.“"
                            },
                            {
                                "example_id": "bdd8fa19-9f34-434d-b800-8ab088f70bad",
                                "sense_id": "20a9506c-95d8-3b6d-99f4-5b3ba627e4ed",
                                "text": "„Seither gilt Wöller manchen in der Parteispitze als einer, der im Mannschaftsspiel aus der Reihe tanzt.“"
                            },
                            {
                                "example_id": "3af06cee-dfce-41e8-952b-7b18920afd5a",
                                "sense_id": "20a9506c-95d8-3b6d-99f4-5b3ba627e4ed",
                                "text": "„Der Einzige im Kabinett, der kein Mannschaftsspiel betreibt, giftete Berlusconi ganz offen gegen seinen Finanzminister.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9d4937c4-1185-42d6-8971-c862ab192234",
                        "source_entry_id": "4b5c0829-5667-3d2b-a73d-db90adce6112",
                        "source_sense_id": "a0207322-16d9-3808-92d2-f6cab0356ac5",
                        "target_lang_word": "team sport",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "team sport",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "87a42441-cdc3-3818-884b-d18ae5803626",
                                        "entry_id": "6f4b5a94-1d8d-3277-b84e-229f7e7f37ca",
                                        "glosses": [
                                            "A sport played by two competing teams."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4319ef90-efbb-4965-b5f8-8fcaaf3af2ee",
                                                "sense_id": "87a42441-cdc3-3818-884b-d18ae5803626",
                                                "text": "This impression is underscored by the high level of minority representation in our major team sports."
                                            },
                                            {
                                                "example_id": "03683cca-2e77-4724-906f-3ad1107c1fda",
                                                "sense_id": "87a42441-cdc3-3818-884b-d18ae5803626",
                                                "text": "But he was required to do a team sport, so he compromised by choosing track, which ironically involved the biggest team of the season."
                                            },
                                            {
                                                "example_id": "2575a6b3-fbc7-4f29-82bc-a94e9a8931e2",
                                                "sense_id": "87a42441-cdc3-3818-884b-d18ae5803626",
                                                "text": "And I looked forward to the other nine games of the greatest team sport devised by man."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "82da0b07-e2d0-3b40-96aa-1a22c7d2e163",
                                        "entry_id": "6f4b5a94-1d8d-3277-b84e-229f7e7f37ca",
                                        "glosses": [
                                            "All sports involving competing teams, collectively."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7ee31da6-420a-4c12-88d3-cae911bc1e02",
                                                "sense_id": "82da0b07-e2d0-3b40-96aa-1a22c7d2e163",
                                                "text": "In addition to personality differences between athletes and non-athletes, personality differences were also observed between team sport athletes and individual sport athletes."
                                            },
                                            {
                                                "example_id": "bc0f7a4d-6721-4236-8dcd-1c730e2cdf63",
                                                "sense_id": "82da0b07-e2d0-3b40-96aa-1a22c7d2e163",
                                                "text": "The representational aspect of team sport adds to this."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6ce754cf-830c-44f6-87a7-d4fbd06d4d19",
