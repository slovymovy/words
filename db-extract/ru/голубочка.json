                "senses": [
                    {
                        "sense_id": "24fc9448-4b61-3c27-ab19-5311c9327d77",
                        "entry_id": "ffbaaed9-b5c5-3498-be39-93bdd69cd885",
                        "glosses": [
                            "прост., уменьш.-ласк. женский половой орган"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da0a064b-6795-4bef-8542-b814c868468d",
                                "sense_id": "24fc9448-4b61-3c27-ab19-5311c9327d77",
                                "text": "На соломке яровой // Скидава́й штаны долой! // Я соломки не боюсь, — // Сама лягу заголюсь! // Скину, скину юбочку, // Покажу голубочку! // А ты, хлопец, не робей, — // Мне по яйца забей! // Ножки вместе, ручки врозь, — // Знай, потыкивай, небось!"
                            }
                        ]
                    }
                ],
