                                "target_senses": [
                                    {
                                        "sense_id": "0ae5beb1-6308-3549-9499-b8e0e90b0eb0",
                                        "entry_id": "09600c8d-e7f5-3aa0-96ca-9e3396a5cc21",
                                        "glosses": [
                                            "To breastfeed: to feed (a baby) at the breast; to suckle."
                                        ],
                                        "tags": [
