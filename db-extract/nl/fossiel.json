                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "6a7d4557-9ebb-33a9-aedf-02a1c7c23c6d",
                        "entry_id": "4d31b480-34bb-357b-bc05-9be74cfb5ec6",
                        "glosses": [
                            "tot fossiel geworden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cbb92e14-d89e-4706-ad3e-ca9a54417ed8",
                                "sense_id": "6a7d4557-9ebb-33a9-aedf-02a1c7c23c6d",
                                "text": "Er werden fossiele resten van mammoeten gevonden."
                            },
                            {
                                "example_id": "5b788fdc-eccb-4124-884f-fedc7563521a",
                                "sense_id": "6a7d4557-9ebb-33a9-aedf-02a1c7c23c6d",
                                "text": "Europees Hof: landen moeten bij winning fossiele brandstoffen kijken naar álle uitstoot die daaruit voortvloeit."
                            }
                        ]
                    },
                    {
                        "sense_id": "788fac01-0f27-3616-8c2e-268c578c2f20",
                        "entry_id": "4d31b480-34bb-357b-bc05-9be74cfb5ec6",
                        "glosses": [
                            "met betrekking tot brandstoffen die het resultaat zijn van een lang fossilisatieproces in de aardkorst"
                        ],
                        "tags": [
                            "metonymisch"
                        ],
                        "examples": [
                            {
                                "example_id": "e73b9822-224e-4fd6-89fc-ff8e6034dcdb",
                                "sense_id": "788fac01-0f27-3616-8c2e-268c578c2f20",
                                "text": "Aardgas is een fossiele brandstof."
                            },
                            {
                                "example_id": "5bfe2066-8621-4bb0-9c04-a27975b4a217",
                                "sense_id": "788fac01-0f27-3616-8c2e-268c578c2f20",
                                "text": "De lagen fossiele brandstof vertoonen zich over een groot gedeelte van Batjan in de beddingen der rivieren en beken. De kolenlaag is echter niet overal even dik en wordt doorsneden door kleilaagjes."
                            }
                        ]
                    },
                    {
                        "sense_id": "75c05907-0380-3344-8888-eec7de1d9309",
                        "entry_id": "4d31b480-34bb-357b-bc05-9be74cfb5ec6",
                        "glosses": [
                            "met betrekking tot brandstoffen die het resultaat zijn van een lang fossilisatieproces in de aardkorst",
                            "elliptische, bijvoeglijke term voor fossiele brandstoffen"
                        ],
                        "tags": [
                            "metonymisch",
                            "pregnant"
                        ],
                        "examples": [
                            {
                                "example_id": "728106e0-c29a-4cf4-9a00-e81f0556862d",
                                "sense_id": "75c05907-0380-3344-8888-eec7de1d9309",
                                "text": "Aardgas is een fossiele brandstof."
                            },
                            {
                                "example_id": "59dbf1c9-a6cc-43eb-b399-820bd2372f83",
                                "sense_id": "75c05907-0380-3344-8888-eec7de1d9309",
                                "text": "De lagen fossiele brandstof vertoonen zich over een groot gedeelte van Batjan in de beddingen der rivieren en beken. De kolenlaag is echter niet overal even dik en wordt doorsneden door kleilaagjes."
                            },
                            {
                                "example_id": "edcaf014-9b88-4aef-b954-f8a0fb515051",
                                "sense_id": "75c05907-0380-3344-8888-eec7de1d9309",
                                "text": "Tien grote energie- en industriebedrijven in Nederland kunnen jaarlijks profiteren van gemiddeld 8,8 miljard euro aan fossiele subsidies, zo blijkt uit onderzoek,"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d97621e0-51a4-4c54-ad35-dab4996a36c4",
                        "source_entry_id": "4d31b480-34bb-357b-bc05-9be74cfb5ec6",
                        "target_lang_word": "fossil",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fossil",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f3427a8f-3b2e-3fe2-a4b4-c0fe8ee56222",
                                        "entry_id": "63e7e3a4-0b15-35db-b794-7679431739fb",
                                        "glosses": [
                                            "aus der erdgeschichtlichen Vergangenheit stammend"
                                        ],
                                        "tags": [
                                            "von Gegenständen oder Stoffen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bb5fe614-c770-45fb-92f0-e5334898f162",
                                                "sense_id": "f3427a8f-3b2e-3fe2-a4b4-c0fe8ee56222",
                                                "text": "„Die Braunkohle-Verstromung müsste sich dann bis zum Jahr 2030 halbieren, bis 2050 gäbe es weniger als zehn Prozent Strom aus fossilen Energien.“"
                                            },
                                            {
                                                "example_id": "b8691ba9-e9ef-4bd4-812b-653b4eaf80a7",
                                                "sense_id": "f3427a8f-3b2e-3fe2-a4b4-c0fe8ee56222",
                                                "text": "Unter der Sahara befindet sich fossiles Wasser."
                                            },
                                            {
                                                "example_id": "96df1aa5-2c74-427f-9e58-886d60d082da",
                                                "sense_id": "f3427a8f-3b2e-3fe2-a4b4-c0fe8ee56222",
                                                "text": "Angestrebt ist ein geringerer Verbrauch fossiler Brennstoffe."
                                            },
                                            {
                                                "example_id": "f044bf23-d45e-4ba6-8724-3aa00b5ecbae",
                                                "sense_id": "f3427a8f-3b2e-3fe2-a4b4-c0fe8ee56222",
                                                "text": "„Spätestens seit 2015, seit Deutschland gemeinsam mit dem Rest der Welt das Pariser Klimaschutzabkommen unterzeichnet hat, ist der Abschied von allen fossilen Energieträgern beschlossene Sache.““"
                                            },
                                            {
                                                "example_id": "164be1f4-4d03-4b32-bc59-96908ced4594",
                                                "sense_id": "f3427a8f-3b2e-3fe2-a4b4-c0fe8ee56222",
                                                "text": "„Der Ölkonzern Exxon Mobil wusste intern bereits seit den 1970er-Jahren, dass fossile Brennstoffe das Klima aufheizen.“"
                                            },
                                            {
                                                "example_id": "b37e66b7-0121-496f-a4c0-dfeabe4320cc",
                                                "sense_id": "f3427a8f-3b2e-3fe2-a4b4-c0fe8ee56222",
                                                "text": "Vergleichende Betrachtungen großer und kleiner Vögel, etwa die Gegenüberstellung des monströsen Oberschenkelknochens eines fossilen Riesenstraußes und des winzigen Skelettes eines Kolibris, lassen zunächst auf die spektakuläre Darstellung von Extremleistungen schließen.“"
                                            },
                                            {
                                                "example_id": "0b0058db-b386-4db8-9b33-b6eaa34c55b7",
                                                "sense_id": "f3427a8f-3b2e-3fe2-a4b4-c0fe8ee56222",
                                                "text": "„Sowohl rezente als auch fossile Tiere und Pflanzen zeigen eine erstaunliche Vielfalt der Formen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
