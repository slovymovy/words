                "senses": [
                    {
                        "sense_id": "47caed9f-2029-386b-acb3-73e5567370a8",
                        "entry_id": "d6cb91dd-0c82-3893-89ac-67b7ba53f7ee",
                        "glosses": [
                            "Radical-socialiste."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "45931eb8-3416-40cf-a6fe-ddb7604c7f3d",
                                "sense_id": "47caed9f-2029-386b-acb3-73e5567370a8",
                                "text": "L’image d’un politicien un peu paillard, peut-être païen, cette réputation d’ambitieux sans… foi, ni loi, ce prototype de radsoc modelé aux traditions de la III République ; cette « image qu’on lui a collée » n’est pourtant pas tombée du ciel."
                            },
                            {
                                "example_id": "4737b3fc-e3d3-46f0-ae13-4b0ce5b2eabb",
                                "sense_id": "47caed9f-2029-386b-acb3-73e5567370a8",
                                "text": "Les radsocs de l'époque, véritables précurseurs de la social-démocratie, situés à la droite de socialistes sur le demi-camembert électoral, passeraient aujourd'hui pour des gauchistes."
                            }
                        ]
                    }
