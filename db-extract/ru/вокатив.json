                    {
                        "translation_id": "da24417b-0e54-47f5-b859-37b8d25e662b",
                        "source_entry_id": "9a9141de-d42e-356c-a3cb-703d87273b92",
                        "source_sense_id": "9e66b90b-aa07-3614-9df9-1cdc18bb9077",
