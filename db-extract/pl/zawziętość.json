                        "entry_id": "94c58847-fde0-36c3-8c44-c7981921c067",
                        "glosses": [
                            "skłonność do upierania się przy swoich racjach, uczuciach, forsowanie za wszelką cenę swoich decyzji nawet wbrew rozsądkowi"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "958bed16-7945-44c5-8428-15e041025136",
                                "sense_id": "80c050a6-8491-3607-8616-00ecda5b9908",
                                "text": "Jego wadą była niespotykana zawziętość, nikt nie był w stanie przemówić mu do rozsądku."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "89e013c1-f4bd-36d6-a0e9-90a633289b8d",
                        "entry_id": "94c58847-fde0-36c3-8c44-c7981921c067",
                        "glosses": [
                            "skłonność do oddawania się jakimś zajęciom z wielkim zapałem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6788d182-569c-46af-8722-26e4010fa7ad",
                                "sense_id": "89e013c1-f4bd-36d6-a0e9-90a633289b8d",
                                "text": "Z wielką zawziętością zabrał się za naukę angielskiego i po roku już świetnie się porozumiewał."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
