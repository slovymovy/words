    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "3f54d836-1f32-3114-8fab-82e0a08c031e",
                "word": "peerless",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "6d2596e9-bb01-4961-b36d-525c4d64a52d",
                        "entry_id": "3f54d836-1f32-3114-8fab-82e0a08c031e",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more peerless"
                    },
                    {
                        "form_id": "759fc2e5-c973-4eb2-bb8b-0d566c1ccc03",
                        "entry_id": "3f54d836-1f32-3114-8fab-82e0a08c031e",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most peerless"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fbccf164-6cfb-3a47-9aee-a189eafd2c63",
                        "entry_id": "3f54d836-1f32-3114-8fab-82e0a08c031e",
                        "glosses": [
                            "Without peer or equal; unparalleled, nonpareil. Of the highest quality, best."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff3260f6-d254-4592-a95f-30dc362a2654",
                                "sense_id": "fbccf164-6cfb-3a47-9aee-a189eafd2c63",
                                "text": "Let's after him, / Whoſe care is gone before, to bid vs welcome: / It is a peerleſſe Kinſman."
                            },
                            {
                                "example_id": "c8251950-b247-4b74-9490-2cd1b796badb",
                                "sense_id": "fbccf164-6cfb-3a47-9aee-a189eafd2c63",
                                "text": "Having now seen himself mistaken in supposing Elfride to be peerless, nothing on earth could make him believe she was not so very bad after all."
                            },
                            {
                                "example_id": "28db17b0-484b-468b-838c-c090587227cf",
                                "sense_id": "fbccf164-6cfb-3a47-9aee-a189eafd2c63",
                                "text": "After wearying oneself with the acres of stuffy, sappy, expressionless babies that populate the canvases of the Old Masters in Italy, it is refreshing to stand before this peerless child and feel that thrill which tells you you are at last in the presence of the real thing."
                            },
                            {
                                "example_id": "98644a60-c92a-4018-8042-306dc2f51525",
                                "sense_id": "fbccf164-6cfb-3a47-9aee-a189eafd2c63",
                                "text": "Telegram! Malachi Mulligan, The Ship, lower Abbey street. O, you peerless mummer! O, you priestified Kinchite!"
                            },
                            {
                                "example_id": "b8df0f0f-7a6f-4fee-8b67-ade9d01ab240",
                                "sense_id": "fbccf164-6cfb-3a47-9aee-a189eafd2c63",
                                "text": "“Would you go into the dragon's lair, my peerless Wiglaf?”"
                            },
                            {
                                "example_id": "b462ad73-d281-41d5-8c33-01c60f498b91",
                                "sense_id": "fbccf164-6cfb-3a47-9aee-a189eafd2c63",
                                "text": "Foden has also grown into this World Cup, having scored against Wales and creating two goals here. England's midfield and attack is taking shape with perfect timing for what will be the sternest of tests against France and the peerless Mbappe."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dbc61af3-cbe0-4404-ab12-7c1eb43e318e",
                        "source_entry_id": "3f54d836-1f32-3114-8fab-82e0a08c031e",
                        "source_sense_id": "fbccf164-6cfb-3a47-9aee-a189eafd2c63",
                        "source_sense_description": "without peer or equal",
                        "target_lang_word": "hors pair",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hors pair",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bd3f7b6e-85cc-3d4d-bb0d-3570c02816c6",
                                        "entry_id": "76399055-25b4-38c3-bddd-b4d805fc73c0",
                                        "glosses": [
                                            "Sans égal, exceptionnel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cff59b88-4702-44b1-93c8-513b76662aa5",
                                                "sense_id": "bd3f7b6e-85cc-3d4d-bb0d-3570c02816c6",
                                                "text": "Mon fils est un pêcheur hors pair, il obtient toujours le premier prix au concours de pêche."
                                            },
                                            {
                                                "example_id": "edcefb28-33fb-4e86-9796-49ec70e01932",
                                                "sense_id": "bd3f7b6e-85cc-3d4d-bb0d-3570c02816c6",
                                                "text": "Si nous trouvons qu’un camarade a réussi à écrire une page hors pair, nous lui disons : « Tu as écrit – ou vous avez écrit – une page hors pair. »"
                                            },
                                            {
                                                "example_id": "0a9d097c-4ec6-47b2-83ff-441adcded4a1",
                                                "sense_id": "bd3f7b6e-85cc-3d4d-bb0d-3570c02816c6",
                                                "text": "Pédagogue hors pair, il montrait comment le respect des règles de procédure, principe fondamental pour un magistrat, ne devait pas empêcher la recherche de la vérité qui devait demeurer au centre des préoccupations."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "69601bab-6a1a-4a06-b0e6-21d450d87384",
                        "source_entry_id": "3f54d836-1f32-3114-8fab-82e0a08c031e",
                        "source_sense_id": "fbccf164-6cfb-3a47-9aee-a189eafd2c63",
