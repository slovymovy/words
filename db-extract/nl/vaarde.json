                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "a3389f58-c657-3713-9da2-97045aa383dc",
                        "entry_id": "e30e9713-8e5b-3e54-b8f2-b4ae52ee61ec",
                        "glosses": [
                            "enkelvoud verleden tijd van varen : \\\"niet meevallen\\"
                        ],
                        "tags": [
                            "impersonal"
                        ],
                        "examples": [
                            {
                                "example_id": "028888ab-7863-483d-9d7f-a24a89017398",
                                "sense_id": "a3389f58-c657-3713-9da2-97045aa383dc",
                                "text": "En dichten? Voor wie, voor wat zou hij nu gaan dichten? Uit de wereld waarin hij leefde, kwamen niet meer die aandrang en nood. Het vaarde hem al te zeer; de eerste, dikke waterstraal uit de bronne was uitgeloopen, en weinig versch water uit den schoot der aarde kwam toe om haar te voeden."
                            }
                        ]
                    }
