                        "cross_references": [
                            {
                                "target_word": "periareion",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "20bdecf0-2ba6-3d67-9f81-8e00a6681cf5",
                                        "entry_id": "107c1f3c-0798-3e37-ba9f-ee3027fe150d",
                                        "glosses": [
                                            "The point in an elliptical orbit around Mars that is closest to Mars."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d5824634-0fcb-4a9d-9e92-544b6fc38f1e",
                                                "sense_id": "20bdecf0-2ba6-3d67-9f81-8e00a6681cf5",
                                                "text": "Mars orbit insertion requires a nominal hyperbolic periareion delta V of 2,491 m/s, at 300 km altitude."
                                            },
                                            {
                                                "example_id": "35a4f8da-2c2d-4db1-9fdb-077d40b02b90",
                                                "sense_id": "20bdecf0-2ba6-3d67-9f81-8e00a6681cf5",
                                                "text": "Nakamiya et al. analyzed maneuver strategies at perigee and periareion for Earth-to-Mars transfers [29] and [30]."
                                            },
                                            {
                                                "example_id": "b0ae8fe9-3218-415f-857e-5c4fc6e8adf2",
                                                "sense_id": "20bdecf0-2ba6-3d67-9f81-8e00a6681cf5",
                                                "text": "Taking advantage of the highly elliptical orbit (~400 km periareion and ~70,000 km apoareion) of MOM, the scientific objective of MENCA is to radially profile the composition of the neutral exosphere of Mars starting from the MOM periareion."
                                            },
                                            {
                                                "example_id": "e60d05ce-7e8b-40bf-b225-143fe6e4e78e",
                                                "sense_id": "20bdecf0-2ba6-3d67-9f81-8e00a6681cf5",
                                                "text": "First, a quite elongated orbit is obtained that has a periareion equal to the height of the final circular orbit; then, at successive periareions a small burn makes the orbit ever less elliptical until a circular LMO is achieved."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
