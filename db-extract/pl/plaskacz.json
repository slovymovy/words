                "translations": [
                    {
                        "translation_id": "4cb67a9d-b773-4d25-aa98-9b0da5cbec7b",
                        "source_entry_id": "475f7cbe-efd2-3dc1-a34a-bd5434c9803c",
                        "source_sense_id": "8b74f2e9-d08e-3653-bdad-0d2187263ae2",
                        "target_lang_word": "slap",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "slap",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e718f601-50e6-3548-8956-8968ae293e53",
                                        "entry_id": "6847cf72-f496-3c01-ae96-821c58b8d0fe",
                                        "glosses": [
                                            "A blow, especially one given with the open hand, or with something broad and flat."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a1f784b4-e3c6-424d-bd77-d63b0bc128b8",
                                                "sense_id": "e718f601-50e6-3548-8956-8968ae293e53",
                                                "text": "He gave me a friendly slap on the back as a sign of camaraderie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3b89d040-999c-3e96-b5e0-826bb5f56d81",
                                        "entry_id": "6847cf72-f496-3c01-ae96-821c58b8d0fe",
                                        "glosses": [
                                            "A sharp percussive sound like that produced by such a blow."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c44dd663-44f9-4ab0-9b74-e389aa39c27e",
                                                "sense_id": "3b89d040-999c-3e96-b5e0-826bb5f56d81",
                                                "text": "the slap of my feet on the bathroom tiles"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9a99a3f7-e83a-3599-a940-9074cf3d5885",
                                        "entry_id": "6847cf72-f496-3c01-ae96-821c58b8d0fe",
                                        "glosses": [
                                            "The percussive sound produced in slap bass playing."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5dd3af83-720d-47e6-91ab-3a62f5c40013",
                                                "sense_id": "9a99a3f7-e83a-3599-a940-9074cf3d5885",
                                                "text": "Havens goes into the terrific Freedom for an encore, which will turn out to be a highlight of the movie; its chopped guitar and conga slaps pre-empt late 90s R&B."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e370664d-88ca-3efa-af9a-bd6878bfca43",
                                        "entry_id": "6847cf72-f496-3c01-ae96-821c58b8d0fe",
                                        "glosses": [
                                            "Makeup; cosmetics."
                                        ],
                                        "tags": [
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e8e9c916-332d-41f0-82c5-953604b3ca71",
                                                "sense_id": "e370664d-88ca-3efa-af9a-bd6878bfca43",
                                                "text": "Well, she schlumphed her Vera down the screech at a rate of knots, zhooshed up the riah, checked the slap in the mirror behind the bar, straightened up one ogle fake riah that had come adrift, and bold as brass orderlied over as fast as she could manage in those bats and, in her best lips, asked, if she could parker the omi a bevvy."
                                            },
                                            {
                                                "example_id": "d2682f49-01d8-4ee2-8261-24f53bc63aad",
                                                "sense_id": "e370664d-88ca-3efa-af9a-bd6878bfca43",
                                                "text": "If you had too much slap on when you went out . . . your mates say too much slap on your ecaf. Yeah. Oh really girl? Yes . . . Go in the lavs here and have a look."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "53350ac8-7dcd-3855-a55e-f97ca6c9a086",
                                        "entry_id": "6847cf72-f496-3c01-ae96-821c58b8d0fe",
                                        "glosses": [
                                            "An eye-catching sticker used in street art."
                                        ],
                                        "tags": [
                                            "countable",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "291cc5e3-9b06-406b-bda2-14f0fa39a1b1",
                                                "sense_id": "53350ac8-7dcd-3855-a55e-f97ca6c9a086",
                                                "text": "[…] which seek to retake public space for their own expression, using graffiti, stickering, 'slaps' and street art to dissent from the commercialisation of the public sphere."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "slap",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6a831d70-fc15-313f-aab9-ccbe5ac9bfbc",
                                        "entry_id": "ccc6f032-fbc7-38c4-8142-257f08116dec",
                                        "glosses": [
                                            "To give a slap to."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "28935f69-8429-44bf-89ca-5102fe4867bc",
                                                "sense_id": "6a831d70-fc15-313f-aab9-ccbe5ac9bfbc",
                                                "text": "She slapped him in response to the insult."
                                            },
                                            {
                                                "example_id": "2ba7472e-bb99-4f50-bd05-e681af018497",
                                                "sense_id": "6a831d70-fc15-313f-aab9-ccbe5ac9bfbc",
                                                "text": "Mrs. Flanders rose, slapped her coat this side and that to get the sand off, and picked up her black parasol."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "40ab5b64-5470-368e-a813-4ac94945c27a",
                                        "entry_id": "ccc6f032-fbc7-38c4-8142-257f08116dec",
                                        "glosses": [
                                            "To cause something to strike soundly."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c5f2c03c-7a4e-403c-87f8-86dac9c7c54f",
                                                "sense_id": "40ab5b64-5470-368e-a813-4ac94945c27a",
                                                "text": "He slapped the reins against the horse's back."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cc0034eb-5049-3de5-a92a-5f936a3d3089",
                                        "entry_id": "ccc6f032-fbc7-38c4-8142-257f08116dec",
                                        "glosses": [
                                            "To strike soundly against something."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a4e33a91-a27e-4c36-99ee-cd9388412dc2",
                                                "sense_id": "cc0034eb-5049-3de5-a92a-5f936a3d3089",
                                                "text": "The rain slapped against the window-panes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "025aea24-e769-3939-9447-cd8defcbb7ef",
                                        "entry_id": "ccc6f032-fbc7-38c4-8142-257f08116dec",
                                        "glosses": [
                                            "To be excellent, especially when relating to music."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "slang",
                                            "stative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "75dd3091-760e-4301-a6be-080d2de525b0",
                                                "sense_id": "025aea24-e769-3939-9447-cd8defcbb7ef",
                                                "text": "The band's new single slaps."
                                            },
                                            {
                                                "example_id": "1feb65b0-7eac-465c-98d0-c5385028d117",
                                                "sense_id": "025aea24-e769-3939-9447-cd8defcbb7ef",
                                                "text": "There are some cinematic elements, but at the end of the day, the album fucking slaps."
                                            },
                                            {
                                                "example_id": "c138a47c-f7b6-4f41-8828-ee02b551060b",
                                                "sense_id": "025aea24-e769-3939-9447-cd8defcbb7ef",
                                                "text": "Also I will never get tired of the song \"Motion Sickness\" by Phoebe Bridgers. Shit slaps."
                                            },
                                            {
                                                "example_id": "e290b73f-6c72-4f62-a7c1-a5a0d83773da",
                                                "sense_id": "025aea24-e769-3939-9447-cd8defcbb7ef",
                                                "text": "2016's 'Girls Like Me' still slaps to this day."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "96031b26-7251-301b-aa7e-30bddba0479e",
                                        "entry_id": "ccc6f032-fbc7-38c4-8142-257f08116dec",
                                        "glosses": [
                                            "To place, to put carelessly."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "89da4b65-8dcb-4c9e-9ccf-238358a84c29",
                                                "sense_id": "96031b26-7251-301b-aa7e-30bddba0479e",
                                                "text": "We'd better slap some fresh paint on that wall."
                                            },
                                            {
                                                "example_id": "9630d542-8f7c-4527-bc97-7c948043e81d",
                                                "sense_id": "96031b26-7251-301b-aa7e-30bddba0479e",
                                                "text": "Louise Belcher: \"On Monday there was supposed to be some big schoolboard inspection or something, so instead of cleaning the place up, what does the principal do? He panics. He and the janitor and the janitor's brother slap a wall where the door used to be.\"\nGene Belcher: \"Wall slap.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7b83751c-a861-33eb-9aa6-80fb22ccb681",
                                        "entry_id": "ccc6f032-fbc7-38c4-8142-257f08116dec",
                                        "glosses": [
                                            "To impose a penalty, etc. on (someone)."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "informal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "624f1786-2b72-4b82-85c2-1366417434a4",
                                                "sense_id": "7b83751c-a861-33eb-9aa6-80fb22ccb681",
                                                "text": "I was slapped with a parking fine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "236e9c3d-60fd-35ca-9067-c9f53abef999",
                                        "entry_id": "ccc6f032-fbc7-38c4-8142-257f08116dec",
                                        "glosses": [
                                            "To play slap bass on (an instrument)."
                                        ],
                                        "tags": [
                                            "informal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e7c8e2eb-1253-4124-a937-11fad7dab5a8",
                                                "sense_id": "236e9c3d-60fd-35ca-9067-c9f53abef999",
                                                "text": "With no drums, Black began slapping his bass to keep time while Moore's guitar leaped in and out of the melody line."
                                            }
                                        ]
                                    }
                                ]
                            },
