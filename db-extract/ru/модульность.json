                        "sense_id": "31725f01-53a1-3803-bdb8-4d5bc52aa5fb",
                        "entry_id": "1ed3873e-d841-3ba5-b0b5-c137385aaa5a",
                        "glosses": [
                            "спец. свойство по значению прилагательного модульный; модульный принцип устройства, конструкции чего-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b82fe35f-1318-47a6-9cf6-699677b6a488",
                                "sense_id": "31725f01-53a1-3803-bdb8-4d5bc52aa5fb",
                                "text": "Модульность ― это свойство системы, которая была разложена на внутренне связанные, но слабо связанные между собой модули."
                            },
                            {
                                "example_id": "49ce4dac-dffb-42bb-9400-f02768e041c2",
                                "sense_id": "31725f01-53a1-3803-bdb8-4d5bc52aa5fb",
                                "text": "Отличительной особенностью Ка-226 является универсальная модульность его конструкции."
                            }
                        ]
                    }
