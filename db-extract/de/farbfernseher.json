                "senses": [
                    {
                        "sense_id": "a351e793-3da6-30f3-922d-d4ce450013bb",
                        "entry_id": "4331fb36-ddef-3d5d-a341-f3865501137e",
                        "glosses": [
                            "Fernsehgerät, das Bilder in Farbe ausgibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "08ed30a7-281f-40a1-ba3d-5db490765214",
                                "sense_id": "a351e793-3da6-30f3-922d-d4ce450013bb",
                                "text": "Ich habe mir einen neuen Farbfernseher gekauft."
                            },
                            {
                                "example_id": "746c866b-6349-4e10-9865-4dbfcd68e683",
                                "sense_id": "a351e793-3da6-30f3-922d-d4ce450013bb",
                                "text": "Als die ersten Farbfernseher auf den Markt kamen, waren diese noch eine große Attraktion."
                            },
                            {
                                "example_id": "92bcc416-4f56-46a8-9fb2-e52f9a636da1",
                                "sense_id": "a351e793-3da6-30f3-922d-d4ce450013bb",
                                "text": "„Weil Oma und Opa Jever sich einen Farbfernseher gekauft hatten, holte Papa mit dem Auto deren altes Schwarzweißgerät ab und schloß es bei uns im Hobbyraum an.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
