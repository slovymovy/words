                "senses": [
                    {
                        "sense_id": "89da6f8d-d92f-3928-b835-1ed363c65112",
                        "entry_id": "f7e1dea5-1fd4-3c5d-b2f0-9cb4c9967449",
                        "glosses": [
                            "удлинить витьем (что нибудь витое)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "921b33bf-420e-4750-98ec-7738613e8854",
                                "sense_id": "89da6f8d-d92f-3928-b835-1ed363c65112",
                                "text": "Надвить веревку."
                            },
                            {
                                "example_id": "af93c49a-9bb4-4ce7-8284-dabac7b99721",
                                "sense_id": "89da6f8d-d92f-3928-b835-1ed363c65112",
                                "text": "Начал собирать обрывки да веревки, от лаптей оборки, связал все вместе, наставил и надвил, на конце клепец в аршин присадил; пошел к ямищу, опустил веревку с клепцом да потряхивает."
                            }
                        ]
                    },
                    {
                        "sense_id": "1e934574-aae0-39e4-9d26-e01d0b5d6a6a",
                        "entry_id": "f7e1dea5-1fd4-3c5d-b2f0-9cb4c9967449",
                        "glosses": [
                            "прибавить что нибудь (витое) к свитому ранее"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "baa60894-a698-46a7-a396-0205f28e694f",
                                "sense_id": "1e934574-aae0-39e4-9d26-e01d0b5d6a6a",
                                "text": "Надвить к веревке еще метр."
                            }
                        ]
                    }
