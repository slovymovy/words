                                "example_id": "1b2627d1-8ad0-4453-981d-46b3e695bf12",
                                "sense_id": "7ec53754-95c2-3763-aac5-a857811d2185",
                                "text": "Die Zahl seiner Follower wächst und wächst."
                            },
                            {
                                "example_id": "72e5e8ca-5dcc-4321-8595-f8ed6067b8db",
                                "sense_id": "7ec53754-95c2-3763-aac5-a857811d2185",
                                "text": "Sie hat die meisten Follower auf Twitter und Instagram."
                            },
                            {
                                "example_id": "b84d972a-f1a2-480b-8325-9d0cd5e2024b",
                                "sense_id": "7ec53754-95c2-3763-aac5-a857811d2185",
                                "text": "Ich habe in 24 Stunden 10 neue Follower gewonnen!"
                            },
                            {
                                "example_id": "36f386bb-bf38-4588-9577-a624356418ca",
                                "sense_id": "7ec53754-95c2-3763-aac5-a857811d2185",
                                "text": "„Wie auch auf Facebook und YouTube können Sie sich bei Instagram Follower kaufen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
