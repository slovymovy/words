            {
                "entry_id": "f64122f6-9d96-3765-926d-bf43fc563ad1",
                "word": "palp",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "79be1ab3-f9ea-4c45-8550-f00fe153592e",
                        "entry_id": "f64122f6-9d96-3765-926d-bf43fc563ad1",
                        "tags": [
                            "plural"
                        ],
                        "form": "palps"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b66403cb-a6de-3bf8-ab4f-3eb9964abde1",
                        "entry_id": "f64122f6-9d96-3765-926d-bf43fc563ad1",
                        "glosses": [
                            "A fleshy part of a fingertip."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "9227a9f7-a9d3-42e4-b220-ffb5df17c2c6",
                                "sense_id": "b66403cb-a6de-3bf8-ab4f-3eb9964abde1",
                                "text": "He folded his razor neatly and with stroking palps of fingers felt the smooth skin."
                            },
                            {
                                "example_id": "167ba79c-c47c-4433-aeea-1dff9f716a21",
                                "sense_id": "b66403cb-a6de-3bf8-ab4f-3eb9964abde1",
                                "text": "The palps of her fingers itched, thickened, erected with the need to touch the bent head. Plunge into the dust-moted rough blackness of his hair, smooth back downward over the deep-brown nape of his neck."
                            },
                            {
                                "example_id": "44ed8277-80ff-4141-a495-cb66b9800940",
                                "sense_id": "b66403cb-a6de-3bf8-ab4f-3eb9964abde1",
                                "text": "With the palp of a forefinger he squeezed moisture from his wiry blond eyebrows."
                            },
                            {
                                "example_id": "1bde9272-0c94-480a-b611-970f7370c68c",
                                "sense_id": "b66403cb-a6de-3bf8-ab4f-3eb9964abde1",
                                "text": "When Mariuchi caresses the plant, for example, sensuously emitting from the palps of her fingers, a siren song."
                            },
                            {
                                "example_id": "2432cb99-ae54-402c-8f05-eff4457f1eaa",
                                "sense_id": "b66403cb-a6de-3bf8-ab4f-3eb9964abde1",
                                "text": "He tested the blade against the palp of his thumb, then returned to the living room and decisively, scrape by scrape, cut away the hex sign, leaving a halo of ragged wood."
                            },
                            {
                                "example_id": "148987cf-08ef-48d9-bb89-edc28691c6f9",
                                "sense_id": "b66403cb-a6de-3bf8-ab4f-3eb9964abde1",
                                "text": "The bag seethed in her hand, not unpleasantly, as computational monofilaments shifted and flowed under her touch until they cradled the palps of her fingers."
                            }
                        ]
                    },
                    {
                        "sense_id": "01b07570-676a-3eda-841b-988cf1cdc998",
                        "entry_id": "f64122f6-9d96-3765-926d-bf43fc563ad1",
                        "glosses": [
                            "Clipping of palpation."
                        ],
                        "tags": [
                            "abbreviation",
                            "alt-of",
                            "clipping",
                            "colloquial",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "8bcef48a-b667-4b7f-bcd3-51ae4641bbb4",
                                "sense_id": "01b07570-676a-3eda-841b-988cf1cdc998",
                                "text": "pain on palp"
                            }
                        ]
                    }
                ],
