    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ae21f856-4bb4-3073-a8cd-3f10eb1f2a4b",
                    "sense_definition": "Een koosnaam voor een geliefd persoon of iemand die erg aardig is.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "koosnaam",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dag <w>schat</w>, hoe was je dag op het werk?",
                            "target_lang_translations": {
                                "en": "Hi <w>darling</w>, how was your day at work?"
                            }
                        },
                        {
                            "text": "Mijn buurvrouw is een echte <w>schat</w> omdat ze altijd mijn planten water geeft.",
                            "target_lang_translations": {
                                "en": "My neighbor is a real <w>sweetheart</w> because she always waters my plants."
                            }
                        }
                    ],
                    "synonyms": [
                        "lieveling",
                        "lieverd",
                        "schattebout"
                    ],
                    "common_phrases": [
                        "een schat van een"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "veelgebruikt in informele situaties"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A term of endearment for a loved one or someone who is very kind."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "darling",
                                "target_lang_sense_clarification": "a person who is very dear to one"
                            },
                            {
                                "target_lang_word": "honey",
                                "target_lang_sense_clarification": "a common term of affection"
                            },
                            {
                                "target_lang_word": "sweetheart",
                                "target_lang_sense_clarification": "a person who is very kind or a romantic partner"
                            },
                            {
                                "target_lang_word": "sweetie",
                                "target_lang_sense_clarification": "an informal term for a loved one"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8bf95c7e-cd46-3e41-8593-83c1a3d80700",
                    "sense_definition": "Een verzameling van kostbare zaken zoals goud, zilver of juwelen.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "rijkdom",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De piraten hebben hun <w>schat</w> op een onbewoond eiland begraven.",
                            "target_lang_translations": {
                                "en": "The pirates buried their <w>treasure</w> on a deserted island."
                            }
                        },
                        {
                            "text": "In het museum kun je een gouden <w>schat</w> uit de Romeinse tijd bewonderen.",
                            "target_lang_translations": {
                                "en": "In the museum, you can admire a golden <w>treasure</w> from the Roman era."
                            }
                        }
                    ],
                    "common_phrases": [
                        "een verborgen schat"
                    ],
                    "target_lang_definitions": {
                        "en": "A collection of valuable items such as gold, silver, or jewels."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "treasure",
                                "target_lang_sense_clarification": "accumulated wealth or valuable objects"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a8e9b0a1-f3e9-39fe-a689-fac883e4ad87",
                    "sense_definition": "Een grote en waardevolle hoeveelheid van iets, niet noodzakelijk geldelijk.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "rijkdom",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dit boek bevat een <w>schat</w> aan informatie over de geschiedenis van de stad.",
                            "target_lang_translations": {
                                "en": "This book contains a <w>wealth</w> of information about the history of the city."
                            }
                        },
                        {
                            "text": "De bibliotheek is een <w>schat</w> aan kennis voor elke student.",
                            "target_lang_translations": {
                                "en": "The library is a <w>treasure trove</w> of knowledge for every student."
                            }
                        }
                    ],
                    "common_phrases": [
                        "een schat aan informatie"
                    ],
                    "target_lang_definitions": {
                        "en": "A large and valuable amount of something, not necessarily monetary."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "wealth",
                                "target_lang_sense_clarification": "an abundance of something desirable"
                            },
                            {
                                "target_lang_word": "treasure trove",
                                "target_lang_sense_clarification": "a collection of valuable or delightful things"
                            },
                            {
                                "target_lang_word": "mine",
                                "target_lang_sense_clarification": "an abundant source of something"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "82fa2f82-e695-340c-9e54-232f63c4411b",
                    "sense_definition": "De eerste persoon enkelvoud tegenwoordige tijd van <w>schatten</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "schatten_werkwoord",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>schat</w> dat de reparatie ongeveer honderd euro zal kosten.",
                            "target_lang_translations": {
                                "en": "I <w>estimate</w> that the repair will cost about a hundred euros."
                            }
                        },
                        {
                            "text": "Ik <w>schat</w> haar leeftijd rond de dertig jaar.",
                            "target_lang_translations": {
                                "en": "I <w>guess</w> her age to be around thirty."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vervoegde vorm van het werkwoord schatten"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The first person singular present tense of the verb 'to estimate'."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "estimate",
                                "target_lang_sense_clarification": "to roughly calculate a value or size"
                            },
                            {
                                "target_lang_word": "guess",
                                "target_lang_sense_clarification": "to form an opinion without certain knowledge"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0286bda0-1eb6-3be8-8a02-1ff79232b7da",
                    "sense_definition": "De gebiedende wijs van <w>schatten</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "schatten_werkwoord",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Schat</w> de waarde van dit schilderij voordat je het verkoopt.",
                            "target_lang_translations": {
                                "en": "<w>Estimate</w> the value of this painting before you sell it."
                            }
                        },
                        {
                            "text": "<w>Schat</w> de afstand tot de overkant van de rivier eens in.",
                            "target_lang_translations": {
                                "en": "Try to <w>assess</w> the distance to the other side of the river."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "imperatief van het werkwoord schatten"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The imperative form of the verb 'to estimate'."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "estimate",
                                "target_lang_sense_clarification": "command to calculate a value"
                            },
                            {
                                "target_lang_word": "assess",
                                "target_lang_sense_clarification": "command to evaluate the nature or quality of something"
                            }
                        ]
                    }
                }
            ]
        }
    ]
