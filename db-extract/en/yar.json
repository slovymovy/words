                        "sense_id": "27c6f113-e50d-37a3-b9f8-42266b352786",
                        "entry_id": "5aa35593-3135-377f-a763-127c3acd881d",
                        "glosses": [
                            "Quick and agile; easy to hand, reef and steer."
                        ],
                        "tags": [
                            "of a vessel"
                        ],
                        "examples": [
                            {
                                "example_id": "55eb218b-0c1a-4ebf-a099-8c437e095f86",
                                "sense_id": "27c6f113-e50d-37a3-b9f8-42266b352786",
                                "text": "The wynd was good, the Schip was yare."
                            },
                            {
                                "example_id": "d9cafd43-d016-41b6-b8f3-4225590d6ee5",
                                "sense_id": "27c6f113-e50d-37a3-b9f8-42266b352786",
                                "text": "1939, The Philadelphia Story written by Philip Barry\nMy, she was yar...It means, uh...easy to handle, quick to the helm, fast, right. Everything a boat should be, until she develops dry rot."
                            },
                            {
                                "example_id": "fbde5511-3d68-4724-b486-a2d151c2076f",
                                "sense_id": "27c6f113-e50d-37a3-b9f8-42266b352786",
                                "text": "...to make a ship best weighed, or yarest in her going."
                            },
                            {
                                "example_id": "d1ce6f6f-8f6f-4b30-a888-08b61259b682",
                                "sense_id": "27c6f113-e50d-37a3-b9f8-42266b352786",
                                "text": "Arr, here be a fine vessel: the yarest river-going boat there be."
                            }
                        ]
                    }
