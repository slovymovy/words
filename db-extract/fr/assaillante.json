                            {
                                "example_id": "86df7ea8-ba8d-4b42-b1a5-e82bc98bbc4a",
                                "sense_id": "898fc956-9674-3e5d-bc10-8fb981d0bcc9",
                                "text": "Et je le sors aussitôt pour appuyer mes dires, comme un brave type qui aurait peur d’être pris pour le complice de son assaillante."
                            },
                            {
                                "example_id": "d5d87b97-27bc-4c75-aacf-1cf2825e1feb",
                                "sense_id": "898fc956-9674-3e5d-bc10-8fb981d0bcc9",
                                "text": "L’une des balles destinée à l’assaillante l’a atteinte, cette dernière s’étant servie d’elle comme d’un bouclier humain."
                            }
                        ]
                    }
