                "senses": [
                    {
                        "sense_id": "87621cf6-c123-3fa9-b160-d8cf22e02e2e",
                        "entry_id": "3b611979-fe98-3e40-96b1-5dffe6e73856",
                        "glosses": [
                            "истор. индивидуально-семейная земельная собственность в варварских королевствах на территории бывшей Западно-Римской империи, в раннефеодальных государствах Западной Европы"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4cb05368-6543-4ee6-86c5-efb16e6c1d2f",
                        "source_entry_id": "3b611979-fe98-3e40-96b1-5dffe6e73856",
                        "source_sense_id": "87621cf6-c123-3fa9-b160-d8cf22e02e2e",
                        "target_lang_word": "Allod",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Allod",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0a7e79d0-657f-3396-b053-cf63727a7cb3",
                                        "entry_id": "e9923e2b-566c-3272-b175-ddd4dd52a2e0",
                                        "glosses": [
                                            "Grundbesitz, der einem Adeligen, der Kirche oder einem Bauern gehörte ohne Abhängigkeiten von einem Obereigentümer"
                                        ],
                                        "tags": [
                                            "Mittelalter",
                                            "frühe Neuzeit"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5a027b2e-0b55-44ef-9273-a106e0d4f492",
                                                "sense_id": "0a7e79d0-657f-3396-b053-cf63727a7cb3",
                                                "text": "„Mit seiner Zustimmung erfolgte im November 1196 seitens Otto’s II. die Lehnsauftragung der markgräflichen Allode in der Alt- und Mittelmark an das Erzstift Magdeburg.“"
                                            },
                                            {
                                                "example_id": "3b12fa0b-dcb8-4f23-928b-4c375b60511c",
                                                "sense_id": "0a7e79d0-657f-3396-b053-cf63727a7cb3",
                                                "text": "„Da stellte es sich heraus, daß der Junker an den Schwiegersohn des Amtmanns, Jón von Vatn, sein Allod und väterliches Erbe Braedratunga samt dazugehörender beweglicher Habe verkauft hatte; und der neue Besitzer war mit dem Amtmann auf dem Wege zum Thing zusammen mit zwei Abschätzern gekommen, um den Viehbestand und die Gebäude, über die man beim Kauf noch keine endgültige Absprache getroffen, zu taxieren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
