        "fr-extract.jsonl": [
            {
                "entry_id": "eb4a32b5-7ba1-3906-bb5b-0088db366132",
                "word": "évitable",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "a2077c6b-b82a-4caa-8e99-166de4720d36",
                        "entry_id": "eb4a32b5-7ba1-3906-bb5b-0088db366132",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "évitables"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7de95018-04ef-3b95-9566-4053e8df3148",
                        "entry_id": "eb4a32b5-7ba1-3906-bb5b-0088db366132",
                        "glosses": [
                            "Qui peut être évité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "914c5524-6c2a-4109-902c-ba89e8b0b2b8",
                                "sense_id": "7de95018-04ef-3b95-9566-4053e8df3148",
                                "text": "Ce malheur était facilement évitable."
                            },
                            {
                                "example_id": "e8019288-4f36-4eab-b3f7-8ed429e6129b",
                                "sense_id": "7de95018-04ef-3b95-9566-4053e8df3148",
                                "text": "10 mars 44 – Max Jacob est mort. Les journaux gardent le silence sur son arrestation comme sur sa fin, mais marraine a eu de ses nouvelles par une chaîne de personnes interposées et on sait qu’il est mort d’une mort évitable, d’une pneumonie contractée à Drancy où il avait été transféré après son passage à Orléans."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4e2eebb0-6ac0-43d6-b7f7-fbb71bddc03e",
                        "source_entry_id": "eb4a32b5-7ba1-3906-bb5b-0088db366132",
                        "source_sense_id": "7de95018-04ef-3b95-9566-4053e8df3148",
                        "target_lang_word": "avoidable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "avoidable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0ce88c4d-2f82-3ba2-92a6-7727de5b1d4e",
                                        "entry_id": "4e793e26-e43a-3009-b9f4-ad38b5d24b20",
                                        "glosses": [
                                            "Capable of being vacated; liable to be annulled or made invalid; voidable."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5f20bc6d-321d-34bf-b0da-e9ed4bd99f8d",
                                        "entry_id": "4e793e26-e43a-3009-b9f4-ad38b5d24b20",
                                        "glosses": [
                                            "Capable of being avoided, shunned, or escaped."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf22dc10-66f1-4e83-922e-d62ed20bd002",
                                                "sense_id": "5f20bc6d-321d-34bf-b0da-e9ed4bd99f8d",
                                                "text": "The minister confessed that many of the deaths were avoidable."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "avoidable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "40a3ed0a-bcfd-33c7-8e72-01d65ad73043",
                                        "entry_id": "37e01c71-1e0f-355a-9ffa-f1578b7c7c64",
                                        "glosses": [
                                            "Something that can or should be avoided."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5030b1cf-3f67-4d50-85da-ac90dfbe6226",
                                                "sense_id": "40a3ed0a-bcfd-33c7-8e72-01d65ad73043",
                                                "text": "Though Mrs Golson re-appeared regularly at the Twyborns', she was on my list of avoidables from the night of the corked moustache until she sprang upon us yesterday."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9391861c-542a-4700-bb4f-c54aacdb9970",
                        "source_entry_id": "eb4a32b5-7ba1-3906-bb5b-0088db366132",
                        "source_sense_id": "7de95018-04ef-3b95-9566-4053e8df3148",
                        "target_lang_word": "evitable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "evitable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "83bafa50-ad8f-3087-98eb-e62331524f0d",
                                        "entry_id": "8749ede8-3d8b-30be-a86b-0085981e22f2",
                                        "glosses": [
                                            "Possible to avoid; avertible."
                                        ],
                                        "tags": [
                                            "uncommon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c054f2d6-5ca8-4249-9b9d-099d293eb4b0",
                                                "sense_id": "83bafa50-ad8f-3087-98eb-e62331524f0d",
                                                "text": "The tragic consequences were evitable."
                                            },
                                            {
                                                "example_id": "3654248d-41a4-4a6d-a452-cb2122bc1d20",
                                                "sense_id": "83bafa50-ad8f-3087-98eb-e62331524f0d",
                                                "text": "That Fort is unſafe where a part of the Garriſon conſiſts of diſguiſed Enemies; for when they take their turns at the Watch, the danger is hardly evitable. It would then certainly be for the ſafety of the Fort, that ſuch Friends in Maſquerade were induſtrouſly kept out, inſtead of being whipt in."
                                            },
                                            {
                                                "example_id": "3d36e817-7d7a-46db-beae-fe2e27c7a8aa",
                                                "sense_id": "83bafa50-ad8f-3087-98eb-e62331524f0d",
                                                "text": "A momentary ſhock like this, I ſay, may, for aught we otherwiſe know, ſooner or later, prove our lot, whenever the evitable fate of our impieties will no longer ſuffer the divine juſtice to be patient."
                                            },
                                            {
                                                "example_id": "438b9bf0-ee56-46cf-a579-687f74b65338",
                                                "sense_id": "83bafa50-ad8f-3087-98eb-e62331524f0d",
                                                "text": "The \"disintegration\" [of the intellect] of which I speak may be evitable or inevitable, good or bad; to draw its optimistic or pessimistic conclusions is an occupation for prophets and makers of almanacks, of whom I am not one."
                                            },
                                            {
                                                "example_id": "a241e4e6-bb0c-43cb-9dd0-bcb577faa0ff",
                                                "sense_id": "83bafa50-ad8f-3087-98eb-e62331524f0d",
                                                "text": "[W]e will analyze the imaging performance through the compensated bilayer lens theoretically and explore the effects of loss and retardation in the material parameters on the image quality, which are evitable in realistic metamaterials."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2b59b833-47ca-4d41-a238-68319f84ff2d",
                        "source_entry_id": "eb4a32b5-7ba1-3906-bb5b-0088db366132",
