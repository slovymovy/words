                "senses": [
                    {
                        "sense_id": "aaf2b84e-6911-3eb6-b724-0861e4006158",
                        "entry_id": "f505e151-cc75-39dd-bc3b-b67de4fa50b5",
                        "glosses": [
                            "Processus par lequel une agent chimique absorbé par un organisme s’accumule dans ses tissus, en particulier si elle est difficile à métaboliser ou à éliminer."
                        ],
                        "tags": [
                            "Toxicologie"
                        ],
                        "examples": [
                            {
                                "example_id": "2b4ca1cc-e4b6-4e6c-be39-888dd3eb6c14",
                                "sense_id": "aaf2b84e-6911-3eb6-b724-0861e4006158",
                                "text": "Il convient de donner des informations sur la bioaccumulation, la persistance et la dégradabilité, lorsque ces informations sont disponibles et appropriées, pour chaque substance pertinente présente dans le mélange."
                            },
                            {
                                "example_id": "a2f2da1b-84f0-4bcd-90d2-2bcbfad8a455",
                                "sense_id": "aaf2b84e-6911-3eb6-b724-0861e4006158",
                                "text": "En fait, nous tentons de connaître dans les moindres détails les mécanismes de bioaccumulation ou, au contraire, de bioélimination des toxines et d’arriver à les reproduire expérimentalement, poursuivit Cailly, nullement perturbé."
                            }
                        ]
                    },
                    {
                        "sense_id": "f1983b8b-6013-3abb-b591-28b0805bb758",
                        "entry_id": "f505e151-cc75-39dd-bc3b-b67de4fa50b5",
                        "glosses": [
                            "Résultat de ce processus, mesuré par la concentration interne du composé dans l’organisme."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": []
                    }
                ],
