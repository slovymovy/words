                    {
                        "translation_id": "6cfb03bf-9115-499b-baaa-a8f70c58e30b",
                        "source_entry_id": "b35a15d4-1d71-35cc-b97b-ecc9d0b0ec5b",
                        "source_sense_id": "21ab4dfb-939b-3c32-8212-2b47321673cc",
                        "source_sense_description": "jemand, der als Soldat an einem Krieg teilnimmt oder teilgenommen hat",
                        "target_lang_word": "combattant",
