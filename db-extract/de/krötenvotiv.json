                ],
                "senses": [
                    {
                        "sense_id": "a3570f6f-ca2c-3ec0-aa5e-3b87f878e70a",
                        "entry_id": "480e9daa-84be-3c6a-b575-ecf0b63d36c4",
                        "glosses": [
                            "den Unterleib und diese Organe einer Frau betreffende Votivgabe durch einen Votant"
                        ],
                        "tags": [
                            "Symbolisierung"
                        ],
                        "examples": [
                            {
                                "example_id": "c0dcb3db-dc45-49e0-baeb-333e7dbfda21",
                                "sense_id": "a3570f6f-ca2c-3ec0-aa5e-3b87f878e70a",
                                "text": "„Frauen brachten daher Krötenvotive als Dank- und Opfergaben in Kirchen und Kapellen, wenn ihnen bei Unterleibserkrankungen, Unfruchtbarkeit oder sexuellen Nöten geholfen wurde.“"
                            },
                            {
                                "example_id": "2260527d-7ba6-4330-9e98-91a867b25140",
                                "sense_id": "a3570f6f-ca2c-3ec0-aa5e-3b87f878e70a",
                                "text": "„Krötenvotiv aus Wachs - Votivgabe bei Gebärmutterleiden“"
                            },
                            {
                                "example_id": "eb67362b-397b-4bdd-9001-a4d266c03772",
                                "sense_id": "a3570f6f-ca2c-3ec0-aa5e-3b87f878e70a",
                                "text": "„Um das Verhältnis des Krötentieres zum Krötenvotiv klarzulegen, will er drei Momente besonders auseinander halten: 1. die lebende Kröte als Seelentier, 2. die Kröte als Fetischtier, 3. die Kröte als Bild.“"
                            },
                            {
                                "example_id": "ff32f147-42d4-4fab-9c27-1ef61eec6e8b",
                                "sense_id": "a3570f6f-ca2c-3ec0-aa5e-3b87f878e70a",
                                "text": "„Krötenvotive sind Dankesgaben zur Geburt eines gesunden Kindes.“"
                            },
                            {
                                "example_id": "37e3c4b7-80c9-4845-8d4b-4c70802ed02e",
                                "sense_id": "a3570f6f-ca2c-3ec0-aa5e-3b87f878e70a",
                                "text": "„Unter den Votivbildern sind viele trachtenkundlich bemerkenswert, unter den Opfergaben auch einige Krötenvotive.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
