{
    "word_family": [
        "avoid",
        "avoidance",
        "devoid",
        "voidness",
        "voidable"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "a8f40065-eb01-3e00-b86c-827a3cb462ec",
                    "sense_definition": "Of no legal force or effect; not valid or binding.",
                    "learner_level": "C1",
                    "frequency": "High",
                    "semantic_group_id": "validity_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The contract was declared null and <w>void</w> because it was not signed by all parties.",
                            "target_lang_translations": {
                                "ru": "Договор был признан <w>недействительным</w>, поскольку не был подписан всеми сторонами.",
                                "zh": "由于没有得到所有当事方的签字，这份合同被宣布为<w>无效</w>。"
                            }
                        },
                        {
                            "text": "Any rule that contradicts the constitution is considered <w>void</w>.",
                            "target_lang_translations": {
                                "ru": "Любое правило, противоречащее конституции, считается <w>недействительным</w>.",
                                "zh": "任何与宪法相抵触的规定都被视为<w>无效</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "invalid",
                        "useless",
                        "ineffectual"
                    ],
                    "common_phrases": [
                        "null and void",
                        "render void"
                    ],
                    "target_lang_definitions": {
                        "ru": "Не имеющий юридической силы; недействительный.",
                        "zh": "不具有法律效力的；不成立或没有约束力的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "недействительный",
                                "target_lang_sense_clarification": "не имеющий законной силы"
                            },
                            {
                                "target_lang_word": "ничтожный",
                                "target_lang_sense_clarification": "юридический термин (о сделке)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "无效的",
                                "target_lang_sense_clarification": "法律、合同、规则等不具效力"
                            },
                            {
                                "target_lang_word": "不具法律效力的",
                                "target_lang_sense_clarification": "正式，用于法律或规章语境"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d4f2bff9-0581-3523-bea0-0b257a32e440",
                    "sense_definition": "Completely lacking or free from something.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "emptiness_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His voice was completely <w>void</w> of emotion when he delivered the bad news.",
                            "target_lang_translations": {
                                "ru": "Его голос был совершенно <w>лишён</w> эмоций, когда он сообщил плохие новости.",
                                "zh": "他告诉别人这个坏消息时，声音是<w>毫无</w>感情<w>的</w>。"
                            }
                        },
                        {
                            "text": "The landscape was <w>void</w> of any vegetation due to the drought.",
                            "target_lang_translations": {
                                "ru": "Пейзаж был <w>лишён</w> какой-либо растительности из-за засухи.",
                                "zh": "由于干旱，这片土地是<w>毫无</w>植被<w>的</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "devoid of",
                        "destitute of",
                        "lacking",
                        "free from"
                    ],
                    "common_phrases": [
                        "void of"
                    ],
                    "target_lang_definitions": {
                        "ru": "Полностью лишенный чего-либо.",
                        "zh": "完全没有某物的；丝毫不具备某种东西的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лишённый",
                                "target_lang_sense_clarification": "чего-либо (эмоций, содержания)"
                            },
                            {
                                "target_lang_word": "свободный",
                                "target_lang_sense_clarification": "от чего-либо"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "毫无……的",
                                "target_lang_sense_clarification": "后常接所缺少的事物，如感情、内容"
                            },
                            {
                                "target_lang_word": "缺乏……的",
                                "target_lang_sense_clarification": "正式，表示缺少某种东西"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e444e769-1ef7-3b91-8a48-de847df9351f",
                    "sense_definition": "Containing nothing; empty or unoccupied.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "emptiness_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He stared into the <w>void</w> darkness of the cave.",
                            "target_lang_translations": {
                                "ru": "Он вглядывался в <w>пустую</w> тьму пещеры.",
                                "zh": "他凝视着洞穴里那片<w>空无一物的</w>黑暗。"
                            }
                        },
                        {
                            "text": "The house stood <w>void</w> and silent after the family moved out.",
                            "target_lang_translations": {
                                "ru": "Дом стоял <w>пустым</w> и тихим после того, как семья съехала.",
                                "zh": "这家人搬走后，房子一直<w>空着</w>，寂静无声。"
                            }
                        }
                    ],
                    "synonyms": [
                        "empty",
                        "vacant",
                        "unoccupied"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "modern usage prefers 'empty' or 'vacant'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ничем не заполненный; пустой или незанятый.",
                        "zh": "里面没有任何东西的；空的，或无人占用的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пустой",
                                "target_lang_sense_clarification": "ничем не заполненный"
                            },
                            {
                                "target_lang_word": "порожний",
                                "target_lang_sense_clarification": "о сосудах или транспорте"
                            },
                            {
                                "target_lang_word": "незанятый",
                                "target_lang_sense_clarification": "свободный (о месте)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "空的",
                                "target_lang_sense_clarification": "里面什么也没有的"
                            },
                            {
                                "target_lang_word": "空着的",
                                "target_lang_sense_clarification": "强调未被占用、无人居住"
                            },
                            {
                                "target_lang_word": "空置的",
                                "target_lang_sense_clarification": "较正式，指场所未被使用"
                            },
                            {
                                "target_lang_word": "空无一物的",
                                "target_lang_sense_clarification": "强调完全没有内容"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f55b0f8a-6c7b-33e3-8c68-7ccf3d19a871",
                    "sense_definition": "A large empty space; a vacuum or abyss.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "emptiness_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The astronaut looked out at the dark <w>void</w> of space.",
                            "target_lang_translations": {
                                "ru": "Астронавт смотрел на темную <w>пустоту</w> космоса.",
                                "zh": "宇航员望向太空中黑暗的<w>虚空</w>。"
                            }
                        },
                        {
                            "text": "She felt a deep <w>void</w> in her life after her best friend moved away.",
                            "target_lang_translations": {
                                "ru": "Она почувствовала глубокую <w>пустоту</w> в своей жизни после того, как её лучшая подруга переехала.",
                                "zh": "最好的朋友搬走后，她感到生活中有一种深深的<w>空虚</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "vacuum",
                        "emptiness",
                        "abyss",
                        "nothingness"
                    ],
                    "common_phrases": [
                        "fill the void",
                        "into the void"
                    ],
                    "target_lang_definitions": {
                        "ru": "Большое пустое пространство; вакуум или бездна.",
                        "zh": "大片的空无空间；真空、深渊，也可引申指内心的空缺感。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пустота",
                                "target_lang_sense_clarification": "незаполненное пространство"
                            },
                            {
                                "target_lang_word": "бездна",
                                "target_lang_sense_clarification": "глубокая пропасть"
                            },
                            {
                                "target_lang_word": "вакуум",
                                "target_lang_sense_clarification": "отсутствие материи"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "空虚",
                                "target_lang_sense_clarification": "大片空无的空间；也可指内心的空落感"
                            },
                            {
                                "target_lang_word": "虚空",
                                "target_lang_sense_clarification": "书面语，指广阔而空无的空间"
                            },
                            {
                                "target_lang_word": "深渊",
                                "target_lang_sense_clarification": "强调深不可测的空无或深渊感"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8b1ca73b-af46-3d35-a16b-3acdfa165d7f",
                    "sense_definition": "An empty space or gap within a structure, such as between walls or floors.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "emptiness_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The electrician ran the cables through the ceiling <w>void</w>.",
                            "target_lang_translations": {
                                "ru": "Электрик протянул кабели через <w>пустоту</w> в потолке.",
                                "zh": "电工把电缆穿过天花板上方的<w>空腔</w>。"
                            }
                        },
                        {
                            "text": "Builders filled the <w>voids</w> in the foundation with concrete.",
                            "target_lang_translations": {
                                "ru": "Строители заполнили <w>пустоты</w> в фундаменте бетоном.",
                                "zh": "工人们用混凝土填补了地基中的<w>空洞</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "gap",
                        "cavity",
                        "space"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical/construction context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Пустое пространство или зазор внутри конструкции.",
                        "zh": "结构内部的空处或间隙，例如墙体、楼板或天花板之间的空间。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пустота",
                                "target_lang_sense_clarification": "свободное пространство"
                            },
                            {
                                "target_lang_word": "полость",
                                "target_lang_sense_clarification": "технический термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "空腔",
                                "target_lang_sense_clarification": "建筑或结构内部的空心部分"
                            },
                            {
                                "target_lang_word": "空洞",
                                "target_lang_sense_clarification": "结构中的洞或空处"
                            },
                            {
                                "target_lang_word": "空隙",
                                "target_lang_sense_clarification": "较一般，指缝隙或空出来的地方"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8a445760-33c0-366d-888b-5d800b78cb7a",
                    "sense_definition": "A black cat.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I love taking pictures of my little <w>void</w>, but it is hard to get the lighting right.",
                            "target_lang_translations": {
                                "ru": "Я люблю фотографировать своего маленького <w>чёрного кота</w>, но трудно подобрать правильное освещение.",
                                "zh": "我很喜欢给我的小<w>黑猫</w>拍照，不过很难把光线调好。"
                            }
                        },
                        {
                            "text": "The shelter has many <w>voids</w> looking for a home this Halloween.",
                            "target_lang_translations": {
                                "ru": "В приюте много <w>чёрных кошек</w>, ищущих дом в этот Хэллоуин.",
                                "zh": "这个万圣节，收容所有很多<w>黑猫</w>在等人领养。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "internet culture"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Чёрный кот (интернет-сленг).",
                        "zh": "黑猫。网络俚语用法。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чёрный кот",
                                "target_lang_sense_clarification": "буквальный перевод"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "黑猫",
                                "target_lang_sense_clarification": "网络俚语，指黑色的猫"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "057c5128-e36e-367e-82df-67616b51bf82",
                    "sense_definition": "To cause something to be no longer valid, effective, or legally binding.",
                    "learner_level": "C1",
                    "frequency": "High",
                    "semantic_group_id": "validity_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If you open the back of the device, you will <w>void</w> the warranty.",
                            "target_lang_translations": {
                                "ru": "Если вы откроете заднюю крышку устройства, вы <w>аннулируете</w> гарантию.",
                                "zh": "如果你打开设备后盖，就会<w>使</w>保修<w>失效</w>。"
                            }
                        },
                        {
                            "text": "The cashier had to <w>void</w> the transaction because the customer forgot their wallet.",
                            "target_lang_translations": {
                                "ru": "Кассиру пришлось <w>аннулировать</w> транзакцию, так как покупатель забыл кошелек.",
                                "zh": "因为顾客忘带钱包，收银员只好<w>撤销</w>这笔交易。"
                            }
                        }
                    ],
                    "synonyms": [
                        "invalidate",
                        "cancel",
                        "annul",
                        "nullify"
                    ],
                    "common_phrases": [
                        "void a check",
                        "void a warranty"
                    ],
                    "target_lang_definitions": {
                        "ru": "Лишать юридической силы; делать недействительным.",
                        "zh": "使某物不再有效、不再生效，或不再具有法律约束力。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "аннулировать",
                                "target_lang_sense_clarification": "отменять действие документа"
                            },
                            {
                                "target_lang_word": "лишать силы",
                                "target_lang_sense_clarification": "делать недействительным"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "使……失效",
                                "target_lang_sense_clarification": "使合同、保修、交易等不再有效"
                            },
                            {
                                "target_lang_word": "作废",
                                "target_lang_sense_clarification": "正式，指令文件、票据、交易等失去效力"
                            },
                            {
                                "target_lang_word": "撤销",
                                "target_lang_sense_clarification": "取消已经成立的事项，如交易、登记等"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "29ab0b64-5184-339e-864d-eb957bca3ce7",
                    "sense_definition": "To empty waste matter from the body.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "emptiness_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patient needed help to <w>void</w> his bladder after the surgery.",
                            "target_lang_translations": {
                                "ru": "Пациенту требовалась помощь, чтобы <w>опорожнить</w> мочевой пузырь после операции.",
                                "zh": "手术后，这名患者需要别人帮助才能<w>排尿</w>。"
                            }
                        },
                        {
                            "text": "The doctor asked if he felt any pain while <w>voiding</w>.",
                            "target_lang_translations": {
                                "ru": "Врач спросил, чувствовал ли он боль при <w>опорожнении</w>.",
                                "zh": "医生问他<w>排尿</w>时是否感到疼痛。"
                            }
                        }
                    ],
                    "synonyms": [
                        "empty",
                        "evacuate",
                        "discharge"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "medical or formal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Опорожнять (кишечник или мочевой пузырь).",
                        "zh": "排出体内废物；医学上多指排尿，也可指排便。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "опорожнять",
                                "target_lang_sense_clarification": "освобождать от содержимого (мед.)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "排尿",
                                "target_lang_sense_clarification": "医学或正式说法，多指排空膀胱"
                            },
                            {
                                "target_lang_word": "排泄",
                                "target_lang_sense_clarification": "较正式，指把体内废物排出"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}