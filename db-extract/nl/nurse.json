                        "examples": [
                            {
                                "example_id": "682531ce-edb5-4c66-a197-e4e72de9e5cd",
                                "sense_id": "166165f0-2ecb-36ea-886e-862e511c0aca",
                                "text": "Nietwaar? als men barones is, en een rijke vader heeft, en een nurse, en een pony om op te rijden, dan heeft men toch ook spieren."
                            },
                            {
                                "example_id": "a40b552e-a59d-4eaf-b156-6d0a73bbeb90",
                                "sense_id": "166165f0-2ecb-36ea-886e-862e511c0aca",
                                "text": "De donkere sjaal van een nurse fladderde over de rotsen en achter haar volgde het tengere figuurtje van een kind."
                            }
                        ]
                    },
                    {
                        "sense_id": "470b600b-acfe-3b55-b09d-ed982ad4794f",
                        "entry_id": "951ffcd3-90aa-3b61-ae58-c843183ac2de",
                        "glosses": [
                            "vrouw die verpleegkundige is"
