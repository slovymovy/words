                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d1563da-28fb-4a48-acb9-23a747c6862d",
                                "sense_id": "d2d29415-34b3-3126-8fcf-7b5e1891209f",
                                "text": "Ainsi, du côté de la narration, le dernier numéro aime autobiographier ou autocommémorer le titre archi-énonciateur."
                            },
                            {
                                "example_id": "e02d0359-aee7-4d75-8e4a-26d12f41587a",
                                "sense_id": "d2d29415-34b3-3126-8fcf-7b5e1891209f",
                                "text": "Et en toute franchise j'ai du mal à m'autobiographier ou même expliquer un son ou la manière dont je l'ai écrit…"
                            },
                            {
                                "example_id": "38039d29-ddf9-43e4-89cd-13d3bf7d2fa9",
                                "sense_id": "d2d29415-34b3-3126-8fcf-7b5e1891209f",
                                "text": "Cette manière de s'autobiographier est favorisée par le penchant qu'a Humboldt à se conduire essentiellement comme un spectateur dans le monde."
                            }
                        ]
                    }
