                        "target_lang_word": "Rebellin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rebellin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bc9c3bdf-a5b3-3c0d-926b-77efb3eb55f2",
                                        "entry_id": "2d8fc155-37eb-32c6-8fb6-2f0f915b6466",
                                        "glosses": [
                                            "weibliche Person, die zum Umsturz bestehender (gesellschaftlicher) Zustände aufruft oder daran beteiligt ist; weibliche Person, die rebelliert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d50d194d-a185-4fe4-bda2-8805fba58e0e",
                                                "sense_id": "bc9c3bdf-a5b3-3c0d-926b-77efb3eb55f2",
                                                "text": "Die Rebellinnen protestieren gegen die Benachteiligung von Frauen."
                                            },
                                            {
                                                "example_id": "9b6a4987-f36e-4e59-a341-36c3d603fd5f",
                                                "sense_id": "bc9c3bdf-a5b3-3c0d-926b-77efb3eb55f2",
                                                "text": "Meine Tochter war schon in ihrer Kindheit eine Rebellin."
                                            },
                                            {
                                                "example_id": "4791e95c-a90f-4a18-bcae-a21187925245",
                                                "sense_id": "bc9c3bdf-a5b3-3c0d-926b-77efb3eb55f2",
                                                "text": "„Aber meine Mom war eine Rebellin, und zum Glück für sie kam ihre Rebellion zum richtigen Zeitpunkt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
