                    },
                    {
                        "form_id": "81911eeb-5a17-4269-9cea-d9f4ab77999f",
                        "entry_id": "34285e84-761e-30a6-8628-86c86c767d5d",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "den Ruhezustand"
                    },
                    {
                        "form_id": "bbefaafa-a8af-4e3c-b5a2-c8c289f2e6c8",
                        "entry_id": "34285e84-761e-30a6-8628-86c86c767d5d",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Ruhezustände"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1f1b5086-14ff-31f2-bbbd-71757d2d3644",
                        "entry_id": "34285e84-761e-30a6-8628-86c86c767d5d",
                        "glosses": [
                            "Zustand von jemandem oder etwas in Untätigkeit oder Entspannung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "450def0f-f290-46e3-89c8-d46eb736779b",
                                "sense_id": "1f1b5086-14ff-31f2-bbbd-71757d2d3644",
                                "text": "„Jeder Muskel in unserem Körper ist darauf ausgelegt, von einem Spannungszustand zu einem Ruhezustand wechseln zu können.“"
                            },
                            {
                                "example_id": "7de23815-c868-48d0-9dc3-20b547f68fb5",
                                "sense_id": "1f1b5086-14ff-31f2-bbbd-71757d2d3644",
                                "text": "„Im Ruhezustand liegt die Sauerstoffkonzentration im Muskel bei ungefähr 40 Torr, bei körperlicher Anstrengung verringert sie sich hingegen auf 20 Torr.“"
                            },
                            {
                                "example_id": "1a47b692-22de-411c-aca4-24108219758d",
                                "sense_id": "1f1b5086-14ff-31f2-bbbd-71757d2d3644",
                                "text": "„Er stellte die Frage, ob sich die Kugel nun bewegt oder im Ruhezustand befindet.“"
                            },
                            {
                                "example_id": "dd5cc3a1-a57a-49ed-a042-c12513c2ad22",
                                "sense_id": "1f1b5086-14ff-31f2-bbbd-71757d2d3644",
                                "text": "„Dieser Ruhezustand ist auch der Zustand der geringsten Reibung und des geringsten Widerstandes.“"
                            },
                            {
                                "example_id": "082e2f8d-efaf-4ead-8439-2a8e870fcae4",
                                "sense_id": "1f1b5086-14ff-31f2-bbbd-71757d2d3644",
                                "text": "„Für eine gestörte Psyche wie die eines Serienmörders ist es typisch, dass sich Ruhezustände mit häufig unmotivierten Wutausbrüchen abwechseln.“"
                            },
                            {
                                "example_id": "4d4af08e-e5b3-4258-8e1b-703b6205bdee",
                                "sense_id": "1f1b5086-14ff-31f2-bbbd-71757d2d3644",
                                "text": "„Triebbedingte Ruhezustände sind Schlaf und Winterschlaf; viele Tiere haben ein ausgeprägtes Appetenzverhalten, das sie nach einem ihrer Art gemäßen Schlafplatz oder Winterschlaf-Versteck suchen läßt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "6254e3e6-5fdf-3fca-a931-a00f74cc0a36",
                        "entry_id": "34285e84-761e-30a6-8628-86c86c767d5d",
                        "glosses": [
                            "Zustand, in dem ein elektronisches Gerät eingeschaltet ist, aber nichts ausführt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4048737-a43d-411f-8d1f-875261552bbd",
                                "sense_id": "6254e3e6-5fdf-3fca-a931-a00f74cc0a36",
                                "text": "„Viele Netzwerkkarten sind dazu in der Lage, einen abgeschalteten oder im Ruhezustand befindlichen Computer einzuschalten oder aufzuwecken.“"
                            },
                            {
                                "example_id": "803ea8a6-f023-4190-b71f-2f4ce1cf402d",
                                "sense_id": "6254e3e6-5fdf-3fca-a931-a00f74cc0a36",
                                "text": "„Befindet sich die CPU nicht lange genug im Ruhezustand, wird der Job nicht gestartet.“"
                            },
                            {
                                "example_id": "b17526a4-cdf3-4e7e-afa8-c772b54c1359",
                                "sense_id": "6254e3e6-5fdf-3fca-a931-a00f74cc0a36",
                                "text": "„Im Ausgangszustand befindet sich die Smartcard im Ruhezustand und es findet keine Kommunikation statt.“"
                            },
                            {
                                "example_id": "c1073780-021a-429b-9b70-7d9e58fe8f34",
                                "sense_id": "6254e3e6-5fdf-3fca-a931-a00f74cc0a36",
                                "text": "„Wenn Sie das iPad manuell über die Standby-Taste in den Ruhezustand versetzen, muss das nicht bedeuten, dass es auch gesperrt wird.“"
                            },
                            {
                                "example_id": "2a982b77-6f33-4e93-915d-739021d63e67",
                                "sense_id": "6254e3e6-5fdf-3fca-a931-a00f74cc0a36",
                                "text": "„Alarme bleiben unter Android auch dann aktiv, wenn sich das Gerät im Ruhezustand befindet.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
