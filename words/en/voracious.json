    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "66bd87c4-e025-32b2-ad80-293c956af1e0",
                    "sense_definition": "Having a very strong desire or enthusiasm for an activity, especially reading or learning.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "enthusiasm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "As a <w>voracious</w> reader, she finished three long novels in just one weekend.",
                            "target_lang_translations": {
                                "ru": "Будучи <w>ненасытным</w> читателем, она закончила три длинных романа всего за один уикенд."
                            }
                        },
                        {
                            "text": "The young student had a <w>voracious</w> appetite for knowledge and spent every afternoon in the library.",
                            "target_lang_translations": {
                                "ru": "У молодого студента была <w>жадная</w> тяга к знаниям, и он проводил каждый день в библиотеке."
                            }
                        }
                    ],
                    "synonyms": [
                        "eager",
                        "insatiable",
                        "rapacious"
                    ],
                    "common_phrases": [
                        "voracious reader",
                        "voracious appetite for knowledge"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обладающий очень сильным желанием или энтузиазмом к какой-либо деятельности, особенно к чтению или обучению."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ненасытный",
                                "target_lang_sense_clarification": "в плане знаний или чтения"
                            },
                            {
                                "target_lang_word": "жадный",
                                "target_lang_sense_clarification": "до знаний или информации"
                            },
                            {
                                "target_lang_word": "неутолимый",
                                "target_lang_sense_clarification": "о жажде деятельности"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2145405c-02cc-3960-9285-e8bb33d6992c",
                    "sense_definition": "Wanting or devouring great quantities of food.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "eating",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After the long hike, the group made a <w>voracious</w> assault on the breakfast buffet.",
                            "target_lang_translations": {
                                "ru": "После долгого похода группа совершила <w>прожорливый</w> набег на завтрак «шведский стол»."
                            }
                        },
                        {
                            "text": "The <w>voracious</w> wolves quickly finished the carcass before the other scavengers arrived.",
                            "target_lang_translations": {
                                "ru": "<w>Прожорливые</w> волки быстро покончили с тушей до того, как прибыли другие падальщики."
                            }
                        }
                    ],
                    "synonyms": [
                        "gluttonous",
                        "ravenous",
                        "edacious"
                    ],
                    "antonyms": [
                        "abstemious",
                        "unvoracious"
                    ],
                    "common_phrases": [
                        "voracious appetite",
                        "voracious assault"
                    ],
                    "target_lang_definitions": {
                        "ru": "Желающий или поглощающий большое количество пищи."
                    },
                    "translations": {
