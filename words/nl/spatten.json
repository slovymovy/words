                            {
                                "target_lang_word": "splash",
                                "target_lang_sense_clarification": "liquid dispersing suddenly from an impulse"
                            },
                            {
                                "target_lang_word": "splatter",
                                "target_lang_sense_clarification": "to fly out in many directions"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c1bd4fbe-5ea5-3334-bbd4-da5c9fabfebc",
                    "sense_definition": "iets of iemand nat maken door vloeistof in die richting te werpen of te trappen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "vloeistofbeweging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kinderen <w>spatten</w> elkaar nat in het zwembad.",
                            "target_lang_translations": {
