                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "crotte",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c19fc538-a4bf-3ac2-b1a1-95fba2c05b69",
                                        "entry_id": "e31c0390-b1c5-36cc-8e66-9064b3679cc3",
                                        "glosses": [
                                            "Exprime le dépit ou la colère, s'utilise à la place de merde."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "35618451-3814-4047-84d4-fe4c522a5cc9",
                                                "sense_id": "c19fc538-a4bf-3ac2-b1a1-95fba2c05b69",
                                                "text": "Elle les rosse encore parce qu’ils disent des gros mots ; ils jurent comme des charretiers ; il y a le petit de cinq ans qui crie toujours : « Crotte pour toi ! »"
                                            },
                                            {
                                                "example_id": "3449cba1-15f1-41f7-b8d2-ba649a739f07",
                                                "sense_id": "c19fc538-a4bf-3ac2-b1a1-95fba2c05b69",
                                                "text": "– Crotte, dit Alice. C’est avec des problèmes pareils qu’on devient chauve."
                                            },
                                            {
                                                "example_id": "5dca8998-e397-4ce3-a029-124b85aaa227",
                                                "sense_id": "c19fc538-a4bf-3ac2-b1a1-95fba2c05b69",
                                                "text": "— Ben crotte ! fit Muguet, qu’est-ce qui vous prend, tout brusquement ?"
                                            },
                                            {
                                                "example_id": "6935c038-e79d-4ce8-a136-7c642a31ff8b",
                                                "sense_id": "c19fc538-a4bf-3ac2-b1a1-95fba2c05b69",
                                                "text": "Ah ces riches… Crotte alors !"
                                            },
                                            {
                                                "example_id": "b9c2d274-a192-4788-8a23-e1cd2041d81e",
                                                "sense_id": "c19fc538-a4bf-3ac2-b1a1-95fba2c05b69",
                                                "text": "« Ah crotte… malheureusement l’avion est plein… surbooking… »"
                                            }
                                        ]
                                    }
                                ]
                            },
