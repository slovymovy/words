                ],
                "senses": [
                    {
                        "sense_id": "10ab518b-e4f8-3666-8445-450d42a125ca",
                        "entry_id": "988d818f-1d68-31b0-bde9-b3450f42b660",
                        "glosses": [
                            "Désigne certains requins de l'ordre des squaliformes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5755d1e6-7d3b-49a0-92de-bf8ab925755e",
                                "sense_id": "10ab518b-e4f8-3666-8445-450d42a125ca",
                                "text": "Les matelots halèrent le monstrueux squale au moyen d’un palan frappé à l’extrémité de la grande vergue."
                            },
                            {
                                "example_id": "5231a744-4c11-4e9a-be3a-c19911027c93",
                                "sense_id": "10ab518b-e4f8-3666-8445-450d42a125ca",
                                "text": "Dans la nuit du 27 au 28 décembre, le patron du bateau le Saint-André, de Nice, a capturé, au moyen du palangre, quatre moines ou monges, squales de la famille des requins : deux de 3m,50 de long, et deux de 2m,50."
                            }
                        ]
                    },
                    {
                        "sense_id": "b042916b-341c-39a1-8e37-9543fb2bf2c9",
                        "entry_id": "988d818f-1d68-31b0-bde9-b3450f42b660",
                        "glosses": [
                            "Requin."
                        ],
                        "tags": [
                            "Absolument"
                        ],
                        "examples": [
                            {
                                "example_id": "e7363956-6fb4-4a83-9e5c-1d0f21913ae3",
                                "sense_id": "b042916b-341c-39a1-8e37-9543fb2bf2c9",
                                "text": "J’avais pu constater, parmi cette cinquantaine de squales presque noirs, la présence d’un énorme requin blanc sale."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d66e9ec8-bc91-4c45-8447-8d5c1320a8c6",
                        "source_entry_id": "988d818f-1d68-31b0-bde9-b3450f42b660",
                        "target_lang_word": "Hai",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hai",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "820d05f7-4275-303c-98fc-f0ac30dc9944",
                                        "entry_id": "86f58921-bea0-38b6-8bbd-229f0281c08a",
                                        "glosses": [
                                            "im Meer lebender Raubfisch (Überordnung Selachii) aus der Klasse der Knorpelfische"
                                        ],
                                        "tags": [
                                            "Ichthyologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b3548360-5615-45be-82a1-39f23255a7cf",
                                                "sense_id": "820d05f7-4275-303c-98fc-f0ac30dc9944",
                                                "text": "Viele Haie sind lebendgebärend."
                                            },
                                            {
                                                "example_id": "72cee771-74a6-426a-8f88-452d4e59e21c",
                                                "sense_id": "820d05f7-4275-303c-98fc-f0ac30dc9944",
                                                "text": "„Den Haien wurde regelrecht der Krieg erklärt.“"
                                            },
                                            {
                                                "example_id": "d704023b-84a1-4222-894f-f7c5392a669b",
                                                "sense_id": "820d05f7-4275-303c-98fc-f0ac30dc9944",
                                                "text": "„Smoaks nahm den Haken, der seitlich im Kiefer des Haifischs steckte, und brachte ihn mehr in der Mitte an, damit der Hai sich leichter ins Schlepptau nehmen ließ.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "975064cf-915d-342a-bc0a-2fc4787c870a",
                                        "entry_id": "86f58921-bea0-38b6-8bbd-229f0281c08a",
                                        "glosses": [
                                            "ein von Gewinnsucht beziehungsweise Profitgier getriebener Mensch"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b08c7f24-4b5e-46f0-9b44-288d3ab5d8f6",
                                                "sense_id": "975064cf-915d-342a-bc0a-2fc4787c870a",
                                                "text": "Ich leihe mir lieber bei einem seriösen Institut Geld, bevor ich erneut auf einen Hai hereinfalle."
                                            },
                                            {
                                                "example_id": "7215837a-241a-4fc3-8a12-2800f04dddcf",
                                                "sense_id": "975064cf-915d-342a-bc0a-2fc4787c870a",
                                                "text": "„Der Hai prophezeite das Schlimmste: Börsenpleite, Schulden, neue Ausgaben, neue Schlachten, Krisen, sogar drohenden Kommunismus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3caaff52-67c4-41b7-bb75-442a93b1d286",
                        "source_entry_id": "988d818f-1d68-31b0-bde9-b3450f42b660",
                        "target_lang_word": "Haifisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Haifisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "81ae5130-f583-3cb6-bea1-9434a6b4de29",
                                        "entry_id": "5223d504-8726-3245-b58a-9db73b9a7ac7",
                                        "glosses": [
                                            "Zoologie, Ichthyologie: im Meer lebender Raubfisch (Überordnung Selachii) aus der Klasse der Knorpelfische"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "955cb694-593e-4295-82d5-ebfc0c7c21d1",
                                                "sense_id": "81ae5130-f583-3cb6-bea1-9434a6b4de29",
                                                "text": "Haifische sind gefürchtet."
                                            },
                                            {
                                                "example_id": "9816d74e-9e34-40ca-b437-0d3ac5a27463",
                                                "sense_id": "81ae5130-f583-3cb6-bea1-9434a6b4de29",
                                                "text": "„Es wimmelte von Haifischen, und wir mussten gut aufpassen, dass sie uns nicht am Bein schnappten, während wir uns mit den Baumstämmen abmühten.“"
                                            },
                                            {
                                                "example_id": "ff788a5e-2826-49fb-a836-6e807bc6d177",
                                                "sense_id": "81ae5130-f583-3cb6-bea1-9434a6b4de29",
                                                "text": "„Smoaks nahm den Haken, der seitlich im Kiefer des Haifischs steckte, und brachte ihn mehr in der Mitte an, damit der Hai sich leichter ins Schlepptau nehmen ließ.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
