                    "sense_id": "bdf437c9-c182-38c7-ba36-93a1492abd55",
                    "sense_definition": "British standard spelling of <w>armor</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The knight polished his shining <w>armour</w> before the tournament.",
                            "target_lang_translations": {
                                "ru": "Рыцарь начистил свои блестящие <w>доспехи</w> перед турниром.",
                                "nl": "De ridder poetste zijn glimmende <w>harnas</w> op voor het toernooi."
                            }
                        },
                        {
                            "text": "Police officers often wear body <w>armour</w> to stay safe on duty.",
                            "target_lang_translations": {
                                "ru": "Полицейские часто носят нательную <w>броню</w>, чтобы оставаться в безопасности на службе.",
                                "nl": "Politieagenten dragen vaak lichaams<w>bepantsering</w> om veilig te blijven tijdens hun dienst."
                            }
                        }
