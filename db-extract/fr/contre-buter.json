                "senses": [
                    {
                        "sense_id": "a0a94249-eb6a-3266-9882-2595898e57a5",
                        "entry_id": "e0b0436e-5821-3b15-a12d-61577768dbc9",
                        "glosses": [
                            "Opposer à la poussée d’un mur, d'un plafond, d'une voûte, d’un édifice, une force opposée, afin de les consolider."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3fc9471e-49bc-45c0-9ddd-aeb3be978062",
                                "sense_id": "a0a94249-eb6a-3266-9882-2595898e57a5",
                                "text": "La voûte centrale, en berceau avec arcs-doubleaux, est contre-butée par les voûtes également en berceau, couvrant les collatéraux très-étroits."
                            },
                            {
                                "example_id": "f810a94a-37a9-475b-ab97-dc53282cc599",
                                "sense_id": "a0a94249-eb6a-3266-9882-2595898e57a5",
                                "text": "Appuie ton dos contre cette paroi, reprit Uncle Prudent, et vous, Phil Evans, veuillez monter sur l’épaule de ce garçon, pendant que je contre-buterai afin qu’il ne vous manque pas."
                            }
                        ]
                    }
