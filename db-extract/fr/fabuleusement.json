        "fr-extract.jsonl": [
            {
                "entry_id": "741cbbb8-02b4-3df9-97eb-887c96c9863a",
                "word": "fabuleusement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "c9d6fe3a-6183-302d-bfe9-712f6ea068dd",
                        "entry_id": "741cbbb8-02b4-3df9-97eb-887c96c9863a",
                        "glosses": [
                            "D’une manière fabuleuse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7b39673-de72-4b94-a6de-b0d6af8cf450",
                                "sense_id": "c9d6fe3a-6183-302d-bfe9-712f6ea068dd",
                                "text": "Ce ramas énorme de fables expliquées fabuleusement et ce chaos de chimères […]"
                            },
                            {
                                "example_id": "82d0591d-5d1a-439d-b1df-6234f066ef29",
                                "sense_id": "c9d6fe3a-6183-302d-bfe9-712f6ea068dd",
                                "text": "… ; et, quand un poète en a joui, ses rêves viennent souvent lui en reconstruire fabuleusement les effets romantiques."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "345a0d77-bf1b-4b4e-a5f9-9088931ab866",
                        "source_entry_id": "741cbbb8-02b4-3df9-97eb-887c96c9863a",
                        "source_sense_id": "c9d6fe3a-6183-302d-bfe9-712f6ea068dd",
                        "target_lang_word": "fabulously",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fabulously",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0a6e99f6-e638-34e7-a704-002189f2fb38",
                                        "entry_id": "ad1c1d06-3ff6-3e6f-8b18-f7339c89f346",
                                        "glosses": [
                                            "In a fabulous manner.",
                                            "In a fashionable or glamorous manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "18a4afcd-4426-4564-abff-df1a9214b39c",
                                                "sense_id": "0a6e99f6-e638-34e7-a704-002189f2fb38",
                                                "text": "That girl is fabulously beautiful."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e825511a-36cc-3edb-8afe-386d50a751d5",
                                        "entry_id": "ad1c1d06-3ff6-3e6f-8b18-f7339c89f346",
                                        "glosses": [
                                            "In a fabulous manner.",
                                            "In an apocryphal or mythical manner; in fables."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b627e9ac-506c-4e7e-bff8-6f33aa4f5108",
                                                "sense_id": "e825511a-36cc-3edb-8afe-386d50a751d5",
                                                "text": "Burying its head in the sand is fabulously attributed to the ostrich."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "69469d8d-36df-4a7a-8551-2713626ed766",
                        "source_entry_id": "741cbbb8-02b4-3df9-97eb-887c96c9863a",
                        "source_sense_id": "c9d6fe3a-6183-302d-bfe9-712f6ea068dd",
                        "target_lang_word": "fantastically",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fantastically",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8f5cd992-b14e-38c1-8a26-eea597b51231",
                                        "entry_id": "4ebaf7a7-ca1e-3533-a9f0-72fe16baed93",
                                        "glosses": [
                                            "In a fantastic manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19da674d-ca56-4ced-8b87-2a698a01a294",
                                                "sense_id": "8f5cd992-b14e-38c1-8a26-eea597b51231",
                                                "text": "He painted fantastically with everything as if in a dream."
                                            },
                                            {
                                                "example_id": "94aa1268-9398-4504-81f4-baffb22d555b",
                                                "sense_id": "8f5cd992-b14e-38c1-8a26-eea597b51231",
                                                "text": "\"The Chengtu revolutionaries were fantastically colourful in the Szechwanese manner—they costumed themselves as heroes of the stage and their energies were chiefly occupied in tying ropes across the main streets so that when Imperial officials rode by in their litters they would have to get down and crawl under, losing face."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3207386e-5933-3ea7-87fb-b1f5a302d166",
                                        "entry_id": "4ebaf7a7-ca1e-3533-a9f0-72fe16baed93",
                                        "glosses": [
                                            "To an extent only in fantasy; outrageously; ridiculously."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f946b455-cbe3-4927-a60e-9aef87bc78f7",
                                                "sense_id": "3207386e-5933-3ea7-87fb-b1f5a302d166",
                                                "text": "The provinces of Liaoning, Heilongjiang and Jilin are fantastically cold in winter, indeed one of the major tourist attractions for the hardy is the display of ice-carved figures in public parks (especially in Haerbin, Heilongjiang province). The long winters have average temperatures between — 20°C and — 27°C, although the short summers are hot."
                                            },
                                            {
                                                "example_id": "aa219e9f-73b3-43b7-9945-f362fe30c77b",
                                                "sense_id": "3207386e-5933-3ea7-87fb-b1f5a302d166",
                                                "text": "He was fantastically wealthy."
                                            },
                                            {
                                                "example_id": "9e85a316-329c-44ea-8bfd-2d1c650c55b9",
                                                "sense_id": "3207386e-5933-3ea7-87fb-b1f5a302d166",
                                                "text": "One must be especially careful when using Google to determine frequency as there is a very real risk of fantastically overestimating the frequency and subsequent importance of a term."
                                            },
                                            {
                                                "example_id": "3eb390a2-13b7-45c2-8ef1-93f89088eaa9",
                                                "sense_id": "3207386e-5933-3ea7-87fb-b1f5a302d166",
                                                "text": "Every guest is appalled and fantastically humourless about the experience, even at this distance. You cannot help but wonder at cultural divides and how differently the British might have approached – or at least recalled – such events, at least in the early days. For us, surely, it would be a story for the ages. You could dine out on it for ever, so to speak."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
