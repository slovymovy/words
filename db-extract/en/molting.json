                                        "entry_id": "6f3370fc-60ff-374e-af66-98486be33558",
                                        "glosses": [
                                            "Grande cage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cfe7bf27-7f98-4b96-b1f0-2ffeb6384583",
                                                "sense_id": "32f7ed41-e36d-3c1f-9218-8c7d6c954cd5",
                                                "text": "Une mue de faucon."
                                            },
                                            {
                                                "example_id": "e2da0284-d82c-4160-a5d9-de6fe2182966",
                                                "sense_id": "32f7ed41-e36d-3c1f-9218-8c7d6c954cd5",
                                                "text": "Il ne faut pas laisser voler ces oiseaux, il faut les tenir dans la mue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "afabbd11-2d80-3606-ab42-a31f0c686cb1",
                                        "entry_id": "6f3370fc-60ff-374e-af66-98486be33558",
                                        "glosses": [
                                            "Lieu étroit et obscur, cage où l’on tient la volaille pour l’engraisser."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b2b53f5-ebec-41eb-b6f6-9dfb3912a0a6",
                                                "sense_id": "afabbd11-2d80-3606-ab42-a31f0c686cb1",
                                                "text": "Mettre des chapons en mue."
                                            }
                                        ]
                                    }
                                ]
                            },
