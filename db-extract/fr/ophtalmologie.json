                        "entry_id": "37eb87bf-239c-3815-a105-567fcef02e05",
                        "glosses": [
                            "Science qui s’occupe de l’anatomie, de la pathologie et de la thérapeutique de l’œil."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3fef6d77-c7fc-4b62-adcf-e6b2c96c6a5d",
                                "sense_id": "63e7003d-6019-384d-8449-4b29511a66da",
                                "text": "Plusieurs types d’appareils d’échographie sont utilisés : des appareils dédiés exclusivement à l’ophtalmologie et des appareils d’échographie générale."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0e06e36b-0434-42fa-83a9-f97380805dcd",
                        "source_entry_id": "37eb87bf-239c-3815-a105-567fcef02e05",
                        "source_sense_id": "63e7003d-6019-384d-8449-4b29511a66da",
