                        "glosses": [
                            "To run in front."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf6c6b4b-7fea-496f-822e-74c7204ca06f",
                                "sense_id": "7a26f374-f9a4-3829-bc47-a3676971ff57",
                                "text": "Bailey still sat, doubled over his book […] A finger forerunning his eyes along the page."
                            }
                        ]
                    },
                    {
                        "sense_id": "dfe010aa-6d60-3229-9c39-7fd50b059d67",
                        "entry_id": "a58ba5ee-9d1a-35e5-9858-a38547a96ff7",
                        "glosses": [
                            "To precede; to forecast or foreshadow."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8bee77f7-3fc5-4ab4-a4b5-d03ca285d845",
                                "sense_id": "dfe010aa-6d60-3229-9c39-7fd50b059d67",
                                "text": "These signs forerun the death or fall of kings."
                            },
                            {
                                "example_id": "1dfaad43-664c-4407-91c3-47a302238625",
                                "sense_id": "dfe010aa-6d60-3229-9c39-7fd50b059d67",
                                "text": "And in herself she moan’d, ‘Too late, too late!’ / Till in the cold wind that foreruns the morn, / A blot in heaven, the Raven, flying high, / Croak’d, […]"
                            },
                            {
                                "example_id": "c4d76f75-36ab-4d21-ad78-f913794b00c9",
                                "sense_id": "dfe010aa-6d60-3229-9c39-7fd50b059d67",
                                "text": "Discontent foreran the Two Mutinies, and more or less it lurkingly survived them."
                            }
                        ]
                    }
