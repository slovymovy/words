                                        "glosses": [
                                            "zur Malerei gehörend, in der Art und Weise der Malkunst"
                                        ],
                                        "tags": [
                                            "keine Steigerung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "009460b9-a8bc-4ac0-96db-8db3aeeba1aa",
                                                "sense_id": "9ac916ac-d593-3654-8337-0ad89091de02",
                                                "text": "Meine ersten malerischen Skizzen liegen Jahrzehnte zurück."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "86323f6b-dd05-3cdd-b03a-3dca471a98bd",
                                        "entry_id": "51599416-6f03-331f-a7bd-8408a7c21a5f",
                                        "glosses": [
                                            "schön; zum Malen geeignet, sich zum Malen anbietend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "255158a8-a6ed-4250-8cb1-68ccf0dbf4e5",
                                                "sense_id": "86323f6b-dd05-3cdd-b03a-3dca471a98bd",
                                                "text": "Das kleine Dörfchen liegt in einem malerischen Tal eingerahmt von bewaldeten Bergen."
                                            },
                                            {
                                                "example_id": "2556341a-8bb4-4283-90a5-c6219db3f881",
                                                "sense_id": "86323f6b-dd05-3cdd-b03a-3dca471a98bd",
                                                "text": "Das malerisch in einer Seitenschlucht des Schwarzachtales gelegene Schloss Grünsberg bei Altdorf bei Nürnberg (Kreis Nürnberger Land) in Mittelfranken wird in den nächsten Jahren für insgesamt mehr als zwei Millionen Euro renoviert."
                                            },
                                            {
                                                "example_id": "3a87bf07-c9d9-47c5-a341-0fbff1525227",
                                                "sense_id": "86323f6b-dd05-3cdd-b03a-3dca471a98bd",
                                                "text": "Preisgekrönte Strände, eine malerische Altstadt und jede Menge Kunst - damit lockt der Küstenort St Ives die Urlauber in die englische Grafschaft Cornwall."
                                            },
                                            {
                                                "example_id": "3b7b0218-465d-44a8-a345-7d2f783acf65",
                                                "sense_id": "86323f6b-dd05-3cdd-b03a-3dca471a98bd",
                                                "text": "Eindrucksvoll erheben sich die Mauern der Festung Königstein auf einem Tafelberg inmitten der malerischen Felslandschaft der Sächsischen Schweiz."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
