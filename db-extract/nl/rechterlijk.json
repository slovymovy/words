                ],
                "senses": [
                    {
                        "sense_id": "aead004f-d6ed-3dca-9c81-ac276ccb307e",
                        "entry_id": "0396639d-7c4c-383e-ad1e-2005c5197f03",
                        "glosses": [
                            "het recht betreffende"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "20391d31-939e-4029-a3f8-8f579638d64b",
                                "sense_id": "aead004f-d6ed-3dca-9c81-ac276ccb307e",
                                "text": "Als u niet wilt betalen zal ik rechterlijke stappen moeten ondernemen."
                            },
                            {
                                "example_id": "47db1415-7a65-424b-946f-c2f740a35615",
                                "sense_id": "aead004f-d6ed-3dca-9c81-ac276ccb307e",
                                "text": "De rechterlijke macht moet onafhankelijk zijn van de regering en de politie."
                            },
                            {
                                "example_id": "836e586c-b5a4-491a-9759-b6df11025bbb",
                                "sense_id": "aead004f-d6ed-3dca-9c81-ac276ccb307e",
                                "text": "Zelfs zwijgen hielp nu niet meer, want Poetins hongerige en corrupte oorlogsmachine begon de onaantastbaar geachte bedrijven van Ruslands bekendste CEO’s te verzwelgen. Onderzoekers van de London School of Economics telden 200 bedrijven die sinds het begin van de oorlog via rechterlijke machinaties van hun eigenaar zijn afgepakt."
                            }
                        ]
                    }
