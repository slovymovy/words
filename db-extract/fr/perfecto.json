                        "sense_id": "f63edd20-f427-3500-a2f3-de39f66b015f",
                        "entry_id": "184c1341-8640-3892-92cb-3029358fe915",
                        "glosses": [
                            "Blouson de cuir de cheval, noir, à fermeture éclair, doté de poches facilement accessibles et destinée, au départ, aux besoins des motards."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a61c580-9b4b-47d2-a39c-4756ac6ad5fb",
                                "sense_id": "f63edd20-f427-3500-a2f3-de39f66b015f",
                                "text": "En général, le jeune coq habite une achélème, circule en moto (en 4x4 dans Urgence), porte tee-shirt, santiags et perfecto."
                            },
                            {
                                "example_id": "6e9b359a-8996-42b8-96d3-f78bf45c66cd",
                                "sense_id": "f63edd20-f427-3500-a2f3-de39f66b015f",
                                "text": "Je tends le bras pour l’inviter à entrer en scène et le Renard s’avance dans la lumière, les mains dans les poches, avec son perfecto et son bandana."
                            }
                        ]
                    }
                ],
