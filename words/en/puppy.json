                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dog <w>puppied</w> late last night in the barn.",
                            "target_lang_translations": {
                                "ru": "Собака <w>ощенилась</w> поздно ночью в сарае.",
