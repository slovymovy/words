                                                "sense_id": "be9d6412-1882-318c-91e3-c3d14256b5ee",
                                                "text": "Sie war berühmt für ihre frivolen Chansons."
                                            },
                                            {
                                                "example_id": "50e0dc37-0f08-41d2-ad36-be1ab466739f",
                                                "sense_id": "be9d6412-1882-318c-91e3-c3d14256b5ee",
                                                "text": "„O, frivol ist mir am Abend“ (Titel einer Show, in Anspielung an das Lied „O, wie wohl ist mir am Abend“)"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "76ad1f9b-059e-30e0-b36b-2e7886de181b",
