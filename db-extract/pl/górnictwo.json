                    {
                        "translation_id": "af89db21-758f-4aee-847c-0715f441cbe9",
                        "source_entry_id": "b8a5a094-b4b5-34ee-8ab8-626cceb7c70b",
                        "source_sense_id": "e5148a0d-08e0-3301-a4b4-79a057303f4d",
                        "target_lang_word": "Bergbau",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bergbau",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "18a3f56b-97d4-3fbc-9e67-e4ff72d254c8",
                                        "entry_id": "500aaccf-588e-3a2e-be92-8d225102f028",
                                        "glosses": [
                                            "Gewinnung von mineralischen Rohstoffen aus einem Gesteinskörper der oberen Erdkruste"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3a89489-4bed-47da-ab03-09d0246c5376",
                                                "sense_id": "18a3f56b-97d4-3fbc-9e67-e4ff72d254c8",
                                                "text": "Der Bergbau geht um."
                                            },
                                            {
                                                "example_id": "75e63b7b-cc3b-4bf4-8e9e-9b4ae27645fb",
                                                "sense_id": "18a3f56b-97d4-3fbc-9e67-e4ff72d254c8",
                                                "text": "In Deutschland nimmt der Bergbau immer weiter ab."
                                            },
                                            {
                                                "example_id": "c2229a89-3059-42b6-971c-b8cea7dab566",
                                                "sense_id": "18a3f56b-97d4-3fbc-9e67-e4ff72d254c8",
                                                "text": "„Der Bergbau ist für die Shona Saisonarbeit: Nach Gold suchen sie nur in Zeiten, in denen ihre Felder und Herden sie nicht mehr so brauchen.“"
                                            },
                                            {
                                                "example_id": "6e2a88fd-162d-4c4f-8aaa-4fd93a3c0018",
                                                "sense_id": "18a3f56b-97d4-3fbc-9e67-e4ff72d254c8",
                                                "text": "„Assessor Henckels Untersuchung war mit dem größten Interesse aufgenommen worden, der Bergbau wurde allerdings dennoch nicht vorangetrieben – der Grund waren die Napoleonischen Kriege.“"
                                            },
                                            {
                                                "example_id": "d93a021d-34c5-4330-a4cb-4ca2afd3b5fc",
                                                "sense_id": "18a3f56b-97d4-3fbc-9e67-e4ff72d254c8",
                                                "text": "„Schon im 12. Jahrhundert setzte im Erzgebirge ein lebhafter Bergbau ein, der sich besonders um Freiberg, Annaberg, später auch Schneeberg und im Osterzgebirge um Altenberg (Zinn) entwickelte und zu der frühen Besiedlung des Gebirges beitrug.“"
                                            },
                                            {
                                                "example_id": "7fe1038a-b57c-42ab-b483-58c8425c1edf",
                                                "sense_id": "18a3f56b-97d4-3fbc-9e67-e4ff72d254c8",
                                                "text": "„Die Blütezeit des Bergbaus war aber schon vorbei, die Straße vernachlässigt und übersät mit Schlaglöchern.“"
                                            },
                                            {
                                                "example_id": "28e787e4-f373-46a9-adb2-c748a8556179",
                                                "sense_id": "18a3f56b-97d4-3fbc-9e67-e4ff72d254c8",
                                                "text": "„Seine Eltern waren Arbeiter und auch er begann, im Bergbau zu malochen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
