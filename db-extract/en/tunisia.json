                                            {
                                                "example_id": "0385aa44-231d-4561-82dd-b71b8fafef2d",
                                                "sense_id": "30948c76-a112-3206-aa7f-c0f2f7ee64f6",
                                                "text": "Voorlopig gaan we even niet met vakantie naar Tunesië!!!"
