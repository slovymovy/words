{
    "word_family": [
        "clunky"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1c21b90d-c418-3df4-8b3f-26ce89cff831",
                    "sense_definition": "A dull, heavy, metallic sound caused by two objects hitting each other.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heavy door closed with a loud <w>clunk</w>.",
                            "target_lang_translations": {
                                "cs": "Těžké dveře se zavřely s hlasitým <w>bouchnutím</w>."
                            }
                        },
                        {
                            "text": "I heard a <w>clunk</w> coming from the car engine.",
                            "target_lang_translations": {
                                "cs": "Slyšel jsem <w>klepání</w> vycházející z motoru auta."
                            }
                        }
                    ],
                    "synonyms": [
                        "thud",
                        "clatter"
                    ],
                    "common_phrases": [
                        "hear a clunk"
                    ],
                    "target_lang_definitions": {
                        "cs": "Tupý, těžký, kovový zvuk způsobený nárazem dvou předmětů o sebe."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "bouchnutí",
                                "target_lang_sense_clarification": "obecný výraz pro tupý náraz"
                            },
                            {
                                "target_lang_word": "klepnutí",
                                "target_lang_sense_clarification": "zvuk kovového rázu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8d210ddb-b0a1-3ecf-9603-70aa54763c94",
                    "sense_definition": "The sound of liquid pouring from a narrow-necked container.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The oil poured out of the can with a steady <w>clunk</w>.",
                            "target_lang_translations": {
                                "cs": "Olej vytékal z plechovky s pravidelným <w>žbluňkáním</w>."
                            }
                        },
                        {
                            "text": "The thick syrup made a <w>clunk</w> as it left the bottle.",
                            "target_lang_translations": {
                                "cs": "Hustý sirup při vytékání z láhve <w>žbluňkl</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "glug"
                    ],
                    "target_lang_definitions": {
                        "cs": "Zvuk tekutiny vytékající z nádoby s úzkým hrdlem."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "žbluňknutí",
                                "target_lang_sense_clarification": "zvuk tekutiny při vytékání"
                            },
                            {
                                "target_lang_word": "bublání",
                                "target_lang_sense_clarification": "zvuk při přerušovaném vytékání hustší tekutiny"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d8778041-373b-37a5-8851-e9c09bc82d56",
                    "sense_definition": "A foolish or stupid person.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Don't listen to that <w>clunk</w>.",
                            "target_lang_translations": {
                                "cs": "Neposlouchej toho <w>hlupáka</w>."
                            }
                        },
                        {
                            "text": "He acted like a total <w>clunk</w> during the meeting.",
                            "target_lang_translations": {
                                "cs": "Během schůzky se choval jako úplný <w>ťulpas</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "fool",
                        "idiot"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Informal and derogatory term for a person."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Hloupý nebo neohrabaný člověk."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "hlupák",
                                "target_lang_sense_clarification": "obecné označení pro někoho neinteligentního"
                            },
                            {
                                "target_lang_word": "ťulpas",
                                "target_lang_sense_clarification": "hovorové, mírně hanlivé označení"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d15655a7-6559-33b7-9285-77d7ddc9bf56",
                    "sense_definition": "To produce a dull, heavy, metallic sound.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old machine began to <w>clunk</w> as it started up.",
                            "target_lang_translations": {
                                "cs": "Starý stroj začal při spouštění <w>klepat</w>."
                            }
                        },
                        {
                            "text": "Her bicycle was <w>clunking</w> along the bumpy road.",
                            "target_lang_translations": {
                                "cs": "Její kolo na hrbolaté cestě <w>klepalo</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "thud"
                    ],
                    "common_phrases": [
                        "clunk along"
                    ],
                    "target_lang_definitions": {
                        "cs": "Vydávat tupý, těžký, kovový zvuk."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "klepat",
                                "target_lang_sense_clarification": "vydávat opakované kovové zvuky"
                            },
                            {
                                "target_lang_word": "bouchat",
                                "target_lang_sense_clarification": "vydávat těžké, dunivé zvuky"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}