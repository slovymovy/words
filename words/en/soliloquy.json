    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "04140fff-ec2d-30f0-afa6-357cd0528eeb",
                    "sense_definition": "A speech in a play in which a character speaks to themselves, revealing their inner thoughts to the audience.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "speech",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "At the end of the second act, the villain delivered a dramatic <w>soliloquy</w> detailing his plans."
                        },
                        {
                            "text": "Every student in the drama class was required to memorize Hamlet's famous <w>soliloquy</w>."
                        }
                    ],
                    "synonyms": [
                        "monologue"
                    ],
                    "antonyms": [
                        "dialogue",
                        "dialog",
                        "colloquy"
                    ],
                    "common_phrases": [
                        "dramatic soliloquy",
                        "deliver a soliloquy"
                    ]
                },
                {
                    "sense_id": "e2c6d848-ff56-3fb9-80db-1f03a1b774ca",
                    "sense_definition": "The act of talking to oneself, or a piece of writing reflecting such solitary thoughts.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "speech",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He paced around the empty room, lost in a quiet <w>soliloquy</w> about his regrets."
                        },
                        {
                            "text": "Her diary read more like an intense <w>soliloquy</w> than a simple record of events."
                        }
                    ],
                    "synonyms": [
                        "monologue"
                    ],
                    "antonyms": [
                        "dialogue",
                        "dialog",
                        "colloquy"
                    ],
                    "common_phrases": [
                        "muttered soliloquy",
                        "internal soliloquy"
                    ]
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4cf2e5c7-a1af-3906-99c6-574d9e86825c",
                    "sense_definition": "To speak one's thoughts aloud when by oneself.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "speech",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She watched the actor <w>soliloquy</w> center stage under a single spotlight."
                        },
                        {
                            "text": "Unaware of the listeners behind him, the old man began to <w>soliloquy</w> softly."
                        }
                    ],
                    "synonyms": [
                        "soliloquize"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used as a verb; soliloquize is preferred."
                        }
                    ]
                }
            ]
        }
    ]
