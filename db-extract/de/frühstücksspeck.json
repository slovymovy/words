                        "translation_id": "7af1d807-9dcb-44b1-9c00-d773bc30d24b",
                        "source_entry_id": "3755d8b1-d55d-3f91-9591-77602b45f8f7",
                        "source_sense_id": "a0888c70-d66b-3741-aac7-d1d85b11f966",
