                ],
                "senses": [
                    {
                        "sense_id": "1a632bb6-6dcb-3cf8-a6cc-dcab6be9ab72",
                        "entry_id": "3beb240b-1928-38af-8b46-2b13703a1e0b",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce03453b-7d2b-400a-8346-7ae2414b34b8",
                                "sense_id": "1a632bb6-6dcb-3cf8-a6cc-dcab6be9ab72",
                                "text": "Frau Gebard ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "be589ab8-9b04-4e08-9605-383eacaccf1f",
                                "sense_id": "1a632bb6-6dcb-3cf8-a6cc-dcab6be9ab72",
                                "text": "Herr Gebard wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "27da99fa-541a-4404-8bcd-e87389dda566",
                                "sense_id": "1a632bb6-6dcb-3cf8-a6cc-dcab6be9ab72",
                                "text": "Die Gebards fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "2044d877-17e2-48da-bee0-a23da4ad642f",
                                "sense_id": "1a632bb6-6dcb-3cf8-a6cc-dcab6be9ab72",
                                "text": "Der Gebard trägt nie die Schals, die die Gebard ihm strickt."
                            },
                            {
                                "example_id": "5e8e9032-6062-41c0-ae61-2a638bce938b",
                                "sense_id": "1a632bb6-6dcb-3cf8-a6cc-dcab6be9ab72",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Gebard kommt, geht der Herr Gebard.“"
                            },
                            {
                                "example_id": "447cc14f-07bd-4269-9028-18809ff469f4",
                                "sense_id": "1a632bb6-6dcb-3cf8-a6cc-dcab6be9ab72",
                                "text": "Gebard kommt und geht."
                            },
                            {
                                "example_id": "33dbedab-c6b8-46e9-a1f2-5125fc1399f7",
                                "sense_id": "1a632bb6-6dcb-3cf8-a6cc-dcab6be9ab72",
                                "text": "Gebards kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
