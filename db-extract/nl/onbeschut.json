                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0591d345-9a1c-4238-b5c8-14f97ac62fa5",
                                                "sense_id": "92964405-f66c-37af-bf41-e1dc07f0c390",
                                                "text": "The film was not exposed to sufficient light."
                                            },
                                            {
                                                "example_id": "19187632-afee-4bc0-b1fe-df38b42ca71d",
                                                "sense_id": "92964405-f66c-37af-bf41-e1dc07f0c390",
                                                "text": "Manganism has been known about since the 19th century, when miners exposed to ores containing manganese, a silvery metal, began to totter, slur their speech and behave like someone inebriated.[…]Nowadays workers are exposed to far lower doses and manganism is rare."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
