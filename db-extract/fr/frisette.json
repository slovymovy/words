        "fr-extract.jsonl": [
            {
                "entry_id": "33e9b28b-0e05-3616-9328-65b0bf92be8b",
                "word": "frisette",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "e59e06fd-0719-4f0b-a6bc-d90088e4b2ed",
                        "entry_id": "33e9b28b-0e05-3616-9328-65b0bf92be8b",
                        "tags": [
                            "plural"
                        ],
                        "form": "frisettes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "bc82a5c5-0445-3b22-b2c9-2b19da69bf57",
                        "entry_id": "33e9b28b-0e05-3616-9328-65b0bf92be8b",
                        "glosses": [
                            "Petite boucle de cheveux frisés."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e2c0e9e8-7052-4634-9ca9-4111525fcdca",
                                "sense_id": "bc82a5c5-0445-3b22-b2c9-2b19da69bf57",
                                "text": "Et puis c’était moi que ma mère aimait le mieux. Elle me disait : Viens, Berthe, que je te fasse des frisettes et que j’arrange bien tes cheveux."
                            },
                            {
                                "example_id": "c8c83566-c03d-4540-ad40-af6369f4f204",
                                "sense_id": "bc82a5c5-0445-3b22-b2c9-2b19da69bf57",
                                "text": "Plus d’une fille eût envié ses cheveux bruns et abondants, mais elle les disposait si simplement, sans bouffants ni frisettes, que la beauté de cette parure naturelle pouvait passer inaperçue."
                            },
                            {
                                "example_id": "67f739c2-a22e-4dd9-86f3-9e8fa45dc343",
                                "sense_id": "bc82a5c5-0445-3b22-b2c9-2b19da69bf57",
                                "text": "Mon bonnet tenait à peine sur toutes ces horribles frisettes."
                            },
                            {
                                "example_id": "53517ecb-b95b-4995-b77b-62df4e1da06d",
                                "sense_id": "bc82a5c5-0445-3b22-b2c9-2b19da69bf57",
                                "text": "Et voilà que sur le tard, devenu aussi laid et ridicule qu’il avait pu être mignon, des pardessus trop longs et une calvitie pâle et luisante couronnée de frisettes grasses, il épouse une veuve."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": [
                    {
