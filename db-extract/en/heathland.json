                    {
                        "translation_id": "bb8b53c3-546a-4b38-aef7-936eec407aff",
                        "source_entry_id": "349b93bc-6f92-3d47-9ede-4ad8b2fbcd88",
                        "source_sense_id": "fecb648c-ae5d-3c72-8f0d-2e08aa616c5c",
