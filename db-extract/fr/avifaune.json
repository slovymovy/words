        "fr-extract.jsonl": [
            {
                "entry_id": "cf85036d-445c-3717-bde9-0382151a6259",
                "word": "avifaune",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "3ae01d29-4e08-465c-a109-67b0ec05e3f1",
                        "entry_id": "cf85036d-445c-3717-bde9-0382151a6259",
                        "tags": [
