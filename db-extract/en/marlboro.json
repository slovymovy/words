                    {
                        "sense_id": "31168211-cc0d-38c0-ae4b-56c175ec7c17",
                        "entry_id": "6a23da2a-bc3c-3751-bca8-bb7c30a0479f",
                        "glosses": [
                            "A cigarette of the Marlboro brand."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f80acc3-9a71-4b3f-b4f7-4d156a3d4d16",
                                "sense_id": "31168211-cc0d-38c0-ae4b-56c175ec7c17",
                                "text": "Chalk up another frozen pizza\nChoke up another thousand Marlboros\nAnything goes for them ordinary Joes\nThey'll cut off your face to spite your nose"
                            },
                            {
                                "example_id": "90568d73-e961-442f-bd47-fe6ddbeaca76",
                                "sense_id": "31168211-cc0d-38c0-ae4b-56c175ec7c17",
                                "text": "Arthur took out the pack of Marlboros that he bought from them, and dropped it on the desk. \"This one is a fake, and a good fake.\" He started to show Alex the small boxes on the sides of the ripped pack."
                            },
                            {
                                "example_id": "128c3291-b930-42fa-b478-0403175193a5",
                                "sense_id": "31168211-cc0d-38c0-ae4b-56c175ec7c17",
                                "text": "Patricia Florca, wearing black market Levis and a dark blue, collarless shirt, snapped open a Ronson lighter and put flame to a black market Marlboro. Lidia Cozma looked enviously at the cigarette's glowing tip.\n\"Want one?\" Patricia whispered. Lidia nodded and Patricia offered the pack. Lidia removed a Marlboro, and moments later both women were sending exhaled smoke toward a cloudless sky."
                            }
                        ]
                    }
