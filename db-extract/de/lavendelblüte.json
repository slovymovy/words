                        "examples": [
                            {
                                "example_id": "7321f9b3-5877-4d5d-b5c7-bb3861d2a0e1",
                                "sense_id": "d886d4ce-08c7-328b-9de9-3297676cd3fc",
                                "text": "„Lächelnd rieb ich eine Lavendelblüte zwischen den Fingern, hielt sie mir unter die Nase und sog ihren Duft ein.“"
                            },
                            {
                                "example_id": "985f74ec-a44b-4c6b-9e7e-e76caa847b0e",
                                "sense_id": "d886d4ce-08c7-328b-9de9-3297676cd3fc",
                                "text": "„Wir würden die Hummeln dabei beobachten, wie sie von Lavendelblüte zu Lavendelblüte fliegen, und stundenlang reden.“"
                            }
                        ],
