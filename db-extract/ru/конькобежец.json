                                        "examples": [
                                            {
                                                "example_id": "502597c1-195f-48eb-995f-8f886dbd1575",
                                                "sense_id": "ba51de15-da36-3f3c-9eed-840405a3a302",
                                                "text": "Bij schaatsenrijders die deelnemen aan de molentocht gaat een kop snert er altijd wel in."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e55e091d-98df-3b12-908b-80b25312f793",
                                        "entry_id": "3536816d-f980-370c-b022-7b095620f1aa",
                                        "glosses": [
                                            "insect uit de familie Gerridae van de insecten en behorend tot de orde halfvleugeligen (Hemiptera) dat zich dank zij de oppervlaktespanning op het wateroppervlak kan voortbewegen"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "250efb46-5296-498f-88b0-535acdadc4d5",
                                                "sense_id": "e55e091d-98df-3b12-908b-80b25312f793",
                                                "text": "Schaatsenrijders leven van kleine diertjes die per ongeluk in het water terechtkomen."
                                            }
