                    },
                    {
                        "translation_id": "9815ba4f-7984-4d56-acd1-18a6e02cacaf",
                        "source_entry_id": "f781da98-705b-35e6-a64f-4269cacb3445",
                        "source_sense_id": "e41afbd9-1b31-33e1-8170-c3621adb2bfc",
                        "source_sense_description": "Gesamtwerk, Lebensleistung eines Menschen",
                        "target_lang_word": "grand œuvre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grand œuvre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f8f0dbb8-5ee7-3441-94de-c26c00e139da",
                                        "entry_id": "3ff036fc-0d9a-3ac0-a6fb-6f8d462b59b2",
                                        "glosses": [
                                            "Réalisation de la pierre philosophale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e77d7f54-084f-465b-9864-d8432d462eff",
                                                "sense_id": "f8f0dbb8-5ee7-3441-94de-c26c00e139da",
                                                "text": "Mais le but ultime de l’alchimie ne peut être obtenu que par le Grand-Œuvre, ou Grand Magistère, menant à la pierre rouge, c’est-à-dire la fameuse pierre philosophale, capable de transformer par simple contact les métaux en or."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "75cc54cd-4458-3cc8-ab22-b0ece0b970ff",
                                        "entry_id": "3ff036fc-0d9a-3ac0-a6fb-6f8d462b59b2",
                                        "glosses": [
                                            "Chef-d’œuvre, en particulier la meilleure œuvre d’un artiste, représentant l’accomplissement de sa vie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "671c28d2-dbfb-432b-a319-2b2329aa5fdc",
                                                "sense_id": "75cc54cd-4458-3cc8-ab22-b0ece0b970ff",
                                                "text": "La seconde partie du grand œuvre de Tocqueville, De la démocratie en Amérique (parue en 1840), est véritablement hantée par la question de la distinction et de l’excellence dans un pays occupé au travail commercial et industriel où la classe et la morale aristocratiques sont inexistantes."
                                            },
                                            {
                                                "example_id": "f3a373d5-61e1-48e0-b61e-9ae3b02fa893",
                                                "sense_id": "75cc54cd-4458-3cc8-ab22-b0ece0b970ff",
                                                "text": "Le musée parisien consacre une exposition à l’auteur du « Poème de l’âme », grand œuvre du peintre du XIXᵉ siècle, en dix-huit toiles et seize dessins accompagnés de 2 814 vers, fruit de plus de quatre décennies d’un travail très académique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "09a23eb4-a201-31ea-9846-694b49390e91",
                                        "entry_id": "3ff036fc-0d9a-3ac0-a6fb-6f8d462b59b2",
                                        "glosses": [
                                            "Action ou récit héroïque."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5239a868-ffce-48cc-bd3e-8e59b4428abb",
                                                "sense_id": "09a23eb4-a201-31ea-9846-694b49390e91",
                                                "text": "Il versa ce qui lui restait d’alcool dans le réchaud, et le grand œuvre commença."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
