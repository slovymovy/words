                    {
                        "sense_id": "c6791aa7-60cd-3cec-9cb1-ef55695db517",
                        "entry_id": "082982e7-b977-3e43-bfa3-a5b170528010",
                        "glosses": [
                            "A daughter colony formed inside a cell of a parent colony."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6890988c-c03a-49ac-a618-5fe3b3ca13e6",
                                "sense_id": "c6791aa7-60cd-3cec-9cb1-ef55695db517",
                                "text": "This may be because the formation of autocolonies within the mother cell wall is a considerable advance over the condition of free-lying spherical cells, and because along with the development of this autocolonial habit there has gone almost necessarily an axial differentiation of the individual cells."
                            },
                            {
                                "example_id": "73350a00-9f1c-4367-8846-2e14b25ad59c",
                                "sense_id": "c6791aa7-60cd-3cec-9cb1-ef55695db517",
                                "text": "This fact is of considerable interest as it shows how the autocolonies of certain of the Autosporaceæ may have arisen."
                            },
                            {
                                "example_id": "38b05510-36ad-417b-8b3b-5a5ef584165a",
                                "sense_id": "c6791aa7-60cd-3cec-9cb1-ef55695db517",
                                "text": "Autocolonies of 8 cells were occasional, and of 4 cells quite frequent."
                            }
                        ]
                    }
                ],
