                                "target_senses": [
                                    {
                                        "sense_id": "f2802d70-648c-37ae-b808-3df6e95fa20c",
                                        "entry_id": "e80064b1-8774-3a7a-b4bc-3a6670195d9f",
                                        "glosses": [
                                            "An expert in ergonomics."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30a2c593-b7ec-4d1f-8aab-5543f0a10e4e",
                                                "sense_id": "f2802d70-648c-37ae-b808-3df6e95fa20c",
                                                "text": "However, comfort was a key part of the selling point and David Lawrence, in his wonderful book British Rail Designed 1948-1997, explains how an ergonomist was hired to ensure the seats were comfortable. Nowadays, I suspect that if the ironing board seats on Thameslink Class 700s or on the Azumas are anything to go by, no ergonomist worthy of the name ever sat in those seats during their design phase."
                                            }
                                        ]
                                    }
                                ]
                            }
