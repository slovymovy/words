                    "frequency": "Middle",
                    "semantic_group_id": "direction_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het schip koerste <w>west</w> om de storm te ontwijken.",
                            "target_lang_translations": {
                                "en": "The ship headed <w>west</w> to avoid the storm.",
                                "ru": "Корабль взял курс на <w>запад</w>, чтобы избежать шторма.",
                                "pl": "Statek skierował się <w>na zachód</w>, aby uniknąć burzy.",
                                "de": "Das Schiff steuerte nach <w>Westen</w>, um dem Sturm auszuweichen.",
                                "fr": "Le navire a mis le cap <w>vers l'ouest</w> pour éviter la tempête.",
                                "it": "La nave fece rotta verso <w>ovest</w> per evitare la tempesta.",
                                "cs": "Loď zamířila <w>na západ</w>, aby se vyhnula bouři.",
                                "tr": "Gemi fırtınadan kaçınmak için <w>batıya</w> yöneldi.",
                                "es": "El barco navegó <w>hacia el oeste</w> para evitar la tormenta."
                            }
                        },
                        {
                            "text": "We rijden <w>west</w> totdat we de kust bereiken.",
                            "target_lang_translations": {
                                "en": "We drive <w>west</w> until we reach the coast.",
                                "ru": "Мы едем на <w>запад</w>, пока не достигнем побережья.",
                                "pl": "Jedziemy <w>na zachód</w>, aż dotrzemy do wybrzeża.",
                                "de": "Wir fahren nach <w>Westen</w>, bis wir die Küste erreichen.",
                                "fr": "Nous roulons <w>vers l'ouest</w> jusqu'à ce que nous atteignions la côte.",
                                "it": "Guidiamo verso <w>ovest</w> finché non raggiungiamo la costa.",
                                "cs": "Jedeme <w>na západ</w>, dokud nedorazíme k pobřeží.",
                                "tr": "Kıyıya ulaşana kadar <w>batıya</w> doğru sürüyoruz.",
                                "es": "Conducimos <w>hacia el oeste</w> hasta llegar a la costa."
                            }
