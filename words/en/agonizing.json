{
    "word_family": [
        "agony",
        "agonize"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "b95cdd93-43df-3d9f-9d35-9989ea724f98",
                    "sense_definition": "Causing extreme physical or mental pain.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "pain",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It was an <w>agonizing</w> twenty-minute wait for the results.",
                            "target_lang_translations": {
                                "de": "Es war ein <w>qualvolles</w> zwanzigminütiges Warten auf die Ergebnisse."
                            }
                        },
                        {
                            "text": "The athlete suffered an <w>agonizing</w> injury during the final match.",
                            "target_lang_translations": {
                                "de": "Der Athlet erlitt während des Finalspiels eine <w>qualvolle</w> Verletzung."
                            }
                        }
                    ],
                    "synonyms": [
                        "excruciating",
                        "painful",
                        "tormenting",
                        "torturous"
                    ],
                    "antonyms": [
                        "pleasant"
                    ],
                    "common_phrases": [
                        "agonizing wait",
                        "agonizing pain"
                    ],
                    "target_lang_definitions": {
                        "de": "Extreme körperliche oder seelische Schmerzen verursachend."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "qualvoll",
                                "target_lang_sense_clarification": "allgemein für Schmerz oder langes Warten"
                            },
                            {
                                "target_lang_word": "peinigend",
                                "target_lang_sense_clarification": "besonders bei seelischem Schmerz oder Druck"
                            },
                            {
                                "target_lang_word": "schmerzhaft",
                                "target_lang_sense_clarification": "allgemeiner Begriff für körperliche Verletzungen"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "82e0409b-b52e-3b7d-b39b-5f9336ee469f",
                    "sense_definition": "Present participle and gerund of <w>agonize</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "pain",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She spent the whole night <w>agonizing</w> over her difficult decision.",
                            "target_lang_translations": {
                                "de": "Sie verbrachte die ganze Nacht damit, sich wegen ihrer schwierigen Entscheidung zu <w>quälen</w>."
                            }
                        },
                        {
                            "text": "He is <w>agonizing</w> about whether to accept the new job offer.",
                            "target_lang_translations": {
                                "de": "Er <w>quält</w> sich mit der Frage, ob er das neue Jobangebot annehmen soll."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Sich intensiv mit einer schwierigen Entscheidung oder Sorge quälen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "sich quälen",
                                "target_lang_sense_clarification": "sich intensiv mit Gedanken oder Entscheidungen beschäftigen"
                            },
                            {
                                "target_lang_word": "grübeln",
                                "target_lang_sense_clarification": "intensives, oft belastendes Nachdenken"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5aca6505-8684-349d-b5e2-89da5f689c5a",
                    "sense_definition": "The act of experiencing intense mental struggle or worry.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "pain",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After years of internal <w>agonizings</w>, he finally found peace.",
                            "target_lang_translations": {
                                "de": "Nach Jahren innerer <w>Qualen</w> fand er endlich Frieden."
                            }
                        },
                        {
                            "text": "Her private <w>agonizings</w> were hidden behind a calm exterior.",
                            "target_lang_translations": {
                                "de": "Ihre privaten <w>Qualen</w> verbarg sie hinter einer ruhigen Fassade."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "This noun form is rarely used in modern English."
                        }
                    ],
                    "target_lang_definitions": {
