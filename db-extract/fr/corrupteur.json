                        ],
                        "form": "corrupteurs"
                    },
                    {
                        "form_id": "5c5d7146-6639-4eb7-9be5-85625bb7ef2a",
                        "entry_id": "965b41de-c27d-354a-8af3-f9ccf916551e",
                        "tags": [
                            "feminine"
                        ],
                        "form": "corruptrice"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4ed8b42c-d10d-3498-9b0b-8e9299377dbd",
                        "entry_id": "965b41de-c27d-354a-8af3-f9ccf916551e",
                        "glosses": [
                            "Celui qui corrompt quelque chose, notamment les mœurs, l’esprit, le langage ou le goût."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "9e09b900-8813-4b56-a400-1a1f57e62f27",
                                "sense_id": "4ed8b42c-d10d-3498-9b0b-8e9299377dbd",
                                "text": "Ma première condamnation est due aux Verdets, des hommes qui s’intitulaient alors pères de la foi, et qui n'étaient autres que ces hideux jésuites que le Parlement, en 1762, a traité de corrupteurs de la jeunesse."
                            },
                            {
                                "example_id": "c4278caa-d084-4fad-8777-bbe6875dd1e8",
                                "sense_id": "4ed8b42c-d10d-3498-9b0b-8e9299377dbd",
                                "text": "Ces écrivains furent les premiers corrupteurs du langage, du goût."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4ed67913-90fc-4b09-b2f4-dfe0b7f2f25b",
                        "source_entry_id": "965b41de-c27d-354a-8af3-f9ccf916551e",
                        "source_sense_id": "4ed8b42c-d10d-3498-9b0b-8e9299377dbd",
                        "target_lang_word": "corrupter",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "corrupter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4fb8e4d5-9c87-3126-911d-9b4ce5e3aacc",
                                        "entry_id": "a7025342-c11c-3f73-bb47-d739e4c9f616",
                                        "glosses": [
                                            "One who or that which corrupts."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4459b4e6-484d-4cf8-ab54-03d6225aaa2e",
                                                "sense_id": "4fb8e4d5-9c87-3126-911d-9b4ce5e3aacc",
                                                "text": "Can love, which always seeks the good of its object, attempt to betray a woman into a bargain where she is so greatly to be the loser? If such corrupter, therefore, should have the impudence to pretend a real affection for her, ought not the woman to regard him […] as the worst of all enemies […] ?"
                                            },
                                            {
                                                "example_id": "68836ebc-649a-43af-9caa-55f6c215c673",
                                                "sense_id": "4fb8e4d5-9c87-3126-911d-9b4ce5e3aacc",
                                                "text": "Since the 1980s, video games have widely been lambasted as a medium that is at best a waste of time and at worst a training ground for violence and aggression. Despite popularized media depictions of video games as corrupters of youth, to date, no study has definitively demonstrated any such link […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
