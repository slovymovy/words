                        "form_id": "3d10a5ff-14d1-492f-a72a-00bcbd240308",
                        "entry_id": "da21e957-9611-3645-8402-14bb83ed73b4",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "congoïdes"
