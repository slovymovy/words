                "senses": [
                    {
                        "sense_id": "988284bf-d5f2-3311-8127-a88cd880ecab",
                        "entry_id": "131eec7d-a202-332c-a2b2-e89ec0dff9d7",
                        "glosses": [
                            "Übertragung eines Textes aus einem Schriftsystem in ein anderes, und zwar so, dass die Schriftzeichen in beiden Richtungen eindeutig einander zugeordnet werden können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e55acb4-0ecd-4981-b38d-f485e1f56082",
                                "sense_id": "988284bf-d5f2-3311-8127-a88cd880ecab",
                                "text": "Transliteration liegt z. B. dann vor, wenn man einen Text, der in griechischer Schrift vorliegt, in die lateinische Schrift überträgt."
                            },
                            {
                                "example_id": "cee8d8c0-163f-4cb8-8c07-75b3670401c3",
                                "sense_id": "988284bf-d5f2-3311-8127-a88cd880ecab",
                                "text": "Kennst du dich mit bulgarischer Transliteration aus?"
                            },
                            {
                                "example_id": "3005dbe6-c479-4d78-a795-a8a8d40feb14",
                                "sense_id": "988284bf-d5f2-3311-8127-a88cd880ecab",
                                "text": "„Ein anderer Grund, der gegen eine Transliteration der japanischen Schrift spricht, ist die große Zahl der Homophone.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7bd156c5-a22e-48b9-bbf6-1c4b18f59e32",
                        "source_entry_id": "131eec7d-a202-332c-a2b2-e89ec0dff9d7",
                        "source_sense_id": "988284bf-d5f2-3311-8127-a88cd880ecab",
                        "source_sense_description": "Linguistik: buchstabengetreue Übertragung eines Textes aus einem Schriftsystem in ein anderes",
                        "target_lang_word": "translittération",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "translittération",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0743a003-0cc8-3a01-9459-fec4b64346be",
                                        "entry_id": "d689832e-8338-3da4-a458-be3abd429e2a",
                                        "glosses": [
                                            "Opération consistant à substituer à chaque graphème d’un système d’écriture un graphème ou un groupe de graphèmes d’un autre, et ce indépendamment de la prononciation, biunivoquement ou non."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57a43e93-cc60-4d4b-8cee-e2ca3cb52074",
                                                "sense_id": "0743a003-0cc8-3a01-9459-fec4b64346be",
                                                "text": "On peut donner un exemple simple de la différence entre translittération et transcription : soit le nom de famille Горбачёв ; celui-ci devra être translittéré Gorbačëv selon la norme ISO 9, mais pourra être transcrit Gorbatchof, Gorbachof ou encore Gorbatschow, selon une équivalence phonétique approximative en tenant compte des usages de la langue cible, ici respectivement le français, l’anglais et l’allemand)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8114caff-cb0d-37b4-83f4-f849458931ef",
                                        "entry_id": "d689832e-8338-3da4-a458-be3abd429e2a",
                                        "glosses": [
                                            "Résultat de cette opération sur une lettre, un mot ou un texte."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
