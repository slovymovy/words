                ],
                "senses": [
                    {
                        "sense_id": "37e02afc-1f60-399b-8fa5-d6959aa8b443",
                        "entry_id": "944da048-9094-3873-8bab-f1348448900e",
                        "glosses": [
                            "eine Wurzel eines Wortes oder einen Wortstamm mit einem Affix versehen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a2578e8-7bff-4dda-8d44-d233098e371c",
                                "sense_id": "37e02afc-1f60-399b-8fa5-d6959aa8b443",
                                "text": "Affigierte und nicht-affigierte Ableitungen weisen bei belonen und berufnen syntaktisch unterschiedlichen Gebrauch auf: …"
                            },
                            {
                                "example_id": "91c29a83-479a-4bf4-9fb1-3e73fff2a422",
                                "sense_id": "37e02afc-1f60-399b-8fa5-d6959aa8b443",
                                "text": "Das nicht-affigierte Derivat lonen ist nur in intransivitem Gebrauch korpusintern bezeugt (…)."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "de85affd-b1ec-3369-8d77-e108901a88e5",
                        "entry_id": "944da048-9094-3873-8bab-f1348448900e",
                        "glosses": [
                            "eine Affiche ausgehängt, angeschlagen, angenagelt"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "c8c36a65-efe0-4953-8c8d-2b421d73779c",
                                "sense_id": "de85affd-b1ec-3369-8d77-e108901a88e5",
                                "text": "Das vom Beklagten am 5. Oktober 1901 in den Straßen Wiens affigierte Plakat: »Die Fackel ist tot« etc. fällt zwar nicht direkt unter die Sanktion des § 22 U. R. G., aber es ist ein Vorbereitungsakt zu der in der fraglichen Gesetzesstelle bezeichneten rechtswidrigen Handlung, welcher dieselbe wirksam zu machen und die Irreführung des Publikums über die Identität der Werke zu befördern geeignet ist."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
