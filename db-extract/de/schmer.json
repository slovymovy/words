                "senses": [
                    {
                        "sense_id": "c48151ea-bcfe-3cad-bfe0-cb79643e8312",
                        "entry_id": "8bcf430d-6c52-30a0-b91b-ba9ac76ba609",
                        "glosses": [
                            "Fett, insbesondere das Bauchfett vom Schwein"
                        ],
                        "tags": [
                            "mundartlich"
                        ],
                        "examples": [
                            {
                                "example_id": "dab1b0bd-e45e-4ee3-b5aa-f4b562e2ade7",
                                "sense_id": "c48151ea-bcfe-3cad-bfe0-cb79643e8312",
                                "text": "Zuviel Schmer essen ist nicht gesund."
                            },
                            {
                                "example_id": "5ec41d44-4623-49ce-8838-43abe86a9c07",
                                "sense_id": "c48151ea-bcfe-3cad-bfe0-cb79643e8312",
                                "text": "„Schmer ist das Fettgewebe der Schweine in der Bauchhöhle (auch Filz oder Bauchfilz genannt), in der Nähe der Rippen und der Nieren.“"
                            },
                            {
                                "example_id": "587afa3e-c01c-4260-8125-e37fe73e5910",
                                "sense_id": "c48151ea-bcfe-3cad-bfe0-cb79643e8312",
                                "text": "„Ihm folgt der Fettgeruch, der mit Schmer und Schweinegrieben seinen Einzug hält.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
