                                "target_senses": [
                                    {
                                        "sense_id": "d5231fb6-3c10-3062-9f8d-8d9089fd5bae",
                                        "entry_id": "6781efdf-49b4-3c02-ab0e-85e5d16c191a",
                                        "glosses": [
                                            "die Baath-Partei und deren Ideologie betreffend, zu ihr gehörend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "082120e9-e104-4d2e-91bc-d23465a2ee6d",
                                                "sense_id": "d5231fb6-3c10-3062-9f8d-8d9089fd5bae",
                                                "text": "„Zu den zahlreichen Instrumenten, die Bagdad dabei zur Verfügung standen, gehörten verschiedene nominell palästinensische Splittergruppen wie Abu Nidals terroristisches Netzwerk, die baathistische Arabische Befreiungsfront und die Palästinensische Befreiungsfront (PFL), die von Abu Abbas angeführt wurde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c6efab90-9463-45b4-ab0b-577bd38fd063",
                        "source_entry_id": "a6ec9144-3e1d-3749-bb44-66d9f8c20403",
                        "source_sense_id": "b1b63914-b6e0-3ae6-a7e1-26d1ecb83e18",
                        "target_lang_word": "Baathist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Baathist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "12620568-d795-33fb-b510-a3b0d159315c",
                                        "entry_id": "a71ec538-80c8-34e8-b313-d857f2e9ccb8",
                                        "glosses": [
                                            "Of or pertaining to Baathism or the Baath Party."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Baathist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2a78ab1c-39fb-3c2d-a782-72dfcbc635a9",
                                        "entry_id": "4619ba3e-caf0-3c65-911e-72edfe94321b",
                                        "glosses": [
                                            "A supporter of Baathism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1bb825d-7ae4-440c-9652-3e1634089a3a",
                                                "sense_id": "2a78ab1c-39fb-3c2d-a782-72dfcbc635a9",
                                                "text": "Another Baathist, former Jordan Foreign Minister Abdullah Rimawi, is plowing a lonely furrow, and no one seems to want to follow him."
                                            },
                                            {
                                                "example_id": "3360ea60-6004-45b3-9895-0ac292666aab",
                                                "sense_id": "2a78ab1c-39fb-3c2d-a782-72dfcbc635a9",
                                                "text": "Also, in March 1963, the Syrian Baathists were able to seize power in a coup that toppled the 'separatists'."
                                            },
                                            {
                                                "example_id": "37b2244c-4f53-478f-b231-9734c5182458",
                                                "sense_id": "2a78ab1c-39fb-3c2d-a782-72dfcbc635a9",
                                                "text": "The Baathists were more ideologically motivated and believed that the Army should be made subservient to the Party, as they were aware that the military been the primaryforcebehind every regime change in Iraq since 1936."
                                            },
                                            {
                                                "example_id": "ff17c36c-2441-4adc-a5de-162ea3e5264b",
                                                "sense_id": "2a78ab1c-39fb-3c2d-a782-72dfcbc635a9",
                                                "text": "The second insurgency has been led by the ideological Baathists, or Saddam Hussein's loyalists and jihadi Salafis."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
