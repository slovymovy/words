                    "sense_definition": "jasność, blask emitowany przez źródło światła, często o charakterze podniosłym lub religijnym",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "światło",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nagle w ciemnym pokoju pojawiła się niezwykła <w>światłość</w>, która przestraszyła wędrowca.",
                            "target_lang_translations": {
                                "en": "Suddenly an unusual <w>radiance</w> appeared in the dark room, which frightened the wanderer."
                            }
                        },
                        {
                            "text": "Poranna <w>światłość</w> powoli rozpraszała gęstą mgłę unoszącą się nad jeziorem.",
                            "target_lang_translations": {
                                "en": "The morning <w>light</w> slowly dispersed the dense fog hovering over the lake."
                            }
                        }
                    ],
                    "synonyms": [
                        "blask",
                        "jasność",
                        "światło"
                    ],
                    "antonyms": [
                        "ciemność",
                        "mrok"
                    ],
                    "common_phrases": [
                        "wiekopomna światłość",
                        "jasna światłość"
                    ],
                    "target_lang_definitions": {
                        "en": "brightness or radiance emitted by a light source, often with an elevated, poetic, or religious connotation"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "light",
                                "target_lang_sense_clarification": "elevated, radiant, or spiritual light"
                            },
                            {
                                "target_lang_word": "radiance",
                                "target_lang_sense_clarification": "glowing or dazzling brightness"
                            },
                            {
                                "target_lang_word": "brightness",
                                "target_lang_sense_clarification": "quality of being bright or luminous"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dcf31703-3db6-366e-bffb-124ff728a59d",
                    "sense_definition": "cecha człowieka światłego, mądrego i wykształconego; otwartość umysłu i inteligencja",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mądrość",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Profesor imponował wszystkim swoją niezwykłą wiedzą oraz <w>światłością</w> umysłu.",
                            "target_lang_translations": {
                                "en": "The professor impressed everyone with his extraordinary knowledge and <w>brightness</w> of mind."
                            }
                        },
                        {
                            "text": "W trudnych czasach potrzebujemy liderów odznaczających się wielką <w>światłością</w> i rozwagą.",
                            "target_lang_translations": {
                                "en": "In difficult times, we need leaders distinguished by great <w>enlightenment</w> and prudence."
                            }
                        }
                    ],
                    "synonyms": [
                        "mądrość",
                        "oświecenie",
                        "rozsądek"
                    ],
                    "antonyms": [
                        "ciemnota",
                        "zacofanie"
                    ],
                    "common_phrases": [
                        "światłość umysłu"
                    ],
                    "target_lang_definitions": {
                        "en": "the quality of being enlightened, wise, and educated; open-mindedness and intellectual brilliance"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "enlightenment",
