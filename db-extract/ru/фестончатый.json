                ],
                "senses": [
                    {
                        "sense_id": "fb59f8de-b7f2-38b2-b7a3-7311fd5ef4cd",
                        "entry_id": "52f31dc5-4fd3-339c-ae02-1d5a9c2a7d9c",
                        "glosses": [
                            "имеющий фестоны; с фестонами"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4374ea1d-e084-4d5b-ab2c-6d266d477af7",
                                "sense_id": "fb59f8de-b7f2-38b2-b7a3-7311fd5ef4cd",
                                "text": "С одного бока шкатулки словно фестончатые зелёные кружева, а с другого — рисунок отливает шёлком, будто вышит гладью."
                            },
                            {
                                "example_id": "d619283c-8046-4c8d-a139-4c78f8f2fe94",
                                "sense_id": "fb59f8de-b7f2-38b2-b7a3-7311fd5ef4cd",
                                "text": "Фестончатый шов более ажурный, а потому используют его при декоративных работах, располагая по краю накладной детали при присоединении её к основе."
                            }
                        ]
                    }
