                    "sense_id": "361c705d-e5ac-3d53-b9e2-1e4891c4b0f4",
                    "sense_definition": "Een plotselinge verandering van de bewegingsrichting.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Met een snelle <w>zwenk</w> ontweek de fietser de plotseling overstekende hond.",
                            "target_lang_translations": {
                                "en": "With a quick <w>swerve</w>, the cyclist avoided the dog that suddenly crossed the road."
                            }
                        },
                        {
                            "text": "De auto maakte een plotselinge <w>zwenk</w> naar links om een botsing te voorkomen.",
                            "target_lang_translations": {
                                "en": "The car made a sudden <w>swerve</w> to the left to avoid a collision."
                            }
                        }
                    ],
                    "synonyms": [
                        "zwaai",
                        "bocht",
                        "draai"
                    ],
                    "common_phrases": [
                        "plotselinge zwenk",
                        "een zwenk maken"
                    ],
                    "target_lang_definitions": {
                        "en": "A sudden change in direction of movement."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "swerve",
