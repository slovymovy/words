                "senses": [
                    {
                        "sense_id": "3212eb64-7494-3d16-af1d-4e7a4f09c2e6",
                        "entry_id": "c12ba2e1-72b6-38c1-b2ae-6e3fb3cda94b",
                        "glosses": [
                            "anerkannter Ingenieur, der sich mit der Strömungs- und Lüftungstechnik auskennt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1223b83c-e325-4d6c-a4de-76482e8a694d",
                                "sense_id": "3212eb64-7494-3d16-af1d-4e7a4f09c2e6",
                                "text": "„In der Salzmine sind auch Bergbau-GEOLOGEN tätig und die Luft zum Atmen bei der schweren Arbeit verdanken die Bergleute dem LÜFTUNGSINGENIEUR.“"
                            },
                            {
                                "example_id": "43717eb2-58f1-4c51-9b96-83c2a32d3f52",
                                "sense_id": "3212eb64-7494-3d16-af1d-4e7a4f09c2e6",
                                "text": "„Über Lüftungsaspekte soll ein Lüftungsingenieur instruieren, über die Dekontamination bei Prionenarbeiten eine die sich darin auskennt und über Laborbrände jemand der die Thematik als Profi kennt.“"
                            },
                            {
                                "example_id": "4acdf7af-b49b-486e-a7dd-54e25ad22002",
                                "sense_id": "3212eb64-7494-3d16-af1d-4e7a4f09c2e6",
                                "text": "„Namensgeber und Gründer des Unternehmens ist der Lüftungsingenieur und diplomierter Strömungstechniker Josef Mollerus.“"
                            },
                            {
                                "example_id": "eb2704b5-48a7-4dce-8957-e7f83ac245b2",
                                "sense_id": "3212eb64-7494-3d16-af1d-4e7a4f09c2e6",
                                "text": "„In Zusammenarbeit mit dem Lüftungsingenieur wurde ein entsprechender Algorithmus entwickelt und implementiert.“"
                            },
                            {
                                "example_id": "9c18c1eb-84ab-49e8-a848-b2eeee57a806",
                                "sense_id": "3212eb64-7494-3d16-af1d-4e7a4f09c2e6",
                                "text": "„Sowohl der Projektleiter einer neuen Gasturbine als auch der Lüftungsingenieur eines neuen Parkhauses brauchen CFD-Berechnungen; die Genauigkeitsanforderungen als auch das zur Verfügung stehende Budget sind jedoch zuweilen gänzlich verschieden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
