                "senses": [
                    {
                        "sense_id": "04a3c199-90a5-36cc-ad60-f8213ff5fdd3",
                        "entry_id": "29c54d88-7591-36a5-bdc9-26be9f1f01fb",
                        "glosses": [
                            "Placer un véhicule sur les rails sur lesquels il doit circuler."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f45dc289-6fcf-4778-b5b4-8cd8deaeed9a",
                                "sense_id": "04a3c199-90a5-36cc-ad60-f8213ff5fdd3",
                                "text": "Quelques Compagnies établissent en dehors des ponts, des planchers en bois et des plans inclinés destinés à enrailler les wagons déraillés."
                            },
                            {
                                "example_id": "30ac5a29-93c5-4c46-9f6b-5b24c753ab18",
                                "sense_id": "04a3c199-90a5-36cc-ad60-f8213ff5fdd3",
                                "text": "Le sabot-cale ne sert pas à « remettre les véhicules sur rail » (enrailler) ; dans certaines circonstances il peut, au contraire, en provoquer le déraillement."
                            }
                        ]
                    }
