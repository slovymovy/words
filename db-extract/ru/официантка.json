                "senses": [
                    {
                        "sense_id": "78a1eda7-bf91-3043-b4f0-4db8a1be0f34",
                        "entry_id": "f3353c40-688f-3337-8dfb-bafbb7805700",
                        "glosses": [
                            "женск. к официант"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ebd40d29-01f6-42ee-92cf-a5936997e0e9",
                                "sense_id": "78a1eda7-bf91-3043-b4f0-4db8a1be0f34",
                                "text": "Но уйти было невозможно, потому что подошла официантка с заказом."
                            },
                            {
                                "example_id": "86026f58-7910-499a-ba4c-b6f21b1553fa",
                                "sense_id": "78a1eda7-bf91-3043-b4f0-4db8a1be0f34",
                                "text": "Хочет без конца задавать мне вопрос: «Как то, о чём я просил?»… Официантка приняла заказ. Мы закурили, и я поинтересовался..."
                            }
                        ]
                    }
                ],
