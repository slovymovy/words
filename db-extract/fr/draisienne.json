        "fr-extract.jsonl": [
            {
                "entry_id": "eb6c816c-96d5-3b15-b1a6-75c38bfa634a",
                "word": "draisienne",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "95c56289-aad8-4555-b965-2c5db0840226",
                        "entry_id": "eb6c816c-96d5-3b15-b1a6-75c38bfa634a",
                        "tags": [
                            "plural"
                        ],
                        "form": "draisiennes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e0df1d94-13cd-3dcd-8f1b-0b2425870b7b",
                        "entry_id": "eb6c816c-96d5-3b15-b1a6-75c38bfa634a",
                        "glosses": [
                            "Véhicule à deux roues alignées que l’on fait avancer en poussant sur le sol avec ses pieds."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10fc3633-c11c-4080-bd41-a22338357b0a",
                                "sense_id": "e0df1d94-13cd-3dcd-8f1b-0b2425870b7b",
                                "text": "Et la draisienne, objet excentrique et ridicule, s’inscrira socialement comme une amusante machine dandy, une mode d’un instant aristocratique."
                            }
                        ]
                    },
                    {
                        "sense_id": "d1994221-a58a-3c91-b7a7-87cf41c76d53",
                        "entry_id": "eb6c816c-96d5-3b15-b1a6-75c38bfa634a",
                        "glosses": [
                            "Sorte de véhicule électrique"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "574efdeb-4a68-4a1e-aff8-e513c819ab82",
                                "sense_id": "d1994221-a58a-3c91-b7a7-87cf41c76d53",
                                "text": "jusqu'à récemment, la draisienne électrique ne bénéficiait d'aucun cadre légal (...) les cyclomobiles légers"
                            },
                            {
                                "example_id": "fb1f077f-095e-4a58-8fb5-0f3559697dc8",
                                "sense_id": "d1994221-a58a-3c91-b7a7-87cf41c76d53",
                                "text": "Ces draisiennes, leur nom d'origine, sont un mélange de trottinette, vélo et cyclo. Il y a un siège, pas de pédalier et pour avancer, il faut actionner la poignée d'accélérateur. A cyclomobile, le législateur a précisé \"léger\". Leur puissance est limitée à 350 watts, leur vitesse à 25 km/h et le poids à vide est de 30 kilos maximum."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "14d8d8ec-c483-473d-b8a2-71fbac1a2d6d",
                        "source_entry_id": "eb6c816c-96d5-3b15-b1a6-75c38bfa634a",
                        "source_sense_id": "e0df1d94-13cd-3dcd-8f1b-0b2425870b7b",
                        "source_sense_description": "Véhicule à deux roues",
                        "target_lang_word": "Draisine",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Draisine",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "286dda1b-c18d-3c5a-8e2b-764257018e18",
                                        "entry_id": "ca71be72-8b79-31e8-84e1-48c445e204f2",
                                        "glosses": [
                                            "im Jahr 1817 von dem badischen Forstmeister Karl von Drais erfundenes, zweirädriges Laufrad"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c40740a-8776-45a5-8fa6-26bbfa9b06b1",
                                                "sense_id": "286dda1b-c18d-3c5a-8e2b-764257018e18",
                                                "text": "Die Draisine ist der direkte Vorläufer des Fahrrades."
                                            },
                                            {
                                                "example_id": "7a3de347-bb57-40c8-9301-94a07c0f5d8d",
                                                "sense_id": "286dda1b-c18d-3c5a-8e2b-764257018e18",
                                                "text": "Die Draisine wird fälschlicherweise oft als „Dräsine“ geschrieben."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8efd94af-b74f-36cc-87fd-63446431abe2",
                                        "entry_id": "ca71be72-8b79-31e8-84e1-48c445e204f2",
                                        "glosses": [
                                            "kleines, mindestens dreirädriges Schienenfahrzeug der Bahn, das für Dienstfahrten und Streckenkontrollen des Schienennetzes genutzt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb08fb96-1fd5-48aa-b3d8-bcaf1c47ac03",
                                                "sense_id": "8efd94af-b74f-36cc-87fd-63446431abe2",
                                                "text": "„Ein bekannter Kleinganove aus der Gegend war vor ein paar Stunden an Tengroths Ackerland vorbeigefahren, auf dem stillgelegten Gleis zwischen Byringe und Åkers Styckebruk, und zwar auf einer Draisine.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "72392256-2ab2-4526-8859-5e7aa5082a85",
                        "source_entry_id": "eb6c816c-96d5-3b15-b1a6-75c38bfa634a",
                        "source_sense_id": "e0df1d94-13cd-3dcd-8f1b-0b2425870b7b",
