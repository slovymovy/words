                "senses": [
                    {
                        "sense_id": "59667cb3-7ebc-3cd7-afb8-a41fa67d30a5",
                        "entry_id": "4d33cc4e-41c4-3455-a97f-d69ac49cee60",
                        "glosses": [
                            "to lend (to allow to be used temporarily)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e03ae648-14e7-419a-a62b-f36adec2a422",
                                "sense_id": "59667cb3-7ebc-3cd7-afb8-a41fa67d30a5",
                                "text": "Мари́на никогда́ не ода́лживает де́ньги незнако́мым лю́дям.",
                                "translation": "Marina never lends money to strangers.",
                                "english": "Marina never lends money to strangers."
                            }
                        ]
                    },
                    {
                        "sense_id": "55329f06-3d61-3a9c-afc6-b8cb077d47d8",
                        "entry_id": "4d33cc4e-41c4-3455-a97f-d69ac49cee60",
                        "glosses": [
                            "to borrow (to receive (something) temporarily)"
                        ],
                        "tags": [
                            "proscribed"
                        ],
                        "examples": [
                            {
                                "example_id": "9799217e-f8d2-4865-b3cf-8302b0caf4a6",
                                "sense_id": "55329f06-3d61-3a9c-afc6-b8cb077d47d8",
                                "text": "Он иногда́ ода́лживал у друзе́й у́дочку, когда́ хоте́л отдохну́ть на приро́де.",
                                "translation": "He sometimes borrowed a fishing rod from friends when he wanted to relax outdoors.",
                                "english": "He sometimes borrowed a fishing rod from friends when he wanted to relax outdoors."
                            }
                        ]
                    }
                ],
