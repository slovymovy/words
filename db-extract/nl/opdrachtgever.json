                "senses": [
                    {
                        "sense_id": "2d17c43c-b099-3a5a-8254-f2d5f93f303c",
                        "entry_id": "596dbcf6-5ed1-3671-b7bb-cfaab61e0fce",
                        "glosses": [
                            "iemand die opdrachten geeft; iemand die een bestelling doet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2595f35a-94c0-4c66-86db-1bd5aa02f7cc",
                                "sense_id": "2d17c43c-b099-3a5a-8254-f2d5f93f303c",
                                "text": "Mijn opdrachtgever verwacht onmogelijke dingen van mij."
                            },
                            {
                                "example_id": "4dc4d7f4-f076-47da-8596-eb850c4a433f",
                                "sense_id": "2d17c43c-b099-3a5a-8254-f2d5f93f303c",
                                "text": "Dat ze nu in onderhandeling waren met het ministerie en de overheid kon misschien vreemd overkomen aangezien de stad Stockholm de eigenlijke opdrachtgever was."
                            },
                            {
                                "example_id": "ba2b1f01-2efe-4c82-9e58-772dfd038190",
                                "sense_id": "2d17c43c-b099-3a5a-8254-f2d5f93f303c",
                                "text": "Jamaloodin en Dos Santos werden genoemd door een groot aantal getuigen in de zaak tegen Burney 'Nini' Fonseca, de man die de schakel vormde tussen opdrachtgevers en uitvoerders van de moord. Het Openbaar Ministerie liet in de zaak-Fonseca in het midden of Dos Santos financierder was of opdrachtgever om Wiels te liquideren."
                            }
                        ]
                    }
