            "senses": [
                {
                    "sense_id": "747efbe2-1ba8-3654-9a50-e93591351bc6",
                    "sense_definition": "The body of a dead animal.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "dead_body",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The forest was covered in a decaying <w>carcass</w>.",
                            "target_lang_translations": {
                                "pl": "Las był pokryty rozkładającym się <w>ścierwem</w>."
                            }
                        },
                        {
                            "text": "Vultures circled above the animal <w>carcass</w> in the field.",
                            "target_lang_translations": {
                                "pl": "Sępy krążyły nad <w>padliną</w> na polu."
                            }
                        }
                    ],
                    "synonyms": [
                        "corpse"
                    ],
                    "common_phrases": [
                        "animal carcass"
                    ],
                    "target_lang_definitions": {
                        "pl": "Martwe, rozkładające się ciało zwierzęcia."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "ścierwo",
                                "target_lang_sense_clarification": "martwe, rozkładające się ciało zwierzęcia"
                            },
                            {
                                "target_lang_word": "padlina",
                                "target_lang_sense_clarification": "ciało martwego zwierzęcia"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "75e57c7c-af80-33b6-b786-feb317557aa9",
                    "sense_definition": "The body of a dead human.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "dead_body",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The detective examined the human <w>carcass</w> found in the alley.",
                            "target_lang_translations": {
                                "pl": "Detektyw zbadał <w>zwłoki</w> znalezione w alejce."
                            }
                        },
                        {
                            "text": "He was horrified to discover a <w>carcass</w> while exploring the cave.",
                            "target_lang_translations": {
                                "pl": "Był przerażony, odkrywając <w>trupa</w> podczas eksploracji jaskini."
                            }
