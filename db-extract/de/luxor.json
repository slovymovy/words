                                "sense_id": "bdf0cad1-6c68-33f0-867a-35fd46d3ab16",
                                "text": "„Auf dem Weg zurück nach Luxor ankert das Schiff am Pier von Esna, einer Stadt wie aus 1001 Nacht.“"
                            },
                            {
                                "example_id": "7fdd04d3-30a6-4159-97ff-747c3812be72",
                                "sense_id": "bdf0cad1-6c68-33f0-867a-35fd46d3ab16",
                                "text": "„Der Fluss strömte dadurch sanfter und besaß nicht mehr die Kraft, um im Tal von Luxor ständig sein Bett zu verändern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
