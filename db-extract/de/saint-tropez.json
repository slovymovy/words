                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c10d543-4b66-4a42-907e-2ee3a1332c8d",
                                "sense_id": "fef6fd64-b2e8-3d63-8ec7-7cfacdd0e877",
                                "text": "„Er bezieht eine Villa in Saint-Raphaél, einem exklusiveren und ruhigeren Ort als das nahe gelegene Saint-Tropez.“"
