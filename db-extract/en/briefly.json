                                        "sense_id": "22a979c3-0058-3b25-a03d-c6f47d5fd8eb",
                                        "entry_id": "714e0f27-ff97-31f4-8498-86fb01e50438",
                                        "glosses": [
                                            "En peu de mots, de façon brève."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0de1dfb8-7232-475b-b97c-f0a5f4315d4b",
                                                "sense_id": "22a979c3-0058-3b25-a03d-c6f47d5fd8eb",
                                                "text": "Nous avons montré aussi brièvement qu’il a été possible, quelle est la dignité de duc et pair dans tous les âges de la monarchie."
                                            },
                                            {
                                                "example_id": "1ac47509-57a8-4ad5-8d96-6bf2e4a9c73f",
                                                "sense_id": "22a979c3-0058-3b25-a03d-c6f47d5fd8eb",
                                                "text": "Je lui exposai brièvement mes aventures, et il m’écouta en silence."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "874a33cd-5b23-4280-990c-3523078a80f6",
