                "senses": [
                    {
                        "sense_id": "0bdbaf77-6aea-310b-a26c-f09e1530b571",
                        "entry_id": "4c2807db-c73f-3c39-98c2-0ed11caa0aaf",
                        "glosses": [
                            "разг. свесившийся или свешивающийся, опустившийся или опущенный вниз; повисший, отвислый"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae6d39cf-e3d7-4b61-b434-a4a5a806929c",
                                "sense_id": "0bdbaf77-6aea-310b-a26c-f09e1530b571",
                                "text": "Из грязи видны были только .. продолговатые, облитые грязью спины да огромные повислые уши [свиней]."
                            },
                            {
                                "example_id": "009a458f-cf3e-4baf-8a29-86c48a296668",
                                "sense_id": "0bdbaf77-6aea-310b-a26c-f09e1530b571",
                                "text": "Повислые под кручей частые длинные корни деревьев — превратились в сосульки."
                            }
                        ]
                    }
                ],
