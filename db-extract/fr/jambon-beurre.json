                        "examples": [
                            {
                                "example_id": "e1d2a1b5-034d-4560-bea4-6ac5a81d379a",
                                "sense_id": "0634df89-bdfc-3beb-87e3-5ddb1709157d",
                                "text": "— Je mange un sandwich, déclara Pat.\n— Deux sandwiches, alors.\n— Jambon-beurre ? grogna le garçon menaçant.\n— Qu’est-ce que vous avez d’autre ?\n— Rien. Jambon-beurre seulement.\n— Bon. Ben, deux."
                            },
                            {
                                "example_id": "fc4d3dc9-1698-4b72-8b5f-a9325c160b84",
                                "sense_id": "0634df89-bdfc-3beb-87e3-5ddb1709157d",
                                "text": "Mi-sérieux, mi-amusés, ces bouffeurs de margarine et d’oméga daubent sur la disette au pays du croissant et du jambon-beurre."
                            }
                        ]
                    }
