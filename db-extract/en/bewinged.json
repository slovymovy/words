                        "sense_id": "9a157b08-90a6-3512-8efd-ce4ab2e9c60b",
                        "entry_id": "40f46ec1-128f-3db6-92cf-970310d0a75e",
                        "glosses": [
                            "Having, or equipped with wings"
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "76adf3e8-2191-488f-b63e-d417ed3a28d4",
                                "sense_id": "9a157b08-90a6-3512-8efd-ce4ab2e9c60b",
                                "text": "An angel throng, bewinged, bedight In veils, and drowned in tears, Sit in a theatre, to see A play of hopes and fears, While the orchestra breathes fitfully The music of the spheres."
                            },
                            {
                                "example_id": "4edc3a6a-3d6e-4ad8-8442-4ace10b868c4",
                                "sense_id": "9a157b08-90a6-3512-8efd-ce4ab2e9c60b",
                                "text": "As I edge up towards the vehicle in front, I can see it quite clearly - the red, bewinged nose cone of a Formula One car reflected in the rear end of the car I am following."
                            },
                            {
                                "example_id": "e5aca114-741a-4f9f-9113-b958087932a8",
                                "sense_id": "9a157b08-90a6-3512-8efd-ce4ab2e9c60b",
                                "text": "Bewinged enchanted spirits— Safely guard these waters That flow hard."
                            },
                            {
                                "example_id": "afc972d5-df68-4a12-97a2-bd6fb8d14379",
                                "sense_id": "9a157b08-90a6-3512-8efd-ce4ab2e9c60b",
                                "text": "Low and black and bewinged, it gave new meaning to her mental image of something that moved like a bat out of hell."
                            },
                            {
                                "example_id": "bc03aa6e-258b-41bf-a7ff-aa14d5f15771",
                                "sense_id": "9a157b08-90a6-3512-8efd-ce4ab2e9c60b",
                                "text": "There are shots of Wymondham Abbey, the rich green of the churchyard, and stained glass windows showing bewinged and halo—ed angels engaged in silent, motionless musical pursuit: lute, violin and horn; cymbal, trumpet, tambourine and triangle."
                            }
                        ]
                    }
