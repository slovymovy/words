                        "examples": [
                            {
                                "example_id": "25095422-b2e7-447e-a66c-6518fff677ee",
                                "sense_id": "e9cba38c-3913-352d-9026-7c7e27f25fbb",
                                "text": "Elle représente cinq petits amours entourant les armes (le blason) du maréchal de Saxe – on distingue bien, posé en bande de droite à gauche, le crancelin, couronne emblématique de la maison de Saxe – et jouant avec des armes (de combat) un peu trop grandes pour eux, l’un avec un casque, l’autre avec une épée."
                            },
                            {
                                "example_id": "59616ca2-24bc-4641-bff0-7c56180dd8c1",
                                "sense_id": "e9cba38c-3913-352d-9026-7c7e27f25fbb",
                                "text": "Coupé, au I de sinople au crancelin d’argent posé en fasce, au II d’or au pal ondé d’azur, qui est de la commune de Breitingen en Allemagne → voir illustration « armoiries avec un crancelin »"
                            }
                        ]
                    }
