    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "65c112b2-e789-3def-b567-a10ebbeb4686",
                "word": "heirloom",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "b88eaf23-67ab-42d0-ba06-4847db576e7b",
                        "entry_id": "65c112b2-e789-3def-b567-a10ebbeb4686",
                        "tags": [
                            "plural"
                        ],
                        "form": "heirlooms"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5a158133-43b2-3800-9ed0-de227f61bb93",
                        "entry_id": "65c112b2-e789-3def-b567-a10ebbeb4686",
                        "glosses": [
                            "A valued possession that has been passed down through the generations."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f067837c-aede-41eb-b06b-a385123e0422",
                                "sense_id": "5a158133-43b2-3800-9ed0-de227f61bb93",
                                "text": "Morning rehearsal starts at eleven. Wheeler takes a taxi from the hotel to the venue, bringing his tuxedo and his violin with him. His violin is an heirloom, more than a hundred years old, and while he's touring it never leaves his sight. (His tuxedo is just a tuxedo.)"
                            }
                        ]
                    },
                    {
                        "sense_id": "b0482590-fc50-3d03-b7fe-01671039bae9",
                        "entry_id": "65c112b2-e789-3def-b567-a10ebbeb4686",
                        "glosses": [
                            "An old crop variety that has been passed down through generations of farmers by seed saving and cultivation, in contrast to modern cultivars used in large-scale agriculture."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "33a5b844-81a7-4690-8127-32ff86ab9e43",
                                "sense_id": "b0482590-fc50-3d03-b7fe-01671039bae9",
                                "text": "My last trip to the market barely yielded enough unmealy heirlooms for a couple of salads."
                            },
                            {
                                "example_id": "548d4ebb-68ca-43e6-82d6-1c3969e33a97",
                                "sense_id": "b0482590-fc50-3d03-b7fe-01671039bae9",
                                "text": "At Hortus Bulborum you will find heirloom narcissi that date back at least to the 15th century and famous old tulips like 'Duc van Tol' (1595) and its sports."
                            },
                            {
                                "example_id": "86a3cd61-8cc6-4bf1-b8cf-06ee6f2a239e",
                                "sense_id": "b0482590-fc50-3d03-b7fe-01671039bae9",
                                "text": "In a paper published Thursday in the journal Science, a team of researchers say they analyzed the genetic code of nearly 400 varieties of tomatoes ― from the common red supermarket types to the funky heirlooms found in farmers markets."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "045e3a00-5b12-4f4f-99a4-de20c66b1850",
                        "source_entry_id": "65c112b2-e789-3def-b567-a10ebbeb4686",
                        "source_sense_description": "valued possession passed down through the generations",
                        "target_lang_word": "erfstuk",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "erfstuk",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "cdd1090b-e60e-370f-8422-245774388e82",
                                        "entry_id": "a348a5a7-09ce-316b-bb99-e6d8bd823291",
                                        "glosses": [
                                            "een veelal kostbaar goed van van generatie op generatie door vererving overgegeven wordt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e5a4ecd2-1edd-4e41-80d0-5fe07f1b5a21",
                                                "sense_id": "cdd1090b-e60e-370f-8422-245774388e82",
                                                "text": "Dat is nog een erfstuk van mijn overgrootvader."
                                            },
                                            {
                                                "example_id": "9bf8a7f8-d953-4cdc-8a32-e3bf6e6e06df",
                                                "sense_id": "cdd1090b-e60e-370f-8422-245774388e82",
                                                "text": "Bij een goede opvoeding hoorde dat je anderen niet tot last was, geen geld leende, geen erfstukken zoals schilderijen of iets anders verkocht, niet naar familieleden rende om je te beklagen. Dat soort dingen deed je gewoon niet."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0dfafa96-10a5-45cc-9654-c8317d58f29a",
                        "source_entry_id": "65c112b2-e789-3def-b567-a10ebbeb4686",
                        "source_sense_description": "valued possession passed down through the generations",
                        "target_lang_word": "patrimoine",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "patrimoine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "edc095d7-c9fc-35f0-9bdf-8e9589faff95",
                                        "entry_id": "ce46e9bf-b46d-3493-bc68-0ef064afa0f0",
                                        "glosses": [
                                            "Biens qu’une personne a hérité de son père ou de sa mère. Se dit en particulier pour les distinguer des acquêts."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "853e25fe-d29d-454f-b97d-522b029763af",
                                                "sense_id": "edc095d7-c9fc-35f0-9bdf-8e9589faff95",
                                                "text": "Dans le même souci de protection du lignage, le père pouvait cependant, s’il se méfiait de ses enfants, les obliger à conserver le patrimoine pour leurs propres enfants : c’est la substitution si répandue dans notre ancien régime […]"
                                            },
                                            {
                                                "example_id": "3c847ed6-b9a3-4b64-bfff-d61e310f6be6",
                                                "sense_id": "edc095d7-c9fc-35f0-9bdf-8e9589faff95",
                                                "text": "Afin de souligner l’indigence des moyens matériels de la Mairie on notera que l’essentiel de ses biens mobiliers devant être introduits dans son patrimoine se résume à 2 camions bennes, un camion citerne vidangeur et 1 citerne à eau acquis en 1997 ; […]."
                                            },
                                            {
                                                "example_id": "a90e4189-bd9f-46b2-bdfa-5411ab3d3cbe",
                                                "sense_id": "edc095d7-c9fc-35f0-9bdf-8e9589faff95",
                                                "text": "En 1784 , le patrimoine du prieuré de Sail-sous-Couzan se composait des éléments suivants : Fort belle maison appelée le prieuré , grange , écurie , cuvage , cuves , pressoir , 3 cartonnées de jardin en deux pièces , 2 journalées de vigne , 60 cartonnées de bois taillis, 2 prés de la contenue de 27 cartonnées."
                                            },
                                            {
                                                "example_id": "af8b6b32-96e3-4719-a383-957f3d021c10",
                                                "sense_id": "edc095d7-c9fc-35f0-9bdf-8e9589faff95",
                                                "text": "Il n’a jamais voulu toucher à son patrimoine, il n’a disposé que de ses acquêts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "900e1c01-5e6b-34e7-a280-c87018fa959f",
                                        "entry_id": "ce46e9bf-b46d-3493-bc68-0ef064afa0f0",
                                        "glosses": [
                                            "Bien transmis commun à une société, une communauté."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d2d10b1a-6888-4a23-bda9-69cbdf554182",
                                                "sense_id": "900e1c01-5e6b-34e7-a280-c87018fa959f",
                                                "text": "La valorisation du patrimoine juif est un processus de grande ampleur en Catalogne où la restauration des calls (nom hébreu désignant les quartiers juifs au Moyen Âge) et la récupération des témoignages du passé, ont donné des résultats notoires."
                                            },
                                            {
                                                "example_id": "770ca056-1afa-4cae-ab07-fbcfd775bbf0",
                                                "sense_id": "900e1c01-5e6b-34e7-a280-c87018fa959f",
                                                "text": "L’office du tourisme travaille en collaboration avec le service du patrimoine de la ville, et propose donc des visites guidées, animées par des guides-conférenciers spécialistes de l'histoire locale."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a5d21f90-f8ad-3460-8708-8e2afec214ff",
                                        "entry_id": "ce46e9bf-b46d-3493-bc68-0ef064afa0f0",
                                        "glosses": [
                                            "Ensemble de droits, d'obligations et de biens possédés par un individu."
                                        ],
                                        "tags": [
                                            "Droit civil"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ad37749-6af8-402f-bd50-830282cda044",
                                                "sense_id": "a5d21f90-f8ad-3460-8708-8e2afec214ff",
                                                "text": "Enfin, la loi du 14 février 2022 en faveur de l’activité professionnelle indépendante a imposé que tous les entrepreneurs individuels soient dotés d’un double patrimoine : l’un privé et l’autre professionnel, ce dernier répondant seul des dettes liées à l’activité économique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5ab533c0-08a4-4b91-b913-896e1c296249",
                        "source_entry_id": "65c112b2-e789-3def-b567-a10ebbeb4686",
