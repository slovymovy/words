                "senses": [
                    {
                        "sense_id": "0205bc31-0c1d-3647-af49-ec9eedf7d881",
                        "entry_id": "125ef789-0303-3c05-a1c2-f510da176420",
                        "glosses": [
                            "Se dit d'une substance qui possède une affinité pour les lipides, les graisses contenues dans les tissus vivants et participe à sa dégradation, sa métabolisation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba7c482b-859f-4973-ae65-ae1d526cbaee",
                                "sense_id": "0205bc31-0c1d-3647-af49-ec9eedf7d881",
                                "text": "Nous ne sommes pas les premiers à démontrer ainsi l'activité lipotrope d'une protéine . Toutefois , pour un bon nombre d'auteurs, c'est le contenu en méthionine d'une protéine qui lui confère son activité lipotrope."
                            },
                            {
                                "example_id": "a5362264-2a14-4be6-afd4-567f5528e75a",
                                "sense_id": "0205bc31-0c1d-3647-af49-ec9eedf7d881",
                                "text": "Ceci constitue une première preuve de l'activité lipotrope de ces deux substances chez le caneton et démontre que le tourteau d'arachides modifie l'activité lipotrope de la bétaïne et de la méthionine."
                            }
                        ]
                    }
