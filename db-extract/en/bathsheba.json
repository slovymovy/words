                        "tags": [],
                        "examples": [
                            {
                                "example_id": "260e0a43-02bb-4094-bf34-a50f5f07ab12",
                                "sense_id": "5e88249f-af43-3a17-ab30-1212f11ae81b",
                                "text": "3 And David sent and enquired after the woman. And one said, Is not this Bathsheba, the daughter of Eliam, the wife of Uriah the Hittite?"
                            }
                        ]
                    },
                    {
                        "sense_id": "da12ef84-947d-321c-bb50-1d77715c376b",
