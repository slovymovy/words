                "forms": [],
                "senses": [
                    {
                        "sense_id": "695ac0d6-4caf-3ce6-85c2-15d9b3767b5c",
                        "entry_id": "4c1639d9-bbe4-3b6c-be01-6a6ab66b094c",
                        "glosses": [
                            "A surname from Mandarin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a76f3a46-720a-4f10-a3bb-e773b2e53ac3",
                                "sense_id": "695ac0d6-4caf-3ce6-85c2-15d9b3767b5c",
                                "text": "Zhang Xueliang, whose name was also rendered Chang Hsueh-liang, was born in 1901 in Manchuria. His father, Zhang Zuolin, a leading warlord known as \"the Old Marshal,\" was assassinated in 1928 by the Japanese. \"The Young Marshal\" emerged in his place as one of the most powerful military figures in China."
                            },
                            {
                                "example_id": "a6e0b67b-a3c9-40a0-aa3f-392d201bd9ba",
                                "sense_id": "695ac0d6-4caf-3ce6-85c2-15d9b3767b5c",
                                "text": "Former Chinese warlord Chang Hsueh-liang, who along with Chinese Communists kidnapped Nationalist leader Chiang Kai-shek and changed the course of Chinese history, died in Hawaii on Oct. 15, Taiwan and Chinese news agencies reported. He was 100.[…]\nChang was born June 3, 1901, in the northeastern province of Liaoning, the son of Manchurian military strongman Chang Tso-lin."
                            },
                            {
                                "example_id": "aca81d7c-22c0-47a0-acfd-3215551648b6",
                                "sense_id": "695ac0d6-4caf-3ce6-85c2-15d9b3767b5c",
                                "text": "The man surnamed Chang (張) on Monday was taken back to his residence in Cianjhen District to clarify how the alleged murders took place after blood samples collected at his home last week matched DNA samples provided by family members of three previously reported missing women."
                            }
                        ]
                    }
                ],
