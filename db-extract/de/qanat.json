                        "examples": [
                            {
                                "example_id": "08b49c58-b931-4687-8c53-2d07eac02f46",
                                "sense_id": "9daa2cfd-8928-3b0c-97c9-237aba5d1205",
                                "text": "„Mein Vater hatte mir als Kind von den Qanaten erzählt, von dieser geistigen und technischen Höchstleistung der Perser.“"
