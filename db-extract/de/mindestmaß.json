                            {
                                "target_word": "minimum",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c076d4fb-9f92-3dcc-9fd3-b6f38ed2c406",
                                        "entry_id": "4f6be11f-593e-31d5-8ab7-ea63675a5978",
                                        "glosses": [
                                            "Plus petite somme dans l’ordre des sommes dont il s’agit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f3164f3-7ce4-4232-8f98-45aedae7ac47",
                                                "sense_id": "c076d4fb-9f92-3dcc-9fd3-b6f38ed2c406",
                                                "text": "75 % de la population afrocolombienne du pays perçoit des salaires plus bas que le minimum légal et leur espérance de vie est de 20% inférieure à la moyenne nationale."
                                            },
                                            {
                                                "example_id": "9ff4d3bc-95b6-4717-9b8e-3ac6dc93231f",
                                                "sense_id": "c076d4fb-9f92-3dcc-9fd3-b6f38ed2c406",
                                                "text": "Il n’a pu obtenir comme traitement que le minimum de ce qu’il pouvait espérer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d4e7fe15-9c41-3047-b266-c9abd4094c62",
                                        "entry_id": "4f6be11f-593e-31d5-8ab7-ea63675a5978",
                                        "glosses": [
                                            "Se dit encore de la moindre des peines que la loi inflige pour un crime, pour un délit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1589cd7-059d-4356-b068-1767d3d4fadd",
                                                "sense_id": "d4e7fe15-9c41-3047-b266-c9abd4094c62",
                                                "text": "On lui appliqua le minimum de la peine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9a43a361-bc84-36a6-8318-4fde4d9664e1",
                                        "entry_id": "4f6be11f-593e-31d5-8ab7-ea63675a5978",
                                        "glosses": [
                                            "Point le plus bas où une chose puisse être mise."
                                        ],
                                        "tags": [
                                            "common"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2d23cd67-1b4a-432e-89f7-c3e43aa03fc8",
                                                "sense_id": "9a43a361-bc84-36a6-8318-4fde4d9664e1",
                                                "text": "Cette condition est le minimum de ce que je puis accepter."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2a0dab90-de39-342f-9a88-bfb1292e0dc1",
                                        "entry_id": "4f6be11f-593e-31d5-8ab7-ea63675a5978",
                                        "glosses": [
