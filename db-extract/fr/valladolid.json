                "senses": [
                    {
                        "sense_id": "4fb7f510-019a-3c0b-ba0e-a61d0b632698",
                        "entry_id": "a4597865-1ed1-3c6a-be1a-8ee1cf1877e6",
                        "glosses": [
                            "Commune et ville d’Espagne, chef-lieu de la province du même nom."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "084178c3-fca0-4168-a49c-ff68624b6fae",
                                "sense_id": "4fb7f510-019a-3c0b-ba0e-a61d0b632698",
                                "text": "Ce flanker, international samoan (5 sélections), est passé par l’Espagne au sein de l’équipe de Valladolid (2018-2019) avant de rejoindre une province australienne, puis les Natal Sharks de Durban (2022)."
                            },
                            {
                                "example_id": "146bd0ef-1ff5-4c59-8e01-ed69204070f4",
                                "sense_id": "4fb7f510-019a-3c0b-ba0e-a61d0b632698",
                                "text": "Dans un 4-4-2 avec Pereira Lage au soutien d’Irvin Cardona, les Brestois se sont procuré les meilleures occasions face à Valladolid."
                            },
                            {
                                "example_id": "eadd4f67-99e9-434e-8f6d-100c0fa0a48b",
                                "sense_id": "4fb7f510-019a-3c0b-ba0e-a61d0b632698",
                                "text": "Valladolid compte plus de 600 bâtiments historiques, une cathédrale qui domine les toits et de petits bistrots aux bouteilles suspendues derrière le comptoir, où l’on commande un cafe solo ou un cafe con leche."
                            }
                        ]
                    },
