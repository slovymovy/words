                    "sense_id": "473c84d3-d8d6-347f-8213-86a393de7dfc",
                    "sense_definition": "Een begroeting die men uitspreekt wanneer iemand ergens arriveert.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Welkom</w> in onze prachtige stad.",
                            "target_lang_translations": {
                                "en": "<w>Welcome</w> to our beautiful city.",
                                "ru": "<w>Добро пожаловать</w> в наш прекрасный город.",
                                "pl": "<w>Witamy</w> w naszym pięknym mieście.",
                                "de": "<w>Willkommen</w> in unserer wunderschönen Stadt.",
                                "fr": "<w>Bienvenue</w> dans notre belle ville.",
                                "it": "<w>Benvenuto</w> nella nostra splendida città.",
                                "cs": "<w>Vítejte</w> v našem krásném městě.",
                                "tr": "Güzel şehrimize <w>hoş geldiniz</w>.",
                                "es": "<w>Bienvenidos</w> a nuestra hermosa ciudad."
                            }
                        },
                        {
                            "text": "Hallo allemaal en <w>welkom</w> bij deze presentatie.",
                            "target_lang_translations": {
                                "en": "Hello everyone and <w>welcome</w> to this presentation.",
                                "ru": "Всем привет и <w>добро пожаловать</w> на эту презентацию.",
                                "pl": "Witam wszystkich i <w>zapraszam</w> na tę prezentację.",
                                "de": "Hallo allerseits und <w>willkommen</w> zu dieser Präsentation.",
                                "fr": "Bonjour à tous et <w>bienvenue</w> à cette présentation.",
                                "it": "Ciao a tutti e <w>benvenuti</w> a questa presentazione.",
                                "cs": "Ahoj všichni a <w>vítejte</w> u této prezentace.",
                                "tr": "Herkese merhaba ve bu sunuma <w>hoş geldiniz</w>.",
                                "es": "Hola a todos y <w>bienvenidos</w> a esta presentación."
                            }
                        }
                    ],
                    "common_phrases": [
                        "van harte welkom",
                        "welkom thuis",
                        "welkom terug"
                    ],
                    "target_lang_definitions": {
                        "en": "A greeting used when someone arrives at a place.",
                        "ru": "Приветствие, используемое при прибытии кого-либо в какое-то место.",
                        "pl": "Powitanie wypowiadane, gdy ktoś przybywa w jakieś miejsce.",
                        "de": "Ein Gruß, den man ausspricht, wenn jemand an einem Ort ankommt.",
                        "fr": "Formule de salutation utilisée lorsque quelqu'un arrive dans un lieu.",
                        "it": "Un saluto rivolto a qualcuno quando arriva in un luogo.",
                        "cs": "Pozdrav vyjadřovaný při něčím příchodu na nějaké místo.",
                        "tr": "Birinin bir yere varması durumunda kullanılan bir selamlama sözü.",
                        "es": "Un saludo que se pronuncia cuando alguien llega a un lugar."
                    },
