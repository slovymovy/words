                "senses": [
                    {
                        "sense_id": "bdf8ba4f-1272-37c7-97f6-c734da29577a",
                        "entry_id": "f0b481a7-08ca-357d-a847-53a4b00447f7",
                        "glosses": [
                            "Fachmann/gerichtlich bestellter Gutachter für Waffen; Person, die berufsmäßig Waffen untersucht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "edac2998-73a1-4602-bc28-aba6dd916a98",
                                "sense_id": "bdf8ba4f-1272-37c7-97f6-c734da29577a",
                                "text": "„Der Waffensachverständige des Schleswig-Holsteiner Landeskriminalamtes bestätigt jedoch, daß aus Diesners Waffe vorher nicht geschossen wurde.“"
                            },
                            {
                                "example_id": "9a09316a-e212-461f-89ab-3a438fe5352b",
                                "sense_id": "bdf8ba4f-1272-37c7-97f6-c734da29577a",
                                "text": "„Ein Bedürfnis zum Erwerb und Besitz von Schusswaffen oder Munition wird bei Personen anerkannt, die glaubhaft machen, dass sie Schusswaffen oder Munition für wissenschaftliche oder technische Zwecke, zur Erprobung, Begutachtung, Untersuchung oder zu einem ähnlichen Zweck (Waffen-, Munitionssachverständige) benötigen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
