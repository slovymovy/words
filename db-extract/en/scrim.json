                                "example_id": "bf6758cb-6e37-4836-9759-590e83388b5c",
                                "sense_id": "1057ad31-be88-34a7-b543-49171b63927a",
                                "text": "Mummified mannequins dangling above the set, illuminated from within, were a heavy-handed touch, but the designer George Tsypin’s translucent scrims and painted drops beautifully conveyed the passage of sun-blasted days and bone-chilling nights on the edge of civilization."
                            }
                        ]
