        "fr-extract.jsonl": [
            {
                "entry_id": "5fa9a7fc-00a6-34a0-b16d-d92ea81d6be4",
                "word": "statuette",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "6d7414c3-9de2-47a9-85af-df1330a91854",
                        "entry_id": "5fa9a7fc-00a6-34a0-b16d-d92ea81d6be4",
                        "tags": [
                            "plural"
                        ],
                        "form": "statuettes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b313dc2a-5852-331b-9f98-195ce673e4d4",
                        "entry_id": "5fa9a7fc-00a6-34a0-b16d-d92ea81d6be4",
                        "glosses": [
                            "Petite statue."
                        ],
                        "tags": [
                            "Sculpture"
                        ],
                        "examples": [
                            {
                                "example_id": "9ebe1c78-8155-42fd-b46b-dc4622185063",
                                "sense_id": "b313dc2a-5852-331b-9f98-195ce673e4d4",
                                "text": "Réexaminons en premier lieu le groupe bien connu des statuettes de terre cuite attiques, conservé à New York, qui révèle une stylisation indéniable des masques comiques dès la fin du Vᵉ siècle av. J.-C."
                            },
                            {
                                "example_id": "21baf6fc-a6bf-45b1-b97b-ff82bc21de4e",
                                "sense_id": "b313dc2a-5852-331b-9f98-195ce673e4d4",
                                "text": "En juin, une statuette anthropomorphe au faciès joufflu en serpentine a ainsi été adjugée pour 399 900 euros chez Binoche et Giquello."
                            },
                            {
                                "example_id": "a448c5f4-49f4-4572-b7d4-7f65e7129ec0",
                                "sense_id": "b313dc2a-5852-331b-9f98-195ce673e4d4",
                                "text": "Commana s’inquiète pour son petit patrimoine : la statuette de la croix de Quillidiec vient de disparaître."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3141b303-c00d-42eb-83fa-4f3d42a26806",
                        "source_entry_id": "5fa9a7fc-00a6-34a0-b16d-d92ea81d6be4",
                        "source_sense_id": "b313dc2a-5852-331b-9f98-195ce673e4d4",
                        "target_lang_word": "statuette",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "statuette",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6697bea5-136e-34e4-88a1-cb2004e7a634",
                                        "entry_id": "d6510b96-cb8f-3f8f-aaa1-1b9b7ba24dcc",
                                        "glosses": [
                                            "A small statue, usually a figure much less than life size, especially when of marble or bronze, or of plaster or clay as a preparation for the marble or bronze, as distinguished from a figure in terra cotta etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e1179c4-a395-4a8c-952d-79679cb2c569",
                                                "sense_id": "6697bea5-136e-34e4-88a1-cb2004e7a634",
                                                "text": "[…] may be discovered not far from a charming statuette of Queen Alexandra, and there is also the figurette of King George's elder brother."
                                            },
                                            {
                                                "example_id": "a7e3b7e2-9ff9-431d-a000-3c5f32bacf4e",
                                                "sense_id": "6697bea5-136e-34e4-88a1-cb2004e7a634",
                                                "text": "Some statuettes are not monochrome but represent characters. That is why they are called nanofigures."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f8606825-c2e4-4db1-940e-4c640f1fe0e5",
                        "source_entry_id": "5fa9a7fc-00a6-34a0-b16d-d92ea81d6be4",
                        "source_sense_id": "b313dc2a-5852-331b-9f98-195ce673e4d4",
                        "target_lang_word": "figurine",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "figurine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "878bee31-ab84-34c8-870c-41c175f49785",
                                        "entry_id": "46f6a49a-bdfc-32cb-83b6-240067a65994",
                                        "glosses": [
                                            "A small carved or molded figure; a statuette."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f37ed64-266d-48a0-9dc0-ee989a10ac57",
                                                "sense_id": "878bee31-ab84-34c8-870c-41c175f49785",
                                                "text": "Galvanised by this knowledge, the figurine family take to exercise and healthy eating in the park, forming themselves into the key words \"Eat\" (better), \"Move\" (more) and \"Live\" (longer) of the government's urgings and soon the municipal landscape is filled with other happy, healthier families who, incidentally, look even more delicious en masse."
                                            },
                                            {
                                                "example_id": "352f8ba8-3d16-4d08-acda-568b639cbe5a",
                                                "sense_id": "878bee31-ab84-34c8-870c-41c175f49785",
                                                "text": "While figurines were an integral part of Late Neolithic and Early Copper Age life, they disappear from society until the later Nuragic period.[…]The lack of figurines is a conscious choice, as is the decision to produce over 500 bronze figurines (bronzetti) in phases III and IV of the Nuragic period."
                                            },
                                            {
                                                "example_id": "17394593-3b3f-48ac-8b5a-75777649bab4",
                                                "sense_id": "878bee31-ab84-34c8-870c-41c175f49785",
                                                "text": "For the abbreviation of the name of the pieces, each player is free to use the name which is commonly used in his/her country. Examples: F = fou (French for bishop), L = loper (Dutch for bishop). In printed periodicals, the use of figurines is recommended."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1e0e85c9-a0c3-4633-9770-4833b2a6ff33",
                        "source_entry_id": "5fa9a7fc-00a6-34a0-b16d-d92ea81d6be4",
                        "source_sense_id": "b313dc2a-5852-331b-9f98-195ce673e4d4",
                        "target_lang_word": "estatuilla",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "7fc40b98-7cba-4c51-b389-cd99c6898e85",
                        "source_entry_id": "5fa9a7fc-00a6-34a0-b16d-d92ea81d6be4",
                        "source_sense_id": "b313dc2a-5852-331b-9f98-195ce673e4d4",
                        "target_lang_word": "figurita",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "figurita",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "43b96c99-8103-39e6-b3cb-905b7c2cf0d1",
                                        "entry_id": "341b9999-1d3f-35cc-9c33-bcc4a97fd234",
                                        "glosses": [
                                            "Pequeña estampa impresa en cartón o papel que, junto a otras de similar temática, suele coleccionarse pegándola en un álbum. Son comunes las figuritas con fotos o ilustraciones de deportistas o vinculados a famosos personajes del cine o la TV."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "564cbffe-dd8c-3d53-9ce1-badd9c6ecb88",
                                        "entry_id": "341b9999-1d3f-35cc-9c33-bcc4a97fd234",
                                        "glosses": [
                                            "Figura pequeña representando algo, que normalmente se usa para decorar o jugar, o en algunos casos especiales, como en las figuritas de los santos, para rezar o encomendarse a él, o con algún uso particular."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "37837dc0-6cba-4327-b7f7-f3e7031c4030",
                        "source_entry_id": "5fa9a7fc-00a6-34a0-b16d-d92ea81d6be4",
                        "source_sense_id": "b313dc2a-5852-331b-9f98-195ce673e4d4",
                        "target_lang_word": "αγαλματίδιο",
                        "target_lang_code": "el",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "αγαλματίδιο",
                                "target_lang_code": "el",
                                "target_senses": [
                                    {
                                        "sense_id": "42cc986d-4722-3693-96a8-e030da17f804",
                                        "entry_id": "d4d1ba68-1404-3735-a25f-3e9574086d52",
                                        "glosses": [
                                            "μικρού μεγέθους άγαλμα, ειδώλιο"
                                        ],
                                        "tags": [
                                            "γλυπτική"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7f933a62-3593-4621-893c-6d145f01e4a6",
                                                "sense_id": "42cc986d-4722-3693-96a8-e030da17f804",
                                                "text": "※ Με τίτλο «Σκλάβα», το 500 ετών κέρινο αγαλματίδιο αποτελούσε τμήμα των προετοιμασιών του Μιχαήλ Αγγέλου για τον περισπούδαστο τάφο του Πάπα Ιουλίου του Β’ στη Ρώμη.",
                                                "translation": "Βρετανία: Δακτυλικό αποτύπωμα του Μιχαήλ Αγγέλου σε κέρινο αγαλματίδιο, Η Καθημερινή , 16 Ιουλίου 2021"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3e8f0e96-60e8-4a3e-879e-89ec8ce3f4dc",
                        "source_entry_id": "5fa9a7fc-00a6-34a0-b16d-d92ea81d6be4",
                        "source_sense_id": "b313dc2a-5852-331b-9f98-195ce673e4d4",
                        "target_lang_word": "αγαλματάκι",
                        "target_lang_code": "el",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "αγαλματάκι",
                                "target_lang_code": "el",
                                "target_senses": [
                                    {
                                        "sense_id": "9170b396-60f6-3f5a-bad5-4b6fe5baf587",
                                        "entry_id": "63edd3fe-b64c-3975-aec6-91d55ac547ee",
                                        "glosses": [
                                            "μικρό άγαλμα"
                                        ],
                                        "tags": [
                                            "diminutive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ae0c2a1b-9658-4704-92fd-eb5e90d11741",
                                                "sense_id": "9170b396-60f6-3f5a-bad5-4b6fe5baf587",
                                                "text": "※ Ο Ρόμπερτ Ολτμαν, ο οποίος έκλεισε τα 81 του στις 20 Φεβρουαρίου, παρέλαβε την περασμένη Κυριακή το πρώτο του Οσκαρ, βράβευση «για το σύνολο της προσφοράς του». Εχει προταθεί πέντε φορές για Οσκαρ καλύτερης σκηνοθεσίας στη διάρκεια της μακρόχρονης καριέρας του, χωρίς όμως να πάρει ποτέ το περιπόθητο αγαλματάκι.",
                                                "translation": "Σκηνοθέτης με αντοχή ο Ρόμπερτ Ολτμαν, Η Καθημερινή, 12 Μαρτίου 2006"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "77049cc6-0f2c-3a72-91e7-c7423fe7f0ce",
                                        "entry_id": "63edd3fe-b64c-3975-aec6-91d55ac547ee",
                                        "glosses": [
                                            ": παιδικό παιχνίδι"
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7a9e8878-d499-403d-b1f9-7a38a341c168",
                        "source_entry_id": "5fa9a7fc-00a6-34a0-b16d-d92ea81d6be4",
                        "source_sense_id": "b313dc2a-5852-331b-9f98-195ce673e4d4",
