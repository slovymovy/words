                        "cross_references": []
                    },
                    {
                        "translation_id": "da7daebe-9ab5-40d9-912b-c9368c3ac441",
                        "source_entry_id": "f4bf706b-3ca4-3e3d-b816-878389e8edb2",
                        "source_sense_id": "eda99956-4e8a-333e-b9e5-475434adc785",
                        "source_sense_description": "ergens ongericht rondlopen",
                        "target_lang_word": "wander",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wander",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "36ddd8ec-9ae8-3fb6-9ac6-7145ab78d31a",
                                        "entry_id": "dae3e409-ca1e-3109-a880-c0e957f86ac1",
                                        "glosses": [
                                            "To move without purpose or specified destination; often in search of livelihood."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "50bef212-d917-40c7-9b41-1f3dcf5d0353",
                                                "sense_id": "36ddd8ec-9ae8-3fb6-9ac6-7145ab78d31a",
                                                "text": "to wander over the fields"
                                            },
                                            {
                                                "example_id": "a34ad41c-a998-408b-b8e6-6fae4a483fa2",
                                                "sense_id": "36ddd8ec-9ae8-3fb6-9ac6-7145ab78d31a",
                                                "text": "They wandered about in sheepskins and goatskins."
                                            },
                                            {
                                                "example_id": "d339462f-1e07-4d6f-a94f-702046e3bc8d",
                                                "sense_id": "36ddd8ec-9ae8-3fb6-9ac6-7145ab78d31a",
                                                "text": "“A tight little craft,” was Austin’s invariable comment on the matron;[…]. ¶ Near her wandered her husband, orientally bland, invariably affable, and from time to time squinting sideways, as usual, in the ever-renewed expectation that he might catch a glimpse of his stiff, retroussé moustache."
                                            },
                                            {
                                                "example_id": "5109c281-d04c-48c0-acf3-039f56a0f7f1",
                                                "sense_id": "36ddd8ec-9ae8-3fb6-9ac6-7145ab78d31a",
                                                "text": "There is an hour or two, after the passengers have embarked, which is disquieting and fussy.[…]Stewards, carrying cabin trunks, swarm in the corridors. Passengers wander restlessly about or hurry, with futile energy, from place to place."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8adf0805-5672-341b-a1cd-a4ca31481815",
                                        "entry_id": "dae3e409-ca1e-3109-a880-c0e957f86ac1",
                                        "glosses": [
                                            "To stray; stray from one's course; err."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "676aff6b-a901-4212-b7ac-fe927db6541d",
                                                "sense_id": "8adf0805-5672-341b-a1cd-a4ca31481815",
                                                "text": "A writer wanders from his subject."
                                            },
                                            {
                                                "example_id": "37612ef7-c5eb-4bc1-b4a2-0fb7490f11c6",
                                                "sense_id": "8adf0805-5672-341b-a1cd-a4ca31481815",
                                                "text": "O, let me not wander from thy commandments."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8d1191d1-bd22-36d6-897d-6abca95ca5d9",
                                        "entry_id": "dae3e409-ca1e-3109-a880-c0e957f86ac1",
                                        "glosses": [
                                            "To commit adultery."
                                        ],
                                        "tags": [
