                        "glosses": [
                            "Ensemble de règles ayant pour finalité de rendre l’information facile à lire et à comprendre, notamment en cas de handicap mental."
                        ],
                        "tags": [
                            "Handicap"
                        ],
                        "examples": [
                            {
                                "example_id": "961b5132-215e-4946-ab00-cba773c65a0f",
                                "sense_id": "421674e0-9766-382d-ac29-3b42f203d7b0",
                                "text": "Le facile à lire et à comprendre (FALC) est une méthode qui a pour but de traduire un langage classique en un langage simplifié."
                            },
                            {
                                "example_id": "bc618a87-5b7c-43b7-ad7d-e1fcd45e78c0",
                                "sense_id": "421674e0-9766-382d-ac29-3b42f203d7b0",
                                "text": "Le FALC transcrit le langage classique et le rend compréhensible par tous."
                            },
                            {
                                "example_id": "65bbb544-33be-4e53-a0b1-be1242d1a920",
                                "sense_id": "421674e0-9766-382d-ac29-3b42f203d7b0",
                                "text": "La médiathèque met à disposition de nombreux documents : livres sonores, à écouter, multimédia, livres avec CD, en gros caractères ou en braille ou adaptés avec la méthode Faciles à lire et à comprendre (FALC) et DYS pour les enfants souffrant de dyslexie."
                            }
                        ]
                    }
