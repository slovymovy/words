                        "examples": [
                            {
                                "example_id": "5162b5e1-3f49-494d-8e7e-4c4f20d7e2d3",
                                "sense_id": "c161f302-d94f-33bf-930d-9e0388112a45",
                                "text": "Ojcu nie spodobał się nowy chłopak Iwony, bo nie ustąpił jej miejsca w tramwaju."
                            },
                            {
                                "example_id": "7fa00b2c-60c5-440c-97be-011aa6f14119",
                                "sense_id": "c161f302-d94f-33bf-930d-9e0388112a45",
                                "text": "Nie przejmuj się tak Iwoną, niech jedzie sama."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
