                                "example_id": "a42d46c7-40b5-46be-9ed7-c2f43c40cfc5",
                                "sense_id": "b0057381-9eb5-3d01-8e57-53c927f63bd4",
                                "text": "Ze klemt Jacobs briefje in haar vuist, en de bakstenen van haar jeugd verbrokkelen weer tot stof."
                            },
                            {
                                "example_id": "06a4c77b-0c11-463d-a4be-93bc14882261",
                                "sense_id": "b0057381-9eb5-3d01-8e57-53c927f63bd4",
                                "text": "Vreemd dat we nooit zien door wie al die dingen worden gebracht, vind je niet?' 'Het is maar een briefje,' zegt Thea."
                            }
                        ]
