                        "sense_id": "2a6feb10-e043-370d-a110-1a19ea564d36",
                        "entry_id": "a0f05547-0465-30aa-8c6d-bdb4fa8889dc",
                        "glosses": [
                            "weibliche Person, die vornehmlich Opern singt"
                        ],
                        "tags": [
                            "Musik"
                        ],
                        "examples": [
                            {
                                "example_id": "9701209b-f70b-43e8-8040-48be50d1b38c",
                                "sense_id": "2a6feb10-e043-370d-a110-1a19ea564d36",
                                "text": "„Besonders in der langen Phase des Stehens, als Orchester, Balletttänzer und der Star des Abends, die Opernsängerin Anna Netrebko, ihren Beitrag zur Eröffnung lieferten und so wie jedes Jahr ein paar Debütanten ob der Anstrengung, Nervosität, des Fastens vor dem großen Auftritt oder einer Mischung aus alldem umkippten.“"
                            }
                        ],
