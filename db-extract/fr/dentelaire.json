                ],
                "senses": [
                    {
                        "sense_id": "a08a195e-78a0-3275-9394-d53df8eaeebe",
                        "entry_id": "e6131ca2-12d0-3187-86e7-87268459f63e",
                        "glosses": [
                            "Nom vernaculaire du plumbago d’Europe et d’espèces voisines."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "26c036ca-853e-42f0-9790-3de81fdd7238",
                                "sense_id": "a08a195e-78a0-3275-9394-d53df8eaeebe",
                                "text": "Vlooienkruid, n. [H n.] Herbe aux puces f., plantain pucier ou pulicaire, psyllion m. (Plantago psyllium) ; aunée ou inule pulicaire (Inula pulicaria) ; — pulicaire f. (Pulicaria) ; persicaire f., curage, piment ou poivre d’eau m. (Polygonum hydropiper), herbe au cancer, dentelaire f. (Plumbago europæa), conise ou conyze f. (Conyza). — Chasse-puce, pouliot sauvage m. (Mentha puligium ^([sic]))."
                            },
                            {
                                "example_id": "f5199b4b-5b5b-4b05-9c92-5b449ce6e42f",
                                "sense_id": "a08a195e-78a0-3275-9394-d53df8eaeebe",
                                "text": "Nous traiterons ici la dentelaire vivace légèrement arbustive et couvre-sol. Elle ne craint pas le gel et possède de magnifiques fleurs bleu gentiane en été et en automne."
                            },
                            {
                                "example_id": "9d4d0695-37ab-40ef-be91-f1137870e9b9",
                                "sense_id": "a08a195e-78a0-3275-9394-d53df8eaeebe",
                                "text": "La racine de dentelaire passait autrefois pour guérir les maux de dents (d'où le nom de la plante). Toxique, on ne l'utilisait que pour l'usage externe."
                            }
                        ]
                    }
                ],
