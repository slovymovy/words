                            {
                                "example_id": "e366da5f-f093-4207-8ada-b901379bed0d",
                                "sense_id": "02918097-6de8-3ba6-95b5-a72cf0f2cb4f",
                                "text": "Folkways are the living customs or traditions, also common to the society.",
                                "translation": "La tradition populaire est constituée des coutumes répandues dans une société."
                            },
                            {
                                "example_id": "beb5f740-138b-4a53-a700-122c8db9eb4d",
                                "sense_id": "02918097-6de8-3ba6-95b5-a72cf0f2cb4f",
                                "text": "Most folkways are not written down and enumerated.",
                                "translation": "Beaucoup de coutumes populaires ne sont pas inscrites et répertoriées."
                            }
                        ]
