                },
                {
                    "sense_id": "f3a6d9b8-2b7d-3548-b82a-e8ac84cba2f1",
                    "sense_definition": "A person held in high regard; a legend.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "slang_terms",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is an absolute <w>ledge</w> for helping us move all this heavy furniture.",
                            "target_lang_translations": {
                                "ru": "Он просто <w>красавчик</w>, что помог нам перевезти всю эту тяжелую мебель.",
                                "nl": "Hij is echt een <w>held</w> dat hij ons hielp al die zware meubels te verhuizen."
                            }
                        },
                        {
                            "text": "The retired football player is considered a true <w>ledge</w> by the local fans.",
                            "target_lang_translations": {
                                "ru": "Ушедший на покой футболист считается настоящей <w>легендой</w> среди местных болельщиков.",
                                "nl": "De gepensioneerde voetballer wordt door de lokale fans als een ware <w>legende</w> beschouwd."
                            }
