                "senses": [
                    {
                        "sense_id": "ea378381-7d69-3510-b93f-9c526715903a",
                        "entry_id": "1a7a06ed-434b-3fc9-a52d-7eaf5507d487",
                        "glosses": [
                            "Vibrant/R-Laut, gebildet mit der Zungenspitze am Zahndamm (am unteren Ausläufer der Schneidezähne des Oberkiefers)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b106ae86-3bb7-4e46-95df-2749903b71dd",
                                "sense_id": "ea378381-7d69-3510-b93f-9c526715903a",
                                "text": "„Im Finnischen wird das R auf der Zungenspitze mit einer leichten Trillerbewegung erzeugt wie im Spanischen auch: Rovaniemi, Räikkönen, Raúl, Ronda (initiales, alveolares Zungenspitzen-R).“"
                            },
                            {
                                "example_id": "d91f460c-0c50-4ac4-a928-95d8706df404",
                                "sense_id": "ea378381-7d69-3510-b93f-9c526715903a",
                                "text": "„Die Aussprache des Zungenspitzen-R ist notwendig zum lautreinen Sprechen vieler Sprachen - und sie ist erlernbar.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
