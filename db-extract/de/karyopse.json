                        "examples": [
                            {
                                "example_id": "b19bf6ba-fe31-4e6f-b02b-309cc2bffbe7",
                                "sense_id": "4105ad7f-651a-3743-a2d1-e116d4431664",
                                "text": "Die Früchte der Süßgräser sind Karyopsen."
