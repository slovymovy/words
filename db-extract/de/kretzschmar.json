                ],
                "senses": [
                    {
                        "sense_id": "f969d67c-12ff-32cb-87be-3fc98280ffb1",
                        "entry_id": "400d0388-d0ec-3de7-b628-173f8a40358c",
                        "glosses": [
                            "Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "886a4619-b43c-42a8-a2d9-451bca098af9",
                                "sense_id": "f969d67c-12ff-32cb-87be-3fc98280ffb1",
                                "text": "Frau Kretzschmar ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "6656ea44-3436-44be-97f5-68d09dd1e4c3",
                                "sense_id": "f969d67c-12ff-32cb-87be-3fc98280ffb1",
                                "text": "Herr Kretzschmar wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "725444d9-2eb8-4b6f-8049-492d4a89d106",
                                "sense_id": "f969d67c-12ff-32cb-87be-3fc98280ffb1",
                                "text": "Die Kretzschmars fliegen heute nach Warschau."
                            },
                            {
                                "example_id": "d3bc014f-3934-4cd5-b920-f4dad5d46d57",
                                "sense_id": "f969d67c-12ff-32cb-87be-3fc98280ffb1",
                                "text": "Der Kretzschmar trägt nie die Pullover, die die Kretzschmar ihm strickt."
                            },
                            {
                                "example_id": "59715162-d5b0-4f70-a0f1-82be54615db9",
                                "sense_id": "f969d67c-12ff-32cb-87be-3fc98280ffb1",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Kretzschmar kommt, geht der Herr Kretzschmar.“"
                            },
                            {
                                "example_id": "d58da7bf-76e7-4cfd-a79f-81e490bf5b26",
                                "sense_id": "f969d67c-12ff-32cb-87be-3fc98280ffb1",
                                "text": "Kretzschmar kommt und geht."
                            },
                            {
                                "example_id": "7bede490-b2af-4a08-9053-77799f897df4",
                                "sense_id": "f969d67c-12ff-32cb-87be-3fc98280ffb1",
                                "text": "Kretzschmars kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
