                        "entry_id": "38328cb7-799f-3379-be2a-d512ca3c67bf",
                        "glosses": [
                            "Cordage dont les deux extrémités sont épissées ensemble de manière à former un anneau ou une élingue."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b1fb729d-bd25-46d0-a7ff-0c338e104bde",
                                "sense_id": "fce2ca34-b7d7-33cf-9ae0-37642b906e0d",
                                "text": "'erse de poulie, cordage qui entoure la caisse d’une poulie en bois et dont une des extrémités sert à fixer cette poulie."
                            },
                            {
                                "example_id": "f308eb03-53ac-4a0a-8716-a4db1e7d2793",
                                "sense_id": "fce2ca34-b7d7-33cf-9ae0-37642b906e0d",
                                "text": "A défaut d’un tel œillet, ce cordage pourrait être relié à la manille ou au croc portés par l’hydravion au moyen d’une erse ou d’un double nœud d’écoute, avec génope à son extrémité."
                            }
                        ]
                    }
