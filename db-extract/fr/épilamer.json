                "senses": [
                    {
                        "sense_id": "a0b0299e-4549-3451-96b2-dbb99d4b56d9",
                        "entry_id": "74e028f1-4cdd-3f8a-86d7-e8907cacf356",
                        "glosses": [
                            "Déposer de l'épilame sur."
                        ],
                        "tags": [
                            "Horlogerie"
                        ],
                        "examples": [
                            {
                                "example_id": "86f572cf-3aeb-4afc-b09d-39137b37f421",
                                "sense_id": "a0b0299e-4549-3451-96b2-dbb99d4b56d9",
                                "text": "A l'heure actuelle, les mouvements étant nettoyés par le termineur, celui-ci pourra pour un prix très modique et sans changer pratiquement sa gamme de fabrication épilamer toutes ses pièces."
                            },
                            {
                                "example_id": "3dc5b26a-c273-4454-a187-74498da421a9",
                                "sense_id": "a0b0299e-4549-3451-96b2-dbb99d4b56d9",
                                "text": "Différentes constatations, notamment l'impossibilité d'épilamer les métaux précieux laissant supposer que l'hypothèse de l'oxydation de Willis était vraisemblablement exacte, on a préparé par oxydation dans des conditions bien particulières un dérivé polaire d'un dyméthylpolysiloxane dont un certain nombre de radicaux CH3 étaient oxydés."
                            }
                        ]
                    }
