                    {
                        "form_id": "b80c847e-3640-493f-bbbe-09d989e9e50f",
                        "entry_id": "30ed07a5-ec18-394d-a019-5b47a62eb9f2",
                        "tags": [
                            "vocative",
                            "plural"
                        ],
                        "form": "błonia"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8b52bc5c-bc7a-34f2-b8e2-6dbcd7292a0c",
                        "entry_id": "30ed07a5-ec18-394d-a019-5b47a62eb9f2",
                        "glosses": [
                            "mit Gras bewachsene, offene Fläche; Wiese"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d3e1a916-f698-4a8e-b8f1-cf0b0178fff9",
                                "sense_id": "8b52bc5c-bc7a-34f2-b8e2-6dbcd7292a0c",
                                "text": "„Ujrzała, zaśmiała się i klasnęła w dłonie, / Jak biały ptak zleciała s parkanu na błonie,“"
                            },
                            {
                                "example_id": "1c32dc2f-69d2-457c-917c-ed9970913462",
                                "sense_id": "8b52bc5c-bc7a-34f2-b8e2-6dbcd7292a0c",
                                "text": "„Wtém się coś zdala na polu ukaże, / Jakowiś ludzie biegą tu po błoniach, / A gałąź cieniu za każdym się czerni, / A biegą prędko, muszą być na koniach; / A świécą mocno, muszą być pancerni.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "926e5a86-1894-4b25-9d65-39e6cb183b4a",
                        "source_entry_id": "30ed07a5-ec18-394d-a019-5b47a62eb9f2",
                        "source_sense_id": "8b52bc5c-bc7a-34f2-b8e2-6dbcd7292a0c",
                        "source_sense_description": "mit Gras bewachsene, offene Fläche; Wiese",
                        "target_lang_word": "Wiese",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wiese",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "50d10afc-8ebb-300f-82ac-dc945a9e723b",
                                        "entry_id": "4e5dfb84-06c6-3a98-b332-025c2304d682",
                                        "glosses": [
                                            "gehölzfreie Grasfluren auf häufig feuchten Böden, in denen Gräser und Kräuter vorherrschen, meistens landwirtschaftlich durch Mähen zur Gewinnung von Heu oder Stalleinstreu oder als Weide genutzt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dacbe37d-6bad-427d-9e85-cf980dc571e3",
                                                "sense_id": "50d10afc-8ebb-300f-82ac-dc945a9e723b",
                                                "text": "Auf der Wiese vor unserem Haus kann man gut Frisbee spielen."
                                            },
                                            {
                                                "example_id": "6949c5a7-143f-4255-9262-b94d45018101",
                                                "sense_id": "50d10afc-8ebb-300f-82ac-dc945a9e723b",
                                                "text": "Die Wiesen bilden vor allem zur Beutejagd sowie zum Ruhen und Sonnen einen wichtigen Sommerlebensraum."
                                            },
                                            {
                                                "example_id": "045a2983-1bad-437d-b874-3a3791b4d242",
                                                "sense_id": "50d10afc-8ebb-300f-82ac-dc945a9e723b",
                                                "text": "„Die Wiesen sind Feuchtwiesen (Wasen) und leicht moorig.“"
                                            },
                                            {
                                                "example_id": "74834524-adaf-4016-9a65-36bcfc0fa81b",
                                                "sense_id": "50d10afc-8ebb-300f-82ac-dc945a9e723b",
                                                "text": "„Statt einer Antwort wedelte ich unverdrossen gegen Fliegenschwaden an, die aus den feuchten Wiesen in die letzten Sonnenstrahlen und in unsere Gesichter schwärmten.“"
                                            },
                                            {
                                                "example_id": "3c469321-055a-432c-99f1-4d3372233dc9",
                                                "sense_id": "50d10afc-8ebb-300f-82ac-dc945a9e723b",
                                                "text": "„Nach rechts hin, auf Blankenburg zu, lagen weite Wiesen und Ackerflächen, während unmittelbar zur Linken ein Waldschirm von geringer Tiefe stand, der unsere Reisenden von der steil abfallenden Talschlucht und der unten schäumenden Bode trennte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
