                "senses": [
                    {
                        "sense_id": "76399c41-3459-3075-af41-a7972274c777",
                        "entry_id": "14e0669d-8d67-3fa0-a1e8-65839223938f",
                        "glosses": [
                            "Qui donne une saveur douce et sucrée aux aliments."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "930f4d9a-b497-4c9e-857e-682ac054df15",
                                "sense_id": "76399c41-3459-3075-af41-a7972274c777",
                                "text": "Si une partie de la propriété édulcorante du sucre lui est enlevée pendant la pulvérisation, elle lui est rendue pendant sa transformation en sirop."
                            },
                            {
                                "example_id": "3e8ed48c-f216-4b0f-af0e-69aaaa25fb7e",
                                "sense_id": "76399c41-3459-3075-af41-a7972274c777",
                                "text": "Les arômes contribuent à rendre le produit agréable au palais, ce qui dépend essentiellement de la présence de produits laitiers ou de la matière édulcorante dans la formule."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6516cdbb-e385-4b51-9399-6e361bb1eba6",
                        "source_entry_id": "14e0669d-8d67-3fa0-a1e8-65839223938f",
                        "source_sense_id": "76399c41-3459-3075-af41-a7972274c777",
                        "target_lang_word": "sweetener",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sweetener",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5530eade-1a2a-3b9a-b76a-e176dc354a17",
                                        "entry_id": "f12e3cf9-dc0a-3902-ac73-457bd962456c",
                                        "glosses": [
                                            "Something added to food to sweeten its taste, especially an artificial substitute for sugar."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1586b6f0-3612-48c2-974a-5b70e428cfe9",
                                                "sense_id": "5530eade-1a2a-3b9a-b76a-e176dc354a17",
                                                "text": "Some examples of the sweeteners include aspartame, saccharin, sucralose and stevia. The W.H.O.’s announcement contradicts previous studies that have said these sweeteners don’t offer any health benefits but also do not cause harm."
                                            },
                                            {
                                                "example_id": "1d7d4e5f-f089-4143-bdc8-02520ccd5f4d",
                                                "sense_id": "5530eade-1a2a-3b9a-b76a-e176dc354a17",
                                                "text": "Even as FDA works to develop that plan, consumers continue to be exposed to unsafe food chemicals including not just dyes but also the artificial sweetener aspartame, the white pigment titanium dioxide, the preservative propylparaben, and the phthalate food packaging chemicals, according to CSPI."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4bb63ae0-1f53-3c11-9b20-d74c24231a9e",
                                        "entry_id": "f12e3cf9-dc0a-3902-ac73-457bd962456c",
                                        "glosses": [
                                            "Something given or added to added to a deal to sweeten another's attitude, especially a bribe or kickback."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e3bd4fc9-3897-3f42-b25d-53b1c734a386",
                                        "entry_id": "f12e3cf9-dc0a-3902-ac73-457bd962456c",
