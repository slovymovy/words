                        "glosses": [
                            "Relatif au peuple des Dogons ou au pays dogon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d34f0f1f-85d0-4b92-8996-131406076258",
                                "sense_id": "bcd0ecd3-6dd8-3abd-b037-7fbf17073ee8",
                                "text": "Ainsi, les jeunes filles dogonnes ne doivent pas regarder leur fiancé car l’amour se lit dans les yeux."
                            },
                            {
                                "example_id": "247a5457-c8fe-4b6d-ae5f-d76031c37a9f",
                                "sense_id": "bcd0ecd3-6dd8-3abd-b037-7fbf17073ee8",
                                "text": "Un vieillard vint à notre rencontre, lequel, d’après les explications d’Ousman, s’intitule hogon, et joue le rôle de guide spirituel dans les villages dogons."
                            }
                        ]
