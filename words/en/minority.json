{
    "word_family": [
        "minor"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "43455ed6-5736-31d8-a690-23e2f0c8b138",
                    "sense_definition": "Any subgroup within a society or collection that does not form a numerical majority.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "smaller_part",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Only a small <w>minority</w> of the students voted against the plan.",
                            "target_lang_translations": {
                                "ru": "Лишь небольшое <w>меньшинство</w> студентов проголосовало против плана.",
                                "zh": "只有一小<w>部分</w>学生投票反对该计划。"
                            }
                        },
                        {
                            "text": "English speakers are a <w>minority</w> in this region.",
                            "target_lang_translations": {
                                "ru": "Англоговорящие составляют <w>меньшинство</w> в этом регионе.",
                                "zh": "英语使用者在该地区属于<w>少数</w>。"
                            }
                        }
                    ],
                    "antonyms": [
                        "majority"
                    ],
                    "common_phrases": [
                        "ethnic minority",
                        "religious minority",
                        "small minority",
                        "significant minority"
                    ],
                    "target_lang_definitions": {
                        "ru": "Меньшая часть общества или группы, не составляющая численного большинства.",
                        "zh": "社会或群体中不占多数的较小部分。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "меньшинство",
                                "target_lang_sense_clarification": "численное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "少数",
                                "target_lang_sense_clarification": "数量上的较少部分"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1eca855e-826d-386b-943c-1c5db8d166fb",
                    "sense_definition": "A member of an ethnic or social minority group.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "smaller_part",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company is actively recruiting <w>minorities</w> for leadership roles.",
                            "target_lang_translations": {
                                "ru": "Компания активно нанимает представителей <w>меньшинств</w> на руководящие должности.",
                                "zh": "该公司正积极招聘<w>少数群体成员</w>担任领导职务。"
                            }
                        },
                        {
                            "text": "As one of the few <w>minorities</w> in the town, he sometimes felt isolated.",
                            "target_lang_translations": {
                                "ru": "Будучи одним из немногих представителей <w>меньшинств</w> в городе, он иногда чувствовал себя изолированным.",
                                "zh": "作为镇上为数不多的<w>少数群体成员</w>之一，他有时感到孤立。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "hiring minorities",
                        "visible minority"
                    ],
                    "target_lang_definitions": {
                        "ru": "Член этнической или социальной группы, составляющей меньшинство.",
                        "zh": "属于少数民族或少数群体的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "меньшинство",
                                "target_lang_sense_clarification": "социальная группа"
                            },
                            {
                                "target_lang_word": "представитель меньшинства",
                                "target_lang_sense_clarification": "человек"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "少数群体成员",
                                "target_lang_sense_clarification": "指代个人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "988fd51f-d1f3-36a1-b2f7-ac59fb958a64",
                    "sense_definition": "The state of being a minor; the period of a person's life prior to reaching legal adulthood.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "age_status",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The prince became king during his <w>minority</w>, so a regent ruled for him.",
                            "target_lang_translations": {
                                "ru": "Принц стал королем во время своего <w>несовершеннолетия</w>, поэтому за него правил регент.",
                                "zh": "王子在<w>未成年</w>时继位，因此由摄政王代为统治。"
                            }
                        },
                        {
                            "text": "She could not access the trust fund during her <w>minority</w>.",
                            "target_lang_translations": {
                                "ru": "Она не могла получить доступ к трастовому фонду во время своего <w>несовершеннолетия</w>.",
                                "zh": "她在<w>未成年</w>期间无法动用信托基金。"
                            }
                        }
                    ],
                    "synonyms": [
                        "childhood"
                    ],
                    "antonyms": [
                        "adulthood",
                        "majority"
                    ],
                    "common_phrases": [
                        "during his minority",
                        "in her minority"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "formal or legal context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Период жизни человека до достижения юридического совершеннолетия.",
                        "zh": "指未达到法定成年年龄的状态或时期。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "несовершеннолетие",
                                "target_lang_sense_clarification": "возраст"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "未成年",
                                "target_lang_sense_clarification": "法律状态"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "62db0161-afc9-3216-acdf-6cf560ac1d0d",
                    "sense_definition": "Of or relating to a minority group or interest.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "smaller_part",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>minority</w> opinion in the court case was written by the newest judge.",
                            "target_lang_translations": {
                                "ru": "Мнение <w>меньшинства</w> в судебном деле было написано самым новым судьей.",
                                "zh": "该案件中<w>少数派</w>的意见由最年轻的法官撰写。"
                            }
                        },
                        {
                            "text": "They hold a <w>minority</w> interest in the new startup.",
                            "target_lang_translations": {
                                "ru": "Они владеют <w>миноритарной</w> долей в новом стартапе.",
                                "zh": "他们持有该初创公司<w>少数</w>的股份。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "minority interest",
                        "minority shareholder",
                        "minority group"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к группе меньшинства или их интересам.",
                        "zh": "与少数群体或少数利益相关的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "меньшинства",
                                "target_lang_sense_clarification": "родительный падеж"
                            },
                            {
                                "target_lang_word": "миноритарный",
                                "target_lang_sense_clarification": "бизнес/финансы"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "少数派的",
                                "target_lang_sense_clarification": "观点或立场"
                            },
                            {
                                "target_lang_word": "少数的",
                                "target_lang_sense_clarification": "商业或股权"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8ee13dc2-900e-309a-a11f-026234847d7b",
                    "sense_definition": "Empowered by or representing less than half of the votes cast or legislative seats.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "smaller_part",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is often difficult for a <w>minority</w> government to pass new laws.",
                            "target_lang_translations": {
                                "ru": "Правительству <w>меньшинства</w> часто бывает трудно принимать новые законы.",
                                "zh": "<w>少数派</w>政府通常很难通过新法律。"
                            }
                        },
                        {
                            "text": "The <w>minority</w> leader criticized the new policy.",
                            "target_lang_translations": {
                                "ru": "Лидер <w>меньшинства</w> раскритиковал новую политику.",
                                "zh": "<w>少数派</w>领袖批评了这项新政策。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "minority government",
                        "minority leader"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сформированный или представленный менее чем половиной голосов или мест.",
                        "zh": "指在投票或议会席位中未占半数以上的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "меньшинства",
                                "target_lang_sense_clarification": "политический термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "少数派",
                                "target_lang_sense_clarification": "政治术语"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}