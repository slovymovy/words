                                        "entry_id": "1c979133-1984-3258-904e-f804e1b94a5d",
                                        "glosses": [
                                            "Angehöriger eines Heilhilfsberufes, der nach ärztlicher Verordnung physikalische Behandlungen anbietet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13cc8676-07a7-4b98-a701-7b20014c41dc",
                                                "sense_id": "0eccf996-f038-3637-9fdc-e743a7abd99a",
                                                "text": "Er ließ sich zum Physiotherapeuten ausbilden."
                                            },
                                            {
                                                "example_id": "f662bdb1-6eef-4252-9935-f23f514271bb",
                                                "sense_id": "0eccf996-f038-3637-9fdc-e743a7abd99a",
                                                "text": "Wenn du wieder Schmerzen hast, dann vereinbare doch einen Behandlungstermin beim Physiotherapeuten."
                                            },
                                            {
                                                "example_id": "daa269c0-cd73-43bd-954c-8e40ff23cb7a",
                                                "sense_id": "0eccf996-f038-3637-9fdc-e743a7abd99a",
                                                "text": "„Physiotherapeut ist hier ein Beruf fürs Leben, er ist zu Recht der Lieblingsarzt der Deutschen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
