    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "944c57ac-de5a-350b-a582-77828675bec8",
                "word": "fitment",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "477dddf8-b4a2-4713-983d-086895dac7ad",
                        "entry_id": "944c57ac-de5a-350b-a582-77828675bec8",
                        "tags": [
                            "plural"
                        ],
                        "form": "fitments"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c4ff82e9-eacc-33ce-88be-82223a26fe6b",
                        "entry_id": "944c57ac-de5a-350b-a582-77828675bec8",
                        "glosses": [
                            "A thing fitted to another in order to accomplish a specific purpose."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "942753fe-aec5-4049-a6ca-5559c4e6b319",
                                "sense_id": "c4ff82e9-eacc-33ce-88be-82223a26fe6b",
                                "text": "Bottles also usually incorporate a fitment, which provides a pouring spout."
                            }
                        ]
                    },
                    {
                        "sense_id": "cd9bbd78-2b41-3a8a-b199-48d6542c65b9",
                        "entry_id": "944c57ac-de5a-350b-a582-77828675bec8",
                        "glosses": [
                            "An item of permanent furniture or equipment."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "f2a67206-fc36-445e-9440-8fd4b2f4f791",
                                "sense_id": "cd9bbd78-2b41-3a8a-b199-48d6542c65b9",
                                "text": "Poor Mole! The Life Adventurous was so new a thing to him, and so thrilling; and this fresh aspect of it was so tempting; and he had fallen in love at first sight with the canary-coloured cart and all its little fitments."
                            },
                            {
                                "example_id": "f3b7c8e1-c535-42db-9640-f64d6533cf95",
                                "sense_id": "cd9bbd78-2b41-3a8a-b199-48d6542c65b9",
                                "text": "There might have been no planking beneath the mould, for all that our feet could feel. It gave under our tread with a spongy, puddingy feel. It covered the deck furniture of the old ship, so that the shape of each article and fitment was often no more than suggested through it."
                            },
                            {
                                "example_id": "4e799ed0-5698-4da5-a82f-72f6d6f24416",
                                "sense_id": "cd9bbd78-2b41-3a8a-b199-48d6542c65b9",
                                "text": "A good sanitary fitment should be of the simplest possible design, constructed so as to be self-cleansing, and, as far as possible, free from any moving working parts."
                            }
                        ]
                    },
                    {
                        "sense_id": "7dfd14cf-98c6-3006-a3ce-c2414317beda",
                        "entry_id": "944c57ac-de5a-350b-a582-77828675bec8",
                        "glosses": [
                            "The act of furnishing with fitments; an instance of such an act."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "a8b74e76-1138-4f57-8ffc-d0ad9ad18b4c",
                                "sense_id": "7dfd14cf-98c6-3006-a3ce-c2414317beda",
                                "text": "Upon such an indictment against the owner, charging him with fitting out the ship with intent to employ her in the illegal voyage, evidence is admissible, that he commanded, authorized, and superintended the fitment, through the instrumentality of his agents, without being personally present."
                            }
                        ]
                    },
                    {
                        "sense_id": "928ed5c5-c5d2-34ca-b6ed-5ee075bc3a4f",
                        "entry_id": "944c57ac-de5a-350b-a582-77828675bec8",
                        "glosses": [
                            "The proper positioning and orientation of a thing for it to serve its designed purpose."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "ae0c3b5b-a011-431c-9864-acb09f950d36",
                                "sense_id": "928ed5c5-c5d2-34ca-b6ed-5ee075bc3a4f",
                                "text": "He told Sancho to pick up the helmet, and he taking it in his hands said:\n\"By God the basin is a good one, and worth a real of eight if it is worth a maravedis,\" and handed it to his master, who immediately put it on his head, turning it round, now this way, now that, in search of fitment, and not finding it he said, \"Clearly the pagan to whose measure this famous head-piece was first forged must have had a very large head; but the worst of it is half of it is wanting.\""
                            }
                        ]
                    },
                    {
                        "sense_id": "f1d4f048-e0e2-39c8-a947-a550e1bdb6a4",
                        "entry_id": "944c57ac-de5a-350b-a582-77828675bec8",
                        "glosses": [
                            "The categorisation of an employee, for the purpose of calculating salary or allowances."
                        ],
                        "tags": [
                            "India",
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "78607bd8-c55b-4a55-9fbb-251634442596",
                                "sense_id": "f1d4f048-e0e2-39c8-a947-a550e1bdb6a4",
                                "text": "As already stated, the Wage Board had recommended revised wage scales, revised categories and fitment of workmen in their respective categories on the revised wage scales as from November 1, 1960."
                            }
                        ]
                    },
                    {
                        "sense_id": "f657624a-af20-3ebc-a754-885501bf34ac",
                        "entry_id": "944c57ac-de5a-350b-a582-77828675bec8",
                        "glosses": [
                            "Something that suits or fits."
                        ],
                        "tags": [
                            "archaic",
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "cb7d21b5-fce0-4b6d-ba2c-a31877d1dd20",
                                "sense_id": "f657624a-af20-3ebc-a754-885501bf34ac",
                                "text": "I am, sir,\nThe soldier that did company these three\nIn poor beseeming; 'twas a fitment for\nThe purpose I then follow'd."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
