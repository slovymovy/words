                    },
                    {
                        "form_id": "d9d8760b-9379-4fbf-b7ec-fed50278a724",
                        "entry_id": "557a3dba-e56b-3eda-b3fe-0daa22c42858",
                        "tags": [],
                        "form": "ferro-manganèse"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fe19c73e-9aab-3339-8216-09a8fb48b864",
                        "entry_id": "557a3dba-e56b-3eda-b3fe-0daa22c42858",
                        "glosses": [
                            "Ferroalliage à forte teneur en manganèse (au moins 65 % de la masse)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d99d038b-9e03-4683-920a-4800bdc9d968",
                                "sense_id": "fe19c73e-9aab-3339-8216-09a8fb48b864",
                                "text": "Ce n’est que par des additions répétées de spiegeleisen et de ferromanganèse que l’on peut arriver à un degré de désulfuration assez avancé pour que le produit final soit de bonne qualité."
                            },
                            {
                                "example_id": "06f4cd3c-b742-4228-b6e3-d46afb4f6185",
                                "sense_id": "fe19c73e-9aab-3339-8216-09a8fb48b864",
                                "text": "Le ferrosilicium est après le ferromanganèse, le produit le plus employé comme additif spécial dans l'industrie sidérurgique. Ces deux ferro-alliages remplissent en sidérurgie différentes fonctions, précises et distinctes, mais dans les cas où ils peuvent être utilisés indifféremment, le ferrosilicium s'impose précisément par son coût moins élevé."
                            },
                            {
                                "example_id": "b97a6be8-556d-4876-bf39-b853ba57eed8",
                                "sense_id": "fe19c73e-9aab-3339-8216-09a8fb48b864",
                                "text": "Le procédé de fabrication du ferromanganèse au haut-fourneau a été inventé en France (Pourcel 1885, 3-21-52) aux Forges de Terrenoire près de Saint-Etienne par la société éponyme en 1875."
                            },
                            {
                                "example_id": "e93c0236-b0c7-481e-836d-219a32f1b5ef",
                                "sense_id": "fe19c73e-9aab-3339-8216-09a8fb48b864",
                                "text": "Il y a deux familles d'alliages de manganèse, appelées ferromanganèse (FeMn) et silicomanganèse (SiMn)."
                            }
                        ]
                    }
                ],
