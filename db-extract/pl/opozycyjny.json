                        "source_sense_id": "2b5da1c4-117a-3e04-89bf-c2b5545efc81",
                        "target_lang_word": "oppositional",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "oppositional",
