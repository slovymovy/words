                                "target_senses": [
                                    {
                                        "sense_id": "af8de03d-312c-3b6b-8e76-8eeeba8be5ce",
                                        "entry_id": "eb6d347a-383e-3462-8d27-78a765417ffd",
                                        "glosses": [
                                            "An organized culture encompassing many communities, often on the scale of a nation or a people; a stage or system of social, political, or technical development."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "70dcaea4-e795-4670-a460-303daff775d5",
                                                "sense_id": "af8de03d-312c-3b6b-8e76-8eeeba8be5ce",
                                                "text": "the Aztec civilization"
                                            },
                                            {
                                                "example_id": "aa313ca8-a015-43e0-abf0-31406c075682",
                                                "sense_id": "af8de03d-312c-3b6b-8e76-8eeeba8be5ce",
                                                "text": "Western civilization"
                                            },
                                            {
                                                "example_id": "bc71a6b2-8fc6-4e9f-9646-564a781f3ad4",
                                                "sense_id": "af8de03d-312c-3b6b-8e76-8eeeba8be5ce",
                                                "text": "Modern civilization is a product of industrialization and globalization."
                                            },
                                            {
                                                "example_id": "2bb8f1ab-aa61-4d73-afb5-40ed268db63c",
                                                "sense_id": "af8de03d-312c-3b6b-8e76-8eeeba8be5ce",
                                                "text": "But civilizations, like the penis, rise and fall, and when the towers and battlements crumble into the earth, they return to the embrace of the Great Mother."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "80560df5-0441-342b-8a54-72d353e91fd5",
                                        "entry_id": "eb6d347a-383e-3462-8d27-78a765417ffd",
                                        "glosses": [
                                            "Human society, particularly civil society."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dbc2cce0-d165-488e-a3e0-6c024c406029",
                                                "sense_id": "80560df5-0441-342b-8a54-72d353e91fd5",
                                                "text": "A hermit doesn't much care for civilization."
                                            },
                                            {
                                                "example_id": "e76e5b49-f45a-4566-b8a5-27cd520d3dba",
                                                "sense_id": "80560df5-0441-342b-8a54-72d353e91fd5",
                                                "text": "I'm glad to be back in civilization after a day with that rowdy family."
                                            },
                                            {
                                                "example_id": "caa001da-5756-435c-9691-7dec879f1823",
                                                "sense_id": "80560df5-0441-342b-8a54-72d353e91fd5",
                                                "text": "Civilisation has imbued man's minds with false ideas of the evil of sex and its fulfilment."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7cf9ecff-3092-3544-ac01-db572986624b",
                                        "entry_id": "eb6d347a-383e-3462-8d27-78a765417ffd",
                                        "glosses": [
                                            "The act or process of civilizing or becoming civilized."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "95262953-906b-4eac-aee1-e02232793fb5",
                                                "sense_id": "7cf9ecff-3092-3544-ac01-db572986624b",
                                                "text": "The teacher's civilization of the child was no easy task."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "967d23c3-684e-35e9-b514-530bd858ebf8",
                                        "entry_id": "eb6d347a-383e-3462-8d27-78a765417ffd",
                                        "glosses": [
                                            "The state or quality of being civilized."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3556c8a1-804d-41a5-9cd5-83502551cae8",
                                                "sense_id": "967d23c3-684e-35e9-b514-530bd858ebf8",
                                                "text": "He was a man of great civilization."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9afb50c3-9f7e-3ae3-a727-8c0828c6b912",
                                        "entry_id": "eb6d347a-383e-3462-8d27-78a765417ffd",
                                        "glosses": [
                                            "The act of rendering a criminal process civil."
                                        ],
