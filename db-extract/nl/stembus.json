                    {
                        "translation_id": "e4d75617-e395-4690-bcd7-f05574789761",
                        "source_entry_id": "82b5fcda-aeb6-3fb7-8e80-ada7fa9791c1",
                        "source_sense_id": "8f38877a-9a6c-3b6a-b8e6-413773571296",
