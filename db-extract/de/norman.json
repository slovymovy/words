                ],
                "senses": [
                    {
                        "sense_id": "183c02fc-b344-3ad6-8a5a-91583c52f9aa",
                        "entry_id": "39576fc2-da15-3927-85e6-d4517e197742",
                        "glosses": [
                            "Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e758c45-c274-49f7-9ba8-763aa8b088e7",
                                "sense_id": "183c02fc-b344-3ad6-8a5a-91583c52f9aa",
                                "text": "Frau Norman ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "0ea5144e-9594-409c-b2a6-4807e4263f0c",
                                "sense_id": "183c02fc-b344-3ad6-8a5a-91583c52f9aa",
                                "text": "Herr Norman wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "564e9b5b-597f-46ab-8b44-d7ab21778a74",
                                "sense_id": "183c02fc-b344-3ad6-8a5a-91583c52f9aa",
                                "text": "Die Normans fahren heute nach Malmö."
                            },
                            {
                                "example_id": "6b357fb8-87c3-4db2-a5da-2bd434af3c11",
                                "sense_id": "183c02fc-b344-3ad6-8a5a-91583c52f9aa",
                                "text": "Der Norman trägt nie die Schals, die die Norman ihm strickt."
                            },
                            {
                                "example_id": "5b821d9a-36f9-42df-969e-1b5a6d49955f",
                                "sense_id": "183c02fc-b344-3ad6-8a5a-91583c52f9aa",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Norman kommt, geht der Herr Norman.“"
                            },
                            {
                                "example_id": "cf0b44fd-943f-44aa-8344-e68e0df11531",
                                "sense_id": "183c02fc-b344-3ad6-8a5a-91583c52f9aa",
                                "text": "Norman kommt und geht."
                            },
                            {
                                "example_id": "02ec31d2-a7e3-4a54-b598-004ab0cf4fc8",
                                "sense_id": "183c02fc-b344-3ad6-8a5a-91583c52f9aa",
                                "text": "Normans kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
