                ],
                "senses": [
                    {
                        "sense_id": "890c3870-d32a-37a5-89df-508b5f4fadab",
                        "entry_id": "63a659c8-75ff-3442-802b-cf14e162f851",
                        "glosses": [
                            "(nach Annahme der Vertreter der generativen Grammatik) beim Menschen genetisch angelegte Vorstellung darüber, was eine mögliche Grammatik ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "850a0bd4-c901-43c9-a1a6-58c578452a95",
                                "sense_id": "890c3870-d32a-37a5-89df-508b5f4fadab",
                                "text": "Zum Spracherwerbsmechanismus gehören elementare Regeln und Strukturen, die allen Sprachen eigen sind."
                            },
                            {
                                "example_id": "a23e1c28-2dec-47dd-8177-6b06c04ad418",
                                "sense_id": "890c3870-d32a-37a5-89df-508b5f4fadab",
                                "text": "„Die Schule Chomskys operiert mit der Annahme eines universalen Spracherwerbsmechanismus, einer angeborenen linguistischen Theorie als Grundlage der Spracherlernung.“"
                            },
                            {
                                "example_id": "a148159b-b329-40f4-89de-ffa79ac2e86c",
                                "sense_id": "890c3870-d32a-37a5-89df-508b5f4fadab",
                                "text": "„Zwei entgegengesetzte erkenntnistheoretische Standpunkte werden zur Beantwortung dieser Frage herangezogen: Der behavioristische Ansatz…und der nativistische Ansatz, die »innateness« Hypothese von einem angeborenen Spracherwerbsmechanismus...“"
                            },
                            {
                                "example_id": "219265dc-7fbc-4fe4-a7fa-c1e1bffe9e47",
                                "sense_id": "890c3870-d32a-37a5-89df-508b5f4fadab",
                                "text": "„Die Meinungen darüber, wie der Spracherwerbsmechanismus am besten zu charakterisieren sei, gehen weit auseinander.“"
                            },
                            {
                                "example_id": "b24260b4-6d1d-48bf-addf-6b35450778a7",
                                "sense_id": "890c3870-d32a-37a5-89df-508b5f4fadab",
                                "text": "„Dies führt Chomsky zu der Annahme eines Spracherwerbsmodells, in dem der Erwerb einer Grammatik abhängt von einem Spracherwerbsmechanismus (language acquisition device - LAD), dessen innere (angeborene) Struktur bestimmte Methoden der Analyse und prinzipielle Beschränkungen, die für jede mögliche Grammatik gelten, kennzeichnen…“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
