                    },
                    {
                        "sense_id": "33448a33-6ae4-3e15-969d-7049a651fc58",
                        "entry_id": "c3a01b03-0ec3-3b73-9b5a-5853a0acf9d8",
                        "glosses": [
                            "voltooid deelwoord van afgelasten"
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "f6064a9c-c99d-4f9f-93e5-f5bac3dc3ee2",
                                "sense_id": "33448a33-6ae4-3e15-969d-7049a651fc58",
                                "text": "De organisatie heeft de wandeltocht vanwege de hitte afgelast."
                            },
                            {
                                "example_id": "3f182df2-b90c-4fa2-870a-22942814f611",
                                "sense_id": "33448a33-6ae4-3e15-969d-7049a651fc58",
                                "text": "De wedstrijd werd afgelast wegens slecht veld."
                            },
                            {
                                "example_id": "c5e88dc0-bac2-4c6c-80c4-61ae49cefe65",
                                "sense_id": "33448a33-6ae4-3e15-969d-7049a651fc58",
                                "text": "Op de dag van haar ontmoeting met Salomé werd Hannah bij aankomst niet onthaald door het gebruikelijke rumoer dat vanuit de woonkamer te horen was, en had de voordeur van de woning niet opengestaan, dan had ze gedacht dat het feest op het laatste moment afgelast was."
                            },
                            {
                                "example_id": "b3c5053b-9b8c-4d1a-bab0-87b1eba3bdc8",
                                "sense_id": "33448a33-6ae4-3e15-969d-7049a651fc58",
                                "text": "En dit weekend is belangrijk voor ons, er worden al zo veel leuke dingen afgelast."
                            },
                            {
                                "example_id": "e9bb4c85-f8e8-4d8b-9fae-75e5ad9605eb",
                                "sense_id": "33448a33-6ae4-3e15-969d-7049a651fc58",
                                "text": "De afgelaste wedstrijd moet volgende week ingehaald worden."
                            },
                            {
                                "example_id": "22332c24-0c62-48f7-ae35-7169a68e6da0",
                                "sense_id": "33448a33-6ae4-3e15-969d-7049a651fc58",
                                "text": "Wegens ziekte zijn haar officiële verplichtingen voor deze week afgelast."
                            }
                        ]
                    }
