    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "bce961a3-c798-363b-b231-197be3c028f1",
                    "sense_definition": "Rendre une personne ou une atmosphère joyeuse et animée.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "joie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ses petites plaisanteries ont réussi à <w>égayer</w> toute la table pendant le dîner."
                        },
                        {
                            "text": "Une bonne nouvelle inattendue est venue <w>égayer</w> cette journée particulièrement difficile."
                        }
                    ],
                    "common_phrases": [
                        "égayer la conversation",
                        "égayer l'atmosphère"
                    ]
                },
                {
                    "sense_id": "e783ab3d-38d3-33f7-a792-37d29b3469b1",
                    "sense_definition": "Rendre un lieu, une tenue ou un objet plus attrayant et plus vivant en y ajoutant des touches de couleur ou d'agrément.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "embellissement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle a posé quelques coussins jaunes pour <w>égayer</w> le salon un peu trop sombre."
                        },
                        {
                            "text": "Ce joli foulard à motifs permet d'<w>égayer</w> une veste grise et terne."
                        }
                    ],
                    "common_phrases": [
                        "égayer une pièce",
                        "égayer une tenue"
                    ]
                },
                {
                    "sense_id": "5383a256-79ea-3e16-859d-49c1898f1b99",
                    "sense_definition": "Prendre du plaisir, se divertir ou plaisanter, parfois aux dépens de quelqu'un.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "joie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les enfants s'<w>égaient</w> dans le jardin dès l'apparition des premiers rayons de soleil."
                        },
                        {
                            "text": "Les collègues se sont longtemps <w>égayés</w> de la mésaventure de leur directeur."
                        }
                    ],
                    "synonyms": [
                        "s'amuser"
                    ],
                    "common_phrases": [
                        "s'égayer aux dépens"
                    ]
                },
                {
                    "sense_id": "8ec4394e-e0d5-33bd-8941-4781e02e524f",
                    "sense_definition": "Éclaircir les branches d'un arbre afin de laisser pénétrer l'air et la lumière.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "arboriculture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le jardinier doit <w>égayer</w> ce vieux pommier pour favoriser une belle récolte en automne."
                        },
                        {
                            "text": "Il a pris son sécateur afin d'<w>égayer</w> la couronne de l'arbre avant l'hiver."
                        }
                    ],
                    "common_phrases": [
                        "égayer un arbre"
                    ]
                }
            ]
        }
    ]
