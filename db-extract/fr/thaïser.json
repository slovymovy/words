                "senses": [
                    {
                        "sense_id": "30652d27-af6b-3582-aa4a-d81ad2498974",
                        "entry_id": "5940944e-4c89-3148-8442-320520fd91f8",
                        "glosses": [
                            "Donner un caractère thaï à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5094d73d-1d4e-4063-b762-2e60cc103852",
                                "sense_id": "30652d27-af6b-3582-aa4a-d81ad2498974",
                                "text": "Cette mobilité des populations déplacées a renforcé la « tradition » qui considère la région comme un réservoir régional de main-d’œuvre mobile et disponible sur des terres à « thaïser » le plus rapidement possible."
                            },
                            {
                                "example_id": "11ec3dc3-f3b2-49dd-b7e5-c16f16db831a",
                                "sense_id": "30652d27-af6b-3582-aa4a-d81ad2498974",
                                "text": "Les Chinois sont forcés de se « thaïser » au risque d’être expulsés, et la xénophobie devient l’une des composantes majeures de la politique d’un Phibun pour lequel constitutionnalisme et nationalisme sont pensés comme une idéologie d’État."
                            }
                        ]
                    }
