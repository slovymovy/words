{
    "word_family": [
        "glower"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "70d104a1-841a-3328-947d-1e31f4c7d850",
                    "sense_definition": "present participle and gerund of <w>glower</w>",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "glower",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The angry man was <w>glowering</w> at everyone who walked past his house.",
                            "target_lang_translations": {
                                "de": "Der wütende Mann <w>starrte</w> jeden <w>finster an</w>, der an seinem Haus vorbeiging."
                            }
                        },
                        {
                            "text": "She spent the entire meeting <w>glowering</w> at her boss in silence.",
                            "target_lang_translations": {
                                "de": "Sie verbrachte das gesamte Meeting damit, ihren Chef schweigend <w>finster anzustarren</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "scowling",
                        "glaring"
                    ],
                    "common_phrases": [
                        "glowering at"
                    ],
                    "target_lang_definitions": {
                        "de": "Jemanden mit einem wütenden oder finsteren Blick anstarren."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "finster anstarren",
                                "target_lang_sense_clarification": "jemanden mit einem bösen Blick fixieren"
                            },
                            {
                                "target_lang_word": "böse anschauen",
                                "target_lang_sense_clarification": "einen missbilligenden oder wütenden Blick zuwerfen"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2c46bacf-597d-3790-972d-fa33a0301bed",
                    "sense_definition": "The act of looking at someone or something with an angry or sullen expression.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "glower",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>glowering</w> from the teacher made the students stop talking immediately.",
                            "target_lang_translations": {
                                "de": "Der <w>finstere Blick</w> des Lehrers brachte die Schüler dazu, sofort mit dem Reden aufzuhören."
                            }
                        },
                        {
                            "text": "He ignored the <w>glowering</w> directed at him and continued his speech.",
                            "target_lang_translations": {
                                "de": "Er ignorierte den <w>bösen Blick</w>, der ihm galt, und setzte seine Rede fort."
                            }
                        }
                    ],
                    "synonyms": [
                        "scowl",
                        "glare"
                    ],
                    "common_phrases": [
                        "intense glowering"
                    ],
                    "target_lang_definitions": {
                        "de": "Der Akt, jemanden mit einem wütenden oder mürrischen Gesichtsausdruck anzusehen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "finsterer Blick",
                                "target_lang_sense_clarification": "ein mürrischer oder zorniger Ausdruck im Gesicht"
                            },
                            {
                                "target_lang_word": "böser Blick",
                                "target_lang_sense_clarification": "ein Ausdruck von Missfallen oder Wut"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}