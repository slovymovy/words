                "senses": [
                    {
                        "sense_id": "498a945a-237b-3c16-82b1-52ee6e1cd40d",
                        "entry_id": "72033a88-b88a-30bb-8f92-e44015f7a610",
                        "glosses": [
                            "Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6053009c-c27d-4b5a-ab9a-4b9efa169d40",
                                "sense_id": "498a945a-237b-3c16-82b1-52ee6e1cd40d",
                                "text": "Adamas kamen, sahen und siegten."
                            },
                            {
                                "example_id": "261c7c53-88e3-4594-8344-d75f74364675",
                                "sense_id": "498a945a-237b-3c16-82b1-52ee6e1cd40d",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Adama kommt, geht der Herr Adama.“"
                            },
                            {
                                "example_id": "cc3f85df-a504-4d8b-bc6c-63f0f607b46d",
                                "sense_id": "498a945a-237b-3c16-82b1-52ee6e1cd40d",
                                "text": "Adama kommt und geht."
                            },
                            {
                                "example_id": "8f722407-8cff-400f-a5ae-b0e1642ca985",
                                "sense_id": "498a945a-237b-3c16-82b1-52ee6e1cd40d",
                                "text": "Frau Adama ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "ccad46f2-3b87-4cd6-870c-8b006869e9dd",
                                "sense_id": "498a945a-237b-3c16-82b1-52ee6e1cd40d",
                                "text": "Herr Adama wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "c8a30fbf-4a13-43b3-9f3e-16a1a4725959",
                                "sense_id": "498a945a-237b-3c16-82b1-52ee6e1cd40d",
                                "text": "Die Adamas fliegen heute nach Liverpool."
                            },
                            {
                                "example_id": "5ef04017-164c-4bc6-a96d-a128bf2a2d39",
                                "sense_id": "498a945a-237b-3c16-82b1-52ee6e1cd40d",
                                "text": "Der Adama trägt nie die Pullover, die die Adama ihm strickt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
