            "senses": [
                {
                    "sense_id": "15150eb3-f657-3864-b652-520178b24534",
                    "sense_definition": "de uiteindelijke score of uitkomst van een wedstrijd, examen of onderzoek",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "resultaat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>uitslag</w> van de voetbalwedstrijd was een gelijkspel tussen beide teams.",
                            "target_lang_translations": {
                                "en": "The <w>result</w> of the football match was a draw between both teams.",
                                "ru": "<w>Результатом</w> футбольного матча стала ничья между обеими командами."
                            }
                        },
                        {
                            "text": "Zij wachtte vol spanning op de <w>uitslag</w> van haar medisch onderzoek.",
                            "target_lang_translations": {
                                "en": "She waited anxiously for the <w>results</w> of her medical examination.",
                                "ru": "Она с волнением ждала <w>результатов</w> своего медицинского обследования."
                            }
