                        "examples": [
                            {
                                "example_id": "da20954b-9dba-4ffa-94b1-d8ae882644de",
                                "sense_id": "9dbdda72-8452-31ed-beb1-35dced9e5dd2",
                                "text": "Лошади паслись в ночном и досыта наедались свежей молодой травы."
                            },
                            {
                                "example_id": "d68a29df-e2c2-4c43-8430-d6baf2921233",
                                "sense_id": "9dbdda72-8452-31ed-beb1-35dced9e5dd2",
                                "text": "А как только рассвело, он отправился в ночное, привёл сам лошадь, сам запряг её, толкнулся, чтобы разбудить старика, и стал укладывать котомку в телегу."
                            }
                        ]
