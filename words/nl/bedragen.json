    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "389e2356-5c31-30ff-a208-841643cccb79",
                    "sense_definition": "een bepaalde waarde, hoeveelheid of som geld hebben",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "hoeveelheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De totale kosten voor de verbouwing van de keuken <w>bedragen</w> ruim tienduizend euro.",
                            "target_lang_translations": {
                                "en": "The total costs for the kitchen renovation <w>amount to</w> over ten thousand euros."
                            }
                        },
                        {
                            "text": "Het <w>bedrag</w> <w>bedraagt</w> meer dan we oorspronkelijk hadden begroot voor dit project.",
                            "target_lang_translations": {
                                "en": "The amount <w>is</w> more than we had originally budgeted for this project."
                            }
                        }
                    ],
                    "common_phrases": [
                        "het bedrag bedraagt",
                        "de kosten bedragen",
                        "de winst bedraagt"
