                        "glosses": [
                            "Arbre de la famille des Fabacées, sous-famille des Mimosacées, également dénommé acacia de Constantinople ou arbre de soie, allusion au velouté de ses fleurs plumeuses. Il en existe 150 espèces environ."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ffe108ec-9134-48c6-974b-83ff54d85943",
                                "sense_id": "93d328fd-c46f-360f-85c5-633c3804efdd",
                                "text": "L’albizzia est un bel arbre ornemental au bois jaune utilisé en ébénisterie et pour la gravure sur bois."
                            },
                            {
                                "example_id": "00ec4e21-0e6d-4de5-98a3-f65acfcc75fa",
                                "sense_id": "93d328fd-c46f-360f-85c5-633c3804efdd",
                                "text": "L’albizzia est capable de fixer l’azote de l’air grâce à ses nodules racinaires."
                            }
                        ]
                    }
