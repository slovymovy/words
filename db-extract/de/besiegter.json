                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3067a899-ae05-481f-ac5a-95d10d164956",
                                "sense_id": "c95711b6-4444-3bc9-a2aa-3d573caa19cc",
                                "text": "„Jedenfalls liegt es im Wesen der Menschen, sich vorzustellen, dass die Besiegten irgendetwas getan haben müssen, womit sie ihr Verderben verdienen.“"
                            },
                            {
                                "example_id": "9ce6a934-2094-4034-bc32-3bd2ae513e65",
                                "sense_id": "c95711b6-4444-3bc9-a2aa-3d573caa19cc",
                                "text": "„›Das Wasser des Besiegten im Zweikampf gehört dem Gewinner‹, führte Chani aus.“"
                            }
                        ],
