                    },
                    {
                        "translation_id": "0cbba39c-ad80-46c8-b0ce-7c39651a1ba3",
                        "source_entry_id": "846fe1dc-4b62-3662-83f4-14824dd42c66",
                        "source_sense_id": "655fc105-931d-3c4a-8d98-d2223c4f3e58",
