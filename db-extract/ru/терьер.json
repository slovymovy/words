                    },
                    {
                        "translation_id": "8d59f4a9-fb94-4dc4-bd56-6b4843f75bf3",
                        "source_entry_id": "de70297d-a094-399a-bd47-482e13b817a8",
                        "source_sense_id": "0311d30b-b1ad-31d4-85c3-222019661147",
                        "target_lang_word": "Terrier",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Terrier",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ae0e4858-3eab-39b2-82c2-b363d3c46f3b",
                                        "entry_id": "3959d039-5324-37bd-8f55-b06d1082e4de",
                                        "glosses": [
                                            "kleiner bis mittelgroßer Hund"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae050b9b-f47a-4b82-af18-d8f4780c8c46",
                                                "sense_id": "ae0e4858-3eab-39b2-82c2-b363d3c46f3b",
                                                "text": "„Der Terrier legte sich in den Staub und beobachtete uns interessiert.“"
                                            },
                                            {
                                                "example_id": "1f16bc76-7999-4115-beba-af4a4b796cc7",
                                                "sense_id": "ae0e4858-3eab-39b2-82c2-b363d3c46f3b",
                                                "text": "„Wie ein Terrier schleppte ich sie stolz nach oben.“"
                                            },
                                            {
                                                "example_id": "937c052f-2f22-4e2e-b67a-087ff0f30d3a",
                                                "sense_id": "ae0e4858-3eab-39b2-82c2-b363d3c46f3b",
                                                "text": "„Teddy, der grauhaarige Terrier, der die Buchhandlung zu seinem Zuhause und den Sylvia zu ihrem Gefährten erkoren hatte, bellte fröhlich, als wollte er den Gruß seiner Herrin wiederholen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "15ad18d3-9295-4eb3-8936-5248192a2975",
                        "source_entry_id": "de70297d-a094-399a-bd47-482e13b817a8",
                        "source_sense_id": "0311d30b-b1ad-31d4-85c3-222019661147",
