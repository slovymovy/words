                    {
                        "translation_id": "e788c018-5620-4ab6-ad26-c61437227176",
                        "source_entry_id": "7f989c75-4491-39db-a91a-98ef5008d4e9",
                        "source_sense_description": "Process of being made liquid",
                        "target_lang_word": "liquéfaction",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "liquéfaction",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fdb74088-62e0-3153-93d5-428daa8c39df",
                                        "entry_id": "2344cc76-c409-3178-9ae7-ad1a5a841ade",
                                        "glosses": [
                                            "Changement d’état d’une substance qui, par l’effet de la température ou de la pression, passe de l’état solide ou gazeux à l’état liquide."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc8ccb0b-f360-4c08-a321-2eaf56fac4ef",
                                                "sense_id": "fdb74088-62e0-3153-93d5-428daa8c39df",
                                                "text": "Un terminal de regazéification représente un investissement de l'ordre de 500 millions de dollars pour une capacité similaire à un train de liquéfaction (quelques MT)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "202b10f2-5125-46a8-bcaf-3045daad8444",
                        "source_entry_id": "7f989c75-4491-39db-a91a-98ef5008d4e9",
                        "source_sense_description": "Process of being made liquid",
                        "target_lang_word": "Verflüssigung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verflüssigung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7b3732e8-0f81-3217-9913-e495bf5344ea",
                                        "entry_id": "3795394e-cc2d-3d84-b4ac-ec9e1ecef895",
                                        "glosses": [
                                            "Vorgang, bei dem etwas seine feste oder gasförmige Form, Konsistenz verliert und in einen flüssigen Zustand übergeht"
                                        ],
                                        "tags": [
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dd7f6344-1af9-4af0-b81d-3814574cd63c",
                                                "sense_id": "7b3732e8-0f81-3217-9913-e495bf5344ea",
                                                "text": "Wärme führt zur Verflüssigung der Eiswürfel."
                                            },
                                            {
                                                "example_id": "794d3c7a-6976-4707-bed4-1147cf0da29f",
                                                "sense_id": "7b3732e8-0f81-3217-9913-e495bf5344ea",
                                                "text": "„Für die Verflüssigung des Erdgases wird viel Energie benötigt.“"
                                            },
                                            {
                                                "example_id": "6603098a-f025-484a-a6e3-735a0c8c57d1",
                                                "sense_id": "7b3732e8-0f81-3217-9913-e495bf5344ea",
                                                "text": "„Neben dem Tsunami an der Küste der Stadt Palu war die Verflüssigung des Erdreichs die wohl schwerste Folgekatastrophe des Erdbebens.“"
                                            },
                                            {
                                                "example_id": "fd96d291-7c67-4103-abe6-f8b7d4ec41b6",
                                                "sense_id": "7b3732e8-0f81-3217-9913-e495bf5344ea",
                                                "text": "„Die Verflüssigung des Stuhls in Kombination mit der anregenden Wirkung auf die Darmtätigkeit macht Rizinusöl zu einem wirksamen Abführmittel.“"
                                            },
                                            {
                                                "example_id": "8e44d313-d703-4840-9be9-194dcd582381",
                                                "sense_id": "7b3732e8-0f81-3217-9913-e495bf5344ea",
                                                "text": "„Auf am Samstag veröffentlichten Aufnahmen ist die Verflüssigung des Bodens und das anschließende Versinken von Gebäuden nachzuvollziehen.“"
                                            },
                                            {
                                                "example_id": "3606a082-5db6-41cb-980e-c0974769a34f",
                                                "sense_id": "7b3732e8-0f81-3217-9913-e495bf5344ea",
                                                "text": "„Diese Unternehmen setzen Kompressoren zur Erhöhung von Druck, zur Verringerung von Volumen und zur Kühlung oder zur Verflüssigung von Gasen, wie Kohlenwasserstoff- und Industriegasen ein.“"
                                            },
                                            {
                                                "example_id": "d6438767-6d9a-4a96-974b-d904b590bca4",
                                                "sense_id": "7b3732e8-0f81-3217-9913-e495bf5344ea",
                                                "text": "„Sorgen Sie dafür, dass das Fernsehpublikum Rudy Giuliani bei der Verflüssigung seines Haarfärbemittels unter tropischer Sonne zuschauen kann und Richard Grenell beim kontinuierlichen Missachten diplomatischer Anstandsregeln im Umgang mit den Einheimischen.“"
                                            },
                                            {
                                                "example_id": "b882b6d2-ab78-4e33-aec3-eb6a8c16ffb8",
                                                "sense_id": "7b3732e8-0f81-3217-9913-e495bf5344ea",
                                                "text": "„Am häufigsten soll sich die Verflüssigung in Gebieten ereignen, die nah am Meer liegen und in denen deshalb der Grundwasserspiegel hoch ist.“"
                                            },
                                            {
                                                "example_id": "2f176a43-60e7-4462-88cd-803545c8e4ae",
                                                "sense_id": "7b3732e8-0f81-3217-9913-e495bf5344ea",
                                                "text": "„Erst im Mund sollen sich die Fasern durch die Scherkräfte zwischen Zunge und Gaumen parallel ausrichten und damit die Verflüssigung der Schokolade beschleunigen, wobei idealerweise gleichzeitig die gewünschten Aromastoffe freigesetzt würden.“"
                                            },
                                            {
                                                "example_id": "d22796e7-d5b0-4f51-9cee-577b9bd36e41",
                                                "sense_id": "7b3732e8-0f81-3217-9913-e495bf5344ea",
                                                "text": "„Das Geschäft mit der Vorbeugung von Verflüssigungen von Dämmen biete noch ‚Raum für großes Wachstum‘.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "520dce50-cf64-3efa-ad92-ce51279e2490",
                                        "entry_id": "3795394e-cc2d-3d84-b4ac-ec9e1ecef895",
                                        "glosses": [
                                            "Aufheben von festen, starren Strukturen, Grenzen oder Ähnlichem"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ceb128f3-7b83-4efa-98c5-066d072a8007",
                                                "sense_id": "520dce50-cf64-3efa-ad92-ce51279e2490",
                                                "text": "„Globalisierung, so der Leitbegriff der neuen Ordnung, lief auf Verflüssigung der Grenzen hinaus.“"
                                            },
                                            {
                                                "example_id": "c6438b36-c4b5-451e-8e1f-7d445c08f384",
                                                "sense_id": "520dce50-cf64-3efa-ad92-ce51279e2490",
                                                "text": "„In diesem Moment der Verflüssigung, den China nach der Kulturrevolution erlebte, vor allem in den fünf Jahren zwischen 1976 und 1981, stellte die Kommunistische Partei nicht nur die Weichen für ihren oft beschriebenen Schwenk zur Marktwirtschaft.“"
                                            },
                                            {
                                                "example_id": "89271c7b-4cb3-47db-a847-74c9d3f749c6",
                                                "sense_id": "520dce50-cf64-3efa-ad92-ce51279e2490",
                                                "text": "„Von dieser Verflüssigung der Klassengrenzen in der – nach Helmut Schelsky – ‚nivellierten Mittelstandsgesellschaft‘ ist die Wahrnehmung der Babyboomer offensichtlich immer noch geprägt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "25c7ebfb-cee6-3eec-809c-94c9101a8b37",
                                        "entry_id": "3795394e-cc2d-3d84-b4ac-ec9e1ecef895",
                                        "glosses": [
                                            "Ereignis, bei dem etwas wieder in normalem Tempo – also ohne Anhalten – ablaufen kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a8bfbb2-8b0b-44f6-874f-dfe4b9026dc6",
                                                "sense_id": "25c7ebfb-cee6-3eec-809c-94c9101a8b37",
                                                "text": "„Engpässe beim Aufbau einer Ladeinfrastruktur müssten vermieden werden, an der ‚Vernetzung zur intelligenten Verflüssigung‘ des Verkehrs müsse gearbeitet werden.“"
                                            },
                                            {
                                                "example_id": "30880de1-7d97-40f3-8747-4e49a24a464d",
                                                "sense_id": "25c7ebfb-cee6-3eec-809c-94c9101a8b37",
                                                "text": "„Dazu könnten zum Beispiel Parkverbote gehören, die Verflüssigung des Verkehrs, der Ausbau von Park and Ride, die Umstellung von Abfallwagen auf Erdgas oder die Nachrüstung städtischer Busse.“"
                                            },
                                            {
                                                "example_id": "39bc583f-f80e-48af-a93c-410fc70a9ea9",
                                                "sense_id": "25c7ebfb-cee6-3eec-809c-94c9101a8b37",
                                                "text": "„Kurzfristig kann die Beseitigung von Engstellen oder Staufallen zur Verflüssigung des Straßenverkehrs beitragen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "7927b993-3a7d-305e-b05c-e337745822bd",
                                        "entry_id": "3795394e-cc2d-3d84-b4ac-ec9e1ecef895",
                                        "glosses": [
                                            "Rückverwandlung von Vermögensobjekten in Geld"
                                        ],
                                        "tags": [
                                            "finance"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
