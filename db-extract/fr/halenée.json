                        "glosses": [
                            "Haleine accompagnée d'une odeur forte et désagréable."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "be1fed7c-d7bb-46c5-9870-ee87ccb371b1",
                                "sense_id": "489ef6f4-9b03-3089-96d2-1cb001584379",
                                "text": "Il m’a donné une halenée de vin, une halenée d’ail."
                            },
                            {
                                "example_id": "1960d8e2-9b92-4a66-aeba-1b2b82ef1d24",
                                "sense_id": "489ef6f4-9b03-3089-96d2-1cb001584379",
                                "text": "Une sueur mauvaise, une halenée fétide et courte, des coliques inavouables, des tremblements incontrôlés lui tiennent compagnie et le laissent égrotant sur son lit de souffrances."
                            }
                        ]
                    },
