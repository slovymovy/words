        "ru-extract.jsonl": [
            {
                "entry_id": "f5be6bd3-fc17-367b-aeab-b89261cb0d2a",
                "word": "опять-таки",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "c1ef2d17-d713-323c-a5cc-aa6181e2a2db",
                        "entry_id": "f5be6bd3-fc17-367b-aeab-b89261cb0d2a",
                        "glosses": [
                            "разг. то же, что опять"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1e668ce-9217-49c0-8dfa-61c3d7996f27",
                                "sense_id": "c1ef2d17-d713-323c-a5cc-aa6181e2a2db",
                                "text": "― Да ведь это опять-таки с какой точки зрения посмотреть на предмет!"
                            },
                            {
                                "example_id": "1e16a8a0-d8a1-4a55-9b75-655ba8ab236a",
                                "sense_id": "c1ef2d17-d713-323c-a5cc-aa6181e2a2db",
                                "text": "Правда это или нет ― читатель опять-таки увидит далее…"
                            },
                            {
                                "example_id": "ee7eb333-04ec-4785-ac96-4e97b30b262b",
                                "sense_id": "c1ef2d17-d713-323c-a5cc-aa6181e2a2db",
                                "text": "Пути, дескать, не будет. Опять-таки вздор. Опять ерунда."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5c06ccea-a0bd-48a9-86c0-f434ea00ba12",
                        "source_entry_id": "f5be6bd3-fc17-367b-aeab-b89261cb0d2a",
                        "source_sense_id": "c1ef2d17-d713-323c-a5cc-aa6181e2a2db",
                        "target_lang_word": "de nouveau",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "de nouveau",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f953c474-c219-3919-8b5e-b0a8c01e8f35",
                                        "entry_id": "197e4a05-2a2c-3ef1-a007-742ac4c67b49",
                                        "glosses": [
                                            "Une fois de plus, encore une fois."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "51eadf56-fd0b-464b-a0ac-91ea46b7bb21",
                                                "sense_id": "f953c474-c219-3919-8b5e-b0a8c01e8f35",
                                                "text": "[…]; il ôtait son grand habit noisette, remettait sa perruque dans la boîte et tirait de nouveau son bonnet de soie sur ses oreilles, en disant : […]."
                                            },
                                            {
                                                "example_id": "4fc6fbb4-9744-42a9-883e-ce6443bc5156",
                                                "sense_id": "f953c474-c219-3919-8b5e-b0a8c01e8f35",
                                                "text": "Cette parole, dite spontanément et avec candeur, me fit comprendre que tout était vrai dans le récit de Mongenod ; je lui tendis alors la main, et nous nous embrassâmes de nouveau."
                                            },
                                            {
                                                "example_id": "93eb3876-5ee5-4760-9734-707fbb5b847d",
                                                "sense_id": "f953c474-c219-3919-8b5e-b0a8c01e8f35",
                                                "text": "Supprimé en 1870, rétabli par l'Assemblée nationale, le cautionnement est de nouveau supprimé pour tous les journaux sans distinction, par la loi de 1881."
                                            },
                                            {
                                                "example_id": "0ca2a647-2915-4ee2-a09f-1c0bf52c84f6",
                                                "sense_id": "f953c474-c219-3919-8b5e-b0a8c01e8f35",
                                                "text": "La brume nous enveloppa de nouveau, bien que le soleil brillât dans une échappée de ciel au dessus de nos têtes."
                                            },
                                            {
                                                "example_id": "4283f06a-72d9-42f0-afd6-7599e5eaaea9",
                                                "sense_id": "f953c474-c219-3919-8b5e-b0a8c01e8f35",
                                                "text": "Le ciel s’est nettoyé de tous nuages. Le bleu de la nuit glacée pèse sur les vitres, gicle dans la voiture, ternit le pare-brise, fleurit de diamants les glaces arrière. Bazalo se penche sur le volant pour déchiffrer la route. Le point rouge de sa cigarette danse au dehors, devant lui, au milieu d’une ronde d’étoiles. Les phares promènent une étroite lumière sur la neige éblouie qui s’ensevelit de nouveau sous la nuit."
                                            },
                                            {
                                                "example_id": "b1f971a5-33b4-446b-8129-ff81db38cc6b",
                                                "sense_id": "f953c474-c219-3919-8b5e-b0a8c01e8f35",
                                                "text": "En hésitant beaucoup, elle finit par expliquer que depuis quelques jours les hommes de l’île les harcelaient de nouveau."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7df7b36e-2736-4997-84d2-aa7254a19e5b",
                        "source_entry_id": "f5be6bd3-fc17-367b-aeab-b89261cb0d2a",
                        "source_sense_id": "c1ef2d17-d713-323c-a5cc-aa6181e2a2db",
                        "target_lang_word": "encore",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "encore",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "54b20fba-e6e9-3a25-80ba-bbbaca2f3a0f",
                                        "entry_id": "bf701da7-1be4-34a1-ab64-0bed5b248054",
                                        "glosses": [
                                            "Qui sert à marquer que l’action ou l’état dont il s’agit se continue, se continuera ou s’est continué jusqu’au temps indiqué par le verbe ou par les autres circonstances du discours. Pour la négation, voir pas encore."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "548f2f2a-df37-4784-b006-6b863ffeeb30",
                                                "sense_id": "54b20fba-e6e9-3a25-80ba-bbbaca2f3a0f",
                                                "text": "Elle vit encore."
                                            },
                                            {
                                                "example_id": "0e3f6a03-366b-4e46-8b3d-3e3efb6f6303",
                                                "sense_id": "54b20fba-e6e9-3a25-80ba-bbbaca2f3a0f",
                                                "text": "Il est encore au lit."
                                            },
                                            {
                                                "example_id": "bba56e6e-0272-44f0-b4c2-69f94d5ed4e0",
                                                "sense_id": "54b20fba-e6e9-3a25-80ba-bbbaca2f3a0f",
                                                "text": "Il n’était pas mort, il respirait encore."
                                            },
                                            {
                                                "example_id": "ed468902-d94d-4f85-83a9-246aee4a944c",
                                                "sense_id": "54b20fba-e6e9-3a25-80ba-bbbaca2f3a0f",
                                                "text": "Il ne sera encore que sous-officier l’an prochain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "922940d2-7644-3547-8094-5c271583cf7c",
                                        "entry_id": "bf701da7-1be4-34a1-ab64-0bed5b248054",
                                        "glosses": [
                                            "De nouveau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19891170-5aba-4980-bcdd-15a4219456eb",
                                                "sense_id": "922940d2-7644-3547-8094-5c271583cf7c",
                                                "text": "Donnez-nous encore à boire."
                                            },
                                            {
                                                "example_id": "d95c1320-f261-45f6-ac0e-eb4966e93e9e",
                                                "sense_id": "922940d2-7644-3547-8094-5c271583cf7c",
                                                "text": "Je veux encore essayer si je pourrai réussir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cfb45e15-9d36-3022-8118-58d48734617d",
                                        "entry_id": "bf701da7-1be4-34a1-ab64-0bed5b248054",
                                        "glosses": [
                                            "Aussi ; de plus."
                                        ],
                                        "tags": [],
                                        "note": "En particulier, il s’emploie dans ce sens avec la conjonction mais (dans mais encore), par opposition à non seulement",
                                        "examples": [
                                            {
                                                "example_id": "113d8d81-85c6-47a1-962d-3d72a7445457",
                                                "sense_id": "cfb45e15-9d36-3022-8118-58d48734617d",
                                                "text": "C’est que Marguerite était non-seulement la plus belle, mais encore la plus lettrée des femmes de son temps, […]."
                                            },
                                            {
                                                "example_id": "8fad1ada-ab3b-4652-9d81-6f59d22c37ac",
                                                "sense_id": "cfb45e15-9d36-3022-8118-58d48734617d",
                                                "text": "Notons qu'il existe, entre les deux races, quelques exemples d'un type mixte : voici un putto couronné de lierre dont la tête fait penser à celle d'un satyreau, ou, mieux encore, un putto sur le point de se métamorphoser en satyreau, […]."
                                            },
                                            {
                                                "example_id": "da68ddc9-0367-445a-bc81-20fe85ffc80e",
                                                "sense_id": "cfb45e15-9d36-3022-8118-58d48734617d",
                                                "text": "Outre l’ordre qu’on lui avait donné, on lui commanda encore de… — On ajoute encore à cela que…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3946b3fd-a0ef-31b3-8f15-79d12efe5ac7",
                                        "entry_id": "bf701da7-1be4-34a1-ab64-0bed5b248054",
                                        "glosses": [
                                            "Il se joint aux adverbes plus (encore plus), ou moins (encore moins), lorsqu’on veut exprimer qu’une quantité, qu’une chose est supérieure ou inférieure à une autre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2741600d-fb80-4cc2-bbb2-f8cef14db89e",
                                                "sense_id": "3946b3fd-a0ef-31b3-8f15-79d12efe5ac7",
                                                "text": "On ne lui aurait pas permis de pénétrer, ce jour-là, dans l’enceinte palissadée et encore moins de chercher des morts parmi les ruines."
                                            },
                                            {
                                                "example_id": "d2d09103-0581-42fa-8c2c-861e88781426",
                                                "sense_id": "3946b3fd-a0ef-31b3-8f15-79d12efe5ac7",
                                                "text": "Il est encore plus riche que son frère."
                                            },
                                            {
                                                "example_id": "ddf8dddb-be14-4845-8c31-c5afb1cf9be3",
                                                "sense_id": "3946b3fd-a0ef-31b3-8f15-79d12efe5ac7",
                                                "text": "Ils ont déjà beaucoup obtenu, mais ils veulent plus encore."
                                            },
                                            {
                                                "example_id": "a6737d3a-ad45-47f3-b661-4089f1e63166",
                                                "sense_id": "3946b3fd-a0ef-31b3-8f15-79d12efe5ac7",
                                                "text": "Ils exigent encore plus, encore davantage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ab30fa3c-6c88-3d09-b045-711a6a2d6d29",
                                        "entry_id": "bf701da7-1be4-34a1-ab64-0bed5b248054",
                                        "glosses": [
                                            "Se joint d’une façon analogue à certains verbes qui marquent l’augmentation ou la diminution."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "78c7ad8c-0174-40e6-b3d7-da3124213342",
                                                "sense_id": "ab30fa3c-6c88-3d09-b045-711a6a2d6d29",
                                                "text": "Cela augmentait encore sa tristesse."
                                            },
                                            {
                                                "example_id": "dbaf7324-f366-4507-9b3c-a87353fc4f4d",
                                                "sense_id": "ab30fa3c-6c88-3d09-b045-711a6a2d6d29",
                                                "text": "Cela réduit encore son revenu, déjà si modique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a5e2b65b-0d61-3da8-8129-633a01b232c6",
                                        "entry_id": "bf701da7-1be4-34a1-ab64-0bed5b248054",
                                        "glosses": [
                                            "Se place au commencement d’une phrase où l’on exprime une restriction qui enchérit sur ce qu’on vient de dire."
                                        ],
                                        "tags": [],
                                        "note": "Avec l’inversion sujet-verbe",
                                        "examples": [
                                            {
                                                "example_id": "ba131e7b-16eb-4fd9-9088-11b6a3020a93",
                                                "sense_id": "a5e2b65b-0d61-3da8-8129-633a01b232c6",
                                                "text": "Ce mot n’est guère usité que dans telle science, encore ne l’emploie-t-on que rarement."
                                            },
                                            {
                                                "example_id": "e9a19f39-fc24-4a03-8063-bed95330a97c",
                                                "sense_id": "a5e2b65b-0d61-3da8-8129-633a01b232c6",
                                                "text": "Vous avez le droit d’agir ainsi, encore faut-il que vous préveniez les intéressés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "489c59d0-0b60-3055-915c-09bb3a1a4cbc",
                                        "entry_id": "bf701da7-1be4-34a1-ab64-0bed5b248054",
                                        "glosses": [
                                            "Au moins. Du moins."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cfac38c3-fe58-45c0-814c-d47876c4f3b5",
                                                "sense_id": "489c59d0-0b60-3055-915c-09bb3a1a4cbc",
                                                "text": "Si encore il voulait céder sur ce point, on pourrait lui accorder le reste."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6feba163-afdb-3ff8-a88e-324813ed57d1",
                                        "entry_id": "bf701da7-1be4-34a1-ab64-0bed5b248054",
                                        "glosses": [
                                            "S’emploie aussi comme une sorte d’interjection, lorsqu’on reproche à quelqu’un une récidive."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c902049b-0753-4f06-860f-b31c657d5f6f",
                                                "sense_id": "6feba163-afdb-3ff8-a88e-324813ed57d1",
                                                "text": "Eh quoi ! Encore ! ou tout simplement, Encore !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "25bd7096-eda8-3d22-857c-76f1b5f69215",
                                        "entry_id": "bf701da7-1be4-34a1-ab64-0bed5b248054",
                                        "glosses": [
                                            "Cependant ; toutefois."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae7d6182-78b4-40a9-8e96-f684b1a9f424",
                                                "sense_id": "25bd7096-eda8-3d22-857c-76f1b5f69215",
                                                "text": "« De toutes les aberrations sexuelles, la plus singulière est encore la chasteté » , disait Remy de Gourmont.\nSes contemporains étaient de son avis. Dieu merci !"
                                            },
                                            {
                                                "example_id": "41f87763-1bd3-4515-82bc-e11f6dc52c42",
                                                "sense_id": "25bd7096-eda8-3d22-857c-76f1b5f69215",
                                                "text": "Vous dites que ce n’est rien, mais encore…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d9e390ed-3940-39a7-a65e-fb8cd2bf85ea",
                                        "entry_id": "bf701da7-1be4-34a1-ab64-0bed5b248054",
                                        "glosses": [
                                            "Souligne le pire en comparant le mauvais à celui-ci."
                                        ],
                                        "tags": [],
                                        "note": "En particulier lorsque cette hiérarchisation est subjective ou ne va pas de soi",
                                        "examples": [
                                            {
                                                "example_id": "2a3b524a-a101-4267-865a-40684ee71c2c",
                                                "sense_id": "d9e390ed-3940-39a7-a65e-fb8cd2bf85ea",
                                                "text": "Il déteste tellement les crachins qu'il préfère encore les gros orages."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fd48a059-0f7d-41b9-a383-602c1915e9cc",
                        "source_entry_id": "f5be6bd3-fc17-367b-aeab-b89261cb0d2a",
                        "source_sense_id": "c1ef2d17-d713-323c-a5cc-aa6181e2a2db",
                        "target_lang_word": "tout de même",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tout de même",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "81755bec-0ab4-3cc0-a5ec-e19ecccb17b3",
                                        "entry_id": "9900956d-642e-3b36-b3ee-ae470fa97ca8",
                                        "glosses": [
                                            "De la même manière."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80e6b715-8c40-48a1-92e7-16c6bd753888",
                                                "sense_id": "81755bec-0ab4-3cc0-a5ec-e19ecccb17b3",
                                                "text": "Il aurait pu réussir tout de même avec d’autres moyens."
                                            },
                                            {
                                                "example_id": "ae2a6201-be4c-46cb-ace7-ee562b370b5e",
                                                "sense_id": "81755bec-0ab4-3cc0-a5ec-e19ecccb17b3",
                                                "text": "Thomas Diafoirus – Mademoiselle, ne plus ne moins que la statue de Memnon rendoit un son harmonieux lorsqu'elle venoit à être éclairée des rayons du soleil, tout de même me sens-je animé d'un doux transport à l'apparition du soleil de vos beautés."
                                            },
                                            {
                                                "example_id": "8d364401-e6dd-40b1-a3e7-1013e1dbf113",
                                                "sense_id": "81755bec-0ab4-3cc0-a5ec-e19ecccb17b3",
                                                "text": "Toute la journée dans un baquet jusqu’à mi-corps, à la pluie, à la neige, avec le vent qui vous coupe la figure ; quand il gèle, c’est tout de même, il faut laver ; il y a des personnes qui n’ont pas beaucoup de linge et qui attendent après ; si on ne lavait pas, on perdrait des pratiques."
                                            },
                                            {
                                                "example_id": "afa71e0e-4ce4-471f-9d44-02d5f6e51033",
                                                "sense_id": "81755bec-0ab4-3cc0-a5ec-e19ecccb17b3",
                                                "text": "Elle entoure d’un bras la taille du jeune dieu, et, d’une main agile, tâtant sous la feuillée le fragile objet dérobé aux regards, le découvre, le débarrasse, en fait jaillir la pulpe charnue, tout de même qu’elle s’y fût prise pour peler des châtaignes."
                                            },
                                            {
                                                "example_id": "7731909f-83df-4f9e-9ec0-af14aee52ef8",
                                                "sense_id": "81755bec-0ab4-3cc0-a5ec-e19ecccb17b3",
                                                "text": "Elle sortit de l’Hospice tout de même qu’elle y était entrée, très vite, sans parler à personne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dcc1fbde-2592-32f4-a7e9-9fe3bbb93e44",
                                        "entry_id": "9900956d-642e-3b36-b3ee-ae470fa97ca8",
                                        "glosses": [
                                            "Malgré ce qui vient d’être dit, en dépit de ce qui est arrivé ou pourrait arriver."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f67381a-1022-41e4-8bf3-fafd29429c07",
                                                "sense_id": "dcc1fbde-2592-32f4-a7e9-9fe3bbb93e44",
                                                "text": "Il ne s'était rien passé entre eux à proprement parler, mais ce dimanche avait été teinté de complicité, presque rien, mais tout de même trop."
                                            },
                                            {
                                                "example_id": "e56f1dca-1f92-49d0-a794-ef7cb186f127",
                                                "sense_id": "dcc1fbde-2592-32f4-a7e9-9fe3bbb93e44",
                                                "text": "— On arrivera peut-être à faire quelque chose de toi, tout de même.\n— Oui, si les petits cochons ne me mangent pas..."
                                            },
                                            {
                                                "example_id": "f8f76bc3-7ece-4e6b-9ad1-3aac11f7cf39",
                                                "sense_id": "dcc1fbde-2592-32f4-a7e9-9fe3bbb93e44",
                                                "text": "Il a fait tout ce qu’il fallait pour échouer ; il a réussi tout de même."
                                            },
                                            {
                                                "example_id": "6ef3ec20-0ae9-4004-b605-eaa51a06f740",
                                                "sense_id": "dcc1fbde-2592-32f4-a7e9-9fe3bbb93e44",
                                                "text": "Quoique vous soyez en retard, entrez tout de même."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1236f8cd-f5d2-3145-abef-dd1a5f4563ba",
                                        "entry_id": "9900956d-642e-3b36-b3ee-ae470fa97ca8",
                                        "glosses": [
                                            "Pour renforcer une expression, pour insister ou pour protester."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2572971f-f393-400b-a33f-f516d5030a0b",
                                                "sense_id": "1236f8cd-f5d2-3145-abef-dd1a5f4563ba",
                                                "text": "Clara, seule. — Ah, çà ! est-ce qu’il croit que si j’avais voulu mal tourner je l’aurais attendu ? Non, mais tout de même !…"
                                            },
                                            {
                                                "example_id": "283d8588-55c7-4e29-adf0-1046ea3d7377",
                                                "sense_id": "1236f8cd-f5d2-3145-abef-dd1a5f4563ba",
                                                "text": "Elle aimait aussi à répéter « tout de même », qu’elle prononçait « tout te même », d’une façon que je n’ai plus entendue, où l’accent nasal prenait un air impertinent et bon enfant à la fois."
                                            },
                                            {
                                                "example_id": "caec58b2-40d3-4d49-85a8-4ac9cec172cc",
                                                "sense_id": "1236f8cd-f5d2-3145-abef-dd1a5f4563ba",
                                                "text": "Cet intérieur de célibataire, tout de même, ça manquait de ménage. Cette table de bois nu, jamais lessivée sans doute, et ce papier des murs méritait d'être changé."
                                            },
                                            {
                                                "example_id": "e70edb87-efa8-4b34-b94b-28493cba951c",
                                                "sense_id": "1236f8cd-f5d2-3145-abef-dd1a5f4563ba",
                                                "text": "— Tout de même… tout de même… Venir t’annoncer une chose pareille. Il faut vraiment que cette fille soit… il faut qu’elle n’ait pas de honte."
                                            },
                                            {
                                                "example_id": "0991338d-6b23-4bc8-b575-18746fd4dd07",
                                                "sense_id": "1236f8cd-f5d2-3145-abef-dd1a5f4563ba",
                                                "text": "O.K., je lui ai donné vingt dollars, elle m'a dit qu'elle n'avait plus rien dans son frigo. Ce n'est pas la fin du monde, tout de même."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3423ead8-816b-4eab-8f30-416870ef99e0",
                        "source_entry_id": "f5be6bd3-fc17-367b-aeab-b89261cb0d2a",
                        "source_sense_id": "c1ef2d17-d713-323c-a5cc-aa6181e2a2db",
                        "target_lang_word": "malgré tout",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "malgré tout",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d23586ce-8982-3a6e-9b0f-6bebd39763e5",
                                        "entry_id": "d95c5e0e-be89-3882-9788-d59a7ada5a8a",
                                        "glosses": [
                                            "Quoi qu’on fasse, quoi qu’il arrive, quoi qu’on en dise."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "07189778-ac02-4783-903d-c8322ecf2aba",
                                                "sense_id": "d23586ce-8982-3a6e-9b0f-6bebd39763e5",
                                                "text": "Depuis vingt-quatre ans, M. B… souffrait d'une sinusite frontale qui avait nécessité onze opérations!! Malgré tout la sinusite persistait, accompagnée de douleurs intolérables."
                                            },
                                            {
                                                "example_id": "f87597ee-ec45-452b-8a81-279dc36efa2a",
                                                "sense_id": "d23586ce-8982-3a6e-9b0f-6bebd39763e5",
                                                "text": "[…], et, malgré tout, les Italiens du Gers semblent ne pas être inaccessibles aux enveloppements qui devrons conduire à leur assimilation."
                                            },
                                            {
                                                "example_id": "87748bee-fa69-459e-be61-7aa4a3aae639",
                                                "sense_id": "d23586ce-8982-3a6e-9b0f-6bebd39763e5",
                                                "text": "Cet espoir est toujours là quand même et malgré tout !"
                                            },
                                            {
                                                "example_id": "e97f0b14-2c39-403d-a03f-c5186d045eaf",
                                                "sense_id": "d23586ce-8982-3a6e-9b0f-6bebd39763e5",
                                                "text": "Miesel, qui peut sembler absent et distant, a la réputation d’un homme d’humour, malgré tout. Mais un homme d’humour digne de ce nom ne l’est-il pas toujours « malgré tout » ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
