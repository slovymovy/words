                        "source_entry_id": "106c5912-4359-3495-8f2e-6a929a6cbae1",
                        "source_sense_description": "punch",
                        "target_lang_word": "rotklap",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
