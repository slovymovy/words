                            },
                            {
                                "target_lang_word": "flunk",
                                "target_lang_sense_clarification": "to fail (informal)"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "rater",
                                "target_lang_sense_clarification": "échouer à un examen"
                            },
                            {
                                "target_lang_word": "caler",
                                "target_lang_sense_clarification": "échouer (argot)"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "bocciare",
