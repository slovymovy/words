                "senses": [
                    {
                        "sense_id": "1f515d6f-baaa-30b6-a223-27fcd9342490",
                        "entry_id": "cd754402-8b3b-3861-b7e6-3a04ef76a661",
                        "glosses": [
                            "Se dit de la respiration, quand elle fait entendre, dans les mouvements d’inspiration et d’expiration, une espèce de son qui imite assez bien le bruit de l’eau bouillante."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "47767831-681d-413e-a1db-15123aea8cb9",
                                "sense_id": "1f515d6f-baaa-30b6-a223-27fcd9342490",
                                "text": "Soustrait aux influences extérieures, je n’entends même plus la respiration stertoreuse de mon Yankee."
                            },
                            {
                                "example_id": "a327e56c-8621-49e1-8503-970b24e64ddd",
                                "sense_id": "1f515d6f-baaa-30b6-a223-27fcd9342490",
                                "text": "La pendule sonna midi. Aussitôt après, précédé d'un souffle stertoreux, de frôlements semblables à ceux qu'eût produits un énorme rat, et d'autres bruits de même sorte émanés du corridor, Simon, qu'on eût pris pour l'ancêtre commun de tous les singes, passa la tête dans l'entrebâillement de la porte."
                            },
                            {
                                "example_id": "22e3fbc4-366f-4cd1-bfce-9b0e0e0ff3e3",
                                "sense_id": "1f515d6f-baaa-30b6-a223-27fcd9342490",
                                "text": "La respiration devenait stertoreuse, pénible."
                            },
                            {
                                "example_id": "82832797-8417-4559-a46e-3f304f23634a",
                                "sense_id": "1f515d6f-baaa-30b6-a223-27fcd9342490",
                                "text": "\"La respiration de Lucy redevint stertoreuse puis cessa tout d'un coup\""
                            }
                        ]
                    }
                ],
