                    },
                    {
                        "translation_id": "a6d0c0b6-e0b0-45ea-bb28-fcf992672c6c",
                        "source_entry_id": "25adba83-ed88-325d-b8df-17b1a52c5083",
                        "source_sense_id": "c39e5368-c99b-3f55-8a17-8811df9fad4d",
                        "target_lang_word": "北方",
                        "target_lang_code": "zh",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "北方",
                                "target_lang_code": "zh",
                                "target_senses": [
                                    {
                                        "sense_id": "5b9a9008-9356-3551-b4ff-6fb4e9f27385",
                                        "entry_id": "955a37a2-bb24-3fb2-ae35-a18c984ffe78",
                                        "glosses": [
                                            "北；北面。"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "281e9a0c-adce-4bd5-9a54-fa3ed708d106",
                                                "sense_id": "5b9a9008-9356-3551-b4ff-6fb4e9f27385",
                                                "text": "《易‧說卦》：“坎者，水也，正北方之卦也。”"
                                            },
                                            {
                                                "example_id": "d5138ccc-7818-4e04-8719-3f09e9628f1a",
                                                "sense_id": "5b9a9008-9356-3551-b4ff-6fb4e9f27385",
                                                "text": "《雲笈七籤》卷十三：“腎主北方，其色黑。”"
                                            },
                                            {
                                                "example_id": "93ab7c54-b642-40de-b25b-fcf94d2e5a02",
                                                "sense_id": "5b9a9008-9356-3551-b4ff-6fb4e9f27385",
                                                "text": "孫中山《建國方略‧第一計劃》：“北方大港之築，用為國際發展實業計劃之策源地。”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cb8e5a5c-a384-301d-a24f-ab74ce7fc35c",
                                        "entry_id": "955a37a2-bb24-3fb2-ae35-a18c984ffe78",
                                        "glosses": [
                                            "北部地區。在中國多指黃河流域及其以北地區。"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3974772-706e-43d9-bf66-7c9c42278344",
                                                "sense_id": "cb8e5a5c-a384-301d-a24f-ab74ce7fc35c",
                                                "text": "《左傳‧文公九年》：“范山言於楚子曰：‘晉君少，不在諸侯，北方可圖也。’楚子師于狼淵以伐鄭。”"
                                            },
                                            {
                                                "example_id": "909d2efe-4d3d-40f1-a12c-a8b5944adf9f",
                                                "sense_id": "cb8e5a5c-a384-301d-a24f-ab74ce7fc35c",
                                                "text": "唐·韓愈《劉公墓志銘》：“大父巨敖……為太原晉陽令，再世宦北方，樂其土俗，遂著籍太原之陽曲。”"
                                            },
                                            {
                                                "example_id": "a4c233d9-0b21-4d50-9642-f7236ad3a866",
                                                "sense_id": "cb8e5a5c-a384-301d-a24f-ab74ce7fc35c",
                                                "text": "冰心《寄小讀者》二九：“你若是不曾離開中國北方，不曾離開到三年之久，你不會贊嘆欣賞北方蔚藍的天！”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
