                    {
                        "sense_id": "ff639223-9e76-3447-b277-577a79d5195d",
                        "entry_id": "02d7697b-98e7-37b7-acd9-720c79253659",
                        "glosses": [
                            "elkaar overlappende stenen of betonnen elementen waarmee een schuin dak lekdicht gedekt wordt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd1c8772-c918-4d64-ab0d-32ddeaa4e90f",
                                "sense_id": "ff639223-9e76-3447-b277-577a79d5195d",
                                "text": "De dakpannen zijn tijdens de storm niet van het dak gewaaid."
                            },
                            {
                                "example_id": "7c201e85-5138-42d9-97e6-726e212cb5b6",
                                "sense_id": "ff639223-9e76-3447-b277-577a79d5195d",
                                "text": "Volgens Weerplaza is een sterke waterhoos vanaf het water het land opgetrokken. Daardoor vlogen onder meer dakpannen in het rond en waaiden bomen om. Ter hoogte van Brouwershaven kwam een schip in de problemen, maar die kon \"op eigen kracht\" naar de haven varen, aldus de veiligheidsregio."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5385a92e-600e-4aa2-87ce-811027c91f66",
                        "source_entry_id": "02d7697b-98e7-37b7-acd9-720c79253659",
                        "source_sense_id": "ff639223-9e76-3447-b277-577a79d5195d",
                        "source_sense_description": "elkaar overlappende stenen of betonnen elementen waarmee een schuin dak lekdicht gedekt wordt",
                        "target_lang_word": "Dachziegel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dachziegel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6fded50a-1fdf-384d-80dd-645466816357",
                                        "entry_id": "df931380-c717-3d2f-90c0-fca89d1e16eb",
                                        "glosses": [
                                            "Bauteil, meist aus gebranntem Ton, zum Eindecken von Dächern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8dfba7d2-7fad-46a3-80d1-85a61b941419",
                                                "sense_id": "6fded50a-1fdf-384d-80dd-645466816357",
                                                "text": "Nachdem unser Dach neu eingedeckt war, sahen die Dachziegel noch schön rot und neu aus."
                                            },
                                            {
                                                "example_id": "51cf1ab3-9db1-4f3d-9096-0bbb57ee5ba6",
                                                "sense_id": "6fded50a-1fdf-384d-80dd-645466816357",
                                                "text": "Der Sturm hat einige Dachziegel vom Haus geweht."
                                            },
                                            {
                                                "example_id": "07d39bc6-6a03-423a-9e1a-1a922e7cec60",
                                                "sense_id": "6fded50a-1fdf-384d-80dd-645466816357",
                                                "text": "„Die Wände wurden neu eingezogen und isoliert, die Hütte bekam ein ordentliches Dach mit richtigen Dachziegeln, und auch eine Ölheizung ließ man Vater installieren.“"
                                            },
                                            {
                                                "example_id": "5c4763f2-5e5a-492c-892f-6a39b3f468fd",
                                                "sense_id": "6fded50a-1fdf-384d-80dd-645466816357",
                                                "text": "„Hoffentlich geht nicht eines Tages ein Dachziegel kaputt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "53ef1286-5d13-4f2c-bce3-0ca62b761115",
                        "source_entry_id": "02d7697b-98e7-37b7-acd9-720c79253659",
                        "source_sense_id": "ff639223-9e76-3447-b277-577a79d5195d",
                        "source_sense_description": "elkaar overlappende stenen of betonnen elementen waarmee een schuin dak lekdicht gedekt wordt",
                        "target_lang_word": "Dachstein",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dachstein",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "60f419fc-3a51-32cf-bcae-4595aa2ce993",
                                        "entry_id": "f08ddaa6-afa2-3577-a5f9-8d231640d3e9",
                                        "glosses": [
                                            "ziegel- oder plattenförmige Betonteile zum Dachdecken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e278bfba-976b-4ca5-a332-011bc7c64043",
                                                "sense_id": "60f419fc-3a51-32cf-bcae-4595aa2ce993",
                                                "text": "Dachsteine werden aus Beton geformt, einer Mischung aus quarzhaltigem Sand, Wasser, Zement und künstlich hinzugefügten Metalloxiden. Letztere sind für die Farbgebung verantwortlich."
                                            },
                                            {
                                                "example_id": "8ae287ca-48ae-4b30-9406-ab2701899934",
                                                "sense_id": "60f419fc-3a51-32cf-bcae-4595aa2ce993",
                                                "text": "Alternativ werden die Dachsteine nach dem Trocknungsvorgang mit einer Kunststofffarbe beschichtet."
                                            },
                                            {
                                                "example_id": "62dd55d2-c514-44f8-b72e-1e89d7df608b",
                                                "sense_id": "60f419fc-3a51-32cf-bcae-4595aa2ce993",
                                                "text": "Beim Thema Nachhaltigkeit können Dachsteine mit einem energieschonenderen Herstellungsprozess punkten."
                                            },
                                            {
                                                "example_id": "85906e1b-a36f-44fa-9fef-7a0be3ecf0e9",
                                                "sense_id": "60f419fc-3a51-32cf-bcae-4595aa2ce993",
                                                "text": "Statt der Dachsteine kann man auch zu Schiefer greifen, der besonders in der Rheinebene gebrochen wird."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Dachstein",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7342796c-ae19-3f55-8204-055ddffde986",
                                        "entry_id": "362e7caf-a9ae-3407-bf0d-1f9aa20d7ee6",
                                        "glosses": [
                                            "Hauptgipfel des in Oberösterreich, Salzburg und der Steiermark gelegenen Dachsteingebirges mit einer Höhe von 2995 Metern über dem Meeresspiegel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "02ef7c3a-ea6c-49ae-b6d3-093bf7b83284",
                                                "sense_id": "7342796c-ae19-3f55-8204-055ddffde986",
                                                "text": "Für den Dachstein will man jedenfalls ein neues Konzept – \"Dachstein Winter 2023+\" – erarbeiten, das noch mehr Winterwanderwege bieten soll."
                                            },
                                            {
                                                "example_id": "bcc635f2-8307-4043-bd09-567f83232afa",
                                                "sense_id": "7342796c-ae19-3f55-8204-055ddffde986",
                                                "text": "Auch der Gang auf die Hängebrücke des Dachsteins, der Treppe ins Nichts, erfordert etwas Mut."
                                            },
                                            {
                                                "example_id": "10ac96e7-c833-4fc0-9dc9-70bd25703ae6",
                                                "sense_id": "7342796c-ae19-3f55-8204-055ddffde986",
                                                "text": "Es herrschen geradezu patagonische Verhältnisse am Dachstein: minus 15 Grad Celsius, dazu ein Wind, der die Wangen gefrieren lässt während der Gletscherüberquerung von der Südwandbahn-Bergstation hinauf auf 2740 Meter."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fc97ce75-1938-4fae-a227-4c7f82b38c49",
                        "source_entry_id": "02d7697b-98e7-37b7-acd9-720c79253659",
                        "source_sense_id": "ff639223-9e76-3447-b277-577a79d5195d",
                        "source_sense_description": "elkaar overlappende stenen of betonnen elementen waarmee een schuin dak lekdicht gedekt wordt",
                        "target_lang_word": "tuile",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tuile",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1a22433b-4a61-3165-87e2-a5e500f5bbe0",
                                        "entry_id": "7c80d41d-805b-3247-805a-f8ee662c0f36",
                                        "glosses": [
                                            "Carreau de peu d’épaisseur, fait de terre grasse pétrie, séchée et cuite au four, tantôt plat, tantôt courbé en demi-cylindre, et dont on se sert pour couvrir les maisons, les bâtiments."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63490a5d-9c1f-444e-a4fd-7876a1db9a28",
                                                "sense_id": "1a22433b-4a61-3165-87e2-a5e500f5bbe0",
                                                "text": "Le toit de tuiles brunes et couvert de mousse s’affaissait en plusieurs endroits de manière à faire croire qu’il allait céder sous le poids de la neige."
                                            },
                                            {
                                                "example_id": "8714164b-bf6a-420f-a939-7c5c2b42401c",
                                                "sense_id": "1a22433b-4a61-3165-87e2-a5e500f5bbe0",
                                                "text": "Les maisons étaient couvertes de toits en tuiles creuses à l’italienne avec des cannelures ; ces tuiles étaient aussi d’un rouge éclatant, couleur étrange pour des yeux accoutumés aux tons de bistre et de suie des toitures parisiennes."
                                            },
                                            {
                                                "example_id": "e73840a8-227a-421a-9346-f0451480d80c",
                                                "sense_id": "1a22433b-4a61-3165-87e2-a5e500f5bbe0",
                                                "text": "Les tuiles, soulevées, roulent sur le toit, tombent sur le sol détrempé ; dans la nuit, les pauvres arbres, sous l’effort du vent plus colère, gémissent et craquent."
                                            },
                                            {
                                                "example_id": "041fb453-4a5d-4e35-9923-f3a8e2d9cd81",
                                                "sense_id": "1a22433b-4a61-3165-87e2-a5e500f5bbe0",
                                                "text": "Quand les deux pêcheurs eurent soupé, ils montèrent se coucher dans la petite chambre qui leur était réservée sous la tuile du toit."
                                            },
                                            {
                                                "example_id": "a6ad04c0-add8-40bb-91a1-c8f3510b2306",
                                                "sense_id": "1a22433b-4a61-3165-87e2-a5e500f5bbe0",
                                                "text": "Pour plus d’étanchéité et de résistance au vent, l’embarrure des tuiles plates était faite au mortier de façon très soignée."
                                            },
                                            {
                                                "example_id": "fccf3c6e-a4d7-4934-ac06-8d615fe3c6b1",
                                                "sense_id": "1a22433b-4a61-3165-87e2-a5e500f5bbe0",
                                                "text": "Afin de couvrir les sépultures, ils se sont servi de tuiles, parfois entières, souvent fragmentaires. C’est un geste naturel dans un atelier de potiers où elles sont si abondantes et réutilisées pour mille usages […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ffc3de9-3bbc-3e98-838a-584fd11731df",
                                        "entry_id": "7c80d41d-805b-3247-805a-f8ee662c0f36",
                                        "glosses": [
                                            "Morceaux de marbre, de pierre (notamment l'ardoise) ou de bronze, qui peuvent ne pas avoir la même forme mais servent aux mêmes usages que les tuiles de terre cuite."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "de8aeb85-b6dc-450c-880d-5d3ffdda87fe",
                                                "sense_id": "1ffc3de9-3bbc-3e98-838a-584fd11731df",
                                                "text": "Ce temple est couvert de tuiles de marbre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "76a04230-b53a-3679-8919-fd05e12554c4",
                                        "entry_id": "7c80d41d-805b-3247-805a-f8ee662c0f36",
                                        "glosses": [
                                            "Élément de matière réfractaire ou fusible à haute température d’un bouclier thermique."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2b9b2c33-9d17-3360-91e7-11569711bd40",
                                        "entry_id": "7c80d41d-805b-3247-805a-f8ee662c0f36",
                                        "glosses": [
                                            "Élément de matière réfractaire ou fusible à haute température d’un bouclier thermique.",
                                            "Plaque élémentaire protégeant les composants exposés au plasma thermonucléaire des flux de particules et des rayonnements."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "29c1fed3-2527-36eb-a1f0-476a8d440a4c",
                                        "entry_id": "7c80d41d-805b-3247-805a-f8ee662c0f36",
                                        "glosses": [
                                            "Gâteau sec en forme de tuile ronde, moulé à l’aide d’un rouleau à pâtisserie."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4f0ea909-2c7a-45a2-81c5-0493cfa94f32",
                                                "sense_id": "29c1fed3-2527-36eb-a1f0-476a8d440a4c",
                                                "text": "En fait de gloutof [sic pour kouglof], il y a, ébouriffant une débauche de papier de soie bleu nuit, un magnifique cake alsacien revisité par l’inspiration, des tartelettes au whisky si fines qu’on craint de les briser et des tuiles aux amandes bien caramélisées sur les bords. J’en bave instantanément."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "87334ab3-1b3b-35ba-abe4-ab2f714e8702",
                                        "entry_id": "7c80d41d-805b-3247-805a-f8ee662c0f36",
                                        "glosses": [
                                            "Accident, imprévu, que l’on ne peut éviter."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e1fef599-e474-4c5c-9972-20b6fbd09c12",
                                                "sense_id": "87334ab3-1b3b-35ba-abe4-ab2f714e8702",
                                                "text": "Il m’est arrivé une tuile."
                                            },
                                            {
                                                "example_id": "604ed7e9-c15f-4af5-b7f7-aae47cfffe1b",
                                                "sense_id": "87334ab3-1b3b-35ba-abe4-ab2f714e8702",
                                                "text": "Muserolle.– Oui, je comprends ton impatience ; mais, après la tuile qui me tombe sur la tête…"
                                            },
                                            {
                                                "example_id": "bc937ab1-e497-4622-95ac-aadf08cfec3b",
                                                "sense_id": "87334ab3-1b3b-35ba-abe4-ab2f714e8702",
                                                "text": "Le jeune homme flaira une tuile. De son mieux il réprima un geste de contrariété."
                                            },
                                            {
                                                "example_id": "b3eca5cf-b0b6-4209-8a34-6c467065b5e5",
                                                "sense_id": "87334ab3-1b3b-35ba-abe4-ab2f714e8702",
                                                "text": "VATELIN. — Oh ! ma chère amie ! te voilà ! Et bien ! il m’en tombe une tuile !"
                                            },
                                            {
                                                "example_id": "730312e2-e6e0-4eec-b8ec-86f01bfedf07",
                                                "sense_id": "87334ab3-1b3b-35ba-abe4-ab2f714e8702",
                                                "text": "À ce moment, mon ordonnance entra et me tendit une enveloppe jaune portant le cachet du régiment et la mention : « Ordre de Service ».\n— La tuile, annonça Conan."
                                            },
                                            {
                                                "example_id": "3752fe77-2729-451d-8ad1-3a70384aabeb",
                                                "sense_id": "87334ab3-1b3b-35ba-abe4-ab2f714e8702",
                                                "text": "Visite d’Elmer James. Je lui fais part de mes ennuis. « Bah, chaque nouvelle tuile est un pas en avant lorsqu’on ne se laisse pas abattre », dit-il joyeusement."
                                            },
                                            {
                                                "example_id": "802b180b-36c1-4bb0-be4f-dd51dedd35c6",
                                                "sense_id": "87334ab3-1b3b-35ba-abe4-ab2f714e8702",
                                                "text": "Ça, c’était avant la nouvelle tuile qui vient de tomber sur Airbus : l’Agence européenne de sécurité aérienne a interdit de vol les 713 hélicoptères Super Puma déjà vendus par Airbus, à la suite d’un accident suspect en Norvège."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "db1d283f-7478-37b1-831a-237d54be2e0b",
                                        "entry_id": "7c80d41d-805b-3247-805a-f8ee662c0f36",
                                        "glosses": [
                                            "Pièce de jeu plate et rigide, qui recouvre ou forme une partie de la surface de jeu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6437864e-6123-4e59-b6c8-24def54d32d1",
                                                "sense_id": "db1d283f-7478-37b1-831a-237d54be2e0b",
                                                "text": "Le mah-jong est un jeu traditionnel de dominos (et d'argent !) qui se joue à quatre avec des pièces sur lesquelles sont gravés des caractères. Le jeu se compose de 144 tuiles spéciales réparties en 6 catégories : […]."
                                            },
                                            {
                                                "example_id": "93ec40e2-0908-4a8e-af47-b4784706b226",
                                                "sense_id": "db1d283f-7478-37b1-831a-237d54be2e0b",
                                                "text": "Les tuiles peuvent être carrées, rectangulaires, hexagonales, ou de forme irrégulière."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2876e089-6b89-3c38-ab1a-720c868b02a6",
                                        "entry_id": "7c80d41d-805b-3247-805a-f8ee662c0f36",
                                        "glosses": [
                                            "Carreau collé formant le carrelage."
                                        ],
                                        "tags": [
                                            "Québec"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1f726c32-666c-406c-ae60-a63848825067",
                                                "sense_id": "2876e089-6b89-3c38-ab1a-720c868b02a6",
                                                "text": "J’ai cassé une tuile du plancher."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "757fc13d-920f-3439-a635-70c8bf42aa99",
                                        "entry_id": "7c80d41d-805b-3247-805a-f8ee662c0f36",
                                        "glosses": [
                                            "Rectangle cliquable d’interface graphique."
                                        ],
                                        "tags": [
                                            "neologism"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e225e9f6-9b44-357a-b078-d65893a8e84d",
                                        "entry_id": "7c80d41d-805b-3247-805a-f8ee662c0f36",
                                        "glosses": [
                                            "Million (d’argent), brique."
                                        ],
                                        "tags": [
                                            "dated",
                                            "slang"
                                        ],
