                        "entry_id": "7e7e432d-c1cd-3cb7-8702-141f2bed53b0",
                        "glosses": [
                            "kłopot, ambaras, przykrość"
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "33ee53d2-a2c1-4a90-91b4-dce4811d2df2",
                                "sense_id": "e8651d64-8829-3b28-b3fd-fc9a249fe09b",
                                "text": "Bezmyślnie wdając się w ich spory, sprawił sobie takie poniki."
                            }
                        ],
