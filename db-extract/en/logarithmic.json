                                            "analytic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "68532503-b118-4ca5-bd13-09dfdc885a91",
                                                "sense_id": "94c67a57-aad8-38a0-9e48-1c974d3fea2d",
                                                "text": "La courbe sensitométrique d'un film ou courbe de noircissement exprime la variation de la densité optique en fonction de l'exposition E exprimée en roentgens sous forme logarithmique […]."
                                            },
                                            {
                                                "example_id": "dcdcf86f-0cf0-4778-ae3a-a9f3751830cc",
                                                "sense_id": "94c67a57-aad8-38a0-9e48-1c974d3fea2d",
                                                "text": "Ainsi le seul couple de suites (e, f) dont l’équation différentielle hypergéométrique associée n'admet pas de solution de type logarithmique à l'origine correspond au cas j = 1."
                                            },
                                            {
                                                "example_id": "4cc963f1-5165-466f-a994-6cd78e02f69f",
                                                "sense_id": "94c67a57-aad8-38a0-9e48-1c974d3fea2d",
                                                "text": "Devant moi — schéma en trois dimensions — ma main et la règle logarithmique, chiffre 15."
                                            }
                                        ]
                                    }
