                "senses": [
                    {
                        "sense_id": "9e09c401-28a0-3475-aef1-64b010a19c88",
                        "entry_id": "9aac5dad-e869-3ca7-975a-4fbca0bd8811",
                        "glosses": [
                            "Stadt in Weißrussland (Belarus)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "70258861-574c-4d8c-aacf-0bb74d640b93",
                                "sense_id": "9e09c401-28a0-3475-aef1-64b010a19c88",
                                "text": "„Am 15. Dezember wurde im polnischen Brest-Litowsk (heute Brest, Weißrussland) ein Waffenstillstand mit den Mittelmächten, in erster Linie mit Deutschland und Österreich-Ungarn vereinbart.“"
                            },
                            {
                                "example_id": "ecc397d9-4a7f-40f8-9c36-ee902e74aaed",
                                "sense_id": "9e09c401-28a0-3475-aef1-64b010a19c88",
                                "text": "„Zugleich weitete er mit seiner Vision eines Europa von Brest bis Brest den Blick nach Osten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "de5316ea-eb99-3cf9-bade-e9c2e740047a",
                        "entry_id": "9aac5dad-e869-3ca7-975a-4fbca0bd8811",
                        "glosses": [
                            "Stadt in der französischen Bretagne"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c077def0-5e8a-4258-af98-ea853cb38a92",
                                "sense_id": "de5316ea-eb99-3cf9-bade-e9c2e740047a",
                                "text": "„Zugleich weitete er mit seiner Vision eines Europa von Brest bis Brest den Blick nach Osten.“"
                            },
                            {
                                "example_id": "8cfc88ce-3f47-4831-b27e-8461d11b6dba",
                                "sense_id": "de5316ea-eb99-3cf9-bade-e9c2e740047a",
                                "text": "„De Gaulle verließ noch am selben Tag über den Hafen von Brest Frankreich in Richtung Großbritannien.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
