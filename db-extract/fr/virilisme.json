                        "sense_id": "aaca0a62-d976-324a-b2ba-d7be3ef0f9ee",
                        "entry_id": "acd71222-a724-3e1a-a197-94c693b0c6e9",
                        "glosses": [
                            "Idéologie prônant la virilité comme valeur supérieure pour le genre masculin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "816f5384-7866-497d-a803-4cf7bebb5233",
                                "sense_id": "aaca0a62-d976-324a-b2ba-d7be3ef0f9ee",
                                "text": "Le virilisme est l’exacerbation des attitudes, représentations et pratiques viriles."
                            },
                            {
                                "example_id": "bcd16c25-3927-48d2-87e8-c9e747243e73",
                                "sense_id": "aaca0a62-d976-324a-b2ba-d7be3ef0f9ee",
                                "text": "Le virilisme contemporain se manifeste par la domination des hommes sur les femmes, mais plus encore par le désir masculin de différenciation radicale avec l’univers féminin. Nous pensons que le virilisme est susceptible d’éclairer le rapport négatif à l’école de plusieurs jeunes garçons."
                            }
                        ]
                    }
