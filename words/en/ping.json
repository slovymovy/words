                    "target_lang_definitions": {
                        "ru": "Короткое электронное сообщение или уведомление.",
                        "zh": "发送给某人的简短电子消息或通知。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сообщение",
                                "target_lang_sense_clarification": "короткое письмо"
                            },
                            {
                                "target_lang_word": "уведомление",
                                "target_lang_sense_clarification": "оповещение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "消息",
                                "target_lang_sense_clarification": "简短的电子信息"
                            },
                            {
                                "target_lang_word": "通知",
                                "target_lang_sense_clarification": "提醒信息"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4fe6e6f7-e46f-354c-9d9a-d4c2a60140a2",
                    "sense_definition": "The time it takes for data to travel from a computer to a server and back, often used to measure internet connection quality.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "network_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Gamers often complain about high <w>ping</w> causing delays in the game.",
                            "target_lang_translations": {
                                "ru": "Геймеры часто жалуются на высокий <w>пинг</w>, вызывающий задержки в игре.",
                                "zh": "玩家经常抱怨高<w>延迟</w>导致游戏卡顿。"
                            }
                        },
                        {
                            "text": "You need a low <w>ping</w> for a smooth video call experience.",
                            "target_lang_translations": {
                                "ru": "Для качественной видеосвязи нужен низкий <w>пинг</w>.",
                                "zh": "为了获得流畅的视频通话体验，你需要较低的<w>ping值</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "latency",
                        "lag"
                    ],
                    "common_phrases": [
                        "high ping",
                        "low ping"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "technical context (computing/gaming)"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Время, за которое данные проходят от компьютера до сервера и обратно; часто используется для оценки качества интернета.",
                        "zh": "数据从计算机传输到服务器再返回所需的时间，常用于衡量互联网连接质量。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пинг",
                                "target_lang_sense_clarification": "время отклика сети"
                            },
                            {
                                "target_lang_word": "задержка",
                                "target_lang_sense_clarification": "время передачи данных"
                            }
                        ],
                        "zh": [
