                "senses": [
                    {
                        "sense_id": "fa22e599-46cb-3577-9842-eabcc6bbbc37",
                        "entry_id": "ef276af7-0171-3627-8d09-3b225c641c4e",
                        "glosses": [
                            "Leutnant der Artillerie"
                        ],
                        "tags": [
                            "Heer"
                        ],
                        "examples": [
                            {
                                "example_id": "6e501405-8e03-4a64-8163-0af309af5be1",
                                "sense_id": "fa22e599-46cb-3577-9842-eabcc6bbbc37",
                                "text": "„Als die Französische Revolution losbrach, standen zufällig einige begabte Rhetoren und Artillerieleutnants in der Gegend herum, mit denen die Geschichte dann viel anfangen konnte.“"
                            },
                            {
                                "example_id": "8f6e0a62-580e-446e-994b-a2d1fceb00c3",
                                "sense_id": "fa22e599-46cb-3577-9842-eabcc6bbbc37",
                                "text": "„Ein Artillerieleutnant, der im Vorgelände nach Verwundeten suchte, wurde durch eine vor ihm hochfahrende Dampfsäule niedergeschleudert.“"
                            },
                            {
                                "example_id": "3c5fdb4a-a245-4c49-9639-fb3e01e35b5c",
                                "sense_id": "fa22e599-46cb-3577-9842-eabcc6bbbc37",
                                "text": "„Auch Napoleon las den Werther immer wieder - als junger Artillerieleutnant in Auxonne (1788/89) und auf seinem Feldzug nach Ägypten (1798).“"
                            },
                            {
                                "example_id": "40553b60-2b08-4ab0-bf54-824b09a7aea3",
                                "sense_id": "fa22e599-46cb-3577-9842-eabcc6bbbc37",
                                "text": "„Der Glaube füllt leere Säcke mit Gold, macht Zimmermannssöhne zu Göttern und Artillerieleutnants zu Kaisern, deren Name Jahrtausende überstrahlt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
