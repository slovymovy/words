{
    "word_family": [
        "piep",
        "pieper"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "37cb6fcf-0c4e-3c63-863e-3489e7ba7d8f",
                    "sense_definition": "Een hoog, schril geluid maken.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "geluid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De muis begon zachtjes te <w>piepen</w> in de hoek van de kamer.",
                            "target_lang_translations": {
                                "en": "The mouse started to <w>squeak</w> softly in the corner of the room.",
                                "fr": "La souris a commencé à <w>pépier</w> doucement dans le coin de la pièce."
                            }
                        },
                        {
                            "text": "De remmen van de oude fiets <w>piepen</w> als je ze gebruikt.",
                            "target_lang_translations": {
                                "en": "The old bike's brakes <w>squeak</w> when you use them.",
                                "fr": "Les freins du vieux vélo <w>grincent</w> quand on les utilise."
                            }
                        }
                    ],
                    "synonyms": [
                        "gillen",
                        "schreeuwen"
                    ],
                    "common_phrases": [
                        "zachtjes piepen"
                    ],
                    "target_lang_definitions": {
                        "en": "To make a short, high-pitched sound.",
                        "fr": "Émettre un son court et aigu."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "squeak",
                                "target_lang_sense_clarification": "To emit a short, high-pitched sound."
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "pépier",
                                "target_lang_sense_clarification": "Émettre de petits cris, souvent utilisé pour les oiseaux."
                            },
                            {
                                "target_lang_word": "grincer",
                                "target_lang_sense_clarification": "Produire un bruit aigu et métallique, comme des charnières."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a403aebf-3aef-3fe2-bd58-b94371e74ab1",
                    "sense_definition": "Iets snel of gemakkelijk afronden.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "voltooien",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Met het juiste gereedschap kan het klusje snel <w>gepiept</w> zijn.",
                            "target_lang_translations": {
                                "en": "With the right tools, the job can be <w>wrapped up</w> quickly.",
                                "fr": "Avec les bons outils, le travail peut être <w>bouclé</w> rapidement."
                            }
                        },
                        {
                            "text": "We hebben de administratie in een uurtje <w>gepiept</w>.",
                            "target_lang_translations": {
                                "en": "We <w>knocked out</w> the paperwork in an hour.",
                                "fr": "Nous avons <w>expédié</w> la paperasse en une heure."
                            }
                        }
                    ],
                    "synonyms": [
                        "afhandelen",
                        "klaren"
                    ],
                    "common_phrases": [
                        "snel gepiept"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Informeel taalgebruik."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To finish something quickly or easily.",
                        "fr": "Terminer quelque chose rapidement ou facilement."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "wrap up",
                                "target_lang_sense_clarification": "To complete a task or project."
                            },
                            {
                                "target_lang_word": "knock out",
                                "target_lang_sense_clarification": "To finish a task quickly (informal)."
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "boucler",
                                "target_lang_sense_clarification": "Terminer une tâche ou un projet rapidement."
                            },
                            {
                                "target_lang_word": "expédier",
                                "target_lang_sense_clarification": "Faire quelque chose très vite, parfois de manière expéditive."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c1dd8ab1-1e0b-3b7d-96c5-43af4b88d792",
                    "sense_definition": "Slapen.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "slapen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik ga nu lekker <w>piepen</w> na een lange dag werken.",
                            "target_lang_translations": {
                                "en": "I'm going to <w>snooze</w> now after a long day of work.",
                                "fr": "Je vais aller <w>roupiller</w> après une longue journée de travail."
                            }
                        },
                        {
                            "text": "De kinderen liggen al te <w>piepen</w> in hun bedjes.",
                            "target_lang_translations": {
                                "en": "The children are already <w>snoozing</w> in their beds.",
                                "fr": "Les enfants sont déjà en train de <w>piquer un somme</w> dans leurs petits lits."
                            }
                        }
                    ],
                    "synonyms": [
                        "slapen",
                        "pitten"
                    ],
                    "antonyms": [
                        "waken"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Bargoens of informeel jargon."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To sleep.",
                        "fr": "Dormir."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "snooze",
                                "target_lang_sense_clarification": "To sleep, often used informally."
                            },
                            {
                                "target_lang_word": "hit the hay",
                                "target_lang_sense_clarification": "An idiomatic expression for going to sleep."
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "piquer un somme",
                                "target_lang_sense_clarification": "Expression familière pour faire une sieste ou dormir."
                            },
                            {
                                "target_lang_word": "roupiller",
                                "target_lang_sense_clarification": "Terme familier pour dormir."
                            }
                        ]
                    }
                }
            ]
        }
    ]
