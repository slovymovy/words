                        "entry_id": "f64133c6-9bd5-3368-ae25-08626b382b76",
                        "glosses": [
                            "Personne malchanceuse ou qui attire la malchance, poissard."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb600e6f-bece-40ae-b96f-a33713771ff8",
                                "sense_id": "876200a5-720f-3362-9b66-ededc28f05aa",
                                "text": "Du Pechvogel!",
                                "translation": "Tu as vraiment la poisse !"
                            },
                            {
                                "example_id": "f6db5c1c-0fd3-4bd3-8994-e17d0b1d7ff4",
                                "sense_id": "876200a5-720f-3362-9b66-ededc28f05aa",
                                "text": "Dieter ist ein echter Pechvogel, er hatte dieses Jahr schon drei Autounfälle.",
                                "translation": "Dieter n'a vraiment pas de chance, il a déjà eu trois accidents de voiture cette année."
                            }
                        ]
                    }
                ],
