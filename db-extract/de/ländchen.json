                "senses": [
                    {
                        "sense_id": "f37a4efb-c72d-3065-beae-6b3c1f851dc7",
                        "entry_id": "b530547d-a784-3099-bdee-ee79b09496c9",
                        "glosses": [
                            "kleines Land im Sinne von Staat oder Bundesland"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b90a9296-2bdc-44e4-885e-eb52a8d14df6",
                                "sense_id": "f37a4efb-c72d-3065-beae-6b3c1f851dc7",
                                "text": "Der Vatikan ist ein Ländchen."
                            },
                            {
                                "example_id": "0b3cb269-f7de-4312-8a57-8c3ebc0c9cba",
                                "sense_id": "f37a4efb-c72d-3065-beae-6b3c1f851dc7",
                                "text": "„Er sprach von Luxemburg wie von einem verlorenen Paradies, während es doch bekanntlich ein winziges, mittelprächtiges Ländchen ist, ohne genauere Eigenschaften – nicht mal ein Land eigentlich, eher eine Ansammlung von Phantombüros, von Briefkastenfirmen auf Steuerflucht, in Parks verstreut.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
