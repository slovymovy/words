                "senses": [
                    {
                        "sense_id": "8b8ec417-30e0-3a71-a408-8610ed8736da",
                        "entry_id": "e2c364fe-0268-34c2-a589-d604ca624bd0",
                        "glosses": [
                            "Avion affecté à l’apprentissage du vol aérien, y compris simulé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d37dcb0-20da-4844-ab27-37bd6770bc7e",
                                "sense_id": "8b8ec417-30e0-3a71-a408-8610ed8736da",
                                "text": "Nous possédons deux avions, un avion-école DV20 Katana très silencieux, et un Piper PA 28 turbo."
                            },
                            {
                                "example_id": "561bbf5c-c372-4d14-a6e0-4ae6a13deb94",
                                "sense_id": "8b8ec417-30e0-3a71-a408-8610ed8736da",
                                "text": "Sur cette centaine de déplacements, j’ai fait une dizaine d’allers-retours en avion, dont environ la moitié, non pas avec des jets ou des avions d’affaires, mais des avions-écoles de la Direction générale de l’aviation civile, dans des cas d’urgence."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "04f754cc-965a-4586-a928-60c6d1d3256c",
                        "source_entry_id": "e2c364fe-0268-34c2-a589-d604ca624bd0",
                        "source_sense_id": "8b8ec417-30e0-3a71-a408-8610ed8736da",
                        "target_lang_word": "Schulflugzeug",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schulflugzeug",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f30aba13-c926-3fc4-a51a-b99e63eedcb4",
                                        "entry_id": "fb0a16f7-c285-36b6-b82c-e335eb6b8987",
                                        "glosses": [
                                            "(meist kleines) Flugzeug, das zur Ausbildung von Piloten dient, in dem praktischer Flugunterricht stattfindet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "202f2966-05fd-4320-85b6-11ccefdce2da",
                                                "sense_id": "f30aba13-c926-3fc4-a51a-b99e63eedcb4",
                                                "text": "„Weil der General möglichst wenig Aufsehen erregen wollte, hatte er ein kleines, einmotoriges Schulflugzeug angefordert, das viel weniger auffiel als der große MI-17-Transporthubschrauber, den ihm der Flugplatzkommandant empfohlen hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
