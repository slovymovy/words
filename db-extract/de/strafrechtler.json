                "senses": [
                    {
                        "sense_id": "13483942-26ed-3d02-8594-d8ce144b1893",
                        "entry_id": "4890250b-005e-3d0b-a3ce-122774ecc4ca",
                        "glosses": [
                            "(männlicher) Jurist, der sich auf das Strafrecht spezialisiert hat"
                        ],
                        "tags": [
                            "general"
                        ],
                        "examples": [
                            {
                                "example_id": "a6d3f771-f5a8-47e4-ab98-2773c54b2d6e",
                                "sense_id": "13483942-26ed-3d02-8594-d8ce144b1893",
                                "text": "Bei vielen Strafrechtlern ist zu beobachten, dass ihr Herz insgeheim für das Zivilrecht schlägt."
                            },
                            {
                                "example_id": "951c973f-5c1d-415e-88b9-99d37c4d6389",
                                "sense_id": "13483942-26ed-3d02-8594-d8ce144b1893",
                                "text": "„Ohnehin sei juristische Forschung, wie sie jetzt in Kooperation mit den russischen Strafrechtlern erfolgt […], keine Selbstverständlichkeit, so der Potsdamer Rechtswissenschaftler.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "258a728a-008f-3ef5-acf5-fc9c58c24b57",
                        "entry_id": "4890250b-005e-3d0b-a3ce-122774ecc4ca",
                        "glosses": [
                            "(männlicher) Hochschullehrer, der Strafrecht lehrt"
                        ],
                        "tags": [
                            "special"
                        ],
                        "examples": [
                            {
                                "example_id": "385a9786-b975-424e-8d7b-b66506ddb943",
                                "sense_id": "258a728a-008f-3ef5-acf5-fc9c58c24b57",
                                "text": "An unserer Fakultät wird händeringend ein Strafrechtler gesucht."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
