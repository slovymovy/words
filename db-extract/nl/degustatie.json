                "senses": [
                    {
                        "sense_id": "eb84e67f-9123-3445-9b86-ffe80dab095d",
                        "entry_id": "bbbd48d7-448d-3f93-bf3f-1458e8e02015",
                        "glosses": [
                            "proeven, vergelijken en keuren van (exclusieve) dranken en voedingswaren meestal als voorbereiding van een aankoop"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff4176dd-d796-425c-affb-a2e4cc45a81a",
                                "sense_id": "eb84e67f-9123-3445-9b86-ffe80dab095d",
                                "text": "Hier worden rondleidingen gegeven door het park, de rozentuin het pershuis en de kelders. Uiteraard wordt hier en daar beschaafd aan het glas genipt. De wijnen zijn hier ook te koop. Rondleidingen en degustatie zijn uitsluitend mogelijk via reservering. (NRC 15 oktober 1998)"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e7f37e44-6cb1-4a74-a67a-c728e482ad21",
                        "source_entry_id": "bbbd48d7-448d-3f93-bf3f-1458e8e02015",
                        "source_sense_id": "eb84e67f-9123-3445-9b86-ffe80dab095d",
                        "target_lang_word": "déguster",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "déguster",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1f88c191-c010-316f-a5d0-607869fce158",
                                        "entry_id": "aa1ee264-f0d5-39ff-8927-74256970b19c",
                                        "glosses": [
                                            "Goûter du vin ou quelque autre boisson pour en connaître la qualité, boire en connaisseur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3d17f1c-0344-4aef-bff4-52512b456329",
                                                "sense_id": "1f88c191-c010-316f-a5d0-607869fce158",
                                                "text": "Ils s’attablent dans de bons restaurants, se font déboucher des bouteilles de Châteauneuf-du-Pape, dégustent des liqueurs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "74160e8c-08ef-337a-a3da-2fc3a0abd9e2",
                                        "entry_id": "aa1ee264-f0d5-39ff-8927-74256970b19c",
                                        "glosses": [
                                            "Savourer quelque chose (de la nourriture, de la boisson, ou autre chose)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "29735496-2557-48a5-827d-ffcc91d74d21",
                                                "sense_id": "74160e8c-08ef-337a-a3da-2fc3a0abd9e2",
                                                "text": "Il oubliait apparemment que l’avant-veille, ce peu reluisant vieux marin avait dégusté chez lui un cottage pie digne d’un végétarien."
                                            },
                                            {
                                                "example_id": "90b73668-2833-48b5-892f-f42aefc6d229",
                                                "sense_id": "74160e8c-08ef-337a-a3da-2fc3a0abd9e2",
                                                "text": "Au comptoir, perché sur un tabouret, on déguste un verre de blanc, un café, avec une farandole de tapas et chipoteries, «grignoteries» en tout genre."
                                            },
                                            {
                                                "example_id": "ba1ff91a-e732-438a-9d30-cf9c1b5a2f91",
                                                "sense_id": "74160e8c-08ef-337a-a3da-2fc3a0abd9e2",
                                                "text": "Les enfants s’amuseront énormément à préparer les recettes présentées dans \" Les petits cuisiniers \", et ils se feront un plaisir de déguster leur chef-d’œuvre."
                                            },
                                            {
                                                "example_id": "c06dacae-5070-4cce-8b3b-e6a6a3e2b7a8",
                                                "sense_id": "74160e8c-08ef-337a-a3da-2fc3a0abd9e2",
                                                "text": "Aujourd’hui, le marché vétuste a laissé la place à une médiathèque qui, l’été venu, « installe des chiliennes près de la fontaine pour déguster un bon bouquin », poétise Eugénie Ponthier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "de18fc56-88c7-3178-add7-d004c29fa46d",
                                        "entry_id": "aa1ee264-f0d5-39ff-8927-74256970b19c",
                                        "glosses": [
                                            "Souffrir."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e3c4d53b-297d-4909-8287-f89c1cd430b9",
                                                "sense_id": "de18fc56-88c7-3178-add7-d004c29fa46d",
                                                "text": "Dans l’accident, avec une double fracture du tibia, j’ai dégusté."
                                            },
                                            {
                                                "example_id": "a912065b-0527-430c-9760-c233fda611d8",
                                                "sense_id": "de18fc56-88c7-3178-add7-d004c29fa46d",
                                                "text": "— Ah pardon ! dit le soldat, qu’est-ce qu’ils dégustent !"
                                            },
                                            {
                                                "example_id": "2a71595d-4e4c-45f9-9476-881433fee506",
                                                "sense_id": "de18fc56-88c7-3178-add7-d004c29fa46d",
                                                "text": "Qu’est-ce qu’elle déguste, la Pologne !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
