                        ],
                        "examples": [
                            {
                                "example_id": "fd963302-7c9d-4350-9e40-44f280432b18",
                                "sense_id": "8803c3a9-4d9a-3296-b067-6deb62977597",
                                "text": "The Colours, that shew best by Candlelight, are; White, Carnation, and a Kinde of Sea-Water-Greene; And Oes, or Spangs, as they are of no great Cost, so they are of most Glory."
                            }
                        ]
                    }
