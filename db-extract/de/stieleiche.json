                        "sense_id": "38251e7f-f0a6-3a77-a3e0-ea2aaf0b6dfb",
                        "entry_id": "959bb32e-1168-306e-8d53-e8c9c6fe3158",
                        "glosses": [
                            "eine Laubbaum-Art aus der Gattung der Eichen (Quercus) in der Familie der Buchengewächse (Fagaceae)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2da90c1b-53b3-4911-b5d4-4f3123ab1e72",
                                "sense_id": "38251e7f-f0a6-3a77-a3e0-ea2aaf0b6dfb",
                                "text": "„Die wichtigsten Baumarten der mitteleuropäischen Wälder sind Rotbuche (Fagus sylvatica), Trauben- und Stieleiche (Quercus petraea, Q. robur), Hainbuche (Carpinus betulus), Weißtanne (Abies alba) und Waldkiefer (Pinus sylvestris).“"
                            },
                            {
                                "example_id": "52dbbc5d-4681-4222-96c3-f7001bad5096",
                                "sense_id": "38251e7f-f0a6-3a77-a3e0-ea2aaf0b6dfb",
                                "text": "„Die Stieleiche ist einhäusig (getrenntgeschlechtig).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
