                                "target_senses": [
                                    {
                                        "sense_id": "dff96940-6b75-3624-9989-fd5b944df25e",
                                        "entry_id": "093c2458-dc31-3c0f-b62b-8f91f5a2e1ba",
                                        "glosses": [
                                            "Nom de famille."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eff63856-c222-49fc-90a4-04ea21330d5c",
                                                "sense_id": "dff96940-6b75-3624-9989-fd5b944df25e",
                                                "text": "De gauche à droite et de bas en haut : Marine Lepage (coordinatrice communale), Véronique Savin, Sandrine Saidani, Frédérique Cabos, Carole Malglaive et Stévie Louis"
                                            },
                                            {
                                                "example_id": "5e5c5d41-f5e1-4df4-a194-032c986e3d14",
                                                "sense_id": "dff96940-6b75-3624-9989-fd5b944df25e",
                                                "text": "«Si ça va mal, je laisserai tout ce que j’ai. Je trouverais un autre endroit, peut-être à Montréal-Nord que je connais bien et où j’ai des amis», raconte en français Tania Louis rencontrée dans l’un des deux restaurants haïtiens de Springfield en Ohio."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Louis",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5b67c571-ad2c-39b5-b2c3-5a6cb4ff2017",
                                        "entry_id": "092abaa6-be94-3f5d-b8fb-645641f5f803",
                                        "glosses": [
                                            "Prénom masculin français."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a56147c-a432-47e5-bfbb-9387ac8cc35f",
                                                "sense_id": "5b67c571-ad2c-39b5-b2c3-5a6cb4ff2017",
                                                "text": "Rayonnante, Anouk Grinberg dans L’Innocent de Louis Garrel, mi-comédie tendre, mi-film de braquage découvert hors compétition, à Cannes."
                                            },
                                            {
                                                "example_id": "1ffe8190-0edc-4f05-98a6-278b48621584",
                                                "sense_id": "5b67c571-ad2c-39b5-b2c3-5a6cb4ff2017",
                                                "text": "Dans ses rêves, il a revu Paris puis la France tout entière engloutie sous des tonnes de papier, avec en fond sonore la voix étouffée de Louis Hémon penché sur lui, un Hémon enquébécisé jusque dans la moelle de sa parlure."
                                            },
                                            {
                                                "example_id": "98b32c9d-9a83-401c-a3c1-8272e93555c6",
                                                "sense_id": "5b67c571-ad2c-39b5-b2c3-5a6cb4ff2017",
                                                "text": "Henri IV est le grand-père de Louis XIV, Cotton, le grand-oncle du P. la Chaise : deux royautés, deux dynasties, celle des rois, celle des confesseurs jésuites."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f81fe69c-c651-4078-8b36-2439eac61431",
                        "source_entry_id": "9e85d127-1223-3831-b693-27a8025de136",
