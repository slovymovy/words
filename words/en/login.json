        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a2b7f580-c5ac-3bb8-aefe-f53b55ccb469",
                    "sense_definition": "A common misspelling of the phrasal verb <w>log in</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should write 'please log in' as two words, but many people mistakenly use <w>login</w> as a verb.",
                            "target_lang_translations": {
                                "ru": "Следует писать «please log in» раздельно, но многие ошибочно используют <w>login</w> как глагол."
                            }
                        },
                        {
                            "text": "It is technically incorrect to <w>login</w> to the portal using the noun form.",
                            "target_lang_translations": {
                                "ru": "Технически неправильно <w>входить</w> на портал, используя форму существительного."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "misspelling"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Распространенное неправильное написание фразового глагола «log in»."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "войти",
                                "target_lang_sense_clarification": "ошибочное использование существительного как глагола"
                            },
                            {
