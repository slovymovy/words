    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7165d2d6-85f8-3255-a9d2-b611e6046614",
                    "sense_definition": "Soumettre à un examen, à une épreuve ou à une vérification expérimentale pour évaluer les qualités ou le bon fonctionnement de quelque chose.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "evaluation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'entreprise veut <w>tester</w> un produit innovant auprès des consommateurs avant de le commercialiser."
                        },
                        {
                            "text": "Nous avons <w>testé</w> une application mobile toute la journée pour repérer les erreurs éventuelles."
                        }
                    ],
                    "synonyms": [
                        "essayer",
                        "expérimenter",
                        "vérifier",
                        "éprouver"
                    ],
                    "common_phrases": [
                        "tester un produit",
                        "tester une application",
                        "tester son matériel"
                    ]
                },
                {
                    "sense_id": "dcb72bd0-d559-346d-add0-abb59a4d283c",
                    "sense_definition": "Chercher à éprouver la patience ou l'autorité de quelqu'un, le provoquer ou le défier.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'adolescent provocateur cherche constamment à <w>tester</w> les limites de la patience de ses parents."
                        },
                        {
                            "text": "Les adversaires ont essayé de nous <w>tester</w> dès le début de la rencontre sportive."
                        }
                    ],
                    "synonyms": [
                        "défier",
                        "provoquer"
                    ],
                    "common_phrases": [
                        "tester les limites"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "familier ou argotique"
                        }
                    ]
                },
                {
                    "sense_id": "732c6d73-5b76-3690-912a-789d1eaa3697",
                    "sense_definition": "Rédiger son testament pour déclarer ses dernières volontés et disposer de ses biens après sa mort.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le vieil homme a souhaité <w>tester</w> en faveur de ses neveux pour répartir ses biens équitablement."
                        },
                        {
                            "text": "Selon le code civil, toute personne saine d'esprit conserve la faculté légale de <w>tester</w>."
                        }
                    ],
                    "synonyms": [
                        "léguer"
                    ]
                },
                {
                    "sense_id": "b6c817f0-8e32-3bee-b2b1-71e9c81d59aa",
                    "sense_definition": "Soumettre un animal reproducteur ou une variété végétale à des contrôles génétiques ou agronomiques de sélection.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "evaluation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le centre de recherche agronomique a <w>testé</w> ces variétés de céréales pour évaluer leur résistance."
                        },
                        {
                            "text": "Les éleveurs ont <w>testé</w> plusieurs jeunes taureaux afin de sélectionner les meilleurs reproducteurs pour le troupeau."
                        }
                    ],
                    "common_phrases": [
                        "tester des semences"
                    ]
                }
            ]
        }
