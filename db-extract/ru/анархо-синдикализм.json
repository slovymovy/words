                                        "glosses": [
                                            "ideologia społeczno-polityczna łącząca anarchizm z syndykalizmem; kierunek anarchizmu głoszący, że związki zawodowe (syndykaty) są podstawowym narzędziem walki klasowej oraz przyszłą podstawą organizacji społeczeństwa, opartego na dobrowolnej federacji wolnych zrzeszeń pracowniczych"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "719dcb53-6fbc-402b-b669-638e945bb9e2",
                                                "sense_id": "24ec4e6e-5603-31e1-af48-090a62116bd8",
                                                "text": "Spróbujcie porównać anarchosyndykalizm z innymi odmianami anarchizmu."
