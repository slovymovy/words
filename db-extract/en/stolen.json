                                                "sense_id": "94f65f7b-c7d8-3986-9d21-ccc05fd209e3",
                                                "text": "Ik heb haar gestolen uit de werkplaats van de miniatuurmaakster en heb haar al die jaren bij me gehouden."
                                            },
                                            {
                                                "example_id": "a4879a42-bfc5-435e-b60d-6c7868698644",
                                                "sense_id": "94f65f7b-c7d8-3986-9d21-ccc05fd209e3",
                                                "text": "Isaac had uit het kantoor van zijn vader de sleutels gestolen en was er stiekem met een paar vrienden van school naar binnen gegaan."
                                            }
                                        ]
                                    }
                                ]
                            },
