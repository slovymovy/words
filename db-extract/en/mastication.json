    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "35f4aa58-7332-36cd-8b74-f221ae9cc2c8",
                "word": "mastication",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "ef21034b-c4c6-4a51-9a1c-ae24027f5a05",
                        "entry_id": "35f4aa58-7332-36cd-8b74-f221ae9cc2c8",
                        "tags": [
                            "plural"
                        ],
                        "form": "mastications"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3e1deac3-60a5-3253-9753-7da06d947c29",
                        "entry_id": "35f4aa58-7332-36cd-8b74-f221ae9cc2c8",
                        "glosses": [
                            "The process of chewing."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "cd7345ef-4823-4b90-b21a-9a9ef4c9729e",
                                "sense_id": "3e1deac3-60a5-3253-9753-7da06d947c29",
                                "text": "“It is no more blasphemous than that thing which is swiping our meat,” I replied, for whatever the thing was, it had leaped upon our deer and was devouring it in great mouthfuls which it swallowed without mastication. The creature appeared to be a great lizard at least ten feet high, with a huge, powerful tail as long as its torso, mighty hind legs and short forelegs."
                            }
                        ]
                    },
                    {
                        "sense_id": "4343fac2-bb62-31d2-be47-a34b7d32e390",
                        "entry_id": "35f4aa58-7332-36cd-8b74-f221ae9cc2c8",
                        "glosses": [
                            "The process of crushing as though chewed."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "22057664-fbd1-411a-ab6c-572126caad42",
                        "source_entry_id": "35f4aa58-7332-36cd-8b74-f221ae9cc2c8",
                        "source_sense_description": "process of chewing",
                        "target_lang_word": "mastication",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mastication",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9376aff5-86fa-34b5-b38c-411cef540660",
                                        "entry_id": "9c97ad78-bf9c-32e9-accb-01de66b317b5",
                                        "glosses": [
                                            "Action de mâcher."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c915c68-0f30-4e71-90cd-39eee11bb79d",
                                                "sense_id": "9376aff5-86fa-34b5-b38c-411cef540660",
                                                "text": "[…] ; après qu’il eut avec grand-peine accompli la mastication d’une bouchée de pois secs, il lui fallut absolument supplier son pieux amphitryon de lui fournir un breuvage quelconque ; […]."
                                            },
                                            {
                                                "example_id": "27aed645-6000-4230-9153-1afcb9b3a1fe",
                                                "sense_id": "9376aff5-86fa-34b5-b38c-411cef540660",
                                                "text": "La langue est dure, déformée et relevée à la pointe : c'est la « langue de bois » des paysans allemands. La mastication est difficile, la salive n'est plus retenue dans la bouche et l’animal dépérit considérablement."
                                            },
                                            {
                                                "example_id": "ccd796d2-8b65-4e7e-83f2-2cd70592b834",
                                                "sense_id": "9376aff5-86fa-34b5-b38c-411cef540660",
                                                "text": "Il mange lentement, handicapé par une mastication pénible, ne dit pas un mot, rit niaisement de loin en loin."
                                            },
                                            {
                                                "example_id": "cd0e9e7f-d41f-47cb-9f5d-f802ac603b8f",
                                                "sense_id": "9376aff5-86fa-34b5-b38c-411cef540660",
                                                "text": "C’est un coursier qui mâche un chewing-gum pour éléphant, à en juger par la vigueur et l’amplitude mandibulaires auxquelles cette mastication le contraint."
                                            },
                                            {
                                                "example_id": "1ec8cb64-8af7-4efd-b61a-e53fb252d557",
                                                "sense_id": "9376aff5-86fa-34b5-b38c-411cef540660",
                                                "text": "La tendreté est la facilité avec laquelle la viande est coupée et broyée au cours de la mastication."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fab531fc-63c4-4924-a4b9-57acc18a7905",
