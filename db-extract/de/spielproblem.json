                "senses": [
                    {
                        "sense_id": "973440fd-32e3-326f-87ed-d9f9244cab07",
                        "entry_id": "4344df4c-760d-3438-9288-a4ae5ec1601d",
                        "glosses": [
                            "Schwierigkeit, Störung, Unregelmäßigkeit während eines Spielgeschehens oder beim beherrschten Umgang mit dem Phänomen Spiel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c6c0b147-655f-43cd-ab57-82aece61ecec",
                                "sense_id": "973440fd-32e3-326f-87ed-d9f9244cab07",
                                "text": "„Zum Teil werden die Aufgaben mehr nur mit Scherzrätseln, Vexiraufgaben, Spielproblemen verwandt erscheinen.“"
                            },
                            {
                                "example_id": "753dc941-e8fc-43c2-b1db-6d7c22225053",
                                "sense_id": "973440fd-32e3-326f-87ed-d9f9244cab07",
                                "text": "„Grundvoraussetzungen für einen guten Spielleiter sind jedoch ein hohes Maß an Sensibilität für Spielvorgänge und für die Gefühle der Spielenden, reflektierte eigene Spielerfahrungen, Flexibilität im Umgang mit Spielproblemen und Toleranz gegenüber den einzelnen Spielwünschen.“"
                            },
                            {
                                "example_id": "b618650d-6014-4b37-8f7f-f37dc4a045ed",
                                "sense_id": "973440fd-32e3-326f-87ed-d9f9244cab07",
                                "text": "„Als drittes Auswahlkriterium dient üblicherweise die Begleitung durch einen Tutor – etwa bei der Einführung in das Planspiel, der Unterstützung bei Spielproblemen und der Reflexion des Gelernten.“"
                            },
                            {
                                "example_id": "d0afd562-57b1-4f37-bf25-16d345e33f68",
                                "sense_id": "973440fd-32e3-326f-87ed-d9f9244cab07",
                                "text": "„Mehrere Bekannte haben zugegeben, dass sie ein Spielproblem hatten und Hilfe suchten.“"
                            },
                            {
                                "example_id": "53017435-9d09-4fca-b9db-18edd5df4466",
                                "sense_id": "973440fd-32e3-326f-87ed-d9f9244cab07",
                                "text": "„Früher war er Installateur bei der ÖBB, doch dann kamen Scheidung und Spielprobleme.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
