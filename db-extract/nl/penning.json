                ],
                "senses": [
                    {
                        "sense_id": "f052f848-33a4-3f6d-9267-af47b9fd8cac",
                        "entry_id": "63d253eb-b4db-30cc-9e29-36d996aa87de",
                        "glosses": [
                            "koperen munt van lage waarde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ca47aad-c5d8-4b36-a4e4-a64c9055946f",
                                "sense_id": "f052f848-33a4-3f6d-9267-af47b9fd8cac",
                                "text": "Beschaamd, verlegen, ’t hoofd gebogen\nVoor Hem, die al haar nooden wist,\nWierp ze alles, wat haar restte in ’t leven,\n- Verzuchtende of zij meer kon geven!\nHaar penningske in Zijn offerkist."
                            }
                        ]
                    },
                    {
                        "sense_id": "30e77594-3b63-3fe1-98f9-6914b690ea54",
                        "entry_id": "63d253eb-b4db-30cc-9e29-36d996aa87de",
                        "glosses": [
                            "herdenkingsmunt die niet in omloop gebracht wordt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b0c8a890-b552-48a7-99cb-c7e118a5044c",
                                "sense_id": "30e77594-3b63-3fe1-98f9-6914b690ea54",
                                "text": "Er werd ter gelegenheid daarvan een prachtige penning geslagen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3b4cf8e3-0a83-46fa-8753-34e2f91a2ba5",
