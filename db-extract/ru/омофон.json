                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "homofoon",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "0eac44fc-eaf7-3d69-9289-7eef5582faba",
                                        "entry_id": "1a40ae6a-25cb-3e87-97cc-b22ed3beb697",
                                        "glosses": [
                                            "woord dat hetzelfde wordt uitgesproken als een ander woord, maar anders wordt geschreven en een andere betekenis heeft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b00a400f-386c-40aa-beef-8fb14cd7b1e0",
                                                "sense_id": "0eac44fc-eaf7-3d69-9289-7eef5582faba",
                                                "text": "Homofonen zijn woorden die hetzelfde klinken maar die je anders schrijft. Er zijn in het Nederlands vrij veel van deze woorden omdat we bijvoorbeeld de ei en ij hebben en ook de ou en au."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "homofoon",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "3acf73ca-1fa7-3e71-8b55-8e4c39bc5f95",
                                        "entry_id": "cbcd6e63-2a73-343e-a76e-0df0bd83587c",
                                        "glosses": [
                                            "éénstemmig gezongen, eventueel met harmonisch begeleidende stemmen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3de0a6c1-4781-4ec2-8668-29b1b9a32974",
                                                "sense_id": "3acf73ca-1fa7-3e71-8b55-8e4c39bc5f95",
                                                "text": "Je ziet meteen aan geschreven muziek dat het homofoon is: de stemmen staan keurig recht onder elkaar."
                                            }
                                        ]
                                    },
