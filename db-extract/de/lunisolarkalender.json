                                        "glosses": [
                                            "A calendar based on the movement of the Earth and the Moon around the Sun, which defines the year."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe482384-5995-4122-9065-270898794ba3",
                                                "sense_id": "c741a763-f151-3d6d-9230-91c0451ce3ee",
                                                "text": "We adopted the Babylonian lunisolar calendar in order to make sure that Pesaḥ fell in the spring, Shavuot at the first fruits, and Sukkot at harvest time."
                                            }
                                        ]
                                    }
                                ]
                            }
