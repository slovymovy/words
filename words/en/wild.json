                            {
                                "target_lang_word": "чудить",
                                "target_lang_sense_clarification": "совершать странные поступки"
                            },
                            {
                                "target_lang_word": "отрываться",
                                "target_lang_sense_clarification": "вести себя буйно"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "320c9ae8-1a67-3d63-af46-ae2ef5d475a9",
                    "sense_definition": "An English family name.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "surname",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The local library was named after Jonathan <w>Wild</w>, a prominent figure in the town's history.",
                            "target_lang_translations": {
                                "ru": "Местная библиотека была названа в честь Джонатана <w>Уайлда</w>, видного деятеля в истории города."
                            }
                        },
                        {
                            "text": "Mr. <w>Wild</w> will be your instructor for the advanced chemistry course this semester.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Уайлд</w> будет вашим преподавателем на продвинутом курсе химии в этом семестре."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "English origin."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Английская фамилия."
