                ],
                "senses": [
                    {
                        "sense_id": "9842f265-b521-3d49-88e2-011afa6120ee",
                        "entry_id": "fcd20b44-7868-3218-bda9-7ac7a9ac15e2",
                        "glosses": [
                            "To disconnect or detach one thing from another."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "40062bb4-d216-495f-a056-9515c6183e8f",
                                "sense_id": "9842f265-b521-3d49-88e2-011afa6120ee",
                                "text": "We uncoupled the trailer and left it behind."
                            },
                            {
                                "example_id": "4494436f-559c-4193-bd4a-a76dbab82bac",
                                "sense_id": "9842f265-b521-3d49-88e2-011afa6120ee",
                                "text": "The railway workers uncoupled the cars near the tail end of the train."
                            },
                            {
                                "example_id": "ea7c9f48-5947-4ef6-83dc-912e60204dfe",
                                "sense_id": "9842f265-b521-3d49-88e2-011afa6120ee",
                                "text": "On arrival at Spiez, the locomotive (No. 206) was immediately uncoupled and drew ahead to enable an Italian through coach from Interlaken to Milan to be loose shunted (with passengers aboard and controlled by means of its handbrake) on to the front of the train."
                            },
                            {
                                "example_id": "3c1c8440-666b-4fc9-9b32-976512e18b86",
                                "sense_id": "9842f265-b521-3d49-88e2-011afa6120ee",
                                "text": "The shunter has a lightweight portable radio transmitter by which, as he uncouples an incoming train into cuts for marshalling, he informs the Traffic Office of the number of wagons in each cut and its siding; [...]."
                            },
                            {
                                "example_id": "a1f14d38-9d78-4a0e-a06f-a289033eed5a",
                                "sense_id": "9842f265-b521-3d49-88e2-011afa6120ee",
                                "text": "The driver remained at his post, while telling fireman Jim Nightall to get down on the track and run back to uncouple the burning wagon from the rest."
                            }
                        ]
                    },
                    {
                        "sense_id": "f0862d7b-63b3-3b93-9e28-8b0431b9cdd8",
                        "entry_id": "fcd20b44-7868-3218-bda9-7ac7a9ac15e2",
                        "glosses": [
                            "To come loose."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "69f8d548-0110-3259-b772-b5c5200c091c",
                        "entry_id": "fcd20b44-7868-3218-bda9-7ac7a9ac15e2",
                        "glosses": [
                            "To loose, as dogs, from their couples."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "50a0934d-fd73-4c72-9d25-4172d3281b84",
                        "source_entry_id": "fcd20b44-7868-3218-bda9-7ac7a9ac15e2",
                        "source_sense_description": "to disconnect or detach",
                        "target_lang_word": "abhängen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abhängen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "096ce2b7-300c-3b74-8cca-4f47ea63f931",
                                        "entry_id": "55736e56-c6c7-310a-b031-4385e4aaf8d3",
                                        "glosses": [
                                            "zur Bedingung haben"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f46b087d-c2e4-4d03-ada0-442bab049ad0",
                                                "sense_id": "096ce2b7-300c-3b74-8cca-4f47ea63f931",
                                                "text": "Das hängt davon ab, wie das Wetter wird."
                                            },
                                            {
                                                "example_id": "24054862-2f4b-4517-b626-96dbe8cd63c8",
                                                "sense_id": "096ce2b7-300c-3b74-8cca-4f47ea63f931",
                                                "text": "„Wie gut ein Lebewesen riechen kann, hängt von der Sensitivität der Geruchsrezeptoren und der Anzahl der Riechzellen ab.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4c9ac6e8-f62d-3a17-b1d2-de3d0d4e0049",
                                        "entry_id": "55736e56-c6c7-310a-b031-4385e4aaf8d3",
                                        "glosses": [
                                            "angewiesen sein auf; die Hilfe oder Unterstützung von etwas/jemandem brauchen"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "476b35c7-ac1c-4797-ab2a-02f1d0f360c4",
                                                "sense_id": "4c9ac6e8-f62d-3a17-b1d2-de3d0d4e0049",
                                                "text": "Er hängt wirtschaftlich von seinen reichen Eltern ab."
                                            },
                                            {
                                                "example_id": "ff5d6dbd-e448-4798-9176-8a2d6a19be7b",
                                                "sense_id": "4c9ac6e8-f62d-3a17-b1d2-de3d0d4e0049",
                                                "text": "„Das Problem der Tech-Szene ist“, […] „dass diese Unternehmen strukturell auf Überwachung gebaut sind und nicht davon loskommen, weil ihre Einnahmen davon abhängen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "5bde633d-4330-3421-bfbb-46adc2e08f4e",
                                        "entry_id": "55736e56-c6c7-310a-b031-4385e4aaf8d3",
                                        "glosses": [
                                            "(von geschlachteten oder erlegten Tieren) lagern, bis sich die Totenstarre löst"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6e5a78e2-e121-48c9-a81e-3170a6bea98a",
                                                "sense_id": "5bde633d-4330-3421-bfbb-46adc2e08f4e",
                                                "text": "ein gut abgehangenes Steak"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "9d146fbd-fdde-353a-9094-ecdbe38cb317",
                                        "entry_id": "55736e56-c6c7-310a-b031-4385e4aaf8d3",
                                        "glosses": [
                                            "nichts tun"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d0d3ca8a-d46f-4664-b5bb-a5fd6fcaaa04",
                                                "sense_id": "9d146fbd-fdde-353a-9094-ecdbe38cb317",
                                                "text": "Meistens hängen wir zusammen ab."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            },
                            {
                                "target_word": "abhängen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5f8deec1-4b11-35cd-9b24-2241bd60da1b",
                                        "entry_id": "bafba01d-32c5-38a5-a9b6-4974444ce641",
                                        "glosses": [
                                            "aus einer hängenden Lage entfernen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f02526bd-d7ca-4706-95f2-1bb89b165c14",
                                                "sense_id": "5f8deec1-4b11-35cd-9b24-2241bd60da1b",
                                                "text": "Ich habe die Bilder abgehängt."
                                            },
                                            {
                                                "example_id": "6f8a01fe-aa75-4ad5-aa6e-6e8a7a6e4ef4",
                                                "sense_id": "5f8deec1-4b11-35cd-9b24-2241bd60da1b",
                                                "text": "Häng schon mal den Wohnwagen ab!"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "20165911-0ac7-387f-97fa-a78616f84ec7",
                                        "entry_id": "bafba01d-32c5-38a5-a9b6-4974444ce641",
                                        "glosses": [
                                            "einen Verfolger hinter sich lassen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cbfdb655-9aaf-472f-adcd-6b573cde1a7d",
                                                "sense_id": "20165911-0ac7-387f-97fa-a78616f84ec7",
                                                "text": "Mist, die haben uns abgehängt!"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "01ba4da6-16a6-37ef-9b4a-56c6bf379975",
                                        "entry_id": "bafba01d-32c5-38a5-a9b6-4974444ce641",
                                        "glosses": [
                                            "durch Darüber- oder Davorhängen von Tüchern oder Folie vor Verschmutzung oder Blicken schützen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "55a80182-ca51-46eb-b7b9-b25016136364",
                                                "sense_id": "01ba4da6-16a6-37ef-9b4a-56c6bf379975",
                                                "text": "Die Möbel waren mit Bettlaken abgehängt."
                                            },
                                            {
                                                "example_id": "44c52537-ed65-4646-b8c5-31a201f599b0",
                                                "sense_id": "01ba4da6-16a6-37ef-9b4a-56c6bf379975",
                                                "text": "Mein Vater hat den Tannenbaum immer abgehängt."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "95a70459-e88b-3ca1-8dd5-696fe048e877",
                                        "entry_id": "bafba01d-32c5-38a5-a9b6-4974444ce641",
                                        "glosses": [
                                            "eine Zwischendecke in hohe Räume einbauen"
                                        ],
