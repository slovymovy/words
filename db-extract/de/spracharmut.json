                "senses": [
                    {
                        "sense_id": "2ac6f02b-19d0-3733-aac5-fc8fbb2482bd",
                        "entry_id": "ad2a3f03-64b3-3865-b481-dc6180d03c26",
                        "glosses": [
                            "Eigenschaft einer Person, nur wenig Worte zu machen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e6c35e44-dffb-4197-babc-aaf54d0e1f8c",
                                "sense_id": "2ac6f02b-19d0-3733-aac5-fc8fbb2482bd",
                                "text": "„Von Beginn an litt unser Zusammenleben an einer Spracharmut, die mich verblüffte.“"
                            },
                            {
                                "example_id": "1e9c03e5-44de-4f24-aa66-920f432b0ed9",
                                "sense_id": "2ac6f02b-19d0-3733-aac5-fc8fbb2482bd",
                                "text": "„Aufgrund der Fremdsprache in den Interviews ist es bisweilen schwierig zu entscheiden, ob es sich um Spracharmut oder syntaktische Besonderheiten handelt.“"
                            },
                            {
                                "example_id": "b4336bfc-4336-48d0-95be-cb267f4d649a",
                                "sense_id": "2ac6f02b-19d0-3733-aac5-fc8fbb2482bd",
                                "text": "„Einerseits stellen wir Spracharmut und sogar Sprachlosigkeit fest, andererseits sind die Fachsprachen auf dem Vormarsch.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
