                        "entry_id": "29c2a9b9-00cd-39e9-993e-3f1c52acdff8",
                        "glosses": [
                            "Personne rappelant Polyphème, géant hirsute aveuglé par Ulysse."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "1d2f9285-e7fe-4dd3-b61b-0abb315b77ab",
                                "sense_id": "5395a537-4cd1-3b7e-a02e-f51db0914604",
                                "text": "Que lui auront fait ces polyphèmes à moitié aveugles ?"
                            }
                        ]
                    },
                    {
                        "sense_id": "7355fd67-d43f-3df4-9f2f-4e2485c19352",
                        "entry_id": "29c2a9b9-00cd-39e9-993e-3f1c52acdff8",
                        "glosses": [
                            "Polyphème d’Amérique."
                        ],
                        "tags": [
                            "Lépidoptérologie"
                        ],
                        "examples": [
                            {
                                "example_id": "4c2924ee-ded0-44a9-86b3-194fe7d3f199",
                                "sense_id": "7355fd67-d43f-3df4-9f2f-4e2485c19352",
                                "text": "Le polyphème ne se nourrit pas au stade adulte. La chenille mange les feuilles de divers feuillus, tels que le bouleau, le saule, l'érable, l'orme etc."
                            }
                        ]
                    }
