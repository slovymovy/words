                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "88aaff9a-6ab0-42f0-850c-11847b196db5",
                        "source_entry_id": "ba6cdbe4-ac66-367b-bc51-f1af436b109f",
                        "source_sense_id": "122a8c2f-59ac-39fb-9a48-80de670fd7d9",
                        "target_lang_word": "antriebslos",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "antriebslos",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cab3c4ea-0344-384b-9c65-d988d3f1f727",
                                        "entry_id": "a265cae8-dbe1-3b40-a237-6d6797cde9a7",
                                        "glosses": [
                                            "ohne Antrieb, ohne innere Motivation, passiv"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d9c20fe3-f279-4dfe-8893-442aaf946585",
                                                "sense_id": "cab3c4ea-0344-384b-9c65-d988d3f1f727",
                                                "text": "Ich fühle mich oft schlaff und antriebslos."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "68678a7e-ebe6-3b72-a5f5-2c54861914c6",
                                        "entry_id": "a265cae8-dbe1-3b40-a237-6d6797cde9a7",
                                        "glosses": [
                                            "ohne eigenen Antrieb"
                                        ],
                                        "tags": [
                                            "bei Schiffen, Fahrzeugen, Flugkörpern"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0705fff5-99b5-4e06-8f85-fa98ff920892",
                                                "sense_id": "68678a7e-ebe6-3b72-a5f5-2c54861914c6",
                                                "text": "Antriebslos auf hoher See zu treiben ist kein Spaß."
                                            },
                                            {
                                                "example_id": "7d76e5e9-c067-423a-a4fc-9ccf6f521c32",
                                                "sense_id": "68678a7e-ebe6-3b72-a5f5-2c54861914c6",
                                                "text": "„Mit Hilfe von zwei Schleppern sollte das noch antriebslose Schiff nach Wilhelmshaven zur Fertigstellung und Ausrüstung gebracht werden.“"
                                            },
                                            {
                                                "example_id": "024de29f-7460-477d-9f6b-f895d087ac93",
                                                "sense_id": "68678a7e-ebe6-3b72-a5f5-2c54861914c6",
                                                "text": "„Die Fahrzeuge müssen antriebslos sein und mindestens drei Räder haben.“"
                                            },
                                            {
                                                "example_id": "889a9440-6764-4127-9191-f9e4fc0f9ee0",
                                                "sense_id": "68678a7e-ebe6-3b72-a5f5-2c54861914c6",
                                                "text": "„Gewöhnlich haben Achterbahnen einen Katapultstart oder ein Liftsystem, das die Wagen zu Beginn der Strecke in große Höhe befördert. Dann sausen sie antriebslos durch Loopings und Spiralen.“"
                                            },
                                            {
                                                "example_id": "07606bd3-d245-4a66-977b-5dd4d2690c76",
                                                "sense_id": "68678a7e-ebe6-3b72-a5f5-2c54861914c6",
                                                "text": "„Zum Weltraumschrott zählen alle Flugkörper, die durch Menschenhand in das All gelangt sind und sich dort antriebslos durch den Raum bewegen.“"
                                            },
                                            {
                                                "example_id": "98c1c5dc-0e50-45d0-9e14-b3365f23f3d4",
                                                "sense_id": "68678a7e-ebe6-3b72-a5f5-2c54861914c6",
                                                "text": "„Eine fast vollkommene Annäherung an ein Inertialsystem wäre erst durch eine antriebslose Rakete im interstellaren Raum fern von allen Massen realisiert, falls sie nicht rotiert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
