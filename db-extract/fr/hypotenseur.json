                "senses": [
                    {
                        "sense_id": "5f5d6f6e-43a3-39a6-8cce-1f6446f73fdf",
                        "entry_id": "b6e82450-7201-32e0-9959-f41562b53426",
                        "glosses": [
                            "Qui fait baisser la tension artérielle (ou pression artérielle)."
                        ],
                        "tags": [
                            "Pharmacie"
                        ],
                        "examples": [
                            {
                                "example_id": "f3dc28dd-a301-484a-8d49-df8672bc2252",
                                "sense_id": "5f5d6f6e-43a3-39a6-8cce-1f6446f73fdf",
                                "text": "Ce sont d’abord les flavanols, un composé végétal que l’on trouve également dans le thé, les myrtilles et le vin rouge qui fait que le cacao a un effet hypotenseur."
                            },
                            {
                                "example_id": "315e3668-3b16-4343-9f0d-e26fe2f47175",
                                "sense_id": "5f5d6f6e-43a3-39a6-8cce-1f6446f73fdf",
                                "text": "Outre leur pouvoir hypotenseur, les nitrates contenus dans les légumes regorgent de bienfaits santé."
                            },
                            {
                                "example_id": "c27224e5-c517-4e7a-83ce-3a65c1e119fb",
                                "sense_id": "5f5d6f6e-43a3-39a6-8cce-1f6446f73fdf",
                                "text": "Il est aussi l’une des propriétés thérapeutiques les plus connues qui possède une capacité hypotenseuse et qui abaisse la tension artérielle."
                            }
                        ]
                    },
                    {
                        "sense_id": "5e54ec04-fb92-3490-99d2-63168088e3e1",
                        "entry_id": "b6e82450-7201-32e0-9959-f41562b53426",
                        "glosses": [
                            "Qui fait baisser la tension oculaire (ou pression oculaire)."
                        ],
                        "tags": [
                            "Pharmacie"
                        ],
                        "examples": [
                            {
                                "example_id": "f9a8f3cf-1857-4d47-8a1e-3538d1d3a7ec",
                                "sense_id": "5e54ec04-fb92-3490-99d2-63168088e3e1",
                                "text": "Un collyre hypotenseur."
                            }
                        ]
                    }
                ],
