                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82cbabc9-cdbd-4c77-9267-d9f972e61e1e",
                                                "sense_id": "3b1a83be-0971-31b7-81b6-37b7433e4c47",
                                                "text": "Immediately beyond the 'No entrance' sign onto the motorway slipway, turn right down the bank."
                                            },
                                            {
                                                "example_id": "992501bf-ef86-4494-9756-2edc7e4e109d",
                                                "sense_id": "3b1a83be-0971-31b7-81b6-37b7433e4c47",
                                                "text": "Cross a motorway slipway – there are no traffic lights. Then cross a major junction. Keep the motorway on your left."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
