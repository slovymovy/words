    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "c2fd267a-5570-372c-9115-f64161c88480",
                    "sense_definition": "À grande vitesse, en parlant d'un déplacement ou d'un mouvement physique.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "vitesse_deplacement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La voiture roule très <w>rapidement</w> sur l'autoroute sans respecter la limitation."
                        },
                        {
                            "text": "Le cycliste descend la colline très <w>rapidement</w> pour tenter de remporter l'épreuve."
                        }
                    ],
                    "synonyms": [
                        "vite"
                    ],
                    "antonyms": [
                        "lentement"
                    ],
                    "common_phrases": [
                        "rouler rapidement",
                        "courir rapidement"
                    ]
                },
                {
                    "sense_id": "7ea27eda-dac3-3f72-9ffa-0cd7da686de1",
                    "sense_definition": "En peu de temps, dans un bref délai ou sans tarder.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "delai_bref",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je dois te parler <w>rapidement</w> avant que le cours ne commence."
                        },
                        {
                            "text": "Le médecin a agi très <w>rapidement</w> pour soulager la douleur du blessé."
                        }
                    ],
                    "synonyms": [
                        "vite",
                        "promptement"
                    ],
                    "antonyms": [
                        "lentement"
                    ],
                    "common_phrases": [
                        "agir rapidement",
                        "répondre rapidement"
                    ]
                },
                {
                    "sense_id": "0e3c2172-e072-36f6-bf44-ef0b7308b39e",
                    "sense_definition": "D'une manière rapide, avec vivacité, efficacité ou accélération dans un processus.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "maniere_vive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'entreprise s'est développée très <w>rapidement</w> sur le marché international cette année."
                        },
                        {
                            "text": "Cet élève apprend très <w>rapidement</w> toutes les nouvelles leçons de mathématiques."
