                ],
                "senses": [
                    {
                        "sense_id": "41c0c4e2-d536-3b79-aede-aca2c8ebb579",
                        "entry_id": "8d4ace62-aa8a-37e0-967e-b9ade67bfd2a",
                        "glosses": [
                            "unglasierter, gebrannter Ton"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "1cec4da9-8b4d-4a7f-be4b-a57d1746a6ba",
                                "sense_id": "41c0c4e2-d536-3b79-aede-aca2c8ebb579",
                                "text": "„Als Tanagra-Figuren werden antike aus Terrakotta geformte und gebrannte Frauenfiguren in sitzender oder stehender Haltung von 15 bis 35 cm Höhe aus der böotischen Stadt Tanagra in Zentralgriechenland bezeichnet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "0c257312-6314-3e0f-9eef-f8d53ba91666",
                        "entry_id": "8d4ace62-aa8a-37e0-967e-b9ade67bfd2a",
                        "glosses": [
                            "Gefäße und Skulpturen aus dem Material [1]"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b2fb748-59d8-42d8-987d-8a3a0628ae9b",
                                "sense_id": "0c257312-6314-3e0f-9eef-f8d53ba91666",
                                "text": "„Die archäologische Nok-Kultur in Zentral-Nigeria ist vor allem bekannt durch ihre eindrucksvollen Terrakotten, die für Tausende von Euro auf dem internationalen Kunstmarkt gehandelt werden.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c70efdcd-a072-4806-91eb-4dade14fe89f",
                        "source_entry_id": "8d4ace62-aa8a-37e0-967e-b9ade67bfd2a",
                        "source_sense_id": "41c0c4e2-d536-3b79-aede-aca2c8ebb579",
                        "source_sense_description": "kein Plural: unglasierter, gebrannter Ton",
                        "target_lang_word": "terracotta",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "terracotta",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f7de57d8-1377-3a25-9305-6ef5ccea0663",
                                        "entry_id": "f4d8745f-ea59-330b-9a3b-a9cce70b1130",
                                        "glosses": [
                                            "A hard red-brown unglazed earthenware, used for pottery and building construction."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ae6994ef-7dfd-3cdd-b88c-9a01c40c803e",
                                        "entry_id": "f4d8745f-ea59-330b-9a3b-a9cce70b1130",
                                        "glosses": [
                                            "A reddish brown colour, like that of terra cotta."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "terracotta",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7be199e7-22a2-3328-9f34-b6521611409f",
                                        "entry_id": "1075e260-0c33-3c30-84d3-e42ab3194704",
                                        "glosses": [
                                            "Of the colour of terracotta."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0e9db05d-4308-4e16-87fb-2cf2982f0919",
                                                "sense_id": "7be199e7-22a2-3328-9f34-b6521611409f",
                                                "text": "A dull red or terracotta brown is far better, and sets off the foliage of Palms or Ferns to greater advantage."
                                            },
                                            {
                                                "example_id": "b5f80a31-e108-4581-8219-1d62d680b30e",
                                                "sense_id": "7be199e7-22a2-3328-9f34-b6521611409f",
                                                "text": "She looked cool in a grey tailored cotton dress with a terracotta scarf and shoes and her hair a black silk helmet."
                                            },
                                            {
                                                "example_id": "b7c52074-9edb-44ec-b8de-e450359e0f8a",
                                                "sense_id": "7be199e7-22a2-3328-9f34-b6521611409f",
                                                "text": "But let's not judge them by the content of their character. Let's judge them by the colour of their skin, which is terracotta."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a64660ef-6b2c-4ee4-b451-9509afab8cef",
                        "source_entry_id": "8d4ace62-aa8a-37e0-967e-b9ade67bfd2a",
                        "source_sense_id": "41c0c4e2-d536-3b79-aede-aca2c8ebb579",
                        "source_sense_description": "kein Plural: unglasierter, gebrannter Ton",
                        "target_lang_word": "terre cuite",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "terre cuite",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c98950dc-d6a3-3bcb-bfb5-73439a4f5247",
                                        "entry_id": "a8f27413-a82b-304b-ae57-7e1dee80babf",
                                        "glosses": [
                                            "Argile ordinaire ferrugineuse durcie par cuisson et dont on fait des poteries, des statues ou des matériaux de construction."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2fa60005-197a-4397-80ce-57c914f0bc53",
                                                "sense_id": "c98950dc-d6a3-3bcb-bfb5-73439a4f5247",
                                                "text": "Nous avons fait usage du fourneau ordinaire de fondeurs, avec cette différence que ce fourneau étoit recouvert d'un dôme en terre cuite pour concentrer la chaleur."
                                            },
                                            {
                                                "example_id": "abd259c3-7def-4653-bc40-405edf241982",
                                                "sense_id": "c98950dc-d6a3-3bcb-bfb5-73439a4f5247",
                                                "text": "Le hochet est un des plus anciens instruments de musique du monde. On en a retrouvé dans l’Égypte Ancienne notamment (en roseau, en papyrus et en terre-cuite) et en Mésopotamie (en terre-cuite), qui datent de 2000 AJC, ainsi que dans la plupart des sociétés préhistoriques des cinq continents."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3e21eb42-4dde-3ad8-892e-a5b403767e69",
                                        "entry_id": "a8f27413-a82b-304b-ae57-7e1dee80babf",
                                        "glosses": [
                                            "Objets de céramique fabriqués à base d’argile ferrugineuse cuite."
                                        ],
                                        "tags": [
                                            "countable",
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a42ef31c-2d10-488c-9f70-92891cf9a6b3",
                                                "sense_id": "3e21eb42-4dde-3ad8-892e-a5b403767e69",
                                                "text": "Ces terres cuites ont des formes et des motifs exceptionnels."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
