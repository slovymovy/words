                    "sense_definition": "Mollusque gastéropode univalve à coquille conique, plus communément appelé cadran.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "zoologie",
                    "name_type": "no",
                    "examples": [
