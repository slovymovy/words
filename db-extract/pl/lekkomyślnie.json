                                        "sense_id": "fb1f0ead-19b3-3e9b-a46f-508bea9b1001",
                                        "entry_id": "a2a473ed-0be3-3871-9b86-bf16ed9e069b",
                                        "glosses": [
                                            "With lavish expenditure or behaviour; in an extravagant manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9575f4a8-ff59-4637-97e1-959cd5a932c9",
                                                "sense_id": "fb1f0ead-19b3-3e9b-a46f-508bea9b1001",
                                                "text": "Perhaps nowhere else in insectdom is such an extravagantly flamboyant display of systemized pattern on parade."
