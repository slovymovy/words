                ],
                "senses": [
                    {
                        "sense_id": "a28d2b2e-bbed-38e7-88d5-ec73995882a9",
                        "entry_id": "b84c8490-3a33-3d8c-860d-48e2ae4dbd8f",
                        "glosses": [
                            "Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae3f1932-ed55-4e15-9359-93bedb922cf9",
                                "sense_id": "a28d2b2e-bbed-38e7-88d5-ec73995882a9",
                                "text": "Die Ippens kommen heute von Borkum."
                            },
                            {
                                "example_id": "a87cfe4f-d444-4c53-971c-87f8a4cc5c91",
                                "sense_id": "a28d2b2e-bbed-38e7-88d5-ec73995882a9",
                                "text": "Der Ippen trägt nie die Schals, die die Ippen ihm strickt."
                            },
                            {
                                "example_id": "7398955d-42b4-4c43-a130-ce73163030c3",
                                "sense_id": "a28d2b2e-bbed-38e7-88d5-ec73995882a9",
                                "text": "Frau Ippen ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "91bab288-84d8-4f04-968e-e354190c254f",
                                "sense_id": "a28d2b2e-bbed-38e7-88d5-ec73995882a9",
                                "text": "Herr Ippen wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "fe56a4bb-47e4-4dc9-9c01-6bcce574d131",
                                "sense_id": "a28d2b2e-bbed-38e7-88d5-ec73995882a9",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Ippen kommt, geht der Herr Ippen.“"
                            },
                            {
                                "example_id": "b5fef60d-7da0-4b03-acf2-6fdae8110214",
                                "sense_id": "a28d2b2e-bbed-38e7-88d5-ec73995882a9",
                                "text": "Ippen kommt und geht."
                            },
                            {
                                "example_id": "3e853aa6-280b-482f-8a56-3d93a9c082d3",
                                "sense_id": "a28d2b2e-bbed-38e7-88d5-ec73995882a9",
                                "text": "Ippens kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
