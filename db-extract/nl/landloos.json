                "senses": [
                    {
                        "sense_id": "6cb7d89f-1938-3524-a52f-ff63a32c036e",
                        "entry_id": "6d139164-b118-37fa-96d4-9350a8e996cf",
                        "glosses": [
                            "zonder eigen grond"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ae366d4-b37a-4831-a750-fa064d4856d0",
                                "sense_id": "6cb7d89f-1938-3524-a52f-ff63a32c036e",
                                "text": "Hij was een arme landloze boer die alleen zijn arbeid kon verkopen."
                            },
                            {
                                "example_id": "0abb3681-7e0a-4c91-8552-6c8c68a51aec",
                                "sense_id": "6cb7d89f-1938-3524-a52f-ff63a32c036e",
                                "text": "Aan de andere kant worden vele van de arme boeren, landloos of wegens verschulding gedwongen hun grond te verkopen of te verpanden, naar de steden gedreven op zoek naar een mager bestaan."
                            }
                        ]
                    },
                    {
                        "sense_id": "70ded7bd-7c10-34de-93eb-8d6ba1667e51",
                        "entry_id": "6d139164-b118-37fa-96d4-9350a8e996cf",
                        "glosses": [
                            "niet bij een nationale staat horend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "475be6d7-ee01-47e0-a7f5-cc926134a841",
                                "sense_id": "70ded7bd-7c10-34de-93eb-8d6ba1667e51",
                                "text": "Esperanto is een voorbeeld van landloze taal."
                            },
                            {
                                "example_id": "0b2658c4-44fb-4b0b-83c5-dc4cff1b5762",
                                "sense_id": "70ded7bd-7c10-34de-93eb-8d6ba1667e51",
                                "text": "De oorzaken [sic!] van de telkens oplaaiende drama's in de regio is een complex van factoren. Ten eerste de aanwezigheid van een landloos, maar zwaar bewapend Hutu-leger dat een bedreiging vormt voor Rwanda, dat zo moeilijk in staat wordt gesteld zich te herstellen van de oorlog van 1994."
                            }
                        ]
                    }
