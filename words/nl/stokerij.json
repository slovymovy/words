    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "36b4dd1f-b4a7-3f78-893e-d3be8309d84c",
                    "sense_definition": "Een bedrijf of fabriek waar sterke alcoholische dranken worden gedestilleerd.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We hebben tijdens onze vakantie een traditionele <w>stokerij</w> bezocht.          ",
                            "target_lang_translations": {
                                "fr": "Nous avons visité une <w>distillerie</w> traditionnelle pendant nos vacances."
                            }
                        },
                        {
                            "text": "Hij werkt al jaren in een ambachtelijke <w>stokerij</w> in Schotland.          ",
                            "target_lang_translations": {
                                "fr": "Il travaille depuis des années dans une <w>distillerie</w> artisanale en Écosse."
                            }
                        }
                    ],
                    "synonyms": [
                        "distilleerderij"
                    ],
                    "common_phrases": [
                        "ambachtelijke stokerij",
                        "illegale stokerij"
                    ],
                    "target_lang_definitions": {
                        "fr": "Une entreprise ou usine où sont distillées des boissons alcoolisées fortes."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "distillerie",
                                "target_lang_sense_clarification": "établissement où l'on distille des alcools"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "662f219c-1aee-35b6-be72-bc911f09505c",
                    "sense_definition": "Het opzettelijk veroorzaken van ruzie, onrust of verdeeldheid.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik ben de voortdurende <w>stokerij</w> op de werkvloer helemaal zat.          ",
                            "target_lang_translations": {
                                "fr": "J'en ai assez de la <w>zizanie</w> constante sur le lieu de travail."
                            }
                        },
                        {
                            "text": "Door zijn <w>stokerij</w> raakten de twee vrienden uiteindelijk in strijd.          ",
                            "target_lang_translations": {
                                "fr": "À cause de ses <w>provocations</w>, les deux amis ont fini par se disputer."
                            }
                        }
                    ],
                    "synonyms": [
                        "intrige",
                        "gestook"
                    ],
                    "target_lang_definitions": {
                        "fr": "L'action de causer délibérément des disputes, des troubles ou de la zizanie."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "zizanie",
                                "target_lang_sense_clarification": "action de semer la discorde"
                            },
                            {
                                "target_lang_word": "provocation",
                                "target_lang_sense_clarification": "fait de chercher la dispute ou les embrouilles"
                            },
                            {
                                "target_lang_word": "intrigues",
                                "target_lang_sense_clarification": "manœuvres secrètes pour diviser"
                            }
                        ]
                    }
                }
            ]
        }
    ]
