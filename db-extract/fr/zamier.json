                        "examples": [
                            {
                                "example_id": "77c10cda-5f1e-482d-a6ba-0b0180eca3d7",
                                "sense_id": "0424eff6-7729-3704-8f94-e8bc9584b4aa",
                                "text": "Il offrit à sa victime des zakouski empoisonnés, puis le pendit à la branche d’un zamier."
                            },
                            {
                                "example_id": "66adfba9-a94e-42ec-88ab-7e91100d6d1e",
                                "sense_id": "0424eff6-7729-3704-8f94-e8bc9584b4aa",
                                "text": "Le zamier des Cafres ou arbre à pain de l’Afrique du Sud, qui fournit une fécule alimentaire de bonne qualité (sagou) ; le zamier nain, qui possède également des racines féculifères…"
                            }
                        ]
