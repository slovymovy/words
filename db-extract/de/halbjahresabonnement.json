                "senses": [
                    {
                        "sense_id": "cfd60c6c-2ef0-31d9-a04f-439bbc98e38d",
                        "entry_id": "a4b07bc2-5245-3081-8e34-edfd3a59d7f5",
                        "glosses": [
                            "Abonnement, das ein halbes Jahr Gültigkeit hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "01d525e8-c9c8-4eeb-aac6-5eb3c9f544f4",
                                "sense_id": "cfd60c6c-2ef0-31d9-a04f-439bbc98e38d",
                                "text": "„Das Ganz- und das Halbjahresabonnement für Minderjährige und Studenten wird 1869 geschaffen.“"
                            },
                            {
                                "example_id": "aa73d44b-a17d-42c5-97f8-55d7216788f2",
                                "sense_id": "cfd60c6c-2ef0-31d9-a04f-439bbc98e38d",
                                "text": "„Der Preis für ein Halbjahresabonnement eines Terminkalenders für eine Region beträgt etwa 70 bis 130 Euro.“"
                            },
                            {
                                "example_id": "c4905a09-d19a-4954-89e2-004dd22e5621",
                                "sense_id": "cfd60c6c-2ef0-31d9-a04f-439bbc98e38d",
                                "text": "„Unterstützen Sie uns mit einem Halbjahresabonnement für 10 DM an obige Kontaktadresse.“"
                            },
                            {
                                "example_id": "a5838e4b-b83e-413f-9483-f1142da043a1",
                                "sense_id": "cfd60c6c-2ef0-31d9-a04f-439bbc98e38d",
                                "text": "„Voraussichtlich werden in der neuen Velostation folgende Preise gelten: 150 Franken für ein Jahresabonnement, 90 Franken für ein Halbjahresabonnement, 20 Franken für ein Monatsabonnement sowie Tageskarten für 2 Franken.“"
                            },
                            {
                                "example_id": "cdd4cb1f-958d-4e51-996f-0166d577badd",
                                "sense_id": "cfd60c6c-2ef0-31d9-a04f-439bbc98e38d",
                                "text": "„Gerade beginnt die Zeitung eine Aktion, die den Lehrern von über 3000 Schulen ein kostenloses Halbjahresabonnement anbietet, damit sie im Unterricht die Probleme bäuerlichen Wirtschaftens mit aktuellem Material bearbeiten können.“"
                            },
                            {
                                "example_id": "3a6dec2f-85db-437d-b824-a262f5f37048",
                                "sense_id": "cfd60c6c-2ef0-31d9-a04f-439bbc98e38d",
                                "text": "„Erst mit der Reetablierung des Jahresabonnements von 1851 kam die LG dieser Gruppe preislich entgegen; das Jahresabonnement wurde um vier Franken billiger als zwei Halbjahresabonnements.“"
                            },
                            {
                                "example_id": "941e5ed4-2ca0-4a65-9086-2bf69855f517",
                                "sense_id": "cfd60c6c-2ef0-31d9-a04f-439bbc98e38d",
                                "text": "„Wir haben bereits früher darauf hingewiesen, daß die in Tabellen 1 und 3 angeführte Zahl der Marktfahrer die Inhaber der gelösten Halbjahresabonnemente, d. h. der ständig anwesenden Verkäufer, darstellt, im weiteren aber vermerkt, daß damit nicht alle Marktfahrer erfaßt werden konnten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
