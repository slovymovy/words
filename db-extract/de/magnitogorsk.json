                                "example_id": "42fa2079-d520-480e-8d0b-30a4303ab5b5",
                                "sense_id": "86bf1506-6c26-383f-b14b-bed75ec47182",
                                "text": "„Magnitogorsk wurde zum gleißenden Symbol des Aufstiegs der Sowjetunion zur industriellen Weltmacht, die Deutschland besiegte und Amerika Paroli bot.“"
                            },
                            {
                                "example_id": "f07ca05c-f394-44dc-b875-44986e2a498a",
                                "sense_id": "86bf1506-6c26-383f-b14b-bed75ec47182",
                                "text": "„In Magnitogorsk wird nicht nur Stahl gekocht, sondern auch – und sonst wenig anderes – auch Eishockey gespielt. Und das ziemlich gut.“"
                            }
                        ],
