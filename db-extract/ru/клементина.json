                    {
                        "translation_id": "1a56242b-5aa1-40f2-9c16-6adac20cb8d2",
                        "source_entry_id": "97517d44-9ff9-3a37-ac34-321680fcf14e",
                        "source_sense_id": "8c5ac4bd-483c-3b71-824c-31280cbef123",
                        "source_sense_description": "Иноязычные аналоги",
                        "target_lang_word": "Clémence",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Clémence",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bc4a7f04-e8d1-320d-a7eb-ed45b67ad8eb",
                                        "entry_id": "0c0271f1-97a1-3c72-aee8-4f7f31d93788",
                                        "glosses": [
                                            "Prénom féminin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63a63844-6aa6-430e-ba02-d2ccd7e94073",
                                                "sense_id": "bc4a7f04-e8d1-320d-a7eb-ed45b67ad8eb",
                                                "text": "Et tu roulais des yeux blancs vers ta Clémence… Ah ! le terrible bourrin qui s’appuyait des régiments."
                                            },
                                            {
                                                "example_id": "e47b1e3f-471a-40e6-a381-101ff75ac101",
                                                "sense_id": "bc4a7f04-e8d1-320d-a7eb-ed45b67ad8eb",
                                                "text": "Elle avait eu deux beaux enfants de ce matelot, la Clémence, puis la chienne de guerre, la grande, était arrivée, expédiant le Paul aux Dardanelles, dans les pays là-bas comme on disait, aux cinq cents diables quoi !"
                                            },
                                            {
                                                "example_id": "49ad77e1-4465-455d-abf0-1199aac6d978",
                                                "sense_id": "bc4a7f04-e8d1-320d-a7eb-ed45b67ad8eb",
                                                "text": "Elle ne fait pas la Place des Arts\n Elle ouvre les boîtes, elle ferme les bars\n Fait l’ Patriote, fait tout c’qu’elle peut\n Moi, c’est Clémence que j’aime le mieux."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5251796c-6c47-4318-adae-6207b4aa0e4a",
                        "source_entry_id": "97517d44-9ff9-3a37-ac34-321680fcf14e",
                        "source_sense_id": "8c5ac4bd-483c-3b71-824c-31280cbef123",
                        "source_sense_description": "Иноязычные аналоги",
                        "target_lang_word": "Clémentine",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Clémentine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "701d4fca-14ad-3108-9379-70bbb863d87b",
                                        "entry_id": "bf1f40ca-a24e-3fe4-b309-391e9894dd5a",
                                        "glosses": [
                                            "Habitante de Saint-Clément, commune française située dans le département de l’Yonne."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Clémentine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "952bba79-8c88-31e5-b9f7-f14823eaca6d",
                                        "entry_id": "fb7c8489-5db9-31af-9a1d-aa6525fdc939",
                                        "glosses": [
                                            "Prénom féminin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d67b30f-254f-43de-aef7-352a26870389",
                                                "sense_id": "952bba79-8c88-31e5-b9f7-f14823eaca6d",
                                                "text": "Clémentine parut sur le seuil de la salle à manger, contempla les convives en train d’engloutir la crème à la vanille."
                                            },
                                            {
                                                "example_id": "b71dd71a-4bb3-405d-bc1a-4bb588c3134a",
                                                "sense_id": "952bba79-8c88-31e5-b9f7-f14823eaca6d",
                                                "text": "Clémentine Célarié se rendra peut-être dans sa maison de la presqu’île de Crozon (29), tout comme Laurent Voulzy et Alain Souchon, à Belle-Île (56), qu’ils aiment tant."
                                            },
                                            {
                                                "example_id": "8bb24cc4-13a2-4767-9744-e2bafe7ea490",
                                                "sense_id": "952bba79-8c88-31e5-b9f7-f14823eaca6d",
                                                "text": "Clémentine Fauré-Bellaïche, une professeure assistante dans une université américaine lui a rétorqué que « Jean Zay, juif, résistant, assassiné par la Milice, [avait] créé le festival précisément pour que le cinéma échappe à toute récupération politique »."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Clémentine",
                                "target_lang_code": "fr",
                                "target_senses": [
