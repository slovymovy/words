                "senses": [
                    {
                        "sense_id": "9ab59f4c-b406-3dfa-b5c7-699ebd0b9e0f",
                        "entry_id": "b0ed676d-f2c7-3c72-9ff8-03d6129567e6",
                        "glosses": [
                            "Flüchtige organische Verbindung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2f36b461-2b7b-49c0-af2b-0607a0287e8b",
                                "sense_id": "9ab59f4c-b406-3dfa-b5c7-699ebd0b9e0f",
                                "text": "„VOC: Abkürzung für englisch volatile organic compounds, flüchtige organische Verbindungen aus der Verwendung organischer Lösemittel und lösemittelhaltiger Produkte in Industrie, Gewerbe, Handwerk und Haushalten, auch bedingt durch Kraftfahrzeugverkehr; neben den Stickstoffoxiden sind VOC die wesentlichen Vorläufersubstanzen für die Umweltbelastung durch bodennahes Ozon.“"
                            },
                            {
                                "example_id": "300be9c6-6f8f-494a-86e4-5ca3831329f7",
                                "sense_id": "9ab59f4c-b406-3dfa-b5c7-699ebd0b9e0f",
                                "text": "„Fachleute unterscheiden VOC von den sehr flüchtigen organischen Verbindungen (Very Volatile Organic Compounds, VVOC) und den schwerflüchtigen organischen Verbindungen (Semivolatile Organic Compounds, SVOC). Die Summe der Konzentrationen sämtlicher VOC ergibt den TVOC-Wert (Total Volatile Organic Compounds).“"
                            },
                            {
                                "example_id": "2d39173a-3946-45cf-be6d-f380a4026f84",
                                "sense_id": "9ab59f4c-b406-3dfa-b5c7-699ebd0b9e0f",
                                "text": "„Die meisten der im Innenraum nachgewiesenen organischen Stoffe gehören zu der Gruppe der VOC.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
