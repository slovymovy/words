        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "bb8d7383-fb7b-3f25-a260-5f001461b4e2",
                    "sense_definition": "Fonctionnaire de justice chargé d'assister les magistrats, de rédiger les procès-verbaux et d'authentifier les actes d'un tribunal.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "justice",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le <w>greffier</w> a soigneusement consigné les déclarations du témoin tout au long de l'audience."
                        },
                        {
                            "text": "Durant le procès, le <w>greffier</w> en chef a vérifié la conformité de chaque pièce du dossier."
                        }
                    ],
                    "common_phrases": [
                        "greffier en chef",
                        "greffier du tribunal"
                    ]
                },
                {
                    "sense_id": "048c7bac-06b5-3979-bec5-428ac930318a",
                    "sense_definition": "Désignation familière ou argotique d'un chat.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "animaux",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le vieux <w>greffier</w> du voisin passe ses après-midi à dormir sur le muret ensoleillé."
                        },
                        {
                            "text": "En rentrant sous la pluie, elle a recueilli un petit <w>greffier</w> affamé devant sa porte."
                        }
                    ],
                    "synonyms": [
                        "chat",
                        "matou",
                        "mistigri"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "terme argotique ou très familier"
                        }
                    ]
                },
                {
                    "sense_id": "1b2a158f-6604-3973-862e-abb605b36127",
                    "sense_definition": "Personne qui se borne à enregistrer ou consigner par écrit des faits ou des propos.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'historien ne voulait pas être un simple <w>greffier</w> des événements mais cherchait à en expliquer les causes."
                        },
                        {
                            "text": "Il s'est contenté du rôle de <w>greffier</w> de la réunion sans jamais donner son opinion personnelle."
                        }
                    ],
                    "synonyms": [
                        "chroniqueur",
                        "scribe"
                    ]
                }
            ]
        }
