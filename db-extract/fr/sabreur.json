                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "edcf545b-f4e0-4f84-a20d-f23819748c5c",
                        "entry_id": "a0171058-02bb-350a-aa6b-4f7358e5fe7d",
                        "tags": [
                            "plural"
                        ],
