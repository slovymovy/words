                    {
                        "sense_id": "1c1a84d1-e4bb-3f14-9c6d-922234783ceb",
                        "entry_id": "970c8d16-a29a-38d2-a053-a64fcc3933a0",
                        "glosses": [
                            "Mise en retrait de la première ligne d’un paragraphe pour le rendre plus lisible."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1de448e4-6f6d-492e-a8e5-e53f94c851d5",
                                "sense_id": "1c1a84d1-e4bb-3f14-9c6d-922234783ceb",
                                "text": "L’indentation est la norme dans la typographie française mais pas anglo-saxonne."
                            }
                        ]
                    },
                    {
                        "sense_id": "43c534b7-aa7e-3b9f-9575-fba89208104e",
                        "entry_id": "970c8d16-a29a-38d2-a053-a64fcc3933a0",
                        "glosses": [
                            "Retrait des lignes d’un bloc, pour les distinguer de celles qui ne font pas partie du bloc"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "00c0a7d0-d7c8-4dba-a031-be01f6614cfd",
                                "sense_id": "43c534b7-aa7e-3b9f-9575-fba89208104e",
                                "text": "Une mauvaise indentation n’empêche pas un programme en C de fonctionner, mais elle est catastrophique pour un programme en Python."
                            }
                        ]
                    },
                    {
                        "sense_id": "44ca8ed7-2588-31a1-91c7-527f867c25b5",
                        "entry_id": "970c8d16-a29a-38d2-a053-a64fcc3933a0",
                        "glosses": [
                            "Avancée de la mer dans les terres."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5fc8d810-a0f6-47b3-b0b2-3b44e47bc5bb",
                                "sense_id": "44ca8ed7-2588-31a1-91c7-527f867c25b5",
                                "text": "Une crénelure est une suite d'indentations."
                            },
                            {
                                "example_id": "9190a644-28c2-437b-aaf2-40dbf243e648",
                                "sense_id": "44ca8ed7-2588-31a1-91c7-527f867c25b5",
                                "text": "— La lisière de la masse principale de la banquise […] est sinueuse et découpée par de plus ou moins vastes indentations, constituant un danger pour les navires; […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "09d36d41-0d2c-3a0d-9bf6-3685630f5a73",
                        "entry_id": "970c8d16-a29a-38d2-a053-a64fcc3933a0",
                        "glosses": [
                            "Échancrure ayant l’aspect d'une morsure produite par une dent."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "18e55f8f-bb83-4ac8-9f62-53220504d607",
                                "sense_id": "09d36d41-0d2c-3a0d-9bf6-3685630f5a73",
                                "text": "Le cortex est épais sans indentation de la substance blanche dans la substance grise."
                            }
                        ]
