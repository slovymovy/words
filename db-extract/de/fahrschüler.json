                "senses": [
                    {
                        "sense_id": "07a69c33-a2f9-3f86-b3ba-ca546d08a6b3",
                        "entry_id": "9cacdf4e-1b1e-355f-9577-60ef6c9a5700",
                        "glosses": [
                            "Élève conducteur, élève d'auto-école."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9064c37b-28ec-41c0-9444-8126629e4af9",
                                "sense_id": "07a69c33-a2f9-3f86-b3ba-ca546d08a6b3",
                                "text": "Als Fahrschüler verwechselt man schon einmal die Pedale.",
                                "translation": "En tant qu’élève conducteur, on confond au moins une fois les pédales."
                            },
                            {
                                "example_id": "7a3687fb-5c3b-4c92-a950-6d61bd95d423",
                                "sense_id": "07a69c33-a2f9-3f86-b3ba-ca546d08a6b3",
                                "text": "Rund die Hälfte der Fahrschüler fällt durch die theoretische Prüfung. Und jeder Dritte scheitert in der Praxis. Doch woher kommen die hohen Durchfall-Quoten?",
                                "translation": "Près de la moitié des élèves conducteurs échouent à l’examen théorique. Et un tiers échoue à l’examen pratique. Mais d’où viennent ces taux d'échec élevés ?"
                            }
                        ]
                    }
                ],
