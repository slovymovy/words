                ],
                "senses": [
                    {
                        "sense_id": "bb5beff9-1a73-3ce3-9d49-7280a132e86e",
                        "entry_id": "4f8aaa00-531c-3016-ac09-5c32a8acce07",
                        "glosses": [
                            "Tasche, die man am Gepäckträger oder Halterungen (Lowridern) beim Hinterrad oder Vorderrad befestigen kann"
                        ],
                        "tags": [
                            "Fahrrad"
                        ],
                        "examples": [
                            {
                                "example_id": "7bd4e744-f524-406b-9d62-f7f17d0a512d",
                                "sense_id": "bb5beff9-1a73-3ce3-9d49-7280a132e86e",
                                "text": "„Sind günstige Fahrradtaschen vom Discounter so gut wie teure Markenprodukte?“"
                            },
                            {
                                "example_id": "600e9756-e661-4f25-a1dc-ce1509b5a7f4",
                                "sense_id": "bb5beff9-1a73-3ce3-9d49-7280a132e86e",
                                "text": "Bei einer Fahrradtour nehme ich immer meine Fahrradtaschen mit."
                            },
                            {
                                "example_id": "bb7e46d0-909a-4843-aba2-467be340da9d",
                                "sense_id": "bb5beff9-1a73-3ce3-9d49-7280a132e86e",
                                "text": "Unsere Fahrradtaschen sind so geräumig, dass man einen Einkauf vom Supermarkt unterbringt."
                            },
                            {
                                "example_id": "19a53d86-1a1b-4c99-a84c-7f98f06ade13",
                                "sense_id": "bb5beff9-1a73-3ce3-9d49-7280a132e86e",
                                "text": "„In Fahradtaschen lässt sich fast alles sicher verstauen.“"
                            },
                            {
                                "example_id": "100442f9-f793-4954-93d4-9bf815aa324b",
                                "sense_id": "bb5beff9-1a73-3ce3-9d49-7280a132e86e",
                                "text": "„Wer seine Einkäufe in einer Fahrradtasche verstauen will, braucht […] einen Gepäckträger.“"
                            },
                            {
                                "example_id": "2a43d17e-ea40-4186-9909-5b10e68e18c7",
                                "sense_id": "bb5beff9-1a73-3ce3-9d49-7280a132e86e",
                                "text": "„Gerollt oder gefaltet? Was soll ganz nach oben? So packen Sie Ihre Fahrradtaschen richtig: […]“"
                            },
                            {
                                "example_id": "4c72b319-9a64-424f-92fc-dfb0afb4d666",
                                "sense_id": "bb5beff9-1a73-3ce3-9d49-7280a132e86e",
                                "text": "„Sie gehören zum wichtigsten Zubehör im Alltag und auf Reisen, ob als einfacher Sack oder ausgeklügeltes Transportsystem: Fahrradtaschen machen ein Fahrrad erst so richtig alltagstauglich.“"
                            },
                            {
                                "example_id": "da834bc1-fcc4-400f-8be5-d4824468c2da",
                                "sense_id": "bb5beff9-1a73-3ce3-9d49-7280a132e86e",
                                "text": "„Beamte hatten am Montag nach einem Hinweis eine Fahrradtasche überprüft, die an einem Brückenpfeiler im Stadtteil Gaarden abgestellt worden war […].“"
                            },
                            {
                                "example_id": "e6d9f515-6b14-46d8-88be-00b18b0b1a0a",
                                "sense_id": "bb5beff9-1a73-3ce3-9d49-7280a132e86e",
                                "text": "„Wer mit Gepäck reist, sollte ein stabiles Rad mit guten Gepäckträgern fahren, zudem sind Fahrradtaschen, die fest am Gepäckträger eingehängt werden, aufgrund der zeitweise groben Piste anzuraten.“"
                            },
                            {
                                "example_id": "d2586efa-76c8-4ca2-ba0e-8d4f72b9d93c",
                                "sense_id": "bb5beff9-1a73-3ce3-9d49-7280a132e86e",
                                "text": "[Bei einer Diebstahl-Versicherung fürs Fahrrad] „sind weder daran gehängte Fahrradtaschen, noch der Fahrradhelm abgesichert.“"
                            },
                            {
                                "example_id": "c142324a-4558-4bdd-b82d-2dacc18f0676",
                                "sense_id": "bb5beff9-1a73-3ce3-9d49-7280a132e86e",
                                "text": "„Im Flämingbahnhof Bad Belzig gibt es einen Fahrradverleih: Herren-, Damen- und Kinderräder mit diversem Zubehör stehen zur Verfügung: von der Tandemstange, Kindersitz oder Fahrradanhänger für die Familientour über Fahrradtaschen bis hin zu Kartenhalter und GPS-Gerät für den anspruchsvollen Radler.“"
                            },
                            {
                                "example_id": "53139dfc-8623-42a4-a9c1-f7f7fc433973",
                                "sense_id": "bb5beff9-1a73-3ce3-9d49-7280a132e86e",
                                "text": "„Caro: »Anfang Juni waren wir abends Containern beim Edeka bei uns in Olching, also Lebensmittel aus der Mülltonne retten. Wir hatten bereits zwei Fahrradtaschen und zwei Rucksäcke gefüllt, als eine Polizeistreife um die Ecke gebogen kam. […]«“"
                            },
                            {
                                "example_id": "76974fa9-f7ee-42a4-9dc5-e2f7cad6384d",
                                "sense_id": "bb5beff9-1a73-3ce3-9d49-7280a132e86e",
                                "text": "„In Tettnang werden hauptsächlich Fahrradtaschen hergestellt - 180.000 Stück pro Jahr.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
