                    {
                        "translation_id": "68fb3937-c669-415a-aba0-144bfff1eb42",
                        "source_entry_id": "e2e48ded-f3cc-30f1-8478-fbea17583b27",
                        "source_sense_id": "7b340400-f019-3792-aee5-e7d8861d9bca",
