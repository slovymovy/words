                                                "sense_id": "29af4a53-1cc8-3fc2-b750-a96b3b6be640",
                                                "text": "Un cabinet hors-d’œuvre."
                                            },
                                            {
                                                "example_id": "f424a7b2-a349-4abc-b792-9224936b0401",
                                                "sense_id": "29af4a53-1cc8-3fc2-b750-a96b3b6be640",
                                                "text": "Ce bâtiment a tant de mètres hors-d’œuvre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6283f9de-a531-377c-b854-6b51030218f3",
                                        "entry_id": "b087f708-ac48-3bc2-ba87-77dff70f357c",
                                        "glosses": [
                                            "Qui n’est pas lié directement au sujet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8ac97d6-b440-402b-b9c4-00527d54525d",
                                                "sense_id": "6283f9de-a531-377c-b854-6b51030218f3",
                                                "text": "Cette description est hors-d’œuvre."
                                            }
