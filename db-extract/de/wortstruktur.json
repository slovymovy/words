                "senses": [
                    {
                        "sense_id": "1ea4d8da-e6ff-3fb1-8235-fa23a4fb631d",
                        "entry_id": "75258ea7-0e17-325a-af96-3977885b79b8",
                        "glosses": [
                            "Aufbau von Wörtern aus Morphemen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d14cc99-5f6e-4c24-b4cb-6629b85597c1",
                                "sense_id": "1ea4d8da-e6ff-3fb1-8235-fa23a4fb631d",
                                "text": "„Therapieziele im Bereich der Wortstruktur und Wortbetonung werden im Rahmen nichtlinearer Ansätze beschrieben.“"
                            },
                            {
                                "example_id": "b3f4bffc-fbf1-4b16-800c-d3033b318828",
                                "sense_id": "1ea4d8da-e6ff-3fb1-8235-fa23a4fb631d",
                                "text": "„Das bedeutet jedoch nicht, dass die Wortstruktur, die beim Übersetzen auch relevant ist, außer Beachtung gelassen wird.“"
                            },
                            {
                                "example_id": "6f61e8ed-6cc5-484c-a176-966da3ff5428",
                                "sense_id": "1ea4d8da-e6ff-3fb1-8235-fa23a4fb631d",
                                "text": "„Geben Sie für diese drei Wortschöpfungen mögliche Morpheme sowie die Wortstruktur an.“"
                            },
                            {
                                "example_id": "84ca66fc-d66f-469b-8c3d-864e2dcb630b",
                                "sense_id": "1ea4d8da-e6ff-3fb1-8235-fa23a4fb631d",
                                "text": "„Sie äußern sich als Lautentstellung, Lautvertauschungen oder Veränderungen der Wortstruktur.“"
                            },
                            {
                                "example_id": "8f8a5bb7-5fd0-4d1a-8ce4-79b4b799b680",
                                "sense_id": "1ea4d8da-e6ff-3fb1-8235-fa23a4fb631d",
                                "text": "„Nach der Wortstruktur kann zwischen primären und sekundären Präpositionen unterschieden werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
