                "senses": [
                    {
                        "sense_id": "def780fe-65f7-3bea-8c1f-69a83c5504d4",
                        "entry_id": "8fc1c5d8-068d-342a-81ca-062b6bb65c56",
                        "glosses": [
                            "ein Anwendungsprogramm, das nach dem Client-Server-Modell arbeitend nicht lokal auf dem Rechner des Benutzers ausgeführt wird, sondern wo die Datenverarbeitung und -auswertung auf einem entfernten Webserver stattfindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "42bcee6b-9a8d-4e88-b846-10b08a972d3d",
                                "sense_id": "def780fe-65f7-3bea-8c1f-69a83c5504d4",
                                "text": "Kennst du eine gute Webanwendung, mit der man online Bilder in ein anderes Format umzuwandeln kann?"
                            },
                            {
                                "example_id": "009fd1f2-e278-41e5-841b-5697b8bb09be",
                                "sense_id": "def780fe-65f7-3bea-8c1f-69a83c5504d4",
                                "text": "„Web Services nennt man die nahtlose Zusammenarbeit disparater Webanwendungen und Datenbanken, die durch vier Standards ermöglicht wird.“"
                            },
                            {
                                "example_id": "9df264fc-c27e-419b-90bf-123806c71b41",
                                "sense_id": "def780fe-65f7-3bea-8c1f-69a83c5504d4",
                                "text": "„Diese Webanwendung läuft aus historischen Gründen auf verteilten Systemen. “"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
