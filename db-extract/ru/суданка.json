                "senses": [
                    {
                        "sense_id": "0f343b65-6f03-3f6e-8a00-d7c108923a95",
                        "entry_id": "a3d38a33-d93b-362f-a9b5-f0c8452b8b8a",
                        "glosses": [
                            "гражданка, жительница или уроженка Судана"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "413dc4c7-2083-45dc-b06b-cae033c2f299",
                                "sense_id": "0f343b65-6f03-3f6e-8a00-d7c108923a95",
                                "text": "Красивые суданки, шествуя гордо и свободно, при встрече с европейцем стараются прикрыться, значит, взгляд европейца, вероятно, излишне возбуждён их наготой."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "22a7c308-df3e-4ac1-85b8-ae5978e70fa1",
                        "source_entry_id": "a3d38a33-d93b-362f-a9b5-f0c8452b8b8a",
                        "source_sense_id": "0f343b65-6f03-3f6e-8a00-d7c108923a95",
                        "source_sense_description": "уроженка или жительница Судана",
                        "target_lang_word": "Sudanese",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sudanese",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "607bceb7-550b-397a-860c-a75aaa5cf5c0",
                                        "entry_id": "66ddb098-74d4-3799-ac26-9b1499ce717d",
                                        "glosses": [
                                            "Of, from, or pertaining to the country of Sudan, or the Sudanese people."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3d340234-c5b5-4f80-841c-e81a765a7abc",
                                                "sense_id": "607bceb7-550b-397a-860c-a75aaa5cf5c0",
                                                "text": "Mr. al-Gada is Sudanese, but was raised in a sleepy town in northeastern Saudi Arabia, where his father was a car mechanic."
                                            },
                                            {
                                                "example_id": "f0405750-33cb-495b-ae96-50449bdf07b9",
                                                "sense_id": "607bceb7-550b-397a-860c-a75aaa5cf5c0",
                                                "text": "Ridding the country of the RSF has come at a great cost for the Sudanese people who are often caught in the crossfire."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Sudanese",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "232570a4-bfd8-3a63-a2a1-0b734aa33cca",
                                        "entry_id": "c72382da-6899-3165-889e-141c1195454d",
                                        "glosses": [
                                            "A person from Sudan or of Sudanese descent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4cfa610e-7363-424b-9a95-f3564b6a27f5",
                                                "sense_id": "232570a4-bfd8-3a63-a2a1-0b734aa33cca",
                                                "text": "But few Sudanese can forget the group’s participation in a massacre of over 120 democracy protesters in 2019."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
