                        "examples": [
                            {
                                "example_id": "f5f7c93c-4883-45e9-85b1-f373883e46bc",
                                "sense_id": "957bd082-fef0-3185-af55-998f9790192c",
                                "text": "Volgens Le Monde vond de Franse justitie de informatie op een laptop in een vuilcontainer in de Brusselse wijk Schaarbeek. Op de computer stond ook een mapje \"Groep Schiphol\". De twee verdachten Ayari en Krayem zijn inmiddels opgepakt."
                            },
                            {
                                "example_id": "49b7ff56-a64f-4d47-b3de-9cd739d0c018",
                                "sense_id": "957bd082-fef0-3185-af55-998f9790192c",
                                "text": "In september nog werd een pasgeboren baby in Den Haag te vondeling gelegd en in maart in Breda. En vorig jaar oktober redden hulpdiensten in Amsterdam een pasgeboren meisje dat was gedumpt in een ondergrondse vuilcontainer."
                            }
                        ]
                    }
