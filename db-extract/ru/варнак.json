                    }
                ],
                "senses": [
                    {
                        "sense_id": "155c0994-b1f5-33c1-88a2-70c688c6765b",
                        "entry_id": "09a8de12-3952-3e62-85cb-69c18c062151",
                        "glosses": [
                            "Délinquant, bandit, en particulier, évadé des camps de prisonniers en Sibérie."
                        ],
                        "tags": [
                            "Illégalité"
                        ],
                        "examples": [
                            {
                                "example_id": "c2d02553-d309-4b91-8cb8-c72bc043fc7f",
                                "sense_id": "155c0994-b1f5-33c1-88a2-70c688c6765b",
                                "text": "Человек, отправленный в ссылку — Ссы́льный или Ссыльная, а название ссыльного или каторжного, бежавший, из тюрьмы или с места поселения в Сибири — Варна́к, его жена — Варначиха или Варначка.",
                                "translation": "Une personne envoyée en exil est appelée un exilé, et le nom d'un exilé ou d'un condamné qui s'est évadé de prison ou d'un lieu de peuplement en Sibérie est appelé varnak, sa femme varnatchikha ou varnachka."
                            }
                        ]
                    }
                ],
