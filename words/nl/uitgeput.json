                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het harde werken in de tuin heeft hem volledig <w>uitgeput</w>.",
                            "target_lang_translations": {
                                "en": "The hard work in the garden has completely <w>exhausted</w> him.",
                                "ru": "Тяжелая работа в саду полностью его <w>измотала</w>.",
                                "zh": "在花园里的辛苦劳作让他<w>精疲力竭</w>。"
                            }
                        },
                        {
                            "text": "We hebben al onze mogelijkheden <w>uitgeput</w> om een oplossing te vinden.",
                            "target_lang_translations": {
                                "en": "We have <w>exhausted</w> all our possibilities to find a solution.",
                                "ru": "Мы <w>исчерпали</w> все наши возможности, чтобы найти решение.",
                                "zh": "为了找到解决方案，我们已经<w>耗尽</w>了所有可能的方法。"
                            }
