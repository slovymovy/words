                "senses": [
                    {
                        "sense_id": "fb8158a6-a102-32d4-82a2-04e6b5b72aa3",
                        "entry_id": "15125de6-60d5-3483-99b9-c19f62fcaf9d",
                        "glosses": [
                            "imię żeńskie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ece9dce0-8e57-4ab9-933b-82a9a5335f8d",
                                "sense_id": "fb8158a6-a102-32d4-82a2-04e6b5b72aa3",
                                "text": "W Polsce coraz częściej spotyka się oryginalne imiona, jak na przykład Amanda."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "b10d5eac-87a6-3f36-af64-c641da884dcf",
                        "entry_id": "15125de6-60d5-3483-99b9-c19f62fcaf9d",
                        "glosses": [
                            "planetoida o numerze katalogowym 725, z pasa głównego planetoid, odkryta w 1911 r."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bfe102e9-f3c4-4d83-9043-cf164603e585",
                                "sense_id": "b10d5eac-87a6-3f36-af64-c641da884dcf",
                                "text": "Amanda porusza się w obszarze między orbitami Marsa i Jowisza."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "aaab6923-9566-4552-8825-fd271db06ec2",
                        "source_entry_id": "15125de6-60d5-3483-99b9-c19f62fcaf9d",
                        "source_sense_id": "fb8158a6-a102-32d4-82a2-04e6b5b72aa3",
                        "target_lang_word": "Amanda",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Amanda",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4941aa8f-b0e3-3e40-95ae-6bc9533ab01e",
                                        "entry_id": "01206b26-7dc7-34b4-a4ad-3d92d126d673",
                                        "glosses": [
                                            "A female given name from Latin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8c04654-bad9-47ef-a0a1-482446126fc4",
                                                "sense_id": "4941aa8f-b0e3-3e40-95ae-6bc9533ab01e",
                                                "text": "O there is a sweet era in the life of man, when ( the brain being tender and fibrillous, and more like pap than anything else ) - a story read of two fond lovers, separated from each other by cruel parents, and by still more cruel destiny -\nAmandus - He\nAmanda - She -\neach ignorant of the other's course."
                                            },
                                            {
                                                "example_id": "8408fa71-965f-481f-ac88-41feceb98eba",
                                                "sense_id": "4941aa8f-b0e3-3e40-95ae-6bc9533ab01e",
                                                "text": "Sue always thought of her offspring as Amanda. Allowing her to name the child had been one of the last indulgences that Brian had seen fit to bestow. Even then he had not the generosity to conceal his displeasure at her choice. Pretentious. Snobbish. Affected. The baby had been 'Mandy' from the day of her birth and, once Brian had really got the hang of high-rise/comprehensive linguistic mores, 'Mand'."
                                            },
                                            {
                                                "example_id": "58600426-e9f0-4197-8093-3b38514c0798",
                                                "sense_id": "4941aa8f-b0e3-3e40-95ae-6bc9533ab01e",
                                                "text": "Both Bobba and Coristine are listed in internal OPM records reviewed by WIRED as “experts” at OPM, reporting directly to Amanda Scales, its new chief of staff."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "28487700-9469-395a-a747-d1b671dfaeb7",
                                        "entry_id": "01206b26-7dc7-34b4-a4ad-3d92d126d673",
                                        "glosses": [
                                            "A place in the United States:",
                                            "A township in Allen County, Ohio."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
