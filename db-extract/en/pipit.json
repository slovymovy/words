                                        "examples": [
                                            {
                                                "example_id": "05beaa7a-74de-4259-bd8b-68e954bcdd70",
                                                "sense_id": "e5f7a488-c354-313a-aad8-40ad251b8ef7",
                                                "text": "Piepers zijn vooral vogels van terrein met lage begroeiing en zingen terwijl de uit de lucht neerdalen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c8c13b0e-5b9f-3fee-84a2-ad5dc6803ed3",
                                        "entry_id": "f8e4ea23-e51a-3293-b3c1-50cf3780b453",
                                        "glosses": [
