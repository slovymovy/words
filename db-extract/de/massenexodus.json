                ],
                "senses": [
                    {
                        "sense_id": "ecaf98d9-dd64-326b-a378-17fdb87f6233",
                        "entry_id": "31e4fecb-e735-3822-822e-4bf6ed734069",
                        "glosses": [
                            "große Fluchtbewegung aus einem Gebiet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "332de2dd-6229-45e0-8468-3edd8174996d",
                                "sense_id": "ecaf98d9-dd64-326b-a378-17fdb87f6233",
                                "text": "„Das Wahlergebnis löste unter den Weißen kurzzeitig eine Panik aus und drohte zu einem Massenexodus der weißen Siedler anzuschwellen, wie es einige Jahre zuvor in Mosambik geschehen war.“"
                            },
                            {
                                "example_id": "6451efb2-03f1-446e-8ca6-b82eba1e3694",
                                "sense_id": "ecaf98d9-dd64-326b-a378-17fdb87f6233",
                                "text": "„Gleichzeitig erlebte Afghanistan aufgrund des anhaltenden Kriegszustands und zunehmender wirtschaftlicher Perspektivlosigkeit einen Massenexodus seiner Bevölkerung.“"
                            },
                            {
                                "example_id": "d5059abd-6d7e-46a8-9d96-add2a399bf7f",
                                "sense_id": "ecaf98d9-dd64-326b-a378-17fdb87f6233",
                                "text": "„Der Engländer William Smith, Angestellter der Royal African Company, verweist in einer kurzen Bemerkung von 1744 auf eine schwere politische Krise in Benin, bei der der Oba mehrere Gegner verfolgen und ermorden ließ, was zu einem Massenexodus der Bevölkerung aus der Stadt geführt habe.“"
                            },
                            {
                                "example_id": "4e62d0a8-a740-4fec-b600-6f1fcda6ca7d",
                                "sense_id": "ecaf98d9-dd64-326b-a378-17fdb87f6233",
                                "text": "„Ab Juli kamen Flugzeuge bei den erbarmungslosen Säuberungsaktionen zum Einsatz, um die Einwohner zum Massenexodus zu zwingen – auf jeden, der nicht rechtzeitig in Deckung gehen konnte, wurde gezielt.“"
                            },
                            {
                                "example_id": "0c5ea11d-c935-44e2-8c98-e4cbd6419f75",
                                "sense_id": "ecaf98d9-dd64-326b-a378-17fdb87f6233",
                                "text": "„Shalom Aleichem dokumentierte in schmerzlichen Schilderungen den Massenexodus aus dem russischen ›Ansiedlungsrayon‹ in die Vereinigten Staaten von Amerika.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
