                {
                    "sense_id": "b6a15f40-9a0e-3249-ad3f-6b39cfd32a3c",
                    "sense_definition": "W sposób całkowity, zupełny; bez żadnych braków czy wyjątków.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "completeness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ojej, <w>całkiem</w> o tym zapomniałam!",
                            "target_lang_translations": {
                                "ru": "Ой, я <w>совсем</w> об этом забыла!",
                                "en": "Oh, I <w>completely</w> forgot about that!",
                                "nl": "Oei, ik ben dat <w>helemaal</w> vergeten!",
                                "de": "Oh je, das habe ich <w>völlig</w> vergessen!",
                                "fr": "Oh là là, j'ai <w>complètement</w> oublié ça !",
                                "it": "Oh, me ne sono <w>completamente</w> dimenticata!",
                                "cs": "Jejda, <w>úplně</w> jsem na to zapomněla!",
                                "tr": "Eyvah, bunu <w>tamamen</w> unutmuşum!",
                                "es": "¡Vaya, se me ha olvidado <w>completamente</w>!",
                                "zh": "哎呀，我<w>完全</w>把这事儿给忘了！"
                            }
                        },
                        {
                            "text": "Twój pomysł jest <w>całkiem</w> inny od mojego.",
                            "target_lang_translations": {
                                "ru": "Твоя идея <w>совершенно</w> отличается от моей.",
                                "en": "Your idea is <w>entirely</w> different from mine.",
                                "nl": "Jouw idee is <w>volledig</w> anders dan het mijne.",
                                "de": "Deine Idee ist <w>gänzlich</w> anders als meine.",
                                "fr": "Ton idée est <w>totalement</w> différente de la mienne.",
                                "it": "La tua idea è <w>del tutto</w> diversa dalla mia.",
                                "cs": "Tvůj nápad je <w>úplně</w> jiný než můj.",
                                "tr": "Senin fikrin benimkinden <w>tamamen</w> farklı.",
                                "es": "Tu idea es <w>totalmente</w> diferente a la mía.",
                                "zh": "你的想法和我的<w>完全</w>不同。"
                            }
                        }
                    ],
