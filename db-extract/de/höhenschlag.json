                "senses": [
                    {
                        "sense_id": "a6fd9e3a-f7d6-34c6-9627-54384800a04f",
                        "entry_id": "4f0b25c4-7738-3e62-924b-5a771fb85d8c",
                        "glosses": [
                            "vertikale Abweichung der Spur bei einem Rad, sodass es beim Drehen unrund läuft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "212a49cd-6661-45f6-9471-0844143f5af9",
                                "sense_id": "a6fd9e3a-f7d6-34c6-9627-54384800a04f",
                                "text": "„Prüfen Sie noch, ob die Felge keinen Höhenschlag hat.“"
                            },
                            {
                                "example_id": "a7221e9c-e3f0-4262-9c35-534457a49f67",
                                "sense_id": "a6fd9e3a-f7d6-34c6-9627-54384800a04f",
                                "text": "„Laufräder sollte man immer mal wieder im Stand darauf kontrollieren, ob sie noch rund laufen, also ohne Seiten- oder Höhenschlag.“"
                            },
                            {
                                "example_id": "1db08f79-5694-4588-b8fe-d112bbaf58b9",
                                "sense_id": "a6fd9e3a-f7d6-34c6-9627-54384800a04f",
                                "text": "„Denn damit die Kohlen nicht springen, sind bei Motorradmotoren gerade mal 0,02 mm Höhenschlag üblich, was nicht arg großzügig ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
