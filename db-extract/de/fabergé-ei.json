                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db78afa9-7cbd-455f-97c7-9ea3f5fb712a",
                                "sense_id": "d477762f-db32-3d68-a943-4fad99415daa",
                                "text": "„Er trug den Leuchtenden Trapezoeder vorsichtig in beiden Händen, als wäre er ebenso zerbrechlich und wertvoll wie ein Fabergé-Ei.“"
                            },
                            {
                                "example_id": "eeeba578-efa8-4c90-8703-89d171c2c759",
                                "sense_id": "d477762f-db32-3d68-a943-4fad99415daa",
                                "text": "„Er ist ein Phantom, das überall gleichzeitig ist und durchaus Sinn für Ironie hat. Wie im Falle des Betrugs mit den Fabergé-Eiern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
