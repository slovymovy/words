                                "target_senses": [
                                    {
                                        "sense_id": "5d591bb0-93ca-3675-936f-d5f3813be3ee",
                                        "entry_id": "f7b3281a-fd2d-3188-96bd-8afba3cf5cb8",
                                        "glosses": [
                                            "Mappe für/mit Schreibutensilien"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4691363a-2fb9-40f2-9b88-c6968a3dc86a",
                                                "sense_id": "5d591bb0-93ca-3675-936f-d5f3813be3ee",
                                                "text": "„Unter den ersten Sachen war auch eine Schreibmappe, deren Deckel eine Photographie zeigte, das Bild seiner Schwester.“"
                                            }
