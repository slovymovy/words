                "senses": [
                    {
                        "sense_id": "a9c323df-9c42-303e-937c-38aad3d46954",
                        "entry_id": "553c6089-1f8c-39db-b132-db8c1fae1e28",
                        "glosses": [
                            "eine einheitliche, zusammenfassende, systematische, möglichst allumfassende Sammlung von Rechtsvorschriften"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "72143cad-7998-4c6e-a293-ce493459c2f3",
                                "sense_id": "a9c323df-9c42-303e-937c-38aad3d46954",
                                "text": "„Ist eine Kodifikation auf nationaler Ebene noch zeitgemäß?“"
                            },
                            {
                                "example_id": "6ec3b0d3-ff87-4d6e-bed6-4f21b4d933cd",
                                "sense_id": "a9c323df-9c42-303e-937c-38aad3d46954",
                                "text": "„Im Verlauf des 5. Jahrhunderts v.Chr. zwangen die Plebejer dem patrizischen Adel die Kodifikation des geltenden Gewohnheitsrechts (XII-Tafel-Gesetz) sowie die zivilrechtliche Gleichstellung […] ab.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a98d9383-14b5-4dbb-91b0-3cea674d488a",
                        "source_entry_id": "553c6089-1f8c-39db-b132-db8c1fae1e28",
                        "source_sense_id": "a9c323df-9c42-303e-937c-38aad3d46954",
                        "target_lang_word": "codification",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "codification",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bc636cd1-c909-39c5-bae1-8be24b386f02",
                                        "entry_id": "851b2ecd-e5dc-3a0e-be1a-86132efad05e",
                                        "glosses": [
                                            "The process of precisely formulating a statement, such as a code of laws."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "477f6133-bae7-45af-82b4-83381b639746",
                                                "sense_id": "bc636cd1-c909-39c5-bae1-8be24b386f02",
                                                "text": "The task force spent months on the codification of their mandate."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "03eab6bd-da93-31db-9577-8563cba2c197",
                                        "entry_id": "851b2ecd-e5dc-3a0e-be1a-86132efad05e",
                                        "glosses": [
                                            "The act or result of arranging something into a code; the act of setting down a body of knowledge in a systematic way."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e1ebfc32-abea-4b6b-a5a4-fcb7a6f5a7eb",
                                                "sense_id": "03eab6bd-da93-31db-9577-8563cba2c197",
                                                "text": "The link between language norms and the codification of a language – in dictionaries, grammars and usage guides – is well accepted."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5233acf6-52c9-4ab9-9b9d-93ed495e2184",
                        "source_entry_id": "553c6089-1f8c-39db-b132-db8c1fae1e28",
                        "source_sense_id": "a9c323df-9c42-303e-937c-38aad3d46954",
                        "target_lang_word": "codification",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "codification",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d054ea2b-2c14-32da-9808-0fbe6416e89c",
                                        "entry_id": "dffa5b63-020a-3550-99b5-ae5b816fb21b",
                                        "glosses": [
                                            "Action de codifier ou résultat de cette action."
                                        ],
                                        "tags": [
                                            "Didactique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b27effb8-370d-4686-a1d0-1888216eec46",
                                                "sense_id": "d054ea2b-2c14-32da-9808-0fbe6416e89c",
                                                "text": "La codification est un acte tranchant du législateur, qui coupe en quelque sorte le droit de ses origines, le fonde en entier sur la raison, la justice, l’intérêt public, l’accord et la dépendance mutuelle des différents articles, et le dispense de chercher des précédents ou des titres en dehors d’un instrument authentique, au delà du jour de la promulgation"
                                            },
                                            {
                                                "example_id": "6b49ae08-70dc-4145-96f9-ecbbebd6f15e",
                                                "sense_id": "d054ea2b-2c14-32da-9808-0fbe6416e89c",
                                                "text": "La codification de la charia par les écoles et rites divers […] représente un modèle idéal de conduite qui a été et est souvent foulé aux pieds par la coutume, l'usage et la tradition locale."
                                            },
                                            {
                                                "example_id": "7f8b3041-07bc-49e3-86ea-31914632cf24",
                                                "sense_id": "d054ea2b-2c14-32da-9808-0fbe6416e89c",
                                                "text": "Les lois représentent, entre autres choses, une codification d'une très large part de la morale publique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
