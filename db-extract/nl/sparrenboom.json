                "senses": [
                    {
                        "sense_id": "99e3365c-bddf-31e4-96d6-de30c058db80",
                        "entry_id": "6d6f8211-4d11-3818-995d-88972dfd4e94",
                        "glosses": [
                            "een spar Picea"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "991541fe-c1b5-408d-a7ca-53c4d0f3a212",
                                "sense_id": "99e3365c-bddf-31e4-96d6-de30c058db80",
                                "text": "In het Kurpark staat hij wat verscholen onder een grote sparrenboom."
                            },
                            {
                                "example_id": "286722dd-4ae0-4d77-aff4-dc306dca08fc",
                                "sense_id": "99e3365c-bddf-31e4-96d6-de30c058db80",
                                "text": "De sparrenboom werd donderdag geveld in het Hertogenwoud in Eupen, om vrijdagmorgen om 6 uur aan te komen op de Grote Markt. De reusachtige kerstboom wordt geschonken door Wallonië en heeft een duurzaam PEFC-label. De boom is een fijnspar, een soort die veel gebruikt wordt als kerstboom en tot wel 50 meter groot kan worden."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b45d2c21-1b61-4ad6-ae2e-7d7f0e1cb26f",
                        "source_entry_id": "6d6f8211-4d11-3818-995d-88972dfd4e94",
                        "source_sense_id": "99e3365c-bddf-31e4-96d6-de30c058db80",
                        "source_sense_description": "een spar",
                        "target_lang_word": "fir",
                        "target_lang_code": "en",
