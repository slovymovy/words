                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "220962f7-d441-4fa2-bc57-785a634d006d",
                                "sense_id": "aeadd5a2-5e5a-3c78-abc3-f6b9a722fec6",
                                "text": "Im Sommer trinke ich gerne eine Weinschorle."
                            },
                            {
                                "example_id": "94b01314-8c0e-4992-a6f8-3c3e663e8fe3",
                                "sense_id": "aeadd5a2-5e5a-3c78-abc3-f6b9a722fec6",
                                "text": "„Der Obmann ruft den Dank der Katzenmusikanten aus und schon laben wir uns an Hefezopf und belegtem Brot mit Schinken und Ei, es gibt Weinschorle und Bier, alles nicht zu knapp.“"
                            }
                        ],
