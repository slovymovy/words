                "senses": [
                    {
                        "sense_id": "8b5d5618-cb75-3ff9-9f52-b742475cf404",
                        "entry_id": "164e4fd4-fb92-30cd-a613-2673ddae8b3d",
                        "glosses": [
                            "Landschaft im östlichen Siebenbürgen (Rumänien), am Rande der Ostkarpaten"
                        ],
                        "tags": [
                            "geography"
                        ],
                        "examples": [
                            {
                                "example_id": "5d6b0998-a1bf-4469-a092-6e3723b04a5e",
                                "sense_id": "8b5d5618-cb75-3ff9-9f52-b742475cf404",
                                "text": "„Im Einklang mit den Prinzipien des amerikanischen Präsidenten Woodrow Wilson [14-Punkte-Programm/Selbstbestimmungsrecht der Völker] wollten sie [die ungarischen politischen Eliten] Wege finden, die eine möglichst große Autonomie für Siebenbürgen oder zumindest für das Szeklerland zu garantieren versprachen.“"
                            },
                            {
                                "example_id": "581140d2-4716-48f7-b9c3-dd25b2b08d64",
                                "sense_id": "8b5d5618-cb75-3ff9-9f52-b742475cf404",
                                "text": "„In Ungarn so wie in den ungarischen Distrikten Siebenbürgens und im Szeklerlande gab es keine Gesetze für den freien Landmann, wohl aber gab es für die Unterthanen Festsetzungen bezüglich der Gütergemeinschaft jenes Vermögens, welches dem Unterthan eigenthümlich gehörte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
