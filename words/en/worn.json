    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "cc81ca99-adfe-3820-92fc-d4869547a200",
                    "sense_definition": "Past participle of <w>wear</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I have <w>worn</w> this coat every winter for five years.",
                            "target_lang_translations": {
                                "ru": "Я <w>носил</w> это пальто каждую зиму в течение пяти лет.",
                                "zh": "这件大衣我五年来的每个冬天都<w>穿</w>着。"
                            }
                        },
                        {
                            "text": "The crown was <w>worn</w> by the king only on special occasions.",
                            "target_lang_translations": {
                                "ru": "Король <w>надевал</w> корону только по особым случаям.",
                                "zh": "国王只在特殊场合才<w>戴</w>这顶皇冠。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "have worn",
                        "be worn"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие прошедшего времени от глагола wear.",
                        "zh": "动词 wear 的过去分词形式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "носить",
                                "target_lang_sense_clarification": "одежду или аксессуары"
                            },
                            {
                                "target_lang_word": "надетый",
                                "target_lang_sense_clarification": "находящийся на ком-либо"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "穿",
                                "target_lang_sense_clarification": "指穿着衣物或佩戴饰品"
                            },
                            {
                                "target_lang_word": "戴",
                                "target_lang_sense_clarification": "指佩戴饰品或帽子"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "0ead58b5-d2f6-39d4-a6ff-6d0f2c81a4f9",
                    "sense_definition": "Damaged and shabby as a result of much use.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He decided to replace the <w>worn</w> tires on his car before the long trip.",
                            "target_lang_translations": {
                                "ru": "Он решил заменить <w>изношенные</w> шины на своей машине перед долгой поездкой.",
                                "zh": "他决定在长途旅行前换掉车上<w>磨损的</w>轮胎。"
                            }
                        },
                        {
                            "text": "The stone steps were <w>worn</w> smooth by the feet of thousands of visitors.",
                            "target_lang_translations": {
                                "ru": "Каменные ступени были <w>стерты</w> до гладкости ногами тысяч посетителей.",
                                "zh": "石阶被成千上万游客的脚步<w>磨</w>得光滑平整。"
                            }
                        }
                    ],
                    "synonyms": [
                        "shabby",
                        "tattered",
                        "threadbare",
                        "ragged",
                        "old"
                    ],
                    "antonyms": [
                        "new",
                        "pristine"
                    ],
                    "common_phrases": [
                        "worn out",
                        "badly worn",
                        "worn smooth"
                    ],
                    "target_lang_definitions": {
                        "ru": "Поврежденный, ветхий или потертый в результате длительного использования.",
                        "zh": "因长期使用而损坏、破旧或磨损的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "изношенный",
                                "target_lang_sense_clarification": "о вещах, механизмах"
                            },
                            {
                                "target_lang_word": "потертый",
                                "target_lang_sense_clarification": "о поверхности, ткани"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "磨损的",
                                "target_lang_sense_clarification": "指物体表面因摩擦而受损"
                            },
                            {
                                "target_lang_word": "破旧的",
                                "target_lang_sense_clarification": "指物品因使用时间长而显得陈旧"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a6f6b3b9-51f2-3f09-8727-e2fbe8d5ce64",
                    "sense_definition": "Looking extremely tired or exhausted.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After working three shifts in a row, she looked pale and <w>worn</w>.",
                            "target_lang_translations": {
                                "ru": "После трех смен подряд она выглядела бледной и <w>изможденной</w>.",
                                "zh": "连续上了三个班后，她看起来脸色苍白且十分<w>憔悴</w>。"
                            }
                        },
                        {
                            "text": "His <w>worn</w> face told the story of a difficult and stressful life.",
                            "target_lang_translations": {
                                "ru": "Его <w>изнуренное</w> лицо говорило о тяжелой и полной стресса жизни.",
                                "zh": "他那<w>疲惫的</w>面容诉说着他那充满压力与艰辛的生活。"
                            }
                        }
                    ],
                    "synonyms": [
                        "haggard",
                        "weary",
                        "exhausted",
                        "fatigued"
                    ],
                    "antonyms": [
                        "fresh",
                        "energetic"
                    ],
                    "common_phrases": [
                        "look worn",
                        "worn expression"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выглядящий крайне уставшим или изможденным.",
                        "zh": "看起来极其疲惫或憔悴的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "изможденный",
                                "target_lang_sense_clarification": "о внешнем виде человека"
                            },
                            {
                                "target_lang_word": "изнуренный",
                                "target_lang_sense_clarification": "крайне уставший"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "憔悴的",
                                "target_lang_sense_clarification": "形容人因疲劳而面色不好"
                            },
                            {
                                "target_lang_word": "疲惫的",
                                "target_lang_sense_clarification": "形容人极度劳累"
                            }
                        ]
                    }
                }
            ]
        }
    ]
