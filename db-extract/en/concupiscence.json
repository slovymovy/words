                                    {
                                        "sense_id": "3aafec91-bfbd-36bd-9ebb-446143ec9721",
                                        "entry_id": "ba2be13a-bdd7-3ba5-b65b-977d9022a6b8",
                                        "glosses": [
                                            "dringende, starke Lust auf etwas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1fd3b9a2-b343-4843-9b95-db844c257781",
                                                "sense_id": "3aafec91-bfbd-36bd-9ebb-446143ec9721",
                                                "text": "„Aber vielleicht sollte man ja bei einem Ausflug nach Heldra nicht nur den leiblichen Gelüsten frönen, sondern sein lückenhaftes Wissen um diese beiden Persönlichkeiten durch einen Besuch im Dorfmuseum auffrischen.“"
                                            },
                                            {
                                                "example_id": "a4c01bf9-7d9d-4420-ab17-6310ba15f829",
                                                "sense_id": "3aafec91-bfbd-36bd-9ebb-446143ec9721",
                                                "text": "„Kleine Gelüste machen einen jungen Mann kühn; die großen machen ihn stumpf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aebff0f2-0051-448c-9b10-ac09dc1818b8",
                        "source_entry_id": "0f86c3e5-9b2c-3e16-9e47-8aabbf896f8e",
                        "source_sense_description": "Ardent desire",
                        "target_lang_word": "Begehren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Begehren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "009cb86b-9cf5-33ff-a823-091bf7ce4ae3",
                                        "entry_id": "08451f35-4cb0-3cb6-8142-4cdfbe3d2a9f",
                                        "glosses": [
                                            "ein heftiges Verlangen nach etwas oder jemandem"
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "409cad4e-c368-4cb4-8557-ccd773e04d4d",
                                                "sense_id": "009cb86b-9cf5-33ff-a823-091bf7ce4ae3",
                                                "text": "Diktatoren fallen häufig durch ein starkes Begehren nach Macht auf."
                                            },
                                            {
                                                "example_id": "7e2ecf29-9d3e-4e83-a59e-54f723decd29",
                                                "sense_id": "009cb86b-9cf5-33ff-a823-091bf7ce4ae3",
                                                "text": "„Edmee’s Kälte hatte sein Begehren nach ihr nur gesteigert, er dachte also das gleiche Mittel anzuwenden, und er zweifelte nicht, daß der Gedanke, ihn zu verlieren, seine Braut einsehen machen werde, was sie an ihm besitze.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5969feb5-3489-31ef-acad-e2af10ebd6c1",
                                        "entry_id": "08451f35-4cb0-3cb6-8142-4cdfbe3d2a9f",
                                        "glosses": [
                                            "eine Anfrage, ein Ersuchen um etwas, das an jemanden gerichtet wird"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "80f52579-b9b5-49a4-8431-a9880f185e9f",
                                                "sense_id": "5969feb5-3489-31ef-acad-e2af10ebd6c1",
                                                "text": "Über das US-Justizministerium erreichte das Begehren die Schweizer Behörden."
                                            },
                                            {
                                                "example_id": "146d9694-71c2-498a-9141-18a54dfc7501",
                                                "sense_id": "5969feb5-3489-31ef-acad-e2af10ebd6c1",
                                                "text": "Der Butler öffnete uns die Tür und wir richteten unser Begehren an ihn."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c36baed1-b9ae-4b71-8704-80219fca663c",
