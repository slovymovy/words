                        "glosses": [
                            "Donner un caractère de zombie à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a918d41c-1c9c-4507-8920-a506240de413",
                                "sense_id": "6edcb14b-b25c-306e-b162-02d731e0b6cb",
                                "text": "Celui-ci veut contrôler toutes les consciences, les gouverner, les zombiser, en les instruisant sur ce qu’il faut ou ne pas enseigner, sur ce qu’il faut ou ne pas faire."
                            },
                            {
                                "example_id": "3a8b4a5a-6058-44b9-aa98-36aee61a10bb",
                                "sense_id": "6edcb14b-b25c-306e-b162-02d731e0b6cb",
                                "text": "Qu’à l’instar du vampire nocturne, il investit au gré de sa fantaisie des identités au-dessus de tout soupçon pour les zombiser ?"
                            }
                        ]
                    }
