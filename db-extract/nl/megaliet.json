                        "examples": [
                            {
                                "example_id": "4983f676-ae74-45dc-b70d-a6b3ee158502",
                                "sense_id": "bc9405b0-d057-3dc4-b4f1-675281a97b9f",
                                "text": "Net voor hij weer naar de VS vertrok heeft Amerikaans president Obama het wereldbekende Stonehenge bezocht in Zuid-Engeland, de duizenden jaren oude verzameling megalieten uit het Stenen Tijdperk."
                            },
                            {
                                "example_id": "941a1efb-25fe-4b72-8746-a148eb4f81d7",
                                "sense_id": "bc9405b0-d057-3dc4-b4f1-675281a97b9f",
                                "text": "De megalieten van de binnenste ring van Stonehenge zijn volgens geologen afkomstig van de Preseli-heuvels in Pembrokeshire, op ruim 200 kilometer van de Salisbury-vlakte waar het monument nu staat."
                            }
                        ]
