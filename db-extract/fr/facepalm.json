                        "entry_id": "a23c9a11-d4c1-321d-a6cc-0057efb25ecc",
                        "glosses": [
                            "Expression gestuelle consistant à se voiler la face de sa paume pendant un bref instant souvent enjoint d'une expression faciale de dégout."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "508970bd-da56-4b49-8d86-8509c13f6943",
                                "sense_id": "71220c57-ad19-380a-b8c3-a8de6cf03c05",
                                "text": "Dominique Cardon, qui est assis à côté de la ministre, amorce un facepalm embarrassé, avant que la ministre n’embraye sur une virulente mais courte diatribe, arguant du fait que tout cela n’est qu’un concept américain fait pour défendre les intérêts de Google, Apple et consorts… et ne quitte la table pour aller prendre son train."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "12467a9d-1df6-464d-a141-669d0162e214",
                        "source_entry_id": "a23c9a11-d4c1-321d-a6cc-0057efb25ecc",
                        "source_sense_id": "71220c57-ad19-380a-b8c3-a8de6cf03c05",
                        "target_lang_word": "facepalm",
