                                        "sense_id": "db423521-94d3-36e6-b9a8-11b6aa704a39",
                                        "entry_id": "45c2bd8c-af9d-3dc1-946d-d248f6de6c60",
                                        "glosses": [
                                            "onderdeel dat een te hoge stroom die tot schade aan een installatie zou leiden, blokkeert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bdfb09ac-7515-44fd-b71b-c1af01eeb1b0",
                                                "sense_id": "db423521-94d3-36e6-b9a8-11b6aa704a39",
                                                "text": "Vastberaden dook hij onder mijn bureau en kwam overeind met de diagnose dat het hoog tijd was voor ‘een stekkercentrale met overspanningsbeveiliging’, tenzij we liever met doorgeslagen stoppen leefden."
                                            },
                                            {
                                                "example_id": "451cf27a-430e-4733-a4c2-cd213bd56797",
                                                "sense_id": "db423521-94d3-36e6-b9a8-11b6aa704a39",
                                                "text": "Een spanningsfilter haalt alle ongerechtigheden uit de elektriciteit en bevat bovendien een overspanningsbeveiliging: een soort zekering die er de brui aan geeft, mocht de spanning opeens wel heel erg toenemen. Dat laatste kan ook bij een blikseminslag het geval zijn."
                                            }
