                    {
                        "form_id": "5d44d783-4199-4aab-b3b3-c585072fbaa8",
                        "entry_id": "45a6c41a-821c-3e52-96d8-02b3e3289338",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Bundestagswahlen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "58a93da2-a935-3902-9ff0-6283f3ba8def",
                        "entry_id": "45a6c41a-821c-3e52-96d8-02b3e3289338",
                        "glosses": [
                            "in der Regel alle vier Jahre stattfindende Wahl der Abgeordneten des Deutschen Bundestages"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed35f302-1a26-4d37-acb0-1ccd93f5c5f0",
                                "sense_id": "58a93da2-a935-3902-9ff0-6283f3ba8def",
                                "text": "Der Termin einer Bundestagswahl wird vom Bundespräsidenten in Absprache mit der Bundesregierung und den Bundesländern festgelegt."
                            },
                            {
                                "example_id": "41651f8d-e5ff-41d4-a84f-c26ab0093155",
                                "sense_id": "58a93da2-a935-3902-9ff0-6283f3ba8def",
                                "text": "„Pünktlich zur Bundestagswahl nehmen die Parteien die Probleme auf dem Wohnungsmarkt ins Visier.“"
                            },
                            {
                                "example_id": "e417154e-f243-4782-befe-60467bb2586b",
                                "sense_id": "58a93da2-a935-3902-9ff0-6283f3ba8def",
                                "text": "„Und viele Genossen grämen sich, weil Gabriel nach der Bundestagswahl 2013 die historische Chance verpasste, nach Gerhard Schröder der zweite Bundeskanzler aus Niedersachsen zu werden.“"
                            },
                            {
                                "example_id": "5db7cae0-5f81-4b11-9005-7f036ee17e7b",
                                "sense_id": "58a93da2-a935-3902-9ff0-6283f3ba8def",
                                "text": "„In der Nacht der Bundestagswahl 1998 habe ich vor Freude geweint, weil Gerhard Schröder Kanzler wurde.“"
                            },
                            {
                                "example_id": "9343c5e3-b318-4566-a596-c9b17cc6bf32",
                                "sense_id": "58a93da2-a935-3902-9ff0-6283f3ba8def",
                                "text": "„Dürften bei der nächsten Bundestagswahl nur Journalisten wählen, wären die Grünen mit großem Abstand die stärkste Partei.“"
                            },
                            {
                                "example_id": "c8217d3f-6e90-4b60-a269-e843cc9af896",
                                "sense_id": "58a93da2-a935-3902-9ff0-6283f3ba8def",
                                "text": "„»Für mich ist mit dieser Bundestagswahl eine rote Linie überschritten, und mein Entschluss steht fest: Ich werde Deutschland verlassen.«“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
