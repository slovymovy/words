                ],
                "translations": [
                    {
                        "translation_id": "d2a32000-4060-41f9-bdc0-52ce4086e908",
                        "source_entry_id": "bb433009-6174-3f5c-9fa6-50843d82032f",
                        "source_sense_id": "80427d99-b25a-3442-9bd4-865501a6cb51",
                        "source_sense_description": "doorzichtbaarheid",
                        "target_lang_word": "Transparenz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Transparenz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8f71cf0d-9881-3fd1-bb88-8d84fc0ef4b3",
                                        "entry_id": "6ccb21cc-45a1-3043-b312-8ff2a25042a8",
                                        "glosses": [
                                            "Durchsichtigkeit eines Materials"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e58a681c-0f1f-436a-bfc4-f7fb9e660606",
                                                "sense_id": "8f71cf0d-9881-3fd1-bb88-8d84fc0ef4b3",
                                                "text": "Glas hat eine hohe Transparenz."
                                            },
                                            {
                                                "example_id": "63716af6-e7be-4994-93b8-24b241bc32fd",
                                                "sense_id": "8f71cf0d-9881-3fd1-bb88-8d84fc0ef4b3",
                                                "text": "„Wenn sie Ihr Dokument mit Transparenzen als PDF-Datei exportieren möchten, sollten Sie sich deshalb zuerst bei Ihrem Produktionspartnern erkundigen, ob deren Geräte mit Transparenzen zurechtkommen.“"
                                            },
                                            {
                                                "example_id": "0917a9af-df15-4524-aa3b-c4a62f7adbb9",
                                                "sense_id": "8f71cf0d-9881-3fd1-bb88-8d84fc0ef4b3",
                                                "text": "[Software::Grafik – Betaversion von Krita 4.3.0:] „Bei RGBA-Pinseln kann man jetzt die Transparenz und die Helligkeit separat festlegen, was beeindruckende neue Effekte ermöglicht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "87b0d3e3-81df-36dd-8457-ff2e46c45270",
                                        "entry_id": "6ccb21cc-45a1-3043-b312-8ff2a25042a8",
                                        "glosses": [
                                            "Maß für die Lichtdurchlässigkeit eines Materials (Bedeutung [1]) (Kehrwert der Opazität)"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "12c9f138-59aa-3e3e-babf-c3f4eec50237",
                                        "entry_id": "6ccb21cc-45a1-3043-b312-8ff2a25042a8",
                                        "glosses": [
                                            "Klarheit/Nachvollziehbarkeit eines Vorgangs oder eines Verfahrens; verwendet häufig in Politik oder Wirtschaft"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9f136f54-e9bf-4e90-94f4-8a0f02e2d3be",
                                                "sense_id": "12c9f138-59aa-3e3e-babf-c3f4eec50237",
                                                "text": "[Coronapandemie 2021: Die Sprecherin des Weißen Hauses, Jen] „Psaki betonte, sie lege ihr Testergebnis offen, um größtmögliche Transparenz zu bieten.“"
                                            },
                                            {
                                                "example_id": "0f12ce14-1ee2-4549-b082-c8992d1624a8",
                                                "sense_id": "12c9f138-59aa-3e3e-babf-c3f4eec50237",
                                                "text": "Wir müssen Transparenz in die Geldgeschäfte der Teilhaber bringen."
                                            },
                                            {
                                                "example_id": "c1aabd8c-9535-4699-afd0-bab1425a081a",
                                                "sense_id": "12c9f138-59aa-3e3e-babf-c3f4eec50237",
                                                "text": "Die internationalen Finanzmärkte sollten mehr Transparenz zeigen."
                                            },
                                            {
                                                "example_id": "159e72eb-6ccc-4e2e-ba1f-9bb3bd2b92ab",
                                                "sense_id": "12c9f138-59aa-3e3e-babf-c3f4eec50237",
                                                "text": "Welcher Lobbyist bei welchem deutschen Gesetz welchen Einfluß genommen und welche Ressourcen zur Verfügung gestellt hat, diese Transparenz fehlt vollkommen."
                                            },
                                            {
                                                "example_id": "31e09cef-fe71-4faf-8e82-e3eb7eef6047",
                                                "sense_id": "12c9f138-59aa-3e3e-babf-c3f4eec50237",
                                                "text": "„Mehr Transparenz könnte laut Köppl auch ein „legislativer Fußabdruck“ bei Gesetzen liefern. Damit müsste im Internet veröffentlicht werden, auf wessen Wunsch welche Änderung in einem Gesetzesentwurf beschlossen wurde.“"
                                            },
                                            {
                                                "example_id": "0ee202ec-506f-4fcc-afae-c5222b4fc2b5",
                                                "sense_id": "12c9f138-59aa-3e3e-babf-c3f4eec50237",
                                                "text": "„Vielleicht schafft ja schon ein bisschen mehr Wissen um die tägliche Polizeiarbeit mehr Transparenz und Vertrauen.“"
                                            },
                                            {
                                                "example_id": "2fc75bd2-d121-4965-96dc-beb86c8d6020",
                                                "sense_id": "12c9f138-59aa-3e3e-babf-c3f4eec50237",
                                                "text": "„Als zweites verlangt Mozilla Transparenz, was bedeutet, dass die Anbieter ihre Datenschutzerklärung öffentlich machen.“"
                                            },
                                            {
                                                "example_id": "47728bcc-a1c5-44a4-bdb3-e9c4fe644512",
                                                "sense_id": "12c9f138-59aa-3e3e-babf-c3f4eec50237",
                                                "text": "[Rüstungsexporte:] „Seit 2014 berichtet die Regierung zwei Mal im Jahr über ihre Exportgenehmigungen, um mehr Transparenz zu gewährleisten.“"
                                            },
                                            {
                                                "example_id": "63482bf7-77b7-441f-b5e8-44fe3331723a",
                                                "sense_id": "12c9f138-59aa-3e3e-babf-c3f4eec50237",
                                                "text": "„Mit mehr Transparenz wollen einige EU-Staaten gegen Steuervermeidung von Konzernen vorgehen.“"
                                            },
                                            {
                                                "example_id": "7738f44d-2f19-425c-8184-58c1d9e033fb",
                                                "sense_id": "12c9f138-59aa-3e3e-babf-c3f4eec50237",
                                                "text": "„Mit ihren Modellrechnungen […] wollen Sandner und sein Team etwas mehr Transparenz in das undurchsichtige Netzwerk bringen, um Investoren Entscheidungshilfen an die Hand zu geben.“"
                                            },
                                            {
                                                "example_id": "7972d0d8-6b3c-4974-ab4a-d463721e6f35",
                                                "sense_id": "12c9f138-59aa-3e3e-babf-c3f4eec50237",
                                                "text": "„Der Nationalrat will nun doch ein Gesetz für mehr Transparenz bei der Politikfinanzierung.“"
                                            },
                                            {
                                                "example_id": "ca55e9e9-0a03-4cca-8dd8-8927ce7c7c08",
                                                "sense_id": "12c9f138-59aa-3e3e-babf-c3f4eec50237",
                                                "text": "„Projektziel: Nachverfolgung der für Umweltprojekte zugesagten Gelder und Aufdeckung von Missbrauch, Misswirtschaft und Verschwendung durch die Forderung nach Rechenschaftspflicht und Transparenz.“"
                                            },
                                            {
                                                "example_id": "135bfeca-449c-4b32-9167-b4abc83fc93c",
                                                "sense_id": "12c9f138-59aa-3e3e-babf-c3f4eec50237",
                                                "text": "[Klimaschutz:] […] „eine Analyse dieser Selbstverpflichtungen fällt ernüchternd aus. Die Forscher beklagen einen \"Mangel an Transparenz und Vergleichbarkeit der Neutralitätsziele\". Was Begriffe wie \"klimaneutral\" genau bezeichnen, sei oft ebenso unklar wie die Frage, wie die Daten erhoben werden und wer sie kontrolliert.“"
                                            },
                                            {
                                                "example_id": "a1dade9c-82d1-4f48-bed2-ab293e341bfb",
                                                "sense_id": "12c9f138-59aa-3e3e-babf-c3f4eec50237",
                                                "text": "[Software::Browser – Firefox-Ableger Waterfox verkauft:] „Wie erst jetzt bekannt wurde, ist Waterfox bereits im Dezember 2019 an die britische Werbeagentur System1 verkauft worden. Die hatte letztes Jahr bereits über ihre Tochtergesellschaft Privacy One Group Ltd die auf Datenschutz ausgelegte Suchmaschine Startpage erworben. Beiden Transaktionen gemeinsam ist zunächst das Fehlen von Transparenz.“"
                                            },
                                            {
                                                "example_id": "a283ee9a-527f-48c5-bccc-58d2a69f89c8",
                                                "sense_id": "12c9f138-59aa-3e3e-babf-c3f4eec50237",
                                                "text": "„Zuviel über die iranische Konkurrenz will er allerdings nicht schimpfen, denn auch seine Firma importiert den wesentlich billigeren iranischen Safran für den Weiterverkauf. Transparenz über Produktion und Handel gibt es wenig, auch Guerrero hält sich mit Details bedeckt.“"
                                            },
                                            {
                                                "example_id": "9cda9cae-7b26-45bd-884f-9b1ed9d57f96",
                                                "sense_id": "12c9f138-59aa-3e3e-babf-c3f4eec50237",
                                                "text": "„Die im Bundesland Hessen regierenden Christdemokraten (CDU) und Grünen haben gegen das Votum der Opposition - einschließlich der rechtspopulistischen AfD! - die Öffnung von Verfassungsschutz-Akten mit NSU-Bezug verhindert. Die bleiben nun 30 Jahre unter Verschluss. Dabei hätte es gerade in diesem Bundesland besonders viele Gründe gegeben, für Transparenz und damit für Vertrauen in den Rechtsstaat zu sorgen.“"
                                            },
                                            {
                                                "example_id": "eb891069-73ef-4c40-9db0-e0f938808393",
                                                "sense_id": "12c9f138-59aa-3e3e-babf-c3f4eec50237",
                                                "text": "„Der niederländische EVP-Abgeordnete Peter van Dalen sagte der DW: »Nawalny […] kämpft seit Jahrzehnten für Meinungsfreiheit, Demokratie, für Transparenz und gegen Korruption.«“"
                                            },
                                            {
                                                "example_id": "4e6f18c1-8440-4872-abc2-912dc07c2ddd",
                                                "sense_id": "12c9f138-59aa-3e3e-babf-c3f4eec50237",
                                                "text": "„Laut einem Ranking belegt Niedersachsens Verwaltung in Sachen Transparenz den letzten Platz unter den Bundesländern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "38c09bd8-dfea-4896-bc39-f545dbd6c45b",
                        "source_entry_id": "bb433009-6174-3f5c-9fa6-50843d82032f",
                        "source_sense_id": "80427d99-b25a-3442-9bd4-865501a6cb51",
                        "source_sense_description": "doorzichtbaarheid",
                        "target_lang_word": "transparency",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "transparency",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6db57233-1d85-3647-907d-9ebe5451a155",
                                        "entry_id": "fbb3792b-3a97-3d7c-82a7-e90e92c80432",
                                        "glosses": [
                                            "The quality of being transparent."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e0ee219e-d1db-38cb-b88c-3dd5fd8c81e9",
                                        "entry_id": "fbb3792b-3a97-3d7c-82a7-e90e92c80432",
                                        "glosses": [
                                            "Openness; accessibility to scrutiny."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d809624a-8c4e-44f3-a4f3-2bf33d2f7b74",
                                                "sense_id": "e0ee219e-d1db-38cb-b88c-3dd5fd8c81e9",
                                                "text": "And it [bribery and fraud] didn't stop there. Both Sir Winston Churchill and later Labour leader Michael Foot were allegedly regular recipients of private cheques that would have seen them summarily sacked in this present age of transparency."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0604e6bd-f99b-34fb-82d7-36babb0bfd9d",
                                        "entry_id": "fbb3792b-3a97-3d7c-82a7-e90e92c80432",
                                        "glosses": [
                                            "A transparent artwork, viewable by shining light through it."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cc1af6d8-43d9-407c-88aa-a514bf54fdc0",
                                                "sense_id": "0604e6bd-f99b-34fb-82d7-36babb0bfd9d",
                                                "text": "According to Bray (Life of Stothard, p. 50), the silversmiths Rundell and Bridge displayed a large transparency by Thomas Stothard, painted in thin oils on canvas and lit from behind, in front of their house on Ludgate Hill in honour of the King's Jubilee in 1810."
                                            },
                                            {
                                                "example_id": "67190726-6cdd-4db2-a41c-9a1193ce4add",
                                                "sense_id": "0604e6bd-f99b-34fb-82d7-36babb0bfd9d",
                                                "text": "It soon came: as they were on their way to a transparency of their majesties, not a little larger than life—with Bellona, in a very handsome helmet, on one side, and Peace, with a cornucopia and a full blown wreath of roses, on the other—the path was interrupted by a little knot of gentlemen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5b81a0f2-85ea-396c-89ce-23b1815b6b02",
                                        "entry_id": "fbb3792b-3a97-3d7c-82a7-e90e92c80432",
                                        "glosses": [
                                            "A translucent film-like material with an image imprinted on it, viewable by shining light through it."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "07464f16-3c20-3937-9eab-113a56eb3bf5",
                                        "entry_id": "fbb3792b-3a97-3d7c-82a7-e90e92c80432",
                                        "glosses": [
                                            "Something transparent."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "87fd4dac-3335-4634-b36a-b7e9a531e469",
                                                "sense_id": "07464f16-3c20-3937-9eab-113a56eb3bf5",
                                                "text": "John Lehmann's narrator Jack Marlowe is such a transparency, and his fiction is totally formless."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "54d923a8-ab5a-33dd-aaaa-cf2c4e6edc9e",
                                        "entry_id": "fbb3792b-3a97-3d7c-82a7-e90e92c80432",
                                        "glosses": [
                                            "Sufficient accuracy to make the compressed result perceptually indistinguishable from the uncompressed input."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3d52f31d-b0cd-4795-b19e-df05c2f813e8",
                        "source_entry_id": "bb433009-6174-3f5c-9fa6-50843d82032f",
                        "source_sense_id": "80427d99-b25a-3442-9bd4-865501a6cb51",
                        "source_sense_description": "doorzichtbaarheid",
                        "target_lang_word": "transparence",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "transparence",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0f8990ae-4086-34fd-9f46-0c70f29ac291",
                                        "entry_id": "52b85398-ae01-3c0f-a72d-c39b016be43d",
                                        "glosses": [
                                            "Caractère de ce qui est transparent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "657eb8f4-b053-4c1c-ba01-d25d3999feb0",
                                                "sense_id": "0f8990ae-4086-34fd-9f46-0c70f29ac291",
                                                "text": "Le crépuscule a partout la même transparence : on ne peut deviner de quel côté s’est couché le soleil, et l’armée française, qui sait si mal s’orienter, n’en a point ce soir le désavantage."
                                            },
                                            {
                                                "example_id": "d7d37a25-2b6b-47e1-be60-20563e11f2e4",
                                                "sense_id": "0f8990ae-4086-34fd-9f46-0c70f29ac291",
                                                "text": "Leurs voiles légers ont la transparence bleuâtre des brumes matinales, et semblent, comme celles-ci, frémir dans la lumière qui les pénètre et qui s’y joue."
                                            },
                                            {
                                                "example_id": "654c1de5-ee78-4f34-9d4e-496ed99a8847",
                                                "sense_id": "0f8990ae-4086-34fd-9f46-0c70f29ac291",
                                                "text": "Ce qui me frappa surtout, c’est la transparence bleutée de l’air, l’extrême délicatesse de tons que prenait le ciel au-dessus des eaux du lagon, […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f43c407d-5f09-33d7-8860-f40ad7dc7b19",
                                        "entry_id": "52b85398-ae01-3c0f-a72d-c39b016be43d",
                                        "glosses": [
                                            "Caractère de ce qui ne cache rien, de ce qui ne dissimule rien…"
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2478846c-5744-4ed2-958b-f2c6914f6e49",
                                                "sense_id": "f43c407d-5f09-33d7-8860-f40ad7dc7b19",
                                                "text": "La dénomination de nombreuses braderies et « foires à tout » joue la carte de la transparence : on sait qu'on trouvera, sortis des greniers, plus d'objets de peu de valeur et de nanars que de meubles de style et autres antiquités de prestige […].,"
                                            },
                                            {
                                                "example_id": "f0228f31-7921-4814-a155-380ceab9fe69",
                                                "sense_id": "f43c407d-5f09-33d7-8860-f40ad7dc7b19",
                                                "text": "Un peu plus d'un an après l'entrée en vigueur des lois sur la transparence de la vie politique…"
                                            },
                                            {
                                                "example_id": "e6dfaa3f-458f-4da3-8992-3c68ef99116d",
                                                "sense_id": "f43c407d-5f09-33d7-8860-f40ad7dc7b19",
                                                "text": "La fondation américaine conseille aux cadres des associations qu’elle finance d’éviter de se porter candidat et, s’ils le font, de faire preuve du maximum de transparence possible."
                                            },
                                            {
                                                "example_id": "1c0de35d-6d73-48b1-ae37-fc02c38bc5c9",
                                                "sense_id": "f43c407d-5f09-33d7-8860-f40ad7dc7b19",
                                                "text": "LA qualité cardinale. Faire preuve de transparence : n'avoir rien à cacher, être pur. … Le contraire de la transparence est le sale, le suspect, le louche. L'exigence impitoyable de transparence a par ailleurs donné naissance à toute une génération de censeurs et aussi à l'autocensure."
                                            },
                                            {
                                                "example_id": "a000eea2-0b1b-487d-b2ec-fdfaadb2d1bf",
                                                "sense_id": "f43c407d-5f09-33d7-8860-f40ad7dc7b19",
                                                "text": "\"Nos conclusions révèlent une négligence grave de la part des partis politiques et des plateformes qui ne respectent pas leurs engagements en matière d'étiquetage des images générées par l'IA dans le cadre de leurs campagnes politiques, soulignant ainsi le besoin urgent de transparence\", peut-on lire dans le rapport."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
