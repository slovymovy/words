                "entry_id": "daecd633-59d4-372c-98e8-290f3974b71c",
                "word": "blazonowanie",
                "pos": "noun",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "f6fb12db-d3db-3860-8f8c-25c5a5b10c5f",
                        "entry_id": "daecd633-59d4-372c-98e8-290f3974b71c",
                        "glosses": [
                            "opis herbu wykonany zgodnie z zasadami heraldyki"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "03b06bf5-bf68-424a-8df6-1e960ef721b9",
                        "source_entry_id": "daecd633-59d4-372c-98e8-290f3974b71c",
                        "source_sense_id": "f6fb12db-d3db-3860-8f8c-25c5a5b10c5f",
                        "target_lang_word": "blazon",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "blazon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cb4b9d67-a98e-31df-b35e-e5dd91a7ae74",
                                        "entry_id": "943b7ceb-7d92-33d0-b4cb-485200f8f209",
                                        "glosses": [
                                            "A verbal or written description of a coat of arms."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "928247cc-b53e-4f32-8ea2-c44c049a8370",
                                                "sense_id": "cb4b9d67-a98e-31df-b35e-e5dd91a7ae74",
                                                "text": "...it should never be forgotten that the best blazon is that which is the most perspicuous"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c503158-432c-337e-aad8-15840d3b093b",
                                        "entry_id": "943b7ceb-7d92-33d0-b4cb-485200f8f209",
                                        "glosses": [
                                            "A formalized language for describing a coat of arms."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e6ed31bb-031a-47fc-a442-b92db3802832",
                                                "sense_id": "7c503158-432c-337e-aad8-15840d3b093b",
                                                "text": "The official blazon of the arms of Perth is \"Gules, a Holy Lambe passant regardant staff and cross argent, with the banner of St. Andrew proper, all within a double tressure counter-flowered of the second\": […]."
                                            },
                                            {
                                                "example_id": "3e2e60a1-f026-4429-95cc-d8f4574fb5fa",
                                                "sense_id": "7c503158-432c-337e-aad8-15840d3b093b",
                                                "text": "We must banish, therefore, the persistent but wholly erroneous notion that the heralds invented many of the terms used in blazon and borrowed the rest from the everyday lexicon of terms..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "97537731-770b-30d6-b8f8-a86ba8ac6af3",
                                        "entry_id": "943b7ceb-7d92-33d0-b4cb-485200f8f209",
                                        "glosses": [
                                            "A coat of arms or a banner depicting a coat of arms."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b3ac712f-7aaf-410d-b185-4a4d6b26864e",
                                                "sense_id": "97537731-770b-30d6-b8f8-a86ba8ac6af3",
                                                "text": "He wears their motto on his blade, / Their blazon o'er his towers displayed; [...]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "416d526e-ec20-30ad-aa18-7cdd98f47d40",
                                        "entry_id": "943b7ceb-7d92-33d0-b4cb-485200f8f209",
                                        "glosses": [
                                            "Ostentatious display, verbal or otherwise; publication; description; record."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "df025a10-94f6-4f8f-bb55-3eccdc391862",
                                                "sense_id": "416d526e-ec20-30ad-aa18-7cdd98f47d40",
                                                "text": "Obtrude the blazon of their exploits upon the company."
                                            },
                                            {
                                                "example_id": "7dbb8b26-1ba6-452d-9b08-9963af2f7206",
                                                "sense_id": "416d526e-ec20-30ad-aa18-7cdd98f47d40",
                                                "text": "Thy tongue, thy face, thy limbs, actions, and spirit, / Do give thee five-fold blazon."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "blazon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7ecb7c38-ecd4-3f86-bd6f-cbd6af575a41",
                                        "entry_id": "40050e66-66c0-3edb-aac8-d95fb6464676",
                                        "glosses": [
                                            "To describe a coat of arms."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b75682ed-3156-4660-9e0e-f3c2839887f2",
                                                "sense_id": "7ecb7c38-ecd4-3f86-bd6f-cbd6af575a41",
                                                "text": "the following coat of arms, which I will send you in the original language, not being herald enough to blazon it in English"
                                            },
                                            {
                                                "example_id": "a299559e-c6f9-4608-9307-7adc0d088dbe",
                                                "sense_id": "7ecb7c38-ecd4-3f86-bd6f-cbd6af575a41",
                                                "text": "After Blazoning the Shield, you proceed to the exterior ornaments viz.: The Helmet, Lambrequin, Crest, Supporters, Badge, and Motto"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5aee8013-5265-3720-8f2b-20746eed07b7",
                                        "entry_id": "40050e66-66c0-3edb-aac8-d95fb6464676",
                                        "glosses": [
                                            "To make widely or generally known, to proclaim."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84934c22-bc08-40e5-a502-a8d4869c4912",
                                                "sense_id": "5aee8013-5265-3720-8f2b-20746eed07b7",
                                                "text": "O thou goddess/ thou divine Nature, how thyself thou blazon'st/ in these two princely boys."
                                            },
                                            {
                                                "example_id": "f29a62b9-566b-4311-9b64-b28f8512f329",
                                                "sense_id": "5aee8013-5265-3720-8f2b-20746eed07b7",
                                                "text": "There pride sits blazoned on th' unmeaning brow."
                                            },
                                            {
                                                "example_id": "77fda2cd-d173-49b9-98ef-cd7a76ad68ee",
                                                "sense_id": "5aee8013-5265-3720-8f2b-20746eed07b7",
                                                "text": "18th century, William Cowper, Retirement\nIn drawing pictures of forbidden joys,\nRetires to blazon his own worthless name"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d19fb7e3-ad45-3773-a020-1c416d15aeaa",
                                        "entry_id": "40050e66-66c0-3edb-aac8-d95fb6464676",
                                        "glosses": [
                                            "To display conspicuously or publicly."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "de902f22-83cd-37f2-8c7c-ce8f9f0a3a2b",
                                        "entry_id": "40050e66-66c0-3edb-aac8-d95fb6464676",
                                        "glosses": [
                                            "To shine; to be conspicuous."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d0ee6800-90bf-3b63-9888-81c5dae5140f",
                                        "entry_id": "40050e66-66c0-3edb-aac8-d95fb6464676",
                                        "glosses": [
                                            "To deck; to embellish; to adorn."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a3b61397-b62a-4d9e-a02b-eb71c1df5752",
                                                "sense_id": "d0ee6800-90bf-3b63-9888-81c5dae5140f",
                                                "text": "She blazons in dread smiles her hideous form."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ac4ee406-9341-4d9b-bdae-b5ac70f122c0",
                        "source_entry_id": "daecd633-59d4-372c-98e8-290f3974b71c",
                        "source_sense_id": "f6fb12db-d3db-3860-8f8c-25c5a5b10c5f",
