{
    "word_family": [
        "ordain",
        "preordain",
        "ordination"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7724149e-b29f-3318-a02f-5afef86e84d4",
                    "sense_definition": "A law or regulation enacted by a local government, such as a city or municipality.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "legal_decree",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The city council passed a new <w>ordinance</w> to restrict noise levels in residential areas after midnight.",
                            "target_lang_translations": {
                                "ru": "Городской совет принял новое <w>постановление</w>, ограничивающее уровень шума в жилых районах после полуночи."
                            }
                        },
                        {
                            "text": "Local business owners must comply with the city <w>ordinance</w> regarding outdoor signage and lighting.",
                            "target_lang_translations": {
                                "ru": "Владельцы местного бизнеса должны соблюдать городское <w>распоряжение</w> относительно наружной рекламы и освещения."
                            }
                        }
                    ],
                    "synonyms": [
                        "bylaw"
                    ],
                    "common_phrases": [
                        "city ordinance",
                        "local ordinance",
                        "pass an ordinance",
                        "zoning ordinance"
                    ],
                    "target_lang_definitions": {
                        "ru": "Закон или нормативный акт, принятый местными органами власти, такими как город или муниципалитет."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "постановление",
                                "target_lang_sense_clarification": "акт органа местной власти"
                            },
                            {
                                "target_lang_word": "распоряжение",
                                "target_lang_sense_clarification": "официальное указание властей"
                            },
                            {
                                "target_lang_word": "муниципальный акт",
                                "target_lang_sense_clarification": "местный закон"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4cc7111c-d16a-3fea-a209-92a0d595f587",
                    "sense_definition": "An authoritative order, decree, or edict issued by a government or sovereign power.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "legal_decree",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The king issued a royal <w>ordinance</w> that changed the tax structure for the entire province.",
                            "target_lang_translations": {
                                "ru": "Король издал королевский <w>указ</w>, который изменил структуру налогообложения для всей провинции."
                            }
                        },
                        {
                            "text": "Under the new government <w>ordinance</w>, all citizens were required to register their primary residence.",
                            "target_lang_translations": {
                                "ru": "Согласно новому правительственному <w>декрету</w>, все граждане были обязаны зарегистрировать свое основное место жительства."
                            }
                        }
                    ],
                    "common_phrases": [
                        "government ordinance",
                        "royal ordinance"
                    ],
                    "target_lang_definitions": {
                        "ru": "Авторитетный приказ, декрет или эдикт, изданный правительством или сувереном."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "указ",
                                "target_lang_sense_clarification": "распоряжение главы государства"
                            },
                            {
                                "target_lang_word": "декрет",
                                "target_lang_sense_clarification": "нормативный акт верховной власти"
                            },
                            {
                                "target_lang_word": "ордонанс",
                                "target_lang_sense_clarification": "королевский указ в некоторых странах"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b184b00a-12d8-3147-8270-4104862514bc",
                    "sense_definition": "A religious rite, ceremony, or practice prescribed by an ecclesiastical authority.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "religious_ritual",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The church views baptism as a sacred <w>ordinance</w> that signifies a believer's entry into the faith.",
                            "target_lang_translations": {
                                "ru": "Церковь рассматривает крещение как священное <w>таинство</w>, знаменующее вступление верующего в веру."
                            }
                        },
                        {
                            "text": "Members of the congregation gathered to participate in the holy <w>ordinance</w> of communion.",
                            "target_lang_translations": {
                                "ru": "Члены общины собрались, чтобы принять участие в святом <w>обряде</w> причастия."
                            }
                        }
                    ],
                    "common_phrases": [
                        "sacred ordinance",
                        "holy ordinance",
                        "religious ordinance"
                    ],
                    "target_lang_definitions": {
                        "ru": "Религиозный обряд, церемония или практика, предписанная церковными властями."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обряд",
                                "target_lang_sense_clarification": "традиционное религиозное действие"
                            },
                            {
                                "target_lang_word": "таинство",
                                "target_lang_sense_clarification": "священнодействие, например крещение"
                            },
                            {
                                "target_lang_word": "установление",
                                "target_lang_sense_clarification": "церковное предписание"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "447944a8-f836-3009-9d62-a63bfa9545ae",
                    "sense_definition": "An alternative spelling of <w>ordnance</w>, referring to military supplies, especially weapons and ammunition.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The historical documents mentioned that the fort was well-stocked with heavy <w>ordinance</w> for its defense.",
                            "target_lang_translations": {
                                "ru": "В исторических документах упоминалось, что форт был хорошо оснащен тяжелым <w>вооружением</w> для своей обороны."
                            }
                        },
                        {
                            "text": "The <w>ordinance</w> officer was responsible for ensuring the troops had enough ammunition for the upcoming battle.",
                            "target_lang_translations": {
                                "ru": "Офицер по <w>артиллерийско-техническому снабжению</w> отвечал за то, чтобы у войск было достаточно боеприпасов для предстоящего сражения."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "alternative spelling of ordnance"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вариант написания слова ordnance, означающего военное снаряжение, особенно оружие и боеприпасы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "артиллерийское вооружение",
                                "target_lang_sense_clarification": "военное снаряжение"
                            },
                            {
                                "target_lang_word": "боеприпасы",
                                "target_lang_sense_clarification": "снаряды и патроны"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}