                    {
                        "translation_id": "13ecf190-aa47-4257-98e8-7f1a36463b18",
                        "source_entry_id": "01863d12-716f-3de4-a47e-428ca13a2638",
                        "source_sense_id": "a3273d41-1956-37d2-a0f4-1fe67bc75aec",
                        "source_sense_description": "een Australisch buideldier",
                        "target_lang_word": "коала",
                        "target_lang_code": "ru",
