                                                "sense_id": "927f53eb-a5cb-3421-95b3-abddc6d43879",
                                                "text": "Różnorodność przypraw czyni jedzenie smacznym."
                                            },
                                            {
                                                "example_id": "eb7636df-3e9b-4041-99a7-90c0cd368cd2",
                                                "sense_id": "927f53eb-a5cb-3421-95b3-abddc6d43879",
                                                "text": "Różnorodność genetyczna to cecha opisująca stopień zróżnicowania genów w ramach jednego gatunku."
                                            }
                                        ],
