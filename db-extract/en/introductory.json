                            {
                                "target_word": "inleidend",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "1a9e64c2-83e6-3ea0-b205-35df799694da",
                                        "entry_id": "3f2c8ba1-7b33-3bd5-a353-df8b10ff1047",
                                        "glosses": [
                                            "van iets dat het dient als voorbereiding op de eigenlijke activiteit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "266b79d7-8702-412c-b1bf-c9185919fd61",
                                                "sense_id": "1a9e64c2-83e6-3ea0-b205-35df799694da",
                                                "text": "Het Duitse gerecht opende na goedkeuring van bondskanselier Angela Merkel een inleidend onderzoek naar Böhmermann en verbood hem tegen Erdogan gerichte delen uit zijn gedicht te herhalen."
                                            },
                                            {
                                                "example_id": "b8bcc610-e2a9-4de0-b04a-37a559efe712",
                                                "sense_id": "1a9e64c2-83e6-3ea0-b205-35df799694da",
                                                "text": "In de petitie wordt opgeroepen tot een referendum over een vertrek uit de eurozone. \"We hebben nog geen datum gekozen, maar een inleidend debat zal waarschijnlijk in de komende weken worden gehouden\", zei parlementssecretaris Johanna Sarhimaa."
                                            },
                                            {
                                                "example_id": "f9d0bfba-fda9-4c47-81fd-aecc94b50a2b",
                                                "sense_id": "1a9e64c2-83e6-3ea0-b205-35df799694da",
                                                "text": "Werd aanvankelijk na enkele dagen van \"inleidend gedans\" nog gesteld dat pijnpunten meteen besproken zouden worden: dat blijkt toch voorzichtiger te gaan."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4952f5aa-8a5b-41a4-a9f2-972bcc193347",
