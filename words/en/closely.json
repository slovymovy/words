                                "nl": "Hij hield zijn ware gevoelens <w>zorgvuldig</w> verborgen voor de wereld.",
                                "pl": "Trzymał swoje prawdziwe uczucia <w>poufnie</w> ukryte przed światem.",
                                "de": "Er hielt seine wahren Gefühle <w>im Geheimen</w> vor der Welt verborgen.",
                                "fr": "Il gardait ses vrais sentiments <w>secrètement</w> cachés du reste du monde.",
                                "it": "Ha tenuto i suoi veri sentimenti <w>segretamente</w> nascosti al mondo.",
                                "cs": "Své skutečné pocity před světem <w>pečlivě</w> skrýval.",
                                "tr": "Gerçek duygularını dünyadan <w>gizli</w> tuttu.",
                                "es": "Mantuvo sus verdaderos sentimientos <w>secretamente</w> ocultos del mundo."
                            }
