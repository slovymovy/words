                "senses": [
                    {
                        "sense_id": "688a11fb-1a80-35ce-89f1-47ff1c0c9397",
                        "entry_id": "00466561-9b4a-35bd-963d-69a963639332",
                        "glosses": [
                            "Association."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "ac072e13-b8e4-4c99-b906-a63f9808c063",
                                "sense_id": "688a11fb-1a80-35ce-89f1-47ff1c0c9397",
                                "text": "David Chauvet, juriste et membre fondateur de l’association, cadre ses troupes :\n« Pas de violence physique ni verbale. Si ça se corse, c’est l’asso qui prend en charge les frais. »"
                            },
                            {
                                "example_id": "451c5356-bcf8-48a4-b810-fc471a5f0033",
                                "sense_id": "688a11fb-1a80-35ce-89f1-47ff1c0c9397",
                                "text": "Dans plusieurs villes, depuis quelques mois, la rupture est totale entre plusieurs asso féministes et lesbiennes, et certains groupes transactivistes."
                            }
                        ]
                    },
                    {
                        "sense_id": "990df19a-4548-35a4-83f9-0c85cdd71a0c",
                        "entry_id": "00466561-9b4a-35bd-963d-69a963639332",
                        "glosses": [
                            "Association étudiante."
                        ],
                        "tags": [
                            "especially",
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "08507802-1931-4d7b-94e0-e9edbd9b26a6",
                                "sense_id": "990df19a-4548-35a4-83f9-0c85cdd71a0c",
                                "text": "Dans mon temps, la seule décision difficile à prendre dans l'asso, c'était l'attribution du contrat de bière pour le bar étudiant."
                            }
                        ]
                    }
