                        "form": "die Kosmogonien"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "699d592f-97b9-3266-b8ea-2abeed680c2d",
                        "entry_id": "10dc185d-0678-369a-955d-796443506a7a",
                        "glosses": [
                            "mythische oder religiöse Lehre zur Entstehung der Welt"
                        ],
                        "tags": [
                            "Mythos"
                        ],
                        "examples": [
                            {
                                "example_id": "a0b62e22-c6fb-4368-9134-efb6bfe0a18f",
                                "sense_id": "699d592f-97b9-3266-b8ea-2abeed680c2d",
                                "text": "Die beiden Schöpfungsberichte aus dem Buch Genesis der Bibel kann man als klassische Kosmogonien des alten Orients lesen."
                            },
                            {
                                "example_id": "0ed7e75d-4004-4b0f-a3db-5ae81469dd47",
                                "sense_id": "699d592f-97b9-3266-b8ea-2abeed680c2d",
                                "text": "„Die religiöse Grundfrage nach der Schöpfung wurde aus dem Bereich der Kosmogonie herausgenommen und nun innerhalb der Ontologie neu gestellt.“"
                            },
                            {
                                "example_id": "f0fc5bc4-05b4-400a-927d-1247ef888d0a",
                                "sense_id": "699d592f-97b9-3266-b8ea-2abeed680c2d",
                                "text": "„Nur sehr wenige andere Kosmogonien bieten einen derart allmächtigen Gott oder eine derart große unsichtbare Kraft wie diesen Schöpfer.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "490cf9cb-1bc4-378f-b21f-a4d2f944be11",
                        "entry_id": "10dc185d-0678-369a-955d-796443506a7a",
                        "glosses": [
                            "naturwissenschaftliche Theorie zur Entstehung der Welt"
                        ],
                        "tags": [
                            "Wissenschaft"
                        ],
                        "examples": [
                            {
                                "example_id": "b887c0bd-7c78-425c-b73e-716a14219a0a",
                                "sense_id": "490cf9cb-1bc4-378f-b21f-a4d2f944be11",
                                "text": "„Alle diese Kosmogenien sind Theorie, logisch in sich zusammenhängende Überlegungen, die weite Zwischenräume mit großer Wahrscheinlichkeit durch Gedankengewölbe überbrücken und sich auf einzelne Tatsachen stützen.“"
                            },
                            {
                                "example_id": "49967a3e-14c8-44f8-a4dd-7382e09e800f",
                                "sense_id": "490cf9cb-1bc4-378f-b21f-a4d2f944be11",
                                "text": "„Diese Schrift zeigt ihn vor allem als wissenschaftlichen Denker, der eine naturwissenschaftliche Theorie aufstellt, die bis heute noch ihre nicht erschütterte Geltung besitzt und für die moderne Entwicklung der Kosmogonie von größter Bedeutung wurde.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
