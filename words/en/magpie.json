{
    "word_family": [
        "magpie"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2a3f0d6b-091e-3c38-814e-ab83be4990df",
                    "sense_definition": "A black and white bird known for its long tail and habit of collecting shiny objects.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "bird",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A noisy <w>magpie</w> sat on the garden fence watching the cat.",
                            "target_lang_translations": {
                                "cs": "Hlučná <w>straka</w> seděla na zahradním plotě a pozorovala kočku."
                            }
                        },
                        {
                            "text": "The common <w>magpie</w> is often seen in parks and gardens.",
                            "target_lang_translations": {
                                "cs": "<w>Straka</w> obecná je často k vidění v parcích a zahradách."
                            }
                        }
                    ],
                    "synonyms": [
                        "common magpie",
                        "pie"
                    ],
                    "common_phrases": [
                        "common magpie"
                    ],
                    "target_lang_definitions": {
                        "cs": "Černobílý pták s dlouhým ocasem, známý tím, že sbírá lesklé předměty."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "straka",
                                "target_lang_sense_clarification": "pták z čeledi krkavcovitých"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "638a3476-d39b-33b3-869b-e609e8069f58",
                    "sense_definition": "A person who collects or steals many different things, often without a clear purpose.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "no",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The writer was a literary <w>magpie</w>, gathering ideas from many different sources.",
                            "target_lang_translations": {
                                "cs": "Spisovatel byl literární <w>straka</w>, sbírající nápady z mnoha různých zdrojů."
                            }
                        },
                        {
                            "text": "She is a bit of a <w>magpie</w> when it comes to collecting vintage jewelry.",
                            "target_lang_translations": {
                                "cs": "Je tak trochu <w>straka</w>, co se týče sbírání vintage šperků."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Osoba, která shromažďuje nebo krade různé věci, často bez jasného účelu."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "straka",
                                "target_lang_sense_clarification": "přeneseně o člověku, který krade nebo sbírá věci"
                            },
                            {
                                "target_lang_word": "sběratel",
                                "target_lang_sense_clarification": "osoba, která shromažďuje předměty"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "af03d796-7422-3351-8257-b3e294075105",
                    "sense_definition": "A pattern of black and white patches.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "no",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old house had a <w>magpie</w> appearance due to its black timber and white plaster walls.",
                            "target_lang_translations": {
                                "cs": "Starý dům měl <w>strakatý</w> vzhled díky černému dřevu a bílým omítkovým stěnám."
                            }
                        },
                        {
                            "text": "The hills were covered in a <w>magpie</w> pattern of snow and dark earth.",
                            "target_lang_translations": {
                                "cs": "Kopce byly pokryty <w>strakatým</w> vzorem sněhu a tmavé země."
                            }
                        }
                    ],
                    "synonyms": [
                        "mottle"
                    ],
                    "target_lang_definitions": {
                        "cs": "Vzor tvořený černobílými skvrnami."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "strakatý",
                                "target_lang_sense_clarification": "vzor s barevnými skvrnami"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "19c9af3a-c744-3920-95d9-a45aa8999cba",
                    "sense_definition": "To steal or collect items, especially small or shiny ones.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "no",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He likes to <w>magpie</w> interesting quotes from books he reads.",
                            "target_lang_translations": {
                                "cs": "Rád si <w>kradl</w> zajímavé citáty z knih, které čte."
                            }
                        },
                        {
                            "text": "She managed to <w>magpie</w> several rare documents from the library archives.",
                            "target_lang_translations": {
                                "cs": "Podařilo se jí <w>ukrást</w> několik vzácných dokumentů z knihovních archivů."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Krást nebo sbírat věci, zejména malé nebo lesklé."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "krást",
                                "target_lang_sense_clarification": "přivlastňovat si cizí věci"
                            },
                            {
                                "target_lang_word": "shromažďovat",
                                "target_lang_sense_clarification": "sbírat různé věci"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8cc17f57-aeab-3044-96f6-c92e6f58d8b8",
                    "sense_definition": "To mark something with patches of black and white.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "no",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The moonlight seemed to <w>magpie</w> the dark forest floor with silver light.",
                            "target_lang_translations": {
                                "cs": "Měsíční svit jako by <w>strakatil</w> temné lesní dno stříbrným světlem."
                            }
                        },
                        {
                            "text": "The artist decided to <w>magpie</w> the wall with contrasting paint colors.",
                            "target_lang_translations": {
                                "cs": "Umělec se rozhodl <w>strakatit</w> zeď kontrastními barvami."
                            }
                        }
                    ],
                    "synonyms": [
                        "mottle"
                    ],
                    "target_lang_definitions": {
                        "cs": "Vytvářet na něčem černé a bílé skvrny."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "strakatit",
                                "target_lang_sense_clarification": "vytvářet skvrnitý vzor"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d6c463a2-1661-3d14-9b83-98c1b1e67367",
                    "sense_definition": "To talk idly or gossip about others.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "no",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They spent the afternoon <w>magpieing</w> about the neighbors' private affairs.",
                            "target_lang_translations": {
                                "cs": "Strávili odpoledne <w>drbáním</w> o soukromých záležitostech sousedů."
                            }
                        },
                        {
                            "text": "It is unkind to <w>magpie</w> with malicious gossip about your friends.",
                            "target_lang_translations": {
                                "cs": "Není hezké <w>pomlouvat</w> své přátele se zlou vůlí."
                            }
                        }
                    ],
                    "synonyms": [
                        "chatter",
                        "gossip"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used to describe idle or malicious talk."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Planě mluvit nebo pomlouvat ostatní."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "pomlouvat",
                                "target_lang_sense_clarification": "mluvit o někom v negativním smyslu"
                            },
                            {
                                "target_lang_word": "drbat",
                                "target_lang_sense_clarification": "hovorově o neformálním rozhovoru o druhých"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}