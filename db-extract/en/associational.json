                        "form": "more associational"
                    },
                    {
                        "form_id": "60a42a74-d2ba-4a42-9541-669b65ee5da3",
                        "entry_id": "44e8df76-40ed-3aa5-b018-8f920a01642d",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most associational"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c9e8e9ed-fc80-3ac4-a7a6-f1bd744a32a1",
                        "entry_id": "44e8df76-40ed-3aa5-b018-8f920a01642d",
                        "glosses": [
                            "Of, pertaining to or deriving from association."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96d97ce0-5a46-4eba-90b0-ee92cbcb33c3",
                                "sense_id": "c9e8e9ed-fc80-3ac4-a7a6-f1bd744a32a1",
                                "text": "How could I create such complex and wide schemes of associational thought and feeling, such filigreed webs of dreams and politics, without being mistaken for a “smuggler of reaction,” “an ideological confusionist,” or “an individualistic and dangerous element”?"
                            },
                            {
                                "example_id": "0876bb5b-c531-4d0a-ac7a-30088137b135",
                                "sense_id": "c9e8e9ed-fc80-3ac4-a7a6-f1bd744a32a1",
                                "text": "Instead of making a point, Roth shows us a detail, but a detail packed with layers of associational meaning."
                            },
                            {
                                "example_id": "c058c21c-d574-48af-a87c-81db6c1743e6",
                                "sense_id": "c9e8e9ed-fc80-3ac4-a7a6-f1bd744a32a1",
                                "text": "The distinction between […] southern Italians, who are amoral familists, and Americans, who are generally community-oriented and associational."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f670db65-54b2-4447-bd01-0f1eca9c614a",
                        "source_entry_id": "44e8df76-40ed-3aa5-b018-8f920a01642d",
                        "source_sense_id": "c9e8e9ed-fc80-3ac4-a7a6-f1bd744a32a1",
                        "source_sense_description": "of, pertaining to or deriving from association",
                        "target_lang_word": "associatif",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "associatif",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "446d65d4-6bae-3189-9e16-44b23be82149",
                                        "entry_id": "49eaf7ef-48a8-3d3f-ab0f-6034d5b41983",
                                        "glosses": [
                                            "Relatif aux associations, au milieu des associations."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2b13d10-1e87-436e-adc4-10e134993f87",
                                                "sense_id": "446d65d4-6bae-3189-9e16-44b23be82149",
                                                "text": "Si l’essor du phénomène associatif (loto des pompiers, des musiciens à la Sainte-Cécile, du club du troisième âge, des parents d’élèves, des anciens combattants, des boulistes, de la paroisse, des chasseurs...) atteste de mutations sociales et favorise des ambiances particulières, il montre aussi la permanence des besoins de la communauté."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0f56b965-acf5-3896-9bb4-980efcaea218",
                                        "entry_id": "49eaf7ef-48a8-3d3f-ab0f-6034d5b41983",
                                        "glosses": [
                                            "Relatif à l’associativité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce7551a7-aea6-45b4-8286-5964a69b6f02",
                                                "sense_id": "0f56b965-acf5-3896-9bb4-980efcaea218",
                                                "text": "Comme le produit vectoriel n’est ni associatif, ni commutatif, le résultat va dépendre de l’ordre des opérations des vecteurs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c676e00d-f056-3b31-8b37-c40582c6526a",
                                        "entry_id": "49eaf7ef-48a8-3d3f-ab0f-6034d5b41983",
                                        "glosses": [
                                            "Qui relève de l’association d’idées, de la construction de sens, de l’établissement d’une cohérence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "736a2928-05a2-4a36-8ce3-b0666f4ecceb",
                                                "sense_id": "c676e00d-f056-3b31-8b37-c40582c6526a",
                                                "text": "Ce travail de mentalisation passe nécessairement par une activité associative qui devra être fortement sollicitée chez le blessé, l’autre s’engageant de manière active et soutenante pour permettre le développement de ce processus de coconstruction du sens."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "associatif",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c118392d-a940-3609-96ec-dcc8e447f667",
                                        "entry_id": "0d6265d8-9590-3f21-b5f6-ef0ba9a803f4",
                                        "glosses": [
                                            "Acteur du monde des associations, représentant d’une association."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb9e1afa-3058-48e5-b63e-2f611654d3f8",
                                                "sense_id": "c118392d-a940-3609-96ec-dcc8e447f667",
                                                "text": "Chez les syndicalistes, comme chez les associatifs, il demeure néanmoins un vieux fond de méfiance : « Le travers dans lequel nous ne voulons pas tomber, c’est l’intellectuel ou d’autres élites qui parlent à la place de », prévient Jean-François Perraud au nom de la CGT."
                                            },
                                            {
                                                "example_id": "7a465eb5-5321-4522-b881-41d22a266aab",
                                                "sense_id": "c118392d-a940-3609-96ec-dcc8e447f667",
                                                "text": "En France, le groupuscule s’était distingué lors des manifestations lycéennes de décembre 2007 ou, plus récemment, parmi les associatifs appelant à la disparition du fichier de police Edvige."
                                            },
                                            {
                                                "example_id": "e10809b7-4a82-4151-8b68-ee7209462f79",
                                                "sense_id": "c118392d-a940-3609-96ec-dcc8e447f667",
                                                "text": "Alors que les associatifs se levaient pour quitter la Place Beauvau, Gérard Collomb a juste trouvé le temps d’ajouter à l’intention des représentants du monde associatif qu’Emmanuel Macron les recevrait prochainement."
                                            },
                                            {
                                                "example_id": "94bbbabd-f83a-4051-b866-8a2d9ac19bef",
                                                "sense_id": "c118392d-a940-3609-96ec-dcc8e447f667",
                                                "text": "Tous les associatifs le disent : il existe dans les quartiers un important gisement de projets sérieux ne demandant qu’à émerger si on leur donne accès aux réseaux qui leur font généralement défaut."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
