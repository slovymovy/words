                        "sense_id": "70aa20d7-a08e-3495-8cb5-1ed0b66f5634",
                        "entry_id": "b4b4dfa1-d298-32e9-9b79-3dc53cbb3bac",
                        "glosses": [
                            "нежелательные предметы, мусор, грязь, перекрывающие какую-либо трубу, трубку, канал и т. п."
                        ],
                        "tags": [],
