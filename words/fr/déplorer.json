            "senses": [
                {
                    "sense_id": "b86c0034-5ecb-3a1e-a8a3-fbfb745f97f3",
                    "sense_definition": "Regretter vivement ou désapprouver profondément un fait, une attitude ou un événement.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "regret",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le directeur <w>déplore</w> le manque de communication flagrant au sein de notre équipe."
                        },
                        {
                            "text": "Nous <w>déplorons</w> tous cette décision prise sans aucune concertation préalable."
                        }
                    ],
                    "synonyms": [
                        "regretter"
                    ],
                    "common_phrases": [
                        "déplorer la situation",
                        "déplorer le manque"
                    ]
                },
                {
                    "sense_id": "2f0bd0eb-6394-3112-93fa-da81e575bebc",
                    "sense_definition": "Éprouver une profonde tristesse ou de la compassion face à un grand malheur, une catastrophe ou une perte humaine.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "affliction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les secours ont annoncé que l'on <w>déplorait</w> plusieurs victimes après l'accident tragique."
                        },
                        {
                            "text": "Toute la ville est venue <w>déplorer</w> la disparition de cet homme d'État respecté."
                        }
                    ],
                    "synonyms": [
                        "pleurer"
                    ],
                    "common_phrases": [
                        "déplorer des victimes",
                        "déplorer des pertes"
                    ]
                }
            ]
        }
