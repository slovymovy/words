        "fr-extract.jsonl": [
            {
                "entry_id": "8f52b3bc-6068-3d04-b792-829e36ab0906",
                "word": "bougre",
                "pos": "intj",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "ead2401b-03c5-340b-a2b3-4a4cfd69ab2b",
                        "entry_id": "8f52b3bc-6068-3d04-b792-829e36ab0906",
                        "glosses": [
                            "Servant à marquer la colère."
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "a0fff1bd-21c1-4788-b209-01812c49dbf8",
                                "sense_id": "ead2401b-03c5-340b-a2b3-4a4cfd69ab2b",
                                "text": "– Quand je pense, disait-il, que, si j’étais resté dans l’armée après l’autre guerre, j’aurais ma retraite aujourd’hui. Je l’aurais, mon jardin, avec tout le temps pour le cultiver. Ah ! bougre de bougre de bougre de bougre !"
                            }
                        ]
                    },
                    {
                        "sense_id": "b449db3b-b554-30f3-82a7-6c23252fea88",
                        "entry_id": "8f52b3bc-6068-3d04-b792-829e36ab0906",
                        "glosses": [
                            "Interjection exprimant une évidence."
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "0e14965f-9fd1-41b7-bfc9-597ac1e8b05f",
                                "sense_id": "b449db3b-b554-30f3-82a7-6c23252fea88",
                                "text": "— C’est la Pauline Richard, expliqua-t-elle. Celle qui tenait la Civette, autrefois. Vous l’avez connue ?\n— Bougre, si je l’ai connue !"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": [
                    {
                        "linkage_id": "07779064-39e6-4297-be0c-614fa7579d1c",
