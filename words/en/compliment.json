{
    "word_family": [
        "complimentary",
        "uncomplimentary"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1540a966-07eb-3e8d-939b-1ecb6885ad14",
                    "sense_definition": "An expression of praise, congratulation, or respect.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She paid him a nice <w>compliment</w> regarding his presentation.",
                            "target_lang_translations": {
                                "ru": "Она сделала ему приятный <w>комплимент</w> по поводу его презентации.",
                                "zh": "她对他的演讲给予了很好的<w>赞美</w>。",
                                "es": "Ella le hizo un buen <w>cumplido</w> sobre su presentación."
                            }
                        },
                        {
                            "text": "I decided to take his remark as a <w>compliment</w> rather than an insult.",
                            "target_lang_translations": {
                                "ru": "Я решил принять его замечание как <w>комплимент</w>, а не как оскорбление.",
                                "zh": "我决定把他的话当作一种<w>恭维</w>，而不是侮辱。",
                                "es": "Decidí tomar su comentario como un <w>cumplido</w> en lugar de un insulto."
                            }
                        }
                    ],
                    "synonyms": [
                        "praise"
                    ],
                    "antonyms": [
                        "insult"
                    ],
                    "common_phrases": [
                        "pay a compliment",
                        "take as a compliment",
                        "return the compliment",
                        "fish for compliments"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выражение похвалы, поздравления или уважения.",
                        "zh": "对他人的赞美、祝贺或表示敬意的话语。",
                        "es": "Una expresión de elogio, felicitación o respeto."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "комплимент",
                                "target_lang_sense_clarification": "приятные слова"
                            },
                            {
                                "target_lang_word": "похвала",
                                "target_lang_sense_clarification": "одобрение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "赞美",
                                "target_lang_sense_clarification": "对他人的肯定或称赞"
                            },
                            {
                                "target_lang_word": "恭维",
                                "target_lang_sense_clarification": "客套的称赞，有时带有讨好意味"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "cumplido",
                                "target_lang_sense_clarification": "expresión de cortesía o elogio"
                            },
                            {
                                "target_lang_word": "halago",
                                "target_lang_sense_clarification": "palabras que expresan admiración o afecto"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "147c62db-e873-32f0-b756-e4333a52063b",
                    "sense_definition": "To pay a compliment to someone; to express a favourable opinion of someone.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>complimented</w> his colleague on her excellent work.",
                            "target_lang_translations": {
                                "ru": "Он <w>похвалил</w> свою коллегу за её отличную работу.",
                                "zh": "他<w>称赞</w>了同事出色的工作表现。",
                                "es": "Él <w>halagó</w> a su colega por su excelente trabajo."
                            }
                        },
                        {
                            "text": "The guests <w>complimented</w> the chef on the delicious meal.",
                            "target_lang_translations": {
                                "ru": "Гости <w>похвалили</w> шеф-повара за восхитительный ужин.",
                                "zh": "客人们<w>夸奖</w>厨师做的饭菜非常美味。",
                                "es": "Los invitados <w>halagaron</w> al chef por la deliciosa comida."
                            }
                        }
                    ],
                    "synonyms": [
                        "praise",
                        "commend"
                    ],
                    "antonyms": [
                        "insult"
                    ],
                    "common_phrases": [
                        "compliment on"
                    ],
                    "target_lang_definitions": {
                        "ru": "Делать комплимент кому-либо; выражать благоприятное мнение о ком-либо.",
                        "zh": "向某人表示赞美；对某人表达好评。",
                        "es": "Hacer un cumplido a alguien; expresar una opinión favorable sobre alguien."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хвалить",
                                "target_lang_sense_clarification": "выражать одобрение"
                            },
                            {
                                "target_lang_word": "делать комплименты",
                                "target_lang_sense_clarification": "говорить любезности"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "称赞",
                                "target_lang_sense_clarification": "用言语表达对人或事的肯定"
                            },
                            {
                                "target_lang_word": "夸奖",
                                "target_lang_sense_clarification": "对人的行为或表现表示赞许"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "halagar",
                                "target_lang_sense_clarification": "expresar admiración o afecto con palabras"
                            },
                            {
                                "target_lang_word": "felicitar",
                                "target_lang_sense_clarification": "expresar alegría por el logro de alguien"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}