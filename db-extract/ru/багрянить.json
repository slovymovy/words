                    {
                        "translation_id": "13d5447d-4697-4443-8e7a-fc7948c87a2b",
                        "source_entry_id": "dbad9dca-053d-382a-bc16-ab1315f5075f",
                        "source_sense_description": "окрашивать в багряный цвет",
                        "target_lang_word": "röten",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "röten",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "94126e29-2427-309e-ae4a-1d4091cbfda4",
                                        "entry_id": "460dcfe6-582e-3978-b415-5388b4b43cd1",
                                        "glosses": [
                                            "etwas rot färben, rot erscheinen lassen"
                                        ],
                                        "tags": [
                                            "gehoben",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9315fb7f-6f64-420a-ad22-fef9ae26e43b",
                                                "sense_id": "94126e29-2427-309e-ae4a-1d4091cbfda4",
                                                "text": "Solche Salben, die ein Wärmegefühl erzeugen und die Haut röten, sind rezeptfrei erhältlich und werden häufig als erste Maßnahme gegen Schmerzen nach Sportunfällen oder bei sonstigen Muskelproblemen empfohlen."
                                            },
                                            {
                                                "example_id": "5f6c27f7-f4f9-4153-a7ec-c80afd74e6ec",
                                                "sense_id": "94126e29-2427-309e-ae4a-1d4091cbfda4",
                                                "text": "Bei der Eintragung eines neuen Eigentümers sind sämtliche Eintragungen der Abt. I zu röten."
                                            },
                                            {
                                                "example_id": "ca451097-b209-4013-b855-8df2c35a0b00",
                                                "sense_id": "94126e29-2427-309e-ae4a-1d4091cbfda4",
                                                "text": "„Die Wangen röten, den Kopf bedienen, aber den Bauch eben auch“, das wünscht sich Intendant Martin Heller."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4fb23650-e7fa-3a27-b23d-5feaa24a0920",
                                        "entry_id": "460dcfe6-582e-3978-b415-5388b4b43cd1",
                                        "glosses": [
                                            "eine rote Farbe annehmen, rot werden"
                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "83f612a8-009b-406c-9906-f4bde84b4cc6",
                                                "sense_id": "4fb23650-e7fa-3a27-b23d-5feaa24a0920",
                                                "text": "Bei Kindern kann sich die ungeschützte Haut schon nach fünf bis zehn Minuten in der Sonne röten."
                                            },
                                            {
                                                "example_id": "9c73ce4c-8110-4a68-b50b-9bd36d2f093d",
                                                "sense_id": "4fb23650-e7fa-3a27-b23d-5feaa24a0920",
                                                "text": "Kehrt man ins Warme zurück, beginnt die Haut zu jucken und sich zu röten - das Blut zirkuliert wieder."
                                            },
                                            {
                                                "example_id": "70c96ea3-a8b0-4c84-a77a-a90e3496c701",
                                                "sense_id": "4fb23650-e7fa-3a27-b23d-5feaa24a0920",
                                                "text": "Blasse Wolken röten sich am Himmel."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "902c68d2-2098-4419-89c1-11d07bd6ed46",
                        "source_entry_id": "dbad9dca-053d-382a-bc16-ab1315f5075f",
                        "source_sense_description": "окрашивать в багряный цвет",
                        "target_lang_word": "empourprer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "empourprer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fead2cf5-4890-3090-b5ee-2887a4144c0c",
                                        "entry_id": "87363011-00fe-3d25-9ae6-6f19e94e8a84",
                                        "glosses": [
                                            "Colorer de pourpre ou de rouge."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db8ca64d-71cb-472e-be5a-d35b2d7b447a",
                                                "sense_id": "fead2cf5-4890-3090-b5ee-2887a4144c0c",
                                                "text": "La honte empourpra ses joues, et, saisissant le papier, il le mit en pièces […]."
                                            },
                                            {
                                                "example_id": "606cda62-d7aa-4538-b895-071d94c401a0",
                                                "sense_id": "fead2cf5-4890-3090-b5ee-2887a4144c0c",
                                                "text": "Chercheur de tableaux, j’admirais ces visages égayés par un sourire, éclairés par les bougies, et que la bonne chère avait empourprés."
                                            },
                                            {
                                                "example_id": "414d3776-2c79-4804-854a-f2e97fcb3321",
                                                "sense_id": "fead2cf5-4890-3090-b5ee-2887a4144c0c",
                                                "text": "On vous fait remarquer au fond du bassin de larges tâches rougeâtres, accusations indélébiles laissées par les victimes contre la cruauté de leurs bourreaux. Malheureusement, les érudits prétendent que les Abencérages et les Zégris n’ont jamais existé. Je m’en rapporte complètement là-dessus aux romances, aux traditions populaires et à la nouvelle de M. de Chateaubriand, et je crois fermement que les empreintes empourprées sont du sang et non de la rouille."
                                            },
                                            {
                                                "example_id": "d884ebe1-a933-41b1-ad01-67c7ae35eb61",
                                                "sense_id": "fead2cf5-4890-3090-b5ee-2887a4144c0c",
                                                "text": "Nous longions à demi-lieue de distance la côte de Cancale, dont les collines semées de bouquets d’arbres et de maisons de campagne s’empourpraient aux rayons du soleil levant."
                                            },
                                            {
                                                "example_id": "b438454f-318e-43f4-b6aa-1dd1da8ecf2a",
                                                "sense_id": "fead2cf5-4890-3090-b5ee-2887a4144c0c",
                                                "text": "Le visage de Félicité s’empourpra d’une joie chaude. Elle se mit sur son séant, frappant comme une enfant dans ses mains sèches de petite vieille."
                                            },
                                            {
                                                "example_id": "ecbecde9-815f-4916-b1cd-a3bc60f5691a",
                                                "sense_id": "fead2cf5-4890-3090-b5ee-2887a4144c0c",
                                                "text": "… une femme … toute vêtue de blanc … le visage livide … le sein empourpré par une tache sanglante !"
                                            },
                                            {
                                                "example_id": "21c8525b-6fd1-4507-9bde-945d5ff41acf",
                                                "sense_id": "fead2cf5-4890-3090-b5ee-2887a4144c0c",
                                                "text": "Vous étiez si entichée de ce jeune monsieur l’étudiant que… curieux que vous vous en soyez aperçue !\nPolinka s’empourpre et n’ajoute rien."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
