                        "sense_id": "e454fbc7-a6ae-3618-a6af-d85077446cec",
                        "entry_id": "715512f8-e0b7-3436-ae61-2f785f36afb9",
                        "glosses": [
                            "der gelbe Farbton eines Pflanzenblattes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a2c3723-8913-47f0-8440-1e440d059ead",
                                "sense_id": "e454fbc7-a6ae-3618-a6af-d85077446cec",
                                "text": "„Herbstliches Blattgelb der Birke hellt das dunkle Nadelgrün der Kiefern auf, das sich durch schnurgerade parallele Baumreihen im tiefsten Schwarz verliert.“"
                            },
                            {
                                "example_id": "e190566c-5813-42b1-b467-5e6a28cd19fc",
                                "sense_id": "e454fbc7-a6ae-3618-a6af-d85077446cec",
                                "text": "„Aus herbstlichem Laub hat zuerst Berzelius durch Extrahieren mit Alkohol einen gelben Farbstoff zu isolieren versucht, den er Blattgelb oder Xanthophyll nannte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
