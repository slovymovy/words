                    },
                    {
                        "sense_id": "cfe73efb-baee-3804-aefd-bf84ccafaae7",
                        "entry_id": "b32738d3-f34e-3cb5-a95c-f8a143797071",
                        "glosses": [
                            "Se placer soi-même."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "142250a8-aee4-4fe5-931f-1b5db861e47e",
                                "sense_id": "cfe73efb-baee-3804-aefd-bf84ccafaae7",
                                "text": "Quant à s’auto-placer soi-même, la tâche est délicate."
                            },
                            {
                                "example_id": "49368503-7796-47a9-af3a-d0fa22e3452f",
                                "sense_id": "cfe73efb-baee-3804-aefd-bf84ccafaae7",
                                "text": "Même si, lui, à l’époque, appartenait à ce camp, les changements de circonstances, de gouvernement et de coalition, commandaient la réécriture du cours de l’histoire, afin de positionner son pouvoir actuel de réviser les Lois Fondamentales ; or, un premier souci est de s’auto-placer."
                            }
                        ]
                    }
