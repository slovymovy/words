{
    "word_family": [
        "intermittence",
        "intermittency",
        "intermittently",
        "intermit"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "e27b2bbe-9326-36a4-bdf5-47286c0d635c",
                    "sense_definition": "Stopping and starting at irregular intervals rather than being continuous.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "occurrence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The weather forecast predicts a cloudy day with <w>intermittent</w> rain showers.",
                            "target_lang_translations": {
                                "ru": "Прогноз погоды обещает облачный день с <w>прерывистыми</w> дождями."
                            }
                        },
                        {
                            "text": "The driver was frustrated by the <w>intermittent</w> noise coming from the engine.",
                            "target_lang_translations": {
                                "ru": "Водителя раздражал <w>прерывистый</w> шум, доносившийся из двигателя."
                            }
                        }
                    ],
                    "synonyms": [
                        "periodic",
                        "fitful",
                        "discontinuous",
                        "stop-start"
                    ],
                    "antonyms": [
                        "steady",
                        "constant",
                        "continual"
                    ],
                    "common_phrases": [
                        "intermittent rain",
                        "intermittent noise",
                        "intermittent fasting"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прекращающийся и начинающийся снова через нерегулярные промежутки времени, а не непрерывный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прерывистый",
                                "target_lang_sense_clarification": "о звуках, сигналах или процессах"
                            },
                            {
                                "target_lang_word": "периодический",
                                "target_lang_sense_clarification": "повторяющийся время от времени"
                            },
                            {
                                "target_lang_word": "нерегулярный",
                                "target_lang_sense_clarification": "происходящий без четкой системы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "727815cb-0aac-3d3a-8c58-2850dbe53eab",
                    "sense_definition": "Describing a body of water that is dry for part of the year or only flows during certain seasons.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "geography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The desert landscape is characterized by many <w>intermittent</w> streams that only appear after a storm.",
                            "target_lang_translations": {
                                "ru": "Для пустынного ландшафта характерно множество <w>пересыхающих</w> ручьев, которые появляются только после шторма."
                            }
                        },
                        {
                            "text": "Farmers in this region must manage their crops around the cycle of <w>intermittent</w> lakes.",
                            "target_lang_translations": {
                                "ru": "Фермеры в этом регионе вынуждены планировать посевы, ориентируясь на цикл <w>пересыхающих</w> озер."
                            }
                        }
                    ],
                    "synonyms": [
                        "periodic",
                        "discontinuous"
                    ],
                    "antonyms": [
                        "constant"
                    ],
                    "common_phrases": [
                        "intermittent stream",
                        "intermittent lake"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical usage in geography and hydrology"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Описывает водоем, который пересыхает в определенное время года или течет только в определенные сезоны."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пересыхающий",
                                "target_lang_sense_clarification": "о реках и озерах"
                            },
                            {
                                "target_lang_word": "сезонный",
                                "target_lang_sense_clarification": "появляющийся только в определенный сезон"
                            },
                            {
                                "target_lang_word": "временный",
                                "target_lang_sense_clarification": "не постоянный водоток"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f49af6b8-5600-38ab-a983-75265ed8e415",
                    "sense_definition": "A fever or disease that subsides and returns at intervals.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "medical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The physician noted that the patient was suffering from one of the common <w>intermittents</w> found in the tropics.",
                            "target_lang_translations": {
                                "ru": "Врач отметил, что пациент страдает от одной из распространенных в тропиках <w>перемежающихся лихорадок</w>."
                            }
                        },
                        {
                            "text": "Historically, quinine was used as a primary treatment for various <w>intermittents</w> like malaria.",
                            "target_lang_translations": {
                                "ru": "Исторически хинин использовался в качестве основного средства лечения различных <w>перемежающихся болезней</w>, таких как малярия."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "primarily used in older medical texts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Лихорадка или болезнь, которая затихает и возвращается через определенные промежутки времени."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перемежающаяся лихорадка",
                                "target_lang_sense_clarification": "медицинский термин для цикличной болезни"
                            },
                            {
                                "target_lang_word": "периодическая болезнь",
                                "target_lang_sense_clarification": "заболевание с фазами ремиссии"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}