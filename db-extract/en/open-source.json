                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "otwarty",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "80d7033e-ce9e-3d9f-8654-9cb168e95ec6",
                                        "entry_id": "114daa4d-4840-3561-8329-a7f2bc1dbea1",
                                        "glosses": [
                                            "niestawiający przeszkód do wejścia / przejścia, niczym nieokolony"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "880e26c6-b185-40c1-ae4f-d7fe02e4644d",
                                                "sense_id": "80d7033e-ce9e-3d9f-8654-9cb168e95ec6",
                                                "text": "Przechodziło się do niego przez otwarte podwórze sąsiadów."
                                            }
                                        ],
                                        "sense_index_json": "\"2.1\""
                                    },
                                    {
                                        "sense_id": "133b4c8f-c4f7-31a6-91c3-0541a3588ab5",
                                        "entry_id": "114daa4d-4840-3561-8329-a7f2bc1dbea1",
                                        "glosses": [
                                            "o sklepie: czynny, działający"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f331323-f1fa-401d-8f16-4d6dd1377743",
                                                "sense_id": "133b4c8f-c4f7-31a6-91c3-0541a3588ab5",
                                                "text": "Chyba jest już za późno, żebyśmy w tej wiosce znaleźli jakiś otwarty sklep. Boję się, że dzisiaj na kolację będziemy jeść same konserwy."
                                            }
                                        ],
                                        "sense_index_json": "\"2.2\""
                                    },
                                    {
                                        "sense_id": "71fcd1c3-e9d2-3790-ac75-ec95646ad0d1",
                                        "entry_id": "114daa4d-4840-3561-8329-a7f2bc1dbea1",
                                        "glosses": [
                                            "o problemie, kwestii: do tej pory nierozwiązany, wciąż podlegający dyskusji"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2.3\""
                                    },
                                    {
                                        "sense_id": "959e8d06-b267-3189-8ffa-9749d40aab05",
                                        "entry_id": "114daa4d-4840-3561-8329-a7f2bc1dbea1",
                                        "glosses": [
                                            "ogólnie dostępny, nieobłożony ograniczeniami"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f9ef9ae5-164b-4718-a1c2-c11995c585b8",
                                                "sense_id": "959e8d06-b267-3189-8ffa-9749d40aab05",
                                                "text": "Absolwenci prawa krytykują obecne egzaminy adwokackie i żądają wprowadzenia ustawy, która umożliwi otwarty dostęp do zawodów prawniczych."
                                            }
                                        ],
                                        "sense_index_json": "\"2.4\""
                                    },
                                    {
                                        "sense_id": "eb21587b-7d2f-3c98-90c0-35837d805012",
                                        "entry_id": "114daa4d-4840-3561-8329-a7f2bc1dbea1",
                                        "glosses": [
                                            "o człowieku: nieukrywający swoich intencji, uczuć"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c98303c8-6d5f-4481-8ee4-b95276b478f2",
                                                "sense_id": "eb21587b-7d2f-3c98-90c0-35837d805012",
                                                "text": "To bardzo otwarty człowiek. Zawsze mówi, co mu leży na sercu."
                                            }
                                        ],
                                        "sense_index_json": "\"2.5\""
                                    },
                                    {
                                        "sense_id": "5e7bc4c6-2ca9-37ea-aa32-f08c9d9f5d5e",
                                        "entry_id": "114daa4d-4840-3561-8329-a7f2bc1dbea1",
                                        "glosses": [
                                            "mający dostępny kod źródłowy"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7042da3c-f232-4884-af97-d7f5bf89fae2",
                                                "sense_id": "5e7bc4c6-2ca9-37ea-aa32-f08c9d9f5d5e",
                                                "text": "Ta firma nie dostarcza otwartych sterowników do swoich kart graficznych; nie można ich samodzielnie poprawić i ponownie skompilować."
                                            }
                                        ],
                                        "sense_index_json": "\"2.6\""
                                    },
                                    {
                                        "sense_id": "941eac7f-69e9-391f-897d-07141ee344b2",
                                        "entry_id": "114daa4d-4840-3561-8329-a7f2bc1dbea1",
                                        "glosses": [
                                            "niczym nie osłonięty, z dostępem do wnętrza"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c7bbbba-9373-45ac-94e8-50d55f686a87",
                                                "sense_id": "941eac7f-69e9-391f-897d-07141ee344b2",
                                                "text": "Chodził po mieście z otwartymi ranami na brzuchu."
                                            }
                                        ],
                                        "sense_index_json": "\"2.7\""
                                    }
                                ]
                            }
                        ]
