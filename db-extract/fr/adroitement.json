                                            {
                                                "example_id": "4a224a3f-40fe-4dbf-b439-e220ff01ec9a",
                                                "sense_id": "6f6328a7-4154-3d66-a64c-3fbbb39afe03",
                                                "text": "Adroitly the ewe led the way to the creek, and the lamb followed."
                                            },
                                            {
                                                "example_id": "3b4b741a-d434-4d6c-b077-8adcd9e40239",
                                                "sense_id": "6f6328a7-4154-3d66-a64c-3fbbb39afe03",
                                                "text": "She held out her empty glass and it was adroitly whisked from her hand."
                                            }
