                        ],
                        "form": "die Elefantenrunden"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c9cfdb29-5958-3a1d-831a-8429be83c7e2",
                        "entry_id": "7194f6be-a40d-3ec5-a88b-4a3d0429e2a3",
                        "glosses": [
                            "im Fernsehen ausgestrahlte Gesprächsrunde, an der für gewöhnlich die Spitzenpolitiker der in das Parlament (in Deutschland: Bundestag, in Österreich und Schweiz: Nationalrat) beziehungsweise in den Bundesrat (in der Schweiz) gewählten oder zur Wahl stehenden Parteien teilnehmen"
                        ],
                        "tags": [
                            "casual",
                            "colloquial",
                            "humorous"
                        ],
                        "examples": [
                            {
                                "example_id": "dea4783f-4c4c-4588-ac41-825d20f20a5a",
                                "sense_id": "c9cfdb29-5958-3a1d-831a-8429be83c7e2",
                                "text": "Die am Wahlabend stattfindende Elefantenrunde verzeichnete hohe Einschaltquoten."
                            },
                            {
                                "example_id": "74fd569b-1258-4b33-a4b8-a387436111f3",
                                "sense_id": "c9cfdb29-5958-3a1d-831a-8429be83c7e2",
                                "text": "„Die Menschen verfolgen im Fernsehen und im Internet Hochrechnungen, Sondersendungen und Elefantenrunden wie bei jeder heimischen Wahl – nur dass man zum Zuschauen verdammt ist.“"
                            },
                            {
                                "example_id": "32abefb4-ffa0-4597-9049-76018c3d7aa1",
                                "sense_id": "c9cfdb29-5958-3a1d-831a-8429be83c7e2",
                                "text": "„Martin Schulz hat Angela Merkel in der Elefantenrunde der Parteichefs und Spitzenkandidaten scharf angegriffen.“"
                            },
                            {
                                "example_id": "2f1d44d3-3587-4a5c-af37-19c955d65016",
                                "sense_id": "c9cfdb29-5958-3a1d-831a-8429be83c7e2",
                                "text": "„Konkrete Ergebnisse brachte die bereits vierte ‚Elefantenrunde‘ aber nicht.“"
                            },
                            {
                                "example_id": "5ae825ec-3e84-4904-998f-cd172bab6161",
                                "sense_id": "c9cfdb29-5958-3a1d-831a-8429be83c7e2",
                                "text": "„Bei Elefantenrunden ist stets für Spannung gesorgt: Die Kandidaten haben die letzte große Gelegenheit, die Gunst der Wähler zu gewinnen.“"
                            },
                            {
                                "example_id": "48a2737a-aa47-4da4-9888-6226429fc001",
                                "sense_id": "c9cfdb29-5958-3a1d-831a-8429be83c7e2",
                                "text": "„Höhepunkte nationaler Wahlkämpfe sind die ‚Elefantenrunden‘ im Fernsehen, in denen üblicherweise die Spitzenkandidaten ihre Ziele nicht nur mit Worten erzählen, sondern auch mit Zahlen beschreiben.“"
                            },
                            {
                                "example_id": "12bdd069-d62f-4adb-8d2d-686c002a13fe",
                                "sense_id": "c9cfdb29-5958-3a1d-831a-8429be83c7e2",
                                "text": "„Schon als die Parteipräsidenten am Abstimmungssonntag in der sogenannten Elefantenrunde vor die Kamera traten, schob SP-Präsident Christian Levrat die Schuld an der Abstimmungsniederlage Müller zu.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
