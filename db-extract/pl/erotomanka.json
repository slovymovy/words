                                        "entry_id": "579c74d6-9ecd-3bb2-9d62-ae0be7e13a47",
                                        "glosses": [
                                            "Personne souffrant d’érotomanie, qui a des obsessions érotiques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "45c5dafe-495a-4cb6-8325-7cff04593ecd",
                                                "sense_id": "2e326151-f513-3647-a9b0-7cb1f16dac4d",
                                                "text": "L’érotomane prend ses désirs pour la réalité."
                                            },
                                            {
                                                "example_id": "638c1459-afee-4e19-adba-318bccde9e22",
                                                "sense_id": "2e326151-f513-3647-a9b0-7cb1f16dac4d",
                                                "text": "À l’arrêt du bus, pour un futur voyage, l’érotomane attend la prochaine étoile."
                                            }
                                        ]
                                    }
                                ]
