                                    {
                                        "sense_id": "f3dd555d-74ff-3eac-a236-5f44c1584cc2",
                                        "entry_id": "6f928b08-94a3-34a5-bacb-8a07fb616b2d",
                                        "glosses": [
                                            "goed tegen een stootje kunnend, niet snel kapot gaand"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5482b1c2-47fc-4ed6-b464-f328bef7334d",
                                                "sense_id": "f3dd555d-74ff-3eac-a236-5f44c1584cc2",
                                                "text": "Die degelijke tent is bestand tegen de storm."
                                            },
                                            {
                                                "example_id": "49239ca7-9d6e-4871-99c2-bf06566a3d28",
                                                "sense_id": "f3dd555d-74ff-3eac-a236-5f44c1584cc2",
                                                "text": "De chique, ruime schrijftafel van ebbenhout, die stijlvol was ingelegd met lichtere houtsoorten, die voor het raam was geplaatst naast de openslaande deuren naar het terras en die gepaard was aan een sobere maar degelijke en comfortabele houten bureaustoel uit de jaren dertig, had ik al meteen bij binnenkomst opgemerkt."
                                            },
                                            {
                                                "example_id": "490f2bd3-b83a-463d-b518-a52d35e81d16",
                                                "sense_id": "f3dd555d-74ff-3eac-a236-5f44c1584cc2",
                                                "text": "Ze heeft de indruk dat de burgerwacht van Sint-Joris degelijk werk heeft verricht, ook al heeft ze akelige herinneringen aan hun betrokkenheid bij de arrestatie van Johannes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8c864b82-e969-348d-98e5-fe6bdd33b3cc",
                                        "entry_id": "6f928b08-94a3-34a5-bacb-8a07fb616b2d",
                                        "glosses": [
                                            "eerlijk, oprecht, net in zijn manieren, saai"
                                        ],
                                        "tags": [
                                            "van personen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4241c058-3b8c-4897-b5d5-9f6c7264e3e1",
                                                "sense_id": "8c864b82-e969-348d-98e5-fe6bdd33b3cc",
                                                "text": "Als je niet met een degelijk iemand trouwt, zal ik je onterven!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
