    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "6c00606b-8046-35d8-b672-c590a0fcbc23",
                "word": "semidarkness",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "374daac6-ad61-392e-98eb-845032ba3cd2",
                        "entry_id": "6c00606b-8046-35d8-b672-c590a0fcbc23",
                        "glosses": [
                            "Partial or near darkness, dimness, twilight."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d22da38e-0141-4710-81c5-b50f96da36f3",
                        "source_entry_id": "6c00606b-8046-35d8-b672-c590a0fcbc23",
                        "source_sense_id": "374daac6-ad61-392e-98eb-845032ba3cd2",
                        "source_sense_description": "partial or near darkness, dimness, twilight.",
                        "target_lang_word": "demi-obscurité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "demi-obscurité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "956b14c6-e418-39ab-97c4-7aedd523045a",
                                        "entry_id": "d3c7835b-3b68-3cf4-832a-d4d975e650ea",
                                        "glosses": [
                                            "Ténèbres incomplètes, demi-jour."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82746756-6c3d-49c8-96c4-6c6978e17ee3",
                                                "sense_id": "956b14c6-e418-39ab-97c4-7aedd523045a",
                                                "text": "Quand le soleil est trop vif, des stores de sparterie qu’on abat sur les fenêtres entretiennent cette demi-obscurité pleine de fraîcheur, qui fait des églises d’Espagne des lieux si favorables au recueillement et à la prière."
                                            },
                                            {
                                                "example_id": "6b9c215c-25d3-44a0-a521-4773a711e591",
                                                "sense_id": "956b14c6-e418-39ab-97c4-7aedd523045a",
                                                "text": "Il ne répondait à personne, et continuait de regarder devant lui sans dire un mot, avec cet air d’inquiétude qui lui-même était un attrait, et cet étrange regard qui flottait dans la demi-obscurité du salon comme une étincelle impossible à fixer."
                                            },
                                            {
                                                "example_id": "c52ebfdd-3af2-49a2-a121-f8937efd199e",
                                                "sense_id": "956b14c6-e418-39ab-97c4-7aedd523045a",
                                                "text": "La nuit tombait, silencieuse ; et cet immense champ de neige prenait dans la demi-obscurité du crépuscule je ne sais quel aspect de profonde mélancolie."
                                            },
                                            {
                                                "example_id": "c371a073-43cd-487c-8bac-ca28a7d74032",
                                                "sense_id": "956b14c6-e418-39ab-97c4-7aedd523045a",
                                                "text": "Puis, comme ses yeux s’accoutumaient à la demi-obscurité, elle finit par apercevoir l’oncle."
                                            },
                                            {
                                                "example_id": "f70d63ef-01f4-4d0c-8486-8970ace0a29a",
                                                "sense_id": "956b14c6-e418-39ab-97c4-7aedd523045a",
                                                "text": "Elle entre dans une chambre noire. On a fait la demi-obscurité, car la lumière est, paraît-il, fatigante."
                                            },
                                            {
                                                "example_id": "ba12f832-7e48-4a97-a9cc-498366184031",
                                                "sense_id": "956b14c6-e418-39ab-97c4-7aedd523045a",
                                                "text": "Il régnait dans la chambre une demi-obscurité."
                                            },
                                            {
                                                "example_id": "82c39a8d-a7dd-4be5-8448-b8ec9c87468f",
                                                "sense_id": "956b14c6-e418-39ab-97c4-7aedd523045a",
                                                "text": "Aussitôt, en effet, il avisa dans la demi-obscurité, car les rideaux de la fenêtre étaient presque fermés, un homme à genoux, et, gisant sur le tapis, une femme que cet homme tenait à la gorge des deux mains."
                                            },
                                            {
                                                "example_id": "7af3777c-a411-49f2-a528-212593246215",
                                                "sense_id": "956b14c6-e418-39ab-97c4-7aedd523045a",
                                                "text": "La demi-obscurité était trouée, au fond, à gauche, par la zone laiteuse de l'estrade où s'agitait un groupe de musiciens de rock'n'roll."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7feaf653-2e80-4523-a9df-85d46256b2e2",
                        "source_entry_id": "6c00606b-8046-35d8-b672-c590a0fcbc23",
                        "source_sense_id": "374daac6-ad61-392e-98eb-845032ba3cd2",
                        "source_sense_description": "partial or near darkness, dimness, twilight.",
                        "target_lang_word": "Halbdunkel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Halbdunkel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1f43246a-e734-34d7-964d-3d1acd24e0e3",
                                        "entry_id": "cd7b3981-54c7-399f-93d3-d8f7746984dc",
                                        "glosses": [
                                            "Zustand, bei dem es noch nicht vollständig dunkel ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c7ca00ca-1eaf-4ede-b5f8-0019b128301b",
                                                "sense_id": "1f43246a-e734-34d7-964d-3d1acd24e0e3",
                                                "text": "Er tapste im Halbdunkel die Kellertreppe hinab."
                                            },
                                            {
                                                "example_id": "b754094b-fc09-4769-917c-5de5709a31be",
                                                "sense_id": "1f43246a-e734-34d7-964d-3d1acd24e0e3",
                                                "text": "„Die Treppe kann man im Halbdunkeln schwer erkennen.“"
                                            },
                                            {
                                                "example_id": "3e2ea7b6-69f4-41ac-b7b3-8db0c2b42a65",
                                                "sense_id": "1f43246a-e734-34d7-964d-3d1acd24e0e3",
                                                "text": "„Ihre Gesichter sind in das Halbdunkel des Raumes getaucht, aber sie geraten in den Lichtschein des Fensters, als sie den Ankömmlingen ein paar Schritte entgegengehen.“"
                                            },
                                            {
                                                "example_id": "3a013e30-7098-4372-b579-6fc3e185ad0f",
                                                "sense_id": "1f43246a-e734-34d7-964d-3d1acd24e0e3",
                                                "text": "„Nach dem Abendessen wurde es draußen pechschwarz, und Elisabeth saß im Halbdunkel auf der Hotelterrasse und trank Kaffee.“"
                                            },
                                            {
                                                "example_id": "f2aad030-f4f4-4d88-b4e7-1d2f17a5d549",
                                                "sense_id": "1f43246a-e734-34d7-964d-3d1acd24e0e3",
                                                "text": "„Es dauerte eine Weile, bis sich seine Augen an das Halbdunkel der Kellerwohnung gewöhnt hatten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
