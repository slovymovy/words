                        ]
                    },
                    {
                        "translation_id": "b7e775f6-63de-4a70-8f04-40b4cd9664f4",
                        "source_entry_id": "a20b2f5f-85c6-3cc8-8857-ee9916961eda",
                        "source_sense_id": "fc11fee8-69b1-374d-8ca9-5c6627fef59f",
                        "target_lang_word": "croaker",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "croaker",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "60378cac-fd03-38d9-8af6-382eaf916d6d",
                                        "entry_id": "6a46ad15-b2ae-3610-b0eb-b401b49c7a30",
                                        "glosses": [
                                            "Someone who or something that makes a croaking sound."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fe2297cf-6294-3fe4-9959-da06b93cbaa7",
                                        "entry_id": "6a46ad15-b2ae-3610-b0eb-b401b49c7a30",
                                        "glosses": [
                                            "A vocal pessimist, grumbler, or doomsayer."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "001b07a0-cdac-44ce-9e79-fe1a4c5e1a9a",
                                                "sense_id": "fe2297cf-6294-3fe4-9959-da06b93cbaa7",
                                                "text": "There are croakers in every country, always boding its ruin."
                                            },
                                            {
                                                "example_id": "576e4c2a-0eae-4dbc-99c3-2988e54817fd",
                                                "sense_id": "fe2297cf-6294-3fe4-9959-da06b93cbaa7",
                                                "text": "It is thought by many, and said by some, that this Republic has already seen its best days; that the historian may now write the story of its decline and fall. Two classes of men are just now especially afflicted with such forebodings. The first are those who are croakers by nature – the men who have a taste for funerals, and especially national funerals. They never see the bright side of anything, and probably never will."
                                            },
                                            {
                                                "example_id": "cd3a1178-5ddd-4c39-9a03-0999c5e8c7d9",
                                                "sense_id": "fe2297cf-6294-3fe4-9959-da06b93cbaa7",
                                                "text": "Nor did the croakers have long to wait. The second night after the drowning of the mate the little yacht was suddenly wracked from stem to stern."
                                            },
                                            {
                                                "example_id": "43cfa82e-e2d0-42d2-84eb-b37b34660ce5",
                                                "sense_id": "fe2297cf-6294-3fe4-9959-da06b93cbaa7",
                                                "text": "\"It is my advice,\" the speaker continued, \"that we go easier upon the small men. On the day that they have all been driven out the power of this society will have been broken.\" Unwelcome truths are not popular. There were angry cries as the speaker resumed his seat. McGinty rose with gloom upon his brow. \"Brother Morris,\" said he, \"you were always a croaker...\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "de05c57d-6c9c-3a3d-b310-1316a9098d79",
                                        "entry_id": "6a46ad15-b2ae-3610-b0eb-b401b49c7a30",
                                        "glosses": [
                                            "A frog."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "86963475-d4cc-4ff3-9984-8fc875351b28",
                                                "sense_id": "de05c57d-6c9c-3a3d-b310-1316a9098d79",
                                                "text": "Frogs are also sensitive to vibrations through the ground, a footfall usually being sufficient to instil silence in a pond full of croakers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5c6d5a17-5a00-34b8-a22f-e7ddb82c677d",
                                        "entry_id": "6a46ad15-b2ae-3610-b0eb-b401b49c7a30",
                                        "glosses": [
                                            "Certain fish in the family Sciaenidae, known for the throbbing sounds they make."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "94d4894b-d70d-3360-88de-4629f79f8372",
                                        "entry_id": "6a46ad15-b2ae-3610-b0eb-b401b49c7a30",
                                        "glosses": [
                                            "A doctor."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8d05a62b-4a77-4273-9e15-c05df09ec8a7",
                                                "sense_id": "94d4894b-d70d-3360-88de-4629f79f8372",
                                                "text": "\"Lungs,\" said McGuire comprehensively. \"I got it. The croaker says I'll come to time for four months longer—maybe six if I hold my gait.[…]\""
                                            },
                                            {
                                                "example_id": "9068b63f-7519-4530-81eb-72443518a300",
                                                "sense_id": "94d4894b-d70d-3360-88de-4629f79f8372",
                                                "text": "He located a doctor in Brooklyn who was a writing fool. This croaker would go three scripts a day for as high as thirty tablets a script."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cf70461d-9a24-4d94-b909-9661d29777ad",
                        "source_entry_id": "a20b2f5f-85c6-3cc8-8857-ee9916961eda",
                        "source_sense_id": "fc11fee8-69b1-374d-8ca9-5c6627fef59f",
                        "target_lang_word": "meagre",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "meagre",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "63bbf0e0-f39c-35a4-b271-ac15602998b7",
                                        "entry_id": "2e5184b3-4f8e-3a21-99fa-46995b825b18",
                                        "glosses": [
                                            "An edible fish, of species Argyrosomus regius, of the family Sciaenidae, found from the Black Sea to the eastern Atlantic."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ca41f8a-5375-4558-819f-58c24b9523c8",
                                                "sense_id": "63bbf0e0-f39c-35a4-b271-ac15602998b7",
                                                "text": "1986, A. Wysokiński, The Living Marine Resources of the Southeast Atlantic, FAO Fisheries Technical Paper 178, page 48,\nAmong more valuable species some of them are worth mentioning, especially littoral forms as: meagres and other croakers (Sciaenidae), grunters (Pomadasyidae), threadfins (Polynemidae), groupers (Serranidae), snappers (Lutjanidae) […] ."
                                            },
                                            {
                                                "example_id": "056b4b93-7bb3-4953-a871-20ef449593fc",
                                                "sense_id": "63bbf0e0-f39c-35a4-b271-ac15602998b7",
                                                "text": "It is striking that these represent meagres (Argyrosomus regius), a species never mentioned in classical texts."
                                            },
                                            {
                                                "example_id": "5d9036d4-5f3f-4b2d-800c-7a57b7e14282",
                                                "sense_id": "63bbf0e0-f39c-35a4-b271-ac15602998b7",
                                                "text": "Meagres (Argyrosomus regius, 230 cm, 103 kg) have been raised mainly in Spain, France and Italy."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "meagre",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ed3f4cf3-ef5a-3cb6-b7a2-3396c65dd2a9",
                                        "entry_id": "7edf12cf-251b-3963-a6ab-66e7175b58f4",
                                        "glosses": [
                                            "Having little flesh; lean; thin."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "UK",
                                            "common"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ef3e436-57d0-43f5-b507-7bc832200f5f",
                                                "sense_id": "ed3f4cf3-ef5a-3cb6-b7a2-3396c65dd2a9",
                                                "text": "[…]meagre were his looks; / Sharp misery had worn him to the bones:"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3793c3e8-5934-3a1a-97bc-6920c57c926b",
                                        "entry_id": "7edf12cf-251b-3963-a6ab-66e7175b58f4",
                                        "glosses": [
                                            "Deficient or inferior in amount, quality or extent"
                                        ],
                                        "tags": [
                                            "Canada",
                                            "UK",
                                            "common"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "641ab869-469e-4d47-bf37-305a90067deb",
                                                "sense_id": "3793c3e8-5934-3a1a-97bc-6920c57c926b",
                                                "text": "Nothing will grow in this meagre soil."
                                            },
                                            {
                                                "example_id": "adc92ba8-f925-409d-a226-16b5d20162f8",
                                                "sense_id": "3793c3e8-5934-3a1a-97bc-6920c57c926b",
                                                "text": "He was given a meagre piece of cake that he swallowed in one bite."
                                            },
                                            {
                                                "example_id": "d884ef35-0e3a-49bd-b352-e5aa224aced5",
                                                "sense_id": "3793c3e8-5934-3a1a-97bc-6920c57c926b",
                                                "text": "His education had been but meagre."
                                            },
                                            {
                                                "example_id": "02d28c8a-cc32-4a79-bcd1-f3d915f008d3",
                                                "sense_id": "3793c3e8-5934-3a1a-97bc-6920c57c926b",
                                                "text": "It is hardly surprising, therefore, that the present rail passenger service is meagre and between Wetherby and Church Fenton almost non-existent."
                                            },
                                            {
                                                "example_id": "771afd02-8484-4688-9b95-bfdfaf472e5e",
                                                "sense_id": "3793c3e8-5934-3a1a-97bc-6920c57c926b",
                                                "text": "Until the recent rash of North London line maps appeared on station billboards in the London area of BR, the service undoubtedly suffered from meagre and ineffectual publicity."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "448e8b34-85e2-37b2-a3f2-c0b7e43ef41f",
                                        "entry_id": "7edf12cf-251b-3963-a6ab-66e7175b58f4",
                                        "glosses": [
                                            "Of a set: such that, considered as a subset of a (usually larger) topological space, it is in a precise sense small or negligible."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "UK",
                                            "common"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ae6b9763-71c1-3d88-8d0b-9ea13e78b889",
                                        "entry_id": "7edf12cf-251b-3963-a6ab-66e7175b58f4",
                                        "glosses": [
                                            "Dry and harsh to the touch (e.g., as chalk)."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "UK",
