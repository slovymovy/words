                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b4db8fd2-eda5-46e1-a7e7-097a816ad8af",
                                "sense_id": "265b4db1-ee87-30c3-9b7e-a408ba5b4394",
                                "text": "Skoki na bungee podwyższają poziom adrenaliny w organizmie."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
