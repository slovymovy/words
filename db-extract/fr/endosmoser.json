                        "glosses": [
                            "Provoquer un effet d'endosmose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45440206-a8c4-4d76-8433-181fdb0b88e9",
                                "sense_id": "a04bda59-d3fe-3ddb-b637-34f7c9441aca",
                                "text": "Le réservoir membraneux contient du mercure, plus l'air et le gaz vers lequel on veut endosmoser un autre fluide."
                            },
                            {
                                "example_id": "c3260d58-44f3-470c-8d88-18c8c7ea7cf3",
                                "sense_id": "a04bda59-d3fe-3ddb-b637-34f7c9441aca",
                                "text": "L'azote contenu dans le sang et l'azote de l'air atmosphérique n'ont pareillement aucune tendance à s'endosmoser l'un l'autre au travers des membranes du poumon."
                            }
                        ]
                    }
