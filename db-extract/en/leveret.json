                                        ],
                                        "tags": [
                                            "expressively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ff0d378-fea4-4705-b938-9802514db4d8",
                                                "sense_id": "cb9ac134-edd3-3479-84d2-6aa7f356b3a2",
                                                "text": "Pětačtyřicetiletá spisovatelka Irena Obermannová upozorňuje, že sama nemá se „zajíčky“ zkušenosti, ale podobné vztahy ji zajímají."
