                "senses": [
                    {
                        "sense_id": "3f5c57ca-55cf-3325-befa-55fd33bda018",
                        "entry_id": "6b7a6546-6361-3932-8432-91e166af33ec",
                        "glosses": [
                            "To be in contact or connection with."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "a3567950-f0e7-44e0-9239-e49f45eda569",
                                "sense_id": "3f5c57ca-55cf-3325-befa-55fd33bda018",
                                "text": "We were in the living area, which adjoins the kitchen."
                            },
                            {
                                "example_id": "5f1e6731-16ba-493f-bbf0-6d52bf40312a",
                                "sense_id": "3f5c57ca-55cf-3325-befa-55fd33bda018",
                                "text": "The living room and dining room adjoin each other."
                            }
                        ]
                    },
                    {
                        "sense_id": "b65764ba-ef1e-30b3-8539-15f5cdf680cf",
                        "entry_id": "6b7a6546-6361-3932-8432-91e166af33ec",
                        "glosses": [
                            "To extend an algebraic object (e.g. a field, a ring, etc.) by adding to it an element not belonging to it and then ensuring closure, for example by also adding all finite power series of the element."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "228cbd87-0918-4ffc-b5af-d1a62c351261",
                                "sense_id": "b65764ba-ef1e-30b3-8539-15f5cdf680cf",
                                "text": "The ring adjunction #92;mathbb#123;Q#125;#91;#92;sqrt#123;2#125;#93; can be obtained from #92;mathbb#123;Q#125; by adjoining #92;sqrt#123;2#125; to #92;mathbb#123;Q#125;."
                            },
                            {
                                "example_id": "c1c68e9d-7091-4051-944b-55a3e34acfdf",
                                "sense_id": "b65764ba-ef1e-30b3-8539-15f5cdf680cf",
                                "text": "The field adjunction #92;mathbb#123;Q#125;(#92;pi) can be obtained from #92;mathbb#123;Q#125; by adjoining #92;pi to #92;mathbb#123;Q#125;."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c6ef8bcd-f4fc-46bf-af89-be0bdf047c5f",
                        "source_entry_id": "6b7a6546-6361-3932-8432-91e166af33ec",
                        "source_sense_description": "to be in contact or connection with",
                        "target_lang_word": "sousedit",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sousedit",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "5f20f898-0696-3ecd-bf1d-7690b48264f2",
                                        "entry_id": "296b5b81-1db2-3da2-b6ff-4b3a674cfe1c",
                                        "glosses": [
                                            "mít společné hranice; mít za souseda; nemít mezi sebou navzájem nikoho dalšího"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "476d9996-6903-41df-ab69-983b8ee2a990",
                                                "sense_id": "5f20f898-0696-3ecd-bf1d-7690b48264f2",
                                                "text": "Než Maďaři obsadili Podunajskou nížinu, tvořila tahle etnická skupina jakousi spojku mezi východními a jižními Slovany, na západě sousedili s Lemky, na východě s Huculy a od obou se liší nářečím, oděvem, jazykem i zvyky, nejblíže prý mají k Ukrajincům."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c4d3a446-cd5a-4af0-a5f5-e28f06a172a7",
                        "source_entry_id": "6b7a6546-6361-3932-8432-91e166af33ec",
                        "source_sense_description": "to be in contact or connection with",
                        "target_lang_word": "adjoindre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "adjoindre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8b29d8db-e469-3d35-a9a1-2767ef1b49d0",
                                        "entry_id": "d7744f98-dd35-3fe6-afdb-bccf53284813",
                                        "glosses": [
                                            "Joindre une ou plusieurs personnes à une ou plusieurs autres pour exécuter une chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d345782-4711-4aa2-b6d1-7ad08ae2332e",
                                                "sense_id": "8b29d8db-e469-3d35-a9a1-2767ef1b49d0",
                                                "text": "Hommes adroits et intelligents, que ce Marbre et ce Sabine, et le capitaine Craventy avait sagement fait en les adjoignant au détachement du lieutenant Hobson."
                                            },
                                            {
                                                "example_id": "54f910e6-b04c-4173-8aad-9fcf8c2ee65f",
                                                "sense_id": "8b29d8db-e469-3d35-a9a1-2767ef1b49d0",
                                                "text": "D'après le traité de Verdun (843), Lothaire, qui avait été adjoint à son père dans la conduite de affaires publiques, resta empereur en nom."
                                            },
                                            {
                                                "example_id": "159f0e47-5f6f-4fb4-950b-d4da0ad6bb20",
                                                "sense_id": "8b29d8db-e469-3d35-a9a1-2767ef1b49d0",
                                                "text": "C’est d’ailleurs dans cet esprit que M. St-Pierre Plamondon s’adjoindra les services de son ex-adversaire, Frédéric Bastien, à titre de conseiller en matière d’affaires constitutionnelles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "63a73239-70f9-38ec-abc9-17a43a3f3311",
                                        "entry_id": "d7744f98-dd35-3fe6-afdb-bccf53284813",
                                        "glosses": [
                                            "Ajouter une chose à une autre pour faire un tout."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "349eca89-0259-40a6-8124-4ee98fdfda9a",
                                                "sense_id": "63a73239-70f9-38ec-abc9-17a43a3f3311",
                                                "text": "Peu à peu, il agrandit son établissement, lui adjoignit un hôtel borgne où de savantes « passes » lui assurèrent de larges profits."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3022bb6d-574a-3d5d-8f08-a27c33f5ee42",
                                        "entry_id": "d7744f98-dd35-3fe6-afdb-bccf53284813",
                                        "glosses": [
                                            "Être adjoint."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5763f3f7-ca9c-42a7-b0b3-2ce280c7a14d",
                                                "sense_id": "3022bb6d-574a-3d5d-8f08-a27c33f5ee42",
                                                "text": "À l’obsolescence technique s’adjoint donc une obsolescence psychologique : un téléphone de deux ans est ringard, un vêtement de six mois est démodé, un écran plat est déjà bien triste face à une télévision 3D."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "17f730f2-c5a4-46b5-b05e-0e5e7a2f7ac7",
                        "source_entry_id": "6b7a6546-6361-3932-8432-91e166af33ec",
                        "source_sense_description": "to be in contact or connection with",
                        "target_lang_word": "грани́чить",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "грани́чить",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "d03f77a8-4746-3344-ba80-5f3884b91c43",
                                        "entry_id": "38a075b9-381b-3977-a63f-63a369d0d796",
                                        "glosses": [
                                            "иметь общую границу, быть смежным территориально ◆ Ведь Смоленская-то губерния граничит с Московскою. М. Н. Загоскин, «Москва и москвичи», 1842—1850 г. [НКРЯ]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10694a5c-74b3-4121-94f2-297b59c300a1",
                                                "sense_id": "d03f77a8-4746-3344-ba80-5f3884b91c43",
                                                "text": "Двор его одною стороною граничил к площадке, на которой стояла церковь Николы-льняного, при повороте вниз Константино-Еленовской улицы, а другою стороною к кремлёвской стене."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc9531a8-1891-3ede-91cd-8879ec59fea6",
                                        "entry_id": "38a075b9-381b-3977-a63f-63a369d0d796",
                                        "glosses": [
                                            "перен. быть близким к чему-либо, доходить до чего-либо"
                                        ],
                                        "tags": [
                                            "о чувствах, переживаниях и т. п."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "43004fd9-e0d9-4eef-a074-e9793995e041",
                                                "sense_id": "fc9531a8-1891-3ede-91cd-8879ec59fea6",
                                                "text": "Что-то граничило почти с отчаянием, чего никогда не бывало в сердце Алеши."
                                            },
                                            {
                                                "example_id": "45f72360-4de2-467b-9c84-dab2024a42b8",
                                                "sense_id": "fc9531a8-1891-3ede-91cd-8879ec59fea6",
                                                "text": "Улитушка поняла, что Порфирий Владимирыч трусит и что в этой пустоутробной и изолгавшейся натуре трусость очень близко граничит с ненавистью"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9035acdb-66c9-328d-bec0-7685bcef7caa",
                                        "entry_id": "38a075b9-381b-3977-a63f-63a369d0d796",
                                        "glosses": [
                                            "устар. являться границей чего-либо; разграничивать, ограничивать"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c7456342-42d3-4d11-a2fd-bf519938a50a",
                                                "sense_id": "9035acdb-66c9-328d-bec0-7685bcef7caa",
                                                "text": "В пересечении наружной поверхности тела со внутренней, продолженной вне тела, происходит линия, которая, замыкаясь, граничит внутреннюю поверхность или, другими словами, ― разделяет внутреннюю сторону линии от наружной, беспредельной в окружном пространстве."
                                            },
                                            {
                                                "example_id": "ee19efe6-5cf9-4411-98ce-048ebd95c5b0",
                                                "sense_id": "9035acdb-66c9-328d-bec0-7685bcef7caa",
                                                "text": "Из корпуса он перешел на палубу, и как прежде каменная стена граничила его ребяческий мир, теперь его миром стал безграничный океан."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7994c945-ae5a-421d-9186-9e6921117311",
                        "source_entry_id": "6b7a6546-6361-3932-8432-91e166af33ec",
                        "source_sense_description": "to be in contact or connection with",
                        "target_lang_word": "примыка́ть",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "примыка́ть",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "b01bbec2-6b3a-3637-b641-c4b72febae4a",
                                        "entry_id": "fa562f4b-09bf-3ba1-b588-9fe666b7df3e",
                                        "glosses": [
                                            "находиться вплотную к чему-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88490f14-9357-4ea9-b4d7-71f70e04c3e7",
                                                "sense_id": "b01bbec2-6b3a-3637-b641-c4b72febae4a",
                                                "text": "Он строил новую конюшню, к которой будут примыкать ресторан и зал, где предполагается устраивать вечера народных танцев."
                                            },
                                            {
                                                "example_id": "280ee692-d71c-4627-a833-e8f6f8a7f560",
                                                "sense_id": "b01bbec2-6b3a-3637-b641-c4b72febae4a",
                                                "text": "Одной стороной он будет примыкать к «Националю», а другой — к театру имени Ермоловой."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "94a00734-273d-39c8-8fb5-a551084633c3",
                                        "entry_id": "fa562f4b-09bf-3ba1-b588-9fe666b7df3e",
                                        "glosses": [
                                            "то же, что присоединяться; становиться членом какой-либо группы, общности"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "73de2818-08ac-45e5-bd3f-879145b2a6bd",
                                                "sense_id": "94a00734-273d-39c8-8fb5-a551084633c3",
                                                "text": "А так как к русской литературно-языковой традиции примыкать ни за что не хотели, то оставалось только примкнуть к традиции польского литературного языка."
                                            },
                                            {
                                                "example_id": "fe56bfd6-60f5-4863-a29c-16b2281ef98b",
                                                "sense_id": "94a00734-273d-39c8-8fb5-a551084633c3",
                                                "text": "Листовки обращались к бежавшим из плена бойцам Красной Армии, указывая, что их долг — уходить в леса, искать партизанские отряды и примыкать к ним…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "053c47df-a18c-3542-b950-8f1f7612777c",
                                        "entry_id": "fa562f4b-09bf-3ba1-b588-9fe666b7df3e",
                                        "glosses": [
                                            "спец. то же, что присоединять"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af7eac7a-f9db-4e11-af38-56708a346497",
                                                "sense_id": "053c47df-a18c-3542-b950-8f1f7612777c",
                                                "text": "Батарейцы спешно начали примыкать штыки к ружьям, готовясь отразить атаку стремительно приближавшихся немцев."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eec24a57-d311-43ad-84e6-79fb040a4942",
                        "source_entry_id": "6b7a6546-6361-3932-8432-91e166af33ec",
                        "source_sense_description": "to be in contact or connection with",
                        "target_lang_word": "сосе́дствовать",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "сосе́дствовать",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "3e816ea0-232e-3508-8b48-23968d1fa13b",
                                        "entry_id": "004c9dd2-9a42-3204-af62-1b30074f906b",
                                        "glosses": [
                                            "быть соседом, жить в соседстве с кем-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1136d816-c066-4987-89ba-e6dc41096e7e",
                                                "sense_id": "3e816ea0-232e-3508-8b48-23968d1fa13b",
                                                "text": "Едва ли не впервые я соседствовал, сосуществовал с немалым чиновником, близко наблюдал его трудовой распорядок."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fcd19aa6-7705-380e-bd93-d587881622d6",
                                        "entry_id": "004c9dd2-9a42-3204-af62-1b30074f906b",
                                        "glosses": [
                                            "находиться, располагаться или происходить, иметь место рядом, поблизости, вместе с чем-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "203203ad-f644-4efa-9f46-88f47c019241",
                                                "sense_id": "fcd19aa6-7705-380e-bd93-d587881622d6",
                                                "text": "С этими чисто восточными лакомствами соседствовали европейские ― петербургский шоколад и московские конфеты."
                                            },
                                            {
                                                "example_id": "134ca886-bbbf-46b8-9eb1-b1338309c7d0",
                                                "sense_id": "fcd19aa6-7705-380e-bd93-d587881622d6",
                                                "text": "Романский стиль отличается крайней разнородностью своих проявлений, смелые поиски нового соседствуют с глубоко отсталыми формами."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
