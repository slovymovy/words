        "pl-extract.jsonl": [
            {
                "entry_id": "9cea8e96-4107-3fc9-a968-8596bad9c860",
                "word": "opustoszały",
                "pos": "adj",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "df8a122f-30d6-3284-afff-7f40694a7e9a",
                        "entry_id": "9cea8e96-4107-3fc9-a968-8596bad9c860",
                        "glosses": [
                            "o obszarze, regionie, budynku itd.: który został opuszczony przez ludzi i pozostaje niezamieszkały"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a2dc633d-8118-4990-9ca6-9e3dacbef390",
                                "sense_id": "df8a122f-30d6-3284-afff-7f40694a7e9a",
                                "text": "Władze Wysp Kanaryjskich poinformowały, że w związku z rosnącą na ulicach liczbą afrykańskich imigrantów podjęły decyzję o skierowaniu 200 nielegalnych przybyszów do hoteli i ośrodków turystycznych, które są opustoszałe wskutek epidemii koronawirusa"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "786eff78-614f-470e-9880-ca7ad4f48ee5",
                        "source_entry_id": "9cea8e96-4107-3fc9-a968-8596bad9c860",
                        "source_sense_id": "df8a122f-30d6-3284-afff-7f40694a7e9a",
                        "target_lang_word": "abandoned",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abandoned",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b81dfef4-7944-3edb-88f4-f735e694eb84",
                                        "entry_id": "bde74fcd-1b5f-3040-b431-c664db434d16",
                                        "glosses": [
                                            "Having given oneself up to vice; immoral; extremely wicked, or sinning without restraint; irreclaimably wicked."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10592895-57ef-4f3e-a8b1-9f77a1ecf97d",
                                                "sense_id": "b81dfef4-7944-3edb-88f4-f735e694eb84",
                                                "text": "Such immunity to offenders offered a safe asylum to the vilest and most abandoned scoundrels."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d1dc770b-2787-399c-94d0-b2d4c684dea1",
                                        "entry_id": "bde74fcd-1b5f-3040-b431-c664db434d16",
                                        "glosses": [
                                            "No longer maintained by its former owners, residents, or caretakers; forsaken, deserted."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "54d38ff6-bf87-4cbb-bdaa-7a47b0154284",
                                                "sense_id": "d1dc770b-2787-399c-94d0-b2d4c684dea1",
                                                "text": "abandoned building"
                                            },
                                            {
                                                "example_id": "bc9e94e4-ae7c-414f-bec7-a67bf8f958cb",
                                                "sense_id": "d1dc770b-2787-399c-94d0-b2d4c684dea1",
                                                "text": "abandoned property"
                                            },
                                            {
                                                "example_id": "20ca1176-ea80-40e9-90b7-c16b55ad8c29",
                                                "sense_id": "d1dc770b-2787-399c-94d0-b2d4c684dea1",
                                                "text": "They explored an abandoned factory on the edge of town."
                                            },
                                            {
                                                "example_id": "8e165608-c33c-475a-acd0-bfe78f343426",
                                                "sense_id": "d1dc770b-2787-399c-94d0-b2d4c684dea1",
                                                "text": "[…] your abandoned streams […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "58f155d1-5d00-3b63-a2b6-91463f2022b9",
                                        "entry_id": "bde74fcd-1b5f-3040-b431-c664db434d16",
                                        "glosses": [
                                            "Free from constraint; uninhibited."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16444e1c-d3a1-49f2-8a57-5bdc71836dff",
                                                "sense_id": "58f155d1-5d00-3b63-a2b6-91463f2022b9",
                                                "text": "Everything was dirty and shabby. There was no sign of the abandoned luxury that Colonel MacAndrew had so confidently described."
                                            },
                                            {
                                                "example_id": "6c7a844a-8f78-4e52-a217-14769a27ccea",
                                                "sense_id": "58f155d1-5d00-3b63-a2b6-91463f2022b9",
                                                "text": "What is the same is our need for community. What seemed different was an abandoned enjoyment of life and music, a uniquely Quebec sense of joie de vivre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "63bd3a70-b1d8-31b1-9c8b-af3365fffc7b",
                                        "entry_id": "bde74fcd-1b5f-3040-b431-c664db434d16",
                                        "glosses": [
                                            "No longer being acted upon by the geologic forces that formed it."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
