                    {
                        "sense_id": "bda324d3-36ff-3db1-91f8-0bb44ab8253e",
                        "entry_id": "2fe485ed-4bec-3fc7-ad0e-91fa9d1d125b",
                        "glosses": [
                            "Extrêmement dangereux, dont on risque de ne pas se remettre, à cause d'intentions malveillantes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "27db013c-070e-4756-8718-064f19c34800",
                                "sense_id": "bda324d3-36ff-3db1-91f8-0bb44ab8253e",
                                "text": "… je déclinai les invitations de Jean-Jacques Bourdin et de Maïté Biraben, deux émissions coupe-gorge où j'avais tout à perdre."
                            }
                        ]
                    }
