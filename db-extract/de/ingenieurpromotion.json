                ],
                "senses": [
                    {
                        "sense_id": "fefc87d2-51a0-3c47-9d77-9ce76995b3e6",
                        "entry_id": "3cf0c9f1-f63e-3ce3-b97c-93cf4a6cac2c",
                        "glosses": [
                            "Verleihung beziehungsweise Erlangung akademischer Grade eines Ingenieurs zu seinem Basisstudium der Ingenieurwissenschaften"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c57d125a-6cf7-410a-80de-502bc9645ff4",
                                "sense_id": "fefc87d2-51a0-3c47-9d77-9ce76995b3e6",
                                "text": "„Die Ingenieurpromotion läuft anders ab als die Promotion in anderen Disziplinen.“"
                            },
                            {
                                "example_id": "ec1dced6-9a65-483e-b11b-d06db06d2b1d",
                                "sense_id": "fefc87d2-51a0-3c47-9d77-9ce76995b3e6",
                                "text": "„Die Ingenieurpromotion an deutschen Universitäten, die durch eine weitgehend selbständige Tätigkeit in Forschung, Lehre und Projektarbeit gekennzeichnet ist, ermöglicht eine umfassende Kompetenzentwicklung der Doktoranden.“"
                            },
                            {
                                "example_id": "b778766d-9d55-4848-b400-71268c06c5d5",
                                "sense_id": "fefc87d2-51a0-3c47-9d77-9ce76995b3e6",
                                "text": "„Sie hebt die Qualitätsmerkmale der klassischen Ingenieurpromotion in Deutschland klar hervor und zeigt zugleich eine ganze Reihe wertvoller Ansätze zur weiteren Verbesserung und Modernisierung der Promotion auf.“"
                            },
                            {
                                "example_id": "2612c26c-7a7b-480d-92f1-99cd81b68c71",
                                "sense_id": "fefc87d2-51a0-3c47-9d77-9ce76995b3e6",
                                "text": "„Es gibt in Europa Bestrebungen, die Ingenieurpromotion zu verschulen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
