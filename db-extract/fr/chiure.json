                "senses": [
                    {
                        "sense_id": "e84d2905-feca-398d-901b-88741eee9575",
                        "entry_id": "c94094c1-24b2-3a71-98b1-3f156a37ddfe",
                        "glosses": [
                            "Excrément de mouches ou d’autres insectes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c703e94b-cef9-437f-a393-ecab06d6f7f2",
                                "sense_id": "e84d2905-feca-398d-901b-88741eee9575",
                                "text": "Mais tous ses soins furent pour le salon. Elle réussit presque à en faire un lieu habitable. Il était garni d’un meuble de velours jaunâtre, à fleurs satinées. Au milieu se trouvait un guéridon à tablette de marbre ; des consoles, surmontées de glaces, s’appuyaient aux deux bouts de la pièce. Il y avait même un tapis qui ne couvrait que le milieu du parquet, et un lustre garni d’un étui de mousseline blanche que les mouches avaient piqué de chiures noires."
                            },
                            {
                                "example_id": "fe8ea87c-550e-4e4f-a0b8-babce40dbc07",
                                "sense_id": "e84d2905-feca-398d-901b-88741eee9575",
                                "text": "La vitre constellée de chiures de mouches renvoyait à Tsi-Tsi le reflet chatoyant de son corsage jaune canari […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "7f216d09-16e4-368f-9328-eff153cbe2ee",
                        "entry_id": "c94094c1-24b2-3a71-98b1-3f156a37ddfe",
                        "glosses": [
                            "Personne ou chose qui ne mérite pas de considération."
                        ],
                        "tags": [
                            "pejorative",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "a575a070-3d6f-41e1-aa26-ce4387db59f5",
                                "sense_id": "7f216d09-16e4-368f-9328-eff153cbe2ee",
                                "text": "Un morceau de plage insulaire est porteur d’une vaste signification. Une terreur panique. Une chiure bénie, calcinée sans pitié par le soleil."
                            },
                            {
                                "example_id": "70f95e29-2a54-47d8-bdf6-56c7939cf19b",
                                "sense_id": "7f216d09-16e4-368f-9328-eff153cbe2ee",
                                "text": "Dis-moi-le donc pourquoi je devrais pas te traiter comme la petite chiure prétentieuse que t'as l'air d'être?"
                            }
                        ]
                    }
                ],
