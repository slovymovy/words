                            {
                                "target_lang_word": "undress",
                                "target_lang_sense_clarification": "someone else"
                            },
                            {
                                "target_lang_word": "strip",
                                "target_lang_sense_clarification": "someone else"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "90871cbe-5c77-3232-aae1-f572a93a183d",
                    "sense_definition": "iemand financieel zwaar benadelen of beroven van al zijn geld",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "financieel_benadelen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij werd door die woekeraar helemaal <w>uitgekleed</w>.",
                            "target_lang_translations": {
                                "en": "He was completely <w>fleeced</w> by that usurer."
                            }
                        },
                        {
                            "text": "De fiscus kan burgers soms volledig <w>uitkleden</w> met hoge belastingen.",
                            "target_lang_translations": {
                                "en": "The tax authorities can sometimes completely <w>strip</w> citizens with high taxes."
                            }
                        }
                    ],
                    "synonyms": [
                        "pluimen",
                        "kaalplukken",
                        "beroven"
                    ],
                    "common_phrases": [
