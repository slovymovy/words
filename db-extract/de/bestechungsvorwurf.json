                        "examples": [
                            {
                                "example_id": "7c5e46a5-8d7f-462f-8a93-d41ac234068f",
                                "sense_id": "6e600e11-c542-31bb-885f-a9c70c617766",
                                "text": "„Was den Bestechungsvorwurf betreffe, so gebe es keinen Anhaltspunkt, ‚wer an wen wann was für ein Bestechungsgeld übergeben haben könnte‘.“"
                            },
                            {
                                "example_id": "801d62c3-74d6-4cb4-919d-00ea0a3ba6ea",
                                "sense_id": "6e600e11-c542-31bb-885f-a9c70c617766",
                                "text": "„Dieses Jahr stellte den Bürgermeister auf eine harte Probe – da war die vertrackte Sache mit dem Grundstücksverkauf und dem Polizisten, der Bestechungsvorwurf und die Haftstrafe.“"
                            }
                        ],
