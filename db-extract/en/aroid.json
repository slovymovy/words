                        "glosses": [
                            "Any plant of the family Araceae, found chiefly in the tropics."
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "4e303412-2a64-48ff-a42e-ba909c4dbf38",
                                "sense_id": "e6e008b0-4428-339c-b8dd-0bc7c90af854",
                                "text": "They made their way slowly to the great Palm House and thence up twisty iron steps to a nook like a tree refuge in New Guinea, among palm boles and extravagant aroid growths."
                            },
                            {
                                "example_id": "f23ee1a2-192a-4e6a-adca-33554277aa8f",
                                "sense_id": "e6e008b0-4428-339c-b8dd-0bc7c90af854",
                                "text": "Jack-in-the-pulpit is the only other aroid native to our part of the world."
                            },
                            {
                                "example_id": "17c7eaed-8ece-4023-aed1-407fb3d55711",
                                "sense_id": "e6e008b0-4428-339c-b8dd-0bc7c90af854",
                                "text": "The majority of aroids are climbers and epiphytes of tropical rainforests."
                            }
                        ]
