                ],
                "senses": [
                    {
                        "sense_id": "2b3332a4-bc6e-32e9-95bd-6738100e3fd8",
                        "entry_id": "6eba1501-c7e7-3fbf-835b-bba6ba792ce0",
                        "glosses": [
                            "Réduction de sucre et de vinaigre, pouvant par exemple servir de base à une sauce aigre-douce."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e954b93e-46bb-4e91-8601-5276bc532295",
                                "sense_id": "2b3332a4-bc6e-32e9-95bd-6738100e3fd8",
                                "text": "En fait, pour lui donner une meilleure assise, il faudrait faire au départ une « gastrique », c’est-à-dire, amener d’abord la gelée de groseilles mouillée de vinaigre jusqu’au caramel, ce qui atténuera la douceur du sucre."
                            },
                            {
                                "example_id": "42c65dfa-8613-4b9c-bb8b-6be37e691ed2",
                                "sense_id": "2b3332a4-bc6e-32e9-95bd-6738100e3fd8",
                                "text": "Faire chauffer le miel dans le poêlon ; réaliser une gastrique en déglaçant avec 2 ou 3 cuillères à soupe du vinaigre des bocaux de prunes et de cerises."
                            }
                        ]
                    },
                    {
                        "sense_id": "22ff6ec3-0001-3580-b1e4-f31b5c00e212",
                        "entry_id": "6eba1501-c7e7-3fbf-835b-bba6ba792ce0",
                        "glosses": [
                            "Gastrite."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f09c556-759c-4b04-b6a9-9651d5cbd793",
                                "sense_id": "22ff6ec3-0001-3580-b1e4-f31b5c00e212",
                                "text": "Une hémorragie gastrique diffuse évoque une gastrique hémorragique."
                            }
                        ]
                    }
