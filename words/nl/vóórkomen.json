                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "aanwezigheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Deze zeldzame planten <w>komen</w> alleen <w>vóór</w> in dit specifieke natuurgebied.",
                            "target_lang_translations": {
                                "en": "These rare plants are only <w>found</w> in this specific nature reserve.",
                                "ru": "Эти редкие растения <w>встречаются</w> только в этом конкретном заповеднике."
                            }
                        },
                        {
                            "text": "In dit hoofdstuk wordt het <w>vóórkomen</w> van pesten onderzocht.",
                            "target_lang_translations": {
                                "en": "In this chapter, the <w>occurrence</w> of bullying is investigated.",
                                "ru": "В этой главе исследуется <w>распространение</w> буллинга."
                            }
                        }
                    ],
                    "synonyms": [
