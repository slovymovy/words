                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "570ebb98-1a64-4933-a866-5eefa71dd531",
                                                "sense_id": "be194ecc-4b43-39c0-b5c8-f410b7eb6c2a",
                                                "text": "Eine Bescheinigung dient als schriftlicher Nachweis für die Richtigkeit einer behaupteten Tatsache."
                                            },
                                            {
                                                "example_id": "db4ef504-ec54-4514-a99a-443bec03efb5",
                                                "sense_id": "be194ecc-4b43-39c0-b5c8-f410b7eb6c2a",
                                                "text": "„Sie bat mich, ich möge mich für sie verwenden, und übergab mir alle Bescheinigungen, die ich allenfalls nötig haben würde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "afde3fe6-3c91-4bcd-a520-908ea4564b21",
