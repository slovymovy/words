                                                "sense_id": "155e1840-79ad-33e2-9d30-c5b8f3407b69",
                                                "text": "Der Wind traf achterlich auf das Schiff."
                                            },
                                            {
                                                "example_id": "3fce23ea-5d97-4e8b-82ff-d15f6752b471",
                                                "sense_id": "155e1840-79ad-33e2-9d30-c5b8f3407b69",
                                                "text": "„Er fiel also etwas achterlich in die an beiden Masten gesetzten Rahsegel.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
