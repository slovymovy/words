                "senses": [
                    {
                        "sense_id": "080e015b-2ca5-326a-93c7-d127f1cc97e8",
                        "entry_id": "4b82e7f5-9248-365e-babc-f8d6f7433afc",
                        "glosses": [
                            "staatliche Institution, die für die Durchführung der Zensur zuständig ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d47454f-c1bc-4167-bd7f-9391b8a0c5dc",
                                "sense_id": "080e015b-2ca5-326a-93c7-d127f1cc97e8",
                                "text": "„So unterschrieb er denn rasch die Entlastungserklärung für die Vormunde, nahm die achthundert Pistolen in Empfang und reichte sein Manuskript der Zensurbehörde ein.“"
                            },
                            {
                                "example_id": "60e71f5b-de28-4f4d-be9b-a0d1fae64d1b",
                                "sense_id": "080e015b-2ca5-326a-93c7-d127f1cc97e8",
                                "text": "„Nach dem Konflikt mit der preußischen Zensurbehörde im Jahre 1794, als die Arbeit an den drei großen Kritiken bereits weit hinter ihm lag, zog sich Kant allmählich und stetig vom akademischen Lehramt zurück.“"
                            },
                            {
                                "example_id": "ce1a47eb-0d43-4e8b-a5cd-3bb9b7fd18fe",
                                "sense_id": "080e015b-2ca5-326a-93c7-d127f1cc97e8",
                                "text": "„Doch selbst dies war zu viel für die Zensurbehörde, das Stück wurde bis in die neueste Zeit nie aufgeführt oder gedruckt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
