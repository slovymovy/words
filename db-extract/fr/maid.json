                        "form": "maids"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5f13112b-07e6-3fc9-916e-68f319c9810d",
                        "entry_id": "f91f8ad8-8b8d-3cee-b543-9c5056764dcf",
                        "glosses": [
                            "Servant·e, bonne, soubrette, généralement une femme."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "7fdf5e3e-0f02-4263-813c-3052a6e2e967",
                                "sense_id": "5f13112b-07e6-3fc9-916e-68f319c9810d",
                                "text": "Dans un sombre, avec seule lumière qui reflète son bras doré, évitant de faire peur au client. Elle regarde la maid avec un sourire."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6d815d81-c6e6-49e4-a732-c20a922398e5",
                        "source_entry_id": "f91f8ad8-8b8d-3cee-b543-9c5056764dcf",
                        "source_sense_id": "5f13112b-07e6-3fc9-916e-68f319c9810d",
                        "target_lang_word": "maid",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "maid",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bc01c78b-528b-3541-974d-da26bee76c15",
                                        "entry_id": "6e61b0a2-9dcc-37cc-adfb-4450f692c91d",
                                        "glosses": [
                                            "A girl or an unmarried young woman; maiden."
                                        ],
                                        "tags": [
                                            "dated",
                                            "poetic"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e56c409e-22d2-364a-9103-4dbf81541532",
                                        "entry_id": "6e61b0a2-9dcc-37cc-adfb-4450f692c91d",
                                        "glosses": [
                                            "A female servant or cleaner (short for maidservant)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "99b46aec-2cf0-4111-8c95-0fbe9d3894e8",
                                                "sense_id": "e56c409e-22d2-364a-9103-4dbf81541532",
                                                "text": "She was a fat, round little woman, richly apparelled in velvet and lace, […]; and the way she laughed, cackling like a hen, the way she talked to the waiters and the maid,[…]—all these unexpected phenomena impelled one to hysterical mirth, and made one class her with such immortally ludicrous types as Ally Sloper, the Widow Twankey, or Miss Moucher."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "74b3538b-2068-329f-b957-70de9138fe43",
                                        "entry_id": "6e61b0a2-9dcc-37cc-adfb-4450f692c91d",
                                        "glosses": [
                                            "A virgin, now female but originally one of either gender."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e970cb51-c3f9-440f-8ab3-8fc95fc25aaf",
                                                "sense_id": "74b3538b-2068-329f-b957-70de9138fe43",
                                                "text": "You are betrothed both to a maid and man."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "06276ac7-9568-45e5-bd9f-59aec9aa9cda",
                        "source_entry_id": "f91f8ad8-8b8d-3cee-b543-9c5056764dcf",
                        "source_sense_id": "5f13112b-07e6-3fc9-916e-68f319c9810d",
                        "target_lang_word": "meido",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "meido",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bb57dcb3-edde-3f55-898d-2c6f31dc4f3f",
                                        "entry_id": "09debdb7-6480-3448-af35-352a973ce9cb",
                                        "glosses": [
                                            "A female fictional character who is employed as a maid, typically wearing a stylized French maid outfit."
                                        ],
                                        "tags": [
                                            "Japanese"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a8f0516-b977-47ad-afe0-7a9d9a344d9c",
                                                "sense_id": "bb57dcb3-edde-3f55-898d-2c6f31dc4f3f",
                                                "text": "I was really struck by how many of the bishoujo cliches it managed to bring up. We already have the older sister, younger sister, childhood friend, and exotic transfer student. We have a genki girl, a ditzy girl, a hime-sama, and a meido."
                                            },
                                            {
                                                "example_id": "b746594b-dc99-488a-8705-fba5f66c9074",
                                                "sense_id": "bb57dcb3-edde-3f55-898d-2c6f31dc4f3f",
                                                "text": "And then there’s Roberta, who seems like a typical meido (maid) character until she pulls out machine guns from her lacy uniform!"
                                            },
                                            {
                                                "example_id": "c1812dda-7820-4066-a9c2-3912f623710b",
                                                "sense_id": "bb57dcb3-edde-3f55-898d-2c6f31dc4f3f",
                                                "text": "Although this is a manga about maids, don’t expect to see the submissive and fawning maids of the meido category. The protagonist here is a faithful, skilled and courteous maid from the old English society."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "96a3ca7f-99e3-3920-9c5f-86635b5baaf0",
                                        "entry_id": "09debdb7-6480-3448-af35-352a973ce9cb",
                                        "glosses": [
                                            "A waitress at a maid café."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4308478-df1a-41f4-8cc1-37eec3b83b18",
                                                "sense_id": "96a3ca7f-99e3-3920-9c5f-86635b5baaf0",
                                                "text": "Actually, the two times I was there, it was really quite dull in terms of the people wandering around. The most excitement I saw was that one candidate for Prime Minister giving a van-top speech in front of Akihabara station. Oh, and a demonstration of some RC \"Tokyo Drift\" toy cars out on the street. No dancing in the streets, only a very few meido (some of questionable gender >__< ), and quite a few gaikokujin."
                                            },
                                            {
                                                "example_id": "5c66c291-173f-401b-b7ab-2a452ea9b236",
                                                "sense_id": "96a3ca7f-99e3-3920-9c5f-86635b5baaf0",
                                                "text": "These meido attract customers by role-playing the part of a maid, complete with French maid-inspired outfits that are long on fantasy elements and typically short on skirt length."
                                            },
                                            {
                                                "example_id": "c949e8ca-2815-4c79-9402-23faaca43fb7",
                                                "sense_id": "96a3ca7f-99e3-3920-9c5f-86635b5baaf0",
                                                "text": "\"I like having conversations with different meidos,\" he explains, \"but Haruki is my favourite because she's friendliest to me.\"\n[…]\nUtena, a meido with pink hair and red plastic horns, recently celebrated her fourth year at Maidolce."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
