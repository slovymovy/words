                    "frequency": "High",
                    "semantic_group_id": "temperature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En été, la <w>chaleur</w> devient parfois insupportable pendant l'après-midi."
                        },
                        {
                            "text": "Il préfère rester à l'intérieur pour éviter la forte <w>chaleur</w> du soleil."
                        }
                    ],
                    "antonyms": [
                        "froid",
                        "fraîcheur"
                    ],
                    "common_phrases": [
