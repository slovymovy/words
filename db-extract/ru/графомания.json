                                        "examples": [
                                            {
                                                "example_id": "25d5f785-1df5-44f8-92a2-67d79f26d3d5",
                                                "sense_id": "fe4261da-0cbf-3c90-830b-80e035eb245c",
                                                "text": "Tout s’était noué pendant l’année 1967. François Duprat disposait de loisirs suite à son exclusion d’Occident. Il laissait libre cours à sa graphomanie dans des publications nationalistes ; il entretenait une autre de ses pathologies dans Défense de l’Occident, la revue de Maurice Bardèche."
                                            }
                                        ]
