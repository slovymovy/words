                                "target_senses": [
                                    {
                                        "sense_id": "5847d81d-b68a-304b-b5f7-ee62ba5cf077",
                                        "entry_id": "27c08aac-b468-34bc-8611-7f3b29e1bb2b",
                                        "glosses": [
                                            "A male given name from the Celtic languages."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3eef7e3-b470-4838-ad0d-e505ea45be5b",
                                                "sense_id": "5847d81d-b68a-304b-b5f7-ee62ba5cf077",
                                                "text": "Young Arthur is alive: this hand of mine / Is yet a maiden and an innocent hand, / Not painted with the crimson spots of blood."
                                            },
                                            {
                                                "example_id": "6606a43f-78de-43d6-9f21-0b5c05c1624a",
                                                "sense_id": "5847d81d-b68a-304b-b5f7-ee62ba5cf077",
                                                "text": "\"Is his name Arthur?\" \"Arthur James.\" \"It’s quite an old-fashioned name.\" \"We’re an old-fashioned family. His mother was fond of Tennyson.\""
                                            },
                                            {
                                                "example_id": "dde7593e-3f19-46f3-ab4e-be050ee17a53",
                                                "sense_id": "5847d81d-b68a-304b-b5f7-ee62ba5cf077",
                                                "text": "\"It will not be his only name,\" Mr. Saporta said, and his glance hoped he had found an acceptable solution. \"We shall also call him 'Aaron'. That will be his Jewish name. But for everyday purposes—Arthur.\""
                                            }
                                        ]
                                    },
