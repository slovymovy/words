                "senses": [
                    {
                        "sense_id": "e5e01738-2724-342b-9f82-348b52ecc5bc",
                        "entry_id": "962d95c8-5123-32b8-90bc-b1f08a299119",
                        "glosses": [
                            "großes, aufwendig gestaltetes sowie reich verziertes Bauwerk (das den Reichtum seines Besitzers/Erbauers zum Ausdruck bringen soll)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "27890db2-498a-4428-a10a-9e1cbab646f9",
                                "sense_id": "e5e01738-2724-342b-9f82-348b52ecc5bc",
                                "text": "„Bei einem Spaziergang entlang der rund fünf Kilometer langen [Wiener] Ringstraße schreitet man entlang unzähliger Prachtbauten.“"
                            },
                            {
                                "example_id": "fd45c47f-faff-461f-9a6c-b0b290a17624",
                                "sense_id": "e5e01738-2724-342b-9f82-348b52ecc5bc",
                                "text": "„Sie ließ viele Prachtbauten errichten, die sie unter anderem durch intensiven Opiumanbau finanzierte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
