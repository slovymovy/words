                "senses": [
                    {
                        "sense_id": "cd1f2b5d-3a1e-3091-b81c-9b99dc93a065",
                        "entry_id": "b8b76bd7-185d-3c38-af3a-f391973bea9f",
                        "glosses": [
                            "in Jahren angegebenes Alter zu einer Gruppe, wobei das Alter der Hälfte der Gruppenmitglieder darüber- und das der anderen Hälfte darunterliegt"
                        ],
                        "tags": [
                            "Statistik"
                        ],
                        "examples": [
                            {
                                "example_id": "d1f96646-fcd4-4640-8ec3-6a14cd4a5084",
                                "sense_id": "cd1f2b5d-3a1e-3091-b81c-9b99dc93a065",
                                "text": "„Die Statistik zeigt den Altersmedian der Weltbevölkerung in den Jahren von 1990 bis 2020 und verschiedene Prognosen bis zum Jahr 2100. Im Jahr 2020 betrug der Altersmedian der Weltbevölkerung 30,9 Jahre. Bei einer angenommenen niedrigen Fertilität wird für das Jahr 2100 ein Altersmedian der Weltbevölkerung von 49,5 prognostiziert.“"
                            },
                            {
                                "example_id": "47b17f57-8e1f-40bb-94ee-117bca6224af",
                                "sense_id": "cd1f2b5d-3a1e-3091-b81c-9b99dc93a065",
                                "text": "„Prospektiv wurden 841 stationår betreute traumatologische Patienten (483 Månner und 358 Frauen), Altersmedian 52 Jahre (Min 18, Max 94 Jahre) mit einem multimodalen Konzept der Thrombembolieprophylaxe behandelt.“"
                            },
                            {
                                "example_id": "610d7e0a-5897-49a4-915a-af47635d7b33",
                                "sense_id": "cd1f2b5d-3a1e-3091-b81c-9b99dc93a065",
                                "text": "„Wenn größere Abweichungen auftreten, so unterschieden sich meist die Altersmediane erheblich, daß heißt ein Kollektiv ist jünger als das andere, und die Vergleichbarkeit der beiden Gruppen ist nicht mehr völlig gewährleistet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
