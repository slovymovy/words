                "senses": [
                    {
                        "sense_id": "dc96d2a2-5ccc-3ad2-9fd9-e1ff61a05996",
                        "entry_id": "3635c189-854e-3ce7-93c0-303f23e775eb",
                        "glosses": [
                            "Fahrkarte für Angehörige der Wehrmacht zur Nutzung der Eisenbahn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c2bdf83b-74dd-44fb-99a1-486fced6c985",
                                "sense_id": "dc96d2a2-5ccc-3ad2-9fd9-e1ff61a05996",
                                "text": "„Krummbier nickt bedächtig, greift in seine Brusttasche und zieht, sorgsam zwischen anderen Papieren versteckt, zwei graublaue Wehrmachtsfahrscheine hervor.“"
                            },
                            {
                                "example_id": "d349b6c5-b627-4124-bda2-e6696f36081e",
                                "sense_id": "dc96d2a2-5ccc-3ad2-9fd9-e1ff61a05996",
                                "text": "„Der Wehrmachtsfahrschein, den ich übrigens gern vorzeigte, war wichtig, weil in der Eisenbahn ziviles Reisen kaum noch möglich war.“"
                            },
                            {
                                "example_id": "89124af4-7cd3-4cfd-a843-c3750cebba11",
                                "sense_id": "dc96d2a2-5ccc-3ad2-9fd9-e1ff61a05996",
                                "text": "„Der - auch von uns ausgestellte - Wehrmachtsfahrschein wies als Zielort Göllingen im Harz aus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
