                                    {
                                        "sense_id": "0f9ad829-9625-384a-ae4a-42b24e6f4c6b",
                                        "entry_id": "a094f03b-3274-3700-91bc-181634ba325f",
                                        "glosses": [
                                            "(o ženě) mající v děloze potomka"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3de66682-ca0f-4a0a-97f4-912dd3791aac",
                                                "sense_id": "0f9ad829-9625-384a-ae4a-42b24e6f4c6b",
                                                "text": "„Já nikdy nebudu těhotný, ale podle toho, co říkají matky gynekoložky, je nemožné, aby si žena nevšimla, že se s ní něco děje. Zvlášť když nejde o prvorodičku, ale rodí už potřetí,“ dodává [Pondělíček]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8c3d7282-acea-38e3-902c-eeee2e9afcf5",
                                        "entry_id": "a094f03b-3274-3700-91bc-181634ba325f",
                                        "glosses": [
                                            "(těhotný něčím) oplývající, nabitý"
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "poetic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b93b8c69-6c3e-4669-be90-4f6c17dcab9d",
                                                "sense_id": "8c3d7282-acea-38e3-902c-eeee2e9afcf5",
                                                "text": "doba těhotná událostmi"
                                            },
                                            {
                                                "example_id": "44147c56-c24c-423c-9657-2f99868596e4",
                                                "sense_id": "8c3d7282-acea-38e3-902c-eeee2e9afcf5",
                                                "text": "A těhotný byl pravdou již svět celý// a pravou víru, která s nebe plála,// již apoštolé věčné říše seli."
                                            },
                                            {
                                                "example_id": "3ae42c0b-3a8b-43e9-b693-7d66800c807a",
                                                "sense_id": "8c3d7282-acea-38e3-902c-eeee2e9afcf5",
                                                "text": "Neměla by půlnoc být prospána‚ protože je vždycky těhotná tajemstvím."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
