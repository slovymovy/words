                        "examples": [
                            {
                                "example_id": "4186ae6d-c39e-41b2-8d23-074c82e6013b",
                                "sense_id": "b3ea2554-b93a-3bc5-b982-6784723ed6fe",
                                "text": "Guido Spek was de afgelopen jaren al regelmatig in het theater te zien, onder meer in de musical Into the Woods en de theaterversie van het populaire tv-programma De Vloer Op. Spek staat volgend jaar ook in de musicalversie van de hitfilm Verliefd op Ibiza."
                            },
                            {
                                "example_id": "cf05cb5a-d3d2-4fc3-b7cd-2d091809680d",
                                "sense_id": "b3ea2554-b93a-3bc5-b982-6784723ed6fe",
                                "text": "Hollywoodster Colin Farrell verscheen na zijn 25ste verjaardag met zo'n kater op de set van de hitfilm Minority Report dat hij flinke moeite had met het onthouden van zijn tekst. De inmiddels 43-jarige acteur had destijds maar liefst 56 takes nodig voor één zin goed op camera stond, onthult Farrell tegen Mirror."
                            }
                        ]
                    }
