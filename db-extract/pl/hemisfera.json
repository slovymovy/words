                "translations": [
                    {
                        "translation_id": "0a6bd79f-0da3-431d-b081-aecfaa28a72a",
                        "source_entry_id": "2ac38f6a-77a8-3d27-93a7-f2243e3fed46",
                        "source_sense_id": "26b7e9f8-154d-3792-a86d-95330ef7f5a8",
                        "target_lang_word": "Hemisphäre",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hemisphäre",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c7f041dc-e9ef-3f74-8546-3f2fffd9661f",
                                        "entry_id": "533f831b-fe14-3b64-a56e-ee014432d992",
                                        "glosses": [
                                            "bei einer Unterteilung der Erde oder eines anderen Himmelskörpers in je zwei Hälften – eine nördliche und eine südliche beziehungsweise eine östliche und eine westliche – einer der beiden Teile"
                                        ],
                                        "tags": [
                                            "Geographie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dd711191-43a8-4d90-8ac1-1da4d327d7a0",
                                                "sense_id": "c7f041dc-e9ef-3f74-8546-3f2fffd9661f",
                                                "text": "Wenn auf der nördlichen Hemisphäre Sommer ist, ist auf der südlichen Winter und umgekehrt."
                                            },
                                            {
                                                "example_id": "fcf298ca-99dd-4831-a6d4-e5ecc11b07d2",
                                                "sense_id": "c7f041dc-e9ef-3f74-8546-3f2fffd9661f",
                                                "text": "„In Südafrika ist das bisher größte und stärkste Radioteleskop der südlichen Hemisphäre in Betrieb genommen worden.“"
                                            },
                                            {
                                                "example_id": "2c4859ba-da48-4e9e-bc7b-92d690494c24",
                                                "sense_id": "c7f041dc-e9ef-3f74-8546-3f2fffd9661f",
                                                "text": "„Das Schiff hatte jene Breitengrade erreicht, die heute unter dem Namen Brüllende Vierziger bekannt sind, da der Wind dort praktisch ungehindert von Land über die südliche Hemisphäre fegt.“"
                                            },
                                            {
                                                "example_id": "0dfa5689-621a-4b75-b130-7e413b8c9cd5",
                                                "sense_id": "c7f041dc-e9ef-3f74-8546-3f2fffd9661f",
                                                "text": "„Nur auf der nördlichen Hemisphäre des Mondes findet man Kettengebirge […].“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f00cb528-10c4-3d80-a1e7-2329c51eba4b",
                                        "entry_id": "533f831b-fe14-3b64-a56e-ee014432d992",
                                        "glosses": [
                                            "die nördliche beziehungsweise südliche Hälfte der Himmelskugel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8770bad-6609-4926-9075-f0ddcd0bb0b9",
                                                "sense_id": "f00cb528-10c4-3d80-a1e7-2329c51eba4b",
                                                "text": "„Er teilt die Himmelskugel in zwei Hälften, welche als nördliche und südliche Hemisphäre des Himmels unterschieden werden.“"
                                            },
                                            {
                                                "example_id": "842584d7-fe95-4d20-bce9-9860354b083e",
                                                "sense_id": "f00cb528-10c4-3d80-a1e7-2329c51eba4b",
                                                "text": "„Der Südliche Fisch […] ist der Gegenpart der Fische auf der südlichen Hemisphäre der Himmelskugel.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "d35166b2-8a2b-3f66-bfd8-1762a4bbd34e",
                                        "entry_id": "533f831b-fe14-3b64-a56e-ee014432d992",
                                        "glosses": [
                                            "die linke beziehungsweise rechte Hälfte des Gehirns"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55cf136c-61b9-4794-8389-878eb3e6ea0d",
                                                "sense_id": "d35166b2-8a2b-3f66-bfd8-1762a4bbd34e",
                                                "text": "„Die linke Hemisphäre bekommt also über das rechte Gesichtsfeld andere Informationen als die rechte Hemisphäre über das linke Gesichtsfeld.“"
                                            },
                                            {
                                                "example_id": "e1be6dd3-eb15-4e1f-acc8-f78f562fc20c",
                                                "sense_id": "d35166b2-8a2b-3f66-bfd8-1762a4bbd34e",
                                                "text": "„Hervorzuheben ist hierbei weniger eine Lateralisierung unseres Gehirns als eine gut funktionierende ständige Interaktion zwischen rechter und linker Hemisphäre.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    }
