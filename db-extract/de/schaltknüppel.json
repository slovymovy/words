                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19b581fc-5b08-4cf3-b08b-6f8e2a546d3d",
                                "sense_id": "f310dd25-0d3a-388c-8d75-71c2b504f3c0",
                                "text": "„Viele legen beim Autofahren die rechte Hand auf den Schaltknüppel – und nur die wenigsten wissen wahrscheinlich, warum sie das tun.“"
                            },
                            {
                                "example_id": "21846eae-bba6-4727-bb72-282ff240baab",
                                "sense_id": "f310dd25-0d3a-388c-8d75-71c2b504f3c0",
                                "text": "„In den Kindertagen des Automobils war der Schaltknüppel noch gar nicht so richtig an Bord.“"
                            }
                        ],
