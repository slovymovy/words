                "senses": [
                    {
                        "sense_id": "4ad8c264-0922-3a03-9ed2-ed106bf3a39b",
                        "entry_id": "b58bbdf1-97bf-30eb-8195-ae748c56de77",
                        "glosses": [
                            "bezwymiarowa jednostka wyrażająca porównanie dwu wielkości równe logarytmowi dziesiętnemu ich stosunku, zwykle stosowana do określania głośności, mocy akustycznej źródła dźwięku, stopnia wzmocnienia sygnału itp."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "649959e0-def5-423e-87a7-f221450688c7",
                                "sense_id": "4ad8c264-0922-3a03-9ed2-ed106bf3a39b",
                                "text": "Bel to bardzo duża jednostka, odpowiadająca bardzo dużym zmianom w natężeniu dźwięku, dlatego w praktyce używa się mniejszej jednostki – dziesiątej części bela, czyli decybela"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
