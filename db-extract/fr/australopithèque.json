                    {
                        "form_id": "f4b32c09-e03a-4381-a790-a68f553e5034",
                        "entry_id": "910c7904-0726-3fd2-abc6-d4b296930f50",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
