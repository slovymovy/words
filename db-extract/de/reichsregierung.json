                ],
                "senses": [
                    {
                        "sense_id": "f65296b6-df70-3a02-b1a2-189c708df278",
                        "entry_id": "47594aa3-c6b5-3445-92a3-be28a4c36555",
                        "glosses": [
                            "Regierung des Deutschen Reiches"
                        ],
                        "tags": [
                            "historisch in der Zeit von 1871 bis 1945"
                        ],
                        "examples": [
                            {
                                "example_id": "c150fbdf-06b3-4368-ad24-b2d87afd3487",
                                "sense_id": "f65296b6-df70-3a02-b1a2-189c708df278",
                                "text": "Von 1871 bis 1918 bestand die Reichsregierung aus dem Kaiser und dem Bundesrat, danach bis 1945 aus Reichskanzler und Reichsministern."
                            },
                            {
                                "example_id": "2c90e01e-9949-4467-9dcd-45ce5c073ba4",
                                "sense_id": "f65296b6-df70-3a02-b1a2-189c708df278",
                                "text": "„Außerdem ermahnte die Reichsregierung die Bevölkerung des Ruhrgebiets, ausschließlich mit friedlichen Mitteln Widerstand zu leisten.“"
                            },
                            {
                                "example_id": "d72daa59-a530-4ac9-8812-58aa09bf2f1d",
                                "sense_id": "f65296b6-df70-3a02-b1a2-189c708df278",
                                "text": "„Die deutsche Reichsregierung sah den Aufruhr mit Sorge und setzte einen Landeskenner in Marsch, der bereits für den belgischen König Leopold II. den Kongobogen erforscht hatte.“"
                            },
                            {
                                "example_id": "9a9d16f2-f88b-4d09-a3a5-9e7584552d03",
                                "sense_id": "f65296b6-df70-3a02-b1a2-189c708df278",
                                "text": "„Doch das war mehr ein formaler Unterschied, wie das Ultimatum zeigte, das die Reichsregierung am späten Nachmittag nach St. Petersburg schickte.“"
                            },
                            {
                                "example_id": "6f15a12c-bfca-4bb5-b4e4-f89a12fd3d9b",
                                "sense_id": "f65296b6-df70-3a02-b1a2-189c708df278",
                                "text": "„Nach der Verhaftung der letzten Reichsregierung an dem sonnigen Morgen des 23. Mai 1945 wurde in der Marineschule Mürwik die Reichskriegsflagge für immer eingeholt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
