                "senses": [
                    {
                        "sense_id": "41efe6e2-dd28-3ca9-948e-2ace11b4eb0d",
                        "entry_id": "0d2b8264-7392-36dc-a3f5-6fdcd41426db",
                        "glosses": [
                            "unzureichende Menge nachgesuchter Ingenieure am Arbeitsmarkt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c12ce8bc-ca58-40bb-80b5-0730ae71d913",
                                "sense_id": "41efe6e2-dd28-3ca9-948e-2ace11b4eb0d",
                                "text": "„Der Ingenieurmangel, der Gegenstand des ersten Teils der gemeinsamen Plenarversammlung war, wurde bereits auf der Fachkonferenz am gestrigen Tage behandelt.“"
                            },
                            {
                                "example_id": "850ee87a-4777-43ed-9fa9-3b1428c7492f",
                                "sense_id": "41efe6e2-dd28-3ca9-948e-2ace11b4eb0d",
                                "text": "„Damit sind vor allem solche Branchen vom Ingenieurmangel betroffen, die in Deutschland den höchsten Stellenwert haben.“"
                            },
                            {
                                "example_id": "4d5b174b-187a-4db1-9fdf-0a5eb6bcf0dd",
                                "sense_id": "41efe6e2-dd28-3ca9-948e-2ace11b4eb0d",
                                "text": "„Trotz steigender Arbeitslosigkeit unter älteren Fachkräften nimmt der Ingenieurmangel in der deutschen Wirtschaft zu. Gegenwärtig sind rund 15.000 Ingenieurstellen bundesweit unbesetzt, zugleich jedoch 26.000 Ingenieure über 50 Jahre ohne Beschäftigung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
