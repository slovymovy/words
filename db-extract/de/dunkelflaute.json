                ],
                "senses": [
                    {
                        "sense_id": "4ffeed46-cb1c-34da-8920-0cf83e101b63",
                        "entry_id": "7d91e03d-9e8a-3c3e-a773-2216f62db207",
                        "glosses": [
                            "längere Dauer eines Ausfalls der Stromproduktion aus Windkraftanlagen und Photovoltaik aufgrund ungünstiger meteorologischer Gegebenheiten"
                        ],
                        "tags": [
                            "Energie"
                        ],
                        "examples": [
                            {
                                "example_id": "6ee2de60-4bde-42de-a9fc-7ff6ddafc3fa",
                                "sense_id": "4ffeed46-cb1c-34da-8920-0cf83e101b63",
                                "text": "„Derzeit sorgen kurzfristig thermische Kraftwerke, die mit Öl, Gas oder Kohle befeuert werden, dafür, dass auch in Zeiten einer Dunkelflaute genauso viel Strom in die Leitungen kommt, wie entnommen wird.“"
                            },
                            {
                                "example_id": "f762e6e6-2bb3-4c8f-8781-3af1aecc330c",
                                "sense_id": "4ffeed46-cb1c-34da-8920-0cf83e101b63",
                                "text": "„In der Wirtschaft bedeutet Dunkelflaute, dass Windenergie- und Fotovoltaik-Anlagen nur sehr wenig Strom produzieren.“"
                            },
                            {
                                "example_id": "b5573450-e795-45ba-8fc2-e4a1b02d8e9a",
                                "sense_id": "4ffeed46-cb1c-34da-8920-0cf83e101b63",
                                "text": "„Besonders gefürchtet ist die sogenannte »kalte Dunkelflaute«, wenn also mitten im Winter die Sonne gar nicht scheint und gleichzeitig der Wind ausbleibt – aber jeder heizen möchte.“"
                            },
                            {
                                "example_id": "05bf0159-bd6d-479e-87b1-8d67912e484c",
                                "sense_id": "4ffeed46-cb1c-34da-8920-0cf83e101b63",
                                "text": "„Dunkelflauten kommen zwar nicht häufig vor, können aber mehrere Tage anhalten, und es ist unmöglich, den Strom einfach abzustellen, bis wieder genügend Wind weht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
