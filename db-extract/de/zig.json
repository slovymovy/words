                    },
                    {
                        "translation_id": "d8dd8a9c-f04c-4411-8040-b230d7680875",
                        "source_entry_id": "6041f516-57c2-3079-8c80-2df2af61b01c",
                        "source_sense_id": "866e51b4-137e-3647-ac44-ddb82a37b9a6",
                        "source_sense_description": "(sehr) viele",
                        "target_lang_word": "tig",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tig",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "03f9dc9a-4036-3617-90b4-5e6ed1d206d4",
                                        "entry_id": "733f8970-8b4d-3e29-be09-8eaa44c9691b",
                                        "glosses": [
                                            "groot aantal, in de ogen van de spreker meer dan toereikend"
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ae6d4d5-b78a-479e-8561-4994c1193a00",
                                                "sense_id": "03f9dc9a-4036-3617-90b4-5e6ed1d206d4",
                                                "text": "Over biologie deed Manouk langer dan ze tijdens de oefenexamens nodig had. \"Omdat ik elk antwoord tig keer controleerde voordat ik er zeker van was.\""
                                            },
                                            {
                                                "example_id": "57cf6c30-da9f-4382-9aa0-65dd41b89627",
                                                "sense_id": "03f9dc9a-4036-3617-90b4-5e6ed1d206d4",
                                                "text": "Zou het mogelijk zijn om deze trails een structureel onderdeel van mijn leven te maken in plaats van een sabbatical om de tig jaar? Het idee alleen al om mijn werk wat regelmatiger te kunnen afwisselen met een wandeling in de natuur gaf me rust."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "afd0306a-563b-4403-a101-ded8742cb414",
                        "source_entry_id": "6041f516-57c2-3079-8c80-2df2af61b01c",
                        "source_sense_id": "866e51b4-137e-3647-ac44-ddb82a37b9a6",
                        "source_sense_description": "(sehr) viele",
                        "target_lang_word": "куча",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "куча",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "1c6652e5-cb70-354d-a550-7071eb8d64d5",
                                        "entry_id": "9b4f243a-c2a7-36ec-8904-6168916f4766",
                                        "glosses": [
                                            "большое количество чего-либо, обычно сыпучего, мелкого, наваленного, насыпанного в одном месте"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e830e19d-8ea2-4cd4-bef6-4a2f80c4572d",
                                                "sense_id": "1c6652e5-cb70-354d-a550-7071eb8d64d5",
                                                "text": "Куча песка."
                                            },
                                            {
                                                "example_id": "06ee0245-f68d-4fb8-82e8-bf10388a1563",
                                                "sense_id": "1c6652e5-cb70-354d-a550-7071eb8d64d5",
                                                "text": "Его одежда валялась на полу бесформенной кучей."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fd4c5877-adfa-37cc-8c5c-b8aab6c056c7",
                                        "entry_id": "9b4f243a-c2a7-36ec-8904-6168916f4766",
                                        "glosses": [
                                            "разг. беспорядочное скопление людей, животных, автомобилей и т. п."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a50a6e91-29e1-423d-8030-62b269886082",
                                                "sense_id": "fd4c5877-adfa-37cc-8c5c-b8aab6c056c7",
                                                "text": "Не представляю, как люди жили в коммуналках в одной куче, дети, однако же, были, и много детей, все делали в спешке, где уж тут до взаимной психотерапии, подготовки, ласк, слов."
                                            }
                                        ]
                                    },
                                    {
