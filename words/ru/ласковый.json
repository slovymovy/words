                            {
                                "target_lang_word": "gracious",
                                "target_lang_sense_clarification": "courteous, kind, and pleasant in interaction"
                            },
                            {
                                "target_lang_word": "warm",
                                "target_lang_sense_clarification": "friendly and receptive"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "27d455db-a490-39f0-8ff6-2f90ab3cc50d",
                    "sense_definition": "Доставляющий мягкое, приятное ощущение; мягкий, нежащий (о природе, погоде).",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "физическое_ощущение",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Летом нам очень нравилось купаться в тёплом и <w>ласковом</w> море.",
                            "target_lang_translations": {
                                "en": "In the summer, we loved swimming in the warm, <w>gentle</w> sea."
                            }
                        },
                        {
                            "text": "С юга подул лёгкий, <w>ласковый</w> ветерок, принёсший долгожданную прохладу.",
                            "target_lang_translations": {
                                "en": "A light, <w>caressing</w> breeze blew from the south, bringing long-awaited cool."
                            }
                        }
                    ],
