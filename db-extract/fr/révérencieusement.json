        "fr-extract.jsonl": [
            {
                "entry_id": "77b7ea56-0c7f-3b30-af08-986a6af1a3e4",
                "word": "révérencieusement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "32f79dfa-d8a2-3089-a946-26b2dba148b0",
                        "entry_id": "77b7ea56-0c7f-3b30-af08-986a6af1a3e4",
                        "glosses": [
                            "Avec respect, d’une manière humble et cérémonieuse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d4b0324-eab2-4d97-a99b-87bc758004ee",
                                "sense_id": "32f79dfa-d8a2-3089-a946-26b2dba148b0",
                                "text": "Père Ytier vous salue très révérencieusement"
                            },
                            {
                                "example_id": "b537ac1c-1b61-42f5-b486-0d9191c7151a",
                                "sense_id": "32f79dfa-d8a2-3089-a946-26b2dba148b0",
                                "text": "Il [Claudien] peint les facéties des mystères de Cérès telles qu’on les jouait encore révérencieusement en Grèce jusqu'à Théodose II"
                            },
                            {
                                "example_id": "bb1492db-9c1a-45ed-9cd3-d745929515aa",
                                "sense_id": "32f79dfa-d8a2-3089-a946-26b2dba148b0",
                                "text": "Ils ont manié révérencieusement ces monnaies rouillées et ces tessons de poterie rouge, aux reliefs stéréotypés, mais exquis, dans laquelle les pauvres du monde gallo-romain mangeaient leurs fèves et leur bouillie d’orge."
                            },
                            {
                                "example_id": "0d0c2259-aaf1-4a12-b689-b5a1268ef23b",
                                "sense_id": "32f79dfa-d8a2-3089-a946-26b2dba148b0",
                                "text": "Si les hommes rient trop haut, il leur ordonne de se calmer et ceux-ci répondent révérencieusement, avant de s’esclaffer de plus belle."
                            }
                        ]
                    }
                ],
