{
    "word_family": [
        "éloigner",
        "loin",
        "lointain"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "86a4a082-e9b9-39ed-80cb-2c4e7939b3de",
                    "sense_definition": "Grande distance spatiale ou temporelle qui sépare des lieux, des personnes ou des époques.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "espace_temps",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'<w>éloignement</w> de son village natal rend les visites à sa famille très rares."
                        },
                        {
                            "text": "Avec l'<w>éloignement</w> des années, les souvenirs d'enfance commencent peu à peu à s'effacer."
                        }
                    ],
                    "synonyms": [
                        "distance",
                        "écart"
                    ],
                    "antonyms": [
                        "proximité"
                    ],
                    "common_phrases": [
                        "éloignement géographique",
                        "souffrir de l'éloignement"
                    ]
                },
                {
                    "sense_id": "7fba4a54-7c73-3bc4-84cd-83d1c7aa8724",
                    "sense_definition": "Fait d'écarter quelqu'un ou de se retirer d'un milieu, d'une fonction ou d'une activité.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Son <w>éloignement</w> volontaire de la scène politique a surpris tous ses partisans."
                        },
                        {
                            "text": "Le directeur a décidé l'<w>éloignement</w> temporaire de cet employé pour apaiser le conflit."
                        }
                    ],
                    "synonyms": [
                        "écartement",
                        "retrait",
                        "éviction"
                    ],
                    "antonyms": [
                        "rapprochement",
                        "intégration"
                    ],
                    "common_phrases": [
                        "éloignement du pouvoir"
                    ]
                },
                {
                    "sense_id": "6aa89735-923d-34ae-853f-4a033d79c631",
                    "sense_definition": "Diminution progressive de l'intimité, de l'affection ou de la complicité entre des individus.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "relation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Leurs divergences d'opinions ont provoqué un <w>éloignement</w> insensible entre les deux amis."
                        },
                        {
                            "text": "Elle a ressenti un profond <w>éloignement</w> envers son entourage après cette dispute."
                        }
                    ],
                    "synonyms": [
                        "détachement",
                        "refroidissement",
                        "brouille"
                    ],
                    "antonyms": [
                        "rapprochement",
                        "complicité",
                        "intimité"
                    ],
                    "common_phrases": [
                        "éloignement affectif"
                    ]
                },
                {
                    "sense_id": "0928a857-b0fb-3119-abd7-01a3233bcc60",
                    "sense_definition": "Sentiment d'aversion, de dégoût ou de répugnance pour une personne ou pour une chose.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "relation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il ressentait un invincible <w>éloignement</w> pour les mondanités et les faux semblants."
                        },
                        {
                            "text": "Malgré leur politesse mutuelle, cet homme éprouvait un net <w>éloignement</w> envers son rival."
                        }
                    ],
                    "synonyms": [
                        "aversion",
                        "répugnance",
                        "dégoût"
                    ],
                    "antonyms": [
                        "attrait",
                        "penchant",
                        "inclination"
                    ],
                    "common_phrases": [
                        "avoir de l'éloignement pour"
                    ]
                }
            ]
        }
    ]
}