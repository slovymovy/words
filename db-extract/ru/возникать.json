                "senses": [
                    {
                        "sense_id": "5680ed34-2449-34e7-9d67-1c25f065bfb5",
                        "entry_id": "bdbd3976-beb8-38b8-aa86-aa31c05cf270",
                        "glosses": [
                            "to arise, to appear, to emerge, to originate, to spring up"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e1a2183-3c07-454a-a5fe-43361ef4141b",
                                "sense_id": "5680ed34-2449-34e7-9d67-1c25f065bfb5",
                                "text": "При реше́нии да́нной зада́чи мо́гут возника́ть не́которые пробле́мы.",
                                "translation": "While solving the given task a few problems can arise.",
                                "english": "While solving the given task a few problems can arise."
                            }
                        ]
                    },
                    {
                        "sense_id": "d7f0a840-70c7-3f94-ae7d-eb62303f4ede",
                        "entry_id": "bdbd3976-beb8-38b8-aa86-aa31c05cf270",
                        "glosses": [
                            "to object, to protest"
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "deca4faa-5e12-41b7-b18d-aa8a4df24737",
                                "sense_id": "d7f0a840-70c7-3f94-ae7d-eb62303f4ede",
                                "text": "Иди́ и не возника́й.",
                                "translation": "(Just) shut up and go.",
                                "english": "(Just) shut up and go."
                            }
                        ]
                    }
