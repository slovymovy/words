                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a432ed52-627d-4d98-9faa-ae8113e04654",
                                "sense_id": "4a61a0f7-be66-3478-a03c-e1e4102a6c72",
                                "text": "We hebben het hele huis overhoop gehaald maar een testament is niet gevonden."
                            }
                        ]
                    },
                    {
                        "sense_id": "c4206f63-8e2a-338d-af78-29fbaae12b66",
                        "entry_id": "d83513d9-f0e7-3ea4-82e7-f3a765019438",
                        "glosses": [
                            "in staat van sterke onderlinge verdeeldheid en/of ruzie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d955edf1-483d-485b-ab08-7ed26777246a",
                                "sense_id": "c4206f63-8e2a-338d-af78-29fbaae12b66",
                                "text": "Die partijen liggen altijd met elkaar overhoop."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "eda8d176-1894-4438-ad5a-8103bc353ad7",
                        "source_entry_id": "d83513d9-f0e7-3ea4-82e7-f3a765019438",
                        "source_sense_id": "4a61a0f7-be66-3478-a03c-e1e4102a6c72",
