                                "example_id": "93af955c-a83c-4606-a780-c951b3224249",
                                "sense_id": "701fe58a-7df3-3df2-89d0-419eda772808",
                                "text": "„Eine Panne im französischen Atomkraftwerk (AKW) Cattenom beunruhigt die deutschen Nachbarn.“"
                            },
                            {
                                "example_id": "f08093d9-5f57-46b8-b7f9-bb62bcb6f49c",
                                "sense_id": "701fe58a-7df3-3df2-89d0-419eda772808",
                                "text": "„Die Kostenexplosion verhinderte aber nicht das nächste AKW.“"
                            },
                            {
                                "example_id": "abcac587-cd83-4f3b-b038-07c5922a2248",
                                "sense_id": "701fe58a-7df3-3df2-89d0-419eda772808",
                                "text": "„Erst als die Regierungskoalition die Panik im Lande sah, ging sie umstandslos daran, die AKWs abzuschalten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
