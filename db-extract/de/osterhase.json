                    }
                ],
                "senses": [
                    {
                        "sense_id": "1f9e0db6-bd2f-3618-9bd2-26eef47000a9",
                        "entry_id": "78a5f96f-e922-3024-abb2-0500ab2942f3",
                        "glosses": [
                            "fiktive, nur zu Ostern heimlich auftretende Figur; verschenkt Präsente und Ostereier an Kinder (meist werden die Eier durch den Osterhasen versteckt)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf7eeaf5-67e4-4162-b0bb-f621afa7dbd3",
                                "sense_id": "1f9e0db6-bd2f-3618-9bd2-26eef47000a9",
                                "text": "Schau mal, was mir der Osterhase dieses Jahr gebracht hat!"
                            },
                            {
                                "example_id": "a06a90d0-7fe9-4c5d-98f9-c0c2c7721a61",
                                "sense_id": "1f9e0db6-bd2f-3618-9bd2-26eef47000a9",
                                "text": "„Komisch, so einen merkwürdigen Ostermorgen hatten sie noch nicht erlebt und der Osterhase war ja wohl etwas durcheinander gewesen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "87adc4c3-c895-44fc-bebc-5142ab47633f",
                        "source_entry_id": "78a5f96f-e922-3024-abb2-0500ab2942f3",
                        "source_sense_id": "1f9e0db6-bd2f-3618-9bd2-26eef47000a9",
                        "target_lang_word": "Easter Bunny",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Easter Bunny",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7ddb1290-fd4f-3334-bd93-5b09ca600c4e",
                                        "entry_id": "31684f92-4174-3cdf-af49-71e88df9c8d0",
                                        "glosses": [
                                            "A symbolic rabbit sometimes depicted delivering Easter eggs to children."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81240c94-0452-4d2a-9f7f-2c19dfe69d6e",
                                                "sense_id": "7ddb1290-fd4f-3334-bd93-5b09ca600c4e",
                                                "text": "An Easter Bunny Party"
                                            },
                                            {
                                                "example_id": "77604c72-6e5c-4f42-bd98-0ab7ee8f52af",
                                                "sense_id": "7ddb1290-fd4f-3334-bd93-5b09ca600c4e",
                                                "text": "One day the old Easter Bunny looked out of his winter covert and Said to his Bunny-wife, who was busy coloring Easter eggs, “It is high time we set out to look for the Easter Lily.”"
                                            },
                                            {
                                                "example_id": "c6ef9ccd-c246-4d88-8cad-d71e33a5c8f1",
                                                "sense_id": "7ddb1290-fd4f-3334-bd93-5b09ca600c4e",
                                                "text": "Soon I ran into two Easter Bunnies who gave me candy. Honest! All right, it was really two women wearing pink bunny hoods."
                                            },
                                            {
                                                "example_id": "264ac314-9a9f-42e6-bec9-24d9c0339a75",
                                                "sense_id": "7ddb1290-fd4f-3334-bd93-5b09ca600c4e",
                                                "text": "Yeah, remember? We’re Spies, we deal in fact, not chasing after Easter Bunnies.\nYeah, right. Wait the Easter Bunny’s missing? A-ha-ha! Just kidding, guys! I know the Easter Bunny is tucked away safe in his little toadstool house up in the fjords of British Columbia."
                                            },
                                            {
                                                "example_id": "43aee540-13f6-40ba-a0bf-1f2407ee71df",
                                                "sense_id": "7ddb1290-fd4f-3334-bd93-5b09ca600c4e",
                                                "text": "Easter Bunnies can be booked for businesses (such as Malls), for churches, for community Easter Egg Hunts or even as a preferred birthday party costume character for a birthday that falls close to Easter."
                                            },
                                            {
                                                "example_id": "8fa08645-3b68-4753-a6e1-461e5f0e8b54",
                                                "sense_id": "7ddb1290-fd4f-3334-bd93-5b09ca600c4e",
                                                "text": "Some residents rotated decorations seasonally by displaying holiday wreaths in the winter and plastic Easter Bunnies and pinwheels in the spring."
                                            },
                                            {
                                                "example_id": "e85efe70-4a44-4b14-ae05-b722d870dd8e",
                                                "sense_id": "7ddb1290-fd4f-3334-bd93-5b09ca600c4e",
                                                "text": "Two costumed Easter Bunnies, handing out plastic, candy-filled eggs and hugging children, hopped in our ranks."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8f082482-b6ea-4dfc-99e9-f68aeb0520d6",
                        "source_entry_id": "78a5f96f-e922-3024-abb2-0500ab2942f3",
                        "source_sense_id": "1f9e0db6-bd2f-3618-9bd2-26eef47000a9",
                        "target_lang_word": "lapin de Pâques",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lapin de Pâques",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "af9047dd-98c9-3662-bdf4-a87c1689d2f1",
                                        "entry_id": "97e1cdd2-7e71-3e73-b4ab-637113038a66",
                                        "glosses": [
                                            "Personnage mythique distribuant des œufs (peints ou en chocolat) pour Pâques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3190b4cd-c8df-46db-a66b-43751ce3849b",
                                                "sense_id": "af9047dd-98c9-3662-bdf4-a87c1689d2f1",
                                                "text": "Nous apportons joie et rêve… Nous sommes le marchand de sable et la Fée des dents. Nous sommes le lapin de Pâques et le père Noël."
                                            },
                                            {
                                                "example_id": "1e852041-b527-4215-ae76-9ebc54ea0ee9",
                                                "sense_id": "af9047dd-98c9-3662-bdf4-a87c1689d2f1",
                                                "text": "Le père Noël n’est pas le premier personnage à être déclaré service essentiel par le gouvernement Legault, la Fée des dents et le Lapin de Pâques bénéficiant également de ce titre."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
