                        "examples": [
                            {
                                "example_id": "1887c98d-33e1-4854-9e04-4a6115770b3c",
                                "sense_id": "543382b9-8980-357c-b31a-f92372faa5a2",
                                "text": "Ich habe den Brief unter dem Dateinamen „Brief_an_Vater.odt“ gespeichert."
                            },
                            {
                                "example_id": "5255e4ec-8751-41b4-b91c-a993324f4bb5",
                                "sense_id": "543382b9-8980-357c-b31a-f92372faa5a2",
                                "text": "Dateinamen enden oft mit drei Buchstaben, die die Art der Datei bezeichnen."
                            },
                            {
                                "example_id": "3f08cdab-97c4-4bc2-9e46-32d8343fe597",
                                "sense_id": "543382b9-8980-357c-b31a-f92372faa5a2",
                                "text": "Du kannst die Datei nicht „Liste.txt“ nennen, denn dieser Dateiname ist in diesem Ordner schon vergeben."
                            }
                        ],
