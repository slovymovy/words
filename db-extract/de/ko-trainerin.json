                                "example_id": "53411b10-e64d-4fd2-84ee-3f246f49a59e",
                                "sense_id": "1a7f1177-82d9-3c2f-9611-4156351079fb",
                                "text": "„Als Ko-Trainerin betreue ich Führungskräfte auf der Basis des Psychodramas.“"
