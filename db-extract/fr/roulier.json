                "forms": [],
                "senses": [
                    {
                        "sense_id": "0847929f-98bc-34c6-8867-fa63af6ca603",
                        "entry_id": "57038965-0369-3797-80d1-8628b619cb1c",
                        "glosses": [
                            "Nom de famille."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7764cbba-2db5-4432-97a5-e7e6c8d65901",
                                "sense_id": "0847929f-98bc-34c6-8867-fa63af6ca603",
                                "text": "Pour Florent Roulier, responsable innovation pour la société de conseil en transformation digitale Niji, les « AI Pin et Rabbit R1 proposent une alternative au smartphone, plutôt qu’un appareil complémentaire, comme une smartwatch »."
                            }
                        ]
                    }
                ],
                "translations": [],
