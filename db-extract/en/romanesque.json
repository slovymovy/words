                                            {
                                                "example_id": "e01f9f7d-6cd4-4b5e-917b-81dcfed08b1c",
                                                "sense_id": "a6da4244-6e4f-3ba9-82f8-65513105886c",
                                                "text": "In Deutschland gibt es viele romanische Kirchen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e1af5db4-96d7-3899-9a44-0fd680b71d9c",
                                        "entry_id": "cb5b5b27-319a-3482-9755-98295ce46218",
                                        "glosses": [
                                            "die Romanen oder die romanischen Sprachen betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43cc1684-b6f6-4e40-b6d1-7bbc038bf83c",
                                                "sense_id": "e1af5db4-96d7-3899-9a44-0fd680b71d9c",
                                                "text": "Französisch ist eine romanische Sprache."
                                            },
                                            {
                                                "example_id": "f9192d51-10d3-44a7-a2af-5b9422b44660",
                                                "sense_id": "e1af5db4-96d7-3899-9a44-0fd680b71d9c",
                                                "text": "„Sie prägen eigene Münzen, übernehmen aber die Gesetze der Franken, den Lebensstil der Einheimischen, deren christliche Religion und romanische Sprache und erschaffen ein effizient verwaltetes Fürstentum, das zur Basis weiterer Eroberungen wird.“"
                                            },
                                            {
                                                "example_id": "51852036-096e-4088-9971-8342bdc3677b",
                                                "sense_id": "e1af5db4-96d7-3899-9a44-0fd680b71d9c",
                                                "text": "„In der Blütezeit des Rittertums dringen zahlreiche Namen aus den romanischen Ländern ein, und die in dieser Zeit überhandnehmende Heiligenverehrung fördert die Ausbreitung der kirchlichen Namen aus dem Neuen Testament in noch nicht dagewesenem Ausmaß.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
