                                "target_senses": [
                                    {
                                        "sense_id": "f55fff18-cc60-3460-b4f3-8e2c57117d82",
                                        "entry_id": "34d1e948-cc91-30fb-94af-8018dc33af04",
                                        "glosses": [
                                            "Angewohnheit, eine Sache einer exklusiven/vorgefassten Kategorie zuzuweisen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a79fdf31-dbfd-4f22-aec3-04ca5d5b4f80",
                                                "sense_id": "f55fff18-cc60-3460-b4f3-8e2c57117d82",
                                                "text": "„Als ob es auf dem Markt nicht schon schwer genug ist, zu überleben, gibt es unter kreativen Berufsgruppen Schubladendenken: Ist ein Designer etwas Besseres als ein Drechsler?“"
                                            },
                                            {
                                                "example_id": "1735149b-5e2e-4d68-b730-80b8c4c1d8e1",
                                                "sense_id": "f55fff18-cc60-3460-b4f3-8e2c57117d82",
                                                "text": "„Tan Wälchli belegt in seinem Aufsatz anhand des amerikanischen Autors Brett Easton Ellis sehr eingängig, wie sich die Kategorien High und Low in der literarischen Postmoderne wechselseitig durchdringen und damit das Schubladendenken ad absurdum führen.“"
                                            }
