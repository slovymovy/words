                            },
                            {
                                "target_lang_word": "identificare",
                                "target_lang_sense_clarification": "riconoscere e definire un problema o un oggetto"
                            },
                            {
                                "target_lang_word": "definire",
                                "target_lang_sense_clarification": "descrivere con precisione"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "89355909-5b18-3b57-bf57-4c132b94b46f",
                    "sense_definition": "In de taalkunde vaststellen tot welke categorie of woordsoort een woord behoort.",
