                        "glosses": [
                            "An American thrush (Catharus fuscescens) common in the Northern United States and Canada."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "03622dbb-9776-4e8b-91b9-493ab4ec871f",
                                "sense_id": "d62392a1-f264-37a8-abae-26d1b9587f06",
                                "text": "In such safe retreats, when the somber shade is brightened here and there with stray beams of sunlight, in the warmth of which myriad insects bathe their wings and flutter away their little span of life, humming a quaint refrain to the gargle of the rivulet, the Veery meets his mate — the song rises — the wooed is won — the home is made."
                            }
                        ]
                    }
