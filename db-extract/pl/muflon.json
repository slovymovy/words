                        "sense_id": "c524c5e8-43fc-389b-aa84-5e43beeccc01",
                        "entry_id": "8e1c89ea-7853-351e-b9c8-b597eda48a98",
                        "glosses": [
                            "Ovis aries musimon Pallas, podgatunek ssaków łożyskowych z rzędu parzystokopytnych"
                        ],
                        "tags": [
                            "syst."
                        ],
                        "examples": [
                            {
                                "example_id": "23294ab8-bba4-4b64-a853-c8c559fc0532",
                                "sense_id": "c524c5e8-43fc-389b-aa84-5e43beeccc01",
                                "text": "Wełna muflona, z wyjątkiem włosów na podgardlu, jest stosunkowo krótka."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "4b2c2fb0-15c0-322b-a4d0-d7cdecb0ede7",
                        "entry_id": "8e1c89ea-7853-351e-b9c8-b597eda48a98",
