                ],
                "senses": [
                    {
                        "sense_id": "cf935757-6ab4-3f82-8d03-13ecdce5da12",
                        "entry_id": "0b36b329-6681-3919-ba58-35ad4f806ce7",
                        "glosses": [
                            "Antikörper, der gegen Infektionen immun macht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3692f0d6-ce18-406a-a473-12a2f52b146d",
                                "sense_id": "cf935757-6ab4-3f82-8d03-13ecdce5da12",
                                "text": "„Die wenigen überlebenden Indianer starben bald darauf an Infektionskrankheiten, welche die Europäer eingeschleppt hatten und gegen die sie keine Abwehrstoffe hatten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "673bfd25-657c-3c56-b9c5-3b7ccf3ce931",
                        "entry_id": "0b36b329-6681-3919-ba58-35ad4f806ce7",
                        "glosses": [
                            "Gift gegen unerwünschte Lebewesen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "60095da0-49d9-4ea6-aedc-d7806f0aad65",
                                "sense_id": "673bfd25-657c-3c56-b9c5-3b7ccf3ce931",
                                "text": "„Neben Vitaminen und Mineralstoffen sind in den Randschichten des Getreides auch unerwünschte Inhaltsstoffe wie Abwehrstoffe gegen Fraßfeinde (etwa Phytin) und Verunreinigungen (etwa Pestizide, Schwermetalle und Schimmelpilzgifte) konzentriert.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f926ff43-442d-4713-9451-c2855fc80207",
                        "source_entry_id": "0b36b329-6681-3919-ba58-35ad4f806ce7",
                        "source_sense_id": "cf935757-6ab4-3f82-8d03-13ecdce5da12",
                        "source_sense_description": "Antikörper, der gegen Infektionen immun macht",
                        "target_lang_word": "anticorps",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anticorps",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "94d732a4-db6b-34d2-97ed-003b4eab765e",
                                        "entry_id": "d51d7858-a717-33dc-8a7b-580523fb5031",
                                        "glosses": [
                                            "Glycoprotéine complexe utilisée par le système immunitaire pour détecter et neutraliser les agents pathogènes comme les bactéries et les virus."
                                        ],
                                        "tags": [
                                            "Biologie moléculaire"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3061595d-cdb0-4628-8da0-49a6f74a2b72",
                                                "sense_id": "94d732a4-db6b-34d2-97ed-003b4eab765e",
                                                "text": "Un anticorps polyclonal est obtenu à partir d’un animal immunisé, habituellement d’une espèce différente de celle de la source de l’antigène."
                                            },
                                            {
                                                "example_id": "9d33bcc3-205e-4ed6-af5f-56549f1b0fb5",
                                                "sense_id": "94d732a4-db6b-34d2-97ed-003b4eab765e",
                                                "text": "Les soignants ont été régulièrement testés pour déterminer s'ils avaient des anticorps et s'ils avaient la Covid-19."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
