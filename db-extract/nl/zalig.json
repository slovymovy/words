                "senses": [
                    {
                        "sense_id": "4d5a270e-ad97-3b12-926e-ce13d96c1d5b",
                        "entry_id": "5fde3a5a-4483-36eb-8654-fc6ca61048f8",
                        "glosses": [
                            "gerechtvaardigd tegenover God, doordat men van zonde bevrijd is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c067be4-931c-4475-b994-febdc9adbc6b",
                                "sense_id": "4d5a270e-ad97-3b12-926e-ce13d96c1d5b",
                                "text": "Christenen verlangen ernaar zalig te worden door het geloof in de Christus."
                            }
                        ]
                    },
                    {
                        "sense_id": "8334dcdf-3abf-3463-a558-e2b36415113f",
                        "entry_id": "5fde3a5a-4483-36eb-8654-fc6ca61048f8",
                        "glosses": [
                            "bijzonder aangenaam, hemels"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0805c7b-198d-430c-b118-89f9cc673bfd",
                                "sense_id": "8334dcdf-3abf-3463-a558-e2b36415113f",
                                "text": "We hebben een zalige vakantie gehad."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4562eb46-cf95-467c-8614-8c9c6e08bd67",
                        "source_entry_id": "5fde3a5a-4483-36eb-8654-fc6ca61048f8",
                        "source_sense_id": "4d5a270e-ad97-3b12-926e-ce13d96c1d5b",
                        "source_sense_description": "gerechtvaardigd tegenover God, doordat men van zonde bevrijd is",
                        "target_lang_word": "selig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "selig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "42f4147a-44f3-3701-87d7-b86f017f8852",
                                        "entry_id": "f09c37eb-fba2-36d6-a7c7-f5807943dd15",
                                        "glosses": [
                                            "himmlischer Wonnen teilhaftig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad6e3b70-beed-4e90-bcec-f96eb3358c54",
                                                "sense_id": "42f4147a-44f3-3701-87d7-b86f017f8852",
                                                "text": "„Selig die Trauernden; denn sie werden getröstet werden.“ (Aus den Seligpreisungen der Bergpredigt)"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0071d79b-9a25-3d47-a346-b6cbfed725ca",
                                        "entry_id": "f09c37eb-fba2-36d6-a7c7-f5807943dd15",
                                        "glosses": [
                                            "aller Widrigkeiten des Lebens enthoben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03d84bb4-c98f-46e8-b1f4-0ac86d1412ae",
                                                "sense_id": "0071d79b-9a25-3d47-a346-b6cbfed725ca",
                                                "text": "„Dr. Adenauer bestieg sein Bett, drehte sich – so der sicherlich authentische Bericht meines Vaters selig – etwas herum, und fragte sodann: ‚Bete mer nicht, lieber Joest?‘“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "cc44f22a-4fe0-3c32-8109-e5fe94856e02",
                                        "entry_id": "f09c37eb-fba2-36d6-a7c7-f5807943dd15",
                                        "glosses": [
                                            "von starkem Hochgefühl erfüllt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39d30557-00c9-46e3-b782-4edfa8f6391c",
                                                "sense_id": "cc44f22a-4fe0-3c32-8109-e5fe94856e02",
                                                "text": "Nach dem gelungenen Fest war sie nur noch selig."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3b2f50fb-779b-4487-ab3a-fbcd718a71f2",
                        "source_entry_id": "5fde3a5a-4483-36eb-8654-fc6ca61048f8",
                        "source_sense_id": "8334dcdf-3abf-3463-a558-e2b36415113f",
                        "source_sense_description": "bijzonder aangenaam, hemels",
                        "target_lang_word": "herrlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "herrlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b0851c57-0437-3151-afe4-a2f105323a94",
                                        "entry_id": "6e55eae5-6adf-3f39-92b1-09a1f7017bda",
                                        "glosses": [
                                            "besonders erfreulich, die Erwartungen übertreffend, wunderschön; so gut, schön oder auf andere Art positiv, dass sich kaum etwas Besseres, Schöneres oder sonst Positiveres vorstellen lässt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e16c00c-423f-4e33-b132-906f534b3418",
                                                "sense_id": "b0851c57-0437-3151-afe4-a2f105323a94",
                                                "text": "Ein herrlicher Sommertag auf einer grünen Wiese ist immer wieder etwas Besonderes."
                                            },
                                            {
                                                "example_id": "d2a43e7e-acaf-431a-80b7-9dd915c1959b",
                                                "sense_id": "b0851c57-0437-3151-afe4-a2f105323a94",
                                                "text": "Wir hörten einen herrlichen Vortrag über die Architektur der vergangenen vier Jahrzehnte."
                                            },
                                            {
                                                "example_id": "405868d1-a42b-458c-8d74-42261f1bf9d0",
                                                "sense_id": "b0851c57-0437-3151-afe4-a2f105323a94",
                                                "text": "„Zu Großem sind wir noch bestimmt, und herrlichen Tagen führe Ich euch noch entgegen.“ (Kaiser Wilhelm II 1892)"
                                            },
                                            {
                                                "example_id": "fb7d5b41-4cf9-48b4-bfe5-d9134f3ff04c",
                                                "sense_id": "b0851c57-0437-3151-afe4-a2f105323a94",
                                                "text": "Der Abend mit Konrad war herrlich."
                                            },
                                            {
                                                "example_id": "a44e0b09-0870-4d5e-b661-a5515207c106",
                                                "sense_id": "b0851c57-0437-3151-afe4-a2f105323a94",
                                                "text": "„Sie kenne kein herrlicheres Bier als das tschechische, lobte sie.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f88ab82b-0174-313a-a410-ab2a5dec06a1",
                                        "entry_id": "6e55eae5-6adf-3f39-92b1-09a1f7017bda",
                                        "glosses": [
                                            "sehr, überaus"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4f549e0-beac-4622-899c-563dcc3c0e8a",
                                                "sense_id": "f88ab82b-0174-313a-a410-ab2a5dec06a1",
                                                "text": "Dieser Hering ist herrlich frisch."
                                            },
                                            {
                                                "example_id": "275d6bda-0f66-4297-a157-6020367456b7",
                                                "sense_id": "f88ab82b-0174-313a-a410-ab2a5dec06a1",
                                                "text": "Hier am Kamin ist es herrlich warm."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
