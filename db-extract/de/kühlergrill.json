                "senses": [
                    {
                        "sense_id": "30d5c517-ab56-388e-a5cf-e8bda54f87d6",
                        "entry_id": "c618d5da-cb85-33bc-ac6b-c60473b91dc7",
                        "glosses": [
                            "Gitter vor dem Kühler eines Kraftfahrzeugs"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "05d95d3f-0ac5-4939-90d0-9a75a5a513b2",
                                "sense_id": "30d5c517-ab56-388e-a5cf-e8bda54f87d6",
                                "text": "Der Kühlergrill soll den Kühler vor Steinen schützen."
                            },
                            {
                                "example_id": "66bd749c-183d-401f-84f0-0282431a2a84",
                                "sense_id": "30d5c517-ab56-388e-a5cf-e8bda54f87d6",
                                "text": "„Joe tarnte den Bus mit Blättern und Zweigen, die er am Kühlergrill befestigte.“"
                            },
                            {
                                "example_id": "c867ab29-a480-4ac6-b3b5-48f036af3c22",
                                "sense_id": "30d5c517-ab56-388e-a5cf-e8bda54f87d6",
                                "text": "„Bald klebten an meiner Windschutzscheibe innen mehr Mücken als tote Insekten vorne an meinem Kühlergrill.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
