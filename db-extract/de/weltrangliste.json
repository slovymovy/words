                "senses": [
                    {
                        "sense_id": "ae855892-dce9-3e09-a9fc-507761571a75",
                        "entry_id": "4ca5f4c6-69d5-3120-96d7-72cfa9b41695",
                        "glosses": [
                            "weltweit gültige Liste, auf der Objekte, Personen, Institutionen danach angeordnet sind, in welchem Ausmaß sie ein bestimmtes Kriterium erfüllen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "73da3328-9ff1-4509-9cd6-cd13cf7d5e12",
                                "sense_id": "ae855892-dce9-3e09-a9fc-507761571a75",
                                "text": "„Österreichs Fußball-Nationalmannschaft hat sich in der neuen FIFA-Weltrangliste weiter verbessert und ist so gut wie noch nie klassiert.“"
                            },
                            {
                                "example_id": "0513d197-6156-407c-a374-2d5504049273",
                                "sense_id": "ae855892-dce9-3e09-a9fc-507761571a75",
                                "text": "„Trotzdem werden Rumänien und Wales in der Weltrangliste der Fifa vor den genannten Schwergewichten geführt: auf Rang acht bzw zehn. Europameister Spanien ist Zwölfter, EM-Finalist Italien 17., Frankreich liegt nur auf dem 22. Rang.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
