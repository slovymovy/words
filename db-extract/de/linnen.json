                "senses": [
                    {
                        "sense_id": "645f1826-3b83-3de2-9f1b-bd72f857aa8a",
                        "entry_id": "1cc17f28-2a4c-3c2c-a0b2-be2d8ff8c377",
                        "glosses": [
                            "Tuch aus Leinen"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "662c6dd5-c71b-4f2b-bacc-d78a6ca2fdb3",
                                "sense_id": "645f1826-3b83-3de2-9f1b-bd72f857aa8a",
                                "text": "„Weißes Linnen kam und Blumen, zuletzt auch Cécile, noch angerötet vom Schlaf, und ehe weitere zehn Minuten um waren, hatte jeder seinen Platz beim Mahl, an dem teilzunehmen der Präzeptor nach einigem Zögern eingewilligt hatte.“"
                            },
                            {
                                "example_id": "aa721f7b-2733-4116-bf05-2a28ddb80482",
                                "sense_id": "645f1826-3b83-3de2-9f1b-bd72f857aa8a",
                                "text": "„Auf dem mit Linnen bedeckten Tisch sah man blitzblanke Teller und Kannen, dazu zwei dreiarmige Leuchter mit brennenden Königskerzen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
