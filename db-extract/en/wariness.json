                        "target_lang_word": "behoedzaamheid",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "behoedzaamheid",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "6eb7ce68-0690-3bec-b103-9461f2b03d05",
                                        "entry_id": "65c1770d-d460-314a-aee4-72fad69b64be",
                                        "glosses": [
                                            "het voorzichtig en zorgvuldig zijn"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6fd4083d-b94a-45f7-a76f-fc8b03d11142",
                                                "sense_id": "6eb7ce68-0690-3bec-b103-9461f2b03d05",
                                                "text": "De Rostovs prezen haar smaak en haar toilet en om elf uur namen ze, met de nodige behoedzaamheid vanwege hun kapsels en toiletten, plaats in de rijtuigen en gingen op weg."
                                            },
                                            {
                                                "example_id": "d50abc13-a89c-4532-b4d8-c7fc53c93426",
                                                "sense_id": "6eb7ce68-0690-3bec-b103-9461f2b03d05",
                                                "text": "De altijd al lastige rolverdeling tussen koning en premier bij publieke optredens in crisissituaties kent nog een actuele complicatie. Mark Rutte leidt een niet homogeen kabinet; de PvdA en de VVD liggen immers ideologisch ver uit elkaar. Dat noopt hem tot behoedzaamheid. Om zich niettemin – electoraal van belang – te manifesteren als leider van het land, is het voor hem verleidelijk zich op nationale momenten te manifesteren."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ac6c2b60-8bfc-463b-94dd-7b0e7b00a901",
