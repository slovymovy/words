                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e344dcb1-db9b-3722-ba67-c79a53821438",
                                        "entry_id": "8372a8e4-2cc1-3f64-b119-5790d6f626df",
                                        "glosses": [
                                            "The presumed cause, force, principle, or divine will that predetermines events."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "94e46b7f-36d2-4129-b5b7-b3df1a633a1e",
                                                "sense_id": "e344dcb1-db9b-3722-ba67-c79a53821438",
                                                "text": "Captain Edward Carlisle[…]felt a curious sensation of helplessness seize upon him as he met her steady gaze,[…]; he could not tell what this prisoner might do. He cursed the fate which had assigned such a duty, cursed especially that fate which forced a gallant soldier to meet so superb a woman as this under handicap so hard."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e4265b4c-76f9-3c40-9e26-4094800acbf6",
                                        "entry_id": "8372a8e4-2cc1-3f64-b119-5790d6f626df",
                                        "glosses": [
                                            "The effect, consequence, outcome, or inevitable events predetermined by this cause."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b9590a52-7ba0-33c8-9dcd-e603ceb3e241",
                                        "entry_id": "8372a8e4-2cc1-3f64-b119-5790d6f626df",
                                        "glosses": [
                                            "An event or a situation which is inevitable in the fullness of time."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "106ff6c6-7ee0-34fb-9a47-1c1757ed8324",
                                        "entry_id": "8372a8e4-2cc1-3f64-b119-5790d6f626df",
                                        "glosses": [
                                            "Destiny; often with a connotation of death, ruin, misfortune, etc."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5f0e6af7-45fd-413c-acda-bc3ac8efbabc",
                                                "sense_id": "106ff6c6-7ee0-34fb-9a47-1c1757ed8324",
                                                "text": "Accept your fate."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1f967aee-60b6-3215-8f4b-a866fc1b15d5",
                                        "entry_id": "8372a8e4-2cc1-3f64-b119-5790d6f626df",
                                        "glosses": [
                                            "Alternative letter-case form of Fate (one of the goddesses said to control the destiny of human beings)."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c3bfaa4a-b592-3d9b-8c7b-70b9388f0e57",
                                        "entry_id": "8372a8e4-2cc1-3f64-b119-5790d6f626df",
                                        "glosses": [
                                            "The products of a chemical reaction in their final form in the biosphere."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e1674230-2e86-4af4-8c86-0a74cdbfc688",
                                                "sense_id": "c3bfaa4a-b592-3d9b-8c7b-70b9388f0e57",
                                                "text": "It’s important to research chemical fate because chemical fate is the best tool we have for understanding and managing human health risks or environmental damage caused by chemical release."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c4065296-a179-3fdd-94a8-9d9aa4cc22c2",
                                        "entry_id": "8372a8e4-2cc1-3f64-b119-5790d6f626df",
                                        "glosses": [
                                            "The mature endpoint of a region, group of cells or individual cell in an embryo, including all changes leading to that mature endpoint"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "fate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8d2f4d1a-467f-34be-b290-954f53de7382",
                                        "entry_id": "65fc298e-84a9-3648-a565-a43b5898368c",
                                        "glosses": [
                                            "To foreordain or predetermine, to make inevitable."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "026ea8a9-15f1-469a-adf2-5a749cf7dbaf",
                                                "sense_id": "8d2f4d1a-467f-34be-b290-954f53de7382",
                                                "text": "The oracle's prediction fated Oedipus to kill his father; not all his striving could change what would occur."
                                            },
                                            {
                                                "example_id": "154c76e5-0052-4c53-8fee-dc9ae6a80ad2",
                                                "sense_id": "8d2f4d1a-467f-34be-b290-954f53de7382",
                                                "text": "At the conclusion of this part, Eric, who plays Jesus and is now a soldier, captures Violet in the forest, fating her to a concentration camp."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "faa53315-acc2-4951-baa4-340103064374",
                        "source_entry_id": "b93b974b-5926-3426-9bbc-eb094db8fba6",
                        "source_sense_id": "c3f65bda-d257-341a-9a94-b0821c9de857",
                        "source_sense_description": "höhere Macht, die die einzelnen Ereignisse, die einem Menschen widerfahren, anordnet",
                        "target_lang_word": "sort",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sort",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "37904bb6-1a34-3219-abee-57686e936406",
                                        "entry_id": "0b873ac0-fa64-3a6e-aa35-f3e92f1fc36f",
                                        "glosses": [
                                            "La destinée considérée comme cause des divers événements de la vie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91ac608f-faf9-4be8-9c52-4ed5b686501b",
                                                "sense_id": "37904bb6-1a34-3219-abee-57686e936406",
                                                "text": "Au contraire de son aîné, il était doté d’un corps malingre qui semblait l’empêcher de s’épanouir. Et comme si la nature s’était acharnée sur son sort, il bégayait chaque fois qu’il devait s’exprimer en public. Il devenait alors ombrageux et taciturne."
                                            },
                                            {
                                                "example_id": "be799e61-0fee-4c90-a423-8c3c9f46b272",
                                                "sense_id": "37904bb6-1a34-3219-abee-57686e936406",
                                                "text": "Le sort en a ainsi ordonné. - Les caprices du sort. - Le sort aveugle. - Le sort jaloux."
                                            },
                                            {
                                                "example_id": "8dbe4933-aee6-4569-a9a6-b2ea9bbebb92",
                                                "sense_id": "37904bb6-1a34-3219-abee-57686e936406",
                                                "text": "Nous serons heureux en dépit du sort. - Braver, affronter, supporter les coups du sort. - Se plaindre du sort. - être poursuivi, accablé par le sort."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "042463fe-193d-362e-a734-ecba9f733ec7",
                                        "entry_id": "0b873ac0-fa64-3a6e-aa35-f3e92f1fc36f",
                                        "glosses": [
                                            "Effet de la destinée ou de la rencontre fortuite des événements bons ou mauvais."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "805661ba-8aa9-41bf-9368-4497fe964e27",
                                                "sense_id": "042463fe-193d-362e-a734-ecba9f733ec7",
                                                "text": "Vous verrez […] que nous serons côte à côte au festin. Quel singulier hasard, en vérité ! Depuis deux heures le sort nous marie…"
                                            },
                                            {
                                                "example_id": "0ae8f446-71c2-4346-ab1f-63c44adf64a3",
                                                "sense_id": "042463fe-193d-362e-a734-ecba9f733ec7",
                                                "text": "Le temps était calme et le navire dériva vers l’Équateur, sans que l’équipage se souciât de son sort."
                                            },
                                            {
                                                "example_id": "fe163ae9-1afd-4a22-8bb8-11e22c6d7636",
                                                "sense_id": "042463fe-193d-362e-a734-ecba9f733ec7",
                                                "text": "Nos vétérans, du Québec et du Canada, ont connu les guerres justes. Mais leur sort, lui, trop souvent, ne l’aura pas été."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4c7b7910-60ae-3d76-9e54-bac6b1074892",
                                        "entry_id": "0b873ac0-fa64-3a6e-aa35-f3e92f1fc36f",
                                        "glosses": [
                                            "Condition ou état d’une personne sous le rapport de la richesse."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "edb515f4-ceef-4310-acf0-f4d53668815a",
                                                "sense_id": "4c7b7910-60ae-3d76-9e54-bac6b1074892",
                                                "text": "Le dogme de la réincarnation […] a malheureusement l’effet pervers de contraindre les déshérités à la résignation, puisque leur lamentable sort présent dépend de mauvaises actions d’une vie antérieure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a6f7ca1a-d228-3a17-bbe0-2478a13ddc0f",
                                        "entry_id": "0b873ac0-fa64-3a6e-aa35-f3e92f1fc36f",
                                        "glosses": [
                                            "Condition des choses, ce qu'il leur advient."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8009b9d9-46d8-4f9a-a2a1-6ee7227b6fa6",
                                                "sense_id": "a6f7ca1a-d228-3a17-bbe0-2478a13ddc0f",
                                                "text": "Tel fut le sort de son livre. - Son discours assura le sort de cette proposition. - Ce système eut le sort de beaucoup d’autres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e807d924-0a1e-3a14-9837-379c692ce0bc",
                                        "entry_id": "0b873ac0-fa64-3a6e-aa35-f3e92f1fc36f",
                                        "glosses": [
                                            "Manière de décider quelque chose par le hasard."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "112d42ac-f111-4d50-9f67-32381c153853",
                                                "sense_id": "e807d924-0a1e-3a14-9837-379c692ce0bc",
                                                "text": "Le sort est tombé sur un tel. - Le sort en a décidé autrement. - Tirer au sort."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c1fd5d9-ba05-3920-b216-3f3a919d1580",
                                        "entry_id": "0b873ac0-fa64-3a6e-aa35-f3e92f1fc36f",
                                        "glosses": [
                                            "Ensemble de paroles, de regards, de caractères, de maléfices par lesquels, suivant une croyance superstitieuse, on peut produire des effets extraordinaires, et presque toujours malfaisants."
                                        ],
                                        "tags": [
                                            "Superstition"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8ea5510b-48b7-4d79-9c07-5d2f32803845",
                                                "sense_id": "1c1fd5d9-ba05-3920-b216-3f3a919d1580",
                                                "text": "Ces pauvres gens disent qu’on a jeté un mauvais sort sur leurs troupeaux. - Il prétend qu’on lui a jeté un sort."
                                            },
                                            {
                                                "example_id": "3445b855-9640-4c6d-9e24-a0646c9f0769",
                                                "sense_id": "1c1fd5d9-ba05-3920-b216-3f3a919d1580",
                                                "text": "Et quand la lignée des Monarques est faillie, & que le droit est dévolu aux états, en ce cas il est beaucoup plus sûr d'y procéder par sort, ayant fait chois des plus dignes, ou de ceux qui font égaux, que d'entrer aux termes d'élection: comme il se fît entre les sept Princes de Perse: pourvu que Dieu y soit appelé, en gardant la forme des anciens Hébreux, qui disaient, Seigneur Dieu donne le sort: à fin que tout charme, & sortilège en soit hors. Ainsi le grand Samuel, quand il fut question de faire un Roy nouveau, fît assembler tout le peuple, & le sort fut tiré des douze lignées: & la lignée de Benjamin étant venue, on tira les familles de Benjamin: & en la famille de Cis le sort tomba sus Saül, que Samuel avait au paravant sacré par le mandement de Dieu, afin qu'on ne pensât point que le Royaume fût dévolu fortuitement."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sort",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5f5ee296-34c7-31a3-97a7-59b51f2691a7",
                                        "entry_id": "729b6815-e750-38ed-9926-c371ed5d5f59",
                                        "glosses": [
                                            "Troisième personne du singulier de l’indicatif présent de sortir."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4f260b2c-3fc6-42c7-b0e2-cbda94249ced",
                                                "sense_id": "5f5ee296-34c7-31a3-97a7-59b51f2691a7",
                                                "text": "L’enfant sort de ce premier œuf mal ou sur-symbiotisé."
                                            },
                                            {
                                                "example_id": "8c8e4476-2bbd-4856-a9af-5a92e8542714",
                                                "sense_id": "5f5ee296-34c7-31a3-97a7-59b51f2691a7",
                                                "text": "Et voici que le vice-président des États-Unis sort de la poche de son veston trois crayons à bille, de pacotille mais portant l’inscription VICE-PRÉSIDENT RICHARD NIXON."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
