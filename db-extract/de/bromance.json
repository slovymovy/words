                        "sense_id": "409eea95-e12e-30e2-9918-18556fed2ceb",
                        "entry_id": "449dcd7b-1ac9-356b-8a1b-13a2ef6d9a35",
                        "glosses": [
                            "innige Beziehung zwischen zwei Männern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b11681e6-6af3-4fde-aeeb-ed34dc178df4",
                                "sense_id": "409eea95-e12e-30e2-9918-18556fed2ceb",
                                "text": "„Bahnt sich etwa gar einen neue Bromance zwischen Trump und Juncker an?“"
                            },
                            {
                                "example_id": "744cd975-478c-44f2-83a7-c4034acb59d2",
                                "sense_id": "409eea95-e12e-30e2-9918-18556fed2ceb",
                                "text": "„Eine echte und seltene Bromance im Motorsport: Jean-Eric Vergne und Andre Lotterer (kurz: #JeAndre) sind sowas wie Best Buddies im Fahrerlager der Formel E.“"
                            },
                            {
                                "example_id": "6c6df187-c813-459c-a138-2e456aa5e07c",
                                "sense_id": "409eea95-e12e-30e2-9918-18556fed2ceb",
                                "text": "„Auch Barack Obama und sein ehemaliger Vizepräsident Joe Biden sind für ihre enge Bromance bekannt.“"
                            },
                            {
                                "example_id": "2aa13478-69c4-49f5-a428-a9599c4e92ce",
                                "sense_id": "409eea95-e12e-30e2-9918-18556fed2ceb",
                                "text": "„Der US-Präsident sieht Angela Merkel als Rivalin, Theresa May als große Enttäuschung und die anfängliche Bromance mit Emmanuel Macron ist auch abgekühlt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
