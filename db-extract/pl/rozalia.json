                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b280105-9938-481f-963e-e206009b4d33",
                                "sense_id": "37ec2baa-6865-3b7f-81a9-1758700271c4",
                                "text": "Mam na imię Rozalia i jestem urzędniczką z Chocza."
