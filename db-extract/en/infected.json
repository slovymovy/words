                                                "sense_id": "e0db953a-c011-3b5a-9ede-85851b03a013",
                                                "text": "Je kunt besmet raken door vlees rauw of onvoldoende verhit te eten."
                                            },
                                            {
                                                "example_id": "2f3183fc-a0de-4358-9565-005d5fed6c12",
                                                "sense_id": "e0db953a-c011-3b5a-9ede-85851b03a013",
                                                "text": "De met H1N1 besmette studenten kregen te horen dat ze beter maar thuis konden blijven, omdat ze anders iedereen zouden aansteken."
                                            },
                                            {
                                                "example_id": "51375aca-38b0-4228-8fc1-6003afc20b45",
                                                "sense_id": "e0db953a-c011-3b5a-9ede-85851b03a013",
                                                "text": "Hij is besmet met hiv."
                                            }
