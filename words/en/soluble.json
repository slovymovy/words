{
    "word_family": [
        "solubility",
        "solubilize",
        "solution",
        "solve",
        "solvent"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f96fa3d0-96f4-3100-8398-573f6a8994f1",
                    "sense_definition": "Able to be dissolved in a liquid.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "dissolvable",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sugar is highly <w>soluble</w> in warm water.",
                            "target_lang_translations": {
                                "zh": "糖在温水中非常<w>可溶</w>。"
                            }
                        },
                        {
                            "text": "Many vitamins are not <w>soluble</w> in water and require fat for absorption.",
                            "target_lang_translations": {
                                "zh": "许多维生素在水中不<w>可溶</w>，需要脂肪才能被吸收。"
                            }
                        }
                    ],
                    "synonyms": [
                        "dissolvable"
                    ],
                    "antonyms": [
                        "insoluble"
                    ],
                    "common_phrases": [
                        "water soluble"
                    ],
                    "target_lang_definitions": {
                        "zh": "指物质能够在液体中溶解的特性。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "可溶的",
                                "target_lang_sense_clarification": "指物质在溶剂中能够溶解的物理性质。"
                            },
                            {
                                "target_lang_word": "易溶的",
                                "target_lang_sense_clarification": "指物质在溶剂中非常容易溶解。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "89615566-a121-3423-834d-20e6f6745996",
                    "sense_definition": "Able to be solved or explained.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "solvable",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The complex math problem is <w>soluble</w> if you use the right formula.",
                            "target_lang_translations": {
                                "zh": "如果你使用正确的公式，这个复杂的数学问题是<w>可解决的</w>。"
                            }
                        },
                        {
                            "text": "Most experts believe the mystery is <w>soluble</w> with enough evidence.",
                            "target_lang_translations": {
                                "zh": "大多数专家认为，只要有足够的证据，这个谜团是<w>可解决的</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "solvable"
                    ],
                    "target_lang_definitions": {
                        "zh": "指问题或谜团能够被解决或解释的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "可解决的",
                                "target_lang_sense_clarification": "指问题或难题可以通过某种方法得到解答。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}