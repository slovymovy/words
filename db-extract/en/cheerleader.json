                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae1b4d1a-3a5b-49aa-a44e-cc3ba7c8ff6a",
                                                "sense_id": "ef62f162-d82c-387b-a637-27e46f104e2f",
                                                "text": "Die Cheerleader traten während der Halbzeitpause auf und erhielten viel Applaus."
                                            },
                                            {
                                                "example_id": "e0c59ca8-e95b-49e9-b3ff-04ba3273e074",
                                                "sense_id": "ef62f162-d82c-387b-a637-27e46f104e2f",
                                                "text": "„Da bewegen sich nämlich an der Außenlinie sympathische junge Leute, die den amtlichen Titel »Cheer-leaders« führen.“"
                                            },
                                            {
                                                "example_id": "306e2945-df14-4ffb-a480-6249d5b5b72d",
                                                "sense_id": "ef62f162-d82c-387b-a637-27e46f104e2f",
                                                "text": "„Vor der Kirche sieht es so aus, als würden Cheerleader das Hochzeitspaar anfeuern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
