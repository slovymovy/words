                "senses": [
                    {
                        "sense_id": "77c41d04-3840-335f-8d4f-4e0064af00f7",
                        "entry_id": "041208a7-bde0-345a-b162-3e32123ef063",
                        "glosses": [
                            "weibliche Person, die (für Medien über Ereignisse) berichtet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "306121c1-c3c0-4e33-a5a6-bc69b513ea11",
                                "sense_id": "77c41d04-3840-335f-8d4f-4e0064af00f7",
                                "text": "Die Berichterstatterin fliegt morgen nach Teheran, um über die dortige Lage zu berichten."
                            },
                            {
                                "example_id": "b7bcf983-50cf-4ca4-ac37-b38aad994252",
                                "sense_id": "77c41d04-3840-335f-8d4f-4e0064af00f7",
                                "text": "Die Berichterstatterin sucht einen Begriff aus dem Bereich der Medizin, um die Emotionen der Tanzenden wiederzugeben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "19a4b753-722a-4034-970c-b9fc45da87f2",
                        "source_entry_id": "041208a7-bde0-345a-b162-3e32123ef063",
                        "source_sense_id": "77c41d04-3840-335f-8d4f-4e0064af00f7",
                        "source_sense_description": "weibliche Person, die (für Medien über Ereignisse) berichtet",
                        "target_lang_word": "correspondent",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "correspondent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5b142d4b-c15b-32c2-af5f-30688a38fd1c",
                                        "entry_id": "f35ec380-14cd-3f15-a83a-52323b309e61",
                                        "glosses": [
                                            "Corresponding; suitable; adapted; congruous."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cadae245-343e-4caf-bc19-16c5d7bdcbcf",
                                                "sense_id": "5b142d4b-c15b-32c2-af5f-30688a38fd1c",
                                                "text": "Action correspondent or repugnant unto the law."
                                            },
                                            {
                                                "example_id": "d8d8b62f-5ff0-4eea-b74c-f7b9ab9e33ff",
                                                "sense_id": "5b142d4b-c15b-32c2-af5f-30688a38fd1c",
                                                "text": "[VV]e are able with playne demonſtration to proue, and vvith reaſon to perſvvade that in tymes paſt our fayth vvas alike, that then vve preached thinges correſpondent vnto the forme of faith already published of vs, ſo that none in this behalfe can repyne or gaynesay vs."
                                            },
                                            {
                                                "example_id": "4e7c0c71-95ca-4270-b280-798334050f64",
                                                "sense_id": "5b142d4b-c15b-32c2-af5f-30688a38fd1c",
                                                "text": "[…]and he exhibited a picture of mental stupor and abstraction, dreadful for Oriana to contemplate! producing in her, as from magnetic attraction, correspondent emotions, which with the utmost difficulty she restrained."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e8e3b87-b625-3f63-a403-d26cb153da1e",
                                        "entry_id": "f35ec380-14cd-3f15-a83a-52323b309e61",
                                        "glosses": [
                                            "Conforming; obedient."
                                        ],
                                        "tags": [
                                            "with to or with"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "84c5c94f-6e34-4aa7-81f4-e6e0eff96469",
                                                "sense_id": "0e8e3b87-b625-3f63-a403-d26cb153da1e",
                                                "text": "ARIEL: Pardon, master: / I will be correspondent to command, / And do my spriting gently."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "correspondent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f08d64b8-a9c5-376a-9757-af43694b6e66",
                                        "entry_id": "1edd02ec-0e3b-3f00-86d5-63b030d1a978",
                                        "glosses": [
                                            "Something which corresponds with something else; counterpart."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d1f6567-f2ff-47f7-aa72-4d78ee692fbd",
                                                "sense_id": "f08d64b8-a9c5-376a-9757-af43694b6e66",
                                                "text": "Both kála and kalánka have widespread correspondents in the western Mediterranean Romance languages."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ab4eb11b-8a2d-3034-a92d-27db314cae0b",
                                        "entry_id": "1edd02ec-0e3b-3f00-86d5-63b030d1a978",
                                        "glosses": [
                                            "Someone who communicates with another person, or a publication, by writing."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "47f223c8-fddd-3cf7-901b-3b4087a61096",
