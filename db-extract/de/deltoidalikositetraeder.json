                        "translation_id": "536a655d-c625-4276-8638-d6907c677b8d",
                        "source_entry_id": "8b098d25-ec57-392d-90e4-9861b032829b",
                        "source_sense_id": "2db68d44-13df-3294-9a32-ea5113b6bd27",
                        "source_sense_description": "Geometrie: Körper („Vielflächner“) mit 24 viereckigen Seitenflächen",
                        "target_lang_word": "deltoidal icositetrahedron",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "deltoidal icositetrahedron",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "690d8255-3d86-31bc-8935-0f0dfc7c35c2",
                                        "entry_id": "979d49d2-8847-3f03-bc4e-43eee732d1c5",
                                        "glosses": [
                                            "A convex polyhedron that has 24 congruent kite-shaped faces and 48 edges and is a Catalan solid, being the dual polyhedron of the rhombicuboctahedron."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3de29180-b444-4489-9a6b-ef2cbc7d61e5",
                                                "sense_id": "690d8255-3d86-31bc-8935-0f0dfc7c35c2",
                                                "text": "These correspond to the foregoing U- and F-vertices of the deltoidal icositetrahedron whose three-edged vertices are \"completely truncated\"; that is to say, the truncating planes pass through the three end points of the edges radiating from the truncated vertex."
                                            },
                                            {
                                                "example_id": "b161f3ba-b425-4f20-a215-39b6adf32c0f",
                                                "sense_id": "690d8255-3d86-31bc-8935-0f0dfc7c35c2",
                                                "text": "The mineral displays a well-developed habit of deltoidal icositetrahedra with dull faces."
                                            },
                                            {
                                                "example_id": "5f720046-c662-4d7f-af5b-0309935f0be4",
                                                "sense_id": "690d8255-3d86-31bc-8935-0f0dfc7c35c2",
                                                "text": "At the Olympus Mons Casino on Mar's they have craps games where the die are rhombic dodecahedron (12 sided), or tetrakis hexahedron (24 sides) or deltoidal icositetrahedron (24 sides). That's for your benefit, Gabby said to me."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
