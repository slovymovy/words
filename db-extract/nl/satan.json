                                    {
                                        "sense_id": "8aa13ef7-64aa-3054-8d15-bfe18e61759f",
                                        "entry_id": "0dea3716-6370-3977-8452-b8088247f6c1",
                                        "glosses": [
                                            "Alternative form of Satan (especially in the sense \\\"a demon follower of Satan; a fallen angel\\\")."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5620d098-967c-4464-b576-3eea6132a5be",
                                                "sense_id": "8aa13ef7-64aa-3054-8d15-bfe18e61759f",
                                                "text": "According to Wahb b. Munnabih, Muhammad b. Ka‘b, and other authorities: Solomon was led to this [test of her intelligence] because the satans feared that he would marry her and make her desirous of having his offspring. She would then disclose to him the secrets of the jinn, and they would never rid themselves of their subservience to Solomon and his offspring to follow."
                                            },
                                            {
                                                "example_id": "3cfada32-0c19-4cb2-9def-2977532cd9f5",
                                                "sense_id": "8aa13ef7-64aa-3054-8d15-bfe18e61759f",
                                                "text": "He tells them to go away, calling them ‘You little satans!’ and then the children′s faces become ghoulish and they begin snapping at him, trying to bite him. A short time later, we see Judas being chased by about a dozen of these children; he falls and they kick and hit him. Twice, we see the figure of Satan (recognizable from the opening scene) standing among the demon-children."
                                            }
                                        ]
                                    }
                                ]
