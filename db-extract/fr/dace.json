                "senses": [
                    {
                        "sense_id": "8a6a05a1-c7bf-3938-9f0e-03ff3619cda8",
                        "entry_id": "466e1e54-c5d5-3c09-80bf-0a07e3fe25b9",
                        "glosses": [
                            "De la Dacie (Europe centrale)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2b29fc0-f421-4043-a101-5c421682142f",
                                "sense_id": "8a6a05a1-c7bf-3938-9f0e-03ff3619cda8",
                                "text": "Plusieurs têtes font penser à l’antique ; de même les ajustements : certains personnages sont habillés comme les rois daces du IIIᵉ siècle."
                            }
                        ]
                    },
                    {
                        "sense_id": "05452147-f2f4-3fe3-80f1-596d28dd2a73",
                        "entry_id": "466e1e54-c5d5-3c09-80bf-0a07e3fe25b9",
                        "glosses": [
                            "Relatif au dace (langue)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ff90c0d-76b3-4d99-94fe-3878ef2f84e5",
                                "sense_id": "05452147-f2f4-3fe3-80f1-596d28dd2a73",
                                "text": "« Pour qui sont ces serpents qui sifflent sur ta tête ? » disait avec l’accent dace à la dame un petit attaché roumain qui passe pour avoir du succès auprès des femmes."
                            }
                        ]
                    }
