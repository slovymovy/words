                        "glosses": [
                            "Qui concerne un proto-continent."
                        ],
                        "tags": [
                            "Extrêmement rare"
                        ],
                        "examples": [
                            {
                                "example_id": "a333b410-12f9-4e5f-9d1a-743d9757e1ef",
                                "sense_id": "d72af01e-e620-38ec-aa42-3addb247f21d",
                                "text": "Dominante climatique (très chaud, chaud, tempéré, froid, très froid) : très froid. Part de la surface terrestre/océanique : 10/90. Nombre de grands continents: 3 îles proto-continentales. Point culminant : Mont de l’Ours, Terre des Baleines, 5.471 m"
                            }
                        ]
