                                            "fruit"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f510bb0d-32d7-4f2a-a33d-1f61960e411f",
                                                "sense_id": "5b30809b-9b05-368d-9c68-6770a3bbcaf4",
                                                "text": "‘Neem een bolletje yoghurt-vlierbes voor de kids van Alpe d’HuZes’. Met deze slogan probeert Van der Poel IJs de nieuwe smaak aan de man te brengen. Een heel speciale smaak, aangezien deze werd ontwikkeld om geld op te halen voor de kinderen die in het team van Unipro Haaksbergen de Alpe d’Huez gaan beklimmen om het KWF te steunen."
                                            },
                                            {
                                                "example_id": "627c4e75-d455-4cb4-8b64-e643db388038",
                                                "sense_id": "5b30809b-9b05-368d-9c68-6770a3bbcaf4",
                                                "text": "Klassieke ingrediënten zoals aardbei of pruimen worden opgepept met sinaasappellikeur, rabarber, kiwi en peperkorrels of vlierbes. Er zijn echter veel meer lekkernijen geschikt om jam van te maken, zoals druiven, mispels, abrikozen en pijnboompitten, ananas of wortels. Ook de tomaten-walnotenjam van Sinie Meerman heeft het gehaald."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f4d00929-1c64-37e4-b015-42e3a547f81c",
                                        "entry_id": "e7dcf328-6db9-3d02-a83a-b4abaf134579",
                                        "glosses": [
                                            "struik waaraan vlierbessen groeien Sambucus nigra"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "954d4e49-f4ef-4df2-b9b5-59ec21e6a3fa",
                                                "sense_id": "f4d00929-1c64-37e4-b015-42e3a547f81c",
                                                "text": "Sanders hondje komt onder de bestofte bladeren van een vlierbes vandaan gescharreld."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
