                                "target_senses": [
                                    {
                                        "sense_id": "3b208f09-b55d-34f7-92ff-18f740d70fe8",
                                        "entry_id": "f7f3ccc9-936d-3807-8a12-aca09f483712",
                                        "glosses": [
                                            "na het moment dat was voorzien"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1b833cf-436d-484d-822e-2de67499bf0b",
                                                "sense_id": "3b208f09-b55d-34f7-92ff-18f740d70fe8",
                                                "text": "Op de kaart stond namelijk dat er over 15 kilometer een meertje (Lake Morena) zou zijn, maar ik liep erg langzaam en het werd al laat."
                                            },
                                            {
                                                "example_id": "39caa569-8673-479c-b01b-3e4309d70178",
                                                "sense_id": "3b208f09-b55d-34f7-92ff-18f740d70fe8",
                                                "text": "Aan de ene kant wilde ik in de late middag zo snel mogelijk de pas over, maar aan de andere kant zou het de volgende ochtend veel veiliger zijn doordat de sneeuw ’s ochtends vroeg nog bevroren zou zijn, waardoor er minder kans op wegglijden was."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "635dfebc-dc62-37c9-99ea-82c36c5db8aa",
                                        "entry_id": "f7f3ccc9-936d-3807-8a12-aca09f483712",
                                        "glosses": [
                                            "met een langzamere ontwikkeling dan wat normaal is"
                                        ],
                                        "tags": [
                                            "van opgroeiende kinderen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9c6550b8-c169-4cd7-88de-0049f83713b9",
                                                "sense_id": "635dfebc-dc62-37c9-99ea-82c36c5db8aa",
                                                "text": "Wanneer is een kind laat met praten?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "laat",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "af363da9-8ed9-339e-bff5-431fee4bfc11",
                                        "entry_id": "85b478d1-0a9c-31dc-bcee-1b8a4be0fb93",
                                        "glosses": [
                                            "op een laat moment"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "44b49fd2-2847-4c33-a67e-fe6e36199dfa",
                                                "sense_id": "af363da9-8ed9-339e-bff5-431fee4bfc11",
                                                "text": "Daar kom je nu wel wat laat mee."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "laat",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "789aa7b2-3c8e-3fe9-ba45-5ff7d7283feb",
                                        "entry_id": "e0715851-257a-37af-976e-c60f0385dc2f",
                                        "glosses": [
                                            "in de middeleeuwen een halfvrije boer [1] die levenslang verplicht was op een bepaalde plaats bepaalde werkzaamheden voor een landheer te verrichten"
                                        ],
                                        "tags": [
                                            "maatschappij"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c753d4b3-697b-4984-8102-8a5ea7bc847d",
                                                "sense_id": "789aa7b2-3c8e-3fe9-ba45-5ff7d7283feb",
                                                "text": "Een laat was oorspronkelijk een cijnsplichtige, behorend bij een bepaald domein."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "laat",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "fe0a0741-bc6f-396d-892a-2d5078e5c3da",
                                        "entry_id": "c14a1fcc-8f24-3cb1-a153-ce794312e24b",
                                        "glosses": [
                                            "enkelvoud tegenwoordige tijd van laten"
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a48f3a6c-2bb8-3805-be00-5ec9d6ac7c1e",
                                        "entry_id": "c14a1fcc-8f24-3cb1-a153-ce794312e24b",
                                        "glosses": [
                                            "gebiedende wijs van laten"
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7ae51a22-bac3-4b8e-bd0d-9641de3f59e9",
                                                "sense_id": "a48f3a6c-2bb8-3805-be00-5ec9d6ac7c1e",
                                                "text": "Heffingen maakten Chinese auto's niet duurder: Afgelopen zomer voerde de EU nog heffingen in om de Europese auto-industrie te beschermen tegen de veel goedkopere auto's uit China. Maar volgens brancheorganisatie Bovag hebben de heffingen niet geleid tot hogere prijzen voor Chinese elektrische auto's. \"De Chinese bedrijven hebben de hogere prijzen kennelijk weten te absorberen. Dat laat ook zien hoe efficiënt zij auto's kunnen produceren\", zegt Geert Brummelhuis van Bovag."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "069193ad-ede1-47c5-b434-225845a244c7",
                        "source_entry_id": "7adfc595-b487-3e36-9cda-483dc177d04d",
                        "source_sense_description": "semifree peasant",
                        "target_lang_word": "lijfeigene",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lijfeigene",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "5aba0ec9-5869-3b7f-9351-26e9d8b4004f",
                                        "entry_id": "4fcc07b6-2e4e-3aaa-ad91-c141442d6655",
                                        "glosses": [
                                            "iemand die met het lijf een meester toebehoort: een onvrije, slaaf of horige"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04b0ac29-40fc-4394-a4b6-122dffeab31f",
                                                "sense_id": "5aba0ec9-5869-3b7f-9351-26e9d8b4004f",
                                                "text": "De vader van Peter Kropotkin was de eigenaar van ongeveer 1200 mannelijke lijfeigenen en ongeveer evenveel vrouwen. De eigenaar van de lijfeigenen was diegene die besloot wie met wie trouwde, waardoor veel gedwongen huwelijken gesloten werden. Ook kwam het vaak voor dat lijfeigenen werden verkocht of vergokt"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b65666b8-6867-4f23-8492-61d883430776",
                        "source_entry_id": "7adfc595-b487-3e36-9cda-483dc177d04d",
                        "source_sense_description": "semifree peasant",
                        "target_lang_word": "serf",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "6ed2c245-9f5d-4b52-baf7-1506ab815540",
                        "source_entry_id": "7adfc595-b487-3e36-9cda-483dc177d04d",
                        "source_sense_description": "semifree peasant",
                        "target_lang_word": "serf",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "serf",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3de29fee-904c-3bbb-b43e-d1c7e92df0ec",
                                        "entry_id": "bcfefaae-c40c-35db-b1cc-ac47999866c6",
                                        "glosses": [
                                            "Homme attachés au domaine qu’ils cultivent moyennant redevance au seigneur qui en est le propriétaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "811f33c8-9f1c-441f-a17c-fdc6f98ed282",
                                                "sense_id": "3de29fee-904c-3bbb-b43e-d1c7e92df0ec",
                                                "text": "Je suis riche, Hedwige, immensément riche, mais à la façon des seigneurs moldaves : riche de terres, de troupeaux, de serfs. Eh bien ! j’ai vendu au monastère de Hango pour un million de terres, de troupeaux, de villages."
                                            },
                                            {
                                                "example_id": "b0dceed4-e377-467f-b193-328f04e09f85",
                                                "sense_id": "3de29fee-904c-3bbb-b43e-d1c7e92df0ec",
                                                "text": "[…], et la plupart d’entre eux, au XIIᵉ siècle surtout, sont encore des serfs : dans la commune de Senlis, fondée par le roi en 1173, l’évêque a encore des mainmortables ; […]."
                                            },
                                            {
                                                "example_id": "94e5ec89-9b27-4fca-9ab8-8c096b25e421",
                                                "sense_id": "3de29fee-904c-3bbb-b43e-d1c7e92df0ec",
                                                "text": "Selon la coutume qui avait encore force de loi en Franche-Comté (et cela, disait Voltaire, est contradictoire avec le nom de cette province), il y avait des serfs, c'est-à-dire des gens de mainmorte, dont la condition était de ne pouvoir disposer de leurs biens et de leur personne."
                                            },
                                            {
                                                "example_id": "e225b977-be94-406f-a7f9-ba86aec66ce7",
                                                "sense_id": "3de29fee-904c-3bbb-b43e-d1c7e92df0ec",
                                                "text": "Il était difficile aux juifs d’échapper à leur sort, car, étant serfs de leurs seigneurs, ils n’avaient pas le droit de se déplacer comme ils l’auraient voulu."
                                            },
                                            {
                                                "example_id": "fb4eea63-ed55-4d21-b838-cc13806fc06d",
                                                "sense_id": "3de29fee-904c-3bbb-b43e-d1c7e92df0ec",
                                                "text": "Les serfs travaillaient sans rémunération sur des terres appartenant à de grands propriétaires terriens."
                                            },
                                            {
                                                "example_id": "d32375b0-2256-4fc6-8b52-0d04eb4bc429",
                                                "sense_id": "3de29fee-904c-3bbb-b43e-d1c7e92df0ec",
                                                "text": "Mais elles vont bientôt se courber et s’asseoir,\nServes du champ pénible et des vives aiguilles ;\nLes vierges ne sont pas, dans les pauvres familles,\nDes colombes qu’un grain nourrit de l’aube au soir."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "serf",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6234f82d-75bc-307e-8643-50021439590b",
                                        "entry_id": "42f5d8e9-d82a-3891-82b6-e96a89ed2111",
                                        "glosses": [
                                            "Relatif au servage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d49d069-147b-46c1-9b5e-9b2371859ce8",
                                                "sense_id": "6234f82d-75bc-307e-8643-50021439590b",
                                                "text": "Dans ce monde de pasteurs, la femme n’a nullement la vie serve qu’elle mène dans celui de chasse et de guerre."
                                            },
                                            {
                                                "example_id": "01bf1a8e-9fdd-4e82-a0f7-a81e13a48ac2",
                                                "sense_id": "6234f82d-75bc-307e-8643-50021439590b",
                                                "text": "Ces braves gens devaient être merveilleusement incorporés à la glèbe, et notre ancienne noblesse n’éprouvait assurément que liesse et contentement à tailler et mortailler une nature aussi débonnairement serve."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "72a40818-1b25-4181-834d-43fd8fd8adcd",
                        "source_entry_id": "7adfc595-b487-3e36-9cda-483dc177d04d",
