                                    {
                                        "sense_id": "e3f9308e-ca65-3c3c-9f94-f9a77436f366",
                                        "entry_id": "17137e83-9afd-3ab2-9dd9-94569873dcdc",
                                        "glosses": [
                                            "der gemeine Mann des alten Roms, jemand, der zu der Plebs gehörte"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6e66fc5-fd6a-4427-bf66-4a3453555ca0",
                                                "sense_id": "e3f9308e-ca65-3c3c-9f94-f9a77436f366",
                                                "text": "Die Plebejer sammelten sich am Rande des Marktplatzes."
                                            },
                                            {
                                                "example_id": "78eb0155-1402-4a1a-9dfc-0c75a5d094b6",
                                                "sense_id": "e3f9308e-ca65-3c3c-9f94-f9a77436f366",
                                                "text": "Zwischen Patriziern und Plebejern bestand ein Eheverbot."
                                            },
                                            {
                                                "example_id": "af41e1cb-0eea-427a-ba94-b188075a35ac",
                                                "sense_id": "e3f9308e-ca65-3c3c-9f94-f9a77436f366",
                                                "text": "„Im Verlauf des 5. Jahrhunderts v.Chr. zwangen die Plebejer dem patrizischen Adel die Kodifikation des geltenden Gewohnheitsrechts (XII-Tafel-Gesetz) sowie die zivilrechtliche Gleichstellung […] ab.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8c861457-064c-3f1e-9302-3db5cc65cd41",
                                        "entry_id": "17137e83-9afd-3ab2-9dd9-94569873dcdc",
                                        "glosses": [
                                            "einer aus dem gemeinen Volke, ein ungehobelter oder ungebildeter Mensch"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3b9509e-2926-46c7-87d1-017f647e2438",
                                                "sense_id": "8c861457-064c-3f1e-9302-3db5cc65cd41",
                                                "text": "Vergiss diese Plebejer, im Grunde sollte man ihnen den Zutritt zur Ausstellung verwehren."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
