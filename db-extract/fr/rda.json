                            {
                                "target_word": "GDR",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7ecd8535-9586-37e9-9219-6886adcdbdef",
                                        "entry_id": "a10fd965-608c-3b21-8409-b17c172225d1",
                                        "glosses": [
                                            "Initialism of German Democratic Republic (“East Germany”)."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "historical",
                                            "initialism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b658758f-87e3-4386-8b0f-3a917298bcab",
                                                "sense_id": "7ecd8535-9586-37e9-9219-6886adcdbdef",
                                                "text": "Developments were markedly different in the Soviet zone, but ultimately ended in perhaps an even grimmer dead end: that of SED leader Walter Ulbricht’s thoroughly Stalinized German Democratic Republic (GDR). […] Subsequently, the GDR’s antifascist tradition would be diluted, distorted, and refashioned into an ahistorical national origins myth in which the citizens of East Germany were officially proclaimed the “victors of history,” but where little space remained for the real and complicated history, not to mention ambivalent role of Stalinized Communism, behind it."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c3eab198-4368-4e5a-b803-3d7423f29c36",
