                "senses": [
                    {
                        "sense_id": "0920a63f-b9ec-32dc-8ebc-4c1abc3436d4",
                        "entry_id": "12e8114e-77ab-3663-822b-786acbe2dd61",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e49da90e-7b53-45f1-9ef0-a16f0d553b0f",
                                "sense_id": "0920a63f-b9ec-32dc-8ebc-4c1abc3436d4",
                                "text": "Frau Engmann ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "0c042df7-4feb-4779-b448-3304f424203e",
                                "sense_id": "0920a63f-b9ec-32dc-8ebc-4c1abc3436d4",
                                "text": "Herr Engmann wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "da5ce47e-fdd4-4be3-b614-841b7b904ee8",
                                "sense_id": "0920a63f-b9ec-32dc-8ebc-4c1abc3436d4",
                                "text": "Die Engmanns kommen heute aus dem Rheinland."
                            },
                            {
                                "example_id": "b017c34b-9722-4039-99fb-26eaece317cc",
                                "sense_id": "0920a63f-b9ec-32dc-8ebc-4c1abc3436d4",
                                "text": "Der Engmann trägt nie die Schals, die die Engmann ihm strickt."
                            },
                            {
                                "example_id": "cd093a04-bc0b-4d6b-a32f-906b1ff8c085",
                                "sense_id": "0920a63f-b9ec-32dc-8ebc-4c1abc3436d4",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Engmann kommt, geht der Herr Engmann.“"
                            },
                            {
                                "example_id": "2a2ebd23-1305-444a-8661-eaf0c0db32e4",
                                "sense_id": "0920a63f-b9ec-32dc-8ebc-4c1abc3436d4",
                                "text": "Engmann kommt und geht."
                            },
                            {
                                "example_id": "c32dfe11-186a-4179-93a3-1c07fc04efa1",
                                "sense_id": "0920a63f-b9ec-32dc-8ebc-4c1abc3436d4",
                                "text": "Engmanns kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
