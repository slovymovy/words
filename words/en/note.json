        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d0aeb239-7cb3-3388-8998-a60f20628966",
                    "sense_definition": "To pay attention to something or to notice it carefully.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "attention",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please <w>note</w> that the library will be closed tomorrow.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, <w>обратите внимание</w>, что библиотека завтра будет закрыта.",
                                "zh": "请<w>注意</w>，图书馆明天闭馆。"
                            }
                        },
                        {
                            "text": "She <w>noted</w> a slight change in the color of the solution.",
                            "target_lang_translations": {
                                "ru": "Она <w>заметила</w> небольшое изменение в цвете раствора.",
                                "zh": "她<w>察觉</w>到溶液颜色有细微的变化。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "please note",
                        "duly noted"
                    ],
                    "target_lang_definitions": {
