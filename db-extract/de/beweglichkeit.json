                                            {
                                                "example_id": "92d27da5-bb16-4383-8830-11536f5cd838",
                                                "sense_id": "2f34e3a4-7a1f-3f7c-9c15-ee3be700d33b",
                                                "text": "His superior agility countered his lack of strength."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "92f063a9-ef90-3808-99d2-09d43144f6cf",
                                        "entry_id": "ff908188-9b23-3235-904f-428b5cd25a59",
