                "senses": [
                    {
                        "sense_id": "6517b193-a54f-35a4-b8e1-c1e072a3f88d",
                        "entry_id": "99c73ce7-4f73-3c39-850c-534fa6416d6d",
                        "glosses": [
                            "Qui a été profondément modifié dans sa structure (par la pression ou la température), en parlant d’une roche, d’un terrain."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b3a37a7-755f-4cd2-be2f-68db3ca74e20",
                                "sense_id": "6517b193-a54f-35a4-b8e1-c1e072a3f88d",
                                "text": "Dans notre dition, les grès werféniens reposent directement et sans métamorphisme soit sur les roches éruptives et métamorphiques du Culm (Ecromagny), soit, de Lantenot au Rocheret, sur les terrains permiens […]"
                            },
                            {
                                "example_id": "b23fe569-226c-4cad-b7d6-98f82f4be44e",
                                "sense_id": "6517b193-a54f-35a4-b8e1-c1e072a3f88d",
                                "text": "Ce n’est bien sûr pas le cas, puisque la surface de la Terre est dynamique : ces roches – comme la plupart de celles de l’Archéen – ont subi des transformations métamorphiques."
                            }
                        ]
                    }
                ],
