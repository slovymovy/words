                    "frequency": "Middle",
                    "semantic_group_id": "arbre",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans cette région nordique, les <w>bouleaux</w> forment de magnifiques forêts argentées."
                        },
                        {
                            "text": "Au printemps, il est courant de récolter la sève de <w>bouleau</w> pour ses vertus fortifiantes."
                        }
                    ],
                    "common_phrases": [
