                ],
                "senses": [
                    {
                        "sense_id": "fd465b97-b24d-3324-8ee1-8eb431374827",
                        "entry_id": "bf6dfe3a-b9fe-3ddc-881b-f2141c25a99e",
                        "glosses": [
                            "Methode mit der etwas gefangen wird, meistens in Bezug auf Meerestiere"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ed5f92a-5838-40e1-8969-1790662ca4e3",
                                "sense_id": "fd465b97-b24d-3324-8ee1-8eb431374827",
                                "text": "„Der Alaska-Seelachs werde teilweise immer noch mit schlechten Fangmethoden gefischt, erklärt Greenpeace-Fischfachfrau Iris Menn auf Nachfrage.“"
                            },
                            {
                                "example_id": "c107d0fc-36ba-4c22-8154-ee30c7b1d4b5",
                                "sense_id": "fd465b97-b24d-3324-8ee1-8eb431374827",
                                "text": "„Seepferdchen erscheinen stets ruhig und anmutig, grazil dümpeln sie in Seegraswiesen. Nichts vermag ihre erhabene Gelassenheit zu stören. Doch das alles ist nur ein Trick! Die bunten Fische sind erfolgreiche Jäger, ihre Fangmethoden hoch spezialisiert.“"
                            },
                            {
                                "example_id": "5392088f-77f1-459c-a50f-ed89f37e51b7",
                                "sense_id": "fd465b97-b24d-3324-8ee1-8eb431374827",
                                "text": "„Neue Abkommen sollen faire Arbeitsplätze und nachhaltige Fangmethoden garantieren.“"
                            },
                            {
                                "example_id": "d23cf8c3-a9e0-4907-870d-bec2d5bc2cbc",
                                "sense_id": "fd465b97-b24d-3324-8ee1-8eb431374827",
                                "text": "„Die Greenpeace-Experten kennzeichnen einen Fisch schon als »nicht empfehlenswert«, wenn bei seinem Fang nur eines von elf Negativkriterien (hoher Beifang, destruktive Fangmethoden, Fang in empfindlichen Tiefseeregionen…) zutrifft.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
