                        "source_sense_id": "b29c051a-e880-39e9-985e-cfa5539e345c",
                        "target_lang_word": "exoneration",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "exoneration",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3c5702a9-8d34-381e-80f6-3f56d69b62ca",
                                        "entry_id": "8f818281-ea9e-3f73-ae2f-0330aee6c142",
                                        "glosses": [
                                            "An act of disburdening, discharging, or freeing morally from a charge or imputation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd2def75-c1a3-42de-b42c-581521bee252",
                                                "sense_id": "3c5702a9-8d34-381e-80f6-3f56d69b62ca",
                                                "text": "Alpaca. (Camelus Pacos,) also Paco. […] This animal, like the camel, is domable, and will carry from seven to nine stone; it will fall on its knees for the convenient reception and exoneration of its burthen."
                                            },
                                            {
                                                "example_id": "94e6ed91-4334-4d35-be0b-5da89e9f194a",
                                                "sense_id": "3c5702a9-8d34-381e-80f6-3f56d69b62ca",
                                                "text": "Mr. Spitzer’s proposal also calls for the creation of a state office that would be responsible for studying all cases that resulted in exonerations and looking for flaws in the system that led to those wrongful convictions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eb632aaa-f7ea-3bf5-82f8-5db2d80211e7",
                                        "entry_id": "8f818281-ea9e-3f73-ae2f-0330aee6c142",
                                        "glosses": [
                                            "The state of being disburdened or freed from a charge."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "943a92bf-a8c2-4ec7-a554-242fd5271fbf",
                        "source_entry_id": "e44540ae-e635-3f53-aeb6-9e0a4433ddeb",
                        "source_sense_id": "fdc23c3e-c9a2-303f-af07-4e5743c7b6c7",
                        "target_lang_word": "Entlastung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Entlastung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "834250ff-96ce-307f-84ce-6a6506518aa3",
                                        "entry_id": "8a7fc1a2-5cdf-33ea-9a6b-e43806e0c3d9",
                                        "glosses": [
                                            "Befreiung/Freiheit von einem anstrengenden, bedrückenden oder unerwünschten Zustand"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de13fdd5-ba45-443a-9df7-bdd6a8347419",
                                                "sense_id": "834250ff-96ce-307f-84ce-6a6506518aa3",
                                                "text": "Die geplante Umgehungsstraße soll dem innerstädtischen Verkehr eine deutliche Entlastung bringen."
                                            },
                                            {
                                                "example_id": "bc5852ef-548e-4dd7-b855-a0137062d570",
                                                "sense_id": "834250ff-96ce-307f-84ce-6a6506518aa3",
                                                "text": "Alle zu meiner Entlastung vorgebrachten Argumente halfen mir dann letztlich auch nicht."
                                            },
                                            {
                                                "example_id": "e66bb554-952c-4868-a7f1-d20df85f5a87",
                                                "sense_id": "834250ff-96ce-307f-84ce-6a6506518aa3",
                                                "text": "„Die Gestapotaktik des Staatsanwaltes war der Grund dafür, dass ich nicht einen einzigen Zeugen zu meiner Entlastung hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b6178064-49d0-3054-b94a-f9e3fdcd0592",
                                        "entry_id": "8a7fc1a2-5cdf-33ea-9a6b-e43806e0c3d9",
                                        "glosses": [
                                            "ausdrückliche Annahme der Führung der Geschäfte einer Gesellschaft für einen bestimmten, zurückliegenden Zeitraum"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27eb4477-da7d-4575-91e0-9d25c644c8c7",
                                                "sense_id": "b6178064-49d0-3054-b94a-f9e3fdcd0592",
                                                "text": "Die Mitgliederversammlung erteilte dem Vorstand Entlastung."
                                            },
                                            {
                                                "example_id": "4af87ccb-d355-4a1f-8e49-953dd934e801",
                                                "sense_id": "b6178064-49d0-3054-b94a-f9e3fdcd0592",
                                                "text": "Ein Punkt auf der Tagesordnung ist die Entlastung des Vorstandes für das Geschäftsjahr 2018."
                                            },
                                            {
                                                "example_id": "f4cc1e29-c402-472e-ac69-a13df9848cd1",
                                                "sense_id": "b6178064-49d0-3054-b94a-f9e3fdcd0592",
                                                "text": "„Diese im Mordprozess vorgebrachte Verlautbarung war zur Entlastung des Angeklagten O. J. Simpson gedacht – und wird zu einer belastenden Information, wenn man genauer darüber nachdenkt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
