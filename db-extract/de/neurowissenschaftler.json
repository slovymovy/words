                                "example_id": "d7a29c47-21d7-4a64-96e8-7964b98d5e49",
                                "sense_id": "080414d1-772b-3378-b35c-ebc404e080a7",
                                "text": "„Irgendwann suchte er im Netz nach der E-Mail-Adresse von Wolf Singer, einem renommierten Neurowissenschaftler, von dem er einige Bücher gelesen hatte.“"
                            },
                            {
                                "example_id": "24f5e0b8-52f2-48b2-8a0f-bff7219f6835",
                                "sense_id": "080414d1-772b-3378-b35c-ebc404e080a7",
                                "text": "„Deswegen sind es inzwischen nicht mehr Philosophen, sondern Neurowissenschaftler, Biochemiker und Hirnforscher, die fundierte Aussagen über die Willensfreiheit des Menschen machen.“"
                            }
