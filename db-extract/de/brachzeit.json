                ],
                "senses": [
                    {
                        "sense_id": "d77a5ae2-745c-3752-b1b0-e22a3cee1f4f",
                        "entry_id": "996c0332-730c-3746-b55e-e8d0a0994b44",
                        "glosses": [
                            "Zeitabschnitt, in dem etwas (zum Beispiel ein Feld) ungenutzt/leer ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c06f6dd1-559a-452b-9717-be83342024db",
                                "sense_id": "d77a5ae2-745c-3752-b1b0-e22a3cee1f4f",
                                "text": "„Nach anfänglicher Skepsis gegenüber einem Wiederanbau von Tabak auf demselben Boden, wurden in den 1880er Jahren Versuche mit 8-jähriger Brachzeit gemacht.“"
                            },
                            {
                                "example_id": "115a365f-062e-4938-ab36-f92679bb0cb6",
                                "sense_id": "d77a5ae2-745c-3752-b1b0-e22a3cee1f4f",
                                "text": "„Bei Mehrstellenarbeit mit unregelmäßigem Arbeitsablauf, wie er für die Textilindustrie typisch ist, kann jedoch der Fall eintreten, daß durch diese Untätigkeitszeit des Arbeiters eine Brachzeit und eine Liegezeit entsteht.“"
                            },
                            {
                                "example_id": "d7de7aa9-4b66-4662-a1ff-e13b6d3f555b",
                                "sense_id": "d77a5ae2-745c-3752-b1b0-e22a3cee1f4f",
                                "text": "„Eine Brachzeit ergibt sich durch ablauf- und störungsbedingte Nutzungsunterbrechung eines Betriebsmittels sowie durch Zeiten planmäßiger Außerbetriebnahmen.“"
                            },
                            {
                                "example_id": "6f589b09-fcf2-4977-8f26-9cc0fcd2f963",
                                "sense_id": "d77a5ae2-745c-3752-b1b0-e22a3cee1f4f",
                                "text": "„Der Betrieb muß bestrebt sein, die Brachzeiten zugunsten der Nutzungszeiten immer mehr zu verringern.“"
                            },
                            {
                                "example_id": "62591106-1c5b-42df-b20a-9c2efbea47a4",
                                "sense_id": "d77a5ae2-745c-3752-b1b0-e22a3cee1f4f",
                                "text": "„Deswegen haben die Bauern von Prethey die Weide hier verboten, um zur Brachzeit gleich eine gute Weide für das Vieh zum Ausspannen bei der Hand zu haben.“"
                            },
                            {
                                "example_id": "efd3b3a7-70c7-47c3-bf5e-5772a4736c90",
                                "sense_id": "d77a5ae2-745c-3752-b1b0-e22a3cee1f4f",
                                "text": "„Schon zur Pharaonenzeit teilten die Ägypter das Jahr in drei Jahreszeiten ein: die Überschwemmungszeit von August bis Oktober, die Anbauzeit von November bis März und die Brachzeit von April bis Juli.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
