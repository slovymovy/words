                "forms": [],
                "senses": [
                    {
                        "sense_id": "f3218600-dd1f-3ca7-80d1-aadcb3fd1551",
                        "entry_id": "62a33937-f980-31b6-b40b-1dcc7a318b65",
                        "glosses": [
                            "Nom de famille français."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c3123ea-c309-4785-bb95-aaffd72f6aa2",
                                "sense_id": "f3218600-dd1f-3ca7-80d1-aadcb3fd1551",
                                "text": "Mme Dessenne est en congé pour un mois. Mme Cocatrix la remplace."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "aa93f625-2e83-391b-8ed0-8a8b5e8aa29b",
                "word": "cocatrix",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "367bbbb4-b583-3b9c-bd11-fb97b2aebdb8",
                        "entry_id": "aa93f625-2e83-391b-8ed0-8a8b5e8aa29b",
                        "glosses": [
                            "Créature imaginaire, qui possède une tête de coq, des ailes de chauve-souris et un corps de serpent. Antoine Furetière dit que c’est une espèce de basilic qui s’engendre dans les cavernes et les puits."
                        ],
                        "tags": [
                            "Fantastique"
                        ],
                        "examples": [
                            {
                                "example_id": "a144c39b-d941-49a3-b043-c1c9674d36c2",
                                "sense_id": "367bbbb4-b583-3b9c-bd11-fb97b2aebdb8",
                                "text": "La cocatrix, que personne n’a jamais vue, est « née par accident à la fin du XIIᵉ et est morte au milieu du XVIIᵉ siècle, victime de la science ». Dans les œuvres modernes et en particulier le jeu de rôle, cocatrix et basilic sont dissociés, le basilic étant vu comme un reptile terrestre, la cocatrix plutôt comme un oiseau avec des ailes et une queue de dragon."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8aa74bc6-4563-48f2-92f6-c7b24680bcfb",
                        "source_entry_id": "aa93f625-2e83-391b-8ed0-8a8b5e8aa29b",
                        "source_sense_id": "367bbbb4-b583-3b9c-bd11-fb97b2aebdb8",
                        "target_lang_word": "cockatrice",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cockatrice",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "11851578-9f9f-36b9-ae91-7629934605a6",
                                        "entry_id": "3ccf37ab-8a40-3d33-9242-cba1c3206196",
                                        "glosses": [
                                            "A legendary creature about the size and shape of a dragon or wyvern, but in appearance resembling a giant rooster, with some lizard-like characteristics."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f46dfd5-8697-4121-98fe-7676d7f85cdd",
                                                "sense_id": "11851578-9f9f-36b9-ae91-7629934605a6",
                                                "text": "“Peace reigns in happy Luxor. The lion lies down with the lamb, and the child, if it will, may harmlessly put its hand into the cockatrice’s den.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c0d29d4c-5493-3875-bf2f-86e1235e3093",
                                        "entry_id": "3ccf37ab-8a40-3d33-9242-cba1c3206196",
                                        "glosses": [
                                            "A mistress, a harlot."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9a3fa012-369e-3bc4-b6d3-e86bda784c7e",
                                        "entry_id": "3ccf37ab-8a40-3d33-9242-cba1c3206196",
                                        "glosses": [
                                            "A snake or serpent that appears to be hatched from a rooster, or cock's, egg."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "41435df4-6db6-40ed-9a93-ed0bba7f959c",
                                                "sense_id": "9a3fa012-369e-3bc4-b6d3-e86bda784c7e",
                                                "text": "For, behold, I will send serpents, cockatrices, among you, which will not be charmed, and they shall bite you, saith the Lord."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3e4d7b34-da0d-3e08-9297-6028dd4b3553",
                                        "entry_id": "3ccf37ab-8a40-3d33-9242-cba1c3206196",
                                        "glosses": [
                                            "The cobra."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a76c2ed9-33c9-3684-a275-120547dfae82",
                                        "entry_id": "3ccf37ab-8a40-3d33-9242-cba1c3206196",
                                        "glosses": [
                                            "Any venomous or deadly thing."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7a2bda5e-f1be-44d4-abb1-2732dcef78ab",
                                                "sense_id": "a76c2ed9-33c9-3684-a275-120547dfae82",
                                                "text": "this little cockatrice of a king"
                                            }
                                        ]
                                    }
                                ]
                            }
