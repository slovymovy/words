                "senses": [
                    {
                        "sense_id": "a0a80100-edd4-3fa3-a098-ce80de3c9156",
                        "entry_id": "6142e7ff-4c9d-3feb-8088-b64ea6f8e5fa",
                        "glosses": [
                            "Visum, das für die Einreise in ein Land erforderlich ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f9f848d8-1dd7-4865-972d-35d92747c36b",
                                "sense_id": "a0a80100-edd4-3fa3-a098-ce80de3c9156",
                                "text": "Für die Einreise in unser Land benötigt man ein Einreisevisum."
                            },
                            {
                                "example_id": "b9bd1634-1968-46db-9fa7-5e8c9aaba413",
                                "sense_id": "a0a80100-edd4-3fa3-a098-ce80de3c9156",
                                "text": "„Bereits dreimal hat man ihm das Einreisevisum verweigert.“"
                            },
                            {
                                "example_id": "3de8b8a9-c4e6-4aa3-b9aa-f73cf2c0a8e6",
                                "sense_id": "a0a80100-edd4-3fa3-a098-ce80de3c9156",
                                "text": "„Indem er ihre Einreisevisa vordatierte oder andere Dokumente fälschen ließ, ermöglichte Grüninger – mit Wissen seines Vorgesetzten – mehreren hundert bis wenigen tausend Juden die Flucht in die Schweiz.“"
                            },
                            {
                                "example_id": "e8524a72-07ea-4235-9cac-53e6c7efceff",
                                "sense_id": "a0a80100-edd4-3fa3-a098-ce80de3c9156",
                                "text": "„Ich beschloß, sie mit Zähnen und Klauen zu verteidigen, bis ich meinen Paß mit dem Einreisevisum wieder hatte.“"
                            },
                            {
                                "example_id": "41a56319-47d0-4ed3-859d-d197122f8933",
                                "sense_id": "a0a80100-edd4-3fa3-a098-ce80de3c9156",
                                "text": "„Kein Grenzland Frankreichs gab zu dieser Zeit Einreisevisen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
