                        "glosses": [
                            "Organisation, die die Interessen der Polizisten vertritt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f90a7ba7-2349-489b-a487-7435b9714577",
                                "sense_id": "26326302-446c-3407-b2db-04462d1960fe",
                                "text": "„Der Polizeigewerkschaft dürfte es in den Verhandlungen nicht geschadet haben, dass die Beamten in den letzten Wochen viele Schichten schieben mussten: Erst die Großdemonstration kurz vor Weihnachten, dann das mittlerweile aufgehobene Gefahrengebiet in Hamburgs Innenstadt.“"
                            },
                            {
                                "example_id": "e4c341f9-5791-43e0-80a8-3640cc137ca9",
                                "sense_id": "26326302-446c-3407-b2db-04462d1960fe",
                                "text": "„Selbst vermehrte Aufrufe, etwa vonseiten der Polizeigewerkschaften, nach mehr Schutz konnten bislang daran nichts ändern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
