                ],
                "senses": [
                    {
                        "sense_id": "5b59c04e-9c3f-3ac8-b62a-52ad61f28741",
                        "entry_id": "35ff8e00-f1d8-3c20-b709-ce54ac42859f",
                        "glosses": [
                            "наружный настил или уступ у входа в дом, часто — под навесом, со ступенькой или лесенкой"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f38a5dc-7d01-4199-aef8-81bf60028aeb",
                                "sense_id": "5b59c04e-9c3f-3ac8-b62a-52ad61f28741",
                                "text": "Библиотека размещалась в пристройке к школе, имела отдельное крыльцо и вход с торца школы."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "39332772-64a3-41f0-ac9c-5b162b90e3a6",
                        "source_entry_id": "35ff8e00-f1d8-3c20-b709-ce54ac42859f",
                        "source_sense_id": "5b59c04e-9c3f-3ac8-b62a-52ad61f28741",
                        "target_lang_word": "porch",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "porch",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ee26168e-e438-3396-9aa7-b03684687115",
                                        "entry_id": "9d7e81e7-cc18-373b-9826-e8b9fd89bfcf",
                                        "glosses": [
                                            "A covered entrance to a building, whether taken from the interior, and forming a sort of vestibule within the main wall, or projecting without and with a separate roof. A porch often has chair(s), table(s) and swings."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd83e935-f280-4556-bc92-8ac38c713c95",
                                                "sense_id": "ee26168e-e438-3396-9aa7-b03684687115",
                                                "text": "He sat on his porch, waiting for his friend to come over."
                                            },
                                            {
                                                "example_id": "b4427204-bd67-4105-8e0b-abacba4479e0",
                                                "sense_id": "ee26168e-e438-3396-9aa7-b03684687115",
                                                "text": "But Miss Thorn relieved the situation by laughing aloud,[…]. We began to tell her about Mohair and the cotillon, and of our point of observation from the Florentine galleried porch, and she insisted she would join us there."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "84535f0e-a39c-3050-a918-08f7e8143f31",
                                        "entry_id": "9d7e81e7-cc18-373b-9826-e8b9fd89bfcf",
                                        "glosses": [
                                            "A portico; a covered walk."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "964dd79a-6b6e-391c-a646-a20c8635ef71",
                                        "entry_id": "9d7e81e7-cc18-373b-9826-e8b9fd89bfcf",
                                        "glosses": [
                                            "The platform outside the external hatch of a spacecraft."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1110cd98-0ed3-45f4-ada1-cfe40857f0a6",
                                                "sense_id": "964dd79a-6b6e-391c-a646-a20c8635ef71",
                                                "text": "By the time he had put on the backpack, McDivitt was ready to let him do more—to stand on the porch at least."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d7f12bc9-b5a1-407f-8a03-bfa2221cdd70",
                        "source_entry_id": "35ff8e00-f1d8-3c20-b709-ce54ac42859f",
                        "source_sense_id": "5b59c04e-9c3f-3ac8-b62a-52ad61f28741",
                        "target_lang_word": "zaguán",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zaguán",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "759c57a9-1eb2-3eda-acab-1ee03806771a",
                                        "entry_id": "9321043e-bbbe-397c-8b5f-dcec90700e41",
                                        "glosses": [
                                            "Antecámara o zona cubierta que da entrada a la vivienda y que posee la puerta que da a la calle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "67595a70-3bfd-42d9-8c03-912afdcc0d8d",
                                                "sense_id": "759c57a9-1eb2-3eda-acab-1ee03806771a",
                                                "text": "El zaguán es ancho con escalera al fondo y con su farolón; un banco de roble invita a sentarse y meditar."
                                            },
                                            {
                                                "example_id": "1c19c762-2551-4c14-aa38-bf928734684d",
                                                "sense_id": "759c57a9-1eb2-3eda-acab-1ee03806771a",
                                                "text": "Está un momento inmóvil, y con arranque en él inusitado, traspone la puerta y penetra en el zaguán."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "90e77744-0f48-4e99-80a3-1549d5491322",
                        "source_entry_id": "35ff8e00-f1d8-3c20-b709-ce54ac42859f",
                        "source_sense_id": "5b59c04e-9c3f-3ac8-b62a-52ad61f28741",
                        "target_lang_word": "porche",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "porche",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "7d26be5a-c8f0-3d3f-9b17-2399654bc68b",
                                        "entry_id": "c4162fe7-4a4d-3ad3-a1e2-71111abd599a",
                                        "glosses": [
                                            "Entrada a un edificio o zona lateral del mismo cubierta por una techumbre adosada a él."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a39331a-242c-4631-8364-341bed4f86e3",
                                                "sense_id": "7d26be5a-c8f0-3d3f-9b17-2399654bc68b",
                                                "text": "«Al llegar, vimos a Eustacio sentado en el porche»."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "502e97cd-52eb-4c3e-8637-3b35b67f7cf0",
                        "source_entry_id": "35ff8e00-f1d8-3c20-b709-ce54ac42859f",
                        "source_sense_id": "5b59c04e-9c3f-3ac8-b62a-52ad61f28741",
                        "target_lang_word": "Außentreppe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Außentreppe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "28bc1ac7-f469-3a39-bd04-e67d921f0d21",
                                        "entry_id": "00c96d52-823a-34d0-8d0f-86193d2e8757",
                                        "glosses": [
                                            "außerhalb eines Gebäudes befindliche Treppe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c344836-8dd2-40bb-94ed-a00192ae050d",
                                                "sense_id": "28bc1ac7-f469-3a39-bd04-e67d921f0d21",
                                                "text": "„Sein Souterrain ist hoch, und in zwei Absätzen führt eine Außentreppe zu den Schalterräumen hinauf.“"
                                            },
                                            {
                                                "example_id": "6ebe67f5-7f07-43a4-a7a3-d0a08e7c51be",
                                                "sense_id": "28bc1ac7-f469-3a39-bd04-e67d921f0d21",
                                                "text": "„Ich stieg die Außentreppe zu Dunnings Wohnung hinauf und klopfte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c2451d3c-50d2-43f6-88b8-397c9292f019",
                        "source_entry_id": "35ff8e00-f1d8-3c20-b709-ce54ac42859f",
                        "source_sense_id": "5b59c04e-9c3f-3ac8-b62a-52ad61f28741",
                        "target_lang_word": "Vorplatz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vorplatz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c3ae14b4-861d-39b8-9517-1ef9ca5c3d69",
                                        "entry_id": "966ab1a3-0763-3d92-96fe-e18d9c30e2e5",
                                        "glosses": [
                                            "Freifläche vor einem Gebäude"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f37d2925-4b15-4793-b62c-a7c165ff8316",
                                                "sense_id": "c3ae14b4-861d-39b8-9517-1ef9ca5c3d69",
                                                "text": "Auf dem Vorplatz des Bahnhofes standen viele Taxis bereit."
                                            },
                                            {
                                                "example_id": "90c4cca9-adaa-4fef-a8dd-29c921f0e137",
                                                "sense_id": "c3ae14b4-861d-39b8-9517-1ef9ca5c3d69",
                                                "text": "„Dort hinauf ging ich, wenn mir der Trubel unten auf dem Vorplatz zuviel wurde.“"
                                            },
                                            {
                                                "example_id": "df34116f-967a-436d-94dc-a7d586559aee",
                                                "sense_id": "c3ae14b4-861d-39b8-9517-1ef9ca5c3d69",
                                                "text": "„Wie eine Filmdiva kommt sie über den Vorplatz geschritten und drückt Ali an sich.“"
                                            },
                                            {
                                                "example_id": "5b585260-3e85-4086-b0ba-e76d72d20b33",
                                                "sense_id": "c3ae14b4-861d-39b8-9517-1ef9ca5c3d69",
                                                "text": "„Da er erfahren hatte, daß der Bahnhof ein geraumes Stück außerhalb des Stadtkerns gelegen war, nahm er, aus dem Tunnel ins Freie tretend, auf dem Vorplatz beglückt eine Straßenbahn wahr, die er zu der frühen Stunde nicht vermutet hatte.“"
                                            },
                                            {
                                                "example_id": "59675c7b-0f8c-4f0b-966d-c38f28d1dbd7",
                                                "sense_id": "c3ae14b4-861d-39b8-9517-1ef9ca5c3d69",
                                                "text": "„Um die Baracke gestapelt sind Kästen und Flaschen, der Vorplatz ist Pfütze und Schlamm oder Sand und Staub und hat keine Bäume, im beständigen Nordwind flattert das kurze Gras.“"
                                            },
                                            {
                                                "example_id": "3917e0d6-3a81-4e6e-b8ee-810c5421901e",
                                                "sense_id": "c3ae14b4-861d-39b8-9517-1ef9ca5c3d69",
                                                "text": "Der Vorplatz war mit Fahrrädern und Kinderwagen vollgestellt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a7c6beed-ec69-3b09-84a7-b8d2c2dd534a",
