                "senses": [
                    {
                        "sense_id": "88959186-3693-3631-bff7-ca4d21754092",
                        "entry_id": "523e279f-ba84-349b-b02f-3059bf97e1ec",
                        "glosses": [
                            "Merkmal/Klasse zum Aufzeigen dessen, was charakteristisch (typisch) ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d51cd74b-cb58-490d-90b1-3660a2b69736",
                                "sense_id": "88959186-3693-3631-bff7-ca4d21754092",
                                "text": "„Im Rahmen des Erfordernisses der Entgeltlichkeit geht es also nicht um eine Einzelfallbeurteilung, sondern um das Feststellen einer Typizität.“"
                            },
                            {
                                "example_id": "69c017e3-2a83-471c-8a76-a2a6ef80f06a",
                                "sense_id": "88959186-3693-3631-bff7-ca4d21754092",
                                "text": "„Die Erfahrungswerte bezüglich der konkreten Eigenschaften eines bestimmten LMO [Living Modified Organism] und seiner Interaktion mit anderen Organismen unterliegen allerdings einem ständigen Erkenntniszuwachs, so dass es durchaus denkbar ist, dass sich in der Zukunft für bestimmte LMO Typizitäten bilden lassen, auf deren Grundlage eine Vermutungsbasis erstellt werden kann, die über den reinen Verdacht hinausgeht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
