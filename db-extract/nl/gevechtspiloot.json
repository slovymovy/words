                        "examples": [
                            {
                                "example_id": "73429cdd-a678-4260-b8ce-3f6bc16ca828",
                                "sense_id": "050bea76-dea8-361c-a7ab-b223fcaf76c1",
                                "text": "Meer dan driekwart eeuw bestond er onduidelijkheid over het lot van de Britse gevechtspiloot Sydney Hatfield Cheeseman (21) en zijn spitfire. Cheeseman verdween op 22 februari 1944 nadat hij samen met een aantal Amerikaanse vliegtuigen een Duitse vliegbasis bij Gilze Rijen had gebombardeerd."
                            },
                            {
                                "example_id": "b69ac077-efa6-49b8-af97-e6076bbc201e",
                                "sense_id": "050bea76-dea8-361c-a7ab-b223fcaf76c1",
                                "text": "De Amerikaanse gevechtspiloot en luchtvaartpionier Chuck Yeager is op 97-jarige leeftijd overleden. Zijn vrouw Victoria meldt dat op Twitter. In 1947 was Yeager de eerste mens die de geluidsbarrière doorbrak. \"Na alle hooggespannen verwachtingen viel het eigenlijk best tegen\", schreef Yeager in 1985 in zijn memoires. Faam verwierf hij al in de Tweede Wereldoorlog toen hij twaalf Duitse vliegtuigen neerhaalde, waarvan vijf in één missie."
                            }
                        ]
                    }
