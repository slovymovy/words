                    }
                ],
                "senses": [
                    {
                        "sense_id": "026228b4-e282-38ee-aa1c-0f8de7d72d4c",
                        "entry_id": "951f6d13-28e9-350e-b1b6-61999b985759",
                        "glosses": [
                            "de leiding van een bedrijf, de directeur en de topmanagers"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9984e63-6610-443f-8c28-bb894a1808b6",
                                "sense_id": "026228b4-e282-38ee-aa1c-0f8de7d72d4c",
                                "text": "Volgens de directie en de bewindvoerder is de uitgangspositie van de financiële en commerciële situatie „bemoedigend”."
                            }
                        ]
                    },
                    {
                        "sense_id": "7b1aaaf6-cb29-3457-82d4-d12cb2da0c4d",
                        "entry_id": "951f6d13-28e9-350e-b1b6-61999b985759",
                        "glosses": [
                            "bestuur"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94467f91-00a9-4623-b683-d77e836c51cc",
                                "sense_id": "7b1aaaf6-cb29-3457-82d4-d12cb2da0c4d",
                                "text": "FC Twente heeft op dit moment een schuldenlast van zo’n 80 miljoen euro, waarvan 50 miljoen langlopend. De directie denkt dat de inkomsten met 20 miljoen euro dalen in de eerste divisie."
                            },
                            {
                                "example_id": "7bc6d141-d968-4b7a-90b4-37b7f4dd3176",
                                "sense_id": "7b1aaaf6-cb29-3457-82d4-d12cb2da0c4d",
                                "text": "Ze waren tegen een muur van bureaucratie opgelopen waarvan deze arts slechts een voorpost was. Verdere pogingen bij de directie van het ziekenhuis zouden eveneens zinloos zijn, wisten ze."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3916a6f0-64a0-4e76-8347-a19e0bb9c7ff",
                        "source_entry_id": "951f6d13-28e9-350e-b1b6-61999b985759",
                        "source_sense_id": "026228b4-e282-38ee-aa1c-0f8de7d72d4c",
                        "source_sense_description": "de leiding van een bedrijf, de directeur en of de topmanagers",
                        "target_lang_word": "Direktion",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Direktion",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "078553f7-da9d-37e0-8810-ac7931d1c5e6",
                                        "entry_id": "1d7f0845-a2e4-3ec5-b1b7-ec0a34a93e7f",
                                        "glosses": [
                                            "leitende Funktion"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e4fc002-116b-4e83-a43a-f00dd3efa53f",
                                                "sense_id": "078553f7-da9d-37e0-8810-ac7931d1c5e6",
                                                "text": "„Die Direktion schwankte zwischen ungläubigem Staunen und Schrecken und schüttelte langsam den Kopf.“"
                                            },
                                            {
                                                "example_id": "8adbd10d-c5b2-41e0-a400-0c4575bb1899",
                                                "sense_id": "078553f7-da9d-37e0-8810-ac7931d1c5e6",
                                                "text": "Auf dem Schild stand groß und leserlich in schwarzen Buchstaben: Direktion."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d440960f-6750-314d-8a66-ab6dbf2c6ec5",
                                        "entry_id": "1d7f0845-a2e4-3ec5-b1b7-ec0a34a93e7f",
                                        "glosses": [
                                            "leitende Verwaltungsbehörde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb88b766-2c7c-42ab-8bc5-e0b93be03f6a",
                                                "sense_id": "d440960f-6750-314d-8a66-ab6dbf2c6ec5",
                                                "text": "Auf dem Schild stand groß und leserlich in schwarzen Buchstaben: Direktion."
                                            },
                                            {
                                                "example_id": "04f733f4-d87c-4a30-9625-1dd8391b4257",
                                                "sense_id": "d440960f-6750-314d-8a66-ab6dbf2c6ec5",
                                                "text": "„Diese Taktik schützt Buschor vor den Vorwürfen, er sei nicht bereit, in seiner Direktion zu sparen und dafür grosse Opfer darzubringen.“"
                                            },
                                            {
                                                "example_id": "ae70b5cb-9427-42e5-923c-01ab3541e8e6",
                                                "sense_id": "d440960f-6750-314d-8a66-ab6dbf2c6ec5",
                                                "text": "„Dies glauben auch die Ökonomen des Bundes, wie einem Interview der Zeitung «Sonntag» mit Aymo Brunetti, dem Leiter der Direktion Wirtschaftspolitik im Staatssekretariat für Wirtschaft (Seco), zu entnehmen ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "b68d5837-d142-3cc1-8cb3-cb0660ab4eba",
                                        "entry_id": "1d7f0845-a2e4-3ec5-b1b7-ec0a34a93e7f",
                                        "glosses": [
                                            "Richtung"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4715fd67-5449-4cfe-93ee-4a2be2f9e8f1",
                                                "sense_id": "b68d5837-d142-3cc1-8cb3-cb0660ab4eba",
                                                "text": "„Die erſte Verschiedenheit in Abſicht auf den verlezenden Körper beſchränkt ſich auf die Gröſſe, auf die Geſtalt, auf die Materie, auf die Entfernung, auf die Direktion (Richtung) deſſelben, und auf den angetroffenen Widerstand ein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a7bef63c-8ac0-4aa2-bfef-00d9c6f4fe90",
