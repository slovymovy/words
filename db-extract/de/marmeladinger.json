                        "source_sense_id": "6306af02-8b81-30a4-93e2-725afa3ac751",
                        "source_sense_description": "umgangssprachlich; aus Sicht eines Österreichers: Deutscher, manchmal im Besonderen: Norddeutscher",
                        "target_lang_word": "kraut",
