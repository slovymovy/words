                    "sense_definition": "Форма дательного или предложного падежа возвратного местоимения <w>себя</w>.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я купил <себе> новый телефон.",
                            "target_lang_translations": {
                                "en": "I bought <myself> a new phone.",
                                "cs": "Koupil jsem <w>si</w> nový telefon.",
                                "nl": "Ik heb <w>mezelf</w> een nieuwe telefoon gekocht.",
                                "pl": "Kupiłem <w>sobie</w> nowy telefon.",
                                "de": "Ich habe <w>mir</w> ein neues Telefon gekauft.",
                                "fr": "Je <w>me</w> suis acheté un nouveau téléphone.",
                                "it": "Mi sono comprato <w>un</w> nuovo telefono.",
                                "tr": "Kendime yeni bir telefon <w>aldım</w>.",
                                "es": "Me compré <w>un</w> teléfono nuevo.",
                                "zh": "我给自己<w>买</w>了一部新手机。"
                            }
                        },
                        {
                            "text": "Она часто рассказывает о <себе>.",
