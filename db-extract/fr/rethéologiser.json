                        "glosses": [
                            "Théologiser de nouveau."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "16d2ef44-056e-4fec-9055-e0db8db60cfd",
                                "sense_id": "d08891c2-f330-3789-9e4f-0799aca930bb",
                                "text": "Soulignons tout de suite qu'il ne peut nullement s'agir de rethéologiser après coup le projet philosophique de Ricœur d'une « petite éthique »."
                            },
                            {
                                "example_id": "a97c4c25-832f-4cb1-b269-3097dd863073",
                                "sense_id": "d08891c2-f330-3789-9e4f-0799aca930bb",
                                "text": "Il ne s'agit pas de rethéologiser le temporel mais de donner un sens humain au spirituel, ceci en « dépassant » la théologie."
                            }
                        ]
                    }
