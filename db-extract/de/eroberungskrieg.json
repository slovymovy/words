                "senses": [
                    {
                        "sense_id": "cde3762e-73ae-3ae4-b9f0-1e13d23cea49",
                        "entry_id": "60fbc364-3624-3dbc-a7bf-8a26ac441743",
                        "glosses": [
                            "Krieg mit dem Ziel, fremdes Gebiet zu erobern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fbd863a8-700a-49ff-af20-10398a50308f",
                                "sense_id": "cde3762e-73ae-3ae4-b9f0-1e13d23cea49",
                                "text": "„Es ist der erste Sieg, den Portugal in diesem Eroberungskrieg im Südosten Afrikas erringt.“"
                            },
                            {
                                "example_id": "931efba7-4ec8-4e0e-bf50-bc26b5753c2f",
                                "sense_id": "cde3762e-73ae-3ae4-b9f0-1e13d23cea49",
                                "text": "„Schuld war wohl der Eroberungskrieg Caesars gegen Gallien, der durch die Störung der Handelsbeziehungen und Einführung neuer Waren und Strukturen den gesamten Wirtschaftsraum nördlich der Alpen kollabieren ließ.“"
                            },
                            {
                                "example_id": "38fab0f5-f734-4273-a02c-6302a7e7b9a8",
                                "sense_id": "cde3762e-73ae-3ae4-b9f0-1e13d23cea49",
                                "text": "„Die neuen Kolonien sollten östlich von Deutschland entstehen, und Mühlmann schwor seine Zunft auf die zukünftigen Eroberungskriege ein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
