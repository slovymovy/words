                "senses": [
                    {
                        "sense_id": "5274d981-be70-34d6-9278-2b7fcee2bd65",
                        "entry_id": "7e59bed6-443d-3f7b-9157-db0b96b85888",
                        "glosses": [
                            "Betrieb, in dem Brände durch Destillation vergorenen Korns hergestellt werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a3e22bd8-1c50-4c01-8f5e-c04192652bab",
                                "sense_id": "5274d981-be70-34d6-9278-2b7fcee2bd65",
                                "text": "„In der Kornbrennerei und Likörfabrik lernte er seine erste wahre Berufung kennen: Kräuterbitter.“"
                            },
                            {
                                "example_id": "c8ea4296-f8cc-464b-b104-1556003fce8a",
                                "sense_id": "5274d981-be70-34d6-9278-2b7fcee2bd65",
                                "text": "„Kein Wunder man hatte dem Rittergut im wachsenden Wohlstand auch eine Kornbrennerei errichtet und die lieferte nur Hochprozentiges, den sogenannten Klaren.“"
                            },
                            {
                                "example_id": "9cba99a6-e9d2-4720-90fd-ff42a6de2c55",
                                "sense_id": "5274d981-be70-34d6-9278-2b7fcee2bd65",
                                "text": "„Hier wohnte die gräfliche Familie von Hardenberg, die eine berühmte Kornbrennerei betrieb.“"
                            },
                            {
                                "example_id": "2d4bd4a8-8ff9-4fde-88cd-1cb628af1f62",
                                "sense_id": "5274d981-be70-34d6-9278-2b7fcee2bd65",
                                "text": "„Sehr bald folgte die Gründung vieler kleiner Kornbrennereien in fast allen Städten.“"
                            },
                            {
                                "example_id": "085c47e4-f589-415e-8d67-91256f8a55c3",
                                "sense_id": "5274d981-be70-34d6-9278-2b7fcee2bd65",
                                "text": "„Dort können sie die Kornbrennerei besichtigen; große kupferne Kessel, unter denen Feuer brennt.“"
                            },
                            {
                                "example_id": "e8fb2b16-6668-413c-863c-234f4c8b5166",
                                "sense_id": "5274d981-be70-34d6-9278-2b7fcee2bd65",
                                "text": "„Die wirtschaftlichen Schwerpunkte dieser Stadt sind die Leinenwebereien und Kornbrennereien.“"
                            },
                            {
                                "example_id": "196f7f00-b237-4563-b29c-bf50be3ee43d",
                                "sense_id": "5274d981-be70-34d6-9278-2b7fcee2bd65",
                                "text": "„Ebenfalls 1948 wurde die Kornbrennerei gebaut, deren Erzeugnisse jedoch nur einen kleinen Anteil am Gesamtbetrieb ausmachen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
