                                    },
                                    {
                                        "sense_id": "1fdbfc5b-59dc-3034-bec1-234d4929bdd2",
                                        "entry_id": "27c20c10-0476-3286-8778-11d660fcfe10",
                                        "glosses": [
                                            "Épuisé physiquement ou mentalement."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "371a5110-995e-4fe1-b2d8-8a71594b5b40",
                                                "sense_id": "1fdbfc5b-59dc-3034-bec1-234d4929bdd2",
                                                "text": "Je suis fatigué, je suis brûlé quand j’arrive le soir, mais ça passe vite, ça s’oublie, parce que c’est tellement gratifiant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4da7a765-1209-321f-96c7-da52cb3444cd",
                                        "entry_id": "27c20c10-0476-3286-8778-11d660fcfe10",
                                        "glosses": [
                                            "Se dit d'un métal qui a été chauffé à une température trop proche de son point de fusion et qui, une fois refroidi, ne supporte plus les contraintes mécaniques et est impropre à être laminé ou forgé."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
