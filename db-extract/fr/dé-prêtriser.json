                ],
                "senses": [
                    {
                        "sense_id": "3371926c-9cf5-37d3-9d67-69e6320f45be",
                        "entry_id": "d42a5012-5421-34cb-8851-c8a6cf5062d0",
                        "glosses": [
                            "Dépouiller de la qualité de prêtre."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "02aa307e-2136-3bc0-8ff6-11e774a39614",
                        "entry_id": "d42a5012-5421-34cb-8851-c8a6cf5062d0",
                        "glosses": [
                            "Rejeter la qualité de prêtre, de façon volontaire ou forcée."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "224d4970-6aab-4977-9071-4d8963304789",
                                "sense_id": "02aa307e-2136-3bc0-8ff6-11e774a39614",
                                "text": "À Rochefort, Laignelot conduit 8 prêtres catholiques et un ministre protestant à se dé-prêtriser."
                            },
                            {
                                "example_id": "deaddf31-9d4a-4ff0-8426-5dcd8edcfe8c",
                                "sense_id": "02aa307e-2136-3bc0-8ff6-11e774a39614",
                                "text": "Par ailleurs, les pressions administratives dans les années 1796-1797 principalement se faisaient de plus en plus fortes afin d’inciter les membres du clergé à se dé-prêtriser en se mariant."
                            },
                            {
                                "example_id": "e55edd07-9507-4a6d-8900-7b9b2bc50260",
                                "sense_id": "02aa307e-2136-3bc0-8ff6-11e774a39614",
                                "text": "Dans une optique légiste, puisque d’origine cléricale, Sieyès devient un homme de Raison et d’Esprit en se dé-prêtrisant, ce qui le rend emblématique tout à la fois d’un esprit libertin irréligieux et du continuum de la fonction publique désintéressée dans l’optique du socialisme colbertien."
                            }
                        ]
                    }
