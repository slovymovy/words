{
    "word_family": [
        "wrangle",
        "wrangler"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0c38f13e-dc30-3d32-92b1-e1c45b40928c",
                    "sense_definition": "A long and complicated argument or dispute.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "argument",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The political <w>wrangling</w> over the new budget lasted for several months.",
                            "target_lang_translations": {
                                "nl": "Het politieke <w>getouwtrek</w> over de nieuwe begroting duurde enkele maanden."
                            }
                        },
                        {
                            "text": "After much <w>wrangling</w>, the two companies finally reached a settlement.",
                            "target_lang_translations": {
                                "nl": "Na veel <w>geharrewar</w> bereikten de twee bedrijven eindelijk een schikking."
                            }
                        }
                    ],
                    "synonyms": [
                        "dispute",
                        "argument",
                        "quarrel"
                    ],
                    "common_phrases": [
                        "political wrangling",
                        "endless wrangling"
                    ],
                    "target_lang_definitions": {
                        "nl": "Een langdurige en ingewikkelde discussie of ruzie."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "getouwtrek",
                                "target_lang_sense_clarification": "vaak gebruikt voor langdurige politieke of zakelijke discussies"
                            },
                            {
                                "target_lang_word": "geharrewar",
                                "target_lang_sense_clarification": "informele term voor een verwarrende of langdurige ruzie"
                            },
                            {
                                "target_lang_word": "twist",
                                "target_lang_sense_clarification": "algemene term voor een conflict of meningsverschil"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b48d1bd1-37a4-382f-8f85-ca9d9d4158c9",
                    "sense_definition": "The act of <w>wrangle</w> or arguing in a noisy or angry way.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "argument",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They spent the whole afternoon <w>wrangling</w> about who should pay the bill.",
                            "target_lang_translations": {
                                "nl": "Ze hebben de hele middag zitten <w>bekvechten</w> over wie de rekening moest betalen."
                            }
                        },
                        {
                            "text": "The committee members were <w>wrangling</w> over the details of the contract.",
                            "target_lang_translations": {
                                "nl": "De commissieleden waren aan het <w>kibbelen</w> over de details van het contract."
                            }
                        }
                    ],
                    "synonyms": [
                        "arguing",
                        "quarreling",
                        "disputing"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle and gerund of wrangle"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Het luidruchtig of boos discussiëren of ruziën."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "bekvechten",
                                "target_lang_sense_clarification": "het maken van kibbelende of ruziënde opmerkingen"
                            },
                            {
                                "target_lang_word": "kibbelen",
                                "target_lang_sense_clarification": "over kleine details of onbelangrijke zaken ruziën"
                            },
                            {
                                "target_lang_word": "discussiëren",
                                "target_lang_sense_clarification": "het voeren van een verhitte discussie"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}