{
    "word_family": [
        "hurdler",
        "hurdling"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "23553ce6-e0b5-3622-9a97-c03fe6fddae5",
                    "sense_definition": "A difficulty or problem that must be overcome to achieve a goal.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "obstacle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The young entrepreneur faced a major financial <w>hurdle</w> when starting her new business.",
                            "target_lang_translations": {
                                "ru": "Молодая предпринимательница столкнулась с серьезным финансовым <w>препятствием</w> при открытии своего нового бизнеса.",
                                "zh": "这位年轻的创业者在创办新公司时遇到了一个重大的财务<w>障碍</w>。"
                            }
                        },
                        {
                            "text": "They still had many <w>hurdles</w> to clear before the peace treaty could be signed.",
                            "target_lang_translations": {
                                "ru": "Им все еще предстояло преодолеть множество <w>барьеров</w>, прежде чем мирный договор мог быть подписан.",
                                "zh": "在和平条约签署之前，他们仍然需要克服许多<w>障碍</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "obstacle",
                        "barrier",
                        "impediment",
                        "difficulty"
                    ],
                    "antonyms": [
                        "advantage",
                        "aid",
                        "help"
                    ],
                    "common_phrases": [
                        "clear a hurdle",
                        "major hurdle",
                        "final hurdle",
                        "overcome a hurdle"
                    ],
                    "target_lang_definitions": {
                        "ru": "Трудность или проблема, которую необходимо преодолеть для достижения цели.",
                        "zh": "为实现某个目标而必须克服的困难或问题。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "препятствие",
                                "target_lang_sense_clarification": "то, что мешает достижению цели"
                            },
                            {
                                "target_lang_word": "барьер",
                                "target_lang_sense_clarification": "преграда для осуществления чего-либо"
                            },
                            {
                                "target_lang_word": "затруднение",
                                "target_lang_sense_clarification": "сложность или помеха"
                            },
                            {
                                "target_lang_word": "преграда",
                                "target_lang_sense_clarification": "то, что стоит на пути"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "障碍",
                                "target_lang_sense_clarification": "为实现目标必须克服的困难或阻碍"
                            },
                            {
                                "target_lang_word": "阻碍",
                                "target_lang_sense_clarification": "前进过程中的阻挡、妨碍"
                            },
                            {
                                "target_lang_word": "壁垒",
                                "target_lang_sense_clarification": "较正式，指限制进展的因素"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fb6f40d5-e66c-33eb-acb3-8d67512992ff",
                    "sense_definition": "A frame or barrier that athletes or horses must jump over during a race.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "sports_barrier",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The athlete tripped over the last <w>hurdle</w> and lost his lead in the race.",
                            "target_lang_translations": {
                                "ru": "Атлет споткнулся о последний <w>барьер</w> и потерял лидерство в забеге.",
                                "zh": "那名运动员被最后一个<w>栏架</w>绊了一下，失去了比赛中的领先位置。"
                            }
                        },
                        {
                            "text": "She practiced jumping every <w>hurdle</w> with perfect form to improve her time.",
                            "target_lang_translations": {
                                "ru": "Она тренировалась перепрыгивать каждое <w>препятствие</w> с идеальной техникой, чтобы улучшить свое время.",
                                "zh": "为了提高成绩，她练习以完美的动作跨过每一个<w>栏架</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "barrier",
                        "jump"
                    ],
                    "common_phrases": [
                        "jump a hurdle",
                        "high hurdles",
                        "low hurdles"
                    ],
                    "target_lang_definitions": {
                        "ru": "Рама или заграждение, через которое атлеты или лошади должны перепрыгнуть во время забега.",
                        "zh": "比赛中运动员或马匹必须跳过的架子或障碍物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "барьер",
                                "target_lang_sense_clarification": "спортивный снаряд для прыжков"
                            },
                            {
                                "target_lang_word": "препятствие",
                                "target_lang_sense_clarification": "объект для перепрыгивания в скачках или беге"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "栏架",
                                "target_lang_sense_clarification": "跨栏或赛马中需要跃过的栏状障碍"
                            },
                            {
                                "target_lang_word": "栏",
                                "target_lang_sense_clarification": "田径项目中的跨越障碍物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "992e3d30-6e91-3fb1-923f-f2f9f6bb9158",
                    "sense_definition": "A movable frame made of twigs or iron used for fencing land or enclosing livestock.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "fencing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The shepherd used a wooden <w>hurdle</w> to keep the sheep within the designated grazing area.",
                            "target_lang_translations": {
                                "ru": "Пастух использовал деревянную <w>изгородь</w>, чтобы удерживать овец в пределах отведенного пастбища.",
                                "zh": "牧羊人用一个木制<w>活动围栏</w>把羊群控制在指定的放牧区域内。"
                            }
                        },
                        {
                            "text": "The purchase of <w>hurdles</w> was a regular charge in the farm's annual accounts.",
                            "target_lang_translations": {
                                "ru": "Покупка переносных <w>загонов</w> была регулярной статьей расходов в годовом отчете фермы.",
                                "zh": "购买<w>活动围栏</w>是这家农场年度账目中的一项经常性支出。"
                            }
                        }
                    ],
                    "synonyms": [
                        "fence",
                        "wattle"
                    ],
                    "common_phrases": [
                        "wattled hurdle"
                    ],
                    "target_lang_definitions": {
                        "ru": "Переносная рама из веток или железа, используемая для ограждения земли или загона для скота.",
                        "zh": "一种由细枝条或铁制成的可移动框架，用于圈地或围住牲畜。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "плетень",
                                "target_lang_sense_clarification": "плетеный забор или щит"
                            },
                            {
                                "target_lang_word": "переносная изгородь",
                                "target_lang_sense_clarification": "мобильное ограждение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "活动围栏",
                                "target_lang_sense_clarification": "可移动的牲畜或土地围挡"
                            },
                            {
                                "target_lang_word": "篱笆架",
                                "target_lang_sense_clarification": "用枝条等编成、可移动的简易围挡"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9db26947-7640-3e3e-8f9b-8c85a377d219",
                    "sense_definition": "In board games like chess variants, a piece that is jumped over by another piece.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "gaming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hopper piece moves by jumping over a <w>hurdle</w> to land on the square beyond it.",
                            "target_lang_translations": {
                                "ru": "Фигура «хоппер» ходит, перепрыгивая через <w>препятствие</w>, чтобы приземлиться на клетку за ним.",
                                "zh": "这种“跳跃子”通过跳过一个<w>障碍子</w>，落到它后面的格子上移动。"
                            }
                        },
                        {
                            "text": "In this game variant, the <w>hurdle</w> is not captured when a piece hops over it.",
                            "target_lang_translations": {
                                "ru": "В этом варианте игры <w>фигура-препятствие</w> не берется, когда другая фигура перепрыгивает через нее.",
                                "zh": "在这个游戏变体中，当棋子跳过这个<w>障碍子</w>时，并不会将其吃掉。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical terminology in fairy chess"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "В настольных играх (например, вариантах шахмат) — фигура, через которую перепрыгивает другая фигура.",
                        "zh": "在某些棋盘游戏（如国际象棋变体）中，指被另一枚棋子跳过的棋子。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "препятствие",
                                "target_lang_sense_clarification": "фигура, через которую совершается прыжок"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "障碍子",
                                "target_lang_sense_clarification": "棋类变体中供其他棋子跳越的棋子"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1d006b34-d831-3bf7-8415-3948457955b0",
                    "sense_definition": "A sled or crate used historically to transport criminals to their place of execution.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "execution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The prisoner was dragged on a <w>hurdle</w> through the streets to the gallows.",
                            "target_lang_translations": {
                                "ru": "Заключенного протащили на <w>санях-волокуше</w> по улицам к виселице.",
                                "zh": "那名囚犯被拖在一张<w>拖架</w>上穿过街道，押往绞刑架。"
                            }
                        },
                        {
                            "text": "Many a wretch has rid on <w>hurdles</w> for crimes far less severe than treason.",
                            "target_lang_translations": {
                                "ru": "Многие несчастные ехали на <w>решетках для казни</w> за преступления куда менее тяжкие, чем государственная измена.",
                                "zh": "许多不幸的人曾因远比叛国轻得多的罪行被押在<w>拖架</w>上示众。"
                            }
                        }
                    ],
                    "synonyms": [
                        "sled",
                        "sledge"
                    ],
                    "common_phrases": [
                        "drawn on a hurdle"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historical context of punishment"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сани или решетка, исторически использовавшиеся для перевозки преступников к месту казни.",
                        "zh": "旧时用于把犯人运送到行刑地点的雪橇或拖架。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сани",
                                "target_lang_sense_clarification": "для перевозки осужденных"
                            },
                            {
                                "target_lang_word": "волокуша",
                                "target_lang_sense_clarification": "приспособление для волочения преступника"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "拖架",
                                "target_lang_sense_clarification": "历史上押送犯人赴刑场用的拖行装置"
                            },
                            {
                                "target_lang_word": "拖橇",
                                "target_lang_sense_clarification": "旧时拖运犯人的橇状器具"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "70be18c8-4013-3dd1-8652-4b3125807ac3",
                    "sense_definition": "To jump over an object while running at a fast pace.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "jumping",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The thief managed to <w>hurdle</w> the low fence while running away from the guards.",
                            "target_lang_translations": {
                                "ru": "Вору удалось <w>перепрыгнуть</w> через низкий забор, убегая от стражи.",
                                "zh": "小偷在躲避卫兵时成功<w>跨过</w>了那道矮栅栏。"
                            }
                        },
                        {
                            "text": "He <w>hurdled</w> the bench in his rush to get to the train station on time.",
                            "target_lang_translations": {
                                "ru": "Он <w>перемахнул</w> через скамейку в спешке, чтобы вовремя успеть на вокзал.",
                                "zh": "为了按时赶到火车站，他匆忙中<w>跳过</w>了那条长凳。"
                            }
                        }
                    ],
                    "synonyms": [
                        "jump",
                        "leap",
                        "vault",
                        "clear"
                    ],
                    "common_phrases": [
                        "hurdle a fence",
                        "hurdle an object"
                    ],
                    "target_lang_definitions": {
                        "ru": "Перепрыгнуть через объект, бежав в быстром темпе.",
                        "zh": "快速奔跑时跳过某个物体。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перепрыгивать",
                                "target_lang_sense_clarification": "через барьер или препятствие"
                            },
                            {
                                "target_lang_word": "преодолевать",
                                "target_lang_sense_clarification": "прыжком на бегу"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "跨过",
                                "target_lang_sense_clarification": "奔跑时跳过障碍物"
                            },
                            {
                                "target_lang_word": "跳过",
                                "target_lang_sense_clarification": "较通用，指跳越某物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7bd21d51-0989-34ee-af8f-5fab9f06bd8e",
                    "sense_definition": "To successfully deal with or overcome a problem or obstacle.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "overcoming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The team had to <w>hurdle</w> several technical issues before the software could be released.",
                            "target_lang_translations": {
                                "ru": "Команде пришлось <w>преодолеть</w> несколько технических проблем, прежде чем программное обеспечение могло быть выпущено.",
                                "zh": "在软件发布之前，团队必须<w>克服</w>几个技术问题。"
                            }
                        },
                        {
                            "text": "She successfully <w>hurdled</w> the final challenge of the competition.",
                            "target_lang_translations": {
                                "ru": "Она успешно <w>справилась</w> с последним испытанием соревнований.",
                                "zh": "她成功<w>克服</w>了比赛中的最后一道难关。"
                            }
                        }
                    ],
                    "synonyms": [
                        "overcome",
                        "surmount",
                        "bypass"
                    ],
                    "antonyms": [
                        "fail",
                        "succumb"
                    ],
                    "common_phrases": [
                        "hurdle a challenge",
                        "hurdle an obstacle"
                    ],
                    "target_lang_definitions": {
                        "ru": "Успешно справиться с проблемой или препятствием или преодолеть их.",
                        "zh": "成功应对或战胜问题、困难或障碍。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "преодолевать",
                                "target_lang_sense_clarification": "справляться с трудностями"
                            },
                            {
                                "target_lang_word": "брать",
                                "target_lang_sense_clarification": "успешно проходить барьер или этап"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "克服",
                                "target_lang_sense_clarification": "成功处理并越过困难"
                            },
                            {
                                "target_lang_word": "跨越",
                                "target_lang_sense_clarification": "强调设法战胜障碍"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "44e3e715-e21a-3d72-a7be-9dabbed11cb0",
                    "sense_definition": "To take part in a track and field race that involves jumping over barriers.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "sports_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She has been <w>hurdling</w> since high school and hopes to make the Olympic team.",
                            "target_lang_translations": {
                                "ru": "Она занимается <w>барьерным бегом</w> со старшей школы и надеется попасть в олимпийскую сборную.",
                                "zh": "她从高中起就一直在<w>跑跨栏</w>，并希望进入奥运代表队。"
                            }
                        },
                        {
                            "text": "The athlete decided to <w>hurdle</w> in the state championships this year.",
                            "target_lang_translations": {
                                "ru": "Атлет решил <w>выступить в беге с барьерами</w> на чемпионате штата в этом году.",
                                "zh": "这名运动员决定今年在州锦标赛中参加<w>跨栏</w>项目。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "hurdle competitively"
                    ],
                    "target_lang_definitions": {
                        "ru": "Участвовать в легкоатлетическом забеге, включающем прыжки через барьеры.",
                        "zh": "参加需要跨越栏架的田径比赛。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бежать с барьерами",
                                "target_lang_sense_clarification": "вид легкой атлетики"
                            },
                            {
                                "target_lang_word": "заниматься барьерным бегом",
                                "target_lang_sense_clarification": "спортивная дисциплина"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "跑跨栏",
                                "target_lang_sense_clarification": "参加跨栏比赛或进行该项目"
                            },
                            {
                                "target_lang_word": "参加跨栏",
                                "target_lang_sense_clarification": "体育项目名称中的说法"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c6833e05-feeb-3f63-a155-f10d81694cd8",
                    "sense_definition": "In certain board games, to move a piece by jumping over another without taking it.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "gaming_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The kangaroo piece <w>hurdles</w> over any two units to land on the square beyond.",
                            "target_lang_translations": {
                                "ru": "Фигура «кенгуру» <w>перепрыгивает</w> через любые две единицы, чтобы приземлиться на клетку за ними.",
                                "zh": "这种“袋鼠”棋子可以<w>跳过</w>任意两个单位，落到后面的格子上。"
                            }
                        },
                        {
                            "text": "A player can <w>hurdle</w> their own pieces to reach a better position on the board.",
                            "target_lang_translations": {
                                "ru": "Игрок может <w>перепрыгивать</w> через свои собственные фигуры, чтобы занять лучшую позицию на доске.",
                                "zh": "玩家可以<w>跳过</w>自己的棋子，以在棋盘上占据更好的位置。"
                            }
                        }
                    ],
                    "synonyms": [
                        "hop",
                        "jump"
                    ],
                    "common_phrases": [
                        "hurdle over a piece"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical terminology in fairy chess"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "В некоторых настольных играх — перемещать фигуру, перепрыгивая через другую без её взятия.",
                        "zh": "在某些棋盘游戏中，指棋子通过跳过另一枚棋子而移动，且不将其吃掉。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перепрыгивать",
                                "target_lang_sense_clarification": "через другую фигуру"
                            }
                        ],
                        "zh": [
                            {
