{
    "word_family": [
        "opportune",
        "opportunist",
        "opportunistic",
        "opportunism",
        "inopportune"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "bea29ebd-127d-391e-90f9-cda427d8b5cb",
                    "sense_definition": "A situation that makes it possible to do something that you want to do.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "chance_general",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Having a holiday is a great <w>opportunity</w> to relax and forget about work.",
                            "target_lang_translations": {
                                "ru": "Отпуск — это отличная <w>возможность</w> расслабиться и забыть о работе.",
                                "tr": "Tatil yapmak, rahatlamak ve işi unutmak için harika bir <w>fırsattır</w>.",
                                "zh": "度假是放松身心、忘掉工作的绝佳<w>机会</w>。"
                            }
                        },
                        {
                            "text": "Please take this <w>opportunity</w> to ask any questions you might have.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, воспользуйтесь этой <w>возможностью</w>, чтобы задать любые вопросы.",
                                "tr": "Lütfen aklınıza takılan soruları sormak için bu <w>fırsatı</w> değerlendirin.",
                                "zh": "请<w>利用</w>这个机会提出你可能有的任何问题。"
                            }
                        }
                    ],
                    "synonyms": [
                        "chance",
                        "occasion",
                        "opening"
                    ],
                    "common_phrases": [
                        "take the opportunity",
                        "miss the opportunity",
                        "golden opportunity",
                        "opportunity to learn"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ситуация, позволяющая сделать то, что вы хотите.",
                        "tr": "İstediğiniz bir şeyi yapmanızı mümkün kılan durum.",
                        "zh": "使你能够做你想做的事情的情况。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "возмо́жность",
                                "target_lang_sense_clarification": "обстоятельство, позволяющее осуществить что-либо"
                            },
                            {
                                "target_lang_word": "удо́бный слу́чай",
                                "target_lang_sense_clarification": "благоприятное стечение обстоятельств"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "fırsat",
                                "target_lang_sense_clarification": "bir şeyi yapmak için uygun durum veya zaman"
                            },
                            {
                                "target_lang_word": "imkân",
                                "target_lang_sense_clarification": "olanak, bir şeyin yapılabilme durumu"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "机会",
                                "target_lang_sense_clarification": "做某事的好时机或条件"
                            },
                            {
                                "target_lang_word": "时机",
                                "target_lang_sense_clarification": "适合做某事的特定时刻"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "05f0e794-fa58-3942-ae1d-850be428a752",
                    "sense_definition": "A chance for success, progress, or profit, especially in work or business.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "chance_advancement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She moved to the city to find better job <w>opportunities</w> in her field.",
                            "target_lang_translations": {
                                "ru": "Она переехала в город, чтобы найти лучшие карьерные <w>возможности</w> в своей сфере.",
                                "tr": "Kendi alanında daha iyi iş <w>olanakları</w> bulmak için şehre taşındı.",
                                "zh": "她搬到城里是为了在她的领域寻找更好的工作<w>机会</w>。"
                            }
                        },
                        {
                            "text": "You must seize the <w>opportunity</w> before it is too late to act.",
                            "target_lang_translations": {
                                "ru": "Ты должен ухватиться за эту <w>возможность</w>, пока не стало слишком поздно действовать.",
                                "tr": "Harekete geçmek için çok geç olmadan bu <w>fırsatı</w> yakalamalısın.",
                                "zh": "你必须在为时已晚之前<w>抓住</w>这个机会采取行动。"
                            }
                        }
                    ],
                    "synonyms": [
                        "prospect",
                        "break",
                        "chance",
                        "possibility"
                    ],
                    "common_phrases": [
                        "job opportunity",
                        "business opportunity",
                        "career opportunity",
                        "seize the opportunity",
                        "equal opportunities"
                    ],
                    "target_lang_definitions": {
                        "ru": "Шанс на успех, развитие или прибыль, особенно в работе или бизнесе.",
                        "tr": "Özellikle iş veya ticarette başarı, gelişme veya kazanç elde etme şansı.",
                        "zh": "获得成功、进步或利润的可能性，尤指在工作或商业方面。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "возмо́жность",
                                "target_lang_sense_clarification": "перспектива развития, часто во мн. числе"
                            },
                            {
                                "target_lang_word": "шанс",
                                "target_lang_sense_clarification": "вероятность успеха"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "fırsat",
                                "target_lang_sense_clarification": "başarı veya gelişme şansı"
                            },
                            {
                                "target_lang_word": "olanak",
                                "target_lang_sense_clarification": "ilerleme veya başarı getirebilecek imkânlar"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "机会",
                                "target_lang_sense_clarification": "获得成功或发展的可能性"
                            },
                            {
                                "target_lang_word": "机遇",
                                "target_lang_sense_clarification": "有利的境遇或发展契机"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6fc4f1ad-2848-3fce-b6ab-c2c3a3da48fd",
                    "sense_definition": "The quality of happening at the right time or being appropriate.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The committee debated the <w>opportunity</w> of introducing the new policy this year.",
                            "target_lang_translations": {
                                "ru": "Комитет обсуждал <w>своевременность</w> введения новой политики в этом году.",
                                "tr": "Komite, yeni politikanın bu yıl yürürlüğe konmasının <w>uygunluğunu</w> tartıştı.",
                                "zh": "委员会讨论了今年推行新政策的<w>适宜性</w>。"
                            }
                        },
                        {
                            "text": "Critics questioned the <w>opportunity</w> of his remarks given the sensitive situation.",
                            "target_lang_translations": {
                                "ru": "Критики поставили под сомнение <w>уместность</w> его замечаний, учитывая деликатность ситуации.",
                                "tr": "Eleştirmenler, hassas durum göz önüne alındığında yaptığı açıklamaların <w>uygunluğunu</w> sorguladı.",
                                "zh": "鉴于局势敏感，评论家们质疑他那番言论的<w>适宜性</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "timeliness",
                        "appropriateness"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "formal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Своевременность или уместность действия.",
                        "tr": "Doğru zamanda gerçekleşme veya uygun olma niteliği.",
                        "zh": "事情发生得恰逢其时或适宜的性质。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уме́стность",
                                "target_lang_sense_clarification": "соответствие ситуации"
                            },
                            {
                                "target_lang_word": "своевре́менность",
                                "target_lang_sense_clarification": "появление в нужный момент"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "uygunluk",
                                "target_lang_sense_clarification": "duruma ve ortama yakışır olma durumu"
                            },
                            {
                                "target_lang_word": "zamanlama uygunluğu",
                                "target_lang_sense_clarification": "tam zamanında ve yerinde olma durumu"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "适宜性",
                                "target_lang_sense_clarification": "符合当前情况的程度"
                            },
                            {
                                "target_lang_word": "及时性",
                                "target_lang_sense_clarification": "在正确的时间发生的性质"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}