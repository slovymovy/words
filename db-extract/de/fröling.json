                ],
                "senses": [
                    {
                        "sense_id": "89401127-803b-3fed-be75-953e92b9f3ae",
                        "entry_id": "2bc50913-4498-3ecc-a9c0-ae33f1bcc609",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b404e8b0-ed58-4abb-a69e-7f7f28e8b4bd",
                                "sense_id": "89401127-803b-3fed-be75-953e92b9f3ae",
                                "text": "Frau Fröling ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "0e6872cb-3b24-4826-8157-d6e67355f10a",
                                "sense_id": "89401127-803b-3fed-be75-953e92b9f3ae",
                                "text": "Herr Fröling wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "32b3850b-d3f1-448c-abcd-c85814e51a6c",
                                "sense_id": "89401127-803b-3fed-be75-953e92b9f3ae",
                                "text": "Die Frölings fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "37919149-c763-4e1c-adb2-80474a12247a",
                                "sense_id": "89401127-803b-3fed-be75-953e92b9f3ae",
                                "text": "Der Fröling trägt nie die Schals, die die Fröling ihm strickt."
                            },
                            {
                                "example_id": "6d3dcbef-908e-48d8-ae35-cf9a5564f7f8",
                                "sense_id": "89401127-803b-3fed-be75-953e92b9f3ae",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Fröling kommt, geht der Herr Fröling.“"
                            },
                            {
                                "example_id": "1027e3b5-f944-4469-a988-1ff5cbf7ca72",
                                "sense_id": "89401127-803b-3fed-be75-953e92b9f3ae",
                                "text": "Fröling kommt und geht."
                            },
                            {
                                "example_id": "dd2b4759-9753-4494-88c5-19cd367fe744",
                                "sense_id": "89401127-803b-3fed-be75-953e92b9f3ae",
                                "text": "Frölings kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
