                },
                {
                    "sense_id": "9b31d248-86b7-30bb-b300-f5f1defb7adc",
                    "sense_definition": "An energetic, exciting, and very enjoyable song, especially in pop, hip-hop, or dance music.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "entertainment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The DJ played one absolute <w>banger</w> after another all night.",
                            "target_lang_translations": {
                                "ru": "Диджей всю ночь ставил один за другим просто стопроцентные <w>хиты</w>.",
                                "it": "Il DJ ha messo una <w>bomba</w> assoluta dietro l'altra per tutta la notte."
                            }
                        },
                        {
                            "text": "Their new single is a certified <w>banger</w> that will top the charts.",
                            "target_lang_translations": {
                                "ru": "Их новый сингл — настоящая <w>пушка</w>, которая возглавит чарты.",
                                "it": "Il loro nuovo singolo è una vera <w>hit</w> che scalerà le classifiche."
                            }
