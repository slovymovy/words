                "pos": "intj",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "0d6f4503-c135-3201-aaa6-0ad4cc8caff1",
                        "entry_id": "85f4ee12-9132-30ad-ba83-7bcd027bc366",
                        "glosses": [
                            "возглас, выражающий уверенное подтверждение чего-либо или клятвенное заверение в чём-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c45eea9c-2958-4c08-841d-aa26a9f0f431",
                                "sense_id": "0d6f4503-c135-3201-aaa6-0ad4cc8caff1",
                                "text": "― Найду дома, ― посулил молодой человек, ― книжка испорчена, ей-богу, Илья Иванович."
                            }
                        ]
                    },
                    {
                        "sense_id": "b2f2f397-4132-32fd-b620-102e59e231e1",
                        "entry_id": "85f4ee12-9132-30ad-ba83-7bcd027bc366",
                        "glosses": [
                            "выражает эмоциональное усиление"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "131f2491-6fc4-4c80-82bc-18e7492a40aa",
                                "sense_id": "b2f2f397-4132-32fd-b620-102e59e231e1",
                                "text": "Ведь не рассказывать же, ей-богу, про эту несчастную рыбёшку, которую с грозным рёвом и омерзительным сопением пожрал один из котов Янсонса."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
