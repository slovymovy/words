                                "target_senses": [
                                    {
                                        "sense_id": "db161089-22a7-3fb7-88f7-e7d66ad917e3",
                                        "entry_id": "f3c2dd4c-c12c-36a2-9f45-4df6f10fcbf0",
                                        "glosses": [
                                            "A member of a Christian religious community of women who live by certain vows and usually wear a habit, (Roman Catholicism, specifically) those living together in a cloister."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc325674-d4a3-4f95-9ca5-341940fff6a8",
                                                "sense_id": "db161089-22a7-3fb7-88f7-e7d66ad917e3",
                                                "text": "Thus, when the nuns came to the mission and we saw that instead of murmuring soft blessings and gliding seraphically over the grass in diaphanous habits, they wore smart blouses and skirts and walked, laughed and talked in low twanging tones very much like our own American missionaries did, we were very disappointed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d65c39be-5a9a-3d2b-8d3d-876ab82fea8f",
                                        "entry_id": "f3c2dd4c-c12c-36a2-9f45-4df6f10fcbf0",
                                        "glosses": [
                                            "A member of a similar female community in other confessions."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2bab3e76-c79f-428b-abd7-478350659609",
                                                "sense_id": "d65c39be-5a9a-3d2b-8d3d-876ab82fea8f",
                                                "text": "a Buddhist nun"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "08dcd2ab-cd71-3bfd-acf3-0f785f14397f",
                                        "entry_id": "f3c2dd4c-c12c-36a2-9f45-4df6f10fcbf0",
                                        "glosses": [
                                            "A prostitute."
                                        ],
                                        "tags": [
                                            "British",
                                            "archaic",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7a3a1e72-8ac4-4849-b748-14aec959512f",
                                                "sense_id": "08dcd2ab-cd71-3bfd-acf3-0f785f14397f",
                                                "text": "Why laſt night, as Colonel Kill'em, Sir William Weezy, Lord Frederick Foretop, and I were careleſsly ſliding the Ranelagh round, picking our teeth, after a damn'd muzzy dinner at Boodle's, who ſhould trip by but an abbeſs, well known about town, with a ſmart little nun in her ſuite."
                                            },
                                            {
                                                "example_id": "9eb71d60-bbab-48e4-9b29-5f6549523bfd",
                                                "sense_id": "08dcd2ab-cd71-3bfd-acf3-0f785f14397f",
                                                "text": "\"I mean to inform you,\" answered the Oxonian, with a grin on his face, \"that those three nymphs, who have so much dazzled your optics, are three nuns, and the plump female is Mother .... of great notoriety [...]\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c977c736-df47-3f4c-a37e-849abdbbd36c",
                                        "entry_id": "f3c2dd4c-c12c-36a2-9f45-4df6f10fcbf0",
                                        "glosses": [
                                            "A kind of pigeon with the feathers on its head like the hood of a nun."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "nun",
                                "target_lang_code": "en",
                                "target_senses": [
