                        "sense_id": "654bb03b-f051-3c50-bec9-a75253523627",
                        "entry_id": "a76ee98c-77bd-31c5-89fa-eeb716007cbf",
                        "glosses": [
                            "fine grit, grains of stone of between six and twenty millimeters diameter"
                        ],
                        "tags": [
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "0abc250a-e716-4169-afac-af8251e63558",
                                "sense_id": "654bb03b-f051-3c50-bec9-a75253523627",
                                "text": "Couvrir les allées de gravillons c'est économique mais cela demande de l'entretien.",
                                "translation": "Covering the lanes with grit is cheap, but it demands maintenance.",
                                "english": "Covering the lanes with grit is cheap, but it demands maintenance."
                            }
                        ]
                    }
                ],
