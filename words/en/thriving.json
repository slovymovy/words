                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "процветающий",
                                "target_lang_sense_clarification": "описывает состояние успеха и роста"
                            },
                            {
                                "target_lang_word": "преуспевающий",
                                "target_lang_sense_clarification": "описывает человека или бизнес, добивающиеся успеха"
