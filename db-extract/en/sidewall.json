                        "entry_id": "5c4f65ff-113d-37ea-a4bc-b56fc81d740e",
                        "glosses": [
                            "The side of a tire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd503096-c75e-4404-9ea4-d179ef051d62",
                                "sense_id": "f8bae590-82e6-30cc-90bf-ee83d485415b",
                                "text": "If the puncture had been in the tread I could have had the tire patched, but it was in the sidewall and they can't fix that: they have to replace the whole tire."
                            }
                        ]
                    },
                    {
                        "sense_id": "9bc9fd62-d7f2-37d7-826b-324cdb572dc0",
                        "entry_id": "5c4f65ff-113d-37ea-a4bc-b56fc81d740e",
                        "glosses": [
                            "The wall forming the side of a structure; a side wall."
