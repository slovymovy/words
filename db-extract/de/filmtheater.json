                "senses": [
                    {
                        "sense_id": "1de06e64-45d8-3dfe-a3a9-4ab793f5c72a",
                        "entry_id": "a3dcc954-6724-3b89-af6c-1c759c23daf6",
                        "glosses": [
                            "Einrichtung, in der Filme öffentlich vorgeführt werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e6f040dd-7f7e-4e4c-b4c1-c10a0185fd19",
                                "sense_id": "1de06e64-45d8-3dfe-a3a9-4ab793f5c72a",
                                "text": "„Um in der Kategorie bester Film antreten zu können, muss ein Spielfilm heuer mindestens sieben aufeinanderfolgende Tage lang in einem kommerziellen Filmtheater im Großraum Los Angeles ausgestrahlt worden sein.“"
                            },
                            {
                                "example_id": "0b904303-ba0e-4b4f-a671-c24761205b97",
                                "sense_id": "1de06e64-45d8-3dfe-a3a9-4ab793f5c72a",
                                "text": "„In den vergangenen Jahren haben einige Münchner Filmtheater geschlossen.“"
                            },
                            {
                                "example_id": "c420cd2b-7777-4046-bd48-f18d4353db25",
                                "sense_id": "1de06e64-45d8-3dfe-a3a9-4ab793f5c72a",
                                "text": "„Um die Filmtheater offenzuhalten, mußten sie den Vertrieb von alten deutschen Spielfilmen in Erwägung ziehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
