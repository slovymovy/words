                ],
                "senses": [
                    {
                        "sense_id": "a6e3a0aa-c526-3df8-bc26-3f444119fe75",
                        "entry_id": "9afeffe2-e0b0-308a-adb0-a69ca7a162f5",
                        "glosses": [
                            "A spar formerly used on board of ships, as a crane to hoist the flukes of the anchor to the top of the bow, without injuring the sides of the ship."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "49b8289f-d774-37c9-a498-ca73dbecc94c",
                        "entry_id": "9afeffe2-e0b0-308a-adb0-a69ca7a162f5",
                        "glosses": [
                            "A crane, often working in pairs and usually made of steel, used to lower things over an edge of a long drop off, such as lowering a maintenance trapeze down a building or launching a lifeboat over the side of a ship."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f925cc15-bb3d-4b9a-8e42-10abe461ce26",
                                "sense_id": "49b8289f-d774-37c9-a498-ca73dbecc94c",
                                "text": "A solid, pyramid-like hummock of ice, left to starboard as the steamer ascended, and which projected close alongside the upper, or boat-deck, as she fell over, had caught, in succession, every pair of davits to starboard, bending and wrenching them, smashing boats, and snapping tackles and gripes, until, as the ship cleared herself, it capped the pile of wreckage strewing the ice in front of, and around it, with the end and broken stanchions of the bridge."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cc1af239-eac9-4f2d-9248-5c56cfbc8125",
