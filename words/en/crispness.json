{
    "word_family": [
        "crisp",
        "crispy",
        "crisply"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9356d8c7-44db-37d7-861f-355d147ae1f0",
                    "sense_definition": "The quality of being firm, dry, and easily broken or crumbled.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "texture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>crispness</w> of the fresh lettuce made the salad very enjoyable.",
                            "target_lang_translations": {
                                "ru": "<w>Хруст</w> свежего салата сделал блюдо очень приятным."
                            }
                        },
                        {
                            "text": "I love the <w>crispness</w> of these freshly baked cookies.",
                            "target_lang_translations": {
                                "ru": "Мне нравится <w>хрустящая текстура</w> этого свежеиспеченного печенья."
                            }
                        }
                    ],
                    "synonyms": [
                        "brittleness",
                        "crunchiness"
                    ],
                    "antonyms": [
                        "softness",
                        "sogginess"
                    ],
                    "common_phrases": [
                        "apple crispness",
                        "biscuit crispness"
                    ],
                    "target_lang_definitions": {
                        "ru": "Свойство чего-либо быть твердым, сухим и легко ломающимся или крошащимся."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хруст",
                                "target_lang_sense_clarification": "звук или ощущение при разламывании твердой пищи"
                            },
                            {
                                "target_lang_word": "хрустящая текстура",
                                "target_lang_sense_clarification": "описание физического состояния продукта"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "248ba185-b6bc-3778-9324-0f4d07e117ad",
                    "sense_definition": "A distinct, sharp, or refreshing quality, often referring to cold air or clear sound.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We enjoyed the <w>crispness</w> of the morning air during our early hike.",
                            "target_lang_translations": {
                                "ru": "Мы наслаждались <w>свежестью</w> утреннего воздуха во время нашей ранней прогулки."
                            }
                        },
                        {
                            "text": "The <w>crispness</w> of the autumn breeze signaled that winter was coming soon.",
                            "target_lang_translations": {
                                "ru": "<w>Свежесть</w> осеннего ветерка сигнализировала о том, что скоро придет зима."
                            }
                        }
                    ],
                    "synonyms": [
                        "freshness",
                        "sharpness"
                    ],
                    "common_phrases": [
                        "morning crispness",
                        "air crispness"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отчетливое, резкое или освежающее качество, часто относящееся к холодному воздуху или чистому звуку."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "свежесть",
                                "target_lang_sense_clarification": "ощущение бодрящей прохлады воздуха"
                            },
                            {
                                "target_lang_word": "резкость",
                                "target_lang_sense_clarification": "отчетливость и ясность звука или ощущения"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}