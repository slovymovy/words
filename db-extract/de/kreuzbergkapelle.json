                ],
                "senses": [
                    {
                        "sense_id": "e5793dbb-f2ac-31e9-9b5d-ba7fbfb8cc3d",
                        "entry_id": "5a4d7ebe-dd72-38c3-b076-e928fdf58e57",
                        "glosses": [
                            "einfach gestaltetes Andachtsgebäude, das nicht für regelmäßige Gottesdienste einer Gemeinde bestimmt ist und auf einem Kreuzberg steht; Teiler einer Kreuzberganlage"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "24d38ab0-2ce4-440e-bac2-cb03c142100b",
                                "sense_id": "e5793dbb-f2ac-31e9-9b5d-ba7fbfb8cc3d",
                                "text": "„Die Kreuzbergkapelle ist im neuromanischen Stil gebaut, einem italienischen Kunststil des frühen Mittelalters.“"
                            },
                            {
                                "example_id": "7226489b-1e74-4535-ba77-cd6df983ac26",
                                "sense_id": "e5793dbb-f2ac-31e9-9b5d-ba7fbfb8cc3d",
                                "text": "„SICHTIGVOR - Hoch oben auf dem Kreuzberg thront sie. Von unten, durch Bäume verdeckt, kaum zu sehen: die Kreuzbergkapelle.“"
                            },
                            {
                                "example_id": "b6e32a64-641d-42d6-8075-cfe926d2d94b",
                                "sense_id": "e5793dbb-f2ac-31e9-9b5d-ba7fbfb8cc3d",
                                "text": "„Wem der Aufstieg von Düdinghausen zur Kreuzbergkapelle über den Kreuzweg zu anstrengend ist, der kann auch direkt auf dem Kreuzberg, nur wenige Meter unterhalb der Kapelle parken.“"
                            },
                            {
                                "example_id": "1c4a82f6-af12-446e-aa17-32edd777b45e",
                                "sense_id": "e5793dbb-f2ac-31e9-9b5d-ba7fbfb8cc3d",
                                "text": "„Über 20 Wallfahrten gingen früher täglich hinauf zur Kreuzbergkapelle.“"
                            },
                            {
                                "example_id": "7545e9b1-4785-4129-8921-d54d701b7d95",
                                "sense_id": "e5793dbb-f2ac-31e9-9b5d-ba7fbfb8cc3d",
                                "text": "„Urkundlich gesichert ist der Bau der Kreuzbergkapelle im Jahre 1715.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
