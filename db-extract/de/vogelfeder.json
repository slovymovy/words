                "senses": [
                    {
                        "sense_id": "0d3d86b3-3fb3-3591-bfb4-afdb986fed15",
                        "entry_id": "c846ddfe-6638-3204-804a-9cfd8c62a774",
                        "glosses": [
                            "Feder, die von einem Vogel stammt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a2b9d88-0f4d-43ad-8351-dd7d8a26132d",
                                "sense_id": "0d3d86b3-3fb3-3591-bfb4-afdb986fed15",
                                "text": "„Peter Handke, eine Vogelfeder im Sakko-Revers, ließ in seinen knappen einleitenden „Worten zum Abend“ alte und echte Verbundenheit mit Heinz Fischer aufblitzen, zeigte sich über dessen Altgriechisch-Kenntnisse herzlich berührt (die Odyssee-Kenntnisse „eines Sozialisten“) und nannte schließlich einigeLektüreempfehlungen, so den Roman „Boštjans Flug“ des Kärntner Slowenen Florjan Lipuš.“"
                            },
                            {
                                "example_id": "d4512568-8272-4d7b-aca2-1d6924f37f00",
                                "sense_id": "0d3d86b3-3fb3-3591-bfb4-afdb986fed15",
                                "text": "„Zum Geburtstag schenkte ich Renate eine von meinen Vogelfedern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
