                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "whoop",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "33b5bc78-ac2b-37bd-9bdf-1473fb34bd09",
                                        "entry_id": "0ed976b4-d218-3769-97ed-c94c6c4ae5c6",
                                        "glosses": [
                                            "A loud, eager cry, usually of joy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d31a2f72-2dc8-4899-9610-0ca70599ca67",
                                                "sense_id": "33b5bc78-ac2b-37bd-9bdf-1473fb34bd09",
                                                "text": "Mixed with the whoop of the crane and the roar of the grim alligator."
                                            },
                                            {
                                                "example_id": "aaf627a9-7fbd-4969-96e3-d84a449313dc",
                                                "sense_id": "33b5bc78-ac2b-37bd-9bdf-1473fb34bd09",
                                                "text": "[A] great whoop of victory sounded as finally they carried the fish up the beach."
                                            },
                                            {
                                                "example_id": "1fd14d82-2656-4db3-9e36-404e02ac821e",
                                                "sense_id": "33b5bc78-ac2b-37bd-9bdf-1473fb34bd09",
                                                "text": "Lavender Hearts has often been stopped by the presence of some wild woman who just can't contain her whoop or moan. Now that's community!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "66437d6c-22f3-3892-af58-f143c93471e7",
                                        "entry_id": "0ed976b4-d218-3769-97ed-c94c6c4ae5c6",
                                        "glosses": [
                                            "A gasp, characteristic of whooping cough."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b2b3d850-3f55-3e73-a6f1-d66482d6435f",
                                        "entry_id": "0ed976b4-d218-3769-97ed-c94c6c4ae5c6",
                                        "glosses": [
                                            "A bump on a racetrack."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "edbd4a7c-fc9e-43dd-bc95-592ae2fe400c",
                                                "sense_id": "b2b3d850-3f55-3e73-a6f1-d66482d6435f",
                                                "text": "."
                                            },
                                            {
                                                "example_id": "11458c8b-05be-42f4-9c7a-328e59fef2ab",
                                                "sense_id": "b2b3d850-3f55-3e73-a6f1-d66482d6435f",
                                                "text": "The key to jamming through the whoops is to keep your weight to the back of the quad […] and keep the front wheels high […]"
                                            },
                                            {
                                                "example_id": "501b9151-c01b-441d-9ede-0e90d6610670",
                                                "sense_id": "b2b3d850-3f55-3e73-a6f1-d66482d6435f",
                                                "text": "The “98 MPH” sign used to be on a set of particularly vicious whoops at one of John's favorite racetracks."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "whoop",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7b21a725-2468-3cb8-b103-48d9a7584535",
                                        "entry_id": "d3986497-b17a-3aa9-893f-dae4e7e312aa",
                                        "glosses": [
                                            "To make a whoop."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ea0bb625-c36f-4d76-bab6-28b36a3982b1",
                                                "sense_id": "7b21a725-2468-3cb8-b103-48d9a7584535",
                                                "text": "each whooping with a merry shout"
                                            },
                                            {
                                                "example_id": "7e3483a5-6786-4be6-b49c-4948ae6881dc",
                                                "sense_id": "7b21a725-2468-3cb8-b103-48d9a7584535",
                                                "text": "When naught was heard but now and then the howl / Of some vile cur, or whooping of the owl."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "392f617a-a2d2-31da-99b7-f6bc9b0620d5",
                                        "entry_id": "d3986497-b17a-3aa9-893f-dae4e7e312aa",
                                        "glosses": [
                                            "To shout, to yell."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a120006d-7832-4198-b49f-32a6a5f68bb7",
                                                "sense_id": "392f617a-a2d2-31da-99b7-f6bc9b0620d5",
                                                "text": "I made a speaking trumpet of my hands and commenced to whoop “Ahoy!” and “Hello!” at the top of my lungs. […] The Colonel woke up, and, after asking what in brimstone was the matter, opened his mouth and roared “Hi!” and “Hello!” like the bull of Bashan."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "674f93e3-59fd-313d-9760-87f64e82478d",
                                        "entry_id": "d3986497-b17a-3aa9-893f-dae4e7e312aa",
                                        "glosses": [
                                            "To cough or breathe with a sonorous inspiration, as in whooping cough."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9d28cff7-1e18-3423-880f-d165b787b08d",
                                        "entry_id": "d3986497-b17a-3aa9-893f-dae4e7e312aa",
                                        "glosses": [
                                            "To insult with shouts; to chase with derision."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7ca35106-e1ef-4e1e-a8d3-6f7d198141d5",
                                                "sense_id": "9d28cff7-1e18-3423-880f-d165b787b08d",
                                                "text": "And suffered me by the voice of slaves to be / Whooped out of Rome."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
