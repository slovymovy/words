                "senses": [
                    {
                        "sense_id": "6132bc4b-16c0-3c05-b7f1-86548637e808",
                        "entry_id": "68b8c6d2-9cb9-3b2b-ad4c-3ed052ecf210",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "33390185-6ff1-45c2-9415-d9bab72933b6",
                                "sense_id": "6132bc4b-16c0-3c05-b7f1-86548637e808",
                                "text": "Frau Fränznick ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "d6fd1213-85c5-46ce-931a-5bc413c95186",
                                "sense_id": "6132bc4b-16c0-3c05-b7f1-86548637e808",
                                "text": "Herr Fränznick wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "22a8db4d-8d3b-454a-ad71-ab4148f210f5",
                                "sense_id": "6132bc4b-16c0-3c05-b7f1-86548637e808",
                                "text": "Die Fränznicks fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "268ecaf2-aaf0-49ec-9586-de2aadf753db",
                                "sense_id": "6132bc4b-16c0-3c05-b7f1-86548637e808",
                                "text": "Der Fränznick trägt nie die Schals, die die Fränznick ihm strickt."
                            },
                            {
                                "example_id": "54d9eed2-644b-462a-a678-fa8c8e151806",
                                "sense_id": "6132bc4b-16c0-3c05-b7f1-86548637e808",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Fränznick kommt, geht der Herr Fränznick.“"
                            },
                            {
                                "example_id": "aba4ecff-5656-4c47-85ae-dbac0c13dd54",
                                "sense_id": "6132bc4b-16c0-3c05-b7f1-86548637e808",
                                "text": "Fränznick kommt und geht."
                            },
                            {
                                "example_id": "2f857865-972f-4e17-be79-f00ea0ea9930",
                                "sense_id": "6132bc4b-16c0-3c05-b7f1-86548637e808",
                                "text": "Fränznicks kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
