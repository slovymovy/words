                    "frequency": "VeryLow",
                    "semantic_group_id": "rhetoric",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He would constantly <w>bombast</w> during debates to hide his complete lack of evidence."
                        },
                        {
                            "text": "Instead of answering simply, the candidate chose to <w>bombast</w> about honor."
                        }
