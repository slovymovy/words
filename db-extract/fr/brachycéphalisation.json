                "senses": [
                    {
                        "sense_id": "a2d50ba6-b94f-38da-8ea6-fb3e983dab78",
                        "entry_id": "71027b6f-eeab-362b-b80f-062738f04ffa",
                        "glosses": [
                            "Évolution de l'indice céphalique d'une population vers des crânes plus larges et arrondis."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df4f7d00-1fd6-4561-88c4-ac0516560272",
                                "sense_id": "a2d50ba6-b94f-38da-8ea6-fb3e983dab78",
                                "text": "Il suffit d'étudier la liste des groupes ethniques, constatant la brachycéphalisation, pour se rendre à l'évidence que l'élévation de l'indice céphalique n'est pas liée aux conditions exogènes, naturelles ou sociales."
                            },
                            {
                                "example_id": "7d212a4e-011e-406b-b208-a064647371bd",
                                "sense_id": "a2d50ba6-b94f-38da-8ea6-fb3e983dab78",
                                "text": "La tendance à la brachycéphalisation, notée dans beaucoup de groupes humains, ne représente sans doute qu'une accentuation à la fœtalisation, très générale chez l'homme et dont l'origine néoténique est probable."
                            }
                        ]
                    }
                ],
