                    },
                    {
                        "translation_id": "98ebeb0e-809e-417a-9a74-def89548bd67",
                        "source_entry_id": "70327b95-0008-368d-b080-d0289e36448b",
                        "source_sense_id": "745a50c0-a5ec-3452-8b15-fce4c4af33b4",
                        "target_lang_word": "thebanisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "thebanisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4e909e54-4a6a-3517-8e16-0cd35597e4bc",
                                        "entry_id": "505a8a8e-282a-342b-9a66-0a7f3c56a935",
                                        "glosses": [
                                            "zu Theben, zu den Thebaner gehörig; Theben, die Thebaner betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb656913-2d57-4ae9-bb29-bec167e949ba",
                                                "sense_id": "4e909e54-4a6a-3517-8e16-0cd35597e4bc",
                                                "text": "Und so ist auch das thebanische Epos ein sehr reiches, woran sich wieder die vielen Tragödien verwandten Ursprungs anschließen."
                                            },
                                            {
                                                "example_id": "f9cd4cd9-dc63-4f43-a429-1db7abf3d91b",
                                                "sense_id": "4e909e54-4a6a-3517-8e16-0cd35597e4bc",
                                                "text": "Nächst dem argivischen Herakles wurde immer der thebanische und boeotische für den ältesten und für den eigentlich griechischen gehalten."
                                            },
                                            {
                                                "example_id": "ee492dd3-73d0-479b-8ab7-ccd1724c1e29",
                                                "sense_id": "4e909e54-4a6a-3517-8e16-0cd35597e4bc",
                                                "text": "Polyneikes erzählte nun seine Verjagung durch den Bruder, seine Aufnahme beim König Adrastos in Argos, der ihm die Tochter zur Gemahlin gab, und wie er dort sieben Fürsten mit siebenfacher Schar für seine gerechte Sache geworben habe und diese Bundesgenossen das thebanische Gebiet bereits umringt hätten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f09f8bde-89c3-4a0b-bd9e-e2e8bfffc115",
