                        "examples": [
                            {
                                "example_id": "dd1dab42-8c98-4402-912d-5e9ee71183c3",
                                "sense_id": "52a655f7-18df-3437-b299-f0d799e3bae8",
                                "text": "Het moet een eigenaardig gezicht zijn voor de spaarzame wandelaars op het Pieterpad die de regen trotseren: vijf mannen met paraplu's, die gebogen over een akker op de Kollenberg bij Sittard lopen op zoek naar iets. Dat iets is een burcht van een korenwolf (officiële naam: Cricetus cricetus, Europese hamster)."
                            },
                            {
                                "example_id": "6cfdf142-ef4e-4e52-98c4-fab8b5fe5884",
                                "sense_id": "52a655f7-18df-3437-b299-f0d799e3bae8",
                                "text": "Bekende Nederlanders brengen de nacht door in een caravan om te protesteren tegen het uitsterven van de korenwolf."
                            }
                        ]
