                                "example_id": "2c969a31-43a7-44f1-8983-33060586a4c2",
                                "sense_id": "4220c588-8e90-3552-8bc6-2f766c86ee6a",
                                "text": "Rotterdam ist heute der wichtigste Umschlagplatz für Seehandelsgüter an der Nordsee."
                            },
                            {
                                "example_id": "2fb5be2a-ac2a-476c-8e2a-81140fec264b",
                                "sense_id": "4220c588-8e90-3552-8bc6-2f766c86ee6a",
                                "text": "„Rotterdam am Maasfluß ist eine große Stadt, von Kanälen durchzogen, die sie dort Grachten nennen, welche viel als Schiffshäfen benutzt werden.“"
                            }
                        ],
