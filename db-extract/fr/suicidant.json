                    {
                        "sense_id": "74cddd22-4fd1-3df6-a456-078fe97e93aa",
                        "entry_id": "22f9a538-b0f2-3863-af12-a3735fb8148e",
                        "glosses": [
                            "Qui a tenté de se suicider."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1894731a-bddb-4a27-acb6-87794c73d94d",
                                "sense_id": "74cddd22-4fd1-3df6-a456-078fe97e93aa",
                                "text": "Tout adolescent suicidant doit être adressé aux urgences d’un établissement de soins, où cette triple évaluation sera commencée."
                            },
                            {
                                "example_id": "3b3c709c-16d3-4b8a-bb4f-04828cb9933c",
                                "sense_id": "74cddd22-4fd1-3df6-a456-078fe97e93aa",
                                "text": "Il est important, tout en prônant l’ouverture de la consultation et en prenant en compte le cheminement du jeune suicidant et de ses proches, de s’assurer d’être un « conteneur actif » de la destructivité."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "849822ca-9b92-350f-89ce-39b80443922d",
