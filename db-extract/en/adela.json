                                                "sense_id": "83e49586-d3d4-3c98-b2c4-5e322bb92c91",
                                                "text": "Vous connaissez Adèle, Adèle Pigasse de son vrai nom, celle qui louche un peu et qui fait le tapin au coin de la rue…"
                                            },
                                            {
                                                "example_id": "edc8937c-52c1-4ac0-b112-2235951441d4",
                                                "sense_id": "83e49586-d3d4-3c98-b2c4-5e322bb92c91",
                                                "text": "Adèle, ni haine, ni rancune\n Si ta chance chancelle\n Un clin d’œil à la lune\n Un baiser vers le ciel\n Adèle!"
                                            },
                                            {
                                                "example_id": "4db28369-f525-434f-9e94-d19879cbe171",
                                                "sense_id": "83e49586-d3d4-3c98-b2c4-5e322bb92c91",
                                                "text": "Karine Tuil publie Kaddish pour un amour, Adèle Van Reeth, elle, est invitée pour Inconsolable."
                                            },
                                            {
                                                "example_id": "07d5d6b9-ff86-4773-9798-b1fe6754928b",
                                                "sense_id": "83e49586-d3d4-3c98-b2c4-5e322bb92c91",
                                                "text": "Adèle Le Berre a déjà eu plusieurs vies."
                                            }
