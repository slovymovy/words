                                "target_senses": [
                                    {
                                        "sense_id": "4c18ca52-0d72-341b-bb8d-39a139429a4b",
                                        "entry_id": "0cfb0e44-b8bd-358b-8c4b-c60210ccc1c3",
                                        "glosses": [
                                            "A native or inhabitant of Wallonia."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f8dde00a-beb8-4b72-b512-ee5cc4b8eeef",
                                                "sense_id": "4c18ca52-0d72-341b-bb8d-39a139429a4b",
                                                "text": "when I was young I did seeke to serue, both in England, Fraunce, and Scotland, to that end I might the better doo my Prince and Countrye seruice, and also to sustaine myselfe, who otherwaies was not able to liue as I did desire to doo: wheras I learned to know the vse of most weapons of warre both for Horsemen and footmen, that are or haue beene vsed in this age, with as good Schoolemaisters as any Italian, Spaniard or Wallon whatsoeuer, hath been or now is."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f3f16ee-bd54-37d4-b63e-081c3ab304b2",
                                        "entry_id": "0cfb0e44-b8bd-358b-8c4b-c60210ccc1c3",
                                        "glosses": [
                                            "A speaker of Walloon (as above)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
