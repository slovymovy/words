                                        "examples": [
                                            {
                                                "example_id": "01c69cf7-e5f7-4e57-8c6a-e3102ad59b1c",
                                                "sense_id": "00bba7b2-2cbb-3949-9795-c4153e4efb6f",
                                                "text": "Die Philokartie erfreute sich Anfang des 20. Jahrhunderts großer Beliebtheit."
                                            },
                                            {
                                                "example_id": "287d1f33-9998-431a-a912-1d67a91f820b",
                                                "sense_id": "00bba7b2-2cbb-3949-9795-c4153e4efb6f",
                                                "text": "„Durch vielerlei Belange bedingt, setzte nach 1918 ein Niedergang der Philokartie ein, der hier nicht näher behandelt werden kann.“"
                                            },
                                            {
                                                "example_id": "ed890ebf-d499-4a8d-916c-19f361753646",
                                                "sense_id": "00bba7b2-2cbb-3949-9795-c4153e4efb6f",
                                                "text": "„So sehen viele die Philokartie auch als einen Teil der Philatelie – was naheliegt, denn postalisch gelaufene Postkarten sind philatelistisch interessante Belege mit Frankatur und postalischer Stempelung.“"
                                            }
