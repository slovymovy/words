                        "glosses": [
                            "Changer la phonétique de."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "93e5f340-72dc-497b-8a31-eaca5d440eed",
                                "sense_id": "e76e5931-9277-3f7c-9b66-475d15929951",
                                "text": "Le mot pipe-line, emprunté, d'après Le Robert, en 1887, et totalement assimilé avec la prononciation correspondant à sa graphie, tend depuis quelques années à être presque toujours rephonétisé à la manière anglaise, les deux i étant prononcés aille."
                            },
                            {
                                "example_id": "7c561c06-f1bc-43e3-a821-2a5bcd70ab67",
                                "sense_id": "e76e5931-9277-3f7c-9b66-475d15929951",
                                "text": "Cette évolution naturelle semble d'ailleurs être arrêtée par une tendance plus récente qui consiste à rephonétiser des mots à la manière anglaise."
                            }
                        ]
                    }
