                        "source_sense_id": "ff375e8c-7ec1-3631-99fb-30aee91a29c8",
                        "source_sense_description": "unerhört, außerordentlich, ungewöhnlich, unverschämt",
                        "target_lang_word": "außerordentlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "außerordentlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a78f3ffa-1f94-331c-965a-0d73184c9d68",
                                        "entry_id": "33847154-17a8-3714-896b-0cb75ec36fb9",
                                        "glosses": [
                                            "sich heraushebend, absetzend; außergewöhnlich, ungewöhnlich, überdurchschnittlich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af647980-53d2-46e8-bf20-9a9ee075b667",
                                                "sense_id": "a78f3ffa-1f94-331c-965a-0d73184c9d68",
                                                "text": "Das ist eine außerordentliche Leistung."
                                            },
                                            {
                                                "example_id": "016dfc3b-3df9-40c1-b524-2290a50b1bdc",
                                                "sense_id": "a78f3ffa-1f94-331c-965a-0d73184c9d68",
                                                "text": "„Der Machtbereich der askanischen Markgrafen hatte sich seit der Mitte des 13. Jahrhunderts außerordentlich erweitert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "cf0aa54a-40e1-36e9-a983-6ad935139f88",
                                        "entry_id": "33847154-17a8-3714-896b-0cb75ec36fb9",
                                        "glosses": [
                                            "sehr, viel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2316ba36-ac84-4a05-89f4-3588c7b85367",
                                                "sense_id": "cf0aa54a-40e1-36e9-a983-6ad935139f88",
                                                "text": "Das Essen war außerordentlich lecker."
                                            },
                                            {
                                                "example_id": "a4dfbf1c-4d1f-4305-a2e5-8bc02a0a0dce",
                                                "sense_id": "cf0aa54a-40e1-36e9-a983-6ad935139f88",
                                                "text": "„Die wirkliche Bahn des Mondes ist außerordentlich kompliziert, da er sich mit der Erde um die Sonne bewegt und auch unser Sonnensystem als Ganzes nicht ruht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "65c3a97e-8f72-37b9-a2dd-5795015b5d40",
                                        "entry_id": "33847154-17a8-3714-896b-0cb75ec36fb9",
                                        "glosses": [
                                            "außerhalb einer verfassten Ordnung liegend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2eeda2ef-4a7b-4658-a9a3-c97780e11777",
                                                "sense_id": "65c3a97e-8f72-37b9-a2dd-5795015b5d40",
                                                "text": "Ein außerordentlicher Professor."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eb35cf1d-9abe-4d78-9e7a-8fce2057649e",
                        "source_entry_id": "288aa0d8-1a4d-3585-bd20-c9f747bcb7aa",
                        "source_sense_id": "ff375e8c-7ec1-3631-99fb-30aee91a29c8",
                        "source_sense_description": "unerhört, außerordentlich, ungewöhnlich, unverschämt",
                        "target_lang_word": "ungewöhnlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ungewöhnlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a0829c8c-8e78-3718-9b39-4a0880a84d57",
                                        "entry_id": "d558a056-9765-32fb-abcf-008daa80df73",
                                        "glosses": [
                                            "nicht gewöhnlich, nicht der Gewohnheit entsprechend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3ddf01c-63b6-4531-acc4-ab87866ab722",
                                                "sense_id": "a0829c8c-8e78-3718-9b39-4a0880a84d57",
                                                "text": "Ungewöhnliche Zeiten erfordern ungewöhnliches Handeln."
                                            },
                                            {
                                                "example_id": "8ee19457-0104-4db1-ba7b-f1bf4d5cf5ad",
                                                "sense_id": "a0829c8c-8e78-3718-9b39-4a0880a84d57",
                                                "text": "„Ausgerechnet Neuseeland, dessen Einwohner sich nach einem flugunfähigen Vogel stolz Kiwis nennen, hat sich diesem ungewöhnlichen Flugsport verschrieben.“"
                                            },
                                            {
                                                "example_id": "94b0dd82-a208-4b55-91a6-beb7480c5d26",
                                                "sense_id": "a0829c8c-8e78-3718-9b39-4a0880a84d57",
                                                "text": "Am ungewöhnlichsten jedoch war ihre Art zu laufen."
                                            },
                                            {
                                                "example_id": "6b05cb6a-5499-45eb-9df7-7e1b876bc456",
                                                "sense_id": "a0829c8c-8e78-3718-9b39-4a0880a84d57",
                                                "text": "„Wie reagiert die Psyche des Straßenbahnkondukteurs auf ein Douceur von ungewöhnlichem Ausmaße, das zum Beispiel mehr als dreimal so groß ist als der Fahrpreis und siebenmal so groß als das Normaltrinkgeld!“"
                                            },
                                            {
                                                "example_id": "74dbb13f-c556-49ce-a05a-1667ff695ef4",
                                                "sense_id": "a0829c8c-8e78-3718-9b39-4a0880a84d57",
                                                "text": "Auf einer Pressekonferenz erklärte der US-Präsident [Donald Trump], dass er ein Treffen mit dem kanadischen Premierminister Justin Trudeau […] ausgeschlagen habe. Ungewöhnlich ist, dass ein amtierender Präsident dies öffentlich sagt. Besonders ungewöhnlich ist, dass Kanada gar nicht um das Treffen gebeten hatte. Dies teilte Trudeaus Sprecherin im Anschluss mit."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0acdb6db-b560-4d60-8fa0-39b2f14e83f3",
                        "source_entry_id": "288aa0d8-1a4d-3585-bd20-c9f747bcb7aa",
                        "source_sense_id": "ff375e8c-7ec1-3631-99fb-30aee91a29c8",
                        "source_sense_description": "unerhört, außerordentlich, ungewöhnlich, unverschämt",
                        "target_lang_word": "unverschämt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unverschämt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7fef6f47-976b-3d1e-9f20-10beadeba33b",
                                        "entry_id": "5555604c-9737-31c1-b457-9b365d68e045",
                                        "glosses": [
                                            "im Verhalten und in den Äußerungen provozierend und/oder auch aggressiv"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09ed7b73-5f57-4a55-bec4-b3e8a90509a7",
                                                "sense_id": "7fef6f47-976b-3d1e-9f20-10beadeba33b",
                                                "text": "Das ist ein unverschämter Angriff gegen die gesamte Stadt und schadet dem Wirtschaftsstandort Köln."
                                            },
                                            {
                                                "example_id": "6c99ab81-7937-4449-a687-2d8f7466c46d",
                                                "sense_id": "7fef6f47-976b-3d1e-9f20-10beadeba33b",
                                                "text": "Werd bloß nicht unverschämt!"
                                            },
                                            {
                                                "example_id": "1ed31b8e-29d1-44c8-b75d-b3276225d134",
                                                "sense_id": "7fef6f47-976b-3d1e-9f20-10beadeba33b",
                                                "text": "„In Amerika hingegen ist der Depp in unverschämter Weise stolz auf seine Dummheit, so sehr, dass er letztlich zum Führer politischer Diskurse und ideologisch dominanter Fraktionen einer ganzen Partei werden kann.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "844f82de-e1dd-3c37-991f-772fda20aeb6",
                                        "entry_id": "5555604c-9737-31c1-b457-9b365d68e045",
                                        "glosses": [
                                            "verstärkend, betonend, hervorhebend: über ein übliches Maß hinausgehend, sehr groß/intensiv; übermäßig, überaus, sehr, allzu"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "acd7a2d6-2586-4599-8066-9224531c146d",
                                                "sense_id": "844f82de-e1dd-3c37-991f-772fda20aeb6",
                                                "text": "Du hast unverschämt viel Glück."
                                            },
                                            {
                                                "example_id": "8bf8e22c-7313-4158-8364-2eceeddea44e",
                                                "sense_id": "844f82de-e1dd-3c37-991f-772fda20aeb6",
                                                "text": "Das ist unverschämt teuer."
                                            },
                                            {
                                                "example_id": "0bf63e29-b186-462f-a7ec-2f70ce13228b",
                                                "sense_id": "844f82de-e1dd-3c37-991f-772fda20aeb6",
                                                "text": "Du siehst unverschämt gut aus."
                                            },
                                            {
                                                "example_id": "a7ebf312-1331-46f0-ada2-8b8d8d6c2cf0",
                                                "sense_id": "844f82de-e1dd-3c37-991f-772fda20aeb6",
                                                "text": "„Die fragmentierende, auch unverschämt komische, halsbrecherisch Töne und Themen konfrontierende Technik Hemons verstärkt seinen kräftigen Appell, den der Muslim Rora ausspricht: Diesseits des Bildes zu bleiben.“"
                                            },
                                            {
                                                "example_id": "5c329984-6c78-4066-adcf-04e58b2e51df",
                                                "sense_id": "844f82de-e1dd-3c37-991f-772fda20aeb6",
                                                "text": "»Da haben Sie unverschämtes Glück gehabt, dass mein Kollege die Dame oder Sie offenbar kennt!«"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "d5cc8e94-23e9-369f-8c66-918ffd29d37c",
                                        "entry_id": "5555604c-9737-31c1-b457-9b365d68e045",
                                        "glosses": [
                                            "sich sittlich und moralisch nicht gesellschaftskonform verhaltend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87c023cd-9827-4ea8-b1ea-fd9331d9f129",
                                                "sense_id": "d5cc8e94-23e9-369f-8c66-918ffd29d37c",
                                                "text": "Dieses Mädchen zeigt sich unverschämt, es schämt sich nicht im geringsten mit der Entblößung ihres Busens und ihrer Waden."
                                            },
                                            {
                                                "example_id": "6aa4b863-7f60-44d8-a631-79ecda53f036",
                                                "sense_id": "d5cc8e94-23e9-369f-8c66-918ffd29d37c",
                                                "text": "Das Fräulein ist eine verwöhnte und unverschämte Göre, die allen schöne Augen macht."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    }
