                "senses": [
                    {
                        "sense_id": "bb313633-78df-39d9-bd4f-bb6e763f274e",
                        "entry_id": "795fd8a7-0aac-314e-8551-f935046535b7",
                        "glosses": [
                            "harvest moon"
                        ],
                        "tags": [
                            "Northern-Germany",
                            "masculine",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "4b8df3e1-f28c-406b-8edb-b777bba70e10",
                                "sense_id": "bb313633-78df-39d9-bd4f-bb6e763f274e",
                                "text": "Der Erntemond stieg langsam über einer Gruppe düsterer Föhren empor und strahlte seinen unbeschreiblichen Zauber in die ruhende leuchtende Nacht aus.",
                                "translation": "The harvest-moon rose slowly from a copse of gloomy firs, and diffused its own unspeakable magic into the hush and transparency of the night.",
                                "english": "The harvest-moon rose slowly from a copse of gloomy firs, and diffused its own unspeakable magic into the hush and transparency of the night."
                            },
                            {
                                "example_id": "adf742e9-c5a0-42fe-9f7e-caea8e2f89ef",
                                "sense_id": "bb313633-78df-39d9-bd4f-bb6e763f274e",
                                "text": "Sein Haupt war so kahl und rund und rot wie der Erntemond zur Rebenlese."
                            },
                            {
                                "example_id": "87c25aa1-1e0c-47a3-9232-a706baf4cf64",
                                "sense_id": "bb313633-78df-39d9-bd4f-bb6e763f274e",
                                "text": "Es herbstelt schon / der Erntemond / strahlt hell vor meinem Fenster"
                            }
                        ]
                    },
                    {
                        "sense_id": "4911caf6-3c83-318b-bac8-5ef8095107be",
                        "entry_id": "795fd8a7-0aac-314e-8551-f935046535b7",
                        "glosses": [
                            "August"
                        ],
                        "tags": [
                            "dated",
                            "masculine",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "db5c53f8-315d-4b4a-95c1-05991835fb13",
                                "sense_id": "4911caf6-3c83-318b-bac8-5ef8095107be",
                                "text": "Und nun kommt der Erntemond und mit ihm die Einführung auch des jüngsten in die himmlischen Scheunen."
                            }
                        ]
                    }
