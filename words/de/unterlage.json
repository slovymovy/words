                    "frequency": "VeryLow",
                    "semantic_group_id": "botanik",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Für die Veredelung der Apfelbäume wählte der Gärtner eine robuste <w>Unterlage</w>.",
