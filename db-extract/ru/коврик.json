                "translations": [
                    {
                        "translation_id": "a6509d8b-8fff-435c-8640-930097195c65",
                        "source_entry_id": "3f3a6b37-5609-35c0-8708-ecdcdf4150a5",
                        "target_lang_word": "rug",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rug",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "656368cc-2ee7-32ae-8e82-c6e7d68baf54",
                                        "entry_id": "b922dc5b-fe27-3197-ac87-88d6207011d3",
                                        "glosses": [
                                            "A partial covering for a floor."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f5c1fec0-97c1-3405-9d18-9403ca6eaf90",
                                        "entry_id": "b922dc5b-fe27-3197-ac87-88d6207011d3",
                                        "glosses": [
                                            "A (usually thick) piece of fabric used for warmth (especially on a bed); a blanket."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f4df88cf-3152-4832-a0ca-6b370cfa3664",
                                                "sense_id": "f5c1fec0-97c1-3405-9d18-9403ca6eaf90",
                                                "text": "They then cut down a quantity of gum-tree leaves for a bed, and threw their rugs upon them ready for bed-time."
                                            },
                                            {
                                                "example_id": "7d297aa4-b0a1-4fa3-8cee-3e56e94cde32",
                                                "sense_id": "f5c1fec0-97c1-3405-9d18-9403ca6eaf90",
                                                "text": "Furnish every sleeping apartment with a sufficient number of toilet utensils and bedsteads, and sufficient bedding so that each bed shall be provided with a mattress, two sheets, a rug, and, in winter time, not less than one additional rug."
                                            },
                                            {
                                                "example_id": "c28b14a5-6974-4c5c-80a7-b12259e94efd",
                                                "sense_id": "f5c1fec0-97c1-3405-9d18-9403ca6eaf90",
                                                "text": "1950 April, Dental Journal of Australia, Volume 22, page 181,\nMy own son had a bunny rug of which he was very fond and on being put to bed he would always demand his “bunny rug to suck his finger with.″"
                                            },
                                            {
                                                "example_id": "f8955794-294f-4ccc-8449-a87659f47eb7",
                                                "sense_id": "f5c1fec0-97c1-3405-9d18-9403ca6eaf90",
                                                "text": "1958, Arthur Hailey, John Castle. Runway Zero-Eight. Bantham Books\nShe tucked in a rug round the woman. “How’s that?” The woman nodded gratefully."
                                            },
                                            {
                                                "example_id": "3694a65f-f923-4a82-908d-6a52341b3a22",
                                                "sense_id": "f5c1fec0-97c1-3405-9d18-9403ca6eaf90",
                                                "text": "He brought with him a rug and a sheet, and lay down by the fire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e41c1108-39fa-3439-8cff-87a7876cf2cf",
                                        "entry_id": "b922dc5b-fe27-3197-ac87-88d6207011d3",
                                        "glosses": [
                                            "A kind of coarse, heavy frieze, formerly used for clothing."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6891c612-eaa8-4cc5-a849-b596e5fa1a05",
                                                "sense_id": "e41c1108-39fa-3439-8cff-87a7876cf2cf",
                                                "text": "They spin the choicest rug in Ireland. A friend of mine […] repaired to Paris Garden clad in one of these Waterford rugs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6fb825e0-db70-3698-8ebe-36308a7f3d38",
                                        "entry_id": "b922dc5b-fe27-3197-ac87-88d6207011d3",
                                        "glosses": [
                                            "A cloak or mantle made of such a frieze."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "db6637a6-8f32-3cfd-8891-9652e1777979",
                                        "entry_id": "b922dc5b-fe27-3197-ac87-88d6207011d3",
                                        "glosses": [
                                            "A person wearing a rug."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "rare"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "04af212d-2920-32ba-ae7e-d48f9f5194aa",
                                        "entry_id": "b922dc5b-fe27-3197-ac87-88d6207011d3",
                                        "glosses": [
                                            "A cloth covering for a horse."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fbb617ee-02ce-38bc-b743-6342226f7258",
                                        "entry_id": "b922dc5b-fe27-3197-ac87-88d6207011d3",
