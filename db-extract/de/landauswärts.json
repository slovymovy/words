                    },
                    {
                        "translation_id": "458630b5-49f1-4d35-84a0-df673e2931e5",
                        "source_entry_id": "ba3bc662-c239-311d-b78d-481716dbfb62",
                        "source_sense_id": "7be17fed-11c6-37ef-b315-0b57231bb859",
                        "source_sense_description": "vom Landesinneren in Richtung auf die Küste, die Landesgrenze; aus dem Land hinaus",
                        "target_lang_word": "seaward",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "seaward",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a473aca8-ae07-3b33-8a2c-fc52287d1eeb",
                                        "entry_id": "c6521062-6b1d-3b6e-98b5-0ccfd73981ec",
                                        "glosses": [
                                            "Being in or facing towards the sea, as opposed to the land."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a4c5ab2c-09c0-4ec8-bb1e-8c5e3fc312bd",
                                                "sense_id": "a473aca8-ae07-3b33-8a2c-fc52287d1eeb",
                                                "text": "The landward side of the fort faced more dangerous guns than the seaward side, which only faced what could be put on a ship."
                                            },
                                            {
                                                "example_id": "a11e846e-fafc-4f46-b089-e949f1e52a91",
                                                "sense_id": "a473aca8-ae07-3b33-8a2c-fc52287d1eeb",
                                                "text": "Following service in the First World War, when it was leased by the Admiralty, it suffered a swift decline. And despite reconstruction efforts, concerns about its safety were raised in the 1930s and its seaward portion was demolished in the 1940s."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "seaward",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "062c87f7-0ad3-36e2-b068-bdaa5950a65d",
                                        "entry_id": "207019e5-875c-3f88-9f96-b627cf0d7816",
                                        "glosses": [
                                            "In the direction of the sea, toward the sea."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "475b1eed-d722-46de-9d0d-e0441e36caf5",
                                                "sense_id": "062c87f7-0ad3-36e2-b068-bdaa5950a65d",
                                                "text": "Ever the sailor's widow looked seaward, hoping to see her missing man coming home."
                                            },
                                            {
                                                "example_id": "9757665f-1f5e-47eb-86df-7de2db710293",
                                                "sense_id": "062c87f7-0ad3-36e2-b068-bdaa5950a65d",
                                                "text": "He and Gerald usually challenged the rollers in a sponson canoe when Gerald was there for the weekend; or, when Lansing came down, the two took long swims seaward or cruised about in Gerald's dory, clad in their swimming-suits; and Selwyn's youth became renewed in a manner almost ridiculous,[…]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "15bc958b-7aa7-4215-85fb-f194dc24bf9e",
                        "source_entry_id": "ba3bc662-c239-311d-b78d-481716dbfb62",
                        "source_sense_id": "7be17fed-11c6-37ef-b315-0b57231bb859",
                        "source_sense_description": "vom Landesinneren in Richtung auf die Küste, die Landesgrenze; aus dem Land hinaus",
