                "senses": [
                    {
                        "sense_id": "de76820c-7722-3f95-b9ad-6a77abf47b2f",
                        "entry_id": "54802340-b258-30d2-86ff-6734d3750b6e",
                        "glosses": [
                            "Débloquer (un écrou, etc.) pour pouvoir le retirer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a8e99ba1-f85e-4745-a01f-c1ce4bdd6804",
                                "sense_id": "de76820c-7722-3f95-b9ad-6a77abf47b2f",
                                "text": "Défreiner l’écrou en \"dépliant\" la partie enfoncée dans la petite cavité (un gros clou ou un tournevis fait l’affaire) puis dévisser l’écrou et retirer la rondelle."
                            },
                            {
                                "example_id": "839cefb2-65db-418d-b41c-fbebf44c7867",
                                "sense_id": "de76820c-7722-3f95-b9ad-6a77abf47b2f",
                                "text": "bonsoir, quelqu’un pourrait il me dire comment défreiner et retirer le roulement pour détacher la boite des lentes de la boite de vitesse série G"
                            }
                        ]
                    },
                    {
                        "sense_id": "e85a6ce6-01b0-386d-917a-a1d989432012",
                        "entry_id": "54802340-b258-30d2-86ff-6734d3750b6e",
                        "glosses": [
                            "Cesser de freiner."
                        ],
                        "tags": [],
                        "examples": [
