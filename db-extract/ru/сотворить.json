                    }
                ],
                "senses": [
                    {
                        "sense_id": "133f3132-ec19-3146-9f06-5009254a704e",
                        "entry_id": "6057701d-0fdf-355d-8572-11af8949228c",
                        "glosses": [
                            "совершить, осуществить, сделать"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "3080cc78-0072-3e5d-9210-9c6cf078ee17",
                        "entry_id": "6057701d-0fdf-355d-8572-11af8949228c",
                        "glosses": [
                            "создать в процессе творчества"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "951ac127-0273-49e9-bb7a-16c9048b820b",
                                "sense_id": "3080cc78-0072-3e5d-9210-9c6cf078ee17",
                                "text": "Женщина может многое и хоть она сотворена из ребра мужчины, ей дано право хранить неугасающий огонь семейного очага, быть мудрее и хитрее, чем мужчина."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bff65514-b479-486b-b2bd-97a007dbb208",
                        "source_entry_id": "6057701d-0fdf-355d-8572-11af8949228c",
                        "target_lang_word": "create",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "create",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f6869810-279a-3fcc-8a75-0e778537244b",
                                        "entry_id": "c878420c-43fe-33ab-a8d2-e52a510decfb",
                                        "glosses": [
                                            "To bring into existence; (sometimes in particular:)"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ac7b3ee1-00f8-466e-973d-bce2d9a9d1ef",
                                                "sense_id": "f6869810-279a-3fcc-8a75-0e778537244b",
                                                "text": "You can create the color orange by mixing yellow and red."
                                            },
                                            {
                                                "example_id": "f5995832-6132-4953-b68d-79039de7e669",
                                                "sense_id": "f6869810-279a-3fcc-8a75-0e778537244b",
                                                "text": "… God created man a moral agent."
                                            },
                                            {
                                                "example_id": "001e4caf-e284-4baa-ba7c-34ea18e213e5",
                                                "sense_id": "f6869810-279a-3fcc-8a75-0e778537244b",
                                                "text": "Creating a complete map of the human connectome would therefore be a monumental milestone but not the end of the journey to understanding how our brains work."
                                            },
                                            {
                                                "example_id": "89f113ff-307b-429b-af29-b4ccde6ec32b",
                                                "sense_id": "f6869810-279a-3fcc-8a75-0e778537244b",
                                                "text": "The dirty secret of the internet is that all this distraction and interruption is immensely profitable. Web companies like to boast about \"creating compelling content\", […] \"share the things you love with the world\" and so on. But the real way to build a successful online business is to be better than your rivals at undermining people's control of their own attention."
                                            },
                                            {
                                                "example_id": "8d2bb684-ca89-4140-b1a7-544b7308983d",
                                                "sense_id": "f6869810-279a-3fcc-8a75-0e778537244b",
                                                "text": "When an ultrasonic beam is fired at the microcannons, the emulsion evaporates, expanding rapidly into gas. This creates enough force to push the nanobullets out at velocities reaching several metres per second."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5b9222f0-d55e-3bdb-8ce6-db0af4a9369b",
                                        "entry_id": "c878420c-43fe-33ab-a8d2-e52a510decfb",
                                        "glosses": [
                                            "To bring into existence; (sometimes in particular:)",
                                            "To bring into existence out of nothing, without the prior existence of the materials or elements used."
                                        ],
                                        "tags": [
                                            "especially",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d33afbc-0371-489b-a5c4-11caf29147d1",
                                                "sense_id": "5b9222f0-d55e-3bdb-8ce6-db0af4a9369b",
                                                "text": "In the beginning God created yᵉ heauen and the earth. And the earth was without forme & voyde, and darkenes was vpon the depe, & the Spirit of God moued vpon the waters."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7debb76f-4425-3c53-af46-637fc7d0217f",
                                        "entry_id": "c878420c-43fe-33ab-a8d2-e52a510decfb",
                                        "glosses": [
                                            "To bring into existence; (sometimes in particular:)",
                                            "To make or produce from other (e.g. raw, unrefined or scattered) materials or combinable elements or ideas; to design or invest with a new form, shape, function, etc."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6515d972-b308-4f17-88c5-8e66a8dd84da",
                                                "sense_id": "7debb76f-4425-3c53-af46-637fc7d0217f",
                                                "text": "Couturiers create exclusive garments for an affluent clientele."
                                            },
                                            {
                                                "example_id": "b74087ac-fbaa-436a-b36a-c57d14004f6a",
                                                "sense_id": "7debb76f-4425-3c53-af46-637fc7d0217f",
                                                "text": "From the ground, Colombo’s port does not look like much.[…] But viewed from high up in one of the growing number of skyscrapers in Sri Lanka’s capital, it is clear that something extraordinary is happening: China is creating a shipping hub just 200 miles from India’s southern tip."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "29eae321-32e6-3a37-9f56-43b316ecd71c",
                                        "entry_id": "c878420c-43fe-33ab-a8d2-e52a510decfb",
                                        "glosses": [
                                            "To cause, to bring (a non-object) about by an action, behavior, or event, to occasion."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d0c8970e-855b-451d-8a1d-42e62b0824b0",
                                                "sense_id": "29eae321-32e6-3a37-9f56-43b316ecd71c",
                                                "text": "crop failures created food shortages and high prices; his stubbornness created many difficulties"
                                            },
                                            {
                                                "example_id": "a8612c25-c7fc-468d-ad08-393106c10a74",
                                                "sense_id": "29eae321-32e6-3a37-9f56-43b316ecd71c",
                                                "text": "A sudden chemical spill on the highway created a chain‐collision which created a record traffic jam."
                                            },
                                            {
                                                "example_id": "a376112f-72c4-4d8e-87bb-e867ee498810",
                                                "sense_id": "29eae321-32e6-3a37-9f56-43b316ecd71c",
                                                "text": "The turmoil went on—no rest, no peace. […] It was nearly eleven o'clock now, and he strolled out again. In the little fair created by the costers' barrows the evening only seemed beginning; and the naphtha flares made one's eyes ache, the men's voices grated harshly, and the girls' faces saddened one."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "41a1f6ba-0b6d-3832-a46a-23886ca037d2",
                                        "entry_id": "c878420c-43fe-33ab-a8d2-e52a510decfb",
                                        "glosses": [
                                            "To confer or invest with a rank or title of nobility, to appoint, ordain or constitute."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3563a65c-2aac-4091-9c7a-374d0309e389",
                                                "sense_id": "41a1f6ba-0b6d-3832-a46a-23886ca037d2",
                                                "text": "Henry VIII created him a Duke. Last month, the queen created two barons."
                                            },
                                            {
                                                "example_id": "55869963-2325-4b90-9eb0-909e4765e9c7",
                                                "sense_id": "41a1f6ba-0b6d-3832-a46a-23886ca037d2",
                                                "text": "Under the concordate with Belgium, at least one Belgian clergyman must be created cardinal; by tradition, every archbishop of Mechelen is thus created a cardinal."
                                            },
                                            {
                                                "example_id": "93bd21f6-66f5-47b5-b854-6a9972663acd",
                                                "sense_id": "41a1f6ba-0b6d-3832-a46a-23886ca037d2",
                                                "text": "Create him Prorex of Affrica,\nThat he may win the Babilonians hearts,\nWhich will reuolt from Perſean gouernment,\nUnleſſe they haue a wiſer King than you."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "efea0f17-a92d-3448-b3c6-f95cd6ed75ae",
                                        "entry_id": "c878420c-43fe-33ab-a8d2-e52a510decfb",
                                        "glosses": [
                                            "To be or do something creative, imaginative, originative."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ee4a6a5-a06b-4e6f-b3f6-0364e45e821a",
                                                "sense_id": "efea0f17-a92d-3448-b3c6-f95cd6ed75ae",
                                                "text": "Children usually enjoy creating, never mind if it is of any use!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "54f1beca-5172-3835-b4d6-740f51a5fff3",
                                        "entry_id": "c878420c-43fe-33ab-a8d2-e52a510decfb",
                                        "glosses": [
                                            "In theatre, to be the first performer of a role; to originate a character."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bbf77718-fc82-37e6-b8d6-16ed1488a464",
                                        "entry_id": "c878420c-43fe-33ab-a8d2-e52a510decfb",
                                        "glosses": [
                                            "To make a fuss, complain; to shout."
                                        ],
                                        "tags": [
                                            "UK",
                                            "colloquial",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c70c5895-ecb1-42df-925e-3900632d33ba",
                                                "sense_id": "bbf77718-fc82-37e6-b8d6-16ed1488a464",
                                                "text": "'What's the time?' she said. 'I must fly. Miss'll start creating.'"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "create",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5a7e1b47-e007-36f4-a375-7c6748c9ee83",
                                        "entry_id": "9bcf1d79-e85a-3ddf-95d0-f704195d6561",
                                        "glosses": [
                                            "Created, resulting from creation."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7491db1c-cf29-4249-b000-7322104402e7",
                                                "sense_id": "5a7e1b47-e007-36f4-a375-7c6748c9ee83",
                                                "text": "Hearts create of duty and zeal."
                                            },
                                            {
                                                "example_id": "b5ff31ba-ddd0-4ccc-8c29-33f37e80dce8",
                                                "sense_id": "5a7e1b47-e007-36f4-a375-7c6748c9ee83",
                                                "text": "Before me things create were none, save things / Eternal, and eternal I endure. / All hope abandon ye who enter here. [Inscription on the gate of Hell.]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
