                        "source_sense_id": "96b5b4b7-5573-3fb7-8d59-8a226e837e64",
                        "target_lang_word": "seaman",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "seaman",
