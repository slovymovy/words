                "senses": [
                    {
                        "sense_id": "6fb82238-1356-37f6-a282-57fe1ddac32b",
                        "entry_id": "3af291c0-6dfb-3363-ade3-9a1af5cfd4d8",
                        "glosses": [
                            "iets of iemand helpen bij het weggaan van een zekere plaats"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f2dc52df-8873-40a1-a8ee-e2ac5710de87",
                                "sense_id": "6fb82238-1356-37f6-a282-57fe1ddac32b",
                                "text": "Sergio Conceiçao moet Nantes weghelpen van de onderste plaatsen in de Franse voetbalcompetitie."
                            }
                        ]
                    },
                    {
                        "sense_id": "2fb146fa-2053-325d-9b9b-228ca115eb82",
                        "entry_id": "3af291c0-6dfb-3363-ade3-9a1af5cfd4d8",
                        "glosses": [
                            "kinderen helpen bij het naar school gaan"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ddebeea5-09c5-420d-99de-0fd9f7154df0",
                                "sense_id": "2fb146fa-2053-325d-9b9b-228ca115eb82",
                                "text": "\"Je kunt niet anders\", zegt Tjeerd Delsing (44), handelaar in onroerend goed en vader van vier kinderen tussen de vijf en twaalf jaar. Zijn vrouw Eta (40) heeft zich volledig aan het moederschap gewijd, maar Tjeerd is verantwoordelijk voor 'de ochtend': het aankleden, het ontbijt, de broodtrommels, het weghelpen."
                            }
                        ]
                    }
