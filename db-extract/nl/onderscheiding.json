                ],
                "senses": [
                    {
                        "sense_id": "2a70d665-b8f9-3b10-8681-c6341492e206",
                        "entry_id": "c85cfc35-44f9-36ca-8fb6-b3f628694722",
                        "glosses": [
                            "verschil zoals dat wordt vastgesteld"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d0bf52e-f5da-4a3a-9cc6-c4341452f652",
                                "sense_id": "2a70d665-b8f9-3b10-8681-c6341492e206",
                                "text": "Mijn doel was, het beginsel, dat in de onderscheiding der woordsoorten gevolgd wordt, en de definitie van enkele woordsoorten, die door Dr. Te Winkel met veel scherpzinnigheid veroordeeld was, te handhaven, hoezeer ik toegeef, dat al de gegeven definities nog niet volmaakt zijn."
                            }
                        ]
                    },
                    {
                        "sense_id": "722ebd49-a390-3415-a4d5-96714c16e245",
                        "entry_id": "c85cfc35-44f9-36ca-8fb6-b3f628694722",
                        "glosses": [
                            "toegekend eerbewijs of uitgereikte decoratie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "71c214d1-72e1-4bf9-87d6-a27e2df35667",
                                "sense_id": "722ebd49-a390-3415-a4d5-96714c16e245",
                                "text": "Hij kreeg een onderscheiding voor zijn dienst."
                            },
                            {
                                "example_id": "28ef812f-e2cf-4d89-ba90-7dc3e808542e",
                                "sense_id": "722ebd49-a390-3415-a4d5-96714c16e245",
                                "text": "Na het bekijken van de lijst van \"Ridderorden en onderscheidingen in nazi-Duitsland\" weet ik het zeker: ik hoop dat ik nooit een onderscheiding krijg!"
                            },
                            {
                                "example_id": "2dca4fad-42dd-4328-bb30-d3eeb8899723",
                                "sense_id": "722ebd49-a390-3415-a4d5-96714c16e245",
                                "text": "Ton Wiggers, oprichter en directeur van het dansgezelschap Introdans, heeft zaterdagavond tijdens zijn afscheid in Stadstheater Arnhem twee onderscheidingen gekregen."
                            }
                        ]
                    },
                    {
                        "sense_id": "55ca8e5c-8b46-3bf8-a63a-3eba5aa22ba2",
                        "entry_id": "c85cfc35-44f9-36ca-8fb6-b3f628694722",
                        "glosses": [
                            "vermogen om verschillen waar te nemen"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e12fbdef-c66a-45d5-ab23-fa0fb41cca76",
                        "source_entry_id": "c85cfc35-44f9-36ca-8fb6-b3f628694722",
                        "source_sense_id": "722ebd49-a390-3415-a4d5-96714c16e245",
                        "source_sense_description": "toegekend eerbewijs of uitgereikte decoratie",
                        "target_lang_word": "Auszeichnung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Auszeichnung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8c146d34-8bbc-3133-ab5c-377763c92684",
                                        "entry_id": "578d8394-644e-3daf-bb8b-ed6339fe71b3",
                                        "glosses": [
                                            "das Auszeichnen von Schrift (Hervorheben einzelner Zeichenfolgen), das Zeichnen von (technischen) Zeichnungen ins Reine, das reproduktionsfähige Zeichnen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c972fcba-1fca-4e1e-b0cc-8ae8e2fd9067",
                                                "sense_id": "8c146d34-8bbc-3133-ab5c-377763c92684",
                                                "text": "Diese Auszeichnung ist reprofähig."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9a1c11de-d716-3537-9c73-0e1cd1220474",
                                        "entry_id": "578d8394-644e-3daf-bb8b-ed6339fe71b3",
                                        "glosses": [
                                            "eine Ehrung, eine Würdigung, eine Anerkennung besonderer Verdienste"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27649bbc-b6bb-4051-abe7-1533934546fa",
                                                "sense_id": "9a1c11de-d716-3537-9c73-0e1cd1220474",
                                                "text": "Der Tag, an dem die Auszeichnungen verliehen werden sollen, ist verschoben."
                                            },
                                            {
                                                "example_id": "5e5252cb-2119-4fc4-acd1-834e8e9b0021",
                                                "sense_id": "9a1c11de-d716-3537-9c73-0e1cd1220474",
                                                "text": "„Für Dagsson ist es die größte Auszeichnung, wenn irgendeine christliche Fernsehstation ihn für den Satan mit spitzem Stift hält.“"
                                            },
                                            {
                                                "example_id": "c2531818-a03e-4a08-8924-7832e4efa443",
                                                "sense_id": "9a1c11de-d716-3537-9c73-0e1cd1220474",
                                                "text": "„Obwohl er seine juristischen Examen mit Auszeichnung bestanden hat, nimmt er nur den Posten eines unbezahlten Assessors ein und ist darauf angewiesen, von den spärlichen Mitteln zu leben, die ihm seine Familie aus Königsberg zukommen läßt.“"
                                            },
                                            {
                                                "example_id": "540f23da-abdf-4dd2-83f8-249a5ab5454e",
                                                "sense_id": "9a1c11de-d716-3537-9c73-0e1cd1220474",
                                                "text": "„In jedem Fall aber mussten am folgenden Tage zahlreiche Auszeichnungen verliehen und zahlreiche Beförderungen vorgenommen werden, und allerhand neue Männer mussten hervortreten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "f874a372-5bf8-3ec3-ba9c-52628e85e989",
                                        "entry_id": "578d8394-644e-3daf-bb8b-ed6339fe71b3",
                                        "glosses": [
                                            "das Verleihen, die Zuerkennung eines qualitativen Prädikates, die Kennzeichnung eines Produktes für die Erfüllung bestimmter Anforderungen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "931a96cf-f94d-47e4-8259-494ca0ef881c",
                                                "sense_id": "f874a372-5bf8-3ec3-ba9c-52628e85e989",
                                                "text": "Dieser Wein bekam 2000 seine erste Auszeichnung."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "f1c02d03-248b-3b76-9f86-1fdadee487ae",
                                        "entry_id": "578d8394-644e-3daf-bb8b-ed6339fe71b3",
                                        "glosses": [
                                            "das Auszeichnen, das Versehen von oder mit Preisangaben, die rechtlich geregelte Kennzeichnung von Gütern mit ihrem Handelspreis"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "673d0006-52fd-402c-a199-defb3c3752dc",
                                                "sense_id": "f1c02d03-248b-3b76-9f86-1fdadee487ae",
                                                "text": "Die Auszeichnung mit den Winterpreisen nehmen wir nächste Woche vor."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    }
