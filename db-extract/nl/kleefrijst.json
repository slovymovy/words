        "nl-extract.jsonl": [
            {
                "entry_id": "dc98daf0-073b-3b95-bc3d-f3cfa5f3182d",
                "word": "kleefrijst",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "45624fed-3739-3f9c-9be7-6fa20fdca6e0",
                        "entry_id": "dc98daf0-073b-3b95-bc3d-f3cfa5f3182d",
                        "glosses": [
                            "rijstsoort die veel zetmeel bevat en daardoor na het koken aan elkaar plakt, zaden van Oryza sativa)var. glutinosa"
                        ],
                        "tags": [
                            "wikidata: kleefrijst"
                        ],
                        "examples": [
                            {
                                "example_id": "8ea1f188-2034-4206-8e08-8c2683d9dd2a",
                                "sense_id": "45624fed-3739-3f9c-9be7-6fa20fdca6e0",
                                "text": "Hij at het liefst de toetjes met zoete kleefrijst van zijn moeder."
                            },
                            {
                                "example_id": "290fb66b-576c-4912-80bc-f51db1f42941",
                                "sense_id": "45624fed-3739-3f9c-9be7-6fa20fdca6e0",
                                "text": "Er kwamen dimsum (het woord, Chinees voor ‘het hart beroeren’ ) op tafel, we kregen oesters, scheermesjes, sint-jakobsschelpen, kleefrijst in lotusblad, pannenkoekjes met pekingeend en altijd schonk Jenny er de heerlijkste wijnen bij."
                            },
                            {
                                "example_id": "60aa44d9-5692-48f0-9ae4-5f11ec037b9f",
                                "sense_id": "45624fed-3739-3f9c-9be7-6fa20fdca6e0",
                                "text": "In de kamer waar de geisha en maiko hun klanten vermaken staan twee kleine tafeltjes vol gerechten met een symbolische betekenis. (…) Kleefrijst met rode sojabonen symboliseert geluk."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e2349ca9-3cd4-4936-81a4-da6ceedb0f07",
                        "source_entry_id": "dc98daf0-073b-3b95-bc3d-f3cfa5f3182d",
                        "source_sense_id": "45624fed-3739-3f9c-9be7-6fa20fdca6e0",
                        "source_sense_description": "rijstsoort die veel zetmeel bevat",
                        "target_lang_word": "Klebreis",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Klebreis",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b6fed9f6-552a-3383-83e4-38e342b9fd7e",
                                        "entry_id": "ce7705fc-af80-3008-81e6-b1de87314c9c",
                                        "glosses": [
                                            "Reis, der beim Kochen verklebt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2717c2b9-b8c5-4ff8-a5f2-247698e3ab2d",
                                                "sense_id": "b6fed9f6-552a-3383-83e4-38e342b9fd7e",
                                                "text": "„Neal sah zu, wie Wu brockenweise Klebreis aus der Schüssel löffelte und in die Saucen der vorangegangenen Speisen tunkte.“"
                                            },
                                            {
                                                "example_id": "2d53eef1-5621-4543-9621-5bee8c7104c3",
                                                "sense_id": "b6fed9f6-552a-3383-83e4-38e342b9fd7e",
                                                "text": "„In manchen Regionen Chinas wird auch süßer Klebreis an den Küchengott geopfert.“"
                                            },
                                            {
                                                "example_id": "882fdab3-3512-4921-be0b-8ce998177538",
                                                "sense_id": "b6fed9f6-552a-3383-83e4-38e342b9fd7e",
                                                "text": "„Die Beständigkeit der chinesischen Mauer beruht wesentlich auf den besonderen Eigenschaften eines Getreides: Vor 1500 Jahren vermengten Bauarbeiter jenen Klebreis, der bis heute das Hauptnahrungsmittel in Asien ist, als angedickte Suppe mit ihrem Kalkzement.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8b3acc49-5d26-4529-b786-8ddfd4b51659",
