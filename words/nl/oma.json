                {
                    "sense_id": "9958e0d1-6522-37ac-8227-d5d18d3a2128",
                    "sense_definition": "Een algemene aanduiding voor een oudere vrouw, vaak onbekend.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "people",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er zat een vriendelijke <w>oma</w> op het bankje in het park naar de eendjes te kijken.",
                            "target_lang_translations": {
                                "en": "A friendly <w>grandma</w> was sitting on the bench in the park watching the ducks.",
                                "ru": "На скамейке в парке сидела приветливая <w>бабушка</w> и смотрела на уточек.",
                                "pl": "Na ławce w parku siedziała sympatyczna <w>babcia</w> i przyglądała się kaczkom.",
                                "de": "Auf der Bank im Park saß eine freundliche <w>Oma</w> und schaute den Enten zu.",
                                "fr": "Il y avait une gentille <w>grand-mère</w> assise sur le banc du parc qui regardait les canards.",
                                "it": "C'era una simpatica <w>vecchietta</w> seduta sulla panchina del parco a guardare le paperette.",
                                "cs": "Na lavičce v parku seděla milá <w>babička</w> a dívala se na kachny.",
                                "tr": "Parktaki bankta sevimli bir <w>teyze</w> oturmuş ördekleri izliyordu.",
                                "es": "Había una <w>anciana</w> simpática sentada en el banco del parque mirando los patitos."
                            }
                        },
                        {
                            "text": "Help jij die oude <w>oma</w> even met oversteken?",
                            "target_lang_translations": {
                                "en": "Will you help that old <w>grandma</w> cross the street?",
                                "ru": "Ты поможешь той старенькой <w>бабушке</w> перейти дорогу?",
                                "pl": "Pomożesz tej starszej <w>babci</w> przejść przez ulicę?",
                                "de": "Hilfst du der alten <w>Oma</w> kurz über die Straße?",
                                "fr": "Tu aides cette vieille <w>dame</w> à traverser ?",
                                "it": "Aiuti quella vecchia <w>nonnina</w> ad attraversare la strada?",
                                "cs": "Pomůžeš té staré <w>babičce</w> přejít silnici?",
                                "tr": "Şu yaşlı <w>teyzenin</w> karşıya geçmesine yardım eder misin?",
                                "es": "¿Ayudas a esa <w>viejita</w> a cruzar la calle?"
                            }
                        }
