                "senses": [
                    {
                        "sense_id": "57da039e-7164-3fab-a337-e59ea18322ae",
                        "entry_id": "54048729-812e-3d1d-b5d1-b62991bfb273",
                        "glosses": [
                            "Artiste qui écrit les paroles et qui compose la musique des chansons qu’il interprète."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "b3dc2b12-180b-47b8-b37f-4b7ad65079a5",
                                "sense_id": "57da039e-7164-3fab-a337-e59ea18322ae",
                                "text": "[…]; Francesco Guccini est, heureusement, encore bien vivant, gaillard et nous voulons dire qu’il lutte aussi avec nous. Peut-être, écrivant sur la liste d’un cantauteur vraiment mort, un Génois, entendais-je éloigner les spectres."
                            },
                            {
                                "example_id": "968a46f7-93d9-4868-972d-e3146502f092",
                                "sense_id": "57da039e-7164-3fab-a337-e59ea18322ae",
                                "text": "JARA Victor (1932-1973) fut un musicien, cantauteur, professeur, directeur de théâtre et membre du Parti communiste chilien."
                            },
                            {
                                "example_id": "ea27926e-18da-4ecc-ab82-bc18355cd1ed",
                                "sense_id": "57da039e-7164-3fab-a337-e59ea18322ae",
                                "text": "Le cantauteur albanais, Ermal Meta, a interprété la chanson “Amara terra mia” du fameux chanteur italien Domenico Modugno."
                            }
                        ]
                    }
                ],
