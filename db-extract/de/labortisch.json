                "senses": [
                    {
                        "sense_id": "5527af55-277c-3248-989e-f38a8130fe45",
                        "entry_id": "f34d181c-c5f5-3d3f-a15b-ed43573b8729",
                        "glosses": [
                            "Tisch, der in einem Labor steht, auf dem Laborarbeiten ausgeführt werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "15246d7e-d13b-445d-aeda-cc36016bc4c2",
                                "sense_id": "5527af55-277c-3248-989e-f38a8130fe45",
                                "text": "„Auf dem Labortisch und rings um ihn herum lagen jedoch andere Dinge verstreut, und wir brauchten nicht lange, um zu erkennen, dass es sich bei diesen Dingen um die sorgfältig, allerdings auch einfallsreich und laienhaft sezierten Körperteile eines Mannes und eines Hundes handelte.“"
                            },
                            {
                                "example_id": "bfdb1804-a91c-4b5b-8dc1-af1ea7d958e6",
                                "sense_id": "5527af55-277c-3248-989e-f38a8130fe45",
                                "text": "„Zwei Männer saßen an einem Labortisch und spielten Schach.“"
                            },
                            {
                                "example_id": "728a8d31-9014-4f7b-b2f6-9e7c7d20c1f6",
                                "sense_id": "5527af55-277c-3248-989e-f38a8130fe45",
                                "text": "„Auf Labortischen, Bahren und Tabletts liegen verschiedene Gegenstände, mit denen man einen Körper bis auf seinen Kern zerlegen kann.“"
                            },
                            {
                                "example_id": "31cda17f-1911-4f1a-8692-250569a46369",
                                "sense_id": "5527af55-277c-3248-989e-f38a8130fe45",
                                "text": "„Das ist mein Labortisch und das ist mein Arbeitshocker.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
