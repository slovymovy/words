                    }
                ],
                "senses": [
                    {
                        "sense_id": "7313b875-2573-3b8a-99d8-2666aad01b15",
                        "entry_id": "03908e02-1c36-3bf2-94c1-6eb40e12589e",
                        "glosses": [
                            "To talk casually; to discuss unimportant matters."
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "d308bb19-3182-4a79-a703-7aca61a73951",
                                "sense_id": "7313b875-2573-3b8a-99d8-2666aad01b15",
                                "text": "What are you guys nattering about? You're clearly not following the meeting!"
                            }
                        ]
                    },
                    {
                        "sense_id": "81fc3ea4-aae8-37fb-bd0a-60d3463dbee9",
                        "entry_id": "03908e02-1c36-3bf2-94c1-6eb40e12589e",
                        "glosses": [
                            "To nag."
                        ],
                        "tags": [
                            "Scotland"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6371df49-352c-457e-84dc-f92b68d7af4a",
                        "source_entry_id": "03908e02-1c36-3bf2-94c1-6eb40e12589e",
                        "source_sense_description": "to talk idly",
                        "target_lang_word": "bavarder",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bavarder",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2b3d29ab-a949-3fd5-a6a4-f42af752c81c",
                                        "entry_id": "fae844c3-9512-3696-9483-d35ffded4c1a",
                                        "glosses": [
                                            "Parler sans mesure et sans discrétion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e6ba516-5302-4e3c-b5b9-ea85b7f7df67",
                                                "sense_id": "2b3d29ab-a949-3fd5-a6a4-f42af752c81c",
                                                "text": "Les deux couples riaient, bavardaient, cueillaient des fleurs, se cajolaient et se mignotaient, luttaient et se roulaient sur l’herbe, et les jeunes filles fumèrent des cigarettes."
                                            },
                                            {
                                                "example_id": "b3ba4a4e-4b90-4ceb-a68d-c7f3355ddb7e",
                                                "sense_id": "2b3d29ab-a949-3fd5-a6a4-f42af752c81c",
                                                "text": "Pendant ce temps nous bavardions avec les Norvégiens, et même dans ce coin perdu du monde, les potins marchaient grand train."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "014fdebe-7fce-3839-b753-12450ece8115",
                                        "entry_id": "fae844c3-9512-3696-9483-d35ffded4c1a",
                                        "glosses": [
                                            "Parler de choses qu’on devrait tenir secrètes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a2929ff-c841-4493-9ddc-023b9942e349",
                                                "sense_id": "014fdebe-7fce-3839-b753-12450ece8115",
                                                "text": "Quelqu’un aura bavardé."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2e919178-8a47-4d9e-ab14-5d1687915370",
                        "source_entry_id": "03908e02-1c36-3bf2-94c1-6eb40e12589e",
                        "source_sense_description": "to talk idly",
                        "target_lang_word": "blablater",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "blablater",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9050d0c9-a174-31d8-88e0-25c2d7c8c8f8",
                                        "entry_id": "db4cb282-73c9-3cf0-883b-71037080ad93",
                                        "glosses": [
                                            "Parler à tort et à travers, parler pour ne rien dire."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f084a2cf-cd03-4fbd-a52d-50894f676cb3",
                                                "sense_id": "9050d0c9-a174-31d8-88e0-25c2d7c8c8f8",
                                                "text": "C’est facile de blablater, shérif, mais ce sont les coyotes les plus coriaces du pays!"
                                            },
                                            {
                                                "example_id": "6fde23d9-0ac2-4f39-96ca-05c7dd52dcc4",
                                                "sense_id": "9050d0c9-a174-31d8-88e0-25c2d7c8c8f8",
                                                "text": "— C'est ça le problème des méchants, commenta Christian à l'attention de Violette, […]. Ils blablatent, ils blablatent, alors qu'ils auraient pu descendre les gentils depuis longtemps…"
                                            },
                                            {
                                                "example_id": "4297e952-1ecb-4df0-a812-b40217d727a6",
                                                "sense_id": "9050d0c9-a174-31d8-88e0-25c2d7c8c8f8",
                                                "text": "Ses sœurs blablataient non-stop durant les repas. Leur mère les écoutait, amusée, en les interrompant à l'occasion pour leur poser une question."
                                            },
                                            {
                                                "example_id": "672fbadb-9653-4d4b-9568-b2a00a369e5d",
                                                "sense_id": "9050d0c9-a174-31d8-88e0-25c2d7c8c8f8",
                                                "text": "On n’a pas envie de blablater. Il nous arrive un truc fumant, une dégueulasserie de haut style. Pour se dépêtrer d’une merderie pareille, il convient de conserver la tête froide."
                                            },
                                            {
                                                "example_id": "c333fb7d-7547-4e7a-91d4-c09a1655e16c",
                                                "sense_id": "9050d0c9-a174-31d8-88e0-25c2d7c8c8f8",
                                                "text": "Hier, petite réunion au ministère, avec café et croissant, on blablate, tout le monde est content… c’est le même cirque depuis des années."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "819c56ed-ba3e-4697-91ca-74f59b044149",
                        "source_entry_id": "03908e02-1c36-3bf2-94c1-6eb40e12589e",
                        "source_sense_description": "to talk idly",
                        "target_lang_word": "papoter",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "papoter",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e761d825-34ff-3ca3-819a-493656918659",
                                        "entry_id": "db5b6dde-3d69-3409-85ed-261552502551",
                                        "glosses": [
                                            "Bavarder, discuter de choses futiles."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "53fb3c26-5db7-4125-a2d0-7deb5d8ae352",
                                                "sense_id": "e761d825-34ff-3ca3-819a-493656918659",
                                                "text": "La petite Duret aussi grimpait souvent ses trois étages, entrait avec des excuses effarouchées, s'asseyait craintivement, papotait, parlait de leurs maris, plaignait Louise, se plaignait ; […]."
                                            },
                                            {
                                                "example_id": "aecb7105-2511-4897-aee4-451b414a9ffc",
                                                "sense_id": "e761d825-34ff-3ca3-819a-493656918659",
                                                "text": "Elle menait une vie très indépendante, passait les après-midis et les soirées dans les salons où l'on papotait indéfiniment."
                                            },
                                            {
                                                "example_id": "39b1eb69-c3c9-4fa3-b7b8-169bd438181e",
                                                "sense_id": "e761d825-34ff-3ca3-819a-493656918659",
                                                "text": "Bonjour aux mamans ; je recherche des mamans pour papoter de nos bambins : éducation, vie de famille, apprentissage propreté, jeux loisirs, etc. (Un forum - 2007)"
                                            },
                                            {
                                                "example_id": "ab8ddd44-0d8a-4d7a-9e18-369594c03ebd",
                                                "sense_id": "e761d825-34ff-3ca3-819a-493656918659",
                                                "text": "J’étais effrayée, voire sottement hilare à l’idée de papoter sur la météo baskets aux pieds et seins à l’air avec, mettons, Jean-Michel Apoual du chalet d’à côté, sandales aux pieds mais surtout sexe à l’air (que les choses soient claires : c’est impossible de ne pas regarder)."
                                            },
                                            {
                                                "example_id": "a123281a-8446-4f37-b9a1-88b0578914d9",
                                                "sense_id": "e761d825-34ff-3ca3-819a-493656918659",
                                                "text": "Elles se saluent en se faisant trois bises. Samantha sert des cafés, les deux femmes papotent un instant de tout et de rien."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cfe5c591-ff7b-4508-8db5-cdc8c2083007",
                        "source_entry_id": "03908e02-1c36-3bf2-94c1-6eb40e12589e",
                        "source_sense_description": "to talk idly",
                        "target_lang_word": "болта́ть",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "болта́ть",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "5f194a5d-4d7d-3ce0-a3ec-4a772a12b9c1",
                                        "entry_id": "bbf17a47-5dd7-32d6-99d1-1d24b2dd9927",
                                        "glosses": [
                                            "беспорядочно раскачивать чем-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "35b006a9-997b-418e-86c4-0d063915fe41",
                                                "sense_id": "5f194a5d-4d7d-3ce0-a3ec-4a772a12b9c1",
                                                "text": "На подоконнике сидел и болтал ногами в джинсах совершенно незнакомый дядька."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "79f9f4d0-96ca-338b-a8de-16fe05943c8f",
                                        "entry_id": "bbf17a47-5dd7-32d6-99d1-1d24b2dd9927",
                                        "glosses": [
                                            "устар. что-либо перемешивать, взбалтывая"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd13ad12-1e17-495b-962d-98753cec41ec",
                                                "sense_id": "79f9f4d0-96ca-338b-a8de-16fe05943c8f",
                                                "text": "Лита на мгновение даже перестала болтать ложкой похлёбку."
                                            },
                                            {
                                                "example_id": "b598380a-9f0d-4eac-a2b3-e9300b2a8de2",
                                                "sense_id": "79f9f4d0-96ca-338b-a8de-16fe05943c8f",
                                                "text": "Генри мрачно болтал ложкой в чашке, и вид у него был такой несчастный, что мне стало жаль бедного ученого."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f62ad2ae-8f9a-36f5-a576-2cd6d1ca0034",
                                        "entry_id": "bbf17a47-5dd7-32d6-99d1-1d24b2dd9927",
                                        "glosses": [
                                            "разг., пренебр. то же, что болтать языком, говорить, разговаривать"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "befa667b-b31b-459a-81f0-e8cf33ced4ed",
                                                "sense_id": "f62ad2ae-8f9a-36f5-a576-2cd6d1ca0034",
                                                "text": "За рулём она вечно болтала без умолку, напоминая Нике жителя Чукотки, который едет на оленях по бескрайней тундре и поёт нескончаемую песню обо всем, что попадается ему по дороге."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c262d3de-4d8d-31f2-8d36-7482b5f83a88",
                                        "entry_id": "bbf17a47-5dd7-32d6-99d1-1d24b2dd9927",
                                        "glosses": [
                                            "разг. вести непринуждённый диалог, беседовать"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8687f0f4-7175-4c4a-842a-abc815797b28",
                                                "sense_id": "c262d3de-4d8d-31f2-8d36-7482b5f83a88",
                                                "text": "Патрульные были заняты — они болтали с хорошенькой продавщицей пива."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
