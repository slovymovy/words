                    {
                        "sense_id": "dc1554f2-ef49-3ce6-9504-cdcac99a342b",
                        "entry_id": "30e47bc5-5ef5-3780-92a0-80047a288933",
                        "glosses": [
                            "Untergattung der Hechtkräuter in der Familie der Wasserhyazinthengewächse"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9029289-b043-400f-bf61-ef8a7871610b",
                                "sense_id": "dc1554f2-ef49-3ce6-9504-cdcac99a342b",
                                "text": "„Dass man nach Paris oder Peking fahren kann, sagt Oyster, und überall einen McDonald's findet, das ist das ökologische Äquivalent konzessionierter Lebensformen. Jeder Ort ist der gleiche Ort. Kudzu. Zebramuscheln. Wasserhyazinthen.“"
                            },
                            {
                                "example_id": "a8a5777b-6ede-47fb-9d68-f705e6183ff2",
                                "sense_id": "dc1554f2-ef49-3ce6-9504-cdcac99a342b",
                                "text": "„Unten grapschte er nach ein paar frei schwimmenden Wasserhyazinthen, mit denen er sich bei seiner Durchquerung zusätzlich tarnte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
