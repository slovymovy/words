                ],
                "senses": [
                    {
                        "sense_id": "939f5553-90fd-3f29-b153-9f3963b048f9",
                        "entry_id": "cfdbfe79-a84f-3d92-8d33-b80260d2805d",
                        "glosses": [
                            "Ungeborenes, nachdem es innere Organe gebildet hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "896410d4-98f4-4135-bd6e-6e8c0b396d4b",
                                "sense_id": "939f5553-90fd-3f29-b153-9f3963b048f9",
                                "text": "„Fetaltod ist der Tod einer aus der Empfängnis stammenden Frucht […]; der Tod wird dadurch angezeigt, daß der Fet nach dem Verlassen des Mutterleibs weder atmet noch andere Lebenszeichen erkennen läßt, […]“"
                            },
                            {
                                "example_id": "7731d4ef-26e3-4e9b-a424-599c4a12b48e",
                                "sense_id": "939f5553-90fd-3f29-b153-9f3963b048f9",
                                "text": "„Anknüpfend an die dargelegte Problematik wurde darauf hingewiesen, dass nur durch einen intrauterinen Fetozid, d. h. das Töten des Feten im Mutterleib, verhindert werden könne, dass der Schwangerschaftsabbruch vom Kind überlebt werde.“"
                            },
                            {
                                "example_id": "956b9b9c-3a66-4b30-8659-13b2f69ee681",
                                "sense_id": "939f5553-90fd-3f29-b153-9f3963b048f9",
                                "text": "„Eine ungefähre Ahnung von den pränatalen regulatorischen Möglichkeiten, die dem Feten zur Verfügung stehen, kann man bekommen, wenn man sich die Entwicklung der Sinneskanäle vor Augen hält.“"
                            },
                            {
                                "example_id": "89073984-901d-40aa-8419-a8435afb3ae9",
                                "sense_id": "939f5553-90fd-3f29-b153-9f3963b048f9",
                                "text": "„Die Atemnot bzw. Kurzatmigkeit insbesondere bei körperlicher Anstrengung, die beim Asthma durch bronchiale Verengung bedingt ist, wird neben der genannten verstärkten Schleimhautschwellung auch durch den wachsenden Feten im Mutterleib verschlimmert.“"
                            },
                            {
                                "example_id": "9115fbca-1374-44a4-ae62-a03bc8c6a798",
                                "sense_id": "939f5553-90fd-3f29-b153-9f3963b048f9",
                                "text": "„Die Mütter waren durchschnittlich seit 38,4 Wochen schwanger, was bedeutete, dass die Feten geburtsreif waren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
