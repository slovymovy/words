                                        "glosses": [
                                            "A state of panic or feeling of intense psychological discomfort about questions of existence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e90f9e7-8ef6-4712-b534-60aab8b2691c",
                                                "sense_id": "3d2e7175-5abb-34a3-8e2d-cdd48c77b4e8",
                                                "text": "The existential crisis is, however, a crisis of our existence, our whole being. When we do find ourselves at that crossroad, everything we have and everything we are is on the scales."
                                            }
                                        ]
                                    }
