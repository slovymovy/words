                "senses": [
                    {
                        "sense_id": "f83d841b-3871-30f4-b0c4-7b8045903a84",
                        "entry_id": "48016955-0cd9-37cd-a29c-c32612812d8e",
                        "glosses": [
                            "ein Gefühl, das sich beim Tasten einstellt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a786c21-9b5a-4c6a-9619-fefcd028d0a1",
                                "sense_id": "f83d841b-3871-30f4-b0c4-7b8045903a84",
                                "text": "„Ich hätte nie gedacht, daß es im Tastgefühl so feine und bedeutungsvolle Unterschiede gibt.“"
                            },
                            {
                                "example_id": "40bf3b17-4b8a-4a58-ab0a-567684defaa6",
                                "sense_id": "f83d841b-3871-30f4-b0c4-7b8045903a84",
                                "text": "„Darin unterscheidet sich der Mann von allen anderen Lebewesen, daß er sich in eine Frau nur durch die Vermittlung eines seiner Sinne verlieben kann, die alle, mit Ausnahme des Tastgefühls, ihren Sitz im Kopf haben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
