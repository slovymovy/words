{
    "word_family": [
        "ruggedness",
        "ruggedly"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "a07c26f6-77b2-326f-ba3e-1c2a8559bb59",
                    "sense_definition": "Having a rocky, uneven, and wild surface, often with little vegetation.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "terrain",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hikers spent all day exploring the <w>rugged</w> mountain range.",
                            "target_lang_translations": {
                                "ru": "Пешие туристы провели весь день, исследуя <w>изрезанный</w> горный хребет."
                            }
                        },
                        {
                            "text": "The <w>rugged</w> terrain made it difficult for the vehicles to pass through the valley.",
                            "target_lang_translations": {
                                "ru": "<w>Пересечённая</w> местность затрудняла проезд транспорта через долину."
                            }
                        }
                    ],
                    "antonyms": [
                        "flat",
                        "smooth"
                    ],
                    "common_phrases": [
                        "rugged terrain",
                        "rugged mountain range",
                        "rugged landscape"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий каменистую, неровную и дикую поверхность, часто с бедной растительностью."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пересечённый",
                                "target_lang_sense_clarification": "о местности с оврагами и холмами"
                            },
                            {
                                "target_lang_word": "неровный",
                                "target_lang_sense_clarification": "о поверхности"
                            },
                            {
                                "target_lang_word": "изрезанный",
                                "target_lang_sense_clarification": "о береговой линии или горах"
                            },
                            {
                                "target_lang_word": "суровый",
                                "target_lang_sense_clarification": "о ландшафте"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9a826192-abe4-3167-be42-bad798c76e87",
                    "sense_definition": "Strong, sturdy, and able to withstand harsh conditions or rough treatment.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "durability",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was known for his <w>rugged</w> good looks and strong personality.",
                            "target_lang_translations": {
                                "ru": "Он был известен своей <w>мужественной</w> внешностью и сильным характером."
                            }
                        },
                        {
                            "text": "The explorer needed <w>rugged</w> outdoor gear to survive the winter expedition.",
                            "target_lang_translations": {
                                "ru": "Исследователю требовалось <w>прочное</w> снаряжение, чтобы выжить в зимней экспедиции."
                            }
                        }
                    ],
                    "antonyms": [
                        "fragile",
                        "delicate"
                    ],
                    "common_phrases": [
                        "rugged good looks",
                        "rugged outdoor gear",
                        "rugged individual"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сильный, крепкий и способный выдерживать суровые условия или грубое обращение."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прочный",
                                "target_lang_sense_clarification": "о вещах и снаряжении"
                            },
                            {
                                "target_lang_word": "крепкий",
                                "target_lang_sense_clarification": "о телосложении или предметах"
                            },
                            {
                                "target_lang_word": "мужественный",
                                "target_lang_sense_clarification": "о внешности"
                            },
                            {
                                "target_lang_word": "выносливый",
                                "target_lang_sense_clarification": "о человеке"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2ee735c4-a77d-33f1-9c8a-163d1177cbc1",
                    "sense_definition": "Specifically designed to operate reliably in harsh environments or extreme conditions.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "durability",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company manufactures a <w>rugged</w> laptop for use on construction sites.",
                            "target_lang_translations": {
                                "ru": "Компания производит <w>защищённый</w> ноутбук для использования на строительных площадках."
                            }
                        },
                        {
                            "text": "Military personnel use <w>rugged</w> handheld devices that can survive being dropped.",
                            "target_lang_translations": {
                                "ru": "Военнослужащие используют <w>ударопрочные</w> портативные устройства, которые выдерживают падение."
                            }
                        }
                    ],
                    "common_phrases": [
                        "rugged laptop",
                        "rugged device",
                        "rugged smartphone"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Специально разработанный для надежной работы в суровых условиях или экстремальных ситуациях."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "защищённый",
                                "target_lang_sense_clarification": "о технике, устойчивой к ударам и влаге"
                            },
                            {
                                "target_lang_word": "ударопрочный",
                                "target_lang_sense_clarification": "о корпусе устройства"
                            },
                            {
                                "target_lang_word": "прочный",
                                "target_lang_sense_clarification": "о конструкции"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "acc321de-db6f-3535-b230-2b1cd4fe284c",
                    "sense_definition": "Healthy, vigorous, and capable of enduring physical hardship.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "durability",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The athlete's <w>rugged</w> health allowed him to recover quickly from the injury.",
                            "target_lang_translations": {
                                "ru": "<w>Крепкое</w> здоровье атлета позволило ему быстро восстановиться после травмы."
                            }
                        },
                        {
                            "text": "Living in the wilderness requires a <w>rugged</w> constitution and great mental strength.",
                            "target_lang_translations": {
                                "ru": "Жизнь в дикой природе требует <w>закалённого</w> организма и большой душевной силы."
                            }
                        }
                    ],
                    "antonyms": [
                        "weak",
                        "frail"
                    ],
                    "common_phrases": [
                        "rugged health",
                        "rugged constitution"
                    ],
                    "target_lang_definitions": {
                        "ru": "Здоровый, энергичный и способный переносить физические трудности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "крепкий",
                                "target_lang_sense_clarification": "о здоровье или организме"
                            },
                            {
                                "target_lang_word": "закалённый",
                                "target_lang_sense_clarification": "о человеке"
                            },
                            {
                                "target_lang_word": "дюжий",
                                "target_lang_sense_clarification": "о силе и здоровье"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "96662b5b-8352-3a3e-a53f-0d7d1d581aab",
                    "sense_definition": "Having a face or features that are wrinkled, weathered, or stern in appearance.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old sailor had a <w>rugged</w> face that told stories of many years at sea.",
                            "target_lang_translations": {
                                "ru": "У старого моряка было <w>суровое</w> лицо, хранившее истории о многих годах, проведённых в море."
                            }
                        },
                        {
                            "text": "His <w>rugged</w> features softened when he saw his grandchildren playing.",
                            "target_lang_translations": {
                                "ru": "Его <w>грубые</w> черты лица смягчились, когда он увидел играющих внуков."
                            }
                        }
                    ],
                    "synonyms": [
                        "crabbed"
                    ],
                    "common_phrases": [
                        "rugged face",
                        "rugged features"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий лицо или черты лица, которые выглядят морщинистыми, обветренными или суровыми."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "грубый",
                                "target_lang_sense_clarification": "о чертах лица"
                            },
                            {
                                "target_lang_word": "суровый",
                                "target_lang_sense_clarification": "о выражении лица"
                            },
                            {
                                "target_lang_word": "обветренный",
                                "target_lang_sense_clarification": "о коже лица"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "bae73cc4-9928-3598-ba24-67601041fc18",
                    "sense_definition": "The simple past and past participle of <w>rug</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The floor was <w>rugged</w> with expensive carpets from the Orient.",
                            "target_lang_translations": {
                                "ru": "Пол был <w>застелен</w> дорогими восточными коврами."
                            }
                        },
                        {
                            "text": "They <w>rugged</w> the hallway to reduce the noise of footsteps.",
                            "target_lang_translations": {
                                "ru": "Они <w>застелили</w> коридор коврами, чтобы уменьшить шум шагов."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Форма прошедшего времени глагола rug (застилать коврами)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "застеленный коврами",
                                "target_lang_sense_clarification": "о поле"
