                        "glosses": [
                            "Qui peut être défalqué."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75127733-94b5-4ebe-acba-7792dce4aa6c",
                                "sense_id": "750a7c35-6c24-3db3-85d4-ccdb70cbf1b4",
                                "text": "Si une dette hypothécaire est défalcable pour l’impôt sur la fortune, ses intérêts sont, à leur tour, défalcables pour l’impôt sur le revenu."
                            },
                            {
                                "example_id": "c7c336c9-09a5-4bc7-a0f7-957773bd88b7",
                                "sense_id": "750a7c35-6c24-3db3-85d4-ccdb70cbf1b4",
                                "text": "Pour ce qui est particulier des sociétés, il peut arriver que pour un même revenu l’impôt étranger soit plus élevé que l’impôt suédois perçu pour le compte de l’État, et dans ce cas la part excédentaire de l’impôt étranger n’est pas défalcable et ne peut être reportée à une année suivante, car ce régime ne comporte pas de dispositions en matière de reports d’une année à l’autre."
                            }
                        ]
                    }
