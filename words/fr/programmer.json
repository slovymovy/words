                {
                    "sense_id": "e1613794-b22b-308e-9d4f-4d36aa7f4760",
                    "sense_definition": "Inscrire un spectacle, un film ou un artiste dans la programmation d'une salle ou d'un festival.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "spectacle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le directeur du théâtre a décidé de <w>programmer</w> cette pièce classique pour la rentrée.",
                            "target_lang_translations": {
                                "en": "The theatre director decided to <w>program</w> this classic play for the autumn season.",
                                "ru": "Директор театра решил <w>включить</w> эту классическую пьесу в программу к осеннему сезону.",
                                "de": "Der Theaterdirektor hat beschlossen, dieses klassische Stück für die Herbstspielzeit zu <w>programmieren</w>.",
                                "es": "El director del teatro ha decidido <w>programar</w> esta obra clásica para la temporada de otoño.",
                                "zh": "剧院院长决定<w>编排</w>这部经典剧目，作为秋季演出季的节目。"
                            }
                        },
                        {
                            "text": "Le festival va <w>programmer</w> plusieurs groupes régionaux sur la scène principale cet été.",
                            "target_lang_translations": {
                                "en": "This summer, the festival will <w>book</w> several regional bands for the main stage.",
                                "ru": "Этим летом фестиваль <w>ангажирует</w> несколько региональных групп на главной сцене.",
                                "de": "Das Festival wird diesen Sommer mehrere regionale Musikgruppen auf der Hauptbühne <w>buchen</w>.",
                                "es": "Este verano, el festival <w>contratará</w> a varios grupos regionales para el escenario principal.",
                                "zh": "今年夏天，音乐节将<w>邀请</w>几支地方乐队在主舞台演出。"
                            }
                        }
