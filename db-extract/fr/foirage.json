                                                "sense_id": "7ebdd689-8411-344b-88a7-dfe9921c4ed5",
                                                "text": "surge capacity; surge fleet; surge deployment capabilities"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7f770b3d-bb3c-3273-85ca-15ca4dc4ee42",
