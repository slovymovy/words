                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Literary usage."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Být zmiňován nebo popisován v obecném přísloví."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "stát se příslovím",
                                "target_lang_sense_clarification": "archaicky: stát se námětem přísloví nebo obecného rčení"
                            },
                            {
                                "target_lang_word": "vejít do přísloví",
                                "target_lang_sense_clarification": "být připomínán v ustáleném rčení"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1ff08357-6186-311c-9fd5-041d6c5e464c",
                    "sense_definition": "To provide or express something using a traditional saying.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "no",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am <w>proverbed</w> with a phrase from my grandfather.",
                            "target_lang_translations": {
                                "cs": "Jsem <w>charakterizován příslovím</w>, které pochází od mého dědečka."
                            }
                        },
                        {
                            "text": "The situation was <w>proverbed</w> by the elders to provide clarity.",
                            "target_lang_translations": {
                                "cs": "Stařešinové tuto situaci <w>vyjádřili příslovím</w>, aby ji ozřejmili."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Literary usage."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Vyjádřit nebo podat něco pomocí tradičního přísloví."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "vyjádřit příslovím",
                                "target_lang_sense_clarification": "archaicky: vyjádřit něco pomocí přísloví"
                            },
                            {
                                "target_lang_word": "charakterizovat příslovím",
                                "target_lang_sense_clarification": "charakterizovat nebo opatřit tradičním rčením"
                            }
                        ]
                    }
                }
            ]
        }
    ]
