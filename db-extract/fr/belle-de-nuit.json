                ],
                "senses": [
                    {
                        "sense_id": "3a3f886f-6e3c-3638-bbe2-48bc0a510d3b",
                        "entry_id": "d970c97f-e989-3028-8672-932fad441df7",
                        "glosses": [
                            "Nom vernaculaire de Mirabilis jalapa plante exotique de la famille des Nyctaginaceae, dont les fleurs, qui ressemblent à celles du liseron, ne s’épanouissent guère qu’après le coucher du soleil."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "238fe588-72f9-4b1e-8305-17e08d09fa11",
                                "sense_id": "3a3f886f-6e3c-3638-bbe2-48bc0a510d3b",
                                "text": "Alors je vois, je sens, j’entends ; la lune réveille les gros papillons ; le vent chaud ouvre les belles-de-nuit ; l’eau des grands bassins s’endort."
                            },
                            {
                                "example_id": "0d8188cd-6580-424c-a3ea-f373f03e6ef4",
                                "sense_id": "3a3f886f-6e3c-3638-bbe2-48bc0a510d3b",
                                "text": "Des odeurs pâmées montaient des brins de chèvrefeuille, les corolles des belles-de-nuit jetaient une dernière senteur pénétrante, comme un adieu mélancolique au jour."
                            }
                        ]
                    },
                    {
                        "sense_id": "d3c278df-3348-38c3-a131-ed99cb946338",
                        "entry_id": "d970c97f-e989-3028-8672-932fad441df7",
                        "glosses": [
                            "Nom vernaculaire de Ipomoea violacea plante annuelle de la famille des Convolvulaceae dont les fleurs s'ouvrent la nuit."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "6ffc5adc-e040-3fc4-8bac-a445fc6a0272",
                        "entry_id": "d970c97f-e989-3028-8672-932fad441df7",
                        "glosses": [
                            "Nom vernaculaire de Epiphyllum oxypetalum, plante de la famille des Cactaceae, nommé ainsi car sa fleur s’ouvre la nuit."
                        ],
                        "tags": [],
                        "examples": []
                    },
