{
    "word_family": [
        "временный",
        "современный",
        "своевременный",
        "вовремя",
        "современник"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2dca976b-2907-3307-b380-82363f6d6048",
                    "sense_definition": "Длительность, продолжительность чего-либо, измеряемая в секундах, минутах, часах, днях и годах; ход событий.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "chronological",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Скажите, пожалуйста, сколько сейчас <w>времени</w> на ваших часах?",
                            "target_lang_translations": {
                                "en": "Could you please tell me what <w>time</w> it is on your watch?",
                                "zh": "请问您的表上现在<w>时间</w>是几点？"
                            }
                        },
                        {
                            "text": "У нас совсем нет <w>времени</w>, чтобы обсуждать этот вопрос.",
                            "target_lang_translations": {
                                "en": "We have absolutely no <w>time</w> to discuss this issue.",
                                "zh": "我们完全没有<w>时间</w>来讨论这个问题。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "сколько времени",
                        "время летит",
                        "тратить время",
                        "с течением времени"
                    ],
                    "target_lang_definitions": {
                        "en": "The indefinite continued progress of existence and events; duration measured by clocks.",
                        "zh": "事物持续的过程，可以用时钟测量，或者指事件发生的先后顺序。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "time",
                                "target_lang_sense_clarification": "general concept or duration"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "时间",
                                "target_lang_sense_clarification": "指一般的时间概念或持续时长"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d29ab9aa-d6cc-33b6-a800-c8b38efb41b0",
                    "sense_definition": "Свободные от работы или занятий часы и дни; досуг.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "chronological",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В свободное <w>время</w> мой брат любит играть в футбол.",
                            "target_lang_translations": {
                                "en": "In his free <w>time</w>, my brother likes to play football.",
                                "zh": "在空闲<w>时间</w>，我哥哥喜欢踢足球。"
                            }
                        },
                        {
                            "text": "Мы отлично провели <w>время</w> в парке в прошлое воскресенье.",
                            "target_lang_translations": {
                                "en": "We had a great <w>time</w> in the park last Sunday.",
                                "zh": "上周日我们在公园度过了愉快的<w>时光</w>。"
                            }
                        }
                    ],
                    "antonyms": [
                        "работа"
                    ],
                    "common_phrases": [
                        "свободное время",
                        "проводить время",
                        "найти время"
                    ],
                    "target_lang_definitions": {
                        "en": "Time available for one's own use; leisure.",
                        "zh": "工作或学习之外的空闲时间；休闲。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "time",
                                "target_lang_sense_clarification": "free time or leisure"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "时间",
                                "target_lang_sense_clarification": "指空闲时间或休闲"
                            },
                            {
                                "target_lang_word": "空闲",
                                "target_lang_sense_clarification": "指有空的时候"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3de63793-3041-3e38-bf7f-5db404cb565a",
                    "sense_definition": "Определённая часть года или суток.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "chronological",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Лето — это моё самое любимое <w>время</w> года.",
                            "target_lang_translations": {
                                "en": "Summer is my favorite <w>time</w> of year.",
                                "zh": "夏天是我最喜欢的<w>季节</w>。"
                            }
                        },
                        {
                            "text": "В ночное <w>время</w> все магазины в нашем районе закрыты.",
                            "target_lang_translations": {
                                "en": "During the night <w>time</w>, all the shops in our neighborhood are closed.",
                                "zh": "在夜间<w>时段</w>，我们社区所有的商店都关门了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "время года",
                        "в любое время",
                        "зимнее время",
                        "светлое время суток"
                    ],
                    "target_lang_definitions": {
                        "en": "A specific portion of the year or day.",
                        "zh": "一年或一天中的特定阶段。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "time",
                                "target_lang_sense_clarification": "period of day or year"
                            },
                            {
                                "target_lang_word": "season",
                                "target_lang_sense_clarification": "time of year"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "时间",
                                "target_lang_sense_clarification": "指一天或一年中的某个时段"
                            },
                            {
                                "target_lang_word": "季节",
                                "target_lang_sense_clarification": "指一年中的特定时期"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "14698536-fdc0-3b3b-af6d-3ee458a0c34f",
                    "sense_definition": "Подходящий, удобный или благоприятный момент для совершения чего-либо.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "chronological",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Нам пора идти домой, уже <w>время</w> обедать.",
                            "target_lang_translations": {
                                "en": "It's time to go home, it's already <w>time</w> to have lunch.",
                                "zh": "我们该回家了，已经到了吃午饭的<w>时候</w>了。"
                            }
                        },
                        {
                            "text": "Сейчас не <w>время</w> спорить, нужно срочно действовать.",
                            "target_lang_translations": {
                                "en": "Now is not the <w>time</w> to argue, we need to act urgently.",
                                "zh": "现在不是争论的<w>时候</w>，必须立即采取行动。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "самое время",
                        "время не ждёт",
                        "всему своё время",
                        "время пришло"
                    ],
                    "target_lang_definitions": {
                        "en": "The appropriate, suitable, or advantageous moment to do something.",
                        "zh": "做某事的合适、方便或有利的时刻。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "time",
                                "target_lang_sense_clarification": "suitable moment"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "时候",
                                "target_lang_sense_clarification": "指做某事的合适时机"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "08a73d8f-5e8f-3da5-9c78-8e6ba14d0a40",
                    "sense_definition": "Исторический период, эпоха или этап в жизни общества.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "chronological",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В те далёкие <w>времена</w> люди жили в деревянных домах.",
                            "target_lang_translations": {
                                "en": "In those distant <w>times</w>, people lived in wooden houses.",
                                "zh": "在那个遥远的<w>时代</w>，人们住在木屋里。"
                            }
                        },
                        {
                            "text": "Это были очень тяжёлые <w>времена</w> для всей нашей страны.",
                            "target_lang_translations": {
                                "en": "Those were very difficult <w>times</w> for our whole country.",
                                "zh": "那对我们整个国家来说都是非常艰难的<w>时期</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "эпоха",
                        "эра"
                    ],
                    "common_phrases": [
                        "во времена",
                        "тёмные времена",
                        "дух времени",
                        "с незапамятных времён"
                    ],
                    "target_lang_definitions": {
                        "en": "A distinct period of history or life; an era.",
                        "zh": "历史上的一个特定时期或社会生活的一个阶段；时代。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "times",
                                "target_lang_sense_clarification": "historical period (often plural)"
                            },
                            {
                                "target_lang_word": "era",
                                "target_lang_sense_clarification": "distinct period"
                            },
                            {
                                "target_lang_word": "age",
                                "target_lang_sense_clarification": "historical age"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "时代",
                                "target_lang_sense_clarification": "指历史时期"
                            },
                            {
                                "target_lang_word": "时期",
                                "target_lang_sense_clarification": "指一段历史阶段"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e458c52e-d105-368b-a55c-dd6084db99ee",
                    "sense_definition": "Грамматическая категория глагола, указывающая на отношение действия к моменту речи.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "grammatical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В этом предложении глагол стоит в прошедшем <w>времени</w>.",
                            "target_lang_translations": {
                                "en": "In this sentence, the verb is in the past <w>tense</w>.",
                                "zh": "在这个句子中，动词使用的是过去<w>时态</w>。"
                            }
                        },
                        {
                            "text": "Ученики изучают будущее <w>время</w> на уроке русского языка.",
                            "target_lang_translations": {
                                "en": "The students are studying the future <w>tense</w> in the Russian class.",
                                "zh": "学生们正在俄语课上学习将来<w>时态</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "настоящее время",
                        "прошедшее время",
                        "будущее время"
                    ],
                    "target_lang_definitions": {
                        "en": "A grammatical category of verbs indicating when an action takes place.",
                        "zh": "动词的一种语法范畴，表示动作发生的时间。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "tense",
                                "target_lang_sense_clarification": "grammar"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "时态",
                                "target_lang_sense_clarification": "语法术语"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}