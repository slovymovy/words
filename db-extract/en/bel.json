                        "entry_id": "3f83cec1-720d-39c2-82ae-53f889c85435",
                        "glosses": [
                            "A Babylonian deity, corresponding to the Semitic Baal."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c3060acf-2a5e-4858-b82f-1ef95320b2d1",
                                "sense_id": "96340eaa-c2b4-327d-a629-2022d3ae1127",
                                "text": "Babylon is taken, Bel is confounded, Merodach is broken in pieces; her idols are confounded, her images are broken in pieces."
                            }
                        ]
                    },
                    {
                        "sense_id": "e3174168-6148-3f20-a06b-146dfb04c03a",
