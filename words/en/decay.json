{
    "word_family": [
        "decadence",
        "decadent"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "145fa878-a511-3193-99d7-c348a5f3b61a",
                    "sense_definition": "The natural process by which a dead plant, animal, or organic substance breaks down; the state of being rotted.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "physical_rot",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Eating too much sugar can lead to serious tooth <w>decay</w>.",
                            "target_lang_translations": {
                                "ru": "Чрезмерное употребление сахара может привести к серьезному <w>разрушению</w> зубов.",
                                "zh": "摄入过多的糖分会导致严重的牙齿<w>腐烂</w>。",
                                "cs": "Nadměrná konzumace cukru může vést k vážnému <w>rozkladu</w> zubů."
                            }
                        },
                        {
                            "text": "The smell of <w>decay</w> in the damp forest was unmistakable.",
                            "target_lang_translations": {
                                "ru": "Запах <w>гниения</w> во влажном лесу был безошибочным.",
                                "zh": "潮湿森林中那股<w>腐烂</w>的气味非常明显。",
                                "cs": "Zápach <w>hniloby</w> ve vlhkém lese byl nezaměnitelný."
                            }
                        }
                    ],
                    "common_phrases": [
                        "tooth decay",
                        "signs of decay",
                        "state of decay"
                    ],
                    "target_lang_definitions": {
                        "ru": "Естественный процесс разложения мертвых растений, животных или органических веществ; состояние гниения",
                        "zh": "有机物质在自然作用下分解的过程；腐烂的状态。",
                        "cs": "Přirozený proces, při kterém se mrtvé rostliny, živočichové nebo organické látky rozkládají; stav hniloby."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гниение",
                                "target_lang_sense_clarification": "процесс разрушения органической материи"
                            },
                            {
                                "target_lang_word": "разложение",
                                "target_lang_sense_clarification": "распад на составные части"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "腐烂",
                                "target_lang_sense_clarification": "有机物因微生物作用而分解"
                            },
                            {
                                "target_lang_word": "分解",
                                "target_lang_sense_clarification": "物质拆解为更简单的成分"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "rozklad",
                                "target_lang_sense_clarification": "proces rozpadu organické hmoty"
                            },
                            {
                                "target_lang_word": "hniloba",
                                "target_lang_sense_clarification": "stav hnití, zejména u biologických materiálů"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f96fd6d1-68d3-3929-9858-b8d57b19281f",
                    "sense_definition": "The gradual loss of quality, strength, health, or status.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "abstract_decline",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The neighborhood suffered from urban <w>decay</w> after the factories closed.",
                            "target_lang_translations": {
                                "ru": "Район пострадал от городского <w>упадка</w> после закрытия заводов.",
                                "zh": "工厂倒闭后，该社区陷入了城市<w>衰落</w>。",
                                "cs": "Čtvrť po uzavření továren trpěla městským <w>úpadkem</w>."
                            }
                        },
                        {
                            "text": "Historians have studied the causes of the empire's <w>decay</w>.",
                            "target_lang_translations": {
                                "ru": "Историки изучали причины <w>упадка</w> империи.",
                                "zh": "历史学家们研究了该帝国<w>衰落</w>的原因。",
                                "cs": "Historici studovali příčiny <w>úpadku</w> impéria."
                            }
                        }
                    ],
                    "common_phrases": [
                        "urban decay",
                        "moral decay",
                        "fall into decay"
                    ],
                    "target_lang_definitions": {
                        "ru": "Постепенная утрата качества, силы, здоровья или статуса",
                        "zh": "质量、力量、健康或地位的逐渐丧失。",
                        "cs": "Postupná ztráta kvality, síly, zdraví nebo postavení."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "упадок",
                                "target_lang_sense_clarification": "ослабление, снижение активности или уровня развития"
                            },
                            {
                                "target_lang_word": "разложение",
                                "target_lang_sense_clarification": "моральный или общественный распад"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "衰落",
                                "target_lang_sense_clarification": "事物由强变弱、由盛转衰"
                            },
                            {
                                "target_lang_word": "颓废",
                                "target_lang_sense_clarification": "指精神或社会风气的腐化堕落"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "úpadek",
                                "target_lang_sense_clarification": "postupné zhoršování stavu nebo úrovně"
                            },
                            {
                                "target_lang_word": "rozklad",
                                "target_lang_sense_clarification": "morální nebo společenský úpadek"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aec6cd0f-7f40-31bf-aba7-4e6fab1ee94f",
                    "sense_definition": "The process by which a radioactive substance releases energy and changes into another form.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "physics_decay",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Carbon dating relies on the predictable rate of radioactive <w>decay</w>.",
                            "target_lang_translations": {
                                "ru": "Радиоуглеродное датирование основывается на предсказуемой скорости радиоактивного <w>распада</w>.",
                                "zh": "碳定年法依赖于放射性<w>衰变</w>的可预测速率。",
                                "cs": "Radiouhlíkové datování spoléhá na předvídatelnou rychlost radioaktivního <w>rozpadu</w>."
                            }
                        },
                        {
                            "text": "The physics students calculated the <w>decay</w> of the isotope.",
                            "target_lang_translations": {
                                "ru": "Студенты-физики рассчитали <w>распад</w> изотопа.",
                                "zh": "物理系学生计算了该同位素的<w>衰变</w>。",
                                "cs": "Studenti fyziky vypočítali <w>rozpad</w> izotopu."
                            }
                        }
                    ],
                    "common_phrases": [
                        "radioactive decay",
                        "exponential decay"
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс, при котором радиоактивное вещество выделяет энергию и превращается в другую форму",
                        "zh": "放射性物质释放能量并转变为另一种形式的过程。",
                        "cs": "Proces, při kterém radioaktivní látka uvolňuje energii a mění se na jinou formu."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "распад",
                                "target_lang_sense_clarification": "физический процесс деления атомного ядра"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "衰变",
                                "target_lang_sense_clarification": "放射性原子核自发地转变为另一种原子核的过程"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "rozpad",
                                "target_lang_sense_clarification": "fyzikální proces přeměny atomového jádra"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "805d6896-17f7-3347-94c9-00cf3b385f08",
                    "sense_definition": "To be slowly destroyed by natural processes; to rot or decompose.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "physical_rot",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Fallen leaves <w>decay</w> on the ground and enrich the soil.",
                            "target_lang_translations": {
                                "ru": "Опавшие листья <w>гниют</w> на земле и обогащают почву.",
                                "zh": "落叶在地面上<w>分解</w>并肥沃了土壤。",
                                "cs": "Spadané listí se na zemi <w>rozkládá</w> a obohacuje půdu."
                            }
                        },
                        {
                            "text": "If you do not brush your teeth, they will start to <w>decay</w>.",
                            "target_lang_translations": {
                                "ru": "Если не чистить зубы, они начнут <w>разрушаться</w>.",
                                "zh": "如果你不刷牙，牙齿就会开始<w>腐烂</w>。",
                                "cs": "Pokud si nebudete čistit zuby, začnou <w>hnít</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "start to decay",
                        "decay rapidly"
                    ],
                    "target_lang_definitions": {
                        "ru": "Медленно разрушаться под воздействием природных процессов; гнить или разлагаться",
                        "zh": "在自然过程中缓慢被破坏；腐烂或分解。",
                        "cs": "Pomalu se ničit přirozenými procesy; hnít nebo se rozkládat."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гнить",
                                "target_lang_sense_clarification": "разлагаться под действием микроорганизмов"
                            },
                            {
                                "target_lang_word": "разлагаться",
                                "target_lang_sense_clarification": "распадаться на составные части"
                            },
                            {
                                "target_lang_word": "портиться",
                                "target_lang_sense_clarification": "приходить в негодность"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "腐烂",
                                "target_lang_sense_clarification": "有机物变质分解"
                            },
                            {
                                "target_lang_word": "分解",
                                "target_lang_sense_clarification": "物质结构瓦解"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "rozkládat se",
                                "target_lang_sense_clarification": "proces rozpadu na jednodušší složky"
                            },
                            {
                                "target_lang_word": "hnít",
                                "target_lang_sense_clarification": "podléhat hnilobnému procesu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9b531fb0-7b29-3991-9cf2-87f2811b31de",
                    "sense_definition": "To become gradually worse in quality, strength, or condition.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "abstract_decline",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Without regular maintenance, the old house began to <w>decay</w>.",
                            "target_lang_translations": {
                                "ru": "Без регулярного ухода старый дом начал <w>ветшать</w>.",
                                "zh": "由于缺乏定期维护，这座老房子开始<w>破败</w>。",
                                "cs": "Bez pravidelné údržby začal starý dům <w>chátrat</w>."
                            }
                        },
                        {
                            "text": "Her memories of that day started to <w>decay</w> as years passed.",
                            "target_lang_translations": {
                                "ru": "Ее воспоминания о том дне начали <w>угасать</w> с годами.",
                                "zh": "随着岁月流逝，她对那一天的记忆开始<w>衰退</w>。",
                                "cs": "Její vzpomínky na ten den začaly s přibývajícími lety <w>upadat</w>."
                            }
                        }
                    ],
                    "antonyms": [
                        "improve",
                        "flourish"
                    ],
                    "common_phrases": [
                        "continue to decay"
                    ],
                    "target_lang_definitions": {
                        "ru": "Постепенно ухудшаться по качеству, силе или состоянию",
                        "zh": "质量、力量或状况逐渐变差。",
                        "cs": "Postupně se zhoršovat v kvalitě, síle nebo stavu."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приходить в упадок",
                                "target_lang_sense_clarification": "о зданиях, экономике или культуре"
                            },
                            {
                                "target_lang_word": "ветшать",
                                "target_lang_sense_clarification": "разрушаться от старости (о зданиях)"
                            },
                            {
                                "target_lang_word": "разрушаться",
                                "target_lang_sense_clarification": "терять целостность"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "衰退",
                                "target_lang_sense_clarification": "机能或状态逐渐减弱"
                            },
                            {
                                "target_lang_word": "破败",
                                "target_lang_sense_clarification": "指建筑物或环境因缺乏维护而损坏"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "chátrat",
                                "target_lang_sense_clarification": "o budovách nebo věcech, které ztrácejí kvalitu"
                            },
                            {
                                "target_lang_word": "upadat",
                                "target_lang_sense_clarification": "postupně ztrácet sílu nebo úroveň"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b663e0e8-5936-323d-8cbc-e923c364a39d",
                    "sense_definition": "To change into a different element or form by emitting radiation (of a radioactive substance).",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "physics_decay",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Uranium <w>decays</w> into lead over a very long period of time.",
                            "target_lang_translations": {
                                "ru": "Уран <w>распадается</w>, превращаясь в свинец, в течение очень длительного времени.",
                                "zh": "铀在漫长的时间里会<w>衰变</w>成铅。",
                                "cs": "Uran se po velmi dlouhou dobu <w>rozpadá</w> na olovo."
                            }
                        },
                        {
                            "text": "The radioactive material <w>decays</w> at a constant rate.",
                            "target_lang_translations": {
                                "ru": "Радиоактивный материал <w>распадается</w> с постоянной скоростью.",
                                "zh": "这种放射性物质以恒定的速率<w>衰变</w>。",
                                "cs": "Radioaktivní materiál se <w>rozpadá</w> konstantní rychlostí."
                            }
                        }
                    ],
                    "common_phrases": [
                        "decay into"
                    ],
                    "target_lang_definitions": {
                        "ru": "Превращаться в другой элемент или форму путем излучения радиации (о радиоактивном веществе)",
                        "zh": "（指放射性物质）通过发射辐射转变为不同的元素或形式。",
                        "cs": "Měnit se na jiný prvek nebo formu vyzařováním radiace (u radioaktivní látky)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "распадаться",
                                "target_lang_sense_clarification": "подвергаться ядерному распаду"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "衰变",
                                "target_lang_sense_clarification": "放射性核素的物理变化"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "rozpadat se",
                                "target_lang_sense_clarification": "podléhat radioaktivnímu rozpadu"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}