                ],
                "senses": [
                    {
                        "sense_id": "a1e5debe-82fc-38cb-9732-bc04ef3f1c23",
                        "entry_id": "2f846a69-63c3-3c3b-87e6-a4c427650ecb",
                        "glosses": [
                            "выдернуть пробку, затычку; открыть что-либо закупоренное"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd9c9509-64b1-479f-879b-4dab9457303d",
                                "sense_id": "a1e5debe-82fc-38cb-9732-bc04ef3f1c23",
                                "text": "Половой: (приносит бутылку) Прикажете откупорить? // Иван Петрович Бородкин: Откупори да бокальчиков дай."
                            },
                            {
                                "example_id": "7325854a-7cf7-49ad-af43-80d5a31c576b",
                                "sense_id": "a1e5debe-82fc-38cb-9732-bc04ef3f1c23",
                                "text": "Гетманов вернулся перед отправкой эшелона раскрасневшийся, весёлый, отказался от ужина, велел лишь порученцу откупорить бутылку мандариновой, любимой им воды."
                            },
                            {
                                "example_id": "71b47b4a-2e8d-40f4-bd37-9ad3163a5ccc",
                                "sense_id": "a1e5debe-82fc-38cb-9732-bc04ef3f1c23",
                                "text": "Он откупорил бутылку и налил себе и попу по стопке."
                            },
                            {
                                "example_id": "2f2a4699-bf19-473c-bde5-e60b556c2733",
                                "sense_id": "a1e5debe-82fc-38cb-9732-bc04ef3f1c23",
                                "text": ".. он с трудом откупорил сырую форточку .."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e501243e-b76b-4ec5-a95d-83db622b34dc",
                        "source_entry_id": "2f846a69-63c3-3c3b-87e6-a4c427650ecb",
                        "source_sense_id": "a1e5debe-82fc-38cb-9732-bc04ef3f1c23",
                        "target_lang_word": "uncork",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "uncork",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1d765c26-398c-349f-9537-b941752d0d5a",
                                        "entry_id": "fc99edb5-67d4-382f-b8ff-7675e1978ff3",
                                        "glosses": [
                                            "To open (a bottle or other container sealed with a cork or stopper) by removing the cork or stopper from."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a69b8fd-95e8-4612-ac82-7b13092c105a",
                                                "sense_id": "1d765c26-398c-349f-9537-b941752d0d5a",
                                                "text": "uncork a bottle of wine"
                                            },
                                            {
                                                "example_id": "a363d28b-9d97-40f5-bc13-32d7177b411e",
                                                "sense_id": "1d765c26-398c-349f-9537-b941752d0d5a",
                                                "text": "After Compiègne, André uncorked a bottle of his Vin Rosé which went down uncommonly well and we reached Aulnoye without further incident."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "55c970c3-c50c-36c0-ba86-79a085ec6eea",
                                        "entry_id": "fc99edb5-67d4-382f-b8ff-7675e1978ff3",
                                        "glosses": [
                                            "To release."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "15bf515a-70df-4545-844c-dac0dbdee89c",
                                                "sense_id": "55c970c3-c50c-36c0-ba86-79a085ec6eea",
                                                "text": "The 11 September attacks uncorked a whirlwind of outlandish conspiracy theories."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
