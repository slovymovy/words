                    {
                        "translation_id": "7c859e76-cf4a-4e52-a098-f38d1927e2b7",
                        "source_entry_id": "92382689-0e0f-33fb-936c-9bfa4229c432",
                        "source_sense_id": "f4fd63ac-de6f-30e5-a687-2951e3b7bcfa",
