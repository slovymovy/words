                        "form_id": "1d87aeb2-ede4-410d-a6cf-8d0d1f00d33f",
                        "entry_id": "e1a5f533-1a04-3ffe-a145-6edc23d399ce",
                        "tags": [
                            "plural"
                        ],
                        "form": "microbibliothèques"
                    },
                    {
                        "form_id": "f07d9c93-d147-480b-b6bc-f509bd7322d7",
                        "entry_id": "e1a5f533-1a04-3ffe-a145-6edc23d399ce",
