                    "frequency": "Middle",
                    "semantic_group_id": "spectacle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette <w>troupe</w> de théâtre part en tournée dans toute la France cet été."
                        },
                        {
                            "text": "Tous les membres de la <w>troupe</w> répètent chaque jour avant la première représentation."
