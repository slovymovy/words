                                                "sense_id": "020caee9-92f5-3f3f-8898-16d20bb77b94",
                                                "text": "Hra se nám dařila. Během několika minut jsme vyřídily šest kluků."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3cb1e267-7e2d-30ba-87c5-2a774a259de2",
                                        "entry_id": "2dcb55ac-8b7f-3c3d-a14b-d69fc4d934e7",
                                        "glosses": [
