                                "target_senses": [
                                    {
                                        "sense_id": "d6adb781-b7d2-3f08-b665-6b63c2e2167a",
                                        "entry_id": "f50d8c20-0591-321b-88e2-cba744d63f82",
                                        "glosses": [
                                            "A becoming glad."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ef176a05-d6d0-4f30-9c44-95dd611fbf82",
                                                "sense_id": "d6adb781-b7d2-3f08-b665-6b63c2e2167a",
                                                "text": "After the buoyancy and gladdenings of her joyous welcome had subsided, she requested that he would make a point of coming to her ball — the same to which Miss Cunningham and her aunt were invited."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "gladdening",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "640e9cc8-7c51-3158-830a-8abe508ba446",
                                        "entry_id": "186b9201-5f4c-3bd2-a95d-b783627cea5f",
                                        "glosses": [
                                            "Causing feelings of gladness."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "711d200d-246f-48df-93e6-ecbb79625a8d",
                                                "sense_id": "640e9cc8-7c51-3158-830a-8abe508ba446",
                                                "text": "Now, the cheerful sun looks in mockingly; we rejoice not in the face of day; it brings not hope, but memory to our minds; and we only watch the gladdening beams to think that they are shining on the narrow grave."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
