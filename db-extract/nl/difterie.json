                                        "entry_id": "5748b207-756e-3583-89dd-307413ee7ee6",
                                        "glosses": [
                                            "vor allem bei Kindern auftretende, häufig tödlich verlaufende Infektionskrankheit der oberen Atemorgane; hervorgerufen durch das grampositive Corynebacterium diphtheriae"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "79107e51-73bb-4ecd-8230-853281165684",
                                                "sense_id": "002bff04-3f7b-35ed-9052-016d3720801d",
                                                "text": "Emil von Behring hat im Jahr 1890 ein Heilserum gegen die Diphtherie entwickelt."
                                            },
                                            {
                                                "example_id": "83b54862-e8ba-430e-b541-15cb8eaff59b",
                                                "sense_id": "002bff04-3f7b-35ed-9052-016d3720801d",
                                                "text": "„Eines Tages brach auf dem Darß die Diphtherie aus.“"
                                            },
                                            {
                                                "example_id": "3b7113e4-2df8-42e7-895d-b81de32da444",
                                                "sense_id": "002bff04-3f7b-35ed-9052-016d3720801d",
                                                "text": "„Pocken, Grippe, Masern, Diphtherie töteten wohl 90 Prozent der indigenen Bevölkerung Nordamerikas.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8e2f8001-723a-44b4-ab9f-b7710b4ea5a2",
                        "source_entry_id": "b898f4fe-b02c-35b2-a5d8-4daafc57939f",
                        "source_sense_id": "5992c869-04ec-3f09-93ba-7e37b48ae6cd",
