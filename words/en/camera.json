                    "sense_id": "43bb3a97-dd2a-38a3-a1c3-8c7e1b7e5923",
                    "sense_definition": "A device for taking still or moving pictures or photographs.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "device",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I used my new digital <w>camera</w> to take photos of the sunset.",
                            "target_lang_translations": {
                                "ru": "Я использовал свою новую цифровую <w>камеру</w>, чтобы сфотографировать закат.",
                                "nl": "Ik gebruikte mijn nieuwe digitale <w>camera</w> om foto's van de zonsondergang te maken.",
                                "pl": "Użyłem mojego nowego <w>aparatu cyfrowego</w>, aby zrobić zdjęcia zachodu słońca.",
                                "de": "Ich habe meine neue digitale <w>Kamera</w> benutzt, um Fotos vom Sonnenuntergang zu machen.",
                                "fr": "J'ai utilisé mon nouvel <w>appareil photo</w> numérique pour prendre des photos du coucher de soleil.",
                                "it": "Ho usato la mia nuova <w>macchina fotografica</w> digitale per fare foto al tramonto.",
                                "cs": "K pořízení fotek západu slunce jsem použil svůj nový digitální <w>fotoaparát</w>.",
                                "tr": "Gün batımının fotoğraflarını çekmek için yeni dijital <w>fotoğraf makinemi</w> kullandım.",
                                "es": "Usé mi nueva <w>cámara</w> digital para tomar fotos del atardecer."
                            }
                        },
                        {
                            "text": "Please look at the <w>camera</w> and smile for the picture.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, посмотрите в <w>камеру</w> и улыбнитесь для снимка.",
                                "nl": "Kijk alsjeblieft naar de <w>camera</w> en lach voor de foto.",
                                "pl": "Proszę spojrzeć w <w>obiektyw</w> i uśmiechnąć się do zdjęcia.",
                                "de": "Bitte schau in die <w>Kamera</w> und lächle für das Foto.",
                                "fr": "S'il vous plaît, regardez l'<w>appareil photo</w> et souriez pour la photo.",
                                "it": "Per favore, guarda la <w>fotocamera</w> e sorridi per la foto.",
                                "cs": "Podívejte se prosím do <w>fotoaparátu</w> a usmějte se na fotku.",
                                "tr": "Lütfen <w>kameraya</w> bakın ve fotoğraf için gülümseyin.",
                                "es": "Por favor, mira a la <w>cámara</w> y sonríe para la foto."
                            }
                        }
                    ],
                    "common_phrases": [
                        "digital camera",
                        "security camera",
                        "on camera",
                        "camera lens"
