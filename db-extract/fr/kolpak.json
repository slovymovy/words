                "word": "kolpak",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "b31cd6f7-e059-480f-ba34-43446516e27b",
                        "entry_id": "17f351c9-51ae-39df-8612-34e392ad33d0",
                        "tags": [
                            "plural"
                        ],
                        "form": "kolpaks"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d5ead895-4399-3eb1-acb8-bc10e6518dab",
                        "entry_id": "17f351c9-51ae-39df-8612-34e392ad33d0",
                        "glosses": [
                            "Chapeau porté en Russie et dans l’est de l’Europe ainsi qu'en Asie centrale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "33bcaa39-1eb7-4bc8-b6b5-b37650ecfeb4",
                                "sense_id": "d5ead895-4399-3eb1-acb8-bc10e6518dab",
                                "text": "Un beau type de Roumain, ce Nicolas ou plutôt Nic Deck : vingt-cinq ans, haute taille, constitution vigoureuse, tête fièrement portée, chevelure noire que recouvre le kolpak blanc."
                            },
                            {
                                "example_id": "7d02562c-8ba8-40de-a481-f3e3aa630110",
                                "sense_id": "d5ead895-4399-3eb1-acb8-bc10e6518dab",
                                "text": "Les Cosaques portent un kolpak, bonnet fort haut, un pantalon large et une capote à la mode polonaise."
                            },
                            {
                                "example_id": "39a04016-5cf0-481d-a328-8a6b0f5c3c4b",
                                "sense_id": "d5ead895-4399-3eb1-acb8-bc10e6518dab",
                                "text": "Et sous les turbans, kolpaks, calots, bonnets et koulas, émergeaient, les files des visages où était inscrite selon la structure des arêtes et des méplats, la différence de leurs origines : montagnes, vallées, déserts et plaines, migrations et conquêtes et sangs mélangés."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bbef133a-aa20-4390-841e-4be5fec64dff",
                        "source_entry_id": "17f351c9-51ae-39df-8612-34e392ad33d0",
                        "source_sense_id": "d5ead895-4399-3eb1-acb8-bc10e6518dab",
                        "target_lang_word": "kołpak",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
