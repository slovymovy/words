                "senses": [
                    {
                        "sense_id": "76f207d0-baa8-3141-a706-e389c0df63f7",
                        "entry_id": "cd67078d-2125-38c0-b616-1bced2e9485e",
                        "glosses": [
                            "snel heen en weer bewegend; op en neer bewegend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "327ceb37-244a-42db-9af5-87fadd429856",
                                "sense_id": "76f207d0-baa8-3141-a706-e389c0df63f7",
                                "text": "Ga met je rug naar het bureau staan, zet je handen op de rand en buig je armen. Doel: strakke bovenarmen, geen schuddende kipfilets meer."
                            },
                            {
                                "example_id": "c0122922-7a7b-4e1e-8e0c-2f51aeee15af",
                                "sense_id": "76f207d0-baa8-3141-a706-e389c0df63f7",
                                "text": "Komt vooral door die lach van Geer. Die is onweerstaanbaar. Een hoog hoehoehihi dat overgaat in een hees geluid dat, als je je ogen dicht doet, ook best kan doorgaan voor een astma-aanval. Blinkend witte tanden bloot, hand op zijn schuddende buik. Soms lijken zijn ogen niet helemaal mee te doen, maar dat zegt niks bij Geer. Dat kan ook het gevolg zijn van een spuitje botox te veel."
                            }
                        ]
                    }
                ],
