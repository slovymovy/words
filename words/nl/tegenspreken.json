    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ab32e6c5-8295-336c-8ead-87a3072f54af",
                    "sense_definition": "beweren dat wat iemand anders zegt niet waar is",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "communicatie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het is niet beleefd om je leraren voortdurend <w>tegen te spreken</w> tijdens de les.",
                            "target_lang_translations": {
                                "en": "It is not polite to constantly <w>contradict</w> your teachers during class."
                            }
                        },
                        {
                            "text": "Niemand durfde de directeur <w>tegen te spreken</w> uit angst voor de gevolgen.",
                            "target_lang_translations": {
                                "en": "No one dared to <w>contradict</w> the director for fear of the consequences."
                            }
                        }
                    ],
                    "synonyms": [
                        "weerspreken"
                    ],
                    "antonyms": [
                        "bevestigen",
                        "instemmen"
                    ],
                    "common_phrases": [
                        "iemand tegenspreken",
                        "elkaar tegenspreken"
                    ],
                    "target_lang_definitions": {
                        "en": "to claim that what someone else says is not true"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "contradict",
                                "target_lang_sense_clarification": "to deny the truth of someone's statement"
                            },
                            {
                                "target_lang_word": "talk back",
                                "target_lang_sense_clarification": "to answer someone rudely or defiantly"
                            },
                            {
                                "target_lang_word": "gainsay",
                                "target_lang_sense_clarification": "to deny or speak against (formal)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "748f84b3-7a1c-3e24-b3e6-77cfeefa0536",
                    "sense_definition": "in strijd zijn met eerdere verklaringen of feiten",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "communicatie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De getuigenissen van de twee verdachten <w>spreken</w> elkaar volledig <w>tegen</w>.",
                            "target_lang_translations": {
                                "en": "The testimonies of the two suspects completely <w>contradict</w> each other."
                            }
                        },
                        {
                            "text": "Deze nieuwe bewijzen <w>spreken</w> de eerdere theorie van de wetenschappers <w>tegen</w>.",
                            "target_lang_translations": {
                                "en": "This new evidence <w>contradicts</w> the scientists' earlier theory."
                            }
                        }
                    ],
                    "synonyms": [
                        "weerspreken"
                    ],
                    "antonyms": [
                        "overeenkomen"
                    ],
                    "common_phrases": [
                        "elkaar tegenspreken",
                        "feiten tegenspreken"
                    ],
                    "target_lang_definitions": {
                        "en": "to be in conflict with previous statements or facts"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "contradict",
                                "target_lang_sense_clarification": "to be inconsistent with something else"
                            },
                            {
                                "target_lang_word": "conflict with",
                                "target_lang_sense_clarification": "to be incompatible or at odds with"
                            },
                            {
                                "target_lang_word": "clash with",
                                "target_lang_sense_clarification": "to be very different and not match"
                            }
                        ]
                    }
                }
            ]
        }
    ]
