                ],
                "senses": [
                    {
                        "sense_id": "a96a6ff3-6351-3ad2-8d6e-0dab0edd922a",
                        "entry_id": "26072dd6-d81d-348f-931e-8b5a8c2eb851",
                        "glosses": [
                            "Faire perdre son caractère brisé à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9efdfc03-3f80-4610-b5cb-e22da47c718c",
                                "sense_id": "a96a6ff3-6351-3ad2-8d6e-0dab0edd922a",
                                "text": "Moi aussi, je n’aurai pas trop de ces quatre jours de plus pour me débriser un peu, car je me sens triste et fatigué."
                            },
                            {
                                "example_id": "7262ac44-6c53-4be9-99af-773e3172ec17",
                                "sense_id": "a96a6ff3-6351-3ad2-8d6e-0dab0edd922a",
                                "text": "Le Seigneur l’a voulu débriser par douleur, veu qu’il a mis son âme pour le péché, il verra sa postérité, et prolongera ses jours, etc."
                            }
                        ]
                    },
                    {
                        "sense_id": "c0ee0774-fbdf-31b4-afa4-06a38784495d",
                        "entry_id": "26072dd6-d81d-348f-931e-8b5a8c2eb851",
                        "glosses": [
                            "Briser."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "a5dce8b5-b6bd-4fb3-879f-ffd2b797616f",
                                "sense_id": "c0ee0774-fbdf-31b4-afa4-06a38784495d",
                                "text": "Ses connaissances en médecine lui ont permis de soigner les navrés tandis que ses pairs ostoyaient et se faisaient honteusement débriser par leurs ennemis."
                            }
                        ]
                    }
                ],
