                        "sense_id": "8c766bb9-64a8-371c-a30f-71373e8a7057",
                        "entry_id": "72efbb8b-85e9-3320-ba67-2f71af81a791",
                        "glosses": [
                            "A funeral rite or service."
                        ],
                        "tags": [
                            "in-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "021522a8-0179-4a68-8ff7-37156d81e2f8",
                                "sense_id": "8c766bb9-64a8-371c-a30f-71373e8a7057",
                                "text": "And to the ladyes he reſtored agayn / The bodyes of her huſbandes yͭ were ſlayn / To done obſequies as tho was the gyſe.",
                                "translation": "And to the ladies he restored again / The bodies of their husbands that were slain / To do obsequies as then was the custom.",
                                "english": "And to the ladies he restored again / The bodies of their husbands that were slain / To do obsequies as then was the custom."
                            },
                            {
                                "example_id": "ba75221a-545f-4417-acaa-67d14dae82ee",
                                "sense_id": "8c766bb9-64a8-371c-a30f-71373e8a7057",
                                "text": "It was a rather ghastly ceremony, but it was the only means in our power of showing our respect to the faithful dead and of celebrating his obsequies."
                            },
                            {
                                "example_id": "40d28405-cb0b-466d-be14-aee9f2fc9cfe",
                                "sense_id": "8c766bb9-64a8-371c-a30f-71373e8a7057",
                                "text": "But, to-day, there were no obsequies to observe at all."
                            }
                        ]
                    }
