                    {
                        "translation_id": "42a906c2-04af-4c66-8a30-8512db5bf47b",
                        "source_entry_id": "4a32ddc2-a7c7-38cc-afbf-ebb23318b4c2",
                        "source_sense_id": "3f056694-f417-3ba1-8400-33b4aa6f78a2",
                        "target_lang_word": "receiver (of stolen or illegal goods)",
                        "target_lang_code": "en",
