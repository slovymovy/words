                    {
                        "sense_id": "fd78f3fa-7993-3d62-888b-251ddeced842",
                        "entry_id": "9ff7576c-d352-3b54-b96a-032b93be1b41",
                        "glosses": [
                            "die Knospe an Gewächsen, aus welchen sich die Blätter entwickeln"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "796952dd-ddea-4f0d-a048-9200a5f19fa2",
                                "sense_id": "fd78f3fa-7993-3d62-888b-251ddeced842",
                                "text": "„Der Stiel ist kurz, 1 Zoll lang, dick, mit einem dicken, kurzen Absatz, an welchem gewöhnlich ein Blattauge sitzt; er steht in einer tiefen, schönen Höhlung.“"
                            },
                            {
                                "example_id": "8d2bac0b-00ef-419c-baa8-bf8afcace251",
                                "sense_id": "fd78f3fa-7993-3d62-888b-251ddeced842",
                                "text": "„Der Bouquetzweig besteht aus einem Sträußchen von 4—7 Blütenknospen mit einem Blattauge in der Mitte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
