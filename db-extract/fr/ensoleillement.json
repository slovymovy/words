                    {
                        "sense_id": "353ede45-ab7b-3145-8ca6-496bec24892f",
                        "entry_id": "fbd18154-00be-3acf-b72f-670939132b17",
                        "glosses": [
                            "Proportion du temps pendant lequel le soleil illumine un lieu sur une certaine durée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "690c44ca-9073-4627-80c4-140ac8968ac0",
                                "sense_id": "353ede45-ab7b-3145-8ca6-496bec24892f",
                                "text": "Un Noir en Europe avec un ensoleillement faible risque de souffrir de rachitisme par hypovitaminose car moins d’ultraviolets arriveront dans le derme."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3822b655-6ee5-4a69-a621-6c1be8cee0b5",
                        "source_entry_id": "fbd18154-00be-3acf-b72f-670939132b17",
                        "source_sense_id": "353ede45-ab7b-3145-8ca6-496bec24892f",
                        "target_lang_word": "Sonnenschein",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sonnenschein",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "14e587db-e9d6-3106-ac6c-19cc517315c3",
                                        "entry_id": "50d44642-f651-30a4-9779-ea2b895f7532",
                                        "glosses": [
                                            "die Lichtstrahlen der Sonne, die die Erde erreichen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "193e79f5-3648-490b-8bc1-40e2f9ee9a29",
                                                "sense_id": "14e587db-e9d6-3106-ac6c-19cc517315c3",
                                                "text": "Bei Sonnenschein werden wir in den Park gehen."
                                            },
                                            {
                                                "example_id": "de52af9e-55f4-45d8-89c0-52ce3c9da8be",
                                                "sense_id": "14e587db-e9d6-3106-ac6c-19cc517315c3",
                                                "text": "„Der Sonnenschein lag noch gelblich auf der Wiese draußen.“"
                                            },
                                            {
                                                "example_id": "dfc2e589-6ba1-4ffb-bf6a-feb9ef26fef5",
                                                "sense_id": "14e587db-e9d6-3106-ac6c-19cc517315c3",
                                                "text": "„Ein Sonnenschein lag über dem Hause Carayon, und Victoire vergaß aller Betrübnis, die vorausgegangen war.“"
                                            },
                                            {
                                                "example_id": "78ff98b6-8dc4-4838-a498-761f30e99d3f",
                                                "sense_id": "14e587db-e9d6-3106-ac6c-19cc517315c3",
                                                "text": "„Der Tod enttäuscht einen nie, er ist unermüdlich, er ruht niemals, streift immer umher, im Regen wie bei Sonnenschein, in Hungersnöten wie in guten Zeiten, seine Aktien fallen nie, und nicht selten steigen sie.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "09b10db2-5713-314d-9381-e3074d5f8cb9",
                                        "entry_id": "50d44642-f651-30a4-9779-ea2b895f7532",
                                        "glosses": [
                                            "ein Kosewort"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03098665-c86f-49b3-8797-2529fef12151",
                                                "sense_id": "09b10db2-5713-314d-9381-e3074d5f8cb9",
                                                "text": "Du bist mein Sonnenschein, / Laß mich nie mehr allein, / Micaela-aha - (Schlager)"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Sonnenschein",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bf0b0528-4be9-336b-89bd-b24e63b223ef",
                                        "entry_id": "2566e29b-5c2a-3188-9044-18baa4afb8a0",
                                        "glosses": [
                                            "deutscher Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "98e06515-2987-4720-8330-272859f6efaf",
                                                "sense_id": "bf0b0528-4be9-336b-89bd-b24e63b223ef",
                                                "text": "Herr Sonnenschein ist im Ruhestand."
                                            },
                                            {
                                                "example_id": "152ca3ea-1151-4be7-9d7e-be519dad583b",
                                                "sense_id": "bf0b0528-4be9-336b-89bd-b24e63b223ef",
                                                "text": "Die Sonnenscheins leben zurückgezogen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1ff04526-bd9e-4ef1-bec6-39e5b6ee5796",
