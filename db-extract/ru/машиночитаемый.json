                        "entry_id": "42b20072-d5ee-3f20-a51f-1f9c4158d816",
                        "glosses": [
                            "комп. читаемый компьютером, машиной, распознаваемый компьютерной программой"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "40fb13bd-e478-4fd3-a845-a10543e5728b",
                                "sense_id": "6bcc1bb6-9d57-387c-a515-1d7f29c534af",
                                "text": "Ведет систему библиотечных каталогов и картотек на традиционных и машиночитаемых носителях с целью многоаспектного библиографического раскрытия фондов."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7840c736-aae3-4c6f-8e1b-b252a59d1cab",
                        "source_entry_id": "42b20072-d5ee-3f20-a51f-1f9c4158d816",
                        "source_sense_id": "6bcc1bb6-9d57-387c-a515-1d7f29c534af",
                        "target_lang_word": "machine-readable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "machine-readable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "771c39a4-201b-3b8d-b2a5-22bb1346b7e6",
                                        "entry_id": "65c16e74-4c29-37aa-9e9e-9a393b2393cd",
                                        "glosses": [
                                            "Capable of being read by a machine, especially a computer system."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc921cf2-53b0-4795-8859-85fa0958ecf2",
                                                "sense_id": "771c39a4-201b-3b8d-b2a5-22bb1346b7e6",
                                                "text": "This encoded every single piece of information about you, your body and your life into one all-purpose machine-readable card that you could then carry around in your wallet, and therefore represented technology’s greatest triumph to date over both itself and plain common sense."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d8959f1f-02ec-35c7-ba95-8bc531d2f40a",
                                        "entry_id": "65c16e74-4c29-37aa-9e9e-9a393b2393cd",
                                        "glosses": [
                                            "Organised or formatted in a way that permits unambiguous interpretation by a program."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17964727-5f7c-4cf9-909c-81e562e7ef58",
                                                "sense_id": "d8959f1f-02ec-35c7-ba95-8bc531d2f40a",
                                                "text": "machine-readable dictionary"
                                            },
                                            {
                                                "example_id": "79ccec65-c9ea-439d-ae71-f6b2d5258eef",
                                                "sense_id": "d8959f1f-02ec-35c7-ba95-8bc531d2f40a",
                                                "text": "An ASCII text file may not be considered machine-readable if its contents do not follow a predictable, well-defined structure."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "700c8715-b660-46fa-8c9d-5cf247cd3e23",
                        "source_entry_id": "42b20072-d5ee-3f20-a51f-1f9c4158d816",
