                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "bfc9644c-af29-3e49-996d-1209030429ff",
                        "entry_id": "2f4dfb3d-e282-3122-bdbe-3ec24bc7bb69",
                        "glosses": [
                            "The state of being emaciated or reduced to excessive leanness; an excessively lean condition."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "26fcbbc9-1a01-4ba9-89bb-12773eeec80b",
                                "sense_id": "bfc9644c-af29-3e49-996d-1209030429ff",
                                "text": "In youth he must have been singularly handsome, but years and care had left their vestiges on his noble features, which were thin even to emaciation."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3e746f6e-972a-4315-ad4d-ca5a2e999e4b",
                        "source_entry_id": "2f4dfb3d-e282-3122-bdbe-3ec24bc7bb69",
                        "source_sense_description": "the act of making very lean",
                        "target_lang_word": "émaciation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
