                        "entry_id": "c9f285b4-f6a4-3e3f-a32d-aba98c09e5e7",
                        "glosses": [
                            "związany z wysyłką, zajmujący się wysyłką"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92c6aa8d-a488-42d6-ae78-a315ecaa89a3",
                                "sense_id": "3230e9a3-9484-394e-92f6-a16a5818ca49",
                                "text": "Nasz sklep prowadzi także sprzedaż wysyłkową."
