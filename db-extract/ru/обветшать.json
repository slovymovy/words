                "senses": [
                    {
                        "sense_id": "0d496641-5452-3f76-a3f4-35b0ca19334e",
                        "entry_id": "9bea128f-14db-3721-8380-78e714015aef",
                        "glosses": [
                            "стать ветхим от времени, от долгого употребления и т. п."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "04440b5a-26d6-4980-8311-280e8e0640af",
                                "sense_id": "0d496641-5452-3f76-a3f4-35b0ca19334e",
                                "text": "Разделите одежды мои: епископу Афанасию отдайте одну милоть и подостланную подо мною одежду - она им мне дана новая и у меня обветшала, а епископу Серапиону отдайте другую милоть, власяницу возьмите себе."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2abf6e12-dc56-4264-b1ee-509d58a355a2",
                        "source_entry_id": "9bea128f-14db-3721-8380-78e714015aef",
                        "source_sense_id": "0d496641-5452-3f76-a3f4-35b0ca19334e",
                        "target_lang_word": "dilapidate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dilapidate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "387c17d4-e12f-3fa0-840a-107501be2f62",
                                        "entry_id": "a62014f2-0902-3c6e-a733-7bc0081229ab",
                                        "glosses": [
                                            "To cause to become ruined or put into disrepair."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6f2f93ff-dded-4cdf-939b-6b7691375888",
                                                "sense_id": "387c17d4-e12f-3fa0-840a-107501be2f62",
                                                "text": "If the bishop, parson, or vicar, etc., dilapidates the buildings, or cuts down the timber of the patrimony[…]"
                                            },
                                            {
                                                "example_id": "ed32550e-19a6-4ee6-87c3-2d64b2cfe42f",
                                                "sense_id": "387c17d4-e12f-3fa0-840a-107501be2f62",
                                                "text": "In the last days of autumn he had whitewashed the chalet, painted the doors, windows, and veranda, repaired the roof and interior, and improved the place so much that the landlord had warned him that the rent would be raised at the expiration of his twelvemonth's tenancy, remarking that a tenant could not reasonably expect to have a pretty, rain-tight dwelling-house for the same money as a hardly habitable ruin. Smilash had immediately promised to dilapidate it to its former state at the end of the year."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ab0fed9f-499f-3c01-99e1-6cb6c1ff4422",
                                        "entry_id": "a62014f2-0902-3c6e-a733-7bc0081229ab",
                                        "glosses": [
                                            "To squander or waste."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dba3d5a2-3821-46e5-87dc-bcac680c7fd4",
                                                "sense_id": "ab0fed9f-499f-3c01-99e1-6cb6c1ff4422",
                                                "text": "The patrimony of the bishopric of Oxon was much dilapidated."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "549f0afd-de08-3b51-ae8a-08202cb8d041",
                                        "entry_id": "a62014f2-0902-3c6e-a733-7bc0081229ab",
                                        "glosses": [
                                            "To fall into ruin or disuse."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "intransitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
