                        "glosses": [
                            "Nanoparticule entrant dans la composition d’un produit alimentaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ea9b177-51bd-4339-9c8b-432305cdd781",
                                "sense_id": "0b1b4799-5ea8-3856-8b30-7db5fb86eeb7",
                                "text": "Il conviendra également d’analyser l’impact potentiel sur l’environnement de ce nano-ingrédient issu de la nature."
                            },
                            {
                                "example_id": "3cf6aec0-e2fb-4f6b-a263-cce54d699919",
                                "sense_id": "0b1b4799-5ea8-3856-8b30-7db5fb86eeb7",
                                "text": "Pire, le nano-ingrédient attire. Le plus décrié, l’additif alimentaire E171, encore appelé dioxyde de titane, se cache dans les paquets de bonbons ou autres confiseries."
                            },
                            {
                                "example_id": "0a674a13-dd70-4f96-af6c-b369e8dc362f",
                                "sense_id": "0b1b4799-5ea8-3856-8b30-7db5fb86eeb7",
                                "text": "C’est d’ailleurs pour cela que, depuis presque trois ans, un règlement européen impose d’indiquer sur l’étiquette la présence d’un nano-ingrédient."
                            }
                        ]
                    }
