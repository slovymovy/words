                "senses": [
                    {
                        "sense_id": "5e73c9cb-84de-3a83-aeb6-9692070c7e18",
                        "entry_id": "6ceb2322-a547-3032-95c1-d92132d13953",
                        "glosses": [
                            "Person, die auf einem Holzblasinstrument spielt"
                        ],
                        "tags": [
                            "Musik"
                        ],
                        "examples": [
                            {
                                "example_id": "9c342e22-14e9-4997-a2ea-77c9a492d15f",
                                "sense_id": "5e73c9cb-84de-3a83-aeb6-9692070c7e18",
                                "text": "„An den Philharmonikern schätzt der 40-Jährige die weichen Streicher, den speziellen Klang der Holzbläser und das kammermusikalische Agieren.“"
                            },
                            {
                                "example_id": "f3f8eb24-1c3c-4c69-99a8-167e473545d3",
                                "sense_id": "5e73c9cb-84de-3a83-aeb6-9692070c7e18",
                                "text": "„Zu den Disziplinen Klavier, Geige, Cello und Gesang waren erstmals zwei weitere hinzugekommen: Holzbläser, also Flöte, Oboe, Klarinette, Fagott, sowie Blechbläser mit Horn, Trompete, Posaune und Tuba.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
