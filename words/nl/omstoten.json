                    "frequency": "Middle",
                    "semantic_group_id": "omvallen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij <w>stootte</w> per ongeluk het glas water <w>om</w> tijdens het eten.",
                            "target_lang_translations": {
                                "en": "He accidentally <w>knocked over</w> the glass of water during dinner.",
                                "ru": "Он случайно <w>опрокинул</w> стакан воды во время еды."
                            }
                        },
                        {
                            "text": "Pas op dat je die dure vaas niet <w>omstoot</w> met je tas.",
                            "target_lang_translations": {
                                "en": "Be careful not to <w>knock over</w> that expensive vase with your bag.",
                                "ru": "Смотри не <w>опрокинь</w> ту дорогую вазу своей сумкой."
                            }
                        }
                    ],
                    "synonyms": [
                        "omverwerpen",
                        "omverstoten"
                    ],
                    "antonyms": [
                        "rechtopzetten"
                    ],
                    "common_phrases": [
                        "een glas omstoten",
                        "per ongeluk omstoten",
                        "een vaas omstoten"
                    ],
                    "target_lang_definitions": {
                        "en": "to cause something to fall over by hitting or pushing it",
                        "ru": "заставить что-либо упасть, ударив или толкнув это"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "knock over",
                                "target_lang_sense_clarification": "to tip something over by bumping it"
                            },
                            {
                                "target_lang_word": "knock down",
                                "target_lang_sense_clarification": "to cause something to fall to the ground"
                            },
                            {
                                "target_lang_word": "topple",
                                "target_lang_sense_clarification": "to cause to become unsteady and fall"
                            }
                        ],
                        "ru": [
