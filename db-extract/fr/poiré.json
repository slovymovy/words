        "fr-extract.jsonl": [
            {
                "entry_id": "a944874c-0fe5-3585-bf93-7f50b6f51066",
                "word": "poiré",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "f013dbf4-c575-4724-8cce-1c65eb15e019",
                        "entry_id": "a944874c-0fe5-3585-bf93-7f50b6f51066",
                        "tags": [
                            "plural"
                        ],
                        "form": "poirés"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "80a5ac9b-9569-3504-9500-bd1d11eef770",
                        "entry_id": "a944874c-0fe5-3585-bf93-7f50b6f51066",
                        "glosses": [
                            "Boisson faite par fermentation alcoolique de jus de poires pressurées."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cbd8f3b3-4ec7-4ec4-a25f-5ac4df8a92d9",
                                "sense_id": "80a5ac9b-9569-3504-9500-bd1d11eef770",
                                "text": "Alors il chercha l’oubli tour à tour dans le cidre normand, le poiré manceau, l’hydromel gaulois, le cognac français, le genièvre hollandais, le gin anglais, le wiskey écossais, le kirsch germain."
                            },
                            {
                                "example_id": "e68d4265-1683-4051-99b1-8ce390a394da",
                                "sense_id": "80a5ac9b-9569-3504-9500-bd1d11eef770",
                                "text": "D’une façon succincte, l’opinion des cidrologues de tous les temps, qu’ils soient médecins, savants ou praticiens, est qu’il existe une catégorie de poirés qui, soigneusement préparés avec des poires de choix, constituent une boisson très agréable et rivalisant avec les meilleurs cidres au point de vue des qualités intrinsèques."
                            },
                            {
                                "example_id": "86525118-067f-45d5-adb6-4a4775c5bfc4",
                                "sense_id": "80a5ac9b-9569-3504-9500-bd1d11eef770",
                                "text": "Aucune boisson alcoolisée autre que le vin, la bière, le cidre et le poiré n’est autorisée sur le lieu de travail."
                            },
                            {
                                "example_id": "cee26251-626c-4126-8d9a-edbb00a5bba3",
                                "sense_id": "80a5ac9b-9569-3504-9500-bd1d11eef770",
                                "text": "Nous avons beaucoup pressé de fruits cet hiver, dit Christel ; cela nous fait au moins dix mesures de cidre et vingt de poiré. C’est une boisson plus rafraîchissante que le vin, pendant les moissons."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "483b47fc-6736-46c4-8a12-e33a73853521",
                        "source_entry_id": "a944874c-0fe5-3585-bf93-7f50b6f51066",
                        "source_sense_id": "80a5ac9b-9569-3504-9500-bd1d11eef770",
                        "target_lang_word": "Birnenmost",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Birnenmost",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0b37f0cb-efbb-3acc-bf6a-fb6688c8cabb",
                                        "entry_id": "e7d6e0bc-32d9-3f0c-a5a1-5218b267d97b",
                                        "glosses": [
                                            "ein Obstwein aus Birnen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da1d4ceb-afea-4a76-bcff-3c624621fceb",
                                                "sense_id": "0b37f0cb-efbb-3acc-bf6a-fb6688c8cabb",
                                                "text": "Birnen haben im Gegensatz zu Äpfeln meist weniger Säure (deswegen ist Birnenmost milder), dafür oft mehr Gerbstoffe, wie sie auch in gehaltvollen Rotweinen vorkommen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b1d42dd3-5301-4707-b055-1c4b74527c8c",
                        "source_entry_id": "a944874c-0fe5-3585-bf93-7f50b6f51066",
                        "source_sense_id": "80a5ac9b-9569-3504-9500-bd1d11eef770",
                        "target_lang_word": "Birnenwein",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Birnenwein",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2b38f01f-ad5e-3322-b204-20572f59a27e",
                                        "entry_id": "24bd7adb-a23a-3f61-b5e3-43a4f4717505",
                                        "glosses": [
                                            "Obstwein, der aus Birnen hergestellt wurde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ace27f3-0735-4761-893b-44f175212378",
                                                "sense_id": "2b38f01f-ad5e-3322-b204-20572f59a27e",
                                                "text": "„Brand aus Apfel- / Birnenwein ist die Bezeichnung für Spirituosen, die ausschließlich durch Destillation von Apfel- / Birnenwein hergestellt und bis maximal 86% vol. ausdestilliert werden, sodass der Geschmack der Ausgangsfrucht erhalten bleibt.“"
                                            },
                                            {
                                                "example_id": "1064f854-fdca-4d8f-97c9-9b14d2c1bead",
                                                "sense_id": "2b38f01f-ad5e-3322-b204-20572f59a27e",
                                                "text": "„In den nördlicheren Gefilden des römischen Reiches waren zweifellos Apfelwein und Birnenwein die wichtigsten Obstweintypen.“"
                                            },
                                            {
                                                "example_id": "917bce71-93f4-46de-9d62-f678c113a6b4",
                                                "sense_id": "2b38f01f-ad5e-3322-b204-20572f59a27e",
                                                "text": "Ich trinke gerne einen Birnenwein."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "65673d0d-870f-440a-8e75-78629cb3b271",
                        "source_entry_id": "a944874c-0fe5-3585-bf93-7f50b6f51066",
                        "source_sense_id": "80a5ac9b-9569-3504-9500-bd1d11eef770",
                        "target_lang_word": "perry",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "perry",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8e6e5075-8b3c-36ec-aa97-02838f2c186e",
                                        "entry_id": "bf4065f2-e87b-30d4-9cbc-8ceaa77af3c0",
                                        "glosses": [
                                            "A fermented alcoholic beverage made from pears; somewhat analogous to cider."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2a316286-2e85-4548-9d42-7d49fe1d300e",
                                                "sense_id": "8e6e5075-8b3c-36ec-aa97-02838f2c186e",
                                                "text": "Perry is less popular than cider, but some consider it superior."
                                            },
                                            {
                                                "example_id": "6d27645d-b21d-4f67-b4b0-7e3cc9d763bd",
                                                "sense_id": "8e6e5075-8b3c-36ec-aa97-02838f2c186e",
                                                "text": "Sip the perry of the Black Worchester and you will belch clouds of soot."
                                            },
                                            {
                                                "example_id": "17098eca-6284-44f5-88ba-b0e2532aeb40",
                                                "sense_id": "8e6e5075-8b3c-36ec-aa97-02838f2c186e",
                                                "text": "M. Vasse never observed a fatal termination unless in two instances ; in which the persons, adults, had drank perry in large quantity."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
