                ],
                "senses": [
                    {
                        "sense_id": "f52c8988-6841-3c73-a7af-a804561e37d5",
                        "entry_id": "8195bbfc-1520-3f3e-adf4-3837802139b2",
                        "glosses": [
                            "een opschudding verwekkend voorval"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6077d0cd-e56d-4bfb-bae8-e5ad368ff211",
                                "sense_id": "f52c8988-6841-3c73-a7af-a804561e37d5",
                                "text": "Er was gisteren een ernstig incident aan de grens met Noord-Korea."
                            }
                        ]
                    },
                    {
                        "sense_id": "938a5634-80e0-3da1-94e3-b8d706c41421",
                        "entry_id": "8195bbfc-1520-3f3e-adf4-3837802139b2",
                        "glosses": [
                            "vervelende gebeurtenis, ongeval"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab04799f-53a0-429d-b852-143b5c3650e5",
                                "sense_id": "938a5634-80e0-3da1-94e3-b8d706c41421",
                                "text": "Het cabinepersoneel zou normaal gesproken bij de nooduitgang zitten. Het is niet duidelijk waarom zij het incident niet konden voorkomen. In een verklaring, zei PIA: ,,Een passagier opende ten onrechte de nooddeur waardoor de noodglijbaan geactiveerd werd.”"
                            },
                            {
                                "example_id": "14181bae-ea0a-4e75-a89c-708e897cf71a",
                                "sense_id": "938a5634-80e0-3da1-94e3-b8d706c41421",
                                "text": "De tocht bleef, aldus de organisatie, verschoond van grote incidenten, al moest twee keer na een valpartij een ambulance worden gebeld."
                            },
                            {
                                "example_id": "cb161dcf-355b-4423-b19b-4ccdb7e789e1",
                                "sense_id": "938a5634-80e0-3da1-94e3-b8d706c41421",
                                "text": "Tunnels worden vanuit de verkeerscentrales 24 uur per dag in de gaten gehouden met camera's en detectiesystemen. \"Zo kunnen wegverkeersleiders bij incidenten de tunnel afsluiten, hulpdiensten alarmeren en installaties in de tunnels bedienen\", schrijft Rijkswaterstaat."
                            }
                        ]
                    },
                    {
                        "sense_id": "d5e3555d-7871-34f8-a883-1ffe8fbd9931",
                        "entry_id": "8195bbfc-1520-3f3e-adf4-3837802139b2",
                        "glosses": [
                            "twistpunt naast het hoofdgeschil in een geding [1]"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c5a0cc1-0234-44f3-aa16-7f9ac60ea706",
                                "sense_id": "d5e3555d-7871-34f8-a883-1ffe8fbd9931",
                                "text": "De RvA kan voor de behandeling van het incident om een aanvulling van de waarborgsom vragen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6fecfee5-5200-49b8-8803-df0ee5cac5b9",
                        "source_entry_id": "8195bbfc-1520-3f3e-adf4-3837802139b2",
                        "source_sense_id": "f52c8988-6841-3c73-a7af-a804561e37d5",
                        "source_sense_description": "een opschudding verwekkend voorval",
                        "target_lang_word": "Zwischenfall",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zwischenfall",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "41eef506-791b-3ce6-9430-4e82c535c0cb",
                                        "entry_id": "64e71d0c-b50d-32da-a9d2-1bc4c3d230f6",
                                        "glosses": [
                                            "ein unvorhergesehenes, störendes Ereignis"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "85fec2af-2b90-4d78-8207-cc77d718c02e",
                                                "sense_id": "41eef506-791b-3ce6-9430-4e82c535c0cb",
                                                "text": "Entschuldigung, dass ich zu spät bin, es gab einen Zwischenfall. Jaja, ich weiß, ich hab mein Bein verloren."
                                            },
                                            {
                                                "example_id": "42181e0e-144a-4d6f-8f25-3698bd4f7aeb",
                                                "sense_id": "41eef506-791b-3ce6-9430-4e82c535c0cb",
                                                "text": "Unser Ausflug in die Berge verlief ohne nennenswerte Zwischenfälle."
                                            },
                                            {
                                                "example_id": "f2b94e47-0de4-4e02-8ca4-565657fb7be8",
                                                "sense_id": "41eef506-791b-3ce6-9430-4e82c535c0cb",
                                                "text": "„Der Zwischenfall hat mich noch etwas anderes gelehrt.“"
                                            },
                                            {
                                                "example_id": "24c499bc-f170-46b4-a449-925796fa6877",
                                                "sense_id": "41eef506-791b-3ce6-9430-4e82c535c0cb",
                                                "text": "„Die Mutter hatte den Zwischenfall genossen, da konnte mir ihre perfekt geheuchelte Anteilnahme nichts vormachen.“"
                                            },
                                            {
                                                "example_id": "e3efae69-bfb9-4c78-861e-2788cae3f932",
                                                "sense_id": "41eef506-791b-3ce6-9430-4e82c535c0cb",
                                                "text": "„Der Zwischenfall tat dem Ehrgeiz und Forscherdrang des Deutschen keinen Abbruch.“"
                                            },
                                            {
                                                "example_id": "1a7de2db-3812-405e-bb8b-215273e4e953",
                                                "sense_id": "41eef506-791b-3ce6-9430-4e82c535c0cb",
                                                "text": "„Nach diesem Zwischenfall waren die Nachbarn weggeblieben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3c33e50a-5add-3bbb-9601-d06181007ad7",
                                        "entry_id": "64e71d0c-b50d-32da-a9d2-1bc4c3d230f6",
                                        "glosses": [
                                            "Auflauf und Zusammenstoß von aufgebrachten Menschen"
                                        ],
                                        "tags": [
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee67fbcb-b6a2-4480-9265-e6f997496a7e",
                                                "sense_id": "3c33e50a-5add-3bbb-9601-d06181007ad7",
                                                "text": "Während der Demonstration kam es zu blutigen Zwischenfällen."
                                            },
                                            {
                                                "example_id": "0e61043d-9ceb-4be6-95c8-8efa30831b1f",
                                                "sense_id": "3c33e50a-5add-3bbb-9601-d06181007ad7",
                                                "text": "„Der Sprecher meldete schwere Zwischenfälle an der Grenze zu Sierra Leone.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
