        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "4ba242c8-7f08-3913-8692-e6273cecc3e3",
                    "sense_definition": "Belonging to the sex or gender that typically produces sperm and does not give birth.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "bio_gender",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>male</w> bird has much brighter feathers than the female.",
                            "target_lang_translations": {
                                "ru": "У <w>самца</w> птицы оперение гораздо ярче, чем у самки.",
                                "zh": "<w>雄性</w>鸟的羽毛比雌性鲜艳得多。"
                            }
                        },
                        {
                            "text": "He is currently working as a <w>male</w> nurse in the local hospital.",
                            "target_lang_translations": {
                                "ru": "В настоящее время он работает <w>медбратом</w> в местной больнице.",
                                "zh": "他目前在当地医院担任<w>男</w>护士。"
                            }
                        }
                    ],
                    "antonyms": [
                        "female"
                    ],
                    "common_phrases": [
                        "male nurse",
                        "male population",
                        "male friend"
                    ],
                    "target_lang_definitions": {
