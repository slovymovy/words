                "senses": [
                    {
                        "sense_id": "13275444-3a39-3a02-b7b1-55db144e7707",
                        "entry_id": "9e3ba834-6543-3a3b-8628-cf85988f4402",
                        "glosses": [
                            "Deaktivierung von Enzymen beziehungsweise Hemmung einer enzymatischen Reaktion durch einen Hemmstoff (Inhibitor)"
                        ],
                        "tags": [
                            "Biochemie"
                        ],
                        "examples": [
                            {
                                "example_id": "59e6ea72-c951-46af-a3ca-e6a8d02fdef9",
                                "sense_id": "13275444-3a39-3a02-b7b1-55db144e7707",
                                "text": "„Das Komitee zieht besonders zwei Hypothesen in Betracht: zum einen, dass der Effekt des Wirkstoffs über die reine Enzymhemmung hinausgehen könnte.“"
                            },
                            {
                                "example_id": "4d7ffddb-f87b-4ef3-b4aa-574433510e35",
                                "sense_id": "13275444-3a39-3a02-b7b1-55db144e7707",
                                "text": "„Folglich kann die längerfristige Enzymhemmung per NSAR, wie Hans-Peter Wirth vom Schweizerischen Gastrozentrum Kreuzlingen erklärt, ‚in dem einen Organ erwünschte, in dem anderen aber unerwünschte Wirkungen auslösen‘.“"
                            },
                            {
                                "example_id": "c1cb3f2a-9e78-46b3-84d1-9010284da28d",
                                "sense_id": "13275444-3a39-3a02-b7b1-55db144e7707",
                                "text": "„Harald Haupt, Chefarzt der Städtischen Kinderklinik Duisburg: Schwefeldioxide und deren Umwandlungsprodukte, die eingeatmet werden, können nach heutigem Stand der Kenntnis über Reizwirkung, lokale Enzymhemmung und Allergie zu Schädigung oder Krankheitsauslösung führen.“"
                            },
                            {
                                "example_id": "b56da781-b9b9-49c0-bd8b-3e648e49151a",
                                "sense_id": "13275444-3a39-3a02-b7b1-55db144e7707",
                                "text": "„Das Potenzial der Enzymhemmung ist nach Jomaas Einschätzung mit der Malaria-Bekämpfung längst nicht ausgeschöpft.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
