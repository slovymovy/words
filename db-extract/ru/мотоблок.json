                "senses": [
                    {
                        "sense_id": "699afc53-b926-3a40-8aa0-c54f98d7d837",
                        "entry_id": "7042a630-8284-3851-aad3-e12693260dce",
                        "glosses": [
                            "two-wheel tractor, walking tractor"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e249fac6-5de7-4e8f-85f7-9d3646309d41",
                                "sense_id": "699afc53-b926-3a40-8aa0-c54f98d7d837",
                                "text": "Конституцио́нный суд (КС) не стал рассма́тривать запро́с о прове́рке статьи́ 12.8 КоАП РФ, в кото́рой пропи́сано наказа́ние за пья́ное вожде́ние. Прове́рку запроси́л оди́н из мировы́х суде́й по́сле того́, как ГИБДД хоте́ла наказа́ть граждани́на, по́йманного в нетре́звом ви́де за рулём мотобло́ка — двухколёсного агрега́та для садо́вых рабо́т и культива́ции земли́. Судья́ усмотре́л «нея́сность» в но́рмах КоАП РФ, не позволя́ющую определи́ть, явля́ется ли мотобло́к тра́нспортным сре́дством.",
                                "translation": "Kommersant",
                                "english": "Kommersant"
                            }
                        ]
                    }
