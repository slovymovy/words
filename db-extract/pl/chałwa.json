                        "entry_id": "716bea01-968d-30d7-b57b-90f3fa1741e4",
                        "glosses": [
                            "wyrób cukierniczy z karmelu oraz zmiażdżonych nasion oleistych"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a01647b3-9b4b-428f-a83e-4974b69feef1",
                                "sense_id": "a19d2e37-5c48-32da-8f55-6c8f4d070d64",
                                "text": "Sabina zrobiła chałwę waniliową z warstwą grylażu."
                            },
                            {
                                "example_id": "384d2f41-8a7e-4bb2-9863-32d8d6ecbb18",
                                "sense_id": "a19d2e37-5c48-32da-8f55-6c8f4d070d64",
                                "text": "Odrazą napawa ją befsztyk krwisty, przepada natomiast za oleistą, mdłą chałwą."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
