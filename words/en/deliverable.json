{
    "word_family": [
        "deliver",
        "delivery",
        "deliverance",
        "deliverer"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b1a952f5-8772-3abb-b6eb-6718664cc990",
                    "sense_definition": "A tangible object or result that must be completed and handed over as part of a project or agreement.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "project management",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The team is working hard to ensure every <w>deliverable</w> is ready by the Friday deadline.",
                            "target_lang_translations": {
                                "ru": "Команда усердно работает над тем, чтобы каждый <w>результат</w> был готов к крайнему сроку в пятницу."
                            }
                        },
                        {
                            "text": "We need to define the key <w>deliverables</w> before we sign the contract with the client.",
                            "target_lang_translations": {
                                "ru": "Нам нужно определить <w>ключевые</w> <w>показатели</w> до того, как мы подпишем контракт с клиентом."
                            }
                        }
                    ],
                    "synonyms": [
                        "output",
                        "product",
                        "result"
                    ],
                    "common_phrases": [
                        "key deliverable",
                        "project deliverable",
                        "final deliverable"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "business"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Материальный объект или результат, который должен быть завершен и передан в рамках проекта или соглашения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "результат",
                                "target_lang_sense_clarification": "конкретный итог работы"
                            },
                            {
                                "target_lang_word": "отчетный материал",
                                "target_lang_sense_clarification": "документация или продукт для сдачи"
                            },
                            {
                                "target_lang_word": "объект поставки",
                                "target_lang_sense_clarification": "в контексте контрактов"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "062ccc2f-9467-3d86-966f-217134f0f99e",
                    "sense_definition": "Capable of being physically transported and handed over to a recipient, or capable of being achieved.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "capability",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The package was not <w>deliverable</w> because the address provided was incorrect.",
                            "target_lang_translations": {
                                "ru": "Посылка была <w>недоставляемой</w>, так как указанный адрес был неверным."
                            }
                        },
                        {
                            "text": "The manager asked if the proposed targets were actually <w>deliverable</w> within the current budget.",
                            "target_lang_translations": {
                                "ru": "Менеджер спросил, являются ли предложенные цели действительно <w>выполнимыми</w> в рамках текущего бюджета."
                            }
                        }
                    ],
                    "synonyms": [
                        "achievable",
                        "feasible",
                        "transportable"
                    ],
                    "antonyms": [
                        "undeliverable"
                    ],
                    "common_phrases": [
                        "not deliverable",
                        "deliverable address"
                    ],
                    "target_lang_definitions": {
                        "ru": "Способный быть физически доставленным получателю или способный быть достигнутым/выполненным."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "доставляемый",
                                "target_lang_sense_clarification": "о почте или грузе"
                            },
                            {
                                "target_lang_word": "выполнимый",
                                "target_lang_sense_clarification": "о целях или планах"
                            },
                            {
                                "target_lang_word": "достижимый",
                                "target_lang_sense_clarification": "о результатах"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}