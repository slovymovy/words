                {
                    "sense_id": "ad2ea5f8-c123-3516-8962-6f83079c2384",
                    "sense_definition": "kraty w więziennym oknie",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "okno",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Patrzył przez więzienne <w>firanki</w> na szare niebo.",
                            "target_lang_translations": {
                                "en": "He looked at the gray sky through the prison <w>bars</w>.",
                                "ru": "Он смотрел сквозь тюремную <w>решётку</w> на серое небо.",
                                "nl": "Hij keek door de gevangenis<w>tralies</w> naar de grijze lucht.",
                                "de": "Er blickte durch die Gefängnis<w>gitter</w> in den grauen Himmel.",
                                "fr": "Il regardait le ciel gris à travers les <w>barreaux</w> de la prison.",
                                "it": "Guardava il cielo grigio attraverso le <w>sbarre</w> della prigione.",
                                "cs": "Díval se přes vězeňské <w>mříže</w> na šedou oblohu.",
                                "tr": "Hapishanenin <w>parmaklıkları</w> ardından gri gökyüzüne bakıyordu.",
                                "es": "Miraba el cielo gris a través de las <w>rejas</w> de la prisión.",
                                "zh": "他透过监狱的<w>铁窗</w>望着灰蒙蒙的天空。"
                            }
                        },
                        {
                            "text": "Za tymi <w>firankami</w> spędził wiele długich lat.",
                            "target_lang_translations": {
                                "en": "Behind those <w>bars</w>, he spent many long years.",
                                "ru": "За этой <w>решёткой</w> он провёл много долгих лет.",
                                "nl": "Achter die <w>tralies</w> bracht hij vele lange jaren door.",
                                "de": "Hinter diesen <w>schwedischen Gardinen</w> verbrachte er viele lange Jahre.",
                                "fr": "Derrière ces <w>barreaux</w>, il a passé de longues années.",
                                "it": "Dietro quelle <w>sbarre</w> trascorse molti lunghi anni.",
                                "cs": "Za těmito <w>mřížemi</w> strávil mnoho dlouhých let.",
                                "tr": "Bu <w>demir parmaklıklar</w> ardında uzun yıllar geçirdi.",
                                "es": "Pasó muchos y largos años tras esos <w>barrotes</w>.",
                                "zh": "他在那重重<w>铁窗</w>后度过了漫长的岁月。"
                            }
                        }
                    ],
