                    {
                        "sense_id": "3875b872-da92-372e-b4c0-1ddb22e17f39",
                        "entry_id": "9ced3e2d-7f02-31ae-99e3-a6d14f09da69",
                        "glosses": [
                            "iets dat via een postbedrijf verstuurd kan worden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b11fe0ce-c2ec-48f7-a855-f8a366a90fa2",
                                "sense_id": "3875b872-da92-372e-b4c0-1ddb22e17f39",
                                "text": "De dertig grootste verzenders van poststukken in Nederland - zoals banken en energieleveranciers - zien een overname van PostNL door Bpost niet zitten."
                            },
                            {
                                "example_id": "a02b6db7-c469-48ee-9bb9-292ffb0af081",
                                "sense_id": "3875b872-da92-372e-b4c0-1ddb22e17f39",
                                "text": "Hoewel een speciale uitgave valt de zegel net als speciale euromunten daadwerkelijk te gebruiken, namelijk voor aangetekende poststukken. De meeste fans zullen de uitgave echter ongetwijfeld willen bewaren."
                            }
                        ]
                    }
