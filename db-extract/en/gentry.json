                            },
                            {
                                "example_id": "fcb3324c-134d-4d10-8478-ee0cf1c581c7",
                                "sense_id": "91b8dc7d-9762-3c05-8be0-6dd28efb5c11",
                                "text": "The manor was owned by the local gentry."
                            },
                            {
                                "example_id": "464d5f79-d692-4c45-8539-5898e5d526c5",
                                "sense_id": "91b8dc7d-9762-3c05-8be0-6dd28efb5c11",
