                "senses": [
                    {
                        "sense_id": "984e7db0-8dfd-3e41-8d50-cd4e3087e9b0",
                        "entry_id": "c1e9ae9b-ef18-3aa8-871a-d11728f9e9e9",
                        "glosses": [
                            "Messgerät zur Bestimmung der Trübung durch kleine Feststoffe in einer Flüssigkeit oder einem Aerosol"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "763a461e-6091-418d-8439-ef9c305613ae",
                                "sense_id": "984e7db0-8dfd-3e41-8d50-cd4e3087e9b0",
                                "text": "„Die Suspensionen werden mit dem Nephelometer nach GATES auf einen Keimgehalt von 30 Milliarden je Kubikzentimeter standardisiert.“"
                            },
                            {
                                "example_id": "5e8cbdaf-a751-48c8-8938-545ba6205b36",
                                "sense_id": "984e7db0-8dfd-3e41-8d50-cd4e3087e9b0",
                                "text": "„Die Verwendung des Nephelometers, in welchem die trübe Schicht seitlich belichtet ist (System Rona-Kleinmann), dürfte sich auch hier empfehlen.“"
                            },
                            {
                                "example_id": "7c2891b9-b8fb-49ec-94de-77ca067b43b4",
                                "sense_id": "984e7db0-8dfd-3e41-8d50-cd4e3087e9b0",
                                "text": "„Das Funktionsprinzip eines Nephelometers ist ähnlich dem des Opazimeters mit dem Unterschied, dass die Messgröße das Streulicht ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
