                    },
                    {
                        "translation_id": "fea42966-7b87-4846-b535-160472ff253f",
                        "source_entry_id": "a74d4c71-c6a8-3355-831d-829690d1fa9c",
                        "source_sense_id": "69b2a1dc-5032-340b-9863-3e522e844f89",
                        "target_lang_word": "rhomboidal",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rhomboidal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0f1e58c0-b526-3dda-ad6c-e7bd8ada0d32",
                                        "entry_id": "e0e5560b-d8d1-3f03-b180-c5bf1254c69c",
                                        "glosses": [
                                            "rhomboid, having a rhomboid shape"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "004423da-dad3-4a55-b45b-8975e07bea09",
                                                "sense_id": "0f1e58c0-b526-3dda-ad6c-e7bd8ada0d32",
                                                "text": "Bisect it by a line drawn diagonally from the angles, and after this bisecting bring together the outlines of the figure so that it may present a rhomboidal design, reducing it by one sixth of its length and one fourth of its breadth at the (obtuse) angles."
                                            },
                                            {
                                                "example_id": "5513aefb-8442-4acc-9b60-9125504c95be",
                                                "sense_id": "0f1e58c0-b526-3dda-ad6c-e7bd8ada0d32",
                                                "text": "The coupled model is global in domain and consists of GCMs of the atmosphere (spectral model with rhomboidal 30 truncation, corresponding to an approximate resolution of 3.75° longitude by 2.25° latitude, with 14 vertical levels) and ocean (1.875° longitude by 2.25° latitude, with 18 vertical levels)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
