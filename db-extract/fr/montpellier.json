                                    {
                                        "sense_id": "e3ac02f0-4e80-3139-9b9b-b2f3e00d5e93",
                                        "entry_id": "a14bd6e6-a723-3fc6-a0c7-fd1bcd2e99cf",
                                        "glosses": [
                                            "große Stadt an der französischen Mittelmeerküste"
                                        ],
                                        "tags": [
                                            "geography"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ee090fe-9aa5-496a-ad77-d9db905fed18",
                                                "sense_id": "e3ac02f0-4e80-3139-9b9b-b2f3e00d5e93",
                                                "text": "Montpellier unterhält eine Städtepartnerschaft mit Heidelberg."
                                            },
                                            {
                                                "example_id": "c950fda3-7c08-407d-9ddc-13c65bf6ef49",
                                                "sense_id": "e3ac02f0-4e80-3139-9b9b-b2f3e00d5e93",
                                                "text": "„Vor meiner Abreise aus Montpellier hatte ich die Gewißheit, daß mein Besuch die Achtung ihres Mannes und ihrer Schwiegermutter für sie vermehrt hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
