                "forms": [],
                "senses": [
                    {
                        "sense_id": "ec627095-a665-37fc-a3a5-f26527887b11",
                        "entry_id": "2ae6db7d-1b29-3894-bc47-92165ab5b44c",
                        "glosses": [
                            "Used as a scat word in song lyrics."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b01d6fc9-de44-4c4d-b241-2896596a7414",
                                "sense_id": "ec627095-a665-37fc-a3a5-f26527887b11",
                                "text": "If you want to know / (Shoop, shoop, shoop, shoop) / If he loves you so / (Shoop, shoop, shoop, shoop) / It's in his kiss."
                            },
                            {
                                "example_id": "730fee35-6663-4c7d-a748-911f38d59359",
                                "sense_id": "ec627095-a665-37fc-a3a5-f26527887b11",
                                "text": "But don't it make you feel good (Shoop shoop aaahh) / And don't it make you feel good (Shoop shoop aaahh) / Don't it make you feel good (Shoop shoop aaahh) / And don't it make you feel good (Shoop shoop aaahh)"
                            },
                            {
                                "example_id": "4889ebf2-bb2d-4bbd-a14a-138fb3a6301c",
                                "sense_id": "ec627095-a665-37fc-a3a5-f26527887b11",
                                "text": "I like what ya do when you do what ya do / You make me wanna shoop / Shoop shoop ba-doop / Shoop ba-doop"
                            },
                            {
                                "example_id": "3cf9c639-c382-4f43-a8cf-e5425c549ff7",
                                "sense_id": "ec627095-a665-37fc-a3a5-f26527887b11",
                                "text": "But there comes a point when / When we exhale (yeah, yeah, say) / Shoop, shoop, shoop / Shoo be doop shoop shoop (yeah)"
                            }
                        ]
                    }
                ],
