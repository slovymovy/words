                "senses": [
                    {
                        "sense_id": "8baa8abb-aa0d-366e-99fe-1535ac239877",
                        "entry_id": "69d32432-ec43-3a70-9e16-65a99c97a9eb",
                        "glosses": [
                            "deutscher Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da066077-4f04-4c09-8732-c40d55d548b8",
                                "sense_id": "8baa8abb-aa0d-366e-99fe-1535ac239877",
                                "text": "„Allen Einrichtungen gemeinsam ist der programmatische Anspruch ihrer Arbeit, den Adolph Kolping, der große deutsche Sozialreformer, schon vor 150 Jahren geprägt hat.“"
                            },
                            {
                                "example_id": "9eae116d-b552-49e3-80e1-9b70ee20cfb2",
                                "sense_id": "8baa8abb-aa0d-366e-99fe-1535ac239877",
                                "text": "Bei den Kolpings brennt Tag und Nacht das Licht."
                            },
                            {
                                "example_id": "431e70eb-2970-4675-b7f2-f4933ca0ac53",
                                "sense_id": "8baa8abb-aa0d-366e-99fe-1535ac239877",
                                "text": "Herr Kolping repariert alte Nähmaschinen."
                            },
                            {
                                "example_id": "142a8229-40f5-4c37-9749-1792ca4114a4",
                                "sense_id": "8baa8abb-aa0d-366e-99fe-1535ac239877",
                                "text": "Von der jungen Kolping kann sich unsere Tochter eine Scheibe abschneiden."
                            },
                            {
                                "example_id": "74c83bd5-3366-4a99-ad52-080bf114824a",
                                "sense_id": "8baa8abb-aa0d-366e-99fe-1535ac239877",
                                "text": "Die Kolping ist mit ihrer Katze in Urlaub gefahren."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
