                ],
                "senses": [
                    {
                        "sense_id": "15ae1a45-6abc-3b12-9d2d-8ad0c6715c44",
                        "entry_id": "517fc531-f28c-3880-803d-9a5027c0d888",
                        "glosses": [
                            "One who practices locksmithing."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0cb597df-d0dc-4233-90e0-6168e668c94e",
                                "sense_id": "15ae1a45-6abc-3b12-9d2d-8ad0c6715c44",
                                "text": "Piccadilly, 12:30 o'clock.--Just before we reached Fenchurch Street Lord Godalming said to me, \"Quincey and I will find a locksmith. You had better not come with us in case there should be any difficulty. For under the circumstances it wouldn't seem so bad for us to break into an empty house."
                            },
                            {
                                "example_id": "afd29aa1-ddc7-4119-9865-aceca2170b15",
                                "sense_id": "15ae1a45-6abc-3b12-9d2d-8ad0c6715c44",
                                "text": "The door was very strong, the lock excellent; the carpenter avowed he would have great trouble and have to do much damage, if force were to be used; and the locksmith was near despair."
                            }
                        ]
                    },
                    {
                        "sense_id": "fd4fa04f-a39b-3c58-9c77-13c659aab78c",
                        "entry_id": "517fc531-f28c-3880-803d-9a5027c0d888",
                        "glosses": [
                            "Someone who only bets when they are sure they will win."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": []
                    }
                ],
