                    "sense_id": "5d14e859-9c6d-34b5-ac3c-a3a7e5c9a060",
                    "sense_definition": "Zich in een horizontale positie bevinden, meestal om te rusten of te slapen.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "position_physical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik ben moe en ga even op de bank <w>liggen</w>.",
                            "target_lang_translations": {
                                "ru": "Я устал и пойду немного <w>полежу</w> на диване.",
                                "en": "I am tired and am going to <w>lie down</w> on the couch for a bit.",
                                "pl": "Jestem zmęczony i pójdę na chwilę <w>położyć się</w> na kanapie.",
                                "de": "Ich bin müde und gehe mich kurz auf das Sofa <w>hinlegen</w>.",
                                "fr": "Je suis fatigué et je vais m'<w>allonger</w> un peu sur le canapé.",
                                "it": "Sono stanco e vado a <w>sdraiarmi</w> un attimo sul divano.",
                                "cs": "Jsem unavený a půjdu si na chvíli <w>lehnout</w> na pohovku.",
                                "tr": "Yorgunum ve kanepede biraz <w>uzanacağım</w>.",
                                "es": "Estoy cansado y me voy a <w>acostar</w> un rato en el sofá."
                            }
                        },
                        {
                            "text": "De hond <w>ligt</w> heerlijk te slapen in zijn mand.",
                            "target_lang_translations": {
                                "ru": "Собака <w>лежит</w> в своей корзине и сладко спит.",
                                "en": "The dog <w>is lying</w> sound asleep in his basket.",
                                "pl": "Pies smacznie <w>śpi</w> w swoim legowisku.",
                                "de": "Der Hund <w>liegt</w> herrlich schlafend in seinem Körbchen.",
                                "fr": "Le chien <w>est couché</w> et dort paisiblement dans son panier.",
                                "it": "Il cane <w>sta</w> dormendo beatamente nella sua cuccia.",
                                "cs": "Pes sladce <w>leží</w> a spí ve svém pelíšku.",
                                "tr": "Köpek sepetinde mışıl mışıl <w>uyuyor</w>.",
                                "es": "El perro <w>está</w> durmiendo plácidamente en su cesta."
                            }
                        }
                    ],
                    "antonyms": [
                        "staan",
                        "zitten"
                    ],
                    "common_phrases": [
                        "in bed liggen",
                        "op de grond liggen",
                        "wakker liggen"
