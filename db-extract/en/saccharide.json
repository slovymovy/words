                        "source_entry_id": "b468bc10-5f75-34b3-8fcb-60e6d7132c88",
                        "source_sense_id": "761f1c91-8df9-346f-b0ac-1a4ebe09b0d4",
                        "source_sense_description": "the unit structure of carbohydrates, of general formula CnH2nOn",
                        "target_lang_word": "saccharide",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "saccharide",
