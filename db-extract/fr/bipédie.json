                    {
                        "sense_id": "f4ffdb48-e6b6-3d44-8223-6b27f12f40f0",
                        "entry_id": "da6f70df-6caa-3259-aa6c-b5d708eada01",
                        "glosses": [
                            "Fait de se mouvoir debout sur deux membres postérieurs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7454c82f-5c3d-4f99-a48a-ea99a93fc173",
                                "sense_id": "f4ffdb48-e6b6-3d44-8223-6b27f12f40f0",
                                "text": "La bipédie est une caractéristique de l’espèce humaine."
                            },
                            {
                                "example_id": "7c81f355-3969-4847-b306-ed578349d005",
                                "sense_id": "f4ffdb48-e6b6-3d44-8223-6b27f12f40f0",
                                "text": "Depuis l’époque de Darwin, on pensait que lorsque la position érigée et la bipédie furent acquises, les mains purent ensuite développer la capacité à manipuler des objets."
                            },
                            {
                                "example_id": "88321acb-5ce8-4c4c-9034-ab1cd3ba0e2f",
                                "sense_id": "f4ffdb48-e6b6-3d44-8223-6b27f12f40f0",
                                "text": "Lucy a notamment fait reculer l’acquisition de la bipédie chez les hominidés à 3,2 millions d’années."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "43f5d2a6-e813-4cd9-909a-205ba93526b6",
                        "source_entry_id": "da6f70df-6caa-3259-aa6c-b5d708eada01",
