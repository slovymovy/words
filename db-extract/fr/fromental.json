            {
                "entry_id": "61f3b7c3-a310-3fda-8ee0-43637efcc41f",
                "word": "Fromental",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "d18904e3-0a41-38c3-8be0-e58b4e82a91c",
                        "entry_id": "61f3b7c3-a310-3fda-8ee0-43637efcc41f",
                        "glosses": [
                            "Commune française du département de la Haute-Vienne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "07bb21ce-7fb1-4aae-a0bd-bac1bb6536f6",
                                "sense_id": "d18904e3-0a41-38c3-8be0-e58b4e82a91c",
                                "text": "À Fromental, les jeunes filles viendront vers nous, barrant la route, timides et rieuses. La plus jolie vous paraîtra avoir des taches de rousseur, mais c’est qu’avant de l’admirer, vous aurez regardé le soleil."
                            }
                        ]
                    },
                    {
                        "sense_id": "a59b917c-4eec-3e28-854f-7ca15b85c86c",
                        "entry_id": "61f3b7c3-a310-3fda-8ee0-43637efcc41f",
                        "glosses": [
                            "Lieu-dit du département du Gard rattaché à la commune de Saint-Roman-de-Codières (France)."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
