                "senses": [
                    {
                        "sense_id": "9b94adab-6b45-3bbc-bdde-aba7c96ca6ee",
                        "entry_id": "6f999683-d06b-371a-ba08-bfddcaa6cfd8",
                        "glosses": [
                            "советск. награждённый орденом Красного Знамени"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e61fa36-78af-43a4-928c-d95d8ca6a80a",
                                "sense_id": "9b94adab-6b45-3bbc-bdde-aba7c96ca6ee",
                                "text": "Пьянство ради пьянства в краснознамённом коллективе не поощрялось."
                            },
                            {
                                "example_id": "883e044e-6955-436e-9707-fa5f4aa65127",
                                "sense_id": "9b94adab-6b45-3bbc-bdde-aba7c96ca6ee",
                                "text": "По-русски он говорил без акцента, очевидно, в молодости учился в известном московском краснознамённом институте, где готовили разведчиков."
                            },
                            {
                                "example_id": "efc572b8-969e-47c5-bf74-fed03f646930",
                                "sense_id": "9b94adab-6b45-3bbc-bdde-aba7c96ca6ee",
                                "text": "Потом всё-таки явились краснознамённые большевики."
                            },
                            {
                                "example_id": "834ade3d-af5c-49ba-9b74-ace57544be89",
                                "sense_id": "9b94adab-6b45-3bbc-bdde-aba7c96ca6ee",
                                "text": "Первоначально в четырёх губернских участках Дальневосточного пограничного округа (Забайкальском, Амурском, Приамурском и Приморском) охрана государственной границы осуществлялась силами восьми пограничных эскадронов и двух отдельных стрелковых батальонов, переданных из состава 5-й Краснознамённой армии."
                            }
                        ]
                    }
