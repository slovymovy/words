                                        "entry_id": "927b3d05-bc34-3ef7-ae82-2944c4ca5cd1",
                                        "glosses": [
                                            "A nightmare; a frustrating or terrible experience."
                                        ],
                                        "tags": [
                                            "Commonwealth",
                                            "Ireland",
                                            "UK",
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
