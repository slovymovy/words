                                        "examples": [
                                            {
                                                "example_id": "5d1f1301-dcd3-437d-b5d8-9160a9c71d8e",
                                                "sense_id": "27d3d68b-2f1f-3e99-9a0b-ed9da074dc16",
                                                "text": "Tous les tridi et les sextidi, Rebstock réunissait les enfants du village dans l’église, et leur apprenait le catéchisme républicain."
                                            }
