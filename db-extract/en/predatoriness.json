                    {
                        "sense_id": "30eba901-618e-3236-867a-d71967eba591",
                        "entry_id": "02f5b19d-0935-3af7-9faa-297731b1ff16",
                        "glosses": [
                            "drapieżnictwo, drapieżność (cecha tego, co poluje na inne zwierzęta)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f2d8112-5067-4c84-89fc-1d586dc12823",
                                "sense_id": "30eba901-618e-3236-867a-d71967eba591",
                                "text": "Predatoriness on all living things by other things has gone on since time began and will continue—mankind being not the least predator.",
                                "translation": "Drapieżnictwo na wszystkich żywych stworzeniach przez inne stworzenia trwa od zarania dziejów i trwać będzie — a ludzkość nie jest w tym najmniejszym z drapieżników."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "d4405bb4-08af-337b-b126-a2361ef90b02",
                        "entry_id": "02f5b19d-0935-3af7-9faa-297731b1ff16",
                        "glosses": [
                            "drapieżność (bezwzględność i agresywność w dążeniu do celu)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "18013aa3-5633-4564-8cec-b7f9fb3fba0e",
                                "sense_id": "d4405bb4-08af-337b-b126-a2361ef90b02",
                                "text": "We have, in consequence, a society of thinly veneered predatoriness.",
                                "translation": "Mamy w rezultacie społeczeństwo odznaczające się cienko zawoalowaną drapieżnością."
                            }
                        ],
