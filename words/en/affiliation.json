                },
                {
                    "sense_id": "5804cab3-d615-3c7e-8ba7-f46a8d75abc9",
                    "sense_definition": "A specific organization, such as a club or trade union, that is a member of a larger umbrella group.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "association",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local branch is a small <w>affiliation</w> of the national labor union.",
                            "target_lang_translations": {
                                "ru": "Местное отделение — это небольшое <w>подразделение</w> национального профсоюза."
                            }
                        },
                        {
                            "text": "Each regional <w>affiliation</w> must follow the guidelines set by the central committee.",
                            "target_lang_translations": {
                                "ru": "Каждый региональный <w>филиал</w> должен следовать правилам, установленным центральным комитетом."
                            }
