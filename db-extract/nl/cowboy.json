                                "target_senses": [
                                    {
                                        "sense_id": "6cab84ea-215a-39a0-9510-b77e8ed3e57b",
                                        "entry_id": "3f0ac5f2-331e-35c2-922b-1880e96119ed",
                                        "glosses": [
                                            "To work as a cowboy, herding cattle."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e68613b9-bb1a-499c-bced-7a9784115be8",
                                                "sense_id": "6cab84ea-215a-39a0-9510-b77e8ed3e57b",
                                                "text": "Besides cowboying he worked at a small sawmill that cut logs into \"four slabs and a tie\" and sold ties to the railroad."
                                            },
                                            {
                                                "example_id": "88d960ba-f316-4327-9552-d78f85be029b",
                                                "sense_id": "6cab84ea-215a-39a0-9510-b77e8ed3e57b",
                                                "text": "Derwood Bailey cowboyed for 50 cents a day, a noon meal, and a gallon of oats for his horse."
                                            },
                                            {
                                                "example_id": "33a30663-524f-47b5-bd00-a0021dde0b93",
                                                "sense_id": "6cab84ea-215a-39a0-9510-b77e8ed3e57b",
                                                "text": "I still had never ridden or cowboyed, and I wanted to learn something about it. I'd been making the damn saddles for years but didn't know how to use them."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
