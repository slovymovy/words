                "senses": [
                    {
                        "sense_id": "3e40b075-52be-3c23-836d-af523e49a55f",
                        "entry_id": "0572690f-0617-35b2-90a5-429ef4920c24",
                        "glosses": [
                            "iets dat niet goed is gegaan"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "88028fa2-b0ff-4a4d-8a8b-82e10e8e4d2c",
                                "sense_id": "3e40b075-52be-3c23-836d-af523e49a55f",
                                "text": "Het eten bereiden was uitgelopen op een grote mislukking."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "09d67bd8-b5f9-4316-bd63-bc1b66a32c67",
                        "source_entry_id": "0572690f-0617-35b2-90a5-429ef4920c24",
                        "source_sense_id": "3e40b075-52be-3c23-836d-af523e49a55f",
                        "source_sense_description": "iets dat niet goed is gegaan",
                        "target_lang_word": "Misserfolg",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Misserfolg",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e4f58abf-e5cc-3706-83ef-7ea0c1cb3df6",
                                        "entry_id": "4955059e-b9be-305f-ab4d-b3dc1f790122",
                                        "glosses": [
                                            "Verfehlen eines gesteckten Ziels"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9af881e8-69d3-444b-a5e9-f6f2987790f0",
                                                "sense_id": "e4f58abf-e5cc-3706-83ef-7ea0c1cb3df6",
                                                "text": "Nachhaltige wirtschaftliche Misserfolge können in die Insolvenz führen."
                                            },
                                            {
                                                "example_id": "4e8e0356-5f75-473f-82fd-8bae44ec20d8",
                                                "sense_id": "e4f58abf-e5cc-3706-83ef-7ea0c1cb3df6",
                                                "text": "„In den letzten Jahren seiner Regierung plante Konstantin eine groß angelegte Militäraktion gegen die Perser, die aber durch seinen plötzlichen Tod nicht zur Ausführung kam. Sie wurde einige Jahre später (363) von Julian nachgeholt und endete mit einem Misserfolg, der noch schlimmer ausgefallen wäre, wenn die Kräfte Persiens eine offensive Westpolitik erlaubt hätten.“"
                                            },
                                            {
                                                "example_id": "91738a74-b5ab-49ed-aac8-a0239b9078ef",
                                                "sense_id": "e4f58abf-e5cc-3706-83ef-7ea0c1cb3df6",
                                                "text": "„Er konnte sich sogar über einen Misserfolg freuen, denn da der Misserfolg ja nur daher rührte, dass man sich in der Praxis nicht streng genug an seine Theorie gehalten hatte, so war er auch nur ein Beweis für die Richtigkeit seiner Theorie.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a96d7053-9e0a-4670-8321-97e3388c46d3",
                        "source_entry_id": "0572690f-0617-35b2-90a5-429ef4920c24",
                        "source_sense_id": "3e40b075-52be-3c23-836d-af523e49a55f",
                        "source_sense_description": "iets dat niet goed is gegaan",
                        "target_lang_word": "Fehlschlag",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fehlschlag",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7add33a9-00cc-37d6-a4b6-51fc609ea157",
                                        "entry_id": "17a1f3e1-97be-3e92-8883-828f225ab41e",
                                        "glosses": [
                                            "Schlag, der sein Ziel verfehlt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e6af84e-d94c-4202-8804-5b75bd0dfdd9",
                                                "sense_id": "7add33a9-00cc-37d6-a4b6-51fc609ea157",
                                                "text": "„Im Kampf ist jeder Fehlschlag auch verschwendete Energie.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e1f04514-0fce-3b2b-b16c-42bd792edd66",
                                        "entry_id": "17a1f3e1-97be-3e92-8883-828f225ab41e",
                                        "glosses": [
                                            "misslungenes Vorhaben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ef6226a-f893-4931-97a1-d955aa24a666",
                                                "sense_id": "e1f04514-0fce-3b2b-b16c-42bd792edd66",
                                                "text": "Unser nächstes Produkt darf auf keinen Fall wieder ein Fehlschlag werden, sonst sind wir pleite."
                                            },
                                            {
                                                "example_id": "05f6121c-cfdd-4644-b698-edc8849b73d9",
                                                "sense_id": "e1f04514-0fce-3b2b-b16c-42bd792edd66",
                                                "text": "„Mit ihren unerwarteten Einleitungen und Eingebungen hat sie bisweilen schwere Fehlschläge erlebt.“"
                                            },
                                            {
                                                "example_id": "ec011152-9a08-4c75-a90f-aed9ee8b07a6",
                                                "sense_id": "e1f04514-0fce-3b2b-b16c-42bd792edd66",
                                                "text": "„Während in der dritten Septemberwoche die nächsten Kriegsfreiwilligen einrückten und ausgebildet wurden, war der Fehlschlag der deutschen Strategie vor der Öffentlichkeit nicht mehr zu verheimlichen.“"
                                            },
                                            {
                                                "example_id": "366aa19e-30d7-439d-bbad-18cd885ec815",
                                                "sense_id": "e1f04514-0fce-3b2b-b16c-42bd792edd66",
                                                "text": "„Trotz der Dunkelheit befahl Napoleon einen erneuten Angriff auf die Schanze, weil er schlecht einschlafen konnte bei dem Gedanken, sein genialer Entschluss sei ein Fehlschlag gewesen, der die Moral seiner Soldaten geschwächt und die des Feindes gestärkt hatte.“"
                                            },
                                            {
                                                "example_id": "5749f19a-101e-43ec-8a35-619f37d5a81f",
                                                "sense_id": "e1f04514-0fce-3b2b-b16c-42bd792edd66",
                                                "text": "„Schweren Herzens und geängstigt durch die Vorstellung, daß ihr dieser Fehlschlag vielleicht einen Fehlschlag überhaupt bedeute, kehrte Frau von Carayon in das Gasthaus zurück.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d9f83b42-92da-4843-9b79-e27f856066f6",
                        "source_entry_id": "0572690f-0617-35b2-90a5-429ef4920c24",
                        "source_sense_id": "3e40b075-52be-3c23-836d-af523e49a55f",
                        "source_sense_description": "iets dat niet goed is gegaan",
                        "target_lang_word": "failure",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "failure",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a7629cfe-1cfb-3559-9594-d8294d2d9bec",
                                        "entry_id": "55dc3aa4-b161-396b-9901-3af6b6a43fb0",
                                        "glosses": [
                                            "State or condition of not meeting a desirable or intended objective, opposite of success."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "418522ba-9c0f-49c2-95fe-0534be243483",
                                                "sense_id": "a7629cfe-1cfb-3559-9594-d8294d2d9bec",
                                                "text": "For Liverpool, their season will now be regarded as a relative disappointment after failure to add the FA Cup to the Carling Cup and not mounting a challenge to reach the Champions League places."
                                            },
                                            {
                                                "example_id": "8855f191-2ece-4770-8777-2d17358b84b9",
                                                "sense_id": "a7629cfe-1cfb-3559-9594-d8294d2d9bec",
                                                "text": "Sarkozy's total will be seen as a personal failure. It is the first time an outgoing president has failed to win a first-round vote in the past 50 years and makes it harder for Sarkozy to regain momentum."
                                            },
                                            {
                                                "example_id": "738572ff-961d-42b3-b703-678254b027ac",
                                                "sense_id": "a7629cfe-1cfb-3559-9594-d8294d2d9bec",
                                                "text": "What exactly is a \"successful failure\" in rocket science? A so-called \"successful failure\" is one where important lessons can be gleaned for future tests and where the risks of harm are low, experts say."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "49070ad2-0599-3b05-b8fe-ca964a9bbf3a",
                                        "entry_id": "55dc3aa4-b161-396b-9901-3af6b6a43fb0",
                                        "glosses": [
                                            "State or condition of not meeting a desirable or intended objective, opposite of success.",
                                            "A condition in which a specified organ does not function well enough to support life."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "70099a53-13ef-4b2f-8638-2e164f336314",
                                                "sense_id": "49070ad2-0599-3b05-b8fe-ca964a9bbf3a",
                                                "text": "heart failure"
                                            },
                                            {
                                                "example_id": "cbe55320-7acf-4cf7-92ff-689d871dfe49",
                                                "sense_id": "49070ad2-0599-3b05-b8fe-ca964a9bbf3a",
                                                "text": "congestive heart failure"
                                            },
                                            {
                                                "example_id": "44ecba1a-8e66-43ad-a70a-c616ec0a61ae",
                                                "sense_id": "49070ad2-0599-3b05-b8fe-ca964a9bbf3a",
                                                "text": "liver failure"
                                            },
                                            {
                                                "example_id": "baaea44a-5281-43c2-b241-9dad13f2b08d",
                                                "sense_id": "49070ad2-0599-3b05-b8fe-ca964a9bbf3a",
                                                "text": "kidney failure"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ccd806ed-855f-354d-a89c-c30acb1d2c67",
                                        "entry_id": "55dc3aa4-b161-396b-9901-3af6b6a43fb0",
                                        "glosses": [
                                            "Omission to do something, whether or not it was attempted, especially something that ought to have been done."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5816cc6e-7eb4-3740-8f73-050f812c789e",
                                        "entry_id": "55dc3aa4-b161-396b-9901-3af6b6a43fb0",
                                        "glosses": [
                                            "An object, person or endeavour in a state of failure, has failed at something or incapable of success."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2d0a0533-2b6a-3108-b571-cca7c9cc369e",
                                        "entry_id": "55dc3aa4-b161-396b-9901-3af6b6a43fb0",
                                        "glosses": [
                                            "Termination of the ability of an item to perform its required function; breakdown."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a17be102-0e0b-45fd-830a-591d925e27e8",
                                                "sense_id": "2d0a0533-2b6a-3108-b571-cca7c9cc369e",
                                                "text": "Seeing the British establishment struggle with the financial sector is like watching an alcoholic […]. Until 2008 there was denial over what finance had become. When a series of bank failures made this impossible, there was widespread anger, leading to the public humiliation of symbolic figures."
                                            },
                                            {
                                                "example_id": "de06f8b5-593d-4d74-9367-5fd1893e91ed",
                                                "sense_id": "2d0a0533-2b6a-3108-b571-cca7c9cc369e",
                                                "text": "But as with individual train failures you have to tackle every one as it arises and assume it will happen again, which it will, if you don't do something about it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "85a6d2b5-d68b-3cc4-8678-43be2f65ef6f",
                                        "entry_id": "55dc3aa4-b161-396b-9901-3af6b6a43fb0",
                                        "glosses": [
                                            "Bankruptcy."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f59847da-57ec-4ee8-84b0-a9c56ef11d79",
                        "source_entry_id": "0572690f-0617-35b2-90a5-429ef4920c24",
                        "source_sense_id": "3e40b075-52be-3c23-836d-af523e49a55f",
                        "source_sense_description": "iets dat niet goed is gegaan",
                        "target_lang_word": "échec",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "échec",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cd4054f3-a527-3bb1-880a-636c125a6596",
                                        "entry_id": "c6c2f1ad-1324-3a77-8820-c9ccd06599d6",
                                        "glosses": [
                                            "Attaque sur le roi, au jeu d’échecs, de sorte qu’il est obligé de se retirer ou de se couvrir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77be9957-e244-495d-abad-5ad54a613303",
                                                "sense_id": "cd4054f3-a527-3bb1-880a-636c125a6596",
                                                "text": "Échec au roi !"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "échec",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8945755f-6787-3cd2-8701-615fc534d273",
                                        "entry_id": "a8f2c9be-d99f-3900-bc19-716d61ac38a3",
                                        "glosses": [
                                            "Coup par lequel, au jeu d’échecs, on met le roi en péril."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba6764d0-ad17-4bcb-816b-ad7221bb329a",
                                                "sense_id": "8945755f-6787-3cd2-8701-615fc534d273",
                                                "text": "Le roi ne peut pas rocquer étant en échec, ni lorsqu’il a remué, ni lorsqu’il essuierait un échec en passant, ni avec une tour qui aurait remué de sa place."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c6021407-5aa2-3904-825f-dc07eddc6fd4",
                                        "entry_id": "a8f2c9be-d99f-3900-bc19-716d61ac38a3",
                                        "glosses": [
                                            "Obstacle, gêne ou embarras causés à quelqu’un."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "21e58142-280d-4811-868f-5b7d10f78e98",
                                                "sense_id": "c6021407-5aa2-3904-825f-dc07eddc6fd4",
                                                "text": "Faire échec à quelqu’un."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8453cf48-bce8-3513-aa80-b63c84faef5e",
                                        "entry_id": "a8f2c9be-d99f-3900-bc19-716d61ac38a3",
                                        "glosses": [
                                            "Revers momentané dans une entreprise."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "89bcdff9-05b9-48e2-b85c-2371dbfbfbdd",
                                                "sense_id": "8453cf48-bce8-3513-aa80-b63c84faef5e",
                                                "text": "Carcassonne était la place centrale des opérations entreprises contre l’armée aragonaise et un refuge assuré en cas d’échec."
                                            },
                                            {
                                                "example_id": "e8a050b9-df90-42f1-89d0-093db9163835",
                                                "sense_id": "8453cf48-bce8-3513-aa80-b63c84faef5e",
                                                "text": "Si la réussite d'un pétanquiste chevronné est imputable à sa capacité technique, il en va autrement de l’échec. Celui-ci est attribué à des causes extérieures au joueur, qui pour l'expliquer invoque la « déveine »."
                                            },
                                            {
                                                "example_id": "54065fed-a06b-4f15-a70e-d93e8ae3eeab",
                                                "sense_id": "8453cf48-bce8-3513-aa80-b63c84faef5e",
                                                "text": "Ainsi, la volonté de correction des premières années, face aux échecs répétitifs maintes fois constatés d’hommes idémistes, se trouve noyée dans l’inertie. Paris dicte à Cayenne des mesures qui témoignent de sa souveraineté, et reflète aussi la méconnaissance de la réalité."
                                            },
                                            {
                                                "example_id": "b775e3e1-7e32-4c88-aa74-a66ea2a1d55e",
                                                "sense_id": "8453cf48-bce8-3513-aa80-b63c84faef5e",
                                                "text": "Je semble défier la mort et pourtant je ne peux protéger les corps meurtris. Les soldats vont encore être obligés de faire des sacrifices pour un résultat plus qu'incertain, probablement un échec."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fad07c14-be19-3ecb-825c-88ebd070e468",
                                        "entry_id": "a8f2c9be-d99f-3900-bc19-716d61ac38a3",
                                        "glosses": [
                                            "(pluriel) Jeu qui se joue par deux personnes sur un tablier, appelé échiquier, avec huit pièces et huit pions de chaque couleur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "731b5828-b5f8-429b-86e7-f7e1986c54bd",
                                                "sense_id": "fad07c14-be19-3ecb-825c-88ebd070e468",
                                                "text": "On ne perd aux échecs que par sa faute."
                                            },
                                            {
                                                "example_id": "e2180fa1-a4da-4aee-86a5-d5fe196d2893",
                                                "sense_id": "fad07c14-be19-3ecb-825c-88ebd070e468",
                                                "text": "Une partie d’échecs."
                                            },
                                            {
                                                "example_id": "e38a429e-b8e5-4afe-ac04-b01187b5f3d4",
                                                "sense_id": "fad07c14-be19-3ecb-825c-88ebd070e468",
                                                "text": "Un grand joueur d’échecs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b68b5f25-6b67-329b-a41a-2549feab0460",
                                        "entry_id": "a8f2c9be-d99f-3900-bc19-716d61ac38a3",
                                        "glosses": [
