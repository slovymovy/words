                        "examples": [
                            {
                                "example_id": "c91b78b8-7d6d-4a80-af92-a3adca450ebf",
                                "sense_id": "39d22fbb-36e7-39a2-9522-4aaae8d19665",
                                "text": "Забытая рубрика в канале. \"Что там в авиации Лаоса?\"",
                                "translation": "Forgotten section in the channel. \"What's going on in Laotian [Russian] aviation?\" - Fighterbomber",
                                "english": "Forgotten section in the channel. \"What's going on in Laotian [Russian] aviation?\" - Fighterbomber"
                            },
                            {
                                "example_id": "d0648264-7f31-49ab-a86b-d49db996495e",
                                "sense_id": "39d22fbb-36e7-39a2-9522-4aaae8d19665",
                                "text": "С удивлением узнали, что ряд старших офицеров из уважаемых кабинетов в головых подразделениях Лаоса не в курсе, что не все ATACMS удается сбить на Крымом.",
                                "translation": "We were surprised to learn that a number of senior officers from respected offices in the Laotian head units were unaware that not all ATACMS could be shot down in Crimea. - Two Majors",
                                "english": "We were surprised to learn that a number of senior officers from respected offices in the Laotian head units were unaware that not all ATACMS could be shot down in Crimea. - Two Majors"
                            }
                        ]
                    }
                ],
