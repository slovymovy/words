                                "target_senses": [
                                    {
                                        "sense_id": "5ec09e71-042e-3c1b-868e-4539444445ea",
                                        "entry_id": "f7c7c265-625c-3cdf-93c5-adce27a1a09c",
                                        "glosses": [
                                            "Berceau léger monté sur deux pieds en forme de croissants, qui permettent de le mouvoir sans effort pour bercer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96950109-631c-47ee-9e9f-e3584a4aec2f",
                                                "sense_id": "5ec09e71-042e-3c1b-868e-4539444445ea",
                                                "text": "L’histoire de la bercelonnette est intimement liée à celle du berceau, déposé par le Mobilier national au musée des Arts décoratifs où il est conservé."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a1a7556e-4199-42f3-a30a-b1e790bffded",
                        "source_entry_id": "efc489d1-d301-3096-8096-0ecae493d07d",
                        "source_sense_id": "3f8a3111-be1c-3ef0-9c6a-974917ee4d50",
                        "source_sense_description": "type of newborn baby's bed",
                        "target_lang_word": "Wiege",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wiege",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "97f414c0-a49a-39f3-b4c2-2b1d922248a8",
                                        "entry_id": "1df47da9-2bd3-3704-9b44-b8f6d1aa7ca0",
                                        "glosses": [
                                            "entweder mit zwei abgerundeten Kufen beziehungsweise Schaukelbrettern versehenes beziehungsweise in ein spezielles Gestell eingehängtes oder frei von der Decke hängendes kastenförmiges Bettchen für Säuglinge, mithilfe dessen der Säugling (in Längs- oder Querrichtung) gewiegt beziehungsweise geschaukelt werden kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a01b0fb7-9d65-4fa2-a963-a889248c0fc4",
                                                "sense_id": "97f414c0-a49a-39f3-b4c2-2b1d922248a8",
                                                "text": "Leg den Kleinen in die Wiege!"
                                            },
                                            {
                                                "example_id": "4ee2915e-901f-4adc-82a4-62f89eda4d24",
                                                "sense_id": "97f414c0-a49a-39f3-b4c2-2b1d922248a8",
                                                "text": "„Glücklicher Säugling! Dir ist ein unendlicher Raum noch die Wiege.",
                                                "translation": "Werde Mann, und dir wird eng die unendliche Welt.“"
                                            },
                                            {
                                                "example_id": "b440fefd-1449-486e-acf7-b77ddd38fc87",
                                                "sense_id": "97f414c0-a49a-39f3-b4c2-2b1d922248a8",
                                                "text": "„Armuth sitzt an ihrer Wiege und schaukelt sie groß, und diese magere Amme bleibt ihre treue Lebensgefährtinn.“"
                                            },
                                            {
                                                "example_id": "f9fd2bc5-fe27-45c2-8a1e-8a21f428be61",
                                                "sense_id": "97f414c0-a49a-39f3-b4c2-2b1d922248a8",
                                                "text": "„Das ältere Kind äußert unverhohlene Feindseligkeit gegen den Konkurrenten, die sich in unliebenswürdiger Beurteilung desselben, in Wünschen, daß »der Storch ihn wieder mitnehmen möge«, und dergleichen Luft macht und gelegentlich selbst zu kleinen Attentaten auf das hilflos in der Wiege Daliegende führt.“"
                                            },
                                            {
                                                "example_id": "0252c7b2-add4-47a2-b6f6-76988d987ffd",
                                                "sense_id": "97f414c0-a49a-39f3-b4c2-2b1d922248a8",
                                                "text": "„Auf Erden war nur ein winziges Licht,",
                                                "translation": "als die Stimme des Sturmes klang.“"
                                            },
                                            {
                                                "example_id": "c01e3ccd-b3e8-4d0d-adcd-0b9daa4f3971",
                                                "sense_id": "97f414c0-a49a-39f3-b4c2-2b1d922248a8",
                                                "text": "„Denn kaum stand die Wiege still, schrie Theophil wie am Spieß.“"
                                            },
                                            {
                                                "example_id": "f5db04a8-5716-4ebd-ac30-12990960dde1",
                                                "sense_id": "97f414c0-a49a-39f3-b4c2-2b1d922248a8",
                                                "text": "„Nicht das ununterbrochene, bald stärkere, bald schwächere Maschinengewehrfeuer aus dem Brücktal weckte die Bäuerin um Mitternacht, sondern das Zucken der Wiege, die das Kind mit seinen stoßweisen, noch schwachen Schreien erschütterte.“"
                                            },
                                            {
                                                "example_id": "adb83e1b-4210-4662-ac6b-7fe27c7ff24d",
                                                "sense_id": "97f414c0-a49a-39f3-b4c2-2b1d922248a8",
                                                "text": "„In einer der Behausungen, Erde aufgeschüttet um verkohlte Balken, kauerte ein Bauer mit Frau; sie wirkten uralt, aber das war wohl das Leid und die Not, denn von einem der Balken hing eine Wiege mit einem Säugling darin, das Gesichtlein faltig, die Augen vereitert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d69f9421-bd5b-3d80-b4a8-f759ff79c6e3",
                                        "entry_id": "1df47da9-2bd3-3704-9b44-b8f6d1aa7ca0",
                                        "glosses": [
                                            "zu [1]; Plural selten; Ort, an dem etwas entsteht, sich entwickelt; Ort, von dem etwas ausgeht, entspringt"
                                        ],
                                        "tags": [
                                            "figurative",
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "24674def-e347-414f-80e7-9483b83f33b4",
                                                "sense_id": "d69f9421-bd5b-3d80-b4a8-f759ff79c6e3",
                                                "text": "Afrika gilt als Wiege der Menschheit."
                                            },
                                            {
                                                "example_id": "54bfc99f-cc9a-4550-bb15-f3fee2e0d458",
                                                "sense_id": "d69f9421-bd5b-3d80-b4a8-f759ff79c6e3",
                                                "text": "„Das Haus bleibe. Es sei eine Wiege der Kunst.“"
                                            },
                                            {
                                                "example_id": "c7b4375b-8717-490a-a292-6fa2361b9137",
                                                "sense_id": "d69f9421-bd5b-3d80-b4a8-f759ff79c6e3",
                                                "text": "„»Wir stehen hier«, sagte sie, »auch du, Karl Radek, an der Wiege einer neuen Partei.[…]«“"
                                            },
                                            {
                                                "example_id": "d44fd4fb-937e-4d58-b3c2-6e6e669fcfe1",
                                                "sense_id": "d69f9421-bd5b-3d80-b4a8-f759ff79c6e3",
                                                "text": "„Als sich 1989 die guten Feen des internationalen Kapitalismus über die Wiege der togolesischen Wirtschaft beugten, schien die Situation dieses kleinen Landes mit mehr als 3,5 Millionen Einwohnern, von denen 80 Prozent auf dem Land leben, sehr hoffnungsvoll zu sein.“"
                                            },
                                            {
                                                "example_id": "97bdc684-33e7-4213-95d7-640c5ce13721",
                                                "sense_id": "d69f9421-bd5b-3d80-b4a8-f759ff79c6e3",
                                                "text": "„Als ‚eine der Wiegen der Revolution‘ wird die Ostberliner Gethsemanekirche apostrophiert.“"
                                            },
                                            {
                                                "example_id": "4b4aa177-8d28-4f76-a564-82b9b652814c",
                                                "sense_id": "d69f9421-bd5b-3d80-b4a8-f759ff79c6e3",
                                                "text": "„Die Tropen stellen deshalb laut den Wissenschaftern nicht nur einen Hort heutiger Artenvielfalt dar, sondern zugleich auch die Wiege eines wesentlichen Teils der globalen Biodiversität.“"
                                            },
                                            {
                                                "example_id": "531d1384-9ede-462d-8d9f-2be42d6707dd",
                                                "sense_id": "d69f9421-bd5b-3d80-b4a8-f759ff79c6e3",
                                                "text": "„Denn die Sundarbans sind die Wiege der Cholera.“"
                                            },
                                            {
                                                "example_id": "e7a97c5e-1a0a-47d6-91f9-287959086ad7",
                                                "sense_id": "d69f9421-bd5b-3d80-b4a8-f759ff79c6e3",
                                                "text": "„Die Stadt war durch die Selbstverbrennung des Obstverkäufers Mohamed Bouazizi im Dezember 2010 zur Wiege der Jasminrevolution geworden – und damit des Arabischen Frühlings.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "df46caa1-4b99-3596-a834-2b7081ece145",
                                        "entry_id": "1df47da9-2bd3-3704-9b44-b8f6d1aa7ca0",
                                        "glosses": [
                                            "Übung, bei der der Oberkörper und die Beine bäuchlings angehoben werden und anschließend der gesamte Körper schaukelnd auf- und ab bewegt wird"
                                        ],
                                        "tags": [
                                            "Gymnastik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ebcc87f4-f6f6-4cee-8638-5014110887e7",
                                                "sense_id": "df46caa1-4b99-3596-a834-2b7081ece145",
                                                "text": "„Nach all diesen Übungen soll schließlich ohne Schwierigkeit auszuführen sein: die ‚Wiege‘ (Schaukelbewegung mit gestreckten Armen und Beinen in Bauchlage), Aufschwingen zum Sitzen, Zusammenklappen von Armen und Beinen mit gestreckten Knien aus Rückenlage, freies Sitzen mit hängenden Unterschenkel, knien, kriechen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "934f597e-122c-3273-9c08-935fef61a0c8",
                                        "entry_id": "1df47da9-2bd3-3704-9b44-b8f6d1aa7ca0",
                                        "glosses": [
                                            "Instrument mit gebogener und gezähnter Schneide aus Stahl, das, beim Kupferstich oder ähnlicher Tiefdruckverfahren, zum Aufrauen der Platte benutzt wird"
                                        ],
                                        "tags": [
                                            "Schabkunsttechnik",
                                            "Tiefdrucktechnik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "49b5febc-cb4a-477a-8a34-1c32051796a3",
                                                "sense_id": "934f597e-122c-3273-9c08-935fef61a0c8",
                                                "text": "„Erst wird die Kupferplatte mittels einer sogenannten Wiege (Granierstahl), die einem kleinen Wiegemesser mit gezahnter Schneide ähnelt, völlig und gleichmäßig aufgerauht.“"
                                            },
                                            {
                                                "example_id": "3cf13bb5-f486-40eb-8d9a-91f680671cd9",
                                                "sense_id": "934f597e-122c-3273-9c08-935fef61a0c8",
                                                "text": "„Die Kupferplatte wir erst mit der sog. Wiege, auch Granierstahl genannt, gleichmäßig aufgerauht (‚gewiegt‘).“"
                                            },
                                            {
                                                "example_id": "d8f39f83-a979-490a-a3c9-e403f6874104",
                                                "sense_id": "934f597e-122c-3273-9c08-935fef61a0c8",
                                                "text": "„Er rauht überhaupt mit der Wiege eine Platte niemals so gleichmäßig auf, daß eine geschlossene samtige Fläche entsteht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
