{
    "word_family": [
        "flat",
        "flatness"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a0c05402-c816-365c-b86e-3ba4e53b6847",
                    "sense_definition": "To make something flat or flatter.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "physical_change",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The construction crew used a heavy roller to <w>flatten</w> the ground for the new road.",
                            "target_lang_translations": {
                                "zh": "施工队用重型压路机把新路的地基<w>弄平</w>了。"
                            }
                        },
                        {
                            "text": "You should <w>flatten</w> the cardboard box before putting it in the recycling bin.",
                            "target_lang_translations": {
                                "zh": "你应该把纸箱<w>压平</w>后再放进回收箱。"
                            }
                        }
                    ],
                    "synonyms": [
                        "level",
                        "smooth"
                    ],
                    "antonyms": [
                        "inflate"
                    ],
                    "common_phrases": [
                        "flatten out"
                    ],
                    "target_lang_definitions": {
                        "zh": "使某物变平或更平。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "弄平",
                                "target_lang_sense_clarification": "指通过物理手段使物体表面平整。"
                            },
                            {
                                "target_lang_word": "压平",
                                "target_lang_sense_clarification": "指通过挤压使物体变平。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5225b214-8d29-312f-a8bf-fedd95e0bb71",
                    "sense_definition": "To become flat or flatter; to plateau.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_change",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After a period of rapid growth, the sales figures finally began to <w>flatten</w> out.",
                            "target_lang_translations": {
                                "zh": "经过一段时间的快速增长，销售额终于开始<w>趋于平缓</w>。"
                            }
                        },
                        {
                            "text": "The mountain path starts to <w>flatten</w> as you reach the top of the ridge.",
                            "target_lang_translations": {
                                "zh": "当你到达山脊顶部时，山路开始<w>变平</w>了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "level off",
                        "plateau"
                    ],
                    "common_phrases": [
                        "flatten out"
                    ],
                    "target_lang_definitions": {
                        "zh": "变得平坦或平稳；趋于平缓。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "趋于平缓",
                                "target_lang_sense_clarification": "指增长或变化速度变慢并稳定下来。"
                            },
                            {
                                "target_lang_word": "变平",
                                "target_lang_sense_clarification": "指地形或趋势变得不再陡峭。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ddec9cd6-3506-377b-b566-89ee818da596",
                    "sense_definition": "To knock down or lay low.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "force",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The strong wind was powerful enough to <w>flatten</w> the small wooden shed.",
                            "target_lang_translations": {
                                "zh": "强风威力巨大，足以将那间小木棚<w>夷为平地</w>。"
                            }
                        },
                        {
                            "text": "The boxer managed to <w>flatten</w> his opponent with a single powerful punch.",
                            "target_lang_translations": {
                                "zh": "拳击手一记重拳就成功将对手<w>击倒</w>了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "knock down",
                        "topple"
                    ],
                    "target_lang_definitions": {
                        "zh": "击倒或摧毁。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "夷为平地",
                                "target_lang_sense_clarification": "指彻底摧毁建筑物。"
                            },
                            {
                                "target_lang_word": "击倒",
                                "target_lang_sense_clarification": "指在格斗中将对手打倒在地。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "52b3fff4-c653-3a57-885b-60a8bd46a9c8",
                    "sense_definition": "To press one's body tightly against a surface to avoid being seen or harmed.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physical_change",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The spy had to <w>flatten</w> himself against the cold stone wall to avoid detection.",
                            "target_lang_translations": {
                                "zh": "间谍不得不将身体<w>紧贴</w>在冰冷的石墙上以避免被发现。"
                            }
                        },
                        {
                            "text": "She <w>flatten</w>ed herself against the door while the crowd rushed past her.",
                            "target_lang_translations": {
                                "zh": "当人群冲过她身边时，她<w>紧贴</w>在门上。"
                            }
                        }
                    ],
                    "synonyms": [
                        "press"
                    ],
                    "target_lang_definitions": {
                        "zh": "将身体紧贴某表面以避免被发现或伤害。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "紧贴",
                                "target_lang_sense_clarification": "指身体紧紧靠在墙壁或表面上。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1189863c-15c0-3a2c-a877-64c69ffd1596",
                    "sense_definition": "To combine separate layers into a single image.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "technical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Before saving the file, you should <w>flatten</w> the image to reduce the file size.",
                            "target_lang_translations": {
                                "zh": "保存文件前，你应该把图像<w>合并</w>以减小文件大小。"
                            }
                        },
                        {
                            "text": "It is often easier to edit layers before you <w>flatten</w> the final design.",
                            "target_lang_translations": {
                                "zh": "在<w>合并</w>最终设计之前编辑图层通常更容易。"
                            }
                        }
                    ],
                    "synonyms": [
                        "merge"
                    ],
                    "target_lang_definitions": {
                        "zh": "将图像中的多个图层合并为一个图层。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "合并",
                                "target_lang_sense_clarification": "指在图像处理软件中将所有图层合为一层。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "187473d7-bc1f-3086-a451-9bc774bf7c47",
                    "sense_definition": "To reduce a data structure to one that has fewer dimensions.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "technical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The programmer had to <w>flatten</w> the nested list to make the data easier to process.",
                            "target_lang_translations": {
                                "zh": "程序员必须将嵌套列表<w>扁平化</w>，以便更轻松地处理数据。"
                            }
                        },
                        {
                            "text": "You can <w>flatten</w> the multi-dimensional array into a simple list using this function.",
                            "target_lang_translations": {
                                "zh": "你可以使用此函数将多维数组<w>扁平化</w>为简单的列表。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "将复杂的数据结构简化为低维结构。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "扁平化",
                                "target_lang_sense_clarification": "指将嵌套的数据结构转换为一维列表。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "af308528-0cf5-381b-a654-e611b596041f",
                    "sense_definition": "To lower a musical note by a semitone.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "technical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The singer tended to <w>flatten</w> the note during the high part of the song.",
                            "target_lang_translations": {
                                "zh": "这位歌手在歌曲的高音部分往往会把音符<w>降半音</w>。"
                            }
                        },
                        {
                            "text": "You need to <w>flatten</w> the B note to play this chord correctly.",
                            "target_lang_translations": {
                                "zh": "你需要把B音<w>降半音</w>才能正确弹奏这个和弦。"
                            }
                        }
                    ],
                    "antonyms": [
                        "sharpen"
                    ],
                    "target_lang_definitions": {
                        "zh": "将音符降低半音。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "降半音",
                                "target_lang_sense_clarification": "指音乐术语中降低音高。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}