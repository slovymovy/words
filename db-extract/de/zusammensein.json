                        ],
                        "form": "des Zusammenseins"
                    },
                    {
                        "form_id": "198cef74-f440-4c69-aa0c-8845ca5052e0",
                        "entry_id": "54c9af7d-0b81-3d15-b013-8e2ca6ccf0a5",
                        "tags": [
                            "dative",
                            "singular"
                        ],
                        "form": "dem Zusammensein"
                    },
                    {
                        "form_id": "80c8e59d-2685-42db-acb7-fb9427d1cb87",
                        "entry_id": "54c9af7d-0b81-3d15-b013-8e2ca6ccf0a5",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "das Zusammensein"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5de59a41-1718-3d9d-97dd-e0e6c789c05f",
                        "entry_id": "54c9af7d-0b81-3d15-b013-8e2ca6ccf0a5",
                        "glosses": [
                            "gesellige Zusammenkunft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f20a11b5-89b4-441a-a15a-abc553218a0a",
                                "sense_id": "5de59a41-1718-3d9d-97dd-e0e6c789c05f",
                                "text": "„Das Zusammensein bei Tisch ist ein wichtiger Bestandteil des Familienlebens, es gibt Kindern Halt.“"
                            },
                            {
                                "example_id": "14039d20-607a-4da6-bd03-3bc7088a59ef",
                                "sense_id": "5de59a41-1718-3d9d-97dd-e0e6c789c05f",
                                "text": "Um ein Lagerfeuer am Strand sitzen und Lieder singen, das ist ein schönes Zusammensein."
                            },
                            {
                                "example_id": "894b203f-446c-47b1-8c28-85c7f6041757",
                                "sense_id": "5de59a41-1718-3d9d-97dd-e0e6c789c05f",
                                "text": "„»Lachen ist ansteckend und macht glücklich, ebenso das Zusammensein mit anderen Menschen oder der Aufenthalt in der Natur.«“"
                            },
                            {
                                "example_id": "84caaaac-9447-49b5-a5a0-c88ed821a1f2",
                                "sense_id": "5de59a41-1718-3d9d-97dd-e0e6c789c05f",
                                "text": "„Denn während Extrovertierte ihre Energie vor allem aus dem Zusammensein mit anderen ziehen, laden introvertierte Menschen ihre Batterien am besten allein auf.“"
                            },
                            {
                                "example_id": "74aea0ad-5ef2-42f7-864e-39e0cb6de912",
                                "sense_id": "5de59a41-1718-3d9d-97dd-e0e6c789c05f",
                                "text": "„Mit dem Ramadan wollen Musliminnen und Muslime Selbstdisziplin erlernen und durch gemeinsames Zusammensein ihren Glauben stärken.“"
                            },
                            {
                                "example_id": "2aebdcf2-3519-4c02-a50f-763c67e816c4",
                                "sense_id": "5de59a41-1718-3d9d-97dd-e0e6c789c05f",
                                "text": "„Die Polizei hat das Zusammensein von mindestens 90 Gästen in einem Lokal in Aurich wegen Verstößen gegen die Corona-Verordnung beendet.“"
                            },
                            {
                                "example_id": "bbf764cf-09ef-411a-b323-4d28a70bee8f",
                                "sense_id": "5de59a41-1718-3d9d-97dd-e0e6c789c05f",
                                "text": "„Durch weniger Konsum, Entschleunigung und ein friedvolles Zusammensein kommt man entspannt und achtsam“ [durch] „die Weihnachtszeit.“"
                            },
                            {
                                "example_id": "ebb97985-0e91-44f7-9b7d-95bdc199dc3c",
                                "sense_id": "5de59a41-1718-3d9d-97dd-e0e6c789c05f",
                                "text": "[Coronapandemie 2021:] „Die Politik hat den Familien ein enges Zusammensein verordnet.“"
                            },
                            {
                                "example_id": "d441bdf3-0b5b-4239-a43d-9b24f03ce231",
                                "sense_id": "5de59a41-1718-3d9d-97dd-e0e6c789c05f",
                                "text": "„Im Mittelpunkt dieser Stammtischrunden stehen oft das gesellige Zusammensein, Kartenspiel und politische oder philosophische Diskussionen.“"
                            },
                            {
                                "example_id": "858f1064-9aca-4b51-838d-07f0cfaac31b",
                                "sense_id": "5de59a41-1718-3d9d-97dd-e0e6c789c05f",
                                "text": "„Aber dieses Zusammensein, das Miteinander, die Welt trifft sich an einem Ort - gerade im olympischen Dorf spielt das auch eine große Rolle.“"
                            },
                            {
                                "example_id": "ffd9a6df-4a46-4cf7-8dc6-920ccfa71e43",
                                "sense_id": "5de59a41-1718-3d9d-97dd-e0e6c789c05f",
                                "text": "[Theresienstadt-Überlebende] „beschreiben das qualvolle Zusammensein in überfüllten Räumen und Schlafsälen.“"
                            },
                            {
                                "example_id": "34f18086-4dfc-4848-ace1-ac9ca57a416b",
                                "sense_id": "5de59a41-1718-3d9d-97dd-e0e6c789c05f",
                                "text": "„Ingeborg Kahl erzählt, dass ihr vor allem das Zusammensein mit Gleichgesinnten geholfen habe, die Haftzeit durchzustehen.“"
                            },
                            {
                                "example_id": "652988c3-1f76-48f5-bf75-5e6a2c46c22e",
                                "sense_id": "5de59a41-1718-3d9d-97dd-e0e6c789c05f",
                                "text": "„Durch die sogenannte Weihnachtsgnade kamen sie im Durchschnitt 18 Tage früher aus dem Gefängnis frei. »Zum Weihnachtsfest wollen wir gerne einigen Gefangenen das Zusammensein mit der Familie ermöglichen, wenn die reguläre Haftentlassung ohnehin einige Tage später ansteht«, sagte Justizministerin Kathrin Wahlmann (SPD).“"
                            },
                            {
                                "example_id": "26ccde5f-ce3f-47af-bb06-9ede4ff82737",
                                "sense_id": "5de59a41-1718-3d9d-97dd-e0e6c789c05f",
                                "text": "„Weihnachten ist das Fest der Familie. An keinem anderen Tag im Jahr wird Gemeinschaft und Zusammensein so zelebriert wie in der Zeit um Heiligabend.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "ef7daf05-fb67-3be4-96b1-e20a82ba3df8",
                        "entry_id": "54c9af7d-0b81-3d15-b013-8e2ca6ccf0a5",
                        "glosses": [
                            "ein Paar sein, in einer Beziehung sein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f3d65604-b7f0-4b2e-abef-da810b6fb912",
                                "sense_id": "ef7daf05-fb67-3be4-96b1-e20a82ba3df8",
                                "text": "„Wenn ich an die Zeit unseres Zusammenseins denke, erschrecke ich. So viele Jahre!“"
                            },
                            {
                                "example_id": "ebf33aaa-cd80-4922-b6d1-4d1cea45c385",
                                "sense_id": "ef7daf05-fb67-3be4-96b1-e20a82ba3df8",
                                "text": "„Es ist also kein Zufall, dass sich Lena im Zusammensein mit ihrem Freund häufig an bestimmte Situationen mit ihrem Vater erinnert fühlt?“"
                            },
                            {
                                "example_id": "fa563006-b26a-41bc-9a75-7a70a9e3c5a1",
                                "sense_id": "ef7daf05-fb67-3be4-96b1-e20a82ba3df8",
                                "text": "„Einst wurde das Liebespaar als höchste Form des Zusammenseins propagiert.“"
                            },
                            {
                                "example_id": "a250ee42-f617-41e2-a0c5-246d15730fbf",
                                "sense_id": "ef7daf05-fb67-3be4-96b1-e20a82ba3df8",
                                "text": "„Mit 12 begann M. sich vorzustellen, wie das Zusammensein mit Mädchen wäre.“"
                            },
                            {
                                "example_id": "f09044f9-1a99-4ec9-8877-5864a41a8536",
                                "sense_id": "ef7daf05-fb67-3be4-96b1-e20a82ba3df8",
                                "text": "„Wir möchten möglichst viel qualitativ hochwertige Zeit miteinander verbringen. Zeit, in der wir unser Zusammensein pflegen und genießen können.“"
                            },
                            {
                                "example_id": "ffb88576-1573-4646-9c49-9927a44fd828",
                                "sense_id": "ef7daf05-fb67-3be4-96b1-e20a82ba3df8",
                                "text": "„Manchmal läuft nicht mal irgendwas falsch, aber dennoch fühlt sich das Zusammensein nicht so an, wie wir es gerne hätten. An diesem Punkt sind viele Menschen schnell bereit, die Beziehung zu beenden.“"
                            },
                            {
                                "example_id": "ffcf6b04-9308-42e4-bae5-c609139f4e28",
                                "sense_id": "ef7daf05-fb67-3be4-96b1-e20a82ba3df8",
                                "text": "„Der Alltag holt euch ein und das Zusammensein wird zur langweiligen Routine?“"
                            },
                            {
                                "example_id": "ceb31c85-ef6d-47c6-a01d-51d6ae77419a",
                                "sense_id": "ef7daf05-fb67-3be4-96b1-e20a82ba3df8",
                                "text": "„Ich mache mir ernsthaft Gedanken darüber, ob Frauen und Männer überhaupt zum Zusammensein bestimmt sind.“"
                            },
                            {
                                "example_id": "07f757b5-8740-49a8-b68a-4372d0966f1b",
                                "sense_id": "ef7daf05-fb67-3be4-96b1-e20a82ba3df8",
                                "text": "„Éléonore ihrerseits erkannte schnell die Vorteile einer solchen Liaison und ertrug das wohl lästige Zusammensein mit dem Kaiser, indem sie die Uhr vorstellte und so seine Anwesenheit in ihrem Schlafgemach verkürzte.“"
                            },
                            {
                                "example_id": "0d7bc95b-2201-46d5-8e76-38fa1f5d6485",
                                "sense_id": "ef7daf05-fb67-3be4-96b1-e20a82ba3df8",
                                "text": "„Anna ist wütend, da sie weiß, dass ihre Beziehung zu William zu neuen kompromittierenden Fotos und weiterem Wirbel um ihre Person führen wird, ohne dass sie sich dagegen wehren kann. Sie bricht daher das Zusammensein mit William abrupt ab und flüchtet aus der Wohnung.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
