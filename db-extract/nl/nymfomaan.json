                "senses": [
                    {
                        "sense_id": "bb6c0168-0591-3371-8a20-c68c9470bbd7",
                        "entry_id": "be7ecc89-0383-3085-b8b5-d98627aace56",
                        "glosses": [
                            "over vrouwen: lijdend aan een te sterke geslachtsdrift"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81e2223e-fd54-46cc-a3c3-e8b45c571bdb",
                                "sense_id": "bb6c0168-0591-3371-8a20-c68c9470bbd7",
                                "text": "Julie Cafmeyer maakt theater over haar eigen liefdesleven: Zichzelf framet ze als ‘een smekende, intelligente, nymfomane, wanhopige, hoopvolle, wankele en strijdvaardige vrouw’. Eraan toevoegend: ‘Geloof wat je wil. Voor mij is het toch al te laat.’"
                            },
                            {
                                "example_id": "d16fd5da-bb8e-4ca8-a363-d76bed8fc0bd",
                                "sense_id": "bb6c0168-0591-3371-8a20-c68c9470bbd7",
                                "text": "Het is uitgesloten dat Bellucci ooit naar Hollywood verhuist. De kans had de actrice toen zij een nymfomane vampier speelde in Dracula onder regie van Francis Ford Coppola. Maar dat wereldje trekt haar totaal niet aan."
                            }
                        ]
                    }
