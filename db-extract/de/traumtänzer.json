                                "sense_id": "3145734e-275c-30c9-922f-1269e5f33ab4",
                                "text": "„In Österreich nennen Kritiker Sie bestenfalls Traumtänzer.“"
                            },
                            {
                                "example_id": "6f64da96-da77-4fc0-b9cc-7a9c1a610e6f",
                                "sense_id": "3145734e-275c-30c9-922f-1269e5f33ab4",
                                "text": "„Und trotzdem gab es noch immer Traumtänzer, die daran glaubten, es würde unter den gegebenen Umständen einen Aufschwung geben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
