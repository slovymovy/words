                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad3e3f16-22bf-4c77-acb9-63b1068d8104",
                                "sense_id": "7a372f63-823c-32c7-bd8f-d26609bcc182",
                                "text": "Il n'est pas jusqu'à l'emploi d'une brique nouvelle, l'amiantine, qui ne soit à louer et dont la couleur d'un blanc chaud ne soi agréable à l'œil."
