                        "sense_id": "da3e57a6-868b-3a0b-84ac-d295712c1c4d",
                        "entry_id": "78da5ec9-1bbe-3640-958a-bd0d8fd89c8e",
                        "glosses": [
                            "(rollende) Bewegung in Vorwärtsrichtung (ohne Lenkvorgänge)"
