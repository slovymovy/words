                "senses": [
                    {
                        "sense_id": "6edbdd8b-56d9-3feb-bd89-602a74fe055b",
                        "entry_id": "a178da87-ac71-3888-ae72-6c198eb59f45",
                        "glosses": [
                            "Personne qui travaille sur une linotype, machine à composer et à fondre les caractères d’imprimerie par lignes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "762339bd-ed08-49ad-b399-f5e0da02bc1a",
                                "sense_id": "6edbdd8b-56d9-3feb-bd89-602a74fe055b",
                                "text": "C’est le moment où je dois envoyer ma page au linotypiste, et ne me demande pas ce qu’est un linotypiste."
                            },
                            {
                                "example_id": "8c731646-b898-4c7f-a8fc-431ad35049f8",
                                "sense_id": "6edbdd8b-56d9-3feb-bd89-602a74fe055b",
                                "text": "Au marbre, on le pensait rubricard ; à la rédaction, on le croyait linotypiste ; à la composition, on le disait correcteur."
                            },
                            {
                                "example_id": "e43f2c94-7392-43bc-b71c-1ab0761ef8ff",
                                "sense_id": "6edbdd8b-56d9-3feb-bd89-602a74fe055b",
                                "text": "Un jour, un copain lui conseille de se faire engager comme linotypiste – metteur en pages dans un journal. Sa formation de typographe lui sera utile."
                            }
                        ]
                    }
                ],
