                    {
                        "sense_id": "e1e3bb4a-26be-312c-84f8-f222b1183bef",
                        "entry_id": "f13740de-c27c-37fa-950f-6b918bb24d82",
                        "glosses": [
                            "Tambourin d’origine tunisienne fait d'une peau tendue sur l'extrémité renflée d'un cylindre de poterie ou de métal."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "23d53bfa-5e4f-4e3d-b317-9b5571fbfd33",
                                "sense_id": "e1e3bb4a-26be-312c-84f8-f222b1183bef",
                                "text": "Les darboukas en matériaux modernes produisent un son plus puissant et plus clair, ce qui les rend plus attrayantes dans les musiques modernes."
                            },
                            {
                                "example_id": "69a7c05d-22f2-4bc1-8855-c3fb3d347425",
                                "sense_id": "e1e3bb4a-26be-312c-84f8-f222b1183bef",
                                "text": "En frappant le sol de leurs sabots, ils hochent la tête en mesure, entraînés par la cadence d’une darbouka."
                            }
                        ]
                    }
                ],
