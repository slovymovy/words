                        "form": "das Menschenkind"
                    },
                    {
                        "form_id": "61463679-c61e-4862-8372-6a4b5e63ae60",
                        "entry_id": "7911e6f1-f2c9-3c08-9bee-4d46d3d0c0ef",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Menschenkinder"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9492572c-d5c3-3399-a777-2b1911a26013",
                        "entry_id": "7911e6f1-f2c9-3c08-9bee-4d46d3d0c0ef",
                        "glosses": [
                            "ein Kind"
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "6437630b-e05c-4602-b446-8c9a558c22c0",
                                "sense_id": "9492572c-d5c3-3399-a777-2b1911a26013",
                                "text": "Da spielten dann Menschenkind und Hundebaby ausgelassen auf dem Rasen."
                            },
                            {
                                "example_id": "32c576d6-9c95-45e4-a76b-55f810917f57",
                                "sense_id": "9492572c-d5c3-3399-a777-2b1911a26013",
                                "text": "„Also verwandelt Yehlh sich in eine Tannennadel, die sich ihrerseits auf verschlungenen Wegen in ein Menschenkind verwandelt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c8c070f9-71d7-39d6-90e4-266e652af846",
                        "entry_id": "7911e6f1-f2c9-3c08-9bee-4d46d3d0c0ef",
                        "glosses": [
                            "ein Mensch mit einer speziellen, herausragenden Eigenschaft"
                        ],
                        "tags": [
                            "selten im Plural"
                        ],
                        "examples": [
                            {
                                "example_id": "9c312454-4197-4f83-8d32-5836f1bb87e1",
                                "sense_id": "c8c070f9-71d7-39d6-90e4-266e652af846",
                                "text": "„Geist und Gemüt bilden bei ihr einen harmonischen Zusammenklang — in jeder Beziehung ein feines Menschenkind.“"
                            },
                            {
                                "example_id": "220f1b1f-ff38-43f8-868d-30ab72f87b2d",
                                "sense_id": "c8c070f9-71d7-39d6-90e4-266e652af846",
                                "text": "„Kein Wunder, daß sich so etwas herumsprach und der Spenderin solch beglückender Gaben den Ruf einbrachte, daß sie kein gewöhnliches Menschenkind, vielmehr ein höheres Wesen, eine Fee sei, die zeitweilig zur Erde herabgestiegen war.“"
                            },
                            {
                                "example_id": "a222d97c-8bc3-413f-9660-b8b20c86fced",
                                "sense_id": "c8c070f9-71d7-39d6-90e4-266e652af846",
                                "text": "„Er liebt Rätsel, Wortspiele, Hieroglyphen und entwickelt bei ihrer Lösung oft einen Scharfsinn, der den mit dem Durchschnittsverstand begabten Menschenkindern unnatürlich erscheint.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "83bc6cd1-4cb0-3bc2-bf3f-f37b0a90dbdd",
                        "entry_id": "7911e6f1-f2c9-3c08-9bee-4d46d3d0c0ef",
                        "glosses": [
                            "ein Mensch, speziell in seiner (kindlichen, allgemein menschlichen) Verletzlichkeit"
                        ],
                        "tags": [
                            "vertraulich"
                        ],
                        "examples": [
                            {
                                "example_id": "0c19f7cd-10c8-451f-8590-94a1f8fe6624",
                                "sense_id": "83bc6cd1-4cb0-3bc2-bf3f-f37b0a90dbdd",
                                "text": "„Mary Sattler war über die offensichtliche Vorliebe ihres Sohnes für dieses „arme Menschenkind“, wie sie Edith gerne bezeichnete, nicht besonders glücklich, genaugenommen war sie alles andere als das.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "51df8369-e473-47f0-b5b3-35d340f89158",
                        "source_entry_id": "7911e6f1-f2c9-3c08-9bee-4d46d3d0c0ef",
                        "source_sense_id": "9492572c-d5c3-3399-a777-2b1911a26013",
                        "source_sense_description": "selten: ein Kind",
                        "target_lang_word": "enfant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "enfant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "020328ae-474b-38bd-91b1-cef9596a4609",
                                        "entry_id": "cd028339-0e36-3c41-8c58-85c050a52d9c",
                                        "glosses": [
                                            "Garçon ou fille qui n’a pas encore atteint l’adolescence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5700643-126c-4311-9888-34ab7223bf2b",
                                                "sense_id": "020328ae-474b-38bd-91b1-cef9596a4609",
                                                "text": "Mais l’enfant, de plus en plus épeuré, s’était caché dans les jupons de la femme."
                                            },
                                            {
                                                "example_id": "675e10d0-0366-4abe-b8bd-8e9cd55893f3",
                                                "sense_id": "020328ae-474b-38bd-91b1-cef9596a4609",
                                                "text": "Je vis toute la famille de mon hôte, une vingtaine de personnes, dont une dizaine d’enfants, qui dormaient, serrés les uns contre les autres, sur des nattes de pandanus."
                                            },
                                            {
                                                "example_id": "21871e69-cc67-448d-94b2-e13a0cac361c",
                                                "sense_id": "020328ae-474b-38bd-91b1-cef9596a4609",
                                                "text": "C’est avec de telles calembredaines que le prêtres s’imaginent piper la confiance des enfants à l’âge où, précisément, ils commencent à discerner qu’ils n’ont pas poussé dans les choux."
                                            },
                                            {
                                                "example_id": "f6d558e8-0924-4aad-8551-3641b3d222bc",
                                                "sense_id": "020328ae-474b-38bd-91b1-cef9596a4609",
                                                "text": "Cet enfant unique est d’ailleurs élevé très mal : un enfant gâté, dorloté, pourri d’égoïsme."
                                            },
                                            {
                                                "example_id": "409e13fa-2b73-4162-bd5f-6141c59daf90",
                                                "sense_id": "020328ae-474b-38bd-91b1-cef9596a4609",
                                                "text": "La salle de réunion du conseil municipal avait autrefois servi de salle de classe pour les enfants du village."
                                            },
                                            {
                                                "example_id": "8d97ea9e-60f1-46c3-9f7a-3df5a84cfc29",
                                                "sense_id": "020328ae-474b-38bd-91b1-cef9596a4609",
                                                "text": "Avec le développement des sciences humaines nous sommes parvenus à une perception de plus en plus attentive de l’individualité de l’enfant. Cet enfant n’est plus ainsi celui qui, selon l’étymologie latine, « ne parle pas ». Bien au contraire, il parle et il est écouté. On peut même affirmer que l’essentiel de la vie familiale est bien ce dialogue de plus en plus égalitaire et ouvert entre les enfants et leurs parents, entre les enfants et le monde."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e762bbee-d4cf-3c9d-a5d6-0302cfcb32dc",
                                        "entry_id": "cd028339-0e36-3c41-8c58-85c050a52d9c",
                                        "glosses": [
                                            "Fils ou fille, de tout âge, par relation au père ou à la mère."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dbc3e401-6745-4721-ac25-082cf3d4341d",
                                                "sense_id": "e762bbee-d4cf-3c9d-a5d6-0302cfcb32dc",
                                                "text": "Cette infécondité, qui, de mois en mois, lui fit verser des torrents de larmes, entretint longtemps le mépris de Brigitte, qui lui reprochait de n’être bonne à rien, pas même à faire des enfants."
                                            },
                                            {
                                                "example_id": "8b33fd17-9612-42b9-9de3-c24d5e9d861b",
                                                "sense_id": "e762bbee-d4cf-3c9d-a5d6-0302cfcb32dc",
                                                "text": "L’inconnu devait être le père de cette enfant qui, sans le remercier, lui prit familièrement le bras et l’entraîna brusquement dans le jardin."
                                            },
                                            {
                                                "example_id": "592064d8-bd91-460f-83cc-b7b3b0d0fbbc",
                                                "sense_id": "e762bbee-d4cf-3c9d-a5d6-0302cfcb32dc",
                                                "text": "Sylvie, elle, a même un rituel : offrir à chaque entrée en sixième de ses neveux, nièces, filleuls et enfants un exemplaire de Pieds nus sur la terre sacrée, de Teresa Carolyn McLuhan."
                                            },
                                            {
                                                "example_id": "23b8b36d-bf28-4cad-8cb4-a08814401017",
                                                "sense_id": "e762bbee-d4cf-3c9d-a5d6-0302cfcb32dc",
                                                "text": "J’aurais pu […] avoir là des enfants bronzés qui auraient grandi libres et heureux sous le chaud soleil de la Polynésie."
                                            },
                                            {
                                                "example_id": "051d137e-2205-43c1-8069-c46a8a9ee7ed",
                                                "sense_id": "e762bbee-d4cf-3c9d-a5d6-0302cfcb32dc",
                                                "text": "On ne fait plus d’enfants, chez nous, sauf dans les coins pouilleux, dans les milieux de misère, certains samedi de paye, après stations devant les comptoirs des bistrots."
                                            },
                                            {
                                                "example_id": "f694a8f2-292a-442d-9956-914b413a0322",
                                                "sense_id": "e762bbee-d4cf-3c9d-a5d6-0302cfcb32dc",
                                                "text": "Celle-ci, mariée à un ingénieur du P.-L.-M., vivait avec ses trois enfants, dans une maisonnette que le ménage avait fait élever, après la guerre, sur un lotissement de Brunoy."
                                            },
                                            {
                                                "example_id": "8ab6439e-6d96-4059-bc1b-d690f1c78567",
                                                "sense_id": "e762bbee-d4cf-3c9d-a5d6-0302cfcb32dc",
                                                "text": "Dès que leurs enfants pourraient s’y aventurer, […], les mères les sermonnent à grosse voix : « Ne va jamais là tout seul, sais-tu : la bête à crochets te mangerait »."
                                            },
                                            {
                                                "example_id": "a42738f9-d30b-4fb4-b805-35db539d238f",
                                                "sense_id": "e762bbee-d4cf-3c9d-a5d6-0302cfcb32dc",
                                                "text": "Un capitulaire prescrit de ne contracter que des unions légitimes, car celles-là seules donnent des enfants capables de succéder."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bbc202d4-0652-3fe7-ba87-86a9de870292",
                                        "entry_id": "cd028339-0e36-3c41-8c58-85c050a52d9c",
                                        "glosses": [
                                            "Fils, par relation à ses parents."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30a69446-71b9-469c-94f2-9dca218694e3",
                                                "sense_id": "bbc202d4-0652-3fe7-ba87-86a9de870292",
                                                "text": "— Laisse-t-elle plusieurs enfants ?\n— Elle ne laisse pas d’enfants, Monsieur ; elle n’a qu’une fille, dit Claudie, qui n’appliquait, comme font les Berrichons, le mot d’enfant qu’au sexe masculin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "32f88def-4999-32dc-8403-44b165e3fcf5",
                                        "entry_id": "cd028339-0e36-3c41-8c58-85c050a52d9c",
                                        "glosses": [
                                            "Descendant, descendante en ligne directe et indirecte."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "38970b61-8fb3-4476-8135-b3586b7bffd3",
                                                "sense_id": "32f88def-4999-32dc-8403-44b165e3fcf5",
                                                "text": "Nous sommes tous enfants d’Adam."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a8eccfe0-b5bd-3260-9ab2-3ba8cbd0d472",
                                        "entry_id": "cd028339-0e36-3c41-8c58-85c050a52d9c",
                                        "glosses": [
                                            "Personne proche de manière affective, amicale, filiale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1752098b-e640-4697-8c47-cc645e17b7be",
                                                "sense_id": "a8eccfe0-b5bd-3260-9ab2-3ba8cbd0d472",
                                                "text": "Ma belle enfant."
                                            },
                                            {
                                                "example_id": "24635802-5663-4313-ac42-e2feb8ee17ba",
                                                "sense_id": "a8eccfe0-b5bd-3260-9ab2-3ba8cbd0d472",
                                                "text": "Venez, mon enfant."
                                            },
                                            {
                                                "example_id": "d74fcdce-4a22-4679-bab8-aebc72c66595",
                                                "sense_id": "a8eccfe0-b5bd-3260-9ab2-3ba8cbd0d472",
                                                "text": "Ma chère enfant, écoutez-moi."
                                            },
                                            {
                                                "example_id": "69bd1af5-1422-494b-b84c-e80ab46ee91b",
                                                "sense_id": "a8eccfe0-b5bd-3260-9ab2-3ba8cbd0d472",
                                                "text": "Courage, enfants, criait-il à ses soldats."
                                            },
                                            {
                                                "example_id": "f6f2fcb1-e59d-437e-8234-e9c59d4b8a9e",
                                                "sense_id": "a8eccfe0-b5bd-3260-9ab2-3ba8cbd0d472",
                                                "text": "Voilà une belle enfant !"
                                            },
                                            {
                                                "example_id": "2ca760db-e107-4f7c-b87c-2e925d46e7ba",
                                                "sense_id": "a8eccfe0-b5bd-3260-9ab2-3ba8cbd0d472",
                                                "text": "Vous êtes une aimable enfant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "969c61b1-003e-3073-88e8-8638547d6db1",
                                        "entry_id": "cd028339-0e36-3c41-8c58-85c050a52d9c",
                                        "glosses": [
                                            "Représentants les plus jeunes d’une population."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "618d52c3-082f-41a4-82f1-c7650b8dc2ce",
                                                "sense_id": "969c61b1-003e-3073-88e8-8638547d6db1",
                                                "text": "Partout, les ministres affirmaient que « la Patrie pouvait compter sur ses enfants ». Et ce mot « enfants » avait un prestige tout neuf."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5a3f4a21-afe9-3aef-ac6c-2ca09a9aa3b6",
                                        "entry_id": "cd028339-0e36-3c41-8c58-85c050a52d9c",
                                        "glosses": [
                                            "Chose qui est produite par une autre, qui en naît, qui en résulte."
                                        ],
                                        "tags": [
                                            "dated",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9fe96c6f-6d0e-4662-9f3e-6380c67c49d0",
                                                "sense_id": "5a3f4a21-afe9-3aef-ac6c-2ca09a9aa3b6",
                                                "text": "Le remords est enfant du crime."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "48e5c92a-fae5-3f55-ac22-2975a1cd3d8d",
                                        "entry_id": "cd028339-0e36-3c41-8c58-85c050a52d9c",
                                        "glosses": [
                                            "(En apposition ou attribut, avec valeur d'adjectif). Qui a le caractère d’un enfant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bde64199-be1f-4f02-b391-1bdea180590b",
                                                "sense_id": "48e5c92a-fae5-3f55-ac22-2975a1cd3d8d",
                                                "text": "Il est très enfant."
                                            },
                                            {
                                                "example_id": "e79abdf3-65db-4472-a930-cfa05f6d8826",
                                                "sense_id": "48e5c92a-fae5-3f55-ac22-2975a1cd3d8d",
                                                "text": "Sa face douloureuse avait un peu vieilli, il ne conservait que ses grands yeux restés enfants, des yeux bruns, vifs et limpides."
                                            },
                                            {
                                                "example_id": "fded8493-6daf-4ba3-9392-9acdbded8f5c",
                                                "sense_id": "48e5c92a-fae5-3f55-ac22-2975a1cd3d8d",
                                                "text": "– Les chefs du mouvement, demandai-je, croient-ils au succès de leur tentative ?\nM. Joyce, alias Grütli, eut un geste dubitatif.\n– Je ne sais, dit-il, je ne les suppose pourtant pas si enfants."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
