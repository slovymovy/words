                        "entry_id": "26bdb849-c5cc-3311-8c65-62bc4df386bd",
                        "glosses": [
                            "Having to do with hermeneutics; that explains, interprets, illustrates or elucidates texts, especially holy texts."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "159b5708-640d-4b28-9b57-37030934c82e",
                        "source_entry_id": "26bdb849-c5cc-3311-8c65-62bc4df386bd",
                        "source_sense_id": "fcc30b28-b907-3381-904e-e1d2ce35ed5b",
