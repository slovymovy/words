                        "sense_id": "a95c66f5-34b4-31fe-989e-9cd4ace2b5e7",
                        "entry_id": "9b4d8c81-3af0-31c4-bf7c-3f4f0a080c98",
                        "glosses": [
                            "In a delighted manner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad4f377d-98b1-49cb-bf6f-d224d333e15e",
                                "sense_id": "a95c66f5-34b4-31fe-989e-9cd4ace2b5e7",
                                "text": "Delightedly dwells he ’mong fays and talismans,\nAnd spirits; and delightedly believes\nDivinities, being himself divine."
                            },
                            {
                                "example_id": "72b1be81-c95d-49ec-be3d-93dab0679f99",
                                "sense_id": "a95c66f5-34b4-31fe-989e-9cd4ace2b5e7",
                                "text": "Reappearing, tape-measure in hand, he went into the bedroom and took slow and accurate measurements, whistling delightedly to find that his pre-mortem theoretical calculations and post-mortem practical measurements hardly varied."
                            },
                            {
                                "example_id": "6e25c6d6-96eb-4bfa-ade0-c579e232a376",
                                "sense_id": "a95c66f5-34b4-31fe-989e-9cd4ace2b5e7",
                                "text": "[…] cards were exchanged, and social visits that were never going to happen were delightedly agreed on."
                            }
                        ]
                    }
                ],
