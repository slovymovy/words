{
    "word_family": [
        "overvloedig",
        "overvloeien"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "265cba31-f777-3528-90d9-889246853c42",
                    "sense_definition": "De aanwezigheid van een zeer grote hoeveelheid van iets, meer dan wat strikt nodig is.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "hoeveelheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In de zomer is er meestal een <w>overvloed</w> aan verse vruchten in de tuin.",
                            "target_lang_translations": {
                                "en": "In the summer, there is usually an <w>abundance</w> of fresh fruit in the garden."
                            }
                        },
                        {
                            "text": "Na de goede oogst was er een <w>overvloed</w> van aardbeien dat jaar.",
                            "target_lang_translations": {
                                "en": "After the good harvest, there was a <w>glut</w> of strawberries that year."
                            }
                        }
                    ],
                    "antonyms": [
                        "gebrek",
                        "tekort",
                        "schaarste"
                    ],
                    "common_phrases": [
                        "overvloed aan informatie",
                        "overvloed van aardbeien"
                    ],
                    "target_lang_definitions": {
                        "en": "The presence of a very large quantity of something, more than what is strictly necessary."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "abundance",
                                "target_lang_sense_clarification": "a large quantity or plentiful supply"
                            },
                            {
                                "target_lang_word": "plenty",
                                "target_lang_sense_clarification": "a full or sufficient amount"
                            },
                            {
                                "target_lang_word": "glut",
                                "target_lang_sense_clarification": "an excessive supply or surplus"
                            },
                            {
                                "target_lang_word": "profusion",
                                "target_lang_sense_clarification": "a large amount of something, often growing or produced"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3d10079c-2bf7-3fa5-919d-ab42ace6b8d0",
                    "sense_definition": "Een toestand van grote welvaart of rijkdom.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "welvaart",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De familie leefde jarenlang in grote <w>overvloed</w> dankzij hun succesvolle bedrijf.",
                            "target_lang_translations": {
                                "en": "The family lived in great <w>abundance</w> for years thanks to their successful business."
                            }
                        },
                        {
                            "text": "De hoorn des <w>overvloeds</w> is een bekend symbool voor vruchtbaarheid en rijkdom.",
                            "target_lang_translations": {
                                "en": "The horn of <w>plenty</w> is a well-known symbol for fertility and wealth."
                            }
                        }
                    ],
                    "antonyms": [
                        "armoede"
                    ],
                    "common_phrases": [
                        "hoorn des overvloeds",
                        "leven in overvloed"
                    ],
                    "target_lang_definitions": {
                        "en": "A state of great prosperity or wealth."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "abundance",
                                "target_lang_sense_clarification": "wealth and affluence"
                            },
                            {
                                "target_lang_word": "affluence",
                                "target_lang_sense_clarification": "the state of having a great deal of money"
                            },
                            {
                                "target_lang_word": "plenty",
                                "target_lang_sense_clarification": "a situation in which food and other necessities are available in large amounts"
                            },
                            {
                                "target_lang_word": "opulence",
                                "target_lang_sense_clarification": "great wealth or luxuriousness"
                            }
                        ]
                    }
                }
            ]
        }
    ]
