                "senses": [
                    {
                        "sense_id": "a34f0ee5-d608-303e-a349-7bdde6fd86e1",
                        "entry_id": "e0114453-ca17-35a2-a92d-e239f27a7426",
                        "glosses": [
                            "Verfahren, etwas durch die Verwendung vollkommen runder Körper herauszufinden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e7b0298-fb52-4ebc-8504-71ba33c7dcd4",
                                "sense_id": "a34f0ee5-d608-303e-a349-7bdde6fd86e1",
                                "text": "„Eine Möglichkeit, farbbasierte Segmentierungsverfahren zu bewerten, stellt der Kugeltest dar […].“"
                            },
                            {
                                "example_id": "e3f8cd0f-2c98-452f-903b-4c0f3eacffac",
                                "sense_id": "a34f0ee5-d608-303e-a349-7bdde6fd86e1",
                                "text": "„Im Einklang mit Studien zum Kugeltest unterschieden sich die Probandengruppen nicht in der Wahrscheinlichkeitsbeurteilung per se.“"
                            },
                            {
                                "example_id": "6df18638-74c3-4c5c-b74e-fa54ce7563dd",
                                "sense_id": "a34f0ee5-d608-303e-a349-7bdde6fd86e1",
                                "text": "„Belege für diese Annahme sind vor allem mit dem sog. Kugeltest (synonym: probabilistische Denkaufgabe) erbracht worden […].“"
                            },
                            {
                                "example_id": "de022f0d-009a-4b37-b8f7-a7dc573977a6",
                                "sense_id": "a34f0ee5-d608-303e-a349-7bdde6fd86e1",
                                "text": "„Der für das ‚Abspindeln‘ des Gleises richtige Zeitpunkt wird mit dem Kugeltest ermittelt […].“"
                            },
                            {
                                "example_id": "c1eb2e8d-e37c-44d3-b5f2-b2c479667b40",
                                "sense_id": "a34f0ee5-d608-303e-a349-7bdde6fd86e1",
                                "text": "„Die Vakuumfestigkeit und ein hierbei nicht gewolltes Abflachen der Schläuche wird durch einen Kugeltest überprüft.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
