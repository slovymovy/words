                "senses": [
                    {
                        "sense_id": "19f62fa5-98ed-31ce-8c95-2639768587d9",
                        "entry_id": "8a565b1a-d5a8-3c93-ac62-8b61a4ebd956",
                        "glosses": [
                            "A boy or lad."
                        ],
                        "tags": [
                            "Ireland"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "2d8fe214-a174-32ec-bbf7-fed60038722b",
                        "entry_id": "8a565b1a-d5a8-3c93-ac62-8b61a4ebd956",
                        "glosses": [
                            "A stereotypically Welsh form of address for a man, usually younger than the speaker."
                        ],
                        "tags": [
                            "derogatory",
                            "sometimes"
                        ],
                        "examples": [
                            {
                                "example_id": "d448f60b-8a84-43b2-bc91-85ca0dd4f52a",
                                "sense_id": "2d8fe214-a174-32ec-bbf7-fed60038722b",
                                "text": "“Don't be daft, boyo. First chance I get, and I'm skipping!”"
                            },
                            {
                                "example_id": "cbb1d2f2-c7bf-43ef-b976-d9d88669d659",
                                "sense_id": "2d8fe214-a174-32ec-bbf7-fed60038722b",
                                "text": "“Can’t get onboard the boat,” Dai finished for me. “Bloody typical, it is, boyo.”"
                            },
                            {
                                "example_id": "4a71373c-5d0c-4a73-91cc-44e0091e6cdd",
                                "sense_id": "2d8fe214-a174-32ec-bbf7-fed60038722b",
                                "text": "“What brings you around, boyo?” Deane asked, offering Case a narrow bonbon wrapped in blue-and-white checked paper."
                            },
                            {
                                "example_id": "9aba3f8c-a95a-4cac-8e74-147274ec2aad",
                                "sense_id": "2d8fe214-a174-32ec-bbf7-fed60038722b",
                                "text": "‘This, er, initiator of polonium and lithium, would it be used in an anti-personnel bomb?’ he asked. ‘Oh yes, you could say so, boyo,’ replied the Welshman."
                            },
                            {
                                "example_id": "b7267247-cb1d-4232-99ec-dc3bfe4be716",
                                "sense_id": "2d8fe214-a174-32ec-bbf7-fed60038722b",
                                "text": "A taff is a Welshman. Everyone in the doctors’ mess calls me taff or taffy. Mr Swain, the mortuary attendant, calls me boyo, especially during the rugby season when Wales lose badly."
                            },
                            {
                                "example_id": "4a33439c-3614-4b0b-8956-2ff88a1a6d89",
                                "sense_id": "2d8fe214-a174-32ec-bbf7-fed60038722b",
                                "text": "“You’re crazy boyo!” Taffy gaped at his shipmate’s rosy cheeks, their hugh brightened by the Canadian blasts. “Now, what in the bloody hell were you doing out there boyo?”"
                            }
                        ]
                    }
                ],
