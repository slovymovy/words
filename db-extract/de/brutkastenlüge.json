                "senses": [
                    {
                        "sense_id": "d4b7fb90-bb5e-3757-8230-43ad02e26b65",
                        "entry_id": "04991f49-a73a-308d-8191-eacd15e7ee46",
                        "glosses": [
                            "propagandistische Unterstützung zur Vorbereitung der Befreiung Kuwaits durch die USA und ihrer Alliierten, nach der irakische Soldaten bei der Eroberung Kuwaits 1990 Frühgeborene in einem Krankenhaus töteten"
                        ],
                        "tags": [
                            "Zweite Golfkrieg",
                            "auch Erster Irakkrieg"
                        ],
                        "examples": [
                            {
                                "example_id": "f29813b5-2b2b-4626-bff5-e28d60e43ff2",
                                "sense_id": "d4b7fb90-bb5e-3757-8230-43ad02e26b65",
                                "text": "Die Grausamkeit des Gegners sollte durch die schon berüchtigte Brutkastenlüge illustriert werden."
                            },
                            {
                                "example_id": "8928a672-2ce8-457a-b359-e185993bc8a3",
                                "sense_id": "d4b7fb90-bb5e-3757-8230-43ad02e26b65",
                                "text": "Zur Zeit ihrer Veröffentlichung bewirkte die Brutkastenlüge jedoch größte weltweite Empörung und eine starke Unterstützung für die geplante Befreiung Kuwaits unter Führung der USA 1991."
                            },
                            {
                                "example_id": "2d5bd1df-2edf-4a5c-9d63-9dbad78b86d8",
                                "sense_id": "d4b7fb90-bb5e-3757-8230-43ad02e26b65",
                                "text": "Die Brutkastenlügegilt heute als Musterbeispiel für eine erfolgreiche Manipulation der Öffentlichkeit."
                            },
                            {
                                "example_id": "a3ab202b-5a7c-4389-9fd0-ed15b4cdb419",
                                "sense_id": "d4b7fb90-bb5e-3757-8230-43ad02e26b65",
                                "text": "Wichtig in der Geschichte sind aber auch all die Lügen, die Kriegen vorangehen: Der Zweite Weltkrieg brauchte die Dolchstoßlegende und den Sender Gleiwitz, für den Vietnamkrieg erfanden die USA einen kommunistischen Überfall im Golf von Tonkin, George Bush und Tony Blair fantasierten Massenvernichtungswaffen in den Irak, und Bush senior brauchte für seinen Irakkrieg die Brutkastenlüge."
                            },
                            {
                                "example_id": "b069ad60-96aa-41f8-b3ae-1ac63bcf683f",
                                "sense_id": "d4b7fb90-bb5e-3757-8230-43ad02e26b65",
                                "text": "Bei der ‚Brutkastenlüge‘ handelt es sich um eine Kampagne des US-amerikanischen PR-Unternehmens Hill & Knowlton (H&K), die ich aus Gründen der Anschaulichkeit immer wieder werde erzählen müssen:…"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
