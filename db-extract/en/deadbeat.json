                    {
                        "translation_id": "c2b3f5df-06ac-4b15-844e-6ade20f611b7",
                        "source_entry_id": "1c12d64d-1f92-3c9c-b123-5266fe5c17e0",
                        "source_sense_description": "lazy person, depending upon financially independent people for support",
                        "target_lang_word": "Faulpelz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Faulpelz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dfaf8a66-5105-3c39-8e0a-e5268a29b63c",
                                        "entry_id": "e4b9f6a3-daaf-350b-9687-26414efe40e9",
                                        "glosses": [
                                            "Person, die träge / faul ist und keine Lust hat, zu arbeiten / sich anzustrengen"
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dc89fdc6-3e7b-4f7c-a2aa-14a43d18b963",
                                                "sense_id": "dfaf8a66-5105-3c39-8e0a-e5268a29b63c",
                                                "text": "Unser Sohn ist ein kleiner Faulpelz."
                                            },
                                            {
                                                "example_id": "4df2924b-e556-4746-888b-a0b2cc56fda8",
                                                "sense_id": "dfaf8a66-5105-3c39-8e0a-e5268a29b63c",
                                                "text": "„Wenn du weiter so ein Faulpelz bist wirst du die Schule nie schaffen!“"
                                            },
                                            {
                                                "example_id": "1c59cd71-1b4c-4afd-9c74-3cde9294b3ff",
                                                "sense_id": "dfaf8a66-5105-3c39-8e0a-e5268a29b63c",
                                                "text": "[André Rauch:] „Als Gymnasiast war ich ein Faulpelz.“"
                                            },
                                            {
                                                "example_id": "031a54ac-ba7c-475e-8651-ee1fd4837b30",
                                                "sense_id": "dfaf8a66-5105-3c39-8e0a-e5268a29b63c",
                                                "text": "[André Rauch:] „Wenn Sie mir heute sagen, du bist faul, Sie sind faul, dann sage ich mir, er behandelt mich als Faulpelz, weil ich nicht tue, was er von mir will. Jemand der faul ist, nimmt sich seine Freiheit.“"
                                            },
                                            {
                                                "example_id": "47f31c3f-7c80-4013-97da-bee8321055fb",
                                                "sense_id": "dfaf8a66-5105-3c39-8e0a-e5268a29b63c",
                                                "text": "„Ich war nie ein Nationalist“, versicherte er mir glaubhaft, „doch ich lasse es mir nicht gefallen, dass ich als Andalusier zum Faulpelz abgestempelt werde, der sich angeblich den ganzen Tag sonnt und das katalanische Geld versäuft.“"
                                            },
                                            {
                                                "example_id": "88f65ee7-973a-438f-be07-d6462eacbc62",
                                                "sense_id": "dfaf8a66-5105-3c39-8e0a-e5268a29b63c",
                                                "text": "Wer als Salafist auf sich hält, trägt Rauschebart. Wer zu faul zum Rasieren ist, auch. Nur verbinden die meisten mit Rauschebartträgern derzeit eher Islamisten als Faulpelze."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1c7855f3-d9b4-4fb6-a56c-6310ad948b8d",
                        "source_entry_id": "1c12d64d-1f92-3c9c-b123-5266fe5c17e0",
                        "source_sense_description": "lazy person, depending upon financially independent people for support",
                        "target_lang_word": "Gammler",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gammler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1d3bc410-c13a-3f71-bd00-834cf92e6c83",
                                        "entry_id": "eae0a823-60cc-3541-b0cb-dbd864b4f200",
                                        "glosses": [
                                            "Angehöriger einer jugendlichen Subkultur mit betonter Ablehnung bürgerlicher Normen und Lebensformen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6683633e-db17-411c-a276-682eddb189f0",
                                                "sense_id": "1d3bc410-c13a-3f71-bd00-834cf92e6c83",
                                                "text": "Die Gammler erregten seinerzeit viel Aufsehen und ernteten fast nur Ablehnung."
                                            },
                                            {
                                                "example_id": "64fe31f8-45f8-45d1-881e-d42705044b94",
                                                "sense_id": "1d3bc410-c13a-3f71-bd00-834cf92e6c83",
                                                "text": "„Die ehemals Beklagte wendete dagegen ein, daß die Klägerin die Beklagte als »Trottel« und den Mitinhaber des von der ehemals Beklagten geführten Fahrschulunternehmens als »Depp«, »Hippie« und »Gammler«, der »blöd genug« gewesen sei, »der Beklagten auch noch Geld zu geben«, bezeichnet habe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "42da9933-f5fc-48a0-99b3-8ca55538a848",
                        "source_entry_id": "1c12d64d-1f92-3c9c-b123-5266fe5c17e0",
                        "source_sense_description": "lazy person, depending upon financially independent people for support",
                        "target_lang_word": "Schnorrer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schnorrer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "482df6de-448b-3c1d-822f-1e964860bc28",
                                        "entry_id": "ebe4404a-166a-3814-a1a1-a366f2aa913a",
                                        "glosses": [
                                            "(männliche) Person, die wiederholt um Gefälligkeiten (zum Beispiel Zigaretten oder Snacks) bittet, ohne die Absicht zu haben, eine Gegenleistung zu erbringen"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aca51b18-7651-4d51-ad64-c93ec5a29cfd",
                                                "sense_id": "482df6de-448b-3c1d-822f-1e964860bc28",
                                                "text": "„Er war empört gewesen, daß der Bankier Roest ihn als Schnorrer und Nebbich empfangen hatte, aber er sah bald, daß er in dieser Stadt, die in einem Millionentaumel lebte, wirklich ein Nebbich war.“"
                                            },
                                            {
                                                "example_id": "78bfe3c7-aecd-4d6d-8796-22966b38b6de",
                                                "sense_id": "482df6de-448b-3c1d-822f-1e964860bc28",
                                                "text": "Er hatte nicht viel für Schnorrer übrig, aber ihm gefiel es, wenn jemand sein Talent in der Öffentlichkeit präsentierte, und er fand, dass eine kleine Gage gerechtfertigt war."
                                            },
                                            {
                                                "example_id": "3aca782b-aff2-4cd2-b092-554be12d119c",
                                                "sense_id": "482df6de-448b-3c1d-822f-1e964860bc28",
                                                "text": "„Die Schnorrer, das heißt die Bettler, die auf Kosten reicher Gönner lebten, waren fester Bestandteil des durch die jüdische Religion geprägten Selbstverständnisses.“"
                                            },
                                            {
                                                "example_id": "37f8bb00-ef8d-41e0-b935-14dfa059fae4",
                                                "sense_id": "482df6de-448b-3c1d-822f-1e964860bc28",
                                                "text": "„Denn einerseits entpuppt sich der Sabbatgast, der seinen Schwiegersohn ungebeten an den Tisch setzt, zwar als ein Schnorrer; andererseits aber folgen alle Beteiligten hier nur dem Gebot: Der Hausherr erfüllt seine Gastgeberpflicht, der Sabbatgast erfüllt seinen Vertrag mit den Eltern des Schwiegersohns, und indem er den Vater seiner Frau begleitet, hält sich auch der Schwiegersohn nur an die Regeln der Tradition.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "816bbda9-fb92-433b-81c4-adb13ac717cb",
