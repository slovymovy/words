                        "form_id": "e54c302c-bd98-4894-b278-a84240b0a9c3",
                        "entry_id": "892e47bb-568e-3cf1-9025-15a3b3123967",
                        "tags": [
                            "vocative",
                            "plural",
                            "nonvirile"
                        ],
                        "form": "czarodziejskie"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "881cc45e-caa0-38eb-8a7d-7ed9ec5eac32",
                        "entry_id": "892e47bb-568e-3cf1-9025-15a3b3123967",
                        "glosses": [
                            "związany z czarowaniem lub czarodziejem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e191526f-a2ef-4617-b094-239d70f94b53",
                                "sense_id": "881cc45e-caa0-38eb-8a7d-7ed9ec5eac32",
                                "text": "Zobaczyła stożkowatą czapkę w gwiazdki i czarodziejską różdżkę."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d8dc9b1e-35ed-41b9-a60a-8c86832dd04d",
                        "source_entry_id": "892e47bb-568e-3cf1-9025-15a3b3123967",
                        "source_sense_id": "881cc45e-caa0-38eb-8a7d-7ed9ec5eac32",
                        "target_lang_word": "kouzelný",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kouzelný",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "ae735112-9fa2-3224-99cf-454d300495ea",
                                        "entry_id": "a07b3025-0483-3d52-9d59-299f43e3d268",
                                        "glosses": [
                                            "související s kouzly; způsobující kouzla či způsobený kouzly"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "181aa755-92ea-41bb-861a-7107f7656e52",
                                                "sense_id": "ae735112-9fa2-3224-99cf-454d300495ea",
                                                "text": "Šebestová, člověče, tohle není obyčejný utržený sluchátko - to je sluchátko kouzelný! Vyčaruje nám, co budeme chtít..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fa2c0612-1c4e-3572-8777-254369b9bbae",
                                        "entry_id": "a07b3025-0483-3d52-9d59-299f43e3d268",
                                        "glosses": [
                                            "vedoucí k upoutání pozornosti a příjemným smyslovým prožitkům"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47dfed9b-803c-47e6-9584-8506b9304872",
                                                "sense_id": "fa2c0612-1c4e-3572-8777-254369b9bbae",
                                                "text": "Naše letošní dovolená byla naprosto kouzelná!"
                                            },
                                            {
                                                "example_id": "60aa76a1-2d3e-472f-8bda-4a820b914dff",
                                                "sense_id": "fa2c0612-1c4e-3572-8777-254369b9bbae",
                                                "text": "Její podmanivý, kouzelný úsměv každého odzbrojí."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cc53ad42-141c-47a9-b177-717154d49a2b",
                        "source_entry_id": "892e47bb-568e-3cf1-9025-15a3b3123967",
                        "source_sense_id": "881cc45e-caa0-38eb-8a7d-7ed9ec5eac32",
                        "target_lang_word": "magique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "magique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a3054d22-758f-30a2-8d7f-b6e9861144d3",
                                        "entry_id": "737e78d5-cfb7-3dfb-955c-fca846798e49",
                                        "glosses": [
                                            "Relatif à la magie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d5d517d-b296-46d5-8bd6-7f090e65f35f",
                                                "sense_id": "a3054d22-758f-30a2-8d7f-b6e9861144d3",
                                                "text": "Leur pouvoir était illimité ; ils guérissaient les malades abandonnés des médecins, rendaient fécondes les terres stériles, arrêtaient les épidémies de bestiaux, mais ils n’étaient point toujours d’humeur à ces sorcelleries bienfaisantes, et, plus volontiers, ils se servaient de leur puissance magique pour tourmenter les hommes et les bêtes."
                                            },
                                            {
                                                "example_id": "493b61ae-1faa-4acc-8bcd-e23b4075dd07",
                                                "sense_id": "a3054d22-758f-30a2-8d7f-b6e9861144d3",
                                                "text": "L’aporie est une espèce d’énigme, mais considérée d’un point de vue logique plutôt que magique ou spirituel. C’est un problème qu’on renonce à résoudre, au moins provisoirement, ou un mystère qu’on refuse d’adorer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b0f38409-60d8-3c43-9340-177b104c21ac",
                                        "entry_id": "737e78d5-cfb7-3dfb-955c-fca846798e49",
                                        "glosses": [
                                            "Qui semble être produit par le prétendu pouvoir de la magie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "41d3df06-282e-4186-87b1-985b62059533",
                                                "sense_id": "b0f38409-60d8-3c43-9340-177b104c21ac",
                                                "text": "François se dévoyait auprès des filles publiques, […]. On dit que ces professionnelles ont des charmes secrets, des recettes magiques pour exaspérer la volupté de leurs clients et leur procurer des extases sans pareilles."
                                            },
                                            {
                                                "example_id": "1e4fc424-0fed-4e44-8494-353f671b12a9",
                                                "sense_id": "b0f38409-60d8-3c43-9340-177b104c21ac",
                                                "text": "Jérôme Denis fait également le constat d’un paradoxe : si ce « travail des données » joue un rôle important dans la vie des organisations, il y est le plus souvent aussi invisibilisé et dévalorisé. Cela découle d’une fausse image que nous nous faisons des données qui seraient dotées de la faculté « quasi-magique » de se propager toutes seules dans les organisations comme le long du système nerveux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "71ebea54-8605-3b7b-8f95-b1998051f0f3",
                                        "entry_id": "737e78d5-cfb7-3dfb-955c-fca846798e49",
                                        "glosses": [
                                            "Ce qui étonne, fait illusion."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2d17e91f-b4f1-4c41-9cbe-2d27904787e3",
                                                "sense_id": "71ebea54-8605-3b7b-8f95-b1998051f0f3",
                                                "text": "Un éclat magique."
                                            },
                                            {
                                                "example_id": "ae52b107-9a59-4bd6-8c54-70d5532f07ce",
                                                "sense_id": "71ebea54-8605-3b7b-8f95-b1998051f0f3",
                                                "text": "Cette illumination est d’un effet, produit un effet magique."
                                            },
                                            {
                                                "example_id": "94437fd1-f14c-40bf-8338-6a1ed1f2855b",
                                                "sense_id": "71ebea54-8605-3b7b-8f95-b1998051f0f3",
                                                "text": "C'était magnifique, grandiose, magique. Vous savez, tous ces mots qui n'en peuvent plus d'être éblouis."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "200dd2d6-498e-4461-9915-3da59f184628",
                        "source_entry_id": "892e47bb-568e-3cf1-9025-15a3b3123967",
                        "source_sense_id": "881cc45e-caa0-38eb-8a7d-7ed9ec5eac32",
                        "target_lang_word": "волшебный",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "волшебный",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "c579dca0-674f-3667-8f1e-e89b21c11b0f",
                                        "entry_id": "cc9f9b67-3f02-3486-aed7-f41f7b3ed4f4",
                                        "glosses": [
                                            "обладающий чудодейственными свойствами, имеющий чудодейственную природу"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "06038dbd-8956-443c-9754-64784d86fd48",
                                                "sense_id": "c579dca0-674f-3667-8f1e-e89b21c11b0f",
                                                "text": "Сердце её как будто бы вздрогнуло — как будто бы какой-нибудь чародей дотронулся до него волшебным жезлом своим!"
                                            },
                                            {
                                                "example_id": "d57bc617-2d62-44a1-8ada-1550a3808786",
                                                "sense_id": "c579dca0-674f-3667-8f1e-e89b21c11b0f",
                                                "text": "Но между тем, никем не зрима, // От нападений колдуна // Волшебной шапкою хранима, // Что делает моя княжна, // Моя прекрасная Людмила?"
                                            },
                                            {
                                                "example_id": "569d7bbd-f3c0-48d7-9241-f9a2d9128db8",
                                                "sense_id": "c579dca0-674f-3667-8f1e-e89b21c11b0f",
                                                "text": "Волшебные чёрные кони и те утомились и несли своих всадников медленно .."
                                            },
                                            {
                                                "example_id": "ca5b59a9-7372-4e1a-a9d9-1edf4bc46b69",
                                                "sense_id": "c579dca0-674f-3667-8f1e-e89b21c11b0f",
                                                "text": "Остановился он неподалёку, в бывшем \"Балчуге\", который преобразился за последние годы во что-то совершенно великолепное, вроде того хрустального моста, который перекидывается по волшебному слову за одну ночь с одного берега на другой."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f691971e-bdb1-3036-bca4-b37febd8d1ef",
                                        "entry_id": "cc9f9b67-3f02-3486-aed7-f41f7b3ed4f4",
                                        "glosses": [
                                            "основанный на фантастическом вымысле, фантастических превращениях, явлениях, описывающий такие превращения, явления"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a1d72b2-6e11-40ce-a9cd-0ddeee5b452f",
                                                "sense_id": "f691971e-bdb1-3036-bca4-b37febd8d1ef",
                                                "text": ".. но все эти поэмы [Пушкина], шуточные, волшебные, рыцарские и сказочные, .. прекрасны и достойны внимания .."
                                            },
                                            {
                                                "example_id": "efe2de88-c6f1-434a-b2d1-5e0177521704",
                                                "sense_id": "f691971e-bdb1-3036-bca4-b37febd8d1ef",
                                                "text": "Особенно нравились ему арабские сказки, которые доставляли обильную пищу его воображению своими волшебными, занимательными рассказами и роскошными описаниями."
                                            },
                                            {
                                                "example_id": "af0a3b82-7121-433f-9b6a-d773c9169b6a",
                                                "sense_id": "f691971e-bdb1-3036-bca4-b37febd8d1ef",
                                                "text": "Вот я теперь записал этот сон и думаю, больше уже не повторится мне во сне та волшебная страна."
                                            },
                                            {
                                                "example_id": "8d6e96a0-837f-4663-9413-672c7e583990",
                                                "sense_id": "f691971e-bdb1-3036-bca4-b37febd8d1ef",
                                                "text": "И я поскачу быстрее ветра и выше облаков в волшебные страны, где живёт Жар-птица и поют Сирин и Алконост."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa9636c2-0019-306e-9a2f-a19f24de4146",
                                        "entry_id": "cc9f9b67-3f02-3486-aed7-f41f7b3ed4f4",
                                        "glosses": [
                                            "перен. необыкновенно прекрасный; пленительный, чарующий"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4613e433-aeed-42aa-9a08-b5c865c6884b",
                                                "sense_id": "aa9636c2-0019-306e-9a2f-a19f24de4146",
                                                "text": ".. и, краснея, вам признаюся, // что волшебный вид прелестницы ― // не хочу теперь назвать её! ― // был мне пищею небесною, // олимпийскою амброзией .."
                                            },
                                            {
                                                "example_id": "6434eca6-627e-414b-87ac-aeb2d569a2e6",
                                                "sense_id": "aa9636c2-0019-306e-9a2f-a19f24de4146",
                                                "text": ".. Он ловит жадною душой // Приятной речи звук волшебный // И взоры девы молодой."
                                            },
                                            {
                                                "example_id": "3256d807-2835-4431-8e92-8dcdd99c610c",
                                                "sense_id": "aa9636c2-0019-306e-9a2f-a19f24de4146",
                                                "text": "Волшебный край! очей отрада! // Всё живо там; холмы, леса, // Янтарь и яхонт винограда, // Долин приютная краса, // И струй и тополей прохлада…"
                                            },
                                            {
                                                "example_id": "4783ae84-2a3f-4dc2-ae1d-ada6b9cefd10",
                                                "sense_id": "aa9636c2-0019-306e-9a2f-a19f24de4146",
                                                "text": "Ты помнишь ли, при вашей встрече, // При первой встрече роковой, // Её волшебный взор, и речи, // И смех младенчески-живой?"
                                            },
                                            {
                                                "example_id": "6f8255f7-b252-40e0-b0ce-0e383f8648cc",
                                                "sense_id": "aa9636c2-0019-306e-9a2f-a19f24de4146",
                                                "text": "Однако вот какой-то волшебный лес с переливающимися чёрными тенями и блёстками алмазов и с какой-то анфиладой мраморных ступеней, и какие-то серебряные крыши волшебных зданий .."
                                            },
                                            {
                                                "example_id": "745a3a45-7358-466e-abba-84c12855d0cb",
                                                "sense_id": "aa9636c2-0019-306e-9a2f-a19f24de4146",
                                                "text": "У хрущёвообразного экскурсовода оказался совершенно волшебный голос, и то, что он говорил, было настоящей сказкой."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1a2619c7-3b5e-433a-80f5-8b9700383b99",
                        "source_entry_id": "892e47bb-568e-3cf1-9025-15a3b3123967",
