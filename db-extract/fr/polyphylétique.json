                        "glosses": [
                            "Relatif à la polyphylie, morphologiquement semblable mais génétiquement issu d'ancêtres différents."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a092ca4-70a7-42b4-a576-0100d250b4d2",
                                "sense_id": "dbfd37a0-db53-3a37-891f-c6d48bffdc7c",
                                "text": "Un taxon polyphylétique est un taxon défini par une ressemblance qui n'a pas été héritée d'un ancêtre commun."
                            },
                            {
                                "example_id": "3d40f9be-c0ba-40d6-8ab6-9ae5bc587c0e",
                                "sense_id": "dbfd37a0-db53-3a37-891f-c6d48bffdc7c",
                                "text": "En classification phylogénétique, les algues sont un groupe polyphylétique : elles sont réparties en onze groupes."
                            }
                        ]
                    }
                ],
