                "senses": [
                    {
                        "sense_id": "0e2f3b48-9610-3656-b888-9a621a951639",
                        "entry_id": "ae6c5ae2-a8a0-3bfa-b574-705e4da16b81",
                        "glosses": [
                            "internauta tworzący i edytujący Wikipedię"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df531e56-5602-408a-a325-75e5d85d2ad2",
                                "sense_id": "0e2f3b48-9610-3656-b888-9a621a951639",
                                "text": "Atlas wikipedystów podaje miejsca pobytu (nauki, zamieszkania lub pracy) polskojęzycznych wikipedystek i wikipedystów"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "aa5235ff-1530-47c8-9822-b35a7c07d60b",
                        "source_entry_id": "ae6c5ae2-a8a0-3bfa-b574-705e4da16b81",
                        "source_sense_id": "0e2f3b48-9610-3656-b888-9a621a951639",
                        "target_lang_word": "Wikipedian",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wikipedian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dd89def7-a419-3a0a-8358-f8ac7886e328",
                                        "entry_id": "798ff19d-6455-347a-a2ef-dc67ee4b8cb4",
                                        "glosses": [
                                            "A person who contributes to Wikipedia, especially a regular contributor well versed in the ways of the website."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b7ec545-cd76-49a2-804d-9c4c518dbd78",
                                                "sense_id": "dd89def7-a419-3a0a-8358-f8ac7886e328",
                                                "text": "He is proud to be a Wikipedian."
                                            },
                                            {
                                                "example_id": "c9fb15e3-dbeb-4b3e-922b-0409e39f7d0e",
                                                "sense_id": "dd89def7-a419-3a0a-8358-f8ac7886e328",
                                                "text": "That is because Wikipedians, as they call themselves, can not only contribute whatever they want but can also edit entries posted by other writers as they see fit."
                                            },
                                            {
                                                "example_id": "f6c783e0-78cc-43bd-a192-3bcdbd3532b0",
                                                "sense_id": "dd89def7-a419-3a0a-8358-f8ac7886e328",
                                                "text": "Britannica, somewhat representative of old media in general, instinctively regards Wikipedia as a threat, whereas Wikipedians are not the least bit tempted to reciprocate."
                                            },
                                            {
                                                "example_id": "18637831-66bb-40e4-830d-f7d765810e61",
                                                "sense_id": "dd89def7-a419-3a0a-8358-f8ac7886e328",
                                                "text": "This change takes care of casual or heat-of-the-moment vandalism, but it does little to address a new category of Wikipedian somewhere between committed community member and momentarily vandalizing teenager, one that creates tougher problems."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Wikipedian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ce8102a5-9f13-3fa0-a103-715577ac58fb",
                                        "entry_id": "375fb341-08f3-34ef-adaa-816f9e5e17fb",
                                        "glosses": [
                                            "Of or relating to Wikipedia."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4346896f-75a0-422f-acd7-93447102cc35",
                                                "sense_id": "ce8102a5-9f13-3fa0-a103-715577ac58fb",
                                                "text": "Many scholars of Wikipedian theology theorize that if consensus is ever reached, Wikipedia will spontaneously disappear."
                                            },
                                            {
                                                "example_id": "12987809-a3bb-4fa5-baf4-099b0bd1e98d",
                                                "sense_id": "ce8102a5-9f13-3fa0-a103-715577ac58fb",
                                                "text": "In these Googlial Wikipedian times, a vast collection of wordbooks may seem slow, unnecessary or both."
                                            },
                                            {
                                                "example_id": "39b412f1-1bdc-4f5d-8819-677b9b366b64",
                                                "sense_id": "ce8102a5-9f13-3fa0-a103-715577ac58fb",
                                                "text": "If people stopped believing in the Wikipedian ideal, and used its tools for vandalism, \"it's unlikely the whole enterprise would survive a week\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8b88b8b9-78e3-4182-87fb-70169c845322",
                        "source_entry_id": "ae6c5ae2-a8a0-3bfa-b574-705e4da16b81",
                        "source_sense_id": "0e2f3b48-9610-3656-b888-9a621a951639",
                        "target_lang_word": "wikipédiste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wikipédiste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c603314c-6b1f-3e87-a86b-b8e824f24bcb",
                                        "entry_id": "c2e109a8-12d5-3a66-ba48-bc9245b946e6",
                                        "glosses": [
                                            "Personne qui participe à la rédaction de l’encyclopédie Wikipédia."
                                        ],
                                        "tags": [
                                            "Wikis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cae847f4-0384-486c-9ee2-36359a9cc941",
                                                "sense_id": "c603314c-6b1f-3e87-a86b-b8e824f24bcb",
                                                "text": "La figure la plus significative du facteur serait le wikipédiste, copieur frénétique si on veut, mais plutôt copiste collectif austère à valeur ajoutée, copieur honnête et avoué, discipliné, indemne de toute usurpation créative puisque la création est statutairement exclue de l’entreprise."
                                            },
                                            {
                                                "example_id": "00a42935-e778-4144-b61b-976045da1586",
                                                "sense_id": "c603314c-6b1f-3e87-a86b-b8e824f24bcb",
                                                "text": "L’ethos du wikipédiste valorise une sorte d’autorité douce, de reconnaissance modeste, d’activisme généreux et d’hospitalité forcée. Cette tension est, à sa manière, une conséquence du type de gouvernance qui s’est instauré sur Wikipédia."
                                            },
                                            {
                                                "example_id": "b87ea327-c913-4b61-8a97-819a46a43305",
                                                "sense_id": "c603314c-6b1f-3e87-a86b-b8e824f24bcb",
                                                "text": "L’anomyme wikipédiste n'a en réalité rien fait d’illégal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eca83ef9-4092-388e-b46c-910f2dcec7fa",
                                        "entry_id": "c2e109a8-12d5-3a66-ba48-bc9245b946e6",
                                        "glosses": [
                                            "Personne adepte ou utilisant les wikis."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b41540a4-ba37-49c7-b9b1-78b77f7b87e9",
                        "source_entry_id": "ae6c5ae2-a8a0-3bfa-b574-705e4da16b81",
                        "source_sense_id": "0e2f3b48-9610-3656-b888-9a621a951639",
