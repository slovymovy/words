                        "source_sense_id": "40588829-e7bf-3965-a7f9-52f6d30d7f2d",
                        "source_sense_description": "Eigenschaft von Lebewesen/sozialen Gruppen, sich auf die Bedingungen ihrer Umwelt einstellen zu können",
                        "target_lang_word": "souplesse",
