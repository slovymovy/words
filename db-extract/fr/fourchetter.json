                ],
                "senses": [
                    {
                        "sense_id": "e39ca73d-fe8b-3e58-a98e-f86c05689017",
                        "entry_id": "ec46791b-bbdb-39f2-92b2-84851d6ff4ae",
                        "glosses": [
                            "Piquer avec une fourchette."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c900788b-1481-44d3-a6db-0b0819f517b3",
                                "sense_id": "e39ca73d-fe8b-3e58-a98e-f86c05689017",
                                "text": "La demoiselle Fiollulia est arrivée derrière le duc et s’est mise à le fourchetter avec la plus vive énergie."
                            },
                            {
                                "example_id": "13ec56e9-827c-4dc1-8dfd-56ec31f01d3d",
                                "sense_id": "e39ca73d-fe8b-3e58-a98e-f86c05689017",
                                "text": "Il conseille d’arracher et de détruire les bananiers atteints, de fourchetter et de chauler fortement le sol avant replantation."
                            }
                        ]
                    },
                    {
                        "sense_id": "96dc1c0b-c59d-38f0-9df1-a2df1647d990",
                        "entry_id": "ec46791b-bbdb-39f2-92b2-84851d6ff4ae",
                        "glosses": [
                            "Diviser en plusieurs trajectoires parallèles, comme dans une fourchette."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a7bd8dd6-a80a-4473-b69d-795de1ad219c",
                                "sense_id": "96dc1c0b-c59d-38f0-9df1-a2df1647d990",
                                "text": "Au bon vieux temps, il existait toute une quantité de procédures assez compliquées pour fourchetter les axes, identifier le secteur, etc."
                            }
                        ]
                    },
                    {
                        "sense_id": "9fd1e007-d9fb-3fb0-bbde-af2278a37b20",
                        "entry_id": "ec46791b-bbdb-39f2-92b2-84851d6ff4ae",
                        "glosses": [
                            "Dans certains jeux (bridge, échecs…), utiliser une fourchette pour gagner quelque chose, prendre en fourchette."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af6e435c-f11f-41cd-99ed-bfb45563a502",
                                "sense_id": "9fd1e007-d9fb-3fb0-bbde-af2278a37b20",
                                "text": "Si Sud fournit petit, je rejoue un petit aussi, si Sud met sa Dame, Ouest prend et en rejoue pour « fourchetter » le 10 du mort !"
                            },
                            {
                                "example_id": "0b235ea5-2d62-409f-8d16-a5c682e29c0a",
                                "sense_id": "9fd1e007-d9fb-3fb0-bbde-af2278a37b20",
                                "text": "J’aime beaucoup les manœuvres du cavalier pour fourchetter la Tour ou pour l’enfilade…"
                            },
                            {
                                "example_id": "be471ac1-f6e8-486c-8836-c0f6af12b253",
                                "sense_id": "9fd1e007-d9fb-3fb0-bbde-af2278a37b20",
                                "text": "Du mort, Sud coupe et rejoue une deuxième fois atout et fourchetter le Valet (le 8 si Ouest met une petite carte, l’As s’il met le Valet)."
                            }
                        ]
                    },
                    {
                        "sense_id": "27895bba-df50-3d14-89bf-5f1e6c10bf0c",
                        "entry_id": "ec46791b-bbdb-39f2-92b2-84851d6ff4ae",
                        "glosses": [
                            "Interroger."
                        ],
