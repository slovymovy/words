                ],
                "senses": [
                    {
                        "sense_id": "5614d01f-46ec-33ae-8200-e1c7280a8128",
                        "entry_id": "7e0112bf-db70-3c60-8fb8-83c22a98fe54",
                        "glosses": [
                            "Qui est à la fois doux et amer au goût."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "2d425d16-d0da-4a2a-83a1-75da10e434dc",
                                "sense_id": "5614d01f-46ec-33ae-8200-e1c7280a8128",
                                "text": "L’une des expériences consistait par exemple à proposer un dessert doux-amer à des volontaires. Avant de pouvoir manger, ces derniers devaient répondre à un appel téléphonique leur demandant s’ils préféraient quelque chose de doux ou quelque chose d’amer."
                            },
                            {
                                "example_id": "da37d8d5-e427-43f8-9d20-f7ef457d1447",
                                "sense_id": "5614d01f-46ec-33ae-8200-e1c7280a8128",
                                "text": "D’autres personnes préfèreront rester dans un domaine sensoriel, le sucré par exemple, pendant toute la séance, voire plusieurs séances à la suite, on peut recourir dans ce cas aux contrastes gustatifs (sucré-salé, doux-amer) ou aux stimulations somesthésiques associées à la saveur sucrée (jus de fruit froid, thé sucré chaud, sucre pétillant, boisson sucrée au gingembre…)."
                            }
                        ]
                    },
                    {
                        "sense_id": "ef28836c-11f4-306b-aa7c-8a2c16130121",
                        "entry_id": "7e0112bf-db70-3c60-8fb8-83c22a98fe54",
                        "glosses": [
                            "Qui est à la fois agréable et désagréable."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "c6713ca1-40eb-4b5d-8364-cf41681df4f8",
                                "sense_id": "ef28836c-11f4-306b-aa7c-8a2c16130121",
                                "text": "Pour elle aussi il est doux-amer, puisqu’il lui fait à la fois « du plaisir et de la peine »"
                            },
                            {
                                "example_id": "7893efee-2c1c-4f75-ac6d-21458837ee05",
                                "sense_id": "ef28836c-11f4-306b-aa7c-8a2c16130121",
                                "text": "Seul naguère avec ses deux femmes, dans le plaisir ou la querelle avec la première, dans une tendresse parfois douce-amère avec l’autre (il est trop sincère pour envisager leurs relations différemment, même en plein deuil)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9f108157-5323-4833-98c8-68921c4c87ae",
                        "source_entry_id": "7e0112bf-db70-3c60-8fb8-83c22a98fe54",
                        "source_sense_description": "agréable et désagréable",
                        "target_lang_word": "bittersüß",
