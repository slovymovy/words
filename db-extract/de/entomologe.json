                        "cross_references": [
                            {
                                "target_word": "энтомолог",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "9dbaf0b5-1aac-3737-8895-807b85ca7bb5",
                                        "entry_id": "63020e18-62e3-362c-ba11-d59d315fb129",
                                        "glosses": [
                                            "специалист по энтомологии; тот, кто изучает насекомых"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dee071e5-8bc3-46b7-bfd5-d235a7236c5c",
                                                "sense_id": "9dbaf0b5-1aac-3737-8895-807b85ca7bb5",
                                                "text": "Он порой напоминал мне слегка сошедшего с ума энтомолога, который, подцепив инструментом многоножку, с любопытством следит за ее движениями."
                                            }
