                "senses": [
                    {
                        "sense_id": "52eedb22-054e-3440-b832-bf9effc75f7d",
                        "entry_id": "b98ead15-5577-3a30-8293-35340497473f",
                        "glosses": [
                            "Se comporter comme un Français, ou tel qu’on se représente les Français."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "32b1afce-e09f-428d-a25d-bd65efba21c2",
                                "sense_id": "52eedb22-054e-3440-b832-bf9effc75f7d",
                                "text": "Désormais, faites péter les accents circonflexes, les cédilles et l’imparfait du subjonctif, ça va franchouiller dans les chaumières."
                            },
                            {
                                "example_id": "7770603b-02ce-4d44-b7f3-49628a7dcc6e",
                                "sense_id": "52eedb22-054e-3440-b832-bf9effc75f7d",
                                "text": "Peut-être que je franchouille mais j’ai toujours raison :)"
                            }
                        ]
                    },
                    {
                        "sense_id": "8f3d4dc7-4f27-372a-951b-2a6876c47e76",
                        "entry_id": "b98ead15-5577-3a30-8293-35340497473f",
                        "glosses": [
                            "Donner un caractère plus français à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "029637cf-238f-47ae-b0a0-fec05e9e45c3",
                                "sense_id": "8f3d4dc7-4f27-372a-951b-2a6876c47e76",
                                "text": "Quand même un cocorico à Luc Besson, à JP Gaultier… qui ont réussi à franchouiller un peu le scénario et les dialogues car sinon ce film n’aurait ressemblé qu’à une grosse tartine ordinaire et hollywoodienne (effets spéciaux, héros, pauvre belle, gentille et sans défense, méchants… et j’en passe) lol."
                            }
                        ]
                    }
