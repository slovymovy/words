                        "cross_references": [
                            {
                                "target_word": "bad breath",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2e42a69d-3fa6-3f8c-895f-74869aae155f",
                                        "entry_id": "d35f1a6b-1681-3a49-825f-7c1408d58284",
                                        "glosses": [
                                            "Breath that produces an unpleasant or foul-smelling odor when exhaled."
                                        ],
                                        "tags": [
                                            "countable",
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d26a9cd0-156d-4008-8769-debe5b488074",
                        "source_entry_id": "c848eec4-84e8-30ca-ab95-7650f66c2f2d",
                        "source_sense_id": "73faeef9-ed08-37aa-b7fd-16d0ee8e5671",
                        "target_lang_word": "halitosis",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "halitosis",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c77d41f8-f1a9-38dc-a40a-eca3c74c9e23",
                                        "entry_id": "167b00a0-3aa6-36f2-a138-48f365d3d246",
                                        "glosses": [
                                            "The condition of having stale or foul-smelling breath."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bae120b2-5502-4305-b985-9b9a46733502",
                                                "sense_id": "c77d41f8-f1a9-38dc-a40a-eca3c74c9e23",
                                                "text": "Bad breath or halitosis is an indication of a disturbed digestive system. It is indicative of a bowel toxemia in either the small or large intestine with an overgrowth of bacteria or yeast."
                                            },
                                            {
                                                "example_id": "a31a0280-2e21-48b4-880a-27aef0a046e7",
                                                "sense_id": "c77d41f8-f1a9-38dc-a40a-eca3c74c9e23",
                                                "text": "For example, the word halitosis was almost completely unknown among the general public until the early 20th century when a business owner named Gerard Lambert started using it to sell a new product called Listerine. By giving a mundane fact of life (bad breath) a scientific sounding label, Lambert elevated the authority and desirability of his product many times over."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
