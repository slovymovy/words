                                        "entry_id": "e28764a6-d687-36c2-b6da-acec485e3de3",
                                        "glosses": [
                                            "die Gewinnung von Rohstoffen, Baustoffen vor allem durch Bergbau und ähnliche Technologien"
                                        ],
                                        "tags": [
                                            "Bergbau",
                                            "ingenieurgeologisch"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "757885bf-7099-4671-b96e-38143130c86a",
                                                "sense_id": "e4d53a83-4312-363d-a09f-1fcbae695d67",
                                                "text": "„Der Abbau von Steinkohle ist seit dem 9. Jahrhundert in England bekannt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "f092bcb7-1954-324a-aa26-a9bac2c83a39",
                                        "entry_id": "e28764a6-d687-36c2-b6da-acec485e3de3",
                                        "glosses": [
                                            "die Verringerung, Beseitigung, Minderung von Beständen"
                                        ],
