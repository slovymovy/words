                ],
                "senses": [
                    {
                        "sense_id": "deb58ccc-99dc-38b7-995e-907d041d18c9",
                        "entry_id": "340f6c64-c1d7-3071-8cd9-9fe8e5b2239e",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "93b281a7-4199-4940-beeb-8027b2e0ab6b",
                                "sense_id": "deb58ccc-99dc-38b7-995e-907d041d18c9",
                                "text": "Frau Wörle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "36a8916e-a085-4279-8618-40f8b3d0305b",
                                "sense_id": "deb58ccc-99dc-38b7-995e-907d041d18c9",
                                "text": "Herr Wörle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "90c0df12-349f-4790-8597-f11192f8ca97",
                                "sense_id": "deb58ccc-99dc-38b7-995e-907d041d18c9",
                                "text": "Die Wörles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "2ddfca66-05b0-479b-9325-4197bd3d3064",
                                "sense_id": "deb58ccc-99dc-38b7-995e-907d041d18c9",
                                "text": "Der Wörle trägt nie die Pullover, die die Wörle ihm strickt."
                            },
                            {
                                "example_id": "bc32b2a3-64e2-44f2-b5b2-062a7c92b476",
                                "sense_id": "deb58ccc-99dc-38b7-995e-907d041d18c9",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Wörle kommt, geht der Herr Wörle.“"
                            },
                            {
                                "example_id": "3057d882-3d2b-4a59-98b0-2bf5767e0bfc",
                                "sense_id": "deb58ccc-99dc-38b7-995e-907d041d18c9",
                                "text": "Wörle kommt und geht."
                            },
                            {
                                "example_id": "a9f9ecbe-2d01-4f9a-a508-4d35f1e76d48",
                                "sense_id": "deb58ccc-99dc-38b7-995e-907d041d18c9",
                                "text": "Wörles kamen, sahen und siegten."
                            },
                            {
                                "example_id": "1238c4a1-50b4-46a9-acc2-4a0dcddf15e0",
                                "sense_id": "deb58ccc-99dc-38b7-995e-907d041d18c9",
                                "text": "„Monatelang hatte Wörle den Stunt vorbereitet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
