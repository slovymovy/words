            {
                "entry_id": "4d0a494c-9935-32a3-97f1-a68651c7c9da",
                "word": "cotylédon",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "135c02a8-0f87-4673-a130-5228cd1a72c2",
                        "entry_id": "4d0a494c-9935-32a3-97f1-a68651c7c9da",
                        "tags": [
                            "plural"
                        ],
                        "form": "cotylédons"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ea6a24d4-40ac-316a-a119-09a8dccf1578",
                        "entry_id": "4d0a494c-9935-32a3-97f1-a68651c7c9da",
                        "glosses": [
                            "Chacun des deux lobes qui forment le placenta."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "572fca0a-11f2-36c7-94f9-01de43233492",
                        "entry_id": "4d0a494c-9935-32a3-97f1-a68651c7c9da",
                        "glosses": [
                            "Feuille insérée sur le premier nœud de l’embryon végétal né de graine."
                        ],
                        "tags": [
                            "analogy"
                        ],
                        "examples": [
                            {
                                "example_id": "0ace404a-6454-4020-8251-9e69fd651827",
                                "sense_id": "572fca0a-11f2-36c7-94f9-01de43233492",
                                "text": "Les deux cotylédons d’une fève, d’un haricot, etc."
                            },
                            {
                                "example_id": "d7a4ae4e-9f13-41b5-8dff-84e6ffc6e986",
                                "sense_id": "572fca0a-11f2-36c7-94f9-01de43233492",
                                "text": "Comme un cotylédon qui cherche à crever la terre, l’incisive exiguë cherche à paraître à travers la chair sensible et rose qui résiste."
                            },
                            {
                                "example_id": "929c966c-36fc-499a-98d5-27e910d1a0b5",
                                "sense_id": "572fca0a-11f2-36c7-94f9-01de43233492",
                                "text": "J’allais donc, grattant à la dérobée le jardin d’essai, surprendre la griffe ascendante du cotylédon, le viril surgeon que le printemps chassait de sa gaine."
                            }
                        ]
                    },
                    {
                        "sense_id": "e15d3235-cfc2-3afe-9acc-612b48a4bf07",
                        "entry_id": "4d0a494c-9935-32a3-97f1-a68651c7c9da",
                        "glosses": [
                            "Synonyme de nombril de Vénus (espèce de plantes)."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "f77b1259-5abd-3c14-9547-b3afa2701ab4",
                        "entry_id": "4d0a494c-9935-32a3-97f1-a68651c7c9da",
                        "glosses": [
                            "Définition manquante ou à compléter. (Ajouter)."
                        ],
                        "tags": [
                            "analogy"
                        ],
                        "examples": [
                            {
                                "example_id": "2832f856-4e8a-4c0d-81b1-f91d6532a4bf",
                                "sense_id": "f77b1259-5abd-3c14-9547-b3afa2701ab4",
                                "text": "J’avais un costume de lord écossais : une petite veste de velours noir en forme de cotylédon de fève, une chemise de linon fermée au cou par un cordonnet de soie, de petites culottes bouffantes en satin vert, de beaux bas de fil et des souliers à boucles."
                            },
                            {
                                "example_id": "911bfae2-5cfa-4c9a-9659-2b72180ac1ff",
                                "sense_id": "f77b1259-5abd-3c14-9547-b3afa2701ab4",
                                "text": "Ce qui m’aida aussi, ce fut ce squelette sous parchemin : ces deux cotylédons d’os iliaques, ces cavités pelviennes dans lesquelles la peau s’enfonçait et dont il fallait que je nettoie le fond avec de petites houppes de coton, ce pubis rocheux, ce sexe ruiné sous des herbes blanches."
                            }
                        ]
                    }
                ],
