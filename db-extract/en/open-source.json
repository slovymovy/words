{
    "word": "open-source",
    "lang_code": "en",
    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "a092e6a5-3947-31c2-9bc3-898b67fc9fdf",
                "word": "open-source",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "bd72c538-5b5e-34db-a81e-9f22f2b98430",
                        "entry_id": "a092e6a5-3947-31c2-9bc3-898b67fc9fdf",
                        "glosses": [
                            "Of or relating to software where the source code is freely available and licensed in a manner that permits modification and redistribution."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "b99efcd4-e60d-4b97-bcdf-8623d6b2e787",
                                "sense_id": "bd72c538-5b5e-34db-a81e-9f22f2b98430",
                                "text": "Linux is an open-source operating system."
                            },
                            {
                                "example_id": "0a4a9855-706f-4520-a0aa-535697566b33",
                                "sense_id": "bd72c538-5b5e-34db-a81e-9f22f2b98430",
                                "text": "ASP.NET MVC has been under an open-source license since the initial release, but it was just open-source code instead of a full open-source project."
                            },
                            {
                                "example_id": "64c7a77c-a4ed-46af-aab0-c20fd5bbe6fb",
                                "sense_id": "bd72c538-5b5e-34db-a81e-9f22f2b98430",
                                "text": "OpenSNP constituted a rare example of how open-source projects can successfully operate on a low budget, having repeatedly rejected offers from corporations to sell control of the data."
                            }
                        ]
                    },
                    {
                        "sense_id": "19185fb9-ac54-38ee-890c-72598b90fd60",
                        "entry_id": "a092e6a5-3947-31c2-9bc3-898b67fc9fdf",
                        "glosses": [
                            "Describing any product whose composition or method of manufacturing is public knowledge and not proprietary."
                        ],
                        "tags": [
                            "broadly",
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "e4822499-184c-4b77-ba19-bb9b8666a18d",
                                "sense_id": "19185fb9-ac54-38ee-890c-72598b90fd60",
                                "text": "open-source cola"
                            }
                        ]
                    },
                    {
                        "sense_id": "e05df6c7-a106-3956-b38e-27dfc5141d2e",
                        "entry_id": "a092e6a5-3947-31c2-9bc3-898b67fc9fdf",
                        "glosses": [
                            "Relying on publicly available information (open sources)."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "8ed9fc28-449f-44fd-91f7-b33e6eb3a993",
                                "sense_id": "e05df6c7-a106-3956-b38e-27dfc5141d2e",
                                "text": "open-source intelligence"
                            },
                            {
                                "example_id": "280827bc-25fd-40bd-b94c-6263aa810707",
                                "sense_id": "e05df6c7-a106-3956-b38e-27dfc5141d2e",
                                "text": "The ramifications of disinformation spill on to the streets with tangible, often devastating real-world consequences. These processes were already under way in 2014, when I founded the open-source investigative group Bellingcat."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e0e9e89c-5cba-4419-8d4a-c0f45ec2c835",
                        "source_entry_id": "a092e6a5-3947-31c2-9bc3-898b67fc9fdf",
                        "source_sense_description": "Translations",
                        "target_lang_word": "quelloffen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "quelloffen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "56fc7020-f558-39d7-9598-022905c1aa3b",
                                        "entry_id": "15d4d84a-89e8-311d-9780-7ab3c7b54ebb",
                                        "glosses": [
                                            "einen öffentlich zugänglichen Quellcode/Quelltext habend"
                                        ],
                                        "tags": [
                                            "Software",
                                            "von Software"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f7e49e4d-4848-4aee-9b0c-d39ea42457d2",
                                                "sense_id": "56fc7020-f558-39d7-9598-022905c1aa3b",
                                                "text": "„Open Source bzw. quelloffen ist Software, deren Quelltext offenliegt und deren Lizenzierung einige weitere Bedingungen erfüllt. Im engeren Sinne steht sie unter einer Lizenz, die von der Open Source Initiative (OSI) anerkannt wird.“"
                                            },
                                            {
                                                "example_id": "9619654f-2244-4c7a-a508-ee4be74448ce",
                                                "sense_id": "56fc7020-f558-39d7-9598-022905c1aa3b",
                                                "text": "„Gegner merken an, dass Skype (und auch die verwendete Verschlüsselung) nicht quelloffen ist, was eine Bewertung vom Sicherheits-Standpunkt aus sehr schwierig bis unmöglich macht.“"
                                            },
                                            {
                                                "example_id": "79807f8b-f6b6-4d8e-aa5d-26bc8f77d485",
                                                "sense_id": "56fc7020-f558-39d7-9598-022905c1aa3b",
                                                "text": "[Im LiMux Projekt hat die bayerische Landeshauptstadt München] die 15000 Arbeitsplatzrechner der städtischen Mitarbeiter auf Linux und quelloffene Software umgestellt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cc05b3ba-689e-4837-b5f4-d236de1c0183",
                        "source_entry_id": "a092e6a5-3947-31c2-9bc3-898b67fc9fdf",
