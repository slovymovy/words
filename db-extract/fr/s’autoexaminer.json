                        "glosses": [
                            "S’examiner soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e934b27d-1e53-4d84-a984-82a725a38b6d",
                                "sense_id": "1ee2c6b7-3cfc-3a06-bf67-9b95ece89c5b",
                                "text": "Par conséquent, pour s'assurer que les critères nécessaires à l'innovation ne soient pas perdus, l'organisation doit régulièrement s'autoexaminer."
                            },
                            {
                                "example_id": "1d00745e-eec2-4c5b-b7a6-64a00e31ab28",
                                "sense_id": "1ee2c6b7-3cfc-3a06-bf67-9b95ece89c5b",
                                "text": "La première conscience de soi naît en s'objectivant dans son « double », permettant à l'esprit humain de s’autoexaminer en pratiquant l'introspection, l'autoanalyse et le dialogue avec soi-même."
                            }
                        ]
                    }
