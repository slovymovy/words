                "forms": [],
                "senses": [
                    {
                        "sense_id": "d0e29944-3297-39b7-8d38-632930b7a636",
                        "entry_id": "4a04586e-7013-30dc-a644-939deac5ce8e",
                        "glosses": [
                            "Pays d’Afrique, entouré de l’Angola, la République démocratique du Congo, la Tanzanie, le Malawi, le Mozambique, le Zimbabwe et la Namibie, et dont la capitale est Lusaka."
                        ],
                        "tags": [
                            "Pays"
                        ],
                        "examples": [
                            {
                                "example_id": "92756acf-c90d-4a9e-b5a5-d67ee7d2cf99",
                                "sense_id": "d0e29944-3297-39b7-8d38-632930b7a636",
                                "text": "L’Afrique du Sud, avec la fin de l’apartheid a vu ainsi affluer des migrants venus du Mozambique, de Zambie ou d’Angola quand les Afrikaners partaient vers l’Australie ou l’Amérique."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "211fcd86-f66e-4c82-9225-52196eb740d5",
                        "source_entry_id": "4a04586e-7013-30dc-a644-939deac5ce8e",
                        "source_sense_id": "d0e29944-3297-39b7-8d38-632930b7a636",
                        "target_lang_word": "Sambia",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sambia",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0708791e-abd7-3e07-bb4e-b37d0f295c78",
                                        "entry_id": "83131aef-c257-36b5-a949-8f1f8bee9600",
                                        "glosses": [
                                            "Staat im südlichen Afrika"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb137651-3899-4f9f-9a93-dbacd050932a",
                                                "sense_id": "0708791e-abd7-3e07-bb4e-b37d0f295c78",
                                                "text": "Sambia liegt auf einem über tausend Meter hohen Plateau, das von tiefen Tälern und Senken umgeben ist."
                                            },
                                            {
                                                "example_id": "bcc4a24e-8233-4e2e-be13-e7f7eb918c40",
                                                "sense_id": "0708791e-abd7-3e07-bb4e-b37d0f295c78",
                                                "text": "Das Sambia von heute mag Theo einfach nicht mehr."
                                            },
                                            {
                                                "example_id": "7b4053c3-6d9c-4af4-993f-9362f758ced3",
                                                "sense_id": "0708791e-abd7-3e07-bb4e-b37d0f295c78",
                                                "text": "Lusaka ist die Hauptstadt von Sambia."
                                            },
                                            {
                                                "example_id": "12795d59-8d52-435b-b9a6-1d14dc858f98",
                                                "sense_id": "0708791e-abd7-3e07-bb4e-b37d0f295c78",
                                                "text": "„Als selbst Sambias Präsident Kaunda seinen Freund Nkomo aufforderte, nach Rhodesien zurückzukehren, blieb diesem nichts anderes übrig.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b0f1f647-3864-4ccb-8d3e-36685bbf4bfc",
                        "source_entry_id": "4a04586e-7013-30dc-a644-939deac5ce8e",
