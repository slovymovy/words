                                "target_senses": [
                                    {
                                        "sense_id": "763697b7-4272-3456-824b-a921b5d9fc92",
                                        "entry_id": "dd1032c2-75eb-34f6-b4c0-d74e109c3b48",
                                        "glosses": [
                                            "Strauch oder Obstbaum , dessen Blüten rötlich weiß blühen und dessen grünlich gelben bis hellgelben, sehr harten Früchte, — die in der äußeren Gestalt, je nach Sorte, mit Äpfeln oder Birnen vergleichbar sind —, ein charakteristisches Aroma besitzen"
                                        ],
                                        "tags": [
                                            "Cydonia oblonga"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee859d48-4715-4c30-ad3d-bf58d03b33db",
                                                "sense_id": "763697b7-4272-3456-824b-a921b5d9fc92",
                                                "text": "Die Quitten blühen."
                                            },
                                            {
                                                "example_id": "9aa910b2-a6ca-4d96-b03e-cd3c6499228a",
                                                "sense_id": "763697b7-4272-3456-824b-a921b5d9fc92",
                                                "text": "In Armenien und dem Iran, wo es heute noch die meisten Sorten gibt, wächst die Quitte wild."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "380564f7-70a0-34cf-9097-b16e3f3022f4",
                                        "entry_id": "dd1032c2-75eb-34f6-b4c0-d74e109c3b48",
                                        "glosses": [
                                            "Frucht von dem unter [1] beschriebenen Strauch oder Obstbaum"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fcfdafc8-bf90-4325-ad11-b2503bf2e649",
                                                "sense_id": "380564f7-70a0-34cf-9097-b16e3f3022f4",
                                                "text": "Geerntet werden Quitten meist im Oktober."
                                            },
                                            {
                                                "example_id": "1a5ecbdf-fe78-4487-8714-949619e51ab6",
                                                "sense_id": "380564f7-70a0-34cf-9097-b16e3f3022f4",
                                                "text": "Seit jeher gilt die Quitte als Symbol für Liebe, Glück, Fruchtbarkeit, Klugheit, Schönheit, Beständigkeit und Unvergänglichkeit."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
