                        "entry_id": "f97f8096-fc10-31fc-bc94-e18effc511c3",
                        "glosses": [
                            "Partisan de Pétain pendant l’occupation allemande de la France."
                        ],
                        "tags": [
                            "France"
                        ],
                        "examples": [
                            {
                                "example_id": "eee40433-5ff3-46a5-b490-d452521d4433",
                                "sense_id": "d2244465-297c-366b-8170-730b42add0e5",
                                "text": "[…] ; un boucher, fervent pétainiste et amateur de poésie mirlitonnesque, devait d'être là à un policier qui n'avait pas apprécié le distique\n« Vive le Maréchal !\nÇa c'est pas mal »\nque le bonhomme avait affiché en grosses majuscules sur la façade de sa boutique."
                            }
                        ]
                    },
                    {
                        "sense_id": "0e56dc19-fdd1-3b4b-b787-57691d6ea9c9",
                        "entry_id": "f97f8096-fc10-31fc-bc94-e18effc511c3",
                        "glosses": [
                            "Personne dont le comportement se caractérise par une soumission molle, une tentative de s’abandonner à l’opportunisme, à la peur, etc."
                        ],
                        "tags": [
                            "Subjectivement"
                        ],
                        "examples": [
                            {
                                "example_id": "9403cf9c-360c-45ee-8e71-a480fce04d49",
                                "sense_id": "0e56dc19-fdd1-3b4b-b787-57691d6ea9c9",
                                "text": "Tout courage est le courage de ne pas être pétainiste."
                            }
                        ]
                    }
