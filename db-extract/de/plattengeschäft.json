                ],
                "senses": [
                    {
                        "sense_id": "addbfe5d-3f94-3bf5-9952-54de7fc1e073",
                        "entry_id": "afafc678-7be2-3563-9150-bdae1229d3c1",
                        "glosses": [
                            "Laden, der Handel mit Schallplatten und dergleichen betreibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95bfeeea-9d60-4aff-9d19-ae298db9281f",
                                "sense_id": "addbfe5d-3f94-3bf5-9952-54de7fc1e073",
                                "text": "„Eines Tages erzählte sie mir begeistert von einem Plattengeschäft speziell für Rockmusik, mit einer Riesenauswahl an HeavyMetal-T-Shirts.“"
                            },
                            {
                                "example_id": "61f238d6-fd10-4efa-a3b7-35bb499805aa",
                                "sense_id": "addbfe5d-3f94-3bf5-9952-54de7fc1e073",
                                "text": "„Die Idee des eigenen Plattengeschäfts existiert schon lange, erzählen sie.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "9525b34e-b953-30da-ae85-277b57708868",
                        "entry_id": "afafc678-7be2-3563-9150-bdae1229d3c1",
                        "glosses": [
                            "Wirtschaftssektor, der sich mit der Herstellung von bespielten Tonträgern beschäftigt"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "79d0cdbd-c19e-4a16-963d-bd8caab39da8",
                                "sense_id": "9525b34e-b953-30da-ae85-277b57708868",
                                "text": "„Er wollte dort ganz groß ins Plattengeschäft einsteigen.“"
                            },
                            {
                                "example_id": "53b5a476-c168-4425-a4c4-836fdc39c9ad",
                                "sense_id": "9525b34e-b953-30da-ae85-277b57708868",
                                "text": "„Das Duo, bestehend aus Berry Gordy Jr. und seinem Partner Billy Davis, wollte unbedingt ins Plattengeschäft einsteigen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
