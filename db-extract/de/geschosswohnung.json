                        "glosses": [
                            "Wohnung, deren Räumlichkeiten sich in einem Geschoss befinden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "958eb6ed-10a7-4b99-8c9e-35e0eabbcb31",
                                "sense_id": "cb5f6f96-99ce-3526-8703-59dd3a41b636",
                                "text": "In Mietshäusern gibt es vorwiegend Geschosswohnungen."
                            },
                            {
                                "example_id": "48ad4003-df93-4266-a38d-d72d7ce37c1d",
                                "sense_id": "cb5f6f96-99ce-3526-8703-59dd3a41b636",
                                "text": "„Die vierte und kleinste Geschosswohnung ist die einzige, die nur eine Ebene aufweist.“"
                            },
                            {
                                "example_id": "76ab253e-bb7b-4ddf-ac5c-9cceef51b93b",
                                "sense_id": "cb5f6f96-99ce-3526-8703-59dd3a41b636",
                                "text": "„Durch den Bau einer Geschosswohnung könnten immerhin 2,3 Erwerbstätige ein Jahr lang beschäftigt werden.“"
                            }
                        ],
