                "senses": [
                    {
                        "sense_id": "d2f94fa6-29f8-3dde-9a8c-1bf0fdebeb03",
                        "entry_id": "44027d7d-3322-34dc-8857-8bcc89ef220a",
                        "glosses": [
                            "Lui ou elle."
                        ],
                        "tags": [
                            "familiar",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "d8ff770e-63dd-4dd0-87f6-5e352b45bedd",
                                "sense_id": "d2f94fa6-29f8-3dde-9a8c-1bf0fdebeb03",
                                "text": "Je m’appelle Pinette. Cézigue, c’est Delarue."
                            },
                            {
                                "example_id": "f8809df3-80af-41c6-a818-3da0b075f6a1",
                                "sense_id": "d2f94fa6-29f8-3dde-9a8c-1bf0fdebeb03",
                                "text": "Personnellement, je n’aurais pas commis des folies pour cézigue."
                            },
                            {
                                "example_id": "f83559cd-7446-46d0-94c7-aca026dd098e",
                                "sense_id": "d2f94fa6-29f8-3dde-9a8c-1bf0fdebeb03",
                                "text": "Dis donc, j’ai fait au gros, cézigue vient turbiner tous les jours ?"
                            },
                            {
                                "example_id": "200cb9b7-b6fe-4dc4-90ad-aa3c76e08120",
                                "sense_id": "d2f94fa6-29f8-3dde-9a8c-1bf0fdebeb03",
                                "text": "Pour tout dire, je le croyais mort, cézigue. J’aurais parié que même les asticots consécutifs à son trépas étaient décédés."
                            },
                            {
                                "example_id": "04441705-3b28-4e11-a753-a9d018ee019f",
                                "sense_id": "d2f94fa6-29f8-3dde-9a8c-1bf0fdebeb03",
                                "text": "— À Saint-Ouen, Badou, y nous en donne trois cents. Plus le larfeuille du gars. Parce qu'y doit avoir un larfeuille, césigue !"
                            }
                        ]
                    }
                ],
