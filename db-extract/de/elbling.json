                "senses": [
                    {
                        "sense_id": "9e02474c-bd45-3147-a1d3-e8f33b767510",
                        "entry_id": "6938b4ad-3c20-340e-ade2-3e2dec47d5d1",
                        "glosses": [
                            "weiße, sehr alte Rebsorte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c46427f-7df5-420b-8f7a-e1813e2cd904",
                                "sense_id": "9e02474c-bd45-3147-a1d3-e8f33b767510",
                                "text": "\"Der Elbling ergibt einen unkomplizierten trockenen und unverfälschten Weißwein, der sich auch hervorragend zur Sektherstellung eignet.\""
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "f8d0c26d-956c-36b0-8f7d-996dcccefa58",
                        "entry_id": "6938b4ad-3c20-340e-ade2-3e2dec47d5d1",
                        "glosses": [
                            "Wein, der aus Reben der Sorte Elbling hergestellt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1295ae22-5619-4601-acab-5eeab3f8ec5b",
                                "sense_id": "f8d0c26d-956c-36b0-8f7d-996dcccefa58",
                                "text": "\"Elbling, dessen Ursprünge auf den Weinbau der Römer in Germanien zurückgeführt werden, ist heute nur noch in wenigen Gegenden verbreitet. Speziell an der Ober-Mosel wird diese spät reifende Weiß-Weinrebe, die frische, fruchtig trockene Weine ergibt, noch gepflegt.\""
                            },
                            {
                                "example_id": "f8e8e05c-675c-4326-b092-ae7bf1bc0102",
                                "sense_id": "f8d0c26d-956c-36b0-8f7d-996dcccefa58",
                                "text": "\"Dieser Elbling präsentiert sich frisch und lebendig mit feinen Fruchtaromen, die an Zitrusfrüchte, Quitten und grüne Äpfel erinnern.\""
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
