                        "entry_id": "f7b742ef-2c0f-3606-8745-e10ab4a96f48",
                        "glosses": [
                            "anspruchsloses, ein- oder zweigeschossiges Gebäude, das nach einfachen Technologien aus Holz errichtet wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e61b5fd3-3e9c-4388-8ca8-4b7ca442bea0",
                                "sense_id": "2efc7cdf-2028-30e7-bd27-348958e0d61a",
                                "text": "„Rauchschwaden ziehen auf und tragen den bestialischen Gestank des brennendem Müllbergs ganz in der Nähe in die Holzbaracke, die eine Plane notdürftig bedeckt.“"
                            },
                            {
                                "example_id": "b023c24b-0fa0-435c-aa63-cc387f85192b",
                                "sense_id": "2efc7cdf-2028-30e7-bd27-348958e0d61a",
                                "text": "„Schlafen in einer Holzbaracke, sich waschen mit Brunnenwasser, in dem die Malaria-Larven schwimmen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
