                        "glosses": [
                            "Qui contient de la fécule."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d65d2507-f2b0-4bf7-aa76-abcffbfccc4f",
                                "sense_id": "2b4e6e41-5c7b-3448-a609-2ee287b53cef",
                                "text": "Après la décantation de la pulpe dans une casse d’eau bouillante, on récupérait une boue féculeuse que l’on asséchait dans le four à pain, encore chaud de la cuisson des miches."
                            },
                            {
                                "example_id": "cb455e93-883c-45d3-89a1-2cfd165d7e8b",
                                "sense_id": "2b4e6e41-5c7b-3448-a609-2ee287b53cef",
                                "text": "C’étaient les belles joyeusetés soudardes à propos de nos prouesses ou, dans des jours féculeux, carrément le concours de pets."
                            }
                        ]
                    }
