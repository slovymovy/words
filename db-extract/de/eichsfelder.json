                    {
                        "sense_id": "3827d068-da46-3014-919b-cb462600cc8c",
                        "entry_id": "76ac2b73-4fad-36a0-a014-0f5f9fb596ca",
                        "glosses": [
                            "aus dem Eichsfeld kommend, das Eichsfeld betreffend, zum Eichsfeld gehörend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd6d2f56-3154-44e8-886b-a4596ec00e71",
                                "sense_id": "3827d068-da46-3014-919b-cb462600cc8c",
                                "text": "„Überhaupt wird die Schönheit der Eichsfelder Landschaft erst bewußt, wenn man an einem schönen Sonntagmorgen hinausgeht und der Wind das Gras, das Blattwerk streicht, wenn über den Feldern die Lerchen jubilieren und hoch im Blau die Wolkenschäfchen treiben.“"
                            },
                            {
                                "example_id": "ee03c9ae-1564-43fd-95c7-f489d7afa958",
                                "sense_id": "3827d068-da46-3014-919b-cb462600cc8c",
                                "text": "„Ich möchte damit weniger die mickrigen 1.540 Quadratkilometer Eichsfelder Land ansprechen, die sich gegenüber dem fünfmal größeren Südtirol wie ein Zwergenstaat ausnehmen, als die Tatsache, dass sowohl das Eichsfeld wie auch Südtirol geologisch betrachtet auf sogenannten Hochplateaus liegen.“"
                            },
                            {
                                "example_id": "0c944bb7-9149-4083-b15a-de0d80049aa0",
                                "sense_id": "3827d068-da46-3014-919b-cb462600cc8c",
                                "text": "„Eine weitere Besonderheit der Eichsfelder Landschaft sind auch die zahlreichen Wallfahrtsorte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
