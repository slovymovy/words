                "senses": [
                    {
                        "sense_id": "fbcc55c6-6384-3269-8a5a-15c1b725bc3b",
                        "entry_id": "4195537c-454c-3386-a5e9-348489df9675",
                        "glosses": [
                            "Vieillir."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "883b8117-0bb5-42e2-9f0b-4174e77a90ae",
                                "sense_id": "fbcc55c6-6384-3269-8a5a-15c1b725bc3b",
                                "text": "Et sache qu’en leurs cœurs avieillis, les survivants de la tragique épopée te réserveront une place de choix."
                            },
                            {
                                "example_id": "8477a42e-fbe6-40eb-8582-d1a77db7d3c6",
                                "sense_id": "fbcc55c6-6384-3269-8a5a-15c1b725bc3b",
                                "text": "D’ailleurs, loin d’avoir cette politique rédemptrice qui va chercher la force là où Dieu l’a mise, ces grandes petites gens haïssaient toute force qui ne venait pas d’eux ; enfin, loin de se rajeunir, le faubourg Saint-Germain s’est avieilli."
                            }
                        ]
                    }
                ],
