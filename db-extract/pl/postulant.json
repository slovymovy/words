                                "target_senses": [
                                    {
                                        "sense_id": "32c47ed2-e392-34e9-9a0c-39bd4ad53dcd",
                                        "entry_id": "f1782993-e7df-3e7b-81ac-fbb0955a3a86",
                                        "glosses": [
                                            "A person seeking admission to a religious order."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d009d160-a0f2-4335-8c72-3a9459300b95",
                                                "sense_id": "32c47ed2-e392-34e9-9a0c-39bd4ad53dcd",
                                                "text": "After their six-month postulancies are over and they have mastered all the chants and books of monastic regulations, the postulants are finally ready to ordain as novice monks […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "93346cef-23a3-35b8-a4b8-2f880cf47d2c",
                                        "entry_id": "f1782993-e7df-3e7b-81ac-fbb0955a3a86",
                                        "glosses": [
                                            "A person who submits a petition for something; a petitioner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00888466-e9e8-42b5-962f-8683446973fd",
                                                "sense_id": "93346cef-23a3-35b8-a4b8-2f880cf47d2c",
                                                "text": "But when the three postulants returned with Sabine it was clear that the results had been far from satisfactory, perhaps because of the massive potations of the old lady."
                                            }
                                        ]
                                    }
                                ]
