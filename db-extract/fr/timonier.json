        "fr-extract.jsonl": [
            {
                "entry_id": "1617f5c4-f71e-321a-9c8e-34e699c46d42",
                "word": "timonier",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "b13a31d8-ba91-438c-b39f-a027151a67ad",
                        "entry_id": "1617f5c4-f71e-321a-9c8e-34e699c46d42",
                        "tags": [
                            "plural"
                        ],
                        "form": "timoniers"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a9de0d91-de84-3428-b81e-e4202a52e549",
                        "entry_id": "1617f5c4-f71e-321a-9c8e-34e699c46d42",
                        "glosses": [
                            "Chacun des chevaux attelés de chaque côté du timon."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "5cef9cfb-82b8-41e0-a9ca-5c6ae4aa8d50",
                                "sense_id": "a9de0d91-de84-3428-b81e-e4202a52e549",
                                "text": "Sans se faire prier, le père Minaï, colosse à barbe d’ébène, ventripotent comme un samovar monstre où bout le sbitène de tout un marché transi de froid, grimpa sur le timonier qui faillit crouler sous son poids."
                            },
                            {
                                "example_id": "6e863c08-c395-454c-8349-12139efff1f2",
                                "sense_id": "a9de0d91-de84-3428-b81e-e4202a52e549",
                                "text": "Elles éclairaient d'une lueur vive un nuage de buée au-dessus de la croupe en sueur des timoniers, et, des deux côtés de la route, la neige qui semblait se dérouler sous le reflet mobile des lumières."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "4966b836-8ab5-3dd7-87c7-749de4ddcb2c",
                "word": "timonier",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "907a6add-a64f-4261-b580-68857f947a12",
                        "entry_id": "4966b836-8ab5-3dd7-87c7-749de4ddcb2c",
                        "tags": [
                            "plural"
                        ],
                        "form": "timoniers"
                    },
                    {
                        "form_id": "dd6cb682-5707-4755-bf13-afbc6f037c43",
                        "entry_id": "4966b836-8ab5-3dd7-87c7-749de4ddcb2c",
                        "tags": [
                            "feminine"
                        ],
                        "form": "timonière"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ffda8e53-3f72-3090-b339-74e3b8c29948",
                        "entry_id": "4966b836-8ab5-3dd7-87c7-749de4ddcb2c",
                        "glosses": [
                            "Homme qui se trouve à la barre ou à tout autre appareil agissant sur le gouvernail."
                        ],
                        "tags": [
                            "Navigation"
                        ],
                        "examples": [
                            {
                                "example_id": "fcb8a99d-a5fa-4153-acbf-db737de0b24e",
                                "sense_id": "ffda8e53-3f72-3090-b339-74e3b8c29948",
                                "text": "Parfois, il s'enfonçait subitement, se relevait, et Mademoiselle lançait au timonier ce regard dont on punit le chauffeur, en auto, qui n'a pas prévu un dos d'âne."
                            },
                            {
                                "example_id": "cc13fdd8-062a-4045-b201-37a567f9c2e2",
                                "sense_id": "ffda8e53-3f72-3090-b339-74e3b8c29948",
                                "text": "D’un seul bond, il sauta sur le timonier, […] ; puis il saisit la barre, et tâcha de remédier au désordre épouvantable qui révolutionnait son brave et courageux navire."
                            }
                        ]
                    },
                    {
                        "sense_id": "20e2e436-3beb-3418-97d6-3d815e2e15df",
                        "entry_id": "4966b836-8ab5-3dd7-87c7-749de4ddcb2c",
                        "glosses": [
                            "Matelot (ou patron) qui tient le gouvernail d’une embarcation et commande les canotiers."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "eea3e477-b5f2-4a8e-ba82-9ef2ae6f8f11",
                        "source_entry_id": "4966b836-8ab5-3dd7-87c7-749de4ddcb2c",
                        "target_lang_word": "Steuermann",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Steuermann",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ce9acb94-4d2b-368b-b3fa-f7b261eece95",
                                        "entry_id": "3072f12b-fdef-35d3-a662-e1b7a9131074",
                                        "glosses": [
                                            "Nautik, Wassersport: (zum Beispiel im Rudern) derjenige, der das Boot steuert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03a32ff6-523b-4f93-a428-52ff1aefb82b",
                                                "sense_id": "ce9acb94-4d2b-368b-b3fa-f7b261eece95",
                                                "text": "Der Steuermann erhält die Goldmedaille."
                                            },
                                            {
                                                "example_id": "21ed49d5-3243-4d3c-a2c3-58204d61631e",
                                                "sense_id": "ce9acb94-4d2b-368b-b3fa-f7b261eece95",
                                                "text": "„Bald kennen die Steuermänner die Strömungen und Gefahren auf der Fahrt zwischen Nordeuropa und Island besser, ist die Route weniger risikoreich als zuvor.“"
                                            },
                                            {
                                                "example_id": "4b6b6714-4b45-4ce9-8be7-6ae3472fa7b2",
                                                "sense_id": "ce9acb94-4d2b-368b-b3fa-f7b261eece95",
                                                "text": "„Der Steuermann trug eine braunweiß gestreifte Strickmütze, die am Hinterkopf hochgeschlagen war.“"
                                            },
                                            {
                                                "example_id": "dbe1285b-7c08-4eae-95c6-4a59791664cc",
                                                "sense_id": "ce9acb94-4d2b-368b-b3fa-f7b261eece95",
                                                "text": "„Bis in die 80er Jahre wurde zu jeder Fahrt auf dieser Strecke ein ortskundiger Rheinlotse als Steuermann hinzugezogen.“"
                                            },
                                            {
                                                "example_id": "e6d89a0c-d47f-463b-8076-2f5b7bcb5d25",
                                                "sense_id": "ce9acb94-4d2b-368b-b3fa-f7b261eece95",
                                                "text": "„Der Steuermann war allein an Bord, und ich nahm meinen Mut zusammen und fragte ihn, ob er nicht einen Schiffsjungen brauche.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
