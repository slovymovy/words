{
    "word_family": [
        "rich",
        "enrich",
        "enrichment"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "22933396-0cb3-3d62-bce3-c245557c60cc",
                    "sense_definition": "The state of having many examples or cases; abundance; profusion.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "abundance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>richness</w> of the local culture is evident in the variety of traditional festivals.",
                            "target_lang_translations": {
                                "ru": "<w>Бога́тство</w> местной культуры проявляется в разнообразии традиционных фестивалей."
                            }
                        },
                        {
                            "text": "The <w>richness</w> of vocabulary in her writing makes her stories very engaging.",
                            "target_lang_translations": {
                                "ru": "<w>Бога́тство</w> словарного запаса в её произведениях делает её рассказы очень увлекательными."
                            }
                        }
                    ],
                    "synonyms": [
                        "abundance",
                        "profusion",
                        "variety"
                    ],
                    "antonyms": [
                        "scarcity",
                        "poverty"
                    ],
                    "common_phrases": [
                        "lexical richness",
                        "cultural richness"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние, при котором чего-либо много; изобилие, разнообразие."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бога́тство",
                                "target_lang_sense_clarification": "обилие и разнообразие чего-либо"
                            },
                            {
                                "target_lang_word": "изоби́лие",
                                "target_lang_sense_clarification": "большое количество чего-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "35ed729a-c5b4-36ae-83b7-a5cbe715a398",
                    "sense_definition": "The state or quality of being wealthy.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "wealth",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He inherited a great <w>richness</w> from his family but chose to live a simple life.",
                            "target_lang_translations": {
                                "ru": "Он унаследовал огромное <w>бога́тство</w> от своей семьи, но решил жить простой жизнью."
                            }
                        },
                        {
                            "text": "The <w>richness</w> of the merchant class changed the political landscape of the city.",
                            "target_lang_translations": {
                                "ru": "<w>Бога́тство</w> купеческого сословия изменило политический ландшафт города."
                            }
                        }
                    ],
                    "synonyms": [
                        "wealth",
                        "affluence"
                    ],
                    "antonyms": [
                        "poverty"
                    ],
                    "common_phrases": [
                        "material richness"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние или качество обладания большими материальными ценностями; зажиточность."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бога́тство",
                                "target_lang_sense_clarification": "обладание значительными ценностями"
                            },
                            {
                                "target_lang_word": "состоя́тельность",
                                "target_lang_sense_clarification": "высокий уровень материального благосостояния"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "69347ad2-e4d4-3a33-a77b-a123fe6a0895",
                    "sense_definition": "The number of different species or types present in a specific community or environment.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "abundance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>richness</w> of the coral reef ecosystem is threatened by rising ocean temperatures.",
                            "target_lang_translations": {
                                "ru": "<w>Разнообра́зие</w> экосистемы коралловых рифов находится под угрозой из-за повышения температуры океана."
                            }
                        },
                        {
                            "text": "Scientists measured the species <w>richness</w> to assess the health of the forest.",
                            "target_lang_translations": {
                                "ru": "Учёные измерили видовое <w>разнообра́зие</w>, чтобы оценить состояние здоровья леса."
                            }
                        }
                    ],
                    "synonyms": [
                        "diversity"
                    ],
                    "common_phrases": [
                        "species richness"
                    ],
                    "target_lang_definitions": {
                        "ru": "Количество различных видов или типов, присутствующих в определенном сообществе или среде."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разнообра́зие",
                                "target_lang_sense_clarification": "наличие многих различных видов"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "be87a351-0fdb-3d4c-8711-e3383e9b0389",
                    "sense_definition": "The quality of being full, deep, or intense in flavor, color, or sound.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>richness</w> of the chocolate cake was balanced by the tartness of the raspberries.",
                            "target_lang_translations": {
                                "ru": "<w>Насы́щенность</w> шоколадного торта была сбалансирована кислинкой малины."
                            }
                        },
                        {
                            "text": "She admired the <w>richness</w> of the colors in the oil painting.",
                            "target_lang_translations": {
                                "ru": "Она восхищалась <w>насы́щенностью</w> цветов на картине, написанной маслом."
                            }
                        }
                    ],
                    "synonyms": [
                        "intensity",
                        "depth"
                    ],
                    "common_phrases": [
                        "flavor richness"
                    ],
                    "target_lang_definitions": {
                        "ru": "Качество полноты, глубины или интенсивности вкуса, цвета или звука."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "насы́щенность",
                                "target_lang_sense_clarification": "интенсивность цвета или вкуса"
                            },
                            {
                                "target_lang_word": "глубина́",
                                "target_lang_sense_clarification": "интенсивность и выразительность"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}