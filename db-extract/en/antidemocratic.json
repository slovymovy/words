                    {
                        "translation_id": "0b917a99-d955-43bb-917b-6fabaf92dbe0",
                        "source_entry_id": "d64444da-6d11-314c-872e-855e6b9425d0",
                        "source_sense_id": "fc68df52-14e5-394d-bb5d-dff82e784fad",
