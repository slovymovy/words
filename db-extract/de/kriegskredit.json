                "senses": [
                    {
                        "sense_id": "df3e665b-e51d-3efd-a4ea-a919fe7a0653",
                        "entry_id": "19247a15-2281-3525-bbcf-48f6d7e5b56c",
                        "glosses": [
                            "Kredit zur Finanzierung von Kriegskosten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "602fb9d5-cb30-4456-b188-9968c282ff3b",
                                "sense_id": "df3e665b-e51d-3efd-a4ea-a919fe7a0653",
                                "text": "„Ebenso wichtig war, für die anstehenden Entscheidungen eine Mehrheit im Reichstag zu organisieren, vor allem für die Bewilligung von Kriegskrediten.“"
                            },
                            {
                                "example_id": "dfe0b6c4-d119-413f-b614-9f090b034978",
                                "sense_id": "df3e665b-e51d-3efd-a4ea-a919fe7a0653",
                                "text": "„Als erster sozialdemokratischer Reichstagsabgeordneter stimmte am 2. Dezember 1914 Karl Liebknecht gegen die Kriegskredite. Am 24. März 1916 lehnten weitere 18 Abgeordnete die Kriegskredite ab und wurden daraufhin aus der SPD ausgeschlossen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
