                "senses": [
                    {
                        "sense_id": "5bbf1d5c-a50d-336b-9e51-79b0494e941f",
                        "entry_id": "1f456902-04d5-3be4-a0e6-260b1c92e69e",
                        "glosses": [
                            "złożenie liter i cyfr albo wyraz, który ukrywa nazwę czegoś lub czyjeś nazwisko"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f96817de-0bb4-4629-8bf2-287cb54d90a5",
                                "sense_id": "5bbf1d5c-a50d-336b-9e51-79b0494e941f",
                                "text": "Operacja pod kryptonimem „Neutron” miała na celu infiltrację środowisk faszystowskich w Czechach i zaostrzenie nastrojów antycygańskich w tym kraju"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e6b495f5-361f-458d-99a6-6d7478cf238d",
                        "source_entry_id": "1f456902-04d5-3be4-a0e6-260b1c92e69e",
                        "source_sense_id": "5bbf1d5c-a50d-336b-9e51-79b0494e941f",
