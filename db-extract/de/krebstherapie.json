                ],
                "senses": [
                    {
                        "sense_id": "9d870c27-1fde-35e7-a66c-89e846bc8687",
                        "entry_id": "f5d52ea4-b1c4-3cc6-badd-094dcc86eb55",
                        "glosses": [
                            "therapeutische Maßnahme, zur Behandlung einer Krebserkrankung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ccbfd518-1ee3-43f1-aedb-8355ae3d822d",
                                "sense_id": "9d870c27-1fde-35e7-a66c-89e846bc8687",
                                "text": "„Das Auftreten von schweren Nebenwirkungen sowie Resistenzentwicklung gehören zu den größten Problemen der modernen Krebstherapie.“"
                            },
                            {
                                "example_id": "18c8e0a3-12a1-483e-9ee4-1723467b9df1",
                                "sense_id": "9d870c27-1fde-35e7-a66c-89e846bc8687",
                                "text": "„Die Kombination aus einer verbesserten Krebstherapie und vorbeugenden Maßnahmen sowie weiter entwickelten diagnostischen Möglichkeiten haben dazu geführt, dass Betroffene trotz der Diagnose Krebs oft zuversichtlich in die Zukunft blicken können.“"
                            },
                            {
                                "example_id": "f58b0ad0-0f23-41a6-8b72-204b56c88014",
                                "sense_id": "9d870c27-1fde-35e7-a66c-89e846bc8687",
                                "text": "[Trotz des Coronarisikos] „rät die DGHO Krebspatienten davon ab, eine geplante Krebstherapie zu verschieben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
