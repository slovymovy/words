                                    {
                                        "sense_id": "011d016d-61f1-3a0d-9fe5-4741a2bfbb5c",
                                        "entry_id": "cf2c03dc-e6a1-3827-af6a-6f0aa98d4cee",
                                        "glosses": [
                                            "Vertreter einer Gattung fleischfressender Dinosaurier aus dem späten Jura"
                                        ],
                                        "tags": [
                                            "Paläontologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3e9bc79b-4480-4361-a438-1819a3c99176",
                                                "sense_id": "011d016d-61f1-3a0d-9fe5-4741a2bfbb5c",
                                                "text": "„Allosaurus war ein typischer großer Theropode, mit einem massiven Schädel auf einem kurzen Hals, einem langen Schwanz und reduzierten Vorderbeinen.“"
                                            },
                                            {
                                                "example_id": "a9832ed6-7ba9-4324-b969-d37731df2a29",
                                                "sense_id": "011d016d-61f1-3a0d-9fe5-4741a2bfbb5c",
                                                "text": "„Über die Hälfte der Körperlänge der Allosaurier entfiel auf den Schwanz. Es wird aufgrund einiger fossiler Funde angenommen, das einige Allosaurierarten im Rudel jagten.“"
                                            },
                                            {
                                                "example_id": "1538ca43-7657-4571-bedf-aff6708f9b92",
                                                "sense_id": "011d016d-61f1-3a0d-9fe5-4741a2bfbb5c",
                                                "text": "„Das besterhaltene Allosaurus-Skelett der Welt hat eine neue Heimat im Knuthenborg Safaripark: In der savannenartigen Parkanlage auf der dänischen Insel Lolland wird der Sensationsfund aus der Jura-Zeit Star einer neuen Dinosaurier-Dauerausstellung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
