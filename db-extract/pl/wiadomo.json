                                        "entry_id": "8ea7e7eb-d06c-384a-9e8f-7a51e00ec30d",
                                        "glosses": [
                                            "gedachte Person, die nach eigenem Ermessen richtig handelt (meist bezogen auf gesellschaftliche Umgangsformen)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "262f5829-71ea-4c51-b2c7-bfb5b74ac723",
                                                "sense_id": "0382b511-1050-3624-87d5-7aa3c89bc7d7",
                                                "text": "Markus, man wäscht sich vor dem Essen die Hände!"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "cc138601-8469-3162-9065-b528a5a2f951",
                                        "entry_id": "8ea7e7eb-d06c-384a-9e8f-7a51e00ec30d",
                                        "glosses": [
                                            "irgendjemand, irgendetwas (im Sinne einer bestimmten Person, zum Beispiel des Sprechers selbst, eines Unbekannten oder einer Personengruppe)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8132b474-f35c-4e01-8a42-009c830f638c",
                                                "sense_id": "cc138601-8469-3162-9065-b528a5a2f951",
                                                "text": "Man kann davon ausgehen, dass diese Äpfel frisch sind."
                                            },
                                            {
                                                "example_id": "6324976e-dd5e-4f22-968b-9522f376a56f",
                                                "sense_id": "cc138601-8469-3162-9065-b528a5a2f951",
                                                "text": "„Wenn man derzeit von Forderungen liest, auch den Fachhochschulen das Promotionsrecht einzuräumen, kann man sich die Ergebnisse vorstellen.“"
                                            },
                                            {
                                                "example_id": "d4085e62-9605-4970-94e8-8704348aab14",
                                                "sense_id": "cc138601-8469-3162-9065-b528a5a2f951",
                                                "text": "„Man kann beispielsweise Pflanzen mittels Gentechnik so manipulieren, dass sie gegen bestimmte Krankheiten immun oder unempfindlich gegen sonst giftige chemische Pflanzenschutzmittel werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "eccb9971-3a4b-36b8-9897-a7809ac7711c",
                                        "entry_id": "8ea7e7eb-d06c-384a-9e8f-7a51e00ec30d",
                                        "glosses": [
                                            "jemand, einer/eine (im Sinne von jemandem, der auch für eine beliebige Person stehen kann)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "753211e8-5a48-4982-8eff-bb5334324b6c",
                                                "sense_id": "eccb9971-3a4b-36b8-9897-a7809ac7711c",
                                                "text": "Als sie ins Krankenhaus eingeliefert wurde, wusste sie noch nicht, dass man dort gewöhnlich keine Handys verwenden durfte."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "c0b4374d-4a3b-32fc-915b-4092f2046d9c",
                                        "entry_id": "8ea7e7eb-d06c-384a-9e8f-7a51e00ec30d",
                                        "glosses": [
                                            "statt eines Personalpronomens der zweiten oder dritten Person (du, Sie, er/sie, ihr, sie), um ein Distanzverhältnis in der Gesprächssituation anzudeuten"
                                        ],
                                        "tags": [
                                            "oft ironisch"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1451904d-4c75-4dab-8223-0bdb56ff3f47",
                                                "sense_id": "c0b4374d-4a3b-32fc-915b-4092f2046d9c",
                                                "text": "Ach, war man heute wieder einmal krank?"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "fae1e846-254f-33ed-adf6-9092830e5a86",
                                        "entry_id": "8ea7e7eb-d06c-384a-9e8f-7a51e00ec30d",
                                        "glosses": [
                                            "ich, wir (die eigene Aussage oder Handlung auf die Allgemeinheit übertragend)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8bda90dd-f977-42a0-b309-274eb4423033",
                                                "sense_id": "fae1e846-254f-33ed-adf6-9092830e5a86",
                                                "text": "Man könnte meinen, dass es an der Tür geklingelt hat."
                                            },
                                            {
                                                "example_id": "5f8855ac-fca6-40ee-8b49-d45f37029d55",
                                                "sense_id": "fae1e846-254f-33ed-adf6-9092830e5a86",
                                                "text": "Gestern auf der Party war es wirklich laut: Man konnte sich gar nicht mehr mit anderen unterhalten."
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    }
                                ]
                            }
                        ]
