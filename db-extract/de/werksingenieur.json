                ],
                "senses": [
                    {
                        "sense_id": "bb386b09-b727-38d8-b971-439d3bb141d0",
                        "entry_id": "5305a8b6-b4e2-3e43-8837-87cc1831a6b0",
                        "glosses": [
                            "intern spezialisierter Ingenieur in Fach- und Sachgebieten des Ingenieurwesens"
                        ],
                        "tags": [
                            "hauptsächlich in der Vergangenheit verwendeter Titel einer Position in der Produktion eines Unternehmens"
                        ],
                        "examples": [
                            {
                                "example_id": "5fb2e8b4-23d8-4c8c-af87-92246cc49bff",
                                "sense_id": "bb386b09-b727-38d8-b971-439d3bb141d0",
                                "text": "„Bei dieser den Außenseitern aus den Notwendigkeiten der wirtschaftlichen Praxis zu gewährenden Chance mußte allerdings verhindert werden, daß gegenüber den Absolventen der genannten Lehranstalten eine minderqualifizierte Gruppe von Ingenieuren dadurch entstand, daß, den Unternehmungen oder Betrieben das Recht eingeräumt wurde, über Arbeits- oder Anstellungsverträge Bezeichnungen wie z. B. „Werksingenieur\" oder „Betriebsingenieur\" zu Berufsbezeichnungen zu machen.“"
                            },
                            {
                                "example_id": "cf91fb02-e7f1-420a-b6ff-f4c0d65c76e4",
                                "sense_id": "bb386b09-b727-38d8-b971-439d3bb141d0",
                                "text": "„Der Werksingenieur Frederick Winslow Taylor (1856–1915) wollte der um die Jahrhundertwende in der Fertigung herrschenden autoritären „Meisterwirtschaft“ mit ihrer großen Willkür und den systemlosen Improvisationen ein Ende bereiten.“"
                            },
                            {
                                "example_id": "c47b649a-6925-4779-bb98-b32fd9909d0d",
                                "sense_id": "bb386b09-b727-38d8-b971-439d3bb141d0",
                                "text": "„Der neue Werksingenieur wurde am 1. Dezember 1951 in Bochum geboren.“"
                            },
                            {
                                "example_id": "4b630260-5216-4dcc-a35e-d9a8731f22d3",
                                "sense_id": "bb386b09-b727-38d8-b971-439d3bb141d0",
                                "text": "„So, wie früher die Arbeiter, die zum Werksingenieur oder zum Leiter von irgendetwas aufstiegen, plötzlich ihr Besteck auf dem Teller kreuzten und allerlei Attitüden annahmen, mit denen sie ständig zeigten, jetzt zu einer höheren Gesellschaftsschicht zu gehören.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
