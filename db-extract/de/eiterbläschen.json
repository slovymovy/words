                    {
                        "translation_id": "3da724ef-51c3-47aa-a8e7-0a030afe707e",
                        "source_entry_id": "bbf160bd-9bef-3517-b952-b6e9db32f49d",
                        "source_sense_id": "71b691dd-8d05-31c0-800f-953fc761ef26",
                        "source_sense_description": "mit Eiter gefüllter kleiner Hohlraum der Haut",
                        "target_lang_word": "pustule",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pustule",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "192c9890-a3e5-342c-82ec-4c94b7e78d3a",
                                        "entry_id": "fecc2301-b67f-3999-b4fd-ee56b7a0329c",
                                        "glosses": [
                                            "Petite tumeur inflammatoire qui s’élève sur la peau et qui se termine par une suppuration."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52a27a52-a7af-4a61-8d0b-2ce9fc61d734",
                                                "sense_id": "192c9890-a3e5-342c-82ec-4c94b7e78d3a",
                                                "text": "Toutefois dans la pustule de la vaccine, l’activité du virus dépend de l’âge de la lésion ; la lymphe perd de sa virulence passé le septième jour."
                                            },
                                            {
                                                "example_id": "21e71cab-1531-48af-9ae0-caeb7b8cf5ad",
                                                "sense_id": "192c9890-a3e5-342c-82ec-4c94b7e78d3a",
                                                "text": "L’espèce de linceul qui le recouvrait était tombé jusqu’à ses hanches ; et ses épaules, sa poitrine, ses bras maigres disparaissaient sous des plaques de pustules écailleuses."
                                            },
                                            {
                                                "example_id": "971fc44e-6cc6-48c3-88fa-a2d2bf708848",
                                                "sense_id": "192c9890-a3e5-342c-82ec-4c94b7e78d3a",
                                                "text": "Après quelques jours encore, se fera toute une éruption de petites cloques semblables à la première. Ces cloques formeront des pustules sur tout le visage."
                                            },
                                            {
                                                "example_id": "5817094f-d3ca-46e0-b6d4-6cce0309f1a7",
                                                "sense_id": "192c9890-a3e5-342c-82ec-4c94b7e78d3a",
                                                "text": "Lorsqu'un boucher acheteur langueyait lui-même le porc, il lui était loisible de profiter de la présence des pustules de ladrerie pour obtenir une réduction sur le prix d'achat ; puis, l'animal abattu et débité, il raclait soigneusement au couteau la langue, la chair du cou et des épaules, la face interne des cuisses, toutes les parties, enfin, où la présence du cysticerque pouvait être le plus facilement constatée à l'extérieur du morceau vendu."
                                            },
                                            {
                                                "example_id": "ed950b0e-c02d-47bf-9674-743d21d0a245",
                                                "sense_id": "192c9890-a3e5-342c-82ec-4c94b7e78d3a",
                                                "text": "— Le carter s'était encore rompu sous les assauts de chocs impitoyables, et l’huile pissait de plus belle, marquant le sable de pustules noirâtres."
                                            }
                                        ]
                                    }
                                ]
