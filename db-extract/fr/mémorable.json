                                                "example_id": "a360debf-c282-4812-adfb-74cd5e973014",
                                                "sense_id": "25c107fd-442d-3068-84c3-f7775951eb7b",
                                                "text": "Het verjaardagsfeest was een onvergetelijke ervaring voor de jarige."
                                            },
