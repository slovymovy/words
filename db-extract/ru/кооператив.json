                        "form": "кооперати́вах"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b0d211e3-83e6-30cd-a26f-5de1d8503ec3",
                        "entry_id": "a8551caa-6ae0-3b00-b33d-6b187b5d2153",
                        "glosses": [
                            "юридически оформленное объединение людей, созданное для достижения общей цели"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e71a8dd-dc2e-47e1-894c-105797594d27",
                                "sense_id": "b0d211e3-83e6-30cd-a26f-5de1d8503ec3",
                                "text": "Метрах в пятидесяти от того места, где я обычно стою, имеется гаражный кооператив."
                            },
                            {
                                "example_id": "f8501cab-bdc8-4e9d-884b-cb21671b802a",
                                "sense_id": "b0d211e3-83e6-30cd-a26f-5de1d8503ec3",
                                "text": "Она вступила в переводческий кооператив, и вот им привалил заказ: перевод недублированных фестивальных фильмов."
                            }
                        ]
                    },
                    {
                        "sense_id": "dce38a44-dbea-3206-929c-5006bae43938",
                        "entry_id": "a8551caa-6ae0-3b00-b33d-6b187b5d2153",
                        "glosses": [
                            "то же, что кооперативная квартира"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fefa424a-588c-445a-b9dc-42dd94175d12",
                                "sense_id": "dce38a44-dbea-3206-929c-5006bae43938",
                                "text": "Сына, дочку воспитала, живут хорошо, у обоих кооператив."
                            },
                            {
                                "example_id": "57d70639-f27e-4cc2-a6bb-a75980c0fedb",
                                "sense_id": "dce38a44-dbea-3206-929c-5006bae43938",
                                "text": "Институт так и не окончил, но трехкомнатный кооператив заработал."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c5a5e3f2-743b-4707-a265-f581614531da",
                        "source_entry_id": "a8551caa-6ae0-3b00-b33d-6b187b5d2153",
                        "target_lang_word": "spółdzielnia",
