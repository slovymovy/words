                "forms": [],
                "senses": [
                    {
                        "sense_id": "0ab5ec37-3bc0-3267-b643-034361231cae",
                        "entry_id": "bde58163-0a7a-3d53-8579-ecada8d77719",
                        "glosses": [
                            "met geklopt ei bestrijken en daarna bestrooien met paneermeel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "56aba838-d4cf-4cae-9ea4-970f413f0a7e",
                                "sense_id": "0ab5ec37-3bc0-3267-b643-034361231cae",
                                "text": "Paneer de feta met panko en bak in de pan tot de feta een bruin korstje heeft."
                            },
                            {
                                "example_id": "4fa8b1db-718b-437e-97ec-6345c602d199",
                                "sense_id": "0ab5ec37-3bc0-3267-b643-034361231cae",
                                "text": "Een ietwat pittige kroket met Spaanse invloeden. Zo is de snack van de jonge bedenker het beste te omschrijven. Niet alleen gebruikte hij de van oorsprong Spaanse vleessoorten, ook deed hij iets speciaals bij het paneren. ,,Normale kroketten zijn óf rood óf geel gepaneerd, maar deze heeft beide kleuren. Een knipoog naar de Spaanse vlag.’’"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9c5ad7bf-5270-4546-ae0b-ea08119f2b44",
                        "source_entry_id": "bde58163-0a7a-3d53-8579-ecada8d77719",
                        "source_sense_id": "0ab5ec37-3bc0-3267-b643-034361231cae",
                        "source_sense_description": "met geklopt ei bestrijken en daarna bestrooien met paneermeel",
                        "target_lang_word": "bread",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bread",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c4478734-2ed7-372a-802c-307a87f6f4d5",
                                        "entry_id": "54ff0d8b-7a5d-3061-af2e-7e3821e40072",
                                        "glosses": [
                                            "A foodstuff made by baking dough made from cereals."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "edfed2d2-22b7-3b6f-95fc-854cf15c7987",
                                        "entry_id": "54ff0d8b-7a5d-3061-af2e-7e3821e40072",
                                        "glosses": [
                                            "A foodstuff made by baking dough made from cereals.",
                                            "Such foodstuff that is not difficult to chew, being not extremely hard, dense, and dry."
                                        ],
                                        "tags": [
                                            "countable",
                                            "especially",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ec954742-4349-4704-baa0-df58b36c81cb",
                                                "sense_id": "edfed2d2-22b7-3b6f-95fc-854cf15c7987",
                                                "text": "We made sandwiches with the bread we bought from the bakery."
                                            },
                                            {
                                                "example_id": "1570b87b-e95e-48e6-8f0e-a47505f7f41c",
                                                "sense_id": "edfed2d2-22b7-3b6f-95fc-854cf15c7987",
                                                "text": "My mother used to send me for the bread."
                                            },
                                            {
                                                "example_id": "982ab369-e6fb-4970-9a9f-52d24859ba62",
                                                "sense_id": "edfed2d2-22b7-3b6f-95fc-854cf15c7987",
                                                "text": "Philander went into the next room[…]and came back with a salt mackerel that dripped brine like a rainstorm. Then he put the coffee pot on the stove and rummaged out a loaf of dry bread and some hardtack."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2ab58170-116e-39e7-b401-231fb066fcbf",
                                        "entry_id": "54ff0d8b-7a5d-3061-af2e-7e3821e40072",
                                        "glosses": [
                                            "Food; sustenance; support of life, in general."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c9e58fd8-35da-4ea2-b972-554adace5727",
                                                "sense_id": "2ab58170-116e-39e7-b401-231fb066fcbf",
                                                "text": "Give us this day our daily bread."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fab237f7-6b01-3b7a-9daf-33721bf7fd91",
                                        "entry_id": "54ff0d8b-7a5d-3061-af2e-7e3821e40072",
                                        "glosses": [
                                            "Any variety of bread."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "85e83cca-6728-4378-9f01-e5f7f37d6e18",
                                                "sense_id": "fab237f7-6b01-3b7a-9daf-33721bf7fd91",
                                                "text": "Some breads are harder and drier than others."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9434976d-e538-30a4-8238-78973d641214",
                                        "entry_id": "54ff0d8b-7a5d-3061-af2e-7e3821e40072",
                                        "glosses": [
                                            "Money."
                                        ],
                                        "tags": [
                                            "Cockney",
                                            "US",
                                            "countable",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "57c06597-2094-4326-885a-18810b7c370c",
                                                "sense_id": "9434976d-e538-30a4-8238-78973d641214",
                                                "text": "[…] save up all your bread, and fly Trans-Love Airways to San Francisco, USA."
                                            },
                                            {
                                                "example_id": "3fbed31b-2a92-45ea-ad7d-4a1e713611ec",
                                                "sense_id": "9434976d-e538-30a4-8238-78973d641214",
                                                "text": "Maybe somebody would see him and recognize him, maybe one of the guys would lay enough bread on him for a meal or at least subway fare."
                                            },
                                            {
                                                "example_id": "45b683a8-5599-49c4-a135-d62fd8442c5b",
                                                "sense_id": "9434976d-e538-30a4-8238-78973d641214",
                                                "text": "And they sit at the bar and put bread in my jar / And say, \"Man, what are you doing here?\""
                                            },
                                            {
                                                "example_id": "fdf5f8f3-5996-479f-b5d3-4138d2dd1cec",
                                                "sense_id": "9434976d-e538-30a4-8238-78973d641214",
                                                "text": "Hey, baby, I don't care if the motherfucker's growing hair just so long as we get our bread."
                                            },
                                            {
                                                "example_id": "503ab2b1-09ad-4a68-b955-c151e6c41a7d",
                                                "sense_id": "9434976d-e538-30a4-8238-78973d641214",
                                                "text": "Tastes like fruit when you hit it; got to have bread to get it."
                                            }
                                        ]
                                    }
                                ]
                            },
