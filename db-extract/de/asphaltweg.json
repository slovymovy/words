                        "examples": [
                            {
                                "example_id": "42ab2bb7-0c07-4311-b2c1-7d99ac20302a",
                                "sense_id": "88f6ad40-3958-3c17-af68-5f312785cd6e",
                                "text": "„Der Pfad geht in einen schmalen Asphaltweg über, es geht jetzt leicht bergan, weiter in Richtung Steeg.“"
                            },
                            {
                                "example_id": "9bc5d0ca-30d9-4341-a07f-6cd8ca90a84d",
                                "sense_id": "88f6ad40-3958-3c17-af68-5f312785cd6e",
                                "text": "„Thomas ließ den Motor kurz aufheulen, dann sauste der Karmann lautstark auf dem Asphaltweg zur Hauptstraße hinauf.“"
                            }
                        ],
