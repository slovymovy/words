                        "cross_references": [
                            {
                                "target_word": "face nord",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fd3b655a-3cb1-30ca-8637-882b76bf1ada",
                                        "entry_id": "3e0e6e15-42a4-346e-a4b8-766e880104f8",
                                        "glosses": [
                                            "Face d’une montagne orientée au nord, généralement considérée comme présentant l’accès le plus difficile vers le sommet."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ae0f9723-1811-39ae-b609-fd4b4f349447",
                                        "entry_id": "3e0e6e15-42a4-346e-a4b8-766e880104f8",
                                        "glosses": [
                                            "But difficile à atteindre."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f5deab0-d8ec-4f0f-a609-c6846978d7d3",
                                                "sense_id": "ae0f9723-1811-39ae-b609-fd4b4f349447",
                                                "text": "Il vaut mieux toujours peupler l’avenir de gestes glorieux et de cités imaginaires, de faces nord, d’étraves écumantes et de paix universelle, sous peine de n’être plus qu’un vieillard desséché et sans le moindre avantage pour personne."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "26f5fafc-7b0c-4ffd-a4e1-ba5fc1bdaa14",
                        "source_entry_id": "e98881bc-93b4-398c-ae4a-071384f28a67",
                        "source_sense_id": "1a36e08c-7332-3900-bf98-990549b16522",
                        "source_sense_description": "nördliche Wand",
                        "target_lang_word": "noordwand",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "noordwand",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "23cdde02-05b8-3237-a37e-2ca83cb05da8",
                                        "entry_id": "1a1bf06c-72f9-3f98-9144-d117b0ac091c",
                                        "glosses": [
                                            "de helling van een berg die naar het noorden is gericht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "043043da-d35e-4116-b4a7-2b30d4e629c4",
                                                "sense_id": "23cdde02-05b8-3237-a37e-2ca83cb05da8",
                                                "text": "Robert Naar werd in 1955 geboren. Al in de jaren zeventig beklom hij, vaak als eerste Nederlander, moeilijke bergwanden in de Alpen, zoals de beruchte noordwand van de Eiger."
                                            },
                                            {
                                                "example_id": "49f38500-6507-4fb0-b103-0a0cafedd492",
                                                "sense_id": "23cdde02-05b8-3237-a37e-2ca83cb05da8",
                                                "text": "Hier aan de noordwand van de berg was er veel meer sneeuw en we zouden nog uren langs sneeuwhellingen moeten afdalen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2f9fbe74-e5e3-3930-8497-054d82592bdd",
                                        "entry_id": "1a1bf06c-72f9-3f98-9144-d117b0ac091c",
                                        "glosses": [
                                            "een wand of muur aan de noordzijde (die dus uitkijkt op het zuiden)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "acdab739-7b87-498b-beef-9d3f4fd442ea",
                                                "sense_id": "2f9fbe74-e5e3-3930-8497-054d82592bdd",
                                                "text": "Vrijwilligers zijn begonnen met het terugplaatsen van panelen van het gerestaureerde Mans Kapbaargmozaïek. Aan de noordwand van de tunnel zitten er inmiddels een tiental weer op hun plek."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
