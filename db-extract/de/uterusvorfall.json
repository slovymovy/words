                "senses": [
                    {
                        "sense_id": "00670adf-3c61-3187-9d84-ed3a4683508c",
                        "entry_id": "fc457522-1ee2-3728-b3c2-61c34116059d",
                        "glosses": [
                            "Herabsinken der Gebärmutter (des Uterus) durch die Scheide"
                        ],
                        "tags": [
                            "Gynäkologie"
                        ],
                        "examples": [
                            {
                                "example_id": "0792ad84-3a33-4054-b16d-cf964c7d8441",
                                "sense_id": "00670adf-3c61-3187-9d84-ed3a4683508c",
                                "text": "„Ein Uterusvorfall ist stets ein Notfall, der sofortiges tierärztliches Eingreifen erfordert. Der vorgefallene Uterus übt einen erheblichen Zug auf die Mutterbänder aus.“"
                            },
                            {
                                "example_id": "e9a82993-0550-475c-9e4d-fed3c52cb508",
                                "sense_id": "00670adf-3c61-3187-9d84-ed3a4683508c",
                                "text": "„Wer schon einmal einen Uterusvorfall bei der Kuh gesehen hat, wird dieses Bild nicht so schnell vergessen. Aus der Scheide ragt ein fast kalbgroßes blassrosa- bis starkrosafarbenes Schleimhautgewebe hervor.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
