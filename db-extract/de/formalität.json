                ],
                "senses": [
                    {
                        "sense_id": "adc9a2e9-dd5c-3f64-95b8-440c655062c0",
                        "entry_id": "f1c0dcc8-973d-3f7f-8ae5-005d0318e64c",
                        "glosses": [
                            "äußere, möglicherweise behördliche Vorschrift"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc85203a-d0da-4199-9438-73d01af9f248",
                                "sense_id": "adc9a2e9-dd5c-3f64-95b8-440c655062c0",
                                "text": "Ich habe alle für das Visum erforderlichen Formalitäten erledigt."
                            },
                            {
                                "example_id": "07796ff3-ab8a-4dd2-aec0-efcf360417c3",
                                "sense_id": "adc9a2e9-dd5c-3f64-95b8-440c655062c0",
                                "text": "„Die Nachbarn kamen und gingen, und der Pfarrer kümmerte sich um die Formalitäten der Beerdigung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "2e8fba92-fba3-3182-aa8f-e084c6777f05",
                        "entry_id": "f1c0dcc8-973d-3f7f-8ae5-005d0318e64c",
                        "glosses": [
                            "Handlung oder Vorgang mit nur äußerlicher Bedeutung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11f8b55c-6c1c-4879-bb35-38275e6046ff",
                                "sense_id": "2e8fba92-fba3-3182-aa8f-e084c6777f05",
                                "text": "Sie müssen hier unterschreiben, das ist bloße Formalität und hat keinen Hintergrund beziehungsweise weiteren Nutzen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ef79aa27-f499-4c9c-8259-4d28de636a0f",
                        "source_entry_id": "f1c0dcc8-973d-3f7f-8ae5-005d0318e64c",
                        "source_sense_id": "adc9a2e9-dd5c-3f64-95b8-440c655062c0",
                        "source_sense_description": "äußere, möglicherweise behördliche Vorschrift",
                        "target_lang_word": "formality",
