                "senses": [
                    {
                        "sense_id": "e52ef21c-87ba-3be0-9304-5f160fb0c3ec",
                        "entry_id": "692e2bef-8ee3-354c-be4d-672e3445c0c5",
                        "glosses": [
                            "höheres Bauwerk, auf dem die Zeit angezeigt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4460fa19-92fe-442b-931a-a338fc0cd666",
                                "sense_id": "e52ef21c-87ba-3be0-9304-5f160fb0c3ec",
                                "text": "„Den Hauptturm des Fischerschlössls, der gleichzeitig Uhrturm ist, zieren kleine Türmchen an den Ecken, die Giebel der Häuser sind zinnenbekrönt.“"
                            },
                            {
                                "example_id": "b74dfdc8-d2b5-48dd-aa4a-499a9fba2ccb",
                                "sense_id": "e52ef21c-87ba-3be0-9304-5f160fb0c3ec",
                                "text": "„Der Friedhof von Akranes lag weit von der Kirche entfernt, fast am anderen Ende des Ortes, wo ein rotbrauner Uhrturm zum Himmel zeigte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c107e80d-85ff-43bc-aad8-51aaee2b3b52",
                        "source_entry_id": "692e2bef-8ee3-354c-be4d-672e3445c0c5",
                        "source_sense_id": "e52ef21c-87ba-3be0-9304-5f160fb0c3ec",
                        "source_sense_description": "höheres Bauwerk, auf dem die Zeit angezeigt wird",
                        "target_lang_word": "clock tower",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "clock tower",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "68aa0b70-63c5-3489-a63e-9cde13f8069d",
                                        "entry_id": "7a6bcb11-4576-3d0d-bd79-ac1876ceb376",
                                        "glosses": [
                                            "A tower, usually in a prominent position, having a large clock in a high position, often with several faces."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b58ccaa0-93be-4999-858d-2ea6df880bcf",
                                                "sense_id": "68aa0b70-63c5-3489-a63e-9cde13f8069d",
                                                "text": "An astronomical clock tower, built at K'ai-feng in the eleventh century under imperial orders, relied on a highly sophisticated combination of water-driven gears (seen at right center in the cutaway diagram above) to rotate an armillary sphere (under the thatched roof) and a celestial globe (located within the tower on the second floor)."
                                            },
                                            {
                                                "example_id": "0d9d0467-526b-4f72-8f59-a04162efc5f8",
                                                "sense_id": "68aa0b70-63c5-3489-a63e-9cde13f8069d",
                                                "text": "This one is surmounted by a clock-tower with a bent weather-vane - the latter being the only disorderly object in sight."
                                            },
                                            {
                                                "example_id": "66e2232c-bb6b-444c-8d2e-3a52a52905f9",
                                                "sense_id": "68aa0b70-63c5-3489-a63e-9cde13f8069d",
                                                "text": "However, the Victorian platform buildings all survive, and the station's iconic clock tower (built in 1899) was dismantled and rebuilt alongside the current frontage."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
