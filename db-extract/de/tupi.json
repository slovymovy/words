                "senses": [
                    {
                        "sense_id": "28ca70a9-8c68-3a61-8f64-0b97981ba05e",
                        "entry_id": "d3c9e57a-c257-38cf-a320-a65fddd32e67",
                        "glosses": [
                            "südamerikanische Verkehrssprache, die von der Sprachfamilie der Tupí-Sprachen abgeleitet ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d4834f0-1103-4756-8449-2dda7f89f882",
                                "sense_id": "28ca70a9-8c68-3a61-8f64-0b97981ba05e",
                                "text": "„Portugiesische Siedler lebten in indigenen Verbänden mit einheimischen Frauen und die Sprache ihrer Kinder war in der Regel eine Varietät des Tupi.“"
                            },
                            {
                                "example_id": "5eb59c2c-af67-47f5-b579-61ed07fbfe53",
                                "sense_id": "28ca70a9-8c68-3a61-8f64-0b97981ba05e",
                                "text": "„Die Verwendung von Tupi ging zurück, hat jedoch Spuren hinterlassen und so stammen heute noch zahlreiche Wörter im brasilianischen Sprachgebrauch, vor allem Ortsnamen und Vornamen, aus dem Tupi.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
