                "senses": [
                    {
                        "sense_id": "7cb627fe-e177-3c75-95e3-e4a688dfcab7",
                        "entry_id": "78f6dedd-13aa-3d68-9227-bb3ac6982a06",
                        "glosses": [
                            "Donner un caractère bancable à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a90158ef-0cc8-4399-8c59-f2bfcce65290",
                                "sense_id": "7cb627fe-e177-3c75-95e3-e4a688dfcab7",
                                "text": "Objectif : augmenter la sécurité juridique + bancabiliser les projets."
                            },
                            {
                                "example_id": "0f6f2ec3-1ce8-4b87-82a8-d2c04578ab24",
                                "sense_id": "7cb627fe-e177-3c75-95e3-e4a688dfcab7",
                                "text": "Car le film a beau être envahi de monstres mythologiques comme le Minotaure ou l'Hydre de Lerne, on est tout de même très éloigné de la cruauté sans façons des mythes primitifs, car on compte bien entendu sur l'audience du plus grand nombre, c'est-à-dire le public des ados qu'il ne faut pas choquer, pour «bancabiliser» ces incontournables stars que furent autrefois Jupin et consorts."
                            },
                            {
                                "example_id": "7f240486-225f-4766-86c9-cfa45ea370bd",
                                "sense_id": "7cb627fe-e177-3c75-95e3-e4a688dfcab7",
                                "text": "C'est l'idée d'arrogants pas clairs pour bancabiliser encore Quitte à tuer encore, en corps"
                            }
                        ]
                    }
