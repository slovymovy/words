                {
                    "sense_id": "ae6daf82-4c90-3b26-81d5-82d1396d089a",
                    "sense_definition": "Intoxicated by alcohol; drunk.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He got completely <w>clobbered</w> at the party and could barely stand up.",
                            "target_lang_translations": {
                                "ru": "На вечеринке он <w>напился в стельку</w> и едва мог стоять на ногах."
                            }
