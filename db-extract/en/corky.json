                        "entry_id": "6f92de8c-05c4-3212-9a42-7fe176e51f1a",
                        "glosses": [
                            "Of wine, contaminated by a faulty or tainted cork."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "139dc5e6-0cd5-4e1d-881e-60d2c70eb8fe",
                                "sense_id": "72051148-62fe-34c6-8d18-222d72a43b77",
                                "text": "This wine smells a bit corky; get me another bottle."
                            }
                        ]
                    },
                    {
                        "sense_id": "d865183d-6fc2-3ec5-aa51-3e23e4b57d44",
                        "entry_id": "6f92de8c-05c4-3212-9a42-7fe176e51f1a",
                        "glosses": [
                            "Consisting of, or like, cork; dry; shrivelled."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "23fd77e6-e32f-41d2-9fa3-4409861dedf8",
                                "sense_id": "d865183d-6fc2-3ec5-aa51-3e23e4b57d44",
                                "text": "Bind fast his corky arms."
                            }
                        ]
                    }
                ],
                "translations": [
