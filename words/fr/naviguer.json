                {
                    "sense_id": "08ece077-9b43-372a-a12c-9774e1a4ff6d",
                    "sense_definition": "Consulter et parcourir des pages ou des sites sur Internet.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "informatique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il passe plusieurs heures par jour à <w>naviguer</w> sur Internet pour son travail."
                        },
                        {
                            "text": "Tu peux facilement <w>naviguer</w> sur ce site pour trouver toutes les informations nécessaires."
                        }
                    ],
                    "common_phrases": [
                        "naviguer sur Internet",
                        "naviguer sur le web"
                    ]
                },
                {
                    "sense_id": "bb5dfa66-5dc8-3da5-860b-55cdf67ad937",
                    "sense_definition": "Se déplacer sur l'eau à bord d'un bateau ou d'un navire.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "maritime",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pendant les vacances d'été, nous aimons <w>naviguer</w> le long des côtes bretonnes."
                        },
                        {
                            "text": "Les marins ont <w>navigué</w> pendant plusieurs semaines sans voir la terre ferme."
                        }
                    ],
                    "synonyms": [
                        "voguer"
                    ],
                    "common_phrases": [
                        "naviguer en mer",
                        "naviguer à la voile"
                    ]
                },
                {
                    "sense_id": "6ed85393-c28f-34c5-9142-571da2bc6189",
                    "sense_definition": "Diriger ou piloter la route d'un navire, d'un aéronef ou d'un engin.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "pilotage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans le brouillard épais, le pilote doit <w>naviguer</w> uniquement à l'aide des instruments de bord."
                        },
                        {
                            "text": "Le commandant a réussi à faire <w>naviguer</w> le bâtiment à travers le détroit encombré."
                        }
                    ],
                    "common_phrases": [
                        "naviguer aux instruments",
                        "naviguer à vue"
                    ]
                },
                {
                    "sense_id": "a8f63872-d732-31d6-9f1f-9587bc4492d0",
                    "sense_definition": "En parlant d'une embarcation, bien ou mal se comporter sur l'eau.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "maritime",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Même par mer agitée, ce voilier d'expédition <w>navigue</w> avec une remarquable stabilité."
                        },
                        {
                            "text": "Bien qu'il soit lourdement chargé, le bateau <w>naviguait</w> sans difficulté apparente."
                        }
                    ]
                }
            ]
        }
