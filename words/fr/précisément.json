{
    "word_family": [
        "imprécis",
        "imprécision",
        "précis",
        "préciser",
        "précision"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "13fbd406-21a6-3675-aea8-ec64e5a57945",
                    "sense_definition": "D'une manière précise, rigoureuse et sans approximation.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "exactitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il faut mesurer <w>précisément</w> chaque ingrédient pour réussir cette recette de pâtisserie."
                        },
                        {
                            "text": "Le guide nous a expliqué très <w>précisément</w> le chemin à suivre dans la montagne."
                        }
                    ],
                    "synonyms": [
                        "exactement",
                        "justement"
                    ],
                    "antonyms": [
                        "vaguement",
                        "approximativement"
                    ],
                    "common_phrases": [
                        "très précisément",
                        "plus précisément"
                    ]
                },
                {
                    "sense_id": "b0fe7ea4-5419-3e7f-aabd-55eb06235310",
                    "sense_definition": "S'emploie en réponse pour marquer l'accord ou confirmer une affirmation : tout à fait, c'est exactement cela.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "affirmation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "— Tu penses qu'il va refuser notre offre ? — <w>Précisément</w>, il ne changera pas d'avis."
                        },
                        {
                            "text": "— C'est ce modèle que vous cherchiez ? — <w>Précisément</w>, merci pour votre aide."
                        }
                    ],
                    "synonyms": [
                        "absolument",
                        "exactement",
                        "tout à fait"
                    ]
                },
                {
                    "sense_id": "782d06d6-edaa-39bb-84ff-05653919e3b5",
                    "sense_definition": "Justement ; sert à souligner une raison particulière ou une circonstance pertinente dans un raisonnement.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "liaison",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "C'est <w>précisément</w> parce qu'il manquait de temps qu'il a commis cette erreur."
                        },
                        {
                            "text": "Nous abordons <w>précisément</w> le sujet dont nous devions discuter aujourd'hui."
                        }
                    ],
                    "synonyms": [
                        "justement"
                    ],
                    "common_phrases": [
                        "c'est précisément pour cela"
                    ]
                }
            ]
        }
    ]
}