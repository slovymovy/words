                "senses": [
                    {
                        "sense_id": "4236df3b-d317-3db5-a21a-20c4e1176bf0",
                        "entry_id": "560a19c8-3b44-373c-877f-15fab4a133ee",
                        "glosses": [
                            "Vorgang, bei dem jemanden oder etwas durch ein bestimmtes Gebiet hindurch an ein bestimmtes Ziel geführt/begleitet (geschleust) wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "20a8d2b7-2277-48e2-8f69-fc56422dcf7e",
                                "sense_id": "4236df3b-d317-3db5-a21a-20c4e1176bf0",
                                "text": "„Die Ansammlung von Schiffen einerseits, rege Schiffsbewegungen vor der Schleusung andererseits, führen um so leichter zu Havarien, je enger ein Vorhafen ist.“"
                            },
                            {
                                "example_id": "bd3d1f9a-a3c0-4c1f-9c7e-6d0c76bb2269",
                                "sense_id": "4236df3b-d317-3db5-a21a-20c4e1176bf0",
                                "text": "Die Schleusung von Migranten auf dem Land-, See- und Luftweg soll unterbunden werden."
                            },
                            {
                                "example_id": "c097b354-971b-45fa-8d5e-304439b65086",
                                "sense_id": "4236df3b-d317-3db5-a21a-20c4e1176bf0",
                                "text": "„Viele Chinesen, insbesondere die in den wohlhabenden Küstenregionen, sind heute in der Lage, die zum Teil enormen Gebühren für eine Schleusung in westliche Gesellschaften aufzubringen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
