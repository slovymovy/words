                ],
                "senses": [
                    {
                        "sense_id": "5900e974-3e15-3abb-9911-bd52ae6c909a",
                        "entry_id": "be0cdf0c-6e89-31d5-a5bb-b10a52100088",
                        "glosses": [
                            "Doctrine de Gamal Abdel Nasser."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "187a5a36-9f5e-4d98-ac2b-af645044dc76",
                                "sense_id": "5900e974-3e15-3abb-9911-bd52ae6c909a",
                                "text": "[…] maintenant officiel, de l’Égypte aux orientations du nassérisme, l’Arabie Saoudite fait prévaloir l’arbitrage des États-Unis, sous prétexte que ceux-ci, amis d’Israël, sont les plus aptes à faire pression sur lui."
                            },
                            {
                                "example_id": "589efd61-186a-4987-9f36-31a9de8e0f3e",
                                "sense_id": "5900e974-3e15-3abb-9911-bd52ae6c909a",
                                "text": "Que reste-t-il donc aujourd'hui de leur héritage, que reste-t-il donc du nassérisme et du baasisme, après le drame de leurs fondateurs, après leur tumultueux rapprochement et leur douloureuse séparation ? A la vérité, presque rien et presque tout."
                            },
                            {
                                "example_id": "6be9ccca-4750-4182-99ec-0fcff306d3f0",
                                "sense_id": "5900e974-3e15-3abb-9911-bd52ae6c909a",
                                "text": "Ils sont peut-être nostalgiques de la figure historique oui, du nassérisme non."
                            }
                        ]
                    }
                ],
