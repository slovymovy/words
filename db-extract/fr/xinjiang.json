        "fr-extract.jsonl": [
            {
                "entry_id": "b2382ce1-449c-3ece-9655-2ffefaa465ab",
                "word": "Xinjiang",
                "pos": "name",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "0f5df429-4d53-4ed6-860c-8263c9d6d948",
                        "entry_id": "b2382ce1-449c-3ece-9655-2ffefaa465ab",
                        "tags": [],
                        "form": "Sin-kiang"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "03095d4e-1d72-3c4e-98a9-0157695f4aea",
                        "entry_id": "b2382ce1-449c-3ece-9655-2ffefaa465ab",
                        "glosses": [
                            "Région autonome ouïghoure située au Nord-Ouest de la Chine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "22d1c4c1-b07c-486c-b2cf-3618a61cf62b",
                                "sense_id": "03095d4e-1d72-3c4e-98a9-0157695f4aea",
                                "text": "Dans un rapport très attendu sur la région chinoise du Xinjiang publié mercredi, l’ONU a évoqué de possibles « crimes contre l’humanité » et fait état de « preuves crédibles » de tortures et de violences sexuelles à l’égard de la minorité ouïgoure."
                            },
                            {
                                "example_id": "e33e541a-27ee-4836-9ff1-f3bc12c85e05",
                                "sense_id": "03095d4e-1d72-3c4e-98a9-0157695f4aea",
                                "text": "C’est ce magot à la peau verte qui bedonne et grimace en pure perte. Il fut une poignée d’argile arrachée au Xinjiang, camionnée vers l’usine, pétrie, moulée, qui a pris forme humaine et qu’on a enfournée une fois vernissée."
                            },
                            {
                                "example_id": "f4290512-a262-45c4-9fb3-337abc73e3f9",
                                "sense_id": "03095d4e-1d72-3c4e-98a9-0157695f4aea",
                                "text": "Le Xinjiang est un territoire stratégique important pour la Chine. D’abord pour ses réserves de gaz et de pétrole, mais aussi parce qu’il ouvre un accès au cœur du continent asiatique."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "31e1f8e8-e0f9-482d-8bca-290195a2ee45",
                        "source_entry_id": "b2382ce1-449c-3ece-9655-2ffefaa465ab",
                        "source_sense_id": "03095d4e-1d72-3c4e-98a9-0157695f4aea",
                        "target_lang_word": "Xinjiang",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Xinjiang",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0ccd2fe5-7f10-36bc-8c2d-48849772fceb",
                                        "entry_id": "74181d61-589a-3d44-a07f-c2aa8f8be6d3",
                                        "glosses": [
                                            "autonome Provinz im Westen der Volksrepublik China"
                                        ],
                                        "tags": [
                                            "Geographie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "875be727-776e-4faa-a2b0-35a7105aca64",
                                                "sense_id": "0ccd2fe5-7f10-36bc-8c2d-48849772fceb",
                                                "text": "„Die USA, die EU und andere Regierungen beschuldigen China, Zwangsarbeit und Menschenrechtsverletzungen in Xinjiang hinzunehmen und sogar zu fördern, vor allem im Umgang mit der muslimischen Minderheit der Uiguren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bdf7d091-b9d2-4d01-bba2-ac325c33448f",
                        "source_entry_id": "b2382ce1-449c-3ece-9655-2ffefaa465ab",
                        "source_sense_id": "03095d4e-1d72-3c4e-98a9-0157695f4aea",
                        "target_lang_word": "Sinkiang",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "b563a55e-a749-4777-9f17-6b4336b4273b",
                        "source_entry_id": "b2382ce1-449c-3ece-9655-2ffefaa465ab",
                        "source_sense_id": "03095d4e-1d72-3c4e-98a9-0157695f4aea",
                        "target_lang_word": "Xinjiang",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Xinjiang",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ad4eb08e-39cc-381d-a39c-1622bce39381",
                                        "entry_id": "a27323c8-e924-3563-9e4f-16e63d0f92c7",
                                        "glosses": [
                                            "An Uyghur autonomous region of China, located in the sparsely populated northwest. Official name: Xinjiang Uygur Autonomous Region. Capital: Ürümqi."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d42a49f-f255-43cd-81c1-5e29bfe6d9f7",
                                                "sense_id": "ad4eb08e-39cc-381d-a39c-1622bce39381",
                                                "text": "In the Xinjiang Autonomous Region, only local languages are used as a medium of instruction in the elementary and middle schools. In the same region, the law provides that both Chinese and Uighur must be used in all public documents."
                                            },
                                            {
                                                "example_id": "d0b5e5b2-a168-4833-869c-dcb6295af34a",
                                                "sense_id": "ad4eb08e-39cc-381d-a39c-1622bce39381",
                                                "text": "In mid-1978 the 800-km. Karakoram highway was opened, linking Xinjiang province in the People’s Republic of China with Havelian, north of Islamabad, after being under construction for 20 years."
                                            },
                                            {
                                                "example_id": "d5b18723-7823-42c0-b658-f07bff0b0d78",
                                                "sense_id": "ad4eb08e-39cc-381d-a39c-1622bce39381",
                                                "text": "Since early 2017, the Chinese government has reportedly detained some 1 million Uygurs and other largely Muslim ethnic minorities in mass internment camps in Xinjiang, where inmates are subjected to political indoctrination. Beijing claims the facilities are “vocational training centres” and says they are a legitimate response to the threat of religious extremism."
                                            },
                                            {
                                                "example_id": "196989d3-fd49-43cd-b37d-94e00082fff0",
                                                "sense_id": "ad4eb08e-39cc-381d-a39c-1622bce39381",
                                                "text": "G7 explicitly agreed to call out human rights abuses in Xinjiang and in Hong Kong- explicitly. Two, to coordinate a common strategy to deal with China non-market policies that undermine competition- we've agreed and that's underway now how to do that. Three, to take serious actions against forced labor in solar, agriculture and the garment industries, because that's where it's happening- and they've agreed we will do that."
                                            },
                                            {
                                                "example_id": "71d4a109-5e98-4741-8698-f5ee136a0950",
                                                "sense_id": "ad4eb08e-39cc-381d-a39c-1622bce39381",
                                                "text": "Xinjiang was the dark China. The western frontier region, which is twice the size of Texas, is home to more than 10 million Muslim ethnic minorities who have been subject to mass detentions, religious repression and intrusive digital and physical surveillance."
                                            },
                                            {
                                                "example_id": "10174f54-526b-46cd-9c1d-82bcee5b90b1",
                                                "sense_id": "ad4eb08e-39cc-381d-a39c-1622bce39381",
                                                "text": "Eighteen people remain trapped in a gold mine after it caved in China's northwestern province of Xinjiang."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Xinjiang",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f51950bf-8088-3d6c-87af-313f4d205b37",
                                        "entry_id": "bc79c0c5-dd35-30ae-a607-6cdde1d024a6",
                                        "glosses": [
                                            "A county of Yuncheng, Shanxi, China."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3adb10f-26e3-4971-812e-8d406e443be9",
                                                "sense_id": "f51950bf-8088-3d6c-87af-313f4d205b37",
                                                "text": "Drumming in Shanxi Province can be dated back centuries earlier to Xinjiang County, the ancient name of Jiangzhou, in present-day Shanxi Province."
                                            },
                                            {
                                                "example_id": "5f4a6d1d-94df-45f0-9d27-36ed34504448",
                                                "sense_id": "f51950bf-8088-3d6c-87af-313f4d205b37",
                                                "text": "In September 2009, Xinjiang County in Yuncheng Municipality, Shanxi Province started to put village administrative information online for farmers to access."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "03cef0d2-1873-4b89-b71e-78bcd811c320",
                        "source_entry_id": "b2382ce1-449c-3ece-9655-2ffefaa465ab",
                        "source_sense_id": "03095d4e-1d72-3c4e-98a9-0157695f4aea",
