                "senses": [
                    {
                        "sense_id": "25acdc59-1115-3882-9a40-a2053bd216d7",
                        "entry_id": "be9ea858-01d2-3bdb-823c-f361a4c500f9",
                        "glosses": [
                            "An area where tents are pitched."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d052310-3b65-4342-b54f-55a835fd06d9",
                                "sense_id": "25acdc59-1115-3882-9a40-a2053bd216d7",
                                "text": "At 4.7 miles, on the left, is the campground and park headquarters for Samuel P. Taylor State Park"
                            }
                        ]
                    },
                    {
                        "sense_id": "1b50068b-642e-38f8-9fb5-8bf746d19a68",
                        "entry_id": "be9ea858-01d2-3bdb-823c-f361a4c500f9",
                        "glosses": [
                            "An area where a camp meeting (a retreat) is held."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f9aeeba-ffa2-4cf9-a669-b80b203010fc",
                                "sense_id": "1b50068b-642e-38f8-9fb5-8bf746d19a68",
                                "text": "Camp Hamilton is the Methodist campground, a few miles from Salem, where the Methodists were holding services."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9c4ae2eb-02ce-43fa-84eb-12f35e56aa0c",
                        "source_entry_id": "be9ea858-01d2-3bdb-823c-f361a4c500f9",
                        "source_sense_description": "area for tents",
                        "target_lang_word": "camping",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "camping",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "e5869257-7e4a-3e47-bce5-bcaf27ee07db",
                                        "entry_id": "c37353d4-e4ec-31d3-b659-fe88bca4e2de",
                                        "glosses": [
                                            "een terrein met voorzieningen om te kamperen"
                                        ],
                                        "tags": [
                                            "kamperen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aabbf26b-65cc-40e4-839a-e135b707901c",
                                                "sense_id": "e5869257-7e4a-3e47-bce5-bcaf27ee07db",
                                                "text": "Wild kamperen is kamperen op een plaats die niet als camping is ingericht."
                                            },
                                            {
                                                "example_id": "85386029-3d9c-4a0a-b43f-98972505d681",
                                                "sense_id": "e5869257-7e4a-3e47-bce5-bcaf27ee07db",
                                                "text": "Het heeft de treurige aanblik van een windmolenpark op zee. De campingplekken herken je alleen nog aan de elektriciteitspaaltjes die boven het water uitsteken. Camping Waalstrand, in het Gelderse Gendt, is ondergelopen als gevolg van de hevige regenval in Duitsland de afgelopen dagen. „Het water komt hier zeker 2,5 meter hoger dan normaal in deze tijd van het jaar”, zegt eigenaar Anciëlla Tap (49). „Kijk die golven!”"
                                            },
                                            {
                                                "example_id": "35377c06-3090-45d9-b78f-51034d65ec24",
                                                "sense_id": "e5869257-7e4a-3e47-bce5-bcaf27ee07db",
                                                "text": "Als ik zou stoppen, zou ik de schitterende natuur om mij heen moeten missen, die steeds mooier leek te worden. De ondergaande zon kleurde de verticale rotswanden goud toen ik de camping van Tuolumne Meadows in Yosemite bereikte."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e61f2a1f-38f1-4d28-95a7-ca1427e765de",
                        "source_entry_id": "be9ea858-01d2-3bdb-823c-f361a4c500f9",
                        "source_sense_description": "area for tents",
                        "target_lang_word": "terrain de camping",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "terrain de camping",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ecf733ce-9f50-3fdf-972b-44a4acb6022c",
                                        "entry_id": "9435f697-faae-3640-a322-ade6c5eb81e0",
                                        "glosses": [
                                            "Aire extérieure, aménagée ou non, généralement herbeuse et parfois arborée, prévue pour l'installation généralement temporaire (pour un weekend ou des vacances), payante ou non, de tentes, caravanes ou autres types d'habitat mobile."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ea2bdfa0-f228-4e6e-a0a8-a57d753c5f22",
                        "source_entry_id": "be9ea858-01d2-3bdb-823c-f361a4c500f9",
                        "source_sense_description": "area for tents",
                        "target_lang_word": "Campingplatz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Campingplatz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "13c31873-47cb-3c4f-bf56-2f935b270130",
                                        "entry_id": "f365b7fa-2be4-3fa8-8131-ad63981bacae",
                                        "glosses": [
                                            "ein abgegrenztes Gelände, auf dem man mit einem Zelt oder Wohnwagen übernachten darf"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "036221e3-3b6f-41c8-a887-b3a43dab989d",
                                                "sense_id": "13c31873-47cb-3c4f-bf56-2f935b270130",
                                                "text": "Wer ein Zelt hat, kann auf einem Campingplatz übernachten."
                                            },
                                            {
                                                "example_id": "114eb0cc-6b1f-46f7-b008-247e6963161d",
                                                "sense_id": "13c31873-47cb-3c4f-bf56-2f935b270130",
                                                "text": "„Ich hatte damals immer ein Zelt dabei, und auf den Campingplätzen waren fast nur Franzosen.“"
                                            },
                                            {
                                                "example_id": "7553a8ef-b9a1-4b2c-9a34-ee47471a10fd",
                                                "sense_id": "13c31873-47cb-3c4f-bf56-2f935b270130",
                                                "text": "„Im Zentrum angelangt machte ich mich auf die Suche nach einem Campingplatz, doch leider gab es in der Hauptstadt keine Möglichkeit zum Zeltaufschlagen.“"
                                            },
                                            {
                                                "example_id": "7ce94545-01ad-427b-b06e-e3689485e04a",
                                                "sense_id": "13c31873-47cb-3c4f-bf56-2f935b270130",
                                                "text": "„Der Campingplatz (Wohnmobilstellplätze und Zelte) erstreckt sich auf dem alten Fußballplatz östlich des Ortes.“"
                                            },
                                            {
                                                "example_id": "57a0b122-7082-43b0-93d8-6d3a73d98a31",
                                                "sense_id": "13c31873-47cb-3c4f-bf56-2f935b270130",
                                                "text": "„Als es auf dem Campingplatz fernab jeder Stromleitung dunkel wird, beobachten die Kinder, wie wir im Schein der Taschenlampe kochen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3619ab89-bb5d-4db5-bdf0-2199dc7f644d",
                        "source_entry_id": "be9ea858-01d2-3bdb-823c-f361a4c500f9",
                        "source_sense_description": "area for tents",
                        "target_lang_word": "Zeltplatz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zeltplatz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "34934a55-5938-3233-b7fc-1f42037f0a71",
                                        "entry_id": "ab46da22-19f8-3e1c-99ac-17ec3a8851e9",
                                        "glosses": [
                                            "Gelände, das dafür eingerichtet/vorbereitet ist, dass darauf gezeltet werden kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46e6e204-f2c6-4ebd-82be-103b945a99d8",
                                                "sense_id": "34934a55-5938-3233-b7fc-1f42037f0a71",
                                                "text": "„Etwa zehn Euro kostet eine Nacht auf dem Zeltplatz pro Person.“"
                                            },
                                            {
                                                "example_id": "8a767550-ffc7-4638-9d07-ebf7bd1d66f1",
                                                "sense_id": "34934a55-5938-3233-b7fc-1f42037f0a71",
                                                "text": "„Hier gibt es den nördlichsten Zeltplatz und den nördlichsten Baumarkt sowie den zweitnördlichsten Baumarkt und natürlich auch zwei Supermärkte.“"
                                            },
                                            {
                                                "example_id": "d0d341d1-227f-4e16-9ff8-8abd5ee5a128",
                                                "sense_id": "34934a55-5938-3233-b7fc-1f42037f0a71",
                                                "text": "„An der Stelle, wo sich das Gefangenenlager befand, steht seit einigen Jahren ein Zeltplatz, und alle, die hier campen, kommen freiwillig.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
