                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7928123-a131-46db-a53c-af27e603f423",
                                "sense_id": "642f03fc-1dad-355f-a00a-9b704ddaee47",
                                "text": "Die meisten Sehnenrisse werden durch Ermüdungserscheinungen verursacht."
                            },
                            {
                                "example_id": "af6854ac-1a19-4e3f-b263-baf116dfd735",
                                "sense_id": "642f03fc-1dad-355f-a00a-9b704ddaee47",
                                "text": "„Wenn bei einem Sehnenrisse Zerreissung der bedeckenden Teile und teilweise Zerstörung der Sehnen an der Rissstelle Statt hat; hier werden die Sehnenenden eben geschnitten, mit der Haut bedeckt und zur Begünstigung der Vereinigung kann die Naht dienen.“ (1838)"
                            }
                        ],
