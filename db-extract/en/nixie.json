                "senses": [
                    {
                        "sense_id": "7c54cc86-fe1b-3f1a-a0c1-e42999319438",
                        "entry_id": "537a592b-f134-3b1f-b3ac-df3affc24322",
                        "glosses": [
                            "A piece of mail returned as undeliverable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1947fb25-2cc7-42bf-9791-3d9622309ad5",
                                "sense_id": "7c54cc86-fe1b-3f1a-a0c1-e42999319438",
                                "text": "Mailers who are registered participants in the Postal Service's Address Change Service (ACS) system expect to receive their address corrections and nixie notifications by electronic messages;[…]."
                            },
                            {
                                "example_id": "9408d7ce-bcb8-4784-a083-53d129b62e6c",
                                "sense_id": "7c54cc86-fe1b-3f1a-a0c1-e42999319438",
                                "text": "If you get a response of less than one percent or excessive “nixies” (wrong addresses), rework your copy or get a new list."
                            },
                            {
                                "example_id": "988a9b47-f74b-41c6-a1fc-7321b675042d",
                                "sense_id": "7c54cc86-fe1b-3f1a-a0c1-e42999319438",
                                "text": "Another good reason to use first-class mail is the fact that it will often be forwarded or, if need be, returned to the sender if the address is bad. (In the industry, this is called a “nixie.”) It is important to keep an eye on the nixie rate if you are using first-class mail."
                            }
                        ]
                    }
                ],
