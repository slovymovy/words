                                        "examples": [
                                            {
                                                "example_id": "9bdd7e38-8b03-4a9a-b445-5347ce5ada43",
                                                "sense_id": "0c8ce72a-bafc-31c7-b75a-5f58b6120761",
                                                "text": "‘She must of^([sic]) grabbed some pills. There's half a dozen kinds up there – even demerol.’"
                                            },
                                            {
                                                "example_id": "225529f3-a81c-4c28-8631-a15ba3d46eab",
                                                "sense_id": "0c8ce72a-bafc-31c7-b75a-5f58b6120761",
                                                "text": "“Anyway, when he came out of Patsy's room, I grabbed him by the arm and said, ‘Gee whiz, doc, haven't you got a couple of pills for me—even demerol?’ ” / Willie broke off to explain. “That's a synthetic. We call them demmies. If you can't buy H or M, why, demmies will do the trick.”"
                                            },
                                            {
                                                "example_id": "9d06e938-00cf-4d59-81b8-181f89e82eda",
                                                "sense_id": "0c8ce72a-bafc-31c7-b75a-5f58b6120761",
                                                "text": "Gately doesn’t miss weed much. The shocker-type AA Miracle is he doesn’t much miss the Demerol, either, today."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
