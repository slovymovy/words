                    {
                        "translation_id": "829ab77d-0f7e-4c13-bbb9-64e5ead22238",
                        "source_entry_id": "07d912d6-3c8f-3c29-905e-94ac91dece6a",
                        "source_sense_id": "4d4c64b3-40fb-315b-9b75-167c3338eebe",
                        "target_lang_word": "dungarees",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dungarees",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "16a3914e-3e61-3691-a95f-9b5197779b8e",
                                        "entry_id": "b4bda94b-6c1e-3dce-bab3-64a29f99afc9",
                                        "glosses": [
                                            "Heavy denim pants or trousers, usually with bib and braces, worn especially as work clothing."
                                        ],
                                        "tags": [
                                            "plural",
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9c9c9c4a-c810-462b-8129-af59a109ff9c",
                                                "sense_id": "16a3914e-3e61-3691-a95f-9b5197779b8e",
                                                "text": "Helen donned a pair of faded dungarees and grabbed her knapsack before rushing off to school."
                                            },
                                            {
                                                "example_id": "837f41d5-7b55-45c7-a9fc-179f26cdaec9",
                                                "sense_id": "16a3914e-3e61-3691-a95f-9b5197779b8e",
                                                "text": "Next came a domeshaped sukhpal (palanquin), its silver plated pole being borne by eight sturdy troopers wearing red flowing kurtas, silk kamarbunds, and silk dungarees."
                                            },
                                            {
                                                "example_id": "c8f0268e-6efa-4b96-ab28-6296c60b797d",
                                                "sense_id": "16a3914e-3e61-3691-a95f-9b5197779b8e",
                                                "text": "I’d arrived at Heaven nightclub, underneath the Charing Cross railway arches, on a hot Sunday afternoon to find my friends had already gone in – you didn’t risk hanging back and missing your chance – so I joined the queue of kids dressed in the acid house uniform of Day-Glo dungarees and smiley T-shirts."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fd58d320-a1d0-4f56-af4e-974acda1866e",
                        "source_entry_id": "07d912d6-3c8f-3c29-905e-94ac91dece6a",
                        "source_sense_id": "4d4c64b3-40fb-315b-9b75-167c3338eebe",
