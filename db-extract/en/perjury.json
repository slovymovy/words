                                        "examples": [
                                            {
                                                "example_id": "68036939-b104-4cbc-a168-64631a48a76f",
                                                "sense_id": "b3209e0e-f210-3e56-a5be-162fa6bb6aff",
                                                "text": "Daar heb je bijvoorbeeld een koopman, een soldaat of een rechter die meent dat door het offeren van één muntje uit zoveel behaalde buit de hele poel van zijn leven in éénmaal gezuiverd is en dat al die meineden, al die uitspattingen, al die dronkenschappen, ruzies, moorden, oplichterijen, trouweloosheden, al dat verraad als het ware volgens contract worden afgekocht, en wel zo dat men weer een nieuwe reeks schurkenstreken kan beginnen."
                                            },
                                            {
                                                "example_id": "b34d59fa-c694-42da-bef3-86256d453b15",
                                                "sense_id": "b3209e0e-f210-3e56-a5be-162fa6bb6aff",
                                                "text": "Eric nam nu het woord over van Ariadne en vertelde dat Heiskanen in hechtenis zat, aangeklaagd wegens meineed en valse aangifte, in beide gevallen een misdrijf, en hij kon een gevangenisstraf van vier jaar tegemoetzien."
                                            }
                                        ]
