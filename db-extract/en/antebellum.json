                "senses": [
                    {
                        "sense_id": "f8b053fe-1da6-37aa-b806-97144fa4d6fb",
                        "entry_id": "55e32f14-108f-3c3f-8927-756a0e8e7a7e",
                        "glosses": [
                            "Of the time period prior to a war."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "d899a853-510a-49c7-a18c-13c7b577b964",
                                "sense_id": "f8b053fe-1da6-37aa-b806-97144fa4d6fb",
                                "text": "A renewed sense of national pride arose in Hitler's antebellum Germany."
                            }
                        ]
                    },
                    {
                        "sense_id": "c2025b17-f11c-31e3-91e5-971042d2244a",
                        "entry_id": "55e32f14-108f-3c3f-8927-756a0e8e7a7e",
                        "glosses": [
                            "Of the time period prior to a war.",
                            "Of the period prior to the American Civil War, especially in reference to the culture of the southern states."
                        ],
                        "tags": [
                            "US",
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "a465ea8b-53cd-4719-978a-8545f88643fc",
                                "sense_id": "c2025b17-f11c-31e3-91e5-971042d2244a",
                                "text": "Slavery was an accepted part of antebellum plantation life."
                            },
                            {
                                "example_id": "5ee5bf3e-77b8-4153-ab42-786f8a3d9ea9",
                                "sense_id": "c2025b17-f11c-31e3-91e5-971042d2244a",
                                "text": "There was no single characteristic house style during the antebellum period, but the elegant plantation homes built in the American South, with their central entrances, balconies, columns, and formal ballrooms, came closest to representing a discrete architectural style for the period."
                            },
                            {
                                "example_id": "b990a90f-9ea2-4dca-8148-e8c71fccdfe7",
                                "sense_id": "c2025b17-f11c-31e3-91e5-971042d2244a",
                                "text": "Across the street from the church, which is lovingly known as Mother Emanuel, is Marion Park. Until recently, this where a statue of Vice President John C. Calhoun, a slaveowner and staunch supporter of antebellum plantation slavery, stood."
                            }
                        ]
                    }
                ],
