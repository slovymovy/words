                    {
                        "sense_id": "dd8a3418-cc2d-3546-bfef-f3c5b34925b6",
                        "entry_id": "0fb5af78-137d-3e77-8cd0-f707b710cfde",
                        "glosses": [
                            "A process of temporarily reducing the ability to feel pain; the provision of this service."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "a538847e-4b17-4ae7-a109-832faaa52899",
                                "sense_id": "dd8a3418-cc2d-3546-bfef-f3c5b34925b6",
                                "text": "This office procedure is quick and straightforward, but it does require some analgesia."
                            }
                        ]
                    },
                    {
                        "sense_id": "ecf8643e-5a69-37f5-9f84-e192a5b29412",
                        "entry_id": "0fb5af78-137d-3e77-8cd0-f707b710cfde",
                        "glosses": [
                            "A medication that performs this action: one that relieves pain."
                        ],
                        "tags": [
                            "broadly",
                            "countable",
                            "metonymically",
                            "often",
                            "proscribed",
                            "uncountable"
