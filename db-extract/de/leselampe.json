                ],
                "senses": [
                    {
                        "sense_id": "c2b20223-3d7f-37b5-b98d-493293b6f8a7",
                        "entry_id": "784ee541-3fa6-342b-be01-3ac059c70eb1",
                        "glosses": [
                            "kleine Lampe zum Lesen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e8ef5848-631b-4729-9ab5-ff6c08da1efc",
                                "sense_id": "c2b20223-3d7f-37b5-b98d-493293b6f8a7",
                                "text": "Als es dunkel wurde, schaltete er die Leselampe ein."
                            },
                            {
                                "example_id": "cbee1b32-07b5-4eb8-8f9f-f2f9151b67c4",
                                "sense_id": "c2b20223-3d7f-37b5-b98d-493293b6f8a7",
                                "text": "„Ich hatte zum Einschlafen alles Licht bis auf eine Leselampe am Bett ausgeschaltet.“"
                            },
                            {
                                "example_id": "81842d22-5571-4c9c-b2e1-61718e076e87",
                                "sense_id": "c2b20223-3d7f-37b5-b98d-493293b6f8a7",
                                "text": "„Tom hob langsam den linken Arm und knipste die Leselampe über dem Bett aus.“"
                            },
                            {
                                "example_id": "e22bd4a6-657d-4de7-a7d9-095974870cc2",
                                "sense_id": "c2b20223-3d7f-37b5-b98d-493293b6f8a7",
                                "text": "„Nur zu bekannt sind all die Erzählungen vom Schotten, der die Blindenschrift lernt, um abends beim Lesen Strom zu sparen, der keine Leselampe kauft, um nicht auch noch ein Buch anschaffen zu müssen, und der in der Dunkelheit bei der ohnehin gesparten Beleuchtung seine Hose auszieht, um sie nicht unnötig abzunutzen.“"
                            },
                            {
                                "example_id": "a394a1a3-399c-4eab-804f-153595fc4783",
                                "sense_id": "c2b20223-3d7f-37b5-b98d-493293b6f8a7",
                                "text": "„Ich schaltete die Leselampe ein und sah mir noch einmal die Bilder an, von Papa und Leif auf Tour, fünfzehn Jahre alt, ihr ganzes Gepäck hinten auf dem Fahrrad.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
