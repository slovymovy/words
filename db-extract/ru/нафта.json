                        "form": "на́фте"
                    },
                    {
                        "form_id": "32e1ba1c-9dc3-4769-920d-db428b401579",
                        "entry_id": "4bf35302-df0d-3885-b09a-f1683760bc93",
                        "tags": [
                            "plural",
