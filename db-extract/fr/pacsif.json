                        "examples": [
                            {
                                "example_id": "ec745168-25a0-45a3-8754-f2b68be4eb95",
                                "sense_id": "420b184f-f13d-38f7-b846-48d9033cec0c",
                                "text": "Mais, après cette amusette, le vrai boulot, le gros pacsif, quatre vingts à cent briques pour chacun."
                            },
                            {
                                "example_id": "0c41ad2a-288f-42a0-a6ec-dad3d67a6064",
                                "sense_id": "420b184f-f13d-38f7-b846-48d9033cec0c",
                                "text": "— Le gros pacsif que je vais empocher. Si avec tout ce fric je ne peux pas te rendre heureuse que je tombe raide mort sur le champ !"
                            },
                            {
                                "example_id": "d0794287-fdfd-4082-ac2f-ceca8b19c70b",
                                "sense_id": "420b184f-f13d-38f7-b846-48d9033cec0c",
                                "text": "Même à la grive, en 40, le Tatave fallait pas lui gonfler le sac... galons pas galons, \"suce ma bite et bien !\" Ce qu’il proclame en s’attrapant tout le pacsif, son service trois pièces à pleine pogne... il relève, il secoue, c’est sa ponctuation personnelle lorsqu’il raconte."
                            }
                        ]
                    }
