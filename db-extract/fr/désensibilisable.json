                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0dbbe1ca-611f-4c43-8334-8252b3c704ae",
                                "sense_id": "1f4345d0-785b-3030-82ee-d7def69999ff",
                                "text": "Ici encore, le Panchromosa de Gevaert apparaît comme beaucoup plus aisément désensibilisable que les Isopans d’Agfa et le FP2 d’Ilford."
                            },
                            {
                                "example_id": "93247578-7473-4479-9fdb-341b8b891087",
                                "sense_id": "1f4345d0-785b-3030-82ee-d7def69999ff",
                                "text": "Dans le cas d’un système désensibilisable, ou dans une bibliothèque de consultation sur place, la détection ne se fait qu’à la sortie des lecteurs."
                            },
                            {
                                "example_id": "bf95cc37-060f-4f45-9dae-ff549eb9b9a2",
                                "sense_id": "1f4345d0-785b-3030-82ee-d7def69999ff",
                                "text": "Cette normalisation a pour but de démystifier les sensations ressenties comme bizarres, et leur redonne un statut de pur ressenti, désensibilisable, tant que la personne reste dans sa fenêtre de tolérance."
                            }
                        ]
                    }
