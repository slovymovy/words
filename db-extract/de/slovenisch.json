                    }
                ],
                "senses": [
                    {
                        "sense_id": "b8afd7d7-df8d-36b4-bdd7-9abc76abded8",
                        "entry_id": "7514e788-4241-3806-b095-e80554192776",
                        "glosses": [
                            "zum Volk der Slowenen gehörig"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7794d4dc-295a-4668-a3b5-2831efbc055a",
                                "sense_id": "b8afd7d7-df8d-36b4-bdd7-9abc76abded8",
                                "text": "„Vor der ersten Sitzung des Jahres 1871 soll ein italienischer Abgeordneter (Dottori) vorgeschlagen haben, den slovenischen Abgeordneten im Landtag und im Landesausschuß den Gebrauch der slovenischen Sprache zu verwehren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "7dbbd946-9706-3296-8afa-083d594eef3e",
                        "entry_id": "7514e788-4241-3806-b095-e80554192776",
                        "glosses": [
                            "zu Slowenien gehörig"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "1c6a7020-9049-3e91-986b-41f613a17f02",
                        "entry_id": "7514e788-4241-3806-b095-e80554192776",
                        "glosses": [
                            "zur Sprache Slowenisch gehörig"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7cd8c196-111c-4d82-86d1-90b08c3b6204",
                                "sense_id": "1c6a7020-9049-3e91-986b-41f613a17f02",
                                "text": "„Vor der ersten Sitzung des Jahres 1871 soll ein italienischer Abgeordneter (Dottori) vorgeschlagen haben, den slovenischen Abgeordneten im Landtag und im Landesausschuß den Gebrauch der slovenischen Sprache zu verwehren.“"
                            },
                            {
                                "example_id": "52568388-1d07-4cc2-9fb2-2fcf9f437779",
                                "sense_id": "1c6a7020-9049-3e91-986b-41f613a17f02",
                                "text": "„Slovenische historische Romane nach dem Zweiten Weltkrieg entwerfen eine Welt, die sich durch nationale und kulturelle Vielfalt auszeichnet.“"
                            },
                            {
                                "example_id": "13181bc3-d82f-4b60-80b5-9aa2c73ff6af",
                                "sense_id": "1c6a7020-9049-3e91-986b-41f613a17f02",
                                "text": "„Der bereits erwähnte Blaž Potočnik ergänzte im Jahre 1858 die zweite, stark überarbeitete Auflage seiner Grammatik um eine slovenische Laut- und Formenlehre nach Miklosich […].“"
