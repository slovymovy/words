                    "sense_id": "30bddd54-fe5f-3d99-b30e-abaad48c6b5d",
                    "sense_definition": "Iemand of iets onverwachts tegenkomen.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "ontmoeten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Op de oude bergpas kon men vele gevaren <w>verwegen</w>.",
                            "target_lang_translations": {
                                "en": "On the old mountain pass, one could <w>encounter</w> many dangers."
                            }
                        },
                        {
                            "text": "Zij hoopten hun oude vrienden onderweg te <w>verwegen</w>.",
                            "target_lang_translations": {
                                "en": "They hoped to <w>meet</w> their old friends along the way."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "verouderd"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To meet someone or encounter something unexpectedly."
                    },
                    "translations": {
