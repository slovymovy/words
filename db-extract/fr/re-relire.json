                ],
                "senses": [
                    {
                        "sense_id": "16d55c86-2274-3f4d-9587-7bd78e4cb2b9",
                        "entry_id": "8c6f0188-c97b-3ef9-8831-fcce8e2417fd",
                        "glosses": [
                            "Relire encore."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc51075e-01f6-40be-a5ff-cdbceaf7789e",
                                "sense_id": "16d55c86-2274-3f4d-9587-7bd78e4cb2b9",
                                "text": "Je n’ai pu m’empêcher de la lire, votre histoire, et de la relire, et de la re-relire d’un bout à l’autre, au point que maintenant je pourrais presque dire que je la sais par cœur !"
                            },
                            {
                                "example_id": "e513bf19-93d5-463a-a461-d7bd88315f20",
                                "sense_id": "16d55c86-2274-3f4d-9587-7bd78e4cb2b9",
                                "text": "Il faut lire, relire, re-relire, et presque apprendre par cœur le discours que prononça André Malraux, dans le vent glacé de cet hiver 1964, sous les yeux d’un De Gaulle plus marmoréen que de coutume."
                            }
                        ]
                    }
