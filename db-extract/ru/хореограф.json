                                    {
                                        "sense_id": "884bba66-0b4a-3001-8a81-1b919dbe1039",
                                        "entry_id": "fbc3a07e-e8b6-39bb-8806-9bd0c8d5ff9c",
                                        "glosses": [
                                            "iemand die balletten en dansfiguren ontwerpt"
                                        ],
                                        "tags": [
                                            "beroep"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2bfeeb5b-d8dd-4317-833c-0b7abafdddd2",
                                                "sense_id": "884bba66-0b4a-3001-8a81-1b919dbe1039",
                                                "text": "Aandacht voor Holland Festival Proms, de afsluiting van het Holland Festival in het Concertgebouw Amsterdam. Terugblik op een dagvullend programma, waarbij componist Merlijn Twaalfhoven en choreograaf Akram Khan te gast zijn."
                                            },
                                            {
                                                "example_id": "3bef0aa6-fac0-4b7c-84bc-55dde55d60b3",
                                                "sense_id": "884bba66-0b4a-3001-8a81-1b919dbe1039",
                                                "text": "`Ik ben Desmond Nowak, ik ben choreograaf, ik werk al een paar jaar bij een dansgezelschap in Montreal.'"
                                            },
                                            {
                                                "example_id": "84956dd0-cbba-4b8d-b96f-3e1135a798f8",
                                                "sense_id": "884bba66-0b4a-3001-8a81-1b919dbe1039",
                                                "text": "De 75-jarige Wiggers, die tevens choreograaf is, richtte Introdans in 1971 op met theatermaker Hans Focking. Het doel was om Oost-Nederland een professioneel dansgezelschap te geven."
                                            }
                                        ]
                                    }
                                ]
                            }
