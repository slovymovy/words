                "senses": [
                    {
                        "sense_id": "d8d7fbc1-e07b-33cd-a70f-755ed9208154",
                        "entry_id": "fd71d52f-5f5e-3670-a2a3-d305681d11e1",
                        "glosses": [
                            "Étude scientifique de l’islam."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5dd89b2c-3b94-45eb-871a-d6d407ffc803",
                                "sense_id": "d8d7fbc1-e07b-33cd-a70f-755ed9208154",
                                "text": "Après des études d’arabe et d’islamologie à l’Université de Heidelberg, Conrad a travaillé dans les ambassades de Beyrouth et de Damas avant de rentrer au BND."
                            },
                            {
                                "example_id": "a8dd8d80-4e6d-4666-b1b3-6ff3d1f30acf",
                                "sense_id": "d8d7fbc1-e07b-33cd-a70f-755ed9208154",
                                "text": "L’université – située en Alsace, où la loi de 1905 ne s’applique pas, en vertu du concordat napoléonien – a déjà mis en place en 2008 un master en islamologie."
                            },
                            {
                                "example_id": "5572cf40-bb6c-4cc5-a269-689085cfd494",
                                "sense_id": "d8d7fbc1-e07b-33cd-a70f-755ed9208154",
                                "text": "Le premier : dialogue de l’Islam sur les islamologies et plus particulièrement certaine islamologie occidentale ou « la mise en question de l’autre que l’islamologie a toujours exercée unilatéralement, faute d’une tête-à-tête »."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fcbdcb8e-f99e-4575-a3fa-0f3bbfb82d4d",
                        "source_entry_id": "fd71d52f-5f5e-3670-a2a3-d305681d11e1",
                        "source_sense_id": "d8d7fbc1-e07b-33cd-a70f-755ed9208154",
                        "target_lang_word": "Islamwissenschaft",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Islamwissenschaft",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d8885b2c-892e-33f7-8a15-8069a60dcd62",
                                        "entry_id": "86877ace-34d1-3f3b-a8b6-185f657f8955",
                                        "glosses": [
                                            "die Lehre vom Islam, seiner heiligen Schrift, dem in arabischer Sprache verfassten Koran, der islamischen Kultur und Geschichte"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05aaec6b-f026-4602-a91f-e4b34d6b8a8c",
                                                "sense_id": "d8885b2c-892e-33f7-8a15-8069a60dcd62",
                                                "text": "Die Islamwissenschaft ist für das Verständnis des Nahen Ostens eine wichtige Disziplin."
                                            },
                                            {
                                                "example_id": "e705be45-146b-41c7-bdcb-acfb6b5ee347",
                                                "sense_id": "d8885b2c-892e-33f7-8a15-8069a60dcd62",
                                                "text": "„Aber mein Vater wollte immer noch, dass ich Islamwissenschaft studiere, um Imam zu werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
