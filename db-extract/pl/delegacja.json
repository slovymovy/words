                "forms": [],
                "senses": [
                    {
                        "sense_id": "d06d311d-6a6f-387a-b90e-19530c419297",
                        "entry_id": "e7894f9d-68d0-3b80-8c93-7b72ef71d721",
                        "glosses": [
                            "wyjazd w sprawach służbowych"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7eda0e6c-1d51-43af-a232-98f97b30a57c",
                                "sense_id": "d06d311d-6a6f-387a-b90e-19530c419297",
                                "text": "Mama pojechała w delegację do Łodzi."
                            },
                            {
                                "example_id": "984daf4f-a4ea-4f78-ac50-3b84a1e9e0e6",
                                "sense_id": "d06d311d-6a6f-387a-b90e-19530c419297",
                                "text": "Jestem w delegacji, utrzymuję kontakt, ale proszę do mnie ciągle nie dzwonić."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "f1522808-eb67-38e6-bd6e-52ccda720b28",
                        "entry_id": "e7894f9d-68d0-3b80-8c93-7b72ef71d721",
                        "glosses": [
                            "grupa osób reprezentująca pewną społeczność"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "03e1d8ae-921b-469e-a9bf-bc4d498b8951",
                                "sense_id": "f1522808-eb67-38e6-bd6e-52ccda720b28",
                                "text": "Delegacja firmy uczestniczyła w rozmowach z władzami miasta."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "fdd13cad-31cc-391e-96c6-fd1d77eba308",
                        "entry_id": "e7894f9d-68d0-3b80-8c93-7b72ef71d721",
                        "glosses": [
                            "częściowe lub całkowite przeniesienie swoich kompetencje na inny organ"
                        ],
                        "tags": [
                            "formal"
                        ],
                        "examples": [
                            {
                                "example_id": "a01bb56e-6fba-4342-ad8a-a9a7f5e12de6",
                                "sense_id": "fdd13cad-31cc-391e-96c6-fd1d77eba308",
                                "text": "Delegacja odbyła się szybko, ale chyba zrozumiałam swoje tymczasowe obowiązki."
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    },
                    {
                        "sense_id": "2ba3afcb-3606-3fe0-bc35-b666faf04e47",
                        "entry_id": "e7894f9d-68d0-3b80-8c93-7b72ef71d721",
                        "glosses": [
                            "dokument potwierdzający delegację (1.1)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f00aed54-79de-4915-930e-a950aeb573d4",
                                "sense_id": "2ba3afcb-3606-3fe0-bc35-b666faf04e47",
                                "text": "Dojechałem, czy może mi Pani podstemplować delegację?"
                            }
                        ],
                        "sense_index_json": "\"1.4\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c2960420-c76f-456d-8562-68d46a19b9f9",
                        "source_entry_id": "e7894f9d-68d0-3b80-8c93-7b72ef71d721",
                        "source_sense_id": "d06d311d-6a6f-387a-b90e-19530c419297",
                        "target_lang_word": "delegation",
