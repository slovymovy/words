                                "target_senses": [
                                    {
                                        "sense_id": "52ce259f-d7a6-3efc-94c2-fe1053b4b91d",
                                        "entry_id": "7318edcd-9e1b-3c5b-b281-80c8b1f9d583",
                                        "glosses": [
                                            "In a pleasant manner; so as to achieve a pleasant result."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "046fc853-fe0c-4053-a0c9-a1bc30964366",
                                                "sense_id": "52ce259f-d7a6-3efc-94c2-fe1053b4b91d",
                                                "text": "He smiled pleasantly at passersby."
                                            },
                                            {
                                                "example_id": "490f1d8d-bd48-46ec-8701-881bbdf95b55",
                                                "sense_id": "52ce259f-d7a6-3efc-94c2-fe1053b4b91d",
                                                "text": "They were pleasantly surprised at the result."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f90d169c-2574-3dc9-90b0-9c86da04dff9",
                                        "entry_id": "7318edcd-9e1b-3c5b-b281-80c8b1f9d583",
                                        "glosses": [
                                            "Lightly"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "10b01372-9dca-3f7c-be15-e731c1c5172f",
                                        "entry_id": "7318edcd-9e1b-3c5b-b281-80c8b1f9d583",
                                        "glosses": [
                                            "Ludicrously; facetiously."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "37e76f5c-1a0f-407d-b67a-7c5a8538377b",
                                                "sense_id": "10b01372-9dca-3f7c-be15-e731c1c5172f",
                                                "text": "In workhouses, pleasantly so named, because work cannot be done in them."
                                            },
                                            {
                                                "example_id": "389bf3c6-5c3e-417a-86c0-97c7326d6681",
                                                "sense_id": "10b01372-9dca-3f7c-be15-e731c1c5172f",
                                                "text": "Mr Venus, reminded of the duties of hospitality, produced some rum. In answer to the inquiry, 'Will you mix it, Mr Wegg?' that gentleman pleasantly rejoined, 'I think not, sir. On so auspicious an occasion, I prefer to take it in the form of a Gum-Tickler.'"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e083be0b-105c-458e-b5b3-40b05bf6342c",
