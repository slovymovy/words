                "senses": [
                    {
                        "sense_id": "d212efcb-bbfb-31d0-9ce7-4a479cc83204",
                        "entry_id": "ab7b66b7-0cbe-39ce-8b45-1346d4fd9f8b",
                        "glosses": [
                            "een onderdaan die tot het dagelijkse gezelschap van een vorst behoort"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "641b822d-bdbc-44c5-9bad-52c4cc261751",
                                "sense_id": "d212efcb-bbfb-31d0-9ce7-4a479cc83204",
                                "text": "Vroeger had bijna iedere vorst een hoveling."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "862b26db-94a9-40d2-ac7d-459a99072336",
                        "source_entry_id": "ab7b66b7-0cbe-39ce-8b45-1346d4fd9f8b",
                        "source_sense_id": "d212efcb-bbfb-31d0-9ce7-4a479cc83204",
                        "source_sense_description": "een onderdaan die tot het dagelijkse gezelschap van een vorst behoort",
                        "target_lang_word": "Höfling",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Höfling",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "083a7048-03e4-3518-85b0-90d315516670",
                                        "entry_id": "1b049dbd-f107-34e8-86a8-1624c56f385c",
                                        "glosses": [
                                            "historisch, heute abwertend: Person, die zum Hofpersonal eines Herrschers gehört"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74619c17-638d-46b6-9447-a6de22a55d9e",
                                                "sense_id": "083a7048-03e4-3518-85b0-90d315516670",
                                                "text": "„Zudem muss Basileios seinen Höflingen misstrauen - etliche seiner Vorgänger sind durch Gift gestorben oder von Verschwörern gestürzt worden.“"
                                            },
                                            {
                                                "example_id": "91fd5362-4a7a-465f-a288-e6b5d1dccc5c",
                                                "sense_id": "083a7048-03e4-3518-85b0-90d315516670",
                                                "text": "„Einige Höflinge spielten den Briten insgeheim Informationen aus der Stadt zu.“"
                                            },
                                            {
                                                "example_id": "36ccb751-1b66-4671-ab37-c1e2b8e7ab1d",
                                                "sense_id": "083a7048-03e4-3518-85b0-90d315516670",
                                                "text": "„Vielleicht 50000 Menschen teilen sich die Hälfte dieser Stadt, die andere ist dem König mit seinem Palast und den wohl etwa 1000 Frauen, Kindern, Eunuchen, Höflingen und Wächtern vorbehalten.“"
                                            },
                                            {
                                                "example_id": "c50a3a54-2b4d-4999-907a-4fa6f6f25d3a",
                                                "sense_id": "083a7048-03e4-3518-85b0-90d315516670",
                                                "text": "„Die Pelliccia hätte gern von einem der vornehmsten Höflinge einen Empfehlungsbrief für diese Stadt erhalten; da sie aber keinen kannte, fragte sie mich, ob sie den venezianischen Gesandten bitten könne, sich ihrer anzunehmen und jemanden um einen Brief zu ersuchen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "765c73eb-cd73-4ad6-8a62-3afbbaa2eae8",
                        "source_entry_id": "ab7b66b7-0cbe-39ce-8b45-1346d4fd9f8b",
                        "source_sense_id": "d212efcb-bbfb-31d0-9ce7-4a479cc83204",
                        "source_sense_description": "een onderdaan die tot het dagelijkse gezelschap van een vorst behoort",
                        "target_lang_word": "courtier",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "courtier",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "68143730-edba-3be8-a000-228db5cf6fa8",
                                        "entry_id": "69362c23-ef88-3dc0-b351-9096178d964e",
                                        "glosses": [
                                            "A person in attendance at a royal court."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a3d2814-dd7a-4361-81b8-a9f1b2e23413",
                                                "sense_id": "68143730-edba-3be8-a000-228db5cf6fa8",
                                                "text": "By the Lord, Horatio, this three years I have taken note of it, the age is grown so picked that the toe of the peasant comes so near the heel of the courtier he galls his kibe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ef252ae2-2f55-38cc-8bad-f6232873ff9a",
                                        "entry_id": "69362c23-ef88-3dc0-b351-9096178d964e",
                                        "glosses": [
                                            "A person who flatters in order to seek favour."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7325b74b-79b5-452c-ac6c-e79c9f087bfc",
                                                "sense_id": "ef252ae2-2f55-38cc-8bad-f6232873ff9a",
                                                "text": "People shouted cheerfully and flinched, but the Prime Minister didn't flinch, she fortified her voice with a firm diapason as if rising to the challenge of a rowdy Chamber. Around her her courtiers started like pheasants."
                                            },
                                            {
                                                "example_id": "6ab65732-a2ba-492e-96a1-0983138231d5",
                                                "sense_id": "ef252ae2-2f55-38cc-8bad-f6232873ff9a",
                                                "text": "The world’s richest person, not known for his humility, is still learning the cutthroat courtier politics of Donald Trump’s inner circle — and his ultimate influence remains an open question."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "81ff811f-55f9-311f-b6ac-94619565a68d",
                                        "entry_id": "69362c23-ef88-3dc0-b351-9096178d964e",
                                        "glosses": [
                                            "Any of various nymphalid butterflies of the Asian genus Sephisa."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a9bcc3be-5d8d-48ce-99cc-682f430d256e",
                        "source_entry_id": "ab7b66b7-0cbe-39ce-8b45-1346d4fd9f8b",
                        "source_sense_id": "d212efcb-bbfb-31d0-9ce7-4a479cc83204",
                        "source_sense_description": "een onderdaan die tot het dagelijkse gezelschap van een vorst behoort",
                        "target_lang_word": "courtisan",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "courtisan",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ee9daebb-2616-3f45-82e7-8fcf73c1fa17",
                                        "entry_id": "ec6d49ea-3b65-30f9-8fce-960e85d05aed",
                                        "glosses": [
                                            "Qui relève de la courtisanerie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5dbeab35-41a6-464c-9687-f52904890362",
                                                "sense_id": "ee9daebb-2616-3f45-82e7-8fcf73c1fa17",
                                                "text": "Il a l’esprit courtisan."
                                            },
                                            {
                                                "example_id": "2fc67c4c-7fbd-4386-a617-b3501c0fc41e",
                                                "sense_id": "ee9daebb-2616-3f45-82e7-8fcf73c1fa17",
                                                "text": "Donc à si peu de frais la vertu se profane,\nSe déguise, se masque et devient courtisane,\nSe transforme aux humeurs, suit le cours du marché,\nEt dispense les gens de blâme et de péché."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "courtisan",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "47d492bf-c3ca-3303-9dca-4cd5c25a89a7",
                                        "entry_id": "f6340d79-5488-3f22-837d-0e34450ca571",
                                        "glosses": [
                                            "Celui qui est attaché à la cour, au service d’un souverain, qui fréquente la cour d’un souverain, d’un roi, d’un prince."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1db4f91-7b70-4c27-9d73-0af9c4c5beae",
                                                "sense_id": "47d492bf-c3ca-3303-9dca-4cd5c25a89a7",
                                                "text": "Un courtisan est un homme de la cour du roi, j’entends un homme qui a une charge ou un emploi domestique dans le palais, qui est le premier écuyer, chambellan, grand veneur, qui à ce titre reçoit de l’argent, et parle au maître avec tout le respect obséquieux, avec toutes les humbles salutations convenables à l’emploi. Mais il n’est pas un simple valet, comme dans les monarchies orientales."
                                            },
                                            {
                                                "example_id": "7cce6cd4-da34-4ee7-971c-295834ac09b4",
                                                "sense_id": "47d492bf-c3ca-3303-9dca-4cd5c25a89a7",
                                                "text": "Le duc se retira comme à regret en emportant une invitation de venir au Chalet tous les soirs, fondée sur l’impossibilité reconnue à un courtisan de Charles X de passer une soirée sans faire son whist."
                                            },
                                            {
                                                "example_id": "30d8627e-35b3-4853-81c6-84eedb9e62f0",
                                                "sense_id": "47d492bf-c3ca-3303-9dca-4cd5c25a89a7",
                                                "text": "En vain les courtisans joyeux espéraient qu’avec quelques décharges on pourrait réduire au silence, ces braillards, ces bourgeois et ces ouvriers qui voulaient des réformes ; en vain les beaux seigneurs de la cour se frottaient les mains."
                                            },
                                            {
                                                "example_id": "f3232aed-dae0-4812-ac30-e91b8ece57ac",
                                                "sense_id": "47d492bf-c3ca-3303-9dca-4cd5c25a89a7",
                                                "text": "Messieurs les courtisans, cessez de vous détruire : Faites, si vous pouvez, votre cour sans vous nuire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ac39086c-f0f7-3687-8656-786a78620cd8",
                                        "entry_id": "f6340d79-5488-3f22-837d-0e34450ca571",
                                        "glosses": [
                                            "Celui qui courtise quelqu’un, qui cherche à plaire aux puissants, aux gens qui ont de l’influence, pour en obtenir quelque chose, et cela par des manières obséquieuses et flatteuses."
                                        ],
                                        "tags": [
                                            "Apparu en 1560"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "45eab5ff-0b59-47f9-a738-fd75ccba740d",
                                                "sense_id": "ac39086c-f0f7-3687-8656-786a78620cd8",
                                                "text": "Je me rejette sur les bonbons et je les lèche. Mais ma mère ne veut pas que j’aie des manières de courtisan : « On commence par lécher le ventre des bonbons, on finit par lécher… » Elle s’arrête, et se tourne vers mon père pour voir s’il pense comme elle, et s’il sait de quoi elle veut parler ; — en effet, il se penche et montre qu’il comprend."
                                            },
                                            {
                                                "example_id": "2d81fc1b-50e5-440c-92cf-c71505fa1e95",
                                                "sense_id": "ac39086c-f0f7-3687-8656-786a78620cd8",
                                                "text": "Tous ces courtisans, profiteurs et forniqueurs dans les bureaux où les climatiseurs ne s’arrêtaient jamais de ronronner, trouvèrent au Président Bagabaga Daba des qualités telles que ses ancêtres durent se retourner dans leur tombe."
                                            },
                                            {
                                                "example_id": "aecb157d-b8ce-42e7-a96c-50a773358ff7",
                                                "sense_id": "ac39086c-f0f7-3687-8656-786a78620cd8",
                                                "text": "L’homme riche a des commensaux ou des parasites, l’homme puissant à des courtisans."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a02ae951-8503-3f2f-bd72-f339717cc9f2",
                                        "entry_id": "f6340d79-5488-3f22-837d-0e34450ca571",
                                        "glosses": [
                                            "Celui qui par des manières flatteuses, recherche les faveurs d’une femme."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2b8bc9ae-ca86-3d47-ae09-317e3f0ee538",
                                        "entry_id": "f6340d79-5488-3f22-837d-0e34450ca571",
                                        "glosses": [
                                            "Homme galant de profession ; prostitué."
                                        ],
                                        "tags": [
                                            "formal",
                                            "pejorative",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "986ce24a-e956-4672-8c59-75410ad52b04",
                                                "sense_id": "2b8bc9ae-ca86-3d47-ae09-317e3f0ee538",
                                                "text": "Une loi athénienne prive de leur droit d’isegoria (Eschine, I, 28) celui qui a frappé ou négligé ses parents, celui qui n’a pas pris part aux expéditions militaires ou a jeté son bouclier, celui qui s’est conduit en prostitué (pornos) ou en « courtisan » (hetairikôs), celui qui a dévoré les biens de ses parents ou tout autre héritage."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
