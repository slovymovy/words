                        "entry_id": "0dd58be8-fbdd-3b73-a096-b6651f156af2",
                        "glosses": [
                            "situatie waarin betrokkenen met elkaar wedijveren en binnen gestelde regels proberen elkaar af te troeven"
                        ],
                        "tags": [
