                                "es": "Quería decir algo, pero de repente se <w>detuvo</w>.",
                                "fr": "Il voulait dire quelque chose, mais il <w>s'est</w> soudainement <w>arrêté</w>.",
                                "nl": "Hij wilde iets zeggen, maar <w>stopte</w> plotseling.",
                                "pl": "Chciał coś powiedzieć, ale nagle <w>przestał</w>.",
                                "de": "Er wollte etwas sagen, aber plötzlich <w>hörte</w> er <w>auf</w>.",
                                "it": "Voleva dire qualcosa, ma all'improvviso <w>si è fermato</w>.",
                                "cs": "Chtěl něco říct, ale náhle <w>přestal</w>.",
                                "tr": "Bir şey söylemek istedi ama aniden <w>durdu</w>.",
                                "zh": "他想说什么，但突然<w>停下</w>了。"
                            }
                        },
                        {
                            "text": "Пожалуйста, <w>остановись</w> и послушай меня.",
                            "target_lang_translations": {
                                "en": "Please <w>stop</w> and listen to me.",
                                "es": "Por favor, <w>para</w> y escúchame.",
                                "fr": "S'il te plaît, <w>arrête-toi</w> et écoute-moi.",
                                "nl": "Alsjeblieft, <w>stop</w> en luister naar me.",
                                "pl": "Proszę, <w>zatrzymaj się</w> i posłuchaj mnie.",
                                "de": "Bitte <w>hör auf</w> und hör mir zu.",
                                "it": "Per favore, <w>fermati</w> e ascoltami.",
                                "cs": "Prosím, <w>přestaň</w> a poslouchej mě.",
                                "tr": "Lütfen <w>dur</w> ve beni dinle.",
                                "zh": "请<w>停止</w>说话，听我说。"
                            }
