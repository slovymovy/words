                ],
                "senses": [
                    {
                        "sense_id": "6ea352fe-b616-33d8-a9f1-fe8ffcdb47f4",
                        "entry_id": "c510d594-48fd-352d-944e-c59ec5aac8cf",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f54eee20-4b3a-4402-8f74-869a2bc39724",
                                "sense_id": "6ea352fe-b616-33d8-a9f1-fe8ffcdb47f4",
                                "text": "Frau Ditsch ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "2877aa6e-e43d-436e-b6af-997f9ad5db54",
                                "sense_id": "6ea352fe-b616-33d8-a9f1-fe8ffcdb47f4",
                                "text": "Herr Ditsch wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "9ab681ad-254a-4c18-8a6f-2d3bd2219b60",
                                "sense_id": "6ea352fe-b616-33d8-a9f1-fe8ffcdb47f4",
                                "text": "Die Ditschs fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "e09cfb5f-a13d-49b7-a99e-47419cc5501c",
                                "sense_id": "6ea352fe-b616-33d8-a9f1-fe8ffcdb47f4",
                                "text": "Der Ditsch trägt nie die Schals, die die Ditsch ihm strickt."
                            },
                            {
                                "example_id": "00d55e76-0116-4312-9df3-ff8b37b60284",
                                "sense_id": "6ea352fe-b616-33d8-a9f1-fe8ffcdb47f4",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Ditsch kommt, geht der Herr Ditsch.“"
                            },
                            {
                                "example_id": "5c7d9648-75a2-4fce-91e3-9ec7345fadaa",
                                "sense_id": "6ea352fe-b616-33d8-a9f1-fe8ffcdb47f4",
                                "text": "Ditsch kommt und geht."
                            },
                            {
                                "example_id": "e159f267-06fe-4af9-9600-85129842464c",
                                "sense_id": "6ea352fe-b616-33d8-a9f1-fe8ffcdb47f4",
                                "text": "Ditschs kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
