    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "525b19af-ab61-3ed3-86ea-d3fc27f996fb",
                "word": "fanboy",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "d169b6f5-021d-4d1a-8544-cbf8c06499e0",
                        "entry_id": "525b19af-ab61-3ed3-86ea-d3fc27f996fb",
                        "tags": [
                            "plural"
                        ],
                        "form": "fanboys"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4e4cb22e-176f-327f-af9a-57a8d64fa1ec",
                        "entry_id": "525b19af-ab61-3ed3-86ea-d3fc27f996fb",
                        "glosses": [
                            "A male fan who is obsessive about a particular subject (especially, something or someone in popular entertainment media)."
                        ],
                        "tags": [
                            "derogatory",
                            "often",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "bccdb496-e7dd-42d1-948d-55e1ecf0e2f0",
                                "sense_id": "4e4cb22e-176f-327f-af9a-57a8d64fa1ec",
                                "text": "(It's in the nature of comic book fanboy obsessiveness that all of these Eras and Ages and such have been religiously chronicled; it's equally in their nature that no two fanboys can ever agree about anything about any of these Ages and Eras; everything is up for debate, eternally and in microscopic detail.)"
                            },
                            {
                                "example_id": "a834457c-25cb-4bb5-983f-2c4801d5fab3",
                                "sense_id": "4e4cb22e-176f-327f-af9a-57a8d64fa1ec",
                                "text": "Six years and seven titles later, their company, Top Cow, is the third-biggest-grossing comic line, thanks mainly to a pair of blood-soaked, modern-day Gothics that have been a hit both with fanboys and a growing number of women."
                            },
                            {
                                "example_id": "8ee85c4e-a986-4534-b7a2-6e2c646207bd",
                                "sense_id": "4e4cb22e-176f-327f-af9a-57a8d64fa1ec",
                                "text": "Apple fanboys have always devoted equal parts of their mind to genuine reasons to praise their chosen corporation, and to blindly ignoring its faults."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9b0ae239-65be-42dc-b26e-d5fb61ff66b9",
                        "source_entry_id": "525b19af-ab61-3ed3-86ea-d3fc27f996fb",
                        "source_sense_id": "4e4cb22e-176f-327f-af9a-57a8d64fa1ec",
                        "source_sense_description": "someone devoted to a single subject",
                        "target_lang_word": "Jünger",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Jünger",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fb0f8fe3-9ec9-3aec-87e4-0375f9ee317e",
                                        "entry_id": "153093d1-c9c8-35da-97a3-4b26416d4474",
                                        "glosses": [
                                            "einer der zunächst zwölf Männer, die Schüler und Anhänger von Jesus waren und die später als Apostel das Evangelium verkündeten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6083dcfe-7fe7-453a-bf2c-65b1a6add4a6",
                                                "sense_id": "fb0f8fe3-9ec9-3aec-87e4-0375f9ee317e",
                                                "text": "Dieses Gemälde zeigt Jesus Christus im Kreise seiner Jünger."
                                            },
                                            {
                                                "example_id": "d70dba89-93d0-4e89-9bf0-3e7ec868f594",
                                                "sense_id": "fb0f8fe3-9ec9-3aec-87e4-0375f9ee317e",
                                                "text": "„Aber die elf Jünger gingen nach Galiläa auf den Berg, wohin Jesus sie beschieden hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4ee33817-71b1-35d3-a85a-9d949d9279e7",
                                        "entry_id": "153093d1-c9c8-35da-97a3-4b26416d4474",
                                        "glosses": [
                                            "jemand, der von einer Sache oder einer Person überzeugt ist und dieser anhängt; jemand, der ein Schüler einer Person ist"
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5448dd92-564e-4206-be4d-b67f04b5251c",
                                                "sense_id": "4ee33817-71b1-35d3-a85a-9d949d9279e7",
                                                "text": "Ich bin nicht hier, um Jünger für meine Lehren anzuwerben."
                                            },
                                            {
                                                "example_id": "101a7d49-c261-4ae8-8b7d-cc277ae38e9f",
                                                "sense_id": "4ee33817-71b1-35d3-a85a-9d949d9279e7",
                                                "text": "Der Professor betrat den Hörsaal und hinter ihm trotteten seine Jünger einher."
                                            },
                                            {
                                                "example_id": "1a553167-be4a-46f6-929b-41b3989e48b6",
                                                "sense_id": "4ee33817-71b1-35d3-a85a-9d949d9279e7",
                                                "text": "„Die Zahl seiner Jünger wächst stetig, aus der ganzen Welt pilgern sie mittlerweile auf den Entoto.“"
                                            },
                                            {
                                                "example_id": "217a6897-8dd2-4d3d-9f9c-91e66f8841cd",
                                                "sense_id": "4ee33817-71b1-35d3-a85a-9d949d9279e7",
                                                "text": "„Nach Todtnauberg fahren seit fast vierzig Jahren seine Jünger und pilgern zur Hütte, die an einem Sonnenhang steht.“"
                                            },
                                            {
                                                "example_id": "d0a7962c-9365-48e2-ba22-a89da701f145",
                                                "sense_id": "4ee33817-71b1-35d3-a85a-9d949d9279e7",
                                                "text": "„Er nahm Maß und legte mir Tuchmuster vor; ich traf meine Wahl, und bereits am nächsten Tag brachte er mir alles, was ich brauchte, um als Jünger des Kriegsgottes aufzutreten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
