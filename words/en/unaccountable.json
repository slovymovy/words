            "senses": [
                {
                    "sense_id": "ae427e00-b877-3d9f-90a9-643c6b04f1e7",
                    "sense_definition": "Impossible to explain, understand, or account for; inexplicable.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "inexplicable",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "For some <w>unaccountable</w> reason, the lights in the entire building suddenly went out."
                        },
                        {
                            "text": "His sudden change of mood was completely <w>unaccountable</w> to his colleagues."
                        }
                    ],
                    "synonyms": [
                        "inexplicable",
                        "incomprehensible",
                        "unfathomable"
                    ],
                    "antonyms": [
                        "accountable",
                        "explicable",
                        "understandable"
                    ],
                    "common_phrases": [
                        "for some unaccountable reason",
                        "unaccountable delay"
                    ]
                },
                {
                    "sense_id": "664b0aa0-11cb-3a90-9fed-f08cc2bb4faf",
                    "sense_definition": "Not required to explain or justify one's actions; not subject to external authority, control, or responsibility.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "irresponsible",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Citizens worried that the powerful intelligence agencies were virtually <w>unaccountable</w> to the public."
                        },
                        {
                            "text": "The committee warned against leaving government officials <w>unaccountable</w> for serious policy failures."
                        }
                    ],
                    "synonyms": [
                        "irresponsible",
                        "answerable to no one"
                    ],
                    "antonyms": [
                        "accountable",
                        "answerable",
                        "responsible"
                    ],
                    "common_phrases": [
                        "unaccountable officials",
                        "unaccountable bureaucracy",
                        "unaccountable to the public"
                    ]
                }
            ]
        }
    ]
