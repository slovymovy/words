{
    "word_family": [
        "scowler"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0109a4f6-7299-3b93-b819-0cc728c82cd7",
                    "sense_definition": "The expression of displeasure or anger by wrinkling the brows.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "facial_expression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She had a dark <w>scowl</w> on her face when she heard the bad news.",
                            "target_lang_translations": {
                                "zh": "听到坏消息时，她脸上带着<w>怒容</w>。"
                            }
                        },
                        {
                            "text": "He tried to hide his <w>scowl</w> behind a fake smile.",
                            "target_lang_translations": {
                                "zh": "他试图用虚假的笑容掩盖自己的<w>怒容</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "frown",
                        "glower"
                    ],
                    "antonyms": [
                        "smile",
                        "grin"
                    ],
                    "common_phrases": [
                        "angry scowl"
                    ],
                    "target_lang_definitions": {
                        "zh": "因不满或愤怒而皱眉的表情。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "怒容",
                                "target_lang_sense_clarification": "指愤怒的表情。"
                            },
                            {
                                "target_lang_word": "皱眉",
                                "target_lang_sense_clarification": "指皱眉的动作或表情。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1dd1b73e-1798-3f04-9c68-7e629441782d",
                    "sense_definition": "A gloomy or threatening appearance.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "gloom",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The storm clouds gathered with a menacing <w>scowl</w> over the valley.",
                            "target_lang_translations": {
                                "zh": "乌云在山谷上空聚集，呈现出一副<w>阴沉</w>的威胁姿态。"
                            }
                        },
                        {
                            "text": "The old house had a dark <w>scowl</w> that made visitors feel unwelcome.",
                            "target_lang_translations": {
                                "zh": "这座老房子外观<w>阴沉</w>，让访客感到不受欢迎。"
                            }
                        }
                    ],
                    "synonyms": [
                        "gloom",
                        "menace"
                    ],
                    "target_lang_definitions": {
                        "zh": "阴沉或具有威胁性的外观。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "阴沉",
                                "target_lang_sense_clarification": "形容天气或环境压抑、阴暗。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a99311da-b103-30b1-994c-576a03ba3abd",
                    "sense_definition": "Abandoned or old mining areas for iron ore.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mining",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hikers explored the dangerous <w>scowl</w> left behind by the nineteenth-century miners.",
                            "target_lang_translations": {
                                "zh": "徒步旅行者探索了十九世纪矿工留下的危险<w>废弃矿坑</w>。"
                            }
                        },
                        {
                            "text": "Local maps still mark the location of the ancient iron <w>scowl</w>.",
                            "target_lang_translations": {
                                "zh": "当地地图上仍标有古老铁<w>废弃矿坑</w>的位置。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Used in mining contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "废弃或古老的铁矿开采区。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "废弃矿坑",
                                "target_lang_sense_clarification": "指不再使用的矿区。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c3c9f859-aa7e-3fa0-92b5-fdc6f88dcd12",
                    "sense_definition": "To wrinkle the brows to show displeasure or anger.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "facial_expression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He began to <w>scowl</w> when he realized he had lost the game.",
                            "target_lang_translations": {
                                "zh": "当意识到自己输掉比赛时，他开始<w>皱眉</w>。"
                            }
                        },
                        {
                            "text": "Do not <w>scowl</w> at me just because you are having a bad day.",
                            "target_lang_translations": {
                                "zh": "别因为你今天过得不顺就对我<w>怒视</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "frown",
                        "glower"
                    ],
                    "antonyms": [
                        "smile",
                        "grin"
                    ],
                    "common_phrases": [
                        "scowl at"
                    ],
                    "target_lang_definitions": {
                        "zh": "皱眉以表示不满或愤怒。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "皱眉",
                                "target_lang_sense_clarification": "表示不悦的动作。"
                            },
                            {
                                "target_lang_word": "怒视",
                                "target_lang_sense_clarification": "带有愤怒情绪的注视。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "93ff47a8-6238-344d-b762-f2e0afba2f9d",
                    "sense_definition": "To appear dark, gloomy, or threatening.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "gloom",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dark clouds began to <w>scowl</w> over the horizon before the rain started.",
                            "target_lang_translations": {
                                "zh": "下雨前，乌云开始在地平线上空变得<w>阴沉</w>。"
                            }
                        },
                        {
                            "text": "The mountains seemed to <w>scowl</w> down upon the small village below.",
                            "target_lang_translations": {
                                "zh": "群山似乎正<w>阴沉</w>地俯视着下方的小村庄。"
                            }
                        }
                    ],
                    "synonyms": [
                        "lower",
                        "threaten"
                    ],
                    "target_lang_definitions": {
                        "zh": "显得阴暗、阴沉或具有威胁性。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "阴沉",
                                "target_lang_sense_clarification": "形容景象压抑。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5e0fb788-c374-3471-87ae-81d36e87df22",
                    "sense_definition": "To look at someone in a way that makes them feel unwelcome or intimidated.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "facial_expression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She managed to <w>scowl</w> her opponent into silence during the debate.",
                            "target_lang_translations": {
                                "zh": "在辩论中，她成功地用<w>怒视</w>让对手沉默了。"
                            }
                        },
                        {
                            "text": "The guard would <w>scowl</w> anyone who tried to enter the restricted area.",
                            "target_lang_translations": {
                                "zh": "警卫会对任何试图进入禁区的人进行<w>怒视</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "intimidate",
                        "frown"
                    ],
                    "target_lang_definitions": {
                        "zh": "以一种让人感到不受欢迎或受恐吓的方式注视某人。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "怒视",
                                "target_lang_sense_clarification": "通过眼神使人感到压力。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9aa10b3a-1382-3fbf-ac23-d2603795c7bb",
                    "sense_definition": "To communicate a feeling or attitude through a facial expression.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "facial_expression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He could only <w>scowl</w> his frustration when the plan failed again.",
                            "target_lang_translations": {
                                "zh": "当计划再次失败时，他只能通过皱眉来<w>流露</w>他的挫败感。"
                            }
                        },
                        {
                            "text": "The prisoner continued to <w>scowl</w> his defiance at the judge.",
                            "target_lang_translations": {
                                "zh": "囚犯继续向法官<w>流露</w>出他的蔑视。"
                            }
                        }
                    ],
                    "synonyms": [
                        "express"
                    ],
                    "common_phrases": [
                        "scowl defiance"
                    ],
                    "target_lang_definitions": {
                        "zh": "通过面部表情传达某种感觉或态度。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "流露",
                                "target_lang_sense_clarification": "指通过表情表达情绪。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}