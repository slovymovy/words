                ],
                "senses": [
                    {
                        "sense_id": "29440319-fe21-3ab5-82f2-73a88ee977dd",
                        "entry_id": "198f54eb-24b6-352c-a550-a3bc12d0bd52",
                        "glosses": [
                            "Transponder im Eisenbahngleis, der bahnbetriebliche Informationen speichert und sie an Schienenfahrzeuge weitergibt, die ihn passieren."
                        ],
                        "tags": [
                            "Zugkontrollsystem"
                        ],
                        "examples": [
                            {
                                "example_id": "f79f8b4b-64c7-4f30-be83-e06d06e2329d",
                                "sense_id": "29440319-fe21-3ab5-82f2-73a88ee977dd",
                                "text": "„Es gibt Balisen mit unveränderlichem und mit veränderlichem Dateninhalt. Bei letzterer kann über eine Kabelverbindung bestimmt werden, welcher der in der Balise abgelegten Dateninhalte bei einer Zugüberfahrt abgesandt wird.“"
                            },
                            {
                                "example_id": "82996448-472c-46ba-8c81-6d29b806eb0f",
                                "sense_id": "29440319-fe21-3ab5-82f2-73a88ee977dd",
                                "text": "„Das neue elektronische System soll das Sicherheitsniveau erhöhen. Das ZBS bedient sich einiger Elemente des auf europäischer Ebene standardisierten Zugbeeinflussungssystems ETCS Level 1, bei der die ZBS-Balisen technisch Eurobalisen sind, wodurch auch die fahrzeugseitige Technik aus erprobten, bisher für ETCS entwickelten Systemen abgeleitet werden kann.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c7dce9ae-5524-4c27-9c36-fbc09985b085",
                        "source_entry_id": "198f54eb-24b6-352c-a550-a3bc12d0bd52",
                        "source_sense_id": "29440319-fe21-3ab5-82f2-73a88ee977dd",
                        "source_sense_description": "Transponder im Eisenbahngleis",
