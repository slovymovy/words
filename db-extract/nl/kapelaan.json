                    }
                ],
                "translations": [
                    {
                        "translation_id": "a09bedd5-413e-4ded-9b42-bb228c0ef124",
                        "source_entry_id": "47349bfc-9aa8-34dc-a666-72ea517c1ef5",
                        "source_sense_id": "624a0ba3-ad29-3b86-b71b-c6cba0d50db9",
                        "source_sense_description": "een priester van de katholieke kerk, werkzaam in een parochie",
                        "target_lang_word": "Kaplan",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kaplan",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cf01f1a4-a477-3710-98c6-215167248ece",
                                        "entry_id": "a795bbc0-6742-3f9c-ab3e-dcb3a50c4415",
                                        "glosses": [
                                            "Geistlicher, der für eine spezielle Einrichtung (zum Beispiel eine Kapelle) zuständig ist, oder der nach der Priesterweihe zunächst einem Pfarrer zugeordnet ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb80402a-79bd-4a38-9581-28ad6ecf004e",
                                                "sense_id": "cf01f1a4-a477-3710-98c6-215167248ece",
                                                "text": "Die Lehrer, so wie auch der Kaplan beim Frauenkloster werden vom Rathe, der Pfarrer und Leutpriester bei der Pfarrkirche werden von der Gemeinde bestellt, und von dem Stifte Münster bestätigt."
                                            },
                                            {
                                                "example_id": "ae30a6a1-93cd-46fe-a319-87c60823b134",
                                                "sense_id": "cf01f1a4-a477-3710-98c6-215167248ece",
                                                "text": "So predigten in Ulm nicht nur der Pfarrer und der Münsterprädikant, sondern auch der Spitalpfarrer und der Kaplan der Kapelle des Spitals zu den armen Siechen."
                                            },
                                            {
                                                "example_id": "26ff6f54-1dbe-47ca-99e4-db22d38f82bc",
                                                "sense_id": "cf01f1a4-a477-3710-98c6-215167248ece",
                                                "text": "In vielen katholischen Gemeinden gibt es einen Kaplan."
                                            },
                                            {
                                                "example_id": "f5901192-53b5-4847-b4e0-a48c32a84447",
                                                "sense_id": "cf01f1a4-a477-3710-98c6-215167248ece",
                                                "text": "Er studierte Philosophie, Theologie und Kunstgeschichte in München, empfing 1905 die Priesterweihe und war dann als Kaplan tätig."
                                            },
                                            {
                                                "example_id": "b4b5292a-1347-42e6-8594-94dc5d37f847",
                                                "sense_id": "cf01f1a4-a477-3710-98c6-215167248ece",
                                                "text": "Er wurde im Dome zu Augsburg zum Priester geweiht und gleich darauf als Kaplan nach Haidhausen gesendet."
                                            },
                                            {
                                                "example_id": "cd9590a6-3144-484b-a13d-54bf02ca5f45",
                                                "sense_id": "cf01f1a4-a477-3710-98c6-215167248ece",
                                                "text": "„Wir wohnten nahe an der Kirche, an der Heinrich Behlen Kaplan war, und er hatte mir dieses Sälchen mit Bühne als Trainingsmöglichkeit besorgt, auch das Zimmer in der Pension.“"
                                            },
                                            {
                                                "example_id": "6c0eacf7-0c3e-4ae8-affc-ca20702e743b",
                                                "sense_id": "cf01f1a4-a477-3710-98c6-215167248ece",
                                                "text": "„Im Vergleich von Kaplan und Pastor zeigen sich Unterschiede in der Einschätzung des Anredeverhaltens.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Kaplan",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f8759c2a-cbc3-3687-ae32-b19cf33fe4a2",
                                        "entry_id": "990f3f36-ffa8-35da-86ba-7be15ae879ad",
                                        "glosses": [
                                            "deutschsprachiger Nachname, Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8bd77262-2fb7-4eb3-ac6f-c3361c7be847",
                                                "sense_id": "f8759c2a-cbc3-3687-ae32-b19cf33fe4a2",
                                                "text": "Frau Kaplan ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "ab6d1ba3-ddbc-403e-a2d9-6817012593a0",
                                                "sense_id": "f8759c2a-cbc3-3687-ae32-b19cf33fe4a2",
                                                "text": "Herr Kaplan wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "a6d11b95-ed9e-4185-a164-4404ca754ad5",
                                                "sense_id": "f8759c2a-cbc3-3687-ae32-b19cf33fe4a2",
                                                "text": "Die Kaplans fliegen heute nach La Paz."
                                            },
                                            {
                                                "example_id": "32339135-e77d-436d-ab2d-ebbe2d3d439a",
                                                "sense_id": "f8759c2a-cbc3-3687-ae32-b19cf33fe4a2",
                                                "text": "Der Kaplan trägt nie die Schals, die die Kaplan ihm strickt."
                                            },
                                            {
                                                "example_id": "369e3fde-e145-44c3-a7f8-6a9c0a13205a",
                                                "sense_id": "f8759c2a-cbc3-3687-ae32-b19cf33fe4a2",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Kaplan kommt, geht der Herr Kaplan.“"
                                            },
                                            {
                                                "example_id": "43a6457f-7219-44c1-8576-8112f70c6685",
                                                "sense_id": "f8759c2a-cbc3-3687-ae32-b19cf33fe4a2",
                                                "text": "Kaplan kommt und geht."
                                            },
                                            {
                                                "example_id": "aacd8675-4e51-44c6-94e8-c86ae6e92c3d",
                                                "sense_id": "f8759c2a-cbc3-3687-ae32-b19cf33fe4a2",
                                                "text": "Kaplans kamen, sahen und siegten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "33435f2b-f6e6-35d9-a119-9b527b038bdd",
