                    {
                        "translation_id": "d23de2ff-a8f7-4ef6-bf2e-03b3bf84237e",
                        "source_entry_id": "158e6575-269a-34aa-96e2-589309e4772e",
                        "source_sense_description": "business: to reduce sales or market share of product by introducing another",
                        "target_lang_word": "kannibalisieren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kannibalisieren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "20967a8b-5e27-3dce-8f2a-35a1991d4eea",
                                        "entry_id": "9e47457c-1152-3ebb-b7a0-5fdbb7070873",
                                        "glosses": [
                                            "etwas, zum Beispiel Kunden oder Marktanteile, (kurzfristig) für sich gewinnen, ohne Rücksicht auf die Methoden, die das ganze System oder einzelne Mitbewerber oder Marken zerstören können; extensiv auf Kosten anderer wachsen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b48a6cbe-59a3-421f-9ebd-e86b48e893c1",
                                                "sense_id": "20967a8b-5e27-3dce-8f2a-35a1991d4eea",
                                                "text": "Wenn der Preis des neuen Produkts niedriger ist und es sich im Wesentlichen um die gleiche Ware handelt, die das gleiche Bedürfnis des Kunden befriedigt, werden Sie zwangsläufig die Verkäufe bei der höherwertigen Marke kannibalisieren."
                                            },
                                            {
                                                "example_id": "d55f662b-e300-4cbf-8b73-9140953f8d95",
                                                "sense_id": "20967a8b-5e27-3dce-8f2a-35a1991d4eea",
                                                "text": "„Dies deutet daraufhin, dass die E-Book-Verkäufe die Print-Verkäufe bei Amazon nicht kannibalisierten, sondern dass diese Tendenz zu Lasten anderer Akteure ging, namentlich der großen Buchhandelsketten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "05d5e7fa-0aff-3b82-9156-39b5245ef2ba",
                                        "entry_id": "9e47457c-1152-3ebb-b7a0-5fdbb7070873",
                                        "glosses": [
                                            "zu einem Tier machen, das seinesgleichen verzehrt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c679cad-a8c9-4e58-909f-de37b12b0c52",
                                                "sense_id": "05d5e7fa-0aff-3b82-9156-39b5245ef2ba",
                                                "text": "Eine Hungersnot kann Nagetiere kannibalisieren, Ratten können dann zum Beispiel ihren Nachwuchs fressen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
