                    {
                        "translation_id": "e79f4898-ef02-4082-84cd-ea06ef78cc8c",
                        "source_entry_id": "86aedc9e-56f4-3a4b-a40d-c6bfa3b9f784",
                        "source_sense_id": "eef36766-6eb1-3add-acf8-6c456ad8e2e8",
                        "source_sense_description": "regional: Kerngehäuse eines Apfels",
                        "target_lang_word": "trognon",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "trognon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "22bc5c3c-c98d-36d8-851f-afb500d493cf",
                                        "entry_id": "08fefc00-e675-3eef-ba36-28f10bfe2381",
                                        "glosses": [
                                            "Le cœur, le milieu d’un fruit ou d’un légume dont on a ôté tout ce qu’il y avait à manger."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ad737d8-3ba1-43a6-838e-c83e48318b1a",
                                                "sense_id": "22bc5c3c-c98d-36d8-851f-afb500d493cf",
                                                "text": "Épluchez la pomme, retirez le trognon et coupez-la en fines lamelles."
                                            },
                                            {
                                                "example_id": "5c5fe96b-97f5-44b1-b78d-8c0c441c9b45",
                                                "sense_id": "22bc5c3c-c98d-36d8-851f-afb500d493cf",
                                                "text": "il glissait sur le lit épais d’épluchures et de trognons qui couvrait la chaussée,."
                                            },
                                            {
                                                "example_id": "9d0aabc8-d8e4-49fc-9cf6-2a37d1e28013",
                                                "sense_id": "22bc5c3c-c98d-36d8-851f-afb500d493cf",
                                                "text": "Le procureur veut séparer le motif de l’acte. C’est comme essayer de retirer le trognon d’une pomme sans toucher à la peau."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9af3d43b-84ca-3f8b-9e07-f039aeee19a4",
                                        "entry_id": "08fefc00-e675-3eef-ba36-28f10bfe2381",
                                        "glosses": [
                                            "Ce qui reste d'un objet dont une partie a été consommée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5463eddf-55e4-4660-86d6-8270f5c39142",
                                                "sense_id": "9af3d43b-84ca-3f8b-9e07-f039aeee19a4",
                                                "text": "Gaby fit d'abord l'inventaire des ressources d'éclairage, en tout cinq trognons de chandelle et deux boîtes d'allumettes qui furent partagées entre les plus grands."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "trognon",
                                "target_lang_code": "fr",
                                "target_senses": [
