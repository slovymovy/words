                                "target_senses": [
                                    {
                                        "sense_id": "193f1701-ff20-339a-acc1-430ff5608266",
                                        "entry_id": "163f80aa-e3ee-355f-8925-48167b04ece9",
                                        "glosses": [
                                            "One who is hired to perform regular household or other duties, and receives compensation. As opposed to a slave."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa167449-f294-4b8f-85c0-49b7f4e9ab53",
                                                "sense_id": "193f1701-ff20-339a-acc1-430ff5608266",
                                                "text": "There are three servants in the household, the butler and two maids."
                                            },
                                            {
                                                "example_id": "02fcd083-c8b4-4ab2-8e64-44bb20c92184",
                                                "sense_id": "193f1701-ff20-339a-acc1-430ff5608266",
                                                "text": "In the great houses, servants out of livery help to the different plats, servants in livery holding the dishes, sauces, etc., and changing the plates."
                                            },
                                            {
                                                "example_id": "b5fca4fb-e3e2-45c4-9973-42512bba6b44",
                                                "sense_id": "193f1701-ff20-339a-acc1-430ff5608266",
                                                "text": "As a political system democracy seems to me extraordinarily foolish, but I would not go out of my way to protest against it. My servant is, so far as I am concerned, welcome to as many votes as he can get. I would very gladly make mine over to him if I could."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "619c002d-a6ba-3ec0-b950-4fd9636ce4ff",
                                        "entry_id": "163f80aa-e3ee-355f-8925-48167b04ece9",
                                        "glosses": [
                                            "One who serves another, providing help in some manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13abde63-d56e-4485-8524-42183901b6eb",
                                                "sense_id": "619c002d-a6ba-3ec0-b950-4fd9636ce4ff",
                                                "text": "She is quite the humble servant, the poor in this city owe much to her but she expects nothing."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "44bde33a-0c90-3c7a-957e-4119b5234ad1",
                                        "entry_id": "163f80aa-e3ee-355f-8925-48167b04ece9",
                                        "glosses": [
                                            "A person who dedicates themselves to God."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2feac311-ed3b-3625-b817-a70128c46a45",
                                        "entry_id": "163f80aa-e3ee-355f-8925-48167b04ece9",
