                                "target_senses": [
                                    {
                                        "sense_id": "279e7096-f9e6-3592-98f3-da3fd44c06a0",
                                        "entry_id": "4937b0ef-ab01-305a-b43d-388cb81b26e7",
                                        "glosses": [
                                            "A member of a rock band, or a solo artist in the genre, especially one with celebrity status."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "637b2334-ce15-3b13-b4f9-aef57bd1c746",
                                        "entry_id": "4937b0ef-ab01-305a-b43d-388cb81b26e7",
                                        "glosses": [
                                            "A person who is renowned or revered in his or her field of accomplishment."
                                        ],
                                        "tags": [
                                            "attributive",
                                            "figuratively",
                                            "sometimes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "15c35ea5-8578-4f6f-a080-68bfe0565d07",
                                                "sense_id": "637b2334-ce15-3b13-b4f9-aef57bd1c746",
                                                "text": "2008: Fareed Zakaria, The Post-American World, Chapter VII\nEventually Clinton relented and went to India in March 2000. He spent five days in the country, visited famous sights, put on traditional clothes, and took part in dances and ceremonies. He communicated the message that he enjoyed and admired India as a country and civilization. The result was a transformation. Clinton is a rock star in India."
                                            },
                                            {
                                                "example_id": "f0556e32-e9a8-4909-8530-7f14fe1c22e6",
                                                "sense_id": "637b2334-ce15-3b13-b4f9-aef57bd1c746",
                                                "text": "Science has long had an image problem but Dr Cox—also known as the rockstar physicist—has done the unthinkable and made particle physics cool."
                                            },
                                            {
                                                "example_id": "07f383d8-2898-4f97-aba0-e439c594b1d6",
                                                "sense_id": "637b2334-ce15-3b13-b4f9-aef57bd1c746",
                                                "text": "Christie has managed to become a rockstar among conservatives nationally while pursuing an agenda that is in many ways moderate."
                                            },
                                            {
                                                "example_id": "6b2d9017-106e-4035-81c5-f25b597fc5ea",
                                                "sense_id": "637b2334-ce15-3b13-b4f9-aef57bd1c746",
                                                "text": "Tony Hsieh is a rockstar software developer who's turning his attention to urban regeneration in Las Vegas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4387110d-c58b-34b0-941e-ae481a80c8a3",
                                        "entry_id": "4937b0ef-ab01-305a-b43d-388cb81b26e7",
                                        "glosses": [
                                            "Any animal, plant, or other thing that is renowned amongst others of its type."
                                        ],
                                        "tags": [
                                            "attributive",
                                            "figuratively",
                                            "sometimes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "98aaff58-0c46-4937-b9a6-18f453ff7778",
                                                "sense_id": "4387110d-c58b-34b0-941e-ae481a80c8a3",
                                                "text": "Owls are the rockstars of the bird world."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
