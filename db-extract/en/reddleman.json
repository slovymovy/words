                                "example_id": "8ed5ad80-0314-4387-9489-9cd990cf4eaf",
                                "sense_id": "4b785e6f-9edd-351d-9df1-891304eb36a1",
                                "text": "You little children think there's only one cuckoo, one fox, one giant, one devil, and one reddleman, when there's lots of us all."
                            }
                        ]
                    },
                    {
                        "sense_id": "84683a95-bb76-3367-bef1-77734d4fa8f2",
                        "entry_id": "2bde248a-95c7-32ca-ae47-f16ea3d1223b",
                        "glosses": [
                            "A bogeyman"
