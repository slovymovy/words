                                    {
                                        "sense_id": "58d81db8-15a0-3f4d-a4ef-2eed4c7143ad",
                                        "entry_id": "0bdf78d9-07b3-3f5f-8083-0872b24febae",
                                        "glosses": [
                                            "unangenehm hell"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "66171d91-7420-4b7a-bd81-13d90f3ec4b0",
                                                "sense_id": "58d81db8-15a0-3f4d-a4ef-2eed4c7143ad",
                                                "text": "Ich wurde vom grellen Licht der Scheinwerfer geblendet."
                                            },
                                            {
                                                "example_id": "167cd4cf-8fff-4df9-9f5a-558b5475beca",
                                                "sense_id": "58d81db8-15a0-3f4d-a4ef-2eed4c7143ad",
                                                "text": "„Ehemalige Frontsoldaten können sich vorstellen, wie es ist, wenn über einer dunklen Landschaft auf einmal eine grell strahlende Leuchtkugel hochgeht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "43dc4ae4-ad57-3ca5-b316-327b69fd837c",
                                        "entry_id": "0bdf78d9-07b3-3f5f-8083-0872b24febae",
                                        "glosses": [
                                            "unangenehm im Ohr, zum Beispiel durch hohe Frequenz und Lautstärke"
                                        ],
                                        "tags": [
                                            "Töne"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "85dc0baa-d563-4394-98ce-52908536708e",
                                                "sense_id": "43dc4ae4-ad57-3ca5-b316-327b69fd837c",
                                                "text": "Ein greller Pfiff ertönte im Bahnhofsgebäude."
                                            },
                                            {
                                                "example_id": "d7627c5e-13de-44c3-b7f4-6c93ddc30855",
                                                "sense_id": "43dc4ae4-ad57-3ca5-b316-327b69fd837c",
                                                "text": "Sie schimpfte laut mit greller Stimme."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "62265cdf-c137-3156-8900-86e2fad087b0",
                                        "entry_id": "0bdf78d9-07b3-3f5f-8083-0872b24febae",
                                        "glosses": [
                                            "unangenehm für das Auge, zum Beispiel durch klare, bunte, intensive Farben"
                                        ],
                                        "tags": [
                                            "Farben"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d9ad2b42-7c6e-43a8-9477-b415082b5a33",
                                                "sense_id": "62265cdf-c137-3156-8900-86e2fad087b0",
                                                "text": "Der Künstler verwendet gerne grelle Farben."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d8827627-ffae-42c3-997c-cba83e93c15e",
                        "source_entry_id": "b40c904f-a4ab-3491-8c36-9fe6e84afc67",
