            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "e5e1d14a-7850-3e7b-a1de-0c6d9cec4fd5",
                    "sense_definition": "De façon marquée, considérable ou indiscutable, notamment dans une comparaison.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "degre",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les résultats de cette année sont <w>nettement</w> supérieurs à ceux de l'an dernier.",
                            "target_lang_translations": {
                                "en": "This year's results are <w>considerably</w> higher than last year's.",
                                "ru": "Результаты этого года <w>заметно</w> выше, чем в прошлом году.",
                                "de": "Die Ergebnisse dieses Jahres sind <w>deutlich</w> besser als die des letzten Jahres.",
                                "es": "Los resultados de este año son <w>considerablemente</w> superiores a los del año pasado.",
                                "zh": "今年的成绩<w>明显</w>高于去年的。"
                            }
                        },
                        {
                            "text": "La nouvelle version de ce logiciel fonctionne <w>nettement</w> mieux que la précédente.",
                            "target_lang_translations": {
                                "en": "The new version of this software works <w>considerably</w> better than the previous one.",
                                "ru": "Новая версия этой программы работает <w>заметно</w> лучше предыдущей.",
                                "de": "Die neue Version dieser Software läuft <w>deutlich</w> besser als die vorherige.",
                                "es": "La nueva versión de este programa informático funciona <w>considerablemente</w> mejor que la anterior.",
                                "zh": "这个软件的新版本<w>明显</w>比之前的版本好用。"
                            }
                        }
                    ],
                    "synonyms": [
                        "considérablement",
                        "sensiblement",
                        "visiblement"
                    ],
                    "antonyms": [
                        "légèrement",
                        "à peine"
                    ],
                    "common_phrases": [
                        "nettement supérieur",
                        "nettement inférieur",
                        "nettement mieux"
                    ],
                    "target_lang_definitions": {
