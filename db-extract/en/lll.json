    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "e8150fb5-a9a1-3b3e-80b9-0b86f09f37f7",
                "word": "LLL",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "dfe36c1f-a544-3b15-8fe9-4c5c84bc6258",
                        "entry_id": "e8150fb5-a9a1-3b3e-80b9-0b86f09f37f7",
                        "glosses": [
                            "La Leche League: international non-profit organisation that promotes breastfeeding."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ec63b28-0169-4ac7-b766-d74727842420",
                                "sense_id": "dfe36c1f-a544-3b15-8fe9-4c5c84bc6258",
                                "text": "The LLL promotes the idea of good mothering through the womanly art of breastfeeding. Some 1,000 mothers and 500 babies from across the United States, Canada, Mexico, Argentina and Johannesburg, South Africa, attended the three-day convention at the Denver Hilton."
                            },
                            {
                                "example_id": "5e31d272-13ea-4d0e-a8a2-0e4025f94016",
                                "sense_id": "dfe36c1f-a544-3b15-8fe9-4c5c84bc6258",
                                "text": "The latter group, known as the La Leche League (LLL), produce a monthly bulletin which can be very useful in this regard, showing, as it does, a modern group of women in an affluent society who believe that breast feeding is worthwhile achieving."
                            },
                            {
                                "example_id": "b7de39dc-1794-4c90-9aba-ab653148f76d",
                                "sense_id": "dfe36c1f-a544-3b15-8fe9-4c5c84bc6258",
                                "text": "The LLL's founders allied themselves with physicians, albeit unconventional ones, from its very inception."
                            },
                            {
                                "example_id": "a27e8cad-8191-413d-99d9-21af95136c73",
                                "sense_id": "dfe36c1f-a544-3b15-8fe9-4c5c84bc6258",
                                "text": "The La Leche League (LLL), formed in 1956—for women, by mothers—to provide education, practical guidance, and support for women in their efforts to breastfeed and \"mother\" their children. Mothers were empowered with new knowledge and trust from experienced mothers, and the LLL produced a book, The Womanly Art of Breastfeeding, and continued its expansion internationally."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": [
