{
    "word_family": [
        "wage"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "83933a05-92c2-3895-8671-37ac72dde0c2",
                    "sense_definition": "One's total income for a time period, typically paid daily or weekly based on hours worked.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "income",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Factory workers demanded higher <w>wages</w>.",
                            "target_lang_translations": {
                                "ru": "Рабочие фабрики требовали повышения <w>зарплаты</w>.",
                                "zh": "工厂工人要求提高<w>工资</w>。"
                            }
                        },
                        {
                            "text": "He collects his weekly <w>wages</w> every Friday afternoon.",
                            "target_lang_translations": {
                                "ru": "Он получает свою недельную <w>зарплату</w> каждую пятницу после обеда.",
                                "zh": "他每周五下午领取他的周<w>薪</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "earnings",
                        "pay",
                        "income",
                        "remuneration",
                        "salary"
                    ],
                    "common_phrases": [
                        "minimum wages",
                        "weekly wages",
                        "low wages",
                        "living wages"
                    ],
                    "target_lang_definitions": {
                        "ru": "Денежное вознаграждение за труд, обычно выплачиваемое ежедневно или еженедельно в зависимости от отработанных часов.",
                        "zh": "指按工作时间（通常为日薪或周薪）计算的劳动报酬。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зарплата",
                                "target_lang_sense_clarification": "общее понятие"
                            },
                            {
                                "target_lang_word": "заработная плата",
                                "target_lang_sense_clarification": "официальный термин"
                            },
                            {
                                "target_lang_word": "оплата труда",
                                "target_lang_sense_clarification": "процесс или сумма выплат"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "工资",
                                "target_lang_sense_clarification": "指按小时或天计算的劳动报酬"
                            },
                            {
                                "target_lang_word": "薪水",
                                "target_lang_sense_clarification": "指定期发放的劳动报酬"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "51ffd1d5-758d-34a0-b772-50e3d2fed086",
                    "sense_definition": "Plural of <w>wage</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "income",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>wages</w> for these two jobs are very different.",
                            "target_lang_translations": {
                                "ru": "<w>Зарплаты</w> на этих двух работах сильно различаются.",
                                "zh": "这两份工作的<w>工资水平</w>大不相同。"
                            }
                        },
                        {
                            "text": "They calculated the <w>wages</w> for all the temporary staff.",
                            "target_lang_translations": {
                                "ru": "Они рассчитали <w>заработную плату</w> для всего временного персонала.",
                                "zh": "他们计算了所有临时员工的<w>薪资</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "plural"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Множественное число от слова wage, обозначающее доходы или ставки оплаты.",
                        "zh": "wage的复数形式，指不同岗位或人员的薪酬水平。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зарплаты",
                                "target_lang_sense_clarification": "уровни оплаты"
                            },
                            {
                                "target_lang_word": "заработки",
                                "target_lang_sense_clarification": "доходы"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "工资水平",
                                "target_lang_sense_clarification": "指不同工作之间的薪酬差异"
                            },
                            {
                                "target_lang_word": "薪资",
                                "target_lang_sense_clarification": "指多项薪酬或整体收入"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b2507e33-86d3-39a8-bc7f-352cdcef5230",
                    "sense_definition": "Third-person singular simple present indicative of <w>wage</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The country <w>wages</w> war against its aggressive neighbors.",
                            "target_lang_translations": {
                                "ru": "Страна <w>ведёт</w> войну против своих агрессивных соседей.",
                                "zh": "这个国家对侵略成性的邻国<w>发动</w>了战争。"
                            }
                        },
                        {
                            "text": "She <w>wages</w> a constant battle against the weeds in her garden.",
                            "target_lang_translations": {
                                "ru": "Она <w>ведёт</w> постоянную борьбу с сорняками в своём саду.",
                                "zh": "她一直在花园里与杂草<w>进行</w>着持久的斗争。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "wages war",
                        "wages a campaign",
                        "wages a battle"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "third-person singular"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Форма глагола 'wage' в третьем лице единственного числа (вести, осуществлять — обычно о войне или борьбе).",
                        "zh": "wage的第三人称单数形式，指发动或进行（战争、斗争等）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ведёт",
                                "target_lang_sense_clarification": "войну или борьбу"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "进行",
                                "target_lang_sense_clarification": "指开展某项长期的斗争或战争"
                            },
                            {
                                "target_lang_word": "发动",
                                "target_lang_sense_clarification": "指开始进行战争"
                            }
                        ]
                    }
                }
            ]
        }
    ]
