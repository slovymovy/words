                ],
                "senses": [
                    {
                        "sense_id": "b6e72914-0083-39ef-850b-5fc0e320a459",
                        "entry_id": "efc04245-4564-33d6-80fe-360ae95921b3",
                        "glosses": [
                            "ein grammatisches Morphem, das der Ableitung (Derivation) eines Wortes dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d21d87b-262f-4a66-b516-a7fa8bbddc29",
                                "sense_id": "b6e72914-0083-39ef-850b-5fc0e320a459",
                                "text": "„Die Etymologie verfolgt nicht nur die Geschichte der einzelnen Lexeme, sondern auch die von Wortbildungsmorphemen und ganzen Wortfamilien.“"
                            },
                            {
                                "example_id": "317b02b1-1c67-4a6e-ad17-f1d29967a575",
                                "sense_id": "b6e72914-0083-39ef-850b-5fc0e320a459",
                                "text": "„Im Unterschied zu den Grundmorphemen kommen die Wortbildungsmorpheme nicht frei vor, sondern dienen in Verbindung mit Derivationsbasen (Grundmorphemen oder Wörtern) der Bildung komplexer Wörter.“"
                            },
                            {
                                "example_id": "174e8d9a-d76d-448b-950d-79709a69b1da",
                                "sense_id": "b6e72914-0083-39ef-850b-5fc0e320a459",
                                "text": "„Wahrscheinlich werden die meisten Wissenschaftler mit den meisten Wörterbuchbenutzern darin übereinstimmen, daß solche Neuwörter, die durch Wortbildungsmorpheme (Suffixe oder Präfixe, die ein Wort von einem Wortstamm oder einem Grundwort ableiten) gebildet werden, eher ins Wörterbuch gehören als solche, die durch bloße Zusammensetzung aus zwei oder mehreren Wörtern entstehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
