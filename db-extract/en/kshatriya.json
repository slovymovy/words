    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "b214b162-7b08-3f87-b7d3-035b66bdc112",
                "word": "kshatriya",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "dbacf796-09ba-4376-abe8-8d16f58ac4be",
                        "entry_id": "b214b162-7b08-3f87-b7d3-035b66bdc112",
                        "tags": [
                            "plural"
                        ],
                        "form": "kshatriyas"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6acdace1-77fc-3b21-aa30-ec8c95592f2d",
                        "entry_id": "b214b162-7b08-3f87-b7d3-035b66bdc112",
                        "glosses": [
                            "A member of the second-highest of the four castes or varnas in traditional Hindu society: the warrior or military caste."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97ad1824-8cf5-4700-ba81-13d820ab2192",
                                "sense_id": "6acdace1-77fc-3b21-aa30-ec8c95592f2d",
                                "text": "The kshatriya could only hope to become a monk in his next life, but given the nature of his daily karma, it seemed unlikely that he could achieve even this limited goal."
                            },
                            {
                                "example_id": "6f230c79-1ef2-44bf-a6ab-680f80534d24",
                                "sense_id": "6acdace1-77fc-3b21-aa30-ec8c95592f2d",
                                "text": "\"Bṛhannaḍā said, 'It is not the habit of a kṣatriya to flee like this; death in battle is preferable to flight in fear.'\" (Mahābhārata: \"Virāṭa Parva\")"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "350c9f83-f398-4df4-b51e-1317ebb9d09f",
                        "source_entry_id": "b214b162-7b08-3f87-b7d3-035b66bdc112",
                        "source_sense_id": "6acdace1-77fc-3b21-aa30-ec8c95592f2d",
                        "source_sense_description": "a member of warrior caste",
                        "target_lang_word": "kshattriya",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "13b57333-6f03-43ed-ab79-f195402ff424",
                        "source_entry_id": "b214b162-7b08-3f87-b7d3-035b66bdc112",
                        "source_sense_id": "6acdace1-77fc-3b21-aa30-ec8c95592f2d",
                        "source_sense_description": "a member of warrior caste",
                        "target_lang_word": "kshatriya",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kshatriya",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "11145b87-1478-3df2-bd57-c8d52bfb2937",
                                        "entry_id": "646a2dd6-5e22-3486-adb8-220782f14969",
                                        "glosses": [
                                            "Noble indien, membre d'une des quatre varnas (caste en Inde), comprenant les rois, seigneurs, et chefs de guerre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30bb186c-ef6c-437d-863a-5e2ec7324aee",
                                                "sense_id": "11145b87-1478-3df2-bd57-c8d52bfb2937",
                                                "text": "Tu connais, de plus, tes devoirs de kshatriya : ils t’enjoignent de combattre selon les principes de la religion ; tu ne peux donc hésiter.\nHeureux les kshatriyas à qui s’offre ainsi l’occasion de combattre."
                                            },
                                            {
                                                "example_id": "43206c62-98b4-4eb9-8038-a4b76173eaa0",
                                                "sense_id": "11145b87-1478-3df2-bd57-c8d52bfb2937",
                                                "text": "Je suis un kshatriya. Je ne vais pas abandonner mon pays, comme un lâche sous prétexte que j’ai peur. Courage, mère."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
