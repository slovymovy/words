{
    "word_family": [
        "moundy",
        "mound-builder"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "42d76581-98a3-3b3c-9d20-d149ef78914f",
                    "sense_definition": "A large amount or pile of something.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "quantity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There was a huge <w>mound</w> of paperwork waiting on her desk after the long weekend.",
                            "target_lang_translations": {
                                "ru": "После долгих выходных на её столе лежала огромная <w>гора</w> бумажной работы.",
                                "zh": "长假过后，她的桌上堆着一大<w>堆</w>待处理的文件。"
                            }
                        },
                        {
                            "text": "The children left a messy <w>mound</w> of toys in the middle of the living room.",
                            "target_lang_translations": {
                                "ru": "Дети оставили беспорядочную <w>кучу</w> игрушек посреди гостиной.",
                                "zh": "孩子们在客厅中央留下了一大<w>堆</w>乱七八糟的玩具。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "mound of paperwork",
                        "mound of laundry"
                    ],
                    "target_lang_definitions": {
                        "ru": "Большое количество или куча чего-либо.",
                        "zh": "指大量堆积在一起的物体。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "куча",
                                "target_lang_sense_clarification": "беспорядочное скопление вещей"
                            },
                            {
                                "target_lang_word": "гора",
                                "target_lang_sense_clarification": "огромное количество чего-либо"
                            },
                            {
                                "target_lang_word": "ворох",
                                "target_lang_sense_clarification": "большое количество бумаг, одежды"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "堆",
                                "target_lang_sense_clarification": "杂乱堆积的物体"
                            },
                            {
                                "target_lang_word": "山",
                                "target_lang_sense_clarification": "形容数量极多，如“堆积如山”"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "86273429-7174-386e-a430-f1005f127367",
                    "sense_definition": "A natural elevation appearing as a small hill, hillock, or knoll.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "elevation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They sat on a grassy <w>mound</w> to watch the sunset over the valley.",
                            "target_lang_translations": {
                                "ru": "Они сели на травянистый <w>холм</w>, чтобы проводить закат над долиной.",
                                "zh": "他们坐在一个长满草的<w>小丘</w>上，看着夕阳在山谷落下。"
                            }
                        },
                        {
                            "text": "The ancient castle ruins stood atop a steep <w>mound</w> overlooking the river.",
                            "target_lang_translations": {
                                "ru": "Руины древнего замка стояли на вершине крутого <w>холма</w>, возвышающегося над рекой.",
                                "zh": "古老的城堡遗迹矗立在一座俯瞰河流的陡峭<w>土丘</w>上。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "grassy mound",
                        "earth mound"
                    ],
                    "target_lang_definitions": {
                        "ru": "Естественное возвышение в виде небольшого холма или бугра.",
                        "zh": "自然形成的小土丘或隆起的地形。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "холм",
                                "target_lang_sense_clarification": "небольшая возвышенность"
                            },
                            {
                                "target_lang_word": "бугор",
                                "target_lang_sense_clarification": "небольшое возвышение на земле"
                            },
                            {
                                "target_lang_word": "курган",
                                "target_lang_sense_clarification": "небольшой холм"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "小丘",
                                "target_lang_sense_clarification": "较小的山丘"
                            },
                            {
                                "target_lang_word": "土堆",
                                "target_lang_sense_clarification": "地面上隆起的小土包"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fad171de-1298-3760-a669-5ef126b06cfb",
                    "sense_definition": "The slightly elevated area of dirt in the middle of a baseball field from which the pitcher throws the ball.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "baseball",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pitcher walked slowly to the <w>mound</w> and prepared for the next throw.",
                            "target_lang_translations": {
                                "ru": "Питчер медленно подошел к <w>горке</w> и приготовился к следующему броску.",
                                "zh": "投手慢慢走向<w>投手丘</w>，准备下一次投球。"
                            }
                        },
                        {
                            "text": "He has been dominant on the <w>mound</w> throughout the entire baseball season.",
                            "target_lang_translations": {
                                "ru": "Он доминировал на <w>горке</w> на протяжении всего бейсбольного сезона.",
                                "zh": "整个棒球赛季中，他在<w>投手丘</w>上的表现都极具统治力。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "pitchers mound",
                        "on the mound"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшое земляное возвышение в центре бейсбольного поля, с которого питчер бросает мяч.",
                        "zh": "棒球场中央投手投球时站立的略微隆起的土台。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "горка",
                                "target_lang_sense_clarification": "в бейсболе, позиция питчера"
                            },
                            {
                                "target_lang_word": "питчерская горка",
                                "target_lang_sense_clarification": "место подачи в бейсболе"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "投手丘",
                                "target_lang_sense_clarification": "棒球比赛中投手投球的区域"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "989cfddf-4437-3680-9e5b-c25a948bd6a7",
                    "sense_definition": "An artificial hill or bank of earth, often constructed as a barrier, burial site, or fortification.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "elevation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Archaeologists discovered ancient artifacts buried deep inside the ceremonial <w>mound</w>.",
                            "target_lang_translations": {
                                "ru": "Археологи обнаружили древние артефакты, погребенные глубоко внутри церемониального <w>кургана</w>.",
                                "zh": "考古学家在仪式性的<w>坟冢</w>深处发现了古代文物。"
                            }
                        },
                        {
                            "text": "Soldiers constructed a defensive <w>mound</w> of earth to protect their camp from attacks.",
                            "target_lang_translations": {
                                "ru": "Солдаты соорудили защитную земляную <w>насыпь</w>, чтобы обезопасить свой лагерь от нападений.",
                                "zh": "士兵们筑起了一道防御性的<w>土堤</w>，以保护营地免受攻击。"
                            }
                        }
                    ],
                    "synonyms": [
                        "bulwark",
                        "rampart"
                    ],
                    "common_phrases": [
                        "burial mound"
                    ],
                    "target_lang_definitions": {
                        "ru": "Искусственный холм или земляная насыпь, часто создаваемая как барьер, место захоронения или укрепление.",
                        "zh": "人工堆筑的土丘或堤岸，常用于防御、墓葬或屏障。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "курган",
                                "target_lang_sense_clarification": "древняя могильная насыпь"
                            },
                            {
                                "target_lang_word": "насыпь",
                                "target_lang_sense_clarification": "искусственное возвышение из земли"
                            },
                            {
                                "target_lang_word": "вал",
                                "target_lang_sense_clarification": "земляное оборонительное укрепление"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "土堆",
                                "target_lang_sense_clarification": "人工堆积的土丘"
                            },
                            {
                                "target_lang_word": "堤坝",
                                "target_lang_sense_clarification": "用于防御或阻挡的土筑结构"
                            },
                            {
                                "target_lang_word": "坟冢",
                                "target_lang_sense_clarification": "古代墓葬的土丘"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4aae57cc-2fea-33e1-b8a5-22a9c32decaa",
                    "sense_definition": "A globe or ball surmounted by a cross, forming part of the regalia of a sovereign.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "regalia",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The monarch held the golden <w>mound</w> in his left hand during the coronation ceremony.",
                            "target_lang_translations": {
                                "ru": "Во время церемонии коронации монарх держал в левой руке золотую <w>державу</w>.",
                                "zh": "加冕典礼上，君主左手拿着金色的<w>十字圣球</w>。"
                            }
                        },
                        {
                            "text": "The royal crown and the jeweled <w>mound</w> were displayed securely in the museum.",
                            "target_lang_translations": {
                                "ru": "Королевская корона и украшенная драгоценными камнями <w>держава</w> были надежно выставлены в музее.",
                                "zh": "皇冠和镶满珠宝的<w>十字圣球</w>被安全地陈列在博物馆里。"
                            }
                        }
                    ],
                    "synonyms": [
                        "globus cruciger",
                        "globe",
                        "orb"
                    ],
                    "target_lang_definitions": {
                        "ru": "Шар с крестом наверху, являющийся частью королевских регалий.",
                        "zh": "顶部带有十字架的球体，是君主权力的象征物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "держава",
                                "target_lang_sense_clarification": "символ монаршей власти в виде золотого шара с крестом"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "十字圣球",
                                "target_lang_sense_clarification": "君主权杖上的球体装饰"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d5b82a19-24ed-33a3-8d19-bf1022897ec4",
                    "sense_definition": "To pile or heap up into a mound.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "piling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She began to <w>mound</w> the fresh soil around the base of the rose bushes.",
                            "target_lang_translations": {
                                "ru": "Она начала <w>насыпать</w> свежую почву вокруг основания кустов роз.",
                                "zh": "她开始在玫瑰丛根部<w>培土</w>。"
                            }
                        },
                        {
                            "text": "He liked to <w>mound</w> up his mashed potatoes to make a well for the gravy.",
                            "target_lang_translations": {
                                "ru": "Ему нравилось <w>выкладывать горкой</w> картофельное пюре, чтобы сделать углубление для подливки.",
                                "zh": "他喜欢把土豆泥<w>堆</w>起来，中间挖个坑放肉汁。"
                            }
                        }
                    ],
                    "synonyms": [
                        "heap up",
                        "pile",
                        "pile up"
                    ],
                    "common_phrases": [
                        "mound up"
                    ],
                    "target_lang_definitions": {
                        "ru": "Складывать или насыпать кучей.",
                        "zh": "将某物堆积成丘状。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "насыпать",
                                "target_lang_sense_clarification": "делать горку из земли или песка"
                            },
                            {
                                "target_lang_word": "складывать горкой",
                                "target_lang_sense_clarification": "придавать форму кучи"
                            },
                            {
                                "target_lang_word": "окучивать",
                                "target_lang_sense_clarification": "подгребать землю к корням растений"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "堆积",
                                "target_lang_sense_clarification": "把东西聚拢成堆"
                            },
                            {
                                "target_lang_word": "培土",
                                "target_lang_sense_clarification": "将土堆在植物根部"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5972cdc9-d7f4-339b-8d1b-45e5a62a3e25",
                    "sense_definition": "To form or rise into the shape of a mound.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "piling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ocean waves began to <w>mound</w> as they approached the shallow reef.",
                            "target_lang_translations": {
                                "ru": "Океанские волны начали <w>вздыматься</w> по мере приближения к мелководному рифу.",
                                "zh": "海浪在接近浅滩礁石时开始<w>隆起</w>。"
                            }
                        },
                        {
                            "text": "We watched the dry sand <w>mound</w> under the force of the desert wind.",
                            "target_lang_translations": {
                                "ru": "Мы наблюдали, как сухой песок <w>собирается в холмики</w> под воздействием пустынного ветра.",
                                "zh": "我们看着干沙在沙漠风力的作用下<w>堆积</w>成丘。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Формироваться или подниматься в виде холмика или кучи.",
                        "zh": "形成或隆起成丘状。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вздыматься",
                                "target_lang_sense_clarification": "подниматься бугром или волной"
                            },
                            {
                                "target_lang_word": "накапливаться холмиком",
                                "target_lang_sense_clarification": "собираться в кучу"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "隆起",
                                "target_lang_sense_clarification": "向上凸起"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "33c1c3cd-62c8-3138-9569-209712370f75",
                    "sense_definition": "To fortify or protect with an embankment or barrier.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "fortification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The villagers worked tirelessly to <w>mound</w> the riverbank before the heavy rains arrived.",
                            "target_lang_translations": {
                                "ru": "Жители деревни без устали трудились, чтобы <w>укрепить насыпью</w> берег реки до начала проливных дождей.",
                                "zh": "在大雨来临前，村民们不辞辛劳地给河岸<w>筑堤</w>。"
                            }
                        },
                        {
                            "text": "Engineers planned to <w>mound</w> the outer perimeter of the outpost for extra security.",
                            "target_lang_translations": {
                                "ru": "Инженеры планировали <w>обнести валом</w> внешний периметр аванпоста для дополнительной безопасности.",
                                "zh": "工程师计划在哨所外围<w>筑堤</w>以加强安全。"
                            }
                        }
                    ],
                    "synonyms": [
                        "bank",
                        "bank up",
                        "bulwark",
                        "rampart"
                    ],
                    "target_lang_definitions": {
                        "ru": "Укреплять или защищать с помощью земляного вала или насыпи.",
                        "zh": "用土堤或屏障进行加固或防御。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обносить валом",
                                "target_lang_sense_clarification": "создавать защитную насыпь"
                            },
                            {
                                "target_lang_word": "укреплять насыпью",
                                "target_lang_sense_clarification": "защищать земляным барьером"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "筑堤",
                                "target_lang_sense_clarification": "修筑土堤以加固"
                            },
                            {
                                "target_lang_word": "修筑防御工事",
                                "target_lang_sense_clarification": "通过堆土建立防御"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}