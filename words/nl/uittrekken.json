    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3ec708b3-8fc4-30a1-bb8e-1defc62e4b5a",
                    "sense_definition": "kledingstukken of schoeisel van het lichaam verwijderen",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "kleding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het was erg warm in de kamer, dus hij besloot zijn dikke trui <w>uit te trekken</w>.",
                            "target_lang_translations": {
                                "en": "It was very warm in the room, so he decided to <w>take off</w> his thick sweater.",
                                "ru": "В комнате было очень жарко, поэтому он решил <w>снять</w> свой толстый свитер."
                            }
                        },
                        {
                            "text": "Vergeet niet je natte schoenen <w>uit te trekken</w> voordat je de woonkamer binnenstapt.",
                            "target_lang_translations": {
                                "en": "Don't forget to <w>take off</w> your wet shoes before stepping into the living room.",
                                "ru": "Не забудь <w>снять</w> мокрую обувь, прежде чем входить в гостиную."
                            }
                        }
                    ],
                    "synonyms": [
                        "uitdoen"
                    ],
                    "antonyms": [
                        "aantrekken",
                        "aandoen"
                    ],
                    "common_phrases": [
                        "schoenen uittrekken",
                        "jas uittrekken"
                    ],
                    "target_lang_definitions": {
                        "en": "to remove clothing or footwear from the body",
                        "ru": "снимать одежду или обувь с тела"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "take off",
                                "target_lang_sense_clarification": "clothing or shoes"
                            },
                            {
                                "target_lang_word": "undress",
                                "target_lang_sense_clarification": "to remove all clothes"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "снимать",
                                "target_lang_sense_clarification": "одежду или обувь"
                            },
                            {
                                "target_lang_word": "раздеваться",
                                "target_lang_sense_clarification": "снимать с себя всю одежду"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dc8090dd-7ade-3b2c-b4e7-71f536612eff",
                    "sense_definition": "iets met kracht uit een vaste positie of uit een ander object trekken",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "verwijderen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De tandarts moest helaas een kies <w>uittrekken</w> omdat de ontsteking te erg was.",
                            "target_lang_translations": {
                                "en": "The dentist unfortunately had to <w>pull out</w> a molar because the inflammation was too severe.",
                                "ru": "Стоматологу, к сожалению, пришлось <w>удалить</w> коренной зуб, так как воспаление было слишком сильным."
                            }
                        },
                        {
                            "text": "Om die kleine splinter <w>uit te trekken</w> kun je het beste een schone pincet gebruiken.",
                            "target_lang_translations": {
                                "en": "To <w>pull out</w> that small splinter, it's best to use clean tweezers.",
                                "ru": "Чтобы <w>вытащить</w> эту маленькую занозу, лучше всего использовать чистый пинцет."
                            }
                        }
                    ],
                    "synonyms": [
                        "extraheren",
                        "verwijderen",
                        "trekken"
                    ],
                    "common_phrases": [
                        "een tand uittrekken",
                        "een splinter uittrekken"
                    ],
                    "target_lang_definitions": {
