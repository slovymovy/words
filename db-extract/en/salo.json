            {
                "entry_id": "6f539ce1-8a29-3a12-ab7b-a13de2ccb87a",
                "word": "salo",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "586d1de0-ae1a-328a-b61b-225eb53cb2a8",
                        "entry_id": "6f539ce1-8a29-3a12-ab7b-a13de2ccb87a",
                        "glosses": [
                            "a type of fatback, or non-rendered underskin pig fat consumed in Central and Eastern Europe, usually seasoned"
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "a67505db-efbc-45f3-bf18-55e589e4421e",
                                "sense_id": "586d1de0-ae1a-328a-b61b-225eb53cb2a8",
                                "text": "[…] Mr. Castro waxed nostalgic, recounting the time he and Soviet comrades sat around a campfire in the forest eating salo, the cured pig fat that is a staple chaser of Russian vodka."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "76b0c170-9f1d-4970-a49c-a319491a9d88",
                        "source_entry_id": "6f539ce1-8a29-3a12-ab7b-a13de2ccb87a",
                        "source_sense_id": "586d1de0-ae1a-328a-b61b-225eb53cb2a8",
                        "source_sense_description": "non-rendered pig fat",
                        "target_lang_word": "sádlo",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sádlo",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "c78f1c44-6339-36b2-ab8b-2632dfaf274a",
                                        "entry_id": "8c673ae6-32d0-30e8-9708-16b798cae0db",
                                        "glosses": [
                                            "živočišná tuková tkáň"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5610f2d5-b3e8-4bf2-bb8c-7680aed98084",
                                                "sense_id": "c78f1c44-6339-36b2-ab8b-2632dfaf274a",
                                                "text": "Při dietě z masa vždy odřezáváme viditelné sádlo."
                                            },
                                            {
                                                "example_id": "69897046-c808-4b2e-98bc-a85963de8545",
                                                "sense_id": "c78f1c44-6339-36b2-ab8b-2632dfaf274a",
                                                "text": "Byl tlustý až běda, všude mu viselo sádlo."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a9e9a6f-6a82-338c-bffb-d8716d615785",
                                        "entry_id": "8c673ae6-32d0-30e8-9708-16b798cae0db",
                                        "glosses": [
                                            "druh živočišného tuku vyškvařený ze sádla (1) užívaný jako potravina nebo v kosmetickém a farmaceutickém průmyslu"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b0034549-2fa5-4a85-8664-d94fc0613b83",
                                                "sense_id": "6a9e9a6f-6a82-338c-bffb-d8716d615785",
                                                "text": "Chtěl jsem si namazat chleba se sádlem, ale došla mi cibule a bez ní to není ono."
                                            },
                                            {
                                                "example_id": "b74ea8ee-5f54-46b8-b90c-8c8738bc3b8d",
                                                "sense_id": "6a9e9a6f-6a82-338c-bffb-d8716d615785",
                                                "text": "Základem tehdejších mastí byly rozmanité tuky, jako např. vepřové sádlo, které se stálé používá, hovězí sádlo, husí, psí, medvědí a dokonce i lidské sádlo."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sádlo",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "10895c31-d7bb-3824-aa19-9808aa26ed39",
                                        "entry_id": "7f4630db-5f2d-3f81-9e73-106e434ce683",
                                        "glosses": [
