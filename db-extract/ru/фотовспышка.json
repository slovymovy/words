                    }
                ],
                "translations": [
                    {
                        "translation_id": "43c94e0a-507f-4eac-b342-1fc8a03ab878",
                        "source_entry_id": "193e7fab-5eba-38ca-83e5-f48b8f808d16",
                        "source_sense_id": "acce60c5-fddb-33bf-b5a1-0283239b2573",
                        "target_lang_word": "flash",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "flash",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bf2e4326-a37e-3971-9dc9-93259d12f017",
                                        "entry_id": "019a096c-58ff-393e-bb80-05d572200de3",
                                        "glosses": [
                                            "Éclair lumineux bref."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f83f0d60-4aee-4a1c-b463-a920e3bb63a9",
                                                "sense_id": "bf2e4326-a37e-3971-9dc9-93259d12f017",
                                                "text": "Il y a eu un flash lumineux d’une toute petite seconde, un simple flash, une seule seconde, et un tiers du plan des Penseurs fut totalement pulvérisé par la puissance du néant lui-même."
                                            },
                                            {
                                                "example_id": "f3c5b54c-5002-49e1-8655-35532758bb06",
                                                "sense_id": "bf2e4326-a37e-3971-9dc9-93259d12f017",
                                                "text": "Matière et antimatière s’annihilent également dans un flash lumineux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0dab3e2e-fef6-375e-a11f-973e814e3680",
                                        "entry_id": "019a096c-58ff-393e-bb80-05d572200de3",
                                        "glosses": [
                                            "Dispositif produisant une lumière intense pendant un très court laps de temps. Son ancêtre est le pistolet à magnésium."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1ac80ff-ef39-4cc9-9684-7855bc924109",
                                                "sense_id": "0dab3e2e-fef6-375e-a11f-973e814e3680",
                                                "text": "Mg entre dans la composition d’alliages d'aluminium. En photographie, il sert dans les lampes « flash », et, en mélange avec des agents oxydants tels que le chlorate de potassium, comme « poudre flash » à cause de la lumière intense et vive qu’il émet en brûlant."
                                            },
                                            {
                                                "example_id": "9d4d1772-bfa6-40ed-af90-01a743caf787",
                                                "sense_id": "0dab3e2e-fef6-375e-a11f-973e814e3680",
                                                "text": "Il avait à la main un appareil photographique sur lequel il enfonçait un flash minuscule.\n– Je viens de l’acheter… On peut obtenir des photos en couleurs… instantanément…"
                                            },
                                            {
                                                "example_id": "9f432b50-b1a9-477c-8bb3-efcc1f6925dc",
                                                "sense_id": "0dab3e2e-fef6-375e-a11f-973e814e3680",
                                                "text": "Il y avait un appareil avec un flash sur le plancher à côté de la main de Steiner."
                                            },
                                            {
                                                "example_id": "2902a42e-7778-4db1-9f1b-3e7fa6a0be72",
                                                "sense_id": "0dab3e2e-fef6-375e-a11f-973e814e3680",
                                                "text": "Évidemment, un flash ne vous sera pas d’une grande utilité en vidéo, mais vous pouvez utiliser une technique de vidéaste : celle de la minette."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "da3f72d7-8be8-3277-9a12-4d0f40537ddb",
                                        "entry_id": "019a096c-58ff-393e-bb80-05d572200de3",
                                        "glosses": [
                                            "Information urgente."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a470d522-634a-4988-9861-0734dabbe8bd",
                                                "sense_id": "da3f72d7-8be8-3277-9a12-4d0f40537ddb",
                                                "text": "La première fut une mort en soirée, qui interrompit le film du mardi soir, un flash laconique annonçant la mort du président de la République Georges Pompidou."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2249245a-9ac3-3a8f-b45b-c8682d1d99e0",
                                        "entry_id": "019a096c-58ff-393e-bb80-05d572200de3",
                                        "glosses": [
                                            "Type de lancer où tous les objets sont lancés et attrapés une seule fois."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "499f8ea5-732f-3a59-9bb4-e244ab0ae4a6",
                                        "entry_id": "019a096c-58ff-393e-bb80-05d572200de3",
                                        "glosses": [
                                            "Dessin créé par une personne qui réalise des tatouages et proposé pour une réalisation unique et souvent sans modification."
                                        ],
                                        "tags": [
                                            "Tatouage"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0d48ebf0-6f62-4e53-8c94-26fdd6a2bc3d",
                                                "sense_id": "499f8ea5-732f-3a59-9bb4-e244ab0ae4a6",
                                                "text": "Un projet perso coute plus cher qu’un flash généralement (à taille, emplacement, nombre de couleurs, temps de travail comparables bien sûr…)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5b7e04f2-4b2f-3d48-9b59-a53cb014fd93",
                                        "entry_id": "019a096c-58ff-393e-bb80-05d572200de3",
                                        "glosses": [
                                            "Effet de certaines drogues consommées par voie intraveineuse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b0af015a-cc88-4ade-92c5-307b457b4967",
                                                "sense_id": "5b7e04f2-4b2f-3d48-9b59-a53cb014fd93",
                                                "text": "L'héroïne brune démarre toujours par un flash si puissant et rapide que le corps se renverse brutalement en arrière, la montée est immédiate."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b1a6238-73bd-3f97-b8b8-603314a13d90",
                                        "entry_id": "019a096c-58ff-393e-bb80-05d572200de3",
                                        "glosses": [
                                            "Fiole d’alcool généralement diluée avec une boisson non alcoolisée."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "52ef651a-e834-402f-9c97-54be3741dba7",
                                                "sense_id": "4b1a6238-73bd-3f97-b8b8-603314a13d90",
                                                "text": "J’bois mon flash et j’suis quillé,\nJe n’sais même plus l’heure qu’il est."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c61c71e2-8ed4-3005-8bcd-3e38272a52cd",
                                        "entry_id": "019a096c-58ff-393e-bb80-05d572200de3",
                                        "glosses": [
                                            "Vision très brève et presciente."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8cc22976-0d19-4862-933e-bee78d4bf048",
                                                "sense_id": "c61c71e2-8ed4-3005-8bcd-3e38272a52cd",
                                                "text": "Une image terrible saisit alors Fabio. Juste un flash. Mais suffisant pour lui figer le sang."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "flash",
