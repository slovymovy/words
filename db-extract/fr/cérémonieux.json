                                    {
                                        "sense_id": "4687c09b-888d-3ab2-81f4-beb308b262ed",
                                        "entry_id": "61f7d4d1-fe3b-3e8f-96d2-dc7dfd3ff585",
                                        "glosses": [
                                            "amtlich, der offiziell korrekten Form entsprechend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "50852850-8b6b-417f-a4c0-255bef328294",
                                                "sense_id": "4687c09b-888d-3ab2-81f4-beb308b262ed",
                                                "text": "Ich musste an dem Schriftsatz noch förmliche Änderungen vornehmen."
                                            },
                                            {
                                                "example_id": "6367919e-14a7-4aec-88b9-890623154853",
                                                "sense_id": "4687c09b-888d-3ab2-81f4-beb308b262ed",
                                                "text": "Die förmliche Anrede lautet Exzellenz."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5b316e3d-0a03-3ad9-b4ec-00f9fa740b08",
                                        "entry_id": "61f7d4d1-fe3b-3e8f-96d2-dc7dfd3ff585",
                                        "glosses": [
                                            "die (äußere) Form des Auftretens betreffend, sich genau an die Regeln und die Etikette haltend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fcf5669e-a62f-48f0-b436-6be2eb8b5979",
                                                "sense_id": "5b316e3d-0a03-3ad9-b4ec-00f9fa740b08",
                                                "text": "Er war, was das betrifft, sehr förmlich."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "3cf107fa-ccb1-3d58-a4f6-eec6f575bb73",
                                        "entry_id": "61f7d4d1-fe3b-3e8f-96d2-dc7dfd3ff585",
                                        "glosses": [
                                            "geradezu"
                                        ],
                                        "tags": [
                                            "adverbieller Gebrauch"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "43dd5fa4-ed2a-438f-af0b-2d829d3a60a6",
                                                "sense_id": "3cf107fa-ccb1-3d58-a4f6-eec6f575bb73",
                                                "text": "Man konnte es förmlich spüren, dass da etwas im Gange war."
                                            },
                                            {
                                                "example_id": "d1c11b90-e72b-4c13-a637-9a6eda6cfa9a",
                                                "sense_id": "3cf107fa-ccb1-3d58-a4f6-eec6f575bb73",
                                                "text": "Das Haus ist förmlich ideal für eine große Familie."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4b4b789b-d83c-482a-bdaa-f807e2b00404",
                        "source_entry_id": "73cc6073-b73d-3c73-8726-177f784e95a4",
