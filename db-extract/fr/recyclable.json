                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "recyclable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dcb30761-d90a-3f5e-bb85-4addbe3a98b0",
                                        "entry_id": "5c2d9bb8-8dbc-3214-a985-58df2f5f4d3d",
                                        "glosses": [
                                            "Able to be recycled."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "823dd09c-2293-447b-9454-fb6272dd61c0",
                                                "sense_id": "dcb30761-d90a-3f5e-bb85-4addbe3a98b0",
                                                "text": "Soda cans are recyclable."
                                            },
                                            {
                                                "example_id": "9200345a-74ee-4160-876c-ee91ea2bc696",
                                                "sense_id": "dcb30761-d90a-3f5e-bb85-4addbe3a98b0",
                                                "text": "People are reminded again, as before, please do not leave plastic bottles, milk containers or otherwise at the Bring Centre – there are no plastic containers there any longer for such recyclable materials."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "recyclable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6e6a05ae-1245-38ae-bdae-53fea2b3686d",
                                        "entry_id": "d3ccb1f8-30a0-3cfd-bc40-8ab1a10dc3a5",
                                        "glosses": [
                                            "An object that can be recycled, such as a soda can."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df02ec15-6aa6-46f2-91a3-ce17de1be050",
                                                "sense_id": "6e6a05ae-1245-38ae-bdae-53fea2b3686d",
                                                "text": "The garbage and recyclables need to be taken out to the street tomorrow."
                                            },
                                            {
                                                "example_id": "c3eab3f0-f10d-4e80-bafc-f90eec7ef0f7",
                                                "sense_id": "6e6a05ae-1245-38ae-bdae-53fea2b3686d",
                                                "text": "A pull-out trash drawer gives you a place to hide kitchen waste and recyclables."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
