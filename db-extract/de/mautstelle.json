                            {
                                "example_id": "9ed43ebf-55e8-4fd7-bc11-e1c5f76600ee",
                                "sense_id": "f1b79089-672d-37e2-9cc6-0670b0556df7",
                                "text": "Vor der Mautstelle stauen sich wieder einmal die Autos."
                            },
                            {
                                "example_id": "8967d5f4-b4ad-4bb9-b031-00bd8beb8e65",
                                "sense_id": "f1b79089-672d-37e2-9cc6-0670b0556df7",
                                "text": "„In Südtirol sollte man sich auf Stau auf der Brennerautobahn Richtung Bozen vor der Mautstelle Sterzing, in Salzburg auf der Tauernautobahn (A10) vor den Tunnelabschnitten Richtung Villach einstellen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
