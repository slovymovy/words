                "senses": [
                    {
                        "sense_id": "0b5a6769-fe4f-33c5-b475-296683a33623",
                        "entry_id": "25add13e-5407-3f8d-93e2-5bce735cd658",
                        "glosses": [
                            "zum Töten entwickelter Roboter"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a2011b8d-a4be-4b81-b7e5-f7fc596fddc5",
                                "sense_id": "0b5a6769-fe4f-33c5-b475-296683a33623",
                                "text": "„Die eine schöne Frau programmiert die mit dem Gedächtnisverlust so um, dass sie sich für einen Killerroboter hält, der jeden Befehl der schönen Frau befolgen muss.“"
                            },
                            {
                                "example_id": "78bfbde4-32e7-4bf6-9365-86276c6b5fa6",
                                "sense_id": "0b5a6769-fe4f-33c5-b475-296683a33623",
                                "text": "„›Verziehen Sie sich in Ihre Höhle. Töten Sie den Mann, der uns so viel Ärger macht. Ich gebe Ihnen genügend Spielraum, so als ginge es um eine wichtige Zielperson irgendwo auf einem anderen Kontinent. Aber ich gebe Ihnen keine Killerroboter.‹“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
