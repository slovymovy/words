                ],
                "senses": [
                    {
                        "sense_id": "b54795b4-5220-3ba6-bf37-d6f4bb647ebc",
                        "entry_id": "29f17f72-2d31-3af7-9c82-13ec3d9551a8",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b1ff69a-98d5-4a88-87a2-4cf73710ac0a",
                                "sense_id": "b54795b4-5220-3ba6-bf37-d6f4bb647ebc",
                                "text": "Frau Zimmerle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "eb25741c-708d-40ad-a86b-f43f57bef1e7",
                                "sense_id": "b54795b4-5220-3ba6-bf37-d6f4bb647ebc",
                                "text": "Herr Zimmerle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "fd5917fb-0a14-41ff-85de-af9bebfcc436",
                                "sense_id": "b54795b4-5220-3ba6-bf37-d6f4bb647ebc",
                                "text": "Die Zimmerles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "d0888427-fef4-4185-8daa-47720bb52901",
                                "sense_id": "b54795b4-5220-3ba6-bf37-d6f4bb647ebc",
                                "text": "Der Zimmerle trägt nie die Schals, die die Zimmerle ihm strickt."
                            },
                            {
                                "example_id": "f2492376-0e0a-4d29-b388-12c7b7f2d2fa",
                                "sense_id": "b54795b4-5220-3ba6-bf37-d6f4bb647ebc",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Zimmerle kommt, geht der Herr Zimmerle.“"
                            },
                            {
                                "example_id": "a0a69c04-c1e0-4ee0-b6d1-2733ce04af2e",
                                "sense_id": "b54795b4-5220-3ba6-bf37-d6f4bb647ebc",
                                "text": "Zimmerle kommt und geht."
                            },
                            {
                                "example_id": "8643b55e-36e8-4cfc-9e69-2ee48f5d7935",
                                "sense_id": "b54795b4-5220-3ba6-bf37-d6f4bb647ebc",
                                "text": "Zimmerles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
