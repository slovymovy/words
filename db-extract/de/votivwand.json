                "senses": [
                    {
                        "sense_id": "f93cd4c2-5688-3f97-b917-bffcda79ec94",
                        "entry_id": "c8753e1b-b648-3c5b-b2d7-70cc91004d02",
                        "glosses": [
                            "feste Wandfläche, auf die Votivgaben installiert sind oder werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c9d54da-f2f4-46f9-81ce-7fb0907d9e45",
                                "sense_id": "f93cd4c2-5688-3f97-b917-bffcda79ec94",
                                "text": "„Eine Votivwand mit zahlreichen Bildchen hinter dem Altar zeigt die Dankbarkeit der Pilgerschar.“"
                            },
                            {
                                "example_id": "1ccb7084-dedc-4ca7-9289-66e40662a02f",
                                "sense_id": "f93cd4c2-5688-3f97-b917-bffcda79ec94",
                                "text": "„Die Nonnen von Müstair nehmen diese Bitten und Danksagungen regelmässig von der Votivwand ab, um sie dann in ihre Gebete einzuschliessen.“"
                            },
                            {
                                "example_id": "24785cf7-71ee-4b81-b13a-d3ec25ab4443",
                                "sense_id": "f93cd4c2-5688-3f97-b917-bffcda79ec94",
                                "text": "„Die Votivwand in der Wallfahrtskirche Maria Buchen.“"
                            },
                            {
                                "example_id": "11bfde93-bded-42fe-9196-6eabe9fb8b5b",
                                "sense_id": "f93cd4c2-5688-3f97-b917-bffcda79ec94",
                                "text": "„Daher kam die Idee, dieses Element zu bestärken und eine große Votivwand unter Einbeziehung der vorhandenen Bilder und Figuren und nahe bei dem Weihwasserbrunnen zu schaffen.“"
                            },
                            {
                                "example_id": "e17560e5-b8f1-4c5b-8569-cb841d14c0b4",
                                "sense_id": "f93cd4c2-5688-3f97-b917-bffcda79ec94",
                                "text": "„ Jedes Jahr kommen Menschen aus aller Welt, um die Schwarze Muttergottes in der Gnadenkapelle zu sehen und an der Votivwand eine Fürbitte zu hinterlassen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
