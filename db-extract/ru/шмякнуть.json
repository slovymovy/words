                ],
                "senses": [
                    {
                        "sense_id": "528dd255-f3b1-3c1d-b5a5-1718cfbdf5e5",
                        "entry_id": "3b0642fa-1403-3429-bdba-4b37012f3a87",
                        "glosses": [
                            "разг. однокр. к шмякать; уронить или бросить, произведя глухой, шлёпающий звук"
                        ],
                        "tags": [
                            "semelefactive"
                        ],
                        "examples": [
                            {
                                "example_id": "746f367f-6865-48c6-b733-2d2636f124d3",
                                "sense_id": "528dd255-f3b1-3c1d-b5a5-1718cfbdf5e5",
                                "text": "Через минут пять мы выбрались на шоссе, и Потапов шмякнул мешок на асфальт."
                            }
                        ]
                    },
                    {
                        "sense_id": "f4774d28-168e-3b97-9a7b-b33a490c2f5f",
                        "entry_id": "3b0642fa-1403-3429-bdba-4b37012f3a87",
                        "glosses": [
                            "разг. однокр. к шмякать; хлопнуть со шлёпающим звуком"
                        ],
                        "tags": [
                            "semelefactive"
                        ],
                        "examples": [
                            {
                                "example_id": "f0996408-6150-4ed5-a353-3d3d0b29f307",
                                "sense_id": "f4774d28-168e-3b97-9a7b-b33a490c2f5f",
                                "text": "А тот шмякнул по рысаку вожжами и покатил, пыль только."
                            },
                            {
                                "example_id": "a530c966-7a12-46ac-ac4f-639dedb57379",
                                "sense_id": "f4774d28-168e-3b97-9a7b-b33a490c2f5f",
                                "text": "А ты штемпель не туда шмякнул."
                            },
                            {
                                "example_id": "cab436ed-cd18-49b5-840b-77807fbf59dd",
                                "sense_id": "f4774d28-168e-3b97-9a7b-b33a490c2f5f",
                                "text": "По двери с той стороны шмякнули чем-то увесистым, что разбилось вдребезги и со звоном осыпалось на пол."
                            }
                        ]
                    }
                ],
