                        "target_lang_word": "Frühlingstag",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Frühlingstag",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "445a0627-c1eb-3c2a-a8a0-109abcdf6892",
                                        "entry_id": "f379ecbd-4ebb-3faa-8d8a-65288aae9d4c",
                                        "glosses": [
                                            "Tag im Frühling"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7cf0fdc9-34cf-4124-8d7b-bebf7c7b4b6b",
                                                "sense_id": "445a0627-c1eb-3c2a-a8a0-109abcdf6892",
                                                "text": "Erwin wurde an einem Frühlingstag geboren."
                                            },
                                            {
                                                "example_id": "f4b97437-f828-4240-830d-d314283c4bbf",
                                                "sense_id": "445a0627-c1eb-3c2a-a8a0-109abcdf6892",
                                                "text": "Gibt es eine meteorologische Definition für einen Frühlingstag?"
                                            },
                                            {
                                                "example_id": "f5b738ae-4e82-49f3-8eb8-c560e1b845e9",
                                                "sense_id": "445a0627-c1eb-3c2a-a8a0-109abcdf6892",
                                                "text": "„Ins ostpolnische Zamość bin ich an einem kalten und düsteren Frühlingstag gekommen, von Westen her durch eine Gegend voller Fischteiche, Fichtenwälder, historischer Massaker.“"
                                            },
                                            {
                                                "example_id": "6c6afce5-90f9-4da7-bb54-3125937b6d53",
                                                "sense_id": "445a0627-c1eb-3c2a-a8a0-109abcdf6892",
                                                "text": "„Das war an einem der ersten Frühlingstage.“"
                                            },
                                            {
                                                "example_id": "3c5165b9-3af2-44b8-99af-81e4df3bfa1b",
                                                "sense_id": "445a0627-c1eb-3c2a-a8a0-109abcdf6892",
                                                "text": "„Es war ein herrlicher Frühlingstag, und ich ging von der Place de l'Observatoire durch den kleinen Luxembourg.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
