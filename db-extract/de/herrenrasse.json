                "senses": [
                    {
                        "sense_id": "e7a04d07-8659-3e6a-b1ff-37d1cc5d9b59",
                        "entry_id": "2db02da9-3c4e-3cc7-beef-f0bdaf61133f",
                        "glosses": [
                            "als überlegen angesehene Rasse"
                        ],
                        "tags": [
                            "im Nationalsozialismus und anderen rassistischen Ideologien"
                        ],
                        "examples": [
                            {
                                "example_id": "1a7726ea-d027-4d50-9261-e01865dcb2aa",
                                "sense_id": "e7a04d07-8659-3e6a-b1ff-37d1cc5d9b59",
                                "text": "„Welche Farbe hatte der Holocaust? Wahrscheinlich weiß. Der Engel des Todes hatte weiße Flügel und eine weiße Kappe. Meine Großmutter nähte im Lager Theresienstadt ihr eigenes Totenhemd, und es war weiß. Es sah aus wie die weißen Umhänge, die mein Vater und seine Freunde an Jom Kippur, dem Versöhnungsfest, zum Gottesdienst in unserer Jecke-Synagoge in Jerusalem trugen. Dr. Josef Mengele trug einen weißen Kittel in seiner ›Klinik‹. Die Arier waren die weiße Herrenrasse.“"
                            },
                            {
                                "example_id": "77a71014-40c3-4b4e-af4f-3d360831f150",
                                "sense_id": "e7a04d07-8659-3e6a-b1ff-37d1cc5d9b59",
                                "text": "„Um aus einer Sklavenrasse eine Herrenrasse zu machen, sagte Mr. Whittier, um unterdrückten Menschen beizubringen, wie sie ihr Leben selbst in die Hand nehmen konnten, musste Moses ein Arschloch sein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3f75753f-25be-422c-a42e-4d82adce1cdf",
                        "source_entry_id": "2db02da9-3c4e-3cc7-beef-f0bdaf61133f",
                        "source_sense_id": "e7a04d07-8659-3e6a-b1ff-37d1cc5d9b59",
                        "source_sense_description": "als überlegen angesehene Rasse",
                        "target_lang_word": "master race",
                        "target_lang_code": "en",
