                    }
                ],
                "translations": [
                    {
                        "translation_id": "da275201-9148-4e92-9da8-1e2ae51ab718",
                        "source_entry_id": "a325cd34-be92-33c3-92ad-3d06b1d861ac",
                        "source_sense_description": "vessel",
                        "target_lang_word": "kolenschip",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kolenschip",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "9e4e8ffe-fd96-37c9-a87b-1d06d882e067",
                                        "entry_id": "92f9bf19-83cc-3271-b885-552d77a34b7d",
                                        "glosses": [
                                            "vrachtboot die gebruikt wordt voor het vervoer van steenkolen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "305eb555-ddbd-4c1c-bffc-4cafdf4cce5c",
                                                "sense_id": "9e4e8ffe-fd96-37c9-a87b-1d06d882e067",
                                                "text": "De Empress of Ireland was met 1477 mensen aan boord op weg van Quebec naar Liverpool toen ze op de St. Lawrence Rivier in dichte mist in aanvaring kwam met een volgeladen Noors kolenschip. Er werd een enorm gat geslagen in de romp, het schip maakte slagzij en zonk binnen een kwartier."
                                            },
                                            {
                                                "example_id": "f34a0cc0-de5e-45fb-8a3a-7e3e3bcd9020",
                                                "sense_id": "9e4e8ffe-fd96-37c9-a87b-1d06d882e067",
                                                "text": "Het Chinese kolenschip Shen Neng dat anderhalve week geleden vastliep op het Great Barrier Reef bij Australië heeft meer schade aangericht dan gedacht. De beheerder van het koraalrif maakt zich vooral zorgen over verfresten van de romp die zijn achtergebleven."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b0b7d789-810e-4393-a7ea-39e150c61730",
                        "source_entry_id": "a325cd34-be92-33c3-92ad-3d06b1d861ac",
                        "source_sense_description": "vessel",
                        "target_lang_word": "koolschip",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "c37fe9a1-0399-46b9-9564-d9a55d3bde52",
                        "source_entry_id": "a325cd34-be92-33c3-92ad-3d06b1d861ac",
                        "source_sense_description": "vessel",
                        "target_lang_word": "charbonnier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "charbonnier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4a65ec01-7f90-36cf-b1e4-a558358bae21",
                                        "entry_id": "f5bfc3a6-6c27-3e19-a4a3-85c05e1afab0",
                                        "glosses": [
                                            "Celui qui fait ou qui vend du charbon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9f55174-ac41-4b17-8906-5af4119e11e2",
                                                "sense_id": "4a65ec01-7f90-36cf-b1e4-a558358bae21",
                                                "text": "Vingt ans auparavant, les charbonniers avaient fait là leur charbonnière, et la place est restée battue ; tout y a été brûlé dans une circonférence assez vaste."
                                            },
                                            {
                                                "example_id": "98f1a0b5-1df3-4343-9f30-f8a79d8daadf",
                                                "sense_id": "4a65ec01-7f90-36cf-b1e4-a558358bae21",
                                                "text": "Comme je paraissais faible et que je boitais un peu, ma mère avait voulu me faire apprendre un métier plus doux que ceux de notre village ; car, au Dagsberg, on ne trouve que des bûcherons, des charbonniers et des schlitteurs."
                                            },
                                            {
                                                "example_id": "a1a23f8e-7e7d-4261-9728-11cec3c8ceb2",
                                                "sense_id": "4a65ec01-7f90-36cf-b1e4-a558358bae21",
                                                "text": "Il ne reste plus au charbonnier qu'à surveiller et à diriger le feu de manière à éviter la combustion entière du bois, tout en opérant la carbonisation."
                                            },
                                            {
                                                "example_id": "57cf8346-0b33-424d-af80-15562f5fc8ca",
                                                "sense_id": "4a65ec01-7f90-36cf-b1e4-a558358bae21",
                                                "text": "Le gars aux biques portait, sous une limousine de roulier, un bourgeron bleu serré à la taille par une ceinture rouge qui maintenait un pantalon de velours à l'instar des charbonniers auvergnats, […]."
                                            },
                                            {
                                                "example_id": "180a1934-509b-46b7-b97c-81b8c348651d",
                                                "sense_id": "4a65ec01-7f90-36cf-b1e4-a558358bae21",
                                                "text": "Devant une hutte de terre et de branches, une famille de charbonniers nous regardait passer. Si nous leur criions bonjour, ils inclinaient gravement la tête.\n « Ça doit être des Italiens. »\nEntre deux pierres dormaient des cendres chaudes et près du foyer la femme, accroupie, penchant sur son enfant un visage olivâtre, aux yeux sombres, le berçait en silence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "45997397-9405-36db-a615-ff2eeb151c9f",
                                        "entry_id": "f5bfc3a6-6c27-3e19-a4a3-85c05e1afab0",
                                        "glosses": [
                                            "Mineur qui travaille aux mines de houille."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5b0ab91f-21d2-318b-879f-1a10b381c279",
                                        "entry_id": "f5bfc3a6-6c27-3e19-a4a3-85c05e1afab0",
                                        "glosses": [
                                            "Celui qui conduit le fourneau."
                                        ],
                                        "tags": [
                                            "Histoire des techniques"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3afd58b0-d9d6-3934-a3f8-1510277a1edb",
                                        "entry_id": "f5bfc3a6-6c27-3e19-a4a3-85c05e1afab0",
                                        "glosses": [
                                            "Lieu où l’on fait, où l’on met le charbon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "76199f18-6d8b-4bbd-9b3c-83f97bad66fc",
                                                "sense_id": "3afd58b0-d9d6-3934-a3f8-1510277a1edb",
                                                "text": "N’y a-t-il pas moyen d’apporter le charbon sans traverser le village […] ? […] Oui, Monsieur, on peut passer derrière les maisons, et vider le sac dans le charbonnier qui se trouve adossé au hangar par dehors."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3257929a-b222-3e62-adb2-3b9067db2893",
                                        "entry_id": "f5bfc3a6-6c27-3e19-a4a3-85c05e1afab0",
                                        "glosses": [
                                            "Bâtiment affecté au transport du charbon."
                                        ],
                                        "tags": [
                                            "Navigation"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b93a3a34-429d-4378-ab20-17d6e275ce6c",
                                                "sense_id": "3257929a-b222-3e62-adb2-3b9067db2893",
                                                "text": "Ce n’était plus seulement les navires à voiles ou à vapeur qu’il était intéressant de suivre des yeux, les grands trois-mâts, les énormes steamers revenant des pays lointains, les charbonniers tout noirs, les barques chargées de paille ou de foin qui ressemblaient à des meules de fourrages emportées par le courant, les grosses tonnes rouges, blanches, noires, que le flot faisait tournoyer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ee4bceb-d4ea-30f4-aa1e-0b7ccebd9a26",
                                        "entry_id": "f5bfc3a6-6c27-3e19-a4a3-85c05e1afab0",
                                        "glosses": [
                                            "Terre où les cerfs frottent leurs bois."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e1246a47-719a-36d8-9e26-345b6f2d7710",
                                        "entry_id": "f5bfc3a6-6c27-3e19-a4a3-85c05e1afab0",
                                        "glosses": [
                                            "Four où l’on brûlait la houille pour en retirer le soufre."
                                        ],
                                        "tags": [
                                            "Histoire des techniques"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c2dee1ab-5b93-30c4-a9e1-d5cd7230f8dd",
                                        "entry_id": "f5bfc3a6-6c27-3e19-a4a3-85c05e1afab0",
                                        "glosses": [
                                            "Variété de renard dont le pelage tire vers le noir."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e6c88bd5-9773-4b97-bfcd-c96d7682a536",
                                                "sense_id": "c2dee1ab-5b93-30c4-a9e1-d5cd7230f8dd",
                                                "text": "Ce qui détermina la chute de gros Zidore et de gros Léon ce fut tout simplement une petite jalousie de chasseurs provoquée par un malheureux renard, un vulgaire goupil, un vieux charbonnier à museau chafouin, à queue pelée […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "28361f28-3c79-350b-b03d-d18abcd2f7ab",
                                        "entry_id": "f5bfc3a6-6c27-3e19-a4a3-85c05e1afab0",
                                        "glosses": [
                                            "Synonyme de tricholome couleur de souris (espèce de champignons)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1b9919c4-f010-34a8-9011-a5e2fe624265",
                                        "entry_id": "f5bfc3a6-6c27-3e19-a4a3-85c05e1afab0",
                                        "glosses": [
                                            "Synonyme de tricholome prétentieux (espèce de champignons)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "acb236b4-c495-37ca-a04c-551bae6cb7d1",
                                        "entry_id": "f5bfc3a6-6c27-3e19-a4a3-85c05e1afab0",
                                        "glosses": [
                                            "Espèce de poissons téléostéen, du genre Anoplopoma."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "charbonnier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6049c5ec-f4f7-363b-8017-42ae71e55680",
                                        "entry_id": "e244f486-2ffc-3738-a04f-77675488d8e9",
                                        "glosses": [
                                            "Relatif au charbon, qui produit du charbon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34bf2d46-92f0-4c3d-9129-d92783d8395f",
                                                "sense_id": "6049c5ec-f4f7-363b-8017-42ae71e55680",
                                                "text": "[…], depuis la Seconde Guerre mondiale, les nations d'Europe occidentale ont laissé dépérir leur industrie charbonnière, tant il était facile de se procurer, en abondance et à bas prix, le pétrole du Proche et du Moyen-Orient."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eca93584-8ab5-3173-93a6-ab97da7e9380",
                                        "entry_id": "e244f486-2ffc-3738-a04f-77675488d8e9",
                                        "glosses": [
                                            "Relatif au bâtiment transportant du charbon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a0ee5ff-1471-48cf-a8ba-f5e60f8881f5",
                                                "sense_id": "eca93584-8ab5-3173-93a6-ab97da7e9380",
                                                "text": "Appelé à Nantes pour affaires, il imagina de revenir incognito à Guernesey sur un bateau charbonnier, transformé par son mirage en un dangereux corsaire, et il escomptait notre surprise à tous. Or, il advint que l’apparition au large de ce sabot noir et insolite inquiéta le capitaine du port, qui lui donna ordre de stopper et s’informa incivilement de ce qu’il avait à bord."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "68894e8f-bdef-399e-a6c4-3abef42dbbcc",
                                        "entry_id": "e244f486-2ffc-3738-a04f-77675488d8e9",
                                        "glosses": [
                                            "Dont le pelage ou le plumage tire sur le noir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f20333ae-fdfd-4063-8b99-dc944e8e4907",
                                                "sense_id": "68894e8f-bdef-399e-a6c4-3abef42dbbcc",
                                                "text": "Renard charbonnier."
                                            },
                                            {
                                                "example_id": "d8649232-b38f-4867-a8b9-e9400fd57372",
                                                "sense_id": "68894e8f-bdef-399e-a6c4-3abef42dbbcc",
                                                "text": "Mésange charbonnière."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "83bdd259-3bb9-3d7a-abd4-3ab53f022a5c",
                                        "entry_id": "e244f486-2ffc-3738-a04f-77675488d8e9",
                                        "glosses": [
                                            "Qualifie les champignons dont le chapeau est brun foncé ou noir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d418433-7788-4c8c-9c9e-f7cfedac54cd",
                                                "sense_id": "83bdd259-3bb9-3d7a-abd4-3ab53f022a5c",
                                                "text": "Champignon charbonnier."
                                            }
                                        ]
                                    }
                                ]
