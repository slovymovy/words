{
    "word_family": [
        "gabled"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8a42a7ec-af6a-33de-9e43-6e7d21baf543",
                    "sense_definition": "The triangular upper part of a wall at the end of a pitched roof.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A bird built its nest beneath the high <w>gable</w> of the cottage.",
                            "target_lang_translations": {
                                "es": "Un pájaro construyó su nido debajo del alto <w>hastial</w> de la cabaña."
                            }
                        },
                        {
                            "text": "The traditional stone house featured a decorative front <w>gable</w> facing the village square.",
                            "target_lang_translations": {
                                "es": "La tradicional casa de piedra contaba con un <w>frontón</w> decorativo orientado hacia la plaza del pueblo."
                            }
                        }
                    ],
                    "synonyms": [
                        "pediment"
                    ],
                    "common_phrases": [
                        "front gable"
                    ],
                    "target_lang_definitions": {
                        "es": "Parte triangular superior de una pared en el extremo de un tejado a dos aguas."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "hastial",
                                "target_lang_sense_clarification": "pared triangular bajo el tejado"
                            },
                            {
                                "target_lang_word": "frontón",
                                "target_lang_sense_clarification": "remate triangular de una fachada"
                            },
                            {
                                "target_lang_word": "gablete",
                                "target_lang_sense_clarification": "remate triangular decorativo, típico del gótico"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "70a51b81-77df-326c-8b32-587f3ff23060",
                    "sense_definition": "A heavy, thick rope or wire; a cable.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sailors secured the ship to the pier using a thick <w>gable</w>.",
                            "target_lang_translations": {
                                "es": "Los marineros aseguraron el barco al muelle utilizando una gruesa <w>maroma</w>."
                            }
                        },
                        {
                            "text": "Under the tension of the violent storm, the anchor <w>gable</w> suddenly snapped.",
                            "target_lang_translations": {
                                "es": "Bajo la tensión de la violenta tormenta, el <w>cable</w> del ancla se partió repentinamente."
                            }
                        }
                    ],
                    "synonyms": [
                        "cable",
                        "rope"
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Cuerda o alambre grueso y pesado; cable (término arcaico)."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "cable",
                                "target_lang_sense_clarification": "maroma gruesa de barco"
                            },
                            {
                                "target_lang_word": "maroma",
                                "target_lang_sense_clarification": "cuerda muy gruesa"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "ad1169dd-422a-3290-90b1-66a0b16c196e",
                    "sense_definition": "A surname transferred from the given name or from the architectural feature.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The classic film starred Clark <w>Gable</w> in one of his most memorable performances.",
                            "target_lang_translations": {
                                "es": "El clásico cinematográfico estuvo protagonizado por Clark <w>Gable</w> en una de sus interpretaciones más memorables."
                            }
                        },
                        {
                            "text": "Professor <w>Gable</w> delivered an inspiring lecture on medieval architecture this morning.",
                            "target_lang_translations": {
                                "es": "El profesor <w>Gable</w> ofreció esta mañana una inspiradora conferencia sobre arquitectura medieval."
                            }
