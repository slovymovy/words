        "fr-extract.jsonl": [
            {
                "entry_id": "589ecb9c-2140-35dc-a097-8eac849817da",
                "word": "Ducat",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "105176d7-281d-346a-acc2-8c33069eca02",
                        "entry_id": "589ecb9c-2140-35dc-a097-8eac849817da",
                        "glosses": [
                            "Nom de famille."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "674baa85-b88e-4947-8390-8ba080e329e0",
                                "sense_id": "105176d7-281d-346a-acc2-8c33069eca02",
                                "text": "Pour le reste, la Section comptera sur ses habituels tauliers (Rey, Ducat, Whitelock, Hewat, Puech, Maddocks…) afin de viser un exploit dont il était passé à deux doigts en décembre dernier (26-22)."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "2266d8a1-08db-3704-ae24-9e31eca28cdc",
                "word": "ducat",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "b417e572-3636-4694-8bd0-ac3c7b6a405a",
                        "entry_id": "2266d8a1-08db-3704-ae24-9e31eca28cdc",
                        "tags": [
                            "plural"
                        ],
                        "form": "ducats"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d9a17854-96c4-3f35-8610-d840917ef909",
                        "entry_id": "2266d8a1-08db-3704-ae24-9e31eca28cdc",
                        "glosses": [
                            "Ancienne pièce de monnaie d’or ou d’argent, émise par un duché, dont la valeur variait suivant les différents pays."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f792ef4d-81e7-4f3d-9d46-aa09c6f37585",
                                "sense_id": "d9a17854-96c4-3f35-8610-d840917ef909",
                                "text": "Je signe : il me donne trois ducats."
                            },
                            {
                                "example_id": "b9f38bd6-a54f-4cac-8d04-678d1ac0847c",
                                "sense_id": "d9a17854-96c4-3f35-8610-d840917ef909",
                                "text": "On entendait, de tous côtés, les carillons des vendeurs de sorbet, de pignolats et de lait caillé, les timbales des astrologues en plein vent, les chansons des guzlares aveugles, dont il y avait quantité, Mme Maria-Pia leur faisant à tous la pension d'un demi-ducat chaque mois, depuis la naissance de Tatiana."
                            },
                            {
                                "example_id": "26be6412-7fe2-4f07-8ab4-b0a3c4f60569",
                                "sense_id": "d9a17854-96c4-3f35-8610-d840917ef909",
                                "text": "Le brave homme se fit payer deux ducats, mais en compensation il m'enveloppa de sa grosse houppelande, et me chanta deux ou trois chansons mecklembourgeoises qui me parurent assez jolies."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1b107d10-efe5-460b-894b-4279846c1a5f",
                        "source_entry_id": "2266d8a1-08db-3704-ae24-9e31eca28cdc",
                        "source_sense_id": "d9a17854-96c4-3f35-8610-d840917ef909",
                        "target_lang_word": "Dukat",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "f45475d0-90f0-46b0-a30a-984f99a1e264",
                        "source_entry_id": "2266d8a1-08db-3704-ae24-9e31eca28cdc",
                        "source_sense_id": "d9a17854-96c4-3f35-8610-d840917ef909",
                        "target_lang_word": "Dukaten",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dukaten",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d2a159bb-e862-32f2-a6bc-8c1e049be372",
                                        "entry_id": "5fef9fce-5cdb-3953-a110-d055aab9221f",
                                        "glosses": [
                                            "eine Goldmünze, die vor allem im Europa der Frühen Neuzeit zum Handel diente und als Nachprägung bis heute als Sammel- und Geschenkmünze verwendet wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "346d1291-13e2-490e-820c-ea76ddce75a4",
                                                "sense_id": "d2a159bb-e862-32f2-a6bc-8c1e049be372",
                                                "text": "„Nur, auch dazu bedurfte es Pfenninge, Taler und Dukaten, die eben sehr dünn gesät waren.“"
                                            },
                                            {
                                                "example_id": "6764731e-6bd2-4675-bc88-a9d779e69e13",
                                                "sense_id": "d2a159bb-e862-32f2-a6bc-8c1e049be372",
                                                "text": "„Einfache Dukaten haben sich seit 1974 (weil sie nicht so selten sind wie der Viertelphilharmoniker) dagegen stabil gehalten und sind nach einem Ausgabepreis von 412 S derzeit 475 S wert.“"
                                            },
                                            {
                                                "example_id": "254d29e1-8c54-4e96-9486-40c3337d7b56",
                                                "sense_id": "d2a159bb-e862-32f2-a6bc-8c1e049be372",
                                                "text": "„Die Kosaken schlugen das Pferd für zwei Dukaten los, und Rostow kaufte es; jetzt, nachdem er sein Geld bekommen hatte, war er einer von den reichsten Offizieren des Regiments.“"
                                            },
                                            {
                                                "example_id": "4fb35065-8fed-44dd-bd64-2b93e74fca2d",
                                                "sense_id": "d2a159bb-e862-32f2-a6bc-8c1e049be372",
                                                "text": "„Dieser Mann, der mir eigentlich nur die sechzig Dukaten geben sollte, sagte mir, als er den Brief gelesen hatte, ich solle bei ihm übernachten, denn er würde sich sehr freuen, wenn ich seinen Sohn kennenlernte, der ebenfalls Dichter sei.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ea8fa779-ed57-417a-b846-36e44038c54e",
                        "source_entry_id": "2266d8a1-08db-3704-ae24-9e31eca28cdc",
                        "source_sense_id": "d9a17854-96c4-3f35-8610-d840917ef909",
                        "target_lang_word": "ducat",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ducat",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b3100de7-844f-3306-8f16-db4f5ebb1f23",
                                        "entry_id": "7abcd0f8-e4f2-3837-aab5-0be6891b6757",
                                        "glosses": [
                                            "A gold coin minted by various European nations."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a3a5bfba-9b50-4edc-a5a0-b26240554c64",
                                                "sense_id": "b3100de7-844f-3306-8f16-db4f5ebb1f23",
                                                "text": "Shylock: \"My daughter! O my ducats! Fled with a Christian! O my Christian ducats! Justice! the law! my ducats, and my daughter!...\""
                                            },
                                            {
                                                "example_id": "edc55b37-79b2-4c9f-be7f-9507a85d2a35",
                                                "sense_id": "b3100de7-844f-3306-8f16-db4f5ebb1f23",
                                                "text": "But when the innkeeper saw what kind of goat the lad had, he thought this was a goat worth having, so when the lad had fallen asleep, he took another goat which couldn't make any golden ducats, and put that in its place."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2c9933f5-4301-329c-9ede-acbda4e79625",
                                        "entry_id": "7abcd0f8-e4f2-3837-aab5-0be6891b6757",
                                        "glosses": [
                                            "A coin of the major denomination (dollar, euro, etc.); money in general."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7b22605d-291b-3508-8ad0-6f4f2ab6ad9e",
                                        "entry_id": "7abcd0f8-e4f2-3837-aab5-0be6891b6757",
                                        "glosses": [
                                            "A ticket."
                                        ],
                                        "tags": [
                                            "US",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "edbfb200-f708-4334-bfb2-3112bd70b333",
                                                "sense_id": "7b22605d-291b-3508-8ad0-6f4f2ab6ad9e",
                                                "text": "Ned Beaumont said, \"Well, I've got a ducat that reads to there, anyway."
                                            },
                                            {
                                                "example_id": "8650649c-bafc-49ad-bf0c-1fc414f9ef90",
                                                "sense_id": "7b22605d-291b-3508-8ad0-6f4f2ab6ad9e",
                                                "text": "Customers are usually enticed in with a \"ducat\", or pass for one free dance."
                                            },
                                            {
                                                "example_id": "2c856107-15f0-4894-a634-a2e77fc46b9e",
                                                "sense_id": "7b22605d-291b-3508-8ad0-6f4f2ab6ad9e",
                                                "text": "[…] the lines at the box office since ducats went on sale publicly Wednesday […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
