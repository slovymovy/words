                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "einsatzunfaehigkeit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wegen einer Knieverletzung wird der beste Spieler der Mannschaft für mindestens drei Wochen <w>ausfallen</w>."
                        },
                        {
                            "text": "Unsere Kollegin <w>fällt</w> schon seit zwei Wochen wegen einer hartnäckigen Erkältung im Büro <w>aus</w>."
