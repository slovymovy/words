                "senses": [
                    {
                        "sense_id": "06bb8de7-b8a9-3ade-b5da-f617dc8d900a",
                        "entry_id": "4045c10c-680b-3b6f-a35d-3d10eaa2ec48",
                        "glosses": [
                            "Donner un caractère mélodique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a8e95f8-953a-4779-818e-bcd8e5f9724e",
                                "sense_id": "06bb8de7-b8a9-3ade-b5da-f617dc8d900a",
                                "text": "Et les musiciens noirs américains n’auraient, en partie, fait que « mélodiser » ces motifs."
                            },
                            {
                                "example_id": "b5974e8f-a831-4865-bedb-0a9ab14489ff",
                                "sense_id": "06bb8de7-b8a9-3ade-b5da-f617dc8d900a",
                                "text": "Mais si l’on choisit de les lire ou de les «dire» il faut utiliser des ressources différentes du chant, et surtout éviter de «mélodiser» sa lecture."
                            },
                            {
                                "example_id": "cdf0b454-825b-42b6-bbf3-27028b1541a4",
                                "sense_id": "06bb8de7-b8a9-3ade-b5da-f617dc8d900a",
                                "text": "Militante pour la chanson française de belle écriture, elle swingue, — (site www.zondits.net)jazzecinquantise, mélodise, comédie musicalise, mais encore électroacoustise..."
                            }
                        ]
                    }
