                "entry_id": "18be3c95-b924-3fcb-8616-3cbaae923be1",
                "word": "boulder",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "8baa0e42-eabb-4edf-87f9-4752062c7431",
                        "entry_id": "18be3c95-b924-3fcb-8616-3cbaae923be1",
                        "tags": [
                            "plural"
                        ],
                        "form": "boulders"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c275fc37-d42d-333c-9b28-78dae79b9f44",
                        "entry_id": "18be3c95-b924-3fcb-8616-3cbaae923be1",
                        "glosses": [
                            "Importante masse rocheuse, distincte du sol qui l’entoure, que l’on trouve surtout dans des formations argileuses."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "aeb8088b-7576-48a8-9435-c1bb3b55c33e",
                                "sense_id": "c275fc37-d42d-333c-9b28-78dae79b9f44",
                                "text": "Enfin le troisième groupe de ruines, c'est celui de la forteresse au sommet de la colline. […]. Au nord et à l'est, ce sont d'énormes et inaccessibles blocs ou boulders de granit superposés."
                            },
                            {
                                "example_id": "9bfe6601-404e-429c-b773-83ff6e16749e",
                                "sense_id": "c275fc37-d42d-333c-9b28-78dae79b9f44",
                                "text": "Une incompréhensible accumulation de boulders presque noirs."
                            },
                            {
                                "example_id": "a193eafd-dde5-4aad-92d4-8c182e691714",
                                "sense_id": "c275fc37-d42d-333c-9b28-78dae79b9f44",
                                "text": "Depuis que nous longeons le piémont du massif, la brume est revenue, plus épaisse que jamais, au point qu'il est impossible, à plus de vingt mètres, de rien distinguer hormis, lorsqu'ils surgissent, les boulders."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "eb47b51c-78b0-4458-9472-1445ff7fd0f3",
                        "source_entry_id": "18be3c95-b924-3fcb-8616-3cbaae923be1",
                        "source_sense_id": "c275fc37-d42d-333c-9b28-78dae79b9f44",
                        "target_lang_word": "Felsblock",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Felsblock",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cee500c1-0fda-3e80-83bd-4ef0a88f3de9",
                                        "entry_id": "fb127799-9883-3037-8c62-c7a8fff16729",
                                        "glosses": [
                                            "größeres Stück Fels"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce79fd5f-3778-4170-b96e-45d2552dd31d",
                                                "sense_id": "cee500c1-0fda-3e80-83bd-4ef0a88f3de9",
                                                "text": "„Einzelne Felsblöcke und flaches Geröll ragten aus der Wiese.“"
                                            },
                                            {
                                                "example_id": "678ded42-9120-4f60-b016-d64706f19ecc",
                                                "sense_id": "cee500c1-0fda-3e80-83bd-4ef0a88f3de9",
                                                "text": "„In einer Bucht gegenüber, am anderen Ende des L-förmig gekrümmten Sees, ragte ein Felsblock aus dem Wasser.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8d564b57-3eaa-416e-8dc5-0640e1abaa25",
                        "source_entry_id": "18be3c95-b924-3fcb-8616-3cbaae923be1",
