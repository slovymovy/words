                        "glosses": [
                            "One who cultivates a large or impressive vocabulary."
                        ],
                        "tags": [
                            "uncommon"
                        ],
                        "examples": [
                            {
                                "example_id": "b0b2cef6-c6d7-4498-8d34-78bf7eb89d7f",
                                "sense_id": "29938a5b-2d91-35be-b690-c4eccc5fa43c",
                                "text": "You might have one of these prodigious vocabularians in your house."
                            },
                            {
                                "example_id": "f00f9b7b-fa8d-439b-af62-e5a42d4b1e2f",
                                "sense_id": "29938a5b-2d91-35be-b690-c4eccc5fa43c",
                                "text": "Indeed so inventive have been baseball's vocabularians, as Paul Dickson's dictionary indicated, this type of baseball humor shows no sign of slowing down."
                            }
                        ]
                    }
