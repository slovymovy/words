                "senses": [
                    {
                        "sense_id": "918d0d99-266d-3f60-84c2-5f96429422a7",
                        "entry_id": "797f591a-9196-33ae-b2e9-2a154e7a4298",
                        "glosses": [
                            "To mingle again; to mix back in"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "321e41a8-d169-4694-b803-68945f9e88ba",
                                "sense_id": "918d0d99-266d-3f60-84c2-5f96429422a7",
                                "text": "Mourn not, ye friends, all must this tribute pay, And all remingle with our parent clay; What though grim death his object ne'er should miss, He's the sole passport to the realms of bliss'"
                            },
                            {
                                "example_id": "6763cf9c-5e24-474f-be05-9d652e9b4785",
                                "sense_id": "918d0d99-266d-3f60-84c2-5f96429422a7",
                                "text": "Prisoners having once chosen to identify themselves with one group or another, thereafter cannot be permitted to change their minds, or to remingle."
                            },
                            {
                                "example_id": "fb02ea3e-8349-4872-9790-f6a28aec2b1b",
                                "sense_id": "918d0d99-266d-3f60-84c2-5f96429422a7",
                                "text": "The ability to fuse and remingle drives and emotions (both positive and negative) for adaptation purposes indicates the progressive compatibility of the individual's ego as a personality agency."
                            }
                        ]
                    }
                ],
