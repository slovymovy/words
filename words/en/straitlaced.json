                    "frequency": "Low",
                    "semantic_group_id": "moral_attitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>straitlaced</w> community was shocked by the unconventional behavior of the new neighbors.",
                            "target_lang_translations": {
                                "cs": "<w>Upjatá</w> komunita byla šokována nekonvenčním chováním nových sousedů."
                            }
                        },
                        {
                            "text": "She found her parents too <w>straitlaced</w> to understand her desire for more personal freedom.",
                            "target_lang_translations": {
                                "cs": "Přišli jí rodiče příliš <w>upjatí</w> na to, aby pochopili její touhu po větší osobní svobodě."
                            }
                        }
                    ],
                    "synonyms": [
                        "puritanical",
                        "prudish",
                        "prim",
                        "stuffy"
                    ],
                    "antonyms": [
                        "broad-minded",
                        "liberal",
                        "permissive"
                    ],
                    "target_lang_definitions": {
                        "cs": "Mající velmi přísné morální nebo společenské postoje a snadno pohoršitelný věcmi, které považuje za nevhodné."
                    },
                    "translations": {
