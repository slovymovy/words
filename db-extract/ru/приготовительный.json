                                                "example_id": "91e1dedc-52a5-4e46-8a59-20d78f0ed6e3",
                                                "sense_id": "bb1a154b-f9d1-3c0b-b567-a260412c8d4c",
                                                "text": "a preparative unto sermons"
                                            },
                                            {
