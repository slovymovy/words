                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "85d03dd9-898f-4e5f-b4fe-b44c4ec7788e",
                                "sense_id": "f3c089f6-b566-3321-833d-2dc91cccb33a",
                                "text": "Some at City Hall are perturbed that delivering the superhighway and other cycling schemes is becoming a “railroading” exercise."
