            "senses": [
                {
                    "sense_id": "f0bb329e-9018-3f64-b8c5-8df5b4651f65",
                    "sense_definition": "Qu'on ne peut pas apaiser ni fléchir ; qui fait preuve d'une dureté ou d'une sévérité sans merci.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Face aux demandes répétées des accusés, le juge est resté totalement <w>implacable</w>."
                        },
                        {
                            "text": "Ce dictateur poursuivait ses opposants politiques avec une haine <w>implacable</w>."
                        }
                    ],
                    "synonyms": [
                        "impitoyable",
                        "inexorable",
                        "inflexible"
                    ],
                    "antonyms": [
                        "placable"
                    ],
                    "common_phrases": [
                        "un ennemi implacable",
                        "une haine implacable"
                    ]
                },
                {
                    "sense_id": "ebbce9f1-2232-3c96-b0fc-33a18f51c253",
                    "sense_definition": "Dont la rigueur et l'enchaînement sont parfaits et ne laissent aucune place au doute ou à l'erreur.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'avocate a convaincu tous les jurés grâce à une logique <w>implacable</w>."
                        },
                        {
                            "text": "Son raisonnement était <w>implacable</w> et personne n'a pu le contredire."
                        }
                    ],
                    "synonyms": [
                        "imparable",
                        "irréfutable"
                    ],
                    "common_phrases": [
