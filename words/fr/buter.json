                            "text": "Le criminel a menacé de <w>buter</w> tous ceux qui parleraient à la police."
                        },
                        {
                            "text": "Dans cette série télévisée, les espions essaient d'éviter de se faire <w>buter</w>."
                        }
                    ],
                    "synonyms": [
                        "assassiner",
                        "descendre",
                        "tuer"
                    ],
                    "common_phrases": [
                        "buter un témoin",
                        "se faire buter"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "argot"
