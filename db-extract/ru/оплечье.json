                        "examples": [
                            {
                                "example_id": "90d503b6-d026-4d62-8074-5234e943ed38",
                                "sense_id": "751db8aa-1002-3f55-a470-9bde1f4377f7",
                                "text": "При императоре Константине XI Багрянородном оплечье получает совершенно самостоятельную форму, отдельную от остального императорского наряда, и принимает вид круглого воротника, отороченного с внешней стороны полосами, между которыми тянется ряд крупных жемчугов или других каких-нибудь круглых украшений."
                            }
                        ]
                    }
