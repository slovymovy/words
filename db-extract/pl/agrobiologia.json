                    {
                        "translation_id": "1c23e6e3-ee34-43fc-a138-240f4936acde",
                        "source_entry_id": "83dd930a-c2dc-3a5b-9728-9654656d3c56",
                        "source_sense_id": "4d16a0e8-51b8-3eef-94e7-efb24e38fc4c",
                        "target_lang_word": "Agrobiologie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Agrobiologie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "375fec2f-3fd2-3e2f-a175-93e2937e62c7",
                                        "entry_id": "026ca9b2-f742-39e2-8d38-6329b4287d37",
                                        "glosses": [
                                            "Fachrichtung, die sich mit den Gesetzmäßigkeiten in der Landwirtschaft beschäftigt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f87afeac-1fc0-4881-bc20-5a27bd84f626",
                                                "sense_id": "375fec2f-3fd2-3e2f-a175-93e2937e62c7",
                                                "text": "„Auch in einer Krypta in Matera, Italien, seien diese Mikroben bereits nachgewiesen worden, sagt Studienleiter Cesareo Saiz-Jimenez vom Institut für Agrobiologie in Sevilla. ‚Es sieht so aus, als würden diese Bakterien in ganz Europa zur Vernichtung von Gebäuden beitragen.‘“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "87b6e0b9-bde7-4877-9186-870428ec6fc9",
                        "source_entry_id": "83dd930a-c2dc-3a5b-9728-9654656d3c56",
                        "source_sense_id": "4d16a0e8-51b8-3eef-94e7-efb24e38fc4c",
                        "target_lang_word": "Agrarbiologie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Agrarbiologie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fb73c779-863a-31f4-89c2-046b979e02fa",
                                        "entry_id": "21b613f2-e94d-3150-bcce-3ed1edad1d4d",
                                        "glosses": [
                                            "biologische Fachrichtung, die sich mit den wissenschaftlichen Grundlagen der Agrarproduktion beschäftigt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16040a2d-1981-4cb8-8bd2-bc2a610e2db1",
                                                "sense_id": "fb73c779-863a-31f4-89c2-046b979e02fa",
                                                "text": "„Das gesamte wichtige Gebiet der Pflanzenphysiologie ist in den kapitalistischen Ländern verhältnismäßig unentwickelt. Ebenso natürlich aber ist es, daß gerade in der Sowjetunion, dem Lande der sozialistischen Kollektivwirtschaft, mit den Arbeiten der biologischen Schulen Mitschurins große Forschungsergebnisse in der Pflanzenphysiologie und der Agrarbiologie erzielt werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "68ac1fb5-c500-4c8e-8397-9327f878d439",
