                                            {
                                                "example_id": "2d493fac-f271-4027-87ae-edd27178acde",
                                                "sense_id": "d06bbacf-af7b-3574-b2a7-904d42f68d8f",
                                                "text": "He was bred […] in Oxford and there doctorated."
                                            },
                                            {
                                                "example_id": "f24d4887-8eec-4d01-992d-ecb7d0396de3",
                                                "sense_id": "d06bbacf-af7b-3574-b2a7-904d42f68d8f",
                                                "text": "Even after Salernum had a teacher of law [...] it could not doctorate in law."
                                            }
