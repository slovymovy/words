                "senses": [
                    {
                        "sense_id": "a401665a-64f6-3ecb-92a4-36fc83367247",
                        "entry_id": "3facf3e9-d8f3-33de-9647-d58a97d902b4",
                        "glosses": [
                            "Amtseinführung eines neuen Monarchen oder Patriarchen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a8aebfe-7bb7-4fa6-a63a-0300084da923",
                                "sense_id": "a401665a-64f6-3ecb-92a4-36fc83367247",
                                "text": "„Die Hsinbyume-Pagode […] ist ein buddhistisches Heiligtum in Mingun (Myanmar). König Bagyidaw ließ sie 1816, drei Jahre vor seiner Inthronisation, für seine verstorbene Lieblingsgemahlin Hsinbyume errichten.“"
                            },
                            {
                                "example_id": "18081332-79f0-4e60-ade4-524b49de106d",
                                "sense_id": "a401665a-64f6-3ecb-92a4-36fc83367247",
                                "text": "„Das Treffen der Führer der arabischen Erdöl exportierenden Länder war die erste Auslandsreise nach seiner Inthronisation.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "6799ab9f-0cbd-325c-aa5b-0fad974680e5",
                        "entry_id": "3facf3e9-d8f3-33de-9647-d58a97d902b4",
                        "glosses": [
                            "Amtseinführung eines Papstes oder Bischofs"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fcdafb88-fbec-4e35-ae8c-24edbd46d269",
                                "sense_id": "6799ab9f-0cbd-325c-aa5b-0fad974680e5",
                                "text": "„Hadrian II. […] war von seiner Inthronisation am 14. Dezember 867 bis zu seinem Tode im Jahre 872 exakt fünf Jahre lang Papst.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
