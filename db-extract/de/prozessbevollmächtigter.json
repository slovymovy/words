                "senses": [
                    {
                        "sense_id": "f7db2e78-ce4d-3ee4-b199-64f6d515ab4c",
                        "entry_id": "526a136a-033d-3bb1-9654-eec7df80db4c",
                        "glosses": [
                            "mit der Vollmacht zur Vertretung eines Klägers oder Verklagten beauftragte Person in einem Zivilprozess"
                        ],
                        "tags": [
                            "Rechtswesen"
                        ],
                        "examples": [
                            {
                                "example_id": "762ae039-6057-403a-8ab9-c07784439d42",
                                "sense_id": "f7db2e78-ce4d-3ee4-b199-64f6d515ab4c",
                                "text": "„Doch Christian Duve, Prozessbevollmächtigter der Deutschen Bank, lässt keinen Zweifel, wie sein Institut weiter vorgehen will: ‚Die Bank wird gegen das Urteil Rechtsmittel beim Bundesgerichtshof einlegen‘, so Duve gegenüber der PZ.“"
                            },
                            {
                                "example_id": "97d96db2-f585-4f5f-b8c1-478341d89cb2",
                                "sense_id": "f7db2e78-ce4d-3ee4-b199-64f6d515ab4c",
                                "text": "„Er kämpft aktuell als Prozessbevollmächtigter für seine Partnerin in einem der wenigen noch laufenden Verfahren gegen die Rückzahlung der Corona-Soforthilfen.“"
                            },
                            {
                                "example_id": "e5131af6-edf8-4182-9d23-3a187d60137c",
                                "sense_id": "f7db2e78-ce4d-3ee4-b199-64f6d515ab4c",
                                "text": "„Die vor dem 1. Juli 2008 zugelassene Prozessagenten können gemäß § 3 Abs. 2 Nr. 2 RDGEG auch weiterhin als Prozessbevollmächtigte auftreten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
