                "senses": [
                    {
                        "sense_id": "58331201-4a56-3d17-9fde-f4d8e4ad35de",
                        "entry_id": "453c28cc-b032-3fcb-8ff7-c8777c247936",
                        "glosses": [
                            "Personne qui arrive en retard."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7cc2aa88-63ad-4bd4-a9ce-34558048b201",
                                "sense_id": "58331201-4a56-3d17-9fde-f4d8e4ad35de",
                                "text": "Ces deux retardataires ne nous rejoignirent que sur le dôme du Mont-Blanc."
                            },
                            {
                                "example_id": "6dddc399-5117-4fca-b25a-4055f2b83452",
                                "sense_id": "58331201-4a56-3d17-9fde-f4d8e4ad35de",
                                "text": "Allez, mon brave bushman. Pendant ce temps, je guetterai les retardataires, et au moins, vos pieds ne risqueront pas de prendre racine !"
                            },
                            {
                                "example_id": "d89963d3-3310-418c-b1d5-a438eab99293",
                                "sense_id": "58331201-4a56-3d17-9fde-f4d8e4ad35de",
                                "text": "Deux gardiens de la paix firent un signe au patron qui gourmanda les retardataires."
                            },
                            {
                                "example_id": "a32de229-dcc3-4bfc-8986-75eba5d51250",
                                "sense_id": "58331201-4a56-3d17-9fde-f4d8e4ad35de",
                                "text": "Il ne leur donna qu'un délai d'un mois pour quitter le pays. Les retardataires étaient menacés d'être mis à mort."
                            },
                            {
                                "example_id": "9da26ac0-d68f-4e9b-9bb1-180079743495",
                                "sense_id": "58331201-4a56-3d17-9fde-f4d8e4ad35de",
                                "text": "D’ailleurs, les retardataires qui n’ont toujours pas rempli leurs obligations tirent un avantage de leur indiscipline : ils peuvent sans risque faire de l’optimisation fiscale en amont de manière à garder la Prestation canadienne d’urgence."
                            },
                            {
                                "example_id": "21a23b9a-c8dd-4a8f-a32c-0d60d703c017",
                                "sense_id": "58331201-4a56-3d17-9fde-f4d8e4ad35de",
                                "text": "Avec l’impossibilité de s’appuyer sur les fusées Soyouz depuis l’invasion russe de l’Ukraine, l’agence spatiale européenne n’avait, de fait, pas d’autre choix, sauf à attendre patiemment un créneau sur l’agenda de la retardataire Ariane 6."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ccbdd605-cffe-44a7-94a4-a2e4595b52eb",
                        "source_entry_id": "453c28cc-b032-3fcb-8ff7-c8777c247936",
                        "source_sense_id": "58331201-4a56-3d17-9fde-f4d8e4ad35de",
                        "target_lang_word": "latecomer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "latecomer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e0055a39-0f0c-355b-af20-28928d0e5491",
                                        "entry_id": "d1496c48-21b1-3c2c-9f2c-9741301f4500",
                                        "glosses": [
                                            "One who has arrived comparatively recently."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf997e67-51a4-44e7-9754-833fe26b5008",
                                                "sense_id": "e0055a39-0f0c-355b-af20-28928d0e5491",
                                                "text": "The old families in the neighborhood look down on him as a latecomer, his family only arrived in the 18th century, too nouveau for them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b715c9af-68c0-33b8-bfd5-194167f93511",
                                        "entry_id": "d1496c48-21b1-3c2c-9f2c-9741301f4500",
                                        "glosses": [
                                            "One who arrived late."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "517b4538-3b9d-47d1-bce6-7c88622c82ec",
                                                "sense_id": "b715c9af-68c0-33b8-bfd5-194167f93511",
                                                "text": "At the party the host made a point of greeting all the latecomers he missed in the first pass."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
