{
    "word_family": [
        "tunnage"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d9692952-dad3-38f9-9f12-2400419e6e35",
                    "sense_definition": "A large wooden cask used for storing liquids like wine.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "container",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The merchant rolled the heavy <w>tun</w> of wine into the cellar.",
                            "target_lang_translations": {
                                "ru": "Купец закатил тяжелую <w>бочку</w> вина в погреб."
                            }
                        },
                        {
                            "text": "Workers filled the large <w>tun</w> with fresh grape juice.",
                            "target_lang_translations": {
                                "ru": "Рабочие наполнили большую <w>бочку</w> свежим виноградным соком."
                            }
                        }
                    ],
                    "common_phrases": [
                        "wine tun"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Refers to historical storage methods."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Большая деревянная бочка, используемая для хранения жидкостей, например вина."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бо́чка",
                                "target_lang_sense_clarification": "вместительный сосуд цилиндрической формы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "df5c92c1-a1e3-3cb0-9801-a0a912660029",
                    "sense_definition": "A traditional unit of liquid measure equal to 252 gallons.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "measurement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ship carried a <w>tun</w> of ale for the long voyage.",
                            "target_lang_translations": {
                                "ru": "Корабль вез <w>тон</w> эля для долгого плавания."
                            }
                        },
                        {
                            "text": "Historical records show the tax was based on each <w>tun</w> of imported wine.",
                            "target_lang_translations": {
                                "ru": "Исторические записи показывают, что налог взимался с каждого <w>тона</w> импортного вина."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Historical unit of measurement."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Традиционная единица измерения объема жидкости, равная 252 галлонам."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тон",
                                "target_lang_sense_clarification": "устаревшая английская мера объема для вина"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1b2f86fe-89a9-3e6d-b476-8df5a89c81a3",
                    "sense_definition": "A unit of mass equal to 2240 pounds.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "measurement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cargo ship was rated to carry a <w>tun</w> of coal.",
                            "target_lang_translations": {
                                "ru": "Грузовое судно было рассчитано на перевозку <w>длинной тонны</w> угля."
                            }
                        },
                        {
                            "text": "Engineers calculated the cargo weight in <w>tuns</w>.",
                            "target_lang_translations": {
                                "ru": "Инженеры рассчитали вес в <w>длинных тоннах</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "long ton"
                    ],
                    "target_lang_definitions": {
                        "ru": "Единица массы, равная 2240 фунтам (длинная тонна)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "длинная тонна",
                                "target_lang_sense_clarification": "английская мера веса"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "263ffae4-7f34-3571-af36-ec3cbe2f4079",
                    "sense_definition": "An extremely large amount of something.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "quantity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He brought a <w>tun</w> of treasure to the king.",
                            "target_lang_translations": {
                                "ru": "Он привез королю <w>море</w> сокровищ."
                            }
                        },
                        {
                            "text": "She possesses a <w>tun</w> of knowledge about ancient history.",
                            "target_lang_translations": {
                                "ru": "Она обладает <w>тьмой</w> знаний о древней истории."
                            }
                        }
                    ],
                    "synonyms": [
                        "ton"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in a literary or figurative sense."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Чрезвычайно большое количество чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тьма",
                                "target_lang_sense_clarification": "огромное количество"
                            },
                            {
                                "target_lang_word": "море",
                                "target_lang_sense_clarification": "переносное значение для обозначения большого количества"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "128e975b-3bd6-38b4-b92d-1961c5bf111d",
                    "sense_definition": "A person who drinks alcohol excessively.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local <w>tun</w> spent all his money at the tavern.",
                            "target_lang_translations": {
                                "ru": "Местный <w>пьяница</w> просадил все свои деньги в таверне."
                            }
                        },
                        {
                            "text": "He was known as a notorious <w>tun</w> in the village.",
                            "target_lang_translations": {
                                "ru": "Он был известен в деревне как отъявленный <w>пьяница</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "drunkard"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который чрезмерно употребляет алкоголь."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пьяница",
                                "target_lang_sense_clarification": "человек, злоупотребляющий спиртным"
                            },
                            {
                                "target_lang_word": "алкоголик",
                                "target_lang_sense_clarification": "человек, страдающий алкоголизмом"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5e0f0b5e-ce8d-3f1a-b5eb-0d45cdeae129",
                    "sense_definition": "To put liquid into casks or barrels.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "container",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The brewer decided to <w>tun</w> the ale after two days of fermentation.",
                            "target_lang_translations": {
                                "ru": "Пивовар решил <w>разлить по бочкам</w> эль после двух дней брожения."
                            }
                        },
                        {
                            "text": "They must <w>tun</w> the beer before it loses its freshness.",
                            "target_lang_translations": {
                                "ru": "Они должны <w>разлить пиво по бочкам</w>, пока оно не потеряло свежесть."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Technical term in brewing."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Разливать жидкость по бочкам."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разливать по бочкам",
                                "target_lang_sense_clarification": "процесс помещения жидкости в бочки"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "bd3cbbe1-796d-3020-97db-66540aa6ce7e",
                    "sense_definition": "A surname of Burmese origin.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The professor introduced himself as Mr. <w>Tun</w>.",
                            "target_lang_translations": {
                                "ru": "Профессор представился как мистер <w>Тун</w>."
                            }
                        },
                        {
                            "text": "Many people named <w>Tun</w> live in the region.",
                            "target_lang_translations": {
                                "ru": "В этом регионе живет много людей по фамилии <w>Тун</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Family name."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия бирманского происхождения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Тун",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}