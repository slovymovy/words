                        "source_entry_id": "b84d60f0-f57f-36e6-a82f-7262ad98cf2a",
                        "target_lang_word": "zweckdienlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zweckdienlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f21de78d-ede9-3183-9362-ff5ba04f6604",
                                        "entry_id": "ae248bf6-e274-34fc-8baf-082cd561e960",
                                        "glosses": [
                                            "nützlich für einen bestimmten Zweck"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c4d480e-eefc-4259-92d8-91f8582efd18",
                                                "sense_id": "f21de78d-ede9-3183-9362-ff5ba04f6604",
                                                "text": "Zweckdienliche Hinweise nimmt jede Polizeidienststelle entgegen."
                                            },
                                            {
                                                "example_id": "eb43bd1e-688a-47b1-9f7f-3d2c57dbd6b0",
                                                "sense_id": "f21de78d-ede9-3183-9362-ff5ba04f6604",
                                                "text": "Am zweckdienlichsten wäre natürlich, die zusätzlichen Geldmittel für die wirklich nötigsten Ausgaben einzusetzen."
                                            },
                                            {
                                                "example_id": "ed71c7fd-bb1c-4f63-978f-c6cb078ec9d9",
                                                "sense_id": "f21de78d-ede9-3183-9362-ff5ba04f6604",
                                                "text": "Es wäre auf jeden Fall zweckdienlicher mit Deiner Erkältung ein paar Tage zuhause zu bleiben, anstatt die Kollegen anzustecken."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e0e536c8-6739-4fe4-848f-df0d45a24cfb",
                        "source_entry_id": "b84d60f0-f57f-36e6-a82f-7262ad98cf2a",
                        "target_lang_word": "zweckmäßig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zweckmäßig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "627439ea-9781-3a6f-b473-5af73ac3973c",
                                        "entry_id": "3faf5228-a9a7-3b08-ad85-0ede94f267c0",
                                        "glosses": [
                                            "für seinen Zweck angemessen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7527fb34-84cc-4be3-97cb-ce7782c34db5",
                                                "sense_id": "627439ea-9781-3a6f-b473-5af73ac3973c",
                                                "text": "„Der Deutsche Arbeitsring Trümmerbeseitigung und Trümmerverwertung hält in Königswinter am Rhein eine weitere Arbeitstagung ab, die der Entwicklung rationeller Arbeitsmethoden für eine zweckmäßige Trümmerbeseitigung und Trümmerverwertung unserer Städte dient.“"
                                            },
                                            {
                                                "example_id": "0932786f-120e-4369-854e-73f7bd128aa1",
                                                "sense_id": "627439ea-9781-3a6f-b473-5af73ac3973c",
                                                "text": "„Daß die USA-Zone ihre eigenen Häfen haben muß, ist eine unbestreitbare Notwendigkeit. Aber es erscheint nicht zweckmäßig, nun gleich auch den drei, süddeutschen Ländern, die wirtschaftlich in Kürze mit der britischen Zone vereinigt werden, für jede Art wirtschaftlicher Betätigung einen separaten Eingang an der Nordsee zu schaffen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "71697460-3a6d-36ff-9f89-ce4070834796",
                                        "entry_id": "3faf5228-a9a7-3b08-ad85-0ede94f267c0",
                                        "glosses": [
                                            "sinnvoll"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b86fd8c9-c76f-45a2-baf3-dd78654c4776",
                                                "sense_id": "71697460-3a6d-36ff-9f89-ce4070834796",
                                                "text": "„Ließen sich die angestrebten Ziele nicht leichter und zweckmäßiger erreichen, wenn man die neue Verfassung so schüfe, daß jeder Versuch, die Demokratie zu stürzen und die Menschenrechte abzuschaffen, unter strengste Strafen gestellt würde?“"
                                            },
                                            {
                                                "example_id": "43a663ee-4aee-4818-81ec-644125fef27f",
                                                "sense_id": "71697460-3a6d-36ff-9f89-ce4070834796",
                                                "text": "„Ist es nicht zweckmäßiger, ihnen das Sündigen durch geeignete Maßnahmen ohne Einengung der persönlichen Freiheit (also ohne Polizei und gelegentliche Razzien) unmöglich zu machen?“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "823eccb0-a5f6-4e3d-bf05-0cf770a0d784",
                        "source_entry_id": "b84d60f0-f57f-36e6-a82f-7262ad98cf2a",
                        "target_lang_word": "sachgemäß",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "b3024f5c-34d9-498a-ad7f-66111c50921b",
                        "source_entry_id": "b84d60f0-f57f-36e6-a82f-7262ad98cf2a",
                        "target_lang_word": "zielführend",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zielführend",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "abb73b2b-228a-3dd1-b8bc-d2effc064124",
                                        "entry_id": "f6b688dc-fb9d-3306-b4e7-1e773a7a0ccf",
                                        "glosses": [
                                            "zum Ziel führend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8fe39a13-9a81-401a-84ca-4522866e3698",
                                                "sense_id": "abb73b2b-228a-3dd1-b8bc-d2effc064124",
                                                "text": "Aber es ist bestimmt nicht zielführend, die Entwicklung von Medien mit einer quantitativen Orientierung nach vorn zu treiben."
                                            },
                                            {
                                                "example_id": "ba00b52f-21f8-45b9-ad22-965da1eaee16",
                                                "sense_id": "abb73b2b-228a-3dd1-b8bc-d2effc064124",
                                                "text": "Sie sagen, Gesetze sollen keine Vertragsdetails für Manager regeln. Freiwilligkeit ist auch nicht zielführend."
                                            },
                                            {
                                                "example_id": "3f3ca6d4-78d6-4846-acbb-0e455fdcd8d4",
                                                "sense_id": "abb73b2b-228a-3dd1-b8bc-d2effc064124",
                                                "text": "Ausschließlich schrittweise (wirtschafts)politische Reformen seien letztlich nicht zielführend."
                                            },
                                            {
                                                "example_id": "e1fc01dd-6aeb-44f7-a674-fbf4fb441ec6",
                                                "sense_id": "abb73b2b-228a-3dd1-b8bc-d2effc064124",
                                                "text": "Es gibt hierzulande genügend kluge Köpfe, und auch die Erfahrungen anderer Länder bieten vielfältige Ansatzpunkte für ein entschlossenes, zielführendes Handeln im sozialen Bereich und auf dem Arbeitsmarkt."
                                            },
                                            {
                                                "example_id": "36716688-d89b-4ca2-8c3c-9d4f5571cd3e",
                                                "sense_id": "abb73b2b-228a-3dd1-b8bc-d2effc064124",
                                                "text": "„Das ist wohl einer der widerwärtigsten Tierversuche, der jemals in Österreich durchgeführt worden ist“, so der österreichische Tierschutzverein. Der Versuch diene lediglich der Profilierung von Wissenschaftlern, das Geld könne zielführender für Lawinensuchgeräte und die Aufklärung von Wintersportlern verwendet werden."
                                            },
                                            {
                                                "example_id": "5153ea85-ea82-4f13-a193-a62246bd6d84",
                                                "sense_id": "abb73b2b-228a-3dd1-b8bc-d2effc064124",
                                                "text": "Als Gefahreneinweisung bezeichnet man beim Segelfliegen einen vom Fluglehrer gesteuerten Segelflug, bei dem er dem Flugschüler mehrere kritische Flugzustände demonstriert (Überziehen, Abschmieren in der Steilkurve, starker Höhenverlust, Scherwinde, Orientierungsverlust, Trudeln usw.) und ihm die zielführendsten Maßnahmen zu ihrer Beseitigung zeigt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9f395ea1-a486-404b-b0a6-19663ef2cd71",
                        "source_entry_id": "b84d60f0-f57f-36e6-a82f-7262ad98cf2a",
                        "target_lang_word": "rationnellement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rationnellement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "82b5f75e-7860-3f6d-ae65-9d7aa87f8980",
                                        "entry_id": "4a7c2519-fa89-3b9c-9a03-4f1e5c22f6ee",
                                        "glosses": [
                                            "D’une manière rationnelle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "512e3a76-468a-4b64-88b0-da224610d6e0",
                                                "sense_id": "82b5f75e-7860-3f6d-ae65-9d7aa87f8980",
                                                "text": "Le monde n'a rien à cacher; il ne se complaît pas dans le mystère, comme, d'autre part, il ne peut donner que ce qu'il a. Notre microcosme ne saurait exister en dehors de lui; et, pas plus que lui, il n'a d'énigme pour celui qui, muni des connaissances nécessaires, le voudra étudier rationnellement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "531d2941-c3a9-47fa-b4d0-a5044981274c",
                        "source_entry_id": "b84d60f0-f57f-36e6-a82f-7262ad98cf2a",
                        "target_lang_word": "utilement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
