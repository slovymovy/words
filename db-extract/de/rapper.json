                                "sense_id": "94aa9292-9c46-371d-a870-7f5c2ed4131e",
                                "text": "Eminem ist ein bekannter amerikanischer Rapper."
                            },
                            {
                                "example_id": "e3d178e5-0eaf-479e-8a9a-0d5ffe3bb1ac",
                                "sense_id": "94aa9292-9c46-371d-a870-7f5c2ed4131e",
                                "text": "„Die Rapper röchelten weiter.“"
                            },
                            {
                                "example_id": "9b780aa1-a9dd-4191-a2aa-5ce6c4e0fe6e",
                                "sense_id": "94aa9292-9c46-371d-a870-7f5c2ed4131e",
                                "text": "„Da tritt The Knife neben isländischen Rappern auf.“"
                            },
                            {
                                "example_id": "fb1b1ee2-3c77-4396-bd97-ea7ae45db6bd",
                                "sense_id": "94aa9292-9c46-371d-a870-7f5c2ed4131e",
                                "text": "„Es gibt drei Gruppen von Rappern mit Migrationshintergrund in Deutschland.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
