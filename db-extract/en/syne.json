                        "sense_id": "3ad722d1-ce3d-35c6-a545-fe0c87bd56b2",
                        "entry_id": "b492a0cb-bb51-39e4-84f5-b5a42a13217b",
                        "glosses": [
                            "Subsequently; then."
                        ],
                        "tags": [
                            "Northern-England",
