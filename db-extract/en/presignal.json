                    {
                        "sense_id": "0bffebf3-4b91-3b32-8bac-29b25f6c8f38",
                        "entry_id": "add834a4-0c90-3618-a2ab-7a7b24514d89",
                        "glosses": [
                            "A signal that occurs before some occurrence, as a warning or to trigger an automatic preparation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97f1b718-50f0-44a4-8963-dc90c6deff43",
                                "sense_id": "0bffebf3-4b91-3b32-8bac-29b25f6c8f38",
                                "text": "A presignal ahead of the streetcar stop allows the streetcar to pass into the unloading zone only after all the nonrail-bound traffic has left."
                            },
                            {
                                "example_id": "d33c9da0-e83d-467b-a665-68902cd13548",
                                "sense_id": "0bffebf3-4b91-3b32-8bac-29b25f6c8f38",
                                "text": "A presignal gets the moving cars back of the intersection off to the same flying start as the stopped lead vehicles. Von Stein has also used presignals in Dusseldorf and in other parts of Germany to create \"time islands\" for streetcars that must stop where there is no room for loading islands."
                            },
                            {
                                "example_id": "05be1046-03f1-42c4-a9cc-095bd5631b62",
                                "sense_id": "0bffebf3-4b91-3b32-8bac-29b25f6c8f38",
                                "text": "In this case, a presignal from the ATS could be interfaced with the elevator controls for that purpose."
                            }
                        ]
                    }
