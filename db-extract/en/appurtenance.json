                                                "example_id": "19b5efc4-5145-4d71-bb21-442f9291a515",
                                                "sense_id": "4d408ff1-3145-33cb-8b53-a42c65439d29",
                                                "text": "Welche Ausrüstung sollen wir montieren?"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "bd823699-09e5-3eca-aded-8f90ded58e01",
                                        "entry_id": "27652152-cde7-3258-a14c-fec48f67baca",
                                        "glosses": [
                                            "Sammelbegriff für Werkzeuge, die man für etwas braucht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a7c92ba-0920-43d6-b7c0-e150484049f1",
                                                "sense_id": "bd823699-09e5-3eca-aded-8f90ded58e01",
                                                "text": "Er hat seine Ausrüstung dabei."
                                            },
                                            {
                                                "example_id": "2d28223a-9014-4fcf-b58a-17ce4f37f65a",
                                                "sense_id": "bd823699-09e5-3eca-aded-8f90ded58e01",
                                                "text": "„Weickerts Leute hatten ihre Ausrüstung von drüben geholt und schliefen.“"
                                            },
                                            {
                                                "example_id": "4136836b-498b-49d1-a481-d57b6c5289aa",
                                                "sense_id": "bd823699-09e5-3eca-aded-8f90ded58e01",
                                                "text": "„Ausgiebig inspizierte er meine Ausrüstung und guckte sich hier und da Verbesserungen für seine Touren ab.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "655f980f-20a0-3087-bad0-c388b656d561",
                                        "entry_id": "27652152-cde7-3258-a14c-fec48f67baca",
                                        "glosses": [
                                            "Handlung, jemand/etwas mit Ausrüstungsgegenständen zu versehen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e709c9d7-23e3-421c-bd36-106364b73c53",
                                                "sense_id": "655f980f-20a0-3087-bad0-c388b656d561",
                                                "text": "Die endgültige Ausrüstung des Kreuzfahrers erforderte noch einmal mehrere Wochen Zeit."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8d2c8ad8-3779-46d9-b542-a502445e6eac",
