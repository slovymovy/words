    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [],
        "ru-extract.jsonl": [
            {
                "entry_id": "e74aa5ab-aa29-3f6e-8cda-97ea6fb98638",
                "word": "Аристов",
                "pos": "name",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "0d84275a-38fd-3292-b545-dc7e8b3c1e9f",
                        "entry_id": "e74aa5ab-aa29-3f6e-8cda-97ea6fb98638",
                        "glosses": [
                            "русская фамилия"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e161cd19-8ff8-41a4-b904-ae39a28bcb16",
                                "sense_id": "0d84275a-38fd-3292-b545-dc7e8b3c1e9f",
                                "text": "Мы договорились с Аристовым, что вечером погуляем вместе по городу."
                            },
                            {
                                "example_id": "cea818bf-ad98-4075-83a7-411d5816d464",
                                "sense_id": "0d84275a-38fd-3292-b545-dc7e8b3c1e9f",
                                "text": "И во время этого перерыва меня наш полковой врач Аристов Семён Семёнович к себе в кабинет увёл."
                            },
                            {
                                "example_id": "12b7f223-e67e-41a3-8a4e-6f33f68ae1b3",
                                "sense_id": "0d84275a-38fd-3292-b545-dc7e8b3c1e9f",
                                "text": "Многие, вероятно, и теперь помнят Аристова в качестве устроителя всевозможных спектаклей, вечеров, чтений и праздников."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
