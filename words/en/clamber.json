{
    "word_family": [
        "clamberer"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3784d30b-0ffe-33b8-94b6-708e5fa6b5ba",
                    "sense_definition": "To climb with difficulty, or in an awkward, hurried, or haphazard manner, typically using both hands and feet.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children <w>clambered</w> over the steep rocks at the edge of the beach.",
                            "target_lang_translations": {
                                "ru": "Дети <w>карабкались</w> по крутым скалам у самого края пляжа."
                            }
                        },
                        {
                            "text": "We had to <w>clamber</w> up the steep hill to reach the ancient ruins before sunset.",
                            "target_lang_translations": {
                                "ru": "Нам пришлось <w>взбираться</w> по крутому холму, чтобы добраться до древних руин до захода солнца."
                            }
                        }
                    ],
                    "synonyms": [
                        "scramble",
                        "shinny",
                        "climb"
                    ],
                    "common_phrases": [
                        "clamber up the hill",
                        "clamber over rocks"
                    ],
                    "target_lang_definitions": {
                        "ru": "Карабкаться, взбираться с трудом, неуклюже или поспешно, обычно помогая себе и руками, и ногами."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "карабкаться",
                                "target_lang_sense_clarification": "лезть, цепляясь руками и ногами"
                            },
                            {
                                "target_lang_word": "взбираться",
                                "target_lang_sense_clarification": "подниматься с трудом наверх"
                            },
                            {
                                "target_lang_word": "вскарабкаться",
                                "target_lang_sense_clarification": "залезть наверх, преодолевая препятствия"
                            },
                            {
                                "target_lang_word": "взобраться",
                                "target_lang_sense_clarification": "с трудом подняться наверх"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6b660685-5115-30c5-82d3-3d62fba54303",
                    "sense_definition": "An awkward, difficult, or haphazard climb.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After a long <w>clamber</w> up the rocky slope, we finally reached the summit.",
                            "target_lang_translations": {
                                "ru": "После долгого и трудного <w>подъема</w> по каменистому склону мы наконец достигли вершины."
                            }
                        },
                        {
                            "text": "It was a difficult <w>clamber</w> through the dense undergrowth to find the hidden path.",
                            "target_lang_translations": {
                                "ru": "Это было тяжелое <w>пробирание</w> сквозь густые заросли, чтобы найти скрытую тропу."
                            }
                        }
                    ],
                    "synonyms": [
                        "scramble",
                        "climb"
                    ],
                    "common_phrases": [
                        "difficult clamber"
                    ],
                    "target_lang_definitions": {
                        "ru": "Трудный, неуклюжий или хаотичный подъем (вверх)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подъем",
                                "target_lang_sense_clarification": "трудное восхождение"
                            },
                            {
                                "target_lang_word": "карабканье",
                                "target_lang_sense_clarification": "процесс преодоления крутого склона"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}