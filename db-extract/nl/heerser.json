                ],
                "senses": [
                    {
                        "sense_id": "9665416e-7563-34e9-bfc4-74979df60f42",
                        "entry_id": "d65160b3-eaf6-3ea1-b522-c6c218bb8c12",
                        "glosses": [
                            "iemand die de macht uitoefent"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a59c03e1-f197-4612-9525-80f447485d8e",
                                "sense_id": "9665416e-7563-34e9-bfc4-74979df60f42",
                                "text": "Karel de Grote was de machtigste heerser die Europa in eeuwen gezien had."
                            },
                            {
                                "example_id": "a313d581-968e-49e2-8c1b-e79023235847",
                                "sense_id": "9665416e-7563-34e9-bfc4-74979df60f42",
                                "text": "Het draagt allemaal bij aan de herleving van een roemruchte periode. Daar hoort ook de aparte expositie van fotograaf Rudy Leukfeldt bij, Blues from Heaven. Heel bijzonder hoe hij Muskee heeft vereeuwigd, als heerser van Drenthe, op een hunebed."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ac54df89-5201-4f80-bd1a-8c69168d237b",
                        "source_entry_id": "d65160b3-eaf6-3ea1-b522-c6c218bb8c12",
                        "source_sense_id": "9665416e-7563-34e9-bfc4-74979df60f42",
                        "source_sense_description": "iemand die de macht uitoefent",
                        "target_lang_word": "Herrscher",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Herrscher",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7e152346-1d19-395c-bae3-df7f03bceca7",
                                        "entry_id": "aa84b315-cfb5-3941-ad43-93f904e60fca",
                                        "glosses": [
                                            "das Oberhaupt eines Stammes, Volkes, Reiches oder Landes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e54360c-ca0c-4a72-ae18-3698d5db9e81",
                                                "sense_id": "7e152346-1d19-395c-bae3-df7f03bceca7",
                                                "text": "„1519 landete Cortez in Mexiko, nahm Tenochtitlan ein, setzte Moctezuma II., den Herrscher der Azteken, ab und richtete ihn schließlich hin.“"
                                            },
                                            {
                                                "example_id": "1c9e1a8b-fc60-47df-9ecd-77a33a50c80e",
                                                "sense_id": "7e152346-1d19-395c-bae3-df7f03bceca7",
                                                "text": "„Das weiß der Westen - und steht den alten Herrschern trotzdem bei.“"
                                            },
                                            {
                                                "example_id": "de316248-4d18-42d0-a899-5a62e08112a8",
                                                "sense_id": "7e152346-1d19-395c-bae3-df7f03bceca7",
                                                "text": "„Wie kein anderen Herrscher machte Tiberius wenig Aufhebens von seiner Person und verzichtete auf Populismus und übertriebene Selbstdarstellung.“"
                                            },
                                            {
                                                "example_id": "2e41b208-ffda-4376-9ed6-0b5c3dabe295",
                                                "sense_id": "7e152346-1d19-395c-bae3-df7f03bceca7",
                                                "text": "„Basileios, so viel wissen die Nordmänner vermutlich, ist Herrscher über ein Reich, das sich von der Südspitze Italiens bis nach Kleinasien erstreckt.“"
                                            },
                                            {
                                                "example_id": "0fb55b6c-065f-4227-b18e-e9bba0ca3f8c",
                                                "sense_id": "7e152346-1d19-395c-bae3-df7f03bceca7",
                                                "text": "„Von wankelmütigen Herrschern beauftragt, von einer unzuverlässigen Mannschaft begleitet, begab er sich auf unabsehbare Zeit unter unvorhersehbaren Gefahren auf eine Reise jenseits der Grenzen der bekannten Welt, um auf unsicheren Wegen ein erhofftes Ziel zu erreichen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8779f7ff-70aa-4101-be38-c26895633d79",
                        "source_entry_id": "d65160b3-eaf6-3ea1-b522-c6c218bb8c12",
