                    {
                        "sense_id": "dc7eded5-0ee3-3b30-a14a-f936fd4132f8",
                        "entry_id": "b8f53ec3-1f7d-3512-a523-652dc86cfaa3",
                        "glosses": [
                            "Relatif à l’étude des langues romanes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "173f0f4a-76fc-44cf-a904-7102d8c792a0",
                                "sense_id": "dc7eded5-0ee3-3b30-a14a-f936fd4132f8",
                                "text": "Le lecteur français, non romaniste, ne saurait qu'à l'aide d'une traduction lire les grandes œuvres de la littérature du Moyen-Âge."
                            }
                        ]
                    }
                ],
