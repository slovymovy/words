                ],
                "senses": [
                    {
                        "sense_id": "1048b124-9ae6-38e2-b268-a98b4a5c65e5",
                        "entry_id": "a483fef5-6eff-33cc-b31d-ed7f2648a3fb",
                        "glosses": [
                            "книжн. вызванный экстазом, связанный с экстазом, проникнутый экстазом"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a5436761-9c72-4ec9-be5d-fcbd195cbcd2",
                                "sense_id": "1048b124-9ae6-38e2-b268-a98b4a5c65e5",
                                "text": "Я же докажу, что подавление шаманского гнозиса с его опорой на экстатическое растворение \"эго\" и настаиванием на таком растворении лишило нас смысла жизни и сделало врагами планеты, самих себя и своих внуков."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3824cdb9-74ad-4c52-9ffa-970307a41241",
                        "source_entry_id": "a483fef5-6eff-33cc-b31d-ed7f2648a3fb",
                        "source_sense_id": "1048b124-9ae6-38e2-b268-a98b4a5c65e5",
                        "target_lang_word": "ecstatic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ecstatic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a1711276-218c-3f02-975f-f00b80b513ff",
                                        "entry_id": "790d7441-51c9-3253-875e-1f904e1dafac",
                                        "glosses": [
                                            "Feeling or characterized by ecstasy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ecb79bb-e2eb-4630-8d3b-e5e49c04f4e6",
                                                "sense_id": "a1711276-218c-3f02-975f-f00b80b513ff",
                                                "text": "[W]hilſt he heſitated there, the criſis of pleaſure overtook him, and the cloſe compreſſure of the vvarm ſurrounding fold, drevv from him the extatic guſh, even before mine vvas ready to meet it, kept up by the pain I had endur'd in the courſe of the engagement, from the unſufferable ſize of his vveapon, tho' it vvas not as yet in above half its length.",
                                                "translation": "Fanny Hill",
                                                "english": "Fanny Hill"
                                            },
                                            {
                                                "example_id": "2cca2e60-81a9-4f60-b111-d9be512eace9",
                                                "sense_id": "a1711276-218c-3f02-975f-f00b80b513ff",
                                                "text": "The moment of ejaculation in mammiferous animals is accompanied by universal excitement of the whole body, a kind of slight convulsion, which terminates in a comatose or exstatic state."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f7eca11-8dac-3192-9956-6f29db92da63",
                                        "entry_id": "790d7441-51c9-3253-875e-1f904e1dafac",
                                        "glosses": [
                                            "Extremely happy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9bd35353-c53b-4b4e-9eee-3e2f10d5f54b",
