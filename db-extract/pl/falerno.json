                "senses": [
                    {
                        "sense_id": "43a8cf15-4312-31ef-ae6f-8888d3a3e68a",
                        "entry_id": "5d569fe1-ab69-34a9-885e-c580ef99c963",
                        "glosses": [
                            "mocne, lekko cierpkie, złociste wino włoskie, cenione przez starożytnych"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5b06bd0-3a24-4c29-a89e-c79cfb66d668",
                                "sense_id": "43a8cf15-4312-31ef-ae6f-8888d3a3e68a",
                                "text": "Dziś wy cieniami marnemi, / Skrwawione chylicie usta, / Mnie zaś tu trzyma do ziemi / Dziewczyna pusta. / Więc klnijmy w pijanym szale / Opatrzność niemiłosierną… / W łeb sobie jutro wypalę, / Pijąc Falerno."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dab2e1ca-2a93-4ed3-9256-dc37e03ddfa0",
                        "source_entry_id": "5d569fe1-ab69-34a9-885e-c580ef99c963",
                        "source_sense_id": "43a8cf15-4312-31ef-ae6f-8888d3a3e68a",
