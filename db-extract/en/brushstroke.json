                ],
                "senses": [
                    {
                        "sense_id": "a134b766-588c-3ef3-ac06-b6f1a5588d40",
                        "entry_id": "5bd0d93c-f84f-30f5-85fe-25750aff5555",
                        "glosses": [
                            "The stroke of a brush, as in painting."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed001a1b-c135-4e88-a3cc-888f5c6f8fe6",
                                "sense_id": "a134b766-588c-3ef3-ac06-b6f1a5588d40",
                                "text": "Since moving to the city [Paris], his [Vincent Van Gogh’s] palette had become lighter and more colorful and his brushstrokes more distinct. In this painting [Boulevard de Clichy], the pastel colors reflect the soft, wintry light. His brushstrokes, now shorter and almost dash-like, give the pedestrians a sense of hurrying along the boulevard."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f347d540-b1d0-4ccd-8433-3d2e59c67692",
                        "source_entry_id": "5bd0d93c-f84f-30f5-85fe-25750aff5555",
                        "source_sense_id": "a134b766-588c-3ef3-ac06-b6f1a5588d40",
                        "source_sense_description": "stroke of a brush",
                        "target_lang_word": "Pinselstrich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pinselstrich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f119011a-27af-3d3c-b2f0-5a0131419100",
                                        "entry_id": "540ef4ae-3c72-3e3a-9e68-bfe3a88eb6fe",
                                        "glosses": [
                                            "mit einem Pinsel gezogene kurze unregelmäßige Linie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e67f93a-e319-446e-a595-fd5a7f6fede0",
                                                "sense_id": "f119011a-27af-3d3c-b2f0-5a0131419100",
                                                "text": "„Bei dem allen wünschte man mehr ausgeführte Stücke zu finden: denn jene sind mit großer Fertigkeit, wie mit einem Pinselstriche hingesetzt, und dieser Wunsch wurde zu Ende des Jahres 1761 erfüllt.“"
                                            },
                                            {
                                                "example_id": "3a3be422-d424-4651-b174-0a1beb80bcb1",
                                                "sense_id": "f119011a-27af-3d3c-b2f0-5a0131419100",
                                                "text": "„Die Oberkante der Dünenkette, die sich wie ein leicht gewellter grünweißer Pinselstrich weit über die Insel hinzieht, hebt sich ohne impressionistischen Übergang deutlich vom stählernen Blau des Himmels ab.“"
                                            },
                                            {
                                                "example_id": "6ec3dd6f-1662-4f48-bb75-a2a27803bc48",
                                                "sense_id": "f119011a-27af-3d3c-b2f0-5a0131419100",
                                                "text": "„Sylvia betrachtete aufmerksam die alabasterne Gestalt, die von hauchfeinen Pinselstrichen zusammengehalten wurde, die afrikanische Dienerin, die fast mit dem dunklen Hintergrund verschmolz, und den Blumenstrauß, den sie ihrer Herrin hinhielt und der paradoxerweise in den selben reinen, hellen Farben gehalten war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6de5fcce-7772-30e0-bd41-5afa6699438b",
                                        "entry_id": "540ef4ae-3c72-3e3a-9e68-bfe3a88eb6fe",
                                        "glosses": [
                                            "Art und Weise des Umgangs mit einem Pinsel"
                                        ],
                                        "tags": [
                                            "Malerei"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
