                "senses": [
                    {
                        "sense_id": "3e1dbb38-e34e-3d36-8a20-2ba517a44715",
                        "entry_id": "903bdf21-5b0d-376d-bb5f-71a35c65f71e",
                        "glosses": [
                            "Qui éreinte, critique sévèrement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f5fb519a-843f-42d1-94e8-0a6597581f8d",
                                "sense_id": "3e1dbb38-e34e-3d36-8a20-2ba517a44715",
                                "text": "Lʼécrivain licencieux, le journaliste éreinteur, haineux, ne sont pas les coupables, cʼest le lecteur; pour lui sa marchandise sʼécoule, donc elle plaît."
                            },
                            {
                                "example_id": "3b289ab3-2ae5-483a-82a1-8dc1d9d23025",
                                "sense_id": "3e1dbb38-e34e-3d36-8a20-2ba517a44715",
                                "text": "Généralement, votre critique est «éreinteuse» disait à Buloz Mme Sand."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "1e03e2ed-8b93-3860-99f7-8fdc2f307bbb",
                "word": "éreinteur",
