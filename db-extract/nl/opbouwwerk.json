                "senses": [
                    {
                        "sense_id": "064eb497-cebf-3555-b45a-e0d7ec7bdef1",
                        "entry_id": "e4d7c08e-f1c1-39c3-93c5-79333d97d3d8",
                        "glosses": [
                            "een onderdeel van welzijnswerk, dat zich richt op het verbeteren van de woon- en leefomstandigheden van buurt- en wijkbewoners door onder meer de invloed van de bewoners bij het verbeteren van de leefbaarheid van hun woonomgeving te versterken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6251f548-c057-4015-8be9-eaed8f06e686",
                                "sense_id": "064eb497-cebf-3555-b45a-e0d7ec7bdef1",
                                "text": "‘In april vorig jaar werd een van de topfiguren echter veroordeeld voor drugshandel en afpersing met geweld. Die pijnlijke gebeurtenis contrasteert met het geduldig en emancipatorisch opbouwwerk van Antwerpse organisaties die zijn ingebed in het sociaal weefsel.’ Ook Monica De Coninck (SP.A) heeft bedenkingen. ‘De eerste bedoeling van bedrijven is winst maken en snel resultaat boeken met de makkelijkste cliënten’, zegt De Coninck."
                            },
                            {
                                "example_id": "15189c07-bedb-4e9f-b745-c81a8402e840",
                                "sense_id": "064eb497-cebf-3555-b45a-e0d7ec7bdef1",
                                "text": "Daarom worden in WAVE tien 'diensten' genoemd, waar de stichting mee aan de slag gaat. Het gaat onder meer om opbouwwerk (samen met de woningstichting Vestion), culturele en creatieve activiteiten en activering."
                            }
                        ]
                    }
