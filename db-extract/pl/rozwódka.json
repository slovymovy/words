                    },
                    {
                        "translation_id": "65fe5761-ef3e-40cb-bb2c-48e190a6ff18",
                        "source_entry_id": "360f89ac-30b0-3991-b028-4a9c939f1317",
                        "source_sense_id": "5f015087-1fa9-3403-8718-b1abede55397",
                        "source_sense_description": "geschiedene Frau",
                        "target_lang_word": "Frau",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Frau",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e3c044e4-c3cc-3d33-baa7-7ff89899cacb",
                                        "entry_id": "5884ff21-59bd-3571-ba64-ae4dc18647ca",
                                        "glosses": [
                                            "erwachsener, weiblicher Mensch"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e4b5358b-46cf-4cc7-ab42-988d3ce322f7",
                                                "sense_id": "e3c044e4-c3cc-3d33-baa7-7ff89899cacb",
                                                "text": "Sie ist eine berufstätige Frau."
                                            },
                                            {
                                                "example_id": "90ae2d30-9bcb-4629-a2d7-754a0e37d410",
                                                "sense_id": "e3c044e4-c3cc-3d33-baa7-7ff89899cacb",
                                                "text": "Sie erwacht zur Frau. (Sie wird vom Mädchen zur Frau.)"
                                            },
                                            {
                                                "example_id": "2cc05378-1cea-4d06-a045-5fbd929285e1",
                                                "sense_id": "e3c044e4-c3cc-3d33-baa7-7ff89899cacb",
                                                "text": "„Weit über dreißig mögen es nach unserer Ankunft sein, Frauen und Kinder vor allem.“"
                                            },
                                            {
                                                "example_id": "8b71d13a-9b6c-4115-b57e-5a47af18a2b5",
                                                "sense_id": "e3c044e4-c3cc-3d33-baa7-7ff89899cacb",
                                                "text": "„Die Frau ist wie ein Buch, von dem, ob gut oder schlecht, zunächst die Titelseite gefallen muß; bietet sie keinen Anreiz, so erweckt sie auch nicht die Lust zum Lesen, und diese Lust ist nur so stark wie das Interesse, das sie einflößt.“"
                                            },
                                            {
                                                "example_id": "98fb7d3b-b1cc-4129-849f-bec264fcc5bb",
                                                "sense_id": "e3c044e4-c3cc-3d33-baa7-7ff89899cacb",
                                                "text": "„Der Chronist hatte eine von den Frauen angesprochen, die mit ihrer Schicht zu Ende war, und erkundigte sich nach ihrer Arbeit.“"
                                            },
                                            {
                                                "example_id": "c75b6171-817c-466a-b0c4-478d0bdd86c4",
                                                "sense_id": "e3c044e4-c3cc-3d33-baa7-7ff89899cacb",
                                                "text": "„Dazu zeigte er [Jan Böhmermann] Bilder von Publizistinnen wie Alice Schwarzer oder Birgit Kelle. Ihr Vergehen? Sie sind der Meinung, dass schon mehr dazugehören muss, als dass man sich zur Frau erklärt, um als Frau zu gelten.“"
                                            },
                                            {
                                                "example_id": "f22f37d2-d4b2-4201-ba59-b488f4e73596",
                                                "sense_id": "e3c044e4-c3cc-3d33-baa7-7ff89899cacb",
                                                "text": "„Ist der Unterschied zwischen Männern und Frauen ein Fantasieprodukt, wie das Kastensystem in Indien oder die Rassentrennung in den Vereinigten Staaten?“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0a750971-77bd-3a2e-8aed-5645f2792d64",
                                        "entry_id": "5884ff21-59bd-3571-ba64-ae4dc18647ca",
                                        "glosses": [
                                            "verheiratete Frau, Ehefrau"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b7fa495-82b7-4ed3-9f3c-8e034446bfe2",
                                                "sense_id": "0a750971-77bd-3a2e-8aed-5645f2792d64",
                                                "text": "Darf ich Ihnen meine Frau vorstellen?"
                                            },
                                            {
                                                "example_id": "b454421b-775b-4b08-88fd-6989b92084d8",
                                                "sense_id": "0a750971-77bd-3a2e-8aed-5645f2792d64",
                                                "text": "Ich war mit meiner Frau und meinen Kindern im Urlaub."
                                            },
                                            {
                                                "example_id": "bcef598e-9b76-4815-846c-18775213cb71",
                                                "sense_id": "0a750971-77bd-3a2e-8aed-5645f2792d64",
                                                "text": "Was die Frau will, das will Gott."
                                            },
                                            {
                                                "example_id": "94719d65-c4c2-4fb7-a6bd-bccbe4997ede",
                                                "sense_id": "0a750971-77bd-3a2e-8aed-5645f2792d64",
                                                "text": "„Ist der Unterschied zwischen Männern und Frauen ein Fantasieprodukt, wie das Kastensystem in Indien oder die Rassentrennung in den Vereinigten Staaten?“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "2bc70d48-4a47-323a-8dff-6bc782f12189",
                                        "entry_id": "5884ff21-59bd-3571-ba64-ae4dc18647ca",
                                        "glosses": [
                                            "Höflichkeitsanrede für eine einzelne weibliche erwachsene Person, Namenszusatz"
                                        ],
                                        "tags": [
                                            "nur Singular"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "068870f8-6770-476e-8125-5df430382a16",
                                                "sense_id": "2bc70d48-4a47-323a-8dff-6bc782f12189",
                                                "text": "Sehr geehrte Frau Müller, ich schreibe hier nicht weiter …"
                                            },
                                            {
                                                "example_id": "7c4249f1-2154-425c-8656-cb32c802a90e",
                                                "sense_id": "2bc70d48-4a47-323a-8dff-6bc782f12189",
                                                "text": "Frau Müller trug ein rotes Kleid."
                                            },
                                            {
                                                "example_id": "49965dde-8167-4775-82d3-381beabb0471",
                                                "sense_id": "2bc70d48-4a47-323a-8dff-6bc782f12189",
                                                "text": "„Manche staunen, wenn Frau Jähnichen die kleingärtnerischen Pflichten herunterbetet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "53103a03-66cc-4250-ab10-7d69f7e9663c",
                        "source_entry_id": "360f89ac-30b0-3991-b028-4a9c939f1317",
                        "source_sense_id": "5f015087-1fa9-3403-8718-b1abede55397",
                        "source_sense_description": "geschiedene Frau",
                        "target_lang_word": "divorcée",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "divorcée",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5c709a16-f515-3539-ac49-8ceeb45f6c0c",
                                        "entry_id": "8d4c84e2-56f4-37c2-a5b3-66e8f4c5276c",
                                        "glosses": [
                                            "Femme qui a divorcé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c541eab-1d18-428b-a9f7-b704bc6b5cf9",
                                                "sense_id": "5c709a16-f515-3539-ac49-8ceeb45f6c0c",
                                                "text": "Quant aux divorcées, je les fuyais depuis un choc que j’avais reçu dans mon enfance. Quand j’avais sept ans, mon père, un jour, était rentré en froissant de rage La Petite Gironde.\n« Quelle honte ! Le roi d’Angleterre abdique pour épouser une divorcée !… »\nLa divorcée devint pour moi la Mangeuse d’empires. Je crus la reconnaître, plus tard, en lisant l’Apocalypse."
                                            },
                                            {
                                                "example_id": "ad4af0ce-e872-40d7-ab51-a381adea0882",
                                                "sense_id": "5c709a16-f515-3539-ac49-8ceeb45f6c0c",
                                                "text": "Sa voisine octogénaire lui présenta sa petite-fille, une divorcée du même âge qu’elle, qui devint une amie avec laquelle sortir, puis une confidente avec qui partager ses moments de doute et ses instants de victoire."
                                            }
                                        ]
                                    }
                                ]
