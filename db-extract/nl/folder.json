                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Faltblatt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "acbd00a6-fdc7-3fb5-aaf9-625f42bbdb37",
                                        "entry_id": "3abb6d85-7845-39f0-8aec-a5f88742ed58",
                                        "glosses": [
                                            "ein kleines Schriftstück auf einem mindestens einmal gefalteten (zusammenklappbaren) Stück Papier mit Informationen oder Werbung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c0c2d85-db70-450a-981d-c4581372250b",
                                                "sense_id": "acbd00a6-fdc7-3fb5-aaf9-625f42bbdb37",
                                                "text": "Wahlwerbung wird häufig in Form von Faltblättern an die Wähler verteilt."
                                            },
                                            {
                                                "example_id": "4ce1cdc7-ab10-45dc-9a9f-49f24164d6d8",
                                                "sense_id": "acbd00a6-fdc7-3fb5-aaf9-625f42bbdb37",
                                                "text": "„Früher war diese, nicht jeder erinnerte sich noch daran, ein dünnes Faltblatt gewesen, das Informationen enthalten hatte über die Haltestationen des Zuges, über Ankunfts- und Abfahrtszeiten und die Anschlusszüge.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "73b37a5f-9259-43d4-97fb-fb5ab35092c7",
                        "source_entry_id": "80c484b3-4878-3eb0-975e-e10ab9032208",
                        "source_sense_id": "a7a16036-5a81-3f6a-b0bc-ca42a95c7069",
                        "source_sense_description": "een blad met informatie of reclame",
                        "target_lang_word": "Broschüre",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Broschüre",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "72f2ef35-113c-3608-a5f2-cd2586ad2574",
                                        "entry_id": "97b22e35-f2ce-34ea-8fcc-ecf0b9fae3e7",
                                        "glosses": [
                                            "kleine, geheftete, nicht gebundene Schrift mit wenigen Seiten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d4610d6-72b3-40be-9cb5-8b1666c61c73",
                                                "sense_id": "72f2ef35-113c-3608-a5f2-cd2586ad2574",
                                                "text": "Beim Verlassen der Werbeveranstaltung drückten sie mir noch eine Broschüre in die Hand."
                                            },
                                            {
                                                "example_id": "cc325087-558d-4c19-af33-52e5ee24fad6",
                                                "sense_id": "72f2ef35-113c-3608-a5f2-cd2586ad2574",
                                                "text": "„Da gab es eine Broschüre über Mesmerismus, die allem Anschein nach reichlich oft benutzt worden war.“"
                                            },
                                            {
                                                "example_id": "2594b7cc-1721-413e-abc4-c6064a1661ec",
                                                "sense_id": "72f2ef35-113c-3608-a5f2-cd2586ad2574",
                                                "text": "„Regelmäßig waren in konservativen Zeitungen, in Broschüren und auf ‚patriotischen‘ Abendversammlungen Tiraden zu hören.“"
                                            },
                                            {
                                                "example_id": "a00cba18-d853-41cf-8c77-db380aa67847",
                                                "sense_id": "72f2ef35-113c-3608-a5f2-cd2586ad2574",
                                                "text": "„Manchmal spielte im Eingang, wo sich die Büchertische mit Broschüren und Raubdrucken drängten, eine Flöte oder Gitarre, ihre melancholischen Melodien gingen alsbald im Stimmengewirr unter.“"
                                            },
                                            {
                                                "example_id": "cdc339ee-4cbe-4e8b-8f62-3dafbd0f84b6",
                                                "sense_id": "72f2ef35-113c-3608-a5f2-cd2586ad2574",
                                                "text": "„Bei den meisten handelte es sich um kleine Broschüren oder Einblattdrucke zu Unterhaltung und Zeitvertreib.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
