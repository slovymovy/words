                        ],
                        "examples": [
                            {
                                "example_id": "efbd0a87-90c4-4a63-a2e0-efa3994aa7b8",
                                "sense_id": "ee7a85da-def1-33c5-8dc3-06d213d40f29",
                                "text": "Zo zag ik erg op tegen onbekende gevaren op de trail zoals ratelslangen, beren, steile bergen, felle zon en hoge temperaturen in de woestijn."
                            },
                            {
                                "example_id": "0566a7de-eebb-4d9a-9f3f-e35546b5131f",
                                "sense_id": "ee7a85da-def1-33c5-8dc3-06d213d40f29",
                                "text": "Door hoge temperaturen, lage luchtvochtigheid en wind, blijft het risico bestaan dat het vuur weer oplaait."
                            }
                        ]
                    }
