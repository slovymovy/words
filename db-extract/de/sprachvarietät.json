                                            "itp."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c9c3ba1b-207e-4d94-8869-ed76df272a47",
                                                "sense_id": "545631d2-8c22-3b3d-9529-3e424c09ec0a",
                                                "text": "Język ten wykazuje spore podobieństwa ze średniowiecznymi odmianami językowymi germańskimi, z Niemiec, z Holandii, ale są w nim też wpływy słowiańskie, wynik kontaktu językowego zachodzącego przez 800 lat."
                                            }
