        "fr-extract.jsonl": [
            {
                "entry_id": "2fdba0ca-9b1c-3f14-9f64-2a5ef26e11d8",
                "word": "diérèse",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "a2f8c7b7-7610-479a-bb2a-4087b558ba14",
                        "entry_id": "2fdba0ca-9b1c-3f14-9f64-2a5ef26e11d8",
                        "tags": [
                            "plural"
                        ],
                        "form": "diérèses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5d153f1c-d4b5-3de1-b76b-749f08f17505",
                        "entry_id": "2fdba0ca-9b1c-3f14-9f64-2a5ef26e11d8",
                        "glosses": [
                            "Division d’une diphtongue en deux syllabes, le fait que deux voyelles consécutives se prononcent séparément."
                        ],
                        "tags": [
                            "Prosodie"
                        ],
                        "examples": [
                            {
                                "example_id": "c39a991e-4d71-441a-b579-49815801b878",
                                "sense_id": "5d153f1c-d4b5-3de1-b76b-749f08f17505",
                                "text": "Le mot diérèse peut se prononcer en trois syllabes par diérèse, ou en deux par synérèse. Quant au mot « synérèse », impossible de le prononcer par diérèse."
                            },
                            {
                                "example_id": "aeaa2558-ce58-4480-8c00-9d8501c4ce1b",
                                "sense_id": "5d153f1c-d4b5-3de1-b76b-749f08f17505",
                                "text": "Le mot sanglier se prononce maintenant en trois syllabes par diérèse."
                            },
                            {
                                "example_id": "dd41155d-6992-4939-a7c0-f20ac4cb4417",
                                "sense_id": "5d153f1c-d4b5-3de1-b76b-749f08f17505",
                                "text": "Prononcer Nation en trois syllabes au lieu de deux, c’est faire une diérèse."
                            },
                            {
                                "example_id": "f6546dc4-5c16-4cf6-851a-e4f4ef6feeb3",
                                "sense_id": "5d153f1c-d4b5-3de1-b76b-749f08f17505",
                                "text": "[Célèbre diérèse ayant fait scandale, sur le mot lion :] « Vous êtes mon lion, superbe et généreux. »"
                            },
                            {
                                "example_id": "b718ba1b-b878-4882-9074-8f94395aa909",
                                "sense_id": "5d153f1c-d4b5-3de1-b76b-749f08f17505",
                                "text": "Dans des mots comme lier, persuader, nouer, faut-il faire la diérèse, c’est-à-dire prononcer séparément les deux voyelles (li-er, per-sua-der, nou-er), ou bien faire la synérèse (ou synizèse), c’est-à-dire les prononcer en une seule syllabe ?"
                            },
                            {
                                "example_id": "877b1e12-466f-4609-b6f2-234cff380e8b",
                                "sense_id": "5d153f1c-d4b5-3de1-b76b-749f08f17505",
                                "text": "Occasion (prononcé o-ca-zi-on) dans : Le roi des animaux, en cette occasion, montra ce qu'il était et lui donna la vie."
                            }
                        ]
                    },
                    {
                        "sense_id": "975e541e-5904-3a14-9f0b-a406805f9043",
                        "entry_id": "2fdba0ca-9b1c-3f14-9f64-2a5ef26e11d8",
                        "glosses": [
                            "Opération qui consiste à diviser, à dilater ou à séparer des parties dont le rapprochement, l’union ou la continuité sont nuisibles."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "ace75f23-a168-35eb-b6d7-7828c206bd55",
                        "entry_id": "2fdba0ca-9b1c-3f14-9f64-2a5ef26e11d8",
                        "glosses": [
                            "Procédure dichotomique qui enrichit la compréhension d’un concept en en diminuant l’extension : A se divise en B et non-B ; schématisée dans l’arbre de Porphyre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "783b887a-7c19-4168-8101-28326215ef0d",
                                "sense_id": "ace75f23-a168-35eb-b6d7-7828c206bd55",
                                "text": "Parmi les corps, les animés et les non-animés (tels les minéraux ou les plantes), parmi les animés ceux doués de raison (les hommes) et ceux qui ne le sont pas."
                            }
                        ]
                    },
                    {
                        "sense_id": "25288dc8-1c04-34b7-8890-870c23f8f5dd",
                        "entry_id": "2fdba0ca-9b1c-3f14-9f64-2a5ef26e11d8",
                        "glosses": [
                            "Division rythmique du temps"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f6bfcb80-2f25-4d86-bafe-1a52d518c0b0",
                                "sense_id": "25288dc8-1c04-34b7-8890-870c23f8f5dd",
                                "text": "Selon la cinquième différence, des mesures de même grandeur peuvent différer par la dirèse, ou division des temps."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "51544c72-20c7-4626-b7f6-19ad0c80259c",
                        "source_entry_id": "2fdba0ca-9b1c-3f14-9f64-2a5ef26e11d8",
                        "source_sense_description": "Séparation d’une diphtongue en deux syllabes",
                        "target_lang_word": "diaeresis",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "diaeresis",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "96449637-1488-3d28-bdf2-3a90769a6229",
                                        "entry_id": "254bcfd4-fb13-3925-8aea-ca0af60c2d15",
                                        "glosses": [
                                            "A separation of one syllable (especially a vowel which is a diphthong, that is, beginning with one sound and ending with another) into two distinct syllables; distraction."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e03a167b-f122-4769-b54c-8c57664f8992",
                                                "sense_id": "96449637-1488-3d28-bdf2-3a90769a6229",
                                                "text": "Synaeresis, the opposite of Diaëresis, is the throwing of two syllables into one; as, Seest for seëst. Looked for look-ed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "21b9423d-bf87-3b95-a509-865df1c58a2e",
                                        "entry_id": "254bcfd4-fb13-3925-8aea-ca0af60c2d15",
                                        "glosses": [
                                            "A separation of one syllable (especially a vowel which is a diphthong, that is, beginning with one sound and ending with another) into two distinct syllables; distraction.",
                                            "The diacritical mark consisting of two dots (¨) placed over a letter (especially the second of two consecutive vowels) to indicate that it is sounded separately, usually as a distinct syllable."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2242a405-ca4f-4e7c-8078-24d62defe9b7",
                                                "sense_id": "21b9423d-bf87-3b95-a509-865df1c58a2e",
                                                "text": "Diæreſis is vvhen tvvo points ouer a vovvell diuide it from another vovvel, as bouë, queuë, read bou-e, queu-e, not bo-ue, que-ue."
                                            },
                                            {
                                                "example_id": "93dfafbb-a3ed-40c2-be20-3ed54ef8f75b",
                                                "sense_id": "21b9423d-bf87-3b95-a509-865df1c58a2e",
                                                "text": "The Diæresis is used to divide a diphthong into two syllables; as, Creätor."
                                            },
                                            {
                                                "example_id": "38632019-2175-4350-b5f7-2782e51bcfc5",
                                                "sense_id": "21b9423d-bf87-3b95-a509-865df1c58a2e",
                                                "text": "An 85-year injustice has been rectified at Poets' Corner in Westminster Abbey with the corrected spelling of one of the greatest of all literary names. Reader, it is finally Brontë, not Bronte. An amended memorial to Charlotte, Emily and Anne Brontë was unveiled on Thursday with added diaereses (two dots) that ensure people pronounce it with two syllables. As if it rhymed with Monty, not font. The memorial was installed in 1939 and, for whatever reason, came without the diaereses that the Brontës used."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "57cb1611-2e39-3e12-9c25-11894705df24",
                                        "entry_id": "254bcfd4-fb13-3925-8aea-ca0af60c2d15",
                                        "glosses": [
                                            "An occurrence of separate vowel sounds in adjacent syllables without an intervening consonant; a hiatus."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1d8ae814-8c4f-339f-9b5e-b77da31bf6ff",
                                        "entry_id": "254bcfd4-fb13-3925-8aea-ca0af60c2d15",
                                        "glosses": [
                                            "A division, a separation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "rare",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "596116a9-c486-3ab4-9623-bd4ed1f059a6",
                                        "entry_id": "254bcfd4-fb13-3925-8aea-ca0af60c2d15",
                                        "glosses": [
                                            "A natural break in rhythm when a word ends at the end of a metrical foot in a line of verse."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d3f0a293-c2de-3b9c-968c-ddd95b15eced",
                                        "entry_id": "254bcfd4-fb13-3925-8aea-ca0af60c2d15",
                                        "glosses": [
                                            "An act of separating body parts or tissues which are normally together."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5623f884-0190-43e7-8fdb-aee7380b821f",
                                                "sense_id": "d3f0a293-c2de-3b9c-968c-ddd95b15eced",
                                                "text": "There are four^([sic]) manners of performing the Diæreſis: viz. by Cutting, Pricking, Tearing, Dravving, and Burning."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
