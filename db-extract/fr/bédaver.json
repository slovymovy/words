                ],
                "senses": [
                    {
                        "sense_id": "64c40fe2-48e3-39f6-9734-bdd812a953cb",
                        "entry_id": "2c7139b7-b0fd-3bdc-a09f-035d4cde516f",
                        "glosses": [
                            "Fumer (en particulier fumer du haschisch ou de la marijuana)."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "2913540b-3166-462c-84ef-2d6b7dab2704",
                                "sense_id": "64c40fe2-48e3-39f6-9734-bdd812a953cb",
                                "text": "Jean-Loup avait d'ailleurs complètement arrêté de « bédaver » depuis quelque temps face à l'inévitable « bad trip » que ça ne manquait plus de provoquer."
                            },
                            {
                                "example_id": "77182a08-bbcb-4432-9def-070516abe476",
                                "sense_id": "64c40fe2-48e3-39f6-9734-bdd812a953cb",
                                "text": "Pour certains c'est flirter et emballer. Pour d'autres, c'est picoler et gerber. Pour quelques-uns, c'est bédaver et triper. Pour plusieurs, c'est taper et bader."
                            },
                            {
                                "example_id": "816781bc-57c7-471f-b6fa-3d89b59a4a66",
                                "sense_id": "64c40fe2-48e3-39f6-9734-bdd812a953cb",
                                "text": "Quand il ne bédavait pas au pied de la barre, à brasser du vide avec les potes, il bédavait dans sa chambre, au désespoir de ses parents. Il zonait sur YouTube, se branlait sur YouPorn, principalement parce qu'il n'y avait rien d'autre à faire."
                            },
                            {
                                "example_id": "ed28ee28-3874-4f81-b47f-f12c56067823",
                                "sense_id": "64c40fe2-48e3-39f6-9734-bdd812a953cb",
                                "text": "J’veux entendre ma cigarette crépiter\nÀ part bédaver, j’sais pas c’qu’on va devenir\nMais bon, on a la vie devant nous."
                            }
                        ]
                    }
