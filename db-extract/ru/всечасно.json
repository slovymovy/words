                                        "glosses": [
                                            "Occurring every hour."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c6735903-0fde-4668-ba83-b30fd7e2b22d",
                                                "sense_id": "287c13bf-177b-392d-9512-57b8b88e1fef",
                                                "text": "There are hourly express buses."
                                            },
                                            {
                                                "example_id": "88b67852-82cb-46b7-a520-7023b5b03d2e",
                                                "sense_id": "287c13bf-177b-392d-9512-57b8b88e1fef",
                                                "text": "The [four] motors have a continuous rating of 144 h.p. and an hourly output of 180 h.p., giving a total hourly rating of 720 h.p. compared with the six-motored \"Arlecchino's\" 994 h.p."
                                            },
                                            {
                                                "example_id": "664d5a14-f1f3-4e76-bbf7-041a35b1d41d",
                                                "sense_id": "287c13bf-177b-392d-9512-57b8b88e1fef",
                                                "text": "This service has suffered badly from Department for Transport-inspired cuts which reduced it from hourly to two-hourly. This, coupled with regular cancellations, has rendered the train service between the area's two biggest towns almost unusable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7999314b-1a68-3942-a550-bf687dcd7175",
                                        "entry_id": "8ff6634f-e1e3-3c5c-81a5-be352e148674",
                                        "glosses": [
                                            "Unsalaried, paid by the hour; (by extension) blue-collar."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "hourly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "390c9345-a0e7-3ab2-b35e-3e203741faac",
                                        "entry_id": "93e1c070-377a-3a00-9383-4d7e10634a8d",
                                        "glosses": [
                                            "At intervals of an hour."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c8dad44-3e5d-41b9-a023-de76634f37b0",
                                                "sense_id": "390c9345-a0e7-3ab2-b35e-3e203741faac",
                                                "text": "Express buses depart hourly."
                                            },
                                            {
                                                "example_id": "f5104191-d0f9-4191-a1cc-07910124546e",
                                                "sense_id": "390c9345-a0e7-3ab2-b35e-3e203741faac",
                                                "text": "Commencement of a two-hourly service pattern by GWR marked the return of regular services to Okehampton for the first time since their withdrawal in 1972. There are plans to extend this to hourly."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "hourly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4c7c2bea-9eb5-3e29-b6f7-42b2d2df137c",
                                        "entry_id": "6bf709c9-72f0-3b6d-8d0a-1902ee4c4f27",
                                        "glosses": [
                                            "Something produced each hour."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8cce4f4e-1a43-4d7f-b7c3-11a60856d007",
                                                "sense_id": "4c7c2bea-9eb5-3e29-b6f7-42b2d2df137c",
                                                "text": "She never reads her hourly report, but let her hourlies be fifteen minutes late and she raises a ruckus."
