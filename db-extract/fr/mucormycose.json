                                                "example_id": "418f9ee8-55ac-4818-b22b-4bacb811d300",
                                                "sense_id": "4c98b8ec-2b5b-3223-83b9-8797498256ff",
                                                "text": "Herein, we characterized the infecting microbe, host, micro- and mycobiomes leading up to infection onset in a leukemia patient that developed invasive mucormycosis."
                                            }
