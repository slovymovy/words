                "senses": [
                    {
                        "sense_id": "1a0d2212-b68b-3c68-aec0-a175543fa8a8",
                        "entry_id": "bf2afe80-d3ea-36cc-87d9-3033f464bddb",
                        "glosses": [
                            "Atom des Quecksilbers"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "71d0c9aa-f4d6-455b-ac2a-a8b3a260412c",
                                "sense_id": "1a0d2212-b68b-3c68-aec0-a175543fa8a8",
                                "text": "„Die Valenzelektronen am Quecksilberatom wie auch am Bromatom befinden sich im Quantenzustand eines *p-Hybrids.“"
                            },
                            {
                                "example_id": "e89aea05-4ee8-4d69-968f-f338fff4353e",
                                "sense_id": "1a0d2212-b68b-3c68-aec0-a175543fa8a8",
                                "text": "„Die Anregungsspannung für Quecksilberatome konnte somit zu 4,9 Volt experimentell ermittelt werden.“"
                            },
                            {
                                "example_id": "3cf6eed7-4bcf-4f14-9094-123423ca1612",
                                "sense_id": "1a0d2212-b68b-3c68-aec0-a175543fa8a8",
                                "text": "„Nach Abb. 23.1. werden durch Elektronen Quecksilberatome so angeregt, daß diese Licht bestimmter Energie ausstrahlen.“"
                            },
                            {
                                "example_id": "2c8859cd-6248-4e2d-b247-fc5d1b54297b",
                                "sense_id": "1a0d2212-b68b-3c68-aec0-a175543fa8a8",
                                "text": "„Hinsichtlich der Emission und Absorption dieser Linie verhält sich also ein Quecksilberatom wie ein Planckscher Oszillator dieser Frequenz.“"
                            },
                            {
                                "example_id": "d1710ba7-ff5b-4b71-83ac-a26d906a107d",
                                "sense_id": "1a0d2212-b68b-3c68-aec0-a175543fa8a8",
                                "text": "„Dabei emittieren die Quecksilberatome ein bläuliches Licht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
