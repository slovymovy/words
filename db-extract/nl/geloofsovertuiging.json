                    {
                        "sense_id": "de561803-de63-3f5b-8911-11cd23021744",
                        "entry_id": "b3d35134-f0c3-3b1a-8cc1-86a07a028b71",
                        "glosses": [
                            "náboženské přesvědčení"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9589fa1f-65ad-468d-8a0a-9e17a55564a9",
                                "sense_id": "de561803-de63-3f5b-8911-11cd23021744",
                                "text": "“Vrouwen vernederen, maar ook minderheden, immigranten, mensen met andere geloofsovertuigingen, lachen met gehandicapten, onze troepen en veteranen beledigen…Dat vertelt ons een paar dingen. Dat vertelt ons dat hij onzeker genoeg is, dat hij zichzelf beter voelt door anderen neer te halen. Niet echt een karaktereigenschap die ik zou aanraden voor iemand in het Oval Office.”"
                            },
                            {
                                "example_id": "cfc51c65-ac4e-49a0-a2d1-d886a312e7e2",
                                "sense_id": "de561803-de63-3f5b-8911-11cd23021744",
                                "text": "Niet-infectieuze gewrichtsontstekingen zijn vaak chronisch en vallen doorgaans onder de noemer reuma."
                            }
                        ]
                    }
                ],
