                                "example_id": "e1a916cb-c467-44e7-b1b4-f0f6cc36b816",
                                "sense_id": "0046c557-3642-31f8-9ac0-957668718edd",
                                "text": "An acht Montagabenden findet unser Kurs statt."
                            },
                            {
