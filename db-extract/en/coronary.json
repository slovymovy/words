                                    },
                                    {
                                        "sense_id": "b6c4b91e-bd64-3496-8c85-b63a42e81d3d",
                                        "entry_id": "d47973cd-2a16-3c93-ab5f-8cacdb966109",
                                        "glosses": [
                                            "Dicho de un vaso sanguíneo, que está directamente conectado a las cavidades cardíacas."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec1b966f-8193-4e8b-91ef-2763ca4095fb",
                                                "sense_id": "b6c4b91e-bd64-3496-8c85-b63a42e81d3d",
                                                "text": "El espasmo de la arteria coronaria es una de las causas de isquemia o nivel insuficiente de oxígeno en el corazón, que afecta aproximadamente a 4 de cada 100.000 personas y afecta a cerca del 2% de los pacientes con angina."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "907b9d65-1a2c-3efa-b45f-88b322470159",
