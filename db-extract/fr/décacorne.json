                                "target_senses": [
                                    {
                                        "sense_id": "6c246692-75fa-3fed-ab69-b1ab15c6b9cc",
                                        "entry_id": "13341a29-9354-3725-842e-3b6a14d287f6",
                                        "glosses": [
                                            "A private startup with a valuation of US$10 billion or greater."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ebd8977-5bae-4a23-83d2-1aa3bb76d325",
                                                "sense_id": "6c246692-75fa-3fed-ab69-b1ab15c6b9cc",
                                                "text": "Today, the delinquent decacorn of Silicon Valley announced Uber Freight, a bid to bring the ride hailing model to trucking."
                                            },
                                            {
                                                "example_id": "a4ab22e1-a0be-4a26-b84f-c1fd1839aee4",
                                                "sense_id": "6c246692-75fa-3fed-ab69-b1ab15c6b9cc",
                                                "text": "It's not the only domestic decacorn (a unicorn at least ten times over) targeting a 2019 debut."
                                            },
                                            {
                                                "example_id": "d9288a36-dd7a-48dd-b823-2f18738a52d4",
                                                "sense_id": "6c246692-75fa-3fed-ab69-b1ab15c6b9cc",
                                                "text": "Indonesian ride-hailing service Go-Jek's value was estimated at $10 billion by a U.S. market intelligence company, putting it in the ranks of startups called decacorns."
                                            },
                                            {
                                                "example_id": "7d6d24f0-7df4-4134-95d1-6fa065c06f53",
                                                "sense_id": "6c246692-75fa-3fed-ab69-b1ab15c6b9cc",
                                                "text": "Many of the biggest so-called decacorns, or privately held companies with valuations of at least $10 billion, have filed to go public in the past several months. Among them are Lyft, the ride-hailing company, and Pinterest, the digital pin board."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
