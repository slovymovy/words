                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Profitable or advantageous (describing a specific subject or situation).",
                        "tr": "\"Выгодный\" (kârlı, avantajlı) sıfatının nötr cins kısa formu.",
                        "es": "Forma corta neutra del adjetivo «выгодный» (ventajoso, rentable, beneficioso).",
                        "fr": "Forme courte neutre de l'adjectif signifiant avantageux ou profitable."
                    },
