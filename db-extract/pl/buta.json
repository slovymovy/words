                        "source_sense_id": "8ce42be0-f447-3a8d-9235-034d636e0c6a",
                        "source_sense_description": "übermäßige Selbstsicherheit; Hochmut, Hoffart",
                        "target_lang_word": "Hoffart",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hoffart",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5028e028-29a1-3aab-8457-ee8cc614a5a5",
