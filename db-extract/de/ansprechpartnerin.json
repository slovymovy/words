                    },
                    {
                        "translation_id": "eba72cdb-46ba-467d-8e7f-8a249d345370",
                        "source_entry_id": "b8e3feda-cc63-3414-8b10-6298f2d239ce",
                        "source_sense_id": "ac714ff2-6e80-37d1-b63f-46ba43d6630a",
                        "source_sense_description": "vorgesehene Gesprächspartnerin für bestimmte Fragen oder Themen",
                        "target_lang_word": "contact name",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "da3d39b1-8c20-4b28-be25-03d6382c1c64",
                        "source_entry_id": "b8e3feda-cc63-3414-8b10-6298f2d239ce",
                        "source_sense_id": "ac714ff2-6e80-37d1-b63f-46ba43d6630a",
                        "source_sense_description": "vorgesehene Gesprächspartnerin für bestimmte Fragen oder Themen",
                        "target_lang_word": "contact person",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "contact person",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6bbc46a0-e5a8-3e98-9969-6d5ab7a5e9f2",
                                        "entry_id": "80b50037-6aab-32e0-9241-e709773542ac",
                                        "glosses": [
                                            "A person in an organization or group that non-members can contact in order to interact with the group; a representative whose contact details are made public."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7dd0d230-10ba-4db0-8361-e6064d874214",
                                                "sense_id": "6bbc46a0-e5a8-3e98-9969-6d5ab7a5e9f2",
                                                "text": "Opportunity for Public Comment Notice is given that any person may file written comments on the proposed rule making with the agency contact person on or before December 2, 1988."
                                            },
                                            {
                                                "example_id": "9457da6c-75ad-4eed-a6f4-e898644eeda1",
                                                "sense_id": "6bbc46a0-e5a8-3e98-9969-6d5ab7a5e9f2",
                                                "text": "The express terms of the proposed action written in plain English are available from the agency contact person named in this notice."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f23fe5e9-89c8-3c03-9720-d142d17e527d",
                                        "entry_id": "80b50037-6aab-32e0-9241-e709773542ac",
                                        "glosses": [
                                            "A person in an organization whose role puts them in contact with non-members."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0363fa6b-f26e-4b71-be89-44e5def4dc05",
                                                "sense_id": "f23fe5e9-89c8-3c03-9720-d142d17e527d",
                                                "text": "These contact people themselves have much responsibility for marketing, as they are in closer contact with customers than anyone else in the business."
                                            },
                                            {
                                                "example_id": "dd94ab97-1794-45e1-b8a9-db225583fd41",
                                                "sense_id": "f23fe5e9-89c8-3c03-9720-d142d17e527d",
                                                "text": "In many knowledge or service based strategies, the person in contact with the customer — the \"contact person\" or \"point person\" — becomes perhaps the most important person in the organization."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "20cc3438-dd6d-30ca-9f00-d3ed96d78d0a",
                                        "entry_id": "80b50037-6aab-32e0-9241-e709773542ac",
                                        "glosses": [
                                            "A point person."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58f135f0-cf7b-4e37-a16b-4e27a439bdc1",
                                                "sense_id": "20cc3438-dd6d-30ca-9f00-d3ed96d78d0a",
                                                "text": "The contact person at the company sponsoring the plan must be detail- and numbers-oriented."
                                            },
                                            {
                                                "example_id": "b9228a20-c172-41b3-bfeb-a5b467b0fa9b",
                                                "sense_id": "20cc3438-dd6d-30ca-9f00-d3ed96d78d0a",
                                                "text": "Both mailings will be sent to the bidder's contact person at the contact address identified in the bidder's FCC Form 175."
                                            },
                                            {
                                                "example_id": "968d1fe0-5d29-41ac-b53e-a0f800f662af",
                                                "sense_id": "20cc3438-dd6d-30ca-9f00-d3ed96d78d0a",
                                                "text": "If I reside in a community where a Parole Officer is not assigned, I will obtain a community contact person approved by my Parole Officer."
                                            },
                                            {
                                                "example_id": "85bc16e0-1ff9-4b35-9114-7615084b371e",
                                                "sense_id": "20cc3438-dd6d-30ca-9f00-d3ed96d78d0a",
                                                "text": "Establish an alternative contact and copy him or her on information you send to the primary contact. Sometimes the contact person comes down with a cold on your production day."
                                            },
                                            {
                                                "example_id": "f83b5ec6-d7ef-4e09-9ee8-c6aaa78a9076",
                                                "sense_id": "20cc3438-dd6d-30ca-9f00-d3ed96d78d0a",
                                                "text": "It is worth noting that the HSA Code of Practice (2007) states that the employer should name a 'contact person' whose task it is to '...listen and advise about complaints of bullying at work and explain the procedures in place to resolve it'."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ae507d64-51b9-39a8-a03c-eb26520adb9e",
                                        "entry_id": "80b50037-6aab-32e0-9241-e709773542ac",
                                        "glosses": [
                                            "A person, such as next of kin, who should be told about someone's situation if an emergency occurs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "560053ab-e29e-40c2-9dac-16b5bf9d74eb",
                                                "sense_id": "ae507d64-51b9-39a8-a03c-eb26520adb9e",
                                                "text": "The name and phone numbers of every contact person should be reviewed by HR ; unfortunately , the person who is listed at the time of hire is often the person now doing the victimizing."
                                            },
                                            {
                                                "example_id": "3fd707dc-11ae-4d20-a92d-c086dafdfaf7",
                                                "sense_id": "ae507d64-51b9-39a8-a03c-eb26520adb9e",
                                                "text": "Searching through a cell phone memory of numbers takes valuable time and without a way to identify the emergency contact person from the list of stored numbers, the wrong person or no person may get contacted to advise of your situation and location."
                                            },
                                            {
                                                "example_id": "eb063077-e894-4986-920f-9741f2edda4e",
                                                "sense_id": "ae507d64-51b9-39a8-a03c-eb26520adb9e",
                                                "text": "Contain an option for each student to identify a contact person or persons whom the institution shall notify within 24 hours of the determination that the student is missing, if the student has been determined missing by the institutional police or campus security department, or the local law enforcement agency;"
                                            },
                                            {
                                                "example_id": "7788e9bc-5449-4800-9e09-73b8671d67ce",
                                                "sense_id": "ae507d64-51b9-39a8-a03c-eb26520adb9e",
                                                "text": "An informed consent and safety plan need to include a contact person."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "641d2e6c-63f5-3f5c-8463-18ab67d907fb",
                                        "entry_id": "80b50037-6aab-32e0-9241-e709773542ac",
                                        "glosses": [
                                            "A person with whom one has had contact; a contact."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb1de45c-4dde-4e52-92f7-fc4f33aa9757",
                                                "sense_id": "641d2e6c-63f5-3f5c-8463-18ab67d907fb",
                                                "text": "The diary was organized as a table in which participants recorded the following features of their contacts during work and leisure time: age (or age range) and sex of the contact person; location where the contact occurred (multiple locations possible); indication of whether physical contact was involved; and lengt of time the contact lasted."
                                            },
                                            {
                                                "example_id": "8218d599-9b7c-4d95-9f09-0b192b654598",
                                                "sense_id": "641d2e6c-63f5-3f5c-8463-18ab67d907fb",
                                                "text": "Pray for the church outreaches that a strong conviction of the Holy Spirit will come upon every contact person for them to accept Jesus as their Lord and Saviour."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
