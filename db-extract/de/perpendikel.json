                "senses": [
                    {
                        "sense_id": "9cd66205-2363-3611-9731-caecdbcc9a8e",
                        "entry_id": "28592492-c718-30ed-8c22-d5fd31552b02",
                        "glosses": [
                            "sichtbares Pendel einer Pendeluhr"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "631fe836-3032-4e51-9ad3-a2975a12f8e3",
                                "sense_id": "9cd66205-2363-3611-9731-caecdbcc9a8e",
                                "text": "Hinter Glas geschützt schwingt ein schön geschmücktes Perpendikel."
                            },
                            {
                                "example_id": "9d00d122-b584-4abf-a2d0-35aace18c795",
                                "sense_id": "9cd66205-2363-3611-9731-caecdbcc9a8e",
                                "text": "„Der Regulator zerhackt mit seinem Perpendikel die Zeit in hörbare Teilchen.“"
                            },
                            {
                                "example_id": "9fc98d58-3cee-4dfc-b903-6763fe2f4d5e",
                                "sense_id": "9cd66205-2363-3611-9731-caecdbcc9a8e",
                                "text": "„Diese Bewegung des kahlen, blanken Kopfes erinnert Lassehn plötzlich ab euíne groteske Reklamefigur, wie er sie früher oft in den Schaufenstern gesehen hat, ein dürres Mänchen mit großen, runden, hervorquellenden Augen, kahlem Schädel und dicken, aufgeworfenen Lippen, die sich mechanisch bewegten, während der Kopf wie ein umgekehrtes Perpendikel hin- und herschwang und eine Hand mit einem Stab gegen die Glasscheibe pochte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "32df3c0f-d746-3500-a79a-7d54cc10cc2b",
                        "entry_id": "28592492-c718-30ed-8c22-d5fd31552b02",
                        "glosses": [
                            "Gerade, die auf einer anderen Geraden oder auf einer Ebene senkrecht steht"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "12acad37-815f-4d3e-8ea7-f776cfd02dfc",
                                "sense_id": "32df3c0f-d746-3500-a79a-7d54cc10cc2b",
                                "text": "„Auf die Austrittsebene Bb werde das Perpendikel JM errichtet, welches die verlängerte Einfallslinie GH in M, die Einfallsebene Aa in R schneidet […]“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
