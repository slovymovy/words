                "senses": [
                    {
                        "sense_id": "9cc1a3c5-ed34-3c4e-9e48-1a3cd9185a70",
                        "entry_id": "1429b36e-ea58-3cb1-9a3f-25923b8c7388",
                        "glosses": [
                            "Ancienne orthographe de désengainer (défaire de sa gaine)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "12565f87-c066-4421-9f8b-9cfcb4bf5c4e",
                                "sense_id": "9cc1a3c5-ed34-3c4e-9e48-1a3cd9185a70",
                                "text": "Il fallait désengaîner la morale de tout ce revêtement artificiel : de là quelques brisures."
                            },
                            {
                                "example_id": "2c425f70-dd87-456d-86d9-598cbdda7225",
                                "sense_id": "9cc1a3c5-ed34-3c4e-9e48-1a3cd9185a70",
                                "text": "M. Hardwick admet aussi que ni les lavements ni les autres remèdes ne peuvent désengaîner l’intestin, et qu’il n’y a de guérison possible que par l’adhérence des deux séreuses intestinales qui viennent en contact, et l’évacuation de la partie invaginée."
                            }
                        ]
                    }
