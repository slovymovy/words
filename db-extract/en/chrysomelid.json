                        "glosses": [
                            "Belonging or relating to the family Chrysomelidae."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b1585de-1508-4f5f-b3e0-0bdd379974c3",
                                "sense_id": "014990d5-4a67-389b-bb95-3ff5e24e596c",
                                "text": "In all, 34 willow-associated chrysomelid species were encountered, of which eight were very abundant."
                            },
                            {
                                "example_id": "1b8422ed-0e11-43f0-8b98-99130533587c",
                                "sense_id": "014990d5-4a67-389b-bb95-3ff5e24e596c",
                                "text": "Defensive shields and domiciles may help explain the uneven radiation of chrysomelid subfamilial and tribal clades."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
