{
    "word_family": [
        "uitbundigheid"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "7a6ce4f4-53a7-3a15-8a75-75319d74f1fe",
                    "sense_definition": "Op een zeer enthousiaste, vrolijke en luidruchtige wijze gevoelens uitend.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "enthousiast",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na het winnende doelpunt barstte het publiek in een <w>uitbundig</w> gejuich uit.",
                            "target_lang_translations": {
                                "en": "After the winning goal, the crowd burst into <w>exuberant</w> cheering."
                            }
                        },
                        {
                            "text": "Zij vierden hun overwinning met een <w>uitbundig</w> feest dat tot diep in de nacht duurde.",
                            "target_lang_translations": {
                                "en": "They celebrated their victory with a <w>boisterous</w> party that lasted late into the night."
                            }
                        }
                    ],
                    "synonyms": [
                        "enthousiast",
                        "geestdriftig"
                    ],
                    "antonyms": [
                        "ingetogen",
                        "rustig",
                        "somber"
                    ],
                    "common_phrases": [
                        "uitbundig feest",
                        "uitbundig vieren"
                    ],
                    "target_lang_definitions": {
                        "en": "Expressing feelings in a very enthusiastic, joyful, and boisterous manner."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "exuberant",
                                "target_lang_sense_clarification": "full of energy, excitement, and cheerfulness"
                            },
                            {
                                "target_lang_word": "enthusiastic",
                                "target_lang_sense_clarification": "showing intense and eager enjoyment or interest"
                            },
                            {
                                "target_lang_word": "boisterous",
                                "target_lang_sense_clarification": "noisy, energetic, and cheerful"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "86bf46c9-7fec-3085-951c-dae2533fb134",
                    "sense_definition": "In zeer grote mate aanwezig, de normale maat overschrijdend; overvloedig of weelderig.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "overvloedig",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De tuin stond vol met <w>uitbundig</w> bloeiende bloemen in allerlei kleuren.",
                            "target_lang_translations": {
                                "en": "The garden was full of <w>profusely</w> blooming flowers in all kinds of colors."
                            }
                        },
                        {
                            "text": "De straten waren voor de koning <w>uitbundig</w> versierd met vlaggen en slingers.",
                            "target_lang_translations": {
                                "en": "The streets were <w>lavishly</w> decorated with flags and garlands for the king."
                            }
                        }
                    ],
                    "synonyms": [
                        "abundant",
                        "overvloedig",
                        "rijk",
                        "rijkelijk",
                        "weelderig",
                        "welig"
                    ],
                    "antonyms": [
                        "schaars",
                        "sober"
                    ],
                    "common_phrases": [
                        "uitbundig versierd",
                        "uitbundig bloeiend"
                    ],
                    "target_lang_definitions": {
                        "en": "Present in a very large quantity, exceeding the normal measure; abundant or lush."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "abundant",
                                "target_lang_sense_clarification": "existing or available in large quantities; plentiful"
                            },
                            {
                                "target_lang_word": "profuse",
                                "target_lang_sense_clarification": "given or produced in great abundance"
                            },
                            {
                                "target_lang_word": "lush",
                                "target_lang_sense_clarification": "growing luxuriantly or in great abundance"
                            },
                            {
                                "target_lang_word": "copious",
                                "target_lang_sense_clarification": "abundant in supply or quantity"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "0dc9e6d7-4d9d-3f6d-9b42-90d74aa132a7",
                    "sense_definition": "In ruime mate, in sterke mate of overvloedig.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "overvloedig",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het matras veerde <w>uitbundig</w> mee toen de kinderen op het bed sprongen.",
                            "target_lang_translations": {
                                "en": "The mattress bounced <w>exuberantly</w> as the children jumped on the bed."
                            }
                        },
                        {
                            "text": "De zon scheen die middag <w>uitbundig</w> aan een wolkenloze hemel.",
                            "target_lang_translations": {
                                "en": "The sun shone <w>brightly</w> in a cloudless sky that afternoon."
                            }
                        }
                    ],
                    "synonyms": [
                        "rijkelijk",
                        "overvloedig"
                    ],
                    "antonyms": [
                        "matig",
                        "sober"
                    ],
                    "common_phrases": [
                        "uitbundig meeveren"
                    ],
                    "target_lang_definitions": {
                        "en": "To a large degree, in a strong manner, or abundantly."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "exuberantly",
                                "target_lang_sense_clarification": "in a full, energetic, or lavish manner"
                            },
                            {
                                "target_lang_word": "abundantly",
                                "target_lang_sense_clarification": "in large quantities or to a high degree"
                            },
                            {
                                "target_lang_word": "profusely",
                                "target_lang_sense_clarification": "to a great degree or in large amounts"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}