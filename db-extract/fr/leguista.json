                        "examples": [
                            {
                                "example_id": "69f6f860-f8e3-454b-8308-3fba54e8f9ea",
                                "sense_id": "c6302cc1-ea6e-36f4-8cba-1f5af9f7ecfc",
                                "text": "Los leguistas piden placas vehiculares con identificación de provincia.\nLes léguistes demandent des plaques d’immatriculation avec une identification de province."
                            },
                            {
                                "example_id": "6adf7b17-18d4-4034-9729-cb473991d7f6",
                                "sense_id": "c6302cc1-ea6e-36f4-8cba-1f5af9f7ecfc",
                                "text": "[La Liga Norte] coquetea ahora con los ex comunistas de derecha que integran el Partido Demócrata y que les tienden puentes y ofrecen acciones comunes olvidando la xenofobia y el separatismo de los leguistas.\n[La Ligue du Nord] flirte maintenant avec les anciens communistes de droite qui ont intégré le Parti Démocratie et qui leurs tendent des ponts et offrent des actions communes oubliant la xénophobie et le séparatisme des léguistes."
                            }
                        ]
                    }
