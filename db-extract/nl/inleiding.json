                                                "sense_id": "b4d02511-47ed-3c48-9494-9ac0e12d9cd8",
                                                "text": "Die Einleitung der Narkose verlief optimal."
                                            },
                                            {
                                                "example_id": "c33f801a-0443-4840-b5d2-d5ebb4351d9d",
                                                "sense_id": "b4d02511-47ed-3c48-9494-9ac0e12d9cd8",
                                                "text": "Mit der künstlichen Einleitung der Geburt wurde nicht mehr zugewartet."
