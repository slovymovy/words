                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "0aefbb3c-b376-4363-bee9-f07593d364da",
                                "sense_id": "3e11bf02-598f-3b90-b5f8-d3b6efa7b4b5",
                                "text": "Ik had dat altijd wel een beetje zo gevoeld, maar het onderdrukt en toegeschreven aan mijn natuurlijke achterdocht."
                            }
                        ]
                    }
