            "senses": [
                {
                    "sense_id": "07e7dee6-8102-32dc-abbf-23b1e6e0eea5",
                    "sense_definition": "Describing a row of houses that are joined together by their side walls.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "architecture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They live in a small <w>terraced</w> house in the center of the city.",
                            "target_lang_translations": {
                                "ru": "Они живут в небольшом <w>террасном</w> доме в центре города."
                            }
                        },
                        {
                            "text": "The street was lined with beautiful <w>terraced</w> housing built during the Victorian era.",
                            "target_lang_translations": {
                                "ru": "Улица была застроена красивыми <w>сблокированными</w> домами, возведенными в викторианскую эпоху."
                            }
                        }
                    ],
                    "synonyms": [
                        "row"
                    ],
                    "antonyms": [
                        "detached",
                        "semi-detached"
                    ],
                    "common_phrases": [
                        "terraced house",
                        "terraced housing",
                        "terraced street"
                    ],
                    "target_lang_definitions": {
                        "ru": "Описание ряда домов, соединенных между собой боковыми стенами."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "террасный",
                                "target_lang_sense_clarification": "о типе застройки"
                            },
                            {
                                "target_lang_word": "сблокированный",
                                "target_lang_sense_clarification": "о домах в ряду"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ecd7f1f5-f9ed-3fec-9ca8-0bab700488de",
                    "sense_definition": "The past tense and past participle of <w>terrace</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmers <w>terraced</w> the steep hillside to create flat areas for planting crops.",
                            "target_lang_translations": {
                                "ru": "Фермеры <w>террасировали</w> крутой склон холма, чтобы создать ровные участки для посадки сельскохозяйственных культур."
                            }
                        },
                        {
                            "text": "The garden was beautifully <w>terraced</w> with stone walls and colorful flowers.",
                            "target_lang_translations": {
                                "ru": "Сад был красиво <w>разбит на террасы</w> с каменными стенами и яркими цветами."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and past participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие прошедшего времени от глагола terrace (делать террасы)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "террасированный",
                                "target_lang_sense_clarification": "сделанный в виде террас"
                            },
                            {
                                "target_lang_word": "устроенный уступами",
                                "target_lang_sense_clarification": "о ландшафте"
