                        "sense_id": "4bd98c27-2bfb-3fc9-9ab5-0c20819018c3",
                        "entry_id": "078f0ac3-0507-30cb-9f37-b506f50edab6",
                        "glosses": [
                            "Immaterial, supersensual, beyond the physical."
                        ],
                        "tags": [
