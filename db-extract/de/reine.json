                        "form": "die Reine"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a494c79d-5f26-3631-986f-092f30f589e9",
                        "entry_id": "dba88432-58af-3faf-8a77-dd5792d6c8ae",
                        "glosses": [
                            "frische Sauberkeit, zum Beispiel als Reinheit der Seele, des Gefühls"
                        ],
                        "tags": [
                            "no-plural",
                            "poetic"
                        ],
                        "examples": [
                            {
                                "example_id": "3397e9f2-6e66-4a86-825a-c991828df6fb",
                                "sense_id": "a494c79d-5f26-3631-986f-092f30f589e9",
                                "text": "„Die Sonntagsstille, die Heiterkeit der Luft, die Wärme der Sonne, die Reine des Himmels über mir, und das Rauschen eines benachbarten großen Nußbaums wiegten mich in eins der süßesten Nachdenken über das Bild meines künftigen Lebens […].“"
                            },
                            {
                                "example_id": "28e5c4e7-6dc5-48e5-81eb-6dd55d6c69d3",
                                "sense_id": "a494c79d-5f26-3631-986f-092f30f589e9",
                                "text": "Die Reine des Metalls prüfte man mit Salpetersäure."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dc8f8459-df33-49f9-ab55-66f8e3bfb7fd",
                        "source_entry_id": "dba88432-58af-3faf-8a77-dd5792d6c8ae",
                        "source_sense_id": "a494c79d-5f26-3631-986f-092f30f589e9",
                        "target_lang_word": "purity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "purity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0bb5466b-3d29-3576-8533-86af310322ff",
                                        "entry_id": "24ef0457-aded-3dbb-b4c0-8afdba28d213",
                                        "glosses": [
                                            "The state or degree of being pure."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "adc6f143-ceb3-43b8-aaab-a05859e3475a",
                                                "sense_id": "0bb5466b-3d29-3576-8533-86af310322ff",
                                                "text": "The purity of the water was tested in a laboratory."
                                            },
                                            {
                                                "example_id": "bf36e58a-08f1-404c-b395-fe44fb9cb6ef",
                                                "sense_id": "0bb5466b-3d29-3576-8533-86af310322ff",
                                                "text": "She admired the purity of the child’s laughter."
                                            },
                                            {
                                                "example_id": "6c2dc41e-c7b1-441c-a61f-b53ef717976e",
                                                "sense_id": "0bb5466b-3d29-3576-8533-86af310322ff",
                                                "text": "Gold is valued according to its level of purity."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "70b5b85f-06f6-4748-b99b-91ec1f5acdde",
                        "source_entry_id": "dba88432-58af-3faf-8a77-dd5792d6c8ae",
                        "source_sense_id": "a494c79d-5f26-3631-986f-092f30f589e9",
                        "target_lang_word": "pureté",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pureté",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "22547368-d29d-3866-b05c-0f670b96519b",
                                        "entry_id": "454c4b54-cd37-3afa-a035-7d3dbfdb47b4",
                                        "glosses": [
                                            "Qualité d’une chose qui est pure et sans mélange."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db8275c4-d2c0-4028-89f4-202a78ced831",
                                                "sense_id": "22547368-d29d-3866-b05c-0f670b96519b",
                                                "text": "Le meilleur criterium de la pureté des différents acides gras est leur point de fusion, qui est d'autant plus élevé qu'ils contiennent plus de carbone."
                                            },
                                            {
                                                "example_id": "4d35ef1c-f8f0-4992-99cd-d4abaa5dc6f6",
                                                "sense_id": "22547368-d29d-3866-b05c-0f670b96519b",
                                                "text": "Par le moyen du feu, on porte les métaux au plus haut degré de pureté dont ils soient susceptibles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "03e40447-8a54-3c20-b571-89a8ce8fc7e0",
                                        "entry_id": "454c4b54-cd37-3afa-a035-7d3dbfdb47b4",
                                        "glosses": [
                                            "Intégrité, droiture, innocence, exemption d’altération, de corruption, de souillure."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f2563c00-fb66-421f-bed7-d1d8627e353e",
                                                "sense_id": "03e40447-8a54-3c20-b571-89a8ce8fc7e0",
                                                "text": "Hélène était arrivée à un âge où la pureté de l'âme porte à des rigidités qui dépassent la juste mesure dans laquelle doivent rester les sentiments."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "31197362-f9c5-38e6-8bf9-7b44ff48d4a5",
                                        "entry_id": "454c4b54-cd37-3afa-a035-7d3dbfdb47b4",
                                        "glosses": [
                                            "Chasteté."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "37ca0518-ae48-4b4b-b516-66409b3fceaf",
                                                "sense_id": "31197362-f9c5-38e6-8bf9-7b44ff48d4a5",
                                                "text": "Les péchés contre la pureté."
                                            },
                                            {
                                                "example_id": "b23150f4-0172-4172-a7af-80881361b203",
                                                "sense_id": "31197362-f9c5-38e6-8bf9-7b44ff48d4a5",
                                                "text": "Pureté angélique."
                                            },
                                            {
                                                "example_id": "b5c2559c-0f57-437e-89e2-d477eebb1613",
                                                "sense_id": "31197362-f9c5-38e6-8bf9-7b44ff48d4a5",
                                                "text": "Pureté virginale."
                                            },
                                            {
                                                "example_id": "ac89683c-ddd3-4f66-9f7a-9cfbdca7e3d7",
                                                "sense_id": "31197362-f9c5-38e6-8bf9-7b44ff48d4a5",
                                                "text": "La pureté du cœur et de l’esprit."
                                            },
                                            {
                                                "example_id": "320555c4-1b16-4389-b384-0f9d2755bf18",
                                                "sense_id": "31197362-f9c5-38e6-8bf9-7b44ff48d4a5",
                                                "text": "Il est incontestable qu’au rebours de la plupart des autres religions, paganisme, islamisme, brahmanisme… le catholicisme moderne a fait de l’impureté, ou de ce qu’il appelle ainsi, un vice fondamental, et de la pureté la vertu peut-être la plus précieuse, la plus céleste, celle dont le parfum est le plus recherché de Dieu. Pour n’être pas inscrite au nombre des vertus théologales, elle n’en a pas un moindre prestige, et mon expérience de confesseur me permet d’avancer que bien des vierges, d’âge mûr, se pardonnent aisément à elles-mêmes un manque presque absolu de charité, à la faveur de leur corps intact."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f6073f6f-6f04-3ff7-a838-dd836bfe9d84",
                                        "entry_id": "454c4b54-cd37-3afa-a035-7d3dbfdb47b4",
                                        "glosses": [
                                            "Exactitude dans le choix, l’emploi et l’arrangement des termes et des phrases."
                                        ],
                                        "tags": [
                                            "Style & langage"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1d2f18fe-6abf-4d86-97d7-df2521749d27",
                                                "sense_id": "f6073f6f-6f04-3ff7-a838-dd836bfe9d84",
                                                "text": "Pureté de style, de diction, d’élocution."
                                            },
                                            {
                                                "example_id": "75915559-ddc9-4126-ba98-a14a48eca5bb",
                                                "sense_id": "f6073f6f-6f04-3ff7-a838-dd836bfe9d84",
                                                "text": "Pureté d’expression."
                                            },
                                            {
                                                "example_id": "21960d9a-8e6d-4757-bd1d-44723516775e",
                                                "sense_id": "f6073f6f-6f04-3ff7-a838-dd836bfe9d84",
                                                "text": "Cet écrivain est d’une grande pureté."
                                            },
                                            {
