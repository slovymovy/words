                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7e6c6859-c81b-49e7-8b44-d88430e60804",
                                                "sense_id": "5ca7ca02-069d-33db-b389-36ccda399252",
                                                "text": "With no warning a gang of little snots — none larger or older than I was — threw me to the ground, pulled my knickers below my knees — without any explanation, and allowed me to get up."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a32d859a-ce0a-3909-acc2-1d2d73dad2e7",
