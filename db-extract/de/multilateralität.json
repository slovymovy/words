                    {
                        "form_id": "6386b1b0-b0e4-43da-a54c-21f056e109fa",
                        "entry_id": "25487465-3849-3a8c-ac6e-6f1b7704127d",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Multilateralität"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "51fe2785-b328-35fc-aff7-3f7276716119",
                        "entry_id": "25487465-3849-3a8c-ac6e-6f1b7704127d",
                        "glosses": [
                            "Eigenschaft/Tatsache, dass etwas auf verschiedenen Seiten, vielseitig (multilateral) ausgeprägt ist; dass sich etwas auf mehrere Seiten bezieht (im politischen Zusammenhang sind damit oft verschiedene Staaten gemeint)"
                        ],
                        "tags": [
                            "auch"
                        ],
                        "examples": [
                            {
                                "example_id": "3d9d9ace-1fa3-43fd-8061-32ac3d149302",
                                "sense_id": "51fe2785-b328-35fc-aff7-3f7276716119",
                                "text": "„Bestimmt man die Multilateralität ohne zentralen Koordinator, erreicht Finnland die höchsten Werte. In keinem anderen Land sind die Koordinationsbeziehungen zwischen den Fachressorts so stark ausgeprägt.“"
                            },
                            {
                                "example_id": "d5ae8e39-91a8-4a1f-bfad-e80bdbe350f6",
                                "sense_id": "51fe2785-b328-35fc-aff7-3f7276716119",
                                "text": "„Hier erhebt sich die Frage, in welchem Zusammenhang gemeinsame Planung und Multilateralität im allgemeinen und die verschiedenen Formen der Zusammenarbeit im besonderen stehen.“"
                            },
                            {
                                "example_id": "b2daadbd-26b0-4872-986c-297a5ddeed1c",
                                "sense_id": "51fe2785-b328-35fc-aff7-3f7276716119",
                                "text": "„Multipolarität bzw. Multilateralität und Großmachtanspruch schließen sich nach dem Verständnis des Kremls nicht aus. Für Moskau bedeutet Multilateralität Gleichberechtigung nur zwischen den ‚happy few‘ Großmächten.“"
                            },
                            {
                                "example_id": "766829a1-820b-4803-bd14-46dd9f923a4a",
                                "sense_id": "51fe2785-b328-35fc-aff7-3f7276716119",
                                "text": "„Die Außenpolitik der USA hat nach 1945 den Eindruck erweckt, sie sei von dem Willen zu Multilateralität und Internationalität bestimmt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
