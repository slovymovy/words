                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a96e79e-35ac-4bbf-878c-b4a9ed9aa2ae",
                                "sense_id": "be05f305-545d-37a7-afaa-45727a8930f2",
                                "text": "Венецианские аркебузиры забивают в дула своих ружей пыжи и круглые кованые пули, волочат маленькую пушку, поджигают порох…"
                            }
                        ]
                    }
                ],
                "translations": [
