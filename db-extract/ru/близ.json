                                "target_senses": [
                                    {
                                        "sense_id": "37bc48aa-af68-3f65-b25e-d848fa3d430a",
                                        "entry_id": "31544de7-805d-3f2a-b074-8d3fd9589cf3",
                                        "glosses": [
                                            "At or towards a position close in space or time."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "19e02184-b857-39f7-87ab-698237c8a367",
                                        "entry_id": "31544de7-805d-3f2a-b074-8d3fd9589cf3",
                                        "glosses": [
                                            "Nearly; almost."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "546e3a4f-c299-4299-a45c-ebd7d5f72a0b",
                                                "sense_id": "19e02184-b857-39f7-87ab-698237c8a367",
                                                "text": "He was near unconscious when I found him."
                                            },
                                            {
                                                "example_id": "ede3a3c1-3ed8-4d25-ba00-ab24e82518ab",
                                                "sense_id": "19e02184-b857-39f7-87ab-698237c8a367",
                                                "text": "I jumped into the near-freezing water."
                                            },
                                            {
                                                "example_id": "bab7df15-2ae2-463a-9dfe-888c57664550",
                                                "sense_id": "19e02184-b857-39f7-87ab-698237c8a367",
                                                "text": "I near ruptured myself trying to move the piano."
                                            },
                                            {
                                                "example_id": "927b3752-6b23-4e8e-b411-252f895d4951",
                                                "sense_id": "19e02184-b857-39f7-87ab-698237c8a367",
                                                "text": "[…] he hears for certain that the Queen-Mother is about and hath near finished a peace with France […]"
                                            },
                                            {
                                                "example_id": "515b348b-f386-4428-ace8-9bad699b3b2c",
                                                "sense_id": "19e02184-b857-39f7-87ab-698237c8a367",
                                                "text": "Sir John Friend had very near completed a regiment of horse."
                                            },
                                            {
                                                "example_id": "5b70a85a-31dd-403c-9784-b870033df8c5",
                                                "sense_id": "19e02184-b857-39f7-87ab-698237c8a367",
                                                "text": "Peter ran after them as fast as his legs would carry him, but at last he had only one of the hares left, and when this was gone, he was very near burst with running."
                                            },
                                            {
                                                "example_id": "88f3bf96-4c4d-4157-b993-e2fbf223943d",
                                                "sense_id": "19e02184-b857-39f7-87ab-698237c8a367",
                                                "text": "Thinking about those pounds and pence, I near forgot my wound."
                                            },
                                            {
                                                "example_id": "98fc586d-6933-4d38-a7db-347da59bfca5",
                                                "sense_id": "19e02184-b857-39f7-87ab-698237c8a367",
                                                "text": "\"I damn near forgot.\" He pulled an envelope from his jacket."
                                            },
                                            {
                                                "example_id": "91af6fbe-6cca-4379-b7ca-a452a14ba93b",
                                                "sense_id": "19e02184-b857-39f7-87ab-698237c8a367",
                                                "text": "The fire was almost dead, the chamber near dark."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "near",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b6a98257-6ed1-3c78-b7ff-dbc272b2e37f",
                                        "entry_id": "6fe738b2-ff24-3b8a-9ebd-8500ddd5dcb4",
                                        "glosses": [
                                            "Physically close to, in close proximity to."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e58712d4-e443-4cfe-bdcf-8fbd28c11264",
                                                "sense_id": "b6a98257-6ed1-3c78-b7ff-dbc272b2e37f",
                                                "text": "There are habitable planets orbiting many of the stars near our Sun."
                                            },
                                            {
                                                "example_id": "9085b446-298e-48c5-90ce-75afea3e4ebd",
                                                "sense_id": "b6a98257-6ed1-3c78-b7ff-dbc272b2e37f",
                                                "text": "Ts'ai Ch'ien 蔡乾 was born in 1908 in Changhua near Taichung, Taiwan (Formosa)."
                                            },
                                            {
                                                "example_id": "6b5f7319-b54f-4983-856c-da05cb28fdce",
                                                "sense_id": "b6a98257-6ed1-3c78-b7ff-dbc272b2e37f",
                                                "text": "He entered the inn, and asking for dinner, unbuckled his wallet, and sat down to rest himself near the door."
                                            },
                                            {
                                                "example_id": "b1de15f8-8fa5-4c44-9876-e5a2a590d746",
                                                "sense_id": "b6a98257-6ed1-3c78-b7ff-dbc272b2e37f",
                                                "text": "This time was most dreadful for Lilian. Thrown on her own resources and almost penniless, she maintained herself and paid the rent of a wretched room near the hospital by working as a charwoman, sempstress, anything."
                                            },
                                            {
                                                "example_id": "967148d6-5587-4962-ba12-2f5c9a859bfb",
                                                "sense_id": "b6a98257-6ed1-3c78-b7ff-dbc272b2e37f",
                                                "text": "It shied, balked, and whinnied, and in the end he could do nothing but drive it into the yard while the men used their own strength to get the heavy wagon near enough the hayloft for convenient pitching."
                                            },
                                            {
                                                "example_id": "f64872b6-5283-4038-b0a8-9dbd427b45d3",
                                                "sense_id": "b6a98257-6ed1-3c78-b7ff-dbc272b2e37f",
                                                "text": "Most of the Himalayan rivers have been relatively untouched by dams near their sources. Now the two great Asian powers, India and China, are rushing to harness them as they cut through some of the world's deepest valleys."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bc08388b-2d99-3f8c-8a7b-9e08748f26eb",
                                        "entry_id": "6fe738b2-ff24-3b8a-9ebd-8500ddd5dcb4",
                                        "glosses": [
                                            "Close to in time."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb9fd499-3d16-46bc-8f5e-aa2c6ac6b3a9",
                                                "sense_id": "bc08388b-2d99-3f8c-8a7b-9e08748f26eb",
                                                "text": "The voyage was near completion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca36d391-e5c5-3404-a27c-8b5355a8ff09",
                                        "entry_id": "6fe738b2-ff24-3b8a-9ebd-8500ddd5dcb4",
                                        "glosses": [
                                            "Close to in nature or degree."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d54e49a-4992-4a58-8cde-8f308bf01e4e",
                                                "sense_id": "ca36d391-e5c5-3404-a27c-8b5355a8ff09",
                                                "text": "His opinions are near the limit of what is acceptable."
                                            },
                                            {
                                                "example_id": "68707fa2-3b2c-4e93-8564-b91a29576c4c",
                                                "sense_id": "ca36d391-e5c5-3404-a27c-8b5355a8ff09",
                                                "text": "There was no way Brín felt anything anywhere near what I felt for him. He saw me as a friend."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "near",
                                "target_lang_code": "en",
                                "target_senses": [
