                                "target_senses": [
                                    {
                                        "sense_id": "40161dba-a8cd-35b7-91ff-1a9e22bb3301",
                                        "entry_id": "c1bc8c8a-fd1b-396b-b0b7-07d7f94abd9a",
                                        "glosses": [
                                            "X-ray examination of the breasts for diagnosing and locating abnormalities, especially tumours."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53727e9e-2dc4-4061-925a-b0cedc7f36f0",
                                                "sense_id": "40161dba-a8cd-35b7-91ff-1a9e22bb3301",
                                                "text": "The introduction of mammography to detect breast cancer early in its course sharply increased its incidence."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e5cd8ee9-db3a-43f9-8023-7a37b35c8bb8",
                        "source_entry_id": "c3925db5-5184-38e5-90b4-ec08b7e2653a",
                        "source_sense_id": "c2d594a5-9ac0-3ce3-a570-2221542cb15d",
                        "target_lang_word": "mammographie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
