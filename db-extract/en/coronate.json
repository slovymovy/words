                        "examples": [
                            {
                                "example_id": "d87db19e-4102-439a-a46b-8e990e6dd1b8",
                                "sense_id": "6d131295-3b15-3c73-9bbf-83c31f9a94b1",
                                "text": "[…] and instead of Coronating your deserved Worth […]"
                            },
                            {
                                "example_id": "b16ff0ce-ea3a-446b-9155-3a5c9b4c5cf3",
                                "sense_id": "6d131295-3b15-3c73-9bbf-83c31f9a94b1",
                                "text": "The whole field of literature has freely surrendered its classic gems to coronate him the intellectual king."
                            },
                            {
                                "example_id": "2e2a695e-46f8-43c1-bcbd-a9b1db5cc5ac",
                                "sense_id": "6d131295-3b15-3c73-9bbf-83c31f9a94b1",
                                "text": "Tribals defy custom, bow to queen - Great Andamanese gear up to coronate first woman"
                            },
                            {
                                "example_id": "428d70b1-f92f-4d78-b59d-d489c451a4d3",
                                "sense_id": "6d131295-3b15-3c73-9bbf-83c31f9a94b1",
                                "text": "2023, USA Today\nOn a soggy London day in June 1953, a bright-eyed 27-year-old married mother named Elizabeth was coronated as queen of England."
                            }
                        ]
