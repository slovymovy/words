                "senses": [
                    {
                        "sense_id": "41b4395b-47e1-3823-9df8-3387d88df5b3",
                        "entry_id": "7a49f2f3-0b1f-31a0-b16d-f2ea6e7c96d8",
                        "glosses": [
                            "in German"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "03f13a1f-ab46-4765-90c3-f4986e8acae0",
                                "sense_id": "41b4395b-47e1-3823-9df8-3387d88df5b3",
                                "text": "Я говорю́ по-неме́цки",
                                "translation": "I speak German.",
                                "english": "I speak German."
                            },
                            {
                                "example_id": "3b2f2faa-1983-41ab-83ad-5d7179b494c2",
                                "sense_id": "41b4395b-47e1-3823-9df8-3387d88df5b3",
                                "text": "Э́то напи́сано по-неме́цки",
                                "translation": "This is written in German.",
                                "english": "This is written in German."
                            },
                            {
                                "example_id": "603451cc-42f3-4516-8f6f-06ba3427a0ef",
                                "sense_id": "41b4395b-47e1-3823-9df8-3387d88df5b3",
                                "text": "Мы то́тчас пола́дили, и хотя́ по контра́кту обя́зан он был учи́ть меня́ по-францу́зски, по-неме́цки и всем нау́кам, но он предпочё́л на́скоро вы́учиться от меня́ ко́е-ка́к болта́ть по-ру́сски, — и пото́м ка́ждый из нас занима́лся уже́ свои́м де́лом.",
                                "translation": "He and I got on very well, and although he bound himself by his agreement to teach me French, German, and all the sciences, he found it more advantageous to himself to pick up from me, after a fashion, a smattering of Russian, after which lesson, each of us went his way.",
                                "english": "He and I got on very well, and although he bound himself by his agreement to teach me French, German, and all the sciences, he found it more advantageous to himself to pick up from me, after a fashion, a smattering of Russian, after which lesson, each of us went his way."
                            },
                            {
                                "example_id": "10d46b50-34a7-41bc-ab0a-24d9710b4097",
                                "sense_id": "41b4395b-47e1-3823-9df8-3387d88df5b3",
                                "text": "— Шу́рочка, как перевести́ по-неме́цки — сопе́рник? — спроси́л Никола́ев, подыма́я го́лову от кни́ги.",
                                "translation": "“Shurochka, how do you say ‘opponent’ in German?” Nikolaev asked, raising his head from his books.",
                                "english": "“Shurochka, how do you say ‘opponent’ in German?” Nikolaev asked, raising his head from his books."
                            }
                        ]
                    }
                ],
