                                "example_id": "6cd09d56-0995-436d-992f-987640f28f2d",
                                "sense_id": "190cfecf-d42c-3739-96cc-be8ef0ec2b17",
                                "text": "De belangstelling voor de provinciale opkoopregeling van kalverhouderijen op de Veluwe is veel groter dan verwacht."
                            }
                        ]
                    }
