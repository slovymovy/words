                                                "example_id": "b3c7c612-febd-4f01-9a3f-aa249ac840b9",
                                                "sense_id": "54e922d0-9534-34f5-adda-b70ad3d33b07",
                                                "text": "imperialismo da mídia, o quarto poder"
                                            },
                                            {
                                                "example_id": "15b2fb63-19f3-4287-8ad6-17e65d01ab93",
                                                "sense_id": "54e922d0-9534-34f5-adda-b70ad3d33b07",
                                                "text": "o imperialismo de uma escola filosófica"
                                            }
