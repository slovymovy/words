                        "entry_id": "b5b224c4-d428-3a8c-948f-aca06ff1a211",
                        "glosses": [
                            "honorowe wyróżnienie w formie emblematu: odznaki, medalu, krzyża lub gwiazdy, przyznawane komuś za wybitny czyn lub osiągnięcia – przez władze, dowództwo wojskowe lub instytucję"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25777605-235a-49b1-bd33-161c0a48fb59",
                                "sense_id": "fa9b6090-4021-3191-a8cd-99a1efdf4267",
                                "text": "Z wojny dziadek wrócił do domu w dziurawych butach, ale z całą serią odznaczeń."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
