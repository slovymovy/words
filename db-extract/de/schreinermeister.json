                "senses": [
                    {
                        "sense_id": "849ea461-5369-3202-a066-2e1f9a3d2dc3",
                        "entry_id": "57ed5eea-842b-31f9-9325-5c4c36754ac1",
                        "glosses": [
                            "Person, die den Meistertitel im Schreinerhandwerk hat"
                        ],
                        "tags": [
                            "Handwerk"
                        ],
                        "examples": [
                            {
                                "example_id": "4b026f52-3842-44cc-b21c-7378c07140a1",
                                "sense_id": "849ea461-5369-3202-a066-2e1f9a3d2dc3",
                                "text": "„Ihr Vater, Schreinermeister und Kunsttischler, zählte zu den Honoratioren des Kleinstädtchens.“"
                            },
                            {
                                "example_id": "78eb64f9-5beb-4243-83d4-d28bdb14f94f",
                                "sense_id": "849ea461-5369-3202-a066-2e1f9a3d2dc3",
                                "text": "„Wir fuhren durch München hindurch in Richtung Norden, und unser Schreinermeister wurde immer stiller und ängstlicher.“"
                            },
                            {
                                "example_id": "6ac69a8e-a3e6-4e33-8297-afe69d68b665",
                                "sense_id": "849ea461-5369-3202-a066-2e1f9a3d2dc3",
                                "text": "„Ihr Vater war Schreinermeister, und Fried hatte im letzten Teil der Ausbildung in seiner Werkstatt gearbeitet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
