                        "form": "den Aschenbrenner"
                    },
                    {
                        "form_id": "07cf58bf-4eae-4ec3-81a8-d5aceefac8a9",
                        "entry_id": "7e72081d-b333-34af-b4f8-076bd4dcbd43",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Aschenbrenner"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9b7c9cf6-f1f1-365f-b755-85cbeef3df1e",
                        "entry_id": "7e72081d-b333-34af-b4f8-076bd4dcbd43",
                        "glosses": [
                            "Handwerker, der durch Auslaugen mit Wasser und Sieden aus Holzasche Pottasche (Kaliumkarbonat) gewann, die für Glashütten, Seifensiedereien und Schmelzwerke benötigt wurde."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "be163526-eabb-4bd9-9521-00dc5a9e707a",
                                "sense_id": "9b7c9cf6-f1f1-365f-b755-85cbeef3df1e",
                                "text": "„Die Aschenbrenner kauften liegende Hölzer oder Abständer in unwegsamen Lagen, Schluchten und dergleichen und erzeugten daraus den Rohstoff.“"
                            },
                            {
                                "example_id": "bca544da-24db-4f36-928d-3558c5e0f82e",
                                "sense_id": "9b7c9cf6-f1f1-365f-b755-85cbeef3df1e",
                                "text": "„Ihre Stellung ist nicht anders als die der übrigen Hilfsarbeiter: der Holzhauer, Aschenbrenner, Aschensammler.“"
                            },
                            {
                                "example_id": "a5322100-b5d6-459f-95a2-1d0e3022febb",
                                "sense_id": "9b7c9cf6-f1f1-365f-b755-85cbeef3df1e",
                                "text": "„Die Meiler der Kohlenbrenner lagen auf Lichtungen oder Schneisen im Wald wie die Betriebsstätten der Teerbrenner und Aschenbrenner.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
