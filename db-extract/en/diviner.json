                            "One who divines or conjectures."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "80399770-9c3c-3eb0-9349-51a4c4878801",
                        "entry_id": "246d26c1-557f-3706-97f3-725e6bc691d5",
                        "glosses": [
