    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d38b45f5-c719-3d3c-be8a-88f6606cd161",
                    "sense_definition": "Past tense and past participle of <w>misplace</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "grammatical_form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I have <w>misplaced</w> my car keys and now I cannot find them anywhere.",
                            "target_lang_translations": {
                                "ru": "Я <w>положил не на место</w> ключи от машины и теперь нигде не могу их найти."
                            }
                        },
                        {
                            "text": "She <w>misplaced</w> her phone yesterday but luckily her sister found it in the kitchen.",
                            "target_lang_translations": {
                                "ru": "Вчера она <w>затеряла</w> свой телефон, но, к счастью, ее сестра нашла его на кухне."
                            }
                        }
                    ],
                    "synonyms": [
                        "lost"
                    ],
                    "antonyms": [
                        "found"
                    ],
                    "common_phrases": [
                        "misplaced keys",
                        "misplaced trust",
                        "misplaced confidence"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and past participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие прошедшего времени от глагола misplace (положить не на место)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "положил не на место",
                                "target_lang_sense_clarification": "о предмете"
                            },
                            {
                                "target_lang_word": "затерял",
                                "target_lang_sense_clarification": "случайно потерял среди вещей"
                            },
                            {
                                "target_lang_word": "потерял",
                                "target_lang_sense_clarification": "в значении временной утраты"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "b207a194-186c-3d6d-88e6-7330204b4587",
                    "sense_definition": "Put in the wrong place or temporarily lost.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "lost_items",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>misplaced</w> documents were eventually found at the bottom of the drawer.",
                            "target_lang_translations": {
                                "ru": "<w>Затерявшиеся</w> документы в конце концов нашлись на дне ящика."
                            }
                        },
                        {
                            "text": "He spent an hour searching for his <w>misplaced</w> glasses before realizing they were on his head.",
                            "target_lang_translations": {
                                "ru": "Он потратил час на поиски своих <w>пропавших</w> очков, прежде чем понял, что они у него на голове."
                            }
                        }
                    ],
                    "synonyms": [
                        "lost",
                        "missing"
                    ],
                    "antonyms": [
                        "located"
                    ],
                    "common_phrases": [
                        "misplaced items",
                        "misplaced file"
                    ],
                    "target_lang_definitions": {
                        "ru": "Положенный не на то место или временно потерянный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "затерявшийся",
                                "target_lang_sense_clarification": "о вещах"
                            },
                            {
                                "target_lang_word": "положенный не на место",
                                "target_lang_sense_clarification": "о предметах"
                            },
                            {
                                "target_lang_word": "пропавший",
                                "target_lang_sense_clarification": "временно отсутствующий"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "83ae742f-97d9-3f39-baa0-b091fd224519",
                    "sense_definition": "Feeling uncomfortable or out of place in a particular environment or social situation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emotional_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I felt completely <w>misplaced</w> at the formal gala because I was wearing casual clothes.",
                            "target_lang_translations": {
                                "ru": "Я чувствовал себя совершенно <w>не на своем месте</w> на торжественном приеме, потому что был в повседневной одежде."
                            }
                        },
                        {
                            "text": "Being the only scientist in a room full of artists made him feel slightly <w>misplaced</w>.",
                            "target_lang_translations": {
                                "ru": "Будучи единственным ученым в комнате, полной художников, он чувствовал себя немного <w>лишним</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "out of place",
                        "uncomfortable"
                    ],
                    "antonyms": [
                        "at home",
                        "comfortable"
                    ],
                    "common_phrases": [
                        "felt misplaced"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чувство дискомфорта или ощущение того, что человек находится не на своем месте в определенной обстановке или социальной ситуации."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "не на своем месте",
                                "target_lang_sense_clarification": "ощущение неуместности"
                            },
                            {
                                "target_lang_word": "лишний",
                                "target_lang_sense_clarification": "чувствующий себя чужим"
                            },
                            {
                                "target_lang_word": "неуместный",
                                "target_lang_sense_clarification": "о человеке или чувстве"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}