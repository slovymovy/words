    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "29aa8d5d-3888-34ec-9a2d-6b09c9242e92",
                "word": "agrology",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "60c04fe7-5e24-330b-adcc-1718094241ae",
                        "entry_id": "29aa8d5d-3888-34ec-9a2d-6b09c9242e92",
                        "glosses": [
                            "A subdiscipline of agronomy (the science of utilizing animals, plants, and soils) and of soil science which addresses the influence of edaphic (soil-related) conditions on crop production for optimizing it."
                        ],
                        "tags": [
                            "rare",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "ff98f7a3-0c3f-4cf9-9b49-4a2f9be55c5e",
                                "sense_id": "60c04fe7-5e24-330b-adcc-1718094241ae",
                                "text": "Earth.—We have to examine its nature in connection with its products; this is the object of a technologic science, derived from mineralogy, and to which we give the name Agrology."
                            },
                            {
                                "example_id": "d0096e59-88a0-4def-a3a7-d05b611702b0",
                                "sense_id": "60c04fe7-5e24-330b-adcc-1718094241ae",
                                "text": "The subject of agriculture will in this school be considered under (1) agrology, or the study of the surface of the earth as to its origin, composition, and physical and chemical properties, […]"
                            },
                            {
                                "example_id": "6f9c2919-f5fa-4c1f-ace1-4b718287f11e",
                                "sense_id": "60c04fe7-5e24-330b-adcc-1718094241ae",
                                "text": "The future of civilization, and of the human race, will be largely determined by the agrology of the present and the immediate future."
                            },
                            {
                                "example_id": "e4c25ba0-73a4-43f3-89e8-cb340aada2e1",
                                "sense_id": "60c04fe7-5e24-330b-adcc-1718094241ae",
                                "text": "The Director of the ENA Marte R. Gómez-Segura […] reconstructed the school, and in 1923 invited Alfonso González-Gallardo, who was then recognized as one of the \"fathers\" of Mexican soil science for the development of agrology. […] The first agrology college was inaugurated in Villa de Meoqui, Chihuahua, in 1928."
                            }
                        ]
                    },
                    {
                        "sense_id": "379e20bf-6c12-3017-be82-ae4ebcb16af5",
                        "entry_id": "29aa8d5d-3888-34ec-9a2d-6b09c9242e92",
                        "glosses": [
                            "The science and art of agriculture."
                        ],
                        "tags": [
                            "Canada",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "e039700e-0321-4c41-9136-b31914e7d0b0",
                                "sense_id": "379e20bf-6c12-3017-be82-ae4ebcb16af5",
                                "text": "Viewed in this light, agrology possesses a three-way interest, between the member, the agricultural industry and society."
                            },
                            {
                                "example_id": "37da61ba-79ed-4633-9a83-07310aa9f2e7",
                                "sense_id": "379e20bf-6c12-3017-be82-ae4ebcb16af5",
                                "text": "It is appreciated that had these organizations not existed, comparable progress to advance the status of professional agrology would not have been made."
                            },
                            {
                                "example_id": "70a60099-9682-4104-a2f5-d28a32c92fc8",
                                "sense_id": "379e20bf-6c12-3017-be82-ae4ebcb16af5",
                                "text": "Agrologists know that the science of agrology is a key science in resource conservation, […]"
                            },
                            {
                                "example_id": "208e2d21-1a25-464d-8739-cc468263cfc0",
                                "sense_id": "379e20bf-6c12-3017-be82-ae4ebcb16af5",
                                "text": "Although excluded from the Ontario study group, [Chris] Cutler, [Cynthia] Scott-Dupree, and David Drexler, an agrology consultant, published an analysis of all bee-kill incidents reported in Canada from 2007–2012."
                            }
                        ]
                    }
                ],
