                "senses": [
                    {
                        "sense_id": "c7bc309a-c4ec-3fc7-9af8-2378ce7734c5",
                        "entry_id": "cd36fa4a-a89a-3bdc-baac-2d8761d7ead4",
                        "glosses": [
                            "eine in der Seeschiffahrt tätige Frau"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a12b08d-c388-4390-819c-c40ff1b07894",
                                "sense_id": "c7bc309a-c4ec-3fc7-9af8-2378ce7734c5",
                                "text": "„ Mit einer Spende von fünf Euro kauft die Seemannsmission eine Telefonkarte zum selben Wert und verschenkt diese an einen Seemann oder eine Seefrau für ein Gespräch mit den Lieben Zuhause.“"
                            }
                        ],
