                        "entry_id": "deb8f40e-f2df-3b2f-91c7-3ab46c4cec16",
                        "glosses": [
                            "D’un jaune à reflets dorés."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "0496f6e3-e751-4f2a-89ae-e1afba9b7e6c",
                                "sense_id": "b2e3c337-e2c4-39c7-a6e0-e675257b76e6",
                                "text": "D'innombrables faisceaux inondaient le passage, lui séchaient les joues et consolaient son cœur, comme un lacis auréolin de rayons chaleureux."
                            },
                            {
                                "example_id": "4e8652b0-de0a-496e-8f74-69ced0053b1d",
                                "sense_id": "b2e3c337-e2c4-39c7-a6e0-e675257b76e6",
                                "text": "Au petit matin, fraîcheur du soleil, les feuilles seront vermeilles. Sur le ciel azurin, la lune semble aurore. Et le champ auréolin, tirerait presque sur l’or."
                            }
                        ]
                    }
