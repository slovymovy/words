                "senses": [
                    {
                        "sense_id": "eec327d7-ed3d-32ca-8fe0-a23a7590a505",
                        "entry_id": "c27a533a-600e-369e-8fb5-96e0cfe15643",
                        "glosses": [
                            "schraubenförmig gewundenes Werkzeug des Bergmanns zum Hochholen abgerissener Seile in Tiefbohrlöchern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c35cd4c1-88af-475c-ba22-16401ee262a4",
                                "sense_id": "eec327d7-ed3d-32ca-8fe0-a23a7590a505",
                                "text": "„Dabei häuft sich im Bohrloche ein feiner Staub, das Bohrmehl, an, welches der Arbeiter von Zeit zu Zeit mit dem Krätzer heraus zieht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "7bdc934d-0138-32b8-a8ac-98e398258a28",
                        "entry_id": "c27a533a-600e-369e-8fb5-96e0cfe15643",
                        "glosses": [
                            "in Gärung übergehender Most (auch: Kretzer)"
                        ],
                        "tags": [
                            "Lebensmittel"
                        ],
                        "examples": [
                            {
                                "example_id": "a078692b-f1a2-4057-8afd-ae3f8c2b909e",
                                "sense_id": "7bdc934d-0138-32b8-a8ac-98e398258a28",
                                "text": "„Der »Vorlauf«, der erste Saft, der mit den Füßen ausgestampft wurde, wie auch der Krätzer, der für Salzlake bestimmte saure Wein, wurde möglichst verkauft.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "373d45bc-2102-357f-b321-799b163c5c33",
                        "entry_id": "c27a533a-600e-369e-8fb5-96e0cfe15643",
                        "glosses": [
                            "Flussbarsch (der durch Aufrichten der Knochenstacheln in der Rückenflosse kratzt, wenn man ihn festhält)"
                        ],
                        "tags": [
                            "mundartlich"
                        ],
                        "examples": [
                            {
                                "example_id": "81c9d7de-9b62-42f5-917c-6187ccf5ef98",
                                "sense_id": "373d45bc-2102-357f-b321-799b163c5c33",
                                "text": "„An die Stelle der Groppe als Speisefisch ist dagegen der Krätzer (Barsch) getreten.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
