    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "31a013a6-c63c-37eb-8d2d-7f2d99ca8aec",
                    "sense_definition": "Something physical that is owned.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "objects",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Make sure you take all your <w>belongings</w> when you leave.",
                            "target_lang_translations": {
                                "ru": "Убедитесь, что вы забрали все свои <w>вещи</w>, когда будете уходить.",
                                "fr": "Assurez-vous de prendre toutes vos <w>affaires</w> avant de partir."
                            }
                        },
                        {
                            "text": "She packed her few personal <w>belongings</w> into a small bag.",
                            "target_lang_translations": {
                                "ru": "Она упаковала свои немногочисленные личные <w>вещи</w> в маленькую сумку.",
                                "fr": "Elle a emballé ses quelques <w>affaires</w> personnelles dans un petit sac."
                            }
                        }
                    ],
                    "synonyms": [
                        "possession",
                        "thing",
                        "property",
                        "item"
                    ],
                    "common_phrases": [
                        "personal belongings",
                        "pack belongings",
                        "leave belongings"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "usually plural"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Материальные предметы или имущество, которыми владеет человек.",
                        "fr": "Objets personnels ou biens matériels appartenant à quelqu'un."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вещи",
                                "target_lang_sense_clarification": "личные предметы"
                            },
                            {
                                "target_lang_word": "имущество",
                                "target_lang_sense_clarification": "собственность, владения"
                            },
                            {
                                "target_lang_word": "со́бственность",
                                "target_lang_sense_clarification": "то, чем владеют"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "affaires",
                                "target_lang_sense_clarification": "effets personnels"
                            },
                            {
                                "target_lang_word": "biens",
                                "target_lang_sense_clarification": "propriétés ou possessions matérielles"
                            },
                            {
                                "target_lang_word": "possession",
                                "target_lang_sense_clarification": "ce que l'on possède"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "544ff6d6-70e6-3053-b9c4-1c1a1536ec15",
                    "sense_definition": "The feeling that one belongs.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "feeling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A need for <w>belonging</w> seems fundamental to humans.",
                            "target_lang_translations": {
                                "ru": "Потребность в чувстве <w>принадлежности</w> кажется фундаментальной для людей.",
                                "fr": "Le besoin d'<w>appartenance</w> semble fondamental chez les humains."
                            }
                        },
                        {
                            "text": "He finally found a sense of <w>belonging</w> with his new group of friends.",
                            "target_lang_translations": {
                                "ru": "Он наконец обрел чувство <w>принадлежности</w> в своей новой компании друзей.",
                                "fr": "Il a finalement trouvé un sentiment d'<w>appartenance</w> avec son nouveau groupe d'amis."
                            }
                        }
                    ],
                    "common_phrases": [
                        "sense of belonging",
                        "feeling of belonging",
                        "need for belonging"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чувство того, что человек является принятым членом группы или коллектива; ощущение общности.",
                        "fr": "Sentiment d'être intégré et accepté au sein d'un groupe ou d'une communauté."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "принадле́жность",
                                "target_lang_sense_clarification": "членство в группе, общность"
                            },
                            {
                                "target_lang_word": "причастность",
                                "target_lang_sense_clarification": "чувство связи с чем-либо"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "appartenance",
                                "target_lang_sense_clarification": "fait de faire partie d'un groupe"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c9b32133-28f9-3e05-a2a5-e24d76671a77",
                    "sense_definition": "Family; relations; household.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "people",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The verandah was filled silently by the forms of his female <w>belongings</w>.",
                            "target_lang_translations": {
                                "ru": "Веранда была безмолвно заполнена фигурами его <w>домочадцев</w> женского пола.",
                                "fr": "La véranda était silencieusement remplie par les silhouettes de ses <w>proches</w> féminines."
                            }
                        },
                        {
                            "text": "He traveled with all his <w>belongings</w>, including his distant relatives.",
                            "target_lang_translations": {
                                "ru": "Он путешествовал со всей своей <w>роднёй</w>, включая дальних родственников.",
                                "fr": "Il voyageait avec tous ses <w>proches</w>, y compris ses parents éloignés."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Семья, родственники или люди, живущие в одном доме (устаревшее значение).",
                        "fr": "Famille, proches ou membres d'un foyer (usage vieilli)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "родня",
                                "target_lang_sense_clarification": "родственники"
                            },
                            {
                                "target_lang_word": "домочадцы",
                                "target_lang_sense_clarification": "члены семьи, живущие вместе"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "famille",
                                "target_lang_sense_clarification": "ensemble des proches"
                            },
                            {
                                "target_lang_word": "proches",
                                "target_lang_sense_clarification": "personnes liées par le sang ou la vie commune"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "03b1c8b7-cdde-37e7-9d13-6116d96825fe",
                    "sense_definition": "Present participle and gerund of <w>belong</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The car <w>belonging</w> to my neighbor is parked outside.",
                            "target_lang_translations": {
                                "ru": "Машина, <w>принадлежащая</w> моему соседу, припаркована снаружи.",
                                "fr": "La voiture <w>appartenant</w> à mon voisin est garée dehors."
                            }
                        },
                        {
                            "text": "Any items <w>belonging</w> to the library must be returned by Friday.",
                            "target_lang_translations": {
                                "ru": "Любые предметы, <w>принадлежащие</w> библиотеке, должны быть возвращены к пятнице.",
                                "fr": "Tout objet <w>appartenant</w> à la bibliothèque doit être rendu avant vendredi."
                            }
                        }
                    ],
                    "common_phrases": [
                        "belonging to"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Действительное причастие настоящего времени от глагола belong (принадлежать).",
                        "fr": "Participe présent du verbe appartenir, indiquant la possession ou le lien."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "принадлежащий",
                                "target_lang_sense_clarification": "относящийся к кому-либо"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "appartenant",
                                "target_lang_sense_clarification": "qui est la propriété de"
                            }
                        ]
                    }
                }
            ]
        }
