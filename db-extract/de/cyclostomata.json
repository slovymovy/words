                "senses": [
                    {
                        "sense_id": "034ea97e-3131-317b-8f15-1e131f938a03",
                        "entry_id": "6b3b026e-749c-33f4-ac4c-32ca740c2f81",
                        "glosses": [
                            "die wohl ursprünglichste Klasse der Wirbeltiere, die durch einen Saugmund und durch das Fehlen echte Kiefer charakterisiert ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "212d19ea-a9ce-4c86-98e7-f8331c3a0acc",
                                "sense_id": "034ea97e-3131-317b-8f15-1e131f938a03",
                                "text": "„In unserer Fauna leben noch einige Arten, die mit den Agnathi verwandt sind: die Cyclostomata. Zu ihnen zählen die Neunaugen unserer Flüsse und des Meeres […] sowie die Schleimfische.“"
                            },
                            {
                                "example_id": "1017e05a-e132-443b-8df7-507777d17b33",
                                "sense_id": "034ea97e-3131-317b-8f15-1e131f938a03",
                                "text": "Die Klasse der Cyclostomata besteht aus circa 44 rezenten Arten."
                            },
                            {
                                "example_id": "03ce596c-9e3c-494e-91df-c5a15b22e898",
                                "sense_id": "034ea97e-3131-317b-8f15-1e131f938a03",
                                "text": "Die Cyclostomata repräsentieren wohl die ursprünglichste Klasse der Wirbeltiere."
                            }
                        ],
