                                "target_senses": [
                                    {
                                        "sense_id": "c2429970-0319-3755-b216-45db534e135a",
                                        "entry_id": "fa89fc44-11e2-3dce-8629-137adc9f68e0",
                                        "glosses": [
                                            "Feu de forêt."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b79826b8-feed-4706-b341-d02b6d59ad08",
                                                "sense_id": "c2429970-0319-3755-b216-45db534e135a",
                                                "text": "Au cours des dernières années, entre 30 000 et 40 000 incendies de forêt se sont déclarés chaque année en Europe, ravageant 500 000 hectares, voire davantage."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "76738fa8-a9d4-4cbb-9e1f-ed9e4f20a981",
                        "source_entry_id": "7bf672a6-6532-3e4f-a693-03ca5d4fa6e6",
                        "source_sense_description": "rapidly spreading fire",
                        "target_lang_word": "Lauffeuer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lauffeuer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dd8e9070-d2ab-3117-9e82-4fa8f3d37f6f",
                                        "entry_id": "18ade80a-52a6-38fd-834d-adf0937d10c9",
                                        "glosses": [
                                            "Brand, der sich am Boden entlang flächenhaft oder linienhaft ausbreitet"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c6297952-5a66-483e-8176-b374f11386c8",
                                                "sense_id": "dd8e9070-d2ab-3117-9e82-4fa8f3d37f6f",
                                                "text": "Die in der Natur häufig vorkommenden Lauffeuer sind für die Ökosysteme weit weniger schädlich als Wipfelfeuer."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d85b7e8f-5776-3b9c-938d-615111dba49e",
                                        "entry_id": "18ade80a-52a6-38fd-834d-adf0937d10c9",
                                        "glosses": [
                                            "Strategie, bei dem in einer Reihe stehende Soldaten nacheinander schießen"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "41dba69f-d983-4386-98b7-fbd3f31ccdff",
                                                "sense_id": "d85b7e8f-5776-3b9c-938d-615111dba49e",
                                                "text": "„Als i. J. 1619 Kaiser Ferdinand II. auf seiner Reise nach Frankfurt den Churfürsten in München besucht hatte, rückte das Bürger Militär dieser Stadt mit vier Fähnlein 14oo, und bei seiner Zurückkunft 3ooo Mann stark in Parade aus, und gab dabei Dechargen und Lauffeuer.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "67c8700c-5ab1-3ee0-b1ae-c07363a74eef",
                                        "entry_id": "18ade80a-52a6-38fd-834d-adf0937d10c9",
                                        "glosses": [
                                            "siehe wie ein Lauffeuer"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "964c5b38-c962-4a8d-bcde-8bf9d9e8a9e0",
                                                "sense_id": "67c8700c-5ab1-3ee0-b1ae-c07363a74eef",
                                                "text": "„Die Nachricht von der britischen Kriegserklärung sorgte nicht nur in Berlin für Aufsehen und heftige Reaktionen, sie erreichte wie ein Lauffeuer rasch die letzten Winkel des Reiches.“"
                                            },
                                            {
                                                "example_id": "e6a91f68-13ed-40da-aa37-226f090508af",
                                                "sense_id": "67c8700c-5ab1-3ee0-b1ae-c07363a74eef",
                                                "text": "„Bei einem Protest gegen Polizeigewalt in den USA stellt sich eine Frau der Polizei entgegen. Das Foto verbreitet sich wie ein Lauffeuer.“"
                                            },
                                            {
                                                "example_id": "98337bc4-dfd9-4a9e-8a94-7d6754cd88e4",
                                                "sense_id": "67c8700c-5ab1-3ee0-b1ae-c07363a74eef",
                                                "text": "Im Zeitalter der neuen Medien, wo falsche Nachrichten sich wie ein Lauffeuer verbreiten, braucht man ein kritisches Bewusstsein."
                                            },
                                            {
                                                "example_id": "17ccf19d-94a1-4701-9a95-08e38f47ef15",
                                                "sense_id": "67c8700c-5ab1-3ee0-b1ae-c07363a74eef",
                                                "text": "„Denn natürlich hatte sich die Nachricht von meiner Abreise im Dorf wie ein Lauffeuer verbreitet.“"
                                            },
                                            {
                                                "example_id": "408d0225-955e-4306-b048-7e72b3f8e794",
                                                "sense_id": "67c8700c-5ab1-3ee0-b1ae-c07363a74eef",
                                                "text": "„Mit ihrem Sprung am Gummiseil war das Bungee-Jumping in Neuseeland geboren und verbreitete sich wie ein Lauffeuer auf der ganzen Welt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3b0d1999-7381-44d7-90da-0556d566b24c",
                        "source_entry_id": "7bf672a6-6532-3e4f-a693-03ca5d4fa6e6",
                        "source_sense_description": "rapidly spreading fire",
                        "target_lang_word": "Waldbrand",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Waldbrand",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a3428555-41b6-33f7-918e-1b045894d848",
                                        "entry_id": "c2a83071-02cb-3bad-bb0b-e5b4d11c9938",
                                        "glosses": [
                                            "in einem Wald um sich greifendes Feuer größeren (zumeist vernichtenden) Ausmaßes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4fce6b89-bcf0-4eaa-95df-a02812a66dea",
                                                "sense_id": "a3428555-41b6-33f7-918e-1b045894d848",
                                                "text": "„Im Unterschied zu den vergangenen Jahren sind Brandenburgs Forste bislang von größeren Waldbränden weitgehend verschont. 164 überwiegend kleinere Waldbrände auf einer Gesamtfläche von 44 Hektar registrierte das Umweltministerium in der ersten Jahreshälfte.“"
                                            },
                                            {
                                                "example_id": "56bc4987-587e-4924-8536-5e3922944ba1",
                                                "sense_id": "a3428555-41b6-33f7-918e-1b045894d848",
                                                "text": "„In dieser Gegend, in der seit drei Jahren Trockenheit herrscht und riesige Waldbrände wüten, mischen sich Katastrophenangst und Technikvertrauen.“"
                                            },
                                            {
                                                "example_id": "1d059ec8-e6fa-49e5-870a-4136608f4622",
                                                "sense_id": "a3428555-41b6-33f7-918e-1b045894d848",
                                                "text": "„Ein Waldbrand, der am Mittwoch im Militärlager Carpiagne - auf halber Strecke zwischen Cassis und Marseille - ausbrach und zwei Nächte und einen Tag lang wütete: 1.100 Hektar Heideland und Pinienwald sowie mehrere Häuser und Hütten wurden zerstört. “"
                                            },
                                            {
                                                "example_id": "df0bcc32-a511-42e0-8006-9385b6a67460",
                                                "sense_id": "a3428555-41b6-33f7-918e-1b045894d848",
                                                "text": "„Die Feuerwehr hat die nördlich der griechischen Hauptstadt Athen tobenden Waldbrände auch am Sonntagmorgen noch nicht unter Kontrolle gebracht.“"
                                            },
                                            {
                                                "example_id": "e7f87421-b025-4b48-a345-518862721369",
                                                "sense_id": "a3428555-41b6-33f7-918e-1b045894d848",
                                                "text": "„Waldbrände gehören in westlichen Regionen der USA und Kanadas mittlerweile zum Alltag. Jahr um Jahr brennen dort Millionen von Quadratkilometern an Waldgebiet.“"
                                            },
                                            {
                                                "example_id": "b07dcdd1-a8f7-43e4-bc24-0afa487c7b8d",
                                                "sense_id": "a3428555-41b6-33f7-918e-1b045894d848",
                                                "text": "„In der Gemeinde Seillans zwischen Fayence und Draguignan hat sich am Montag ein Waldbrand entfacht und etwa 10 Hektar Wald vernichtet.“"
                                            },
                                            {
                                                "example_id": "7b9c5aa5-646c-47b2-9ee4-1b71bbb087b0",
                                                "sense_id": "a3428555-41b6-33f7-918e-1b045894d848",
                                                "text": "„Waldbrände entstehen unter natürlichen Bedingungen durch Blitzschlag, vulkanische Aktivitäten und Selbstentzündung.[…]Weitere Ursachen für Waldbrand in Deutschland sind vor allem:",
                                                "translation": "* Militärübungen[…]“"
                                            },
                                            {
                                                "example_id": "957d7f48-bc9b-4b24-b943-13044fde50ee",
                                                "sense_id": "a3428555-41b6-33f7-918e-1b045894d848",
                                                "text": "„Bei Linienflügen von Frankfurt nach Santiago de Chile via São Paulo gelang es den Wissenschaftlern erstmalig Abluftfahnen von großflächigen Waldbränden mit erhöhten Quecksilberkonzentrationen zu beobachten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
