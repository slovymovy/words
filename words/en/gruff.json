        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e2dcd27c-eae9-36bb-8f06-aae148988b29",
                    "sense_definition": "to speak in a rough, harsh, or unfriendly tone",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "speaking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "“I don't have time for this,” he <w>gruffed</w> before walking out of the room.",
                            "target_lang_translations": {
                                "ru": "«У меня нет на это времени», — <w>буркнул</w> он, прежде чем выйти из комнаты.",
                                "cs": "„Na tohle nemám čas,“ <w>zabručel</w>, než odešel z místnosti."
                            }
                        },
                        {
                            "text": "The guard <w>gruffed</w> a short command to the visitors at the gate.",
                            "target_lang_translations": {
                                "ru": "Охранник <w>прохрипел</w> короткую команду посетителям у ворот.",
                                "cs": "Strážný <w>vyštěkl</w> krátký rozkaz na návštěvníky u brány."
                            }
                        }
                    ],
                    "synonyms": [
                        "growl",
                        "snap",
                        "bark"
                    ],
                    "target_lang_definitions": {
                        "ru": "говорить грубым, резким или неприветливым тоном",
                        "cs": "mluvit drsným, ostrým nebo nepřátelským tónem"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прохрипеть",
                                "target_lang_sense_clarification": "сказать хриплым голосом"
                            },
                            {
                                "target_lang_word": "буркнуть",
                                "target_lang_sense_clarification": "сказать резко и невнятно"
                            },
                            {
                                "target_lang_word": "рявкнуть",
                                "target_lang_sense_clarification": "сказать грубо и громко"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "zabručet",
                                "target_lang_sense_clarification": "říci něco drsně a nevrle"
