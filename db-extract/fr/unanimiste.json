                                                "example_id": "9669317e-da8b-4700-ab86-3a9f78106a1a",
                                                "sense_id": "75919518-6d56-39f2-b25c-731c41f9b16a",
                                                "text": "Die Politiker verurteilten einhellig den Raketentest."
                                            },
                                            {
                                                "example_id": "506bf951-3163-47c2-a5c7-675604687858",
                                                "sense_id": "75919518-6d56-39f2-b25c-731c41f9b16a",
                                                "text": "„Wie bekommen Sie eine einhelligere Betrachtungsweise im Sicherheitsrat hin, etwa bezogen auf das Nuklearprogramm Irans?“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
