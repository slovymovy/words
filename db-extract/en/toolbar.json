                        "source_entry_id": "8a42e135-fe5a-3059-b5a2-37370ba49bbd",
                        "source_sense_id": "a689cf24-cfd2-32ed-85d0-bc1e7125d9b6",
                        "source_sense_description": "row of icons in a graphical user interface",
                        "target_lang_word": "werkbalk",
