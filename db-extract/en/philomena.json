                        "glosses": [
                            "A female given name from Ancient Greek."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee733579-7f0d-4ea5-a2ad-7d278d35e7ec",
                                "sense_id": "86da566b-1432-32df-bae4-bd550f1bbbb4",
                                "text": "\"Why did St Philomena get crossed off, I wonder?\" asked Celia.\n\"I don't know, maybe they found her out,\" Tom grinned. \"I know my sister Phil was very annoyed at the time, she felt it was an attack of some sort.\""
                            }
                        ]
                    }
