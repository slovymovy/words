                                        "examples": [
                                            {
                                                "example_id": "a0f51a06-bcdb-4d69-8103-e28267bf80bb",
                                                "sense_id": "b084b902-9cc1-3e60-bdd0-4de74cbae9ca",
                                                "text": "Die VIPs hatten beim Zugang den Vorrang."
                                            },
                                            {
                                                "example_id": "0e3ed23c-479c-4940-addb-d7cf10fa5732",
                                                "sense_id": "b084b902-9cc1-3e60-bdd0-4de74cbae9ca",
                                                "text": "„Zu einem solchen Ziel gibt es zwar keine vernünftige Alternative, gleichwohl stellt sich die Frage, welche Interessen im Zweifel Vorrang haben.“"
                                            },
                                            {
                                                "example_id": "01b8cc12-8c58-413a-8793-355de576904a",
                                                "sense_id": "b084b902-9cc1-3e60-bdd0-4de74cbae9ca",
                                                "text": "„[…] der Vorrang der Politik gegenüber der Wirtschaft bleibt in einer ökonomisch entgrenzten Welt am ehesten im Rahmen der Nation gewahrt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e6c505f6-28ff-3c61-8d1a-a47263ce320d",
                                        "entry_id": "368aee0a-3528-3c7b-a307-9c61e55fe54e",
                                        "glosses": [
                                            "die Vorfahrt im Straßenverkehr, auch bei Fußgängern"
                                        ],
                                        "tags": [
                                            "besonders österreichisch"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dd399c2c-47ec-44eb-aa4b-21827b0fd38c",
                                                "sense_id": "e6c505f6-28ff-3c61-8d1a-a47263ce320d",
                                                "text": "Da der Wagen von der Vorrangstraße an der Kreuzung anhielt, hatte er somit auf den Vorrang verzichtet."
                                            },
                                            {
                                                "example_id": "8136a4cf-1552-4f76-af2a-c4ef28b5326b",
                                                "sense_id": "e6c505f6-28ff-3c61-8d1a-a47263ce320d",
                                                "text": "„Fahrzeuge, die von rechts kommen, haben, sofern die folgenden Absätze nichts anderes bestimmen, den Vorrang; Schienenfahrzeuge jedoch auch dann, wenn sie von links kommen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
