                        ],
                        "examples": [
                            {
                                "example_id": "b854395e-ade8-4855-99a8-bb4f2378aad4",
                                "sense_id": "6213a7f2-0116-3d14-bc71-b9e484f1c69f",
                                "text": "When the marriage act was mooted, Keith swore that he would revenge himself upon the bishops, by taking some acres of land for a burying-ground, and underburying them all."
                            },
                            {
                                "example_id": "2ce3b26d-3b03-468c-af6b-a17156a52ac9",
                                "sense_id": "6213a7f2-0116-3d14-bc71-b9e484f1c69f",
                                "text": "The identification of faults, or fractures along which there has been movement is especially desirable, inasmuch as fractures of this type extend more deeply than others, and usually constitute the channels for the upward circulation of the original mineralized hot waters, volcanic vapors. etc., from the underburied igneous magmas, and for the descent of the impoverishing and enriching surface waters."
                            },
                            {
                                "example_id": "8e40c8da-819b-446d-a844-e35c3b77ca65",
                                "sense_id": "6213a7f2-0116-3d14-bc71-b9e484f1c69f",
                                "text": "[...] he married sixty-one couples and, vowing eternal vengeance on bishops, bought several acres of land for burials, threatening to underbury them all."
                            }
                        ]
                    }
