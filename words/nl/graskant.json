    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "43befa1c-4b67-34a9-a8de-242ecae8bf9e",
                    "sense_definition": "de rand of kant van een grasveld of gazon",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "rand",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij gebruikt een speciale schaar om de <w>graskant</w> netjes recht af te snijden.",
                            "target_lang_translations": {
                                "ru": "Он использует специальные ножницы, чтобы аккуратно и ровно подрезать <w>кромку газона</w>."
                            }
                        },
                        {
                            "text": "Na het maaien van het gazon moeten we de <w>graskanten</w> nog bijknippen.",
                            "target_lang_translations": {
                                "ru": "После кошения газона нам нужно ещё подровнять <w>края газона</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "gazonrand",
                        "graskantje"
                    ],
                    "common_phrases": [
                        "de graskant afsteken",
                        "de graskant bijknippen"
                    ],
                    "target_lang_definitions": {
                        "ru": "край или граница травяного поля или газона"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кромка газона",
                                "target_lang_sense_clarification": "край подстриженного газона"
                            },
                            {
                                "target_lang_word": "край газона",
                                "target_lang_sense_clarification": "граница травяного участка"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d4153d52-c0a8-39ea-9166-2e4750606117",
                    "sense_definition": "een met gras begroeide walkant of oever langs een waterweg of sloot",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "oever",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De eenden rusten rustig uit in de zonnige <w>graskant</w> langs de sloot.",
                            "target_lang_translations": {
                                "ru": "Утки спокойно отдыхают на солнечном <w>травянистом берегу</w> вдоль канавы."
                            }
                        },
                        {
                            "text": "We wandelden urenlang langs de brede <w>graskant</w> van het kanaal.",
                            "target_lang_translations": {
                                "ru": "Мы часами гуляли вдоль широкого <w>травянистого берега</w> канала."
                            }
                        }
                    ],
                    "synonyms": [
                        "grasoever",
                        "walkant"
                    ],
                    "common_phrases": [
                        "in de graskant zitten",
                        "langs de graskant lopen"
                    ],
                    "target_lang_definitions": {
                        "ru": "поросший травой берег или обочина вдоль водоёма или канавы"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "травянистый берег",
                                "target_lang_sense_clarification": "берег, заросший травой"
                            },
                            {
                                "target_lang_word": "зелёный берег",
                                "target_lang_sense_clarification": "берег вдоль воды с растительностью"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}