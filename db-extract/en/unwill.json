                ],
                "senses": [
                    {
                        "sense_id": "8d8592f0-9275-3361-be77-49ca12babdba",
                        "entry_id": "a9750e29-ba2a-3484-9e3d-20fe10a0d250",
                        "glosses": [
                            "Lack or absence of will; willlessness; undesire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1610f7ca-87ce-4a69-8d36-0a07808ca86e",
                                "sense_id": "8d8592f0-9275-3361-be77-49ca12babdba",
                                "text": "Woe to him that shall be under His unwill!"
                            },
                            {
                                "example_id": "18333273-00d0-41cd-9f70-093b0c18d256",
                                "sense_id": "8d8592f0-9275-3361-be77-49ca12babdba",
                                "text": "They are major poets out of whak, twisted and balked by unwill."
                            },
                            {
                                "example_id": "7e980d04-462e-47be-883e-198d75a6d1c1",
                                "sense_id": "8d8592f0-9275-3361-be77-49ca12babdba",
                                "text": "The first challenge to shaping and taming this emerging world is the will itself and the human problem of unwill, especially in relation to femininity."
                            },
                            {
                                "example_id": "495cad7e-c7c9-49ac-a59b-2dc1bccc04d4",
                                "sense_id": "8d8592f0-9275-3361-be77-49ca12babdba",
                                "text": "If women are showing \"technological ineptitude\" and are \"disinclined towards technology\" by showing an \"unwill\" to co-operate technologically, does this merely indicate stupidity?"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
