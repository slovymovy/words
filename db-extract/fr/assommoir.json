                                        "entry_id": "8782e541-dc19-3d86-9acf-789c12ae0a79",
                                        "glosses": [
                                            "publieke drinkgelegenheid"
                                        ],
                                        "tags": [
                                            "horeca"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2b2d9a30-16f4-4653-a1e9-4224f0c381aa",
                                                "sense_id": "1808376e-d1f2-3805-b7da-5c6995345d35",
                                                "text": "Hij komt graag wat drinken in de kroeg."
                                            },
                                            {
                                                "example_id": "a4bc15c7-8371-43da-856d-c4abb1694331",
                                                "sense_id": "1808376e-d1f2-3805-b7da-5c6995345d35",
                                                "text": "Ik was totaal weggeregend in mijn tentje en had het hele weekend een beetje verloren en verveeld voor me uit zitten kijken in een kroeg."
                                            },
                                            {
                                                "example_id": "ae42b3f7-4faf-4f87-8a1a-89fc6ae631f9",
                                                "sense_id": "1808376e-d1f2-3805-b7da-5c6995345d35",
                                                "text": "Duizenden supporters waren voor de wedstrijd naar De Kuip in Rotterdam gereisd, maar ook in Deventer zelf werd het duel nauwlettend gevolgd. Op terrassen en in kroegen in de binnenstad zagen mensen op grote schermen hoe AZ na strafschoppen werd verslagen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
