                                        "entry_id": "a85cdab9-3f3a-3a4b-bd10-de6412256d77",
                                        "glosses": [
                                            "Entzündung der Bindehaut des Auges verbunden mit einer Rötung der Bindehaut"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c444fb6-2c15-41ef-a1ee-655ec4bbba94",
                                                "sense_id": "6139f70d-091a-3050-af15-26b6842e6687",
                                                "text": "Wegen seiner Bindehautentzündung ging er zum Arzt."
                                            },
                                            {
                                                "example_id": "c2f60224-fea4-44f8-a190-3fca9d8cc2ab",
                                                "sense_id": "6139f70d-091a-3050-af15-26b6842e6687",
                                                "text": "„Im Herbst wanderte Christa mit der Mutter zur wundertätigen Quelle nach Gränzendorf, das uranhaltige Wasser zu holen, das gegen Bindehautentzündung half.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
