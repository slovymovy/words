                                        "sense_id": "8632d984-ac2a-34f3-809b-0c201c55dfea",
                                        "entry_id": "cd392451-ad49-3ce4-a8af-8a337e2a997f",
                                        "glosses": [
                                            "griechischer Philosoph, der einer philosophischen Richtung oder Schule vor dem Auftreten von Sokrates angehörte"
                                        ],
                                        "tags": [
                                            "plural-normally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b84180cf-2ea3-44ff-b336-b7f374b655b1",
                                                "sense_id": "8632d984-ac2a-34f3-809b-0c201c55dfea",
                                                "text": "„Mit den Vorsokratikern begann etwa zwischen 600 und 400 v.Chr. die abendländische Philosophie.“"
                                            },
                                            {
                                                "example_id": "8648d81e-3e99-4e9f-a4cb-740023ba8760",
                                                "sense_id": "8632d984-ac2a-34f3-809b-0c201c55dfea",
                                                "text": "„Die Naturphilosophen werden oft auch als Vorsokratiker bezeichnet, da sie vor Sokrates gelebt haben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
