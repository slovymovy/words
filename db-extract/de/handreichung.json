                "senses": [
                    {
                        "sense_id": "ade2a3a6-345e-3e7d-a473-c7cebb2c26df",
                        "entry_id": "5a6e828b-886c-3b46-a81c-255112494fe8",
                        "glosses": [
                            "kleine Dienstleistung, Hilfestellung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1a66efc-bc0d-436d-aaa1-337ff65b7138",
                                "sense_id": "ade2a3a6-345e-3e7d-a473-c7cebb2c26df",
                                "text": "„Nixblume machte sich sofort in ihrer Nähe durch kleine Handreichungen zu schaffen, hielt ihr zum Haarglätten den Spiegel, besorgte Waschwasser und bediente sie auch sonst aufmerksam und fleißig.“"
                            },
                            {
                                "example_id": "d4d9a950-acad-49a5-8897-10b79641851c",
                                "sense_id": "ade2a3a6-345e-3e7d-a473-c7cebb2c26df",
                                "text": "„Nachdem das junge Mädchen eine kleine Handreichung gemacht hatte, fragte ich sie, wie es ihrer Schwester ginge.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "9f6fce80-83db-3f8c-b30c-d705e826f25c",
                        "entry_id": "5a6e828b-886c-3b46-a81c-255112494fe8",
                        "glosses": [
                            "schriftlich fixierte Anleitung, wie etwas zu verstehen/zu bewältigen ist"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "d5ee9cd1-c03c-3bcb-aa6f-b481fb09f9cb",
                        "entry_id": "5a6e828b-886c-3b46-a81c-255112494fe8",
