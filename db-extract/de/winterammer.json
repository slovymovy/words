                        "glosses": [
                            "amerikanischer Singvogel aus der Familie der Neuweltammern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b628229-d3c7-42a8-8199-48ebb6dceb3f",
                                "sense_id": "4d2f7bc8-79ad-396a-a641-3e77b2bd8866",
                                "text": "„Dann jedoch schwenken Krähen, Waldsänger, Meisen, Winterammern und Kernbeißer wie ein geeinter Schwarm synchron nach Osten, fliegen über das Ufer und den See davon, als wollten sie Jacob's Ladder in Richtung des Festlands verlassen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
