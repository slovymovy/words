                    {
                        "translation_id": "5063b099-e424-4ca4-989c-e55277ad3dfa",
                        "source_entry_id": "e776ca15-e554-360c-af02-285b20a0007d",
                        "source_sense_id": "f32cd475-013c-31a1-a512-cae377017b04",
