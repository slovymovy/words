                "senses": [
                    {
                        "sense_id": "df934cb5-33e4-3ed9-99d4-2f6a132723fe",
                        "entry_id": "171a60a3-f7ba-3a02-bc4d-9d46f0fc61bc",
                        "glosses": [
                            "een fijn, doorschijnend weefsel dat gemaakt kan zijn van linnen, wol, katoen, zijde of zelfs kunstzijde"
                        ],
                        "tags": [],
