                        "examples": [
                            {
                                "example_id": "3a3053d4-4604-41c3-b4ab-8b63fa07310d",
                                "sense_id": "a1ab6a2a-ab77-305f-bd4a-b79c46ca6b8d",
                                "text": "„Auch im Ausland ist Gaddafi umstritten. Als Verfechter der arabischen Einheit scheiterte er mit seinen Bemühungen um die Vereinigung Libyens mit den Staaten des Maschrik (Ägypten 1972-73, Syrien 1970 und 1980), den Staaten des Maghreb (Tunesien 1974, Marokko 1984), aber auch mit dem Sudan (1969 und 1985) und dem Tschad (1981).“"
                            }
                        ],
