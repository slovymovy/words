                ],
                "senses": [
                    {
                        "sense_id": "cbbbd84f-e9f6-37ae-a987-beb7f2754783",
                        "entry_id": "1f40986e-9aa4-36fb-ad6a-ed60c115501c",
                        "glosses": [
                            "Gebäude (= Stall), in dem Rinder gehalten werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "856b9da8-dd66-40e2-8e40-fb674dbb970f",
                                "sense_id": "cbbbd84f-e9f6-37ae-a987-beb7f2754783",
                                "text": "„Das anfallende Dinkelstroh soll dann später im neu gebauten Rinderstall verwendet werden.“"
                            },
                            {
                                "example_id": "4ffadc06-9aa3-4ba5-a85a-78d41e81b0fc",
                                "sense_id": "cbbbd84f-e9f6-37ae-a987-beb7f2754783",
                                "text": "„Eingebettet in die sanften Hänge des Buchserbergs befinden sich das Wohnhaus, die Käserei, zwei Rinder- und Kuhställe, ein Schweinestall sowie die Terrasse zur Gästebewirtung.“"
                            },
                            {
                                "example_id": "aada0f2c-627d-4fcc-aa01-750123b96f4a",
                                "sense_id": "cbbbd84f-e9f6-37ae-a987-beb7f2754783",
                                "text": "„Am Ortseingang von Brodowin steht ein Glaskubus mit Holzdach, die gläserne Meierei, nicht weit davon ein riesiger Rinderstall aus Holz für 185 Milchkühe, die frei im Stroh bedeckten Stall laufen, nicht in Boxen eingepfercht sind,“ […]."
                            },
                            {
                                "example_id": "6c033de9-c923-43b5-b42f-4a04f4e48bdf",
                                "sense_id": "cbbbd84f-e9f6-37ae-a987-beb7f2754783",
                                "text": "„Nachdem die Tierhaltung Anfang der 1950er Jahre wieder auf die Beine gekommen war, änderten sich die Alltagspraktiken im Rinderstall grundlegend.“"
                            },
                            {
                                "example_id": "353c75ed-6c67-4ae2-af3b-6f7608839dd8",
                                "sense_id": "cbbbd84f-e9f6-37ae-a987-beb7f2754783",
                                "text": "„Der Großbrand eines Rinderstalls in Niederoberbach (Landkreis Ansbach) hat einen Millionenschaden verursacht.“"
                            },
                            {
                                "example_id": "96378745-99ce-458d-a1b2-b902ad3db713",
                                "sense_id": "cbbbd84f-e9f6-37ae-a987-beb7f2754783",
                                "text": "„In Sottrum im Landkreis Rotenburg ist eine als Rinderstall genutzte alte Scheune komplett niedergebrannt.“"
                            },
                            {
                                "example_id": "a3dc2634-cba3-4c5a-b280-d9cfdcb8d4c3",
                                "sense_id": "cbbbd84f-e9f6-37ae-a987-beb7f2754783",
                                "text": "„Der Unternehmer Franz Bleßmann erwarb das Gut 1911 und ließ es nach dem Schema barocker Gutsanlagen umbauen. Unter anderem ließ er das bis heute erhaltene Herrenhaus, den Rinderstall und das markante Torhaus errichten.“"
                            },
                            {
                                "example_id": "b02cc156-8d52-40c5-a48b-894e96499e0f",
                                "sense_id": "cbbbd84f-e9f6-37ae-a987-beb7f2754783",
                                "text": "„Die Gesundheit wird nicht nur durch die Züchtung, sondern auch durch die Haltung gefördert. Die Rinderställe wurden immer wieder verbessert, um sich den Bedürfnissen der Kühe und Fleischrinder anzupassen.“"
                            },
                            {
                                "example_id": "5cdc65fa-068d-4be4-89c9-56d31093941b",
                                "sense_id": "cbbbd84f-e9f6-37ae-a987-beb7f2754783",
                                "text": "„Rinderställe können gut gegen Allergien sein, wie Wiener Forscherinnen herausgefunden haben. Sie stießen dort auf ein spezielles Protein, das zur Vorbeugung, aber auch zur Symptombekämpfung bei allergischen Reaktionen hilft.“"
                            },
                            {
                                "example_id": "4b5bed3e-91bd-488a-9cfa-c24f0b528a88",
                                "sense_id": "cbbbd84f-e9f6-37ae-a987-beb7f2754783",
                                "text": "„Der Grund, weshalb in Deutschland noch relativ gefahrlos rohes Fleisch gegessen werden kann, ist, dass sich in mitteleuropäischen Rinderställen eine moderate Variante der EHEC-Bakterien eingenistet hat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
