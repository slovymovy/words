                                "target_senses": [
                                    {
                                        "sense_id": "959777ae-5245-3227-a165-26c064dcb950",
                                        "entry_id": "6ed60dea-7828-397b-adc4-aebbd21a42ab",
                                        "glosses": [
                                            "Boilerplate."
                                        ],
                                        "tags": [
                                            "informal",
                                            "no-plural",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ce3faac3-ef26-423d-8560-2a8d41ba0626",
                                                "sense_id": "959777ae-5245-3227-a165-26c064dcb950",
                                                "text": "While it appears the FRM40_TEXT table is the answer, saving a form with boiler text does not seem to insert into this table."
                                            },
                                            {
                                                "example_id": "6e966bfd-cbf8-4b2d-b612-a7ad1abf7d5b",
                                                "sense_id": "959777ae-5245-3227-a165-26c064dcb950",
                                                "text": "Note that Stuart Grey makes the assertion: \"I think rationally on all subjects.\", and then proceeds to use the standard boiler tactics and phrases of the people WHO instigate conflict and war."
                                            },
                                            {
                                                "example_id": "5ce037bc-2f6e-4089-9684-d930e9040dee",
                                                "sense_id": "959777ae-5245-3227-a165-26c064dcb950",
                                                "text": "Nearly every employer in my field has similar terms (they all come out of a legal boiler mill somewhere)."
                                            },
                                            {
                                                "example_id": "96459558-e51f-4f41-86d5-b773c38793ab",
                                                "sense_id": "959777ae-5245-3227-a165-26c064dcb950",
                                                "text": "Just aligning all the paragraphs of 'boiler text' is tedious but trying to insert values in alignment is impossible!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "de779c32-a1c1-44b6-95fd-fc81315ef9da",
                        "source_entry_id": "a6466d40-32bb-3f2f-a4ef-e826511cb2e0",
                        "source_sense_id": "276293b7-efa2-3a01-a3cf-40bed4a10f7c",
                        "source_sense_description": "Gerät zum Erhitzen oder Erwärmen von Wasser",
                        "target_lang_word": "chauffe-eau",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chauffe-eau",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "da9b80d7-3589-3814-8eed-362a59569be1",
                                        "entry_id": "e8a3dc25-8919-3585-9ba5-ac5a5a91b9bb",
                                        "glosses": [
                                            "Appareil fournissant l’eau chaude domestique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b9b3645-ef01-4542-937d-cece1f8ffaf3",
                                                "sense_id": "da9b80d7-3589-3814-8eed-362a59569be1",
                                                "text": "Dans le but de fournir l'eau chaude à bon marché dans les maisons du Congo belge, il serait possible d'établir des chauffe-eaux solaires."
                                            },
                                            {
                                                "example_id": "dc55815e-fd69-4815-9b74-aeaa6011a9d8",
                                                "sense_id": "da9b80d7-3589-3814-8eed-362a59569be1",
                                                "text": "Pour les chauffe-eau solaires monobloc, des avis techniques et des certificats de contrôle de qualité (CSTBat) sont délivrés par le Centre Scientifique et Technique du Bâtiment."
                                            },
                                            {
                                                "example_id": "cef139b6-89ca-4d15-81d5-915354a2cd3c",
                                                "sense_id": "da9b80d7-3589-3814-8eed-362a59569be1",
                                                "text": "Il était tellement désœuvré que, depuis quelques semaines, il s’était mis à parler à son chauffe-eau. Et le plus inquiétant – il en avait pris conscience l’avant-veille – était qu’il s’attendait maintenant à ce que le chauffe-eau lui réponde. L’appareil produisait il est vrai des bruits de plus en plus variés : gémissements, ronflements, claquements secs, sifflements de tonalité et de volume variés ; on pouvait s’attendre un jour ou l’autre à ce qu’il accède au langage articulé. Il était, en somme, son plus ancien compagnon."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2e2f7ed3-88bc-4b6a-8a78-6140eb8f8e1a",
                        "source_entry_id": "a6466d40-32bb-3f2f-a4ef-e826511cb2e0",
