                                "example_id": "04ecd570-8fab-404a-a60a-adb6570f1ff1",
                                "sense_id": "0496d3dd-b7ea-393e-bae2-44e5defdafe7",
                                "text": "„Neben Berichten über die Erfolge der verschiedenen christlichen Missionsstationen in Afrika enthielt die Nummer auch die Ankündigung eines Literaturwettbewerbes in verschiedenen afrikanischen Sprachen, darunter auch Chinyanja bzw. Chichewa.“"
                            },
                            {
                                "example_id": "c3b11a33-97b3-4426-8304-c18f4bf45cef",
                                "sense_id": "0496d3dd-b7ea-393e-bae2-44e5defdafe7",
                                "text": "„Die Sprachkompetenz der Religionspädagogen, hier Chinyanja, ist nur das erste Problem.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
