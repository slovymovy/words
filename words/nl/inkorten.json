                    "sense_id": "ea3dee62-9f8e-379a-a19b-e1d21df802d4",
                    "sense_definition": "Iets korter of kleiner maken in lengte, tijd of omvang.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "korter maken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik zou u aanraden de rok een ietsje te laten <w>inkorten</w>.",
                            "target_lang_translations": {
                                "en": "I would recommend having the skirt <w>shortened</w> a little bit."
                            }
                        },
                        {
                            "text": "De redacteur moest de tekst <w>inkorten</w> om alles op één pagina te laten passen.",
                            "target_lang_translations": {
                                "en": "The editor had to <w>abridge</w> the text to make everything fit on one page."
                            }
                        }
                    ],
                    "synonyms": [
