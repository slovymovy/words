                "senses": [
                    {
                        "sense_id": "308480b1-3030-3156-8fcf-9ad4df801239",
                        "entry_id": "b7a4dcb9-bfaf-3005-a290-646e3d208507",
                        "glosses": [
                            "пастух овечьих стад"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "24e46421-5510-4f1a-940a-dbd525adee32",
                                "sense_id": "308480b1-3030-3156-8fcf-9ad4df801239",
                                "text": "Ташчайнар — Камнедробитель, — прозванный так окрестными чабанами за сокрушительные челюсти, подполз к её ложу и успокаивающе заурчал, как бы прикрывая её телом от напасти."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5e7aa412-f891-4640-b817-5b568bd94a36",
                        "source_entry_id": "b7a4dcb9-bfaf-3005-a290-646e3d208507",
                        "source_sense_id": "308480b1-3030-3156-8fcf-9ad4df801239",
                        "target_lang_word": "shepherd",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "shepherd",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "817addf9-9849-3909-93ce-4eba941dcf1b",
                                        "entry_id": "362c395c-9867-306d-a375-04c69f200bca",
                                        "glosses": [
                                            "A person who tends sheep, especially a grazing flock."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7e066e6a-a86f-40b3-9547-8c5993bfce4f",
                                                "sense_id": "817addf9-9849-3909-93ce-4eba941dcf1b",
                                                "text": "It was April 22, 1831, and a young man was walking down Whitehall in the direction of Parliament Street. He wore shepherd's plaid trousers and the swallow-tail coat of the day, with a figured muslin cravat wound about his wide-spread collar."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e48614c9-cb0b-33c1-840d-a552f60beb71",
                                        "entry_id": "362c395c-9867-306d-a375-04c69f200bca",
                                        "glosses": [
                                            "A person who tends sheep, especially a grazing flock.",
                                            "A male sheep tender"
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bcf187aa-3d58-3e7f-9343-02a63a8b5ec4",
                                        "entry_id": "362c395c-9867-306d-a375-04c69f200bca",
                                        "glosses": [
                                            "Someone who watches over, looks after, or guides somebody."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6279921c-7ed5-407d-a785-327a55171319",
                                                "sense_id": "bcf187aa-3d58-3e7f-9343-02a63a8b5ec4",
                                                "text": "The Lord is my shepherd; I shall not want."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "03feb72f-5817-3cdc-8bcf-8e185c630175",
                                        "entry_id": "362c395c-9867-306d-a375-04c69f200bca",
                                        "glosses": [
                                            "Someone who watches over, looks after, or guides somebody.",
                                            "A male watcher/guardian/guider/leader"
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9e98ee45-149a-3380-a439-855b5014a7cd",
                                        "entry_id": "362c395c-9867-306d-a375-04c69f200bca",
                                        "glosses": [
                                            "The pastor of a church; one who guides others in religion."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ade9f136-1844-3c22-abfa-4e62d832e55d",
                                        "entry_id": "362c395c-9867-306d-a375-04c69f200bca",
                                        "glosses": [
                                            "The pastor of a church; one who guides others in religion.",
                                            "A male pastor"
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4d99cea2-5e83-3dde-97de-ad8293bd3b3f",
                                        "entry_id": "362c395c-9867-306d-a375-04c69f200bca",
                                        "glosses": [
                                            "A swain; a rustic male lover."
                                        ],
                                        "tags": [
                                            "countable",
                                            "poetic"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "58599226-89a8-3852-99fc-27846434d964",
                                        "entry_id": "362c395c-9867-306d-a375-04c69f200bca",
                                        "glosses": [
                                            "A German Shepherd."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5b5f790c-3f7c-4f5c-91cd-16a855268337",
                                                "sense_id": "58599226-89a8-3852-99fc-27846434d964",
                                                "text": "The dirt floor, low ceiling and unfinished stone walls were barely illuminated by candles and a dim string of green decorative lights. A nervous shepherd mix barked at me as a woman tried to calm it. When my eyes adjusted, I saw people in corners."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "shepherd",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e6b67094-6a8b-3686-be8b-4e36396f63ed",
                                        "entry_id": "a821673e-321a-3ba6-8527-9ef0bfe7c401",
                                        "glosses": [
                                            "To watch over; to guide."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c64f8aa3-a87c-4732-9452-fefc4859e280",
                                                "sense_id": "e6b67094-6a8b-3686-be8b-4e36396f63ed",
                                                "text": "For me has Pain, the sentinel, / Been vigilant / To pace my plot and dwell / Within my tent; / Oft in the night with small alarms / Has stirred me out of rest, / Alert, oppressed, / Till shepherded within thine arms / And on thy breast, / O loving Lady, in the curse of Pain / I have been blest— / […]"
                                            },
                                            {
                                                "example_id": "eff93736-23f5-438d-9e50-a98ddba35951",
                                                "sense_id": "e6b67094-6a8b-3686-be8b-4e36396f63ed",
                                                "text": "Each entry in this volume was assigned to a different preeminent scholar who was responsible for shepherding that specific entry, and that specific entry alone, into being."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fae865d7-b37b-3e52-96e0-703afb3b1c77",
                                        "entry_id": "a821673e-321a-3ba6-8527-9ef0bfe7c401",
                                        "glosses": [
                                            "To obstruct an opponent from getting to the ball, either when a teammate has it or is going for it, or if the ball is about to bounce through the goal or out of bounds."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e90443f6-6e4a-4e6e-964f-f6a47bcc41c4",
                        "source_entry_id": "b7a4dcb9-bfaf-3005-a290-646e3d208507",
                        "source_sense_id": "308480b1-3030-3156-8fcf-9ad4df801239",
                        "target_lang_word": "berger",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "berger",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6592e019-c7eb-387d-b021-ac9fc089d9e1",
                                        "entry_id": "6f08dd35-b7a5-3c2d-8a68-25cfc509136e",
                                        "glosses": [
                                            "Pâtre, gardien de troupeau."
                                        ],
                                        "tags": [
                                            "Élevage"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "39480cd2-951e-4199-af63-b73236395855",
                                                "sense_id": "6592e019-c7eb-387d-b021-ac9fc089d9e1",
                                                "text": "Aux alentours et dans les lointains invisibles, les tintements joyeux des clochettes argentines et les bourdons graves des sonneaux indiquaient à Mimile que les autres petits bergers, ainsi que les bergères de son âge rapatriaient comme lui vers l’abreuvoir et vers l’étable leurs troupeaux repus."
                                            },
                                            {
                                                "example_id": "8cfba72d-129c-478a-95ce-31833a7036c5",
                                                "sense_id": "6592e019-c7eb-387d-b021-ac9fc089d9e1",
                                                "text": "Les brebis y passaient les mois d'été et les bergers les menaient, le soir, dans des endroits réservés appelés jasses « jassia » où elles se rassemblaient pour la nuit."
                                            },
                                            {
                                                "example_id": "115ac9e2-b1f1-481c-a115-03a51974d32c",
                                                "sense_id": "6592e019-c7eb-387d-b021-ac9fc089d9e1",
                                                "text": "En arrivant à Normée le berger souffle dans sa corne pour annoncer son retour. Les chiens aboient. Par petits groupes, les bêtes, sans se tromper, rentrent dans leur cour respective."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b1ef2ff8-d340-3335-a073-9822aa48c03d",
                                        "entry_id": "6f08dd35-b7a5-3c2d-8a68-25cfc509136e",
                                        "glosses": [
                                            "Pâtre, gardien de troupeau.",
                                            "Pasteur, guide spirituel d’une personne, d’un groupe de personnes."
                                        ],
                                        "tags": [
                                            "Élevage"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7949c1fe-db75-45e7-baa1-76f025590206",
                                                "sense_id": "b1ef2ff8-d340-3335-a073-9822aa48c03d",
                                                "text": "Ces bergers qu'on appelle les prêtres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a0a05304-43b3-3d84-8fde-049ab733ec81",
                                        "entry_id": "6f08dd35-b7a5-3c2d-8a68-25cfc509136e",
                                        "glosses": [
                                            "Pâtre, gardien de troupeau.",
                                            "Santon de la crèche qui représente ce gardien."
                                        ],
                                        "tags": [
                                            "Élevage"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d2de7280-d9f4-4e34-bc5b-44e31f51d011",
                                                "sense_id": "a0a05304-43b3-3d84-8fde-049ab733ec81",
                                                "text": "Faut dire qu'il y a tellement de bergers ! Des bergers debout, des bergers couchés, des bergers qui portent un agneau sur leurs frêles épaules, des bergers accompagnés de leur chien ! En tout, il y en a au moins cent cinquante !"
                                            },
                                            {
                                                "example_id": "b0028394-16bb-465f-b2ef-e6957c0d6401",
                                                "sense_id": "a0a05304-43b3-3d84-8fde-049ab733ec81",
                                                "text": "L'attraction principale était la crèche vivante avec les bergers, les Rois mages, la Vierge Marie, saint Joseph et le petit Jésus. Il y avait aussi les moutons, le bœuf, l'âne, tout. Il ne manquait que le chameau."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "db48bfcb-d7ce-3b03-8182-e8ad843a781d",
                                        "entry_id": "6f08dd35-b7a5-3c2d-8a68-25cfc509136e",
                                        "glosses": [
                                            "Amant."
                                        ],
                                        "tags": [
                                            "poetic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "461b822e-271d-4db1-973f-59d159eca45e",
                                                "sense_id": "db48bfcb-d7ce-3b03-8182-e8ad843a781d",
                                                "text": "Un berger fidèle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "418ea4ba-c589-3c96-ae60-e20eee8e2419",
                                        "entry_id": "6f08dd35-b7a5-3c2d-8a68-25cfc509136e",
                                        "glosses": [
                                            "Chien de berger."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "77171e49-2142-4279-a457-9aabb8c54fc8",
                                                "sense_id": "418ea4ba-c589-3c96-ae60-e20eee8e2419",
                                                "text": "Pour Josée, les croquettes du vétérinaire et les holistiques n'ont même pas suffis à stopper les diarrhées sévères et les démangeaisons à s'en arracher les poils de son Berger croisé Husky et Golden."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
