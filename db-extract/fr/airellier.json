                        "glosses": [
                            "Arbrisseau qui produit des airelles."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "a748432e-0ba3-41df-9864-49d5277031da",
                                "sense_id": "8a2e5095-001a-3d9e-90a1-bf5d919b029c",
                                "text": "La Laponie possède une ressource dans ses arbustes, tels que l’épine-vinette, le mûrier rampant, l’airellier et autres."
                            },
                            {
                                "example_id": "b4992de8-f8f3-4270-85d4-0e43d8949670",
                                "sense_id": "8a2e5095-001a-3d9e-90a1-bf5d919b029c",
                                "text": "Bénin et Lesueur puisèrent de l’eau dans un petit bassin naturel qui se cachait à vingt pas sous les airelliers, et ils y couchèrent les bouteilles de Saint-Péray mousseux, pour les rafraîchir."
                            },
                            {
                                "example_id": "573bef60-e703-41ee-9fdb-95466fd439c8",
                                "sense_id": "8a2e5095-001a-3d9e-90a1-bf5d919b029c",
                                "text": "Les sous-bois de sapins ont des tapis d’airelliers où l’on enfonce jusqu’à mi-jambes."
                            }
                        ]
                    }
