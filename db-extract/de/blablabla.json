                        ],
                        "examples": [
                            {
                                "example_id": "25b263c9-d8a2-45a6-872a-2d5e195e39a0",
                                "sense_id": "82df3d0d-993b-3228-815a-5f63a0f95649",
                                "text": "Dieses ganze Blablabla hör ich mir nicht länger an!"
                            },
                            {
                                "example_id": "a6a87ac0-548b-4195-8bac-133becc0d4e5",
                                "sense_id": "82df3d0d-993b-3228-815a-5f63a0f95649",
                                "text": "„Was im Jahr 2019 noch nach gleichem Muster läuft, sind die TV-Talkshows. CDU, AfD und Vodafone koalieren nun; die EU ist auf Liechtenstein und Monaco reduziert, mit der Währung Merkel; aus Zypern nehmen Bootsflüchtlinge Kurs auf Nordafrika; Mehdorn als Bundespräsident. Und die Debattierer reden das alte Blablabla.“"
                            },
                            {
                                "example_id": "2f2a4488-0fce-468c-989d-9bb88a6f6cd5",
                                "sense_id": "82df3d0d-993b-3228-815a-5f63a0f95649",
                                "text": "„Mußte mich überwinden und schon wieder Vogel empfangen. Unverbindliches Blablabla. Wirkte ziemlich obenauf, der Herr Oberlehrer, weiß, ohne ihn läuft nichts mehr.“"
                            },
                            {
                                "example_id": "8205c569-8c5a-4528-a205-56e991c95af5",
                                "sense_id": "82df3d0d-993b-3228-815a-5f63a0f95649",
                                "text": "„Im Betriebsjargon über philosophische Texte zu reden oder Interpretationen von Thomas Mann zu vergleichen, das ist nur Blablabla.“"
                            },
                            {
                                "example_id": "8a282a5e-7dde-437d-880c-5654f843e963",
                                "sense_id": "82df3d0d-993b-3228-815a-5f63a0f95649",
                                "text": "„»Ich kann Ihnen gar nichts bieten, nur Blablabla«, hatte er sein Publikum am Anfang gewarnt. Das lachte nur über so viel Bescheidenheit.“"
                            },
                            {
                                "example_id": "7dfba7e0-eab6-49dc-841a-643743949ffe",
                                "sense_id": "82df3d0d-993b-3228-815a-5f63a0f95649",
                                "text": "„Bei den Protesten von über 100.000 Menschen gestern in Kopenhagen gegen eine drohende Klimakatastrophe und das Blablabla der Verursacher sind 1000 TeilnehmerInnen [sic] festgenommen worden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
