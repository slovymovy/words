                        "examples": [
                            {
                                "example_id": "d2f7cc5b-9e89-4fe9-b659-8a1a44c8520a",
                                "sense_id": "1f53baad-8f9e-3fa9-bc4b-b70f030b10a7",
                                "text": "Le biscotin est composé d'une pâte de farine, de beurre et de fleur d'oranger qui peut enrober une noisette grillée (à Aix en Provence). (« web-provence.com » -2007)"
                            },
                            {
                                "example_id": "69c10ada-9c38-44df-adb2-6b7d7c69bc0c",
                                "sense_id": "1f53baad-8f9e-3fa9-bc4b-b70f030b10a7",
                                "text": "Et puis il y a les bugnes, les oreillettes, les navettes parfumées au cumin, celles à l’anis, les croquants aux amandes, les galettes de lait, les biscotins aux pignons de pin."
                            }
                        ]
