                "senses": [
                    {
                        "sense_id": "2b52236c-f78b-3968-822d-cd10220b03ea",
                        "entry_id": "2b9796c3-c4b3-3bfa-8ac4-361bd2c7260b",
                        "glosses": [
                            "porcja sprasowanego tytoniu przeznaczonego do żucia"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "01b00617-1d81-4b52-9cb2-fed8bd86b942",
                                "sense_id": "2b52236c-f78b-3968-822d-cd10220b03ea",
                                "text": "Nim odpowiedział, szturman włożył sobie w usta następną prymkę."
                            },
                            {
                                "example_id": "656cc58d-1112-4c0e-99f5-e0ae92cb2962",
                                "sense_id": "2b52236c-f78b-3968-822d-cd10220b03ea",
                                "text": "Tutaj, w dymie konduktorskich fajek, w czadzie tytoniu, prymki, papierosów tułały się echa opowieści"
                            },
                            {
                                "example_id": "b69b7a80-ee80-42bb-ba33-63924d25e8c3",
                                "sense_id": "2b52236c-f78b-3968-822d-cd10220b03ea",
                                "text": "Dam ci funt prymki – zaskamłał pojednawczo – zaraz jak tylko ją wydostanę, dalibóg…"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "166dd15c-fc94-4345-a290-d0b397634bbf",
                        "source_entry_id": "2b9796c3-c4b3-3bfa-8ac4-361bd2c7260b",
                        "source_sense_id": "2b52236c-f78b-3968-822d-cd10220b03ea",
                        "target_lang_word": "plug",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "plug",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7d43fa0c-7596-33e5-a0e7-de361a57f991",
                                        "entry_id": "295d0da0-97fd-3df6-b5cd-a8242b09bab8",
                                        "glosses": [
                                            "A pronged connecting device which fits into a mating socket, especially an electrical one."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1377882d-9e13-45f1-8dde-0f8e634b3c3c",
                                                "sense_id": "7d43fa0c-7596-33e5-a0e7-de361a57f991",
                                                "text": "I pushed the plug back into the electrical socket and the lamp began to glow again."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3e1d4953-6ad7-3e57-a1f2-fc08530fc9e6",
                                        "entry_id": "295d0da0-97fd-3df6-b5cd-a8242b09bab8",
                                        "glosses": [
                                            "A pronged connecting device which fits into a mating socket, especially an electrical one.",
                                            "An electric socket: wall plug."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0f9207d5-86a0-358a-9399-31efd2e781d3",
                                        "entry_id": "295d0da0-97fd-3df6-b5cd-a8242b09bab8",
                                        "glosses": [
                                            "Any piece of wood, metal, or other substance used to stop or fill a hole."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19f6d71b-f710-43e7-b651-022d79520b10",
                                                "sense_id": "0f9207d5-86a0-358a-9399-31efd2e781d3",
                                                "text": "Pull the plug out of the tub so it can drain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ded8b0b7-a73f-36fb-9ff6-f49769b54ad2",
                                        "entry_id": "295d0da0-97fd-3df6-b5cd-a8242b09bab8",
                                        "glosses": [
                                            "A flat oblong cake of pressed tobacco."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d729b126-8c8f-4330-9201-9ac67b93fdcf",
                                                "sense_id": "ded8b0b7-a73f-36fb-9ff6-f49769b54ad2",
                                                "text": "He preferred a plug of tobacco to loose chaw."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "14195f9f-3809-35e8-a6b2-df212e69ff9f",
                                        "entry_id": "295d0da0-97fd-3df6-b5cd-a8242b09bab8",
                                        "glosses": [
                                            "A high, tapering silk hat."
                                        ],
                                        "tags": [
                                            "US",
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "42a11146-659b-3bc8-89f4-e58f4c2ecacf",
                                        "entry_id": "295d0da0-97fd-3df6-b5cd-a8242b09bab8",
                                        "glosses": [
                                            "A worthless horse."
                                        ],
                                        "tags": [
                                            "US",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fae1b086-3502-450a-bdef-e3fc40cc2884",
                                                "sense_id": "42a11146-659b-3bc8-89f4-e58f4c2ecacf",
                                                "text": "That sorry old plug is ready for the glue factory!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1922f9ad-ba3b-3e6c-b90d-98ab572f4af6",
                                        "entry_id": "295d0da0-97fd-3df6-b5cd-a8242b09bab8",
                                        "glosses": [
                                            "Any worn-out or useless article."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "74e1249a-51f9-3c1a-9250-51d292d1540c",
                                        "entry_id": "295d0da0-97fd-3df6-b5cd-a8242b09bab8",
                                        "glosses": [
                                            "A book that fails to sell."
                                        ],
                                        "tags": [
                                            "dated",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8ff44510-e711-4eb1-b4be-2c3b2936ae47",
                                                "sense_id": "74e1249a-51f9-3c1a-9250-51d292d1540c",
                                                "text": "Stack all new and fresh, composed of the fast-selling standard books only — no old plugs or unsalable books whatever."
                                            },
                                            {
                                                "example_id": "12d2c89f-028f-4bf0-ba73-6deae2697df6",
                                                "sense_id": "74e1249a-51f9-3c1a-9250-51d292d1540c",
                                                "text": "Many New York booksellers promoted the impression that Quaritch had sent only 'plugs' (i.e. unsaleable books)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "67dc52d4-c85c-3ad2-8da0-b6cf16347dff",
                                        "entry_id": "295d0da0-97fd-3df6-b5cd-a8242b09bab8",
                                        "glosses": [
                                            "A block of wood let into a wall to afford a hold for nails."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "495ad9ca-3c7b-31ad-b889-3a31fd172623",
                                        "entry_id": "295d0da0-97fd-3df6-b5cd-a8242b09bab8",
                                        "glosses": [
                                            "A promotion (act of promoting) of a product (such as a book, film or play) or other thing, concept, etc, for example during an interview or a commercial."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "44cc37de-bb1a-4e79-a954-2459a4609998",
                                                "sense_id": "495ad9ca-3c7b-31ad-b889-3a31fd172623",
                                                "text": "During the interview, the author put in a plug for his latest novel."
                                            },
                                            {
                                                "example_id": "cf730a4d-972c-4e6a-88af-7cf613d07fea",
                                                "sense_id": "495ad9ca-3c7b-31ad-b889-3a31fd172623",
                                                "text": "She used her televised tour of the zoo to work in another plug for conservation."
                                            },
                                            {
                                                "example_id": "d1e51af7-b6a4-4cc7-9990-64a12a1e3ab2",
                                                "sense_id": "495ad9ca-3c7b-31ad-b889-3a31fd172623",
                                                "text": "Department store decorations up before Thanksgiving, Christmas cards all over the place, TV full of plugs for fifty-dollar toys that inner-city kids watching can never expect to receive, parents spending what they can't afford and deluging their kids with the annual orgy of materialist values […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1034e567-f240-3a62-ac05-36fce5187869",
                                        "entry_id": "295d0da0-97fd-3df6-b5cd-a8242b09bab8",
                                        "glosses": [
                                            "A body of once molten rock that hardened in a volcanic vent. Usually round or oval in shape."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cfbdee06-38fe-4756-a16b-a1cb060b6ce4",
                                                "sense_id": "1034e567-f240-3a62-ac05-36fce5187869",
                                                "text": "Pressure built beneath the plug in the caldera, eventually resulting in a catastrophic explosion of pyroclastic shrapnel and ash."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5e5d4ecb-6f7c-3f81-9082-1e87ffb6be99",
                                        "entry_id": "295d0da0-97fd-3df6-b5cd-a8242b09bab8",
                                        "glosses": [
                                            "A type of lure consisting of a rigid, buoyant or semi-buoyant body and one or more hooks."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de7d9e77-a2e0-4c41-9618-76ae4930a58a",
                                                "sense_id": "5e5d4ecb-6f7c-3f81-9082-1e87ffb6be99",
                                                "text": "The fisherman cast the plug into a likely pool, hoping to catch a whopper."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "59ed8cd7-4006-391a-a6b3-b991b28eb203",
                                        "entry_id": "295d0da0-97fd-3df6-b5cd-a8242b09bab8",
                                        "glosses": [
                                            "A small seedling grown in a tray from expanded polystyrene or polythene filled usually with a peat or compost substrate."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8cc29637-3390-3dff-8aa2-a30adbc0067f",
                                        "entry_id": "295d0da0-97fd-3df6-b5cd-a8242b09bab8",
                                        "glosses": [
                                            "A growth of protoplasm that closes the pore openings in the cells of certain algae."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f7960d96-fd8e-34b2-86e3-e3039a389d00",
                                        "entry_id": "295d0da0-97fd-3df6-b5cd-a8242b09bab8",
                                        "glosses": [
                                            "A short cylindrical piece of jewellery commonly worn in larger-gauge body piercings, especially in the ear."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "43d9e34e-7e6d-3aba-b647-5e6bac9ee0dc",
                                        "entry_id": "295d0da0-97fd-3df6-b5cd-a8242b09bab8",
                                        "glosses": [
                                            "A drug dealer."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4c33197c-cf5d-4a9f-ab72-d006ce7d766b",
                                                "sense_id": "43d9e34e-7e6d-3aba-b647-5e6bac9ee0dc",
                                                "text": "He saw me catch a trap and leave the house of a drug dealer. That's why he targeted me. He could have easily blown my ass off right then and there for lying, but for some reason he didn't. He just left. I biked back to my plug's spot and told him […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "27157fcd-12c5-3774-a18d-3e2bdbee7391",
                                        "entry_id": "295d0da0-97fd-3df6-b5cd-a8242b09bab8",
                                        "glosses": [
                                            "A branch from a water-pipe to supply a hose."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9aa56053-ffb0-3259-9588-3c69bf9ab26d",
                                        "entry_id": "295d0da0-97fd-3df6-b5cd-a8242b09bab8",
                                        "glosses": [
                                            "A standard, modular fuselage component that can be added or removed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "458ed3d3-6bf7-4029-a1a1-0decdbf34a16",
                                                "sense_id": "9aa56053-ffb0-3259-9588-3c69bf9ab26d",
                                                "text": "Add front and aft closures to the fuselage midsection. Addition or subtraction of fuselage plugs, to a maximum of five rows, conveniently distributed on each side of wing, is possible."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1783197c-d72e-3fe4-98f4-dd49ddfd6bdf",
                                        "entry_id": "295d0da0-97fd-3df6-b5cd-a8242b09bab8",
                                        "glosses": [
                                            "Ellipsis of fireplug (“fire hydrant”)."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "plug",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e55adfb6-ea05-3b10-84a2-b31a88e445aa",
                                        "entry_id": "9fba8848-4db3-3422-be75-a4cfe70414f9",
                                        "glosses": [
                                            "To stop with a plug; to make tight by stopping a hole."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7df4b21f-d700-4f64-a1b1-add591a7b9b5",
                                                "sense_id": "e55adfb6-ea05-3b10-84a2-b31a88e445aa",
                                                "text": "He attempted to plug the leaks with some caulk."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6ab2bc9c-a12d-3569-bd83-1ee4dc7707b3",
                                        "entry_id": "9fba8848-4db3-3422-be75-a4cfe70414f9",
                                        "glosses": [
                                            "To promote (something, especially a product or service); to mention (something) as if promoting or advertising it."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "045b2ea7-5043-4627-a96f-b798193dc38d",
                                                "sense_id": "6ab2bc9c-a12d-3569-bd83-1ee4dc7707b3",
                                                "text": "The main guest on the show just kept plugging his latest movie: it got so tiresome."
                                            },
                                            {
                                                "example_id": "9ba835a1-56e0-472a-a168-a8a93b79c56b",
                                                "sense_id": "6ab2bc9c-a12d-3569-bd83-1ee4dc7707b3",
                                                "text": "Kennedy went on nationwide speaking tour to plug environmental conservation."
                                            },
                                            {
                                                "example_id": "aa6882ab-33fd-42ae-8b1c-9a2547d56688",
                                                "sense_id": "6ab2bc9c-a12d-3569-bd83-1ee4dc7707b3",
                                                "text": "He [Mike Skinner] treats the gig as an opportunity repeatedly to plug the after-party, where he will be DJing."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fec86e05-2c62-341f-8151-533c7db11012",
                                        "entry_id": "9fba8848-4db3-3422-be75-a4cfe70414f9",
                                        "glosses": [
                                            "To persist or continue with something."
                                        ],
                                        "tags": [
                                            "informal",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9bf6428c-010f-48d5-8e58-213bcf56dc4d",
                                                "sense_id": "fec86e05-2c62-341f-8151-533c7db11012",
                                                "text": "Near-synonym: plug away"
                                            },
                                            {
                                                "example_id": "4c19ab03-a7ea-40fc-8059-116d82c9db10",
                                                "sense_id": "fec86e05-2c62-341f-8151-533c7db11012",
                                                "text": "Keep plugging at the problem until you find a solution."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b22c5b83-f19b-397e-b687-8b87072e5226",
                                        "entry_id": "9fba8848-4db3-3422-be75-a4cfe70414f9",
                                        "glosses": [
                                            "To shoot (someone) with a bullet."
                                        ],
                                        "tags": [
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "84699a2c-1633-4fd1-9f39-8b3d25bb10de",
                                                "sense_id": "b22c5b83-f19b-397e-b687-8b87072e5226",
                                                "text": "1884, H. Rider Haggard, The Witch's Head\nI am awfully glad that you kept your nerve and plugged him; it would have been better if you could have nailed him through the right shoulder, which would not have killed him..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba421bc1-c8cc-391e-b156-b75ded41fdaf",
