                },
                {
                    "sense_id": "fa91117f-fc07-37ec-a66a-6f5784f2185a",
                    "sense_definition": "Inheritance from a deceased husband to his widow.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "inheritance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After the king's death, the queen lived quietly on her <w>dowry</w>.",
                            "target_lang_translations": {
                                "ru": "После смерти короля королева тихо жила на свою <w>вдовью часть</w>.",
                                "fr": "Après la mort du roi, la reine vécut paisiblement grâce à son <w>douaire</w>.",
                                "zh": "国王逝世后，王后依靠自己的<w>寡妇产</w>平静地度日。"
                            }
                        },
                        {
                            "text": "The legal document specified the <w>dowry</w> she would retain if she outlived her spouse.",
                            "target_lang_translations": {
                                "ru": "В юридическом документе оговаривалась <w>вдовья часть</w>, которую она сохранит, если переживет супруга.",
                                "fr": "Le document juridique précisait le <w>douaire</w> qu'elle conserverait si elle survivait à son conjoint.",
                                "zh": "该法律文件明确规定了若她比配偶长寿所能保留的<w>寡妇应得遗产</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "dower"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historical or legal context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Наследство или имущество, переходящее от умершего мужа к его вдове.",
                        "fr": "Part des biens ou héritage laissée par un mari décédé à sa veuve pour assurer sa subsistance.",
                        "zh": "丈夫去世后遗留给寡妇的财产或遗产。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вдовья часть",
                                "target_lang_sense_clarification": "доля наследства"
                            },
                            {
                                "target_lang_word": "пожизненное содержание",
                                "target_lang_sense_clarification": "обеспечение вдовы"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "douaire",
                                "target_lang_sense_clarification": "biens réservés à la veuve"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "寡妇应得遗产",
                                "target_lang_sense_clarification": "法定寡妇产"
                            },
                            {
                                "target_lang_word": "寡妇产",
                                "target_lang_sense_clarification": "法律概念，遗孀保留产"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e47c5f6c-a487-3912-951a-0f3ca3ea3f44",
                    "sense_definition": "A natural gift or talent.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "figurative_gift",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She possessed a <w>dowry</w> of wit and intelligence that charmed everyone she met.",
                            "target_lang_translations": {
                                "ru": "Она обладала <w>даром</w> остроумия и интеллекта, который очаровывал всех, кого она встречала.",
                                "fr": "Elle possédait un <w>don</w> d'esprit et d'intelligence qui charmait tous ceux qu'elle rencontrait.",
                                "zh": "她拥有机智与聪慧的<w>天赋</w>，让遇见的每一个人都为之倾倒。"
                            }
                        },
                        {
                            "text": "His only <w>dowry</w> was his incredible strength and determination.",
                            "target_lang_translations": {
                                "ru": "Его единственным <w>достоянием</w> была невероятная сила и решимость.",
                                "fr": "Son seul <w>apanage</w> était sa force et sa détermination incroyables.",
                                "zh": "他唯一的<w>天赋</w>就是惊人的力量与坚定不移的决心。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Природный дар или талант.",
                        "fr": "Don naturel, talent ou qualité innée.",
                        "zh": "天生的才能或禀赋。"
