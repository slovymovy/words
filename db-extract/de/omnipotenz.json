                                "target_senses": [
                                    {
                                        "sense_id": "cba5f189-ba69-332f-8d63-a39ffd8212c4",
                                        "entry_id": "ecb2de18-ca1e-318a-88ed-dbe74d92a24f",
                                        "glosses": [
                                            "Unlimited power; commonly attributed to a deity or deities."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "58539b3f-02cd-45f0-b185-944b93e24e0d",
                                                "sense_id": "cba5f189-ba69-332f-8d63-a39ffd8212c4",
                                                "text": "One purpose of the Freedom of Information Act is to make our society less of a police state. Until the CIA's omnipotence is seriously challenged, however, the xeroxed papers in my hand have little meaning. For now, they remind me of nothing less than the simple fact that evil forces still control our society."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6dfc91fb-632e-4448-a84d-a0da5e95558b",
                        "source_entry_id": "61bcfbe9-b6b9-3bb3-8f6e-3e49dc53f490",
                        "source_sense_id": "b12f9167-3b75-3302-a32e-21e5f0d3ce2b",
                        "target_lang_word": "totipotency",
