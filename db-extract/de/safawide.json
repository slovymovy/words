                "senses": [
                    {
                        "sense_id": "fdad947e-396a-3b3b-8afc-afb2697d631e",
                        "entry_id": "47431602-0c25-3d36-9246-ad4b5f08ecff",
                        "glosses": [
                            "Angehöriger der gleichnamigen Dynastie in Persien"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "a4b0573f-d4c5-4f14-a6c1-1026c02a3bc4",
                                "sense_id": "fdad947e-396a-3b3b-8afc-afb2697d631e",
                                "text": "„Außer in Persien, wo die Safawiden den Glauben der Shia zur Staatsreligion erklärten, blieben die Shiiten eine Minderheit unter den Muslimen.“"
                            },
                            {
                                "example_id": "4e67fcf1-122e-4db7-90d9-92369e23bfee",
                                "sense_id": "fdad947e-396a-3b3b-8afc-afb2697d631e",
                                "text": "„Auch entstanden auf dem Hochland schiitische Sultanate, die mit den persischen Safawiden verbunden waren und sich von Delhi abgrenzten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
