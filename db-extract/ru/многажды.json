        "ru-extract.jsonl": [
            {
                "entry_id": "5d4c0432-d027-3245-85f2-bb0d7f5d708b",
                "word": "многажды",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "d07b2b1c-ffb4-3763-9893-31d109e7f3a0",
                        "entry_id": "5d4c0432-d027-3245-85f2-bb0d7f5d708b",
                        "glosses": [
                            "церк. и старин., часто, неоднократно, много раз"
                        ],
                        "tags": [
                            "теперь разг., шутл."
                        ],
                        "examples": [
                            {
                                "example_id": "f9829ee5-794c-4113-8321-128120a6e0ee",
                                "sense_id": "d07b2b1c-ffb4-3763-9893-31d109e7f3a0",
                                "text": "Многажды начинал падать дождь и многажды переставал."
                            },
                            {
                                "example_id": "c853de1b-9725-4747-b662-a6ef2330490d",
                                "sense_id": "d07b2b1c-ffb4-3763-9893-31d109e7f3a0",
                                "text": "Обедали в чайхане, потом многажды пили чай на заготпункте."
                            },
                            {
                                "example_id": "08078065-90c8-418c-b760-6f477b1e138e",
                                "sense_id": "d07b2b1c-ffb4-3763-9893-31d109e7f3a0",
                                "text": "― Даже и не дважды, ― подхватил Мими, улыбаясь и принимая любимую позу свою: скрещенные руки на трость, подбородок на костяшки тыльной стороны ладони, ― многажды, бесчисленное множество раз."
                            }
                        ]
                    },
                    {
                        "sense_id": "b674772a-89ca-360e-aad0-2771980f0239",
                        "entry_id": "5d4c0432-d027-3245-85f2-bb0d7f5d708b",
                        "glosses": [
                            "церк. и старин., намного, во много раз"
                        ],
                        "tags": [
                            "теперь разг., шутл."
                        ],
                        "examples": [
                            {
                                "example_id": "ae206c69-e54f-469b-ba02-1ea8c8c4881f",
                                "sense_id": "b674772a-89ca-360e-aad0-2771980f0239",
                                "text": "Сколько раз за таким же точно столом я их перехитривал, уходил от них, сбивал со следа, дурил, обманывал, да и просто оказывался умнее их и многажды проницательнее."
                            }
                        ]
                    }
                ],
