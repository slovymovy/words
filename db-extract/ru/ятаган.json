                        "cross_references": [
                            {
                                "target_word": "yatağan",
                                "target_lang_code": "tr",
                                "target_senses": [
                                    {
                                        "sense_id": "10ace362-ee44-39b0-81f1-7e77c8d1c3d3",
                                        "entry_id": "c600c6e1-58e2-35aa-8dc2-f51a7e9f82c1",
                                        "glosses": [
                                            "Namlusu kavisli, iki yanı da kesici, bir tür uzun savaş bıçağı"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9393c001-4d9b-44c6-9c81-550b8e43775d",
                                                "sense_id": "10ace362-ee44-39b0-81f1-7e77c8d1c3d3",
                                                "text": "Kalkanları parçalayan çelik yatağanlar, zırhları kesen ağır saldırmalar yapacaktı."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c55d6b43-b7d5-4e4e-9bd4-3b204fbfc27b",
                        "source_entry_id": "10b36a1f-3efa-3ae9-9555-8996843fbfb9",
                        "source_sense_id": "9a14d9d9-0ead-38ec-8764-9e9f61886763",
                        "target_lang_word": "yatagan",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "yatagan",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4667d722-9f99-3744-8b65-e1c1a7303b07",
                                        "entry_id": "8e11cf2f-1b62-30cf-b5ab-b1ee5f456987",
                                        "glosses": [
                                            "Sabre turc, à lame recourbée et dont le tranchant forme, vers la pointe, une courbe rentrante."
                                        ],
                                        "tags": [
                                            "Armement"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4442070a-cb84-4c17-89f2-597ba84067e7",
                                                "sense_id": "4667d722-9f99-3744-8b65-e1c1a7303b07",
                                                "text": "Un coup de yatagan."
                                            },
                                            {
                                                "example_id": "854c0185-d81f-4476-8995-22bf2cb0c04f",
                                                "sense_id": "4667d722-9f99-3744-8b65-e1c1a7303b07",
                                                "text": "Pour se donner l’air plus terrible, chaque franc-tireur laissait pousser sa barbe et ses moustaches, si bien qu’à la promenade le monde ne se connaissait plus. De loin vous voyiez un brigand des Abruzzes qui venait sur vous, la moustache en croc, les yeux flamboyants, avec un tremblement de sabres, de revolvers, de yatagans ; et puis, quand on s’approchait, c’était le receveur Pégoulade."
                                            },
                                            {
                                                "example_id": "1267d446-fafe-401b-ab33-bbe87d206a38",
                                                "sense_id": "4667d722-9f99-3744-8b65-e1c1a7303b07",
                                                "text": "Tous deux nous crûmes entendre à notre porte une troupe de djinns, ou des hommes à turban, rampant sur les marches vermoulues, avec des poignards et des yatagans dégainés."
                                            },
                                            {
                                                "example_id": "37fda6a2-c210-45bd-b352-856b5d656887",
                                                "sense_id": "4667d722-9f99-3744-8b65-e1c1a7303b07",
                                                "text": "Au bord de la terrasse, les feuilles se découpent en lames recourbées de minuscules yatagans."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
