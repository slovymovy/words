                    {
                        "translation_id": "6811f25e-4996-463c-a154-c9cb607c39f1",
                        "source_entry_id": "3a44549d-6898-3ef4-b22b-320661d113f5",
                        "source_sense_id": "1c9dd3d1-07b2-3f5c-b7eb-d10d580fc483",
