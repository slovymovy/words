                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "That was a fantastic performance by the band.",
                            "target_lang_translations": {
                                "ru": "Это было фантастическое выступление группы.",
                                "nl": "Dat was een fantastisch optreden van de band.",
                                "pl": "To był fantastyczny występ tego zespołu.",
                                "de": "Das war ein fantastischer Auftritt der Band.",
                                "fr": "C'était une performance fantastique de la part du groupe.",
                                "it": "È stata una prestazione fantastica da parte della band.",
