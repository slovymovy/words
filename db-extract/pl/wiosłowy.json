                                        "sense_id": "85c975cb-6c50-3503-904d-b8a1cad21a70",
                                        "entry_id": "fd3e9dbe-e138-35a2-a883-d59acb20eb50",
                                        "glosses": [
                                            "The act of having a row, or argument."
                                        ],
                                        "tags": [
