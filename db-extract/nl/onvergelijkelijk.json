                "translations": [
                    {
                        "translation_id": "37efb50e-cab3-4286-b435-59bc93109f18",
                        "source_entry_id": "09fb6853-edc3-3021-934b-bac70724dfc7",
                        "source_sense_id": "ce3d673c-11a6-3b24-b9e3-905375dcafb1",
                        "source_sense_description": "zonder dat je zaken eigenlijk met elkaar mag vergelijken",
                        "target_lang_word": "unique",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unique",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "aeb07cda-3c27-3ced-9e0f-feb7a381f8a4",
                                        "entry_id": "dcb3490f-e740-3fea-809f-49f1f9687745",
                                        "glosses": [
                                            "Being the only one of its kind; unequaled, unparalleled or unmatched."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c37b579f-7596-4aef-b761-10a64d0cf129",
                                                "sense_id": "aeb07cda-3c27-3ced-9e0f-feb7a381f8a4",
                                                "text": "Every person has a unique life, therefore every person has a unique journey."
                                            },
                                            {
                                                "example_id": "417112f7-a456-45fd-b434-216ecc81032d",
                                                "sense_id": "aeb07cda-3c27-3ced-9e0f-feb7a381f8a4",
                                                "text": "Perhaps the reader will wonder why we have placed our \" beings \" on a sphere rather than on another closed surface. But this choice has its justification in the fact that, of all closed surfaces, the sphere is unique in possessing the property that all points on it are equivalent."
                                            },
                                            {
                                                "example_id": "dedde751-322c-4560-bcab-450fffdf2a55",
                                                "sense_id": "aeb07cda-3c27-3ced-9e0f-feb7a381f8a4",
                                                "text": "3. Both were written and published with the same unique chorus structure;\n4. Both compositions were written and published with the same unique harmonic structure;"
                                            },
                                            {
                                                "example_id": "13967f92-48d4-4dfe-9b14-8a6e5d024ee1",
                                                "sense_id": "aeb07cda-3c27-3ced-9e0f-feb7a381f8a4",
                                                "text": "‘[…] There's every Staffordshire crime-piece ever made in this cabinet, and that's unique. The Van Hoyer Museum in New York hasn't that very rare second version of Maria Marten's Red Barn over there, nor the little Frederick George Manning—he was the criminal Dickens saw hanged on the roof of the gaol in Horsemonger Lane, by the way—’"
                                            },
                                            {
                                                "example_id": "d6a060a2-5b13-4449-88a9-620f13aa7f41",
                                                "sense_id": "aeb07cda-3c27-3ced-9e0f-feb7a381f8a4",
                                                "text": "Admiralty Island contains unique resources of scientific interest which need protection to assure continued opportunities for study."
                                            },
                                            {
                                                "example_id": "84f22951-b638-485e-9115-019f71125361",
                                                "sense_id": "aeb07cda-3c27-3ced-9e0f-feb7a381f8a4",
                                                "text": "A very interesting history of United Nations at war in Korea, done in an^([sic]) unique question and answer style."
                                            },
                                            {
                                                "example_id": "c2e9af64-2f2b-4e65-ba42-33fa8b517926",
                                                "sense_id": "aeb07cda-3c27-3ced-9e0f-feb7a381f8a4",
                                                "text": "GPS assigns a unique C/A code and a unique P code to each satellite."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "05b958aa-f17f-3e5f-9a37-ad7f937f5969",
                                        "entry_id": "dcb3490f-e740-3fea-809f-49f1f9687745",
                                        "glosses": [
                                            "Of a feature, such that only one holder has it."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "31b1a8cd-bd8e-3c80-98cd-8d9bdf324040",
                                        "entry_id": "dcb3490f-e740-3fea-809f-49f1f9687745",
                                        "glosses": [
                                            "Particular, characteristic."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3b4a71b9-f9f3-3cdf-9d89-eb9ec0c7f818",
                                        "entry_id": "dcb3490f-e740-3fea-809f-49f1f9687745",
                                        "glosses": [
                                            "Of a rare quality, unusual."
                                        ],
                                        "tags": [
                                            "proscribed"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eaeb7a7b-d663-4ad9-8256-9ac0ea32b603",
                                                "sense_id": "3b4a71b9-f9f3-3cdf-9d89-eb9ec0c7f818",
                                                "text": "And as I look back, it seems to me that we were fairly unique, the sixty of us, in that there wasn’t one good mixer in the bunch."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "unique",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "80dba136-7eb7-383f-84c4-486f5098a50d",
                                        "entry_id": "7a6aa8ea-f521-3c12-b900-b11143096e4f",
                                        "glosses": [
                                            "A thing without a like; something unequalled or unparallelled; one of a kind."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a7b5839c-a406-42ef-a4df-c18fe8f3fc4d",
                                                "sense_id": "80dba136-7eb7-383f-84c4-486f5098a50d",
                                                "text": "The phoenix, the unique of birds."
                                            },
                                            {
                                                "example_id": "9abaf453-5998-4460-8617-ae8ac1aa978e",
                                                "sense_id": "80dba136-7eb7-383f-84c4-486f5098a50d",
                                                "text": "[…] uniques of the game, Sauron and Morgoth, are found on levels 99 and 100 of the dungeon respectively, […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
