                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3aa75015-8dba-4130-8545-0edf98a717f2",
                                "sense_id": "75aec65d-1b7d-3471-add7-c62b9a2d543d",
                                "text": "Prymat papieża w Kościele rzymskokatolickim."
                            },
                            {
                                "example_id": "e38ba294-c8eb-46ea-93a7-f7cb67cedeb9",
                                "sense_id": "75aec65d-1b7d-3471-add7-c62b9a2d543d",
                                "text": "Niemcy i Francja rywalizują o prymat w europejskiej polityce."
                            },
                            {
                                "example_id": "5709b0b1-e9b7-43cf-8778-d855bdc4033c",
                                "sense_id": "75aec65d-1b7d-3471-add7-c62b9a2d543d",
                                "text": "Walczyć o prymat w pracy."
                            }
                        ],
