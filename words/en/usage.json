                },
                {
                    "sense_id": "46e0a755-181e-362b-8ecf-00201fe14e47",
                    "sense_definition": "The way in which a person or thing is treated, especially when it is harsh or unfair.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "treatment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old car had suffered years of rough <w>usage</w> on the bumpy country roads.",
                            "target_lang_translations": {
                                "ru": "Старая машина пострадала от многолетней грубой <w>эксплуатации</w> на ухабистых проселочных дорогах."
                            }
                        },
                        {
                            "text": "The prisoner complained of the cruel <w>usage</w> he received at the hands of his captors.",
                            "target_lang_translations": {
                                "ru": "Заключенный жаловался на жестокое <w>обращение</w>, которому он подвергался со стороны своих похитителей."
                            }
                        }
                    ],
                    "synonyms": [
