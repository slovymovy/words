                        "examples": [
                            {
                                "example_id": "d4ff2846-9118-4d8c-bbdc-d69192cc5a41",
                                "sense_id": "32e2e194-0c0c-3bf6-bf90-97698bf4f5a5",
                                "text": "Behalve instellingen en landen kijken ook oliemaatschappijen vooruit. Libië is geen groot olieland. Voor de gevechten begonnen, was het land goed voor ongeveer twee procent van de wereldproductie."
                            },
                            {
                                "example_id": "992252e3-7a8e-4284-b642-dbe5942ad2a6",
                                "sense_id": "32e2e194-0c0c-3bf6-bf90-97698bf4f5a5",
                                "text": "Kroonprins Nayef van Saudi-Arabië is vandaag overleden, heeft de staatstelevisie gemeld. Nayef was sinds 1975 ook minister van Binnenlandse Zaken in het belangrijke olieland."
                            }
