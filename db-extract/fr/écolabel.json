                    },
                    {
                        "form_id": "b83f44fd-e55a-4c30-a310-53c3210ca19f",
                        "entry_id": "b515a696-cac5-388b-a11a-fd34e16b7c67",
                        "tags": [],
                        "form": "éco-label"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "45c4c4be-f49b-3ad0-8eb7-b35bd0f8b28f",
                        "entry_id": "b515a696-cac5-388b-a11a-fd34e16b7c67",
                        "glosses": [
                            "Label attribué par une organisation certifiante et garantissant un impact réduit sur l'environnement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46ffed65-f5ab-4050-aa7b-cf74be2070a8",
                                "sense_id": "45c4c4be-f49b-3ad0-8eb7-b35bd0f8b28f",
                                "text": "L'écolabel forestier FSC accorde autant de place aux aspects sociaux (droits des populations autochtones) et économiques qu'aux aspects environnementaux (gestion durable des forêts)."
                            },
                            {
                                "example_id": "41c0b335-b58e-4d1a-8757-f1586ce50443",
                                "sense_id": "45c4c4be-f49b-3ad0-8eb7-b35bd0f8b28f",
                                "text": "L’écolabel Européen repose sur le principe d’une « approche globale » qui « prend en considération le cycle de vie du produit à partir de la fabrication y compris le choix des matières premières, la distribution, la consommation et l’utilisation jusqu’à l’élimination après usage »."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9057c346-41bc-4c5f-bcb8-5628d801c52c",
                        "source_entry_id": "b515a696-cac5-388b-a11a-fd34e16b7c67",
                        "source_sense_id": "45c4c4be-f49b-3ad0-8eb7-b35bd0f8b28f",
                        "target_lang_word": "Umweltzeichen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Umweltzeichen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "eed6873a-ba42-3300-9a41-cd8b3bcc69b1",
                                        "entry_id": "ac14e5ad-0eab-3dc1-a024-75c37eb4b50e",
                                        "glosses": [
                                            "auf Waren angebrachtes Symbol, das dem Verbraucher eine besonders gute Umweltverträglichkeit im Vergleich zu anderen gleichartigen Waren anzeigt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b2ff24f3-1be1-453f-921b-ee502e80e1ec",
                                                "sense_id": "eed6873a-ba42-3300-9a41-cd8b3bcc69b1",
                                                "text": "„Das Umweltzeichen Blauer Engel steckt in einer Krise. Seit einiger Zeit stagniert die Zahl der ausgezeichneten Produkte oder geht sogar leicht zurück.“"
                                            },
                                            {
                                                "example_id": "e12e116e-f49a-4297-a817-a3b08fd621b3",
                                                "sense_id": "eed6873a-ba42-3300-9a41-cd8b3bcc69b1",
                                                "text": "„Ich habe erreicht, dass es keinen Blauen Engel für lärmarme Laubsauger gibt. Diese Geräte sind nicht gut für die Umwelt, also verdienen sie auch kein Umweltzeichen.“"
                                            },
                                            {
                                                "example_id": "04b49883-5597-4abf-8453-62caeeaa7d8c",
                                                "sense_id": "eed6873a-ba42-3300-9a41-cd8b3bcc69b1",
                                                "text": "„Die neue Zentrale ist eines der grünsten Gebäude der Stadt und erhielt Umweltzeichen der Hafencity in Gold“."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
