                                                "sense_id": "2bcd5870-5f98-32be-b3ea-ee837c12a054",
                                                "text": "Der Hubschrauber schwebte über dem Dach des Gebäudes und Spezialkräfte der Polizei seilten sich ab."
                                            },
                                            {
                                                "example_id": "c96bbacf-cfe5-492a-803c-6505bde6b366",
                                                "sense_id": "2bcd5870-5f98-32be-b3ea-ee837c12a054",
                                                "text": "Und jede Menge Geschichten erzählen sie: Von der berüchtigten Malfatta, dieser 50 Grad steilen Senkrecht-Sause, bei der man sich erstmal 50 Meter abseilen muss."
                                            },
                                            {
                                                "example_id": "72827d56-84f3-471b-8b19-9075252a5f2e",
                                                "sense_id": "2bcd5870-5f98-32be-b3ea-ee837c12a054",
                                                "text": "Stromausfall: Mehr als 170 Menschen mussten aus dem Riesenrad \"Singapore Flyer\" in Singapur abgeseilt werden."
                                            },
                                            {
                                                "example_id": "867fd4c3-ec56-4aec-b5b6-c80ab15fef75",
                                                "sense_id": "2bcd5870-5f98-32be-b3ea-ee837c12a054",
                                                "text": "„Einmal seilten sich die Teilnehmer ab und einmal sprangen sie hinunter.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6d685180-1c9b-325d-94bc-0434fd64ee64",
