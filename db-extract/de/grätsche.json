                                "target_senses": [
                                    {
                                        "sense_id": "4747b31d-f844-3b07-a9f0-97982fda33bb",
                                        "entry_id": "28f9936f-3aad-37a4-9216-eb6fe821e2c2",
                                        "glosses": [
                                            "To sit or stand with a leg on each side of something; to sit astride."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1e08f70c-5314-4cc8-bd40-54872c9bab4d",
                                                "sense_id": "4747b31d-f844-3b07-a9f0-97982fda33bb",
                                                "text": "But guess my surprise, when I saw the lazy young rogue lie down on his back, and gently pull down Polly upon him, who giving way to his humour, straddled, and with her hands conducted her blind favourite to the right place",
                                                "translation": "Fanny Hill",
                                                "english": "Fanny Hill"
                                            },
                                            {
                                                "example_id": "b4c3ccc7-c3c0-4f0e-8572-cb413b322047",
                                                "sense_id": "4747b31d-f844-3b07-a9f0-97982fda33bb",
                                                "text": "As they approached the entrance of the port, the giant straddled clear across it, with a foot firmly planted on each headland,"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df4d6307-8be9-3bf6-baa2-0a2e9da924da",
                                        "entry_id": "28f9936f-3aad-37a4-9216-eb6fe821e2c2",
                                        "glosses": [
                                            "To be on both sides of something; to have parts that are in different places, regions, etc."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "48db40a8-caa6-4bf9-a3c0-57450e92a713",
                                                "sense_id": "df4d6307-8be9-3bf6-baa2-0a2e9da924da",
                                                "text": "The mountain-ringed Yukon Flats basin straddles the Arctic Circle and is bisected by the Yukon River."
                                            },
                                            {
                                                "example_id": "0174a929-f527-49bf-90e3-d4d34a07ebaf",
                                                "sense_id": "df4d6307-8be9-3bf6-baa2-0a2e9da924da",
                                                "text": "Those in our movement who are Black and must straddle two movements, fighting the racism of the gay community along with the heterosexism in white institutions and in communities of color."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e2af8d8a-2ab0-3d4c-ab43-0d46383e4d8a",
                                        "entry_id": "28f9936f-3aad-37a4-9216-eb6fe821e2c2",
                                        "glosses": [
                                            "To consider or favor two apparently opposite sides; to be noncommittal."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dcf29a70-a492-4284-86b3-f7cf2768835e",
                                                "sense_id": "e2af8d8a-2ab0-3d4c-ab43-0d46383e4d8a",
                                                "text": "Wanting to please both sides, he straddled the issue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "64b84254-5cef-35ef-a70c-ea30702add43",
                                        "entry_id": "28f9936f-3aad-37a4-9216-eb6fe821e2c2",
                                        "glosses": [
                                            "To form a disorderly sprawl; to spread out irregularly."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "12859d36-b967-4407-afa8-c1ea959b1537",
                                                "sense_id": "64b84254-5cef-35ef-a70c-ea30702add43",
                                                "text": "This weed straddles the entire garden."
                                            },
