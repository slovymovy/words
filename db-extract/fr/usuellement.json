                "senses": [
                    {
                        "sense_id": "9ac14eb4-7cad-31a5-849f-ac604c08e028",
                        "entry_id": "c4902137-c942-3dad-a56d-d9d079eb0ab7",
                        "glosses": [
                            "Communément ; à l’ordinaire ; d’une manière usuelle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0dcce0f6-8609-4c23-91c4-880d218e358c",
                                "sense_id": "9ac14eb4-7cad-31a5-849f-ac604c08e028",
                                "text": "Les opérations de broyage marquent usuellement le terme des opérations d’épuration des fines, que celles-ci soient destinées à l’agglomération ou à la carbonisation."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c06fa7a2-f6b1-430a-95f9-10c5da24b77c",
                        "source_entry_id": "c4902137-c942-3dad-a56d-d9d079eb0ab7",
                        "source_sense_id": "9ac14eb4-7cad-31a5-849f-ac604c08e028",
                        "target_lang_word": "gewöhnlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gewöhnlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d90e5ab9-0a36-35e1-973f-6ba68f210cf6",
                                        "entry_id": "d64866d2-e272-357d-aea8-9062249b5f69",
                                        "glosses": [
                                            "so, wie unter diesen Umständen meist oder immer"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "73cc8492-2ee0-4285-b949-487c64a94afa",
                                                "sense_id": "d90e5ab9-0a36-35e1-973f-6ba68f210cf6",
                                                "text": "Sie antwortete wie gewöhnlich."
                                            },
                                            {
                                                "example_id": "4b933060-adcc-45a2-9f3f-100af430f620",
                                                "sense_id": "d90e5ab9-0a36-35e1-973f-6ba68f210cf6",
                                                "text": "Für gewöhnlich sind sie pünktlich."
                                            },
                                            {
                                                "example_id": "ff0e8436-8d02-4b12-b2a3-b4d4f45e846d",
                                                "sense_id": "d90e5ab9-0a36-35e1-973f-6ba68f210cf6",
                                                "text": "Das ist ein für eine Mutter ganz gewöhnliches Verhalten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4c1b6de5-e564-3994-bb36-33df2746ea3a",
                                        "entry_id": "d64866d2-e272-357d-aea8-9062249b5f69",
                                        "glosses": [
                                            "keine besonderen Merkmale aufweisend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d429e30e-a582-450e-8487-c0737079b56d",
                                                "sense_id": "4c1b6de5-e564-3994-bb36-33df2746ea3a",
                                                "text": "Wir alle sind gewöhnliche Sterbliche."
                                            },
                                            {
                                                "example_id": "1e2a1a3a-3c38-4563-a88d-a12abe3c3e0a",
                                                "sense_id": "4c1b6de5-e564-3994-bb36-33df2746ea3a",
                                                "text": "Wie kann aus einem ganz gewöhnlichen Menschen plötzlich ein Verbrecher werden?"
                                            },
                                            {
                                                "example_id": "ce71aafb-f960-437f-9e03-a8a53156196b",
                                                "sense_id": "4c1b6de5-e564-3994-bb36-33df2746ea3a",
                                                "text": "„Schließlich waren die Richter des Athener Gerichts, der Heliaia ebenso wie die Teilnehmer an der Volksversammlung keine Rechtsexperten, sondern gewöhnliche Bürger.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "31287f72-57d0-3dfa-9237-a9cff7619999",
                                        "entry_id": "d64866d2-e272-357d-aea8-9062249b5f69",
                                        "glosses": [
                                            "von niederer Erziehung seiend"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2c3e45ea-74df-413e-b214-62f71fff0413",
                                                "sense_id": "31287f72-57d0-3dfa-9237-a9cff7619999",
                                                "text": "Das Benehmen dieses Kerls ist mir zu gewöhnlich (= zu unfein, grob)."
                                            },
                                            {
                                                "example_id": "860e7544-33e3-442d-a3ed-bf581b6eb6f4",
                                                "sense_id": "31287f72-57d0-3dfa-9237-a9cff7619999",
                                                "text": "Er hat gar zu gewöhnliche Manieren."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d97e97bf-f45c-4205-ad2a-36f1e1348d68",
