                            {
                                "example_id": "2a7b5c02-fff7-4333-b83a-b1c037d00cb2",
                                "sense_id": "f6cf9ebc-80a2-32a7-ae50-15673f4e8c66",
                                "text": "„Zum Abschluss der 62. Generalversammlung kamen knapp 300 Entscheidungsträger aus Medien, Politik, Werbung und Wirtschaft zum traditionellen Heurigenabend des Verbandes Österreichischer Zeitungen beim Heurigen \"Zum Martin Sepp\" in der Wiener Cobenzlgasse.“"
                            },
                            {
                                "example_id": "274350e5-8d12-4d4e-a3be-1577d866b7da",
                                "sense_id": "f6cf9ebc-80a2-32a7-ae50-15673f4e8c66",
                                "text": "„Ein Heurigenabend Haeussermans für den Regisseur Leopold Lindtberg kostete fast 21.000 Schilling, in den 1960er-Jahren eine stattliche Summe.“"
                            }
                        ],
