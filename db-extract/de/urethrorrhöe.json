                ],
                "senses": [
                    {
                        "sense_id": "1a0bf8d7-a373-3bc9-9c4c-5952e1ac9499",
                        "entry_id": "0b08dd99-8def-3478-9359-1bd5e895b277",
                        "glosses": [
                            "Harnröhrenausfluss (Vergleiche Urethra)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5fc49cc5-fc37-4011-8bdd-d1b8c9b43b1c",
                                "sense_id": "1a0bf8d7-a373-3bc9-9c4c-5952e1ac9499",
                                "text": "„Als secretorische Neurosen nennt er die der Nieren, die sich als Polyurie, Anurie, Phosphaturie, Gaucurie äussern, dann die der Hoden (Polyspermie, Aspermatie), die der Prostata (Prostatorrhöe), die der Cowper’schen und Littré’schen Drüsen (Urethrorrhöe).“"
                            },
                            {
                                "example_id": "77ebb32c-3fa2-4862-83a0-a70ec74844bc",
                                "sense_id": "1a0bf8d7-a373-3bc9-9c4c-5952e1ac9499",
                                "text": "„So entsteht oftmals ein krankhafter Ausfluss aus diesen Partien[…] durch Einwirkung eines rheumatischen Reizes[.] Ja, selbst in Folge von heftigen Schmerzen während eines Zahndurchbruchs soll sich – auf die gleiche Weise, wie in diesem Zustande oftmals Diarrhöe entstehet – mehrmals bei einem und demselben Individuum Urethrorrhöe gebildet haben.“"
                            },
                            {
                                "example_id": "21616075-32a9-42fc-8f14-cad075ea52aa",
                                "sense_id": "1a0bf8d7-a373-3bc9-9c4c-5952e1ac9499",
                                "text": "„Wie die Urethraldrüsen, deren vermehrte Sekretion die Urethrorrhöe bedingt, so sondern auch die Präputialdrüsen abnorm ab und veranlassen einen chronischen Feuchtigkeitszustand des Präputialsackes“"
                            },
                            {
                                "example_id": "19d8bfc1-3d5d-426c-95df-8b216a34f7a5",
                                "sense_id": "1a0bf8d7-a373-3bc9-9c4c-5952e1ac9499",
                                "text": "„Die ›Urethrorrhöe‹ wird nach Verf. in kurzer Zeit durch heisse Kaliumpermanganatspülungen und Bougiebehandlung beseitigt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
