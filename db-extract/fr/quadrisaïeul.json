                                        "glosses": [
                                            "отец прапрадеда или прапрабабушки, прадед деда или бабушки"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5b33f5f-f3e3-4c52-a051-ad650e616537",
                                                "sense_id": "ee422855-2928-3d3c-8bcd-1056ca377d9c",
                                                "text": "Стихи эти описывали моего прапрапрадеда ― Андрея Полисадова, вернее, нашу семейную легенду о нем."
                                            }
