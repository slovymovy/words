{
    "word_family": [
        "itchy",
        "itchiness",
        "unitchy"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "db63c936-1cf2-373f-a436-e7a88ed08587",
                    "sense_definition": "A sensation felt on an area of the skin that causes a person or animal to want to scratch said area.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "physical sensation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mosquito bite on my arm left a persistent <w>itch</w> that I could not ignore.",
                            "target_lang_translations": {
                                "ru": "Комариный укус на руке оставил стойкий <w>зуд</w>, который я не мог игнорировать."
                            }
                        },
                        {
                            "text": "He felt a sudden <w>itch</w> on his back but could not reach it to scratch.",
                            "target_lang_translations": {
                                "ru": "Он почувствовал внезапный <w>зуд</w> на спине, но не мог дотянуться, чтобы почесаться."
                            }
                        }
                    ],
                    "synonyms": [
                        "yuck",
                        "yuik",
                        "yeuk"
                    ],
                    "common_phrases": [
                        "persistent itch",
                        "scratch an itch"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ощущение на участке кожи, вызывающее желание почесаться."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зуд",
                                "target_lang_sense_clarification": "физическое ощущение"
                            },
                            {
                                "target_lang_word": "свербёж",
                                "target_lang_sense_clarification": "разговорное обозначение зуда"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9a5c4c8c-776f-384a-848a-39fa9b108e47",
                    "sense_definition": "A constant teasing desire or strong urge to do something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "desire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After years of living in the city, she felt a sudden <w>itch</w> to move to the countryside.",
                            "target_lang_translations": {
                                "ru": "После многих лет жизни в городе она почувствовала внезапную <w>жажду</w> переехать в сельскую местность."
                            }
                        },
                        {
                            "text": "He had a seven-year <w>itch</w> to change his career and try something completely new.",
                            "target_lang_translations": {
                                "ru": "У него возникло непреодолимое <w>желание</w> сменить карьеру и попробовать что-то совершенно новое."
                            }
                        }
                    ],
                    "common_phrases": [
                        "seven-year itch",
                        "itch to travel"
                    ],
                    "target_lang_definitions": {
                        "ru": "Постоянное дразнящее желание или сильное стремление что-то сделать."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зуд",
                                "target_lang_sense_clarification": "переносное значение, беспокойство"
                            },
                            {
                                "target_lang_word": "жажда",
                                "target_lang_sense_clarification": "сильное стремление к чему-либо"
                            },
                            {
                                "target_lang_word": "свербёж",
                                "target_lang_sense_clarification": "ироничное обозначение навязчивого желания"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0962e801-ec36-3fde-8a12-3c6724d93b12",
                    "sense_definition": "To feel a sensation on the skin that creates a need to be scratched.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "physical sensation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My eyes began to <w>itch</w> terribly because of the high pollen count in the air.",
                            "target_lang_translations": {
                                "ru": "Мои глаза начали ужасно <w>чесаться</w> из-за высокого содержания пыльцы в воздухе."
                            }
                        },
                        {
                            "text": "Does your wool sweater make your skin <w>itch</w> when you wear it?",
                            "target_lang_translations": {
                                "ru": "Твой шерстяной свитер заставляет кожу <w>чесаться</w>, когда ты его носишь?"
                            }
                        }
                    ],
                    "common_phrases": [
                        "eyes itch",
                        "skin starts to itch"
                    ],
                    "target_lang_definitions": {
                        "ru": "Испытывать ощущение на коже, вызывающее потребность почесаться."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чесаться",
                                "target_lang_sense_clarification": "о коже или частях тела"
                            },
                            {
                                "target_lang_word": "зудеть",
                                "target_lang_sense_clarification": "испытывать зуд"
                            },
                            {
                                "target_lang_word": "свербеть",
                                "target_lang_sense_clarification": "разговорное, о зуде"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "faac0152-9a3e-3104-a865-bd688a78d3b8",
                    "sense_definition": "To have a constant urge or feel strongly motivated to do something.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "desire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He has been <w>itching</w> for opportunities to practice his driving skills since he got his permit.",
                            "target_lang_translations": {
                                "ru": "Он <w>рвется</w> практиковать свои навыки вождения с тех пор, как получил права."
                            }
                        },
                        {
                            "text": "The team was <w>itching</w> to start the game after weeks of intense training.",
                            "target_lang_translations": {
                                "ru": "Команда <w>горела желанием</w> начать игру после недель интенсивных тренировок."
                            }
                        }
                    ],
                    "common_phrases": [
                        "itching to go",
                        "itching for a fight"
                    ],
                    "target_lang_definitions": {
                        "ru": "Иметь постоянное стремление или чувствовать сильную мотивацию что-то сделать."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рваться",
                                "target_lang_sense_clarification": "сильно стремиться к действию"
                            },
                            {
                                "target_lang_word": "гореть желанием",
                                "target_lang_sense_clarification": "очень сильно хотеть"
                            },
                            {
                                "target_lang_word": "свербеть",
                                "target_lang_sense_clarification": "безличное, о непреодолимом желании"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2221bfb6-f146-3250-8bf8-88efbc9b2ab9",
                    "sense_definition": "To scratch or rub a part of the body to relieve an unpleasant sensation.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "physical sensation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The guard pointed his gun toward the road and <w>itched</w> his chin with the other hand.",
                            "target_lang_translations": {
                                "ru": "Охранник направил пистолет в сторону дороги и <w>почесал</w> подбородок другой рукой."
                            }
                        },
                        {
                            "text": "He <w>itched</w> his neck while trying to decide if he should answer the question.",
                            "target_lang_translations": {
                                "ru": "Он <w>почесывал</w> шею, пытаясь решить, стоит ли отвечать на вопрос."
                            }
                        }
                    ],
                    "synonyms": [],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used as a synonym for 'scratch' in some dialects"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Чесать или тереть часть тела, чтобы облегчить неприятное ощущение."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чесать",
                                "target_lang_sense_clarification": "избавляться от зуда"
                            },
                            {
                                "target_lang_word": "почесать",
                                "target_lang_sense_clarification": "однократное действие"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cae4f8c5-9e9d-38d3-969b-f6608d041789",
                    "sense_definition": "To cause a part of the body to feel an irritating sensation.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "physical sensation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My head is suddenly <w>itching</w> me like mad after walking through those tall weeds.",
                            "target_lang_translations": {
                                "ru": "Моя голова внезапно начала <w>чесаться</w> как сумасшедшая после прогулки по тем высоким сорнякам."
                            }
                        },
                        {
                            "text": "This new laundry detergent seems to be <w>itching</w> my skin whenever I wear these clothes.",
                            "target_lang_translations": {
                                "ru": "Кажется, этот новый стиральный порошок <w>раздражает</w> мою кожу всякий раз, когда я надеваю эти вещи."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Transitive use is less common in standard English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вызывать раздражающее ощущение в какой-либо части тела."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "раздражать",
                                "target_lang_sense_clarification": "вызывать зуд на коже"
                            },
                            {
                                "target_lang_word": "чесаться",
                                "target_lang_sense_clarification": "в значении 'вызывать зуд'"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}
