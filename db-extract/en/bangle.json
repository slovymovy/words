                    {
                        "translation_id": "9ac4d51a-471f-4df9-8a95-919c381f7f39",
                        "source_entry_id": "12571518-f91a-386f-8e39-f1ea47c4b537",
                        "source_sense_id": "9e7f1230-539b-3cd2-94be-c1ddc95cb28c",
                        "source_sense_description": "a rigid bracelet or anklet, especially one with no clasp",
                        "target_lang_word": "Armreifen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Armreifen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a48b281c-9e52-3351-ab99-dcee338517be",
                                        "entry_id": "0eb507e4-ed78-3642-aeea-2f60fd8a040e",
                                        "glosses": [
                                            "Reif, der als Schmuck am Arm/Handgelenk getragen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1dcdcc2-a942-45b9-a54a-ff5daf686ae4",
                                                "sense_id": "a48b281c-9e52-3351-ab99-dcee338517be",
                                                "text": "„Der vormalige Eigentümer des Armreifens, der zum Eigentümer einer Halskette geworden ist, kann mit dieser verfahren, wie er will.“"
                                            },
                                            {
                                                "example_id": "f2dc24aa-c5b9-4a74-a821-7e69c00162cf",
                                                "sense_id": "a48b281c-9e52-3351-ab99-dcee338517be",
                                                "text": "„Ohne den Prolog würde für den Leser nicht ersichtlich werden, warum der Anblick des Armreifens Lydia dermaßen aus der Bahn wirft, da sie lange nicht in der Lage ist, überhaupt zu sprechen.“"
                                            },
                                            {
                                                "example_id": "d8d92ef6-f8ee-41c1-9545-40e8891a6eea",
                                                "sense_id": "a48b281c-9e52-3351-ab99-dcee338517be",
                                                "text": "„Nur die Armreifen, die an ihrem Handgelenk bei jeder Bewegung klimpern, sind neu.“"
                                            },
                                            {
                                                "example_id": "99ec27c1-b001-4719-bb9d-6613d1937dcd",
                                                "sense_id": "a48b281c-9e52-3351-ab99-dcee338517be",
                                                "text": "„Die Archäologen haben in dem Areal Gegenstände aus der Keltenzeit freigelegt: Armreifen und Halsringe, Waffen und Gewandspangen, Teller und Vasen.“"
                                            },
                                            {
                                                "example_id": "84a7dbc5-ee66-471b-8a3b-ed5d29b9f03a",
                                                "sense_id": "a48b281c-9e52-3351-ab99-dcee338517be",
                                                "text": "„Seine Mutter streifte sich die Ringe von den Fingern und die Armreifen von den Handgelenken und reichte Bobby den Schatz hinüber.“"
                                            },
                                            {
                                                "example_id": "d7c7b702-3d72-4491-bf0b-a79eba4d9a56",
                                                "sense_id": "a48b281c-9e52-3351-ab99-dcee338517be",
                                                "text": "„Armreifen werden daraus hergestellt, die gläubige Hindufrauen traditionell zerbrechen, wenn ihr Ehemann stirbt.“"
                                            },
                                            {
                                                "example_id": "2948a597-400b-4d03-a108-ff72f599b206",
                                                "sense_id": "a48b281c-9e52-3351-ab99-dcee338517be",
                                                "text": "„In Wahrheit sind die Armreifen, Kronen oder Ketten allerdings aus Gold!“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
