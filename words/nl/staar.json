                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stare",
                                "target_lang_sense_clarification": "imperative form"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "865337fb-9f2c-3b4b-bfda-0388a547ead9",
                    "sense_definition": "Tweede persoon enkelvoud tegenwoordige tijd van <w>staren</w> (bij inversie).",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "staren_vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Waarom <w>staar</w> je zo verbaasd naar mijn nieuwe kapsel?",
                            "target_lang_translations": {
                                "en": "Why do you <w>stare</w> so surprisedly at my new haircut?"
                            }
                        },
                        {
                            "text": "Als je zo diep in gedachten bent, <w>staar</w> je altijd naar de grond.",
                            "target_lang_translations": {
                                "en": "When you are so deep in thought, you always <w>stare</w> at the ground."
                            }
