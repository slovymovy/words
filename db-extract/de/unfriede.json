                        "target_lang_word": "strife",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "strife",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ef089fd9-52c2-31bf-a95d-4efddfcfdbf2",
                                        "entry_id": "697aa73d-c332-3ef6-891f-6e7ec210539e",
                                        "glosses": [
                                            "Striving; earnest endeavor; hard work."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c5dc74a9-637e-35c8-9faf-9ce80b393f0a",
                                        "entry_id": "697aa73d-c332-3ef6-891f-6e7ec210539e",
                                        "glosses": [
                                            "Exertion or contention for superiority, either by physical or intellectual means."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f819040a-ce74-410d-bbd7-e579c0847f20",
                                                "sense_id": "c5dc74a9-637e-35c8-9faf-9ce80b393f0a",
                                                "text": "From forth the fatal loins of these two foes\nA pair of star-cross'd lovers take their life;\nWhose misadventured piteous overthrows\nDo with their death bury their parents' strife."
                                            },
                                            {
                                                "example_id": "0b5b61ac-3ce4-4ac2-9fb3-0882702aac8a",
                                                "sense_id": "c5dc74a9-637e-35c8-9faf-9ce80b393f0a",
                                                "text": "Hee is proud, knowing nothing, but doting about questions, and ſtrifes of wordes,[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "05b81506-8e04-37ab-9e47-fdf00953b8ef",
                                        "entry_id": "697aa73d-c332-3ef6-891f-6e7ec210539e",
                                        "glosses": [
                                            "Bitter conflict, sometimes violent."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2ef43373-320a-4329-8707-f487471bbb3e",
                                                "sense_id": "05b81506-8e04-37ab-9e47-fdf00953b8ef",
                                                "text": "A few observations about the interpretation of vows or pledges may not be out of place here. Interpretation of pledges has been a fruitful source of strife all the world over. No matter how explicit the pledge, people will turn and twist the text to suit their own purposes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "038c7ee2-2002-367d-ab54-90f07ea729c7",
                                        "entry_id": "697aa73d-c332-3ef6-891f-6e7ec210539e",
                                        "glosses": [
                                            "A trouble of any kind."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "19cd7da3-37da-3065-af50-61134157a4b7",
                                        "entry_id": "697aa73d-c332-3ef6-891f-6e7ec210539e",
                                        "glosses": [
                                            "That which is contended against; occasion of contest."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c0b8b4fd-2956-4423-827f-7438ce84837f",
                                                "sense_id": "19cd7da3-37da-3065-af50-61134157a4b7",
                                                "text": "He ſpide lamenting her unlucky ſtrife,"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
