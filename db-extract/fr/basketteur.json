                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f4f0586-7b9a-497b-b75b-4fac5f496bb8",
                                "sense_id": "6592b5f2-f7f8-3221-9289-80342dc9519a",
                                "text": "Il mesure deux mètres, il est beau, rassurant, avec des paluches de basketteur."
                            },
                            {
                                "example_id": "b350915f-a7a1-40b1-9b1f-af36f8f5bf15",
                                "sense_id": "6592b5f2-f7f8-3221-9289-80342dc9519a",
                                "text": "Le basketteur français Victor Wembanyama encensé par LeBron James en personne"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6099757c-64dc-46f2-b2f8-79ac1d838d65",
