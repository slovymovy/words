                        "examples": [
                            {
                                "example_id": "f2ceb75d-88c0-4f09-b9e9-3e2b78810533",
                                "sense_id": "3a1c81fe-9fef-347e-9008-a90290570cd2",
                                "text": "Un avertissement liminaire : cette notule n’émane pas d’un pointu cortophile, juste d’un lecteur dilettante qui, adolescent, feuilleta avec quelque négligence les albums du marin, sans jamais verser dans l’adoration."
                            },
                            {
                                "example_id": "73aadb43-f4a0-47ad-be87-b2d1c3c0ba98",
                                "sense_id": "3a1c81fe-9fef-347e-9008-a90290570cd2",
                                "text": "Bref, un bel été pour les cortophiles..."
                            },
                            {
                                "example_id": "97498376-4fe5-40e9-9562-37cf496b0826",
                                "sense_id": "3a1c81fe-9fef-347e-9008-a90290570cd2",
                                "text": "Comme probablement beaucoup de cortophiles, j’avais dressé l’oreille aux rumeurs successives d’une renaissance éditoriale de la série Corto Maltese."
