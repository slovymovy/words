                    {
                        "translation_id": "ff508362-cdaf-4ecb-888c-9a2c86e32ce1",
                        "source_entry_id": "be56ebdb-9ca2-35b7-b369-14bb2d5d6c9c",
                        "source_sense_id": "a31e4d54-70e5-34ed-bc62-b6bf75b657cc",
