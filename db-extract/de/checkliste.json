                                "target_senses": [
                                    {
                                        "sense_id": "4079d985-372c-3a53-a1d8-663442ef78bb",
                                        "entry_id": "ff974d9b-3c02-3b50-839c-531ab237a249",
                                        "glosses": [
                                            "To add to a checklist."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "052ee43a-3f03-4467-9399-25221f382e9a",
                                                "sense_id": "4079d985-372c-3a53-a1d8-663442ef78bb",
                                                "text": "It was like he was checklisting the steps of brushing your teeth. Everyone knows how to brush your teeth—you do it automatically—so what good would a checklist do?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
