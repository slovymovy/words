                    {
                        "sense_id": "eb486e8a-5d6d-3d44-97bf-b88a4fb6e33e",
                        "entry_id": "2032832c-83f1-37ee-9bba-bcf7c04e3b7e",
                        "glosses": [
                            "Celle dont le métier est de rendre des films, des spectacles ou des expositions, accessibles aux personnes aveugles ou malvoyantes grâce à un texte en voix off qui décrit les éléments visuels de l’œuvre."
                        ],
                        "tags": [
                            "Audiovisuel"
                        ],
                        "examples": [
                            {
                                "example_id": "5096d115-3412-4f43-bed5-4dc82471714c",
                                "sense_id": "eb486e8a-5d6d-3d44-97bf-b88a4fb6e33e",
                                "text": "C’est en tout cas la conclusion à laquelle en arrivent des aveugles rassemblés pour donner leur avis sur la traduction en mots d’un film que vient de leur lire Misako, une jeune et charmante audiodescriptrice."
                            },
                            {
                                "example_id": "e18301f0-df50-47d4-8176-947152b92872",
                                "sense_id": "eb486e8a-5d6d-3d44-97bf-b88a4fb6e33e",
                                "text": "Installée en régie, l’audiodescriptrice, Juliette Soulat, fera donc partie intégrante du spectacle, dont elle relayera ce que l’œil ne perçoit plus ou mal : les jeux de lumières, ce qu’il se passe pendant les temps morts"
                            }
                        ]
                    }
