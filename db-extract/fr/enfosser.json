                "senses": [
                    {
                        "sense_id": "29a3e4b9-ca3c-3a02-8305-fe59137f9e1a",
                        "entry_id": "c27904f4-de71-31ce-a6b1-169e1513a8a5",
                        "glosses": [
                            "Mettre dans une fosse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d12535d4-aaa9-4f0e-8bc8-dfa38b176362",
                                "sense_id": "29a3e4b9-ca3c-3a02-8305-fe59137f9e1a",
                                "text": "M. Fossart avait envoyé au concours général de Paris un bocal des pulpes de sa farbique, enfossées depuis 7 mois et dans un état parfait de conservation; mais, le bocal n'ayant pas été présenté dans les délais voulus, a été impitoyablement écarté par les commissaires."
                            },
                            {
                                "example_id": "7d3e818c-479b-4bfe-8689-cd9a7187047c",
                                "sense_id": "29a3e4b9-ca3c-3a02-8305-fe59137f9e1a",
                                "text": "Jusqu'alors les pulpes de ditillerie agricole par macération ne s'enfossaient guère, parce qu'elles perdaient 60 % de leur poids, et on attendait pour commencer la fabrication, la rentrée des troupeaux à l'étable."
                            }
                        ]
                    }
