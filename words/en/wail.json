                            },
                            {
                                "target_lang_word": "вой",
                                "target_lang_sense_clarification": "протяжный плач или крик"
                            },
                            {
                                "target_lang_word": "стенание",
                                "target_lang_sense_clarification": "жалобный стон или плач"
                            }
                        ],
