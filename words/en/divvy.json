        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "632b7d7e-b910-3a98-b868-a3ccdce7429f",
                    "sense_definition": "To divide into portions",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "divide",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We <w>divvied</w> the money into equal portions to split between us.",
                            "target_lang_translations": {
                                "fr": "Nous avons <w>partagé</w> l'argent en parts égales pour le répartir entre nous.",
                                "cs": "Peníze jsme <w>rozdělili</w> na stejné díly, abychom se o ně podělili.",
                                "ru": "Мы <w>разделили</w> деньги на равные части, чтобы поделить их между собой."
                            }
                        },
                        {
                            "text": "It is a sordid business, this <w>divvying</w> us up by race.",
                            "target_lang_translations": {
                                "fr": "C'est une affaire sordide, ce fait de nous <w>diviser</w> selon la race.",
                                "cs": "Je to špinavá záležitost, tohle naše <w>rozdělování</w> podle rasy.",
                                "ru": "Это отвратительное дело — вот так <w>разделять</w> нас по расовому признаку."
                            }
                        }
                    ],
                    "synonyms": [
                        "distribute",
                        "allocate",
                        "share"
                    ],
                    "common_phrases": [
                        "divvy up"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Informal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Diviser quelque chose en plusieurs portions ou parts.",
                        "cs": "Rozdělit něco na několik částí nebo podílů.",
                        "ru": "Делить или распределять что-либо на части или доли (разговорное)"
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "partager",
                                "target_lang_sense_clarification": "Diviser une chose en plusieurs parties pour en faire la distribution."
                            },
                            {
                                "target_lang_word": "répartir",
                                "target_lang_sense_clarification": "Distribuer des éléments de manière organisée."
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "rozdělit",
                                "target_lang_sense_clarification": "Rozdělit celek na menší části."
                            },
                            {
                                "target_lang_word": "podělit se",
                                "target_lang_sense_clarification": "Rozdělit něco mezi více lidí."
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "делить",
                                "target_lang_sense_clarification": "разделять на доли"
                            },
                            {
                                "target_lang_word": "дерибанить",
                                "target_lang_sense_clarification": "жаргонное: делить, растаскивать"
                            },
                            {
                                "target_lang_word": "распределять",
                                "target_lang_sense_clarification": "раздавать по частям"
                            }
                        ]
                    }
                }
            ]
        },
        {
