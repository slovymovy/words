    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "82e76367-3711-378f-bf82-46ee26537bc9",
                "word": "Mart",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "457c0984-32ae-3e3f-9185-6a4382800e23",
                        "entry_id": "82e76367-3711-378f-bf82-46ee26537bc9",
                        "glosses": [
                            "A diminutive of the male given name Martin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c447320f-654d-4c69-97d0-f03eb3b88527",
                                "sense_id": "457c0984-32ae-3e3f-9185-6a4382800e23",
                                "text": "He looked at me when introduced and said “Mart's boy!” 'I was in fact Martin's grandson, but didn't bother splitting hairs — […]"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "e1eff10e-d4c9-396b-9110-43f375315129",
                "word": "mart",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "67f0db2c-b55a-4aa6-8276-f5e7be3c0ea8",
                        "entry_id": "e1eff10e-d4c9-396b-9110-43f375315129",
                        "tags": [
                            "plural"
                        ],
                        "form": "marts"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f06beed3-07af-3e48-bc01-e997d56e8d36",
                        "entry_id": "e1eff10e-d4c9-396b-9110-43f375315129",
                        "glosses": [
                            "A shop, a store, a market."
                        ],
                        "tags": [
                            "Canada",
                            "Philippines",
                            "US",
                            "in-compounds",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "be062059-686d-44f9-85bc-e962cc01baac",
                                "sense_id": "f06beed3-07af-3e48-bc01-e997d56e8d36",
                                "text": "FedMart, Walmart, Kmart, Kwik-E-Mart"
                            }
                        ]
                    },
                    {
                        "sense_id": "b067fe35-899b-34a0-a2dc-49de7f07afdb",
                        "entry_id": "e1eff10e-d4c9-396b-9110-43f375315129",
                        "glosses": [
                            "A bazaar, fair, market, or marketplace."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb163346-8930-4427-bd20-85af00312668",
                                "sense_id": "b067fe35-899b-34a0-a2dc-49de7f07afdb",
                                "text": "In that day, drovers would drive their cattle to the marts on the coast."
                            },
                            {
                                "example_id": "fb282cf4-4e81-4c4e-aa3a-f8b1ff220a0e",
                                "sense_id": "b067fe35-899b-34a0-a2dc-49de7f07afdb",
                                "text": "Perhaps ſome Merchant hath inuited him,\n And from the Mart he's ſomewhere gone to dinner:\n Good Siſter let vs dine, and neuer fret;\n A man is Maſter of his libertie:"
                            },
                            {
                                "example_id": "60c35f94-6247-4daf-aae7-18cc2e7cd280",
                                "sense_id": "b067fe35-899b-34a0-a2dc-49de7f07afdb",
                                "text": "And by great waters the seede of Sihor, the haruest of the riuer is her reuenew, and she is a mart of nations."
                            },
                            {
                                "example_id": "b2d7af4a-39a0-4a4a-81e2-eb671c932686",
                                "sense_id": "b067fe35-899b-34a0-a2dc-49de7f07afdb",
                                "text": "In London; where has commerce ſuch a mart,\n So rich, ſo throng'd, ſo drain'd, and ſo ſupplied,\n As London, opulent, enlarged, and ſtill\n Increaſing, London?"
                            },
                            {
                                "example_id": "1af492d8-8c87-4e53-bf74-c351b6768a83",
                                "sense_id": "b067fe35-899b-34a0-a2dc-49de7f07afdb",
                                "text": "The world is a great mart, my Holly, where all things are for sale to him who bids the highest in the currency of our desires."
                            },
                            {
                                "example_id": "d9a3bab8-65f9-46a4-a2bd-d4b9342b0c85",
                                "sense_id": "b067fe35-899b-34a0-a2dc-49de7f07afdb",
                                "text": "The bold little ships even broke through the Gates of Hercules to the open ocean, coasting then northward to take the gold of Ireland and the tin of Cornwall, as well as southward, around the bulge of Senegal, to remote Yorubaland and the distant marts of ivory, gold, and slaves."
                            }
                        ]
                    },
                    {
                        "sense_id": "e524e422-d056-32c2-b5e6-482f233edb0f",
                        "entry_id": "e1eff10e-d4c9-396b-9110-43f375315129",
                        "glosses": [
                            "A bargain."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "7d03aa53-2808-42c8-a643-22bff90768d5",
                                "sense_id": "e524e422-d056-32c2-b5e6-482f233edb0f",
                                "text": "Faith Gentlemen now I play a marchants part,\n And venture madly on a deſperate Mart."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
