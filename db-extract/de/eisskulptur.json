                "senses": [
                    {
                        "sense_id": "941fe173-5214-3219-b4ea-3080e8af9f5d",
                        "entry_id": "653a6e0d-f12c-3b41-a0a3-1767c5357f30",
                        "glosses": [
                            "Skulptur, gefertigt aus Eis"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f73e8886-55b7-4c03-8119-868359ad0fb9",
                                "sense_id": "941fe173-5214-3219-b4ea-3080e8af9f5d",
                                "text": "„Das Kind sei am Sonntagabend von einer Eisskulptur erschlagen worden, teilte die Polizei mit.“"
                            },
                            {
                                "example_id": "68f22bb9-2576-4d60-bd52-1bd41b130c59",
                                "sense_id": "941fe173-5214-3219-b4ea-3080e8af9f5d",
                                "text": "„Eine schmelzende Eisskulptur auf dem eigentlich für Premier Boris Johnson vorgesehenen Platz bei einer TV-Debatte über Klimaschutz hat bei seinen britischen Konservativen für Empörung gesorgt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
