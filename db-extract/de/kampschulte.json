                "senses": [
                    {
                        "sense_id": "52ed4eb3-0385-3893-8887-17ad4c567786",
                        "entry_id": "f3c48fac-d6dd-3e39-be7e-221554cd37c1",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c757d96d-d286-4f71-9bdf-c793e6299bd9",
                                "sense_id": "52ed4eb3-0385-3893-8887-17ad4c567786",
                                "text": "Frau Kampschulte ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "f0e7bd73-72b5-41d6-a4cc-e086097fdd8e",
                                "sense_id": "52ed4eb3-0385-3893-8887-17ad4c567786",
                                "text": "Herr Kampschulte wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "5e2bf09d-5cb9-4c50-a5c2-4af1284f3323",
                                "sense_id": "52ed4eb3-0385-3893-8887-17ad4c567786",
                                "text": "Die Kampschultes fliegen heute nach Liverpool."
                            },
                            {
                                "example_id": "afa02a49-480a-48fb-95d9-ca456b9d36fa",
                                "sense_id": "52ed4eb3-0385-3893-8887-17ad4c567786",
                                "text": "Der Kampschulte trägt nie die Pullover, die die Kampschulte ihm strickt."
                            },
                            {
                                "example_id": "efd45554-8556-4eab-84fb-fc58ad22133f",
                                "sense_id": "52ed4eb3-0385-3893-8887-17ad4c567786",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Kampschulte kommt, geht der Herr Kampschulte.“"
                            },
                            {
                                "example_id": "59ef59ee-07ce-4a41-87fe-2b78639e4dd8",
                                "sense_id": "52ed4eb3-0385-3893-8887-17ad4c567786",
                                "text": "Kampschulte kommt und geht."
                            },
                            {
                                "example_id": "7cb782ab-4d7d-4b1a-9fc2-fe309fd2fc7d",
                                "sense_id": "52ed4eb3-0385-3893-8887-17ad4c567786",
                                "text": "Kampschultes kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
