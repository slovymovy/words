                                                "example_id": "1f954a74-d523-4917-a9e7-64c64b500ee4",
                                                "sense_id": "a93ea56e-8137-3854-b01c-d2993cc29b64",
                                                "text": "Собирать грибы."
                                            },
                                            {
                                                "example_id": "17129497-6548-4f3c-9df9-62719f4bb225",
                                                "sense_id": "a93ea56e-8137-3854-b01c-d2993cc29b64",
                                                "text": "Собирать ягоды."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "34977e8e-220e-3344-b3ff-7ec6b13685d5",
                                        "entry_id": "56ca6e4a-f67d-3230-ad9e-4148f0ee105a",
                                        "glosses": [
                                            "перен. подготавливать кого-либо к отъезду"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "37acec5a-d49d-4d47-b280-965d33750f3a",
                                                "sense_id": "34977e8e-220e-3344-b3ff-7ec6b13685d5",
                                                "text": "Стал его тот самый прапорщик Купчук собирать в дорогу — шинель подогнал поновее, сухпаёк и всё такое."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3b458343-f1ad-30cf-890c-887ff42330dc",
                                        "entry_id": "56ca6e4a-f67d-3230-ad9e-4148f0ee105a",
                                        "glosses": [
                                            "получать сложный объект путём объединения его готовых частей"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "359ea9bc-1994-44eb-a9b6-61aec490c2a2",
                                                "sense_id": "3b458343-f1ad-30cf-890c-887ff42330dc",
                                                "text": "Собирать компьютеры."
                                            },
                                            {
                                                "example_id": "29f78f9b-e96f-4f00-be31-19bc8067142a",
                                                "sense_id": "3b458343-f1ad-30cf-890c-887ff42330dc",
                                                "text": "Собирать и разбирать автомат Калашникова."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "751cd56b-3f79-34f4-bf1d-42a0332b64d0",
                                        "entry_id": "56ca6e4a-f67d-3230-ad9e-4148f0ee105a",
                                        "glosses": [
                                            "получать что-либо от каждого субъекта, принадлежащего некоторому множеству"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ae16ded-0a70-4860-9b61-81de6862c3ba",
                                                "sense_id": "751cd56b-3f79-34f4-bf1d-42a0332b64d0",
                                                "text": "Партийный активист собирает взносы с членов партии."
                                            },
                                            {
                                                "example_id": "6c6f4f07-a202-48eb-ab32-2a1cf64ceb30",
                                                "sense_id": "751cd56b-3f79-34f4-bf1d-42a0332b64d0",
                                                "text": "Этот кандидат собрал на выборах наибольшее число голосов."
                                            },
                                            {
                                                "example_id": "bc716528-9951-49e3-b007-987004b07ae9",
                                                "sense_id": "751cd56b-3f79-34f4-bf1d-42a0332b64d0",
                                                "text": "Мы собираем деньги с родителей на обеды для детей."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9fdd5fb7-a7cd-43e6-9b19-91fd98bae940",
                        "source_entry_id": "d815d18b-558a-35f4-9f8d-fde7f0695b16",
                        "source_sense_description": "convene",
                        "target_lang_word": "созывать",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "созывать",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "61b8733a-b80c-3616-b1b9-0e5f65a20d36",
                                        "entry_id": "02d94c3b-638d-39c8-886e-e1e3b05d5cfe",
                                        "glosses": [
                                            "криком, сигналом собирать в одно место всех или многих"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f830db1-9062-41de-8648-c6474cf1dc68",
                                                "sense_id": "61b8733a-b80c-3616-b1b9-0e5f65a20d36",
                                                "text": "В городах целый день били в набат: созывали всех, но кто и для чего зовёт, никто не знал того, а все были в тревоге."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8b0742b3-7093-3712-9ddd-fafc704e1f29",
                                        "entry_id": "02d94c3b-638d-39c8-886e-e1e3b05d5cfe",
                                        "glosses": [
                                            "звать, приглашать куда-либо всех или многих"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "011f97d1-ada5-4f69-b015-e0df509f53ab",
                                                "sense_id": "8b0742b3-7093-3712-9ddd-fafc704e1f29",
                                                "text": "Перекрестись! Созывать мёртвых на новоселье! Экая страсть!"
                                            },
                                            {
                                                "example_id": "cf01b530-d33d-45e1-ace5-f4ed3677a6d2",
                                                "sense_id": "8b0742b3-7093-3712-9ddd-fafc704e1f29",
                                                "text": "— А паутину-то я всю с потолка сняла; теперь хоть женись, гостей созывай, так в ту ж пору…"
                                            },
                                            {
                                                "example_id": "796c80e2-0368-42ec-a20f-143c7622de91",
                                                "sense_id": "8b0742b3-7093-3712-9ddd-fafc704e1f29",
                                                "text": "Хозяин, желающий какое-нибудь дело справить разом в один день, созывает к себе соседей на работу и ставит за неё сытный обед с пивом и вином."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a512388-aae3-3cba-a24b-0d2281a4280c",
                                        "entry_id": "02d94c3b-638d-39c8-886e-e1e3b05d5cfe",
                                        "glosses": [
                                            "собирать участников какого-либо совещания, членов коллегиального органа и т. п. для работы, деятельности"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fafdda7c-37e1-4bb6-919f-459730cd613c",
                                                "sense_id": "3a512388-aae3-3cba-a24b-0d2281a4280c",
                                                "text": "Парламент остался в ожидании, но с 1566 по 1571 год королева его не созывала."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
