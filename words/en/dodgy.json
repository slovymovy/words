                    "target_lang_definitions": {
                        "ru": "Связанный с высоким уровнем риска или опасности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рискованный",
                                "target_lang_sense_clarification": "содержащий риск"
                            },
                            {
                                "target_lang_word": "опасный",
                                "target_lang_sense_clarification": "представляющий угрозу"
                            },
                            {
                                "target_lang_word": "стремный",
                                "target_lang_sense_clarification": "сленг: вызывающий опасение или страх"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aff3ee10-9808-3590-8123-b56a1b6160a4",
                    "sense_definition": "Evasive and shifty, often avoiding a direct answer or responsibility.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "dishonesty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "When asked about the missing funds, the spokesman gave a <w>dodgy</w> answer about legal ramifications.",
                            "target_lang_translations": {
                                "ru": "Когда его спросили о пропавших средствах, представитель дал <w>уклончивый</w> ответ о юридических последствиях."
                            }
                        },
                        {
                            "text": "He has a <w>dodgy</w> way of looking at you that makes you feel he is hiding something.",
                            "target_lang_translations": {
                                "ru": "У него какой-то <w>подозрительный</w> взгляд, из-за которого кажется, что он что-то скрывает."
                            }
                        }
                    ],
                    "synonyms": [
                        "dodge"
                    ],
                    "antonyms": [
                        "direct",
                        "straightforward"
                    ],
                    "common_phrases": [
                        "dodgy answer",
                        "dodgy look"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Describes a person's behavior or mannerisms."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Уклончивый и неискренний, часто избегающий прямого ответа или ответственности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уклончивый",
                                "target_lang_sense_clarification": "избегающий прямоты"
                            },
                            {
                                "target_lang_word": "изворотливый",
                                "target_lang_sense_clarification": "хитрый, умеющий выкручиваться"
                            },
                            {
                                "target_lang_word": "мутный",
                                "target_lang_sense_clarification": "сленг: неясный, подозрительный в поведении"
                            }
                        ]
