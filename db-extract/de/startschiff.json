                ],
                "senses": [
                    {
                        "sense_id": "e6a4813f-fd42-34d6-8959-96b03cc9fa27",
                        "entry_id": "ef1b5aaf-f6d3-3682-b0c7-4a900a5413d1",
                        "glosses": [
                            "Segelregatten: Boot, auf dem die Wettfahrtleitung die Signale für den Beginn einer Wettfahrt (unter anderem den Startschuss) gibt"
                        ],
                        "tags": [
                            "Wassersport"
                        ],
                        "examples": [
                            {
                                "example_id": "9471227c-a0a3-412c-9867-c8b38a4785e5",
                                "sense_id": "e6a4813f-fd42-34d6-8959-96b03cc9fa27",
                                "text": "Das Startschiff wird gegen den Wind betrachtet meist auf der Steuerbordseite der Startlinie verankert."
                            },
                            {
                                "example_id": "ae2821de-c36a-4c90-9120-00b76a0c49f6",
                                "sense_id": "e6a4813f-fd42-34d6-8959-96b03cc9fa27",
                                "text": "Bei sehr großen Startschiffen kann es in deren Lee eine Windabdeckung geben, durch die man kaum zur Startlinie kommt."
                            },
                            {
                                "example_id": "24df5e1f-176d-4915-bf54-4eb3d1dd8697",
                                "sense_id": "e6a4813f-fd42-34d6-8959-96b03cc9fa27",
                                "text": "„Das Startschiff liegt rechts, die meisten Segler starten üblicherweise auf Backbordbug.“"
                            },
                            {
                                "example_id": "f82dc640-2a8c-4c72-a093-70876c5544a8",
                                "sense_id": "e6a4813f-fd42-34d6-8959-96b03cc9fa27",
                                "text": "„In der Regel verläuft die Startlinie zwischen den Masten des Startschiffes (A) und einer Boje (B).“"
                            },
                            {
                                "example_id": "e942acb4-5d6e-47ff-bfd9-a3d7bb28a988",
                                "sense_id": "e6a4813f-fd42-34d6-8959-96b03cc9fa27",
                                "text": "„5 Minuten vor dem Start wird die Klassenflagge auf dem Startschiff gehisst, und es ertönt das akustische Ankündigungssignal.“"
                            },
                            {
                                "example_id": "07bcf4cd-79ea-47bc-8c76-147b5b76fb47",
                                "sense_id": "e6a4813f-fd42-34d6-8959-96b03cc9fa27",
                                "text": "„4 Minuten vor dem Start wird die Signalflagge P (Blauer Peter) am Startschiff gehisst, und es ertönt das Vorbereitungssignal.“"
                            },
                            {
                                "example_id": "0356bb6e-1ca4-4a49-869b-d1158ad37d98",
                                "sense_id": "e6a4813f-fd42-34d6-8959-96b03cc9fa27",
                                "text": "„Das Startschiff fuhr etwas früher 'raus und da es auf der Regattabahn ca. 30 kn maß, beschloss die Wettfahrtleitung nicht nochmal solch ein Risiko einzugehen und ließ Startverschiebung an Land hochziehen.“"
                            },
                            {
                                "example_id": "d65bf4a9-a50b-4b8c-85f7-2fa84f0b3927",
                                "sense_id": "e6a4813f-fd42-34d6-8959-96b03cc9fa27",
                                "text": "„Die erste Boje oder Lee-Boje (3) bildet meist zusammen mit dem Startschiff die Startlinie. Die Startlinie wird ungefähr quer zur Windrichtung ausgelegt.“"
                            },
                            {
                                "example_id": "6d05bba4-53df-492e-860b-4fc157e32d12",
                                "sense_id": "e6a4813f-fd42-34d6-8959-96b03cc9fa27",
                                "text": "„Die Ziellinie wird dann meist von der Luv-Boje (1) und dem Startschiff gebildet, das dazu während der Wettfahrt von der Lee-Boje zur Luv-Boje fahren muss.“"
                            },
                            {
                                "example_id": "152cf158-a913-4a12-8965-d8f4a489025b",
                                "sense_id": "e6a4813f-fd42-34d6-8959-96b03cc9fa27",
                                "text": "„Die »München« war das Startschiff, die »Stuttgart« das Zielschiff.“"
                            },
                            {
                                "example_id": "e3227c89-6d7d-42b5-b402-47b34d7dbc3c",
                                "sense_id": "e6a4813f-fd42-34d6-8959-96b03cc9fa27",
                                "text": "„Die Hohentwiel war 2015 Startschiff der Regatta Rund um den Bodensee.“"
                            },
                            {
                                "example_id": "9ffb379e-c4ee-4512-98d9-3c8e4715dd62",
                                "sense_id": "e6a4813f-fd42-34d6-8959-96b03cc9fa27",
                                "text": "„»Für die WM werden extra Schlauchboote gechartert, eine großes Startschiff überführt, Wettfahrtleiter, Jurymitglieder eingeflogen und ggf. auch gastronomische Leistungen bestellt.«“"
                            },
                            {
                                "example_id": "a2c54e99-3333-41f2-86b9-ae43eab88435",
                                "sense_id": "e6a4813f-fd42-34d6-8959-96b03cc9fa27",
                                "text": "„Die auf dem Startschiff ausgehängte Bahnanzeige besteht aus dem Kompaßkurs [sic!] und aus einer roten oder grünen Tafel (Flagge), je nachdem ob links oder rechts herum gesegelt werden soll.“"
                            },
                            {
                                "example_id": "efe1cc08-ee89-4f5a-970e-a765742384e6",
                                "sense_id": "e6a4813f-fd42-34d6-8959-96b03cc9fa27",
                                "text": "„Beim Torstart gibt es keine festausgelegte Startlinie, sondern lediglich eine innere Begrenzungsbahnmarke in der Nähe des Startschiffes.“"
                            },
                            {
                                "example_id": "9c8c91c0-ec73-48aa-90df-7c027472903a",
                                "sense_id": "e6a4813f-fd42-34d6-8959-96b03cc9fa27",
                                "text": "[Frühstart:] „Eine Yacht kann ihren Ausschluß [sic!] jedoch vermeiden, wenn sie entweder das Startschiff oder die Begrenzungstonne der Startlinie umsegelt und erneut von der richtigen Seite aus startet.“"
                            },
                            {
                                "example_id": "51e11d71-4f7e-4ee0-9515-5c480c9d9768",
                                "sense_id": "e6a4813f-fd42-34d6-8959-96b03cc9fa27",
                                "text": "„Gehadert hat Buhl später nach der Sichtung von vier Videos und dem Ton-Mitschnitt vom Startschiff weniger mit der eigenen Disqualifikation, die er bei einem knappen halben Meter über der Linie als \"zu akzeptieren\" einstufte. Bedauerlich sei die Disqualifikation von Willim, bei dem es \"maximal zehn Zentimeter\" waren.“"
                            },
                            {
                                "example_id": "1dadfe31-ec14-4235-8945-63dc682862c9",
                                "sense_id": "e6a4813f-fd42-34d6-8959-96b03cc9fa27",
                                "text": "„Skipper Ian Walker hatte sein Boot zu dicht rechts vom Startschiff positioniert und wegen des fehlenden Windes nicht mehr unter die Linie drücken können. Er trieb außen am Startschiff vorbei, musste mit großem Zeitverlust umkehren und mit einigen hundert Metern Rückstand neu starten.“"
                            },
                            {
                                "example_id": "dcfeee0d-7d9d-4083-a519-045b90170654",
                                "sense_id": "e6a4813f-fd42-34d6-8959-96b03cc9fa27",
                                "text": "„Paul engagiert sich bis zu seinem Tod 2012 in seinem Rostocker Yacht-Club und betreut das Flaggschiff des VSaW, den Zweimaster \"Ebb-Tide\" in seiner Rolle als Startschiff des VSaW auf den Regattakursen der Kieler Woche bis in die 2000er-Jahre.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
