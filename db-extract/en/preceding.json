                                            {
                                                "example_id": "1da00b1b-098a-44cf-9f7e-7631ce19b3e4",
                                                "sense_id": "5ec0bc86-5d2f-32f8-b004-a5383babe104",
                                                "text": "In de voorgaande alinea heb ik al gesproken over de geschiedenis van ons bedrijf."
                                            },
                                            {
                                                "example_id": "e46950ab-8896-4b64-97ce-48620bc55703",
                                                "sense_id": "5ec0bc86-5d2f-32f8-b004-a5383babe104",
