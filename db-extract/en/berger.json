                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ae8dfc0-79c7-4a77-bb6c-b350a239a01c",
                                                "sense_id": "bf566477-69a3-306f-a693-a7a5b1e9b33b",
                                                "text": "Frau Berger ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "04046c54-6a26-4bf1-b0db-688fd0e20aaf",
                                                "sense_id": "bf566477-69a3-306f-a693-a7a5b1e9b33b",
                                                "text": "Herr Berger wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "c48ad2d7-9031-490f-ae38-32688d50d26a",
                                                "sense_id": "bf566477-69a3-306f-a693-a7a5b1e9b33b",
                                                "text": "Die Bergers fahren heute nach Dresden."
                                            },
                                            {
                                                "example_id": "2dfdbe6f-26fe-4da7-bebf-04b67910430a",
                                                "sense_id": "bf566477-69a3-306f-a693-a7a5b1e9b33b",
                                                "text": "Der Berger trägt nie die Schals, die die Berger ihm strickt."
                                            },
                                            {
                                                "example_id": "46426891-9eca-48fa-b643-a76440dbd34c",
                                                "sense_id": "bf566477-69a3-306f-a693-a7a5b1e9b33b",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Berger kommt, geht der Herr Berger.“"
                                            },
                                            {
                                                "example_id": "c8919c25-8f02-4bbf-92ca-0b4cc82347c1",
                                                "sense_id": "bf566477-69a3-306f-a693-a7a5b1e9b33b",
                                                "text": "Berger kommt und geht."
                                            },
                                            {
                                                "example_id": "87867ee7-b47b-4978-8399-c18dc0544df4",
                                                "sense_id": "bf566477-69a3-306f-a693-a7a5b1e9b33b",
                                                "text": "Bergers kamen, sahen und siegten."
                                            }
                                        ],
