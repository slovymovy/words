                ],
                "senses": [
                    {
                        "sense_id": "4c18b5a8-51e7-3c19-8103-543173d9af03",
                        "entry_id": "8c1072e1-f4f2-38bc-8b30-b6ced90e07e7",
                        "glosses": [
                            "ein Schicksalsschlag, ein bedrohliches Ereignis oder eine Entwicklung, dem die Betroffenen ausgeliefert sind, eventuell als Strafe oder religiöse Prüfung gedeutet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f76ae97-ba6e-4f47-86c6-b35dafe29260",
                                "sense_id": "4c18b5a8-51e7-3c19-8103-543173d9af03",
                                "text": "„In der Heimsuchung der Stadt Oran durch die tödliche Seuche, übertragen durch massenhaft auftauchende Ratten, meinte sich eine ganze Generation den Schrecken der Barbarei noch einmal vor Augen führen zu können.“"
                            },
                            {
                                "example_id": "33043a5c-79fa-4868-9179-35bd2d920826",
                                "sense_id": "4c18b5a8-51e7-3c19-8103-543173d9af03",
                                "text": "„Immerhin, es war eine nette Heimsuchung gewesen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "b836aac3-7bb4-33b0-adca-6a24622f670d",
                        "entry_id": "8c1072e1-f4f2-38bc-8b30-b6ced90e07e7",
                        "glosses": [
                            "Besuch, insbesondere der überraschend hereinbrechende „Besuch“ beziehungsweise die Ankunft Gottes zu den Menschen, die normalerweise Erschrecken auslöst"
                        ],
                        "tags": [
                            "archaic",
                            "general"
                        ],
                        "examples": [
                            {
                                "example_id": "f788e215-7a35-4461-b507-97ebf0dc1c37",
                                "sense_id": "b836aac3-7bb4-33b0-adca-6a24622f670d",
                                "text": "„In der Deutschen Bibel wird es [das Verb »heimsuchen«] auch häufig mit der vierten Endung der Sache [dem Kasus Akkusativ] gebraucht, die Sünde, die Boßheit, die Blutschulden u.s.f. heimsuchen, d.i. strafen, da denn Heimsuchungen auch Strafen bedeuten.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "d9ef9cbd-a976-3688-ab57-a9062aaaf909",
                        "entry_id": "8c1072e1-f4f2-38bc-8b30-b6ced90e07e7",
                        "glosses": [
                            "der Besuch von Maria, als sie mit Jesus schwanger war, bei der mit Johannes dem Täufer schwangeren Elisabeth (vergleiche Lukas 1,39; meist Mariä Heimsuchung als Festtag und Motiv in der Kunst)"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "3d6af03c-df56-4a5d-bebb-4182374dad3f",
                                "sense_id": "d9ef9cbd-a976-3688-ab57-a9062aaaf909",
                                "text": "Das geistliche Volkslied »Maria durch ein’ Dornwald ging« greift die Heimsuchung Mariens auf."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "fa54bfd0-cbf2-3490-9074-186924e6d2d1",
                        "entry_id": "8c1072e1-f4f2-38bc-8b30-b6ced90e07e7",
                        "glosses": [
                            "eine Form des Hausfriedensbruchs, schwere Störung des Hausfriedens"
                        ],
                        "tags": [
                            "historical",
                            "law"
                        ],
                        "examples": [
                            {
                                "example_id": "48c5a5e6-4ebb-45c3-b2e6-aee8f3663907",
                                "sense_id": "fa54bfd0-cbf2-3490-9074-186924e6d2d1",
                                "text": "„Wer Heimsuchung thut, gibt sein Leben in des Kaisers Hand.“"
                            }
                        ],
                        "sense_index_json": "\"4\""
                    },
                    {
                        "sense_id": "750d7375-1e18-3dac-89a5-885c564fa534",
                        "entry_id": "8c1072e1-f4f2-38bc-8b30-b6ced90e07e7",
                        "glosses": [
                            "Haussuchung, Hausdurchsuchung eines Verdächtigen durch die Polizei"
                        ],
                        "tags": [
                            "South-German"
                        ],
                        "examples": [],
                        "sense_index_json": "\"5\""
                    }
