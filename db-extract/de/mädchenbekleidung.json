                        "examples": [
                            {
                                "example_id": "f10ce934-3771-4f4e-b08f-89ec3749660f",
                                "sense_id": "2168ca0e-8690-3d81-a179-c44f3843dd56",
                                "text": "„Der Wollverbrauch dagegen ist in allen Sparten (mit Ausnahme der Damen- und Mädchenbekleidung) absolut und relativ rückläufig.“"
                            },
                            {
                                "example_id": "1491f147-8eb6-491b-8e11-6d7561c3ccfd",
                                "sense_id": "2168ca0e-8690-3d81-a179-c44f3843dd56",
                                "text": "„Am Ende war lediglich auszuwerten, ob seine Gefährtin bei diesem Einkaufsbummel mehr zu den Knaben oder mehr zur Mädchenbekleidung hingezogen war."
                            },
                            {
                                "example_id": "80ad3848-1fce-444f-b9a7-0d22d896b706",
                                "sense_id": "2168ca0e-8690-3d81-a179-c44f3843dd56",
                                "text": "„Je nach Sortimentsgruppe sind diese Chips verschiedenfarbig, und Knaben- und Mädchenbekleidung wird durch Chips unterschiedlicher Größe gekennzeichnet.“"
                            },
                            {
                                "example_id": "6840b64c-833b-4b4a-b49b-ce556c3a1a07",
                                "sense_id": "2168ca0e-8690-3d81-a179-c44f3843dd56",
                                "text": "Dieses Geschäft für Mädchenbekleidung hat geschlossen."
                            }
                        ],
