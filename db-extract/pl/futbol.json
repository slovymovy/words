                                    },
                                    {
                                        "sense_id": "7a136606-945b-3d23-833d-3efb59ee9470",
                                        "entry_id": "59e16a03-fdc0-3d21-bc7c-b535bf17591f",
                                        "glosses": [
                                            "American Football"
