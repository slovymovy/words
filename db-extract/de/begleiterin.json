                ],
                "senses": [
                    {
                        "sense_id": "efd62a26-7f48-3337-996e-fa1283fc3648",
                        "entry_id": "590d85bb-af3a-344e-8459-a164f10bc151",
                        "glosses": [
                            "weibliche Person, die jemanden begleitet; weibliche Person, die gemeinsam mit jemandem irgendwo hingeht"
                        ],
                        "tags": [
                            "general"
                        ],
                        "examples": [
                            {
                                "example_id": "075f7231-3a27-419e-a69f-6280298d282f",
                                "sense_id": "efd62a26-7f48-3337-996e-fa1283fc3648",
                                "text": "„Sie blickte die junge Begleiterin ihres alten Bekannten strahlend an, als erwartete sie sich von ihr eine Bestätigung, daß jene Affäre damals keine Zukunft gehabt hatte.“"
                            },
                            {
                                "example_id": "f50613dc-2f1e-499d-b91c-445fb328c673",
                                "sense_id": "efd62a26-7f48-3337-996e-fa1283fc3648",
                                "text": "„Sie schnappte empört nach Luft und versuchte gleichzeitig, ihre Begleiterin entschuldigend anzulächeln.“"
                            },
                            {
                                "example_id": "6279521d-e22b-48df-94e5-6f0317ee99b8",
                                "sense_id": "efd62a26-7f48-3337-996e-fa1283fc3648",
                                "text": "„Die Tante folgte mit ihren beiden Begleiterinnen auf dem Fuß nach.“"
                            },
                            {
                                "example_id": "916bb483-44e6-437d-b745-7a44e9b437c4",
                                "sense_id": "efd62a26-7f48-3337-996e-fa1283fc3648",
                                "text": "„Sie ging mit einer Begeiterin hinaus, und ich folgte ihnen von fern.“"
                            },
                            {
                                "example_id": "79a78e09-a411-4b5f-be9d-80d9ea417f34",
                                "sense_id": "efd62a26-7f48-3337-996e-fa1283fc3648",
                                "text": "„Fragend blickte Bond seine Begleiterin an.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "bf8d5602-b468-3a29-a3c6-02cdcca0179b",
                        "entry_id": "590d85bb-af3a-344e-8459-a164f10bc151",
                        "glosses": [
                            "weibliche Person, die einen Solisten auf einem Instrument begleitet"
                        ],
                        "tags": [
                            "Musik"
                        ],
                        "examples": [
                            {
                                "example_id": "20bd05c8-2bbe-4a52-ab25-4dd1039ca084",
                                "sense_id": "bf8d5602-b468-3a29-a3c6-02cdcca0179b",
                                "text": "„Auch Leon Szostakowski (12) musizierte den 1. Satz des Konzertes für Violoncello Nr. 4 in G-Dur ohne Schwierigkeiten und entpuppte sich sogar als Kavalier, als er seiner Begleiterin am Klavier im Nachhinein eine Rose schenkte.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4fa73a67-3b5f-4241-9fd3-3f265457a9bb",
                        "source_entry_id": "590d85bb-af3a-344e-8459-a164f10bc151",
                        "source_sense_id": "efd62a26-7f48-3337-996e-fa1283fc3648",
                        "source_sense_description": "weibliche Person, die jemanden begleitet",
                        "target_lang_word": "companion",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "companion",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a80693dd-f362-377b-b41a-40c3c79a2992",
                                        "entry_id": "da0fea94-22a6-3a74-a291-3551f2749286",
                                        "glosses": [
                                            "A friend, acquaintance, or partner; someone with whom one spends time or accompanies"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4aa91e72-a199-46c7-b13a-5c474aae2ca0",
                                                "sense_id": "a80693dd-f362-377b-b41a-40c3c79a2992",
                                                "text": "His dog has been his trusted companion for the last five years."
                                            },
                                            {
                                                "example_id": "0ce8c9c1-63f1-4e62-b678-80ba7ff25c72",
                                                "sense_id": "a80693dd-f362-377b-b41a-40c3c79a2992",
                                                "text": "Heere are your Sonnes againe, and I muſt looſe / Two of the ſweet’ſt Companions in the World."
                                            },
                                            {
                                                "example_id": "57b53bf2-1e68-4049-a282-db1f27eba2a1",
                                                "sense_id": "a80693dd-f362-377b-b41a-40c3c79a2992",
                                                "text": "The krogan have had a love-hate relationship with varren for millennia, alternately fighting them for territory and embracing them as treasured companions."
                                            },
                                            {
                                                "example_id": "8d805e53-d81f-4adf-8ccc-b7890ec94350",
                                                "sense_id": "a80693dd-f362-377b-b41a-40c3c79a2992",
                                                "text": "For the most part, Hefner's female companions all adhered to the same mold: twentysomething, bosomy and blonde. \"Well, I guess I know what I like,\" he once said when asked about his preferences."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "038b3911-3cc4-367d-a831-25d656c68b92",
                                        "entry_id": "da0fea94-22a6-3a74-a291-3551f2749286",
                                        "glosses": [
                                            "A person employed to accompany or travel with another."
                                        ],
