                "senses": [
                    {
                        "sense_id": "6b01f251-a125-37ed-8795-4fec2d27dbb9",
                        "entry_id": "edac011e-011b-3a06-b86e-25a9a51267fd",
                        "glosses": [
                            "Lave-vaisselle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f75fc1df-d07b-4518-9295-d76a462cff2a",
                                "sense_id": "6b01f251-a125-37ed-8795-4fec2d27dbb9",
                                "text": "Die Spülmaschine macht das Geschirr sauber.",
                                "translation": "Le lave-vaisselle rend la vaisselle propre."
                            },
                            {
                                "example_id": "54e1fe3e-fa75-4608-b14a-7526478e651b",
                                "sense_id": "6b01f251-a125-37ed-8795-4fec2d27dbb9",
                                "text": "Kannst du mir bitte helfen, die Spülmaschine einzuräumen?",
                                "translation": "Peux-tu m'aider à remplir le lave-vaisselle s'il te plaît?"
                            }
                        ]
                    }
                ],
