                {
                    "sense_id": "aa92ee51-fbfd-31b7-955c-004668406ea6",
                    "sense_definition": "Grand mammifère herbivore d'Afrique et d'Asie doté d'une trompe préhensile et de longues défenses.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "zoologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Au zoo, les enfants admirent un grand <w>éléphant</w> qui mange des feuilles d'arbre."
                        },
                        {
                            "text": "Le guide nous a montré les traces d'un troupeau d'<w>éléphants</w> près du fleuve."
                        }
                    ],
                    "common_phrases": [
                        "défense d'éléphant",
                        "trompe d'éléphant",
                        "troupeau d'éléphants"
                    ]
                },
                {
                    "sense_id": "a490dc21-1bda-31d8-a54d-364705e8c86c",
                    "sense_definition": "Personnalité historique influente et expérimentée, en particulier au sein du Parti socialiste en France.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Plusieurs <w>éléphants</w> du parti ont contesté publiquement la nouvelle orientation stratégique de la direction."
                        },
                        {
                            "text": "Ce congrès politique a mis en scène une rivalité entre les jeunes élus et les vieux <w>éléphants</w>."
                        }
                    ],
                    "common_phrases": [
                        "éléphant du parti",
                        "vieux éléphants"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "politique française"
                        }
                    ]
                },
                {
                    "sense_id": "0a4298f2-a090-3e14-8ecd-43ad590e770a",
                    "sense_definition": "Individu mâle de cette espèce animale, par opposition à la femelle.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "zoologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le soigneur a dû séparer le jeune <w>éléphant</w> de la femelle pour des soins médicaux urgents."
                        },
                        {
                            "text": "Dans cette réserve africaine, un grand <w>éléphant</w> solitaire protège son groupe des prédateurs."
                        }
                    ],
                    "antonyms": [
                        "éléphante"
                    ],
                    "common_phrases": [
                        "éléphant mâle"
                    ]
                },
                {
