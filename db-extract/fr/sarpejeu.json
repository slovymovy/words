                                "example_id": "717c1673-7eda-40ce-b18e-32a12ccfe9b7",
                                "sense_id": "75bf22fd-a29a-30e2-9e40-3d8f95842570",
                                "text": "Sarpejeu, mes amis ! s’écria le chirurgien, cet œil de basilic m’a glacé."
                            },
                            {
                                "example_id": "12696383-2a3a-42b4-b9b6-e58132d9cbc9",
                                "sense_id": "75bf22fd-a29a-30e2-9e40-3d8f95842570",
                                "text": "Allons, bourgeois ! soyez gentil ! Du calme, sarpejeu ! du calme, donc !"
                            },
                            {
                                "example_id": "b7cce10f-4779-4a3f-bdc3-44b87c9795d2",
                                "sense_id": "75bf22fd-a29a-30e2-9e40-3d8f95842570",
                                "text": "Demain ils porteront témoignage de ce qu’ils ont vu, à moins que vous ne consentiez, par écrit, à m’épouser, sarpejeu !"
                            },
                            {
                                "example_id": "c85b910e-fa97-417e-a9e8-fc71ee0441f4",
                                "sense_id": "75bf22fd-a29a-30e2-9e40-3d8f95842570",
                                "text": "Tu sais, Élisabeth ! si c’est une plaisanterie, sarpejeu ! qu’elle finisse !"
                            }
                        ]
                    }
