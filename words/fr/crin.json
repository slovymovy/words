                        }
                    ]
                },
                {
                    "sense_id": "6315e8a1-eca5-3e0c-80e2-4a1513cf5281",
                    "sense_definition": "Plaie ouverte ou entaille à la tête.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En heurtant violemment le chambranle de la porte basse, il s'est fait un vilain <w>crin</w>."
                        },
                        {
                            "text": "Les secouristes ont rapidement désinfecté le <w>crin</w> sanglant causé par la chute d'une pierre."
