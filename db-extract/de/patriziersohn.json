                ],
                "senses": [
                    {
                        "sense_id": "42048723-a066-37d0-8073-999dcd8e67b4",
                        "entry_id": "2f06aadd-4afa-3aa5-8e0c-743cbf7c573b",
                        "glosses": [
                            "Sohn eines wohlhabenden/adligen Bürgers (Patriziers)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc8f36c7-9c90-4d3f-a788-d113179603eb",
                                "sense_id": "42048723-a066-37d0-8073-999dcd8e67b4",
                                "text": "„Trotzdem gelang es ihr, den Nürnberger Patriziersohn Hieronymus Baumgärtner, den sie bei Melanchthon kennengelernt hatte, an sich zu locken.“"
                            },
                            {
                                "example_id": "9c46e364-e1e5-4fba-92cf-dc69eeb91106",
                                "sense_id": "42048723-a066-37d0-8073-999dcd8e67b4",
                                "text": "„Dieser war ein korsischer Patriziersohn, der sich dank der Protektion seines Onkels, der Umgang mit den höchsten Kreisen der Kurie pflegte, schnell in Rom etablieren konnte.“"
                            },
                            {
                                "example_id": "4842478d-931d-4432-91d9-3823831ce1ba",
                                "sense_id": "42048723-a066-37d0-8073-999dcd8e67b4",
                                "text": "„Zusammen mit dem Augsburger Patriziersohn Matthäus Lang und dem Tiroler Adligen Paul von Liechtenstein bildete er über viele Jahre hinweg ein Triumvirat am Hof – ohne die drei wurde nichts entschieden.“"
                            },
                            {
                                "example_id": "57ec5441-1a98-49d5-b47c-2d69ad6f7356",
                                "sense_id": "42048723-a066-37d0-8073-999dcd8e67b4",
                                "text": "„Wenn es Ärger gab, dann waren Reibereien mit dem jungen Stadtadel der Grund, Patriziersöhne gerieten sich mit Hamburger Soldaten in die Haare, auf Festen und in Schenken, oft im Suff, meistens wegen einer Frau.“"
                            },
                            {
                                "example_id": "f7b3b8a5-334b-4dad-bd4f-a49cd9990967",
                                "sense_id": "42048723-a066-37d0-8073-999dcd8e67b4",
                                "text": "„Doch Anna war sicher, dass es nur eine Frage der Zeit war, bis er ihr erneut eine Ehe mit einem der reichen Patriziersöhne ans Herz legte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
