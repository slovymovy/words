                "senses": [
                    {
                        "sense_id": "82168dce-0eef-38a3-8066-42c39215c95d",
                        "entry_id": "0374a6d8-2af4-3ede-b14e-c5505b9fa59e",
                        "glosses": [
                            "Qu’on peut conjecturer, présumer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d47c4afe-06a6-493f-a901-1075a39a5ac1",
                                "sense_id": "82168dce-0eef-38a3-8066-42c39215c95d",
                                "text": "Si je ne devinais pas quels étaient les sentiments très-présumables qu’Olivier me supposait en raisonnant d’après lui-même, je me vis l’objet d’une investigation qui me fit réfléchir et d’un soupçon qui m’embarrassa."
                            },
                            {
                                "example_id": "64156efd-26ad-4b72-a1ac-5ab2260c8293",
                                "sense_id": "82168dce-0eef-38a3-8066-42c39215c95d",
                                "text": "Seulement là où les choses diffèrent, l’électricité se manifeste ; et il est présumable qu’elles ne diffèrent jamais là où l’électricité n’est pas développée, sinon apparente."
                            },
                            {
                                "example_id": "f12a910d-6792-4b35-9a07-b31a36d53b66",
                                "sense_id": "82168dce-0eef-38a3-8066-42c39215c95d",
                                "text": "Il était présumable, d'ailleurs, que le convoi de ravitaillement suivrait à peu près l'itinéraire du lieutenant, et longerait le littoral […]."
                            }
                        ]
                    }
                ],
