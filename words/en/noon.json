{
    "word_family": [
        "afternoon",
        "forenoon",
        "noonday",
        "noontime",
        "noontide"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "fadb21cd-7c52-31e3-9d26-4fec957f062c",
                    "sense_definition": "The time of day corresponding to 12 o'clock in the daytime; the middle of the day.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "time_of_day",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We agreed to meet at <w>noon</w> for lunch.",
                            "target_lang_translations": {
                                "ru": "Мы договорились встретиться в <w>полдень</w> за обедом.",
                                "fr": "Nous avons convenu de nous retrouver à <w>midi</w> pour déjeuner.",
                                "zh": "我们约好<w>中午</w>见面吃午饭。"
                            }
                        },
                        {
                            "text": "The sun was high in the sky, for it was nearly <w>noon</w>.",
                            "target_lang_translations": {
                                "ru": "Солнце стояло высоко в небе, так как был почти <w>полдень</w>.",
                                "fr": "Le soleil était haut dans le ciel, car il était presque <w>midi</w>.",
                                "zh": "太阳高悬在空中，因为快到<w>正午</w>了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "midday",
                        "twelve"
                    ],
                    "antonyms": [
                        "midnight"
                    ],
                    "common_phrases": [
                        "at noon",
                        "high noon",
                        "before noon",
                        "after noon",
                        "noon break"
                    ],
                    "target_lang_definitions": {
                        "ru": "Время дня, соответствующее 12 часам; середина дня.",
                        "fr": "Le moment de la journée correspondant à 12 heures ; le milieu de la journée.",
                        "zh": "指白天十二点的时间；中午。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "полдень",
                                "target_lang_sense_clarification": "время суток"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "midi",
                                "target_lang_sense_clarification": "moment de la journée"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "中午",
                                "target_lang_sense_clarification": "指白天十二点左右的时间"
                            },
                            {
                                "target_lang_word": "正午",
                                "target_lang_sense_clarification": "指白天十二点整"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f6c59f0b-6a4c-3653-8858-01e2ee1a0e87",
                    "sense_definition": "The highest point or culmination of something, such as a career or life.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "figurative_peak",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The empire was at the <w>noon</w> of its glory when the war began.",
                            "target_lang_translations": {
                                "ru": "Империя была в <w>зените</w> своей славы, когда началась война.",
                                "fr": "L'empire était à l'<w>apogée</w> de sa gloire quand la guerre a commencé.",
                                "zh": "战争开始时，这个帝国正处于其荣耀的<w>鼎盛时期</w>。"
                            }
                        },
                        {
                            "text": "He died tragically in the <w>noon</w> of his life.",
                            "target_lang_translations": {
                                "ru": "Он трагически погиб в <w>расцвете</w> лет.",
                                "fr": "Il est mort tragiquement au <w>midi</w> de sa vie.",
                                "zh": "他在人生的<w>全盛时期</w>不幸去世了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "apex",
                        "capstone"
                    ],
                    "target_lang_definitions": {
                        "ru": "Высшая точка или кульминация чего-либо, например, карьеры или жизни.",
                        "fr": "Le point culminant ou l'apogée de quelque chose, comme une carrière ou une vie.",
                        "zh": "指某事物的最高点或鼎盛时期，如事业或人生。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зенит",
                                "target_lang_sense_clarification": "высшая степень"
                            },
                            {
                                "target_lang_word": "расцвет",
                                "target_lang_sense_clarification": "лучшая пора"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "apogée",
                                "target_lang_sense_clarification": "point culminant"
                            },
                            {
                                "target_lang_word": "midi",
                                "target_lang_sense_clarification": "le milieu de la vie (poétique)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "鼎盛时期",
                                "target_lang_sense_clarification": "指事物发展的最高峰"
                            },
                            {
                                "target_lang_word": "全盛时期",
                                "target_lang_sense_clarification": "指最繁荣的阶段"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e55403db-67a8-3ab6-913a-f4a78d4aba6a",
                    "sense_definition": "To stop, rest, or eat a meal in the middle of the day.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They <w>nooned</w> beside a small stream to water the horses.",
                            "target_lang_translations": {
                                "ru": "Они <w>остановились на полдень</w> у ручья, чтобы напоить лошадей.",
                                "fr": "Ils ont <w>fait halte à midi</w> près d'un petit ruisseau pour abreuver les chevaux.",
                                "zh": "他们在小溪旁<w>停下来休息</w>，给马喂水。"
                            }
                        },
                        {
                            "text": "We <w>nooned</w> under the trees to avoid the midday sun.",
                            "target_lang_translations": {
                                "ru": "Мы <w>переждали полдень</w> под деревьями, чтобы укрыться от полуденного солнца.",
                                "fr": "Nous avons <w>fait halte à midi</w> sous les arbres pour éviter le soleil de la mi-journée.",
                                "zh": "我们躲在树下<w>午休</w>，以避开正午的烈日。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "often used in historical or regional contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Останавливаться, отдыхать или принимать пищу в середине дня.",
                        "fr": "S'arrêter, se reposer ou prendre un repas au milieu de la journée.",
                        "zh": "指在中午时分停下来休息或进餐。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "останавливаться на полдень",
                                "target_lang_sense_clarification": "делать привал"
                            },
                            {
                                "target_lang_word": "полудничать",
                                "target_lang_sense_clarification": "устаревшее"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "faire halte à midi",
                                "target_lang_sense_clarification": "s'arrêter pour le repas"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "午休",
                                "target_lang_sense_clarification": "中午休息"
                            },
                            {
                                "target_lang_word": "吃午饭",
                                "target_lang_sense_clarification": "中午进餐"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "794a1f05-ccd7-3059-bc09-f6c9b7c18a1c",
                    "sense_definition": "A surname.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Is Dr. <w>Noon</w> available for an appointment today?",
                            "target_lang_translations": {
                                "ru": "Доктор <w>Нун</w> сегодня принимает?",
                                "fr": "Le Dr <w>Noon</w> est-il disponible pour un rendez-vous aujourd'hui ?",
                                "zh": "<w>努恩</w>医生今天有空看诊吗？"
                            }
                        },
                        {
                            "text": "The <w>Noon</w> family has lived in this town for generations.",
                            "target_lang_translations": {
                                "ru": "Семья <w>Нун</w> живет в этом городе уже несколько поколений.",
                                "fr": "La famille <w>Noon</w> vit dans cette ville depuis des générations.",
                                "zh": "<w>努恩</w>一家在这个镇上已经住了好几代人了。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия.",
                        "fr": "Un nom de famille.",
                        "zh": "姓氏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Нун",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "Noon",
                                "target_lang_sense_clarification": "nom de famille"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "努恩",
                                "target_lang_sense_clarification": "姓氏"
                            }
                        ]
                    }
                }
            ]
        }
    ]
