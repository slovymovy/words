                        "cross_references": [
                            {
                                "target_word": "levensvoorwaarde",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "8b04929e-176b-30a6-9d39-a08eb4a15d52",
                                        "entry_id": "fae4f4ae-e8b2-3d39-9045-a1f3070ab01e",
                                        "glosses": [
                                            "wat nodig is om te kunnen (blijven) leven"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ca7fdc4-8fb8-4052-9b5e-8ba6eb2475b7",
                                                "sense_id": "8b04929e-176b-30a6-9d39-a08eb4a15d52",
                                                "text": "Ik zie een mooi geklede vrouw, die graag naar zich laat kijken (nee, voor wie bekeken worden een levensvoorwaarde is), zich langzaam uitkleden, terwijl zij zich al streelt nog door haar kleren heen."
                                            },
                                            {
                                                "example_id": "f65a951c-043b-45ad-aa3e-c9b0a8b3129d",
                                                "sense_id": "8b04929e-176b-30a6-9d39-a08eb4a15d52",
                                                "text": "\"Stilte is een onderschatte levensvoorwaarde. Stilte is als ademhalen, geen mens kan zonder. En dan begint het, het verdwijnpunt valt samen met het beginpunt. Ook hier.\""
                                            },
                                            {
                                                "example_id": "8328f89d-c9f4-4188-9500-faa2ffba0da6",
                                                "sense_id": "8b04929e-176b-30a6-9d39-a08eb4a15d52",
                                                "text": "Eerder vandaag had de Raad van Sate als hoogste Franse rechtsinstantie de autoriteiten verplicht betere levensvoorwaarden voor migranten te scheppen. Hulporganisaties waren naar de rechter getrokken nadat Rijsel een onthaalcentrum weigerde te openen voor migranten."
                                            }
                                        ]
                                    }
                                ]
                            }
