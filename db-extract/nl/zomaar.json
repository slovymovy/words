                        ]
                    },
                    {
                        "translation_id": "1f2abe02-31e1-49f0-ac07-5e966cfce20c",
                        "source_entry_id": "5824f478-5066-34bf-9e21-334db7c761d2",
                        "source_sense_id": "08271d1b-70d0-32a0-8d26-a253dc3920a7",
                        "source_sense_description": "op willekeurige wijze, zonder nadenken of voorbereiden",
                        "target_lang_word": "just",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "just",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f7c03e62-15af-3b2a-abd1-c760f4109e9c",
                                        "entry_id": "b52cbe1d-3986-3125-a624-30c903e4934a",
                                        "glosses": [
                                            "Factually right, correct; factual."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2724006d-2db2-4cec-b8f6-505273657b50",
                                                "sense_id": "f7c03e62-15af-3b2a-abd1-c760f4109e9c",
                                                "text": "It is a just assessment of the facts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ea9879c-c9d4-3814-bf69-f0f1021237be",
                                        "entry_id": "b52cbe1d-3986-3125-a624-30c903e4934a",
                                        "glosses": [
                                            "Rationally right, correct."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "727fe57a-9d79-3aed-a41a-63db2870f0b5",
                                        "entry_id": "b52cbe1d-3986-3125-a624-30c903e4934a",
                                        "glosses": [
                                            "Morally right; upright, righteous, equitable; fair."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d04c33af-f1ed-4c7b-b2ec-8f243768370a",
                                                "sense_id": "727fe57a-9d79-3aed-a41a-63db2870f0b5",
                                                "text": "It looks like a just solution at first glance."
                                            },
                                            {
                                                "example_id": "0496627a-2829-48ae-a2f3-81956e16dcbd",
                                                "sense_id": "727fe57a-9d79-3aed-a41a-63db2870f0b5",
                                                "text": "My lord, we know your grace to be a man\nJust and upright."
                                            },
                                            {
                                                "example_id": "471d5c0f-de2e-4c35-9098-f0589c8116b5",
                                                "sense_id": "727fe57a-9d79-3aed-a41a-63db2870f0b5",
                                                "text": "Masters, give unto your servants that which is just and equal; knowing that ye also have a Master in heaven."
                                            },
                                            {
                                                "example_id": "4ff36a7f-f5b0-42c2-bb3d-a848d840f52a",
                                                "sense_id": "727fe57a-9d79-3aed-a41a-63db2870f0b5",
                                                "text": "Here is a Proclamation for a Prince: that proclaims him in whoſe name it is emitted [James II of England], to be the greateſt Tyrant that ever lived in the world, and their Revolt who have diſowned him to be the juſteſt that ever was."
                                            },
                                            {
                                                "example_id": "c8024bff-b89b-4177-88ec-d0fa141968cf",
                                                "sense_id": "727fe57a-9d79-3aed-a41a-63db2870f0b5",
                                                "text": "Looking back over my previously written account of these things, I must insist that I have been altogether juster to Cavor than he has been to me."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dfa5b8c4-e3ba-3fbe-9db7-01353f13fe13",
                                        "entry_id": "b52cbe1d-3986-3125-a624-30c903e4934a",
                                        "glosses": [
                                            "Proper, adequate."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "just",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5debdf36-750e-37fb-b170-02fb0bf7a3ff",
                                        "entry_id": "4f37cd5b-1615-351d-8dc3-919ac6ec9dc5",
                                        "glosses": [
                                            "Only, simply, merely."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "434940df-d43c-4bd6-837a-ffb0ccb52a0c",
                                                "sense_id": "5debdf36-750e-37fb-b170-02fb0bf7a3ff",
                                                "text": "Just plant a few tomatoes, unless you can freeze or dry them."
                                            },
                                            {
                                                "example_id": "63e5afb6-a76e-4f4f-96f6-093b50b58ac0",
                                                "sense_id": "5debdf36-750e-37fb-b170-02fb0bf7a3ff",
                                                "text": "He calls it vermilion, but it's just red to me."
                                            },
                                            {
                                                "example_id": "0a10ce0b-ff2f-4754-87c5-4201dadbdee8",
                                                "sense_id": "5debdf36-750e-37fb-b170-02fb0bf7a3ff",
                                                "text": "Philander went into the next room, which was just a lean-to hitched on to the end of the shanty, and came back with a salt mackerel that dripped brine like a rainstorm. Then he put the coffee pot on the stove and rummaged out a loaf of dry bread and some hardtack."
                                            },
                                            {
                                                "example_id": "bdd4c9c1-16c0-4bd2-9635-d800f741adab",
                                                "sense_id": "5debdf36-750e-37fb-b170-02fb0bf7a3ff",
                                                "text": "From the ground, Colombo’s port does not look like much.[…] But viewed from high up in one of the growing number of skyscrapers in Sri Lanka’s capital, it is clear that something extraordinary is happening: China is creating a shipping hub just 200 miles from India’s southern tip."
                                            },
                                            {
                                                "example_id": "3d2bed20-ae99-4c1f-9ae3-4220cd395fce",
                                                "sense_id": "5debdf36-750e-37fb-b170-02fb0bf7a3ff",
                                                "text": "Swearing doesn't just mean what we now understand by \"dirty words\". It is entwined, in social and linguistic history, with the other sort of swearing: vows and oaths."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "82c396ed-6bf9-304f-8761-a5e8378bde93",
                                        "entry_id": "4f37cd5b-1615-351d-8dc3-919ac6ec9dc5",
                                        "glosses": [
                                            "Only, simply, merely.",
                                            "Introduces a disappointing or surprising outcome that renders futile something previously mentioned."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c15e309e-6586-48ad-a987-6c6e060b35a8",
                                                "sense_id": "82c396ed-6bf9-304f-8761-a5e8378bde93",
                                                "text": "I spent two hours cooking my favorite recipe, just to burn the rice and ruin the meal."
                                            },
                                            {
                                                "example_id": "be930e72-45e4-4c38-9f71-eaf7890d2e7b",
                                                "sense_id": "82c396ed-6bf9-304f-8761-a5e8378bde93",
                                                "text": "I helped him out, just for him to betray me."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "06d11317-7c84-3a3e-9bba-f540a2c143e1",
                                        "entry_id": "4f37cd5b-1615-351d-8dc3-919ac6ec9dc5",
                                        "glosses": [
                                            "Used to reduce the force of an imperative; simply."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c305cc79-3663-4ae4-897d-b9f8a1d3893a",
                                                "sense_id": "06d11317-7c84-3a3e-9bba-f540a2c143e1",
                                                "text": "Just follow the directions on the box."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f337aa21-1204-334d-8068-ea393e86cb75",
                                        "entry_id": "4f37cd5b-1615-351d-8dc3-919ac6ec9dc5",
                                        "glosses": [
                                            "Used to increase the force of an imperative; simply, without questioning."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dac7edca-1e64-4d54-962e-64944e454c70",
                                                "sense_id": "f337aa21-1204-334d-8068-ea393e86cb75",
                                                "text": "I'm tired of playing games – just get it done."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9ea5b925-1118-36f2-98ef-092325776180",
                                        "entry_id": "4f37cd5b-1615-351d-8dc3-919ac6ec9dc5",
                                        "glosses": [
                                            "Used to convey a less serious or formal tone"
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ed5713c5-ef81-47d5-8c9e-cbc57ebe83f8",
                                                "sense_id": "9ea5b925-1118-36f2-98ef-092325776180",
                                                "text": "I just called to say \"hi\"."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8733a2e6-2101-371d-86a9-dc88e972fcf7",
                                        "entry_id": "4f37cd5b-1615-351d-8dc3-919ac6ec9dc5",
                                        "glosses": [
                                            "Absolutely, positively"
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "479d31f9-f2db-4520-9aef-6c7f3e80dcc4",
                                                "sense_id": "8733a2e6-2101-371d-86a9-dc88e972fcf7",
                                                "text": "It is just splendid!"
                                            },
                                            {
                                                "example_id": "a23d9c91-4040-42ee-aa89-bd216cc0322c",
                                                "sense_id": "8733a2e6-2101-371d-86a9-dc88e972fcf7",
                                                "text": "just fine"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8e6a664c-96db-3c68-9c1f-dca9c6758225",
                                        "entry_id": "4f37cd5b-1615-351d-8dc3-919ac6ec9dc5",
                                        "glosses": [
                                            "Barely, hardly, scarcely.",
                                            "Moments ago, only very recently."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd605c68-1534-4c16-92d4-c21e45142783",
                                                "sense_id": "8e6a664c-96db-3c68-9c1f-dca9c6758225",
                                                "text": "They just left, but you may leave a message at the desk."
                                            },
                                            {
                                                "example_id": "a570f356-ff60-4527-a042-9487c375cc9e",
                                                "sense_id": "8e6a664c-96db-3c68-9c1f-dca9c6758225",
                                                "text": "Philander went into the next room[…]and came back with a salt mackerel[…]. Next he put the mackerel in a fry-pan, and the shanty began to smell like a Banks boat just in from a v'yage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "276f9010-d641-3466-8e11-02fff4296c07",
                                        "entry_id": "4f37cd5b-1615-351d-8dc3-919ac6ec9dc5",
                                        "glosses": [
                                            "Barely, hardly, scarcely.",
                                            "By a narrow margin; closely; narrowly; almost not."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d331c15a-1e36-4552-b370-0f57f233a52e",
                                                "sense_id": "276f9010-d641-3466-8e11-02fff4296c07",
                                                "text": "The fastball just missed my head!"
                                            },
                                            {
                                                "example_id": "39d80ac6-8791-4fbd-84ce-dadb570eb302",
                                                "sense_id": "276f9010-d641-3466-8e11-02fff4296c07",
                                                "text": "The fire department arrived just in time."
                                            },
                                            {
                                                "example_id": "04145cb8-e883-4390-9181-5a95f73040b1",
                                                "sense_id": "276f9010-d641-3466-8e11-02fff4296c07",
                                                "text": "The piece just might fit."
                                            },
                                            {
                                                "example_id": "f3cc8a0d-ec77-4751-a25a-d1df770a6661",
                                                "sense_id": "276f9010-d641-3466-8e11-02fff4296c07",
                                                "text": "Nanny Broome was looking up at the outer wall. Just under the ceiling there were three lunette windows, heavily barred and blacked out in the normal way by centuries of grime."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0eb886ac-5ba9-3b5e-8455-1a2b3054989c",
                                        "entry_id": "4f37cd5b-1615-351d-8dc3-919ac6ec9dc5",
                                        "glosses": [
                                            "Exactly, precisely, perfectly."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "50f232b9-9344-46ea-a2f7-e36b991e57b0",
                                                "sense_id": "0eb886ac-5ba9-3b5e-8455-1a2b3054989c",
                                                "text": "He wants everything just right for the big day."
                                            },
                                            {
                                                "example_id": "0ad70a2d-e06f-47dc-82b1-b1f8ff52274e",
                                                "sense_id": "0eb886ac-5ba9-3b5e-8455-1a2b3054989c",
                                                "text": "And having just enough, not covet more."
                                            },
                                            {
                                                "example_id": "7de9132e-65a9-49bf-b3b3-86be0100bcbf",
                                                "sense_id": "0eb886ac-5ba9-3b5e-8455-1a2b3054989c",
                                                "text": "The god Pan […] guided my hand so just to the heart of the beast.",
                                                "translation": "The New Arcadia",
                                                "english": "The New Arcadia"
                                            },
                                            {
                                                "example_id": "cab83d73-36e0-4f67-86b1-586eaa9528e0",
                                                "sense_id": "0eb886ac-5ba9-3b5e-8455-1a2b3054989c",
                                                "text": "To-night, at Herne's oak, just 'twixt twelve and one."
                                            },
                                            {
                                                "example_id": "a046c3a8-4052-4ee9-8b0e-d69fcfaa0f19",
                                                "sense_id": "0eb886ac-5ba9-3b5e-8455-1a2b3054989c",
                                                "text": "Private-equity nabobs bristle at being dubbed mere financiers. Piling debt onto companies’ balance-sheets is only a small part of what leveraged buy-outs are about, they insist. Improving the workings of the businesses they take over is just as core to their calling, if not more so. Much of their pleading is public-relations bluster."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "just",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d1149600-f990-3906-8d43-ad9f4e980fe7",
                                        "entry_id": "c9d537ec-9d1b-3b56-91cf-12e1f96933b2",
                                        "glosses": [
                                            "Expressing dismay or discontent."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "just",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0cd9113a-1773-36c5-bdc3-cb8d65871761",
                                        "entry_id": "f61e8c11-cb19-3087-a101-2c23deec4cfd",
                                        "glosses": [
                                            "A joust, tournament."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2cbdcd08-5cf9-4c9a-b278-8bd07d6735c7",
                                                "sense_id": "0cd9113a-1773-36c5-bdc3-cb8d65871761",
                                                "text": "Justs and tilts were held here weekly, while the great tourneys that occurred less often were given upon a field outside the castle wall upon the floor of the valley."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "just",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3eecfd0b-0ac8-3d9c-8638-596d820edd75",
                                        "entry_id": "f62cb5e7-f525-3b18-9dcf-a2a6600773c5",
                                        "glosses": [
                                            "To joust, fight a tournament."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "633cf794-914b-458a-af19-fe045575269f",
                                                "sense_id": "3eecfd0b-0ac8-3d9c-8638-596d820edd75",
                                                "text": "He iusts with her vnknowne whom he lou’d best, [...]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1fb77459-fcf7-4f75-bdc4-ea43b16b95b4",
