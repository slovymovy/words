                    {
                        "translation_id": "15b86bf2-4bfe-4efe-9faf-380fe3d754fc",
                        "source_entry_id": "b6c141b7-c169-3b5b-aad8-3f41a346477f",
                        "source_sense_id": "2a98debb-90e1-3f60-b3fa-e292d8829425",
