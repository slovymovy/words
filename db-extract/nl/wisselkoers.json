                                    {
                                        "sense_id": "2701d25a-7e0d-3f82-b987-0de3213ec2c0",
                                        "entry_id": "463d433a-866a-317d-9c12-50164e199311",
                                        "glosses": [
                                            "Prix d’une monnaie par rapport à une autre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87bd8d79-ec26-46a8-91cf-20594b6009b6",
                                                "sense_id": "2701d25a-7e0d-3f82-b987-0de3213ec2c0",
                                                "text": "Une période de croissance lente sera nécessaire avant que les tensions inflationnistes ne se dissipent et que la Banque centrale puisse abaisser les taux d’intérêt, permettant ainsi au taux de change de se déprécier."
                                            },
                                            {
                                                "example_id": "756f6f8e-3495-47f1-aec0-dbbe2a89ce7f",
                                                "sense_id": "2701d25a-7e0d-3f82-b987-0de3213ec2c0",
                                                "text": "L’incertitude liée au taux de change engendre une incertitude des prix futurs des biens et services."
                                            },
                                            {
                                                "example_id": "27a20bc7-9421-4f25-a9a4-9af791af6db8",
                                                "sense_id": "2701d25a-7e0d-3f82-b987-0de3213ec2c0",
                                                "text": "Ma pensée n’était plus (ou pas encore) sur la question du taux de change mark-franc lorsqu’un garde-mobile me prévient que la route en direction de Chindrieux est libre."
                                            }
                                        ]
                                    }
                                ]
                            }
