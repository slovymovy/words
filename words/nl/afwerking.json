            "pos": "noun",
            "senses": [
                {
                    "sense_id": "da468ffa-7bbe-39c2-9008-50544e3cb4de",
                    "sense_definition": "Het voltooien of de laatste hand leggen aan een taak of project.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "voltooiing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>afwerking</w> van het script verliep goed en we konden op tijd beginnen met filmen.",
                            "target_lang_translations": {
                                "en": "The <w>completion</w> of the script went well and we were able to start filming on time."
                            }
                        },
                        {
                            "text": "De snelle <w>afwerking</w> van het project zorgde voor tevreden klanten.",
                            "target_lang_translations": {
                                "en": "The rapid <w>completion</w> of the project resulted in satisfied clients."
                            }
                        }
                    ],
                    "synonyms": [
                        "voltooiing"
                    ],
                    "common_phrases": [
                        "snelle afwerking",
                        "afwerking van het project"
                    ],
                    "target_lang_definitions": {
                        "en": "The completion or putting the final touches on a task or project."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "completion",
                                "target_lang_sense_clarification": "of a task or project"
                            },
                            {
                                "target_lang_word": "finishing",
                                "target_lang_sense_clarification": "the act of completing something"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "852d765e-afdc-3e45-a479-6b3aa84b4da4",
                    "sense_definition": "De wijze of kwaliteit waarop iets is voltooid of gedetailleerd.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "kwaliteit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>afwerking</w> van deze houten tafel is werkelijk van uitstekende kwaliteit.",
                            "target_lang_translations": {
                                "en": "The <w>finish</w> of this wooden table is truly of excellent quality."
                            }
                        },
                        {
                            "text": "Let vooral op de fijne <w>afwerking</w> van de details in dit schilderij.",
                            "target_lang_translations": {
                                "en": "Pay special attention to the fine <w>finishing</w> of the details in this painting."
                            }
                        }
                    ],
                    "common_phrases": [
                        "fijne afwerking",
                        "kwaliteit van de afwerking"
                    ],
                    "target_lang_definitions": {
                        "en": "The manner or quality in which something is completed or detailed."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "finish",
                                "target_lang_sense_clarification": "the surface appearance or quality of workmanship"
                            },
                            {
                                "target_lang_word": "finishing",
                                "target_lang_sense_clarification": "the final work or ornamentation of an object"
                            },
                            {
                                "target_lang_word": "finishing touch",
                                "target_lang_sense_clarification": "a final detail that completes something"
                            }
                        ]
                    }
                }
            ]
