                "senses": [
                    {
                        "sense_id": "cb81507c-cbdf-368c-9bff-492de1f38060",
                        "entry_id": "c1beb34b-a177-3c30-8fff-2330efbaee6b",
                        "glosses": [
                            "weibliche Person, die Harfe spielt"
                        ],
                        "tags": [
                            "Musik"
                        ],
                        "examples": [
                            {
                                "example_id": "a4091376-ecc4-4812-be8a-3e4afa7c8d54",
                                "sense_id": "cb81507c-cbdf-368c-9bff-492de1f38060",
                                "text": "„Da fiel Sabina ein, daß Jay diese Geschichte kannte und wußte, daß dies von Lillian erzählt wurde; und Lillian hatte nicht als Harfenistin, sondern als Pianistin weitergespielt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1137f749-1454-4263-adb3-eaceec48a168",
                        "source_entry_id": "c1beb34b-a177-3c30-8fff-2330efbaee6b",
                        "source_sense_id": "cb81507c-cbdf-368c-9bff-492de1f38060",
                        "source_sense_description": "weibliche Person, die Harfe spielt",
                        "target_lang_word": "арфистка",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "арфистка",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "7119888d-8e6f-3d65-888c-bbdd10f9a6b3",
                                        "entry_id": "2373b4b8-2e5f-3ab3-9c9d-fa3044fa9107",
                                        "glosses": [
                                            "женск. к арфист"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "27b31a78-dfd4-39e9-848d-c52872a348c5",
                                        "entry_id": "2373b4b8-2e5f-3ab3-9c9d-fa3044fa9107",
                                        "glosses": [
                                            "устар. женщина (обычно лёгкого поведения), развлекающая посетителей ресторана пением и игрой на музыкальном инструменте"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f8dc8e5-bba4-4a6d-9f35-bc8d9f4c9648",
                                                "sense_id": "27b31a78-dfd4-39e9-848d-c52872a348c5",
                                                "text": "Я шла замуж-то, как голубка была, а муж меня через неделю по трактирам повёз арфисток слушать; сажал их за один стол со мной, обнимался с ними; а что говорили, так у меня волоса́ дыбом подымались!"
                                            },
                                            {
                                                "example_id": "a23a8905-104e-4253-b503-49161649ce23",
                                                "sense_id": "27b31a78-dfd4-39e9-848d-c52872a348c5",
                                                "text": "В столице же она была мыслима не иначе, как навязанная очень сильным покровительством, но и за всем тем от публики она, наверное, заслужила бы только незавидное прозвище «арфистки»."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
