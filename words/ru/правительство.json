                            },
                            {
                                "target_lang_word": "rule",
                                "target_lang_sense_clarification": "exercise of authority"
                            },
                            {
                                "target_lang_word": "government",
                                "target_lang_sense_clarification": "tenure"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "统治时期",
