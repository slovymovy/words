                "senses": [
                    {
                        "sense_id": "4562c73b-bb8f-347f-a7c6-e744ca3adedc",
                        "entry_id": "8dc10bce-9397-308a-a95d-d42a8cfda17d",
                        "glosses": [
                            "Gesamtheit aller Arbeiten, die zum Einbringen von Schilf notwendig sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "87cf1f07-6619-47b4-bdf4-05fd3b9c1d57",
                                "sense_id": "4562c73b-bb8f-347f-a7c6-e744ca3adedc",
                                "text": "„Der Nationalpark umfaßt die unberührte, unter strengem Schutz stehenden Kerngebiete, weiters die sogenannte bewahrende Zone, in der traditionelle, aber naturschonende Bewirtschaftung wie Schilfernte, Mähen der Wiesen und sanfte, kontrollierte Beweidung erlaubt ist, sowie die Saumzone mit Siedlungsgebieten, in der jedoch ebenfalls strenge Auflagen gelten.“"
                            },
                            {
                                "example_id": "a2130138-4f93-4336-baa9-32173edb32fb",
                                "sense_id": "4562c73b-bb8f-347f-a7c6-e744ca3adedc",
                                "text": "„Die Schilfernte auf dem Neusiedler See ist abgeschlossen und die Schilfschneider ziehen eine gemischte Bilanz.“"
                            },
                            {
                                "example_id": "3d04eae8-c39e-4b93-a836-e701d5231a9a",
                                "sense_id": "4562c73b-bb8f-347f-a7c6-e744ca3adedc",
                                "text": "„Ein am Montag von Naturschutzlandesrätin Astrid Eisenkopf (SPÖ) präsentiertes EU-Projekt soll nun naturschonende Methoden der Schilfernte erarbeiten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
