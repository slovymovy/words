{
    "word_family": [
        "judge",
        "judicious",
        "prejudge",
        "misjudge",
        "judgmental",
        "adjudge"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "043e8ec4-8632-37f4-8c8f-8fa2d0c60635",
                    "sense_definition": "The ability to make considered decisions or come to sensible conclusions.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "mental_faculty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manager showed excellent <w>judgment</w> when he decided to delay the product launch.",
                            "target_lang_translations": {
                                "ru": "Менеджер проявил отличное <w>благоразумие</w>, когда решил отложить запуск продукта.",
                                "zh": "经理决定推迟产品发布时，展现出了极佳的<w>判断力</w>。"
                            }
                        },
                        {
                            "text": "Driving while tired can seriously impair your good <w>judgment</w> and reaction time.",
                            "target_lang_translations": {
                                "ru": "Вождение в уставшем состоянии может серьезно ухудшить вашу <w>рассудительность</w> и время реакции.",
                                "zh": "疲劳驾驶会严重削弱你的<w>判断力</w>和反应时间。"
                            }
                        }
                    ],
                    "synonyms": [
                        "thinking"
                    ],
                    "common_phrases": [
                        "good judgment",
                        "poor judgment",
                        "impair judgment",
                        "sound judgment"
                    ],
                    "target_lang_definitions": {
                        "ru": "Способность принимать взвешенные решения или приходить к разумным выводам.",
                        "zh": "做出深思熟虑的决定或得出合理结论的能力。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "здравомыслие",
                                "target_lang_sense_clarification": "способность мыслить разумно"
                            },
                            {
                                "target_lang_word": "рассудительность",
                                "target_lang_sense_clarification": "качество ума"
                            },
                            {
                                "target_lang_word": "благоразумие",
                                "target_lang_sense_clarification": "мудрость в решениях"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "判断力",
                                "target_lang_sense_clarification": "辨别是非、做出正确决策的能力"
                            },
                            {
                                "target_lang_word": "明辨是非",
                                "target_lang_sense_clarification": "指具备良好的判断能力"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e81437d2-afae-33e3-9494-95d00adf7b67",
                    "sense_definition": "An opinion or conclusion formed after careful consideration.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "opinion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In my <w>judgment</w>, the plan is likely to succeed if we have enough funding.",
                            "target_lang_translations": {
                                "ru": "По моему <w>суждению</w>, план, скорее всего, увенчается успехом, если у нас будет достаточное финансирование.",
                                "zh": "依我的<w>判断</w>，如果我们有足够的资金，这个计划很可能会成功。"
                            }
                        },
                        {
                            "text": "It is too early to pass <w>judgment</w> on the success of the new policy.",
                            "target_lang_translations": {
                                "ru": "Еще слишком рано выносить <w>суждение</w> об успехе новой политики.",
                                "zh": "现在对新政策的成败下<w>判断</w>还为时过早。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "pass judgment",
                        "professional judgment",
                        "personal judgment"
                    ],
                    "target_lang_definitions": {
                        "ru": "Мнение или вывод, сформированные после тщательного обдумывания.",
                        "zh": "经过仔细考虑后形成的一种观点或结论。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "суждение",
                                "target_lang_sense_clarification": "мнение или умозаключение"
                            },
                            {
                                "target_lang_word": "мнение",
                                "target_lang_sense_clarification": "личная точка зрения"
                            },
                            {
                                "target_lang_word": "оценка",
                                "target_lang_sense_clarification": "анализ ситуации"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "判断",
                                "target_lang_sense_clarification": "对事物情况的断定"
                            },
                            {
                                "target_lang_word": "看法",
                                "target_lang_sense_clarification": "对某事物的见解"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "32905fb2-ce71-3daa-a2df-4d6ca0578bb2",
                    "sense_definition": "The process or act of forming an opinion or making a decision.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "process",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>judgment</w> of the competition took several hours because there were many talented participants.",
                            "target_lang_translations": {
                                "ru": "<w>Судейство</w> конкурса заняло несколько часов, так как было много талантливых участников.",
                                "zh": "由于参赛选手众多，比赛的<w>评判</w>工作花费了几个小时。"
                            }
                        },
                        {
                            "text": "The key to the situation was <w>judgment</w> of the role the railways could play in modern times.",
                            "target_lang_translations": {
                                "ru": "Ключом к ситуации была <w>оценка</w> роли, которую железные дороги могли бы сыграть в современное время.",
                                "zh": "局势的关键在于对铁路在现代社会所能发挥作用的<w>评估</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "judgment of character",
                        "value judgment"
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс или акт формирования мнения или принятия решения.",
                        "zh": "形成观点或做出决定的过程或行为。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оценивание",
                                "target_lang_sense_clarification": "процесс вынесения оценки"
                            },
                            {
                                "target_lang_word": "судейство",
                                "target_lang_sense_clarification": "в контексте соревнований"
                            },
                            {
                                "target_lang_word": "оценка",
                                "target_lang_sense_clarification": "акт определения ценности или качеств"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "评估",
                                "target_lang_sense_clarification": "对价值或质量的衡量过程"
                            },
                            {
                                "target_lang_word": "评判",
                                "target_lang_sense_clarification": "对比赛或表现进行评价"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3d385381-8e9c-3f67-b728-d28064db2f62",
                    "sense_definition": "A formal decision given by a court or a judge.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "legal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The court is expected to deliver its final <w>judgment</w> on the case tomorrow morning.",
                            "target_lang_translations": {
                                "ru": "Ожидается, что завтра утром суд вынесет окончательное <w>решение</w> по этому делу.",
                                "zh": "法院预计将于明早对该案做出最终<w>判决</w>。"
                            }
                        },
                        {
                            "text": "The lawyer asked the court to give the <w>judgment</w> as soon as possible.",
                            "target_lang_translations": {
                                "ru": "Адвокат попросил суд вынести <w>постановление</w> как можно скорее.",
                                "zh": "律师请求法院尽快做出<w>裁决</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "final judgment",
                        "court judgment",
                        "legal judgment",
                        "deliver judgment"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официальное решение, вынесенное судом или судьей.",
                        "zh": "法院或法官做出的正式裁决。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "судебное решение",
                                "target_lang_sense_clarification": "официальный вердикт"
                            },
                            {
                                "target_lang_word": "приговор",
                                "target_lang_sense_clarification": "решение по уголовному делу"
                            },
                            {
                                "target_lang_word": "постановление",
                                "target_lang_sense_clarification": "официальный акт суда"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "判决",
                                "target_lang_sense_clarification": "法院对案件做出的正式决定"
                            },
                            {
                                "target_lang_word": "裁决",
                                "target_lang_sense_clarification": "对争议事项的正式决定"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "815447e7-95e6-3df9-8c7f-dbca80ac310a",
                    "sense_definition": "A divine sentence or punishment, often referring to the end of the world.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "religious",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many ancient cultures believed that natural disasters were a form of divine <w>judgment</w>.",
                            "target_lang_translations": {
                                "ru": "Многие древние культуры верили, что стихийные бедствия были формой божественного <w>суда</w>.",
                                "zh": "许多古代文化认为自然灾害是一种神圣的<w>审判</w>。"
                            }
                        },
                        {
                            "text": "The preacher spoke about the day of <w>judgment</w> and the need for repentance.",
                            "target_lang_translations": {
                                "ru": "Проповедник говорил о дне <w>суда</w> и необходимости покаяния.",
                                "zh": "传教士谈到了<w>审判</w>日以及悔改的必要性。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "day of judgment",
                        "divine judgment"
                    ],
                    "target_lang_definitions": {
                        "ru": "Божественный приговор или наказание, часто относящееся к концу света.",
                        "zh": "神圣的审判或惩罚，常指世界末日。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "суд",
                                "target_lang_sense_clarification": "божественное правосудие"
                            },
                            {
                                "target_lang_word": "кара",
                                "target_lang_sense_clarification": "божественное наказание"
                            },
                            {
                                "target_lang_word": "возмездие",
                                "target_lang_sense_clarification": "справедливая расплата"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "审判",
                                "target_lang_sense_clarification": "宗教语境下的神圣裁决"
                            },
                            {
                                "target_lang_word": "天谴",
                                "target_lang_sense_clarification": "上天降下的惩罚"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}