                                    {
                                        "sense_id": "dd19b64a-6982-3ac3-bb39-e8ab4a651f4a",
                                        "entry_id": "aba27808-1399-3898-9bcc-d631832d5373",
                                        "glosses": [
                                            "Stingy; parsimonious."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8ba8a244-19b7-4459-8fe6-524165358d06",
                                                "sense_id": "dd19b64a-6982-3ac3-bb39-e8ab4a651f4a",
                                                "text": "Don't be near with your pocketbook."
                                            },
                                            {
                                                "example_id": "542f29d4-76e4-4dc1-807f-f1cc0dbb8ae4",
                                                "sense_id": "dd19b64a-6982-3ac3-bb39-e8ab4a651f4a",
                                                "text": "[T]o let you know, Miss, he's so near, it's partly a wonder how he lives at all: and yet he's worth a power of money, too."
