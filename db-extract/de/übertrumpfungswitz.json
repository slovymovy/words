                ],
                "senses": [
                    {
                        "sense_id": "3fb57df2-da53-3860-8479-0009c29f92f6",
                        "entry_id": "19f45c84-4dfc-3fd4-a089-a8671dd44d65",
                        "glosses": [
                            "Witz, bei dem immer ein nachfolgender Protagonist den vorigen übertrumpft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ccae8f1-890c-4585-9003-22b7c82600f6",
                                "sense_id": "3fb57df2-da53-3860-8479-0009c29f92f6",
                                "text": "„Eine wichtige Rolle gerade auch im Themenfeld der wirtschaftlichen Situation spielte der sogenannte »Übertrumpfungswitz«.“"
                            },
                            {
                                "example_id": "dff4ee69-7414-48b1-b570-634e052149a0",
                                "sense_id": "3fb57df2-da53-3860-8479-0009c29f92f6",
                                "text": "„Der Übertrumpfungswitz (Freud spricht von ›Überbietungswitzen‹) gelangt schnell in den Bereich der Aufschneiderei, der Lüge.“"
                            },
                            {
                                "example_id": "14156867-d163-4dda-86ca-100398f2cf11",
                                "sense_id": "3fb57df2-da53-3860-8479-0009c29f92f6",
                                "text": "„Ein häufiges Strukturelement solcher Übertrumpfungswitze ist nach RÖHRICH (1977) die Umkehrung der anfänglichen Machtverhältnisse, indem die zunächst überlegene Figur (s = superior) durch das Kontern beziehungsweise die Aggression (A) der anderen Figur zum Unterlegenen (i = inferior) wird.“"
                            },
                            {
                                "example_id": "7e7057f6-cbec-4a13-b692-d744e6bd5f95",
                                "sense_id": "3fb57df2-da53-3860-8479-0009c29f92f6",
                                "text": "„Wenn es nicht gerade um Übertrumpfungswitze geht, in denen alle Akteure Kinder sind, wird dem Kleinen der Große, der Erwachsene gegenübergestellt, als Kontrastfolie, damit der Spannungsbogen der Kurzerzählung besser geführt werden kann.“"
                            },
                            {
                                "example_id": "3885601c-a3bb-462a-8def-26c500612158",
                                "sense_id": "3fb57df2-da53-3860-8479-0009c29f92f6",
                                "text": "„Der Aufbau dieser Geschichten erinnert an die Gattung des Übertrumpfungswitzes (vgl. Bergmann 1996).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
