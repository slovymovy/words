                ],
                "senses": [
                    {
                        "sense_id": "b61a1422-6966-3729-9d1a-4dab01af9dde",
                        "entry_id": "97f3149f-2527-32c4-a4a1-9f386dae8e68",
                        "glosses": [
                            "Frau, die die traditionell dem Nikolaus zugeschriebene Rolle einnimmt oder so verkleidet ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c3ce83f0-531f-4e8f-a058-abf977a1b40c",
                                "sense_id": "b61a1422-6966-3729-9d1a-4dab01af9dde",
                                "text": "„Zum Verteilen der Schoko-Nikoläuse werden wir SVler nämlich kostümiert sein – und natürlich gehe ich nicht als Nikoläusin, sondern als Engel.“"
                            },
                            {
                                "example_id": "12333648-2e32-4ab8-ba36-5e1d545bca85",
                                "sense_id": "b61a1422-6966-3729-9d1a-4dab01af9dde",
                                "text": "„Die Nikoläusin kommt dieses Jahr verspätet.“"
                            },
                            {
                                "example_id": "a289806c-7f51-44f2-aff1-80870e9ee78b",
                                "sense_id": "b61a1422-6966-3729-9d1a-4dab01af9dde",
                                "text": "„In der Jahreshauptversammlung am 6. Dezember kam traditionsgemäß auch der Nikolaus bzw. diesmal eine Nikoläusin mit einem gekonnten Vortrag, außerdem hatte sie für jeden etwas mitgebracht.“"
                            },
                            {
                                "example_id": "b8a83156-3d59-4c7e-b81d-91fb2f74e32b",
                                "sense_id": "b61a1422-6966-3729-9d1a-4dab01af9dde",
                                "text": "„Überall in dem kleinen Bergstädtchen zirpt und leuchtet und funzelt es bunt hinter den Fensterscheiben – und drinnen gibt es Schweinefüße und mit Oliven gefüllte Krapfen, während im Fernsehen Nikoläusinnen in gut gefüllten roten Bikinis Showtreppen hinuntergehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
