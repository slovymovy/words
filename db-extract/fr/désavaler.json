                ],
                "senses": [
                    {
                        "sense_id": "cd4b230e-fb2d-35e7-9f4a-9371f7715a14",
                        "entry_id": "f3222fa3-ddc3-3e0a-83fc-de8e65caaece",
                        "glosses": [
                            "Rejeter par la bouche (ce qu’on avait avalé)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "05579b80-8971-454f-b475-8db6a581b65d",
                                "sense_id": "cd4b230e-fb2d-35e7-9f4a-9371f7715a14",
                                "text": "Eh ! braves gens, croyez-vous donc plus à Vénus et à ses illustres incartades qui feraient enfermer ses imitatrices à Saint-Lazare, qu’à ce brave dieu Thi, qui passe son temps à avaler et à désavaler un astre, occupation qui n’a rien de contagieux."
                            },
                            {
                                "example_id": "2b21f24d-ceae-452b-9a29-12356ddd116a",
                                "sense_id": "cd4b230e-fb2d-35e7-9f4a-9371f7715a14",
                                "text": "Je m’y attendais si peu que béate, ma bouche ne désavale que de l’air, aucun mot n’arrivant à se former dedans."
                            },
                            {
                                "example_id": "b6e2ed88-e35a-4024-a2c2-1f17abea25bd",
                                "sense_id": "cd4b230e-fb2d-35e7-9f4a-9371f7715a14",
                                "text": "Un autre possibilité dans ce titre c’est que l’avalée soit « désavalée », que Bérénice soit vomie ou rejetée."
                            }
                        ]
                    }
                ],
