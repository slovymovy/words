                                        "glosses": [
                                            "Cuivre (instrument à vent) de la famille des saxhorns, ressemblant à une trompette en si ♭."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "861ed255-f163-49c2-95f6-814b7a14097e",
                                                "sense_id": "51ca5366-8ddf-3e3d-b2db-04df17c07be9",
                                                "text": "On dansait dans les carrefours, au son des pistons et des bugles, sur la sciure de bois, sous les lanternes vénitiennes."
                                            },
                                            {
                                                "example_id": "ba056737-6a2a-429a-b6c9-dd0fc9d9a7a0",
                                                "sense_id": "51ca5366-8ddf-3e3d-b2db-04df17c07be9",
                                                "text": "Mais on s’en sortait tout de même, en s’arrangeant pour faire donner la grosse caisse aux passages où le bugle avait à jouer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e0828fe6-b6e7-3383-a1a6-c42ade997635",
                                        "entry_id": "870bcf77-774d-31e9-8272-d5027b54871b",
                                        "glosses": [
