                        "glosses": [
                            "A cry; an appeal; a call."
                        ],
                        "tags": [
                            "dialectal"
                        ],
                        "examples": [
                            {
                                "example_id": "21e6e05e-47ff-4ab8-829a-66989497c0a5",
                                "sense_id": "429b1252-f8e9-31e1-9589-9e6b683ac2e4",
                                "text": "So bold was I to show my voice that night / With clepes, and cries, to fill the street throughout / With Creuse’ name in sorrow, with vain tears ; / And often-sithes the same for to repeat."
                            }
                        ]
                    }
