                "senses": [
                    {
                        "sense_id": "f8d1f6d8-f1fa-3169-a479-c5dacae6a78e",
                        "entry_id": "6c2b9a05-864b-3862-a0a0-b90b58f59e9b",
                        "glosses": [
                            "Phénol à odeur caractéristique, contenue dans de nombreuses plantes et en particulier dans le clou de girofle."
                        ],
                        "tags": [
                            "Cosmétologie"
                        ],
                        "examples": [
                            {
                                "example_id": "25dfa696-6592-4e95-8e94-382a5b8fe5c0",
                                "sense_id": "f8d1f6d8-f1fa-3169-a479-c5dacae6a78e",
                                "text": "L’eugénol, tiré de l’essence de girofle par extraction, présente de nombreuses indications en pratique dentaire."
                            },
                            {
                                "example_id": "aac100b3-83c8-42d6-b62e-4e7bf997534c",
                                "sense_id": "f8d1f6d8-f1fa-3169-a479-c5dacae6a78e",
                                "text": "l'eugénol fait partie d'une liste européenne de 26 substances allergisantes dont la présence dans un cosmétique doit être mentionnée sur l'emballage dès que la concentration dépasse 0,001% pour les produits qui se gardent sur la peau (pommade, crème, etc.) et 0,01% pour les produits qui se rincent (savon, gel lavant, etc.)."
                            },
                            {
                                "example_id": "146be84e-0800-407c-a0b9-26f5251e8a6a",
                                "sense_id": "f8d1f6d8-f1fa-3169-a479-c5dacae6a78e",
                                "text": "L'eugénol aurait donc une valeur toxique voisine de celle de l'anisol et un peu inférieure à la moitié de celle du phénol."
                            }
                        ]
                    }
                ],
