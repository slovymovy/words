                "senses": [
                    {
                        "sense_id": "ae2ff3a5-437b-36bf-aad2-7e6bfbd9a213",
                        "entry_id": "8842f662-8fff-3b15-b68e-d3ea3d587420",
                        "glosses": [
                            "Sigle de Forces françaises de l'intérieur, rassemblement en 1944 des principaux groupes militaires de la Résistance intérieure française."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d6f4c8d-000a-454c-a2f7-7d3b5b35c11f",
                                "sense_id": "ae2ff3a5-437b-36bf-aad2-7e6bfbd9a213",
                                "text": "En quelques minutes les drapeaux disparurent. Les rues se vidèrent et les maisons tirèrent leurs volets. Quelques FFI qui se trouvaient là reprirent le chemin des bois."
                            },
                            {
                                "example_id": "1b4ccb2a-e747-4cb9-a5b8-42b091a06c71",
                                "sense_id": "ae2ff3a5-437b-36bf-aad2-7e6bfbd9a213",
                                "text": "Les maquisards d’Auvergne furent bientôt intégrés aux Forces françaises de l’intérieur (FFI) et constituèrent des unités rattachées à la Ire armée des Forces françaises libres, commandées par le général de Lattre de Tassigny."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
