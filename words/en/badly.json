            "senses": [
                {
                    "sense_id": "6635f34c-927c-3a58-b7f9-587048ee04de",
                    "sense_definition": "Not feeling healthy; ill or unwell.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He has been feeling <w>badly</w> ever since he ate that strange food.",
                            "target_lang_translations": {
                                "ru": "Он чувствует себя <w>плохо</w> с тех пор, как съел ту странную еду.",
                                "cs": "Cítí se <w>špatně</w> od té doby, co snědl to divné jídlo.",
                                "pl": "Czuje się <w>źle</w>, odkąd zjadł to dziwne jedzenie.",
                                "zh": "自从吃了那种奇怪的食物后，他一直感到<w>不舒服</w>。"
                            }
                        },
                        {
                            "text": "She looks <w>badly</w> and should probably see a doctor soon.",
                            "target_lang_translations": {
