                "senses": [
                    {
                        "sense_id": "abf105ed-6b7f-3ed1-a801-8fe7da7f8bab",
                        "entry_id": "7ffaeee4-7c74-3cdf-bbb9-4c1775c474d3",
                        "glosses": [
                            "bajkowy, dobrotliwy człowieczek, bardzo małej postury, tradycyjnie z długą brodą, ubrany w czerwony kubraczek i takąż szpiczastą czapkę"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c79a3347-a133-42e3-ae23-fec73b667f4a",
                                "sense_id": "abf105ed-6b7f-3ed1-a801-8fe7da7f8bab",
                                "text": "Powiadał dziadek, że jego samego Krasnoludki tak śpiewać uczyły i zawsze im okruszyny chleba albo i twarogu na ławie zostawiał, bo z ziemi takie jeść nie chcą, jako że swój honor mają"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "0ffbefaf-2661-329b-8242-a12925986099",
                        "entry_id": "7ffaeee4-7c74-3cdf-bbb9-4c1775c474d3",
                        "glosses": [
                            "abstrakcyjny powód, winowajca lub sprawca"
                        ],
                        "tags": [
                            "metaphoric"
                        ],
                        "examples": [
                            {
                                "example_id": "4ac3b891-792b-47da-9bc9-88bc3c1639d9",
                                "sense_id": "0ffbefaf-2661-329b-8242-a12925986099",
                                "text": "To krasnoludki namówiły nas do wódki, • to krasnoludki wszystkiemu winne są"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
