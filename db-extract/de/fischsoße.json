                "senses": [
                    {
                        "sense_id": "d550b919-ee72-3be2-830c-6461209ccd2d",
                        "entry_id": "97f7f5c3-df34-36d4-b663-87b5809472ee",
                        "glosses": [
                            "gewürzte Flüssigkeit, die zu Fischgerichten gereicht wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d0d1a3a4-5f84-4636-b210-3b7e9a2dc14c",
                                "sense_id": "d550b919-ee72-3be2-830c-6461209ccd2d",
                                "text": "„Die am weitesten verbreitete ist, dass Ketchup aus China stammt und dort eine gewürzte Fischsoße bezeichnete.“"
                            },
                            {
                                "example_id": "ec2acd8c-07eb-41a5-a51a-7563999d466d",
                                "sense_id": "d550b919-ee72-3be2-830c-6461209ccd2d",
                                "text": "„Indische Kinder können scharf essen, asiatische Kinder vertragen vergorene Fischsoße.“"
                            },
                            {
                                "example_id": "d942f52c-18a3-4c3a-8bcd-068f82d21699",
                                "sense_id": "d550b919-ee72-3be2-830c-6461209ccd2d",
                                "text": "„Fischsoßen sind traditionelle Würzsaucen der asiatischen Küche.“"
                            }
                        ],
