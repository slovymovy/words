{
    "word_family": [
        "diminish",
        "diminution",
        "diminutive"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "3b44fd16-a223-39a5-a1f9-2149e0d57220",
                    "sense_definition": "Becoming smaller, fewer, or less in size, degree, or importance.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company faced <w>diminishing</w> returns on its marketing investments over the last year.",
                            "target_lang_translations": {
                                "de": "Das Unternehmen verzeichnete im letzten Jahr <w>abnehmende</w> Erträge bei seinen Marketinginvestitionen."
                            }
                        },
                        {
                            "text": "They had to survive on <w>diminishing</w> supplies as the winter went on.",
                            "target_lang_translations": {
                                "de": "Sie mussten im weiteren Verlauf des Winters mit <w>schwindenden</w> Vorräten überleben."
                            }
                        }
                    ],
                    "synonyms": [
                        "decreasing",
                        "dwindling",
                        "declining"
                    ],
                    "antonyms": [
                        "increasing",
                        "growing"
                    ],
                    "common_phrases": [
                        "diminishing returns",
                        "diminishing supplies",
                        "diminishing resources"
                    ],
                    "target_lang_definitions": {
                        "de": "Kleiner, weniger oder geringer werdend in Bezug auf Größe, Grad oder Bedeutung."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "abnehmend",
                                "target_lang_sense_clarification": "allgemeiner Begriff für das Kleiner- oder Wenigerwerden"
                            },
                            {
                                "target_lang_word": "schwindend",
                                "target_lang_sense_clarification": "betont das Verschwinden oder den Verlust von etwas"
                            },
                            {
                                "target_lang_word": "sinkend",
                                "target_lang_sense_clarification": "oft verwendet bei Werten, Zahlen oder Erträgen"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4d2de26e-8f9b-3e94-a57e-5ab3bbad252a",
                    "sense_definition": "present participle and gerund of <w>diminish</w>",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rain was <w>diminishing</w> rapidly, allowing the sun to shine through the clouds.",
                            "target_lang_translations": {
                                "de": "Der Regen war schnell <w>abnehmend</w>, sodass die Sonne durch die Wolken scheinen konnte."
                            }
                        },
                        {
                            "text": "By <w>diminishing</w> the risk of failure, the new strategy helped the team succeed.",
                            "target_lang_translations": {
                                "de": "Indem sie das Risiko des Scheiterns <w>verringerte</w>, half die neue Strategie dem Team zum Erfolg."
                            }
                        }
                    ],
                    "common_phrases": [
                        "diminishing the risk",
                        "diminishing the impact"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle and gerund form"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Partizip Präsens und Gerundium von 'verringern' oder 'abnehmen'."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "verringernd",
                                "target_lang_sense_clarification": "aktiver Prozess des Reduzierens"
                            },
                            {
                                "target_lang_word": "abnehmend",
                                "target_lang_sense_clarification": "der Prozess des Kleinerwerdens"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9c9469a5-f137-3b96-8a9a-9774ed975551",
                    "sense_definition": "The act or process of becoming smaller or less.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The constant <w>diminishing</w> of their influence caused concern among board members.",
                            "target_lang_translations": {
                                "de": "Das ständige <w>Schwinden</w> ihres Einflusses sorgte bei den Vorstandsmitgliedern für Besorgnis."
                            }
                        },
                        {
                            "text": "A gradual <w>diminishing</w> of sound could be heard as the train pulled away.",
                            "target_lang_translations": {
                                "de": "Ein allmähliches <w>Abnehmen</w> des Geräusches war zu hören, als der Zug abfuhr."
                            }
                        }
                    ],
                    "synonyms": [
                        "diminishment",
                        "reduction",
                        "decline"
                    ],
                    "antonyms": [
                        "increase",
                        "growth"
                    ],
                    "common_phrases": [
                        "gradual diminishing"
                    ],
                    "target_lang_definitions": {
                        "de": "Der Vorgang oder Prozess, bei dem etwas kleiner oder weniger wird."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Verringerung",
                                "target_lang_sense_clarification": "allgemeiner Prozess der Reduktion"
                            },
                            {
                                "target_lang_word": "Abnahme",
                                "target_lang_sense_clarification": "der Vorgang des Rückgangs"
                            },
                            {
                                "target_lang_word": "Schwinden",
                                "target_lang_sense_clarification": "das allmähliche Verschwinden oder Abnehmen"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}