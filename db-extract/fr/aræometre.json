                        "sense_id": "e32218b7-4b62-3fd2-bb01-b3c80e7a16bf",
                        "entry_id": "6dce8441-1885-388f-9c14-93f44f4cf7da",
                        "glosses": [
                            "Variante orthographique de aréomètre."
                        ],
                        "tags": [
                            "alt-of",
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "f87966af-0bfe-4a8f-893c-4c3666bb5c62",
                                "sense_id": "e32218b7-4b62-3fd2-bb01-b3c80e7a16bf",
                                "text": "Il faudroit en ſecond lieu determiner le degré de l’acide par ſa peſanteur , & la peſanteur par la demerſion de l’Aræometre."
                            },
                            {
                                "example_id": "c0a46cc4-7501-4c64-8e60-6ffe2b5d1cf4",
                                "sense_id": "e32218b7-4b62-3fd2-bb01-b3c80e7a16bf",
                                "text": "L’épreuvre de la facilité que l’eau a à s’échauffer , que l’on a faite par le thermometre , a marqué des differences ſans comparaiſon plus remarquables que celles que l’on a faites avec l’aræometre , où la difference de la plus peſante eau à la plus legere a fait voir des differences ſi petites , qu’il eſt très difficile de les connoitre qu’entre les eaux qu’on ſçait d’ailleurs être fort differentes en bonté."
                            },
                            {
                                "example_id": "30a4630c-0480-426c-b289-864c7017add7",
                                "sense_id": "e32218b7-4b62-3fd2-bb01-b3c80e7a16bf",
                                "text": "L’Aræometre plongé dans l’eau de la mer peſoit 2 onces 3 dragmes 57 grains."
                            }
                        ]
                    }
