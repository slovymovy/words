                                                "example_id": "fe864797-c9bd-473b-a435-67047265057e",
                                                "sense_id": "540506df-60b7-3337-8112-2edb5ee6c1db",
                                                "text": "Titan ist der zweitgrößte Mond unseres Sonnensystems."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
