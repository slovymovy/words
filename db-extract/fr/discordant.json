                "senses": [
                    {
                        "sense_id": "b588efcf-b8e3-3e1c-92b6-76a170101701",
                        "entry_id": "04634bb4-d8bf-3d8a-894c-67c96813eb16",
                        "glosses": [
                            "Qui n’est pas d’accord, ou qu’on ne peut que difficilement accorder."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7fbeef3-54ba-45dc-a8f5-3f67908d1415",
                                "sense_id": "b588efcf-b8e3-3e1c-92b6-76a170101701",
                                "text": "Tout à coup un point blanc se montra au ciel, dans le nord ; il grandit rapidement en venant sur nous, et nous entendîmes un étrange murmure de cris discordants ; c’étaient des oies ou des cygnes sauvages, qui du Nord émigraient dans le Midi ; ils passèrent au-dessus de nos têtes et ils étaient déjà loin qu’on voyait encore voltiger dans l’air quelques flocons de duvet, dont la blancheur se détachait sur le ciel noir."
                            },
                            {
                                "example_id": "2e8a565e-7048-4d20-aa6b-19939e1144cf",
                                "sense_id": "b588efcf-b8e3-3e1c-92b6-76a170101701",
                                "text": "Voix discordante."
                            },
                            {
                                "example_id": "feb3b250-77f2-45e4-a7a7-5cbac143ea0a",
                                "sense_id": "b588efcf-b8e3-3e1c-92b6-76a170101701",
                                "text": "Instrument discordant."
                            },
                            {
                                "example_id": "bff7b086-d9a2-4b2a-a689-cd2cc6b3619b",
                                "sense_id": "b588efcf-b8e3-3e1c-92b6-76a170101701",
                                "text": "Ton discordant. On dit dans un sens analogue"
                            },
                            {
                                "example_id": "0f1b551d-3933-4eee-a95e-748c23ccb4a8",
                                "sense_id": "b588efcf-b8e3-3e1c-92b6-76a170101701",
                                "text": "Chant discordant."
                            }
                        ]
                    },
                    {
                        "sense_id": "118134de-7b3f-3343-9579-bfdc720229a3",
                        "entry_id": "04634bb4-d8bf-3d8a-894c-67c96813eb16",
                        "glosses": [
                            "Qui va mal avec d’autres choses, qui a dû mal à s’accorder avec."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "06036424-ba58-418c-9b09-e9f7129a184d",
                                "sense_id": "118134de-7b3f-3343-9579-bfdc720229a3",
                                "text": "Des couleurs discordantes."
                            },
                            {
                                "example_id": "11225591-8bde-4128-9527-072c5303bbbb",
                                "sense_id": "118134de-7b3f-3343-9579-bfdc720229a3",
                                "text": "opinions, humeurs discordantes."
                            },
                            {
                                "example_id": "9bc6e052-c9ef-477b-84eb-a33f735a3e92",
                                "sense_id": "118134de-7b3f-3343-9579-bfdc720229a3",
                                "text": "caractères discordants."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "48dd3134-2f13-4d0e-8517-462fd37dca9b",
                        "source_entry_id": "04634bb4-d8bf-3d8a-894c-67c96813eb16",
                        "target_lang_word": "unmusical",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unmusical",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "eec4219f-e72e-34eb-9595-3e423506b1f0",
                                        "entry_id": "344fdd4a-058c-36c6-a081-f65f11eb08f4",
                                        "glosses": [
                                            "Not musical: lacking in musical ability."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ec27478e-4a50-3f56-b0ba-2a169bccac7b",
                                        "entry_id": "344fdd4a-058c-36c6-a081-f65f11eb08f4",
                                        "glosses": [
                                            "Not musical: unmelodic."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce7f9111-b53f-4707-b6f6-601ff8a69ac1",
                                                "sense_id": "ec27478e-4a50-3f56-b0ba-2a169bccac7b",
                                                "text": "The harp itself was a huge gourd, and a most unmusical \"shell\" it proved to be."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2dfdef2d-a3ff-49b7-85ea-c4f9562ff6bc",
                        "source_entry_id": "04634bb4-d8bf-3d8a-894c-67c96813eb16",
                        "target_lang_word": "discordant",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "discordant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6cc7bee9-279e-34f1-bc6e-f41ed5f71d12",
                                        "entry_id": "dab14949-c65b-3de7-930b-44987caa72c8",
                                        "glosses": [
                                            "Not in accord or harmony; conflicting, incompatible."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af98c69e-22bf-4c6d-8a67-30dfbb575492",
                                                "sense_id": "6cc7bee9-279e-34f1-bc6e-f41ed5f71d12",
                                                "text": "For it is poſſible long ſtudy may encreaſe, and confirm erroneous Sentences: and vvhere men build on falſe grounds, the more they build, the greater is the ruine: and of thoſe that ſtudy, and obſerve vvith equall time, and diligence, the reaſons and reſolutions are, and muſt remain diſcordant: […]"
                                            },
                                            {
                                                "example_id": "b87d5325-dd1f-4232-accf-f827bddc7bd2",
                                                "sense_id": "6cc7bee9-279e-34f1-bc6e-f41ed5f71d12",
                                                "text": "[T]hat vvhich vve call Conſcience is to be referred, namely, if by a due compariſon of things done vvith the rule, there be a conſonancy follovvs the ſentence Approbation; if diſcordant from it, the ſentence of Condemnation."
                                            },
                                            {
                                                "example_id": "3541d793-6f57-4d9a-8304-cc7b7f473db7",
                                                "sense_id": "6cc7bee9-279e-34f1-bc6e-f41ed5f71d12",
                                                "text": "Thy ſenate is a ſcene of civil jar, / Chaos of contrarieties at vvar, / VVhere ſharp and ſolid, phlegmatic and light, / Diſcordant atoms meet, ferment and fight, […]"
                                            },
                                            {
                                                "example_id": "e1800445-f8fc-4573-9d18-ca910dac241c",
                                                "sense_id": "6cc7bee9-279e-34f1-bc6e-f41ed5f71d12",
                                                "text": "If, after all, he should experience an evil or unpleasant impression, let him throw aside first these volumes, as the lightest; then Cicero, Demosthenes, and every one else whose political notions, so discordant from those now prevalent, are represented in them; […]"
                                            },
                                            {
                                                "example_id": "c937e634-3eec-4410-b94c-348eb4bc20ce",
                                                "sense_id": "6cc7bee9-279e-34f1-bc6e-f41ed5f71d12",
                                                "text": "It is very probable, that Hephaistos and other deities may have been known under forms of tradition variously modified, in Troas and in Greece respectively; and, indeed, in different portions of one and the same country. These forms, however distinct or discordant, the plan of Homer required him in some manner to amalgamate."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "34f59ba0-655c-35b9-a2ab-e37e0cd2e29b",
                                        "entry_id": "dab14949-c65b-3de7-930b-44987caa72c8",
                                        "glosses": [
                                            "Not in accord or harmony; conflicting, incompatible.",
                                            "Of people: disagreeing with each other; dissenting, quarrelsome."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0be3c372-1a7b-4b25-95b0-7c8d25f90c58",
                                                "sense_id": "34f59ba0-655c-35b9-a2ab-e37e0cd2e29b",
                                                "text": "Rumour is a pipe, / Blovvne by ſurmizes, Iealouſies[,] coniectures, / And of ſo eaſie, and ſo plaine a ſtop, / That the blunt monſter, vvith vncounted heads, / The ſtill diſcordant vvau'ring multitude, / Can play vpon it."
                                            },
                                            {
                                                "example_id": "d3adceee-cca5-49bf-962c-7223f6dd47e3",
                                                "sense_id": "34f59ba0-655c-35b9-a2ab-e37e0cd2e29b",
                                                "text": "Yet this Baſilius [Basil I, who had Michael III assassinated] vvaſhed his hands and made many Proteſtations that he had no hand in his blood. This made for the Popes advantage: VVomen and Rebels and Traytors and diſcordant Princes did much in raiſing him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c64b4313-587e-3a08-9e07-d89edf7c9a88",
                                        "entry_id": "dab14949-c65b-3de7-930b-44987caa72c8",
                                        "glosses": [
                                            "Not in accord or harmony; conflicting, incompatible.",
                                            "Of sounds: harsh, jarring; specifically (music), of musical notes or tunes: not in harmony; dissonant, inharmonious."
                                        ],
                                        "tags": [
                                            "also",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6b2daa38-2ef5-4a01-ac24-5a5d6729ea0a",
                                                "sense_id": "c64b4313-587e-3a08-9e07-d89edf7c9a88",
                                                "text": "[N]o other kind of liuing beaſtes both behold the fayrenes and the bewtie of the wordle^([sic – meaning worlde]), or is moued with anny reſpect of ſauours, but only for the diuerſity of meates, nother perceaueth the concordaunt and diſcordante diſtaunces of ſoundes, and tunes […]"
                                            },
                                            {
                                                "example_id": "b9ab6c25-2fe8-4795-b629-831b877cf10a",
                                                "sense_id": "c64b4313-587e-3a08-9e07-d89edf7c9a88",
                                                "text": "But hovv fatally ſecure ſhould vve be, if God ſhould permit this Syren alvvaies to entertain us vvith her muſic, and ſhould not by ſome diſcordant grating notes, interrupt our raptures, and recal us to ſober thoughts?"
                                            },
                                            {
                                                "example_id": "a170f72f-d0f9-43f3-9631-eee0e1b9c261",
                                                "sense_id": "c64b4313-587e-3a08-9e07-d89edf7c9a88",
                                                "text": "VVar, vvith diſcordant Notes and jarring Noiſe, / The Harmony of Peace deſtroys."
                                            },
                                            {
                                                "example_id": "650b1d70-b25b-487c-af4c-cfa8db8ca0cc",
                                                "sense_id": "c64b4313-587e-3a08-9e07-d89edf7c9a88",
                                                "text": "In the heart / No paſſion touches a diſcordant ſtring, / But all is harmony and love."
                                            },
                                            {
                                                "example_id": "fed1cd83-9213-4ad0-88db-cb4e243a72be",
                                                "sense_id": "c64b4313-587e-3a08-9e07-d89edf7c9a88",
                                                "text": "[T]rue, Mac's apology and subsequent behaviour rather raised him in the opinion of his fellow-castaways. But the discordant note had been struck, and its harmonics tingled in the brain."
                                            },
                                            {
                                                "example_id": "a68a4f6c-541d-4b52-9afc-f021c0a0f0ec",
                                                "sense_id": "c64b4313-587e-3a08-9e07-d89edf7c9a88",
                                                "text": "With this shift in both what shows are being made, and in what viewers desire, the genre hearteningly appears to be reverting to its roots of being an entertainment spectacular, giving the space for novelty and mad-cap amusement that's presented in a warm and humorous way. After a discordant patch, it's in tune again – even if some auditionees, as ever, are not."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "86366a04-9801-388f-a80d-899dba1e4eda",
                                        "entry_id": "dab14949-c65b-3de7-930b-44987caa72c8",
                                        "glosses": [
                                            "Of a rock formation or other land feature, or its alignment: cutting across or transverse to neighbouring features."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3bf75399-7210-4077-8191-e13a1e6575be",
                                                "sense_id": "86366a04-9801-388f-a80d-899dba1e4eda",
                                                "text": "Dikes may be discordant to country rock if they intrude at a high angle to the bedding."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6fa93789-61c7-35e4-a463-756c6bed0ec6",
                                        "entry_id": "dab14949-c65b-3de7-930b-44987caa72c8",
                                        "glosses": [
                                            "Of a rock formation or other land feature, or its alignment: cutting across or transverse to neighbouring features.",
                                            "Of a coastline: having bands of different types of rock running transversely to the coast, leading to the formation of alternating bays and headlands."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "15f7fee8-145d-3451-a0a1-a1176baa66fc",
                                        "entry_id": "dab14949-c65b-3de7-930b-44987caa72c8",
                                        "glosses": [
                                            "Of two similar subjects, especially twins: differing in some characteristic."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "50f8e27c-b3f4-35ea-a2d4-dd0e81e5bf33",
                                        "entry_id": "dab14949-c65b-3de7-930b-44987caa72c8",
                                        "glosses": [
                                            "Ellipsis of serodiscordant (“of a couple: with one partner HIV positive and the other HIV negative”)."
                                        ],
