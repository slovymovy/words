                "translations": [
                    {
                        "translation_id": "40e27be3-829d-43a1-a1ea-12fbcb8c64d4",
                        "source_entry_id": "1311c47f-f88b-31c6-a6eb-ad61fa0279fb",
                        "source_sense_id": "9852f0b3-e79e-3739-872e-980af4b7c36d",
