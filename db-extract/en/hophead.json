                        "glosses": [
                            "A drug addict."
                        ],
                        "tags": [
                            "US",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "8b3ae8b4-9987-4034-bf0c-6bbfe15c5f45",
                                "sense_id": "5f3c3033-5f29-35ac-9d87-97752800b0fa",
                                "text": "For the alcoholic there are numerous substitutes: a period of intense diversion and excitement, pressing need for rest, hypnotic sedatives, sleep. Not for the hophead. Sedatives don't touch it; he can't rest; he can't even sleep."
                            },
                            {
                                "example_id": "fc09fb85-590c-474f-9a5e-7f4c93e7cb79",
                                "sense_id": "5f3c3033-5f29-35ac-9d87-97752800b0fa",
                                "text": "“Oed,” looking at her puzzled, “you don't get addicted. It's not like you're some hophead. You take it because it's good. […]"
                            },
                            {
                                "example_id": "4c7809c4-2ee0-4c56-9e8a-404ed8f241e3",
                                "sense_id": "5f3c3033-5f29-35ac-9d87-97752800b0fa",
                                "text": "Why should we all go around on tiptoe forever pretending the kid's not a hophead?"
                            }
                        ]
                    },
                    {
                        "sense_id": "96a4f08e-0ed2-399e-8284-70693135179e",
                        "entry_id": "ef43a8b1-4f96-30f9-a329-b6a0c4ce3e48",
                        "glosses": [
