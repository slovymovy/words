                        "examples": [
                            {
                                "example_id": "0923a8b0-093e-4729-8892-274c97b95772",
                                "sense_id": "17224802-2e94-3cb6-a276-705e63de5e55",
                                "text": "De conclusie van Albertus, afgelopen jaar de beste Nederlander op het KLM Open en spelend op de Pro Golf Tour, het derde Europese niveau: bij putts van een meter of tien of langer laat hij de vlag er sowieso in. „Dan is het fijn dat niemand de vlag hoeft te bewaken. Er is geen afleiding tijdens het putten van die persoon én je ziet de hole beter.”"
                            }
                        ]
                    },
                    {
                        "sense_id": "2fb58543-026d-3219-b116-f7bf07c535c9",
                        "entry_id": "a166989c-e9aa-3b5a-b1ea-2ff851feb85e",
                        "glosses": [
                            "hele traject van de afslag tot het bijbehorende putje, als onderdeel van een golfbaan"
                        ],
                        "tags": [
                            "golf"
                        ],
                        "examples": [
                            {
                                "example_id": "1283af02-c19f-40bf-a008-2e83097f768b",
                                "sense_id": "2fb58543-026d-3219-b116-f7bf07c535c9",
                                "text": "Golfer Tiger Woods slaat een bal op de negende hole in de eerste ronde van de Amerikaanse open kampioenschappen in Pebble Beach in Californië."
                            }
                        ]
                    },
                    {
                        "sense_id": "07c68b82-bd5e-39f8-85ee-8bd881c11d09",
                        "entry_id": "a166989c-e9aa-3b5a-b1ea-2ff851feb85e",
                        "glosses": [
                            "hele traject van de afslag tot het bijbehorende putje, als onderdeel van een golfwedstrijd"
                        ],
                        "tags": [
                            "golf"
                        ],
                        "examples": [
                            {
                                "example_id": "498b83fa-ad2f-4225-9cc5-9db7d240bd78",
                                "sense_id": "07c68b82-bd5e-39f8-85ee-8bd881c11d09",
                                "text": "„Ik heb tijdens mijn laatste ronde geen moment gedacht aan de overwinning”, liet Woodland weten. ”Ik heb gewoon hole na hole mijn spel gespeeld.”"
                            },
                            {
                                "example_id": "d23e333b-f12a-43de-b390-03f2282bf788",
                                "sense_id": "07c68b82-bd5e-39f8-85ee-8bd881c11d09",
                                "text": "Tijdens een wedstrijdje matchplay op de golfclub sla ik mijn bal in het water naast de vlag van de 14de. Dat is zuur, want op deze manier verlies ik waarschijnlijk deze hole."
                            }
                        ]
