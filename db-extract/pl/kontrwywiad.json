                    },
                    {
                        "translation_id": "c5d80dfb-1d1c-434d-92be-20b3eea30b50",
                        "source_entry_id": "324bafd3-77d4-3362-963a-48a9f4155856",
                        "source_sense_id": "daccc115-50f3-3428-b806-b8ecedb400ee",
                        "target_lang_word": "contrainteligencia",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "7ce53554-3eba-4221-8b3c-671bddc3e6b9",
                        "source_entry_id": "324bafd3-77d4-3362-963a-48a9f4155856",
                        "source_sense_id": "daccc115-50f3-3428-b806-b8ecedb400ee",
                        "target_lang_word": "Abwehr",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Abwehr",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "be98e516-58f9-3394-be54-30dd4a705fb5",
                                        "entry_id": "31bb2f97-232d-385f-9ece-f0cadde582cb",
                                        "glosses": [
                                            "Maßnahme, um einen Angriff oder dessen beabsichtigte Auswirkung zu stoppen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a69e03e1-44b4-442b-abf4-3227a3ab084d",
                                                "sense_id": "be98e516-58f9-3394-be54-30dd4a705fb5",
                                                "text": "Mit der Abwehr des letzten Angriffes war ihm der Sieg sicher."
                                            },
                                            {
                                                "example_id": "75e5cefc-beea-4f3a-9143-e70eb44b0da2",
                                                "sense_id": "be98e516-58f9-3394-be54-30dd4a705fb5",
                                                "text": "Zur Abwehr der Eindringlinge werden vermehrt weiße Blutkörperchen produziert."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4d50064c-d448-3fc7-a325-44f39cc99e99",
                                        "entry_id": "31bb2f97-232d-385f-9ece-f0cadde582cb",
                                        "glosses": [
                                            "Haltung voller Ablehnung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "032ad5b8-4823-4e33-aa11-e76200a4071b",
                                                "sense_id": "4d50064c-d448-3fc7-a325-44f39cc99e99",
                                                "text": "Er schwieg einfach und starrte geradeaus, seine Abwehr war einfach undurchdringlich."
                                            },
                                            {
                                                "example_id": "2b2996c3-e90c-4fce-9480-5d9461aa7b3a",
                                                "sense_id": "4d50064c-d448-3fc7-a325-44f39cc99e99",
                                                "text": "Es sind ja nicht nur die Kosten, wir müssen auch mit einer Abwehr der Bevölkerung rechnen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "0737ae79-37a4-3b9f-bc5f-12a405d5c27f",
                                        "entry_id": "31bb2f97-232d-385f-9ece-f0cadde582cb",
                                        "glosses": [
                                            "Gruppe, die die Verteidigung übernimmt, zum Beispiel bei Mannschaftssportarten wie Fußball oder auch beim Geheimdienst oder Militär"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c53d8bc-73ef-46d0-920d-6c98e66701ec",
                                                "sense_id": "0737ae79-37a4-3b9f-bc5f-12a405d5c27f",
                                                "text": "Mit einer Abwehr aus tausenden Speerkämpfern mit Schilden mussten sie sich kaum Sorgen machen."
                                            },
                                            {
                                                "example_id": "157cf153-f6b9-42d0-a0e9-9002b0e3c7f4",
                                                "sense_id": "0737ae79-37a4-3b9f-bc5f-12a405d5c27f",
                                                "text": "Der Libero war einmal mehr phantastisch, die Abwehr hingegen lausig."
                                            },
                                            {
                                                "example_id": "5704c9c2-f2d4-4782-bc57-2cffd81da0c9",
                                                "sense_id": "0737ae79-37a4-3b9f-bc5f-12a405d5c27f",
                                                "text": "Sie hatte im 2. Weltkrieg für die Abwehr gearbeitet."
                                            },
                                            {
                                                "example_id": "5926acc8-1b04-464d-861c-3cba37cfd415",
                                                "sense_id": "0737ae79-37a4-3b9f-bc5f-12a405d5c27f",
                                                "text": "„Daß er von Wehrmacht und Abwehr des Großdeutschen Reiches wie eine Stecknadel gesucht wurde, wußte Thomas Lieven nicht.“"
                                            },
                                            {
                                                "example_id": "c4c2e2f6-c4a8-4d8d-87e4-94a965425101",
                                                "sense_id": "0737ae79-37a4-3b9f-bc5f-12a405d5c27f",
                                                "text": "[Fußball:] „Die drittbeste Abwehr der Liga bei zugleich den wenigsten Gelben Karten sind nur zwei bemerkenswerte Statistiken von St. Paulis Saison.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
