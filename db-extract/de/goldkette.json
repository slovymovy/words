                                "sense_id": "50520dfc-fa59-3772-91b2-2e7009ffbb5c",
                                "text": "Sie wünscht sich eine Goldkette zum Geburtstag."
                            },
                            {
                                "example_id": "02f67848-6258-4676-a01d-d08be5992ded",
                                "sense_id": "50520dfc-fa59-3772-91b2-2e7009ffbb5c",
                                "text": "„Arbeitsplätze hängen von mir ab wie Goldketten.“"
                            },
                            {
                                "example_id": "c78fe077-3103-4a66-82e4-28d4f3158d62",
                                "sense_id": "50520dfc-fa59-3772-91b2-2e7009ffbb5c",
                                "text": "„Goldketten glitzerten an den Handgelenken ihrer Besitzer.“"
                            }
                        ],
