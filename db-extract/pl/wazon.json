                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "377f2c18-e68a-4144-a579-f5d70ff06995",
                                                "sense_id": "33fcfb8e-e4e7-38ff-b9cc-206961be2763",
                                                "text": "Este jarrón decorado con un motivo de gacelas se situaba originariamente en un ángulo de la Qubba al-Kubra (actualmente denominada «Sala de Dos Hermanas») del palacio nazarí de la la Alhambra de Granada, de donde pasó a la «Sala de los Reyes» antes de formar parte de las colecciones del Museo de la Alhambra en los años 40"
                                            }
                                        ],
