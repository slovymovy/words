                        "cross_references": [
                            {
                                "target_word": "corbeau freux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3674b207-dc39-3ca5-8314-9c36fc374dd1",
                                        "entry_id": "0f9a15c8-20e7-32bf-961f-fbc2d6966c54",
                                        "glosses": [
                                            "Espèce d’oiseau passereau d’Eurasie, corbeau au plumage noir d’un éclat métallique ou brun-violet et à bec effilé et non garni de plumes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e630a17-076f-4953-b790-16502ed4d985",
                                                "sense_id": "3674b207-dc39-3ca5-8314-9c36fc374dd1",
                                                "text": "Le terme vernaculaire (nom commun générique) de « corbeau » désigne plusieurs espèces de corvidés, allant du grand corbeau (Corvus corax) à la corneille (Corvus corone), en passant par le corbeau freux (Corvus frugilegus)."
                                            },
                                            {
                                                "example_id": "32189aea-9339-4ec7-8c45-cb42729f27eb",
                                                "sense_id": "3674b207-dc39-3ca5-8314-9c36fc374dd1",
                                                "text": "Le corbeau freux, essentiellement végétarien, se réunit en bandes et s’approche volontiers des habitations."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f9beb1d8-6ee1-4275-9452-4b9a3be2dbc3",
                        "source_entry_id": "000d19fd-95a4-37a5-8fa8-8040346b630c",
                        "source_sense_id": "6540019e-f0f9-39a2-a250-6a7dcabdfdaa",
                        "source_sense_description": "bepaalde soort kraaiachtige vogel, Corvus frugilegus",
                        "target_lang_word": "freux",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
