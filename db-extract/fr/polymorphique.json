                "senses": [
                    {
                        "sense_id": "51e217f1-de01-3da7-b12d-5602e2461c5b",
                        "entry_id": "24db49f5-c36e-3fe6-9436-e2804350ec35",
                        "glosses": [
                            "Relatif au polymorphisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e89448bb-0bbb-4861-93df-0475e08227dd",
                                "sense_id": "51e217f1-de01-3da7-b12d-5602e2461c5b",
                                "text": "Si la substance n’est pas un corps simple mais un corps composé on dit que le solide existe sous deux formes « polymorphiques ». C’est ainsi que la glace existe sous six formes polymorphiques, c’est-à-dire que la glace existe sous six formes cristallisées différentes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "433f29fd-a058-41f0-bf78-bf6bf769c8d6",
                        "source_entry_id": "24db49f5-c36e-3fe6-9436-e2804350ec35",
                        "source_sense_id": "51e217f1-de01-3da7-b12d-5602e2461c5b",
