                ],
                "senses": [
                    {
                        "sense_id": "21d29ce4-1387-32e1-a174-3f679f63c0b3",
                        "entry_id": "713fa266-7aa3-368f-a42a-e9758c227193",
                        "glosses": [
                            "Chef le plus élevé dans la hiérarchie."
                        ],
                        "tags": [
                            "Maroc",
                            "Algérie"
                        ],
                        "examples": [
                            {
                                "example_id": "30632a4b-ebc3-4ee9-9e35-0d75bb7834c6",
                                "sense_id": "21d29ce4-1387-32e1-a174-3f679f63c0b3",
                                "text": "Le traité franco-espagnol du 27 novembre 1912 prévoyait que les zones hispaniques seraient administrées par un khalifa (vice-roi)."
                            },
                            {
                                "example_id": "fa6ae917-e956-4b83-a878-7e178ddd3247",
                                "sense_id": "21d29ce4-1387-32e1-a174-3f679f63c0b3",
                                "text": "Lorsqu'une ghazia est faite, soit par un agha, soit par un khalifa, soit par l’émir ; le gouvernement prélève un cinquième sur le produit de la ghazia."
                            },
                            {
                                "example_id": "1afac1cb-4500-4955-b297-a87ca0cd6d65",
                                "sense_id": "21d29ce4-1387-32e1-a174-3f679f63c0b3",
                                "text": "Le grand-vizir s’est réservé le caïdat paternel des Glaoua et ceux, très productifs des Mesfioua et des Touggana administrés par des khalifas."
                            }
                        ]
                    }
                ],
