                "senses": [
                    {
                        "sense_id": "3a29ac4d-82c6-3817-9879-3341ff898f6c",
                        "entry_id": "58fafe3c-fcad-3ef3-a005-755d7f4e519a",
                        "glosses": [
                            "Plante monocotylédone à fleurs blanches de la famille des liliacées, souvent confondue avec le muguet."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4aed3606-f8fe-4ac2-8af0-1f79ce937598",
                                "sense_id": "3a29ac4d-82c6-3817-9879-3341ff898f6c",
                                "text": "Je me mis à mon herbier : du cornouiller du Canada (Cornus canadensis Lin.) qui s’étalait sur la mousse, avec ses rosettes à six feuilles et ses baies rouges ; du maïanthème du Canada aussi (Maianthemum canadense Des.) avec ses doubles feuilles juteuses en cœur, très luisantes ; une variété particulière de lycopode (Lycopodium annotinum Lin.) et, enfin, des fougères (Pephrodium dilatatum Des. et Polypodium vulgare Lin.), la première ressemblant vaguement à la fougère-aigle, dotée d’une fronde à la structure assez simple."
                            },
                            {
                                "example_id": "7f2e3d87-6b47-4df9-bf45-82206de20797",
                                "sense_id": "3a29ac4d-82c6-3817-9879-3341ff898f6c",
                                "text": "Le maïanthème fleurit bien au printemps qui suit la coupe, mais ne tarde pas à disparaître si le sol reste dénudé : quelques feuilles isolées et rabougries persistent seules."
                            }
                        ]
                    }
