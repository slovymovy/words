                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The gardener used a strip of <w>bass</w> to tie the young plant to the stake.",
                            "target_lang_translations": {
