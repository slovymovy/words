                "senses": [
                    {
                        "sense_id": "a3c694db-91d1-3687-97f3-03e6cd073d2e",
                        "entry_id": "be93ab99-4b37-31be-bea6-ad2970279cbd",
                        "glosses": [
                            "Pterodactylus, rodzaj wymarłego latającego gada należącego do rzędu pterozaurów, żyjącego w okresie późnej jury"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8127a067-b4b7-48d2-a629-7cd5e1fd80ff",
                                "sense_id": "a3c694db-91d1-3687-97f3-03e6cd073d2e",
                                "text": "Czy wiesz, że pterodaktyl nie był dinozaurem?"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "50170346-4b1b-4fcd-bd65-bb2e3c48161c",
                        "source_entry_id": "be93ab99-4b37-31be-bea6-ad2970279cbd",
                        "source_sense_id": "a3c694db-91d1-3687-97f3-03e6cd073d2e",
                        "target_lang_word": "pterodactyl",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pterodactyl",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "93177993-5bb8-3b6f-9879-414ddbeebc94",
                                        "entry_id": "e483ddb1-e035-3fa4-b6d8-5d213365313f",
                                        "glosses": [
                                            "A pterosaur of the genus Pterodactylus."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a7aaca66-3848-32dc-ae0c-5086c08f08d6",
                                        "entry_id": "e483ddb1-e035-3fa4-b6d8-5d213365313f",
                                        "glosses": [
                                            "Any pterosaur."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "proscribed"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ea84ff6c-f8e3-4f12-a54c-015f88958638",
                                                "sense_id": "a7aaca66-3848-32dc-ae0c-5086c08f08d6",
                                                "text": "He described also the iguanodon and the pterodactyl - two of the first of the wonders which they had encountered."
                                            },
                                            {
                                                "example_id": "0124485a-f68f-4486-b5ef-d2d3492d42d8",
                                                "sense_id": "a7aaca66-3848-32dc-ae0c-5086c08f08d6",
                                                "text": "Had a pterodactyl swooped down from those old-time crags, it would hardly have been out of place."
                                            },
                                            {
                                                "example_id": "befc3291-0c10-48d3-befa-816afaafb66b",
                                                "sense_id": "a7aaca66-3848-32dc-ae0c-5086c08f08d6",
                                                "text": "Now let me tell you, Brisbane mossies in the sixties were as big as pterodactyls."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "093c0fcf-2371-419d-bade-3b5d1f2c2d33",
                        "source_entry_id": "be93ab99-4b37-31be-bea6-ad2970279cbd",
                        "source_sense_id": "a3c694db-91d1-3687-97f3-03e6cd073d2e",
                        "target_lang_word": "pterodaktyl",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "a35d6bca-483b-4088-bf1a-7dd97b953e5d",
                        "source_entry_id": "be93ab99-4b37-31be-bea6-ad2970279cbd",
                        "source_sense_id": "a3c694db-91d1-3687-97f3-03e6cd073d2e",
                        "target_lang_word": "ptérodactyle",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ptérodactyle",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ae12ffd7-e339-38b3-a1bf-49dd5943714f",
                                        "entry_id": "b5b5cddf-dbf9-3248-a60d-dba0c1ef33cf",
                                        "glosses": [
                                            "Genre de reptiles sauriens, qu’on a rangés tantôt parmi les oiseaux, tantôt parmi les poissons et dont on ne connaît que des débris fossiles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7bee00ed-49b1-4247-9341-a6ae87afc5ad",
                                                "sense_id": "ae12ffd7-e339-38b3-a1bf-49dd5943714f",
                                                "text": "Cuvier, Oken, faisaient du ptérodactyle un reptile ; Sœmering voyait dans cet animal un mammifère volant ; Hunter et Blumenbach le regardaient comme un oiseau ; pour Goldfuss et de Blainville, le ptérodactyle doit prendre place dans une classe intermédiaire entre celles des reptiles et des oiseaux."
                                            },
                                            {
                                                "example_id": "ebd3dee5-e4e3-426a-a106-47c225a8b465",
                                                "sense_id": "ae12ffd7-e339-38b3-a1bf-49dd5943714f",
                                                "text": "Elles ont le monde entre leurs mains\n& nous sommes des oiseaux perdus\ndes ptérodactyles en déclin\navec des sentiments tordus."
                                            },
                                            {
                                                "example_id": "50d678af-e93d-4d66-be91-cdab58b3a4e2",
                                                "sense_id": "ae12ffd7-e339-38b3-a1bf-49dd5943714f",
                                                "text": "Car c’était Joy que fuyaient les ptérodactyles !"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ptérodactyle",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "49359fe4-fd8a-3f73-ad24-a30172b104bb",
                                        "entry_id": "00a964d3-48b8-3c92-9ac5-d7cefcffef8d",
                                        "glosses": [
                                            "Définition manquante ou à compléter. (Ajouter)"
                                        ],
