                        "entry_id": "1a88cc8f-746a-3905-b45d-52f7347fcee0",
                        "glosses": [
                            "Towards the interior of the country and away from the seacoast."
                        ],
                        "tags": [
                            "not-comparable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "d648e951-770d-434a-b130-a15f77464ff8",
                                "sense_id": "a51ea0bc-1140-3ba0-ace1-4f26ef6fddd2",
                                "text": "Near-synonym: inland"
                            },
                            {
                                "example_id": "7e1d7bc3-c9d8-4551-aaa7-4257fe37dd58",
                                "sense_id": "a51ea0bc-1140-3ba0-ace1-4f26ef6fddd2",
                                "text": "They went upcountry to visit their extended family."
                            },
                            {
                                "example_id": "4b4af05e-bbc7-451b-ac7f-9df1eeb52515",
                                "sense_id": "a51ea0bc-1140-3ba0-ace1-4f26ef6fddd2",
                                "text": "According to Dr Christy in 1931, the authorities in Monrovia had deliberately banned all freelance travel upcountry by outsiders […]"
                            }
                        ]
                    }
