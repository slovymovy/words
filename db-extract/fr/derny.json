                                "target_senses": [
                                    {
                                        "sense_id": "52a80a1b-8dac-322d-92d3-4461f4f4bae4",
                                        "entry_id": "32868bd3-357d-35f8-8eff-9f7530052670",
                                        "glosses": [
                                            "A motorized bicycle for paced cycling events such as keirin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1192867d-7912-4200-9427-8c51ff285a57",
                                                "sense_id": "52a80a1b-8dac-322d-92d3-4461f4f4bae4",
                                                "text": "Of course, a familiar sight in a velodrome is the derny, with its characteristic engine sound. Before the cyclists come onto the track, the derny riders perform a few laps to warm up their engines."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1a1498e2-2bdf-4ec5-a149-9f53aeb1b77d",
                        "source_entry_id": "6de9a6a9-0a85-3044-8538-d9a068f42c83",
                        "source_sense_id": "339b0451-8a9d-34f0-9877-c1d1f91acbee",
