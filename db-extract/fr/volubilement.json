        "fr-extract.jsonl": [
            {
                "entry_id": "f088e6bf-481a-3efa-bffb-46b9ad24d42b",
                "word": "volubilement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "80a20ae1-1e7c-37bf-9b92-4011db8cb434",
                        "entry_id": "f088e6bf-481a-3efa-bffb-46b9ad24d42b",
                        "glosses": [
                            "D'une manière volubile ; avec volubilité."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "aa1da6e5-ee5e-41ad-aee6-a4d6cfed3452",
                                "sense_id": "80a20ae1-1e7c-37bf-9b92-4011db8cb434",
                                "text": "Hautecorne est grand ; il possède un nez architectural, de longs membres qu'il manie volubilement, un poil sombre et serré, des yeux noirs et convaincants, une faconde âpre et l'accent cévenol."
                            },
                            {
                                "example_id": "b59798ef-49c5-453d-806f-3520944ddd8c",
                                "sense_id": "80a20ae1-1e7c-37bf-9b92-4011db8cb434",
                                "text": "Scriassine se mit à parler volubilement en russe ; George lui répondit d'une voix impassible."
                            },
                            {
                                "example_id": "eb4d6cb3-0438-49a9-b079-0efe05510a0a",
                                "sense_id": "80a20ae1-1e7c-37bf-9b92-4011db8cb434",
                                "text": "Elle m’ouvrit tout de suite volubilement son cœur."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "52ab9826-50ff-450c-90fa-937f48fe9cee",
                        "source_entry_id": "f088e6bf-481a-3efa-bffb-46b9ad24d42b",
                        "source_sense_id": "80a20ae1-1e7c-37bf-9b92-4011db8cb434",
                        "target_lang_word": "volubly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "volubly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "14388e4a-1e0f-315c-822d-64e69cbe434d",
                                        "entry_id": "8af34efa-38ec-328a-aaf5-c73ada503d67",
                                        "glosses": [
                                            "In a voluble manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c96b204-16d1-46be-83eb-f01deff30de5",
                                                "sense_id": "14388e4a-1e0f-315c-822d-64e69cbe434d",
                                                "text": "The Frenchman then began chattering volubly, and the General supported him; but I recommended the former to read, for example, extracts from the memoirs of General Perovski, who, in 1812, was a prisoner in the hands of the French."
                                            },
                                            {
                                                "example_id": "e86ca237-6bcc-4eee-924c-7ce51b698765",
                                                "sense_id": "14388e4a-1e0f-315c-822d-64e69cbe434d",
                                                "text": "They stayed together during three dances, went out on to the terrace, explored wherever they were permitted to explore, paid two visits to the buffet, and enjoyed themselves much in the same way as if they had been school-children surreptitiously breaking loose from an assembly of grown-ups. The boy became volubly friendly and bubbling over with unexpected humour and high spirits."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
