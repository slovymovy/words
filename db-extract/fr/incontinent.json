                "senses": [
                    {
                        "sense_id": "2ed06fbd-135e-3117-9d9f-df9d9714610d",
                        "entry_id": "28ad5c96-060d-30f6-9e85-04de48eef8a4",
                        "glosses": [
                            "Qui manque de continence, qui n’est pas chaste, qui ne sait pas se retenir."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "0195ac69-533d-4868-ad4c-847fdd792825",
                                "sense_id": "2ed06fbd-135e-3117-9d9f-df9d9714610d",
                                "text": "Quelle leçon des dangers à trop songer aux sirènes attrayantes du monde de Charroux, que le moine incontinent et adultère pourrissant, emmuré, dans sa basse fosse."
                            }
                        ]
                    },
                    {
                        "sense_id": "5ef9a3e4-934f-3ff0-9a40-6a2d54237fe9",
                        "entry_id": "28ad5c96-060d-30f6-9e85-04de48eef8a4",
                        "glosses": [
                            "Qui ne contrôle pas ou plus ses sphincters, qui ne peut retenir la miction ou la défécation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "299c2b76-0cc8-4c53-a8bf-0558302639d4",
                                "sense_id": "5ef9a3e4-934f-3ff0-9a40-6a2d54237fe9",
                                "text": "Dans ma voiture, les incontinents restent debout, je tiens à mes sièges!"
                            },
                            {
                                "example_id": "5c8060e0-041a-47d2-a8e6-936c0ae671c7",
                                "sense_id": "5ef9a3e4-934f-3ff0-9a40-6a2d54237fe9",
                                "text": "La dégradation de la qualité de vie du patient incontinent et les émotions qui y sont associées sont liées à la fréquence et au degré d’incontinence […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "cbe8b222-c720-3597-94c7-db12f99cd8b3",
                        "entry_id": "28ad5c96-060d-30f6-9e85-04de48eef8a4",
                        "glosses": [
                            "Qui ne se retient pas."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "369d7e37-b14c-4dbd-99df-9a2f05e19ebc",
                                "sense_id": "cbe8b222-c720-3597-94c7-db12f99cd8b3",
                                "text": "Contrairement à celle de la plupart des vieillards, sa mémoire n’était pas non plus incontinente. Ses récits ne disent que ce qu’il a voulu dire."
                            }
                        ]
                    }
                ],
