                "senses": [
                    {
                        "sense_id": "afdc316f-962f-3569-86aa-1cbf95ff7432",
                        "entry_id": "7c93e449-bc8f-326e-9e02-3632df4be873",
                        "glosses": [
                            "Verfügung einer Person oder eines Landes über die eigene Existenz; Freiheit in der persönlichen Willensbildung"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "c0fa38d1-97df-4696-90e3-ce594c0688bf",
                                "sense_id": "afdc316f-962f-3569-86aa-1cbf95ff7432",
                                "text": "„Es waren deutsche Schulen und Universitäten, die mir ein Leben in Selbstbestimmung ermöglicht haben.“"
                            },
                            {
                                "example_id": "2b598680-64d2-4f09-a13b-e21f92024364",
                                "sense_id": "afdc316f-962f-3569-86aa-1cbf95ff7432",
                                "text": "„Präsident Charles de Gaulle lässt schließlich ein Referendum zu – mit eindeutigem Ergebnis: Mehr als 95 Prozent der wahlbeteiligten Algerier votieren für die Selbstbestimmung des Landes.“"
                            },
                            {
                                "example_id": "eaf3cc34-b8e2-44c0-9335-dff31b65716b",
                                "sense_id": "afdc316f-962f-3569-86aa-1cbf95ff7432",
                                "text": "„Nach 1945 fordern sie als Belohnung für ihren Einsatz die politische Selbstbestimmung.“"
                            },
                            {
                                "example_id": "e6380834-5a86-4296-8aee-5b1547fdb96d",
                                "sense_id": "afdc316f-962f-3569-86aa-1cbf95ff7432",
                                "text": "„Individuelle Freiheit als Selbstbestimmung und Entgrenzung ist dabei das Leitmotiv.“"
                            },
                            {
                                "example_id": "925b7caa-9568-436d-8e5c-ca68eac91bb3",
                                "sense_id": "afdc316f-962f-3569-86aa-1cbf95ff7432",
                                "text": "„Die Freiheit des Einzelnen bedeutete für den britischen Philosophen John Stuart Mill auch ein Recht auf Selbstbestimmung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "4137e98d-cb5b-3024-8699-ecb22ce3f348",
                        "entry_id": "7c93e449-bc8f-326e-9e02-3632df4be873",
                        "glosses": [
                            "eine Definition des eigenen Selbst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf10d79d-a5a8-42f6-b0d1-d59dca9ed7e4",
                                "sense_id": "4137e98d-cb5b-3024-8699-ecb22ce3f348",
                                "text": "Entgegen gängiger Selbstbestimmungen von moderner Zeit als unendlichem Fortschreiten oder technischer Beschleunigung fragt das von Barbara Gronau (Professorin für Theorie und Geschichte des Theaters an der Universität der Künste Berlin) geleitete Symposium nach einem anderen Zeitdiskurs der Künste, welcher Unterbrechung, Stillstellung und Verlangsamung als kritisch-utopische Suchmomente beschreibt."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a5fc49db-09f9-4d00-b0f4-83e0cc4e50e7",
