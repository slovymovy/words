                    {
                        "sense_id": "3a5719d5-8881-3c1e-95be-0423b748b7d1",
                        "entry_id": "8eda86bf-c622-379c-a9fc-c08d7cd1daa7",
                        "glosses": [
                            "Personne pouvant apparaître brusquement, comme si elle était montée sur ressort."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5d59d56-2d1d-4e43-9a43-c03f54d1fb6b",
                                "sense_id": "3a5719d5-8881-3c1e-95be-0423b748b7d1",
                                "text": "Tel un zébulon sorti de sa boîte, la tête de Benjamin Lavernhe dépasse d’une trappe."
                            }
                        ]
                    },
                    {
                        "sense_id": "99d34e9a-61ff-3e36-8a55-af1ddec199b1",
                        "entry_id": "8eda86bf-c622-379c-a9fc-c08d7cd1daa7",
                        "glosses": [
                            "Personne très énergique, hyperactive."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "68698179-9e30-4939-a398-b2a187cede1b",
                                "sense_id": "99d34e9a-61ff-3e36-8a55-af1ddec199b1",
                                "text": "Il y en a qui sont au départ très inhibés, d’autres très extravertis sautant comme des zébulons dans la classe ; cela dépend de leur caractère mais aussi de leurs “antécédents” musicaux familiaux."
                            }
                        ]
                    },
                    {
                        "sense_id": "8393b21a-a1d0-3ee3-a9b2-0f5b9dceaafe",
                        "entry_id": "8eda86bf-c622-379c-a9fc-c08d7cd1daa7",
                        "glosses": [
                            "Personne qui apparaît d’un coup dans les médias, à la connaissance du public."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "e91a9cdb-6a5c-483e-877b-e7e2d9e5468f",
                                "sense_id": "8393b21a-a1d0-3ee3-a9b2-0f5b9dceaafe",
                                "text": "Juin 1967 : un zébulon helvétique nommé Claude Nobs lance dans sa petite ville de Suisse Romande une des plus belles aventures musicales de son temps."
                            },
                            {
                                "example_id": "8ee6f35c-1742-4a2f-bb79-24f783f97bed",
                                "sense_id": "8393b21a-a1d0-3ee3-a9b2-0f5b9dceaafe",
                                "text": "Surtout, profitons bien de ce talent unique, car impossible de dire combien de temps durera le manège enchanté du zébulon bigourdan."
                            }
                        ]
                    }
