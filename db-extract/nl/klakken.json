            {
                "entry_id": "a7026aa3-fd6e-33d7-ae88-04083eb87a29",
                "word": "klakken",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "e879213a-587a-3f9a-ad15-454fcd875e42",
                        "entry_id": "a7026aa3-fd6e-33d7-ae88-04083eb87a29",
                        "glosses": [
                            "een plotseling luid geluid maken door twee zaken tegen elkaar te slaan, met name het slaan van de tong tegen het verhemelte of mondbodem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "adf47e15-d064-4e87-b10e-293975223edc",
                                "sense_id": "e879213a-587a-3f9a-ad15-454fcd875e42",
                                "text": "Maar in Stockhausen is een soeverein pianiste aan het woord. Ook letterlijk, want ze speelt niet alleen, ze wordt geacht te reciteren, te zingen en met haar tong te klakken. Haar uitvoering is overtuigend, spannend en bovenal volkomen natuurlijk. Waren er maar meer Vanessa’s om de bedreigde muziek van de twintigste eeuw te redden."
                            },
                            {
                                "example_id": "c2de1b07-45f2-4103-baef-a51897745968",
                                "sense_id": "e879213a-587a-3f9a-ad15-454fcd875e42",
                                "text": "Van complimenten, fluiten, sissen, klakken en staren tot naroepen, beledigen, om seks vragen, achterna lopen en zelfs in het nauw drijven: vrijwel alle Rotterdamse vrouwen tussen de 18 en 45 jaar die meewerkten aan een onderzoek van de Erasmus Universiteit hebben op straat ervaring met seksueel getinte toenadering. Ongeveer de helft ervaart dat gedrag als intimiderend."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c53181ee-51c1-4102-9d2e-4c398e194973",
                        "source_entry_id": "a7026aa3-fd6e-33d7-ae88-04083eb87a29",
                        "source_sense_id": "e879213a-587a-3f9a-ad15-454fcd875e42",
                        "source_sense_description": "een plotseling luid geluid maken door twee zaken tegen elkaar te slaan...",
                        "target_lang_word": "clack",
