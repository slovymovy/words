                        "sense_id": "24f83d86-9e26-399c-a3cc-fe2462290d93",
                        "entry_id": "09700ac8-3a42-3809-9965-bad2fd7231a6",
                        "glosses": [
                            "iemand die mensen helpt bij het vissen"
