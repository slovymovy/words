                "senses": [
                    {
                        "sense_id": "70a5cfc2-6a63-36e2-8116-165fa842216b",
                        "entry_id": "ab295fd7-0692-3f5a-b19f-2e6ad58a37a7",
                        "glosses": [
                            "etwas bloß Ausgedachtes, das es in der Wirklichkeit nicht gibt"
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "9bec2baa-6fb9-4dc8-8866-a6ffa2c3b2f6",
                                "sense_id": "70a5cfc2-6a63-36e2-8116-165fa842216b",
                                "text": "Dieses Verfahren kann man nur als Kopfgeburt von Bürokraten bezeichnen."
                            },
                            {
                                "example_id": "97af5381-31b1-45de-bd73-e0d9cd4d72ad",
                                "sense_id": "70a5cfc2-6a63-36e2-8116-165fa842216b",
                                "text": "„Eine Alternative, die man getrost als Kopfgeburt geschichtsblinder Theoretiker einstufen darf.“"
                            },
                            {
                                "example_id": "50562589-9241-4f41-8316-6e0c5d5590ec",
                                "sense_id": "70a5cfc2-6a63-36e2-8116-165fa842216b",
                                "text": "Sehnsuchtsort des 21. Jahrhunderts - Gutes Leben auf dem Land?: […] Das Dorf, wie wir es uns vorstellen, ist eine reine Kopfgeburt."
                            },
                            {
                                "example_id": "9ede6783-e92b-493a-be3b-45cd43826064",
                                "sense_id": "70a5cfc2-6a63-36e2-8116-165fa842216b",
                                "text": "Man muss sich klar machen, dass [der Film] „Woman in Gold“ keine Kopfgeburt eines Drehbuchautoren ist, obwohl es so klingt."
                            },
                            {
                                "example_id": "f0f876cf-120b-44c9-8daf-0544f3edde45",
                                "sense_id": "70a5cfc2-6a63-36e2-8116-165fa842216b",
                                "text": "Das Völkerkundemuseum in Hamburg war gestern. Jetzt kommt „MARKK - das Museum am Rothenbaum, Kulturen und Künste der Welt“. […] Der neue Name mit der Abkürzung ist natürlich eine Kopfgeburt."
                            },
                            {
                                "example_id": "869092cc-45c7-47e2-a852-18dcc8807209",
                                "sense_id": "70a5cfc2-6a63-36e2-8116-165fa842216b",
                                "text": "„Es gab große Firmen der Unterhaltungselektronik, die noch 1995 gesagt haben: mp3 ist so kompliziert, dass es nie in irgendwelche Anwendungen für die breite Masse gehen wird. Das wäre eine Kopfgeburt von irgendwelchen Leuten von Forschungsinstituten, aber nichts, was die Industrie brauchen könnte!“"
                            },
                            {
                                "example_id": "d3c9afc0-976b-4238-81c7-be70d7afd588",
                                "sense_id": "70a5cfc2-6a63-36e2-8116-165fa842216b",
                                "text": "Der Kommunismus als Kopfgeburt: Eberhard Rathgeb erzählt die Geschichte eines Rationalisten."
                            },
                            {
                                "example_id": "75908bfc-764d-4f93-ac95-344e9eeaf372",
                                "sense_id": "70a5cfc2-6a63-36e2-8116-165fa842216b",
                                "text": "„Was hier passiert ist eine Kopfgeburt, dass von oben her verkündet wird, man müsse einen Nationalpark ausrufen und keiner will den.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
