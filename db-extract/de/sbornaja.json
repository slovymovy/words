                "senses": [
                    {
                        "sense_id": "50ac7173-76ee-32c1-8daf-4fee707e8686",
                        "entry_id": "cb466de6-8d22-3533-8e4d-69d69a6a9f7c",
                        "glosses": [
                            "Bezeichnung für eine Russland vertretende nationale Auswahlmannschaft (im Eishockey oder Fußball)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c9ae3e8-684a-4069-8cf0-a08288e054cb",
                                "sense_id": "50ac7173-76ee-32c1-8daf-4fee707e8686",
                                "text": "„[Fußball:] Der Erfolg der russischen Nationalmannschaft, der Sbornaja, die während der Europameisterschaft [2008] mit modernem Tempofußball beeindruckte, verstärkt auch die Konjunktur der russischen Liga und die Anziehungskraft auf Spieler und Trainer aus westlichen Fußballnationen.“"
                            },
                            {
                                "example_id": "7f481132-3860-49f4-a830-41a3e94dedab",
                                "sense_id": "50ac7173-76ee-32c1-8daf-4fee707e8686",
                                "text": "„[Eishockey:] Unter [Wiktor] Tichonow holte die ›Sbornaja‹ drei Mal Olympia-Gold und acht WM-Titel.“"
                            },
                            {
                                "example_id": "b1d7fd82-3850-49cc-a05b-a72394456976",
                                "sense_id": "50ac7173-76ee-32c1-8daf-4fee707e8686",
                                "text": "„[Eishockey:] Von 1982 bis 1990 gehörte Slawa Bykow den beiden besten Mannschaften der Welt an: dem ZSKA Moskau und der sowjetischen Nationalmannschaft, der berühmten Sbornaja, deren Name etwas wie Attila, die Geisel Gottes, tönt.“"
                            },
                            {
                                "example_id": "30242b73-69ef-444e-94b5-29950ca8c7a1",
                                "sense_id": "50ac7173-76ee-32c1-8daf-4fee707e8686",
                                "text": "„[Fußball:] In der ersten Hälfte des 20. Jahrhunderts bestritt die Sbornaja kaum Länderspiele. Im Kalten Krieg wurde sie dann oft gegen ideologische Gegner in Stellung gebracht.“"
                            },
                            {
                                "example_id": "d35bfd52-5019-4ec0-8ac7-295e73477185",
                                "sense_id": "50ac7173-76ee-32c1-8daf-4fee707e8686",
                                "text": "„[Eishockey:] Damals führte der kollektive Drill der immer wieder kasernierten Staatsamateure zu einer jahrzehntelangen Dominanz der Sbornaja, die sogenannte Rote Maschine lief wie geschmiert. Doch nun, ein Vierteljahrhundert nach dem Ende des Kommunismus, ist Eishockey ein globalisierter Sport, die nationalen Stile sind verschwunden, das schnelle, technische, direkte Spiel beherrschen längst viele Nationalmannschaften.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
