    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "cfadb340-7ad6-336a-85a8-13b33dbdcf17",
                    "sense_definition": "To fill up, stock, or supply something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "filling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bartender <w>plenished</w> the empty glasses with fresh drinks for the guests.",
                            "target_lang_translations": {
                                "tr": "Barmen, konuklar için boş bardakları taze içeceklerle <w>doldurdu</w>."
                            }
                        },
                        {
                            "text": "They worked all day to <w>plenish</w> the pantry with enough food for the winter.",
                            "target_lang_translations": {
                                "tr": "Kiler kış için yeterli yiyecekle <w>stoklamak</w> adına tüm gün çalıştılar."
                            }
                        }
                    ],
                    "synonyms": [
                        "replenish",
                        "stock",
                        "supply"
                    ],
                    "antonyms": [
                        "empty",
                        "deplete"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This term is rarely used in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir şeyi doldurmak, stoklamak veya tedarik etmek."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "doldurmak",
                                "target_lang_sense_clarification": "Boş bir alanı veya kabı içerikle tamamlamak."
                            },
                            {
                                "target_lang_word": "stoklamak",
                                "target_lang_sense_clarification": "İhtiyaç duyulan malzemeleri biriktirmek veya depolamak."
                            },
                            {
                                "target_lang_word": "tedarik etmek",
                                "target_lang_sense_clarification": "Gerekli olanı sağlamak veya temin etmek."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d393d59d-711c-3cf5-ac74-c12af99dfdc3",
                    "sense_definition": "To stock a house or land with furniture or livestock.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "filling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmer <w>plenished</w> his new fields with a healthy herd of cattle.",
                            "target_lang_translations": {
                                "tr": "Çiftçi yeni tarlalarını sağlıklı bir sığır sürüsüyle <w>donattı</w>."
                            }
                        },
                        {
                            "text": "It took several months to fully <w>plenish</w> the old manor with antique furniture.",
                            "target_lang_translations": {
                                "tr": "Eski köşkü antika mobilyalarla tamamen <w>döşemek</w> birkaç ay sürdü."
                            }
                        }
                    ],
                    "synonyms": [
                        "furnish",
                        "equip"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This usage is largely historical or literary."
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir evi mobilya ile döşemek veya araziyi hayvanlarla donatmak."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "döşemek",
                                "target_lang_sense_clarification": "Bir mekanı mobilya veya eşya ile donatmak."
                            },
                            {
                                "target_lang_word": "donatmak",
                                "target_lang_sense_clarification": "Bir yeri gerekli araç, gereç veya canlılarla doldurmak."
                            }
                        ]
                    }
                }
            ]
        }
    ]
