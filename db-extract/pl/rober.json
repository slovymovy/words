                                        "examples": [
                                            {
                                                "example_id": "18e9dd8a-043c-4e1b-b317-141d1cfcb35b",
                                                "sense_id": "a72f70a9-e06a-378f-8184-ce0cf9fa4920",
                                                "text": "Johnny, don't forget your rubbers today."
                                            },
                                            {
                                                "example_id": "669e0207-33bf-4121-9778-5ee6452eece5",
                                                "sense_id": "a72f70a9-e06a-378f-8184-ce0cf9fa4920",
                                                "text": "He set aside his aunt’s counsel in regard to a better regimen, as well as her more specific hints, made in view of the near approach of rough weather, that he provide himself with rubbers and an umbrella, even if he would not hear of a rain-coat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "756e7ca0-cb57-3dcf-8566-58add7e528aa",
                                        "entry_id": "bee1068d-1dee-3df4-96e9-a1e925c69f69",
                                        "glosses": [
                                            "Tires, particularly racing tires."
                                        ],
                                        "tags": [
                                            "slang",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "98b8a0b6-ed63-4f85-a084-a2b7caddad9e",
                                                "sense_id": "756e7ca0-cb57-3dcf-8566-58add7e528aa",
                                                "text": "Jones enters the pits to get new rubber."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f5ab526-851d-3e16-8144-923e68e3c945",
                                        "entry_id": "bee1068d-1dee-3df4-96e9-a1e925c69f69",
                                        "glosses": [
                                            "A hardship or misfortune."
                                        ],
                                        "tags": [
                                            "dated",
