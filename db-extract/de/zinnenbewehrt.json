                ],
                "senses": [
                    {
                        "sense_id": "c08e39ca-66e4-3fe2-b92e-286202c269b5",
                        "entry_id": "104e71a9-b4f6-3d15-9e28-155fad734526",
                        "glosses": [
                            "mit Zinnen versehen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "06aa55af-0391-4b51-b550-e2693e429e4b",
                                "sense_id": "c08e39ca-66e4-3fe2-b92e-286202c269b5",
                                "text": "„Er schlich den Gang entlang, öffnete eine Tür, die nach draußen führte, und trat auf die zinnenbewehrte Brustwehr hinaus.“"
                            },
                            {
                                "example_id": "08e54c3f-fd23-4445-b908-4ff7c1fbe7a1",
                                "sense_id": "c08e39ca-66e4-3fe2-b92e-286202c269b5",
                                "text": "„Court und Russ sprangen gerade von der zinnenbewehrten Stadtmauer auf ein Dach hinunter, das nicht ganz so steil war wie die bisherigen.“"
                            },
                            {
                                "example_id": "bf3db1f5-c6da-4b98-810e-ba9e7b360a7a",
                                "sense_id": "c08e39ca-66e4-3fe2-b92e-286202c269b5",
                                "text": "„Der große zentrale Platz von Tenochtitlan wurde zur Plaza Mayor, flankiert von einer neu errichteten Kathedrale auf der einen Seite und einem massigen Regierungsgebäude mit zinnenbewehrten Türmen auf der anderen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [],
