                ],
                "senses": [
                    {
                        "sense_id": "0106a88a-f04c-3e7a-a7d7-d94fb51d4031",
                        "entry_id": "31d5cf8d-8dcc-3641-b558-3d7643a88a9e",
                        "glosses": [
                            "so, dass es durchgesetzt werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a4decdf-95d4-484f-ae76-21f9cb8b35f8",
                                "sense_id": "0106a88a-f04c-3e7a-a7d7-d94fb51d4031",
                                "text": "„Das Fragerecht stellt ein zentrales Instrument der Kontrolle der Verwaltung durch die Organe der Gesetzgebung dar. Jedoch ist es nur beschränkt rechtlich durchsetzbar.“"
                            },
                            {
                                "example_id": "181476db-66d3-431b-91f8-2954c2c1624f",
                                "sense_id": "0106a88a-f04c-3e7a-a7d7-d94fb51d4031",
                                "text": "„Vor wenigen Tagen ließ die designierte Kommission die Katze aus dem Sack: Sie will dafür sorgen, dass ihre wirtschaftspolitischen Forderungen durchsetzbar werden.“"
                            },
                            {
                                "example_id": "449a7917-eee2-4e44-a0f7-aea01d615834",
                                "sense_id": "0106a88a-f04c-3e7a-a7d7-d94fb51d4031",
                                "text": "„Ab dem 23. September 2020 ist erstmals das Recht auf digitale Barrierefreiheit durchsetzbar. Behinderte Menschen, die auf Barrieren im Internet stoßen, können diese ab sofort melden oder sich bei der Zentralstelle für barrierefreie Informationstechnik ihres Landesbehindertenbeauftragten beschweren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
