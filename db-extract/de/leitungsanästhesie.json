                "senses": [
                    {
                        "sense_id": "0d37ddfe-2afd-3373-bf1f-e5e5d6d97a53",
                        "entry_id": "8ea655b3-23eb-340f-b251-205b4fa4d7b0",
                        "glosses": [
                            "Verfahren, bei dem durch die Injektion eines Anästhetikums in die unmittelbare Nähe eines Nerven die Weiterleitung von Schmerzimpulsen in afferenten Nervenfasern gehemmt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "31dac541-a96a-4ebb-825a-89f6eebf33a5",
                                "sense_id": "0d37ddfe-2afd-3373-bf1f-e5e5d6d97a53",
                                "text": "Bevor der Zahnarzt für einen Eingriff zum Beispiel eine Leitungsanästhesie durchführt, muss er diesbezüglich seiner Aufklärungspflicht gegenüber dem Patienten nachkommen."
                            },
                            {
                                "example_id": "9d691cd6-511e-4fca-9273-f55d29e49146",
                                "sense_id": "0d37ddfe-2afd-3373-bf1f-e5e5d6d97a53",
                                "text": "Zu argumentieren, dass es sich bei der Finger-Leitungsanästhesie wegen der vier Fingernerven um vier anästhesiologische Eingriffe handelt, ist eine sehr individuelle Auslegung von Gebührenordnung und Anatomie."
                            },
                            {
                                "example_id": "bdb319b3-4e8b-425e-b510-3f4953643ab2",
                                "sense_id": "0d37ddfe-2afd-3373-bf1f-e5e5d6d97a53",
                                "text": "Bei der peripheren Leitungsanästhesie werden entweder einzelne Nerven (periphere Nervenblockade) oder ganze Nervengeflechte (Plexusanästhesie) betäubt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
