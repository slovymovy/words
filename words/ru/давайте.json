                {
                    "sense_id": "0b55c4ea-4468-3dc6-9a52-7eb617e57a3b",
                    "sense_definition": "Форма повелительного наклонения глагола <w>давать</w> во множественном числе или при вежливом обращении.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "action_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Давайте</w> мне вашу руку, здесь скользко.",
                            "target_lang_translations": {
                                "en": "<w>Give</w> me your hand, it's slippery here.",
                                "zh": "把你的手<w>给</w>我，这里很滑。",
                                "nl": "<w>Geef</w> me uw hand, het is hier glad.",
                                "pl": "<w>Proszę podać</w> mi rękę, jest tu ślisko.",
                                "de": "<w>Geben Sie</w> mir Ihre Hand, hier ist es glatt.",
                                "fr": "<w>Donnez</w>-moi votre main, c'est glissant ici.",
                                "it": "<w>Mi dia</w> la mano, qui è scivoloso.",
                                "cs": "<w>Dejte</w> mi ruku, je tu kluzko.",
                                "tr": "Elinizi bana <w>verin</w>, burası kaygan.",
                                "es": "<w>Denme</w> su mano, aquí está resbaladizo."
                            }
                        },
                        {
                            "text": "Не <w>давайте</w> собаке сладкое.",
                            "target_lang_translations": {
                                "en": "Don't <w>give</w> the dog sweets.",
                                "zh": "不要<w>给</w>狗吃甜食。",
                                "nl": "<w>Geef</w> de hond geen zoetigheid.",
                                "pl": "Nie <w>dawajcie</w> psu słodyczy.",
                                "de": "<w>Gebt</w> dem Hund nichts Süßes.",
                                "fr": "Ne <w>donnez</w> pas de sucreries au chien.",
                                "it": "Non <w>date</w> dolci al cane.",
                                "cs": "Ne<w>dávejte</w> psovi sladké.",
                                "tr": "Köpeğe tatlı <w>vermeyin</w>.",
                                "es": "No le <w>den</w> dulces al perro."
                            }
