                "senses": [
                    {
                        "sense_id": "40636f8f-5b4d-33a4-ada6-64cd5899c51a",
                        "entry_id": "be1e727e-7243-37e3-92f0-aa3d944fbeb9",
                        "glosses": [
                            "школьн. тот, кто имеет оценку «пять, отлично»"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75473700-f48c-4ce2-a35c-7a0a128721fd",
                                "sense_id": "40636f8f-5b4d-33a4-ada6-64cd5899c51a",
                                "text": "― А мой внучок-то ― хорошо учится! Пятёрочник! ― похвасталась вахтёрша."
                            },
                            {
                                "example_id": "8f98e4d7-9be7-4cab-852c-665e6aaf40d8",
                                "sense_id": "40636f8f-5b4d-33a4-ada6-64cd5899c51a",
                                "text": "Были отличники, круглые пятёрочники, в университете или педагогическом они бы блистали, но только не у нас."
                            }
                        ]
                    }
