                                        "sense_id": "0fbee928-c0c1-3e1c-80ee-3f7d179d178e",
                                        "entry_id": "ddc6f5d0-7173-3382-af3f-b7ba678931cd",
                                        "glosses": [
                                            "Abhorrent or very undesirable."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
