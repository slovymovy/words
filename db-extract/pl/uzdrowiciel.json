                                "target_senses": [
                                    {
                                        "sense_id": "36872cce-0482-3d46-9ee6-7d0e068dd2de",
                                        "entry_id": "e72205dd-531a-3914-8a38-cf49698f05b5",
                                        "glosses": [
                                            "One who heals, especially through faith."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d441dcf0-d320-4842-9bc3-ae02d47c500c",
                                                "sense_id": "36872cce-0482-3d46-9ee6-7d0e068dd2de",
                                                "text": "faith healer"
                                            },
                                            {
                                                "example_id": "a275a10a-41a9-436a-9876-b8bd859c6906",
                                                "sense_id": "36872cce-0482-3d46-9ee6-7d0e068dd2de",
                                                "text": "gifted healer"
                                            },
                                            {
                                                "example_id": "b46eaf56-3c39-4cc3-b7bf-1039fe29d656",
                                                "sense_id": "36872cce-0482-3d46-9ee6-7d0e068dd2de",
                                                "text": "natural healer"
                                            },
                                            {
                                                "example_id": "dd23acc3-3cf6-49b2-a8db-7cdadb5b38cd",
                                                "sense_id": "36872cce-0482-3d46-9ee6-7d0e068dd2de",
                                                "text": "The villagers sought help from a traditional healer."
                                            },
                                            {
                                                "example_id": "c75799dc-712d-4161-ad9b-56a7a4c89ab0",
                                                "sense_id": "36872cce-0482-3d46-9ee6-7d0e068dd2de",
                                                "text": "She became known as a spiritual healer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "013a53aa-5d64-3831-af87-fcef2e95ad46",
                                        "entry_id": "e72205dd-531a-3914-8a38-cf49698f05b5",
                                        "glosses": [
                                            "Anything that heals; a medicine that heals some wound, injury, ailment, or disease."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b0ef4477-6346-4ff6-ad46-0c32a8879b99",
                        "source_entry_id": "468e37c8-0ff3-3b5f-8d29-fc5d134e3468",
                        "source_sense_id": "38db1a79-8913-3274-98ed-81807dc480f8",
                        "target_lang_word": "guérisseur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "guérisseur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f0c7af52-256e-38ee-8222-62c52cb78a9c",
                                        "entry_id": "0d503b31-73f8-35cf-992a-9e8f2fad3f0d",
                                        "glosses": [
                                            "Celui qui prétend guérir, qui fait profession de guérir par des moyens empiriques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9634e64b-8661-48c8-8504-17f79fbe7c13",
                                                "sense_id": "f0c7af52-256e-38ee-8222-62c52cb78a9c",
                                                "text": "Quant aux autres membres du sacré collège Tonto, Lanfranco , Philonardo et quelques-uns de leurs collègues, ce serait pis encore si on leur demandait quelle profession ils exerçaient avant de passer cardinaux , l'un était sonneur d'orgues à l'Oratoire, […]; l'autre était guérisseur de vérolés dans un carrefour de Naples; […]."
                                            },
                                            {
                                                "example_id": "e89b0437-f701-41e9-b4c5-48eb6022afbb",
                                                "sense_id": "f0c7af52-256e-38ee-8222-62c52cb78a9c",
                                                "text": "Le flair du médecin devenait tout, le guérisseur n’était plus qu’un devin heureusement doué, marchant lui-même à tâtons, enlevant les cures au petit bonheur de son génie."
                                            },
                                            {
                                                "example_id": "f72879c5-fe44-40dd-ae0c-1a34dfd5f7d7",
                                                "sense_id": "f0c7af52-256e-38ee-8222-62c52cb78a9c",
                                                "text": "Un guérisseur peut-il être en congé de maladie?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0670dab8-f183-4355-8fd1-6681c3e74377",
                        "source_entry_id": "468e37c8-0ff3-3b5f-8d29-fc5d134e3468",
                        "source_sense_id": "38db1a79-8913-3274-98ed-81807dc480f8",
                        "target_lang_word": "Wunderheiler",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wunderheiler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b64c8d44-8859-3708-b830-e3693edb3c75",
                                        "entry_id": "d46ec6f7-eb10-3042-8a52-55551bfdc169",
                                        "glosses": [
                                            "jemand, der auf nicht erklärbare/wundersame Weise Heilung verschafft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d131281e-bdde-4fce-a1c5-3d1f65f30cc8",
                                                "sense_id": "b64c8d44-8859-3708-b830-e3693edb3c75",
                                                "text": "„Aber er ist so etwas wie ein Superstar unter den Wunderheilern.“"
                                            },
                                            {
                                                "example_id": "e41e33dc-3d37-42cf-b84b-a1e7a098b123",
                                                "sense_id": "b64c8d44-8859-3708-b830-e3693edb3c75",
                                                "text": "„Wie ein Wunderheiler legte er ihm die Hand auf den Kopf.“"
                                            },
                                            {
                                                "example_id": "a391e5cf-e5cc-45f9-bce0-600479aff6b1",
                                                "sense_id": "b64c8d44-8859-3708-b830-e3693edb3c75",
                                                "text": "„Ein anderer Zeitgenosse spottete über den Wunderheiler Faust, sein Ruhm sei zwar so groß wie der des Paracelsus, seine tatsächliche medizinische Kunst jedoch winzig klein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8654b4b5-2224-413f-acd4-da7b0b014f6a",
                        "source_entry_id": "468e37c8-0ff3-3b5f-8d29-fc5d134e3468",
                        "source_sense_id": "38db1a79-8913-3274-98ed-81807dc480f8",
                        "target_lang_word": "Heilpraktiker",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "36689f3b-c339-427d-9750-0881a6fa954b",
                        "source_entry_id": "468e37c8-0ff3-3b5f-8d29-fc5d134e3468",
                        "source_sense_id": "38db1a79-8913-3274-98ed-81807dc480f8",
                        "target_lang_word": "Heiler",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Heiler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "21f33020-a75e-3ad0-ae0a-acbc0e53bc1c",
                                        "entry_id": "4f49f751-cbaf-3a72-b5bc-dbcb1ccc3965",
                                        "glosses": [
                                            "jemand, der Heilung verschafft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24c0adf8-83c3-432a-a66f-c4f1f10a9286",
                                                "sense_id": "21f33020-a75e-3ad0-ae0a-acbc0e53bc1c",
                                                "text": "„Als Beweis kramt der Heiler eine Mappe mit zerknitterten Dokumenten hervor: »Solomon G., HIV-positiv«.“"
                                            },
                                            {
                                                "example_id": "85d0f140-f568-4a61-aed0-6854a3ea5f9d",
                                                "sense_id": "21f33020-a75e-3ad0-ae0a-acbc0e53bc1c",
                                                "text": "„Der Heiler saß auf einem Schemel und sägte mit der Hand an etwas herum, das er in der anderen Hand hielt.\""
                                            },
                                            {
                                                "example_id": "225846f4-823e-409d-8701-78f6cea6fe7e",
                                                "sense_id": "21f33020-a75e-3ad0-ae0a-acbc0e53bc1c",
                                                "text": "„Die populären Exorzisten verstanden sich letztlich eher als Heiler denn als Kirchenmänner.“"
                                            }
