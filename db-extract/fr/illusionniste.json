        "fr-extract.jsonl": [
            {
                "entry_id": "ff86f47b-d05d-39f3-930f-5f14931f759f",
                "word": "illusionniste",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "d7459eb7-4c63-4550-8fda-861f6474a862",
                        "entry_id": "ff86f47b-d05d-39f3-930f-5f14931f759f",
                        "tags": [
                            "plural"
                        ],
                        "form": "illusionnistes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ad7f34c5-22c0-3aaf-95c4-5bdc059cb3ac",
                        "entry_id": "ff86f47b-d05d-39f3-930f-5f14931f759f",
                        "glosses": [
                            "Prestidigitateur, créateur d’illusions."
                        ],
                        "tags": [
                            "Prestidigitation"
                        ],
                        "examples": [
                            {
                                "example_id": "eacd214a-5bca-40e8-8e3a-62dd2b25400b",
                                "sense_id": "ad7f34c5-22c0-3aaf-95c4-5bdc059cb3ac",
                                "text": "Pas mal, cette disparition! Notre ami pourrait gagner beaucoup d'argent comme illusionniste..."
                            },
                            {
                                "example_id": "085267c4-532a-4379-a2f4-4edadc756692",
                                "sense_id": "ad7f34c5-22c0-3aaf-95c4-5bdc059cb3ac",
                                "text": "Dès l'âge de dix ans le Père, ayant décelé chez moi un don d’illusionniste, m’emmena chaque soir avec lui."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fb61fb6b-ef21-45c3-910e-49fd5ffa3053",
                        "source_entry_id": "ff86f47b-d05d-39f3-930f-5f14931f759f",
                        "source_sense_id": "ad7f34c5-22c0-3aaf-95c4-5bdc059cb3ac",
                        "target_lang_word": "illusionist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
