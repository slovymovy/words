                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "opulent",
                                "target_lang_sense_clarification": "pour une silhouette ou des formes généreuses"
                            },
                            {
                                "target_lang_word": "généreux",
                                "target_lang_sense_clarification": "en parlant des formes du corps"
                            },
                            {
                                "target_lang_word": "voluptueux",
                                "target_lang_sense_clarification": "qui a des formes très féminines et séduisantes"
                            }
