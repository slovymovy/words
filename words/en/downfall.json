{
    "word_family": [
        "downfallen",
        "downfalling"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b7182602-589f-3fec-9852-75bfe949b0ae",
                    "sense_definition": "A sudden and precipitous decline in fortune, status, power, or wealth.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ruin",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many economic and political reasons led to the sudden <w>downfall</w> of the Roman Empire.",
                            "target_lang_translations": {
                                "ru": "Многие экономические и политические причины привели к внезапному <w>падению</w> Римской империи.",
                                "nl": "Vele economische en politieke redenen leidden tot de plotselinge <w>ondergang</w> van het Romeinse Rijk."
                            }
                        },
                        {
                            "text": "His arrogance and refusal to listen to advice eventually caused his <w>downfall</w>.",
                            "target_lang_translations": {
                                "ru": "Его высокомерие и нежелание прислушиваться к советам в конечном итоге привели к его <w>краху</w>.",
                                "nl": "Zijn arrogantie en weigering om naar advies te luisteren veroorzaakten uiteindelijk zijn <w>val</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "fall",
                        "doom"
                    ],
                    "common_phrases": [
                        "cause of his downfall",
                        "lead to the downfall"
                    ],
                    "target_lang_definitions": {
                        "ru": "Внезапный и резкий упадок сил, потерь богатства, власти, статуса или удачи.",
                        "nl": "Een plotselinge en sterke achteruitgang in fortuin, status, macht of rijkdom."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "падение",
                                "target_lang_sense_clarification": "утрата власти, статуса или величия"
                            },
                            {
                                "target_lang_word": "крах",
                                "target_lang_sense_clarification": "полное крушение, провал"
                            },
                            {
                                "target_lang_word": "гибель",
                                "target_lang_sense_clarification": "окончательное разрушение или конец существования"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "neergang",
                                "target_lang_sense_clarification": "het proces van achteruitgang of verval"
                            },
                            {
                                "target_lang_word": "ondergang",
                                "target_lang_sense_clarification": "het definitieve einde of de vernietiging van iets"
                            },
                            {
                                "target_lang_word": "val",
                                "target_lang_sense_clarification": "het verlies van macht of positie"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3d5a64ea-43b1-3e94-9217-093d10217824",
                    "sense_definition": "The specific cause of a sudden ruin, failure, or critical loss of status.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ruin",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Greed was the ultimate <w>downfall</w> of the corrupt businessman.",
                            "target_lang_translations": {
                                "ru": "Жадность стала главной <w>причиной гибели</w> коррумпированного бизнесмена.",
                                "nl": "Hebzucht was de uiteindelijke <w>ondergang</w> van de corrupte zakenman."
                            }
                        },
                        {
                            "text": "They realized too late that a single strategic mistake would be their <w>downfall</w>.",
                            "target_lang_translations": {
                                "ru": "Они слишком поздно поняли, что одна стратегическая ошибка станет их <w>погибелью</w>.",
                                "nl": "Ze realiseerden zich te laat dat een enkele strategische fout hun <w>ondergang</w> zou betekenen."
                            }
                        }
                    ],
                    "common_phrases": [
                        "be their downfall"
                    ],
                    "target_lang_definitions": {
                        "ru": "Конкретная причина внезапного краха, неудачи или критической потери статуса.",
                        "nl": "De specifieke oorzaak van een plotselinge ondergang, mislukking of kritiek verlies van status."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "причина гибели",
                                "target_lang_sense_clarification": "то, что привело к краху"
                            },
                            {
                                "target_lang_word": "погибель",
                                "target_lang_sense_clarification": "то, что губит или ведет к краху"
                            },
                            {
                                "target_lang_word": "крах",
                                "target_lang_sense_clarification": "причина полного провала"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "ondergang",
                                "target_lang_sense_clarification": "de oorzaak van iemands vernietiging"
                            },
                            {
                                "target_lang_word": "val",
                                "target_lang_sense_clarification": "de reden voor iemands mislukking"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a550d2c6-6c6f-324b-996d-56366353bdb3",
                    "sense_definition": "A heavy fall of rain or snow.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "precipitation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden <w>downfall</w> of rain caught the hikers completely unprepared.",
                            "target_lang_translations": {
                                "ru": "Внезапный <w>ливень</w> застал туристов врасплох.",
                                "nl": "De plotselinge <w>stortbui</w> overviel de wandelaars volledig onvoorbereid."
                            }
                        },
                        {
                            "text": "We watched the heavy <w>downfall</w> of snow from the safety of our warm living room.",
                            "target_lang_translations": {
                                "ru": "Мы наблюдали за сильным <w>снегопадом</w> из уюта нашей теплой гостиной.",
                                "nl": "We keken naar de zware <w>sneeuwval</w> vanuit de veiligheid van onze warme woonkamer."
                            }
                        }
                    ],
                    "common_phrases": [
                        "downfall of rain"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сильный, обильный дождь или снегопад.",
                        "nl": "Een zware val van regen of sneeuw."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ливень",
                                "target_lang_sense_clarification": "проливной дождь"
                            },
                            {
                                "target_lang_word": "снегопад",
                                "target_lang_sense_clarification": "обильное выпадение снега"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "stortbui",
                                "target_lang_sense_clarification": "een zeer hevige regenbui"
                            },
                            {
                                "target_lang_word": "sneeuwval",
                                "target_lang_sense_clarification": "het vallen van sneeuw"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e917d464-abae-3904-81d4-cfa0fa99c2f4",
                    "sense_definition": "To fall down, deteriorate, or decline.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Some theorists believed that the entire economic system would <w>downfall</w> within a decade.",
                            "target_lang_translations": {
                                "ru": "Некоторые теоретики полагали, что вся экономическая система <w>рухнет</w> в течение десятилетия.",
                                "nl": "Sommige theoretici geloofden dat het gehele economische systeem binnen een decennium <w>ten onder zou gaan</w>."
                            }
                        },
                        {
                            "text": "As the old structures began to <w>downfall</w>, new communities emerged from the ruins.",
                            "target_lang_translations": {
                                "ru": "Когда старые структуры начали <w>приходить в упадок</w>, на руинах возникли новые сообщества.",
                                "nl": "Terwijl de oude structuren begonnen te <w>vervallen</w>, ontstonden er nieuwe gemeenschappen uit de ruïnes."
                            }
                        }
                    ],
                    "synonyms": [
                        "fall"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used as a verb in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Падать ниц, разрушаться, приходить в упадок (устаревшее).",
                        "nl": "Vallen, verslechteren of achteruitgaan (verouderd)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рушиться",
                                "target_lang_sense_clarification": "приходить в упадок, разваливаться"
                            },
                            {
                                "target_lang_word": "пасть",
                                "target_lang_sense_clarification": "потерпеть крах, упасть"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "ten onder gaan",
                                "target_lang_sense_clarification": "vernietigd worden of falen"
                            },
                            {
                                "target_lang_word": "vervallen",
                                "target_lang_sense_clarification": "in een slechtere staat raken"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}