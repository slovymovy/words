                    {
                        "sense_id": "94276845-7b12-3a57-bdbc-a4ded2991248",
                        "entry_id": "268c547a-2db2-3ebf-a786-fffed76af83a",
                        "glosses": [
                            "археол. вскрытие земли для исследования находящихся в культурном слое археологических памятников"
                        ],
