                "senses": [
                    {
                        "sense_id": "81c33c1c-9a75-3438-ae1c-be8a3fd7f7a5",
                        "entry_id": "5c7559ee-8e94-343e-bd14-f06db65622e9",
                        "glosses": [
                            "een woord dat hetzelfde wordt uitgesproken en/of geschreven als een ander woord – al dan niet van dezelfde woordsoort – maar daarmee in betekenis verschilt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7119c598-2bd4-49d5-a6ec-180801763d65",
                                "sense_id": "81c33c1c-9a75-3438-ae1c-be8a3fd7f7a5",
                                "text": "Homoniemen zijn woorden met twee totaal verschillende betekenissen, bijvoorbeeld ‘arm’, dat is zowel een lichaamsdeel als een persoon die niet rijk is.."
                            }
                        ]
                    },
                    {
                        "sense_id": "4eca7660-8091-3bf2-8c91-9f388d64a0a6",
                        "entry_id": "5c7559ee-8e94-343e-bd14-f06db65622e9",
                        "glosses": [
                            "een wetenschappelijke naam met dezelfde spelling (dus bestaande uit dezelfde letters) als een andere wetenschappelijke naam, maar met een ander type (niet te verwarren met een isoniem)"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5ace4e40-7e64-42ed-8e21-f1429fc840e7",
                        "source_entry_id": "5c7559ee-8e94-343e-bd14-f06db65622e9",
                        "source_sense_id": "81c33c1c-9a75-3438-ae1c-be8a3fd7f7a5",
                        "source_sense_description": "een woord dat hetzelfde wordt uitgesproken als een ander woord maar in betekenis verschilt",
                        "target_lang_word": "Homonym",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Homonym",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "537ad11b-4805-3d38-8bc4-66352ed2a44b",
                                        "entry_id": "bcf9e017-86a7-3b28-890e-4014abffc4cf",
                                        "glosses": [
                                            "Wort, das mit einem anderen gleich lautet, aber eine andere Bedeutung und – je nach Definition – zumeist auch eine andere Herkunft hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1442aa63-e244-4504-92f2-05ed05eb1b95",
                                                "sense_id": "537ad11b-4805-3d38-8bc4-66352ed2a44b",
                                                "text": "Die Wortform „Kiel“ (Teil einer Vogelfeder oder Teil eines Schiffes) steht für zwei Homonyme, das heißt für zwei Wörter, da beide Bedeutungen nichts miteinander zu tun haben."
                                            },
                                            {
                                                "example_id": "00418293-cd24-46be-9051-0c64421ffebf",
                                                "sense_id": "537ad11b-4805-3d38-8bc4-66352ed2a44b",
                                                "text": "„schlingen“ in der Bedeutung ‚(ineinander)winden, verflechten, verknüpfen‘ und „schlingen“ in der Bedeutung ‚schlucken, gierig und schnell essen‘ sind Homonyme, da zum einen ihre Bedeutungen weit auseinanderliegen und zum andern das erstgenannte Wort auf althochdeutsch slingan, mittelhochdeutsch slingen, das zweite jedoch auf althochdeutsch slintan, mittelhochdeutsch slinden zurückgeht."
                                            },
                                            {
                                                "example_id": "19072d25-8a9d-4829-89a4-c41c82f164c7",
                                                "sense_id": "537ad11b-4805-3d38-8bc4-66352ed2a44b",
                                                "text": "„Ausgangspunkt des Witzes in Sachsen sind zunächst Homonyme, die durch den mundartlichen Zusammenfall schriftsprachlich getrennter Formen entstehen.“"
                                            },
                                            {
                                                "example_id": "69883008-36fc-42d4-b673-1fba1ba15820",
                                                "sense_id": "537ad11b-4805-3d38-8bc4-66352ed2a44b",
                                                "text": "„Allerdings könnten auch die schon zu DDR-Zeiten üblich gewesenen Gegenlosungen, die ja mit Homonymen spielen, bereits als Sprachspiele betrachtet werden.“"
                                            },
                                            {
                                                "example_id": "c418bd3a-b5cd-42ff-a28a-88df014eea5f",
                                                "sense_id": "537ad11b-4805-3d38-8bc4-66352ed2a44b",
                                                "text": "„Besonders kniffelig wird es bei Homonymen, die zwar das gleiche grammatische Geschlecht haben, aber eine unterschiedliche Pluralbildung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "caf08db9-fb40-46d9-8850-ad4e2ef419ea",
