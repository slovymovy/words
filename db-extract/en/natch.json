                                        ],
                                        "tags": [
                                            "expressively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb40ddd7-384a-4fed-823a-64e3bf2d72da",
                                                "sense_id": "dec50634-9860-3f09-9ca1-de8ef3793139",
                                                "text": "„Tak co, koupíme to?“ – „Jasan, za takovou cenu to nikde jinde neseženeš.“"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
