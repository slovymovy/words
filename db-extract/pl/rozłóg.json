                                                "text": "Durch Wald und Flur – (Buchtitel)"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "bdb2467f-8cc7-37a3-9e95-24b654b180ca",
                                        "entry_id": "e8fd2934-05f4-37e8-a645-29cc90b97e58",
                                        "glosses": [
                                            "Feldmark"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea9e554b-f2a8-4cd5-8488-49418eda29cc",
                                                "sense_id": "bdb2467f-8cc7-37a3-9e95-24b654b180ca",
                                                "text": "Die Folge war eine Zersplitterung der Flur."
                                            },
                                            {
                                                "example_id": "0ff9964a-b55e-4985-9b9c-b177a64b6bc2",
                                                "sense_id": "bdb2467f-8cc7-37a3-9e95-24b654b180ca",
                                                "text": "„Die holden Inseln im Rhein, der gewaltige Strom und die schöne Flur müssen den romantischen Dichter entzückt haben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
