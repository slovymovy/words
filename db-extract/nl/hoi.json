                                "sense_id": "db775887-4371-3107-af1d-d88c3e96885a",
                                "text": "Tot morgen. Hoi!",
                                "translation": "See you tomorrow. Bye!",
                                "english": "See you tomorrow. Bye!"
                            }
                        ]
                    },
                    {
