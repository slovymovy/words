                                "example_id": "534bf844-23ac-4a83-9af3-23ef6d230d20",
                                "sense_id": "99cf795e-93dd-3354-8e6e-54590c2e4bc5",
                                "text": "Dès le premier jour, les chevilles tuméfiées par la pression du fer se déchirèrent. Une plaie se forma, sanieuse, putride, entourée d’une auréole d’inflammation violente."
                            },
                            {
                                "example_id": "a047004d-1296-456f-aad6-5e9a9fb134dc",
                                "sense_id": "99cf795e-93dd-3354-8e6e-54590c2e4bc5",
                                "text": "De touts petits enfants couverts de croûtes et de lésions sanieuses censées inciter les passants à témoigner d'un peu de charité."
                            }
                        ]
