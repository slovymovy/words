                    {
                        "translation_id": "e49c1f28-cd36-4d8e-9ca0-9c88be0dd249",
                        "source_entry_id": "7aadd8c1-ecf0-33ea-b7e1-2504d2c61b73",
                        "source_sense_description": "in a manner that leaves no remainder",
                        "target_lang_word": "на́цело",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "на́цело",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "b3edf78b-af57-38cb-8cde-58e5515c2660",
                                        "entry_id": "3cf6a7cf-eb58-333f-adf9-94e8871f36b8",
                                        "glosses": [
                                            "разг. полностью, без остатка"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ffae588f-e344-4dc6-a2ab-4cb039810e0f",
                                                "sense_id": "b3edf78b-af57-38cb-8cde-58e5515c2660",
                                                "text": "Для сатирика настоящее нацело разлагается на прошлое и будущее, никакого нейтрального и самодостаточного настоящего не остаётся."
                                            },
                                            {
                                                "example_id": "d76088dc-5eae-4d86-aa85-f3a3d3222317",
                                                "sense_id": "b3edf78b-af57-38cb-8cde-58e5515c2660",
                                                "text": "Мелкие пустоты обычно нацело заполняются минеральным веществом."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d13367c1-31b3-3377-90b1-768237c8f8fa",
                                        "entry_id": "3cf6a7cf-eb58-333f-adf9-94e8871f36b8",
                                        "glosses": [
                                            "матем. без остатка (о делении)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b6ea2c16-99d6-43b3-925b-754dc60a7f7c",
                                                "sense_id": "d13367c1-31b3-3377-90b1-768237c8f8fa",
                                                "text": "Правда, мы получаем абсолютный номер сектора, но это не страшно, для «правильных» секторов номер будет нацело делиться на количество секторов на дорожку…"
                                            },
                                            {
                                                "example_id": "6ac8c568-cdf6-439b-ae99-d4d612378014",
                                                "sense_id": "d13367c1-31b3-3377-90b1-768237c8f8fa",
                                                "text": "А при проверке, является ли год с номером Year високосным, следует помнить, что год считается таковым, если его номер делится нацело на 4, но не делится на 100 или делится нацело на 400."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
