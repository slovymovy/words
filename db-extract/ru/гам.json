                    }
                ],
                "translations": [
                    {
                        "translation_id": "56b848fa-d852-4344-aeb7-e2645f265059",
                        "source_entry_id": "6b82ec13-0e74-39b0-b362-caa3eb7aba22",
                        "source_sense_id": "aa5006d1-5ccb-3173-9178-312f6d5c0cd5",
                        "target_lang_word": "noise",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "noise",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4b8baea3-60ac-361a-81c1-7a03ae1bdba3",
                                        "entry_id": "f5048dbe-7a80-3ff3-9e05-b57bfd6d1dc1",
                                        "glosses": [
                                            "Various sounds, usually unwanted or unpleasant."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6df56091-864c-4bdc-ad2c-766fe01d5962",
                                                "sense_id": "4b8baea3-60ac-361a-81c1-7a03ae1bdba3",
                                                "text": "He knew that it was trash day, when the garbage collectors made all the noise."
                                            },
                                            {
                                                "example_id": "3f7f5064-89c6-4b96-b7a1-882c1874b975",
                                                "sense_id": "4b8baea3-60ac-361a-81c1-7a03ae1bdba3",
                                                "text": "The heavens turn about in a most rapid motion without noise to us perceived."
                                            },
                                            {
                                                "example_id": "44d0ba03-8260-4db9-8a29-dba4c2c2cd1f",
                                                "sense_id": "4b8baea3-60ac-361a-81c1-7a03ae1bdba3",
                                                "text": "Charles had not been employed above six months at Darracott Place, but he was not such a whopstraw as to make the least noise in the performance of his duties when his lordship was out of humour."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2e398d2b-b134-3cd2-8a3e-7e850f201bed",
                                        "entry_id": "f5048dbe-7a80-3ff3-9e05-b57bfd6d1dc1",
                                        "glosses": [
                                            "Any sound."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "912e48f2-0d4d-4205-9522-3e72a39d5497",
                                                "sense_id": "2e398d2b-b134-3cd2-8a3e-7e850f201bed",
                                                "text": "The sudden noise made everyone jump."
                                            },
                                            {
                                                "example_id": "2d2c5c9d-17b4-4304-ab32-bbd538dfd13e",
                                                "sense_id": "2e398d2b-b134-3cd2-8a3e-7e850f201bed",
                                                "text": "She crept up behind him not making a noise."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b56f6de3-9a87-3390-ac6d-3277e3015e31",
                                        "entry_id": "f5048dbe-7a80-3ff3-9e05-b57bfd6d1dc1",
                                        "glosses": [
                                            "Sound or signal generated by random fluctuations."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2b5e7a9a-bc78-3d4f-97c6-1aac11ff8dd4",
                                        "entry_id": "f5048dbe-7a80-3ff3-9e05-b57bfd6d1dc1",
                                        "glosses": [
                                            "Any part of a signal or data that reduces the clarity, precision, or quality of the desired output."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "20a98bdc-1153-418d-8dfa-c4127a0eafdf",
                                                "sense_id": "2b5e7a9a-bc78-3d4f-97c6-1aac11ff8dd4",
                                                "text": "signal-to-noise ratio"
                                            },
                                            {
                                                "example_id": "792b40fb-d570-405e-a904-ee0e2feb9d7b",
                                                "sense_id": "2b5e7a9a-bc78-3d4f-97c6-1aac11ff8dd4",
                                                "text": "On the technical side, the scanning and OCR of texts, in combination with the graphic design of high school text books, introduced a certain level of noise into the corpus which in turn led to a higher tagging error rate than usual and may affect count precision."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bec8cdbb-8f10-3f6c-b893-bb715bd5194c",
                                        "entry_id": "f5048dbe-7a80-3ff3-9e05-b57bfd6d1dc1",
                                        "glosses": [
                                            "Variation or deviation generated by random fluctuations."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "71895b10-4788-3ca4-aa89-3dca67ded46d",
                                        "entry_id": "f5048dbe-7a80-3ff3-9e05-b57bfd6d1dc1",
                                        "glosses": [
                                            "Unwanted fuss or bustle; useless activity."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "925a6042-7125-41d6-a097-429709b7f2f8",
                                                "sense_id": "71895b10-4788-3ca4-aa89-3dca67ded46d",
                                                "text": "In order to provide coherence and confidence, the leader must dramatically turn down the noise level in the organization, eliminate any unnecessary distractions that inevitably get in the way of execution, and banish the fear of uncertainty."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c5415f5a-6c49-3694-973b-c99a2fcf9f61",
                                        "entry_id": "f5048dbe-7a80-3ff3-9e05-b57bfd6d1dc1",
                                        "glosses": [
                                            "The measured level of variation in gene expression among cells, regardless of source, within a supposedly identical population."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c609f7ce-a022-38a6-91c8-c8acae3e4f38",
                                        "entry_id": "f5048dbe-7a80-3ff3-9e05-b57bfd6d1dc1",
                                        "glosses": [
                                            "Rumour or complaint."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a589b4a6-dd01-40bf-959f-992ca48de708",
                                                "sense_id": "c609f7ce-a022-38a6-91c8-c8acae3e4f38",
                                                "text": "The problems with the new computer system are causing a lot of noise at Head Office."
                                            },
                                            {
                                                "example_id": "2931f1bb-6770-4798-94e2-54313480d8b8",
                                                "sense_id": "c609f7ce-a022-38a6-91c8-c8acae3e4f38",
                                                "text": "1709-1710, Thomas Baker, Reflections on Learning\nWhat noise have we had for fome Years about Transplantation of diseases and transfusion of blood!"
                                            },
                                            {
                                                "example_id": "e9ad0d18-f123-4619-8b7f-b30d5ee6d42d",
                                                "sense_id": "c609f7ce-a022-38a6-91c8-c8acae3e4f38",
                                                "text": "He [Socrates] lived in Athens during the great plague, which has made so much noise through all ages."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5fef8cd2-6c17-3078-831a-08fbe0d30f9e",
                                        "entry_id": "f5048dbe-7a80-3ff3-9e05-b57bfd6d1dc1",
                                        "glosses": [
                                            "Speech that is suggestive of an attitude or opinion."
                                        ],
                                        "tags": [
                                            "countable",
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c2fdbb9c-d106-430c-9ad6-38203d513a8f",
                                                "sense_id": "5fef8cd2-6c17-3078-831a-08fbe0d30f9e",
                                                "text": "Despite encouraging noises made by politicians from time to time, the two sides there have never been further from an agreement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eb33db2d-13e3-3775-98f7-7a202c3f1e62",
                                        "entry_id": "f5048dbe-7a80-3ff3-9e05-b57bfd6d1dc1",
                                        "glosses": [
                                            "Music, in general; a concert; also, a company of musicians; a band."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "edae4a6a-4f51-45c5-a81d-0c9ad6e6c657",
                                                "sense_id": "eb33db2d-13e3-3775-98f7-7a202c3f1e62",
                                                "text": "The king has his noise of gypsies."
                                            },
                                            {
                                                "example_id": "9fafdad5-2cb1-45f1-baf3-b4441be13ae5",
                                                "sense_id": "eb33db2d-13e3-3775-98f7-7a202c3f1e62",
                                                "text": "That we on earth, with undiscording voice, / May rightly answer that melodious noise"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9d4a4dcd-84b6-352b-b286-3e9f87c9b107",
                                        "entry_id": "f5048dbe-7a80-3ff3-9e05-b57bfd6d1dc1",
                                        "glosses": [
                                            "A genre of rock music that uses static and other non-musical sounds, also influenced by art rock."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "noise",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9ecac966-6ce0-3836-842a-054fff65ff1f",
                                        "entry_id": "5284ec33-45d7-3a46-84ad-fa5174461cb1",
                                        "glosses": [
                                            "To make a noise; to sound."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5f62f364-6245-4039-92eb-9ffa57d4d498",
                                                "sense_id": "9ecac966-6ce0-3836-842a-054fff65ff1f",
                                                "text": "Those terrours, which thou speak'st of, did me none ;\nI never fear'd they could, though noising loud\nAnd threatening nigh"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fa71f831-72ac-3a35-bf11-815386995f95",
                                        "entry_id": "5284ec33-45d7-3a46-84ad-fa5174461cb1",
                                        "glosses": [
                                            "To spread news of; to spread as rumor or gossip."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3dc0f650-7eca-4585-bb8c-bd3bac5a72ef",
                                                "sense_id": "fa71f831-72ac-3a35-bf11-815386995f95",
                                                "text": "When this was noysed aboute, the multitude cam togedder and were astonyed, because that every man herde them speake in his awne tongue."
                                            },
                                            {
                                                "example_id": "4a6f6fdb-b04e-47de-a4fa-9f2a7fd26315",
                                                "sense_id": "fa71f831-72ac-3a35-bf11-815386995f95",
                                                "text": "This man then meeting with Chriſtian, and having ſome inckling of him, for Chriſtians ſetting forth from the City of Deſtruction was much noiſed abroad, not only in the Town, where he dwelt, but alſo it began to be the Town-talk in ſome other places."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
