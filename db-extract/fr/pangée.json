                "senses": [
                    {
                        "sense_id": "16cf45d5-7b6b-3fb9-a7a0-29bb9d0800bc",
                        "entry_id": "a11462d0-487a-357d-a4e3-e172da42cf98",
                        "glosses": [
                            "Massif montagneux de la Macédoine, nommée aussi Pounhar-Dagh du temps de l’empire ottoman."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd33924b-2a2c-47b1-a45a-53cef9eefb63",
                                "sense_id": "16cf45d5-7b6b-3fb9-a7a0-29bb9d0800bc",
                                "text": "Ce sont toutes parties d’un même sujet : le Pangée, la région côtière de la Thrace, dans ses rapports avec le monde hellénique."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "14e0903b-c05d-4761-b40d-4882c0f80155",
