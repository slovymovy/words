                "senses": [
                    {
                        "sense_id": "433ef97d-be1e-327b-8ecf-c83f76b02248",
                        "entry_id": "93eef101-1ed5-3411-8e87-f391fbf6c47a",
                        "glosses": [
                            "doskonały mówca lub interpretator recytowanych tekstów"
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "93e10c61-b852-461a-8aab-7ffc799ff24e",
                                "sense_id": "433ef97d-be1e-327b-8ecf-c83f76b02248",
                                "text": "Obywatele Antiochii widzieli więc w Janie retora doskonałego i byli dumni, że właśnie on, w ich mieście, przejmuje z rąk pogańskich prymat retoryki."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "2c604b66-61f6-3436-93c3-b9c180ba76fb",
                        "entry_id": "93eef101-1ed5-3411-8e87-f391fbf6c47a",
                        "glosses": [
                            "nauczyciel poprawnej wymowy"
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "fd765d00-caf6-4a98-8133-5b0e83f8c860",
                                "sense_id": "2c604b66-61f6-3436-93c3-b9c180ba76fb",
                                "text": "Ja się nie znałem, nawet nie widziałem z Jackiem; / Ledwiem słyszał o jego życiu hajdamackiem, / Siedząc wtenczas retorem w jezuickiej szkole, / Potem u wojewody służąc za pacholę."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
