                            "trait_type": "form",
                            "comment": "verb form"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Second person singular present tense (in inversion) of <w>verhuren</w> (to rent out).",
                        "ru": "Форма второго лица единственного числа настоящего времени (при инверсии) глагола verhuren (сдавать в аренду)."
                    },
                    "translations": {
