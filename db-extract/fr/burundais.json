                "senses": [
                    {
                        "sense_id": "559a1d61-670d-3dad-9428-85e8f9316d42",
                        "entry_id": "8f9fc23c-eedb-3580-bad7-f9b40079a5cd",
                        "glosses": [
                            "Relatif au Burundi."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0bc4532b-51fd-4c3a-875f-489c7ac4465b",
                                "sense_id": "559a1d61-670d-3dad-9428-85e8f9316d42",
                                "text": "Ce jeune homme est burundais."
                            },
                            {
                                "example_id": "22e8bd80-a6e1-489d-86d0-4453df27501f",
                                "sense_id": "559a1d61-670d-3dad-9428-85e8f9316d42",
                                "text": "La Somalie se serait emparée de positions clé. Interrogé en début de semaine, le chef d’état-major de l’armée burundaise n’avait ni confirmé ni infirmé des informations faisant état de plusieurs dizaines de victimes parmi le contingent burundais."
                            },
                            {
                                "example_id": "334302c6-3352-4f0a-b39e-61527ccb5933",
                                "sense_id": "559a1d61-670d-3dad-9428-85e8f9316d42",
                                "text": "Dès le poste-frontière, on changeait de monde. La retenue burundaise laissait place au tumulte zaïrois. — (Gaël Faye, Petit Pays, Grasset, 2016, page 22)"
                            },
                            {
                                "example_id": "a80cb423-a88e-4c52-ba6a-7fc0a155f854",
                                "sense_id": "559a1d61-670d-3dad-9428-85e8f9316d42",
                                "text": "Il est le deuxième dirigeant d'Afrique de l'Est à mourir dans des circonstances controversées, après le président burundais Pierre Nkurunziza, également sceptique sur la COVID-19 et décédé des suites d'une \"insuffisance cardiaque\" en juin dernier, après que sa femme a été transportée à Nairobi pour y être soignée du coronavirus."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "24952be7-685f-4880-8a23-677c34e4f564",
                        "source_entry_id": "8f9fc23c-eedb-3580-bad7-f9b40079a5cd",
                        "source_sense_id": "559a1d61-670d-3dad-9428-85e8f9316d42",
