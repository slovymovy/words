                "senses": [
                    {
                        "sense_id": "43641215-b632-349b-9981-cd59cfdaa83d",
                        "entry_id": "f3487960-b128-38c4-a063-2a123cff0e31",
                        "glosses": [
                            "jemand, der einen Kredit aufnimmt"
                        ],
                        "tags": [
                            "Finanzen"
                        ],
                        "examples": [
                            {
                                "example_id": "9089d096-d7c1-4a7b-b6a2-c69ab81559bf",
                                "sense_id": "43641215-b632-349b-9981-cd59cfdaa83d",
                                "text": "Die Bonität des Kreditnehmers wurde vor der Kreditvergabe gründlich geprüft."
                            },
                            {
                                "example_id": "92a78d44-7243-4b0f-bb72-f0f3b22c6b83",
                                "sense_id": "43641215-b632-349b-9981-cd59cfdaa83d",
                                "text": "„Es ist illusorisch anzunehmen, dass alle Kreditnehmer ihre Kredite immer bedienen werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e70e8356-dd8d-472c-8a3e-823db0c3bdb8",
                        "source_entry_id": "f3487960-b128-38c4-a063-2a123cff0e31",
                        "source_sense_id": "43641215-b632-349b-9981-cd59cfdaa83d",
                        "source_sense_description": "Finanzen: jemand, der einen Kredit aufnimmt",
                        "target_lang_word": "borrower",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "borrower",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "05f06e7e-e5fe-3488-9845-ef5ab4ab1723",
                                        "entry_id": "f80610fa-e43f-3806-aad9-7bab991ad874",
                                        "glosses": [
                                            "One who borrows."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9441e978-0339-4403-9d96-0c8ba4f35df7",
                                                "sense_id": "05f06e7e-e5fe-3488-9845-ef5ab4ab1723",
                                                "text": "a library borrower’s card"
                                            },
                                            {
                                                "example_id": "077e3006-438d-4cc6-a192-32c96f867c91",
                                                "sense_id": "05f06e7e-e5fe-3488-9845-ef5ab4ab1723",
                                                "text": "But if other negative factors are operating simultaneously, or if the borrower's financial status is weak to start with, then one extra adverse development is more likely to affect returns on the loan."
                                            },
                                            {
                                                "example_id": "2b1ebe92-3191-43e1-a654-ced0ab38a8a6",
                                                "sense_id": "05f06e7e-e5fe-3488-9845-ef5ab4ab1723",
                                                "text": "This term became popular from the late 1960s onwards, languages being neatly divided between borrowers and calquers."
                                            },
                                            {
                                                "example_id": "492c84b1-8fe3-4486-ab90-1fdc166b4281",
                                                "sense_id": "05f06e7e-e5fe-3488-9845-ef5ab4ab1723",
                                                "text": "For most student loan issues, borrowers work with loan servicers hired by the department rather than directly with FSA staff."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
