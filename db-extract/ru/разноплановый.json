                                        "sense_id": "af5c0d09-108c-3d6d-88fe-d054acda6d3e",
                                        "entry_id": "1ab59edb-8bcf-35e4-b8a5-05a64da730a3",
                                        "glosses": [
                                            "Alternative spelling of multifaceted."
                                        ],
                                        "tags": [
