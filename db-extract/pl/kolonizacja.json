                "senses": [
                    {
                        "sense_id": "e5155553-218c-38d2-81a1-bf0491fbf2f8",
                        "entry_id": "2e7652c6-68d3-32a4-822e-025d5ab8ad31",
                        "glosses": [
                            "tworzenie osad na obszarach słabo zamieszkanych lub niezamieszkanych"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "506b3807-c71e-4259-a07e-84ccae95e46f",
                                "sense_id": "e5155553-218c-38d2-81a1-bf0491fbf2f8",
                                "text": "Na wschód od Lachów mieszkają Pogórzanie, prowadzący gospodarkę pastersko-rolniczą, posiadający w swej kulturze materialnej, a zwłaszcza w budownictwie, ślady średniowiecznej kolonizacji niemieckiej (stąd występujące tu czasem określenie „na Głuchoniemcach\")."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "9d60bd1e-4eaf-38b1-91ff-6980818d8fb9",
                        "entry_id": "2e7652c6-68d3-32a4-822e-025d5ab8ad31",
                        "glosses": [
                            "przekształcanie podbitych miejsc w kolonie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b4ef043-7031-4184-a1d6-487c4799b5d9",
                                "sense_id": "9d60bd1e-4eaf-38b1-91ff-6980818d8fb9",
                                "text": "„Kolonizacja nie była nigdy aktem cywilizacyjnym, nie wyrosła z woli cywilizowania kogokolwiek — mówi Albert Sarraut, w swoim czasie gubernator Indochin. — Jest ona aktem przemocy, i to przemocy kierowanej interesem własnym”"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "1cc0ff7d-291e-3d6d-b0c6-41b7c4e0c246",
                        "entry_id": "2e7652c6-68d3-32a4-822e-025d5ab8ad31",
                        "glosses": [
                            "zasiedlanie organizmu przez drobnoustroje; bezobjawowa obecność mikroorganizmów w ustroju"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a362e298-0112-4b28-9207-53d5ded35e9c",
                        "source_entry_id": "2e7652c6-68d3-32a4-822e-025d5ab8ad31",
                        "source_sense_id": "e5155553-218c-38d2-81a1-bf0491fbf2f8",
                        "target_lang_word": "colonisation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "colonisation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b77cf397-3e1d-3e89-b0ac-50e5ce621ea3",
                                        "entry_id": "a413760b-bc86-324e-85e5-7b6a9e5cedb6",
                                        "glosses": [
                                            "Alternative spelling of colonization."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e1c5b437-e756-4cd5-ac4d-b53dad3fc294",
                                                "sense_id": "b77cf397-3e1d-3e89-b0ac-50e5ce621ea3",
                                                "text": "Colonisation began towards the end of 1826, when a British settlement was founded at Albany, on the southern coast, and in the next year the whole territory (then known as New Holland) became a possession of the British Crown."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d00e5c52-43db-48a0-8864-92feabf13826",
                        "source_entry_id": "2e7652c6-68d3-32a4-822e-025d5ab8ad31",
                        "source_sense_id": "e5155553-218c-38d2-81a1-bf0491fbf2f8",
