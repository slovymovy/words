                        ],
                        "examples": [
                            {
                                "example_id": "55c1b2ea-15e0-4fb7-a583-75c56d4785b6",
                                "sense_id": "c0e6334d-89e8-398d-9ff6-62b2dfddb992",
                                "text": "In de witte bubbel komt raciaal ongemak niet voor en is men niet gewend erover te praten. Om de goede vrede te bewaren, nemen witte mensen het vaak voor elkaar op bij een beschuldiging van racisme, merkt DiAngelo. Voor zwarte mensen is het dus nog moeilijker om erover te beginnen, zeker in levenden lijve, vandaar dat het debat vooral online in eigen kringen woedt."
                            }
