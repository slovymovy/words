                                "target_senses": [
                                    {
                                        "sense_id": "735dfb24-1805-3345-9aff-362f0c7c5219",
                                        "entry_id": "c7ac204f-21a1-3b1c-ba15-a14eadd8c331",
                                        "glosses": [
                                            "Faire un arrangement avec une personne au sujet d’une entreprise dont elle a été chargée."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f415be40-c868-3d16-9b17-27e5a6713461",
                                        "entry_id": "c7ac204f-21a1-3b1c-ba15-a14eadd8c331",
                                        "glosses": [
                                            "Céder en totalité ou en partie une affaire, une entreprise pour laquelle on avait soi-même traité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88602fa4-4eb5-4ea9-84c5-e28dea6c7037",
                                                "sense_id": "f415be40-c868-3d16-9b17-27e5a6713461",
                                                "text": "Il s’était rendu adjudicataire de cette fourniture, il en a sous-traité avec un tel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5e5dd811-c927-3bd3-819e-312f13bb4f5d",
                                        "entry_id": "c7ac204f-21a1-3b1c-ba15-a14eadd8c331",
                                        "glosses": [
                                            "Faire réaliser, pour son compte, une activité commerciale ou industrielle, que l'on ne peut ou ne veut pas faire."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5a44e73d-6bf2-4019-a567-8a63d5f68467",
                                                "sense_id": "5e5dd811-c927-3bd3-819e-312f13bb4f5d",
                                                "text": "Il faut dire que le fabricant a fait très tôt le choix de la délocalisation, […]. 45% des tissus des collections du groupe sont tricotés et découpés en France, la confection étant sous-traitée au Maghreb, en Roumanie ou en Asie."
                                            },
                                            {
                                                "example_id": "df5c85f4-c17d-4ebf-8a32-bb27bdc25c00",
                                                "sense_id": "5e5dd811-c927-3bd3-819e-312f13bb4f5d",
                                                "text": "A eux trois, Google, Apple et Facebook ont moins d’employés qu’un groupe comme Carrefour. Cela veut dire qu’ils sous-traitent la quasi-totalité de leur activité, à l’exception de l’ingénierie, de la finance et du marketing."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
