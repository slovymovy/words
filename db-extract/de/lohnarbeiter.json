                "senses": [
                    {
                        "sense_id": "af2a221f-c3ec-3b60-bffd-6831b545f051",
                        "entry_id": "e5cfbb25-1336-3946-9c59-b45db6ee18ba",
                        "glosses": [
                            "Arbeiter, der einer Lohnarbeit nachgeht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a809130d-236a-42c6-bda0-e5dcc998b9a7",
                                "sense_id": "af2a221f-c3ec-3b60-bffd-6831b545f051",
                                "text": "„Nach Hal Draper bildet das industrielle Proletariat den Kern der Arbeiterklasse, danach kommt das nicht-industrielle Proletariat, also die Lohnarbeiter im Bereich der Dienstleistungen und der Landwirtschaft.“"
                            },
                            {
                                "example_id": "b1e0b20b-94fc-4259-aacd-c2829eb4d417",
                                "sense_id": "af2a221f-c3ec-3b60-bffd-6831b545f051",
                                "text": "„Geldhäuser wie das der Fugger stiegen zu Montanunternehmen und dann zu Montanmonopolisten auf, während die in Eigenregie schürfenden und hüttenden Bergwerkler zu Lohnarbeitern absanken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
