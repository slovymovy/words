                ],
                "senses": [
                    {
                        "sense_id": "a41ece0d-9098-3297-9d6c-07fc56031985",
                        "entry_id": "4c7e365a-fe62-3710-bf36-ee1a64d55d1b",
                        "glosses": [
                            "Person, welche neben einer anderen Person, auf einer Sitzgelegenheit sitzt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "856665dd-6c80-49f8-afad-0a670c9d716a",
                                "sense_id": "a41ece0d-9098-3297-9d6c-07fc56031985",
                                "text": "„Rich Wisken geht in seinem Reisebericht noch auf weitere Details des vierstündigen Beisammenseins mit seinem übergewichtigen Sitznachbarn ein.“"
                            },
                            {
                                "example_id": "c4e800c9-335c-4ef0-b3d7-db5279dd0f9d",
                                "sense_id": "a41ece0d-9098-3297-9d6c-07fc56031985",
                                "text": "„Später, als ich im Flugzeug saß, roch mein Sitznachbar an mir.“"
                            },
                            {
                                "example_id": "d4f661fe-b584-41a8-9a82-306329aff28f",
                                "sense_id": "a41ece0d-9098-3297-9d6c-07fc56031985",
                                "text": "„Meinen Sitznachbarn ging das ähnlich, aber die hatten sich ihr eigenes Essen mitgebracht.“"
                            },
                            {
                                "example_id": "dc6ef927-746a-47f9-8f3e-cc123f8bdcba",
                                "sense_id": "a41ece0d-9098-3297-9d6c-07fc56031985",
                                "text": "„Grenfeld erkannte im zerknautschten Gesicht seines Sitznachbarn einen alten Kollegen aus dem Präsidium.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
