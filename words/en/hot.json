                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "status",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The politician didn't realize the microphone was <w>hot</w> and said something embarrassing.",
                            "target_lang_translations": {
                                "ru": "Политик не понял, что микрофон <w>включен</w>, и сказал нечто неловкое."
