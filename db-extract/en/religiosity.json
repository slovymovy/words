        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "d45b4867-8362-31a9-b381-23f8ebb7814e",
                "word": "religiosity",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "29f5f0a0-5ef9-4f48-98ba-13e4ab377cd1",
                        "entry_id": "d45b4867-8362-31a9-b381-23f8ebb7814e",
