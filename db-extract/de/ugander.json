                "senses": [
                    {
                        "sense_id": "2d48bef5-6e5a-3213-a018-625341aa282d",
                        "entry_id": "c401336f-a24d-320d-b3a2-bc93d9004d92",
                        "glosses": [
                            "Staatsbürger von Uganda"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e8f2185-4187-493b-97a3-8f30e9596fde",
                                "sense_id": "2d48bef5-6e5a-3213-a018-625341aa282d",
                                "text": "Goswin hat seit einigen Jahren einen Ugander als Brieffreund."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c9052d9b-b57b-430d-994b-e9cf50b77548",
                        "source_entry_id": "c401336f-a24d-320d-b3a2-bc93d9004d92",
                        "source_sense_id": "2d48bef5-6e5a-3213-a018-625341aa282d",
                        "source_sense_description": "Staatsbürger von Uganda",
                        "target_lang_word": "Ugandan",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ugandan",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "995b4180-53b9-37a7-81f1-e3c9c433e784",
                                        "entry_id": "aacb8ebe-fc9d-3166-afac-572deb63e36e",
                                        "glosses": [
                                            "A person from Uganda or of Ugandan descent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b52462a4-7119-4879-82bc-54ebade2d7bd",
                                                "sense_id": "995b4180-53b9-37a7-81f1-e3c9c433e784",
                                                "text": "Many young Ugandans say on social media they plan to go ahead with the march to the country’s parliament despite the country’s police refusing to grant a permit for the protest."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Ugandan",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b3294505-4130-3443-b85a-aceb6f39be5c",
                                        "entry_id": "e66d27fe-33c9-31d1-8f01-32c8d7a1d954",
                                        "glosses": [
                                            "Of, from, or pertaining to Uganda, the Ugandan people or the Ugandan language."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a662396c-b089-47e8-a10a-a0d1664fb14a",
                                                "sense_id": "b3294505-4130-3443-b85a-aceb6f39be5c",
                                                "text": "Some have also called for the speaker of the parliament, Anita Annet Among, to resign. She was among high-profile Ugandan politicians sanctioned by the United States and the United Kingdom for corruption earlier this year."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Ugandan",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "76d20015-e940-30e1-8a48-c3ee782c6bd4",
                                        "entry_id": "2d7099db-5392-3eb4-a375-7d44e6db1d44",
                                        "glosses": [
                                            "Sexual, highlights a double entendre."
                                        ],
                                        "tags": [
                                            "UK",
                                            "euphemistic",
                                            "informal",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cafdc1a2-7e9f-4d62-aef3-03ae44131739",
                                                "sense_id": "76d20015-e940-30e1-8a48-c3ee782c6bd4",
                                                "text": "Margaret, Duchess of Argyll...depicts this charming old gentleman, who often kisses young girls outside Annabel's, as a narrow-minded, boring Ugandan expert."
                                            },
                                            {
                                                "example_id": "95d8b683-d251-477a-8a01-f59ee1d2fb7c",
                                                "sense_id": "76d20015-e940-30e1-8a48-c3ee782c6bd4",
                                                "text": "Eight ladies with Ugandan associations had ascended the fire escape and were making their way through his room."
                                            },
                                            {
                                                "example_id": "9950da4d-30ae-40c8-a9eb-12b1838ddc27",
                                                "sense_id": "76d20015-e940-30e1-8a48-c3ee782c6bd4",
                                                "text": "They have a bit of a 'how was it for you' session referring to the night and/or evening before, and we are left not knowing whether they enjoyed Ugandan Relations between the sheets or not."
                                            },
                                            {
                                                "example_id": "805a23ff-8f37-44e8-a5b0-1abb041a7713",
                                                "sense_id": "76d20015-e940-30e1-8a48-c3ee782c6bd4",
                                                "text": "I'm in serious need of some ugandan activities. Any of you birds out there at a loose end and want to get the dirty water off your chest?"
                                            },
                                            {
                                                "example_id": "fca1ecec-3083-45d0-8e66-80951948f1a1",
                                                "sense_id": "76d20015-e940-30e1-8a48-c3ee782c6bd4",
                                                "text": "Serif's question: where is Mister? The Eagle's answer: engaged in Ugandan practices."
                                            },
                                            {
                                                "example_id": "c1f8493b-5d14-4cb7-8d13-9491640bc4a1",
                                                "sense_id": "76d20015-e940-30e1-8a48-c3ee782c6bd4",
                                                "text": "I recall her once snatching a copy of the hated Private Eye, in which I'd been reading about the Ugandan activities of a prominent member of her party."
                                            },
                                            {
                                                "example_id": "429a3fce-5b66-4770-abc3-8eb4dcb96842",
                                                "sense_id": "76d20015-e940-30e1-8a48-c3ee782c6bd4",
                                                "text": "Jones denied last week that he was in a Ugandan situation with Morris, but did say \"I am very fond of anyone who helps me lose six and a half stone...\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
