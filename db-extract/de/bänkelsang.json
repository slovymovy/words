                "senses": [
                    {
                        "sense_id": "23b752a5-c164-31f1-858f-99a9d38bd575",
                        "entry_id": "3f851246-522d-3767-a46d-e8d1a7624907",
                        "glosses": [
                            "ein Vortrag von Liedern, die meist einen traurigen oder spektakulären Inhalt haben; politisches Nachrichtenlied aus dem 17. Jahrhundert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "603e4be3-3ea2-4e7c-b63e-fb9cd0c07d27",
                                "sense_id": "23b752a5-c164-31f1-858f-99a9d38bd575",
                                "text": "Von wandernden (auf einem Bänkchen stehenden) Schaustellern wurde der Bänkelsang dem Jahrmarktspublikum vorgetragen."
                            },
                            {
                                "example_id": "f76cabe0-ae16-43c6-a9c9-aa64f0e63fe6",
                                "sense_id": "23b752a5-c164-31f1-858f-99a9d38bd575",
                                "text": "Der Bänkelsang hatte seine Ursprünge im 17. Jahrhundert und zog sich durch die Zeitgeschichte bis in die 1930er Jahre, als er sein Ende fand."
                            },
                            {
                                "example_id": "af380bb9-a0ed-42f5-8bd2-8460f1493363",
                                "sense_id": "23b752a5-c164-31f1-858f-99a9d38bd575",
                                "text": "Sie stiegen auf ein „Bänkel“, zeigten mit einem Stock nacheinander auf einzelne Bilder und trugen ihren Bänkelsang vor."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "beb80cd8-d5e6-4535-b433-220e9b73cdda",
                        "source_entry_id": "3f851246-522d-3767-a46d-e8d1a7624907",
                        "source_sense_id": "23b752a5-c164-31f1-858f-99a9d38bd575",
                        "source_sense_description": "ein Vortrag von Liedern, die meist einen traurigen oder spektakulären Inhalt haben",
                        "target_lang_word": "ritournelle",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ritournelle",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7807e4ca-f411-3f4e-95c0-97868ae4143c",
                                        "entry_id": "ca4a0f6c-bee7-3880-b887-2febc3a2f1e7",
                                        "glosses": [
                                            "Courte phrase musicale dont on fait précéder chaque couplet d’une chanson."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c2b5c0b-236d-4662-a5c1-a435dd231155",
                                                "sense_id": "7807e4ca-f411-3f4e-95c0-97868ae4143c",
                                                "text": "En ce moment, l’orchestre, adoucissant le chant de ses cuivres dans une langueur molle et balancée, commençait la ritournelle d’une valse."
                                            },
                                            {
                                                "example_id": "28570357-1eb0-4b37-9ca3-a147753d0ac2",
                                                "sense_id": "7807e4ca-f411-3f4e-95c0-97868ae4143c",
                                                "text": "Dans son allégresse, elle accompagne de ses chants et de ses danses, en battant rythmiquement des mains, les ritournelles d'un gramophone […]."
                                            },
                                            {
                                                "example_id": "140de182-6e9c-496c-a460-a4cb60baffad",
                                                "sense_id": "7807e4ca-f411-3f4e-95c0-97868ae4143c",
                                                "text": "Et allez donc, envoie la ritournelle\nDe la chanson gnangnan et chauvine et vieux jeu\nRéveille un peu le piano à bretelles\nÀ chaque fois qu'on l'entend, on a les larmes aux yeux."
                                            },
                                            {
                                                "example_id": "2e637687-1e26-4dd4-96b8-2cc47bed0463",
                                                "sense_id": "7807e4ca-f411-3f4e-95c0-97868ae4143c",
                                                "text": "Son répertoire ? Des ritournelles qui font danser les gens, et apaisent les enfants…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c5749a99-e1c5-39bd-aee7-90b2d5a0cb9f",
                                        "entry_id": "ca4a0f6c-bee7-3880-b887-2febc3a2f1e7",
                                        "glosses": [
                                            "Idée à laquelle quelqu’un revient sans cesse, propos qu’il répète à satiété, réponse qu’il fait toujours la même."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "familiar",
                                            "ironic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1d00126e-f7f6-4020-bad6-f70878423920",
                                                "sense_id": "c5749a99-e1c5-39bd-aee7-90b2d5a0cb9f",
                                                "text": "Alors, dans une moue de dépit, il me resservait toujours la même ritournelle : — Si elle n’écrit pas aujourd'hui, elle écrira peut-être demain."
                                            },
                                            {
                                                "example_id": "0423c047-b914-43ad-b77a-cced592fa10f",
                                                "sense_id": "c5749a99-e1c5-39bd-aee7-90b2d5a0cb9f",
                                                "text": "— Je regarde le ciel et ne vois que la pluie\nVoici là la ritournelle de mon profond ennui."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "21011cc5-f02b-3a3c-8e59-713d19a14295",
                                        "entry_id": "ca4a0f6c-bee7-3880-b887-2febc3a2f1e7",
                                        "glosses": [
                                            "Situation qui se répète sans cesse."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2a7ca14d-a5ed-490d-b7e5-9c38f0f12484",
                                                "sense_id": "21011cc5-f02b-3a3c-8e59-713d19a14295",
                                                "text": "Avoir des enfants, qui à leur tour auraient des enfants, c’était rabâcher à l’infini la même ennuyeuse ritournelle ; le savant, l’artiste, l’écrivain, le penseur créaient un autre monde, lumineux et joyeux, où tout avait sa raison d’être."
                                            },
                                            {
                                                "example_id": "d8fbfa76-a2bc-48d7-8e71-a85c6ea1d70d",
                                                "sense_id": "21011cc5-f02b-3a3c-8e59-713d19a14295",
                                                "text": "Ritournelle éternelle où chaque personnage semble déterminé à répéter les mêmes erreurs que ses ancêtres."
                                            }
                                        ]
                                    }
                                ]
                            },
