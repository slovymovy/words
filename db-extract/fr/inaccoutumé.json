                    },
                    {
                        "form_id": "100d19fb-cff0-4186-82a0-09bc15207bec",
                        "entry_id": "fbe40316-5654-39aa-8f08-57c0a8577c15",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "inaccoutumées"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e2fe898c-331d-3ad5-83c6-2aad3d94fbb6",
                        "entry_id": "fbe40316-5654-39aa-8f08-57c0a8577c15",
                        "glosses": [
                            "Qui n’a pas coutume de se faire, d’arriver."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "67089729-0c28-485a-becf-ad9d2f9539c3",
                                "sense_id": "e2fe898c-331d-3ad5-83c6-2aad3d94fbb6",
                                "text": "Le printemps s’y déclarait avec une force inaccoutumée."
                            },
                            {
                                "example_id": "defdf6af-0aa6-48d3-be48-9881c5663fad",
                                "sense_id": "e2fe898c-331d-3ad5-83c6-2aad3d94fbb6",
                                "text": "Il était évident que c’était pour moi qu'on avait fait cette illumination inaccoutumée."
                            },
                            {
                                "example_id": "a7acd3ab-0634-4910-9510-e4b695c7439a",
                                "sense_id": "e2fe898c-331d-3ad5-83c6-2aad3d94fbb6",
                                "text": "En épouse inaccoutumée aux artifices des séductions, elle ne remuait pas un pli de son manteau, de peur que les parfums de son corps ne se perdissent au souffle du geste."
                            },
                            {
                                "example_id": "74872893-845c-4448-b8f6-3c6626dffa17",
                                "sense_id": "e2fe898c-331d-3ad5-83c6-2aad3d94fbb6",
                                "text": "Et un grand coiffeur avait donné à ses cheveux un pli inaccoutumé qui transformait le visage."
                            },
                            {
                                "example_id": "f15737b1-0bba-41b8-8e72-08721c324f24",
                                "sense_id": "e2fe898c-331d-3ad5-83c6-2aad3d94fbb6",
                                "text": "Tout en mangeant, je riais, plaisantais, je faisais même de l’esprit, ce qui chez moi, d’ordinaire sérieux et méditatif, semblait un trait inaccoutumé."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e51119ec-bc37-49b9-b9f2-7330a9e2683a",
                        "source_entry_id": "fbe40316-5654-39aa-8f08-57c0a8577c15",
                        "source_sense_id": "e2fe898c-331d-3ad5-83c6-2aad3d94fbb6",
                        "target_lang_word": "unaccustomed",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unaccustomed",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e4c7d329-9be3-3085-9fca-c0385205b0fb",
                                        "entry_id": "2ac89861-a21b-3fba-9ff1-bda97420f305",
                                        "glosses": [
                                            "Not used to an event or thing, not accustomed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "293bdd1d-56df-4fc4-a369-b1ee44b96fe0",
                                                "sense_id": "e4c7d329-9be3-3085-9fca-c0385205b0fb",
                                                "text": "He is unaccustomed to the cold."
                                            },
                                            {
                                                "example_id": "c9847a51-8dbc-418e-9604-54a64d45f5da",
                                                "sense_id": "e4c7d329-9be3-3085-9fca-c0385205b0fb",
                                                "text": "[…] I again conveyed his Key into his Pocket, and counterfeiting Sleep, tho’ I never once cloſed my Eyes, lay in Bed till after he aroſe and went to Prayers, an Exerciſe to which I had long been unaccuſtomed."
                                            },
                                            {
                                                "example_id": "78bc7467-21b0-4298-a823-48e03134e242",
                                                "sense_id": "e4c7d329-9be3-3085-9fca-c0385205b0fb",
                                                "text": "“Do Veniam,” said his Superior; and the old man seized, with a trembling hand, a beverage to which he had been long unaccustomed, drained the cup with protracted delight, as if dwelling on the flavour and perfume, and set it down with a melancholy smile and shake of the head, as if bidding adieu in future to such delicious potations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "748db0c8-c1ff-3f65-8cb0-a5fa831813b4",
                                        "entry_id": "2ac89861-a21b-3fba-9ff1-bda97420f305",
                                        "glosses": [
                                            "To which one is not accustomed, unfamiliar"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a838bdd2-7bf0-446a-b00d-8cf34079df3d",
                                                "sense_id": "748db0c8-c1ff-3f65-8cb0-a5fa831813b4",
                                                "text": "Guerrilla warfare opens a field of activity for every local capacity, forces the enemy into an unaccustomed method of battle, avoids the evil consequences of a great defeat, secures the national war from the risk of treason, and has the advantage of not confining it within any defined and determinate basis of operations."
                                            },
                                            {
                                                "example_id": "abc73dd7-685e-4cb1-9689-c365fedb3cf2",
                                                "sense_id": "748db0c8-c1ff-3f65-8cb0-a5fa831813b4",
                                                "text": "He stood transfixed before the unaccustomed view of London at night time, a vast panorama which reminded him […] of some wood engravings far off and magical, in a printshop in his childhood."
                                            },
                                            {
                                                "example_id": "57db5729-68a2-4d83-ba31-1821726f8a69",
                                                "sense_id": "748db0c8-c1ff-3f65-8cb0-a5fa831813b4",
                                                "text": "Later that day, whether from the accumulated effect of seeing hunger, from the unaccustomed food or from the sun, I get sick."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "unaccustomed",
                                "target_lang_code": "en",
                                "target_senses": [
