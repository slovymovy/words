                                    {
                                        "sense_id": "2f5456a7-3693-3554-a640-5565bcb541f4",
                                        "entry_id": "79ad4069-ca9d-3c8c-b876-fe52c95834c2",
                                        "glosses": [
                                            "tudo o que se opõe, impede ou faz parar"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12d726d8-38c8-4fe3-a08a-598a05a7b483",
                                                "sense_id": "2f5456a7-3693-3554-a640-5565bcb541f4",
                                                "text": "A cada obstáculo que encontramos, devemos mudar o curso de nossas vidas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "63e11dd4-58f0-37ec-b24f-cdd91c4dcf8a",
                                        "entry_id": "79ad4069-ca9d-3c8c-b876-fe52c95834c2",
                                        "glosses": [
                                            "estorvo"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "716b3a13-91a5-4e9f-8bc2-0fbb93071f10",
                                                "sense_id": "63e11dd4-58f0-37ec-b24f-cdd91c4dcf8a",
                                                "text": "A falta de dinheiro é um enorme obstáculo na vida de qualquer pessoa."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "52927196-6bdd-3788-b8b6-c082ca847f06",
                                        "entry_id": "79ad4069-ca9d-3c8c-b876-fe52c95834c2",
                                        "glosses": [
                                            "oposição"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "18e15ac2-382e-4f9b-a8a4-370562d4e182",
                                                "sense_id": "52927196-6bdd-3788-b8b6-c082ca847f06",
                                                "text": "A ciência quase sempre encontra obstáculo da igreja ao anunciar determinadas descobertas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "95637827-b7f7-39e6-a730-89568fea3aba",
                                        "entry_id": "79ad4069-ca9d-3c8c-b876-fe52c95834c2",
                                        "glosses": [
                                            "dificuldade"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55b70801-3f72-41d6-8a16-d7b0a5e05dd1",
                                                "sense_id": "95637827-b7f7-39e6-a730-89568fea3aba",
                                                "text": "Para cada obstáculo encarado, uma medalha de coragem no peito."
                                            }
                                        ]
                                    }
                                ]
