                                                "example_id": "25d3919c-0216-414a-8bc5-2b8e522a8cae",
                                                "sense_id": "79dd97f3-1730-3402-9308-54a4bd50bcc2",
                                                "text": "La cancérologie ou oncologie est une science particulière qui, par sa composante cellulaire, touche à tous les domaines, de l’embryologie à la thérapeutique, faisant appel à toutes les techniques diagnostiques et thérapeutiques."
                                            },
                                            {
                                                "example_id": "ec5a12b4-bbed-4d82-ae50-a2a705ba8e5d",
                                                "sense_id": "79dd97f3-1730-3402-9308-54a4bd50bcc2",
                                                "text": "Parce qu’en oncologie, tout est long. Très long. La patience, elle s’apprend là."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
