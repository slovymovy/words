                "senses": [
                    {
                        "sense_id": "44f0fc4a-c136-3aba-8a2d-d3d069743941",
                        "entry_id": "97ce76f5-fd05-37d5-ba4a-d5433f8b38dd",
                        "glosses": [
                            "Handlung mit mangelnder Sorgfalt, auch deren Ursache und Ergebnis"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf44aae1-e653-4f80-8de5-04f588ea896d",
                                "sense_id": "44f0fc4a-c136-3aba-8a2d-d3d069743941",
                                "text": "„Grund für den Unfall war eine Unachtsamkeit des Fahrers, teilen nun Staatsanwaltschaft und Polizei mit.“"
                            },
                            {
                                "example_id": "9e2c6509-1a0d-42ba-8905-e2ebd9ed4d36",
                                "sense_id": "44f0fc4a-c136-3aba-8a2d-d3d069743941",
                                "text": "„Jede Art von Unachtsamkeit kann die Ursache für Unglücke, Missgeschicke, falsche Lebensführung, Verletzung und Missachtung von Regeln und Gesetzen werden.“"
                            },
                            {
                                "example_id": "554599d0-fe71-4748-9ef3-70d0495a3c60",
                                "sense_id": "44f0fc4a-c136-3aba-8a2d-d3d069743941",
                                "text": "„Schon die Unachtsamkeit eines einzigen Mannes beim Pfeiferauchen konnte einen Brand auslösen, von dem Übermut der Siegesfeiern, bei denen sich Wodka und französischer Wein mischten, ganz zu schweigen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "63a8f698-f933-4f2b-a726-ed368c323c4c",
                        "source_entry_id": "97ce76f5-fd05-37d5-ba4a-d5433f8b38dd",
                        "source_sense_id": "44f0fc4a-c136-3aba-8a2d-d3d069743941",
                        "source_sense_description": "Handlung mit mangelnder Sorgfalt, auch deren Ursache und Ergebnis",
                        "target_lang_word": "carelessness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "carelessness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c7ffb173-b3be-3f09-9b1d-991540e3e154",
                                        "entry_id": "9c5922f0-3156-3bf5-a708-0becd10bad34",
                                        "glosses": [
                                            "Lack of care; the state or quality of being careless."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "85f118fc-1bea-4103-a803-4d6c11bfa708",
                                                "sense_id": "c7ffb173-b3be-3f09-9b1d-991540e3e154",
                                                "text": "This accident was caused by carelessness."
                                            },
                                            {
                                                "example_id": "b499bc2f-2998-4cf9-882e-a837f25310de",
                                                "sense_id": "c7ffb173-b3be-3f09-9b1d-991540e3e154",
                                                "text": "There were, however, 34 deaths among passengers in movement accidents, due mainly to misadventure and carelessness when entering and leaving trains in motion, falling off platforms and out of carriages, and opening and closing carriage doors."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
