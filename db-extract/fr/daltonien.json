                "translations": [
                    {
                        "translation_id": "68261dbb-e6b3-4a81-a71e-e2fd2317206d",
                        "source_entry_id": "66622c3e-a66a-37cc-b898-feaeff13a7a5",
                        "source_sense_id": "f2c3bd09-7f3a-369e-b012-c836747f1037",
                        "target_lang_word": "color blind",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "color blind",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "112bb039-9281-3fb3-a26a-6ae245a859af",
                                        "entry_id": "75d73e6e-a909-39b7-a173-30fa469b9299",
                                        "glosses": [
                                            "Unable to distinguish between two or more primary colors (usually red and green)."
                                        ],
                                        "tags": [
                                            "of a person or animal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "40804c9c-72eb-31d9-924a-1ec1e35b17bf",
                                        "entry_id": "75d73e6e-a909-39b7-a173-30fa469b9299",
                                        "glosses": [
                                            "Holding no prejudice based on skin color or race; not paying attention to skin color."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f180979b-6933-46fc-bda9-1d0bf95decce",
                                                "sense_id": "40804c9c-72eb-31d9-924a-1ec1e35b17bf",
                                                "text": "Because mass incarceration is officially colorblind, it seems inconceivable that the system could function much like a racial caste system."
                                            },
                                            {
                                                "example_id": "92b22187-2d64-4bdb-9770-a5d2e1842a62",
                                                "sense_id": "40804c9c-72eb-31d9-924a-1ec1e35b17bf",
                                                "text": "MAHER: Well, whatever. I just said we shouldn't have two national anthems. We're one country. It's not a good idea. We've seen what happens in other countries where you have, you know- when you separate things out. That's never where America was. That's never where liberalism was. It was about being a colorblind society.[…]"
                                            },
                                            {
                                                "example_id": "ef735e8f-f3af-40d5-9293-d912d45ce10c",
                                                "sense_id": "40804c9c-72eb-31d9-924a-1ec1e35b17bf",
                                                "text": "Don Demel[…] said his parents had raised him “colorblind.” But the reason for the discontent was clear: Other white people in Fort Bend “did not like certain people coming here,” he said. “It’s race. They are old-school.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
