                                                "example_id": "724e8127-1aeb-4d70-a164-794c1d0ca08e",
                                                "sense_id": "7f4a92dd-5dea-3008-b224-90ff1fd1cbfe",
                                                "text": "Wir sind heute Abend bei den Valentin eingeladen."
                                            },
                                            {
                                                "example_id": "96826b49-a9ea-4d5d-94eb-8cab2e9fb210",
                                                "sense_id": "7f4a92dd-5dea-3008-b224-90ff1fd1cbfe",
                                                "text": "Die Valentins von nebenan haben wieder die ganze Nacht laut gefeiert."
                                            },
                                            {
                                                "example_id": "a3b41ba7-1617-453f-ace9-c182a26aa873",
                                                "sense_id": "7f4a92dd-5dea-3008-b224-90ff1fd1cbfe",
                                                "text": "Der kleine Valentin kommt nun in den Kindergarten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
