                ],
                "senses": [
                    {
                        "sense_id": "a65a0536-f8da-3d9d-bcb1-0638c00b8664",
                        "entry_id": "268f715b-fc6a-3c34-8a13-a58f40b65e3c",
                        "glosses": [
                            "unterhaltsamer Plauderer"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "d0c1f7ce-cd0b-4724-80f8-2a8e95f1714a",
                                "sense_id": "a65a0536-f8da-3d9d-bcb1-0638c00b8664",
                                "text": "Er zeigte sich als charmanter Causeur und stand — ohne sich aufzudrängen — im Mittelpunkt der Feier."
                            },
                            {
                                "example_id": "477439f1-8b6b-4133-b863-1ccd4ef9c1a4",
                                "sense_id": "a65a0536-f8da-3d9d-bcb1-0638c00b8664",
                                "text": "„Gleich bei seinem Eintritt waren sich alle darüber klar, daß er sich heute in der ungnädigsten Stimmung befand - der strahlende Causeur vom vorigen Abend war nicht wiederzuerkennen.“"
                            },
                            {
                                "example_id": "35388602-a2f5-47bd-b3c9-9c4c76c64722",
                                "sense_id": "a65a0536-f8da-3d9d-bcb1-0638c00b8664",
                                "text": "„Der beste Reisekamerad ist Alexandre Desvachez, ein Cellist, der im ganzen Fernen Osten konzertiert und damit ein kleines Vermögen gesammelt hat, ein aufgeschlossener, für alles interessierter Mann und nebenbei ein guter Causeur.“"
                            },
                            {
                                "example_id": "143d63a6-d832-46be-8907-221289e4e4bf",
                                "sense_id": "a65a0536-f8da-3d9d-bcb1-0638c00b8664",
                                "text": "„Als sein kleiner Neffe zu ihm kam, war der Abbé vierzig Jahre alt, der Stolz der Provence und des dortigen Adels, von erlesener Bildung und ein funkelnder Causeur.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8c8dd7c6-ba75-444f-b022-81ce22ed85cd",
                        "source_entry_id": "268f715b-fc6a-3c34-8a13-a58f40b65e3c",
                        "source_sense_id": "a65a0536-f8da-3d9d-bcb1-0638c00b8664",
                        "source_sense_description": "veraltend: unterhaltsamer Plauderer",
                        "target_lang_word": "causeur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "causeur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2747de5a-d88e-3dfe-9031-98436bfcf8b6",
                                        "entry_id": "8a9fd215-bdf6-3ef4-83a4-8377fbea1940",
                                        "glosses": [
                                            "Qui aime à causer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee85123e-5c26-4464-b076-ab8f47589e89",
                                                "sense_id": "2747de5a-d88e-3dfe-9031-98436bfcf8b6",
                                                "text": "… ; les chasseurs, gens peu causeurs de leur nature, croyant soupçonner sous les paroles embarrassées et les réticences du jeune homme, un secret qu’il désirait garder, …."
                                            },
                                            {
                                                "example_id": "38873baf-2424-4129-b27d-c635b3d4a30c",
                                                "sense_id": "2747de5a-d88e-3dfe-9031-98436bfcf8b6",
                                                "text": "Pendant les heures des repas nous fîmes connaissance, et bien vite, il me prit en amitié ; j’étais questionneur enragé, il était causeur ; nous devînmes inséparables. Dans la mine, où généralement on parle peu, on nous appela les bavards."
                                            },
                                            {
                                                "example_id": "9ebcd040-4af8-441f-8f47-18a68fd3adc8",
                                                "sense_id": "2747de5a-d88e-3dfe-9031-98436bfcf8b6",
                                                "text": "Écoutez, écoutez, sous les forêts profondes\nLa cigale causeuse a fini son refrain ;\nSeuls, les lourds chariots traînant les gerbes blondes,\nFont tinter dans le vent leurs clochettes d’airain."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "causeur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ab31ca39-5b7c-34d6-87e2-4c3cb0e352d3",
                                        "entry_id": "fe5515e8-2282-311c-b2a1-f6507bc1db3c",
                                        "glosses": [
                                            "Personne qui parle, qui cause."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2362b98c-1368-4a2f-b25f-09b71272a95b",
                                                "sense_id": "ab31ca39-5b7c-34d6-87e2-4c3cb0e352d3",
                                                "text": "Une très-jeune et belle personne, tenant un grand éventail comme un sceptre, et entourée de dix jeunes gens, entra dans leur petit salon retiré, avec sa cour brillante, qu’elle dirigeait comme une reine, et acheva de mettre en déroute les studieux causeurs."
                                            },
                                            {
                                                "example_id": "c8498e77-543f-4113-a324-4809ad8b9a97",
                                                "sense_id": "ab31ca39-5b7c-34d6-87e2-4c3cb0e352d3",
                                                "text": "Madame Pinglet. — Le fait est qu’on ne peut pas être plus hospitalier qu’il ne l’a été !… il nous a logés, hébergés, pendant quinze jours !…\nPinglet. — Et c’était lui encore qui avait l’air d’être notre obligé !\nMadame Pinglet. — C’est-à-dire qu’il était chez nous chez lui… et aimable, brillant causeur…\nPinglet. — Dame, un avocat, s’il n’était pas brillant causeur !…"
                                            },
                                            {
                                                "example_id": "c4853319-4abf-423f-8dbf-3af11a1faad3",
                                                "sense_id": "ab31ca39-5b7c-34d6-87e2-4c3cb0e352d3",
                                                "text": "Si je demandais : « Connaissez-vous les Guermantes ? », Legrandin le causeur répondait : « Non, je n’ai jamais voulu les connaître. »"
                                            },
                                            {
                                                "example_id": "26846bd0-1f66-489b-a07e-991f8b158dd0",
                                                "sense_id": "ab31ca39-5b7c-34d6-87e2-4c3cb0e352d3",
                                                "text": "Faites taire ces causeurs."
                                            },
                                            {
                                                "example_id": "15d0e7f1-76c7-4a33-9893-e3cd1d736f4f",
                                                "sense_id": "ab31ca39-5b7c-34d6-87e2-4c3cb0e352d3",
                                                "text": "Insupportable causeur."
                                            },
                                            {
                                                "example_id": "965db655-321b-4015-ad2d-308160cd470a",
                                                "sense_id": "ab31ca39-5b7c-34d6-87e2-4c3cb0e352d3",
                                                "text": "Ce vieillard est un aimable causeur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4e92947c-afd8-3843-93f3-718be981255f",
                                        "entry_id": "fe5515e8-2282-311c-b2a1-f6507bc1db3c",
                                        "glosses": [
                                            "Celui qui fait une causerie, un exposé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a81de56-7293-4c75-9257-02ca205ffa1c",
                                                "sense_id": "4e92947c-afd8-3843-93f3-718be981255f",
                                                "text": "Le groupe qui le suit est assez mince : une dizaine de personnes, de couples qui ne se connaissent pas et gardent entre eux une distance un peu gênée dans les moments où il faut faire cercle autour du causeur."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
