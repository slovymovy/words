                        "glosses": [
                            "Celui qui fabrique ou pose des parquets."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9eeb9dd3-8ecc-4c0b-a28f-be42ef104df9",
                                "sense_id": "69c1e9c1-75e1-3b61-8b5c-6d29e371fd01",
                                "text": "Si on était le fils ou le neveu d’un parqueteur, ça allait tout seul, mais si en plus, comme moi, on avait appris un autre métier !"
                            },
                            {
                                "example_id": "a2eb3328-70fb-4018-8476-7c5b942d3717",
                                "sense_id": "69c1e9c1-75e1-3b61-8b5c-6d29e371fd01",
                                "text": "— Couvert et Lucas, menuisiers parqueteurs à Bruxelles, ont poussé l’art de la parqueterie à un point qu’aucun pays voisin n’a pu encore atteindre."
                            }
                        ]
                    }
