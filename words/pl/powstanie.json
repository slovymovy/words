        "powstaniowy"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "77ed91af-d7e8-3cbe-8da1-5f4fcfbd4dab",
                    "sense_definition": "zbrojne wystąpienie ludności państwa, miasta lub regionu skierowane przeciwko dotychczasowej władzy lub okupantowi",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "uprising_event",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wybuchło <w>powstanie</w> przeciwko rządom okrutnego dyktatora.",
                            "target_lang_translations": {
                                "ru": "Вспыхнуло <w>восстание</w> против правления жестокого диктатора.",
                                "en": "An <w>uprising</w> broke out against the rule of the cruel dictator."
                            }
                        },
                        {
                            "text": "Każdego roku uroczyście obchodzimy rocznicę wybuchu <w>powstania</w>.",
                            "target_lang_translations": {
                                "ru": "Каждый год мы торжественно отмечаем годовщину начала <w>восстания</w>.",
                                "en": "Every year we solemnly commemorate the anniversary of the outbreak of the <w>uprising</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "zryw",
                        "rebelia"
                    ],
                    "common_phrases": [
                        "wybuch powstania",
                        "powstanie warszawskie",
                        "stłumić powstanie",
                        "upadek powstania"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вооруженное выступление населения государства, города или региона против существующей власти или оккупанта",
                        "en": "an armed revolt of a population or region against the ruling government or an occupier"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "восстание",
                                "target_lang_sense_clarification": "вооруженное выступление"
                            },
                            {
                                "target_lang_word": "мятеж",
                                "target_lang_sense_clarification": "бунт, неповиновение"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "uprising",
                                "target_lang_sense_clarification": "popular armed revolt"
                            },
                            {
                                "target_lang_word": "insurrection",
                                "target_lang_sense_clarification": "violent rising against authority"
                            },
                            {
                                "target_lang_word": "rebellion",
                                "target_lang_sense_clarification": "resistance or revolt"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "10f9b195-769d-3ce9-a34f-7ea72eae9c62",
                    "sense_definition": "proces tworzenia się czegoś lub moment, w którym coś zaczyna istnieć; rzeczownik odczasownikowy od <w>powstać</w>",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "creation_process",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Powstanie</w> tej organizacji zmieniło sytuację polityczną w regionie.",
                            "target_lang_translations": {
                                "ru": "<w>Создание</w> этой организации изменило политическую ситуацию в регионе.",
                                "en": "The <w>creation</w> of this organization changed the political situation in the region."
                            }
                        },
                        {
                            "text": "Naukowcy wciąż badają <w>powstanie</w> życia na naszej planecie.",
                            "target_lang_translations": {
                                "ru": "Ученые до сих пор изучают <w>возникновение</w> жизни на нашей планете.",
                                "en": "Scientists are still studying the <w>origin</w> of life on our planet."
                            }
                        }
                    ],
                    "common_phrases": [
                        "powstanie świata",
                        "powstanie państwa",
                        "powstanie życia"
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс создания чего-либо или момент, когда что-то начинает существовать; отглагольное существительное от <w>powstać</w>",
                        "en": "the process of creation or the emergence and coming into existence of something; verbal noun from powstać"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "возникновение",
                                "target_lang_sense_clarification": "появление, зарождение"
                            },
                            {
                                "target_lang_word": "образование",
                                "target_lang_sense_clarification": "формирование"
                            },
                            {
                                "target_lang_word": "создание",
                                "target_lang_sense_clarification": "творение, основание"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "emergence",
                                "target_lang_sense_clarification": "coming into being or prominence"
                            },
                            {
