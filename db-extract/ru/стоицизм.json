                                "target_senses": [
                                    {
                                        "sense_id": "3949d6cf-7594-3f7e-8bc9-a3e896b6579a",
                                        "entry_id": "8bfec4b2-8884-3540-a1c7-301975c345a0",
                                        "glosses": [
                                            "corrente filosofica, prevede autocontrollo e distacco dalle cose terrene, si estremizza nell'ideale dell'atarassia, come mezzo per raggiungere l'integrità morale e intellettuale"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04d4e54a-b99a-4628-a6d0-bbbbd809be77",
                                                "sense_id": "3949d6cf-7594-3f7e-8bc9-a3e896b6579a",
                                                "text": "lo stoicismo fu fondato da Zenone"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "56effb2d-2114-3e75-8041-d59b48c89900",
                                        "entry_id": "8bfec4b2-8884-3540-a1c7-301975c345a0",
                                        "glosses": [
                                            "definizione mancante; se vuoi, aggiungila tu"
                                        ],
