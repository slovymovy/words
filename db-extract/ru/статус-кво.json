                "translations": [
                    {
                        "translation_id": "e84ab730-4e31-45f9-a7a4-6fbf8d5eca2e",
                        "source_entry_id": "f85b9cd9-edce-34d3-a26d-2bbedb0c6f03",
                        "source_sense_id": "78111ea2-4b14-38c3-8210-b7e59a23c3a8",
                        "source_sense_description": "Status quo",
                        "target_lang_word": "Status quo",
