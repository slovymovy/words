                ],
                "senses": [
                    {
                        "sense_id": "98a76afe-d2d1-3cc3-9f5b-973aa775c5fd",
                        "entry_id": "3f11d042-97df-3229-948c-98804a74514c",
                        "glosses": [
                            "металл. связанный с процессом изготовления труб путём отливки; предназначенный для изготовления таких труб"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d3b0dd3-13e0-4914-ad30-7de49a358129",
                                "sense_id": "98a76afe-d2d1-3cc3-9f5b-973aa775c5fd",
                                "text": "Начальству было угодно взвалить на меня ответственность за выпуск труб, в частности за труболитейную машину."
                            },
                            {
                                "example_id": "b17f6aef-eabd-48c7-a07e-1dd19351a05f",
                                "sense_id": "98a76afe-d2d1-3cc3-9f5b-973aa775c5fd",
                                "text": "Тогда Асе шел девятнадцатый год. Она работала табельщицей на труболитейном заводе и по вечерам ходила в клуб петь."
                            }
                        ]
                    }
