        "nl-extract.jsonl": [
            {
                "entry_id": "9b93feca-12a3-37f7-9651-eba4f6c4ac38",
                "word": "afhaspelen",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "a3b9a0b3-87a0-3cb7-b91d-a38bb8e26d02",
                        "entry_id": "9b93feca-12a3-37f7-9651-eba4f6c4ac38",
                        "glosses": [
                            "draad die ergens omheen gedraaid is weer losmaken met een draaiende of rollende beweging"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "53fce5ee-c62a-45fd-a93e-8bc9eef9b151",
                                "sense_id": "a3b9a0b3-87a0-3cb7-b91d-a38bb8e26d02",
                                "text": "Er zijn ook allerhande attributen te zien die te pas kwamen aan de teelt van de zijderupsen, het afhaspelen van de cocons, het twijnen (ineendraaien) van de draden, het spinnen van het cocon-afval en uiteindelijk het weven."
                            }
                        ]
                    },
                    {
                        "sense_id": "8e459eec-99de-3a4e-b8f3-9b4fe0fded78",
                        "entry_id": "9b93feca-12a3-37f7-9651-eba4f6c4ac38",
                        "glosses": [
                            "op een snelle slordige manier voltooien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "083bd89c-4663-4006-a4c3-e2f2c4c4bfa9",
                                "sense_id": "8e459eec-99de-3a4e-b8f3-9b4fe0fded78",
                                "text": "De landskampioen is de enige Belgische vertegenwoordiger op het kampioenenbal. Vicekampioen en bekerwinnaar Standard sneuvelde in de derde voorronde tegen Ajax en werd daardoor veroordeeld tot de Europa League. Club was als Belgisch landskampioen rechtstreeks geplaatst voor de groepsfase en moest dus geen voorrondes afhaspelen."
                            }
                        ]
                    }
                ],
