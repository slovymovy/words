                        "glosses": [
                            "To regard something as ideal."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "ba27cacc-bf98-3756-be0a-1304a57dd9ce",
                        "entry_id": "ceb1cf0c-19a2-301f-9d8b-68ac0c3190ea",
                        "glosses": [
                            "To conceive or form an ideal."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "f1e82b51-8d02-4899-8a64-2a152fc72b63",
                                "sense_id": "ba27cacc-bf98-3756-be0a-1304a57dd9ce",
                                "text": "People tell me that I wouldn't be so anxious for a lover if I knew the kinds of problems which such a relationship brings, to which I reply that, yes, perhaps I am idealizing somewhat, but basically I know that people aren't plastic, and that where there are human beings there are problems, and, all the same, I think it can be worth it in the long run if there is honesty on both sides."
                            }
                        ]
                    },
                    {
                        "sense_id": "fd5cba49-b590-3c15-8cb4-0622ff2f6175",
                        "entry_id": "ceb1cf0c-19a2-301f-9d8b-68ac0c3190ea",
                        "glosses": [
                            "To portray using idealization."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "784084fc-e17a-454f-94f5-81783248fc37",
                        "source_entry_id": "ceb1cf0c-19a2-301f-9d8b-68ac0c3190ea",
                        "source_sense_description": "transitive: to regard something as ideal",
                        "target_lang_word": "idealiseren",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "idealiseren",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "b39b86a6-bdac-3255-8101-cd34105b92b5",
                                        "entry_id": "24d0ad54-8caa-33d6-adcc-07dac1fead01",
                                        "glosses": [
                                            "iets gunstiger of zelfs als ideaal beoordelen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9ee5ee44-1029-4a20-a8c1-f8ad0279ab6d",
                                                "sense_id": "b39b86a6-bdac-3255-8101-cd34105b92b5",
                                                "text": "Je moet zo'n vervelende actie niet zo idealiseren!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "de1b535c-483d-4a69-8716-4b97feb954ee",
                        "source_entry_id": "ceb1cf0c-19a2-301f-9d8b-68ac0c3190ea",
                        "source_sense_description": "transitive: to regard something as ideal",
                        "target_lang_word": "idéaliser",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "idéaliser",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d408171e-a56e-3926-b256-7ea7f6a799ca",
                                        "entry_id": "fef15082-09ab-3b2a-bfb4-e2545d9dd3da",
                                        "glosses": [
                                            "Revêtir d’un caractère idéal une personne, une chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d25dfe44-96b7-40d8-8f26-1c0aa5b23f89",
                                                "sense_id": "d408171e-a56e-3926-b256-7ea7f6a799ca",
                                                "text": "Vous idéalisez trop cette personne."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3a050b87-0e39-4bec-adb1-d427940948ce",
                        "source_entry_id": "ceb1cf0c-19a2-301f-9d8b-68ac0c3190ea",
                        "source_sense_description": "transitive: to regard something as ideal",
                        "target_lang_word": "idealisieren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "idealisieren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a08e5936-93b0-32c1-b1e3-0b9ef5aad23c",
                                        "entry_id": "bff969c7-84c0-3d6e-a9eb-b4a2ffbb409b",
                                        "glosses": [
                                            "höher einschätzen oder darstellen, als der Realität entspricht"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b74473ce-83d4-44d8-8d56-82f51c8b7dcd",
                                                "sense_id": "a08e5936-93b0-32c1-b1e3-0b9ef5aad23c",
                                                "text": "Sie idealisieren Menschen, ohne sie näher zu kennen und glauben, dass diese immer gut, verfügbar und alles könnend sind."
                                            },
                                            {
                                                "example_id": "28320d2f-448d-418d-84e7-a5e09199b75a",
                                                "sense_id": "a08e5936-93b0-32c1-b1e3-0b9ef5aad23c",
                                                "text": "Sexualität wird idealisiert, moralisiert und politisiert."
                                            },
                                            {
                                                "example_id": "c48b5319-9042-4124-b5cb-3f1ec9468823",
                                                "sense_id": "a08e5936-93b0-32c1-b1e3-0b9ef5aad23c",
                                                "text": "Die Betroffenen haben ein grandioses Gefühl der eigenen Wichtigkeit, sie verlangen nach übermäßiger Bewunderung, sie idealisieren sich selbst und sind stark von Fantasien grenzenlosen Erfolgs, Macht, Glanz oder Schönheit eingenommen."
                                            },
                                            {
                                                "example_id": "bcc0d5ed-c4fd-4c85-95ae-03324d36cbf0",
                                                "sense_id": "a08e5936-93b0-32c1-b1e3-0b9ef5aad23c",
                                                "text": "Das zweite Profil bilden Jugendliche und junge Erwachsene, die gegen ihre Familie und Gesellschaft rebellieren. Sie idealisieren den Kampf im Jihad."
                                            },
                                            {
                                                "example_id": "985ddabf-59d4-4cef-a9fd-3ce303c816db",
                                                "sense_id": "a08e5936-93b0-32c1-b1e3-0b9ef5aad23c",
                                                "text": "Wenn die Kinder klein sind, dann idealisieren sie ihre Eltern. Doch „irgendwann schmeißen die Kinder die Eltern vom Podest“, sagt Reich-Klenke."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "98f4b01a-d887-4f8d-aa0c-abf9cfa8bc44",
                        "source_entry_id": "ceb1cf0c-19a2-301f-9d8b-68ac0c3190ea",
