                                                "sense_id": "35740d24-8389-3938-abf7-3fa40fde9965",
                                                "text": "the redevelopment of the hero's character in a comic book"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "93defa1e-435b-3486-a136-86e7fd527a76",
                                        "entry_id": "1ae9e03c-8536-394d-b7f7-6681b525f308",
                                        "glosses": [
                                            "The demolition of old, redundant or unfashionable buildings or infrastructure and the construction of new ones on the same site."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da40ba02-06a5-443c-8b67-d9a6456a09d7",
                                                "sense_id": "93defa1e-435b-3486-a136-86e7fd527a76",
                                                "text": "The government of New Zealand is looking for a crew to lead the redevelopment of its research headquarters in Antarctica.\nBuilt in the 1980s, the country’s Scott Base consists of 12 structures that officials want replaced by three large, interconnected buildings, plus a separate helicopter hangar."
                                            },
                                            {
                                                "example_id": "7af82b0d-df3f-4ced-b995-a601bb6b1c71",
                                                "sense_id": "93defa1e-435b-3486-a136-86e7fd527a76",
                                                "text": "HS2 Minister Andrew Stephenson added: \"This station will not only benefit the local community by enabling the comprehensive redevelopment of the area, but will serve as a transport superhub acting as a gateway to the Midlands and the North.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b072472c-27b4-4870-8fc6-b637ce936d4c",
