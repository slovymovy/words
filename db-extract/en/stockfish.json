                                            {
                                                "example_id": "cf116855-0207-49af-a034-c063990e826f",
                                                "sense_id": "1198594c-4fa0-3a20-8148-8da1bdb11dca",
                                                "text": "L'ESTOCAFICADA C'est la version nissarde du stoquefiche marseillais ou du stockfish des gens de l'Océan. — (Jean Paul Clébert, Provence, Éd. Nathan, 1986)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "adb94795-9e48-3259-ab8a-87e7373e3572",
                                        "entry_id": "a9662aad-746a-345d-9a8f-802fc7c4247a",
                                        "glosses": [
                                            "Personne très maigre."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "14cf3afe-b541-410a-b07e-49744434e905",
                                                "sense_id": "adb94795-9e48-3259-ab8a-87e7373e3572",
                                                "text": "Il m'a simplement avoué qu'il ne tenait pas à être mêlé aux problèmes de Frise-Poulet et du stoquefiche – c'était son terme – qui l'accompagnait."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c7227622-762a-4d89-8338-ae57b1826d4d",
                        "source_entry_id": "d76ba988-eea6-38e2-b97d-9a2af45bc1a8",
                        "source_sense_id": "3f028d95-576a-3b3d-8a1f-b2a406878fc3",
                        "source_sense_description": "cured fish",
                        "target_lang_word": "Stockfisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Stockfisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f42798d6-8223-3d27-b975-4e1daa574829",
                                        "entry_id": "ec9be8f9-8237-3dd2-b0fa-d80dbd4fe98a",
                                        "glosses": [
                                            "durch Trocknung haltbar gemachter Fisch, meist Kabeljau/Dorsch (gesalzen und getrocknet: Klippfisch)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "14ba6a08-b0ce-4b99-b033-2078b6f07b35",
                                                "sense_id": "f42798d6-8223-3d27-b975-4e1daa574829",
                                                "text": "„Es werden hauptsächlich zwei Sorten an Trockenfisch unterschieden: Stockfisch und Klippfisch. Stockfisch sind geköpfte, ungesalzene, paarweise an den Schwänzen zusammengebundene und auf Holzgestellen zum Trocknen aufgehängte Magerfische (z. B. Kabeljau und Seelachs).“"
                                            },
                                            {
                                                "example_id": "c20ae75f-18c5-44ff-9fc7-b16cb6128f95",
                                                "sense_id": "f42798d6-8223-3d27-b975-4e1daa574829",
                                                "text": "„Hering und Stockfisch waren neben Einbecker Bier, Schollen und Bückling die einzigen Nahrungsmittelexporte des hansischen Raums, die in Süddeutschland größeren Absatz fanden und so zur wirtschaftlichen Verflechtung der beiden Räume beitrugen.“"
                                            },
                                            {
                                                "example_id": "001ccd0e-a5e6-429b-8748-468df7232150",
                                                "sense_id": "f42798d6-8223-3d27-b975-4e1daa574829",
                                                "text": "„Während ich schlief, war er ausgegangen und hatte alles mögliche gekauft, alles in Papier gewickelt, Ei in Papier, Wurst in Papier, Stockfisch in Papier, Butter, Quark, Sahne, und ein recht großes Päckchen, das ich für Käse hielt.“"
                                            },
                                            {
                                                "example_id": "a394bda8-4b26-4545-9520-bae04c3f6073",
                                                "sense_id": "f42798d6-8223-3d27-b975-4e1daa574829",
                                                "text": "„Die Hanse hatte sogar beliebtes Fastfood à la McDonald's im Angebot: den Stockfisch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "504294fa-4711-313e-b19e-ec3970ccfefb",
                                        "entry_id": "ec9be8f9-8237-3dd2-b0fa-d80dbd4fe98a",
                                        "glosses": [
                                            "wortkarger, langweiliger Mensch"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52611b6a-35e1-4a45-b58c-f9233d38d89a",
                                                "sense_id": "504294fa-4711-313e-b19e-ec3970ccfefb",
                                                "text": "Durch seine Computersucht verlor er allmählich die Fähigkeit zur Interaktion und wurde so zum Stockfisch, der nie eine Partnerin fand."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
