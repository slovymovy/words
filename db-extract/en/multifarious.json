                                        "glosses": [
                                            "twee of meer"
                                        ],
                                        "tags": [
                                            "gevolgd door een meervoud"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "170c2b65-3017-40cd-8999-bf4815cb82c7",
                                                "sense_id": "05e2d9cc-927a-30a3-b4ac-e332f064716f",
                                                "text": "Ik heb je diverse keren proberen te bellen maar je nam niet op."
                                            }
                                        ]
