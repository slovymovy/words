                        "entry_id": "95903993-96ba-3642-a2ac-bccf4aab714f",
                        "glosses": [
                            "lebkuchenähnliches Gebäck, das zu mindestens 50 % aus Honig besteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "93243bfa-9ced-4fb4-85d5-bb6e9f4c570d",
                                "sense_id": "d7f08f6b-3a3d-377f-8aad-4108710286b1",
                                "text": "Honigkuchen ist eine Nürnberger Spezialität."
                            },
                            {
                                "example_id": "c4e4c637-f5f9-4805-b0cf-cbe8d0d55fee",
                                "sense_id": "d7f08f6b-3a3d-377f-8aad-4108710286b1",
                                "text": "„Da wurden Honigkuchen gebacken und Apfelstrudel, süße Rosinen- und Mandelfladen und allerlei Leckerbissen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
