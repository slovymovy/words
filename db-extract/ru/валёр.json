                "senses": [
                    {
                        "sense_id": "d801b9e7-d257-348f-b992-56de59f35ac4",
                        "entry_id": "c21eb513-fbf7-3bd1-bc62-b066a1e6b47c",
                        "glosses": [
                            "живоп. оттенок тона, который во взаимосвязи с другими оттенками выражает определённое соотношение света и тени"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d7f8ee2b-4616-4cdb-9e7f-be3682976d50",
                                "sense_id": "d801b9e7-d257-348f-b992-56de59f35ac4",
                                "text": "Чтобы подчеркнуть игру валёров, Тёрнер впервые отказался от традиционного грунта каштанового или золотистого цвета и использовал белый грунт, напоминавший основу для акварели, который позволил тонам звучать более ярко и в то же время дал возможность значительно высветлить палитру."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "147aa079-fa51-4900-840a-f211f6df19f4",
                        "source_entry_id": "c21eb513-fbf7-3bd1-bc62-b066a1e6b47c",
                        "source_sense_id": "d801b9e7-d257-348f-b992-56de59f35ac4",
                        "target_lang_word": "Valeur",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "9449008f-ca03-44bd-870a-6fa32e47648c",
                        "source_entry_id": "c21eb513-fbf7-3bd1-bc62-b066a1e6b47c",
                        "source_sense_id": "d801b9e7-d257-348f-b992-56de59f35ac4",
                        "target_lang_word": "valeur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "valeur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0150477f-a48b-30c6-ba78-35b5fc35fe74",
                                        "entry_id": "9be483ba-bd75-3570-934c-a16f91cafc62",
                                        "glosses": [
                                            "Qualité ou justesse d’une chose, d’une idée, d’un ouvrage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9e7ecf5-71c7-4896-a6b6-67fcf81e772a",
                                                "sense_id": "0150477f-a48b-30c6-ba78-35b5fc35fe74",
                                                "text": "Ainsi dans les premiers temps du reboisement, beaucoup de reboiseurs […] ne distinguaient pas la valeur forestière des différents sols. Ils ont eu bien des déboires […]."
                                            },
                                            {
                                                "example_id": "0b703c8f-0c8d-4cf4-90e5-7d74eaa7ceaa",
                                                "sense_id": "0150477f-a48b-30c6-ba78-35b5fc35fe74",
                                                "text": "Ils ont réalisé là un travail de grande valeur."
                                            },
                                            {
                                                "example_id": "258ca140-da1d-4f86-b5ce-7a9e8d749c03",
                                                "sense_id": "0150477f-a48b-30c6-ba78-35b5fc35fe74",
                                                "text": "Ce plan n’a aucune valeur, il ne peut pas fonctionner."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f718e259-05fa-3642-aa5b-56523fc216cd",
                                        "entry_id": "9be483ba-bd75-3570-934c-a16f91cafc62",
                                        "glosses": [
                                            "Noblesse de caractère d’une personne."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "04b821b2-74cc-407e-bdb9-66600197ad98",
                                                "sense_id": "f718e259-05fa-3642-aa5b-56523fc216cd",
                                                "text": "Un homme de valeur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d4beb999-1a6b-3289-961c-9213ea5c67ba",
                                        "entry_id": "9be483ba-bd75-3570-934c-a16f91cafc62",
                                        "glosses": [
                                            "Importance ou intérêt que l’on porte à un être, à une chose, à un phénomène ou événement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "afb2469b-f023-490c-96c6-0ca694fd1985",
                                                "sense_id": "d4beb999-1a6b-3289-961c-9213ea5c67ba",
                                                "text": "Ce bibelot, cette relation, ce souvenir, a beaucoup de valeur à mes yeux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ed40450e-1843-3368-bfc6-e4c9b9390606",
                                        "entry_id": "9be483ba-bd75-3570-934c-a16f91cafc62",
                                        "glosses": [
                                            "Prix."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd81ab4d-64ab-4231-945c-1e853a8b8b5d",
                                                "sense_id": "ed40450e-1843-3368-bfc6-e4c9b9390606",
                                                "text": "Mais ces belles futaies représentent une valeur commerciale qui a mis en appétit la convoitise du spéculateur, déjà riche de capital, plus riche encore en audace et en influence."
                                            },
                                            {
                                                "example_id": "3ee2019f-6e15-46fc-a720-498ffaa3b09f",
                                                "sense_id": "ed40450e-1843-3368-bfc6-e4c9b9390606",
                                                "text": "[…]; le système monétaire et le système du crédit reposent sur une vaine tradition de la valeur de l’or et offrent une instabilité presque fantastique."
                                            },
                                            {
                                                "example_id": "188a49d9-91ae-48fb-9733-f391cdc03246",
                                                "sense_id": "ed40450e-1843-3368-bfc6-e4c9b9390606",
                                                "text": "Karl Kraus « démasque la société à l’aide de la langue », écrit le philosophe et sociologue Max Horkheimer, car « c’est le massacre des mots et des phrases qui lui révèle la déshumanisation des hommes et des relations entre eux, la destruction de l’esprit par la valeur marchande »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "497d5f1f-96c9-3b43-98c0-d514155a7534",
                                        "entry_id": "9be483ba-bd75-3570-934c-a16f91cafc62",
                                        "glosses": [
                                            "Prix que l’on attache à une chose intellectuelle ou morale."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ae0d94ae-fca2-4f08-8283-5a05189a13d5",
                                                "sense_id": "497d5f1f-96c9-3b43-98c0-d514155a7534",
                                                "text": "Cet ouvrage a peu de valeur."
                                            },
                                            {
                                                "example_id": "96ba0953-64bd-4b15-aeeb-5141773fd461",
                                                "sense_id": "497d5f1f-96c9-3b43-98c0-d514155a7534",
                                                "text": "Donner de la valeur à ce qu’on dit : Ajouter de la force ou de la grâce à un discours par la manière de le débiter."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6c1d2da8-1a3c-3d96-8452-46821f61e51a",
                                        "entry_id": "9be483ba-bd75-3570-934c-a16f91cafc62",
                                        "glosses": [
                                            "Titre, action, obligation, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f38b3c1b-bdb3-4ef9-a9d8-248ed05c42ce",
                                                "sense_id": "6c1d2da8-1a3c-3d96-8452-46821f61e51a",
                                                "text": "Valeurs mobilières de placement."
                                            },
                                            {
                                                "example_id": "15e80e91-e369-4b80-b610-64de28192ab5",
                                                "sense_id": "6c1d2da8-1a3c-3d96-8452-46821f61e51a",
                                                "text": "Valeurs cotées à la bourse, en bourse."
                                            },
                                            {
                                                "example_id": "a3065a76-f6f0-4cca-a893-c7c5ade074f2",
                                                "sense_id": "6c1d2da8-1a3c-3d96-8452-46821f61e51a",
                                                "text": "Cette valeur n’est pas négociable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "139fdc8e-2e9c-3621-85cc-b43a156799f1",
                                        "entry_id": "9be483ba-bd75-3570-934c-a16f91cafc62",
                                        "glosses": [
                                            "Idéologie ou règle morale d’une personne ou d’un groupe."
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4bd28f83-476b-4f7d-a90f-b8b58317bd8c",
                                                "sense_id": "139fdc8e-2e9c-3621-85cc-b43a156799f1",
                                                "text": "Le statut d’entrepreneur individuel spécialisé dans la chnouf semble en contradiction avec une vocation de pédagogue se destinant à enseigner les valeurs du sport. À moins de se spécialiser dans le cyclisme."
                                            },
                                            {
                                                "example_id": "2de6ddc6-6b8e-4ea8-90c8-4f9758848197",
                                                "sense_id": "139fdc8e-2e9c-3621-85cc-b43a156799f1",
                                                "text": "Pauvre Bill. En plus de la gêne occasionnée par la découverte que sa femme était une coureuse de jupons, il lui fallait limiter les dégâts sur sa propre carrière politique en campant sur une position ferme concernant les valeurs familiales."
                                            },
                                            {
                                                "example_id": "75fbd0c3-ccf4-47af-a8fb-86dbbc096cb1",
                                                "sense_id": "139fdc8e-2e9c-3621-85cc-b43a156799f1",
                                                "text": "Je n'irais pas jusqu'à dire que je suis l'incarnation de la vertu ou la réincarnation de Robin des Bois, mais j'ai des valeurs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d04e0041-e28d-3323-a2d6-4d3429539044",
                                        "entry_id": "9be483ba-bd75-3570-934c-a16f91cafc62",
                                        "glosses": [
                                            "Juste signification des termes, suivant l’usage reçu."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8cb817b9-9997-4ad2-adbb-63e94c35a766",
                                                "sense_id": "d04e0041-e28d-3323-a2d6-4d3429539044",
                                                "text": "Cet homme ne connaît pas, ne sait pas la valeur des termes dont il se sert."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e91fefbb-4dc0-3143-b43c-83a643053186",
                                        "entry_id": "9be483ba-bd75-3570-934c-a16f91cafc62",
                                        "glosses": [
                                            "L’amplitude lumineuse définissant la couleur (Voir WP)"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0906c3e9-d618-31fb-9f5c-16d2796e3d27",
                                        "entry_id": "9be483ba-bd75-3570-934c-a16f91cafc62",
                                        "glosses": [
                                            "Mesure d’une grandeur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16275884-3a71-4320-b16e-c39876b13216",
                                                "sense_id": "0906c3e9-d618-31fb-9f5c-16d2796e3d27",
                                                "text": "f(x) : valeur de la fonction f au point x."
                                            },
                                            {
                                                "example_id": "cd7ee3f2-2fb7-4e5e-82bd-34986a6f3b9c",
                                                "sense_id": "0906c3e9-d618-31fb-9f5c-16d2796e3d27",
                                                "text": "̄OM valeur algébrique de OM."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a681d6c7-7a7e-3c4f-ae3f-890e87989b43",
                                        "entry_id": "9be483ba-bd75-3570-934c-a16f91cafc62",
                                        "glosses": [
                                            "Expression quantitative d’une grandeur, constituée d’un nombre – la valeur numérique – et d’une référence."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f05bb496-024c-4480-9b6d-465eb5263098",
                                                "sense_id": "a681d6c7-7a7e-3c4f-ae3f-890e87989b43",
                                                "text": "L’abaque figuré ici comprend toutes les valeurs utiles pour n et D ; mais on a limité le graphique aux cotes comprises entre 100 et 200 millimètres pour T et F, valeurs d'ailleurs très usuelles ; […]."
                                            },
                                            {
                                                "example_id": "11da6b3f-e14a-425f-a8ae-2aea0212ae3e",
                                                "sense_id": "a681d6c7-7a7e-3c4f-ae3f-890e87989b43",
                                                "text": "Dans le SI, la valeur d’une grandeur est généralement exprimée comme le produit algébrique d’un nombre et d’une unité de mesure. Certaines grandeurs dites sans dimension n’ont pas d’unité et peuvent être quantifiées par leur seule valeur numérique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d906098a-64d6-34d2-a161-234dd65b2f28",
                                        "entry_id": "9be483ba-bd75-3570-934c-a16f91cafc62",
                                        "glosses": [
                                            "Contenu d’une variable ou d’une constante"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40a2ec29-5d41-4b10-a288-99649548f38f",
                                                "sense_id": "d906098a-64d6-34d2-a161-234dd65b2f28",
                                                "text": "les instructions d’affectation permettent de donner des valeurs aux variables."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa0b1429-e6f9-30ad-9c95-a9580ee8afb2",
                                        "entry_id": "9be483ba-bd75-3570-934c-a16f91cafc62",
                                        "glosses": [
                                            "Durée d’une note ou d’un silence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fee805d5-5859-42f5-9ab9-73af6872c86b",
                                                "sense_id": "aa0b1429-e6f9-30ad-9c95-a9580ee8afb2",
                                                "text": "La valeur d’une blanche est le double de la valeur d’une noire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ee935634-793e-3463-bb53-518f2d3a9dee",
                                        "entry_id": "9be483ba-bd75-3570-934c-a16f91cafc62",
                                        "glosses": [
                                            "Bravoure, mérite, vaillance, vertu guerrière."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa8c555c-aa9d-44bb-8c1c-6f2a040a8ce9",
                                                "sense_id": "ee935634-793e-3463-bb53-518f2d3a9dee",
                                                "text": "Lorsque dans une armée le besoin de récompenses se fait très vivement sentir, on peut affirmer que sa valeur est en baisse."
                                            },
                                            {
                                                "example_id": "29e171cb-b6f3-48f6-a10c-bc8c8c831ea2",
                                                "sense_id": "ee935634-793e-3463-bb53-518f2d3a9dee",
                                                "text": "Je suis jeune, il est vrai ; mais aux âmes bien nées\nLa valeur n’attend point le nombre des années."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6d7d7b7c-3bf7-38cd-b237-ac8bc75d75f6",
                                        "entry_id": "9be483ba-bd75-3570-934c-a16f91cafc62",
                                        "glosses": [
                                            "Appréciation de l’intensité de la sensation visuelle résultant du graphisme."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
                ],
