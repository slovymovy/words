                "senses": [
                    {
                        "sense_id": "86d53ed6-4856-3ff8-b9b9-d38078812aa0",
                        "entry_id": "19af81f0-1ed3-3aed-8602-b1d0d546f3fd",
                        "glosses": [
                            "Nötigung einer Person zur Duldung des ( außerehelichen) Beischlafs"
                        ],
                        "tags": [
                            "früher"
                        ],
                        "examples": [
                            {
                                "example_id": "f7e38389-3a1f-4b73-92de-dcb612867f94",
                                "sense_id": "86d53ed6-4856-3ff8-b9b9-d38078812aa0",
                                "text": "„Das Stuprum an der ehrbaren Frau ist schwerlich in älterer Zeit als ein bloß mit der privatrechtlichen Injurienklage verfolgbares Unrecht angesehen worden.“ (1962)"
                            },
                            {
                                "example_id": "cce4f8e4-3401-4941-ba6c-ddf0e7c88661",
                                "sense_id": "86d53ed6-4856-3ff8-b9b9-d38078812aa0",
                                "text": "„Ein Stuprum, sagt der Verf., erhält eine ganz eigene Natur, wenn es mit einer Person verübt wird, welche das Stuprum nicht will, denn hier geschieht zugleich eine Rechtsverletzung der nichtwollenden Person.“ (1802)"
                            },
                            {
                                "example_id": "4a9c9e1b-e810-4bdf-9865-b619ee30c59f",
                                "sense_id": "86d53ed6-4856-3ff8-b9b9-d38078812aa0",
                                "text": "„Die Römer nahmen nämlich das Wort adulterium in einer weitern Bedeutung, wie wir das Wort Ehebruch. Sie verstanden nicht nur letzteren, sondern - auch zugleich das Stuprum darunter.“ (1805)"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
