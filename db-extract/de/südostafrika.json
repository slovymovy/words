                ],
                "senses": [
                    {
                        "sense_id": "6d9b0efb-b8f6-30ea-869e-7730f69f3fc1",
                        "entry_id": "a0a0e78e-1a64-37fc-873b-582ddea455d1",
                        "glosses": [
                            "nicht genau definierter Teil Afrikas, zu dem der östliche Teil Südafrikas und der südliche Teil Ostafrikas gehört"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "16d0e98f-c097-43f8-b4f4-0f3e7012dd84",
                                "sense_id": "6d9b0efb-b8f6-30ea-869e-7730f69f3fc1",
                                "text": "„Nur etwa 12 cm lang wird der Gefleckte Dickfingergecko (Pachydactylus maculatus) in Südostafrika, der oft in Gemeinschaft mit Skorpionen und Gürtelschweifen lebt.“"
                            },
                            {
                                "example_id": "86febe36-07c1-4c33-8387-603a0aa6940d",
                                "sense_id": "6d9b0efb-b8f6-30ea-869e-7730f69f3fc1",
                                "text": "„Der Schakalbussard (Buteo rufofuscus) ist der häufigste Bussard in Ost- und Südostafrika; er ruft schakalähnlich.“"
                            },
                            {
                                "example_id": "1e88bc9b-7f6b-482f-9d7f-548c8fca046c",
                                "sense_id": "6d9b0efb-b8f6-30ea-869e-7730f69f3fc1",
                                "text": "„Die monsunalen Sommerregengebiete (Hinterindien, Japan, China, der Süden der USA, Südostafrika, Südaustralien) zeichnen sich durch eine intensive Landwirtschaft aus.“"
                            },
                            {
                                "example_id": "edd240a0-d5de-4652-94ea-0f3b4fb485dc",
                                "sense_id": "6d9b0efb-b8f6-30ea-869e-7730f69f3fc1",
                                "text": "„Während des El Niño von 1997/98 waren auch Südostafrika und Nordbrasilien von Trockenheit betroffen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
