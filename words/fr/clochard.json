                    "frequency": "Middle",
                    "semantic_group_id": "sans_abri",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Un vieux <w>clochard</w> dormait tranquillement sur un banc du parc public."
                        },
                        {
                            "text": "Pendant l'hiver, des bénévoles distribuent des couvertures chaudes aux <w>clochards</w> de la ville."
                        }
                    ],
                    "synonyms": [
                        "sans-abri",
                        "vagabond",
                        "mendiant"
                    ],
                    "common_phrases": [
