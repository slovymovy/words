                        "glosses": [
                            "In a pitying manner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b0f18359-f81e-436b-9986-36fd33ee99d6",
                                "sense_id": "124ed61f-5699-38bd-9641-0da71eff82b7",
                                "text": "Ursula knew that Palmer had been astir at dawn, but not to attend to his usual duties, for she pityingly had freed the thirsty, uncared for sheep; many of these were now bogged in the various water-holes along the river."
                            },
                            {
                                "example_id": "a1b9d1f1-3c63-4c24-b9c6-384c5f47ef7e",
                                "sense_id": "124ed61f-5699-38bd-9641-0da71eff82b7",
                                "text": "The lady in the mirror gazed at the lady in the room, reproachfully at first, then — for were they not sisters? — relentingly, then pityingly."
                            }
                        ]
                    }
