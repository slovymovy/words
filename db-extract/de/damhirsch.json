                    {
                        "translation_id": "b0a7ef12-daa3-4cd9-9d9b-0954aa795f8b",
                        "source_entry_id": "dce09102-bcc3-37d7-89eb-873549e62cdb",
                        "source_sense_id": "b7ece03f-cb21-3b74-a29b-fe7376701905",
                        "source_sense_description": "Zoologie: Art der Familie Hirsche mit Schaufelgeweih und geflecktem Sommerfell",
                        "target_lang_word": "daim",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "daim",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e1a9bfbb-3803-3684-898f-8cb5e84ee41e",
                                        "entry_id": "d1db6c86-2dee-3de7-909d-352a05ddd056",
                                        "glosses": [
                                            "Cervidé d’une grandeur moyenne entre le cerf et le chevreuil, à la robe tachetée et au bois plat et palmé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2df8623-52a4-4493-8311-2f90a04a3376",
                                                "sense_id": "e1a9bfbb-3803-3684-898f-8cb5e84ee41e",
                                                "text": "Parfois un daim montrait sa tête effarouchée au-dessus des hautes herbes et disparaissait au loin en bondissant."
                                            },
                                            {
                                                "example_id": "aae27cb2-daeb-457b-90f1-6a02b0277555",
                                                "sense_id": "e1a9bfbb-3803-3684-898f-8cb5e84ee41e",
                                                "text": "Je suis comme le daim, au guet sur le rocher,\nQui geint de peur, palpite et dans l’herbe s’enfonce,\nParce qu’il sent venir la flèche de l’archer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c05de7b2-0dfc-35dd-8a7c-c5934677b0c0",
                                        "entry_id": "d1db6c86-2dee-3de7-909d-352a05ddd056",
                                        "glosses": [
                                            "Cervidé d’une grandeur moyenne entre le cerf et le chevreuil, à la robe tachetée et au bois plat et palmé.",
                                            "Daim européen."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "632d8bcb-995e-38d7-ae94-ccbe1a7ad14b",
                                        "entry_id": "d1db6c86-2dee-3de7-909d-352a05ddd056",
                                        "glosses": [
                                            "Viande de cet animal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d53ef16-5275-48da-a7dd-94e2c4d16a6c",
                                                "sense_id": "632d8bcb-995e-38d7-ae94-ccbe1a7ad14b",
                                                "text": "Il […] présidait les grandes assemblées de la nation franke, suivies de ces festins traditionnels parmi la race teutonique, où des sangliers et des daims entiers étaient servis tout embrochés, et où des tonneaux défoncés occupaient les quatre coins de la salle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "943a86f2-dd7f-3593-885e-fd7545642056",
                                        "entry_id": "d1db6c86-2dee-3de7-909d-352a05ddd056",
                                        "glosses": [
                                            "Peau tannée de cet animal."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "48c0b1a2-e25d-4557-9e67-15cc97a38c21",
                                                "sense_id": "943a86f2-dd7f-3593-885e-fd7545642056",
                                                "text": "Même pas eu le temps de me payer une paire de tatanes en daim comme j'avais envie. J’étais sapé de mes anciennes fringues, ma garde-robe d'avant la taule... les frocs se faisaient plus si fuseaux..."
                                            },
                                            {
                                                "example_id": "e2944e78-5832-4fc7-92c8-7703582e7a43",
                                                "sense_id": "943a86f2-dd7f-3593-885e-fd7545642056",
                                                "text": "Il portait un imperméable en daim avec une ceinture."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f98a455e-e7cc-33d3-a897-3a9dd90f6147",
                                        "entry_id": "d1db6c86-2dee-3de7-909d-352a05ddd056",
