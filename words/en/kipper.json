                            {
                                "target_lang_word": "карты Киппер",
                                "target_lang_sense_clarification": "гадальная немецкая колода"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "fe70bc2f-76f4-3585-9dde-9b06074ad6cf",
                    "sense_definition": "To cure fish, especially herring or salmon, by splitting, salting, and smoking.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "cure_fish",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Fishermen in the coastal village still <w>kipper</w> their catch over oak chips.",
                            "target_lang_translations": {
                                "ru": "Рыбаки в прибрежной деревне до сих пор <w>коптят</w> свой улов на дубовой щепе."
                            }
                        },
                        {
                            "text": "The local cannery learned how to <w>kipper</w> salmon according to traditional methods.",
                            "target_lang_translations": {
                                "ru": "Местный консервный завод научился <w>засаливать и коптить</w> лосося по традиционным рецептам."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Засаливать и коптить рыбу (особенно сельдь или лосося), предварительно пластуя её."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "коптить",
                                "target_lang_sense_clarification": "засоленную пластованную рыбу"
                            },
                            {
                                "target_lang_word": "пластовать и коптить",
                                "target_lang_sense_clarification": "кулинарный метод заготовки рыбы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f996a8d3-5afe-36e7-9604-d66b8b800bee",
                    "sense_definition": "To permeate, stain, or damage something with smoke, or to expose someone to heavy smoke.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "smoke_exposure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Years of heavy pipe smoking had completely <w>kippered</w> the living room wallpaper.",
                            "target_lang_translations": {
                                "ru": "Годы курения трубки насквозь <w>прокоптили</w> обои в гостиной."
                            }
                        },
                        {
                            "text": "We sat inside the poorly ventilated tavern, slowly <w>kippering</w> in cigarette fumes.",
                            "target_lang_translations": {
                                "ru": "Мы сидели в плохо проветриваемой таверне, медленно <w>пропитываясь</w> сигаретным дымом."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Informal figurative use"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прокоптить, пропитать дымом или подвергать воздействию густого дыма."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прокоптить",
                                "target_lang_sense_clarification": "насквозь пропитать дымом"
                            },
                            {
                                "target_lang_word": "закоптить",
                                "target_lang_sense_clarification": "покрыть копотью или дымом"
                            },
                            {
                                "target_lang_word": "окуривать дымом",
                                "target_lang_sense_clarification": "подвергать действию дыма"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b9fa1eea-c13e-3585-9ac8-00a688c04a03",
                    "sense_definition": "To dry out, shrivel, or harden through exposure to intense heat, sun, wind, or chemicals.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "desiccate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tourists were lying on the sand, slowly <w>kippering</w> under the blazing midday sun.",
                            "target_lang_translations": {
                                "ru": "Туристы лежали на песке, медленно <w>жарясь</w> под палящим полуденным солнцем."
                            }
                        },
                        {
                            "text": "The bitter desert wind will <w>kipper</w> your skin if you do not cover up.",
                            "target_lang_translations": {
                                "ru": "Резкий пустынный ветер <w>иссушит</w> твою кожу, если ты не укутаешься."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Humorous or expressive usage"
                        }
