                "senses": [
                    {
                        "sense_id": "ead60544-49a8-30e7-9a62-a06db7bfd135",
                        "entry_id": "ce2a3476-330d-3258-9329-585abff0ed22",
                        "glosses": [
                            "In a limitless way."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "308bc383-be47-4640-8326-c07b0e1c8554",
                                "sense_id": "ead60544-49a8-30e7-9a62-a06db7bfd135",
                                "text": "1834, Charles Reece Pemberton, Autobiography of Pel. Verjuice, Chapter 7, The Monthly Repository, 1834, Volume 8, p. 34,\nHow limitlessly, how indescribably beautiful were all these things!"
                            },
                            {
                                "example_id": "9cbc586a-2235-4e55-9b99-0ae41167927c",
                                "sense_id": "ead60544-49a8-30e7-9a62-a06db7bfd135",
                                "text": "Out in the country in India, the day begins early. One sees a plain, perfectly flat, dust-colored and brick-yardy, stretching limitlessly away on every side in the dim gray light […]"
                            },
                            {
                                "example_id": "f0c4fa26-bfda-476b-8f5b-4c298145d06b",
                                "sense_id": "ead60544-49a8-30e7-9a62-a06db7bfd135",
                                "text": "How much luck is one person entitled to in a night? Does it come in a limited allotment, like milk in a bottle, and when so much has been poured out then only so much is left? Or was luck a matter of the day, and on the day you’re lucky you are limitlessly lucky?"
                            }
                        ]
                    }
                ],
                "translations": [
