                        "target_lang_word": "comradely",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "comradely",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "76e9f872-f787-306b-95b5-b5aaf58148d6",
                                        "entry_id": "274c47cc-6aa7-3186-bc1e-0b10cbf47233",
                                        "glosses": [
                                            "Having the characteristics of a comrade or of comradeship; companionable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "41cc7456-4b95-47de-8f66-0210dab8fd9d",
                                                "sense_id": "76e9f872-f787-306b-95b5-b5aaf58148d6",
                                                "text": "\"Now, if you ever want to put anythin' out of sight, Julia,\" commented Ferd, with a comradely wink, \"you'll know how to do it […]\""
                                            },
                                            {
                                                "example_id": "2a053633-bcb6-47ea-867f-aa75efa5e475",
                                                "sense_id": "76e9f872-f787-306b-95b5-b5aaf58148d6",
                                                "text": "Land must be cleared before there was much stock-work for sheep and cattle dogs. But Bobtails were comradely; they guarded the men from the desperate loneliness in those isolated places."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "db987cb0-1a6c-30f1-b16c-090051e9f22e",
                                        "entry_id": "274c47cc-6aa7-3186-bc1e-0b10cbf47233",
                                        "glosses": [
                                            "Of or relating to comradeship; between or among comrades."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0187c12-3178-45a9-8574-d0bf0f36bec9",
                                                "sense_id": "db987cb0-1a6c-30f1-b16c-090051e9f22e",
                                                "text": "Heather was thinking not of the dead, but of the incorrigible living, of him whom she had striven hard, not with tears and common female wiles but with comradely devotion, to save from his worst enemy, himself."
                                            },
                                            {
                                                "example_id": "e8678540-d162-449d-9d69-42715017b3ad",
                                                "sense_id": "db987cb0-1a6c-30f1-b16c-090051e9f22e",
                                                "text": "During the trial they conferred together amiably in whispers, continued their comradely discussions during recesses."
                                            },
                                            {
                                                "example_id": "be1e0774-9a96-4f9f-bf85-1ced01c3cb7d",
                                                "sense_id": "db987cb0-1a6c-30f1-b16c-090051e9f22e",
                                                "text": "I touch her cheek, take her hand. On this bleak hillside in mid-morning I can find no trace in myself of that stupefied eroticism that used to draw me night after night to her body or even of the comradely affection of the road."
                                            },
                                            {
                                                "example_id": "3647be35-5085-402c-b32e-3a0dced47663",
                                                "sense_id": "db987cb0-1a6c-30f1-b16c-090051e9f22e",
                                                "text": "Much of Kühne's work is based on an analysis of comradely ideals constructed and sanctified, especially by right-wing groups, in the interwar years."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "comradely",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9ee1c555-6cd9-397f-adeb-950456d19b5b",
                                        "entry_id": "278abf34-767a-3323-9b61-2187669f13d5",
                                        "glosses": [
                                            "In the manner of a comrade."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e06fa472-d46e-43fb-b0a9-28eb23d75940",
                                                "sense_id": "9ee1c555-6cd9-397f-adeb-950456d19b5b",
                                                "text": "He smiled at her as he had before they were lovers; the breasts and thighs and backsides, knees, feet and arms comradely crowded together on the truck seemed to deny the reality of the physical presence he had lent her in a hotel room in Dar."
                                            }
                                        ]
                                    }
                                ]
