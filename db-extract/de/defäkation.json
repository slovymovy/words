                                        "entry_id": "0886d573-9384-3da7-a869-236bcf0de6d8",
                                        "glosses": [
                                            "The act or process of voiding feces from the bowels."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a0b5093e-0cc0-331f-b26e-f10e2b24da69",
                                        "entry_id": "0886d573-9384-3da7-a869-236bcf0de6d8",
                                        "glosses": [
                                            "Any of several processes for the removal of impurities, or for clarifying various materials."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7ecd6f98-6cd0-4106-a2b9-328851dd4d2c",
                                                "sense_id": "a0b5093e-0cc0-331f-b26e-f10e2b24da69",
                                                "text": "The juice after it leaves the mill has a more or less green color, due to the presence of large quantities of chlorophyl and other vegetable substances, which must be removed. This process is known as defecation."
                                            }
                                        ]
                                    }
                                ]
                            }
