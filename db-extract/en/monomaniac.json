                                            {
                                                "example_id": "fdbb3d80-a8a8-48f3-8b49-2e8442329a55",
                                                "sense_id": "e0bc0488-be86-3944-b36a-a6b695efabfa",
                                                "text": "Aufgrund einer Erkrankung, die sie zur Monomanin machte, war es ihr nicht mehr möglich, im Wachschutz zu arbeiten."
