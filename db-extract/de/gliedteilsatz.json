                "senses": [
                    {
                        "sense_id": "60762aea-016d-3e9b-90ef-cd5aebc6de8a",
                        "entry_id": "fefe3f1d-f754-3b63-9325-a1d682160043",
                        "glosses": [
                            "ein Teilsatz, der die Position und Funktion eines Teils eines Satzgliedes vertritt"
                        ],
                        "tags": [
                            "speziell Syntax"
                        ],
                        "examples": [
                            {
                                "example_id": "1f83eda0-9dd4-4667-9279-f280620e433a",
                                "sense_id": "60762aea-016d-3e9b-90ef-cd5aebc6de8a",
                                "text": "In dem Satz: \"Das Haus, das meinem Vater gehört, ist alt\" ist \"das meinem Vater gehört\" der Gliedteilsatz. \"Das Haus, das meinem Vater gehört\" ist insgesamt ein Satzglied (ein nominales Satzglied in der Funktion des Subjekts) und \"das meinem Vater gehört\" vertritt darin einen Satzgliedteil, nämlich das Genitiv-Attribut \"meines Vaters\"."
                            },
                            {
                                "example_id": "948bc9ae-468f-49b8-8571-ee650b1e0fe8",
                                "sense_id": "60762aea-016d-3e9b-90ef-cd5aebc6de8a",
                                "text": "„Subordinierte (eingebettete) Sätze, die die Funktion eines Satzgliedteils (Attributs) erfüllen, nennen wir Gliedteilsätze (Attributsätze).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
