{
    "word_family": [
        "afgaan",
        "opgang",
        "doorgang",
        "ingang",
        "uitgang"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "cff0f7af-da5d-386f-b83b-b46e71bef399",
                    "sense_definition": "Een schaamtevolle mislukking die gezichtsverlies veroorzaakt",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mislukking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De leerling begon te stotteren omdat hij bang was dat zijn spreekbeurt een <w>totale afgang</w> zou worden.",
                            "target_lang_translations": {
                                "en": "The student started to stutter because he was afraid his presentation would be a <w>total embarrassment</w>."
                            }
                        },
                        {
                            "text": "Na alle grote beloftes bleek de presentatie van het nieuwe product een enorme <w>afgang</w> te zijn.",
                            "target_lang_translations": {
                                "en": "After all the big promises, the presentation of the new product turned out to be a huge <w>flop</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "blamage",
                        "fiasco",
                        "mislukking"
                    ],
                    "antonyms": [
                        "succes",
                        "triomf"
                    ],
                    "common_phrases": [
                        "totale afgang",
                        "een grote afgang"
                    ],
                    "target_lang_definitions": {
                        "en": "A shameful failure that causes loss of face"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "embarrassment",
                                "target_lang_sense_clarification": "a shameful or awkward situation"
                            },
                            {
                                "target_lang_word": "flop",
                                "target_lang_sense_clarification": "a total failure"
                            },
                            {
                                "target_lang_word": "fiasco",
                                "target_lang_sense_clarification": "a complete and ignominious failure"
                            },
                            {
                                "target_lang_word": "disgrace",
                                "target_lang_sense_clarification": "loss of reputation or respect as the result of a dishonorable action"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "069a875e-366c-3902-9e3c-042e1ffb885a",
                    "sense_definition": "Het verlaten van het toneel of podium door een acteur of spreker",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "toneel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na zijn laatste monoloog maakte de acteur een dramatische <w>afgang</w> naar de coulissen.",
                            "target_lang_translations": {
                                "en": "After his final monologue, the actor made a dramatic <w>exit</w> to the wings."
                            }
                        },
                        {
                            "text": "Het publiek applaudisseerde luidruchtig tijdens de <w>afgang</w> van de hoofdrolspeler.",
                            "target_lang_translations": {
                                "en": "The audience applauded loudly during the lead actor's <w>exit</w>."
                            }
                        }
                    ],
                    "antonyms": [
                        "opkomst"
                    ],
                    "common_phrases": [
                        "een dramatische afgang"
                    ],
                    "target_lang_definitions": {
                        "en": "The departure of an actor or speaker from the stage"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "exit",
                                "target_lang_sense_clarification": "the act of leaving the stage"
                            },
                            {
                                "target_lang_word": "departure",
                                "target_lang_sense_clarification": "leaving a stage or podium"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d2579bfe-c28e-35b7-873e-e87180952cca",
                    "sense_definition": "De handeling van het naar beneden gaan of afdalen",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "beweging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>afgang</w> van de steile berghelling bleek gevaarlijker dan de klim omhoog.",
                            "target_lang_translations": {
                                "en": "The <w>descent</w> of the steep mountainside turned out to be more dangerous than the climb up."
                            }
                        },
                        {
                            "text": "Tijdens de <w>afgang</w> in de mijnschacht moesten alle arbeiders een helm dragen.",
                            "target_lang_translations": {
                                "en": "During the <w>descent</w> into the mine shaft, all workers had to wear a helmet."
                            }
                        }
                    ],
                    "synonyms": [
                        "afdaling"
                    ],
                    "antonyms": [
                        "opgang",
                        "stijging"
                    ],
                    "target_lang_definitions": {
                        "en": "The act of going down or descending"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "descent",
                                "target_lang_sense_clarification": "an action of moving downward, dropping, or falling"
                            },
                            {
                                "target_lang_word": "way down",
                                "target_lang_sense_clarification": "the path or journey downwards"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}