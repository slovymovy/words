    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3123df16-bd54-37bf-8877-f41b821ac86f",
                    "sense_definition": "sehr windig sein, wehen oder ein Unwetter bilden",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "wetter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Seit gestern Abend <w>stürmt</w> es an der Küste ununterbrochen.",
                            "target_lang_translations": {
                                "en": "It has been <w>storming</w> continuously on the coast since yesterday evening."
                            }
                        },
                        {
                            "text": "Wegen des herannahenden Tiefs <w>stürmte</w> und regnete es die ganze Nacht hindurch.",
                            "target_lang_translations": {
                                "en": "Due to the approaching low-pressure system, it <w>stormed</w> and rained all night long."
                            }
                        }
                    ],
                    "common_phrases": [
                        "es stürmt draußen"
                    ],
                    "target_lang_definitions": {
                        "en": "to be very windy, blow forcefully, or rage (of a storm)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "storm",
                                "target_lang_sense_clarification": "to have severe weather with strong winds"
                            },
                            {
                                "target_lang_word": "rage",
                                "target_lang_sense_clarification": "of a storm or wind"
                            },
                            {
                                "target_lang_word": "blow a gale",
                                "target_lang_sense_clarification": "idiomatic, to be extremely windy"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d4d5ad6a-3583-3ac2-9851-537a7c6122d2",
                    "sense_definition": "sich sehr schnell, heftig und ungestüm zu Fuß in eine Richtung bewegen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "bewegung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mit wütendem Gesichtsausdruck <w>stürmte</w> der Junge aus dem Klassenzimmer.",
                            "target_lang_translations": {
                                "en": "With an angry look on his face, the boy <w>stormed</w> out of the classroom."
                            }
                        },
                        {
                            "text": "Als die Pausenglocke läutete, <w>stürmten</w> alle Kinder sofort ins Freie.",
                            "target_lang_translations": {
                                "en": "When the recess bell rang, all the children immediately <w>rushed</w> outside."
                            }
                        }
                    ],
                    "common_phrases": [
                        "aus dem Zimmer stürmen"
                    ],
                    "target_lang_definitions": {
                        "en": "to move very quickly, violently, or impetuously on foot in a certain direction"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "storm",
                                "target_lang_sense_clarification": "to rush angrily or forcefully"
                            },
                            {
                                "target_lang_word": "rush",
                                "target_lang_sense_clarification": "to hurry or charge rapidly"
                            },
                            {
                                "target_lang_word": "charge",
                                "target_lang_sense_clarification": "to move with sudden burst of speed and force"
                            },
                            {
                                "target_lang_word": "dash",
                                "target_lang_sense_clarification": "to run or move impetuously"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f0d876d1-4e12-31e6-a7c8-8c19fe1fdc87",
                    "sense_definition": "einen Ort, ein Gebäude oder eine Stellung gewaltsam angreifen und einnehmen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "angriff",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Spezialeinheiten der Polizei <w>stürmten</w> am frühen Morgen das verlassene Lagerhaus.",
                            "target_lang_translations": {
                                "en": "Special police units <w>stormed</w> the abandoned warehouse early in the morning."
                            }
                        },
                        {
                            "text": "Tausende aufgebrachte Menschen versuchten, das Parlamentsgebäude zu <w>stürmen</w>.",
                            "target_lang_translations": {
                                "en": "Thousands of angry people tried to <w>storm</w> the parliament building."
                            }
                        }
                    ],
                    "antonyms": [
                        "verteidigen"
                    ],
                    "common_phrases": [
                        "ein Gebäude stürmen"
                    ],
                    "target_lang_definitions": {
                        "en": "to violently attack and capture a place, building, or military position"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "storm",
                                "target_lang_sense_clarification": "to assault a building or stronghold"
                            },
                            {
                                "target_lang_word": "invade",
                                "target_lang_sense_clarification": "to enter by force"
                            },
                            {
                                "target_lang_word": "assault",
                                "target_lang_sense_clarification": "to launch a violent attack on"
                            },
                            {
                                "target_lang_word": "rush",
                                "target_lang_sense_clarification": "to charge at a position in an attack"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "940d4a82-8faa-3482-998d-6b0f7f9dd819",
                    "sense_definition": "im Sport als Angreifer agieren oder offensive Spielzüge nach vorne ausführen",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "sport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der erfahrene Fußballprofi <w>stürmte</w> viele Jahre lang für die Nationalmannschaft.",
                            "target_lang_translations": {
                                "en": "The experienced professional footballer <w>played as a striker</w> for the national team for many years."
                            }
                        },
                        {
                            "text": "In der zweiten Spielhälfte <w>stürmte</w> die gesamte Mannschaft unermüdlich auf das Tor.",
                            "target_lang_translations": {
                                "en": "In the second half of the game, the entire team tirelessly <w>charged</w> at the goal."
                            }
                        }
                    ],
                    "antonyms": [
                        "verteidigen"
                    ],
                    "target_lang_definitions": {
                        "en": "to play as a forward or attack aggressively towards the opponent's goal (in sports)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "play as a striker",
                                "target_lang_sense_clarification": "in football/soccer"
                            },
                            {
                                "target_lang_word": "play forward",
                                "target_lang_sense_clarification": "to act as an attacker"
                            },
                            {
                                "target_lang_word": "charge",
                                "target_lang_sense_clarification": "to attack towards the goal"
                            }
                        ]
                    }
                }
            ]
        },
