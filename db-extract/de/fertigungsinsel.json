                "senses": [
                    {
                        "sense_id": "2d106787-cfbe-31cd-aafb-21124fca76b9",
                        "entry_id": "aa14b7e6-206f-3e32-b9fd-90a1b9703a16",
                        "glosses": [
                            "eine bestimmte Form der Fertigungsorganisation, bei der alle für die Fertigung von Erzeugnissen oder Teilen benötigten Ressourcen in einer organisatorischen Einheit zusammengefasst sind."
                        ],
                        "tags": [
                            "Produktionswirtschaft"
                        ],
                        "examples": [
                            {
                                "example_id": "b5999da8-02d4-434a-98c7-38c181245e13",
                                "sense_id": "2d106787-cfbe-31cd-aafb-21124fca76b9",
                                "text": "Mit der Organisationsform der Fertigungsinsel ist eine weitgehende Delegation von Aufgaben, Kompetenzen und Verantwortung in die innerhalb der Fertigungsinsel tätige Arbeitsgruppe verbunden."
                            },
                            {
                                "example_id": "3cae2892-ace4-47ea-a2d3-04888f8dad60",
                                "sense_id": "2d106787-cfbe-31cd-aafb-21124fca76b9",
                                "text": "\"Durch Fertigungsinseln wird das Tayloristische Prinzip der Trennung planender und ausführender Tätigkeiten aufgegeben, indem auf eine strikte, vorgegebene Arbeitsteilung verzichtet wird.\""
                            }
                        ],
