                "senses": [
                    {
                        "sense_id": "7f2d9e4d-953c-306f-92b4-8cfc0b4cce4c",
                        "entry_id": "8162ec1b-cb0c-3123-b634-50bea3842d7b",
                        "glosses": [
                            "spezielles Terrarium zur Haltung von Tieren und Pflanzen, die in Sumpfgebieten leben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ee755c1-27b9-4430-a287-3fd03590784f",
                                "sense_id": "7f2d9e4d-953c-306f-92b4-8cfc0b4cce4c",
                                "text": "„Ein 35 Zentimeter großes Dreihornchamäleon-Männchen (Trioceros jacksonii) ist derzeit die Attraktion im dortigen Vivarium. Das Reptil mit den charakteristischen Hörnern soll sich nun zunächst im Paludarium einleben, so Vivariumsleiter Hannes Kirchhauser.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "417b4e6d-4569-4160-a3bf-08901e7afa53",
                        "source_entry_id": "8162ec1b-cb0c-3123-b634-50bea3842d7b",
                        "source_sense_id": "7f2d9e4d-953c-306f-92b4-8cfc0b4cce4c",
                        "source_sense_description": "spezielles Terrarium zur Haltung von Tieren und Pflanzen, die in Sumpfgebieten leben",
                        "target_lang_word": "paludarium",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "paludarium",
