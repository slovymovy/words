                                        "sense_id": "527fb5c3-5e7b-3602-8109-23bc893d5417",
                                        "entry_id": "febd55ca-fbcb-31a5-8ec9-ed088ac13ba3",
                                        "glosses": [
                                            "Suggested indirectly, without being directly expressed."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "118920a7-0d99-46dd-9823-1c3658084d70",
                                                "sense_id": "527fb5c3-5e7b-3602-8109-23bc893d5417",
                                                "text": "Poets often leave behind an implicit message within their words."
                                            },
                                            {
                                                "example_id": "5afb3e53-c601-46cd-8152-1fe2084bad70",
                                                "sense_id": "527fb5c3-5e7b-3602-8109-23bc893d5417",
                                                "text": "The Bible and its teachings helped form the basis for the Founding Fathers' abiding belief in the inalienable rights of the individual, rights which they found implicit in the Bible's teachings of the inherent worth and dignity of each individual."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5e43b627-0299-3bb7-85ee-b81000f84f1f",
                                        "entry_id": "febd55ca-fbcb-31a5-8ec9-ed088ac13ba3",
                                        "glosses": [
                                            "Contained in the essential nature of something but not openly shown."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5c8dff22-d178-33ce-81bd-a9a2a97e5955",
                                        "entry_id": "febd55ca-fbcb-31a5-8ec9-ed088ac13ba3",
                                        "glosses": [
                                            "Having no reservations or doubts; unquestioning or unconditional; usually said of faith or trust."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1b1373dc-5ab0-4c00-9a19-f5371eab2314",
                                                "sense_id": "5c8dff22-d178-33ce-81bd-a9a2a97e5955",
                                                "text": "He is not only a zealous advocate for pusilanimous and passive obedience, but for the most implicit faith in the dictatorial mandates of power."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c200503b-6bf9-3824-a0d0-37382bd20c66",
                                        "entry_id": "febd55ca-fbcb-31a5-8ec9-ed088ac13ba3",
                                        "glosses": [
                                            "entangled, twisted together."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
