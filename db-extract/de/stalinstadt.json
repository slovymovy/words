                        "glosses": [
                            "1953 bis 1961 gültige Bezeichnung für Eisenhüttenstadt"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "63c0e3fb-0f06-4756-8807-6136103c9854",
                                "sense_id": "ff0b7e4b-04d8-3572-bde8-343e3d98426a",
                                "text": "„Im Zuge der Entstalinisierung wurde Stalinstadt dann am 13. November 1961 mit Schönfließ und Fürstenberg (Oder) zusammengelegt zur neuen Stadt Eisenhüttenstadt.“"
                            },
                            {
                                "example_id": "add85378-1e94-41c5-825d-ddfc02456c05",
                                "sense_id": "ff0b7e4b-04d8-3572-bde8-343e3d98426a",
                                "text": "„Stalinstadt gehörte am 17. und 18. Juni 1953 nicht zu den Zentren des Arbeiterprotestes gegen die stalinistische Politik der SED.“"
                            }
                        ],
