        "fr-extract.jsonl": [
            {
                "entry_id": "cdd6d2b2-5e9e-388d-85e9-dbeaeb18a8d8",
                "word": "tarmac",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "be5a16bd-d658-45b8-a291-1e212fe10fe5",
                        "entry_id": "cdd6d2b2-5e9e-388d-85e9-dbeaeb18a8d8",
                        "tags": [
                            "plural"
                        ],
                        "form": "tarmacs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7c7b0844-eb27-39c7-8079-c2602f2fb7a6",
                        "entry_id": "cdd6d2b2-5e9e-388d-85e9-dbeaeb18a8d8",
                        "glosses": [
                            "Matériau utilisé à la surface des routes, principalement dans un aéroport."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "63295860-f3fe-4f7e-b43a-8920a2dfa9fa",
                                "sense_id": "7c7b0844-eb27-39c7-8079-c2602f2fb7a6",
                                "text": "Le tarmac est un liant à base de goudron et utilisé par une entreprise anglaise pour l’enrobage du laitier des hauts fourneaux."
                            },
                            {
                                "example_id": "a67bba45-5432-4535-8db1-fb32e0098b0a",
                                "sense_id": "7c7b0844-eb27-39c7-8079-c2602f2fb7a6",
                                "text": "L’entreprise de génie civil posa également, autour de la maison, un tarmac de macadam gris d’une largeur de dix mètres."
                            }
                        ]
                    },
                    {
                        "sense_id": "facfd344-724a-39fe-bab7-e18cbe4fe84c",
                        "entry_id": "cdd6d2b2-5e9e-388d-85e9-dbeaeb18a8d8",
                        "glosses": [
                            "Ensemble des zones de circulation et de stationnement des avions, y compris les parkings, à l’exclusion de la piste d’atterrissage."
                        ],
                        "tags": [
                            "metonymically"
                        ],
                        "examples": [
                            {
                                "example_id": "79b07059-d947-401d-bde7-e293c2705dc6",
                                "sense_id": "facfd344-724a-39fe-bab7-e18cbe4fe84c",
                                "text": "L’avion était posé sur le tarmac comme un vieux jouet, une maquette de la marque Heller, peut-être, pareille à celles qu’il construisait dans son enfance, […]"
                            },
                            {
                                "example_id": "b9b2f97e-fca0-4657-bbdc-b3f377b41f56",
                                "sense_id": "facfd344-724a-39fe-bab7-e18cbe4fe84c",
                                "text": "À quelques mètres de là, une dizaine de chasseurs CF-18 sont stationnés sur le tarmac. Des membres du personnel de la base s’affairent aux derniers préparatifs en vue des vols de la matinée."
                            }
                        ]
                    },
                    {
                        "sense_id": "fd62dbe9-8bf6-343c-bc1e-9c38a6951b98",
                        "entry_id": "cdd6d2b2-5e9e-388d-85e9-dbeaeb18a8d8",
                        "glosses": [
                            "Surface d'atterrissage des appareils sur un porte-avions."
                        ],
                        "tags": [
                            "analogy"
                        ],
                        "examples": [
                            {
                                "example_id": "fce17eab-02bf-46d4-b5ff-d1be53f3ee8e",
                                "sense_id": "fd62dbe9-8bf6-343c-bc1e-9c38a6951b98",
                                "text": "Sur le tarmac, les hommes s'activent dans un ballet très chronométré. Chacun porte les couleurs de sa tâche."
                            }
                        ]
                    }
                ],
