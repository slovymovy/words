{
    "word_family": [
        "mitten"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "540191b9-16e6-373c-95e2-d575e78bbe38",
                    "sense_definition": "A type of glove that covers the four fingers together and the thumb separately.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "glove",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She wore warm wool <w>mitts</w> to protect her hands from the freezing winter air.",
                            "target_lang_translations": {
                                "cs": "Měla na sobě teplé vlněné <w>palčáky</w>, aby si chránila ruce před mrazivým zimním vzduchem."
                            }
                        },
                        {
                            "text": "The child lost one of his <w>mitts</w> while playing in the deep snow.",
                            "target_lang_translations": {
                                "cs": "Dítě ztratilo jeden ze svých <w>palčáků</w>, když si hrálo v hlubokém sněhu."
                            }
                        }
                    ],
                    "synonyms": [
                        "mitten"
                    ],
                    "target_lang_definitions": {
                        "cs": "Typ rukavice, která zakrývá čtyři prsty společně a palec odděleně."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "palčáky",
                                "target_lang_sense_clarification": "běžné označení pro rukavice bez oddělených prstů"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dddee651-782f-39d6-b099-6e2fc030d48c",
                    "sense_definition": "A large, padded glove used for protection or sports.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "glove",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The baker used a thick oven <w>mitt</w> to take the hot tray out of the oven.",
                            "target_lang_translations": {
                                "cs": "Pekař použil tlustou kuchyňskou <w>chňapku</w>, aby vyndal horký plech z trouby."
                            }
                        },
                        {
                            "text": "The baseball player caught the fast ball easily with his leather <w>mitt</w>.",
                            "target_lang_translations": {
                                "cs": "Baseballový hráč snadno chytil rychlý míč svou koženou <w>rukavicí</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "glove"
                    ],
                    "common_phrases": [
                        "oven mitt",
                        "baseball mitt"
                    ],
                    "target_lang_definitions": {
                        "cs": "Velká polstrovaná rukavice používaná pro ochranu nebo při sportu."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "chňapka",
                                "target_lang_sense_clarification": "kuchyňská rukavice na horké nádobí"
                            },
                            {
                                "target_lang_word": "rukavice",
                                "target_lang_sense_clarification": "obecné označení, v kontextu sportu např. baseballová rukavice"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8567b4ee-ba5a-3651-b2ad-50820f487857",
                    "sense_definition": "A person's hand, often used in a humorous or informal way.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "hand",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Keep your dirty <w>mitts</w> off the clean kitchen counter.",
                            "target_lang_translations": {
                                "cs": "Dej ty svoje špinavé <w>tlapy</w> pryč z čisté kuchyňské linky."
                            }
                        },
                        {
                            "text": "He reached out with his big <w>mitts</w> to grab the heavy box.",
                            "target_lang_translations": {
                                "cs": "Natáhl své velké <w>tlapy</w>, aby popadl těžkou krabici."
                            }
                        }
                    ],
                    "synonyms": [
                        "hand"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used informally to refer to hands."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Lidská ruka, často používané humorným nebo neformálním způsobem."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "tlapy",
                                "target_lang_sense_clarification": "hovorové, často pejorativní označení pro velké ruce"
                            },
                            {
                                "target_lang_word": "ruce",
                                "target_lang_sense_clarification": "neutrální označení, v hovorovém kontextu"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "5f248657-473a-3311-b7f5-b1d4aec83f74",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "name",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The researcher <w>Mitt</w> published a new study on linguistics last month.",
                            "target_lang_translations": {
                                "cs": "Výzkumník <w>Mitt</w> minulý měsíc publikoval novou studii o lingvistice."
                            }
                        },
                        {
                            "text": "I met a man named Mr. <w>Mitt</w> at the conference yesterday.",
                            "target_lang_translations": {
                                "cs": "Včera jsem na konferenci potkal muže jménem pan <w>Mitt</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Used as a family name."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Příjmení."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "Mitt",
                                "target_lang_sense_clarification": "příjmení ponechané v původním tvaru"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}