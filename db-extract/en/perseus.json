    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "5870bbd5-8f9c-3551-ac7f-943a3fe11081",
                "word": "Perseus",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "1ec65c78-829f-3eef-98f4-16c691d9cb28",
                        "entry_id": "5870bbd5-8f9c-3551-ac7f-943a3fe11081",
                        "glosses": [
                            "The mythological Greek warrior who slew the Gorgon Medusa by decapitating her. He married Andromeda after rescuing her from Ceto and founded Mycenae. He was the son of Zeus and Danae."
                        ],
                        "tags": [
                            "Greek"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "52a1a43d-acd2-3829-aa35-e836915723bf",
                        "entry_id": "5870bbd5-8f9c-3551-ac7f-943a3fe11081",
                        "glosses": [
                            "An autumn constellation of the northern sky, said to resemble the mythical hero. It includes the stars Algenib, Algol, and Mirfak."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "2016109a-086e-3977-985e-0d4b68e0fe41",
                        "entry_id": "5870bbd5-8f9c-3551-ac7f-943a3fe11081",
                        "glosses": [
                            "The last Antigonid king of Macedonia, Perseus of Macedon."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b3ab6e2a-3508-4720-9243-9acc96d6f317",
                        "source_entry_id": "5870bbd5-8f9c-3551-ac7f-943a3fe11081",
                        "source_sense_description": "mythical Greek warrior",
