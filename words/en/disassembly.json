{
    "word_family": [
        "assemble",
        "assembly",
        "disassemble",
        "disassembler",
        "reassemble",
        "reassembly"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1c140a86-97f2-3519-9f8f-944341062629",
                    "sense_definition": "The act or process of taking a machine, structure, or object apart into its individual pieces.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mechanic began the careful <w>disassembly</w> of the damaged engine.",
                            "target_lang_translations": {
                                "zh": "机械师开始小心地<w>拆卸</w>受损的发动机。"
                            }
                        },
                        {
                            "text": "Complete <w>disassembly</w> of the bicycle is required before shipping it in a box.",
                            "target_lang_translations": {
                                "zh": "将自行车装箱运输之前，需要进行彻底<w>拆解</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "dismantling",
                        "taking apart"
                    ],
                    "antonyms": [
                        "assembly#Noun",
                        "reassembly#Noun"
                    ],
                    "common_phrases": [
                        "complete disassembly",
                        "rapid unscheduled disassembly"
                    ],
                    "target_lang_definitions": {
                        "zh": "将机器、结构或物体拆解成独立零件的行为或过程。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "拆卸",
                                "target_lang_sense_clarification": "将机器或机械部件拆解开来"
                            },
                            {
                                "target_lang_word": "拆解",
                                "target_lang_sense_clarification": "将整体结构分解成部件"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7d3d426b-dcb7-3730-b877-827de700340f",
                    "sense_definition": "The human-readable assembly language code produced by converting machine code with a disassembler.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The security researcher examined the <w>disassembly</w> to identify potential vulnerabilities in the software.",
                            "target_lang_translations": {
                                "zh": "安全研究人员检查了<w>反汇编代码</w>，以找出软件中潜在的安全漏洞。"
                            }
                        },
                        {
                            "text": "If you inspect the raw <w>disassembly</w>, you can see how each function handles memory.",
                            "target_lang_translations": {
                                "zh": "如果你检查原始的<w>反汇编代码</w>，就能看出每个函数是如何处理内存的。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "disassembly output"
                    ],
                    "target_lang_definitions": {
                        "zh": "用反汇编器将机器代码转换后生成的人类可读的汇编语言代码，或指反汇编过程。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "反汇编代码",
                                "target_lang_sense_clarification": "通过反汇编得到的汇编程序代码"
                            },
                            {
                                "target_lang_word": "反汇编",
                                "target_lang_sense_clarification": "将机器码转换成汇编语言的操作或结果"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}