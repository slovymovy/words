    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1abc3835-f49e-365f-b20b-1c8b60065eae",
                    "sense_definition": "met een luid en krachtig stemgeluid praten of roepen",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "vocal_expression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je hoeft niet zo hard te <w>schreeuwen</w>, ik sta vlak naast je.",
                            "target_lang_translations": {
                                "en": "You don't have to <w>shout</w> so loudly, I'm standing right next to you.",
                                "ru": "Тебе не нужно так сильно <w>кричать</w>, я стою прямо рядом с тобой."
                            }
                        },
                        {
                            "text": "De luitenant <w>schreeuwde</w> een bevel naar zijn soldaten.",
                            "target_lang_translations": {
                                "en": "The lieutenant <w>yelled</w> a command to his soldiers.",
                                "ru": "Лейтенант <w>выкрикнул</w> приказ своим солдатам."
                            }
                        }
                    ],
                    "antonyms": [
                        "fluisteren"
                    ],
                    "common_phrases": [
                        "om hulp schreeuwen",
                        "moord en brand schreeuwen",
                        "tegen iemand schreeuwen"
                    ],
                    "target_lang_definitions": {
                        "en": "to speak or call out with a loud and powerful voice",
                        "ru": "говорить или звать громким и мощным голосом"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "shout",
                                "target_lang_sense_clarification": "to use a loud voice to be heard or express emotion"
                            },
                            {
                                "target_lang_word": "yell",
                                "target_lang_sense_clarification": "to shout loudly, often in anger or excitement"
                            },
                            {
                                "target_lang_word": "cry out",
                                "target_lang_sense_clarification": "to shout or call out suddenly"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "кричать",
                                "target_lang_sense_clarification": "использовать громкий голос, чтобы быть услышанным"
                            },
                            {
                                "target_lang_word": "орать",
                                "target_lang_sense_clarification": "кричать очень громко, часто в гневе"
                            },
                            {
                                "target_lang_word": "выкрикивать",
                                "target_lang_sense_clarification": "громко произносить слова или команды"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "89f9811b-3a69-3523-a120-5a2df61aa42d",
                    "sense_definition": "een hoog en hard geluid maken uit angst, pijn of opwinding",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "vocal_expression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De fans <w>schreeuwden</w> onophoudelijk toen de zanger het podium opkwam.",
                            "target_lang_translations": {
                                "en": "The fans <w>screamed</w> incessantly when the singer came onto the stage.",
                                "ru": "Фанаты непрестанно <w>визжали</w>, когда певец вышел на сцену."
                            }
                        },
                        {
                            "text": "Toen ze de spin zag, begon ze hard te <w>schreeuwen</w> van schrik.",
                            "target_lang_translations": {
                                "en": "When she saw the spider, she started <w>screaming</w> loudly from fright.",
                                "ru": "Когда она увидела паука, она начала громко <w>кричать</w> от испуга."
                            }
                        }
                    ],
                    "synonyms": [
                        "gillen",
                        "krijsen"
                    ],
                    "common_phrases": [
                        "het uitschreeuwen van pijn"
                    ],
                    "target_lang_definitions": {
                        "en": "to make a high and loud sound out of fear, pain, or excitement",
                        "ru": "издавать высокий и резкий звук от страха, боли или волнения"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "scream",
                                "target_lang_sense_clarification": "to make a loud, high-pitched cry"
                            },
                            {
                                "target_lang_word": "shriek",
                                "target_lang_sense_clarification": "to utter a sharp, shrill cry"
                            },
                            {
                                "target_lang_word": "yell",
                                "target_lang_sense_clarification": "to shout loudly due to strong emotion"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "визжать",
                                "target_lang_sense_clarification": "издавать пронзительный, высокий крик"
                            },
                            {
                                "target_lang_word": "вопить",
                                "target_lang_sense_clarification": "громко и неистово кричать от сильных эмоций"
                            },
                            {
                                "target_lang_word": "кричать",
                                "target_lang_sense_clarification": "издавать громкий звук от испуга или боли"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7fd5f17f-6ecd-3d19-a010-014c5f031a21",
                    "sense_definition": "gezegd van kleuren of ontwerpen die zeer opvallend of fel zijn",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dit behang <w>schreeuwt</w> nogal door de felle kleuren.",
                            "target_lang_translations": {
                                "en": "This wallpaper <w>screams</w> a bit because of the bright colors.",
                                "ru": "Эти обои прямо-таки <w>кричат</w> из-за ярких цветов."
                            }
                        },
                        {
                            "text": "Zijn nieuwe jas <w>schreeuwt</w> om aandacht in deze grijze omgeving.",
                            "target_lang_translations": {
                                "en": "His new coat <w>shouts</w> for attention in this gray environment.",
                                "ru": "Его новая куртка <w>взывает</w> о внимании в этой серой обстановке."
                            }
                        }
                    ],
                    "common_phrases": [
                        "om aandacht schreeuwen"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used metaphorically to describe visual intensity"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "said of colors or designs that are very striking, bright, or garish",
                        "ru": "о цветах или дизайне, которые очень заметны, ярки или безвкусны"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "scream",
                                "target_lang_sense_clarification": "to be very indicative of or strikingly obvious"
                            },
                            {
                                "target_lang_word": "shout",
                                "target_lang_sense_clarification": "to forcefully attract attention visually"
                            },
                            {
                                "target_lang_word": "be loud",
                                "target_lang_sense_clarification": "to be garish or overly bright"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "кричать",
                                "target_lang_sense_clarification": "быть вызывающе ярким или бросающимся в глаза"
                            },
                            {
                                "target_lang_word": "быть кричащим",
                                "target_lang_sense_clarification": "о слишком ярком, безвкусном оформлении"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b08ea1f4-5dff-3aec-89f0-074a7d71a7a6",
