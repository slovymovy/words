                    {
                        "translation_id": "c061b0f7-8021-4d5f-8d13-58e015d10e5a",
                        "source_entry_id": "02dd17c1-d28e-3ea1-b765-c218c4e10400",
                        "source_sense_id": "378b1a30-7fd1-3cd1-85a1-ab85319c75fe",
                        "source_sense_description": "felle boosheid",
                        "target_lang_word": "malignity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
