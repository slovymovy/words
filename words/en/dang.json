                    "target_lang_definitions": {
                        "ru": "Ругать или проклинать кого-то или что-то (эвфемизм для 'damn').",
                        "zh": "咒骂或谴责某人或某物，是 damn 的委婉说法。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "проклинать",
                                "target_lang_sense_clarification": "желать зла"
                            },
                            {
                                "target_lang_word": "ругать",
                                "target_lang_sense_clarification": "бранить"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "骂",
                                "target_lang_sense_clarification": "指咒骂、骂人或骂某物"
                            },
                            {
                                "target_lang_word": "诅咒",
                                "target_lang_sense_clarification": "较强，表示诅咒、咒骂"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8ca53902-b363-3ab1-be55-55bd8de5ee07",
                    "sense_definition": "The simple past tense of <w>ding</w>.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The church bell <w>dang</w> loudly across the quiet valley.",
                            "target_lang_translations": {
                                "ru": "Церковный колокол громко <w>звенел</w> над тихой долиной.",
                                "zh": "教堂的钟声在寂静的山谷里大声<w>响起</w>。"
                            }
                        },
                        {
                            "text": "He <w>dang</w> the metal pot with a spoon to get everyone's attention.",
                            "target_lang_translations": {
                                "ru": "Он <w>ударил</w> ложкой по металлической кастрюле, чтобы привлечь всеобщее внимание.",
                                "zh": "他用勺子<w>敲</w>了一下金属锅，好引起大家注意。"
                            }
                        }
