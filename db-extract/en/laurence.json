                    {
                        "translation_id": "8e04e42c-40a0-4049-a8f6-4b6350d1217d",
                        "source_entry_id": "ca7ee964-f5bd-3efc-b308-12b2767c6744",
                        "source_sense_description": "male given name",
                        "target_lang_word": "Laurent",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Laurent",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0198602a-adae-3b64-ac19-03999b8845e0",
                                        "entry_id": "26d16a12-8304-32db-a773-0b8e46437fca",
                                        "glosses": [
                                            "Prénom masculin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7991a8b4-4d8b-453d-91d6-3f847d519a1a",
                                                "sense_id": "0198602a-adae-3b64-ac19-03999b8845e0",
                                                "text": "Laurent, tu tressautes."
                                            },
                                            {
                                                "example_id": "7850e580-eb0b-4b2a-a310-438e874eb5af",
                                                "sense_id": "0198602a-adae-3b64-ac19-03999b8845e0",
                                                "text": "Laurent Lafitte secoue Blanche Gardin et vice versa dans le réjouissant Tout le monde aime Jeanne, premier film de Céline Devaux découvert à la Semaine de la critique du Festival de Cannes et en salles ce mercredi."
                                            },
                                            {
                                                "example_id": "38253e47-d104-4833-88b6-d08ddf9d59ba",
                                                "sense_id": "0198602a-adae-3b64-ac19-03999b8845e0",
                                                "text": "Selon les chiffres partagés par Pôle Emploi, Laurent Berger dit vrai."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Laurent",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0ca98f80-461e-38df-a978-0f17fc9da030",
                                        "entry_id": "7c119049-4d7f-3c09-a246-40fc4fad78ea",
                                        "glosses": [
                                            "Nom de famille français."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a3a5373f-e915-456b-845e-be134d7822aa",
                                                "sense_id": "0ca98f80-461e-38df-a978-0f17fc9da030",
                                                "text": "Les Combattantes, minisérie événement de TF1 diffusée ce lundi à 21 h 10, réunit à nouveau Audrey Fleurot, Camille Lou et Julie de Bona dans une fresque historique, produite par Iris Bucher et réalisée par Alexandre Laurent."
                                            },
                                            {
                                                "example_id": "87a48ebf-63bb-4532-a928-7fca2aebc670",
                                                "sense_id": "0ca98f80-461e-38df-a978-0f17fc9da030",
                                                "text": "« Régis, il faut le connaître sur la durée pour que ça fonctionne vraiment avec lui », estime Jocelyn Laurent (26 ans), qui l’a côtoyé au centre de formation lorientais."
                                            },
                                            {
                                                "example_id": "51c53b86-a5e5-4c8d-bfa8-bfd9128138f8",
                                                "sense_id": "0ca98f80-461e-38df-a978-0f17fc9da030",
                                                "text": "La victoire finale a été décernée à Marin et Vincent Laurent après une lutte acharnée contre Maxence et Paul Lozac’h qui terminent sur la deuxième marche du podium, devant Guillaume et Albane De Brisoult."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e422fe52-599f-47f6-b345-8cab417febab",
