                ],
                "senses": [
                    {
                        "sense_id": "03afe8e9-111d-3d35-a3d3-92680af20843",
                        "entry_id": "28ff2777-91ca-3f68-afe0-c9987651af2b",
                        "glosses": [
                            "seinerzeit aus Erdöl hergestellte Kunststoffteile, die nach Gebrauch nunmehr Abfall sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2579ac93-9bc0-4681-a713-ca60fc861893",
                                "sense_id": "03afe8e9-111d-3d35-a3d3-92680af20843",
                                "text": "„Das einfachste und effektivste Mittel gegen die Plastikschwemme ist es und wird es auch in Zukunft bleiben: den Plastikmüll erst gar nicht entstehen zu lassen!“"
                            },
                            {
                                "example_id": "718d7569-405c-4927-a17f-02ae38079449",
                                "sense_id": "03afe8e9-111d-3d35-a3d3-92680af20843",
                                "text": "„ Die Ozeane bieten Lebensraum für unzählige Fischarten, Pflanzen, Meeressäuger - doch ihr Leben ist bedroht: in jedem Quadratkilometer der Meere schwimmen zehntausende Teile Plastikmüll, an dem sie qualvoll verenden.“"
                            },
                            {
                                "example_id": "2df03699-1bc2-45b3-843c-e93926defb2d",
                                "sense_id": "03afe8e9-111d-3d35-a3d3-92680af20843",
                                "text": "„Plastikmüll ist ein weltweites Problem und gefährdet in zunehmendem Maße unsere Meere und Küsten.“"
                            },
                            {
                                "example_id": "5bfb23b2-eca6-4f23-a70f-bf3afd11c935",
                                "sense_id": "03afe8e9-111d-3d35-a3d3-92680af20843",
                                "text": "„Doch heute schwimmen in jedem Quadratkilometer der Meere zehntausende Teile Plastikmüll.“"
                            },
                            {
                                "example_id": "6cb8a16f-7980-44f6-aa1f-8836dfab4659",
                                "sense_id": "03afe8e9-111d-3d35-a3d3-92680af20843",
                                "text": "„Die Forscher haben unter anderem ermittelt, wie viel Müll in Küstenländern produziert wird, wie hoch der Anteil an Plastikmüll ist und wie viel davon unsachgemäß oder gar nicht entsorgt wird, also zum Beispiel in offenen Deponien gesammelt oder schlichtweg in die Umwelt geworfen wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
