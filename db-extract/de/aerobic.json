                        "glosses": [
                            "Fitnesstraining, bei dem meist in Begleitung von Musik die beiden Sportarten Gymnastik und Tanz mit dem Ziel verbunden werden, den Umsatz von Sauerstoff im Körper zu verstärken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a1d04a4-e9ef-4f09-9480-635dbbcd2461",
                                "sense_id": "318713cf-15e4-39c4-b3d6-fd0ece0917da",
                                "text": "Aerobic ist ein Fitnesstraining für den menschlichen Körper und stärkt die Lunge und das Herz."
                            },
                            {
                                "example_id": "0ab9147b-975b-4d7a-82a2-7f9eb0f6d1f7",
                                "sense_id": "318713cf-15e4-39c4-b3d6-fd0ece0917da",
                                "text": "Zweimal die Woche gehe ich ins Fitnessstudio und mache Aerobic."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
