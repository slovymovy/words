                "senses": [
                    {
                        "sense_id": "eef2ac33-5a13-3422-9792-482282542764",
                        "entry_id": "ff44a732-a992-35f7-8dcf-28d0011b7036",
                        "glosses": [
                            "Haushaltsgerät mit kreisförmiger, rotierender Klinge, um Pizza in handliche Stücke zu zerschneiden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d69c53d8-7291-4b49-9105-eb6e0e197dbb",
                                "sense_id": "eef2ac33-5a13-3422-9792-482282542764",
                                "text": "„Der Flammkuchenteig ist so knusprig, dass man ihn am besten mit einer Küchenschere oder einem Pizzaschneider zerteilt.“"
                            },
                            {
                                "example_id": "0ab9157e-286e-4708-96a5-7eb086fccd6d",
                                "sense_id": "eef2ac33-5a13-3422-9792-482282542764",
                                "text": "„Die Mohnmischung mit einem großen Löffel gleichmäßig auf einer Teigplatte verstreichen. Die zweite Teigplatte darauf legen und leicht andrücken. Den Teig mit einem Pizzaschneider oder einem großen Messer von der Schmalseite her in ca. 1 ½ cm breite Streifen schneiden.“"
                            },
                            {
                                "example_id": "0a1efb69-0a82-4981-badb-0957084fc039",
                                "sense_id": "eef2ac33-5a13-3422-9792-482282542764",
                                "text": "„Mit einem scharfen Messer oder dem Pizzaschneider in etwa 2 cm große Quadrate schneiden."
                            },
                            {
                                "example_id": "02ecda88-d888-4997-918d-c133b0d8ac96",
                                "sense_id": "eef2ac33-5a13-3422-9792-482282542764",
                                "text": "„Verwenden Sie anstelle eines Messers einen Pizzaschneider.“"
                            },
                            {
                                "example_id": "691d72fb-12c5-4602-a3a7-ecadecf8c394",
                                "sense_id": "eef2ac33-5a13-3422-9792-482282542764",
                                "text": "Er zerteilte die Pizza mit einem Pizzaschneider."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
