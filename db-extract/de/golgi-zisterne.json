                "senses": [
                    {
                        "sense_id": "88dcd6bd-0bce-34e4-922f-2e1eb652fd43",
                        "entry_id": "a0fd146d-ec38-3b74-928f-21d3e5ff0b05",
                        "glosses": [
                            "ein flaches Membrankompartiment im Zellplasma pflanzlicher und tierischer Zellen mit zellsekretorischer Funktion. Mehrere solcher gestapelter Kompartimente bilden ein Dictyosom. Die Gesamtheit aller Dictyosomen einer Zelle bilden den Golgi-Apparat."
                        ],
                        "tags": [
                            "Cytologie"
                        ],
                        "examples": [
                            {
                                "example_id": "3b9596a7-22ef-4f3c-be89-d8b15ae164db",
                                "sense_id": "88dcd6bd-0bce-34e4-922f-2e1eb652fd43",
                                "text": "Die funktionelle Grundeinheit des Golgi-Apparates ist die Golgi-Zisterne."
                            },
                            {
                                "example_id": "506e721a-483c-4473-b430-1b8823f7aa91",
                                "sense_id": "88dcd6bd-0bce-34e4-922f-2e1eb652fd43",
                                "text": "„Der Golgi-Apparat besteht aus Stapeln flacher oder schüsselförmiger Golgi-Zisternen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
