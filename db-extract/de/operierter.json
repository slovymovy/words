                ],
                "senses": [
                    {
                        "sense_id": "015246cf-4501-36f6-af3f-510a338f6a4e",
                        "entry_id": "4e727348-54a2-3134-aafe-dc8fc202084f",
                        "glosses": [
                            "Person, die operiert wird oder wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "09504867-3f4a-4f0b-910a-e102843ac9b0",
                                "sense_id": "015246cf-4501-36f6-af3f-510a338f6a4e",
                                "text": "„Wieder zurück in meinem Zimmer, diesmal auch im Dauerlauf aber mit geschlossenen Augen, wurde ich versorgt mit allem, was ein frisch Operierter braucht.“"
                            },
                            {
                                "example_id": "6bfaa558-725f-4b5f-9dda-367343128755",
                                "sense_id": "015246cf-4501-36f6-af3f-510a338f6a4e",
                                "text": "„Ein Operierter mehr pro Pflegekraft bedeutet statistisch eine um 7 % höhere Sterblichkeit innerhalb der ersten 30 Tage.“"
                            },
                            {
                                "example_id": "b0fbf7b0-69aa-4e10-8fca-7c1a09479bf3",
                                "sense_id": "015246cf-4501-36f6-af3f-510a338f6a4e",
                                "text": "„Nach zwei Wochen gaben 82 % der Operierten noch Beschwerden an, nach sechs Wochen war dieser Wert auf 42 % gesunken und nach sechs Monaten immerhin noch 17 %.“"
                            },
                            {
                                "example_id": "c6fd629a-220c-4996-a2b2-bd082a9c2c2d",
                                "sense_id": "015246cf-4501-36f6-af3f-510a338f6a4e",
                                "text": "„Wir helfen Kindern und Säuglingen, Jugendlichen, Erwachsenen und Berufstätigen, Schwangeren, Senioren, Operierten und Sportlern.“"
                            },
                            {
                                "example_id": "8fc98731-beeb-430b-878f-09a81a570542",
                                "sense_id": "015246cf-4501-36f6-af3f-510a338f6a4e",
                                "text": "„Dennoch muss ein Teil der Operierten damit rechnen, dass sich infolge des Eingriffs eine Harninkontinenz entwickelt.“"
                            },
                            {
                                "example_id": "d7034494-37e5-42c4-a808-a1f5fc28a943",
                                "sense_id": "015246cf-4501-36f6-af3f-510a338f6a4e",
                                "text": "„Bei etwa 85 % der Operierten wird innerhalb von zwei Monaten nach Eingriff eine Schmerzfreiheit erreicht.“"
                            },
                            {
                                "example_id": "6fccb1f1-98a8-489e-935b-d7eb055001ff",
                                "sense_id": "015246cf-4501-36f6-af3f-510a338f6a4e",
                                "text": "„Allen Operierten, die hierhin gefunden haben, eine schnelle Heilung und gute Gesundheit!“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
