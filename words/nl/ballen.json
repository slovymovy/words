                    "synonyms": [
                        "lef",
                        "moed",
                        "branie",
                        "durf"
                    ],
                    "antonyms": [
                        "lafheid"
                    ],
                    "common_phrases": [
                        "ballen tonen",
                        "ballen hebben"
