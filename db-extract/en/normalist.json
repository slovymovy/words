                        "glosses": [
                            "One who believes something to be the normal state of things, not requiring remediation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "961c6205-47d2-41e6-bd94-011ec7693b77",
                                "sense_id": "d6563fd9-3083-38e0-a48a-1f096de269ad",
                                "text": "Normalists believe that immature behavior in the home and school is simply part of growing up."
                            },
                            {
                                "example_id": "c8033fad-1be1-4e39-8767-434bd4c41a0d",
                                "sense_id": "d6563fd9-3083-38e0-a48a-1f096de269ad",
                                "text": "Conversely, non-Christian thinkers may be characterized as normalists in the sense that they believe the world in its present state is normal, that is, not in need of radical renewal."
                            }
                        ]
                    }
                ],
