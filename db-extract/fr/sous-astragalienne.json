                        "examples": [
                            {
                                "example_id": "199ba9fe-8aea-4158-aad1-7a46c74c60f9",
                                "sense_id": "3c9e8e0f-edfa-36df-a121-8073a646dec7",
                                "text": "La forme des surfaces articulaires, la résistance du système capsulo-ligamentaire permet ces mouvements de verrouillage et de déverrouillage du médio-pied et de la sous-astragalienne."
                            },
                            {
