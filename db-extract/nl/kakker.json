                        "entry_id": "c52f648c-497c-36c9-a2ce-1f53e4bf12d2",
                        "glosses": [
                            "a stereotypical designation of a Dutch person who is elitist, posh, preppy, and conceited. Commonly associated attributes include polo shirts, field hockey, and the accent (bekakt praten)"
                        ],
                        "tags": [
                            "broadly",
                            "derogatory",
                            "masculine",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "87db2db8-e335-4b06-b8d6-010da51fcd1f",
                                "sense_id": "8da4fa39-320c-3d93-9eb1-9454076cec05",
                                "text": "Die debiele kakker snuift de hele dag op kosten van zijn vader.",
                                "translation": "That idiotic preppy asshole snorts [drugs] all day at his father's expense.",
                                "english": "That idiotic preppy asshole snorts [drugs] all day at his father's expense."
