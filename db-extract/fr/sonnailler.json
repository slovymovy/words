                "entry_id": "ee2631d4-35d6-3951-aab4-7f2c5c169e10",
                "word": "sonnailler",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "b885a503-803b-40c3-905b-30370c723757",
                        "entry_id": "ee2631d4-35d6-3951-aab4-7f2c5c169e10",
                        "tags": [
                            "plural"
                        ],
                        "form": "sonnaillers"
                    },
                    {
                        "form_id": "567bd412-6f92-4142-9894-d75380761867",
                        "entry_id": "ee2631d4-35d6-3951-aab4-7f2c5c169e10",
                        "tags": [
                            "une femelle"
                        ],
                        "form": "sonnaillère"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "20e538d5-13b9-3d83-be9c-2032fe69b025",
                        "entry_id": "ee2631d4-35d6-3951-aab4-7f2c5c169e10",
                        "glosses": [
                            "Animal qui porte une sonnaille, et qui va en tête du troupeau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "36ccbce1-0fc9-431a-b008-4fe72630822a",
                                "sense_id": "20e538d5-13b9-3d83-be9c-2032fe69b025",
                                "text": "Le troupeau marchait en masse compacte, le sonnailler devant, et, près de lui, la brebis birane, faisant tinter leur clarine au milieu des bêlements."
                            },
                            {
                                "example_id": "941bc6f1-7cd2-49be-b5ad-ba1ec0f31777",
                                "sense_id": "20e538d5-13b9-3d83-be9c-2032fe69b025",
                                "text": "Et le bélier s'est enfui avec la flamme dans sa toison, le sonnailler avec la sonnaille, le feu, le fracas et les cornes battaient la clôture derrière laquelle il s'était caché ; […]."
                            },
                            {
                                "example_id": "94c31e73-03c3-40c1-b3dd-2933e2bddabe",
                                "sense_id": "20e538d5-13b9-3d83-be9c-2032fe69b025",
                                "text": "[…] on se trouvait nez à nez avec le troupeau allant au pâturage ou en revenant , la sonnaillère en tête et le fameux taureau fermant la marche."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
