                "senses": [
                    {
                        "sense_id": "5cb93ea4-de3f-3362-8847-e3bc46b644fb",
                        "entry_id": "8f18de84-c94b-37e7-a6ac-d739ebb3e7de",
                        "glosses": [
                            "Automobil mit genau vier Türen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45ce3a9c-216c-4cb8-bd8b-7b0e0b3c1b1a",
                                "sense_id": "5cb93ea4-de3f-3362-8847-e3bc46b644fb",
                                "text": "„Das sind beeindruckenden Werte, die von einem weiteren Viertürer, der noch nicht den Supersportwagen zugerechnet wird, noch getoppt werden: 3,2 Sekunden für den Sprint auf 100, 315 km/h top.“"
                            },
                            {
                                "example_id": "99d50c07-aba3-4750-94df-79ae5559334f",
                                "sense_id": "5cb93ea4-de3f-3362-8847-e3bc46b644fb",
                                "text": "„Die Nebenmarke AMG wird von Mercedes immer weiter aufgefächert. Als zweites eigenständiges Modell wird der GT als Viertürer aufgerüstet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
