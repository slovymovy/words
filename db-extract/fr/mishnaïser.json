                ],
                "senses": [
                    {
                        "sense_id": "31d01de9-ec00-3519-b96d-19645a9889e2",
                        "entry_id": "4176a17d-f9cc-396d-831c-6759ad80d506",
                        "glosses": [
                            "Donner un caractère mishnaïque à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "88afe368-e45b-481e-b297-a0fde63f2fb8",
                                "sense_id": "31d01de9-ec00-3519-b96d-19645a9889e2",
                                "text": "Tout cela n'était pas fait pour demeurer dans l'écrit, mais pour être mishnaïsé, c'est-à-dire rythmo-catéchisé, donc enfoncé dans les muscles de ceux qui devaient partir à la conquête du monde."
                            }
                        ]
                    },
                    {
                        "sense_id": "5086f1a9-cf13-3bca-afcb-07b2979508d8",
                        "entry_id": "4176a17d-f9cc-396d-831c-6759ad80d506",
                        "glosses": [
                            "Dire la Mishna."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54fc9171-2182-4494-b368-57d73b6e34e1",
                                "sense_id": "5086f1a9-cf13-3bca-afcb-07b2979508d8",
                                "text": "Un certain Talmîd était à Rabbi Eliezer qui mishnaïsait à voix basse."
                            },
                            {
                                "example_id": "8775bb99-4a60-43b6-a83a-0cd3475626d0",
                                "sense_id": "5086f1a9-cf13-3bca-afcb-07b2979508d8",
                                "text": "Tout homme qui miqraïse sans psalmodie et mishnaïse sans mélodie, Celui-là, l’Ecriture en dit: “Et certes j’ai donné à eux des préceptes qui ne sont pas bons”."
                            }
                        ]
                    }
                ],
