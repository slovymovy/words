                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "0ca5b210-d1c4-4172-af43-5b8b54bb2965",
                                "sense_id": "7445248d-df45-3269-8345-b25c49a4ce0a",
                                "text": "Fireflies that suspire / In short, soft lapses of transported flame."
                            },
                            {
                                "example_id": "b5b9dca1-a906-436b-814a-8dcbaaffd63c",
                                "sense_id": "7445248d-df45-3269-8345-b25c49a4ce0a",
                                "text": "To him that yesterday did suspire."
                            }
                        ]
                    },
