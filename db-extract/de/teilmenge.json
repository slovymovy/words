                ],
                "senses": [
                    {
                        "sense_id": "d8f1df81-3b60-36d9-91bd-e30c0408c36f",
                        "entry_id": "b08705ee-be19-393d-a652-d3626a212d01",
                        "glosses": [
                            "eine Menge, die nur Elemente einer anderen Menge enthält"
                        ],
                        "tags": [
                            "Mengenlehre"
                        ],
                        "examples": [
                            {
                                "example_id": "169eefb2-9f30-4290-bada-4012bbc65a26",
                                "sense_id": "d8f1df81-3b60-36d9-91bd-e30c0408c36f",
                                "text": "Jede Menge hat die leere Menge zur Teilmenge."
                            },
                            {
                                "example_id": "d2a8e135-c3c5-479c-bca4-90733fd46654",
                                "sense_id": "d8f1df81-3b60-36d9-91bd-e30c0408c36f",
                                "text": "Die Teilmenge der Schüler dieser Klasse, die ihre Mathematikaufgaben richtig gelöst haben, die kann ich an den Fingern einer Hand abzählen."
                            },
                            {
                                "example_id": "c0c488cd-2792-41ac-b2dd-21e64b343118",
                                "sense_id": "d8f1df81-3b60-36d9-91bd-e30c0408c36f",
                                "text": "„Teilmengen achronaler Mengen sind achronal.“"
                            },
                            {
                                "example_id": "3ae997df-e6b1-428c-b49f-be70379db93e",
                                "sense_id": "d8f1df81-3b60-36d9-91bd-e30c0408c36f",
                                "text": "„Bei unendlichen Mengen ist es aber möglich, dass eine echte Teilmenge dieselbe Mächtigkeit hat wie ihre Grundmenge.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "43431231-b40b-42c6-8ae7-1ef011d1816f",
                        "source_entry_id": "b08705ee-be19-393d-a652-d3626a212d01",
                        "source_sense_id": "d8f1df81-3b60-36d9-91bd-e30c0408c36f",
                        "source_sense_description": "Mathematik, Mengenlehre: eine Menge, die nur Elemente einer anderen Menge enthält",
                        "target_lang_word": "subset",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "subset",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "20ab33e5-073e-3114-b98e-6a758a3335ed",
                                        "entry_id": "410828d7-b746-3ac3-bef5-377e3fc6e0df",
                                        "glosses": [
                                            "A set A such that every element of A is also an element of S."
                                        ],
                                        "tags": [
                                            "of a set S"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17e73e02-1ebe-4f26-89ac-7bbcd46c5fb0",
                                                "sense_id": "20ab33e5-073e-3114-b98e-6a758a3335ed",
                                                "text": "The set of integers is a subset of the set of real numbers."
                                            },
                                            {
                                                "example_id": "cb5339db-f580-408f-972f-56cf18ad824d",
                                                "sense_id": "20ab33e5-073e-3114-b98e-6a758a3335ed",
                                                "text": "The set #92;lbracea,b#92;rbrace is a both a subset and a proper subset of #92;lbracea,b,c#92;rbrace while the set #92;lbracea,b,c#92;rbrace is a subset of #92;lbracea,b,c#92;rbrace but not a proper subset of #92;lbracea,b,c#92;rbrace."
                                            },
                                            {
                                                "example_id": "ade089ab-5b46-4ec4-9a45-1d7dc8d42a8e",
                                                "sense_id": "20ab33e5-073e-3114-b98e-6a758a3335ed",
                                                "text": "1963, David B. MacNeil, Modern Mathematics for the Practical Man, David Van Nostrand, Republished as 2013, David B. MacNeil, Fundamentals of Modern Mathematics: A Practical Review, Dover, page 3,\nIn the foregoing example, the set D of the first four letters of the alphabet, was a subset of the set A of all the letters of the alphabet, because A includes all the members of D."
                                            },
                                            {
                                                "example_id": "f4aa23ab-6221-4127-9c52-562ab132b5aa",
                                                "sense_id": "20ab33e5-073e-3114-b98e-6a758a3335ed",
                                                "text": "Let A be a subset of the topological space X and take x#92;inX."
                                            },
                                            {
                                                "example_id": "a15ef938-7ec8-49c5-a9fe-3aba2ee3f820",
                                                "sense_id": "20ab33e5-073e-3114-b98e-6a758a3335ed",
                                                "text": "We say that a set S has a finite partition into subsets S#95;1,#92;dots,S#95;n, if S#61;S#95;i#92;cup#92;dots#92;cupS#95;n, where the subsets are pairwise disjoint, that is, S#95;i#92;capS#95;j#61;#92;empty, if i#92;nej. (We do not require that the subsets be nonempty.)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b5df7d6-0261-3811-9a10-8f1a9691582d",
                                        "entry_id": "410828d7-b746-3ac3-bef5-377e3fc6e0df",
                                        "glosses": [
                                            "A group of things or people, all of which are in a specified larger group."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef3349ce-810f-4efd-8ff1-3c9688414393",
                                                "sense_id": "1b5df7d6-0261-3811-9a10-8f1a9691582d",
                                                "text": "We asked a subset of the population of the town for their opinion."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "subset",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "abbdc0f6-51aa-3d95-969b-6d357dc15919",
                                        "entry_id": "fa3f011e-9514-3e09-8b58-e47413645a99",
                                        "glosses": [
                                            "To take a subset of."
                                        ],
