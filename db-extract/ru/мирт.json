                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Myrte",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "83a12a21-67f2-3e76-862a-4654c80a7b47",
                                        "entry_id": "1cd9aea2-77b2-3f3e-ae6f-4969b38dec84",
                                        "glosses": [
                                            "mediterraner Strauch mit immergrünen Blättern und weißen Blüten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48390126-8e19-4d0a-8d8b-1f08b33dd902",
                                                "sense_id": "83a12a21-67f2-3e76-862a-4654c80a7b47",
                                                "text": "„Im alten Griechenland war die Myrte der Göttin Aphrodite geweiht, der Göttin der Liebe und Schönheit.“"
                                            },
                                            {
                                                "example_id": "b94f6673-7082-4ab1-93cd-34f9023db312",
                                                "sense_id": "83a12a21-67f2-3e76-862a-4654c80a7b47",
                                                "text": "„Bei Damenkränzchen mit ausschließlicher Beteiligung von Jungfrauen, sprich nie verheirateten Frauen gehobeneren Alters, wird mit leicht boshaftem Unterton auch von Jungfernkränzchen gesprochen, ein Wortspiel zu dem aus Myrten geflochtenen Haarkranz.”"
                                            },
                                            {
                                                "example_id": "91e58419-2e7b-4a31-8b3a-6f24cdc5f3eb",
                                                "sense_id": "83a12a21-67f2-3e76-862a-4654c80a7b47",
                                                "text": "„Durch Haine mit wilden Oliven, Maulbeerbäumen und Myrte gelangt man in alte Eichenwälder und schließlich über die Baumgrenze hinaus auf schneebedeckte Gipfel.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
