                                    {
                                        "sense_id": "210b9ce8-54aa-39db-966e-bc94f4e47df8",
                                        "entry_id": "ad6212e5-3a4f-350e-933f-61c7748522b0",
                                        "glosses": [
                                            "Having the psychological condition of erotomania."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aded2509-34f2-474d-b55a-c39b448fabc8",
                                                "sense_id": "210b9ce8-54aa-39db-966e-bc94f4e47df8",
                                                "text": "At all events, whatever be the result, we think it would not be easy for a hypochondriacal gentleman to find a sane lady who would undertake his cure in this manner; and may be equally doubted whether any sane gentleman would undertake the cure of an erotomaniacal damsel. Probably M. Villermay may propose to pair the love-sick of the one sex with the hypochondriacs of the other."
                                            },
                                            {
                                                "example_id": "eb9c9353-9084-4277-9ce1-8692a5aeeae1",
                                                "sense_id": "210b9ce8-54aa-39db-966e-bc94f4e47df8",
                                                "text": "As a vicious hysteric, Bertha Mason’s madness is precipitated by an erotomaniacal response."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
