                    {
                        "sense_id": "db4e05be-6443-3270-9134-6c1b46f1b85a",
                        "entry_id": "0feee32a-04e4-377c-a360-37bc123a463d",
                        "glosses": [
                            "zonder uitspatten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a081f9b-dea0-4a87-bb38-6ca5bd16b0d8",
                                "sense_id": "db4e05be-6443-3270-9134-6c1b46f1b85a",
                                "text": "De beheerste reactie was erg netjes na zo'n zware en directe aanval."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e3653595-cb3e-4f3a-b291-12fdbd682240",
                        "source_entry_id": "0feee32a-04e4-377c-a360-37bc123a463d",
                        "source_sense_id": "db4e05be-6443-3270-9134-6c1b46f1b85a",
                        "source_sense_description": "zonder uitspatten",
                        "target_lang_word": "beherrscht",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "beherrscht",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9854690d-74b4-3482-b49e-91f67134ac36",
                                        "entry_id": "7b196800-50cc-3fdd-8268-6efd812072d2",
                                        "glosses": [
                                            "sich in der Gewalt haben, seine Gefühle / Emotionen unter Kontrolle haben, kontrolliert sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6ea39364-ec98-4b4e-95ae-414931d31f62",
                                                "sense_id": "9854690d-74b4-3482-b49e-91f67134ac36",
                                                "text": "Bei einem Pantomimen ist die Körpersprache äußert beherrscht."
                                            },
                                            {
                                                "example_id": "319a29f5-e752-4487-9289-6435a857fe77",
                                                "sense_id": "9854690d-74b4-3482-b49e-91f67134ac36",
                                                "text": "Seine Stimme, Gestik und Mimik, seine gesamte Ausdrucksweise, alles wirkte total beherrscht."
                                            },
                                            {
                                                "example_id": "13bc4b34-fd07-43de-991e-72617e78a76d",
                                                "sense_id": "9854690d-74b4-3482-b49e-91f67134ac36",
                                                "text": "Die Auskunft wird ihm verweigert, er insistiert, allseits spricht man mit gerade noch beherrschter Stimme, eine Ablehnung des Vorsitzenden Richters wegen Besorgnis der Befangenheit wird zwar noch nicht vorgebracht, aber als Möglichkeit angedeutet, im Antlitz des Oberstaatsanwalts Hartmut Koppenhöfer, 41, wetterleuchten Sätze, die Komplizenschaft zum Thema haben dürften, gleich wird es eine Explosion geben …"
                                            },
                                            {
                                                "example_id": "85a2b890-c311-4cad-a1d6-ecee36fed880",
                                                "sense_id": "9854690d-74b4-3482-b49e-91f67134ac36",
                                                "text": "Mojib Latif ist ein sehr ruhiger, beherrschter Mensch. Für seine Verhältnisse wird er fast ungehalten, wenn er immer und immer wieder versichern und erklären muss, weshalb der Klimawandel kein Ammenmärchen ist."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
