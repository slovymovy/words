                "senses": [
                    {
                        "sense_id": "0bbf86b6-fe21-3103-86c1-3da3d6de63af",
                        "entry_id": "c1710cb0-3eb0-3f96-be17-474baa022055",
                        "glosses": [
                            "etwas, das Licht (Photonen) aussendet, insbesondere im sichtbaren Bereich"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "475f15e0-4f16-47e5-bc1b-8149db881bc0",
                                "sense_id": "0bbf86b6-fe21-3103-86c1-3da3d6de63af",
                                "text": "In der Physik wird häufig von einer punktförmiger Lichtquelle ausgegangen."
                            },
                            {
                                "example_id": "bbacc6b5-6a8f-4276-843b-4d92d480bc5a",
                                "sense_id": "0bbf86b6-fe21-3103-86c1-3da3d6de63af",
                                "text": "„Sie ist die einzige Lichtquelle in dem Zimmer, der Holzboden reflektiert sie schwach.“"
                            },
                            {
                                "example_id": "efff5c9e-6fc7-4adc-9d89-4844bad63e2f",
                                "sense_id": "0bbf86b6-fe21-3103-86c1-3da3d6de63af",
                                "text": "„Ein fahler Schein tauchte plötzlich unter den Wolken auf, bald gab der aufsteigende Dunst die Lichtquelle frei.“"
                            },
                            {
                                "example_id": "9df03077-d65d-43e9-9059-026d884cdbb3",
                                "sense_id": "0bbf86b6-fe21-3103-86c1-3da3d6de63af",
                                "text": "„Die Kerze in ihrer Hand war die einzige Lichtquelle.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
