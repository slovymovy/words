{
    "word_family": [
        "sorbet"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2bc934f9-9414-316e-8d93-4807f240f8ae",
                    "sense_definition": "A frozen dessert made of fruit juice, sugar, and water, with milk, cream, or egg white added.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sweet_food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "For dessert, she chose a scoop of raspberry <w>sherbet</w> instead of chocolate ice cream.",
                            "target_lang_translations": {
                                "pl": "Na deser wybrała gałkę malinowego <w>sorbetu</w> zamiast lodów czekoladowych."
                            }
                        },
                        {
                            "text": "The restaurant serves a refreshing lime <w>sherbet</w> between courses to cleanse the palate.",
                            "target_lang_translations": {
                                "pl": "Restauracja serwuje orzeźwiający limonkowy <w>sorbet</w> między daniami, aby oczyścić kubki smakowe."
                            }
                        }
                    ],
                    "common_phrases": [
                        "orange sherbet",
                        "rainbow sherbet"
                    ],
                    "target_lang_definitions": {
                        "pl": "Mrożony deser owocowy przygotowywany z soku owocowego, cukru i wody, z dodatkiem mleka, śmietanki lub białka jaj."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "sorbet",
                                "target_lang_sense_clarification": "deser mrożony z dodatkiem nabiału"
                            },
                            {
                                "target_lang_word": "lody sorbetowe",
                                "target_lang_sense_clarification": "mrożony deser owocowo-mleczny"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ab5c290f-1b7b-3fe0-bbe1-69a2482630d5",
                    "sense_definition": "An effervescent, fizzy sweet powder eaten by itself or stirred into water to make a drink.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sweet_food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children bought packets of fizzy <w>sherbet</w> with licorice sticks to dip into it.",
                            "target_lang_translations": {
                                "pl": "Dzieci kupiły torebki musującej <w>oranżadki w proszku</w> z lukrecjowymi patyczkami do maczania."
                            }
                        },
                        {
                            "text": "When you stir the <w>sherbet</w> into cold water, it starts bubbling immediately.",
                            "target_lang_translations": {
                                "pl": "Kiedy wsypiesz <w>proszek musujący</w> do zimnej wody, natychmiast zaczyna musować."
                            }
                        }
                    ],
                    "common_phrases": [
                        "sherbet lemon",
                        "sherbet fountain"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Chiefly British"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Słodki, musujący proszek spożywany prosto z torebki lub rozpuszczany w wodzie jako napój."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "oranżadka w proszku",
                                "target_lang_sense_clarification": "musujący słodki proszek"
                            },
                            {
                                "target_lang_word": "proszek musujący",
                                "target_lang_sense_clarification": "słodycz musująca w proszku"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cda77dc6-2f65-379b-a088-ec1fbeb47825",
                    "sense_definition": "A traditional sweet, refreshing drink of West and South Asia, made from sweetened fruit juices, flower petals, or herbs.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "beverage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The host welcomed his guests with a cool glass of rose <w>sherbet</w> on the warm afternoon.",
                            "target_lang_translations": {
                                "pl": "Gospodarz przywitał swoich gości w ciepłe popołudnie chłodną szklanką różanego <w>szerbetu</w>."
                            }
                        },
                        {
                            "text": "Street vendors across the city prepare traditional fruit <w>sherbet</w> during the hot summer months.",
                            "target_lang_translations": {
                                "pl": "Uliczni sprzedawcy w całym mieście przygotowują tradycyjny owocowy <w>szerbet</w> podczas gorących letnich miesięcy."
                            }
                        }
                    ],
                    "synonyms": [
                        "sharbat"
                    ],
                    "common_phrases": [
                        "rose sherbet"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "West and South Asia"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Tradycyjny, słodki i orzeźwiający napój Bliskiego Wschodu oraz Azji Południowej, przygotowywany ze słodzonych soków owocowych, płatków kwiatów lub ziół."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "szerbet",
                                "target_lang_sense_clarification": "tradycyjny słodki napój orientalny"
                            },
                            {
                                "target_lang_word": "szarbat",
                                "target_lang_sense_clarification": "napój orientalny"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8f356de6-6f5a-3858-a02e-e938d72bf205",
                    "sense_definition": "An alcoholic drink, especially beer.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "beverage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They decided to head down to the local pub for a few <w>sherbets</w> after a long shift.",
                            "target_lang_translations": {
                                "pl": "Po długiej zmianie postanowili pójść do lokalnego pubu na parę <w>piwek</w>."
                            }
                        },
                        {
                            "text": "He offered to buy a round of <w>sherbets</w> to celebrate his promotion with his teammates.",
                            "target_lang_translations": {
                                "pl": "Zaoferował, że postawi kolejkę <w>browarków</w>, by uczcić swój awans ze współpracownikami."
                            }
                        }
                    ],
                    "common_phrases": [
                        "a few sherbets"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "British and Australian slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Napój alkoholowy, w szczególności piwo (potocznie)."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "browarek",
                                "target_lang_sense_clarification": "slangowo o piwie"
                            },
                            {
                                "target_lang_word": "piwko",
                                "target_lang_sense_clarification": "slangowo lub potocznie"
                            },
                            {
                                "target_lang_word": "drineczek",
                                "target_lang_sense_clarification": "napój alkoholowy"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}