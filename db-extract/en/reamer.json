                    },
                    {
                        "translation_id": "0e39997f-75c1-4077-89d1-0363fae894d3",
                        "source_entry_id": "c8aad2fa-9ec6-3f3c-81b0-0aa6a93363b0",
                        "source_sense_description": "pipe tool",
                        "target_lang_word": "grattoir",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grattoir",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e0d1b9c3-1645-3ce4-ac3e-7472834e01e1",
                                        "entry_id": "838ea0c4-de7d-372a-85e8-420e797414c0",
                                        "glosses": [
                                            "Outil ou instrument utilisé pour gratter ou pour racler."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5755f09d-4ab0-4f50-8676-cfee018a6c0a",
                                                "sense_id": "e0d1b9c3-1645-3ce4-ac3e-7472834e01e1",
                                                "text": "On a aussi un outil d’acier d’environ six pouces de long, dont un des bouts qu’on appelle Grattoir est formé en triangle, tranchant des trois costez, pour ratisser sur le cuivre, quand il est nécessaire."
                                            },
                                            {
                                                "example_id": "efcf59ff-a8e7-40b4-bfcc-fc0563b9f2f7",
                                                "sense_id": "e0d1b9c3-1645-3ce4-ac3e-7472834e01e1",
                                                "text": "Dans le compartiment, il n’y a que le mode d’emploi du véhicule, un grattoir à givre, un roman policier, un pistolet automatique et une liasse de billets de cinq cents euros épaisse comme un steak américain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5d64247f-80ff-3135-af3a-540b47d1ce59",
                                        "entry_id": "838ea0c4-de7d-372a-85e8-420e797414c0",
                                        "glosses": [
                                            "Instrument propre à gratter le papier, le parchemin, etc., pour en enlever l’écriture ou les taches."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "580a3f90-7249-4f58-9aeb-b1627e8dfddc",
                                                "sense_id": "5d64247f-80ff-3135-af3a-540b47d1ce59",
                                                "text": "Effacer des mots avec un grattoir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4fdd5217-0769-3cb7-a58d-8932cf0a5a6c",
                                        "entry_id": "838ea0c4-de7d-372a-85e8-420e797414c0",
                                        "glosses": [
                                            "Type d’outil préhistorique en silex taillé et retouché."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b2f170d1-feb6-38f5-9574-29c629549bc5",
                                        "entry_id": "838ea0c4-de7d-372a-85e8-420e797414c0",
                                        "glosses": [
                                            "Grille ou lame où l’on gratte ses chaussures avant d’entrer dans une maison; décrottoir ; gratte-pieds."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "07f79508-d2d1-479e-aba7-d7cb0ce9d03f",
                                                "sense_id": "b2f170d1-feb6-38f5-9574-29c629549bc5",
                                                "text": "On m’avait beaucoup parlé de la propreté des Hollandaises ; néanmoins, elle m’a paru fabuleuse : il n’est pas jusqu’aux crémaillères, jusqu’aux plaques des cheminées, aux clous des portes et aux grattoirs pour les pieds, qui ne soient brillants comme des bijoux d’acier ; ces gens-là n’ont pas le goût de la propreté, ils en ont le culte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2fbf1689-e074-3add-8b64-1507403432ca",
                                        "entry_id": "838ea0c4-de7d-372a-85e8-420e797414c0",
                                        "glosses": [
                                            "Outil manuel d’ajusteur, généralement de section triangulaire, qui fonctionne par arrachement d’un copeau."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
