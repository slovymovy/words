                        "form": "sie sind frühneuzeitlich"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c621f009-31e4-383d-9a68-5ea223b120b7",
                        "entry_id": "b3064517-af33-3cf2-ae36-737373826216",
                        "glosses": [
                            "die Frühneuzeit betreffend, in der Frühneuzeit (geschehend)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "344f1d06-5cdc-49a2-8fa7-1c0c1e9d5a12",
                                "sense_id": "c621f009-31e4-383d-9a68-5ea223b120b7",
                                "text": "„Der Band beschäftigt sich mit der Präsenz des Italienischen im frühneuzeitlichen Frankreich.“"
                            },
                            {
                                "example_id": "fe4002c4-4399-4606-8917-f6ff0a64a24e",
                                "sense_id": "c621f009-31e4-383d-9a68-5ea223b120b7",
                                "text": "„Der frühneuzeitliche Staat versuchte, Seuchen einzudämmen, der moderne Staat sorgte vor durch das Impfen.“"
                            },
                            {
                                "example_id": "e8271eb6-5d08-4af2-8d8a-92d5d376e1b6",
                                "sense_id": "c621f009-31e4-383d-9a68-5ea223b120b7",
                                "text": "„Auch der frühneuzeitliche Alltag scheint weniger gewaltvoll gewesen zu sein, obwohl das innerhäusliche Leben in den Dokumenten notorisch schwer zu fassen ist.“"
                            },
                            {
                                "example_id": "cce31869-0956-4555-9ee4-969b0ff2a309",
