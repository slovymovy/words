                "senses": [
                    {
                        "sense_id": "46ba1885-50e9-34ad-a152-2691d697eef0",
                        "entry_id": "e9abf500-dc51-36f0-91d9-c2c2d46bddd1",
                        "glosses": [
                            "(männliche^☆) Person, die (professionell) Salsa tanzt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c4b30ea8-320a-4506-8592-90640c06d035",
                                "sense_id": "46ba1885-50e9-34ad-a152-2691d697eef0",
                                "text": "Die Salsatänzer wurden vom Publikum bejubelt."
                            },
                            {
                                "example_id": "fa3ec6ff-62f6-487c-81ce-0d4719c90d65",
                                "sense_id": "46ba1885-50e9-34ad-a152-2691d697eef0",
                                "text": "„Dudamel will dies allerdings nicht zu sehr betont wissen, witzelt, ein übler Salsatänzer zu sein.“"
                            },
                            {
                                "example_id": "c195f440-8139-41d3-811d-656b68b7df7d",
                                "sense_id": "46ba1885-50e9-34ad-a152-2691d697eef0",
                                "text": "„Vor allem Salsatänzer finden sich unter ihren Schülern.“"
                            },
                            {
                                "example_id": "db09b761-daa3-4fc3-86a4-610ca1d2ad27",
                                "sense_id": "46ba1885-50e9-34ad-a152-2691d697eef0",
                                "text": "„Das erstaunt insofern, als der begnadete Salsatänzer gut ankommt bei der Damenwelt.“"
                            },
                            {
                                "example_id": "275d57f5-18be-458d-a430-7bdd7cdb7107",
                                "sense_id": "46ba1885-50e9-34ad-a152-2691d697eef0",
                                "text": "„Die besten Salsatänzer Deutschlands treffen am Samstag, 15. Oktober, in Sulz aufeinander, um bei der offenen deutschen Meisterschaft ihr Können unter Beweis zu stellen.“"
                            }
                        ],
