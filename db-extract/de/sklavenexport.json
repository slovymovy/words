                "senses": [
                    {
                        "sense_id": "b59eb909-c716-3bd9-8e2b-9a63d8b853e2",
                        "entry_id": "3f7b3055-93da-35f7-b7be-fbb3b715afee",
                        "glosses": [
                            "die Ausfuhr von Sklaven"
