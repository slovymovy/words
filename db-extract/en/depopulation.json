        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "78df3d64-0d7c-3742-a17f-bda67e22e2da",
                "word": "depopulation",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "7f1b4992-f119-47fc-bc79-087c8d423e2a",
                        "entry_id": "78df3d64-0d7c-3742-a17f-bda67e22e2da",
                        "tags": [
                            "plural"
                        ],
                        "form": "depopulations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a8d99089-022c-3af3-900c-038e31f5e896",
                        "entry_id": "78df3d64-0d7c-3742-a17f-bda67e22e2da",
                        "glosses": [
                            "The act of depopulating or condition of being depopulated; the destruction or expulsion of inhabitants."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "773c9ac5-8f2d-4aa2-9097-159ad12f32d9",
                                "sense_id": "a8d99089-022c-3af3-900c-038e31f5e896",
                                "text": "A 2022 report published by the Scottish Borders Council states: \"Hawick has been affected more by depopulation than any other Borders town, with all parts of the town experiencing population loss, and Hawick Central is currently experiencing the highest depopulation out of the 30 Intermediate Zones in Scottish Borders.\""
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f8bd7cb2-12fd-4615-bcab-1e9a034f0c11",
                        "source_entry_id": "78df3d64-0d7c-3742-a17f-bda67e22e2da",
                        "source_sense_id": "a8d99089-022c-3af3-900c-038e31f5e896",
                        "source_sense_description": "act or condition of depopulating",
                        "target_lang_word": "ontvolking",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ontvolking",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "1a47d099-d0dd-3036-a5cb-144d629328f3",
                                        "entry_id": "113a72f5-6f03-31b7-a08f-c2a6c6ce1b39",
                                        "glosses": [
                                            "aanzienlijke vermindering van het aantal inwoners"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e2c0e94-9bc7-4544-8cd5-29edf5b67974",
                                                "sense_id": "1a47d099-d0dd-3036-a5cb-144d629328f3",
                                                "text": "De bevolking van de stad mag dan van zo’n 175.000 inwoners in 1950 zijn gedaald tot 40.000 nu, de huizenprijzen zijn vooral de afgelopen twee decennia hard gestegen. (…) Het einde van de ontvolking is dan ook nog niet in zicht in Venetië, dat nu, net als voor de coronatijd, weer onder de voet wordt gelopen door miljoenen toeristen."
                                            },
                                            {
                                                "example_id": "c8700421-4256-4ab3-a6aa-98b02b2a56dd",
                                                "sense_id": "1a47d099-d0dd-3036-a5cb-144d629328f3",
                                                "text": "Daar waar mijnen en fabrieken gesloten zijn of de landbouw geen werk meer biedt, is de ontvolking het hardst gegaan."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a192c3d7-c242-32df-83bf-ecc1cee71158",
                                        "entry_id": "113a72f5-6f03-31b7-a08f-c2a6c6ce1b39",
                                        "glosses": [
                                            "verwijdering van de inwoners uit een gebied"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "372b7ffd-e6db-40bd-9414-1496398045dd",
                                                "sense_id": "a192c3d7-c242-32df-83bf-ecc1cee71158",
                                                "text": "Ten slotte is er de meest omstreden actie van Coen, die dan inmiddels gouverneur-generaal is, de ontvolking van Banda, de verwoesting van nootmuskaatbomen en de concentratie van de nootmuskaatteelt op één eiland. In hedendaagse termen: executies, etnische zuiveringen, deportatie en extirpatie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "64219d68-c461-4811-b81b-57009d30a08d",
                        "source_entry_id": "78df3d64-0d7c-3742-a17f-bda67e22e2da",
                        "source_sense_id": "a8d99089-022c-3af3-900c-038e31f5e896",
                        "source_sense_description": "act or condition of depopulating",
                        "target_lang_word": "dépeuplement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dépeuplement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "517dde2b-3beb-37c6-8bf9-d51be5de66b8",
                                        "entry_id": "2f1271ab-65ac-383b-ad29-9b4edff1db91",
                                        "glosses": [
                                            "Action de dépeupler ou de se dépeupler."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "164d50a1-8911-4af0-96f0-e3f1c61c0ff5",
                                                "sense_id": "517dde2b-3beb-37c6-8bf9-d51be5de66b8",
                                                "text": "À terme, il conduira au dépeuplement des plateaux, après avoir nourri une importante émigration hors frontière."
                                            },
                                            {
                                                "example_id": "c56ef477-4aaa-424b-9bf8-b5f816b6bbba",
                                                "sense_id": "517dde2b-3beb-37c6-8bf9-d51be5de66b8",
                                                "text": "Le dépeuplement d’un étang, d’un canton de chasse. — Les guerres continuelles causent le dépeuplement des états."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "29319740-51a3-3910-b3a4-b00e12c000d5",
                                        "entry_id": "2f1271ab-65ac-383b-ad29-9b4edff1db91",
                                        "glosses": [
                                            "Abattage de toutes les bêtes d'un troupeau"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "468a76e7-d564-4923-83e0-440e74d0649b",
                                                "sense_id": "29319740-51a3-3910-b3a4-b00e12c000d5",
                                                "text": "Suspectant un foyer de grippe aviaire dans un élevage de canards, la préfecture des Landes a mis en place un périmètre de contrôle temporaire autour de cette exploitation qui est en cours de dépeuplement à titre préventif."
                                            },
                                            {
                                                "example_id": "4358fa38-1749-4ea7-9b08-0b15ec4a89a7",
                                                "sense_id": "29319740-51a3-3910-b3a4-b00e12c000d5",
                                                "text": "Si on ne faisait que des dépeuplements partiels, il faudrait analyser toutes les bêtes de tous les élevages tous les jours. Si l’on épargne les animaux sans symptômes, on ne va jamais arrêter le cycle."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3428746a-ec83-4bbe-bbc3-07ccb50aa2e9",
