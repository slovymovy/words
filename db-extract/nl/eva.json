                                "target_senses": [
                                    {
                                        "sense_id": "2810ba42-94d4-3fcc-8281-726c609ed007",
                                        "entry_id": "474426ce-456b-30ff-8e36-bb7cbf7392db",
                                        "glosses": [
                                            "Prénom féminin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e59a110-95a6-41fc-b247-f9a4822b4841",
                                                "sense_id": "2810ba42-94d4-3fcc-8281-726c609ed007",
                                                "text": "Ève, qui devinait les tortures de cette modestie, se plut à jouir de ce silence ; mais quand David tortilla son chapeau pour s’en aller, elle sourit."
                                            },
                                            {
                                                "example_id": "928fba72-503e-4681-aa3a-d0546ee1391a",
                                                "sense_id": "2810ba42-94d4-3fcc-8281-726c609ed007",
                                                "text": "Hakim Belaroussi (institut Capeline), Nelly El Shafey (Hypsome), Capucine Huguet (Capucine H), Émilie Geissler (restauration de tableaux), Marie-Cécile Kfouri (restauration et conservation de peintures) et Ève Mallet-Mire (architecture de design d’intérieur) viennent rejoindre les précédents lauréats."
                                            },
                                            {
                                                "example_id": "6c6dbf48-1c54-4757-b6dc-49e5423518dc",
                                                "sense_id": "2810ba42-94d4-3fcc-8281-726c609ed007",
                                                "text": "Melvine Malard à fait le taf. Comme Ève Périsset l’avait fait avant."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
