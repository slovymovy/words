                                "target_senses": [
                                    {
                                        "sense_id": "ed32c0ee-7a4b-3295-aef9-e8e8333033bf",
                                        "entry_id": "b116eda5-5b87-3e6e-8e20-9e378b30a664",
                                        "glosses": [
                                            "automatisiertes Computerprogramm, das virtuell mit realen Personen kommunizieren kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd9dbed4-f0e1-454d-bd28-06d1c2b19fe8",
                                                "sense_id": "ed32c0ee-7a4b-3295-aef9-e8e8333033bf",
                                                "text": "„Chatbots sind inzwischen weitverbreitet, nicht nur in der Bankbranche.“"
                                            },
                                            {
                                                "example_id": "c79ba434-3f00-4c87-824e-9dcfbcf9ed5d",
                                                "sense_id": "ed32c0ee-7a4b-3295-aef9-e8e8333033bf",
                                                "text": "„Chatbots sind darauf ausgelegt, mit menschlichen Benutzern auf eine Weise zu interagieren, die so natürlich wie möglich wirkt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
