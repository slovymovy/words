                                        "entry_id": "9035e0ad-cbc1-3ddd-990c-3f730898a2e0",
                                        "glosses": [
                                            "Schmuckstück in Form einer Plakette oder Scheibe, das oft als Hals- oder Armbandanhänger getragen wird und auf einer Seite ein eingraviertes oder geprägtes Bild oder Symbol trägt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ed38538-89d9-4660-89e2-58ee5ee62de4",
                                                "sense_id": "325efb35-c8d9-3d3a-b321-dc35410cb228",
                                                "text": "Sie trägt ein Medaillon mit dem Bild ihres Mannes."
                                            },
                                            {
                                                "example_id": "68af25c5-569e-4372-b85c-8eae1d51a2b1",
                                                "sense_id": "325efb35-c8d9-3d3a-b321-dc35410cb228",
                                                "text": "„Er findet ein Medaillon, auf dem eine Menschenfrau abgebildet ist, verliebt sich in das Bild.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "df5b76da-b508-310e-8844-4c69fa7d9305",
