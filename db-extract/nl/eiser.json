                                            {
                                                "example_id": "3cc5384b-8c72-458e-ae58-71f8eba6972a",
                                                "sense_id": "407093cb-7f99-3651-b332-b11761367776",
                                                "text": "Les parties requérantes."
                                            },
                                            {
                                                "example_id": "256a9660-8cfb-4c4a-8a35-9dee648179f1",
                                                "sense_id": "407093cb-7f99-3651-b332-b11761367776",
                                                "text": "Dans cette même requête, les associations requérantes affirment que le juge François Rolland a commis plusieurs « erreurs de droit », notamment en affirmant que les articles 16 et 17 de la loi 78 ne « prohibent pas les manifestations »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d3528682-aead-3c50-b2cb-ca0b13aafd93",
                                        "entry_id": "1b24e5df-d65f-3b77-b457-3bcdf5c83432",
                                        "glosses": [
                                            "Se dit d'un chien qui cherche a retrouver la voie qu'il a perdue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c57611a0-41bf-4c3f-9149-1e4daf6c647c",
                                                "sense_id": "d3528682-aead-3c50-b2cb-ca0b13aafd93",
                                                "text": "Chienne très entreprenante, très requérante, infatigable, elle savait explorer le terrain comme personne, méthodiquement, distinguant parfaitement l'espace exploré de celui qui restait à découvrir."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "requérant",
                                "target_lang_code": "fr",
                                "target_senses": [
