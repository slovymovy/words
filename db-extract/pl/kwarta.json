                                        "sense_id": "6e0bd532-721c-3588-a881-a6a61b44d5f9",
                                        "entry_id": "660f0f63-f7fa-3d50-87fc-76ddefa6f75e",
                                        "glosses": [
                                            "Féminin singulier de quart.",
                                            "Qualifie une fièvre survenant chaque quatrième jour comme dans certaines formes de paludisme (cas de Plasmodium malariae chez l'humain)."
                                        ],
                                        "tags": [
                                            "dated",
                                            "form-of",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d0674b99-5f02-4edf-9d59-ac69c7a2fc6f",
                                                "sense_id": "6e0bd532-721c-3588-a881-a6a61b44d5f9",
                                                "text": "Beaucoup d’observateurs admettent l’existence de plusieurs espèces d’hématozoaires du paludisme : hématozoaires des fièvres tropicales, de la tierce et de la quarte. Je pense qu'il s'agit de simples variétés d'une même espèce polymorphe."
                                            }
