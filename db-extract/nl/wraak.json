                    {
                        "sense_id": "2e43439c-1fc2-3f37-9392-3dbf15a456bb",
                        "entry_id": "07ba2b79-0743-3300-86f1-b11a3d243829",
                        "glosses": [
                            "het vergelden van doorgemaakt lijden #:▸ Maar dan, op een dag, wordt er een steen geworpen - en of het nu per ongeluk of expres is, die steen raakt de voorruit van de auto van een of andere machtige idioot die wraak wil, of die indruk op zijn minnares wil maken en - zoef - daar komen de voetsoldaten al binnenmarcheren."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "0fd1b7b8-e635-3672-b96d-86b6c5b40c9d",
                        "entry_id": "07ba2b79-0743-3300-86f1-b11a3d243829",
                        "glosses": [
                            "voornemen om het doorgemaakte lijden te vergelden aan de veroorzaker"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ea703ff-e8ad-450b-a2c7-46267fa69571",
                                "sense_id": "0fd1b7b8-e635-3672-b96d-86b6c5b40c9d",
                                "text": "In veel gevallen was de politiek een dekmantel voor persoonlijke wraak en familievetes."
                            },
                            {
                                "example_id": "c80ce900-7819-40b2-a82f-aafcf2155acb",
                                "sense_id": "0fd1b7b8-e635-3672-b96d-86b6c5b40c9d",
                                "text": "Aan weerskanten brullen kerels als gekken om zichzelf te verdoven, om zichzelf moed te geven. Anderen rennen net als hij, geconcentreerd, de zenuwen in hun buik, met droge keel. Ze stormen allemaal op de vijand af, gewapend met een onherroepelijke woede, een verlangen naar wraak."
                            }
                        ]
                    },
                    {
                        "sense_id": "d3268b57-5811-3d4c-b244-dc814e72eef6",
                        "entry_id": "07ba2b79-0743-3300-86f1-b11a3d243829",
                        "glosses": [
                            "straf"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "69376929-79c3-3fd8-ac27-3fd04bebcb98",
                        "entry_id": "07ba2b79-0743-3300-86f1-b11a3d243829",
                        "glosses": [
                            "uit koers raken"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "eef47ba4-3e85-40de-a39f-b99c5ff10f00",
                        "source_entry_id": "07ba2b79-0743-3300-86f1-b11a3d243829",
                        "source_sense_id": "2e43439c-1fc2-3f37-9392-3dbf15a456bb",
                        "source_sense_description": "het vergelden van doorgemaakt lijden",
                        "target_lang_word": "Rache",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rache",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8ec678db-db5c-34fe-9740-a5208be16f2f",
                                        "entry_id": "d095bc13-e511-341b-9b87-0784576179b2",
                                        "glosses": [
                                            "Handlung gegen eine oder mehrere Personen mit beabsichtigten negativen Auswirkungen als Reaktion auf ein erlittenes (manchmal auch nur vermeintliches) Unrecht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3972338-b00e-44d7-ae31-1110c73e524c",
                                                "sense_id": "8ec678db-db5c-34fe-9740-a5208be16f2f",
                                                "text": "Sein Sohn wurde ermordet. Nun will er Rache."
                                            },
                                            {
                                                "example_id": "5c17e93f-d9d2-4b57-9869-f31fbc442fd1",
                                                "sense_id": "8ec678db-db5c-34fe-9740-a5208be16f2f",
                                                "text": "„Es war eine Zeit blutiger Kämpfe, aber nicht um Land und Besitz, sondern um Ehre und Tapferkeit, vor allem aber um Rache für erlittene Beleidigungen.“"
                                            },
                                            {
                                                "example_id": "05cb1d33-3826-4d77-9ce3-0b40aee45eda",
                                                "sense_id": "8ec678db-db5c-34fe-9740-a5208be16f2f",
                                                "text": "„Sarale fuhr entsetzt hoch, sprang von der Bank, bereit zur Rache, brüllend wie ein verwundetes Tier und zitternd vor schrecklicher Angst.“"
                                            },
                                            {
                                                "example_id": "2768dd82-3ff4-442a-a3bf-57bfc4de88bf",
                                                "sense_id": "8ec678db-db5c-34fe-9740-a5208be16f2f",
                                                "text": "„Da ich erst zwölf Jahre alt war, hatte mein Geist noch nicht die Kaltblütigkeit erlangt, Pläne für eine heroische Rache zu schmieden, wie sie das eingebildete Ehrgefühl ausheckt.“"
                                            },
                                            {
                                                "example_id": "7f28f7ee-3505-44a7-a37a-549f2a3d75c0",
                                                "sense_id": "8ec678db-db5c-34fe-9740-a5208be16f2f",
                                                "text": "„Der Tod war das Geringste, was sie von Menschen zu erwarten hatten, deren Rache und Blutdurst durch eine lange Folgenreihe von Unterdrückungen so furchtbar aufgeregt waren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c7c81465-5f37-4aa2-8830-e563262bebfb",
                        "source_entry_id": "07ba2b79-0743-3300-86f1-b11a3d243829",
                        "source_sense_id": "2e43439c-1fc2-3f37-9392-3dbf15a456bb",
                        "source_sense_description": "het vergelden van doorgemaakt lijden",
                        "target_lang_word": "revenge",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "revenge",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ad268b28-e50c-3c88-b65c-bccc99551393",
                                        "entry_id": "50538b14-1a61-3855-9d7d-44f976b56d82",
                                        "glosses": [
                                            "Any form of personal, retaliatory action against an individual, institution, or group for some alleged or perceived harm or injustice."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aefcf2bd-ff20-411c-b156-a80d92aa2df9",
                                                "sense_id": "ad268b28-e50c-3c88-b65c-bccc99551393",
                                                "text": "Indifference is the sweetest revenge."
                                            },
                                            {
                                                "example_id": "808340c5-422e-411d-8aa7-f47d953914a1",
                                                "sense_id": "ad268b28-e50c-3c88-b65c-bccc99551393",
                                                "text": "When I left my wife, she tried to set fire to the house in revenge."
                                            },
                                            {
                                                "example_id": "6e7b4692-451b-4948-88cb-e2e5f21d0c60",
                                                "sense_id": "ad268b28-e50c-3c88-b65c-bccc99551393",
                                                "text": "After tearing his fave T-shirt unintentionally, my brother wreaked revenge on me by ripping my most prized blazer apart."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "377413da-2cf9-358b-994c-c6f9c60c7c91",
                                        "entry_id": "50538b14-1a61-3855-9d7d-44f976b56d82",
                                        "glosses": [
                                            "A win by a previous loser."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6794e744-f55a-4075-97bd-81bcad1524a4",
                                                "sense_id": "377413da-2cf9-358b-994c-c6f9c60c7c91",
                                                "text": "“I'm through with all pawn-games,” I laughed. “Come, let us have a game of lansquenet. Either I will take a farewell fall out of you or you will have your sevenfold revenge”."
                                            },
                                            {
                                                "example_id": "504f5928-4243-42ee-aa6f-54fb404c7b30",
                                                "sense_id": "377413da-2cf9-358b-994c-c6f9c60c7c91",
                                                "text": "CHAOTICA: Arachnia, death as you know it has no hold on me. My defeat is but a temporary setback. I shall return to seek my revenge.\nJANEWAY: He doesn't give up, does he?\nPARIS: They never do.\nCHAOTICA: Our love was not meant to be, my Queen. But be warned. You have not seen the last of (gurgle) Chaotica."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "revenge",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "638a697d-a8e7-3266-8bd1-7ffc9f3cc32e",
                                        "entry_id": "dbea435c-c0b7-34c2-90a7-b8d32d9d8ae8",
                                        "glosses": [
                                            "To take revenge for (a particular harmful action) or on behalf of (its victim); to avenge."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0af17023-6526-425b-80dd-1e254074b7de",
                                                "sense_id": "638a697d-a8e7-3266-8bd1-7ffc9f3cc32e",
                                                "text": "Arsenal revenged their loss to Manchester United last time with a 5–0 drubbing this time."
                                            },
                                            {
                                                "example_id": "9f2e4597-5fec-4799-9a05-105648586756",
                                                "sense_id": "638a697d-a8e7-3266-8bd1-7ffc9f3cc32e",
                                                "text": "The gods are just, and will revenge our cause."
                                            },
                                            {
                                                "example_id": "bd4f9812-0a1d-4578-81a7-c0a8f5c142d5",
                                                "sense_id": "638a697d-a8e7-3266-8bd1-7ffc9f3cc32e",
                                                "text": "to revenge the death of our fathers"
                                            },
                                            {
                                                "example_id": "f3cb2c10-a052-498c-a552-6ff32b24f1a5",
                                                "sense_id": "638a697d-a8e7-3266-8bd1-7ffc9f3cc32e",
                                                "text": "However, my veneration for that illustrious man was so great, that on the night when he died, I revenged him finely on his two principal enemies."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "08d33abb-6119-30a5-bf7e-d4e41e87b42a",
                                        "entry_id": "dbea435c-c0b7-34c2-90a7-b8d32d9d8ae8",
                                        "glosses": [
                                            "To take one's revenge (on or upon someone)."
                                        ],
                                        "tags": [
                                            "reflexive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "931f180b-e7b2-4319-9422-726f6d57cd68",
                                                "sense_id": "08d33abb-6119-30a5-bf7e-d4e41e87b42a",
                                                "text": "Come, Antony, and young Octavius, come,\n Revenge yourselves alone on Cassius."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4fd8ecb8-b02a-3920-b64e-b2880b4c623e",
                                        "entry_id": "dbea435c-c0b7-34c2-90a7-b8d32d9d8ae8",
                                        "glosses": [
                                            "To take vengeance; to revenge itself."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "95a718de-1b4f-4785-bb32-e88660862fff",
                                                "sense_id": "4fd8ecb8-b02a-3920-b64e-b2880b4c623e",
                                                "text": "a bird that will revenge upon you all"
                                            },
                                            {
                                                "example_id": "2f9e7082-3c9b-42f2-906b-23c0f0682f9c",
                                                "sense_id": "4fd8ecb8-b02a-3920-b64e-b2880b4c623e",
                                                "text": "Count it not hard henceforth, when thou dost hear\n That a just vengeance was by righteous court\n Justly reveng'd. […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "845b066b-d878-4cf4-ace6-8c971e7a2158",
                        "source_entry_id": "07ba2b79-0743-3300-86f1-b11a3d243829",
                        "source_sense_id": "2e43439c-1fc2-3f37-9392-3dbf15a456bb",
                        "source_sense_description": "het vergelden van doorgemaakt lijden",
                        "target_lang_word": "vengeance",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vengeance",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7ae18c6e-3164-3b42-87f7-a2a438d31b58",
                                        "entry_id": "ec1c4d6a-36a1-3962-860e-2173adefaa18",
                                        "glosses": [
                                            "Revenge taken for an insult, injury, or other wrong."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "db2ac284-822f-47a7-be16-92600544c35b",
                                                "sense_id": "7ae18c6e-3164-3b42-87f7-a2a438d31b58",
                                                "text": "All the gods have mocked at prayer. This sin must now be punished by the vengeance of men."
                                            },
                                            {
                                                "example_id": "7b8e4fa9-b954-4bc7-8e30-a4d3b8ad40f6",
                                                "sense_id": "7ae18c6e-3164-3b42-87f7-a2a438d31b58",
                                                "text": "My name is Maximus Decimus Meridius, commander of the Armies of the North; General of the Felix Legions; loyal servant to the true emperor, Marcus Aurelius; father to a murdered son; husband to a murdered wife; and I will have my vengeance, in this life or the next."
                                            },
                                            {
                                                "example_id": "274579ae-c54b-4af7-b31d-cc3f76ffa154",
                                                "sense_id": "7ae18c6e-3164-3b42-87f7-a2a438d31b58",
                                                "text": "Penn: I don't want to invest in the conversation, not that I don't have it privately, about my feelings about what direct action should happen to a leader who does that, but if there is a God, there will be vengeance beyond all possible comprehension.\nHannity: \"Vengeance is mine saith the Lord\", quoted in a very famous book."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a44b3f06-bf52-35fd-be55-4893a6f7c599",
                                        "entry_id": "ec1c4d6a-36a1-3962-860e-2173adefaa18",
                                        "glosses": [
                                            "Desire for revenge."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "228801fc-1570-41ac-b56a-4912dc3cc920",
                                                "sense_id": "a44b3f06-bf52-35fd-be55-4893a6f7c599",
                                                "text": "Thereupon full of anger, full of jealousy, full of vengeance, she forms […] a scheme of retribution, […]"
                                            },
                                            {
                                                "example_id": "0fac21d9-e516-4344-af5b-d226979ed32d",
                                                "sense_id": "a44b3f06-bf52-35fd-be55-4893a6f7c599",
                                                "text": "If her husband was all forgiveness, asking the bands to play “Dixie,” she was full of vengeance […]"
                                            },
                                            {
                                                "example_id": "0390f855-b073-40ca-b0c3-68a6c8be15ab",
                                                "sense_id": "a44b3f06-bf52-35fd-be55-4893a6f7c599",
                                                "text": "Are they full of vengeance[?], because they say that people with vengeance in their hearts must dig two graves, one for their enemy and the other for themselves."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "796ca4ac-7e7a-4d0e-8c89-8942525f1dd4",
                        "source_entry_id": "07ba2b79-0743-3300-86f1-b11a3d243829",
                        "source_sense_id": "2e43439c-1fc2-3f37-9392-3dbf15a456bb",
                        "source_sense_description": "het vergelden van doorgemaakt lijden",
                        "target_lang_word": "vengeance",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vengeance",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "61437f8b-663a-3ee3-ac99-398630bdebec",
                                        "entry_id": "de9c4830-3469-3838-b4e6-397858528f7b",
                                        "glosses": [
                                            "Peine causée à l’offenseur pour la satisfaction personnelle de l’offensé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e940a8d-094d-469c-87b0-c27302b2d092",
                                                "sense_id": "61437f8b-663a-3ee3-ac99-398630bdebec",
                                                "text": "La vengeance est le plaisir des dieux ; et, s’ils se la sont réservée, comme nous le disent les prêtres, c’est parce qu’ils la regardent comme une jouissance trop précieuse pour de simples mortels."
                                            },
                                            {
                                                "example_id": "aa1c08d3-f729-4d82-9a2f-44e144c67a7d",
                                                "sense_id": "61437f8b-663a-3ee3-ac99-398630bdebec",
                                                "text": "La vengeance est permise, […], c’est le droit imprescriptible du faible et de l’opprimé ; cependant, elle doit être proportionnée à l’injure reçue."
                                            },
                                            {
                                                "example_id": "5530dec7-d430-4d80-abb1-9cbd447e11d6",
                                                "sense_id": "61437f8b-663a-3ee3-ac99-398630bdebec",
                                                "text": "Malheur à toi, dormeur silencieux, chair vile,\nEsprit que la vengeance éternelle a sacré,\nToi qui n’as jamais cru, ni jamais espéré !"
                                            },
                                            {
                                                "example_id": "859f33dd-7874-4600-8af6-9ec0d0ab5572",
                                                "sense_id": "61437f8b-663a-3ee3-ac99-398630bdebec",
                                                "text": "La vengeance est un plat qui se déguste glacé, mais se délivre brûlant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "011d196b-8a45-3359-aac9-b6e5c0c607e0",
                                        "entry_id": "de9c4830-3469-3838-b4e6-397858528f7b",
                                        "glosses": [
                                            "Désir de se venger."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fa56369e-209b-4847-9647-5969be405ed7",
                                                "sense_id": "011d196b-8a45-3359-aac9-b6e5c0c607e0",
                                                "text": "On passe ainsi de la jalousie à la vengeance, et on sait que la vengeance est un sentiment d’une puissance extraordinaire, surtout chez les êtres faibles."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
