                ],
                "senses": [
                    {
                        "sense_id": "96ffec8a-ad0e-3a09-929b-fe4a1ab53c14",
                        "entry_id": "c38bfa8e-5a71-30e0-8505-3094eb8c890c",
                        "glosses": [
                            "beabsichtigte oder auch nicht beabsichtigte geruchliche Wirkung mit überraschender Auswirkung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "711dd46a-4570-4f29-94f6-8ec80b1b0232",
                                "sense_id": "96ffec8a-ad0e-3a09-929b-fe4a1ab53c14",
                                "text": "„Die erste Station der Rechenanlage (Abtrennung von Grobstoffen) erzeugte einen gewissen Geruchseffekt und eine gewisse Verwunderung: Das WC ist doch kein Mülleimer!“"
                            },
                            {
                                "example_id": "424a1d72-d443-41f4-8976-4dd0ed28796c",
                                "sense_id": "96ffec8a-ad0e-3a09-929b-fe4a1ab53c14",
                                "text": "„Die TRW geschl. AG leistet ihr Bestes für den Schutz der Wassergewinnungsstellen, die fachgerechte Entsorgung der Abwasserschlamme sowie für die Verminderung der bei der Abwasserableitung bzw. -Klärung entstehenden Geruchseffekte.“"
                            },
                            {
                                "example_id": "92001f10-e7e1-4ada-9fef-db5b1f1b670d",
                                "sense_id": "96ffec8a-ad0e-3a09-929b-fe4a1ab53c14",
                                "text": "„Und schon kann sie beginnen, die Entdeckertour durch den deutschen Wald: Insgesamt 180 verschiedene Bildmotive – inklusive Sonderstickern mit Leucht-, Glanz- oder Geruchseffekt – können gesammelt werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e2da551c-6a0c-395d-a416-3598f724aa35",
                        "entry_id": "c38bfa8e-5a71-30e0-8505-3094eb8c890c",
                        "glosses": [
                            "Anwendung eines Tricks, einer Technik oder eines Verfahren, dass geruchlich überraschend und beeindruckend wirken soll"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a289310d-3d46-4910-a039-93f872739d90",
                                "sense_id": "e2da551c-6a0c-395d-a416-3598f724aa35",
                                "text": "„Und schon kann sie beginnen, die Entdeckertour durch den deutschen Wald: Insgesamt 180 verschiedene Bildmotive – inklusive Sonderstickern mit Leucht-, Glanz- oder Geruchseffekt – können gesammelt werden.“"
                            },
                            {
                                "example_id": "d8900218-5aec-493a-8b35-f673feb04cce",
                                "sense_id": "e2da551c-6a0c-395d-a416-3598f724aa35",
                                "text": "„Die französische Firma Olf-action hat in Kooperation mit dem Behance Network ein neues Gerät entwickelt, das Geruchseffekte zu Filmen und Videospielen produzieren soll.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
