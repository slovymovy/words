                        "glosses": [
                            "Haltestelle, an der nur auf Wunsch eines Fahrgastes angehalten wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b57b34eb-65a2-46ee-849a-baf320b2f3f7",
                                "sense_id": "71ae2109-dcff-3cfd-baf1-a84518243c4d",
                                "text": "„Würden die langen Standzeiten der Züge an einigen Bahnhöfen von bis zu zwölf Minuten verkürzt, könne Bedarfshalt wohl ohne Zeitverlust eingeführt werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
