        "fr-extract.jsonl": [
            {
                "entry_id": "9289c5e5-a8a4-3be1-b5cc-8a1e025e350d",
                "word": "flottille",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "6602fc2c-1fc9-4118-9364-c13c38e97f36",
                        "entry_id": "9289c5e5-a8a4-3be1-b5cc-8a1e025e350d",
                        "tags": [
                            "plural"
                        ],
                        "form": "flottilles"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5104fab8-8c07-3e3d-8e46-50ed7211d84d",
                        "entry_id": "9289c5e5-a8a4-3be1-b5cc-8a1e025e350d",
                        "glosses": [
                            "Flotte de plusieurs petits bâtiments."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c099899f-337f-4c42-8a3a-988cf2363566",
                                "sense_id": "5104fab8-8c07-3e3d-8e46-50ed7211d84d",
                                "text": "Vers ce même temps, le capitaine Robson étant à soixante milles du navire sur le cutter, attaqua une flottille de pirogues de Vilear et en prit quatorze."
                            },
                            {
                                "example_id": "24151be7-f0b1-4f68-a7dd-493d03aef906",
                                "sense_id": "5104fab8-8c07-3e3d-8e46-50ed7211d84d",
                                "text": "Toute la flottille de pêche se trouve, sans doute, en ce moment dans le golfe Kotzebue, à l’entrée du détroit."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7a6aca69-54ed-468e-9e9a-a650abb30774",
                        "source_entry_id": "9289c5e5-a8a4-3be1-b5cc-8a1e025e350d",
                        "source_sense_id": "5104fab8-8c07-3e3d-8e46-50ed7211d84d",
                        "target_lang_word": "Flottille",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Flottille",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4c93307d-29ec-3f7f-8b5f-da3eb5df2e5e",
                                        "entry_id": "393f3c29-f762-313a-b4a5-81d26730da06",
                                        "glosses": [
                                            "Teilverband einer Flotte, Verband kleiner Kriegsschiffe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "703e79fb-49f1-468b-92bb-cc7484ee2e27",
                                                "sense_id": "4c93307d-29ec-3f7f-8b5f-da3eb5df2e5e",
                                                "text": "„Nun, dachte ich, kann nichts mehr schiefgehen, und machte mich auf die lange Reise zur Flottille zurück.“"
                                            },
                                            {
                                                "example_id": "d94ceb9c-21cd-4462-aadb-80f295fb519e",
                                                "sense_id": "4c93307d-29ec-3f7f-8b5f-da3eb5df2e5e",
                                                "text": "„Der Tragweite dieser Verfehlung waren sie sich schwerlich bewußt; denn in aller Arglosigkeit ließen sie die kleine Flottille sogar vor dem tarentinischen Hafen Anker werfen und waren deshalb sehr erstaunt, als die Tarentiner mit einem äußerst starken Akt der Selbsthilfe antworteten und eine Anzahl Schiffe kurzerhand versenkten.“"
                                            },
                                            {
                                                "example_id": "a84fbb4e-7316-4ae1-b873-3c6c86371a5d",
                                                "sense_id": "4c93307d-29ec-3f7f-8b5f-da3eb5df2e5e",
                                                "text": "„Acht Tage war es erst her, dass er das Kommando seiner Flottille übernommen hatte.“"
                                            },
                                            {
                                                "example_id": "56666ada-6c7e-482b-a57d-55643183a636",
                                                "sense_id": "4c93307d-29ec-3f7f-8b5f-da3eb5df2e5e",
                                                "text": "„Ein mächtiger Sturm hat den Portugiesen Bartolomeu Diaz mit seiner Flottille an Afrikas Atlantikküste weit nach Süden verschlagen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "65d5e386-fdf6-4e51-a5b7-56fe92bc6af9",
                        "source_entry_id": "9289c5e5-a8a4-3be1-b5cc-8a1e025e350d",
                        "source_sense_id": "5104fab8-8c07-3e3d-8e46-50ed7211d84d",
                        "target_lang_word": "flotilla",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "flotilla",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "15232016-72a4-3245-afaa-5cfa5b1f5ee6",
                                        "entry_id": "6ea2c2f9-94c7-3d68-a2ee-e3c592e8893c",
                                        "glosses": [
                                            "A small fleet of warships (usually of the same class), or a fleet of small ships."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cfa537e7-ac60-426f-8950-cea028616d87",
                                                "sense_id": "15232016-72a4-3245-afaa-5cfa5b1f5ee6",
                                                "text": "Toward the horizon a flotilla of fishing-boats showed immutable, pink-lacquered by the evening sun."
                                            },
                                            {
                                                "example_id": "4125f8c6-e369-4b51-8cde-949c5c9fedf0",
                                                "sense_id": "15232016-72a4-3245-afaa-5cfa5b1f5ee6",
                                                "text": "Driven from their home system by the geth nearly three centuries ago, most quarians now live aboard the Migrant Fleet, a flotilla of fifty thousand vessels ranging in size from passenger shuttles to mobile space stations.\nHome to 17 million quarians, the flotilla understandably has scarce resources. Because of this, each quarian must go on a rite of passage known as the Pilgrimage when they come of age. They leave the fleet and only return once they have found something of value they can bring back to their people."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ef78997f-28c9-3ccd-a4a6-ed4c5c32ba15",
                                        "entry_id": "6ea2c2f9-94c7-3d68-a2ee-e3c592e8893c",
                                        "glosses": [
                                            "A small group of things or people"
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bba04ce0-d52e-4dab-a740-c1c18ca98032",
                                                "sense_id": "ef78997f-28c9-3ccd-a4a6-ed4c5c32ba15",
                                                "text": "After a few moments Chloe saw Rosamund walking towards them with a small flotilla of shopping bags."
                                            },
                                            {
                                                "example_id": "57b36cce-a960-4750-b58d-8b98837d7fad",
                                                "sense_id": "ef78997f-28c9-3ccd-a4a6-ed4c5c32ba15",
                                                "text": "flotilla of tiny ducklings"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "212dd2a5-7883-36ea-b770-0def88111003",
                                        "entry_id": "6ea2c2f9-94c7-3d68-a2ee-e3c592e8893c",
                                        "glosses": [
                                            "A spaceship made of one or more central mutually stabilizing overweight spaceships flanked by lightweight, middleweight, or heavyweight spaceships that prevent the formation of destructive eggs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e46b71fd-c047-4da7-8210-9bf9ed6b2ce2",
                                                "sense_id": "212dd2a5-7883-36ea-b770-0def88111003",
                                                "text": "For rule R(2222) a flotilla of six gliders traveling eastwards is generated."
                                            },
                                            {
                                                "example_id": "934c7a80-04e2-4ef7-8e45-fabd371a70c7",
                                                "sense_id": "212dd2a5-7883-36ea-b770-0def88111003",
                                                "text": "Now, the smallest known Life spaceship that isn’t a glider, a *WSS, or a flotilla of *WSSs is the loafer, which has population 20 in a 9 by 9 bounding box."
                                            },
                                            {
                                                "example_id": "3af052f9-7022-4b7a-a071-99cf76a64b56",
                                                "sense_id": "212dd2a5-7883-36ea-b770-0def88111003",
                                                "text": "The resulting spaceship (shown below) has a phase with only 24 cells, making it in this respect the smallest known spaceship other than the standard spaceships and some trivial two-spaceship flotillas derived from them."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d15d1258-4275-43c1-ae32-b0056dff9244",
                        "source_entry_id": "9289c5e5-a8a4-3be1-b5cc-8a1e025e350d",
                        "source_sense_id": "5104fab8-8c07-3e3d-8e46-50ed7211d84d",
