                    ]
                },
                {
                    "sense_id": "9a6284c2-212c-3989-b0bb-bc349ff2e87f",
                    "sense_definition": "Отправлять кого-либо куда-либо с поручением или заданием.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "отправка",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Командир решил <w>слать</w> гонца с важными вестями в штаб."
                        },
                        {
                            "text": "Начальник стал <w>слать</w> сотрудников на проверку в филиалы."
