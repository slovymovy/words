                        ],
                        "examples": [
                            {
                                "example_id": "4bf5a7be-85b3-40b5-8f1f-e5d75084b9e1",
                                "sense_id": "988c2c41-6097-312d-9fd1-88767fdd5104",
                                "text": "Hij is een beroemd wielrenner."
