                ],
                "senses": [
                    {
                        "sense_id": "b6c0a7e5-ea97-3dfc-bb57-3a781e7d4166",
                        "entry_id": "e1bb3d47-5196-3acf-a646-eb78ffe11595",
                        "glosses": [
                            "vierzehnter Bezirk der österreichischen Bundeshauptstadt Wien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ec1453b-adff-47f3-8142-6a04b9a2d046",
                                "sense_id": "b6c0a7e5-ea97-3dfc-bb57-3a781e7d4166",
                                "text": "Dafür, dass er ziemlich groß ist, ist er eigentlich ziemlich unbekannt: Nach Penzing – von seiner Fläche her immerhin der viertgrößte Wiener Bezirk – verschlägt es den durchschnittlichen Wiener nicht oft."
                            },
                            {
                                "example_id": "fb947142-28d6-42a8-bcc1-ec7c3d29542e",
                                "sense_id": "b6c0a7e5-ea97-3dfc-bb57-3a781e7d4166",
                                "text": "Penzing ist der Bezirk mit dem zweitgrößten Grünflächenanteil Wiens."
                            },
                            {
                                "example_id": "bad26091-6dcc-4d07-9092-85846b87472d",
                                "sense_id": "b6c0a7e5-ea97-3dfc-bb57-3a781e7d4166",
                                "text": "Penzing ist auch bekannt als Heimatbezirk des Fussballvereins SK Rapid (Gerhard Hanappi-Stadion), ebenso durch Fuchs-Villa und die Hohe-Wand-Wiese, einem beliebten Ausflugsziel der WienerInnen [sic]."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "8eb0170a-701a-3fb6-a3d5-8621ba6b3cc1",
                        "entry_id": "e1bb3d47-5196-3acf-a646-eb78ffe11595",
                        "glosses": [
                            "ehemaliger Vorort, nunmehr Ortsteil des gleichnamigen Bezirkes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c72a432-180f-4c82-8413-f09b4ce45c15",
                                "sense_id": "8eb0170a-701a-3fb6-a3d5-8621ba6b3cc1",
                                "text": "Penzing wurde nach 800 als Wehrbauernsiedlung zum Schutz der Furt durch den Wienfluss gegründet."
                            },
                            {
                                "example_id": "7f73ff37-56dc-41dc-a851-7634853608ef",
                                "sense_id": "8eb0170a-701a-3fb6-a3d5-8621ba6b3cc1",
                                "text": "1891 wurde Penzing in die Stadt Wien eingemeindet."
                            },
                            {
                                "example_id": "a336ad12-ae56-4fea-accc-853e510104d5",
                                "sense_id": "8eb0170a-701a-3fb6-a3d5-8621ba6b3cc1",
                                "text": "Penzing war jahrhundertelang ein erfolgreiches Weinbauland, das so wie die meisten heutigen Aussenbezirke von Pest, Türkenkriegen und im Falle von Penzing zusätzlich Überflutungen des Wienflusses heimgesucht wurde."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
