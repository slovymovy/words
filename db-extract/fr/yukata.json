                                        "sense_id": "b455f47f-e2c4-36d0-a5f7-96500655510c",
                                        "entry_id": "e7a49eda-291b-3fd2-beb3-c94eb0059032",
                                        "glosses": [
                                            "An unlined cotton summer kimono worn by both men and women."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4e154a3-292c-425f-b0cd-f8fa97d8c838",
                                                "sense_id": "b455f47f-e2c4-36d0-a5f7-96500655510c",
                                                "text": "When made of lightweight cotton, the unlined and partially lined kimono become yukata. Yukata, however, do not have flutter sleeves, as they are considered too dressy for this informal kimono."
                                            },
                                            {
                                                "example_id": "a05a98f4-2f00-4434-85cf-a7904019ea87",
                                                "sense_id": "b455f47f-e2c4-36d0-a5f7-96500655510c",
                                                "text": "Most Japanese now wear yukata as summer kimono that are cool and comfortable."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
