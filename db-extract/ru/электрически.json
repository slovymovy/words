                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c99aca24-06da-333d-be0f-7ddc71ca83d5",
                                        "entry_id": "09694776-1e94-3ff9-8360-dcbb66de5e6c",
                                        "glosses": [
                                            "mit Elektrizität betrieben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb54044c-d730-4c76-bb0c-ee67b7f9abcd",
                                                "sense_id": "c99aca24-06da-333d-be0f-7ddc71ca83d5",
                                                "text": "Heiners elektrischer Rasierapparat ist schon wieder kaputt."
                                            },
                                            {
                                                "example_id": "4fce0c2f-1cda-402c-87c9-1f397b580350",
                                                "sense_id": "c99aca24-06da-333d-be0f-7ddc71ca83d5",
                                                "text": "„Um die Klimaziele einzuhalten, müssten“ […] „90 Prozent der Autos in den USA bis 2050 elektrisch betrieben werden. Das wäre nur mit drastischen Maßnahmen möglich.“"
                                            },
                                            {
                                                "example_id": "171224ee-e424-4c61-b0c4-2071dcdeefa0",
                                                "sense_id": "c99aca24-06da-333d-be0f-7ddc71ca83d5",
                                                "text": "„In Shenzhen werden seit 2007 bereits 100 Prozent des öffentlichen Personentransfers elektrisch durchgeführt. Damit ist die Stadt weltweit Vorreiter.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "e3fb35d0-6e61-36b3-9d26-52c8fc671f20",
                                        "entry_id": "09694776-1e94-3ff9-8360-dcbb66de5e6c",
                                        "glosses": [
                                            "Elektrizität speichernd, führend, erzeugend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3cdde976-2bf1-43b7-a523-5ea5a53b02c3",
                                                "sense_id": "e3fb35d0-6e61-36b3-9d26-52c8fc671f20",
                                                "text": "Dies ist eine elektrische Leitung."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "a6732377-da8e-3300-af73-358d38c8d773",
                                        "entry_id": "09694776-1e94-3ff9-8360-dcbb66de5e6c",
                                        "glosses": [
                                            "auf Elektrizität basierend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "98bcc7c9-c40d-4ee1-81a5-c478ccefa853",
                                                "sense_id": "a6732377-da8e-3300-af73-358d38c8d773",
                                                "text": "Der Zaun an der Kuhweide ist elektrisch geladen."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "938735a1-c274-3945-baf5-7616c9cea9e8",
                                        "entry_id": "09694776-1e94-3ff9-8360-dcbb66de5e6c",
                                        "glosses": [
