                        "examples": [
                            {
                                "example_id": "ca2661de-433a-4f86-b240-eacf4382a21f",
                                "sense_id": "2bc59968-f1c7-33ac-bce3-704608e5965e",
                                "text": "De groenwieren zijn protisten die nauw verwant zijn aan de planten, onder andere omdat ook zij bladgroen bevatten."
