                ],
                "senses": [
                    {
                        "sense_id": "93c2fa8c-b987-3e09-acf9-d4a27129a737",
                        "entry_id": "b5bd937f-efcb-3b36-882a-33ad5833b993",
                        "glosses": [
                            "widerrufbare, auf Bitten hin erfolgende Übertragung des Besitzes einer Sache ohne Begründung eines Rechtsanspruchs"
                        ],
                        "tags": [
                            "Rechtssprache",
                            "ursprünglich im römischen Recht"
                        ],
                        "examples": [
                            {
                                "example_id": "9e0fe9d6-36d9-4bbc-b367-76f871d9211f",
                                "sense_id": "93c2fa8c-b987-3e09-acf9-d4a27129a737",
                                "text": "Das Prekarium (auch Bittleihe) setzt eine Unbestimmtheit der Gebrauchsdauer, jederzeitige Wiederrufbarkeit und Unentgeltlichkeit der Überlassung voraus (vgl §§ 974, 981 ABGB)."
                            },
                            {
                                "example_id": "49a4d94b-5b4c-423c-8169-24c4d05e7704",
                                "sense_id": "93c2fa8c-b987-3e09-acf9-d4a27129a737",
                                "text": "In der Praxis hat diese Abgrenzung große Bedeutung, weil auf ein Prekarium das MRG (Mietrechtsgesetz) nicht anwendbar ist."
                            },
                            {
                                "example_id": "2daba706-274c-439a-b42e-e6cc49cdf5ad",
                                "sense_id": "93c2fa8c-b987-3e09-acf9-d4a27129a737",
                                "text": "Hat man weder die Dauer, noch die Absicht des Gebrauches bestimmt, so entsteht kein wahrer Vertrag, sondern ein unverbindliches Bittleihen (Prekarium), und der Verleiher kann die entlehnte Sache nach Willkür zurückfordern."
                            },
                            {
                                "example_id": "3a788611-8da9-4155-9517-a72c4d831a35",
                                "sense_id": "93c2fa8c-b987-3e09-acf9-d4a27129a737",
                                "text": "Ein „Prekarium“ ist ein symbolischer Mietpreis - dafür können die Bewohner jederzeit delogiert werden und haben keinerlei Rechte."
                            },
                            {
                                "example_id": "541197ec-c836-4649-a3eb-40d5d32af981",
                                "sense_id": "93c2fa8c-b987-3e09-acf9-d4a27129a737",
                                "text": "Von einer tatsächlichen Souveränität und Staatlichkeit kann im Kosovo nicht die Rede sein. Diese Entität bleibt ein Prekarium, solange es in den Vereinten Nationen nicht als Staat anerkannt wird."
                            },
                            {
                                "example_id": "c21309fc-21aa-4897-a047-e4349f908ad2",
                                "sense_id": "93c2fa8c-b987-3e09-acf9-d4a27129a737",
                                "text": "Ein Prekarium nahmen nur diejenigen in Anspruch, die keine Aussicht auf eigenen Grundbesitz hatten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
