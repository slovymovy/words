                    "frequency": "Middle",
                    "semantic_group_id": "tekst",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In de oude bibliotheek vonden de onderzoekers een zeldzaam <w>geschrift</w> uit de middeleeuwen.",
                            "target_lang_translations": {
                                "en": "In the old library, the researchers found a rare <w>writing</w> from the Middle Ages."
                            }
                        },
                        {
                            "text": "Dit <w>geschrift</w> bevat belangrijke informatie over de geschiedenis van de stad.",
                            "target_lang_translations": {
                                "en": "This <w>document</w> contains important information about the history of the city."
                            }
                        }
                    ],
                    "synonyms": [
                        "tekst",
                        "document",
                        "stuk",
                        "verhandeling"
                    ],
