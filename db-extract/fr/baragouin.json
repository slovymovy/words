        "fr-extract.jsonl": [
            {
                "entry_id": "7da2780f-799a-3ff2-8025-196b20dae9da",
                "word": "baragouin",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "f7b1d393-0a15-431e-98bf-36cbf7a49ece",
                        "entry_id": "7da2780f-799a-3ff2-8025-196b20dae9da",
                        "tags": [
                            "plural"
                        ],
                        "form": "baragouins"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7003716c-2e5d-32c0-b110-6915fd36bb6f",
                        "entry_id": "7da2780f-799a-3ff2-8025-196b20dae9da",
                        "glosses": [
                            "Langage incorrect et inintelligible."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "3bdd75c2-a29e-4622-bb69-c409bdd66e91",
                                "sense_id": "7003716c-2e5d-32c0-b110-6915fd36bb6f",
                                "text": "La chose mérite d'être soulignée, car cette mauvaise langue de Mme de Genlis reprendra à son compte un ragot particulièrement sot, faisant de l'anglais de Voltaire un baragouin insupportable. Voilà qui est absolument faux."
                            },
                            {
                                "example_id": "ab448cea-818b-4a7c-a539-f5fac772e939",
                                "sense_id": "7003716c-2e5d-32c0-b110-6915fd36bb6f",
                                "text": "De visage, il avait l’air plus vieux que Catherine ; et pourtant quand on le mit sur ses pieds, il ne sut que regarder autour de lui, et répéta sans cesse un baragouin que personne ne pouvait comprendre."
                            }
                        ]
                    },
                    {
                        "sense_id": "9021c12a-da7a-3514-84ed-3d8f3b407e61",
                        "entry_id": "7da2780f-799a-3ff2-8025-196b20dae9da",
                        "glosses": [
                            "Langue que l’on ne comprend pas."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "8b75a811-3bae-4b8f-8c75-be930964980a",
                                "sense_id": "9021c12a-da7a-3514-84ed-3d8f3b407e61",
                                "text": "L’orfèvre. – La citadelle ! voilà ce que le peuple ne souffrira jamais, voir tout d’un coup s’élever sur la ville cette nouvelle tour de Babel, au milieu du plus maudit baragouin ; les Allemands ne pousseront jamais à Florence, et pour les y greffer, il faudra un vigoureux lien."
                            },
                            {
                                "example_id": "0a96a61e-ea06-4c6a-9ba1-7853d5e87d09",
                                "sense_id": "9021c12a-da7a-3514-84ed-3d8f3b407e61",
                                "text": "Une soirée a suffit pour les faire dégringoler du trépied, ou plutôt du perchoir, d'où ils rendaient leurs oracles — dans quel baragouin, dieux du ciel !"
                            },
                            {
                                "example_id": "507c0b95-876d-419a-a2dc-83ca06157869",
                                "sense_id": "9021c12a-da7a-3514-84ed-3d8f3b407e61",
                                "text": "A quoy respondit Pantagruel. Mon amy je n’entends point ce barragouyn, et pourtant si voulez qu’on vous entende parlez aultre langaige."
                            },
                            {
                                "example_id": "8e23773e-d061-4248-a3a6-9c547299b6e9",
                                "sense_id": "9021c12a-da7a-3514-84ed-3d8f3b407e61",
                                "text": "... livre basty d’un espagnol baragouiné en terminaisons latines"
                            },
                            {
                                "example_id": "7cf8e56e-8b0a-45a8-9157-59383f03fc09",
                                "sense_id": "9021c12a-da7a-3514-84ed-3d8f3b407e61",
                                "text": "La mère se débattait, jurait qu’elle n’avait point vu de franc-tireur, l’autre disait qu’il était sûr. Enfin le vacarme se met à baisser, on n’entendait plus rien. Et puis, le sergent parle à ses hommes, dans leur baragouin."
                            },
                            {
                                "example_id": "d5c53ad2-b4a6-4a02-bcb6-5e11b93136db",
                                "sense_id": "9021c12a-da7a-3514-84ed-3d8f3b407e61",
                                "text": "Est-il encore possible de faire chanter l’imparfait du subjonctif dans le « baragouin » parlé maintenant ?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "de535a35-9eb3-41b8-beb3-9fbb7898a300",
                        "source_entry_id": "7da2780f-799a-3ff2-8025-196b20dae9da",
                        "target_lang_word": "Kauderwelsch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kauderwelsch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6d592c85-f149-3c00-bd8a-83f6ad34db68",
                                        "entry_id": "7bbf4698-8968-37d2-8f1f-1d8f074d36b4",
                                        "glosses": [
                                            "schwer- oder unverständliche Sprache; aus Elementen verschiedener Sprachen gemischte Ausdrucksweise, fehlerhafte Ausdrucksweise"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c0e05eeb-adfc-4c59-830c-8d8908adf1ec",
                                                "sense_id": "6d592c85-f149-3c00-bd8a-83f6ad34db68",
                                                "text": "Sein Kauderwelsch aus Spanisch und Deutsch war kaum verständlich."
                                            },
                                            {
                                                "example_id": "03da9ff9-2d2d-4500-99e2-f49e12229b0d",
                                                "sense_id": "6d592c85-f149-3c00-bd8a-83f6ad34db68",
                                                "text": "Man kann einen Satz, in dem Wörter oder grammatische Strukturen unterschiedlicher sprachlicher Herkunft gemischt werden, als Kauderwelsch bezeichnen."
                                            },
                                            {
                                                "example_id": "1370db05-c8d6-4361-ad1b-1fa36ac5e1df",
                                                "sense_id": "6d592c85-f149-3c00-bd8a-83f6ad34db68",
                                                "text": "Auch eine unverständliche Ausdrucksweise kann als Kauderwelsch bezeichnet werden."
                                            },
                                            {
                                                "example_id": "455e2124-bc05-4ea0-a051-6311b023ae7e",
                                                "sense_id": "6d592c85-f149-3c00-bd8a-83f6ad34db68",
                                                "text": "Auf Fremde wirkt der Hamburger manchmal leicht befremdlich, weil er ein nicht leicht verständliches Kauderwelsch, das Hamborger Platt, als Verständigungsmittel einsetzt."
                                            },
                                            {
                                                "example_id": "2c3282df-4437-46eb-9d54-b423a7db36a2",
                                                "sense_id": "6d592c85-f149-3c00-bd8a-83f6ad34db68",
                                                "text": "Der Linguist [Reiner Pogarell] hat beobachtet, dass das Aufbegehren gegen Denglisch-Kauderwelsch in Firmen stärker wird […]"
                                            },
                                            {
                                                "example_id": "a91c9376-2258-4ede-a4ac-36ab77d5517a",
                                                "sense_id": "6d592c85-f149-3c00-bd8a-83f6ad34db68",
                                                "text": "„Wir haben .. wiederholt auf das zähe westliche Vorurteil bei Jud und Christ hingewiesen, wonach Jiddisch nichts anderes sei als ein Jargon, ein verdorbenes, mit fremden Brocken anorganisch durchwürfeltes Deutsch, ein Kauderwelsch.“"
                                            },
                                            {
                                                "example_id": "8cc5b731-89f5-45ff-9805-0849d5e97e6a",
                                                "sense_id": "6d592c85-f149-3c00-bd8a-83f6ad34db68",
                                                "text": "„Für das, was er für Englisch hielt, hätte es ohnehin eines Dolmetschers bedurft, es handelte sich um ein Kauderwelsch aus Schwäbisch und Globalesisch."
                                            },
                                            {
                                                "example_id": "69586255-3a16-4259-a723-e550e00ddf00",
                                                "sense_id": "6d592c85-f149-3c00-bd8a-83f6ad34db68",
                                                "text": "„Und wenn Eltern eine Sprache vermitteln wollen, die sie selbst nur mangelhaft beherrschen, kommt dabei oft eher ein Kauderwelsch heraus.“"
                                            },
                                            {
                                                "example_id": "29149c2f-06f7-4d3e-823c-e9e3f2bd532f",
                                                "sense_id": "6d592c85-f149-3c00-bd8a-83f6ad34db68",
                                                "text": "„Wir besaßen jeder nicht weniger als dreißigtausend Fuß in den »reichsten Gruben der Erde«, wie es im wilden Kauderwelsch der Minensprache hieß - und hatten Schulden beim Metzger.“"
                                            },
                                            {
                                                "example_id": "35879291-482c-46e0-b036-78cd148b270d",
                                                "sense_id": "6d592c85-f149-3c00-bd8a-83f6ad34db68",
                                                "text": "„Soll man nun beim Jiddisch des Ostens nach wie vor von Mischsprache oder Kauderwelsch sprechen?“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a65fd012-58b0-4319-b061-31a2c9577665",
                        "source_entry_id": "7da2780f-799a-3ff2-8025-196b20dae9da",
                        "target_lang_word": "gibberish",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gibberish",
