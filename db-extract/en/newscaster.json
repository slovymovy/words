                                        "entry_id": "8676938a-3c18-33f8-b545-ad503be65289",
                                        "glosses": [
                                            "Person, die in Funk und Fernsehen die Nachrichten vorträgt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe31f3b3-35ab-4556-aef0-35452a8df420",
                                                "sense_id": "2ef4f966-07cf-3932-850c-d31ab90e1b6c",
                                                "text": "Viele Nachrichtensprecher werden mit der Zeit prominent."
                                            },
                                            {
                                                "example_id": "5782a449-2001-45fa-975f-713d76dff328",
                                                "sense_id": "2ef4f966-07cf-3932-850c-d31ab90e1b6c",
                                                "text": "„Wenn die Nachrichtensprecher verstummten und die Zuhörer schliefen und die Sendezeit zu Ende war, schwieg Helenas Radio, war aber nicht ausgeschaltet.“"
                                            },
                                            {
                                                "example_id": "0bf7d41e-3cc5-460c-b0e0-c3fc032c9495",
                                                "sense_id": "2ef4f966-07cf-3932-850c-d31ab90e1b6c",
                                                "text": "„Ich war gerade auf dem Weg in den Flur, als der Nachrichtensprecher meldete, Seine Majestät, der König habe einen Herzinfarkt erlitten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e7f436cb-1600-49fa-81dd-0e39673d0ca2",
                        "source_entry_id": "b9c53f0b-175d-354e-9c98-0aed234d3b51",
