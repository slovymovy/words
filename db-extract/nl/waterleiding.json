                                    },
                                    {
                                        "sense_id": "1df9a430-f5d2-3836-ba6d-eb32129ef1b7",
                                        "entry_id": "b7dc481d-c80e-3224-b3dc-096a7a80eee6",
                                        "glosses": [
                                            "A hydraulic apparatus by which a supply of water is furnished for ornamental purposes; also, an ornamental fountain or waterfall."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a6426b7-9f1b-4f20-86af-4d560edff61e",
                                                "sense_id": "1df9a430-f5d2-3836-ba6d-eb32129ef1b7",
                                                "text": "Resolving to possess myself in some quiet if it might be, in a time of so great jealosy, I built by my Brother's permission a study, made a fishpond, an island, and some other solitudes and retirements, at Wotton, which gave the first occasion of improving them to those water-works and gardens which afterwards succeeded them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "31f8c5dd-97da-3a3d-8b78-ac8cf7a0a1ea",
