{
    "word_family": [
        "kwitnąć",
        "kwiecień",
        "kwiecisty",
        "kwitnienie"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "98b8ab0e-38e1-3281-b0a0-54423d7b341c",
                    "sense_definition": "Organ roślin nasiennych, w którym wykształcają się wyspecjalizowane elementy służące do rozmnażania.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "botanika",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wiosną każdy <w>kwiat</w> na łące wygląda pięknie.",
                            "target_lang_translations": {
                                "ru": "Весной каждый <w>цветок</w> на лугу выглядит прекрасно."
                            }
                        },
                        {
                            "text": "Ten <w>kwiat</w> ma bardzo intensywny zapach.",
                            "target_lang_translations": {
                                "ru": "У этого <w>цветка</w> очень интенсивный запах."
                            }
                        }
                    ],
                    "common_phrases": [
                        "piękny kwiat",
                        "zapach kwiatów"
                    ],
                    "target_lang_definitions": {
                        "ru": "Орган размножения цветкового растения, его цветущая часть."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "цветок",
                                "target_lang_sense_clarification": "ботанический орган растения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3db84ff6-5f7d-36d8-9c4f-4d2f56749809",
                    "sense_definition": "Kwitnąca roślina ozdobna.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "botanika",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kupiłem piękny <w>kwiat</w> dla mojej mamy na urodziny.",
                            "target_lang_translations": {
                                "ru": "Я купил красивый <w>цветок</w> для моей мамы на день рождения."
                            }
                        },
                        {
                            "text": "Wręczyłem jej <w>kwiat</w> w podziękowaniu za pomoc.",
                            "target_lang_translations": {
                                "ru": "Я вручил ей <w>цветок</w> в благодарность за помощь."
                            }
                        }
                    ],
                    "synonyms": [
                        "kwiatek"
                    ],
                    "antonyms": [
                        "łodyga"
                    ],
                    "common_phrases": [
                        "bukiet kwiatów",
                        "podarować kwiat"
                    ],
                    "target_lang_definitions": {
                        "ru": "Цветущее декоративное растение или срезанный цветок, используемый как подарок."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "цветок",
                                "target_lang_sense_clarification": "растение или срезанный цветок как подарок"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cd6fd35d-27fb-3a2a-8d94-b9809780205f",
                    "sense_definition": "Roślina doniczkowa.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "botanika",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Muszę dzisiaj podlać każdy <w>kwiat</w> w moim salonie.",
                            "target_lang_translations": {
                                "ru": "Мне нужно сегодня полить каждый <w>цветок</w> в моей гостиной."
                            }
                        },
                        {
                            "text": "Ten <w>kwiat</w> stoi na parapecie i potrzebuje dużo słońca.",
                            "target_lang_translations": {
                                "ru": "Этот <w>цветок</w> стоит на подоконнике и нуждается в большом количестве солнца."
                            }
                        }
                    ],
                    "synonyms": [
                        "kwiatek"
                    ],
                    "common_phrases": [
                        "podlewać kwiat",
                        "doniczkowy kwiat"
                    ],
                    "target_lang_definitions": {
                        "ru": "Комнатное растение, выращиваемое в горшке."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "цветок",
                                "target_lang_sense_clarification": "комнатное растение"
                            },
                            {
                                "target_lang_word": "комнатное растение",
                                "target_lang_sense_clarification": "растение, выращиваемое в помещении"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3985eb04-a2ba-3257-ba6f-b836e339666c",
                    "sense_definition": "Najlepsza, najbardziej wartościowa część jakiejś grupy osób lub społeczności.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "metafora",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na konferencji zebrał się prawdziwy <w>kwiat</w> polskiej nauki.",
                            "target_lang_translations": {
                                "ru": "На конференции собрался настоящий <w>цвет</w> польской науки."
                            }
                        },
                        {
                            "text": "Młodzież to <w>kwiat</w> narodu, o który trzeba dbać.",
                            "target_lang_translations": {
                                "ru": "Молодёжь — это <w>цвет</w> нации, о котором нужно заботиться."
                            }
                        }
                    ],
                    "synonyms": [
                        "elita",
                        "śmietanka",
                        "kwiecie"
                    ],
                    "common_phrases": [
                        "kwiat młodzieży",
                        "kwiat społeczeństwa"
                    ],
                    "target_lang_definitions": {
                        "ru": "Лучшая, наиболее ценная часть какой-либо группы людей или общества."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "цвет",
                                "target_lang_sense_clarification": "лучшая, отборная часть чего-либо"
                            },
                            {
                                "target_lang_word": "элита",
                                "target_lang_sense_clarification": "высший слой общества"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "04cc9dfe-1ae5-3298-8e5e-db2ef6b66ef7",
                    "sense_definition": "Dziewictwo.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "metafora",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W dawnych czasach utrata <w>kwiatu</w> była wydarzeniem o wielkim znaczeniu społecznym.",
                            "target_lang_translations": {
                                "ru": "В давние времена потеря <w>невинности</w> была событием большого социального значения."
                            }
                        },
                        {
                            "text": "Poetycko mówiono o niej, że straciła swój <w>kwiat</w> zbyt wcześnie.",
                            "target_lang_translations": {
                                "ru": "Поэтически о ней говорили, что она потеряла свою <w>невинность</w> слишком рано."
                            }
                        }
                    ],
                    "synonyms": [
                        "panieński kwiatek"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Używane w kontekście literackim lub historycznym."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Девственность (устаревшее, поэтическое выражение)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "невинность",
                                "target_lang_sense_clarification": "девственность"
                            }
                        ]
                    }
                }
            ]
        }
    ]
