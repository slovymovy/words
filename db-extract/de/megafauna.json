                    {
                        "sense_id": "f377303c-b99f-3f42-a084-13c4bc94c537",
                        "entry_id": "f2f27359-4162-30cd-9e8b-350255513927",
                        "glosses": [
                            "Gesamtheit derjenigen Tiere, die die größte Körpergröße aufweisen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b18a52dd-c08c-4c49-86c9-d70c75aa3e01",
                                "sense_id": "f377303c-b99f-3f42-a084-13c4bc94c537",
                                "text": "„Ein Teil dieser europäischen Megafauna starb aus, als die letzte Eiszeit begann und das Klima zu kalt für die wärmeliebenden Arten wurde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "42369d13-4a15-4f38-be03-210ca3201ea2",
