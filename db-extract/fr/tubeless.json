                                            {
                                                "example_id": "ba2ee863-4b5d-4258-89f9-a3bd4dc5511d",
                                                "sense_id": "e6ec1b65-6343-396e-b819-dcb613a0e99a",
                                                "text": "Joe's No Flat's brengt 'gevulde' binnenbanden en tubeless banden voor vrijwel alle fietstypes op de markt. Ook is de reparatievloeistof per fles te koop voor wie zijn eigen banden wil afvullen."
                                            },
                                            {
                                                "example_id": "12e42ac5-9194-47ec-97a9-ad2ff97c79bb",
                                                "sense_id": "e6ec1b65-6343-396e-b819-dcb613a0e99a",
                                                "text": "De nieuwe vinding van Richard Nieuwhuis van Dugast voor de veldrijders – een tubeless band met hoge demping – viel niet alleen in de smaak, maar ook in de prijzen op het wereldkampioenschap veldrijden zondag in Heusden-Zolder."
                                            }
                                        ]
                                    }
