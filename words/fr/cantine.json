    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "fc0c4ada-a4a4-3eb9-981a-f1c65f7de290",
                    "sense_definition": "Lieu de restauration collective au sein d'une école, d'une entreprise ou d'une administration.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "restauration_collective",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "À midi, les enfants mangent tous ensemble à la <w>cantine</w> de l'école primaire."
                        },
                        {
                            "text": "Nous avons l'habitude de déjeuner à la <w>cantine</w> d'entreprise pour gagner du temps."
                        }
                    ],
                    "synonyms": [
                        "réfectoire",
                        "cafétéria"
                    ],
                    "common_phrases": [
                        "cantine scolaire",
                        "manger à la cantine",
                        "cantine d'entreprise"
                    ]
                },
                {
                    "sense_id": "13707f77-fb02-3195-acd5-9e6d8fe3fcc0",
                    "sense_definition": "Magasin ou débit de boissons et de vivres au sein d'une caserne, d'un atelier ou d'une prison.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "restauration_collective",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les détenus peuvent acheter des paquets de café et des biscuits à la <w>cantine</w>."
                        },
                        {
                            "text": "Dans ce camp militaire, la <w>cantine</w> propose des produits de première nécessité aux soldats."
                        }
                    ],
                    "synonyms": [
                        "foyer",
                        "buvette"
                    ],
                    "common_phrases": [
                        "bon de cantine",
                        "prix de cantine"
                    ]
                },
                {
                    "sense_id": "b36880d9-1e9c-3096-93e3-0bde58eb7ee0",
                    "sense_definition": "Grande malle ou caisse métallique servant au transport d'effets personnels ou de matériel militaire.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "coffre_ou_malle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'officier a chargé sa lourde <w>cantine</w> en métal à l'arrière du véhicule tout-terrain."
                        },
                        {
                            "text": "Avant chaque départ en mission, les soldats préparent leurs <w>cantines</w> avec soin."
                        }
                    ],
                    "synonyms": [
                        "malle",
                        "coffre"
                    ],
                    "common_phrases": [
                        "cantine militaire",
                        "cantine métallique"
                    ]
                },
                {
                    "sense_id": "06d6edac-bfa2-3f40-99d6-d403454751f9",
                    "sense_definition": "Petit coffre compartimenté servant à transporter des vivres, de la vaisselle ou des bouteilles.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "coffre_ou_malle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le voyageur ouvrit sa <w>cantine</w> pour en sortir deux bouteilles de vin soigneusement calées."
                        },
                        {
                            "text": "Cette vieille <w>cantine</w> en bois permettait autrefois de protéger les provisions durant le trajet."
                        }
                    ],
                    "synonyms": [
                        "coffret",
                        "boîte"
                    ],
                    "common_phrases": [
                        "cantine de voyage"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Sens traditionnel pour le transport de nourriture"
                        }
                    ]
                },
                {
                    "sense_id": "b16eabad-c744-33e7-86b8-38f25394c28d",
                    "sense_definition": "Petit flacon ou fiole destinée à contenir une boisson.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "recipient",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il portait une petite <w>cantine</w> en verre remplie d'eau-de-vie dans sa poche intérieure."
                        },
                        {
                            "text": "Le soldat tira une <w>cantine</w> de sa besace pour boire une gorgée d'eau fraîche."
                        }
                    ],
                    "synonyms": [
                        "flacon",
                        "gourde"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Désignation ancienne d'un flacon"
                        }
                    ]
                }
            ]
        }
    ]
}