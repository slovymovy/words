                ],
                "senses": [
                    {
                        "sense_id": "a41a8c7c-b03e-3707-a0d0-999b4773be6f",
                        "entry_id": "91a3e1cf-c0c3-3b6e-99f1-98dbf93d8f80",
                        "glosses": [
                            "Qui n’est pas droit, qui est de travers."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "e550a1bf-fbe0-4060-9567-5ee58ddef40d",
                                "sense_id": "a41a8c7c-b03e-3707-a0d0-999b4773be6f",
                                "text": "Bois tortu. Bois qui n’est bon qu’à faire des courbes."
                            },
                            {
                                "example_id": "0df1009d-31eb-4bb4-bc60-d12f4ddd38af",
                                "sense_id": "a41a8c7c-b03e-3707-a0d0-999b4773be6f",
                                "text": "Je ne sais pas si je lui rends service en le faisant vivre, tortu et malplaisant comme il est, mais c'est plus fort que moi…"
                            },
                            {
                                "example_id": "c7f572c4-b6ef-49b3-a5d2-fe16a8bd404f",
                                "sense_id": "a41a8c7c-b03e-3707-a0d0-999b4773be6f",
                                "text": "La plume à la main, il dessinait machinalement, durant des heures, des arbres tortus, des maisonnettes, des izbas, des télègues, des troïkas."
                            },
                            {
                                "example_id": "d5d2f01e-a2d2-4fbc-b016-16003a96f8b1",
                                "sense_id": "a41a8c7c-b03e-3707-a0d0-999b4773be6f",
                                "text": "Des grègues de satin jaune, qui jadis avaient déguisé les masques à quelque entrée de ballet, s’engloutissaient dans des bottes, l’une de pêcheur d’huîtres, en cuir noir, l’autre à genouillère, en cuir blanc de Russie, celle-ci à pied plat, l’autre à pied tortu, ergotée d’un éperon, et que sa semelle feuilletée eût abandonnée depuis longtemps sans le secours d’une ficelle faisant plusieurs tours sur le pied comme les bandelettes d’un cothurne antique."
                            },
                            {
                                "example_id": "f21e44ef-0b5e-4132-8dfc-3fecbc339503",
                                "sense_id": "a41a8c7c-b03e-3707-a0d0-999b4773be6f",
                                "text": "À quelques pas de moi, un tas de vieux sarments noirs, tortus et griffus, avaient l’air de grouiller comme un nid de serpents, et me regardaient avec des grimaces diaboliques…"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "90681ad7-2237-4393-a1b3-7f6b14fc325e",
                        "source_entry_id": "91a3e1cf-c0c3-3b6e-99f1-98dbf93d8f80",
                        "source_sense_id": "a41a8c7c-b03e-3707-a0d0-999b4773be6f",
