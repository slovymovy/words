                                        "entry_id": "49359d40-8273-354e-8228-b42d40bfcff3",
                                        "glosses": [
                                            "Partie de l’histoire naturelle qui a pour objet les animaux."
                                        ],
                                        "tags": [
                                            "Didactique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "907bea83-3dfd-49a7-93d5-548aea15bf2e",
                                                "sense_id": "1838a032-34e2-3e4e-8129-e3fd07617782",
                                                "text": "Ces premiers arrangemens terminés, je sortis pour reconnaître cette terre que je comptais exploiter au nom de la zoologie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8502c46d-9c50-3e04-bbc9-a50b11ac7a8e",
                                        "entry_id": "49359d40-8273-354e-8228-b42d40bfcff3",
                                        "glosses": [
                                            "Étude d’objets qui peuvent être répartis en espèces comme pour les animaux."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da97fdd5-3b23-4933-9aac-d4c1543445e9",
                                                "sense_id": "8502c46d-9c50-3e04-bbc9-a50b11ac7a8e",
                                                "text": "Ce qu’invoquaient Glashow, Iliopoulos et Maiani n’était pas uniquement une nouvelle particule, spécimen d’une vaste zoologie de particules dont on pouvait douter du bien-fondé, mais une collection entièrement inédite de baryons et de mésons « charmés »."
                                            }
                                        ]
                                    }
                                ]
                            }
