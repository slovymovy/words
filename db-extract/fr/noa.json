                "forms": [],
                "senses": [
                    {
                        "sense_id": "9ab5dfa5-36d2-3da3-b3c8-27ea8fa1117a",
                        "entry_id": "7714f9dd-f18b-38af-a93f-5cdcb641480b",
                        "glosses": [
