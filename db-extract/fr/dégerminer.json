                "senses": [
                    {
                        "sense_id": "9964ceb0-1f14-345b-9a31-abdd9566ccbe",
                        "entry_id": "532d148c-c393-3444-948d-ebef45802060",
                        "glosses": [
                            "Débarrasser des germes (au sens botanique du terme)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea329c8c-0515-4155-9f99-1bab54748bac",
                                "sense_id": "9964ceb0-1f14-345b-9a31-abdd9566ccbe",
                                "text": "En ajustant l’intervalle entre la plaque de frottement et la plaque dentée, il peut dégerminer le maïs avec une humidité et une densité différentes et a un taux de dégermination élevé."
                            },
                            {
                                "example_id": "792491c2-6170-4c79-a690-a84b0bd8833f",
                                "sense_id": "9964ceb0-1f14-345b-9a31-abdd9566ccbe",
                                "text": "Machines á dégerminer le malt."
                            }
                        ]
                    },
                    {
                        "sense_id": "9a6309e4-1434-3ea1-9815-06c0aae37261",
                        "entry_id": "532d148c-c393-3444-948d-ebef45802060",
                        "glosses": [
                            "Débarrasser des germes (au sens de micro-organismes)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1541cd5e-c56a-4171-8028-9ca2e32af28c",
                                "sense_id": "9a6309e4-1434-3ea1-9815-06c0aae37261",
                                "text": "Ils offrent non seulement des programmes innovants de conception hygiénique et de nettoyage automatique, mais aussi un module de dégermination UVC intégré en option pour dégerminer l’air ambiant."
                            },
                            {
                                "example_id": "3f8fe92b-5c7c-450b-9007-eb164a10f502",
                                "sense_id": "9a6309e4-1434-3ea1-9815-06c0aae37261",
                                "text": "Il est utilisé pour dégerminer la peau, les plaies et les muqueuses, et pour la préparation préopératoire de la peau des patients."
                            }
                        ]
                    }
