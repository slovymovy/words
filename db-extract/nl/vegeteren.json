                                "target_senses": [
                                    {
                                        "sense_id": "e1124f14-dc43-3a9e-86fb-d2eb02ddf775",
                                        "entry_id": "2886f970-784a-359e-92b2-ad79535916fd",
                                        "glosses": [
                                            "To grow or sprout."
                                        ],
                                        "tags": [
                                            "of a plant"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f06455c8-eed0-3916-bbb4-f1c23afb2a92",
                                        "entry_id": "2886f970-784a-359e-92b2-ad79535916fd",
                                        "glosses": [
                                            "To spread abnormally."
                                        ],
                                        "tags": [
                                            "of a wart etc"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a87728a3-f714-3244-b4e6-eb7e42fd35a7",
                                        "entry_id": "2886f970-784a-359e-92b2-ad79535916fd",
                                        "glosses": [
                                            "To live or spend a period of time in a dull, inactive, unchallenging way."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "974d5074-e24b-4873-82e8-cc3efd685bf9",
                                                "sense_id": "a87728a3-f714-3244-b4e6-eb7e42fd35a7",
                                                "text": "Nor indeed is it likely I shall now ever be able to do more than vegetate, for my few remaining years or months in this or some other solitude. It is literally vegetating, for I have very little locomotive powers beyond those that appertain to a cauliflower."
                                            },
                                            {
                                                "example_id": "2653ccf3-9b3e-4ede-bf0d-224746063f6c",
                                                "sense_id": "a87728a3-f714-3244-b4e6-eb7e42fd35a7",
                                                "text": "I am amazed to see a young man of your appearance and talents—though, after I have been thus depreciating the latter, it is almost an affront to say any thing about those you possess—I am amazed to see you vegetating among your own oaks, as if, like them, growth were your only value.\""
                                            },
                                            {
                                                "example_id": "c78a68f3-30ae-499d-80be-5f313815aa0b",
                                                "sense_id": "a87728a3-f714-3244-b4e6-eb7e42fd35a7",
                                                "text": "We are isolated, locked in hospital rooms 24 hours a day, 7 days a week, subjected to discrimination stemming from hatred, with no constructive programs or activities to occupy our minds. We vegitate ^([sic]) and deteriorate physically and emotionally."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
