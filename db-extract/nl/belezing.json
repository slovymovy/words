                                "example_id": "9996114d-7490-49b5-a880-aec5222919b1",
                                "sense_id": "270f6738-138e-3e50-a3d0-831632292c0b",
                                "text": "Een man werd erg ziek na het eten van een peer die hij van Elisabeth had gekregen. Hij kreeg hevige pijnen in de hartstreek maar kon door belezing gered worden."
                            },
                            {
                                "example_id": "53c24ae0-9218-43fd-9e64-01ce6c86d301",
                                "sense_id": "270f6738-138e-3e50-a3d0-831632292c0b",
                                "text": "Getuigen bevestigden Guiselynes jarenlange heksenfaam. Mensen en dieren waren ziek geworden na contact met haar. Ofwel stierven ze, ofwel waren ze genezen na kerkelijke belezingen."
                            }
