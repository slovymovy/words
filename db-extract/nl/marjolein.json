                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3ab47e56-9de7-4de7-b0fa-d7146e9fe9fa",
                                                "sense_id": "421c024d-bccd-3140-86ae-b779f561082d",
                                                "text": "The Lillie I condemned for thy hand, / And buds of marierom had ſtolne thy haire"
                                            },
                                            {
                                                "example_id": "32facbde-947a-41a5-996c-65a2f342d50d",
                                                "sense_id": "421c024d-bccd-3140-86ae-b779f561082d",
                                                "text": "Among the ancients, especially the Romans, marjoram was known to have an aphrodisiac value."
                                            }
                                        ]
