                    {
                        "sense_id": "23c295d1-632f-3995-aecd-71f25883acd5",
                        "entry_id": "c8e1b8c4-5c5f-348c-8cad-2098eabfdef8",
                        "glosses": [
                            "het verlies van de controle over de bal aan de tegenpartij"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a800575c-4155-4818-ba02-2c5b915a0bd2",
                                "sense_id": "23c295d1-632f-3995-aecd-71f25883acd5",
                                "text": "Al snel maakt Frankrijk gelijk. En dan, vrijwel uit het niets, is er een moment van genialiteit. Australië lijdt achterin balverlies. De bal komt bij Mbappé, die 'm in een snelle beweging via de hak bij Adrien Rabiot bezorgt, die op zijn beurt voorgeeft en Olivier Giroud ziet binnentikken: 2-1."
                            },
                            {
                                "example_id": "d2fbea48-aa83-451b-8bb4-f6f0af90dc02",
                                "sense_id": "23c295d1-632f-3995-aecd-71f25883acd5",
                                "text": "Het gaf Frankrijk vertrouwen, terwijl het spelpeil bij Australië snel daalde. De ploeg van Graham Arnold raakte de bal steeds sneller kwijt. Dat kostte in de 33ste minuut een tegendoelpunt. Olivier Giroud, de ervaren vervanger van Benzema, strafte op aangeven van Rabiot onnodig balverlies op eigen helft af."
                            }
                        ]
                    }
