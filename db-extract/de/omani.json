                    }
                ],
                "senses": [
                    {
                        "sense_id": "96ab6771-7251-3d9e-b653-2fba060099f8",
                        "entry_id": "c7d35918-baee-3de6-b4a1-0d63f38abb12",
                        "glosses": [
                            "Staatsbürgerin von Oman"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a54f839c-86b4-4ef9-8c3f-c475a678d6c8",
                                "sense_id": "96ab6771-7251-3d9e-b653-2fba060099f8",
                                "text": "„Eine Omani würde niemals so laut aufschreien.“"
                            },
                            {
                                "example_id": "29f4b2f1-d6bb-4b00-97d2-435ad32911a4",
                                "sense_id": "96ab6771-7251-3d9e-b653-2fba060099f8",
                                "text": "„Natürlich, sie ist ja auch eine Omani.“"
                            },
                            {
                                "example_id": "5fc94c63-4d30-420b-89ef-0c0abd074071",
                                "sense_id": "96ab6771-7251-3d9e-b653-2fba060099f8",
                                "text": "„Obwohl ich eine Omani bin, werden lieber westliche Innenarchitekten engagiert. Ihnen vertraut man mehr.“"
                            },
                            {
                                "example_id": "ae052e3c-dcbc-446c-b805-3c9f1edbd323",
                                "sense_id": "96ab6771-7251-3d9e-b653-2fba060099f8",
                                "text": "„Ich wohne mit meinen Arbeitskolleginnen – eine Omani, eine Ägypterin, eine Philippina, eine Singapurerin und zwei Deutsche – in einer grossen Villa mitten in Muscat in einer von Einheimischen bewohnten Strasse.“"
                            },
                            {
                                "example_id": "daba2deb-3461-405d-a18f-47eeefdf5a83",
                                "sense_id": "96ab6771-7251-3d9e-b653-2fba060099f8",
                                "text": "„Und auch sonst mutet alles hier mehr asiatisch als arabisch an. Immerhin eine Omani als Azubi.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
