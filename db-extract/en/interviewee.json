                        "examples": [
                            {
                                "example_id": "6fd64670-a03f-4f32-badc-141662d395b9",
                                "sense_id": "91e8ba01-1310-3e47-ac21-5ddc56a3eeee",
                                "text": "Both ‘no-op’ interviewees hold relatively stable identities as TG and offer interesting perspectives on trans repudiation from a TG standpoint."
                            },
                            {
                                "example_id": "7b248549-1856-49eb-b43c-68d2c92ccedf",
                                "sense_id": "91e8ba01-1310-3e47-ac21-5ddc56a3eeee",
                                "text": "[…] a willing American interviewee describes how he wants his girlfriend to \"reach for my [bleep]^([sic]) faster while giving me road head.\""
                            }
                        ]
                    }
