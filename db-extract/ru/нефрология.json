                    {
                        "translation_id": "48366cbd-cad7-4173-927a-4f0c1824f092",
                        "source_entry_id": "ff4f58be-3404-3748-8645-fa157108aca4",
                        "source_sense_id": "6c61fee4-7803-37f6-85af-c8f73c6361d8",
                        "target_lang_word": "Nephrologie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nephrologie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "98bba900-ceed-3645-8fd8-5d763aa939db",
                                        "entry_id": "d1b2448d-5353-3771-bd25-aa07149e1c0a",
                                        "glosses": [
                                            "Wissenschaft von der Morphologie, den Funktionen und Erkrankungen der Niere"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ca9a515-e303-4c0d-8dc8-72c5a8132c6c",
                                                "sense_id": "98bba900-ceed-3645-8fd8-5d763aa939db",
                                                "text": "Die Attraktivität der Nephrologie begründet sich heute vor allem auf den zukunftsweisenden neuen Entwicklungen auf klinischem und wissenschaftlichem Gebiet."
                                            },
                                            {
                                                "example_id": "fcb04fd1-8618-4721-9ab0-e1bb7497f033",
                                                "sense_id": "98bba900-ceed-3645-8fd8-5d763aa939db",
                                                "text": "In der Geschichte der klinischen Medizin ist die Nephrologie eine vergleichsweise relativ junge Disziplin, obwohl PhysiologInnen [sic] die Nierenfunktion und klinisch tätige ÄrztInnen [sic] Nierenerkrankungen bereits seit vielen Jahrhunderten beobachtet und beschrieben haben."
                                            },
                                            {
                                                "example_id": "750783ae-f85b-4dea-a3f5-f1b99011a096",
                                                "sense_id": "98bba900-ceed-3645-8fd8-5d763aa939db",
                                                "text": "Störungen des Elektrolythaushaltes wurden ebenso eine Domäne der Nephrologie wie die Diagnostik und Therapie der arteriellen Hypertonie (obwohl bereits Guyton erkannt hatte, dass ohne eine Störung der Nierenfunktion keine Hypertonie persistieren kann)."
                                            },
                                            {
                                                "example_id": "fc7f8fd7-eb75-45b4-aa3b-7230e09a3781",
                                                "sense_id": "98bba900-ceed-3645-8fd8-5d763aa939db",
                                                "text": "Im Funktionsbereich Nephrologie ist das gesamte Spektrum hochspezialisierter Verfahren zur Diagnostik und Therapie akuter und chronischer Nierenerkrankungen, Bluthochdruckerkrankungen sowie für Nierenfunktionsstörungen, die sich im Rahmen von Stoffwechselkrankheiten (Diabetes mellitus, Gicht), Tumorleiden oder bei Erkrankungen des Skelett- und Bindegewebes entwickeln, verfügbar."
                                            },
                                            {
                                                "example_id": "4161d836-2b34-465f-8834-020560fa8844",
                                                "sense_id": "98bba900-ceed-3645-8fd8-5d763aa939db",
                                                "text": "Die Facharztprüfung in der Nephrologie ist die letzte Hürde auf Ihren Weg zum Facharzt für Innere Medizin und Nephrologie."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
