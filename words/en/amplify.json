{
    "word_family": [
        "amplifier",
        "amplification",
        "amplitude",
        "ample"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d5a0f33c-d19b-3831-bb0f-48a656948c22",
                    "sense_definition": "To make something larger, more intense, or more powerful in effect.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "increase",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new marketing campaign will <w>amplify</w> the impact of our brand across the country.",
                            "target_lang_translations": {
                                "ru": "Новая маркетинговая кампания <w>усилит</w> влияние нашего бренда по всей стране."
                            }
                        },
                        {
                            "text": "Social media can <w>amplify</w> the message of a small protest until it reaches millions.",
                            "target_lang_translations": {
                                "ru": "Социальные сети могут <w>распространить</w> призыв небольшого протеста, пока он не достигнет миллионов."
                            }
                        }
                    ],
                    "synonyms": [
                        "intensify",
                        "magnify",
                        "strengthen",
                        "increase",
                        "boost"
                    ],
                    "antonyms": [
                        "diminish",
                        "reduce",
                        "weaken"
                    ],
                    "common_phrases": [
                        "amplify the impact",
                        "amplify the message",
                        "amplify the effect"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сделать что-либо более масштабным, интенсивным или мощным по воздействию."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "усиливать",
                                "target_lang_sense_clarification": "делать эффект или воздействие мощнее"
                            },
                            {
                                "target_lang_word": "увеличивать",
                                "target_lang_sense_clarification": "делать более значительным по масштабу"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cab345fc-4592-3a91-ae5c-63fd655bb35c",
                    "sense_definition": "To increase the strength of an electrical signal or sound.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "technical_increase",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We need to <w>amplify</w> the signal so that the radio can pick it up clearly.",
                            "target_lang_translations": {
                                "ru": "Нам нужно <w>усилить</w> сигнал, чтобы радио могло четко его принимать."
                            }
                        },
                        {
                            "text": "The electric guitar uses a special device to <w>amplify</w> the sound for the audience.",
                            "target_lang_translations": {
                                "ru": "Электрогитара использует специальное устройство, чтобы <w>усиливать</w> звук для аудитории."
                            }
                        }
                    ],
                    "synonyms": [
                        "boost",
                        "turn up",
                        "increase"
                    ],
                    "antonyms": [
                        "dampen",
                        "mute"
                    ],
                    "common_phrases": [
                        "amplify a signal",
                        "amplify the sound",
                        "amplify the volume"
                    ],
                    "target_lang_definitions": {
                        "ru": "Увеличить силу электрического сигнала или звука."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "усиливать",
                                "target_lang_sense_clarification": "о звуке или электрическом сигнале"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "86b94da3-1f13-32db-99b0-32dcfa92e711",
                    "sense_definition": "To provide more information or detail about something that has been said or written.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The witness was asked to <w>amplify</w> on his earlier statement to clarify the timeline.",
                            "target_lang_translations": {
                                "ru": "Свидетеля попросили <w>дополнить</w> его предыдущее заявление, чтобы уточнить хронологию событий."
                            }
                        },
                        {
                            "text": "The author decided to <w>amplify</w> the story by adding several chapters about the character's past.",
                            "target_lang_translations": {
                                "ru": "Автор решил <w>расширить</w> историю, добавив несколько глав о прошлом персонажа."
                            }
                        }
                    ],
                    "synonyms": [
                        "elaborate",
                        "expand",
                        "expound"
                    ],
                    "antonyms": [
                        "summarize",
                        "abridge",
                        "condense"
                    ],
                    "common_phrases": [
                        "amplify on a point",
                        "amplify the details"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предоставить дополнительную информацию или подробности о чем-то сказанном или написанном."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "развивать",
                                "target_lang_sense_clarification": "добавлять подробности к мысли или утверждению"
                            },
                            {
                                "target_lang_word": "дополнять",
                                "target_lang_sense_clarification": "расширять сказанное новыми деталями"
                            },
                            {
                                "target_lang_word": "детализировать",
                                "target_lang_sense_clarification": "подробно излагать"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8797c9a7-f889-3a6e-b907-e9616fd82096",
                    "sense_definition": "To add extra words or content to a translation to make it sound more natural in the target language.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "linguistics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Translators often <w>amplify</w> the text when moving from a concise language to a more descriptive one.",
                            "target_lang_translations": {
                                "ru": "Переводчики часто <w>расширяют</w> текст при переходе с лаконичного языка на более описательный."
                            }
                        },
                        {
                            "text": "It is sometimes necessary to <w>amplify</w> the translation to ensure the cultural context is understood.",
                            "target_lang_translations": {
                                "ru": "Иногда необходимо <w>дополнить</w> перевод, чтобы обеспечить понимание культурного контекста."
                            }
                        }
                    ],
                    "synonyms": [
                        "augment"
                    ],
                    "common_phrases": [
                        "amplify the translation"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical term in translation studies"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Добавлять дополнительные слова или содержание в перевод, чтобы он звучал более естественно на целевом языке."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "расширять",
                                "target_lang_sense_clarification": "добавлять поясняющие слова в тексте перевода"
                            },
                            {
                                "target_lang_word": "дополнять",
                                "target_lang_sense_clarification": "вводить контекстуальные добавления"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}