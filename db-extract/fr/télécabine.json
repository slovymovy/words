                        "sense_id": "ca25a0fa-0ed4-3191-8476-3dbd07b8b327",
                        "entry_id": "8f8d0f1f-ac08-317d-87d7-c03052d3ad28",
                        "glosses": [
                            "Système de remontée mécanique dans lequel des cabines, suspendues à un seul câble, transportent les voyageurs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a20ebc0e-f73e-484e-95fa-44c319914ba2",
                                "sense_id": "ca25a0fa-0ed4-3191-8476-3dbd07b8b327",
                                "text": "La télécabine a probablement heurté le pylône sur le chemin du retour et a été éjectée», a expliqué la mairesse de Stresa, Marcella Severino."
                            },
                            {
                                "example_id": "85d688a0-128e-4d1d-a9af-9d8794806c51",
                                "sense_id": "ca25a0fa-0ed4-3191-8476-3dbd07b8b327",
                                "text": "À cause du brouillard, nous sommes redescendus en télécabine."
                            },
                            {
                                "example_id": "3fa164ba-5661-46c9-9528-51b116f02848",
                                "sense_id": "ca25a0fa-0ed4-3191-8476-3dbd07b8b327",
                                "text": "Un déraillement sur le télécabine de l’Aups de Véran a provoqué la chute de 4 cabines jeudi à Flaine"
                            },
                            {
                                "example_id": "cc5949e3-d254-4b8a-a08f-7d67a7c2ddc5",
                                "sense_id": "ca25a0fa-0ed4-3191-8476-3dbd07b8b327",
                                "text": "Offrez-vous l’ultime randonnée vers la plus haute cime des Laurentides à bord de la télécabine panoramique !"
                            }
                        ]
                    }
                ],
