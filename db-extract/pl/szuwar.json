                        ],
                        "examples": [
                            {
                                "example_id": "50121534-3459-428f-b219-3493eaf3c9b8",
                                "sense_id": "89c6a0a4-9be0-37b7-ab26-ae5fffeefc45",
                                "text": "Mariusz zerkał niby to na wodę i pobliskie szuwary, by jako wytrawny wioślarz i sternik zarazem okazywać szczególną dbałość o komfort i bezpieczeństwo swojej pasażerki"
                            }
                        ],
