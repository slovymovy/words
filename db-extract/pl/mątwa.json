                "translations": [
                    {
                        "translation_id": "9903e0a1-2a40-4900-b514-6e4c456c1267",
                        "source_entry_id": "216d3174-1d50-36e6-a402-eb0e2850a7de",
                        "source_sense_id": "9d083ff3-b4fd-3814-982d-a7de39263ad6",
                        "target_lang_word": "cuttlefish",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cuttlefish",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3ee892a3-ec44-3585-a076-a0f2b0651185",
                                        "entry_id": "97a2e93c-5f1e-3335-b0e3-9b5e6af1b641",
                                        "glosses": [
                                            "Any squid-like cephalopods (marine mollusks) of the order Sepiida that have eight arms, two retractable tentacles, and a calcareous internal shell, and can eject a dark ink when threatened."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1aa5f9c1-8695-4a4b-aa0b-6231d8bd8f5c",
                                                "sense_id": "3ee892a3-ec44-3585-a076-a0f2b0651185",
                                                "text": "Cuttle-fish, spiced oysters, sea hedge-hogs, and lobsters were among the ingredients of love-potions that reputed thaumaturgist Apuleius [...] was accused of have prepared in order to win the love of a widow."
                                            },
                                            {
                                                "example_id": "2adb53d2-78de-44ea-acda-9c4b02bd1336",
                                                "sense_id": "3ee892a3-ec44-3585-a076-a0f2b0651185",
                                                "text": "Fossilised ink sacs are more conclusively known from the extinct “soft-bodied” Coleoidea cephalopods in groups Belemitida (including belemnites with bullet-like internal skeletons commonly found as fossils) and Phragmoteuthida as well as from squid, octopus and cuttlefish fossils."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "41d9e164-7834-47ce-9956-65eadf1c78b4",
                        "source_entry_id": "216d3174-1d50-36e6-a402-eb0e2850a7de",
                        "source_sense_id": "9d083ff3-b4fd-3814-982d-a7de39263ad6",
                        "target_lang_word": "Tintenfisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tintenfisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "298eedcc-d811-337c-b175-a7d1c41f8194",
                                        "entry_id": "37541eb9-5016-3a4c-9447-6e4f02c373ff",
                                        "glosses": [
                                            "Teilgruppe der Kopffüßer (Cephalopoda), die sich durch den Besitz eines Tintenbeutels auszeichnen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ae1f253-b4e8-42a1-8a56-3e8355d775b6",
                                                "sense_id": "298eedcc-d811-337c-b175-a7d1c41f8194",
                                                "text": "„Seit Jahrmillionen bevölkern Tintenfische, jene räuberischen Weichtiere, alle Meere der Welt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3dfba91a-b9ae-4f60-97e8-058fb46d5c15",
                        "source_entry_id": "216d3174-1d50-36e6-a402-eb0e2850a7de",
                        "source_sense_id": "9d083ff3-b4fd-3814-982d-a7de39263ad6",
                        "target_lang_word": "каракатица",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "каракатица",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "42e23878-4885-384d-a966-8c06e40d4c53",
                                        "entry_id": "200c24ed-d4f8-3e2b-85eb-8126dbf5c68c",
                                        "glosses": [
                                            "зоол. хищный головоногий моллюск, отличающийся наличием известковой внутренней раковины в виде широкой пластинки, занимающей почти всю спинную сторону туловища (лат. sepia)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "797c1726-ad5f-4b73-a6f2-0c212dfd8a81",
                                                "sense_id": "42e23878-4885-384d-a966-8c06e40d4c53",
                                                "text": "У крохотной тихоокеанской двурогой каракатицы чочин-ика особый пузырёк со светящейся жидкостью служит для привлечения добычи, но, подвергшись нападению, каракатица опорожняет его содержимое в воду и спасается бегством, оставляя на растерзание врагу медленно расплывающийся в воде светящийся фантом."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e8dd0e01-6215-32fd-ab21-cc59956a9cdf",
                                        "entry_id": "200c24ed-d4f8-3e2b-85eb-8126dbf5c68c",
                                        "glosses": [
                                            "перен., пренебр. неуклюжий, коротконогий, также некрасивый, неприятный человек (обычно о женщине)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17a3c90d-e503-48ff-862f-7b228fe507b8",
                                                "sense_id": "e8dd0e01-6215-32fd-ab21-cc59956a9cdf",
                                                "text": "― Чего, дамы, — хамски осклабился Гриша, — тут такие девчонки кругом ходят, а я с вами, старыми каракатицами, тусуюсь."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
