                "senses": [
                    {
                        "sense_id": "19488b41-ee85-3315-a8e9-06ed60a781f3",
                        "entry_id": "79078a5d-555a-3f1f-a1a6-040c0a47105b",
                        "glosses": [
                            "Sportler, der mit seinen herausragenden Leistungen eine Ausnahme bildet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74414740-8408-443c-b78b-3516cb53117b",
                                "sense_id": "19488b41-ee85-3315-a8e9-06ed60a781f3",
                                "text": "„In seiner Vernehmung als Zeuge räumte der einstige Ausnahmeathlet ein, seinen Kontrahenten an jenem Wintertag provoziert zu haben.“"
                            },
                            {
                                "example_id": "33362d09-890f-4975-a638-3ff57b69eacd",
                                "sense_id": "19488b41-ee85-3315-a8e9-06ed60a781f3",
                                "text": "„Selbst ein Ausnahmeathlet wie er kann sich dem Alterungsprozess nicht widersetzen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
