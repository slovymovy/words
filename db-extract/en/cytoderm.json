                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1cddfe8d-da69-4e42-9d7f-a5dd63093c04",
                                "sense_id": "f453f2ed-71f7-3734-be55-dd129d0cf6d1",
                                "text": "Several specimens were found, all of which belong to Kirchner's variety subtile, the cytoderm being delicately punctate over the whole surface."
                            },
                            {
                                "example_id": "4140d650-832c-4c64-846c-6b835a7bc597",
                                "sense_id": "f453f2ed-71f7-3734-be55-dd129d0cf6d1",
                                "text": "Potted plants of flue-cured tobacco variety K326 were treated in Zhengzhou, Henan, China by 70-80% (control) and<60% (drought stress) of maximum field water capacity beginning at vigorous growth stage on 2 July 2007, and their leaf samples were taken 16, 28 and 40 days after the treatments were started for observation on the accumulation of cytoderm expansin under electronic microscope."
                            },
                            {
                                "example_id": "b2264c7e-2405-4c47-b483-cec8223725f0",
                                "sense_id": "f453f2ed-71f7-3734-be55-dd129d0cf6d1",
                                "text": "The mixture was transferred into centrifuge tubes then ultrasonically treated five times to break the cytoderm."
                            }
                        ]
                    }
