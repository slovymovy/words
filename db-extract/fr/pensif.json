                ],
                "senses": [
                    {
                        "sense_id": "42fa2965-09c4-36d3-a05f-be56778427d2",
                        "entry_id": "a3173bd2-e3f2-34a0-a06a-f8d46ea654a7",
                        "glosses": [
                            "Qui est occupé d’une pensée qui l’attache fortement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0554ce83-a79e-41ec-b10e-5a479abbd9d9",
                                "sense_id": "42fa2965-09c4-36d3-a05f-be56778427d2",
                                "text": "Vers la fin du mois de mai 1825, Lucien avait perdu toute sa vivacité ; il se sortait plus, dînait avec Herrera, demeurait pensif, travaillait, lisait la collection des traités diplomatiques, restait assis à la turque sur un divan et fumait trois ou quatre houka par jour."
                            },
                            {
                                "example_id": "26c593a6-8a46-4cfb-8d1c-db1b2058382b",
                                "sense_id": "42fa2965-09c4-36d3-a05f-be56778427d2",
                                "text": "L’intendant de police resta un instant pensif, puis il reprit brusquement :\n– Que pensez-vous de tout ceci, James ?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8d0d4368-7917-4db0-bc04-4a157e7d398d",
                        "source_entry_id": "a3173bd2-e3f2-34a0-a06a-f8d46ea654a7",
                        "source_sense_id": "42fa2965-09c4-36d3-a05f-be56778427d2",
                        "target_lang_word": "nachdenklich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nachdenklich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "66782c98-57e9-3376-b59a-ad12225cc95a",
                                        "entry_id": "c17fbbeb-12b1-3b44-85db-0f677ca9bfc1",
                                        "glosses": [
                                            "eigenen Gedanken nachgehend, in Gedanken versunken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "855ccb73-9aa8-4731-8d04-5a6a2e862681",
                                                "sense_id": "66782c98-57e9-3376-b59a-ad12225cc95a",
                                                "text": "Auch der nachdenkliche, besonnene Weit-Blick will gelernt sein. Beim Wirtschaftsminister fehlt allerdings der verwegene Drei-Tage-Bart."
                                            },
                                            {
                                                "example_id": "ce2e80bc-d442-41de-b72e-515f1718e255",
                                                "sense_id": "66782c98-57e9-3376-b59a-ad12225cc95a",
                                                "text": "Meine Tochter Katja saß in der Badewanne und machte ein nachdenkliches Gesicht."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "75443cb5-e4e9-3dcf-916a-15a7b657c606",
                                        "entry_id": "c17fbbeb-12b1-3b44-85db-0f677ca9bfc1",
                                        "glosses": [
                                            "im Wesen zum Nachdenken geneigt, zu Überlegungen neigend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb996392-0d37-4b7c-a5ce-da7e73c42fe9",
                                                "sense_id": "75443cb5-e4e9-3dcf-916a-15a7b657c606",
                                                "text": "Keinen schillernden Karrieretypen habe man da erlebt. Eher eine nachdenkliche Persönlichkeit mit „seltener Brillanz“, sagt der heutige Firmenchef Jochen Kienbaum und attestiert Löscher kulturelles Feingefühl."
                                            },
                                            {
                                                "example_id": "e725e36e-38a5-4257-93cd-d6107ce7d9e5",
                                                "sense_id": "75443cb5-e4e9-3dcf-916a-15a7b657c606",
                                                "text": "Das Buch werde zeigen, dass Monroe \"eine wirklich nachdenkliche Person\" gewesen sei, sagte Herausgeberin Courtney Hodell."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "2e7e4b11-b4d3-33a4-a991-1007c0e7801d",
                                        "entry_id": "c17fbbeb-12b1-3b44-85db-0f677ca9bfc1",
                                        "glosses": [
                                            "zum Nachdenken anregend/anreizend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8662622c-be28-423e-8088-f0c735e53d96",
                                                "sense_id": "2e7e4b11-b4d3-33a4-a991-1007c0e7801d",
                                                "text": "Dass die Salzburger Regierungsparteien insgesamt fast ein Viertel ihrer Wähler verloren hätten, stimmt Haslauer \"nachdenklich.\""
                                            },
                                            {
                                                "example_id": "39115be6-8026-4588-9667-7e924d5b108b",
                                                "sense_id": "2e7e4b11-b4d3-33a4-a991-1007c0e7801d",
                                                "text": "Wie viel Respekt bringt eine Gesellschaft der nächsten Generation entgegen? Diese Frage sollte nicht nur Politiker, sondern auch Eltern und Pädagogen nachdenklich machen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "86579508-38e9-4f39-bcf8-81f392827651",
                        "source_entry_id": "a3173bd2-e3f2-34a0-a06a-f8d46ea654a7",
                        "source_sense_id": "42fa2965-09c4-36d3-a05f-be56778427d2",
                        "target_lang_word": "gedankenvoll",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "36c89c72-9893-4d1b-918b-1806bd9aa701",
                        "source_entry_id": "a3173bd2-e3f2-34a0-a06a-f8d46ea654a7",
                        "source_sense_id": "42fa2965-09c4-36d3-a05f-be56778427d2",
                        "target_lang_word": "thoughtful",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "thoughtful",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "70e6bf9f-e5bf-3c59-b5f5-a68cc54bc685",
                                        "entry_id": "abd1fd48-c2f7-3966-8ccc-cbe37aa9d409",
                                        "glosses": [
                                            "Demonstrating thought or careful consideration."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ddf3dce0-aead-436f-beca-1f26c15b0f33",
                                                "sense_id": "70e6bf9f-e5bf-3c59-b5f5-a68cc54bc685",
                                                "text": "Most thoughtful people eventually solve the puzzle."
                                            },
                                            {
                                                "example_id": "ccd4471a-f88c-4800-afec-491fe4899d42",
                                                "sense_id": "70e6bf9f-e5bf-3c59-b5f5-a68cc54bc685",
                                                "text": "Now the New Year reviving old Desires,\nThe thoughtful Soul to Solitude retires,\nWhere the White Hand of Moses on the Bough\nPuts out, and Jesus from the Ground suspires."
                                            },
                                            {
                                                "example_id": "9b9a0b42-3fee-46e4-90fe-13b3f0949f21",
                                                "sense_id": "70e6bf9f-e5bf-3c59-b5f5-a68cc54bc685",
                                                "text": "But Richmond, his grandfather's darling, after one thoughtful glance cast under his lashes at that uncompromising countenance appeared to lose himself in his own reflections."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6d3533ea-a156-3faf-bcb1-c6e9cf3a18cd",
                                        "entry_id": "abd1fd48-c2f7-3966-8ccc-cbe37aa9d409",
                                        "glosses": [
                                            "Demonstrating kindness or consideration for others."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "51ff19ae-7a1d-47f1-9d28-9695266dc78f",
                                                "sense_id": "6d3533ea-a156-3faf-bcb1-c6e9cf3a18cd",
                                                "text": "Preparing dinner is a thoughtful gesture for a new mother."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2b45845c-2500-4e6b-b85a-4392ba83c8ee",
                        "source_entry_id": "a3173bd2-e3f2-34a0-a06a-f8d46ea654a7",
