                "senses": [
                    {
                        "sense_id": "b5ae9f29-5ece-39d7-915e-e862fc9ddd4b",
                        "entry_id": "b2f36964-8725-3aad-b4aa-51dd4fbe9cd8",
                        "glosses": [
                            "Fahrbahn für Putschiautos (Autoskooter)"
                        ],
                        "tags": [
                            "Swiss Standard German",
                            "regional"
                        ],
                        "examples": [
                            {
                                "example_id": "409d694a-4105-4873-b6ee-61c378b1c061",
                                "sense_id": "b5ae9f29-5ece-39d7-915e-e862fc9ddd4b",
                                "text": "„Oder die Putschiautobahn.“"
                            },
                            {
                                "example_id": "0ed995f8-5077-40a8-92b3-7f12a30f481b",
                                "sense_id": "b5ae9f29-5ece-39d7-915e-e862fc9ddd4b",
                                "text": "„Wer freute sich nicht auf das nächste Mal, wenn die Putschiautobahn im Dorf aufgestellt wurde, wovon die Magenbrotschwaden von weither kündeten?“"
                            },
                            {
                                "example_id": "7f5e6f42-2a38-48f7-a685-686b6d2e26f4",
                                "sense_id": "b5ae9f29-5ece-39d7-915e-e862fc9ddd4b",
                                "text": "„Tatsächlich finden sich vom Streichelzoo über die Putschiautobahn bis hin zu Blaskapellenkonzert und Chasperlitheater zahlreiche vertraute Programmpunkte.“"
                            },
                            {
                                "example_id": "514a3caf-7389-42ec-8746-48f9cff7d509",
                                "sense_id": "b5ae9f29-5ece-39d7-915e-e862fc9ddd4b",
                                "text": "„Natürlich fehlt es auch nicht an einer Putschiautobahn im Lunapark.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
