                "senses": [
                    {
                        "sense_id": "68026a99-77b7-3306-9d7f-aec2f403352b",
                        "entry_id": "05e7ca5f-0402-35f1-85a6-9dfeeafe0dcc",
                        "glosses": [
                            "Creuser le sol afin d’y capturer la marmotte en son terrier."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "c158e1c0-921a-4654-ac2b-55e4bb667d95",
                                "sense_id": "68026a99-77b7-3306-9d7f-aec2f403352b",
                                "text": "C’est à l’automne que les quelques paysans de la contrée partaient le dimanche « chaver ». Chaver voulait dire dans notre jargon patois franco italien : creuser la terre pour prendre les marmottes au nid."
                            }
                        ]
                    },
                    {
                        "sense_id": "328cfcfc-ed1d-3828-9483-19462b2bcf28",
                        "entry_id": "05e7ca5f-0402-35f1-85a6-9dfeeafe0dcc",
                        "glosses": [
                            "Pêcher dans les chaves, les trous creusés par le courant dans les berges des rivières."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "e2990deb-04f1-4753-aaae-19a8b27ffbb6",
                                "sense_id": "328cfcfc-ed1d-3828-9483-19462b2bcf28",
                                "text": "Sous les chênes du Beuvron, il avait trempé ses culottes, il avait pêché en chavant, les bras plongés sous les racines visqueuses …."
                            }
                        ]
                    }
