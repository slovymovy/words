                    "frequency": "High",
                    "semantic_group_id": "family",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Moja <w>babcia</w> ma siedemdziesiąt lat.",
                            "target_lang_translations": {
                                "ru": "Моей <w>бабушке</w> семьдесят лет.",
                                "en": "My <w>grandmother</w> is seventy years old.",
                                "nl": "Mijn <w>oma</w> is zeventig jaar oud.",
                                "de": "Meine <w>Oma</w> ist siebzig Jahre alt.",
                                "fr": "Ma <w>grand-mère</w> a soixante-dix ans.",
                                "it": "Mia <w>nonna</w> ha settant'anni.",
                                "cs": "Mojí <w>babičce</w> je sedmdesát let.",
                                "tr": "Benim <w>büyükannem</w> yetmiş yaşında.",
                                "es": "Mi <w>abuela</w> tiene setenta años.",
                                "zh": "我的<w>奶奶</w>七十岁了。"
                            }
                        },
                        {
                            "text": "W każdy weekend odwiedzamy naszą <w>babcię</w> na wsi.",
                            "target_lang_translations": {
                                "ru": "Каждые выходные мы навещаем нашу <w>бабушку</w> в деревне.",
                                "en": "Every weekend we visit our <w>grandma</w> in the countryside.",
                                "nl": "Elk weekend bezoeken we onze <w>oma</w> op het platteland.",
                                "de": "Jedes Wochenende besuchen wir unsere <w>Großmutter</w> auf dem Land.",
                                "fr": "Chaque week-end, nous rendons visite à notre <w>mamie</w> à la campagne.",
                                "it": "Ogni fine settimana andiamo a trovare nostra <w>nonna</w> in campagna.",
                                "cs": "Každý víkend navštěvujeme naši <w>babičku</w> na vesnici.",
                                "tr": "Her hafta sonu köydeki <w>büyükannemizi</w> ziyaret ederiz.",
                                "es": "Cada fin de semana visitamos a nuestra <w>abuela</w> en el campo.",
                                "zh": "每个周末我们都会去乡下看望我们的<w>奶奶</w>。"
                            }
                        }
