                "senses": [
                    {
                        "sense_id": "456cc94a-4901-39a2-9110-213a23832520",
                        "entry_id": "5acd7bb5-46c2-3145-8fe5-14b40b4eb4a1",
                        "glosses": [
                            "Belastung durch Verkehr"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f25f6be8-78fd-44a1-a452-e7c0f19a9a33",
                                "sense_id": "456cc94a-4901-39a2-9110-213a23832520",
                                "text": "„Zusätzlich zu den ländlichen Regionen wird auch in städtischen Wohngebieten mit wenig Verkehrsbelastung die Hintergrundbelastung ermittelt, die in der Region entsteht.“"
                            },
                            {
                                "example_id": "d68931af-30fb-4420-991b-82a84893c490",
                                "sense_id": "456cc94a-4901-39a2-9110-213a23832520",
                                "text": "„In den Industrienationen heißt die Hauptaufgabe der Stadtplaner daher: Haltet die Stadtflucht in Grenzen, macht eure Städte lebenswert, senkt die Umwelt- und Verkehrsbelastung und schafft attraktiven, günstigen Wohnraum!“"
                            },
                            {
                                "example_id": "2f8758e0-c9b3-4132-b323-6420ba8cb898",
                                "sense_id": "456cc94a-4901-39a2-9110-213a23832520",
                                "text": "„Um den Grund dafür herauszufinden, wurden weitere Faktoren herangezogen, die als potentielle Risikofaktoren für kindliches Asthma gelten: Geschlecht, positiver Allergie-Test, asthmatische oder allergische Erkrankungen bei Eltern oder Geschwistern, Rauchen der Mutter im ersten Lebensjahr des Kindes und zum Zeitpunkt der Untersuchung, Geburtsgewicht des Kindes unter 2 500 Gramm, feuchte Wohnung, Kohle- oder Gas-Heizung, Verkehrsbelastung mit mehr als 75 000 Autos pro Tag im Einzugsgebiet der Schule.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
