                                        "glosses": [
                                            "die Hauptinsel dieser Gruppe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72effab1-2af3-4e74-ad08-4fd3b26031b3",
                                                "sense_id": "fc24a36c-953b-32a5-8c04-01490abb1247",
                                                "text": "Mayotte ist mit ca. 9 Millionen Jahren die älteste Vulkaninsel der Komoren."
