                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le <w>rapprochement</w> des deux bureaux a permis d'améliorer la communication au sein de l'équipe."
                        },
                        {
                            "text": "Ce voyage a favorisé un <w>rapprochement</w> chaleureux entre les membres de la famille."
                        }
                    ],
