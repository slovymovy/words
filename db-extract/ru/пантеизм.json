                    }
                ],
                "senses": [
                    {
                        "sense_id": "c82c99d9-9852-302f-ae17-cb0a662d760f",
                        "entry_id": "f5fd8450-a626-3f09-8484-f65d8a813498",
                        "glosses": [
                            "филос. религиозно-философское учение, отождествляющее Бога с природой и рассматривающее природу как воплощение Божества"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d2abdb5-0415-4985-bf5c-593d7432ed3a",
                                "sense_id": "c82c99d9-9852-302f-ae17-cb0a662d760f",
                                "text": "Художник может исповедовать пантеизм, называть себя мистиком, реалистом ― все равно: сознание единства идеалистично."
                            },
                            {
                                "example_id": "2f3cd8eb-af48-4ac3-b3f8-537d16c193a2",
                                "sense_id": "c82c99d9-9852-302f-ae17-cb0a662d760f",
                                "text": "Пантеизм с его эманацией мира из Божества не допускает ни самостоятельности и свободы Бога, ни самостоятельности и свободы мира и человека."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e54d7f3d-4d89-4d60-bb8b-a1a9b72a8fff",
                        "source_entry_id": "f5fd8450-a626-3f09-8484-f65d8a813498",
                        "source_sense_id": "c82c99d9-9852-302f-ae17-cb0a662d760f",
                        "target_lang_word": "pantheism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pantheism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9990c02a-29b8-3413-ab94-9b77f7b71056",
                                        "entry_id": "23352324-79be-3d39-8021-5750f72b2516",
                                        "glosses": [
                                            "The belief that the Universe is in some sense divine and should be revered. Pantheism identifies the universe with God but denies any personality or transcendence of such a God."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3a4e6bee-3426-3b29-ba11-5e32e64a5fe8",
                                        "entry_id": "23352324-79be-3d39-8021-5750f72b2516",
                                        "glosses": [
                                            "The belief in all gods; omnitheism."
                                        ],
                                        "tags": [
                                            "countable",
                                            "rare",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "18a16d26-91d7-42ce-bae0-52c68a48608f",
                        "source_entry_id": "f5fd8450-a626-3f09-8484-f65d8a813498",
                        "source_sense_id": "c82c99d9-9852-302f-ae17-cb0a662d760f",
                        "target_lang_word": "panteismo",
