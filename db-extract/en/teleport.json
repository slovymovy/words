                    },
                    {
                        "translation_id": "522f30d9-9910-4d3e-8ec7-465a8a4566ac",
                        "source_entry_id": "34231ce1-686c-39ed-9dad-477a8785d1e2",
                        "source_sense_description": "travel without physically crossing distance",
                        "target_lang_word": "téléporter",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "téléporter",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b5ac456e-7edd-34c4-8d92-692d331da4e5",
                                        "entry_id": "acd230c1-d776-360a-8173-28775beb92c5",
                                        "glosses": [
                                            "Transporter au loin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7243ee2e-32d5-44c8-8a18-11ffb586d4aa",
                                                "sense_id": "b5ac456e-7edd-34c4-8d92-692d331da4e5",
                                                "text": "Les ogives trilobées dignes du palais des Doges y abondent, les ruelles aux roses pastels nous téléportent dans la Sérénissime et la place centrale, Tartinjev trg, est hérissée d’un campanile qui se prend — avec succès — pour celui de la place Saint-Marc, de l’autre côté de l’Adriatique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0c365e82-9fcb-3dcc-bf3a-1f55ee6d12b7",
                                        "entry_id": "acd230c1-d776-360a-8173-28775beb92c5",
                                        "glosses": [
                                            "Voyager ou transporter un objet sans, physiquement, passer d’un point à l’autre."
                                        ],
                                        "tags": [
                                            "Science-fiction"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "84ca00d7-4cd6-4b11-ad04-42468ad571c1",
                                                "sense_id": "0c365e82-9fcb-3dcc-bf3a-1f55ee6d12b7",
                                                "text": "Pendant que les escouades de marines étaient téléportés à bord du vaisseau-mère, il amorça la charge atomique qui éradiqua la planète hostile."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "facc2a8a-deda-44e7-9239-e63ae95994bb",
                        "source_entry_id": "34231ce1-686c-39ed-9dad-477a8785d1e2",
                        "source_sense_description": "travel without physically crossing distance",
                        "target_lang_word": "teleportieren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "teleportieren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "08dbff4a-fed1-3f9e-bcdf-3012e20d5ad3",
                                        "entry_id": "b4e998d1-a6fc-31bb-a7f5-c26b0205541d",
                                        "glosses": [
                                            "etwas oder jemanden an einen anderen Ort transportieren, ohne dass die Distanz physisch überwunden wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ea70d41-ab6e-472d-8d1a-5c8a595c7fd2",
                                                "sense_id": "08dbff4a-fed1-3f9e-bcdf-3012e20d5ad3",
                                                "text": "„Wissenschaftlern auf dem fünften Kontinent ist es gelungen, mit Effekten der Quantenmechanik Teilchen über weite Strecken zu teleportieren.“"
                                            },
                                            {
                                                "example_id": "f7e0ef8d-80a3-4dc8-804c-4d246140ebbc",
                                                "sense_id": "08dbff4a-fed1-3f9e-bcdf-3012e20d5ad3",
                                                "text": "Wiener Physiker konnten zeigen, dass sie nicht nur Quanteninformation mithilfe verschränkter Teilchen über 143 Kilometer teleportieren können."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
