                                                "sense_id": "67d161af-779c-3488-aeb3-270367c32f07",
                                                "text": "Ich erwarte eine unverzügliche Antwort."
                                            },
                                            {
                                                "example_id": "b9553f66-f143-4b6b-9b03-7ba4a78b8f27",
                                                "sense_id": "67d161af-779c-3488-aeb3-270367c32f07",
                                                "text": "Änderungen der Einkommensverhältnisse sind dem Amt unverzüglich mitzuteilen."
                                            },
                                            {
                                                "example_id": "4e323767-3293-4643-a91f-8aae31d25b59",
                                                "sense_id": "67d161af-779c-3488-aeb3-270367c32f07",
                                                "text": "Das tritt nach meiner Kenntnis… ist das sofort, unverzüglich."
                                            }
