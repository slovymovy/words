{
    "word_family": [
        "retombée",
        "tomber",
        "tombée",
        "tombant",
        "tombeur"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "61adea09-f2f7-3a00-be03-e3c6f5b46140",
                    "sense_definition": "Tomber une nouvelle fois après s'être relevé.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "mouvement_chute",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'enfant s'est relevé sur le verglas, mais il est <w>retombé</w> aussitôt."
                        },
                        {
                            "text": "Fais bien attention à ne pas <w>retomber</w> sur ce trottoir mouillé."
                        }
                    ],
                    "antonyms": [
                        "se relever"
                    ],
                    "common_phrases": [
                        "retomber par terre"
                    ]
                },
                {
                    "sense_id": "dedf65bc-c2bf-3eda-94ad-9d44766ea403",
                    "sense_definition": "Descendre vers le sol après s'être élevé dans les airs.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "mouvement_chute",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le chat a sauté du mur et a réussi à <w>retomber</w> sur ses pieds."
                        },
                        {
                            "text": "Après avoir atteint le sommet de sa trajectoire, la balle <w>retombe</w> rapidement."
                        }
                    ],
                    "synonyms": [
                        "redescendre"
                    ],
                    "antonyms": [
                        "s'élever",
                        "monter"
                    ],
                    "common_phrases": [
                        "retomber sur ses pieds"
                    ]
                },
                {
                    "sense_id": "adeae6fc-fcd8-3f37-9e61-290564c55b98",
                    "sense_definition": "Être de nouveau atteint d'une maladie dont on n'était pas totalement guéri.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "etat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il est sorti sans manteau et risque de <w>retomber</w> malade."
                        },
                        {
                            "text": "Après quelques jours de rémission, le patient est hélas <w>retombé</w> dans un état fiévreux."
                        }
                    ],
                    "synonyms": [
                        "rechuter"
                    ],
                    "antonyms": [
                        "guérir"
                    ],
                    "common_phrases": [
                        "retomber malade"
                    ]
                },
                {
                    "sense_id": "e687acf9-ede8-332e-a5ae-55db81665cc6",
                    "sense_definition": "Revenir à un état antérieur, souvent négatif ou difficile.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "etat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après cette courte dispute, la pièce <w>retomba</w> dans un silence pesant."
                        },
                        {
                            "text": "Malgré ses bonnes résolutions, il a fini par <w>retomber</w> dans ses travers."
                        }
                    ],
                    "synonyms": [
                        "régresser"
                    ],
                    "antonyms": [
                        "progresser"
                    ],
                    "common_phrases": [
                        "retomber dans ses travers",
                        "retomber dans l'oubli"
                    ]
                },
                {
                    "sense_id": "86f49b97-2d22-3ddc-8ed0-946065fa854f",
                    "sense_definition": "Pendre librement vers le bas, en parlant d'un tissu, de cheveux ou d'éléments végétaux.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "position",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ses longs cheveux bruns <w>retombaient</w> gracieusement sur ses épaules."
                        },
                        {
                            "text": "Les branches du saule pleureur <w>retombent</w> jusqu'à la surface de l'eau."
                        }
                    ],
                    "synonyms": [
                        "pendre"
                    ],
                    "common_phrases": [
                        "retomber sur les épaules"
                    ]
                },
                {
                    "sense_id": "612a4c6d-1adb-3e41-90ac-bffe461da9b6",
                    "sense_definition": "Affecter ou accabler quelqu'un, en parlant des conséquences fâcheuses ou des reproches liés à une action.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "consequence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Si cette décision échoue, tout le blâme va <w>retomber</w> sur le responsable."
                        },
                        {
                            "text": "Il redoutait que les conséquences du scandale ne <w>retombent</w> sur sa famille."
                        }
                    ],
                    "synonyms": [
                        "peser"
                    ],
                    "common_phrases": [
                        "retomber sur quelqu'un"
                    ]
                }
            ]
        }
    ]
}