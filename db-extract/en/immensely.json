                                "target_senses": [
                                    {
                                        "sense_id": "809065d7-8799-34b3-9a44-04e0be60540b",
                                        "entry_id": "0ffbd650-0fb7-3a27-bef2-9d773ee1850d",
                                        "glosses": [
                                            "Beaucoup, d’une manière énorme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2cc8163-2858-4fb5-bd85-67589e3c44df",
                                                "sense_id": "809065d7-8799-34b3-9a44-04e0be60540b",
                                                "text": "Le fait, d’ailleurs, est patent, incontesté, affirmé de tous côtés : l’aisance s’est énormément développée parmi les ruraux des Côtes-du-Nord."
                                            },
                                            {
                                                "example_id": "df7f4dd8-01ae-4201-ab72-cf765a36efaf",
                                                "sense_id": "809065d7-8799-34b3-9a44-04e0be60540b",
                                                "text": "Il avait énormément l’air d'un zamuro…"
                                            },
                                            {
                                                "example_id": "09eae40b-883e-4544-9add-55a041a8eabe",
                                                "sense_id": "809065d7-8799-34b3-9a44-04e0be60540b",
                                                "text": "Les enfants s’amuseront énormément à préparer les recettes présentées dans \" Les petits cuisiniers \", et ils se feront un plaisir de déguster leur chef-d’œuvre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c0b28d36-a4d2-36dc-b279-f7b21207c4a7",
                                        "entry_id": "0ffbd650-0fb7-3a27-bef2-9d773ee1850d",
                                        "glosses": [
                                            "Un nombre énorme de. Une quantité énorme de."
                                        ],
                                        "tags": [
                                            "Avec de"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1407b3ce-047b-4d17-a115-59092b88489e",
                                                "sense_id": "c0b28d36-a4d2-36dc-b279-f7b21207c4a7",
                                                "text": "Nous avons de bonnes touches, beaucoup d’insolence, énormément de liberté de langage."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c8ba5863-6233-47b6-a907-21a262ab5195",
                        "source_entry_id": "f0599c2e-414a-3c02-a7bb-95c23ddb8e57",
