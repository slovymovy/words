                    },
                    {
                        "translation_id": "b0b7c41e-7735-4622-8478-b65173d543cc",
                        "source_entry_id": "c922a03a-8ce8-30a3-be7f-750609b46f37",
                        "source_sense_id": "517816be-a0b2-345f-867d-a38962058e7f",
                        "target_lang_word": "магнитное поле",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "магнитное поле",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "8bba20a9-c838-3b1f-acb5-c9edf33aca66",
                                        "entry_id": "210f7790-0dd8-36e8-a4df-7d414ede6ed0",
                                        "glosses": [
                                            "физ. одна из форм электромагнитного поля, создающееся движущимися электрическими зарядами и спиновыми магнитными моментами, а также переменным электрическим полем"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd4d26a4-9151-4100-ba71-899fc280c685",
                                                "sense_id": "8bba20a9-c838-3b1f-acb5-c9edf33aca66",
                                                "text": "По основному закону физики, магнитное поле возникает всюду, где движется электрическое поле, причём направление его составляет прямые углы с направлением электрического поля и с направлением движения."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "319a3a18-0ca1-393d-aa3e-2d75ebcf23cf",
                                        "entry_id": "210f7790-0dd8-36e8-a4df-7d414ede6ed0",
                                        "glosses": [
                                            "перен., ритор. поле притяжения"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f679cd2d-7353-4e66-9fd0-902cb21dc8ea",
                                                "sense_id": "319a3a18-0ca1-393d-aa3e-2d75ebcf23cf",
                                                "text": "Можно думать, что, аналогично физическому магнитному полю, являет своё магнитное поле и город, и его поле даёт свою картину расположения магнитных сил. Полюсы города ― это его деловая часть, City, и часть, отводимая под жилые дома."
                                            },
                                            {
                                                "example_id": "7c1842fe-daac-4bb0-b84a-419ad3fef85a",
                                                "sense_id": "319a3a18-0ca1-393d-aa3e-2d75ebcf23cf",
                                                "text": "Было что-то бесконечно приятное и порочное в этой поездке вдвоём, но не вследствие жаркого магнитного поля, с первой же минуты образовавшегося между ними, или, скажем, грешного тепла, исходившего из колен незнакомой женщины; порочное заключалось прежде всего в самом соприкосновении Саши с тёмным учрежденьем, где в данную минуту супруг её скверными способами добывал пропитание и для неё самой, и для лошади, которая везла их, и для кучера, дремавшего на облучке."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
