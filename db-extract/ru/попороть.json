                "senses": [
                    {
                        "sense_id": "5fb52907-4c44-3d3f-891d-6b401e2267f4",
                        "entry_id": "955653dc-36d6-30ca-ac0c-9394c36523e7",
                        "glosses": [
                            "совершить действие, выраженное гл. пороть; провести некоторое время, совершая такое действие"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2446a2da-7529-4880-96ae-91e78d98b0ef",
                                "sense_id": "5fb52907-4c44-3d3f-891d-6b401e2267f4",
                                "text": "Ему бы молчать надо да слушать, чтобы… неотнюдь… чтоб дрожал, голоса не смел подать. Покамест еще не женили, попороть хорошенько надо."
                            },
                            {
                                "example_id": "9186b336-8875-4769-ab21-0026816d7b17",
                                "sense_id": "5fb52907-4c44-3d3f-891d-6b401e2267f4",
                                "text": "― Вот что, Мироныч… кликни-ка Савишну… Вчера я малость велела её попороть… небось глаза стыдно теперь показать старой дуре!"
                            }
                        ]
                    }
                ],
