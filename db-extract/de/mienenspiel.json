                "senses": [
                    {
                        "sense_id": "cebf59e2-950f-32e6-b2b8-c6c621c65813",
                        "entry_id": "27aca2b1-6b58-387c-b507-c867d576dd6b",
                        "glosses": [
                            "Bewegung/Veränderung im Gesichtsausdruck"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "64a0ede8-21f2-4699-8441-c4efe5f06c5e",
                                "sense_id": "cebf59e2-950f-32e6-b2b8-c6c621c65813",
                                "text": "„Die Bewegungen dieser Falten bestritten fast sein gesamtes Mienenspiel.“"
                            },
                            {
                                "example_id": "dd07701c-7d33-499c-8386-26bab175e998",
                                "sense_id": "cebf59e2-950f-32e6-b2b8-c6c621c65813",
                                "text": "„Er ließ die Freude erkennen, die ihm das Bestrafen bereitete, denn er hatte nicht gelernt, sein Mienenspiel zu beherrschen.“"
                            },
                            {
                                "example_id": "c7abe349-6680-4a00-9973-313f9696dbd8",
                                "sense_id": "cebf59e2-950f-32e6-b2b8-c6c621c65813",
                                "text": "„Ari hatte sich überlegt, wie er in das Gepräch einsteigen wollte, hatte sich vorgenommen, das Mienenspiel des Historikers genau zu beobachten, aber in diesem Schummerlicht war das leichter gesagt als getan.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
