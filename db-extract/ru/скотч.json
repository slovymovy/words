                        "entry_id": "90f14248-993d-35d7-9d2c-832a14236bc8",
                        "tags": [
                            "plural",
                            "prepositional"
                        ],
                        "form": "ско́тчах"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "49145cf5-519c-3f45-b72d-fc972731fac9",
                        "entry_id": "90f14248-993d-35d7-9d2c-832a14236bc8",
                        "glosses": [
                            "книжн. шотландский ви́ски"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c570c6c7-a626-44c5-b9b7-4bb23b74486e",
                                "sense_id": "49145cf5-519c-3f45-b72d-fc972731fac9",
                                "text": "❬…❭ Там я откупорил бутылку шотландского виски (перед скотчем она никогда не могла устоять). ❬…❭"
                            },
                            {
                                "example_id": "de452844-286b-49e3-a3a6-55651ee01aa1",
                                "sense_id": "49145cf5-519c-3f45-b72d-fc972731fac9",
                                "text": "❬…❭ Он сел в своё кресло под торшером, и сейчас же из спальни появился долговязый с подносом, который он тут же поставил на стол. На подносе стояла початая бутылка скотча, стакан и лежала большая квадратная коробка, обтянутая синим сафьяном. ❬…❭"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
