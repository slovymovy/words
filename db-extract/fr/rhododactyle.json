                        "examples": [
                            {
                                "example_id": "fa40913d-6b3e-4444-b79b-44cea25f9ebc",
                                "sense_id": "46e2cd7c-b9a7-31f5-991d-2339e9ffa44a",
                                "text": "Quand l’Aurore rhododactyle\nDonne aux oiseaux leçon de chant,\nQuand le firmament noir rutile\nDans la pourpre et l’or du couchant,\nSoir et matin je pense à vous,\nMoi, l’indigène de Trévoux."
                            },
                            {
                                "example_id": "9b61d0c3-bc2b-4cc0-9ed2-5fed934dbc86",
                                "sense_id": "46e2cd7c-b9a7-31f5-991d-2339e9ffa44a",
                                "text": "Dès la rhododactyle aurore\nVous l’eussiez entendu grincher\nLe soir il ronchonnait encore\nAuparavant que se coucher."
                            },
                            {
                                "example_id": "0aa62767-8d2e-4ee6-9f8f-cae3d909c8f6",
                                "sense_id": "46e2cd7c-b9a7-31f5-991d-2339e9ffa44a",
                                "text": "C’est à l’aube rhododactyle du lundi 13 février, arrivant directement de Suez, que le chasseur de mines Cassiopée se trouve enfin abrité par les montagnes enneigées de la presqu’île du Péloponnèse."
                            }
                        ]
                    }
