                "senses": [
                    {
                        "sense_id": "5673692b-ebd8-3312-b282-7c83dec39a38",
                        "entry_id": "01a18dd3-d955-3731-bf17-091926fa181f",
                        "glosses": [
                            "Wettrennen, bei dem die Teilnehmer von Schlittenhunden gezogene Hundeschlitten verwenden"
                        ],
                        "tags": [
                            "Hundesport"
                        ],
                        "examples": [
                            {
                                "example_id": "ab0f445b-ab3e-46af-b204-1ea77724864a",
                                "sense_id": "5673692b-ebd8-3312-b282-7c83dec39a38",
                                "text": "„Es gehört wie der Eisbildhauerbewerb, Skijöring und Hundeschlittenrennen zum Fasching und hat lange Tradition in der gleichnamigen Weltkulturerbe-Stadt Québec.“"
                            },
                            {
                                "example_id": "8fa42839-4ce1-46be-a599-180b50f77bc7",
                                "sense_id": "5673692b-ebd8-3312-b282-7c83dec39a38",
                                "text": "„Immer am ersten Wochenende im März startet das längste und härteste Hundeschlittenrennen der Welt: Iditarod in Alaska.“"
                            },
                            {
                                "example_id": "52888c14-d85c-48fe-978f-8f9074ea70de",
                                "sense_id": "5673692b-ebd8-3312-b282-7c83dec39a38",
                                "text": "„Nur knapp zwei Minuten vor seiner schnellsten Verfolgerin erreichte Dallas Seavey am Dienstag das Ziel in Nome, dem Ort, an dem das Iditarod-Hundeschlittenrennen traditionell endet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
