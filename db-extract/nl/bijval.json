        "nl-extract.jsonl": [
            {
                "entry_id": "af327283-ec4b-3a77-bc1d-0a18a50141bf",
                "word": "bijval",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "f754edb2-28bd-34d4-8d63-750f403effe0",
                        "entry_id": "af327283-ec4b-3a77-bc1d-0a18a50141bf",
                        "glosses": [
                            "openlijk geuite instemming, applaus, steun"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a2e8efa-25b7-442d-953b-18c8ba2d3d96",
                                "sense_id": "f754edb2-28bd-34d4-8d63-750f403effe0",
                                "text": "Hij kreeg direct bijval van medestudenten."
                            },
                            {
                                "example_id": "ea5c900a-cc24-4313-adea-a716c26bf3c3",
                                "sense_id": "f754edb2-28bd-34d4-8d63-750f403effe0",
                                "text": "De minister die veel kritiek kreeg was blij met elke bijval die hij ontving."
                            },
                            {
                                "example_id": "399b7312-ca27-402e-aae7-513fe0eadf45",
                                "sense_id": "f754edb2-28bd-34d4-8d63-750f403effe0",
                                "text": "Toch zijn wij er bijzonder aan gehecht, omdat het hier ter plekke naar het leven is geschilderd, toen de vioolvirtuoos op het hoogtepunt van zijn roem in dit hotel verbleef op doorreis naar bijval en furore aan de grote vorstenhoven van Europa."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b6fb37c1-d71b-402d-b19b-3de56b834e0a",
                        "source_entry_id": "af327283-ec4b-3a77-bc1d-0a18a50141bf",
                        "source_sense_id": "f754edb2-28bd-34d4-8d63-750f403effe0",
                        "target_lang_word": "Beifall",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Beifall",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1f55c373-f4ed-338b-8b7d-75fd16463e60",
                                        "entry_id": "6036b42a-2713-3ffd-adba-5e268aeec031",
                                        "glosses": [
                                            "akustische Bekundung von Zustimmung und Gefallen einer Darbietung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7eb194f-de5d-41cf-9397-17aede186d37",
                                                "sense_id": "1f55c373-f4ed-338b-8b7d-75fd16463e60",
                                                "text": "Das Publikum spendete lang anhaltenden, nicht enden wollenden und durch Hochrufe unterbrochenen Beifall."
                                            },
                                            {
                                                "example_id": "978530e8-aed5-4494-b547-3fd3cc1703f0",
                                                "sense_id": "1f55c373-f4ed-338b-8b7d-75fd16463e60",
                                                "text": "„Beinah hätte ich Beifall geklatscht.“"
                                            },
                                            {
                                                "example_id": "1ae58d56-784c-4995-a0fe-dbe5646245ac",
                                                "sense_id": "1f55c373-f4ed-338b-8b7d-75fd16463e60",
                                                "text": "„So brachte ich sie dahin, sich selbst Beifall zu zollen, daß sie den Weg der Nachgiebigkeit gewählt hatte.“"
                                            },
                                            {
                                                "example_id": "de7fdf30-bb09-4f6c-bd1a-7a7e1944fdcc",
                                                "sense_id": "1f55c373-f4ed-338b-8b7d-75fd16463e60",
                                                "text": "„Ein lebhafter Beifall blieb nicht aus.“"
                                            },
                                            {
                                                "example_id": "28a09ee5-9064-4e6b-87bf-9dd791f2adb7",
                                                "sense_id": "1f55c373-f4ed-338b-8b7d-75fd16463e60",
                                                "text": "„Der Zögling nickte Beifall zu.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
