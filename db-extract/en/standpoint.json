                                        "sense_id": "8bbf0c19-82c8-3ad0-9f9c-0de08fc284e8",
                                        "entry_id": "8552313b-b4a6-3fd7-a11c-c6bb70533826",
                                        "glosses": [
                                            "een houding die men aanneemt ten aanzien van een actueel vraagstuk"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "922aa56d-fa5a-4882-b0dc-796e554119b4",
                                                "sense_id": "8bbf0c19-82c8-3ad0-9f9c-0de08fc284e8",
                                                "text": "Het standpunt van de partij staat nog ter discussie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "70cd0249-137d-376d-9941-8833dc0a0f70",
                                        "entry_id": "8552313b-b4a6-3fd7-a11c-c6bb70533826",
                                        "glosses": [
                                            "het punt waar men zich bevindt om waar te nemen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91d048af-44f0-46da-b7b3-3a1fa90fec1f",
                                                "sense_id": "70cd0249-137d-376d-9941-8833dc0a0f70",
                                                "text": "De foto is genomen vanaf het hoogte standpunt."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5d1fec8b-524e-407c-81f5-ff32b6711ffa",
                        "source_entry_id": "326c5239-0dd0-3a0e-bd1e-92bf876ccd11",
                        "source_sense_id": "dcfb07df-e4af-31b0-94a5-9c3280af6cfd",
                        "source_sense_description": "point of view",
                        "target_lang_word": "uitgangspunt",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "uitgangspunt",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "a7ecf586-2cc1-33cd-8a8c-dfd14cce459a",
                                        "entry_id": "09b194d8-f4b0-3fab-9363-b2d95d9a0167",
                                        "glosses": [
                                            "de aannames en veronderstellingen waar men van uitgaat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "879fd1c0-7726-4337-9673-b78e0f7b2256",
                                                "sense_id": "a7ecf586-2cc1-33cd-8a8c-dfd14cce459a",
                                                "text": "De dualiteit van golf en deeltje is het uitgangspunt van de kwantummechanica."
                                            },
                                            {
                                                "example_id": "11bc5ccb-b45c-45d3-a0a1-a545917c1f74",
                                                "sense_id": "a7ecf586-2cc1-33cd-8a8c-dfd14cce459a",
                                                "text": "Waar het in het advies aan ontbreekt, is een inhoudelijke beschouwing ten aanzien van ouderen, hun zorgvraag alsmede de zorgverlening. ‘Betaalbaarheid’ en ‘organiseerbaarheid’ zijn de uitgangspunten."
                                            },
                                            {
                                                "example_id": "bbf2309a-14e3-45a5-94a9-0568c0259485",
                                                "sense_id": "a7ecf586-2cc1-33cd-8a8c-dfd14cce459a",
                                                "text": "Dat was in 1905. Nu was het 1940 en was je terug bij het uitgangspunt. Het was alsof je de Kleivebron opnieuw bouwde."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9b7cae74-c0b4-4ddb-b1e4-e11a7caee885",
                        "source_entry_id": "326c5239-0dd0-3a0e-bd1e-92bf876ccd11",
                        "source_sense_id": "dcfb07df-e4af-31b0-94a5-9c3280af6cfd",
                        "source_sense_description": "point of view",
                        "target_lang_word": "point de vue",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "point de vue",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "88c412a8-da86-397f-b08d-b35872bbdf00",
                                        "entry_id": "5d3c6938-8f32-3bf6-8279-2dc3580d1f43",
                                        "glosses": [
                                            "Lieu d’où l’on regarde, site d’observation, panorama."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a35474e-36a8-400c-8bc6-9cef4cff9e28",
                                                "sense_id": "88c412a8-da86-397f-b08d-b35872bbdf00",
                                                "text": "Par une douce soirée du mois d’août, en 1821, deux personnes gravissaient les chemins pierreux […] et se dirigeaient vers les hauteurs pour y admirer sans doute les points de vue multipliés qu’on y découvre."
                                            },
                                            {
                                                "example_id": "cf054651-629a-47b9-a5bf-a8e6040b9d28",
                                                "sense_id": "88c412a8-da86-397f-b08d-b35872bbdf00",
                                                "text": "Prenant pour point de départ notre point de vue, c’est-à-dire la Terre où nous sommes, nous pouvons de là nous diriger vers les autres planètes de notre système […]"
                                            },
                                            {
                                                "example_id": "7eaa9373-6991-4ad2-b59e-8988365bf4eb",
                                                "sense_id": "88c412a8-da86-397f-b08d-b35872bbdf00",
                                                "text": "À la frontière de quatre départements (Haute-Saône, Territoire de Belfort, Vosges, Haut-Rhin), le ballon d’Alsace constitue également l’un des plus beaux points de vue de la région (sommet à 1 247 m)."
                                            },
                                            {
                                                "example_id": "cc5831fa-eb25-410c-ad7a-338a1a70fde4",
                                                "sense_id": "88c412a8-da86-397f-b08d-b35872bbdf00",
                                                "text": "Un ancien « point de vue » d’où on ne voyait plus rien depuis longtemps, envahi de crottes de lapins et de fragon piquant."
                                            },
                                            {
                                                "example_id": "c16162aa-707c-4809-b1d7-f1eadb6ca0c5",
                                                "sense_id": "88c412a8-da86-397f-b08d-b35872bbdf00",
                                                "text": "Mystère du point de vue. La perspective change totalement la perception du paysage. On croit que celui-ci s’offre tout naturellement si l’on ouvre bien les yeux. C’est faux. Ce que nous voyons, nous le composons et l’inventons pour une large part."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3d601ffe-d023-39cc-8c07-5db9d77a9383",
                                        "entry_id": "5d3c6938-8f32-3bf6-8279-2dc3580d1f43",
                                        "glosses": [
                                            "Manière de voir les choses, façon de considérer un problème, notamment dans les locutions « au point de vue » ou « à tout point de vue »."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2cca7e0-5513-49ca-a117-1cf75e2b3aca",
                                                "sense_id": "3d601ffe-d023-39cc-8c07-5db9d77a9383",
                                                "text": "Vous allez défendre vos points de vue, mais acceptez aussi les critiques."
                                            },
                                            {
                                                "example_id": "4c0eb469-b3b0-4fb6-9ba8-22ee207c930b",
                                                "sense_id": "3d601ffe-d023-39cc-8c07-5db9d77a9383",
                                                "text": "Toutes les personnes qui ont vu de près les chefs des trade-unions sont frappées de l’extrême différence qui existe entre la France et l’Angleterre à ce point de vue ; les chefs des trade-unions deviennent rapidement des gentlemen sans que personne y trouve à redire."
                                            },
                                            {
                                                "example_id": "ae578891-f137-4ba5-9e24-2d2885de9dba",
                                                "sense_id": "3d601ffe-d023-39cc-8c07-5db9d77a9383",
                                                "text": "Au point de vue réparations, le renvideur, étant un métier plus délicat, demande plus de réparations."
                                            },
                                            {
                                                "example_id": "0982dc02-92a2-4365-a4e5-2e2640e96f23",
                                                "sense_id": "3d601ffe-d023-39cc-8c07-5db9d77a9383",
                                                "text": "J’aurais parfaitement compris que Paul Boncour montât à la tribune et démontrât à la Chambre et au pays que le projet du gouvernement ne tenait pas compte, du point de vue bourgeois même, des nécessités actuelles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ab8ae31b-7a60-3b5f-9a41-9c989fe5b121",
                                        "entry_id": "5d3c6938-8f32-3bf6-8279-2dc3580d1f43",
                                        "glosses": [
                                            "Opinion particulière, personnelle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4dd9693c-7567-45b8-a32d-d26cc2b72c9a",
                                                "sense_id": "ab8ae31b-7a60-3b5f-9a41-9c989fe5b121",
                                                "text": "À mesure, en effet, que les années s’écoulaient, l’ancien ministre de maréchal Mac-Mahon modifiait, révisait ses points de vue. Il en venait à juger équitablement les hommes qu’il avait combattus."
                                            },
                                            {
                                                "example_id": "399835b7-2706-4353-b7ff-34d5c667674d",
                                                "sense_id": "ab8ae31b-7a60-3b5f-9a41-9c989fe5b121",
                                                "text": "De son point de vue, Elias Gil avait été un putain d’enfoiré de merde."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "27ae430b-847c-42c0-98b6-8a744c23de53",
                        "source_entry_id": "326c5239-0dd0-3a0e-bd1e-92bf876ccd11",
                        "source_sense_id": "dcfb07df-e4af-31b0-94a5-9c3280af6cfd",
                        "source_sense_description": "point of view",
                        "target_lang_word": "Standpunkt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Standpunkt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f8cd4db8-45b5-39d5-9742-696105b1837c",
                                        "entry_id": "7c546539-6a3c-30f9-8236-b4b8665f775c",
                                        "glosses": [
                                            "räumliche Position"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d631975-723a-441a-a033-9d651f850b6b",
                                                "sense_id": "f8cd4db8-45b5-39d5-9742-696105b1837c",
                                                "text": "Etwa zehn Meter über dem Dach der Insel, aber so weit vom Standpunkt der beiden Deutschen entfernt, daß ihre eben nur aus der Luke hervorblickenden Köpfe kaum bemerkt werden konnten, schwebte der Schiffskörper frei in der Luft. (Kurd Laßwitz, Auf zwei Planeten, z.n. Projekt Gutenberg)"
                                            },
                                            {
                                                "example_id": "3ae14ebd-5cd0-4d9c-ae85-5e2c41ef30cd",
                                                "sense_id": "f8cd4db8-45b5-39d5-9742-696105b1837c",
                                                "text": "Der Maler selbst nahm seinen Standpunkt auf einer Erhöhung im Garten der Hackert'schen Villa selbst, sodaß er den schiefen Bogen der Brücke und den Weg zu derselben als Vordergrund hatte; Eleonore hatte denselben Standpunkt gewählt, aber näher der Brücke, weil sie für ihre Silberstiftzeichnung des größern Details bedurfte. (Heinrich Albert Oppermann, Hundert Jahre 1770–1870, z.n. Projekt Gutenberg)"
                                            },
                                            {
                                                "example_id": "841303d6-7b2f-49a5-9f85-65883586b5aa",
                                                "sense_id": "f8cd4db8-45b5-39d5-9742-696105b1837c",
                                                "text": "„Aber von meinem jetzigen Standpunkt aus, am obersten Zipfel Afrikas, war Namibia noch eine Ewigkeit entfernt; vor mir lag der gesamte Kontinent.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f7419732-c604-3188-9acc-7f545115b548",
                                        "entry_id": "7c546539-6a3c-30f9-8236-b4b8665f775c",
                                        "glosses": [
                                            "Aspekt, der die Betrachtung von etwas bestimmt, Überzeugung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1b36489-9009-44ba-9c20-a6efee92bea4",
                                                "sense_id": "f7419732-c604-3188-9acc-7f545115b548",
                                                "text": "Sie vertritt einen durchaus beschränkten Standpunkt, und wenn ich das Wort wähle, so bin ich noch ritterlich. (Theodor Fontane, Frau Jenny Treibel, z.n. Projekt Gutenberg)"
                                            },
                                            {
                                                "example_id": "be883e2e-df79-4754-bba8-c4569befdbde",
                                                "sense_id": "f7419732-c604-3188-9acc-7f545115b548",
                                                "text": "Ein solcher Standpunkt ist daher nicht als eine Meinung, eine subjektive, beliebige Vorstellungs- und Denkweise eines Individuums, als eine Verirrung der Spekulation, anzusehen; diese findet sich vielmehr auf ihrem Wege nothwendig darauf versetzt, und insofern ist das System vollkommen wahr. (Georg Wilhelm Friedrich Hegel, Wissenschaft der Logik, Zweiter Teil, Die subjektive Logik oder Lehre vom Begriff, z.n. Projekt Gutenberg)"
                                            },
                                            {
                                                "example_id": "b256be4b-308c-4b55-aa48-0030bf556657",
                                                "sense_id": "f7419732-c604-3188-9acc-7f545115b548",
                                                "text": "Nun sind aber gerade die, welche sich am entschiedensten auf diesen Standpunkt stellen, zugleich am festesten überzeugt, daß alle, selbst die höchsten Bewußtseinsprozesse im Menschen, den Willen desselben nicht ausgenommen, an materielle Vorgänge geknüpft sind, welche mit gesetzlicher Notwendigkeit entstehen und vor sich gehen und die Bewußtseinsprozesse eben so gesetzlich notwendig mitführen. (Gustav Theodor Fechner, Einige Ideen zur Schöpfungs- und Entwickelungsgeschichte der Organismen, z.n. Projekt Gutenberg)"
                                            },
                                            {
                                                "example_id": "af738e3b-683d-4778-949d-ba53f0326c26",
                                                "sense_id": "f7419732-c604-3188-9acc-7f545115b548",
                                                "text": "David Hilbert: Manche Menschen haben einen Gesichtskreis vom Radius Null und nennen ihn ihren Standpunkt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "55f96311-2e40-4603-8e54-4e266fa2245e",
                        "source_entry_id": "326c5239-0dd0-3a0e-bd1e-92bf876ccd11",
                        "source_sense_id": "dcfb07df-e4af-31b0-94a5-9c3280af6cfd",
                        "source_sense_description": "point of view",
                        "target_lang_word": "Sichtweise",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sichtweise",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "88907469-5857-33d0-ae46-03b7e876f988",
                                        "entry_id": "f6634594-63ca-368d-97b5-3061422dec3a",
                                        "glosses": [
                                            "Betrachtung oder Bewertung aus einer speziellen Richtung heraus"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60084d0c-9a58-406c-8139-be535bd0954f",
                                                "sense_id": "88907469-5857-33d0-ae46-03b7e876f988",
                                                "text": "Wir haben auf die Planungen vor allem eine ingenieurwissenschaftliche Sichtweise."
                                            },
                                            {
                                                "example_id": "03c7beaa-44c8-4709-aeb3-972856bb0c08",
                                                "sense_id": "88907469-5857-33d0-ae46-03b7e876f988",
                                                "text": "Die Systembiologie ist die biochemische Sichtweise der Welt."
                                            },
                                            {
                                                "example_id": "c3e3c303-9636-4a39-9aac-6322b4ecbad4",
                                                "sense_id": "88907469-5857-33d0-ae46-03b7e876f988",
                                                "text": "„Forster stand mit seiner Sichtweise in Deutschland nicht allein.“"
                                            },
                                            {
                                                "example_id": "4d260d0a-1d03-4e62-a292-39f8b2453e86",
                                                "sense_id": "88907469-5857-33d0-ae46-03b7e876f988",
                                                "text": "„Eine ähnliche Sichtweise vertrat Kurt Riezler, der Sekretär und politische Berater von Reichskanzler Theobald von Bethmann Hollweg.“"
                                            },
                                            {
                                                "example_id": "6b4decdd-7a41-4461-8af6-3eceafc90f06",
                                                "sense_id": "88907469-5857-33d0-ae46-03b7e876f988",
                                                "text": "„Durch den Witz und in dem Witz wird eine Korrektur der Sichtweise vorgenommen, die in der offiziellen Sprache vorgegeben ist, es wird ihr eine andere Sichtweise gegenübergestellt.“"
                                            },
                                            {
                                                "example_id": "1b006e41-cf38-490f-ba50-dea203358223",
                                                "sense_id": "88907469-5857-33d0-ae46-03b7e876f988",
                                                "text": "„Thomas macht gestisch deutlich, dass er diese pessimistische Sichtweise keineswegs teilt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
