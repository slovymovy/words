                    {
                        "translation_id": "b0efda93-4c9e-40b6-afd3-2c23ead78441",
                        "source_entry_id": "de38a416-dc80-3c14-854c-d508be133a1d",
                        "source_sense_id": "4a7fcdb8-d88a-3605-aca4-22d50cd6d6ac",
