                            {
                                "example_id": "c124021b-f0d7-446e-95bf-ab59ad4f4d6c",
                                "sense_id": "b36ae208-b8d0-3317-a7b8-bd059f8f90e2",
                                "text": "De politieagenten kwamen als dader in zicht omdat op een politiecomputer zonder aanleiding het privéadres van Basay-Yildiz was opgezocht."
                            },
                            {
                                "example_id": "c850b6e8-012d-4d77-9cb0-bbcb424dedc6",
                                "sense_id": "b36ae208-b8d0-3317-a7b8-bd059f8f90e2",
                                "text": "Lezers meldden daarop dat Relotius via een privéadres ook geld had ingezameld voor de niet-bestaande kinderen. Het blad stapte daarom naar de politie."
                            },
                            {
                                "example_id": "50a42d8d-e40e-4b58-9afc-2f8e6d211da0",
                                "sense_id": "b36ae208-b8d0-3317-a7b8-bd059f8f90e2",
                                "text": "De affaire lijkt over te waaien, totdat duidelijk wordt dat bij de kraak ook de namen en privéadressen van enkele topambtenaren werden buitgemaakt, die daarna onder medeverantwoordelijkheid van Duyvendak werden gepubliceerd in het Amsterdamse krakersblad Bluf!, vergezeld van de oproep om ‘hun rust te verstoren’."
                            }
