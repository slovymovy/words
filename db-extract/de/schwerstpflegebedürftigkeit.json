                "senses": [
                    {
                        "sense_id": "238755ff-e574-37dd-9bfa-cb71ae61377a",
                        "entry_id": "b025794b-d48b-3d09-860a-de79e809b617",
                        "glosses": [
                            "Zustand der Notwendigkeit intensiver Gesundheitsversorgung aufgrund schwerwiegender Gesundheitsprobleme"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "948f9dd3-8bd9-48b8-bad4-aec8ef46481e",
                                "sense_id": "238755ff-e574-37dd-9bfa-cb71ae61377a",
                                "text": "„Die Anforderungen für die Anerkennung einer Schwerstpflegebedürftigkeit wurden nicht gelockert, insoweit stehen weiterhin vergleichsweise wenig finanzielle Mittel aus der Pflegeversicherung zur Verfügung […]“"
                            },
                            {
                                "example_id": "422ae86d-86c9-4c84-b1d0-b1abf7aaa7b1",
                                "sense_id": "238755ff-e574-37dd-9bfa-cb71ae61377a",
                                "text": "„Wird die Schwerstpflegebedürftigkeit festgestellt, so sind es fünf Stunden, davon vier Stunden, die auf die Grundpflege entfallen.“"
                            },
                            {
                                "example_id": "12b892b1-cce0-4199-893c-3bce7a5d8221",
                                "sense_id": "238755ff-e574-37dd-9bfa-cb71ae61377a",
                                "text": "„Schwerstpflegebedürftigkeit liegt vor, wenn der Hilfebedarf bei der Grundpflege so groß ist, dass er jederzeit gegeben ist und Tag und Nacht(rund um die Uhr) anfällt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
