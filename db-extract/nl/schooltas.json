                                                "sense_id": "b38444f4-4027-32e8-884b-e4a1eb347d84",
                                                "text": "[il] tenait sur ses genoux le cartable du collégien, un vrai portefeuille de ministre en chagrin marron."
                                            },
                                            {
                                                "example_id": "86ed4676-6547-479f-bad9-b2c82a90d222",
                                                "sense_id": "b38444f4-4027-32e8-884b-e4a1eb347d84",
                                                "text": "Mon cartable giberne, en tirant mes épaules en arrière, me faisait une poitrine avantageuse."
                                            },
                                            {
                                                "example_id": "cbd434fb-805d-4089-b9fd-e86e0734a6da",
                                                "sense_id": "b38444f4-4027-32e8-884b-e4a1eb347d84",
                                                "text": "Dans sa boite en carton de 12 portions, La Vache qui rit a toujours ce goût délicieux des quatre-heures qui s'écrasent dans le fond du cartable, pile sur le carnet de notes."
                                            }
                                        ]
                                    },
