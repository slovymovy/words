                        "target_lang_word": "masse terrestre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "48078cd0-a3a3-496f-990f-40225fb07f6b",
                        "source_entry_id": "d3023d4d-6207-3760-9df3-189b2d898b50",
                        "source_sense_id": "3e90d8d6-9553-3e5b-af88-71b70b9a759d",
                        "source_sense_description": "large continuous area of land",
                        "target_lang_word": "Landfläche",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Landfläche",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "85bec353-0a69-3dd4-8935-6f11da4802af",
                                        "entry_id": "019a52b9-2d23-347b-aa99-ad1ee7ef1e8f",
                                        "glosses": [
                                            "Areal (Fläche) zu Lande"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b892e578-096d-4615-b200-c01cda0a62bf",
                                                "sense_id": "85bec353-0a69-3dd4-8935-6f11da4802af",
                                                "text": "Wasserflächen machen 70% der Erdoberfläche aus, die Landfläche beträgt rund 149 Millionen km2."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0b568d34-38dc-4bd6-9ee4-e70afd76dfbf",
                        "source_entry_id": "d3023d4d-6207-3760-9df3-189b2d898b50",
                        "source_sense_id": "3e90d8d6-9553-3e5b-af88-71b70b9a759d",
                        "source_sense_description": "large continuous area of land",
                        "target_lang_word": "Landmasse",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Landmasse",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ca286421-b9bf-370c-92a6-d5bb33499bb9",
                                        "entry_id": "323d92ec-d7b7-3ff7-aae3-599b90f36502",
                                        "glosses": [
                                            "den Meeresspiegel überragender Teil der Erdkruste mit großer Flächenausdehnung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26c8aea3-26ee-4319-be9d-1bf3c4b74ef3",
                                                "sense_id": "ca286421-b9bf-370c-92a6-d5bb33499bb9",
                                                "text": "Die Landmassen stellen im Verhältnis zur Wasseroberfläche nur einen kleinen Teil der Erdöberfläche dar."
                                            },
                                            {
                                                "example_id": "5351496e-f8f1-4db6-b414-4ad84c3509e5",
                                                "sense_id": "ca286421-b9bf-370c-92a6-d5bb33499bb9",
                                                "text": "„Die riesige Landmasse wurde von einer Kolonie zum integralen Teil des Reichs.“"
                                            },
                                            {
                                                "example_id": "82454474-33fb-41c0-87ee-e63bbc47c338",
                                                "sense_id": "ca286421-b9bf-370c-92a6-d5bb33499bb9",
                                                "text": "„Forscher aus Deutschland und der Schweiz konnten nun anhand von Computersimulationen Veränderungen bei der Plattentektonik nachweisen, die letztlich zu den heutigen Landmassen, Ozeanen und womöglich auch zu unserer Atmosphäre geführt haben.“"
                                            },
                                            {
                                                "example_id": "dc9dc75d-f096-4610-bb7d-0c2ef37a9894",
                                                "sense_id": "ca286421-b9bf-370c-92a6-d5bb33499bb9",
                                                "text": "„Zusammengerechnet ist die Landmasse des Archipels nur wenig größer als die Färöer.“"
                                            },
                                            {
                                                "example_id": "b9904159-3e66-499b-9d92-87d955bc10da",
                                                "sense_id": "ca286421-b9bf-370c-92a6-d5bb33499bb9",
                                                "text": "„Als territorial größte Einheit ist Belutschistan mit 42 Prozent der Landmasse die bevölkerungsmäßig kleinste Provinz Pakistans, aber zugleich auch die rohstoffreichste und die mit den niedrigsten sozioökonomischen Indikatoren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d4d9f85b-7484-41ce-9fb7-1a83e69314ad",
                        "source_entry_id": "d3023d4d-6207-3760-9df3-189b2d898b50",
                        "source_sense_id": "3e90d8d6-9553-3e5b-af88-71b70b9a759d",
                        "source_sense_description": "large continuous area of land",
                        "target_lang_word": "Festland",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Festland",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3ae8c463-7a3f-3aad-b4ef-50c90a32e5d7",
                                        "entry_id": "ab5c97b3-235f-304b-a9c8-e014b897453b",
                                        "glosses": [
                                            "die Hauptlandfläche eines Kontinents"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a542213e-a2a1-42a2-8803-cc4a449661e3",
                                                "sense_id": "3ae8c463-7a3f-3aad-b4ef-50c90a32e5d7",
                                                "text": "Der Ärmelkanal trennt England vom europäischen Festland."
                                            },
                                            {
                                                "example_id": "e872b4f2-8a95-4f7e-9a04-5cf37531ab66",
                                                "sense_id": "3ae8c463-7a3f-3aad-b4ef-50c90a32e5d7",
                                                "text": "„Der Nordpol ist kein Festland, ist nicht mit dem Nordkap zu verwechseln und, anders als der Südpol, nicht von Bergen umgeben.“"
                                            },
                                            {
                                                "example_id": "52022b6c-3f7a-4451-94b3-6cde3a9bd092",
                                                "sense_id": "3ae8c463-7a3f-3aad-b4ef-50c90a32e5d7",
                                                "text": "„Sein Südpol ist weit stärker mit Festland bedeckt als der Nordpol, der nur aus einem kleinen Landkäppchen besteht.“"
                                            },
                                            {
                                                "example_id": "4855023d-af2a-4900-be60-a802eced6b93",
                                                "sense_id": "3ae8c463-7a3f-3aad-b4ef-50c90a32e5d7",
                                                "text": "„Dies war auch für das europäische Festland von Bedeutung, denn die christliche Mission Westeuropas erfolgte in der Nachfolge Patricks durch irische Mönche!“"
                                            },
                                            {
                                                "example_id": "fade6410-0916-429a-a22e-faaf596f5522",
                                                "sense_id": "3ae8c463-7a3f-3aad-b4ef-50c90a32e5d7",
                                                "text": "„Was es für einen Seemann bedeutete, das Festland weit hinter sich zu lassen und ins Unbekannte zu segeln, zeigen die Notizen, die Christoph Kolumbus in sein Bordbuch geschrieben hat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3f6d3516-60b2-47aa-b7d9-46e746e071df",
                        "source_entry_id": "d3023d4d-6207-3760-9df3-189b2d898b50",
                        "source_sense_id": "3e90d8d6-9553-3e5b-af88-71b70b9a759d",
