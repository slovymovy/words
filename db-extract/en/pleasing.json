                "senses": [
                    {
                        "sense_id": "67e183f4-c4b6-3975-b287-b0b13455a4ce",
                        "entry_id": "c83754c3-8d44-309e-8b1f-f4a1f1e09bae",
                        "glosses": [
                            "Agreeable; giving pleasure, cheer, enjoyment or gratification."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94c0ed1d-9bfc-4d1e-a5e4-a7f8999944ad",
                                "sense_id": "67e183f4-c4b6-3975-b287-b0b13455a4ce",
                                "text": "These two designs were neat and handsome, by modern standards, and very pleasing in appearance."
                            },
                            {
                                "example_id": "186e06af-57c5-4189-a268-8abcea6f2e7c",
                                "sense_id": "67e183f4-c4b6-3975-b287-b0b13455a4ce",
                                "text": "Elegant brick and stone buildings, with iron and glass canopies and decorative wooden scalloping and fencing—all evidencing care on the part of the architect to produce a pleasing, well-planned building—were submerged beneath a profusion of ill-conceived additions and camouflaged by vulgar paint schemes; and the original conception was lost."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "94b7f27a-3727-4c6f-a397-f1d34db7b6b1",
                        "source_entry_id": "c83754c3-8d44-309e-8b1f-f4a1f1e09bae",
                        "source_sense_id": "67e183f4-c4b6-3975-b287-b0b13455a4ce",
                        "source_sense_description": "giving pleasure",
                        "target_lang_word": "plaisant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "plaisant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "884f72d4-377b-3860-a8be-d203b605cab5",
                                        "entry_id": "b2b7b46a-2549-3ff6-b3c4-3b098b319020",
                                        "glosses": [
                                            "Agréable ; qui plaît."
                                        ],
                                        "tags": [],
                                        "note": "Ce sens est courant au Québec, mais peu usité en France, où il s’emploie surtout dans des phrases négatives",
                                        "examples": [
                                            {
                                                "example_id": "d993b752-1ea0-4196-986d-c90bd643c051",
                                                "sense_id": "884f72d4-377b-3860-a8be-d203b605cab5",
                                                "text": "Ce jardin est plaisant."
                                            },
                                            {
                                                "example_id": "cbe1493c-c578-4c6d-80dc-ef50e79fc1a0",
                                                "sense_id": "884f72d4-377b-3860-a8be-d203b605cab5",
                                                "text": "Il n’est guère plaisant d’avoir affaire à ces gens-là."
                                            },
                                            {
                                                "example_id": "82a5fcad-0941-41a4-9ab5-1b6528772506",
                                                "sense_id": "884f72d4-377b-3860-a8be-d203b605cab5",
                                                "text": "Ce fut encore cette diarrhée verte qui faillit l’enlever, qui, d'une enfant « rêtue » déjà, et plaisante, fit une sorte de morte."
                                            },
                                            {
                                                "example_id": "5205d2a0-4947-44e2-87e0-aa715b6dadc7",
                                                "sense_id": "884f72d4-377b-3860-a8be-d203b605cab5",
                                                "text": "Malgré son air un peu ridicule, ce garçon te plaisait. Et c'était sans aucun doute ce qu'il y avait de plus constant chez lui : il plaisait. Plaisante, sa peau devait l'être au toucher. Son sourire était plaisant, sa démarche l'était aussi. Résultat : tout en lui était si plaisant qu'il en devenait insipide."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "42097a4e-7303-3411-8f7f-55cd6431d7d7",
                                        "entry_id": "b2b7b46a-2549-3ff6-b3c4-3b098b319020",
                                        "glosses": [
                                            "Amusant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f5fceb9-9061-4cb4-b7d3-d52b19363f9f",
                                                "sense_id": "42097a4e-7303-3411-8f7f-55cd6431d7d7",
                                                "text": "Il nous a fait un récit très plaisant."
                                            },
                                            {
                                                "example_id": "4409db13-5592-4b09-9d90-6b4bbe98f573",
                                                "sense_id": "42097a4e-7303-3411-8f7f-55cd6431d7d7",
                                                "text": "Il est plaisant de voir les airs qu’elle se donne."
                                            },
                                            {
                                                "example_id": "50fbf799-8309-4903-a190-5d939e412050",
                                                "sense_id": "42097a4e-7303-3411-8f7f-55cd6431d7d7",
                                                "text": "Je ne trouve rien de plaisant dans votre histoire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dcb4ff72-bc13-3607-a18d-0c93e1446b18",
                                        "entry_id": "b2b7b46a-2549-3ff6-b3c4-3b098b319020",
                                        "glosses": [
                                            "(Placé avant le nom) Impertinent, ridicule."
                                        ],
                                        "tags": [
                                            "ironic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f5925ec4-0ba4-4161-a96f-c288f84b3993",
                                                "sense_id": "dcb4ff72-bc13-3607-a18d-0c93e1446b18",
                                                "text": "C’est un plaisant personnage."
                                            },
                                            {
                                                "example_id": "91e37223-9488-4119-b88d-9a98a55db8a0",
                                                "sense_id": "dcb4ff72-bc13-3607-a18d-0c93e1446b18",
                                                "text": "Ce sont de plaisantes gens."
                                            },
                                            {
                                                "example_id": "3b1cc8bd-d4f8-4f3e-ac22-f212d50e1560",
                                                "sense_id": "dcb4ff72-bc13-3607-a18d-0c93e1446b18",
                                                "text": "Il vous a fait un plaisant accueil."
                                            },
                                            {
                                                "example_id": "adde9098-d276-4a72-8d44-f5962e7c8fd4",
                                                "sense_id": "dcb4ff72-bc13-3607-a18d-0c93e1446b18",
                                                "text": "Je vous trouve bien plaisant de vouloir."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "plaisant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0f64377f-674e-30f9-8829-d8939d5ac047",
                                        "entry_id": "5d27508d-9fca-385e-8e91-b84f4fddb8df",
                                        "glosses": [
                                            "Celui qui cherche à faire rire par ses actions, par ses propos."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b7dc2a6-9e60-454e-9955-b060b45133d7",
                                                "sense_id": "0f64377f-674e-30f9-8829-d8939d5ac047",
                                                "text": "Il fait le plaisant."
                                            },
                                            {
                                                "example_id": "d2547d51-ff1a-485c-a2d3-ee5cab49bcf8",
                                                "sense_id": "0f64377f-674e-30f9-8829-d8939d5ac047",
                                                "text": "Les bons plaisants sont rares."
                                            },
                                            {
                                                "example_id": "f1b56fc5-9972-4e57-a2f1-809e66b86018",
                                                "sense_id": "0f64377f-674e-30f9-8829-d8939d5ac047",
                                                "text": "Un mauvais plaisant, Celui qui fait de mauvaises plaisanteries."
                                            },
                                            {
                                                "example_id": "2d9c56f3-345f-4b58-a420-9adfe65cbf38",
                                                "sense_id": "0f64377f-674e-30f9-8829-d8939d5ac047",
                                                "text": "Le frère aîné, don Juan de Lora, dit à son cousin Gazonal qu’il était la victime d’un plaisant de Paris."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "14cfa506-d0f3-3e8b-8be6-a8da09076424",
                                        "entry_id": "5d27508d-9fca-385e-8e91-b84f4fddb8df",
                                        "glosses": [
                                            "Ce qui fait rire."
                                        ],
                                        "tags": [
                                            "singular"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "644f1d4f-8455-48ae-98d2-19e2c81364b9",
                                                "sense_id": "14cfa506-d0f3-3e8b-8be6-a8da09076424",
                                                "text": "Le plaisant, avec tant d’orgueil, c’est que souvent il ne comprenait absolument rien à ce dont on parlait."
                                            },
                                            {
                                                "example_id": "cef575fb-b3c0-47e6-a75f-f29e7abc28d0",
                                                "sense_id": "14cfa506-d0f3-3e8b-8be6-a8da09076424",
                                                "text": "Il ne faut pas confondre le plaisant avec le bouffon et le burlesque."
                                            },
                                            {
                                                "example_id": "40381682-d1f3-4962-a549-d5d8901b220f",
                                                "sense_id": "14cfa506-d0f3-3e8b-8be6-a8da09076424",
                                                "text": "Il y a une grande différence entre le plaisant et le comique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ecfbfea1-a16a-396c-a79d-49951d397582",
                                        "entry_id": "5d27508d-9fca-385e-8e91-b84f4fddb8df",
                                        "glosses": [
                                            "La chose plaisante, le côté plaisant d'une chose."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "49817a06-f481-4fd8-b1de-2b1803eb5d97",
                                                "sense_id": "ecfbfea1-a16a-396c-a79d-49951d397582",
                                                "text": "Le plaisant de l’aventure, le plaisant de l’histoire fut que…."
                                            }
                                        ]
                                    }
                                ]
                            },
