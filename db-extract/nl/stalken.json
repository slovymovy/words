                                "target_senses": [
                                    {
                                        "sense_id": "f9255699-48f9-39ba-80a2-125ea4f9bee1",
                                        "entry_id": "65857f41-6ee8-3038-ba34-c19af69c77ef",
                                        "glosses": [
                                            "To approach slowly and quietly in order not to be discovered when getting closer."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "106b7e58-3e4f-4bc6-a033-9f6eac3dbca8",
                                                "sense_id": "f9255699-48f9-39ba-80a2-125ea4f9bee1",
                                                "text": "As for shooting a man from behind a wall, it is cruelly like to stalking a deer."
                                            },
                                            {
                                                "example_id": "7d63f643-a9d1-4abd-ba0b-53f9e20b95a5",
                                                "sense_id": "f9255699-48f9-39ba-80a2-125ea4f9bee1",
                                                "text": "But they had already discovered that he could be bullied, and they had it their own way; and presently Selwyn lay prone upon the nursery floor, impersonating a ladrone while pleasant shivers chased themselves over Drina, whom he was stalking."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bd673009-b032-34ea-87ac-5fe87a522e2d",
                                        "entry_id": "65857f41-6ee8-3038-ba34-c19af69c77ef",
                                        "glosses": [
                                            "To (try to) follow or contact someone constantly, often resulting in harassment.ᵂᵖ"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "49f6269e-c50c-4e52-b39d-0157aac57d00",
                                                "sense_id": "bd673009-b032-34ea-87ac-5fe87a522e2d",
                                                "text": "My ex-girlfriend is stalking me."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca429a76-c0bd-39fb-9529-ea230db451f5",
                                        "entry_id": "65857f41-6ee8-3038-ba34-c19af69c77ef",
                                        "glosses": [
                                            "To walk slowly and cautiously; to walk in a stealthy, noiseless manner."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1830ffde-cd0b-498a-9757-eb3fa58c2ae4",
                                                "sense_id": "ca429a76-c0bd-39fb-9529-ea230db451f5",
                                                "text": "[Bertran] stalks close behind her, like a witch's fiend, / Pressing to be employed."
                                            },
                                            {
                                                "example_id": "9329e088-3b26-4e4c-a4f6-8455b041de22",
                                                "sense_id": "ca429a76-c0bd-39fb-9529-ea230db451f5",
                                                "text": "O ay, stalk on, stalk on, the fowl sits"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "03e92eb3-668f-3922-9a35-b7d4b1fa589f",
                                        "entry_id": "65857f41-6ee8-3038-ba34-c19af69c77ef",
                                        "glosses": [
                                            "To walk behind something, such as a screen, for the purpose of approaching game; to proceed under cover."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3cf10588-2deb-4077-9016-9808c6ee1b13",
                                                "sense_id": "03e92eb3-668f-3922-9a35-b7d4b1fa589f",
                                                "text": "The king[…]crept under the shoulder of his led horse;[…]\"I must stalk,\" said he."
                                            },
                                            {
                                                "example_id": "bdf0ec26-c61b-4257-add4-594d58f51d3e",
                                                "sense_id": "03e92eb3-668f-3922-9a35-b7d4b1fa589f",
                                                "text": "One underneath his horse, to get a shoot doth stalk."
                                            }
                                        ]
                                    }
                                ]
                            },
