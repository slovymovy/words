                "senses": [
                    {
                        "sense_id": "598ac3ba-6d32-348c-b581-b27f822460ee",
                        "entry_id": "7c7dc248-5fde-3e62-8ff2-b011079df2f7",
                        "glosses": [
                            "eine bedeutende und qualitativ sehr hochwertige Rotwein-Rebsorte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e84cd96-4d26-4de7-8a9d-8eb75f63ef41",
                                "sense_id": "598ac3ba-6d32-348c-b581-b27f822460ee",
                                "text": "„Aufgrund seiner geschmacklichen Qualität und seines feinen Duftes findet der Spätburgunder trotz der Probleme beim Anbau wieder zunehmend Beachtung; […]“"
                            },
                            {
                                "example_id": "c485dd86-e05d-47dc-8ef3-494360375e3d",
                                "sense_id": "598ac3ba-6d32-348c-b581-b27f822460ee",
                                "text": "„Rotweine gewinnen in Deutschland immer mehr an Bedeutung. […] Sie werden zunehmend in einem bewußt französischen Stil bereitet, mit einem höheren Alkoholgehalt, weniger Restzucker und mit Holzalterung. Hauptrebsorte ist der Spätburgunder (Pinot Noir).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c9dc516e-4311-3dc8-a8b6-7c7b31cf2dd5",
                        "entry_id": "7c7dc248-5fde-3e62-8ff2-b011079df2f7",
                        "glosses": [
                            "Wein, der aus Spätburgunder-Reben hergestellt wurde"
                        ],
