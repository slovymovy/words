                    },
                    {
                        "translation_id": "248e1962-4de4-415c-bd89-6852a2ed4284",
                        "source_entry_id": "a4a9031d-fbab-35d7-8ab6-9eacf2002b06",
                        "source_sense_id": "f397ead6-1445-3183-b498-920d3ec43f90",
                        "source_sense_description": "compound with carbon-oxygen double bond joined via carbon to another oxygen atom",
                        "target_lang_word": "ester",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ester",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "97272283-301b-3bdf-beb9-8e7362bec529",
                                        "entry_id": "d80015a4-9398-3931-b7d7-b5a0987ab169",
                                        "glosses": [
                                            "een koolstofverbinding met de functionele groep -C(=O)-O-C-"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "59182a78-ff73-47ff-a6a4-21a3818b94b5",
                                                "sense_id": "97272283-301b-3bdf-beb9-8e7362bec529",
                                                "text": "Een ester kan gezien worden als het reactieproduct van een alcohol en een carbonzuur."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5375c2b4-57e9-490d-84fe-271161a68994",
                        "source_entry_id": "a4a9031d-fbab-35d7-8ab6-9eacf2002b06",
                        "source_sense_id": "f397ead6-1445-3183-b498-920d3ec43f90",
                        "source_sense_description": "compound with carbon-oxygen double bond joined via carbon to another oxygen atom",
                        "target_lang_word": "ester",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ester",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ebf919c4-f3f6-3cb4-a037-2c1102531c5f",
                                        "entry_id": "c23f5076-0de8-38ff-99e0-e1af61cc555d",
                                        "glosses": [
                                            "Molécule obtenue par la réaction chimique entre un alcool et un oxoacide."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70dffd76-4b8c-48cc-bf26-1df010f04fa8",
                                                "sense_id": "ebf919c4-f3f6-3cb4-a037-2c1102531c5f",
                                                "text": "Fines herbes psychotropiques, notamment silène, spergule et saponaire, concoctées avec ester stéarique de glycérine et jus de coquelicot ranci. Recette infaillible pour susciter hallucinations catachrétiques."
                                            },
                                            {
                                                "example_id": "43d65e8b-08eb-420b-aa51-2711bad3f084",
                                                "sense_id": "ebf919c4-f3f6-3cb4-a037-2c1102531c5f",
                                                "text": "Les esters peuvent encore subir des alcoolyses et des interesterifications ; leur statut ne change pas mais des radicaux sont permutés."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ester",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5daf0cb9-1908-3e5d-b92b-afbfd2ce505b",
                                        "entry_id": "db432552-9d7e-3856-a2ff-0051f8d34edc",
                                        "glosses": [
                                            "Comparaître devant un tribunal ; poursuivre en justice."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c2fc7f3c-51d6-4bcb-b722-7ee1f69d9d62",
                                                "sense_id": "5daf0cb9-1908-3e5d-b92b-afbfd2ce505b",
                                                "text": "L’esclave (sum. ÌR) a un statut juridique, il a une personnalité juridique, il jouit de certains droits, il peut ester en justice, acquérir des biens, épouser une femme libre, sans que celle-ci entre pour autant dans la condition servile."
                                            },
                                            {
                                                "example_id": "c9b8f102-d128-4202-83a6-d443272853a3",
                                                "sense_id": "5daf0cb9-1908-3e5d-b92b-afbfd2ce505b",
                                                "text": "Je n’ai même pas eu à ester en justice, l’éditeur a vite reconnu son tort, arrêté la diffusion du livre et l’a réimprimé en supprimant les passages les plus insupportables de bassesse et de sottise."
                                            },
                                            {
                                                "example_id": "75e8c233-3a8b-4557-990c-7f6eda8b3b06",
                                                "sense_id": "5daf0cb9-1908-3e5d-b92b-afbfd2ce505b",
                                                "text": "Il est par conséquent préférable d’ester, d’ouïr témoins, avocats, apôtres et huissiers, de discourir ainsi le plus longtemps possible avant que de juger."
                                            },
                                            {
                                                "example_id": "a912e4e7-9f9b-473b-a92a-00ecf885cffb",
                                                "sense_id": "5daf0cb9-1908-3e5d-b92b-afbfd2ce505b",
                                                "text": "La fumée blanche est arrivée de Matignon à 22 h 30 passées vendredi 2 avril, à la veille du week-end de Pâques : sur décision du gouvernement, l’agrément d’Anticor, qui permet à l’association anticorruption d’ester en justice, est renouvelé pour la période de trois ans prévue par la loi."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
