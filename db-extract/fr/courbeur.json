                "senses": [
                    {
                        "sense_id": "412c91cb-a4d3-3f1f-8bb4-507a1a7df1a4",
                        "entry_id": "2314bba5-7e4a-35e1-80f0-4a9cfc9b1953",
                        "glosses": [
                            "Celui qui courbe quelque chose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b4e9ce0d-f7a9-4f0f-8bf2-8ba05291c40b",
                                "sense_id": "412c91cb-a4d3-3f1f-8bb4-507a1a7df1a4",
                                "text": "A cet arbre se rattache la fable du Pityokamptes ou courbeur de pins, brigand qui avait choisi pour théâtre de ses crimes l'entrée de l’isthme de Corinthe, et qu’on appelait le Diable des pins. Il était assez fort pour pouvoir courber ces arbres dont l’isthme était couvert, et il exigeait des voyageurs le même tour de force."
                            },
                            {
                                "example_id": "22d2cf6e-f915-41c7-a933-955a216cdaab",
                                "sense_id": "412c91cb-a4d3-3f1f-8bb4-507a1a7df1a4",
                                "text": "Il est une heure où vient la justice popuaire, une heure où l’homme qui comme M. Péraldi n’a jamais été qu’un courbeur d’échine, voit la vieillesse désassouplir, la grâce et l’élégance de ses courbettes."
                            },
                            {
                                "example_id": "2e360143-31c4-4501-bffe-d3218359a4ab",
                                "sense_id": "412c91cb-a4d3-3f1f-8bb4-507a1a7df1a4",
                                "text": "Petrequin, Pierre, courbeur dans la maison Peugeot et Cᵉ à Pont-de-Roide."
                            }
                        ]
                    },
                    {
                        "sense_id": "383793b5-0838-3afe-b77b-59ddf768d978",
                        "entry_id": "2314bba5-7e4a-35e1-80f0-4a9cfc9b1953",
                        "glosses": [
                            "Appareil ou machine qui courbe quelque chose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "475e0ec9-ef47-4bbd-8c15-37d8921d6a78",
                                "sense_id": "383793b5-0838-3afe-b77b-59ddf768d978",
                                "text": "Les coudes sont opérés par un courbeur et un courbeur-coupeur muni d’un couteau formant cisaille avec l’arête du pignon fendu et coupant le fil sans aucune chute."
                            }
                        ]
                    }
