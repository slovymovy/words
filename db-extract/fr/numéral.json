                    }
                ],
                "senses": [
                    {
                        "sense_id": "5ea47cc1-26a9-38d1-90ec-98dc6208f0ea",
                        "entry_id": "6f583acf-00f5-30ad-9414-53902115ea16",
                        "glosses": [
                            "Qui désigne un nombre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3eeefefd-a813-45b9-8e62-559c2f4f10bb",
                                "sense_id": "5ea47cc1-26a9-38d1-90ec-98dc6208f0ea",
                                "text": "I, V, X, L, C, D et M sont des lettres numérales dans les chiffres romains."
                            }
                        ]
                    },
                    {
                        "sense_id": "6b9e419c-2f1b-321a-b8d7-d3b7668e2d0f",
                        "entry_id": "6f583acf-00f5-30ad-9414-53902115ea16",
                        "glosses": [
                            "Qui sert à exprimer le nombre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b97e9466-1f35-48b4-aa9a-1ef254254c78",
                                "sense_id": "6b9e419c-2f1b-321a-b8d7-d3b7668e2d0f",
                                "text": "Substantif, adjectif numéral."
                            },
                            {
                                "example_id": "bbc1039f-d5e1-4852-966c-ec1910e1913e",
                                "sense_id": "6b9e419c-2f1b-321a-b8d7-d3b7668e2d0f",
                                "text": "Arithmétique numérale. Arithmétique par les chiffres. On l’appelle ainsi pour la distinguer de l’arithmétique littérale ou algèbre.\n— Gramm. Substantif, adjectif numéral. Substantif, adjectif qui sert à exprimer le nombre."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "05622b5c-555b-4138-8c5b-b30b5eeb4cb6",
                        "source_entry_id": "6f583acf-00f5-30ad-9414-53902115ea16",
                        "target_lang_word": "numeral",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "numeral",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5dcaf117-f5bc-3430-9ed5-55cc08dd2cf9",
                                        "entry_id": "3ea6fd50-09e2-3e41-a78d-6ea79c647d48",
                                        "glosses": [
                                            "A symbol that is not a word and represents a number, such as the Arabic numerals 1, 2, 3 or the Roman numerals I, V, X, L."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "18f38f11-b6b9-340f-b31b-36569d5554c7",
                                        "entry_id": "3ea6fd50-09e2-3e41-a78d-6ea79c647d48",
                                        "glosses": [
                                            "A representation of a number composed of such symbols."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a550aa3c-82a1-46c8-b52a-7d5f35d9ec86",
                                                "sense_id": "18f38f11-b6b9-340f-b31b-36569d5554c7",
                                                "text": "Compare the numeral for the product with the original decimal numeral."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cb34038a-46bd-3fdc-ad38-8665f92b5c78",
                                        "entry_id": "3ea6fd50-09e2-3e41-a78d-6ea79c647d48",
                                        "glosses": [
                                            "A number word, a simple or compound word for a number often having particular grammatical attributes depending on the language."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c7c5d1a6-4a50-469d-b61c-76c411284f12",
                                                "sense_id": "cb34038a-46bd-3fdc-ad38-8665f92b5c78",
                                                "text": "We use the term numeral for linguistic expressions and number for meanings. For example, five is a numeral expressing the number \"5\" - and fifteen hundred and one thousand five hundred are different numerals expressing the same number, \"1,500\"."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1af278ff-ec07-3f34-8916-c7cc777de500",
                                        "entry_id": "3ea6fd50-09e2-3e41-a78d-6ea79c647d48",
                                        "glosses": [
                                            "A card whose rank is a number (usually including the ace as 1)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c958f5ba-3ab2-4828-bdd0-d762ccc2e0c0",
                                                "sense_id": "1af278ff-ec07-3f34-8916-c7cc777de500",
                                                "text": "Jacks, queens, and kings are not numerals."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "numeral",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "332dcd17-2fbb-3889-965f-add6e970c7d5",
                                        "entry_id": "9134b4b6-6bf5-390e-8a9c-10a4616673f4",
                                        "glosses": [
                                            "Of or relating to numbers; numerical."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3106d2d0-0e4f-4379-bc37-afafd4be2e30",
                                                "sense_id": "332dcd17-2fbb-3889-965f-add6e970c7d5",
                                                "text": "A long train of numeral progressions."
                                            }
                                        ]
                                    }
                                ]
