                "senses": [
                    {
                        "sense_id": "18c2101a-4f8c-38df-95bd-2942d217750c",
                        "entry_id": "df29f0eb-bcc4-37f4-a4c9-3fcde02c8a68",
                        "glosses": [
                            "sterftecijfer"
                        ],
                        "tags": [],
