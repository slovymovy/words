                                "target_senses": [
                                    {
                                        "sense_id": "552acc0e-99b4-3406-82c0-e6574b29da26",
                                        "entry_id": "d3e4dd52-f0b0-3f5d-8b65-67ef5c8708ca",
                                        "glosses": [
                                            "Weg entlang einer Wasserstraße, auf dem früher Zugtiere die Schiffe über das Wasser gezogen haben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2732a48c-f539-4f0c-91aa-b5826484f9ed",
                                                "sense_id": "552acc0e-99b4-3406-82c0-e6574b29da26",
                                                "text": "Der historische Treidelpfad entlang des Kanals ist heute ein beliebter Rad- und Wanderweg."
                                            },
                                            {
                                                "example_id": "4043b405-640f-488a-ab89-9fa55e674460",
                                                "sense_id": "552acc0e-99b4-3406-82c0-e6574b29da26",
                                                "text": "„Das Pferd trottete den holprigen Treidelpfad in Richtung Bath entlang.“"
                                            },
                                            {
                                                "example_id": "878f2a10-8382-4376-84c5-06ded3898b59",
                                                "sense_id": "552acc0e-99b4-3406-82c0-e6574b29da26",
                                                "text": "\"Lein- oder Treidelpfad hieß der Uferweg an schiffbaren Flüssen. Auf ihm zogen Menschen oder Zugtiere Schiffe mit Seilen stromauf.\""
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6a733ea0-4688-49ba-9efc-0fe3fca8b6eb",
                        "source_entry_id": "ccc6f28f-450b-3a93-872a-91ad24bcb2e9",
                        "source_sense_id": "f8d77038-6921-3aff-b32f-211776d88a8d",
                        "source_sense_description": "een pad langs de kant van een kanaal of vaart waarover eertijds de trekdieren van de trekschuit werden voortgedreven",
                        "target_lang_word": "Treidelweg",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Treidelweg",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "083f02ba-ac21-3aa6-8610-76cde0085091",
                                        "entry_id": "f7b02fa2-5b59-319e-b81f-eec02bfe0623",
                                        "glosses": [
                                            "Weg entlang von Flüssen, der dazu dient, Schiffe von Hand oder mit Tieren flussaufwärts zu ziehen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "228058be-c71f-48de-b0f9-56ee7d65d4f5",
                                                "sense_id": "083f02ba-ac21-3aa6-8610-76cde0085091",
                                                "text": "Der Treidelweg wechselt manchmal die Flussseite."
                                            },
                                            {
                                                "example_id": "d214c086-7ca9-4acb-9ece-de43a9bd27af",
                                                "sense_id": "083f02ba-ac21-3aa6-8610-76cde0085091",
                                                "text": "„Dort unten auf dem Treidelweg jenseits des Stromes schleppen Bomätschen einen Elbkahn stromaufwärts.“"
                                            },
                                            {
                                                "example_id": "ce676e1f-b6cb-412d-afc2-1b29eca3797f",
                                                "sense_id": "083f02ba-ac21-3aa6-8610-76cde0085091",
                                                "text": "„Gern gingen wir auf den Uferdämmen und Treidelwegen der Flüsse.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "62f3b44e-b3e6-44cd-8da0-0e0938251c61",
                        "source_entry_id": "ccc6f28f-450b-3a93-872a-91ad24bcb2e9",
                        "source_sense_id": "f8d77038-6921-3aff-b32f-211776d88a8d",
