                                        "entry_id": "08366818-b489-3d6f-a3b0-fdff8b51a15f",
                                        "glosses": [
                                            "ontwikkeling tot een verbond van staten die hun zelfstandigheid behouden, maar erkennen dat het verbond de hoogste zeggenschap heeft"
                                        ],
                                        "tags": [],
