                    }
                ],
                "senses": [
                    {
                        "sense_id": "7e7ce933-2c09-340f-abf0-79c5cd801011",
                        "entry_id": "808a887b-eeb3-3a3b-830a-1a694acefd46",
                        "glosses": [
                            "Genre de plantes monocotylédones de la famille des Marantacées, composé d’environ 20 espèces de vivaces rhizomateuses à feuillage persistant, poussant dans la forêt humide tropicale, en Amérique centrale et en Amérique du Sud."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e895cdc-a38f-43d2-9be2-5011d763a3e1",
                                "sense_id": "7e7ce933-2c09-340f-abf0-79c5cd801011",
                                "text": "Là, sur des gradins, cachant à demi les tuyaux de chauffage, fleurissaient les Maranta, douces au toucher comme du velours, les Gloxinia, aux cloches violettes, les Dracena, semblables à des lames de vieille laque vernie."
                            },
                            {
                                "example_id": "0e56e6ec-0429-4d37-bc3e-36d85a5a789f",
                                "sense_id": "7e7ce933-2c09-340f-abf0-79c5cd801011",
                                "text": "Tous ces bâtiments sont bien arrangés et bien entretenus, environnés de charmilles où mûrissent les marantas."
                            }
                        ]
                    },
                    {
                        "sense_id": "bc7f3609-6d36-3a70-9a97-8361e62b43ee",
                        "entry_id": "808a887b-eeb3-3a3b-830a-1a694acefd46",
                        "glosses": [
                            "Synonyme d’arrow-root, plante cultivée pour les vertus thérapeutiques et alimentaires de sa racine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6303ba5e-bd17-4306-bb99-3f1df609340e",
                                "sense_id": "bc7f3609-6d36-3a70-9a97-8361e62b43ee",
                                "text": "La maranta. Cette plante cultivée pour son rhizome est originaire du Brésil et du Venezuela, où existent les formes sauvages. Elle est très répandue aux Antilles, particulièrement à Saint Vincent et sa culture est pratiquée en Inde, au Sri Lanka et en Indonésie. — (Cirad/Gret/MAE, Mémento de l'Agronome, 1 692 pages, page 850, 2002, Paris, France, Cirad/Gret/Ministère des Affaires Étrangères)"
                            }
                        ]
                    }
                ],
