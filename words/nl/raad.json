    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2f83741a-bdb7-3506-a303-9d3ef1529dab",
                    "sense_definition": "een aanbeveling of suggestie over hoe men het beste kan handelen in een bepaalde situatie",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "advies",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij gaf hem de goede <w>raad</w> om niet op die boze e-mail te reageren.",
                            "target_lang_translations": {
                                "en": "He gave him the good <w>advice</w> not to respond to that angry email.",
                                "ru": "Он дал ему хороший <w>совет</w> не отвечать на то гневное письмо."
                            }
                        },
                        {
                            "text": "Mijn vader staat mij altijd met <w>raad</w> en daad bij als ik problemen heb.",
                            "target_lang_translations": {
                                "en": "My father always supports me with <w>counsel</w> and action whenever I have problems.",
                                "ru": "Мой отец всегда помогает мне <w>советом</w> и делом, когда у меня возникают проблемы."
                            }
                        }
                    ],
                    "synonyms": [
                        "advies",
                        "tip"
                    ],
                    "common_phrases": [
                        "raad en daad",
                        "goede raad",
                        "iemand om raad vragen"
                    ],
                    "target_lang_definitions": {
                        "en": "a recommendation or suggestion on how best to act in a particular situation",
                        "ru": "рекомендация или предложение о том, как лучше всего действовать в определенной ситуации"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "advice",
                                "target_lang_sense_clarification": "guidance or recommendations"
                            },
                            {
                                "target_lang_word": "counsel",
                                "target_lang_sense_clarification": "formal or professional advice"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "совет",
                                "target_lang_sense_clarification": "рекомендация"
                            },
                            {
                                "target_lang_word": "наставление",
                                "target_lang_sense_clarification": "поучительный совет"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ffc3f124-4ec7-398f-906b-0fa48b2a0a07",
                    "sense_definition": "een officieel orgaan of een groep mensen die belast is met adviseren of het nemen van besluiten",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "bestuursorgaan",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>raad</w> besloot na een lange discussie het nieuwe voorstel toch aan te nemen.",
                            "target_lang_translations": {
                                "en": "The <w>council</w> decided to accept the new proposal after a long discussion.",
                                "ru": "<w>Совет</w> после долгого обсуждения всё же решил принять новое предложение."
                            }
                        },
                        {
                            "text": "De <w>raad</w> van commissarissen houdt toezicht op het beleid van de directeuren.",
                            "target_lang_translations": {
                                "en": "The <w>board</w> of directors supervises the policy of the managers.",
                                "ru": "Наблюдательный <w>совет</w> контролирует политику директоров."
                            }
                        }
                    ],
                    "synonyms": [
                        "adviesorgaan",
                        "college",
                        "gremium"
                    ],
                    "common_phrases": [
                        "raad van bestuur",
                        "raad van commissarissen",
                        "gemeentelijke raad"
                    ],
                    "target_lang_definitions": {
                        "en": "an official body or group of people responsible for advising or making decisions",
                        "ru": "официальный орган или группа людей, ответственных за консультирование или принятие решений"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "council",
                                "target_lang_sense_clarification": "a governing or administrative body"
                            },
                            {
                                "target_lang_word": "board",
                                "target_lang_sense_clarification": "a group of people managing an organization"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "совет",
                                "target_lang_sense_clarification": "административный орган"
                            },
                            {
                                "target_lang_word": "коллегия",
                                "target_lang_sense_clarification": "группа должностных лиц"
                            },
                            {
                                "target_lang_word": "правление",
                                "target_lang_sense_clarification": "руководящий орган организации"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9e9200d7-25e0-34e6-9564-d5b1f3a3ae1b",
                    "sense_definition": "een formele bijeenkomst of vergadering waarin overleg wordt gepleegd om tot een besluit te komen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "overleg",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tijdens de <w>raad</w> van vorige week is er gesproken over de nieuwe parkeerplaatsen.",
                            "target_lang_translations": {
                                "en": "During last week's <w>council</w> meeting, the new parking spaces were discussed.",
                                "ru": "Во время <w>совещания</w> на прошлой неделе обсуждались новые парковочные места."
                            }
                        },
                        {
                            "text": "De ministers kwamen in <w>raad</w> bijeen om de crisis in het land te bespreken.",
                            "target_lang_translations": {
                                "en": "The ministers met in <w>council</w> to discuss the crisis in the country.",
                                "ru": "Министры собрались на <w>совет</w>, чтобы обсудить кризис в стране."
                            }
                        }
                    ],
                    "synonyms": [
                        "beraad",
                        "bijeenkomst",
                        "vergadering"
                    ],
                    "common_phrases": [
                        "in raad bijeenkomen"
                    ],
                    "target_lang_definitions": {
                        "en": "a formal meeting or assembly where consultation takes place to reach a decision",
                        "ru": "официальное собрание или заседание, на котором проводятся консультации для принятия решения"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "council",
                                "target_lang_sense_clarification": "a formal meeting for deliberation"
                            },
                            {
                                "target_lang_word": "deliberation",
                                "target_lang_sense_clarification": "formal discussion or consultation"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "совещание",
                                "target_lang_sense_clarification": "заседание для обсуждения"
                            },
                            {
                                "target_lang_word": "совет",
                                "target_lang_sense_clarification": "собрание членов совета"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c1633f26-214f-32e4-9ef1-db4ea65d9258",
                    "sense_definition": "een persoon die in een officiële functie advies geeft, vaak als titel voor een lid van een hoog rechtscollege",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "functionaris",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De gouverneur luisterde aandachtig naar de argumenten van de verschillende <w>raden</w>.",
                            "target_lang_translations": {
                                "en": "The governor listened carefully to the arguments of the various <w>counselors</w>.",
                                "ru": "Губернатор внимательно выслушал аргументы различных <w>советников</w>."
                            }
                        },
                        {
                            "text": "Als <w>raad</w> bij het hof heeft hij veel invloed op de uiteindelijke uitspraak.",
                            "target_lang_translations": {
                                "en": "As a <w>counselor</w> at the court, he has a lot of influence on the final verdict.",
                                "ru": "Как <w>советник</w> при суде, он имеет большое влияние на окончательный приговор."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Vaak gebruikt in historische of zeer formele juridische contexten."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "a person who gives advice in an official capacity, often as a title for a member of a high court",
                        "ru": "лицо, дающее советы в официальном качестве, часто титул члена высокого суда"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "counselor",
                                "target_lang_sense_clarification": "an official advisor"
                            },
                            {
                                "target_lang_word": "councilor",
                                "target_lang_sense_clarification": "a member of a council"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "советник",
                                "target_lang_sense_clarification": "официальный консультант"
                            },
                            {
                                "target_lang_word": "член совета",
                                "target_lang_sense_clarification": "участник официального органа"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ac9d1c2f-39dd-306b-bd22-803328bed7c1",
                    "sense_definition": "zorg of voorziening, tegenwoordig alleen nog herkenbaar in samenstellingen zoals huisraad of voorraad",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "voorziening",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In oude teksten zie je dat <w>raad</w> ook de betekenis van voorraad of bezit kon hebben.",
                            "target_lang_translations": {
                                "en": "In old texts, you see that <w>provision</w> could also have the meaning of stock or possession.",
                                "ru": "В старых текстах можно увидеть, что слово raad могло также иметь значение <w>запаса</w> или владения."
                            }
                        },
                        {
                            "text": "Het woord huisraad verwijst naar de verzameling spullen die voor het huishouden nodig zijn.",
                            "target_lang_translations": {
                                "en": "The word 'huisraad' refers to the collection of <w>effects</w> needed for the household.",
                                "ru": "Слово huisraad относится к совокупности вещей (<w>утвари</w>), необходимых для ведения хозяйства."
                            }
                        }
                    ],
                    "antonyms": [
                        "onraad"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Alleen nog gebruikelijk in specifieke samenstellingen."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "provision or supply, nowadays only recognizable in compounds like household effects or stock",
                        "ru": "обеспечение или запас, в настоящее время встречается только в сложных словах"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "provisions",
                                "target_lang_sense_clarification": "supplies or equipment"
                            },
                            {
                                "target_lang_word": "effects",
                                "target_lang_sense_clarification": "belongings or household items"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "утварь",
                                "target_lang_sense_clarification": "предметы обихода (в составе huisraad)"
                            },
                            {
                                "target_lang_word": "запас",
                                "target_lang_sense_clarification": "наличие чего-либо (в составе voorraad)"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b95d3812-1fc8-3936-8124-0d6481f0353f",
                    "sense_definition": "de eerste persoon enkelvoud tegenwoordige tijd van het werkwoord <w>raden</w>",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>raad</w> je aan om morgen op tijd te komen voor de belangrijke afspraak.",
                            "target_lang_translations": {
                                "en": "I <w>advise</w> you to arrive on time tomorrow for the important appointment.",
                                "ru": "Я <w>советую</w> тебе завтра прийти вовремя на важную встречу."
                            }
                        },
                        {
                            "text": "Ik <w>raad</w> het antwoord op het raadsel meestal binnen een paar seconden.",
                            "target_lang_translations": {
                                "en": "I usually <w>guess</w> the answer to the riddle within a few seconds.",
                                "ru": "Обычно я <w>отгадываю</w> ответ на загадку за несколько секунд."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "ik-vorm"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "the first person singular present tense of the verb 'raden' (to guess/advise)",
                        "ru": "форма первого лица единственного числа настоящего времени глагола 'raden' (советовать/угадывать)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "advise",
                                "target_lang_sense_clarification": "to give advice (I form)"
                            },
                            {
                                "target_lang_word": "guess",
                                "target_lang_sense_clarification": "to estimate or suppose (I form)"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "советую",
                                "target_lang_sense_clarification": "даю совет"
                            },
                            {
                                "target_lang_word": "угадываю",
                                "target_lang_sense_clarification": "даю правильный ответ"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "66127ebc-4fb8-3b3e-a0e1-5739bfb47899",
                    "sense_definition": "de gebiedende wijs van het werkwoord <w>raden</w>",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Raad</w> eens wie ik vanmorgen in de supermarkt tegenkwam!",
                            "target_lang_translations": {
                                "en": "<w>Guess</w> who I ran into at the supermarket this morning!",
                                "ru": "<w>Угадай</w>, кого я встретил сегодня утром в супермаркете!"
                            }
                        },
                        {
                            "text": "<w>Raad</w> niet zomaar wat het antwoord is, maar denk eerst goed na.",
                            "target_lang_translations": {
                                "en": "Don't just <w>guess</w> what the answer is, but think carefully first.",
                                "ru": "Не <w>угадывай</w> ответ просто так, а сначала хорошенько подумай."
                            }
                        }
                    ],
                    "common_phrases": [
                        "raad eens"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "imperatief"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "the imperative mood of the verb 'raden' (to guess/advise)",
                        "ru": "повелительное наклонение глагола 'raden' (угадывать/советовать)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "guess",
                                "target_lang_sense_clarification": "command to estimate"
                            },
                            {
                                "target_lang_word": "advise",
                                "target_lang_sense_clarification": "command to give advice"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "угадай",
                                "target_lang_sense_clarification": "просьба отгадать"
                            },
                            {
                                "target_lang_word": "посоветуй",
                                "target_lang_sense_clarification": "просьба дать совет"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "37c53888-8791-38b3-90dc-a19362bf87f6",
                    "sense_definition": "de tweede persoon enkelvoud tegenwoordige tijd van <w>raden</w> wanneer het onderwerp achter het werkwoord staat",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Waarom <w>raad</w> je niet gewoon wat er in het grote cadeau zit?",
                            "target_lang_translations": {
                                "en": "Why don't you just <w>guess</w> what is inside the big present?",
                                "ru": "Почему бы тебе просто не <w>угадать</w>, что находится в этом большом подарке?"
                            }
                        },
                        {
                            "text": "Wat <w>raad</w> je mij aan om te doen in deze lastige situatie?",
                            "target_lang_translations": {
                                "en": "What do you <w>advise</w> me to do in this difficult situation?",
                                "ru": "Что ты мне <w>посоветуешь</w> сделать в этой сложной ситуации?"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "inversie met jij/je"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "the second person singular present tense of 'raden' when the subject follows the verb",
                        "ru": "форма второго лица единственного числа настоящего времени глагола 'raden' при инверсии"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "guess",
                                "target_lang_sense_clarification": "do you guess"
                            },
                            {
                                "target_lang_word": "advise",
                                "target_lang_sense_clarification": "do you advise"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "угадываешь",
                                "target_lang_sense_clarification": "ты угадываешь (в вопросе)"
                            },
                            {
                                "target_lang_word": "советуешь",
                                "target_lang_sense_clarification": "ты советуешь (в вопросе)"
                            }
                        ]
                    }
                }
            ]
        }
    ]
