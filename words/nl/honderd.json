                    "sense_id": "b213bac9-124b-3beb-9149-93f96e0ae242",
                    "sense_definition": "het getal 100, tien maal tien, volgend op negenennegentig",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "getallen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De totale kosten voor de boodschappen bedragen precies <w>honderd</w> euro. ",
                            "target_lang_translations": {
