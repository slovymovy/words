                                    }
                                ]
                            },
                            {
                                "target_word": "Fabien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ba9f0b9d-c102-3a64-bd60-e71680ea1bc8",
                                        "entry_id": "e1b3fcb3-a7d2-3118-982c-9a0730be8524",
                                        "glosses": [
                                            "Prénom masculin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "08fc3834-62eb-40da-bb95-4bebf5d07fda",
                                                "sense_id": "ba9f0b9d-c102-3a64-bd60-e71680ea1bc8",
                                                "text": "« Mon coup de cœur, c’est Camélia Jordana », confie Fabien Gay, qui se réjouit de ce « moment de retrouvailles » après deux ans de Covid-19."
                                            },
                                            {
                                                "example_id": "892f4113-bbdb-4279-a206-2967b952fe8d",
                                                "sense_id": "ba9f0b9d-c102-3a64-bd60-e71680ea1bc8",
                                                "text": "Fabien Bonnel a encore donné de la voix pour France-Autriche, au cœur des Irrésistibles Français."
                                            },
                                            {
                                                "example_id": "f5d98115-cd09-48b4-b79e-8adc01f46f0a",
                                                "sense_id": "ba9f0b9d-c102-3a64-bd60-e71680ea1bc8",
                                                "text": "En tennis de table maintenant, Benoît Froment, de la Fédération française handisport (FFH), donne le nom de Fabien Lamirault et Matéo Bohéas, « les numéros 1 et 5 mondiaux »."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Fabien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0027586f-41ca-39ba-b7a6-dbb3d4b45c77",
                                        "entry_id": "f8971af7-62eb-3e45-b559-3a67ab4473f1",
                                        "glosses": [
                                            "Pour place du Colonel-Fabien: le siège du parti communiste français (PCF), ou par extension, sa direction."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be7e5665-62fe-4d7a-b488-b28461225deb",
                                                "sense_id": "0027586f-41ca-39ba-b7a6-dbb3d4b45c77",
                                                "text": "À Fabien, il y a maintenant très peu de monde : la maison est vide, la cantine est fermée, chacun travaille dans son coin."
                                            },
                                            {
                                                "example_id": "b7a44ab5-139b-44d3-b160-562fbb97c957",
                                                "sense_id": "0027586f-41ca-39ba-b7a6-dbb3d4b45c77",
                                                "text": "Je me rappelle les beaux jours, quand j’étais reçu à Fabien après de longues tractations avec le service de presse du Parti"
                                            },
                                            {
                                                "example_id": "8a4fd38c-9df1-449e-a065-fecdb8a20991",
                                                "sense_id": "0027586f-41ca-39ba-b7a6-dbb3d4b45c77",
                                                "text": "Je me souviens que je fis un rapport à « Fabien » où je disais que ce Front sandiniste et ses jeunes « muchachos » étaient « l’avant-garde » d’une révolution en marche… que cela nous plaise ou pas"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
