                                        "glosses": [
                                            "The killing of one's own child."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7dcbded7-2625-482f-b30c-10b162524028",
                                                "sense_id": "4685bbc7-5924-315e-8a0a-4a89922ccf39",
                                                "text": "it began by violating nature, and ends in filicide. (I, v)"
                                            },
                                            {
                                                "example_id": "994eb305-11f8-463c-834c-3c884ffa7c36",
                                                "sense_id": "4685bbc7-5924-315e-8a0a-4a89922ccf39",
                                                "text": "Terms related to familicide include filicide (the killing of one's child or children), uxoricide (the killing of one's wife), fratricide or sororicide (the killing of one's brother or sister), avunculicide (the killing of one's uncle), and nepoticide (the killing of one's nephew)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a7434591-1853-3d76-870f-fc4e4b132124",
                                        "entry_id": "86cab805-9fd3-3ea5-a7a2-cbd80e29ff41",
                                        "glosses": [
                                            "A person who kills his or her own child."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
