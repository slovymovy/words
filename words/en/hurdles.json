    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0e5d4c30-80e9-304a-938e-760613f599fb",
                    "sense_definition": "plural of <w>hurdle</w>",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "obstacles",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company faced many financial <w>hurdles</w> during its first year of operation.",
                            "target_lang_translations": {
                                "nl": "Het bedrijf stuitte tijdens zijn eerste operationele jaar op veel financiële <w>horden</w>."
                            }
                        },
                        {
                            "text": "They had to jump over several wooden <w>hurdles</w> during the training session.",
                            "target_lang_translations": {
                                "nl": "Tijdens de trainingssessie moesten ze over verschillende houten <w>horden</w> springen."
                            }
                        }
                    ],
                    "synonyms": [
                        "obstacles",
                        "barriers"
                    ],
                    "common_phrases": [
                        "overcome hurdles",
                        "face hurdles"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "plural"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Meervoud van horde: obstakels, belemmeringen of fysieke hekjes waar men overheen moet springen."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "horden",
                                "target_lang_sense_clarification": "meervoud van horde (zowel fysiek als figuurlijk)"
                            },
                            {
                                "target_lang_word": "obstakels",
                                "target_lang_sense_clarification": "figuurlijke belemmeringen"
                            },
                            {
                                "target_lang_word": "hindernissen",
                                "target_lang_sense_clarification": "fysieke of figuurlijke belemmeringen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e26a9387-3ba8-3431-8aed-88da8e653788",
                    "sense_definition": "A track and field race in which athletes must leap over a series of barriers while running.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "athletics_sport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Despite a stumble, he managed to come fourth in the <w>hurdles</w>.",
                            "target_lang_translations": {
                                "nl": "Ondanks een struikeling wist hij vierde te worden op de <w>hordeloop</w>."
                            }
                        },
                        {
                            "text": "She has been training intensely for the 100-meter <w>hurdles</w> at the national championship.",
                            "target_lang_translations": {
                                "nl": "Ze traint intensief voor de 100 meter <w>horden</w> op de nationale kampioenschappen."
                            }
                        }
                    ],
                    "synonyms": [
                        "hurdling"
                    ],
                    "common_phrases": [
                        "100-meter hurdles",
                        "run the hurdles"
                    ],
                    "target_lang_definitions": {
                        "nl": "Een atletiekonderdeel waarbij lopers over een reeks horden moeten springen; hordelopen."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "hordeloop",
                                "target_lang_sense_clarification": "de atletiekwedstrijd of het onderdeel"
                            },
                            {
                                "target_lang_word": "horden",
                                "target_lang_sense_clarification": "als aanduiding voor het sportonderdeel (bijv. 100 meter horden)"
                            },
                            {
                                "target_lang_word": "hordelopen",
                                "target_lang_sense_clarification": "het onderdeel hordelopen"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "09930c8b-9a3a-32af-ba5d-173181f51804",
                    "sense_definition": "third-person singular simple present indicative of <w>hurdle</w>",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "jumping_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The agile runner <w>hurdles</w> every obstacle with remarkable grace and speed.",
                            "target_lang_translations": {
                                "nl": "De behendige loper <w>springt over</w> elk obstakel met opmerkelijke gratie en snelheid."
                            }
                        },
                        {
                            "text": "He easily <w>hurdles</w> the low fence to retrieve the stray soccer ball.",
                            "target_lang_translations": {
                                "nl": "Hij <w>springt</w> moeiteloos <w>over</w> het lage hek om de verdwaalde voetbal te halen."
                            }
                        }
                    ],
                    "synonyms": [
                        "leaps",
                        "vaults"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "third-person singular"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Derde persoon enkelvoud van 'to hurdle': ergens overheen springen of een obstakel nemen."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "springt over",
                                "target_lang_sense_clarification": "derde persoon enkelvoud van overspringen"
                            },
                            {
                                "target_lang_word": "neemt",
                                "target_lang_sense_clarification": "een horde of hindernis nemen"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "6eb80200-76c8-307c-bcaf-5b4896525384",
                    "sense_definition": "plural of <w>Hurdle</w>",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "family_name_plural",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The <w>Hurdles</w> invited all of their neighbors over for an annual summer barbecue.",
                            "target_lang_translations": {
                                "nl": "<w>De familie Hurdle</w> nodigde al hun buren uit voor een jaarlijkse zomerbarbecue."
                            }
                        },
                        {
                            "text": "We received a lovely holiday greeting card from the <w>Hurdles</w> yesterday.",
                            "target_lang_translations": {
                                "nl": "We ontvingen gisteren een mooie vakantiekaart van <w>de familie Hurdle</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "plural of surname"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Meervoud van de familienaam Hurdle; de familie Hurdle."
                    },
                    "translations": {
                        "nl": [
