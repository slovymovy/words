                    {
                        "translation_id": "a7d95fa3-bea1-4c67-a7f9-d5fd74cdaafe",
                        "source_entry_id": "23d2638e-c6a7-345d-affc-1b6c48bf1f1f",
                        "source_sense_id": "040d6919-61a4-322a-91c3-d7a789ba1f04",
