                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d827c68c-f87a-40fc-9362-a3bd52b478d2",
                                "sense_id": "b1d6bb42-c1fa-367e-9a9f-fdfe4594d8c1",
                                "text": "Winorośl zasilamy niewielkimi dawkami azotu, a preparaty przeciwgrzybowe stosujemy w czasie zauważenia choroby i profilaktycznie"
                            },
                            {
                                "example_id": "dcb84eb0-ee57-45c4-b9ff-565bb9253fea",
                                "sense_id": "b1d6bb42-c1fa-367e-9a9f-fdfe4594d8c1",
                                "text": "W celu ochrony roślin przed chorobą cebule zaprawia się w preparatach przeciwgrzybowych"
                            }
                        ],
