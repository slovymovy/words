                        "target_lang_code": "zh",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "d8ac93fa-8dcd-43f2-89d3-5cbb9db49731",
                        "source_entry_id": "d56b1563-e7ab-36c0-b5f0-2470a5e00209",
                        "source_sense_id": "f2f94596-0e67-385f-aefd-32a8da69d3ce",
                        "target_lang_word": "Gemälde",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gemälde",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "299dad55-02b7-3984-bc2f-0ff6bc142198",
                                        "entry_id": "fd4d0fec-51ae-3655-92b1-943cca52f99f",
                                        "glosses": [
                                            "ein auf einen Träger (etwa eine Leinwand) aufgebrachtes Bild"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d96bc48e-ed70-4098-b33e-cf4c35d4c6c9",
                                                "sense_id": "299dad55-02b7-3984-bc2f-0ff6bc142198",
                                                "text": "Als er vor dem Gemälde stand, machte er halt."
                                            },
                                            {
                                                "example_id": "844abcec-55e1-4500-8892-f22b6ad8c985",
                                                "sense_id": "299dad55-02b7-3984-bc2f-0ff6bc142198",
                                                "text": "„Auch das amüsante Gemälde eines tanzenden Mädchens hätte er in der Kiste entdeckt.“"
                                            },
                                            {
                                                "example_id": "679e321e-1b48-4cf2-a238-32bb2250681a",
                                                "sense_id": "299dad55-02b7-3984-bc2f-0ff6bc142198",
                                                "text": "„Goethe wird das Gemälde ohne Vorbehalt gegen Friedrich betrachtet haben.“"
                                            },
                                            {
                                                "example_id": "77d96811-6383-4b09-b940-dc8c781bee21",
                                                "sense_id": "299dad55-02b7-3984-bc2f-0ff6bc142198",
                                                "text": "„Die Gerüste erinnerten mich an alte Gemälde vom Turmbau zu Babel.“"
                                            },
                                            {
                                                "example_id": "8a4f58e6-a7fd-4ce7-9deb-1907ccebc89b",
                                                "sense_id": "299dad55-02b7-3984-bc2f-0ff6bc142198",
                                                "text": "„Viele Gemälde aus französischen Museen kamen so als Raubkunst nach Deutschland.“"
                                            },
                                            {
                                                "example_id": "97ed9242-9934-439c-a7ed-d76aeb3c9fde",
                                                "sense_id": "299dad55-02b7-3984-bc2f-0ff6bc142198",
                                                "text": "„Wenn im Weißpigment eines alten Gemäldes Titanweiß nachgewiesen wird, handelt es sich offensichtlich um eine Fälschung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
