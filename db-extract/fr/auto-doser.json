                "senses": [
                    {
                        "sense_id": "8a46b232-3352-31c8-8bee-3ecd1607a8c2",
                        "entry_id": "31a1674b-0578-3837-9dd3-fa8a6c282c45",
                        "glosses": [
                            "Doser soi-même (par exemple son traitement en fonction de la douleur ressentie)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4dff8c78-908a-4a1a-808c-4f79c231a126",
                                "sense_id": "8a46b232-3352-31c8-8bee-3ecd1607a8c2",
                                "text": "Première chose : beaucoup plus de mal à auto-doser les quantités journalières à prendre."
                            },
                            {
                                "example_id": "b0e38c9a-3223-4f6d-b564-cbf2237a25ab",
                                "sense_id": "8a46b232-3352-31c8-8bee-3ecd1607a8c2",
                                "text": "La liberté de faire un choix éclairé sur la péridurale, de pouvoir aussi l'auto-doser et surtout de ne pas se la faire imposer."
                            },
                            {
                                "example_id": "aecef97f-b255-441d-a22f-5652ed0914e6",
                                "sense_id": "8a46b232-3352-31c8-8bee-3ecd1607a8c2",
                                "text": "A l'Etoile on n'a pas le petit bouton pour s'auto-doser la péridurale."
                            }
                        ]
                    }
