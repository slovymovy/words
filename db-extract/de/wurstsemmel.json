                "senses": [
                    {
                        "sense_id": "947d8ff8-7ffa-3773-98bf-f2b9b2d0cda6",
                        "entry_id": "77367b4c-46d6-3056-a1cf-2fca65150ae6",
                        "glosses": [
                            "quer halbierte Semmel mit in dünnen Scheiben geschnittener Wurst zwischen den beiden Hälften"
                        ],
                        "tags": [
                            "Austrian German"
                        ],
                        "examples": [
                            {
                                "example_id": "6bd1c247-527d-4123-97a4-fc2a260e8547",
                                "sense_id": "947d8ff8-7ffa-3773-98bf-f2b9b2d0cda6",
                                "text": "„Auf Facebook formierte sich schnell Widerstand - vor allem gegen die Verunglimpfung der Wurstsemmel.“"
                            },
                            {
                                "example_id": "e5901981-1d6c-4bd4-a01b-da24e79a751e",
                                "sense_id": "947d8ff8-7ffa-3773-98bf-f2b9b2d0cda6",
                                "text": "„Auf dem Speiseplan steht vor allem die Jause von zu Hause oder die Wurstsemmel vom Supermarkt ums Eck.“"
                            },
                            {
                                "example_id": "a08c4343-89a2-4290-ba09-45b48d5e950e",
                                "sense_id": "947d8ff8-7ffa-3773-98bf-f2b9b2d0cda6",
                                "text": "„Prinzregent Luitpold, der gerne im Allgäuer Gebirge auf die Jagd ging, spendierte dort an seinen Geburtstagen jedem Kind eine Wurstsemmel.“"
                            }
                        ],
