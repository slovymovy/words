                "senses": [
                    {
                        "sense_id": "953b69e7-b5ad-3b5a-8326-b959d39da939",
                        "entry_id": "9655cc86-6cb6-3026-bcff-ad761c0a6b27",
                        "glosses": [
                            "стать мягким, потерять твёрдость, упругость, поникнуть"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "172ae3bd-9236-4521-b019-2f148098f7d5",
                                "sense_id": "953b69e7-b5ad-3b5a-8326-b959d39da939",
                                "text": "Коротышки, которые спорили о том, полетит шар или не полетит, обернулись и увидели, что шар быстро стал уменьшаться. Он обмяк, сморщился, как сушёная груша, и скрылся на дне корзины. На месте, где раньше красовался огромный шар, теперь стояла только корзина, накрытая сверху сеткой."
                            }
                        ]
                    },
                    {
                        "sense_id": "b70bfa36-8bcf-3910-bdfd-46439722ce05",
                        "entry_id": "9655cc86-6cb6-3026-bcff-ad761c0a6b27",
                        "glosses": [
                            "перен. стать вялым, расслабленным"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "f26e7842-6615-340e-b3c8-7b4ee8396de2",
                        "entry_id": "9655cc86-6cb6-3026-bcff-ad761c0a6b27",
                        "glosses": [
                            "перен. стать снисходительнее, мягче, потерять суровость; смягчиться"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "11c4c8a9-be62-44b6-be43-8af33b368deb",
                        "source_entry_id": "9655cc86-6cb6-3026-bcff-ad761c0a6b27",
                        "target_lang_word": "soften",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "soften",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "804c5244-b074-36a7-8f6e-b8b23913a74e",
                                        "entry_id": "a2019927-940a-3b2e-8338-84994acfaf73",
                                        "glosses": [
                                            "To make something soft or softer."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a2d97191-acd5-4371-90eb-1a609b67ed4a",
                                                "sense_id": "804c5244-b074-36a7-8f6e-b8b23913a74e",
                                                "text": "Soften the butter before beating in the sugar."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "be41065f-b020-34a0-a39a-4c29cc20a048",
                                        "entry_id": "a2019927-940a-3b2e-8338-84994acfaf73",
                                        "glosses": [
                                            "To undermine the morale of someone (often soften up)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "150f02a3-9160-475f-b9c7-b4f8d2c0777c",
                                                "sense_id": "be41065f-b020-34a0-a39a-4c29cc20a048",
                                                "text": "Before the invasion, we softened up the enemy with the artillery."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "baffe763-14f6-39f7-8d7b-591d61c7881c",
                                        "entry_id": "a2019927-940a-3b2e-8338-84994acfaf73",
                                        "glosses": [
                                            "To make less harsh"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cabb484e-b9b1-462e-a41c-12fc7425bd8c",
                                                "sense_id": "baffe763-14f6-39f7-8d7b-591d61c7881c",
                                                "text": "Having second thoughts, I softened my criticism."
                                            },
                                            {
                                                "example_id": "595a2197-87e9-49b9-9f92-184307b2b076",
                                                "sense_id": "baffe763-14f6-39f7-8d7b-591d61c7881c",
                                                "text": "I have recently reclad the south-west facing side of my single-storey cottage […]. I now want to plant some climbers of more manageable proportions to soften the building."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4c0a1da8-505c-323e-8ea6-fe597e7ce6d9",
                                        "entry_id": "a2019927-940a-3b2e-8338-84994acfaf73",
                                        "glosses": [
                                            "To become soft or softer"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a1fed54c-5d70-4b24-9604-5f8e84841db0",
                                                "sense_id": "4c0a1da8-505c-323e-8ea6-fe597e7ce6d9",
                                                "text": "The butter softened as it warmed up."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "94b13739-62a5-35fa-b56f-893aa38d9345",
                                        "entry_id": "a2019927-940a-3b2e-8338-84994acfaf73",
                                        "glosses": [
                                            "To become or make (a consonant) more lenis, to lenite."
                                        ],
