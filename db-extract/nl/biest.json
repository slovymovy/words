                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "6c77ee18-0374-4d39-aa24-9e305cb65203",
                        "source_entry_id": "89f58704-058b-3844-835c-c697ca894b26",
                        "source_sense_id": "39996503-1272-36a4-8668-19b8c3fbc878",
                        "source_sense_description": "colostrum van koe",
                        "target_lang_word": "Biest",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Biest",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "02ab135a-025a-3e6b-980e-a7020ef81872",
                                        "entry_id": "4aeb1428-0800-34e6-9409-90c88ef88ba9",
                                        "glosses": [
                                            "widerwärtiges Tier"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "009225b2-075d-4b04-a7df-ce7f6b88b11d",
                                                "sense_id": "02ab135a-025a-3e6b-980e-a7020ef81872",
                                                "text": "„Als mich das Biest immer noch nicht loslassen wollte, rannte ich laut um Hilfe brüllend herum.“"
                                            },
                                            {
                                                "example_id": "6ba61192-f528-4045-8055-1b2609f2fde5",
                                                "sense_id": "02ab135a-025a-3e6b-980e-a7020ef81872",
                                                "text": "„Und es kamen immer mehr von den Biestern.“"
                                            },
                                            {
                                                "example_id": "7c0ffb7c-ff08-4fbd-bbee-d5fc4bb17376",
                                                "sense_id": "02ab135a-025a-3e6b-980e-a7020ef81872",
                                                "text": "„Gott dei Dank beissen die Biester nicht, aber sie sind überall zu spüren, ein widerwärtiges Kribbeln auf der Haut.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a265c7cb-d89d-338c-8582-19072d2e5388",
                                        "entry_id": "4aeb1428-0800-34e6-9409-90c88ef88ba9",
                                        "glosses": [
                                            "gemeiner, hinterhältiger Mensch, häufig speziell: gemeine Frau"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0c5d44ae-abdf-40f7-833a-0e7c01510f9a",
                                                "sense_id": "a265c7cb-d89d-338c-8582-19072d2e5388",
                                                "text": "Sie erwies sich als ein richtiges Biest."
                                            },
                                            {
                                                "example_id": "baffebde-ab41-4d64-ba62-915479271c63",
                                                "sense_id": "a265c7cb-d89d-338c-8582-19072d2e5388",
                                                "text": "„Nein, viel wichtiger ist doch, dass Euch genau das gelungen ist, was man den Herren jetzt zum Nachteil auslegen möchte: dass aus schrecklichen, haarigen Biestern Menschen männlichen Geschlechts geworden sind, die fähig und willens sind zu reflektieren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Biest",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "21a0cd3f-5584-3b36-bbff-e596b5e5c457",
                                        "entry_id": "13b84a33-1ecf-3f43-8a48-1c799e9f3ae1",
