                                        "glosses": [
                                            "Chaîne de hautes montagnes entre l'Afghanistan oriental et le nord du Pakistan."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "02622fee-710a-4aaf-a34f-8782a945ee98",
                                                "sense_id": "ee152de3-6960-3464-a8de-fe1adceac3c9",
                                                "text": "On arrivait aux approches du Chibar, seule trouée dans le massif auguste et monstrueux de l’Hindou Kouch, par où, à 3 500 mètres d’altitude, se faisait tout le trafic et tout le charroi entre l’Afghanistan du Sud et l’Afghanistan du Nord."
                                            },
                                            {
                                                "example_id": "49c9b049-ad38-43a6-ab42-2dfa70233c55",
                                                "sense_id": "ee152de3-6960-3464-a8de-fe1adceac3c9",
                                                "text": "L’Hindou-Kouch et l’Himalaya isolent l’Inde de l’Asie centrale."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
