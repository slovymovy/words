                "senses": [
                    {
                        "sense_id": "cad77e43-2cf1-3140-ae58-0b4737c0932c",
                        "entry_id": "e4835df1-48bb-3f07-861a-d6404eb6f24e",
                        "glosses": [
                            "volstrekte dwaasheid"
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "1d510958-2a9d-4ef0-836f-b9afb585a3c2",
                                "sense_id": "cad77e43-2cf1-3140-ae58-0b4737c0932c",
                                "text": "Sinnepoppen vertolkt qua thematiek de euforie van de nieuwe welstand. Winst is een eerbaar gegeven, verspilling en gemakzucht zijn idioterie en `Die wat spaert / die wat heeft'."
                            },
                            {
                                "example_id": "73dbaeef-40e8-4006-a744-be0d43e6d467",
                                "sense_id": "cad77e43-2cf1-3140-ae58-0b4737c0932c",
                                "text": "Een door God gegeven, hemels-muzikaal talent: dat is Mozart. Tegenover hem staat de aardse ploeteraar: dat is tijdgenoot Salieri. Dit artistieke duel kreeg bekendheid door de film Amadeus (1984), naar libretto en toneelstuk van Peter Schaffer. Vincent Rietveld en Marien Jongewaard van respectievelijk De Warme Winkel en Nieuw West ontheiligen met hun Amadeus de iconische status van de film. Beurtelings bizar en wreed, groots en vol idioterie komt de schrijnende tegenstelling geleidelijk naar voren."
                            }
                        ]
                    }
                ],
