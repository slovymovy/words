        "fr-extract.jsonl": [
            {
                "entry_id": "d91aceb3-9a10-39ff-99a4-e00c1b8a5fd8",
                "word": "nomination",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "4db3c5f0-dbe0-4c47-b626-b9c05970c9be",
                        "entry_id": "d91aceb3-9a10-39ff-99a4-e00c1b8a5fd8",
                        "tags": [
                            "plural"
                        ],
                        "form": "nominations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ff69b259-8f4b-37a7-bde0-eabc4afee650",
                        "entry_id": "d91aceb3-9a10-39ff-99a4-e00c1b8a5fd8",
                        "glosses": [
                            "Action de nommer à un emploi, à une charge, à une dignité, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "13ebf628-5c14-470a-9454-76df42596049",
                                "sense_id": "ff69b259-8f4b-37a7-bde0-eabc4afee650",
                                "text": "La seconde mesure que l’empereur a adoptée est la nomination d’un ministre auprès du gouvernement de la Colombie."
                            },
                            {
                                "example_id": "6d4c9d67-ac1f-4499-b13f-25164eb5ce0b",
                                "sense_id": "ff69b259-8f4b-37a7-bde0-eabc4afee650",
                                "text": "Vous pensez bien, dit-il, que la nomination d’un chanoine étranger au diocèse n’a pas été considérée d’un œil indifférent par le clergé de Chartres."
                            },
                            {
                                "example_id": "e82c847e-2a3b-4d0d-b38f-2875c71605fe",
                                "sense_id": "ff69b259-8f4b-37a7-bde0-eabc4afee650",
                                "text": "L'assemblée a procédé alors à la nomination du Comité permanent."
                            },
                            {
                                "example_id": "b833ecd1-b745-40a0-969d-d952fee6134f",
                                "sense_id": "ff69b259-8f4b-37a7-bde0-eabc4afee650",
                                "text": "Le revirement d’Enzo Le Fée, qui voulait quitter la Bretagne cet été avant la nomination de Régis Le Bris, illustre cela."
                            }
                        ]
                    },
                    {
                        "sense_id": "cc693769-1f4e-3b60-b166-adc3b44f9f0e",
                        "entry_id": "d91aceb3-9a10-39ff-99a4-e00c1b8a5fd8",
                        "glosses": [
                            "Droit de nommer à un emploi, à une charge, à une dignité, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "deb0b122-8f68-47d4-8dd8-077965a5b6cf",
                                "sense_id": "cc693769-1f4e-3b60-b166-adc3b44f9f0e",
                                "text": "La dignité de lord lieutenant est, rigoureusement parlant, à la nomination du Roi; mais elle est de fait, dans chaque comté, le partage héréditaire de quelque grande famille, d’où elle ne sort presque jamais."
                            }
                        ]
                    },
                    {
                        "sense_id": "945d664a-8fdd-3f57-8218-c0d56280e1c1",
                        "entry_id": "d91aceb3-9a10-39ff-99a4-e00c1b8a5fd8",
                        "glosses": [
                            "Mentions obtenues dans un concours."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "444e513c-a886-454b-9bc4-55c67758cba8",
                                "sense_id": "945d664a-8fdd-3f57-8218-c0d56280e1c1",
                                "text": "Il a eu trois nominations au Concours général."
                            }
                        ]
                    },
                    {
                        "sense_id": "98e827d9-0688-31f5-bc68-791b5312bce6",
                        "entry_id": "d91aceb3-9a10-39ff-99a4-e00c1b8a5fd8",
                        "glosses": [
                            "Présélection d’un artiste dans une catégorie lors d’un concours cinématographique ou télévisuel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5504d2f2-e077-400d-a62b-0ff8dd39f223",
                                "sense_id": "98e827d9-0688-31f5-bc68-791b5312bce6",
                                "text": "Attention, contrairement à une idée largement répandue obtenir une nomination dans une catégorie ne signifie pas être le lauréat (le vainqueur). En effet, la nomination est la dernière étape sélective avant le vote final qui désignera le lauréat."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4d331d45-5076-424a-af24-ef39698c9112",
                        "source_entry_id": "d91aceb3-9a10-39ff-99a4-e00c1b8a5fd8",
                        "source_sense_description": "Action de nommer à un emploi, à une charge, à une dignité",
                        "target_lang_word": "Ernennung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ernennung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6885ef02-1f8c-3314-aea2-848d29985729",
                                        "entry_id": "1774ba87-c939-3730-87ae-af13a5ba1ed2",
                                        "glosses": [
                                            "Verleihung eines Titels oder Status"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d5e0236b-39bf-41ee-a756-116f2058149b",
                                                "sense_id": "6885ef02-1f8c-3314-aea2-848d29985729",
                                                "text": "Noch am Tag seiner Ernennung beschloss er grundlegende Maßnahmen."
                                            },
                                            {
                                                "example_id": "6eb12aa9-e686-402d-96b4-00e5ddbcd8ff",
                                                "sense_id": "6885ef02-1f8c-3314-aea2-848d29985729",
                                                "text": "„Im Vorjahr hatte er durch die Ernennung des konservativen Juristen Neil Gorsuch das zuvor bestehende Patt zwischen vier liberalen und vier konservativen Höchstrichtern aufgehoben.“"
                                            },
                                            {
                                                "example_id": "6c8edce8-29b7-4aae-b9fe-0b48d2130845",
                                                "sense_id": "6885ef02-1f8c-3314-aea2-848d29985729",
                                                "text": "„Lai-bau zog darauf die aus zwei Bogen bestehende bedruckte Anstellungsurkunde und die von den Ministerien des Innern und des Krieges ausgefertigten Bestätigungen der Ernennungen hervor und legte sie auf den Tisch.“"
                                            },
                                            {
                                                "example_id": "7ed91cd5-0c55-46a5-adfa-ad01f91b2438",
                                                "sense_id": "6885ef02-1f8c-3314-aea2-848d29985729",
                                                "text": "„Tatsächlich führte die Ernennung der neuen Professoren zunächst zu einem Aufschwung des Vorlesungswesens, auch die Zahl der Studierenden stieg an.“"
                                            },
                                            {
                                                "example_id": "077b0071-0080-4a96-b481-a42a99e7484f",
                                                "sense_id": "6885ef02-1f8c-3314-aea2-848d29985729",
                                                "text": "„Die Ernennung Hitlers zum Reichskanzler scheint er kaum bemerkt zu haben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f47f3cef-79c6-4374-b0c1-79b896430135",
