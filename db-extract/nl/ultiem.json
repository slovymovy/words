                ],
                "senses": [
                    {
                        "sense_id": "27909369-c462-3225-be94-5d9b34a3e99b",
                        "entry_id": "e44c345c-e846-35af-aae9-24f5ee32b363",
                        "glosses": [
                            "het extreemst, uiterst, allerlaatst in een ontwikkeling"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c38acaa-2da8-4061-aff1-180e37e07ee2",
                                "sense_id": "27909369-c462-3225-be94-5d9b34a3e99b",
                                "text": "Dat is het ultieme voorbeeld van van een commerciële haven."
                            },
                            {
                                "example_id": "edcf3ed1-350b-47f2-8296-295d2d3e91f7",
                                "sense_id": "27909369-c462-3225-be94-5d9b34a3e99b",
                                "text": "Het oudheidkundig museum was toen niet langer het belangrijkste opgravingsinstituut in Nederland. Die rol was overgenomen door de nieuwe Rijksdienst voor het Oudheidkundig Bodemonderzoek. Het was de ultieme overwinning voor Van Giffen die directeur van die dienst was geworden."
                            },
                            {
                                "example_id": "b44b98fc-86d0-49d9-98d8-71c1624da878",
                                "sense_id": "27909369-c462-3225-be94-5d9b34a3e99b",
                                "text": "Het was niet goed, het was zenuwslopend, maar FC Twente is terug in de eredivisie. Omdat de enige overgebleven concurrent Sparta onderuit ging bij Jong PSV, was een punt tegen Jong AZ voldoende. De mooiste 0-0 van het seizoen voelde als de meest glorieuze zege. De ultieme bevrijding."
                            }
                        ]
                    }
                ],
