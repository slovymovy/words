                "senses": [
                    {
                        "sense_id": "d59ecd70-86aa-3c24-a204-1a4a1b899272",
                        "entry_id": "373cda85-1a55-313c-8a2c-c46ed4f492bb",
                        "glosses": [
                            "Verbrechen gegen den Staat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a74de2cd-58df-4c98-9eb6-84ddd77cc7eb",
                                "sense_id": "d59ecd70-86aa-3c24-a204-1a4a1b899272",
                                "text": "Er wurde wegen Hochverrat vor Gericht angeklagt."
                            },
                            {
                                "example_id": "a1faed1c-a7f6-47b9-8b6e-a625447e739a",
                                "sense_id": "d59ecd70-86aa-3c24-a204-1a4a1b899272",
                                "text": "„Daher waren Christenfeinde in der frühen Kaiserzeit weniger von Hass gegen die neue Lehre erfüllt; ihre Abneigung entsprang vielmehr ihrer affirmativen Haltung zum Imperium. Jede Alternative war für sie undenkbar und hätte ohnehin an Hochverrat gegrenzt.“"
                            },
                            {
                                "example_id": "249eb5fe-71f2-4a37-baef-5d6a0d5f6888",
                                "sense_id": "d59ecd70-86aa-3c24-a204-1a4a1b899272",
                                "text": "„Zu fünf Jahren Festung werde ich verurteilt, ich hätte das Verbrechen eines Hochverrats begangen, aber aus ehrenhaften Motiven.“"
                            },
                            {
                                "example_id": "0b76299f-8a6d-4a96-82ef-6bb92f008439",
                                "sense_id": "d59ecd70-86aa-3c24-a204-1a4a1b899272",
                                "text": "„Ein Patrizier namens Albinus war des Hochverrats überführt und verurteilt worden.“"
                            },
                            {
                                "example_id": "66cb956f-652f-403e-a395-d15b627e9e6e",
                                "sense_id": "d59ecd70-86aa-3c24-a204-1a4a1b899272",
                                "text": "„Das war natürlich Hochverrat und deshalb lebensgefährlich.“"
                            },
                            {
                                "example_id": "a1cf2a99-cf62-4904-aab3-770f2e9bd446",
                                "sense_id": "d59ecd70-86aa-3c24-a204-1a4a1b899272",
                                "text": "„Fanatische junge Hindu-Nationalisten hielten Gandhis Einsatz für Hochverrat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
