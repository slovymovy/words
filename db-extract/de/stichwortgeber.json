                "senses": [
                    {
                        "sense_id": "07b12f07-6966-3f2f-b1cc-956b80b6bc10",
                        "entry_id": "08124af6-a557-34d3-93ea-6f60bc7a0ca8",
                        "glosses": [
                            "Person, die zu etwas ein Stichwort/eine Anregung gibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8055b1d8-e41b-425d-94d0-28c6176d41c2",
                                "sense_id": "07b12f07-6966-3f2f-b1cc-956b80b6bc10",
                                "text": "„Ein jeder in Deutschland wusste es: Schlegel war Vordenker und Stichwortgeber der romantischen Bewegung.“"
                            },
                            {
                                "example_id": "2cc1f07d-c182-4600-bafe-59bac9fb3671",
                                "sense_id": "07b12f07-6966-3f2f-b1cc-956b80b6bc10",
                                "text": "„Gobineau wurde mit dieser Theorie zum Stichwortgeber der Nationalsozialisten, die die Ermordung der Juden auch mit dem Schutz der angeblich reinen »germanisch-arischen Rasse« vor Vermischung begründeten.“"
                            },
                            {
                                "example_id": "d2e99376-91f3-43a6-9838-5a4100029e27",
                                "sense_id": "07b12f07-6966-3f2f-b1cc-956b80b6bc10",
                                "text": "„»Wirklich?«, fragte er, wie es sich für einen guten Stichwortgeber gehörte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
