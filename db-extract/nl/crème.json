                        "examples": [
                            {
                                "example_id": "e6b71180-55f7-45e0-a5d7-3ad2a3b046a6",
                                "sense_id": "62805dc6-7349-3f52-bb4f-ef03aceb88ed",
                                "text": "‘Een crèmeke, alstublief, m'dam.’",
                                "translation": "An ice cream, please, ma'am.",
                                "english": "An ice cream, please, ma'am."
                            },
                            {
                                "example_id": "34237416-9558-487d-a102-9dd7ae392399",
                                "sense_id": "62805dc6-7349-3f52-bb4f-ef03aceb88ed",
                                "text": "HIER CRÈME MET ÉCHTE FRAISEN!",
                                "translation": "Here ice cream with real cherries!",
                                "english": "Here ice cream with real cherries!"
                            },
                            {
                                "example_id": "47325a38-3fe1-436d-999d-b8c4e2747d21",
                                "sense_id": "62805dc6-7349-3f52-bb4f-ef03aceb88ed",
                                "text": "2017 October 15, 'Goesting' (pseud.), \"Crème de la crème: hier lik je de lekkerste ijsjes van het land\", Het Laatste Nieuws.\nGoesting ging testen en serveert de crème de la crème onder de crème, al zeggen we er meteen bij dat deze lijst uiteraard niet volledig is.\nGoesting went to test and serves the crème de la crème of ice cream, although we say right away that this list is obviously not exhaustive."
                            }
