                "senses": [
                    {
                        "sense_id": "528bf6f8-8f8d-3e89-a337-880810125afb",
                        "entry_id": "8402070b-445e-396c-a11f-f2473f930bed",
                        "glosses": [
                            "Genre musical apparu dans les années 1980 en Jamaïque, dérivé du dancehall, caractérisé par une prédominance de l’instrumentation électronique et de l’utilisation de samplers."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "329ad045-e558-4e88-8d34-c3c516572615",
                                "sense_id": "528bf6f8-8f8d-3e89-a337-880810125afb",
                                "text": "En seconde partie de soirée, c’est le groupe Nadamas qui présentera sa musique festive et populaire, qui puise autant dans le bal musette que dans le ragga, le ska ou même le klezmer."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dc74037f-90d4-42a8-8fcc-356ef57beef1",
                        "source_entry_id": "8402070b-445e-396c-a11f-f2473f930bed",
                        "source_sense_id": "528bf6f8-8f8d-3e89-a337-880810125afb",
