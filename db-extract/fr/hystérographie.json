                    {
                        "sense_id": "d61134de-982f-352e-8c18-90f242fa3c01",
                        "entry_id": "68b3a53d-2732-3b6f-9a0c-271db2c15ff0",
                        "glosses": [
                            "Radiographie de l’utérus."
                        ],
                        "tags": [
                            "Gynécologie"
                        ],
                        "examples": [
                            {
                                "example_id": "2db9d5c8-2852-4a5e-8c86-ae72d23dd733",
                                "sense_id": "d61134de-982f-352e-8c18-90f242fa3c01",
                                "text": "L’hystérographie est la radiographie de l’utérus et des trompes, réalisée chez un radiologue."
                            },
                            {
                                "example_id": "62d5b014-e5f1-4fdc-abba-05a7d6e96815",
                                "sense_id": "d61134de-982f-352e-8c18-90f242fa3c01",
                                "text": "L’hystérosalpingographie, également connue sous le nom d’hystérographie, est un examen médical crucial dans le domaine de la gynécologie. L’hystérographie est un outil diagnostique précieux pour évaluer la santé reproductive des femmes."
                            }
                        ]
                    }
