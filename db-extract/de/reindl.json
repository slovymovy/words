                "senses": [
                    {
                        "sense_id": "7505195f-9a94-3579-ac67-3e7a163d89ec",
                        "entry_id": "869a7d4c-b681-3e67-894e-684cc73e0bc8",
                        "glosses": [
                            "flaches, kleineres, Gefäß zum Kochen und Braten; flacher, kleinerer Kochtopf, Bräter"
                        ],
                        "tags": [
                            "Austrian German"
                        ],
                        "examples": [
                            {
                                "example_id": "b61ba2ef-82c5-4809-968f-178295c43250",
                                "sense_id": "7505195f-9a94-3579-ac67-3e7a163d89ec",
                                "text": "„Die mehrmaligen Klopfversuche waren ergebnislos geblieben und so sperrte sie, das Reindl mit der Linken umklammert, die Wohnungstüre auf.“"
                            },
                            {
                                "example_id": "5fa281dc-998f-4542-9f21-eb62db34a904",
                                "sense_id": "7505195f-9a94-3579-ac67-3e7a163d89ec",
                                "text": "übertragen: „Wir mussten jedes Reindl ausschmieren.“"
                            },
                            {
                                "example_id": "df6a2a80-8b2b-4ae6-bf60-e4e70a9e796b",
                                "sense_id": "7505195f-9a94-3579-ac67-3e7a163d89ec",
                                "text": "übertragen: „Er schmiert das Reindl aus sozusagen.“"
                            },
                            {
                                "example_id": "2e707dd1-d07c-4373-b143-e48d22055680",
                                "sense_id": "7505195f-9a94-3579-ac67-3e7a163d89ec",
                                "text": "übertragen: „Er werde eine Sendung machen, die ‚vom Opernballkleid bis zur Umweltkatastrophe - manchmal ist das ja identisch - das ganze Reindl ausschmiert‘, kündigte der frühere ‚Willkommen Österreich‘-Frontman an.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
