                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle lui a adressé un <w>reproche</w> sévère pour son retard injustifié à la réunion."
                        },
                        {
                            "text": "Le professeur a évité de faire le moindre <w>reproche</w> à cet élève attentif."
                        }
                    ],
                    "synonyms": [
                        "blâme",
                        "grief",
                        "réprimande"
                    ],
                    "antonyms": [
                        "compliment",
                        "éloge",
                        "louange"
                    ],
                    "common_phrases": [
                        "faire des reproches",
                        "sans reproche"
                    ]
                }
            ]
        },
        {
