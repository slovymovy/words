                                    },
                                    {
                                        "sense_id": "3f36f97c-1ffd-325b-bb00-764c68d371e8",
                                        "entry_id": "33a97141-97bc-3cef-b834-a3ade21e06ad",
                                        "glosses": [
                                            "Familie (A_i)_(i∈I) von Teilmengen von A heißt Überdeckung von B⊂A, wenn B⊂∪_(i∈I)A_i gilt"
                                        ],
                                        "tags": [
                                            "Topologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d23d4fdb-6561-4e44-880c-4cf398a8ec78",
                                                "sense_id": "3f36f97c-1ffd-325b-bb00-764c68d371e8",
                                                "text": "„Der Fall der Euklidischen Ebene steht in der Mitte; denn in diesem Falle giebt es nur eine endliche Anzahl von wesentlich verschiedenen Arten von Bewegungsgruppen mit Fundamentalbereich; aber zur lückenlosen Ueberdeckung der ganzen Ebene ist eine unendliche Anzahl von Exemplaren congruenter Bereiche notwendig.“"
                                            }
                                        ],
                                        "sense_index_json": "\"8\""
                                    },
                                    {
                                        "sense_id": "645a51b1-c988-387d-9e83-258c632da06b",
                                        "entry_id": "33a97141-97bc-3cef-b834-a3ade21e06ad",
                                        "glosses": [
                                            "Überdeckungsgrad, Anzahl sich gleichzeitig im Eingriff befindlicher Zähne zweier Zahnräder"
                                        ],
                                        "tags": [
                                            "short-form"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "51ba956a-ef48-4ece-9628-01e3fbe0ad38",
                                                "sense_id": "645a51b1-c988-387d-9e83-258c632da06b",
                                                "text": "Damit Kraft zwischen zwei Zahnrädern übertragen werden kann, muss eine Überdeckung vorliegen, in der Praxis ist ein Überdeckungsgrad von 1,1 bis 1,25 üblich."
                                            }
                                        ],
                                        "sense_index_json": "\"9\""
                                    },
                                    {
                                        "sense_id": "c62cd866-3a0a-30d8-8e4f-4d305f0c6cec",
                                        "entry_id": "33a97141-97bc-3cef-b834-a3ade21e06ad",
                                        "glosses": [
                                            "die Mächtigkeit der über einem Tunnel auflastenden Erd- und Gesteinsmassen"
                                        ],
                                        "tags": [
                                            "Tiefbau"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "420601f8-aa51-41f4-94ad-6535c3eb2f40",
                                                "sense_id": "c62cd866-3a0a-30d8-8e4f-4d305f0c6cec",
                                                "text": "„In der linkselbischen Marsch gingen die Bohrungen bis auf 60 m unter Gelände, und im Bereich des zum nördlichen Elbufer parallel verlaufenden Geestrückens wurde der Baugrund wegen der dort topografisch bedingten größeren Überdeckung sogar bis zu 80 m Tiefe untersucht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"10\""
                                    },
                                    {
                                        "sense_id": "5eb502ad-e878-3946-987f-8bb3aeb4d874",
                                        "entry_id": "33a97141-97bc-3cef-b834-a3ade21e06ad",
                                        "glosses": [
                                            "mehrfache Deckung einer strategisch wichtigen Figur"
                                        ],
                                        "tags": [
                                            "Schach"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0cca35a8-8b3b-4a08-a400-2740bf86167b",
                                                "sense_id": "5eb502ad-e878-3946-987f-8bb3aeb4d874",
                                                "text": "Überdeckung ist eine prophylaktische und taktische Maßnahme."
                                            }
                                        ],
                                        "sense_index_json": "\"11\""
                                    }
                                ]
                            }
