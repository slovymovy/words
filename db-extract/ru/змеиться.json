                ],
                "senses": [
                    {
                        "sense_id": "36d18185-cc58-37fc-9a63-a3e37f44adbb",
                        "entry_id": "b0b917a4-7526-3792-b7bb-8f12be6b78f3",
                        "glosses": [
                            "тянуться, стелиться волнистой, извилистой полосой, линией; извиваться, виться"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "01fbd4a9-3c87-4f11-9054-b789dce06326",
                                "sense_id": "36d18185-cc58-37fc-9a63-a3e37f44adbb",
                                "text": "Змеились косы на плечах младых, // Оплетены тесемкой золотою."
                            },
                            {
                                "example_id": "13a0cc7c-713c-4d43-ab79-68aa882a5f79",
                                "sense_id": "36d18185-cc58-37fc-9a63-a3e37f44adbb",
                                "text": "Деревья и кусты смешались в мрачную массу; в двух шагах ничего не было видно; только беловатой полосой змеились песчаные дорожки."
                            },
                            {
                                "example_id": "1f77f4ec-557c-420a-bde8-cb61efd25147",
                                "sense_id": "36d18185-cc58-37fc-9a63-a3e37f44adbb",
                                "text": "Коридор змеился, изгибаясь под невероятными углами; квартире, казалось, нет конца."
                            }
                        ]
                    },
                    {
                        "sense_id": "b779e489-dbd3-34bd-91a6-58e5c49ed75b",
                        "entry_id": "b0b917a4-7526-3792-b7bb-8f12be6b78f3",
                        "glosses": [
                            "перен., разг. блуждать, скользить, незаметно появляться и исчезать (преим. об улыбке)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7fe920e-98e7-47ff-8986-90d54479d8d6",
                                "sense_id": "b779e489-dbd3-34bd-91a6-58e5c49ed75b",
                                "text": "На его губах змеилась насмешливая улыбка."
                            },
                            {
                                "example_id": "cd272043-cb03-40cc-a30f-6fc6f9495de2",
                                "sense_id": "b779e489-dbd3-34bd-91a6-58e5c49ed75b",
                                "text": "Тонкая улыбка чуть-чуть змеилась на её губах."
                            }
                        ]
                    }
                ],
