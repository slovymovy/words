                "senses": [
                    {
                        "sense_id": "23bba5fb-1f6a-3fb9-b50b-95ec28dbf110",
                        "entry_id": "a598a5c3-cfee-39c5-a6b0-89fe1dce039d",
                        "glosses": [
                            "sehr reicher, wohlhabender Mensch"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b627336b-90b1-4fb9-b7ec-6a07740ac12d",
                                "sense_id": "23bba5fb-1f6a-3fb9-b50b-95ec28dbf110",
                                "text": "Seit er durch seine sagenhafte Geschäftsidee reich wurde, führt sich Frank wie ein Krösus auf."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1c10d3a2-1bb2-4f34-9421-82448b12354b",
                        "source_entry_id": "a598a5c3-cfee-39c5-a6b0-89fe1dce039d",
                        "source_sense_id": "23bba5fb-1f6a-3fb9-b50b-95ec28dbf110",
                        "source_sense_description": "sehr reicher, wohlhabender Mensch",
                        "target_lang_word": "Croesus",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Croesus",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d00ebb7e-8542-35a4-97ef-1a6639ae9f85",
                                        "entry_id": "e0360a63-bc96-31d2-9a2c-15cf12604cc6",
                                        "glosses": [
                                            "A male given name from Ancient Greek."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2c1c2c87-9878-368a-b60f-360281361631",
                                        "entry_id": "e0360a63-bc96-31d2-9a2c-15cf12604cc6",
                                        "glosses": [
                                            "A king of Lydia, noted for his great wealth."
                                        ],
                                        "tags": [
                                            "specifically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c197c58e-b8e3-4a0b-bc9a-8dc7d8fe0967",
                                                "sense_id": "2c1c2c87-9878-368a-b60f-360281361631",
                                                "text": "“[…] They talk of you as if you were Croesus—and I expect the beggars sponge on you unconscionably.” And Vickers launched forth into a tirade very different from his platform utterances. He spoke with extreme contempt of the dense stupidity exhibited on all occasions by the working classes."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Croesus",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "36621a17-4793-337a-a3b3-648b50b5f062",
                                        "entry_id": "446af045-4e2e-3904-8639-69b4daa356b4",
                                        "glosses": [
                                            "A rich person."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd472a5a-09de-4ab2-b1fa-9035b569df4a",
                                                "sense_id": "36621a17-4793-337a-a3b3-648b50b5f062",
                                                "text": "1875, Henry James, \"Benvolio\" in The Galaxy 20 (2) (August 1875).\n\"Decidedly he was to be a great man, and this was not the moment for letting him go! At the same time there was something impressive in this extraordinary lapse in his eagerness—in his finding it so easy to forget his honors. It was only an intellectual Croesus, the Countess said to herself, who could afford to keep so loose an account.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "60fb82c2-4ebc-4a5d-afd9-96c39a4eb2d6",
                        "source_entry_id": "a598a5c3-cfee-39c5-a6b0-89fe1dce039d",
                        "source_sense_id": "23bba5fb-1f6a-3fb9-b50b-95ec28dbf110",
                        "source_sense_description": "sehr reicher, wohlhabender Mensch",
                        "target_lang_word": "nabob",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nabob",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7f9b8324-3dc0-3fdf-b62b-0041511b1134",
                                        "entry_id": "98c5c1a5-6eb7-3707-a965-dfe646e04854",
                                        "glosses": [
                                            "An Indian ruler within the Mogul empire."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a640f388-6309-4def-b189-9dfa87d8bf1e",
                                                "sense_id": "7f9b8324-3dc0-3fdf-b62b-0041511b1134",
                                                "text": "They have drained the treasuries of Nabobs, who must fill them by oppressing the industry of their subjects."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ee980c7-d95e-3678-9e1e-17d43f4e5631",
                                        "entry_id": "98c5c1a5-6eb7-3707-a965-dfe646e04854",
                                        "glosses": [
                                            "Someone of great wealth or importance."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "181676d6-fb39-467d-a09b-da56b18130cd",
                                                "sense_id": "4ee980c7-d95e-3678-9e1e-17d43f4e5631",
                                                "text": "Mr. Glentworth had never quitted Europe, and his wealth was either good English landed property, or equally undeniable English consols; still he was a stranger, very rich, and suddenly come from abroad. Such a man was necessarily a nabob in Mr. Palmer's eyes. India had been the place for making large fortunes in his young days."
                                            },
                                            {
                                                "example_id": "1a16be87-1b7a-4c49-ab7a-7cec103c822a",
                                                "sense_id": "4ee980c7-d95e-3678-9e1e-17d43f4e5631",
                                                "text": "Private-equity nabobs bristle at being dubbed mere financiers. Piling debt onto companies’ balance-sheets is only a small part of what leveraged buy-outs are about, they insist. Improving the workings of the businesses they take over is just as core to their calling, if not more so. Much of their pleading is public-relations bluster."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3c8381d7-7899-3bae-b23a-f949a32c8abd",
                                        "entry_id": "98c5c1a5-6eb7-3707-a965-dfe646e04854",
                                        "glosses": [
                                            "A person with a grandiose style or manner."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cf892fba-f8ec-4642-a7ed-145ac67a3aac",
                        "source_entry_id": "a598a5c3-cfee-39c5-a6b0-89fe1dce039d",
                        "source_sense_id": "23bba5fb-1f6a-3fb9-b50b-95ec28dbf110",
                        "source_sense_description": "sehr reicher, wohlhabender Mensch",
                        "target_lang_word": "crésus",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "crésus",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7a8a2e35-f9de-3a8f-acf8-42cc6e8ea1f8",
                                        "entry_id": "3e530839-ecca-3231-a82a-b81cb5faeb3c",
                                        "glosses": [
                                            "Homme extrêmement riche,"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77d9f4d0-058e-478f-a8a7-4e0035dc6494",
                                                "sense_id": "7a8a2e35-f9de-3a8f-acf8-42cc6e8ea1f8",
                                                "text": "Mis en possession de cette petite fortune, il se crut devenu un crésus."
                                            },
                                            {
                                                "example_id": "c702b9b6-4f36-4d27-afda-3e7128304068",
                                                "sense_id": "7a8a2e35-f9de-3a8f-acf8-42cc6e8ea1f8",
                                                "text": "Écoute bien. Il est pris, le crésus ! C’est tout comme. C’est déjà fait. Tout est arrangé. J’ai vu des gens. Il viendra ce soir à six heures. Apporter ses soixante francs, canaille !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "73b6f433-8c9d-4da4-a17f-31d83c08dcff",
