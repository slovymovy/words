                "translations": [
                    {
                        "translation_id": "f5f41c2b-b423-4eb3-8007-5dc4c60d1fdc",
                        "source_entry_id": "f03ca887-e120-3734-b2b7-0fcd0113f681",
                        "source_sense_id": "f3e4a5ab-4065-31d8-8b99-b7e6f3695dc5",
                        "target_lang_word": "soudure",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "soudure",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ed62f7ab-383b-3e71-b80f-9fe51498ac04",
                                        "entry_id": "09acab67-fe6e-34c8-8603-dbe3019e4804",
                                        "glosses": [
                                            "Action de souder ; le résultat de ce travail."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a208a28-cb05-41cf-a799-f3f4dbf3ad73",
                                                "sense_id": "ed62f7ab-383b-3e71-b80f-9fe51498ac04",
                                                "text": "Le polypropylène est difficilement collable. La technique adoptée est la soudure au miroir ou par rotation."
                                            },
                                            {
                                                "example_id": "3718b480-ad22-4f10-a282-10fa12882788",
                                                "sense_id": "ed62f7ab-383b-3e71-b80f-9fe51498ac04",
                                                "text": "Le principe est basé sur une ondulation longitudinale d'un feuillard inox en 304 L, un spiralage du feuillard ondulé sur un mandrin donnant le diamètre intérieur souhaité, une soudure en continu du feuillard et un contrôle de la soudure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1a322e8e-63e4-3f2f-9186-51e2f8a19c2a",
                                        "entry_id": "09acab67-fe6e-34c8-8603-dbe3019e4804",
                                        "glosses": [
                                            "Endroit par où les deux pièces de métal sont soudées."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a569bbc-16ce-484b-bc7a-e362701c0d20",
                                                "sense_id": "1a322e8e-63e4-3f2f-9186-51e2f8a19c2a",
                                                "text": "Le principe est basé sur une ondulation longitudinale d’un feuillard inox en 304 L, un spiralage du feuillard ondulé sur un mandrin donnant le diamètre intérieur souhaité, une soudure en continu du feuillard et un contrôle de la soudure."
                                            },
                                            {
                                                "example_id": "ec4c7df6-b8b1-46e0-ae55-0b70c2e45018",
                                                "sense_id": "1a322e8e-63e4-3f2f-9186-51e2f8a19c2a",
                                                "text": "Le tuyau est crevé à la soudure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "80b7b35e-20c2-3b28-8a6d-86c1e9e9778b",
                                        "entry_id": "09acab67-fe6e-34c8-8603-dbe3019e4804",
                                        "glosses": [
                                            "Composition métallique fusible, qui sert à souder, à unir ensemble des pièces de métal."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "86f66eff-a19a-381d-b296-7772b961f8a5",
                                        "entry_id": "09acab67-fe6e-34c8-8603-dbe3019e4804",
                                        "glosses": [
                                            "Suppression du trait d’union."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04eabf19-a8f2-4caa-ba50-a83d39e917f6",
                                                "sense_id": "86f66eff-a19a-381d-b296-7772b961f8a5",
                                                "text": "Le Rapport, dans sa grande indulgence, étend aussi la soudure à divers composés à premier élément verbal et second élément nominal ou autre, tels que « (d’)arrachepied », « couvrepied », « croquemadame », « croquemonsieur », « croquemort », « fourretout », « passepartout », « porteclé », « portefeuille », « portemonnaie », « tapecul », « tirebouchon », « tournedos », etc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1f99c245-7737-376e-98d2-09ecdfc2c89b",
                                        "entry_id": "09acab67-fe6e-34c8-8603-dbe3019e4804",
                                        "glosses": [
                                            "Chevauchement de deux périodes d’approvisionnement d’un produit."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cb005bac-fdca-3a4e-8851-045830a4c438",
                                        "entry_id": "09acab67-fe6e-34c8-8603-dbe3019e4804",
                                        "glosses": [
                                            "Chevauchement de deux périodes budgétaires."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7dc5cd16-71d7-4bde-a127-ec7770b946b5",
                                                "sense_id": "cb005bac-fdca-3a4e-8851-045830a4c438",
                                                "text": "Est-ce qu’il ne pouvait pas donner sa paie d’un seul coup, au lieu de la débiter en tranches sous prétexte qu’on ne faisait jamais la soudure ? La soudure ! Belle fichaise. Comme s’il ne valais pas mieux vivre quelques bonnes journées – au risque d’en jeûner quelques autres – plutôt que de grignoter des miettes tout le mois."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce1aa940-3b57-3efd-a9a9-a06469fcd15a",
                                        "entry_id": "09acab67-fe6e-34c8-8603-dbe3019e4804",
                                        "glosses": [
                                            "Période entre deux récoltes, pendant laquelle la production agricole est nulle, en particulier à cause de la sécheresse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea253657-cfac-4d51-b53d-e2a9caca51bc",
                                                "sense_id": "ce1aa940-3b57-3efd-a9a9-a06469fcd15a",
                                                "text": "Ajoutez encore la montée du « péril luthérien », les gelées de l’hiver 1523-1524 de sorte que la soudure du printemps fut difficile, les processions qu’on avait multipliées dans Paris soit à cause du temps, soit à cause de la guerre."
                                            },
                                            {
                                                "example_id": "f52c3c66-cd6c-4aa9-b480-f75f3a054533",
                                                "sense_id": "ce1aa940-3b57-3efd-a9a9-a06469fcd15a",
                                                "text": "[…] leur ration alimentaire quotidienne a tendance à diminuer du fait des difficultés de la soudure."
                                            },
                                            {
                                                "example_id": "7108bc05-d5ae-418c-bb97-466426b3ed83",
                                                "sense_id": "ce1aa940-3b57-3efd-a9a9-a06469fcd15a",
                                                "text": "La durée de la période de soudure est toujours de plusieurs mois et peut atteindre six mois et plus dans les années de sécheresse."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "823c22a0-e0c4-4118-b173-798451324165",
                        "source_entry_id": "f03ca887-e120-3734-b2b7-0fcd0113f681",
                        "source_sense_id": "f3e4a5ab-4065-31d8-8b99-b7e6f3695dc5",
                        "target_lang_word": "brasure",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "brasure",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "53a5fae0-e4cf-34a6-931d-06ed49aba232",
                                        "entry_id": "ef842bbd-5dbf-32bc-bec4-e311099b6228",
                                        "glosses": [
                                            "Action rendant solidaires deux pièces à l’aide, d’un matériau d’apport et d’une température inférieure au point de fusion du ou des matériaux constituant les pièces à assembler."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee3a81e5-454b-4201-a017-8455d208cb2a",
                                                "sense_id": "53a5fae0-e4cf-34a6-931d-06ed49aba232",
                                                "text": "Pour éviter de surchauffer le métal, utiliser un arc électrique plutôt qu’une torche au gaz pour effectuer la brasure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eb01d29c-5caf-3ba3-8a86-7b66d964d396",
                                        "entry_id": "ef842bbd-5dbf-32bc-bec4-e311099b6228",
                                        "glosses": [
                                            "Endroit où deux pièces sont brasées."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f56ecfc9-c607-4515-a332-1669ff539fea",
                                                "sense_id": "eb01d29c-5caf-3ba3-8a86-7b66d964d396",
                                                "text": "Les opérations de grattage ou de limage des brasures peuvent provoquer l’inhalation de poussières métalliques et la contamination des mains."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "be188c1e-363a-3209-b4b1-9b1058083a44",
                                        "entry_id": "ef842bbd-5dbf-32bc-bec4-e311099b6228",
                                        "glosses": [
                                            "Métal ou alliage d’apport utilisé pour le brasage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21fce551-3a0e-4175-891e-857c359af72d",
                                                "sense_id": "be188c1e-363a-3209-b4b1-9b1058083a44",
                                                "text": "Il est parfois nécessaire de procéder à un nettoyage préalable des pièces à braser à l’aide de solvants ou de solutions aqueuses acides ou alcalines. Ces opérations peuvent exposer les salariés à des produits toxiques, corrosifs ou inflammables. Ces produits chimiques peuvent également être utilisés après le brasage pour le nettoyage des résidus de brasure."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
