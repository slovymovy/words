                        "sense_id": "3b9cd92c-5755-383d-a213-33239a340284",
                        "entry_id": "76d1d1c3-2bb8-3c99-ba39-b631f79baef2",
                        "glosses": [
                            "Sentiment d'avoir déjà été témoin ou d'avoir déjà vécu (phénomène appelé ecmésie) une situation pourtant nouvelle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98170739-21ff-42a0-85b9-770bd3218a6a",
                                "sense_id": "3b9cd92c-5755-383d-a213-33239a340284",
                                "text": "Ce phénomène de déjà-vu, appelé scientifiquement paramnésie, ne résulterait finalement que d’un dysfonctionnement temporaire du cerveau."
                            }
                        ]
                    }
                ],
