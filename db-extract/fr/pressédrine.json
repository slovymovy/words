                        "glosses": [
                            "Nom d’un médicament sympathomimétique, dont les propriétés imitent la stimulation du système nerveux sympathique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a70c3d37-e4be-4e9e-a676-2c21ad4fddf3",
                                "sense_id": "3604b347-5cf3-352f-9377-3faa6e34f97f",
                                "text": "Le Pressyl (1) est constitué par l’association d’un analeptique cardio-respiratoire, la camphramine, à un sympathomimétique, la pressédrine."
                            },
                            {
                                "example_id": "7f1cc447-1978-4f57-94d2-0ea9cf7c612a",
                                "sense_id": "3604b347-5cf3-352f-9377-3faa6e34f97f",
                                "text": "Fait capital : ils sont actifs par voie digestive, et, par cette voie, certains d’entre eux, comme la benzédrine et la pressédrine, ont des effets qui durent plusieurs heures."
                            },
                            {
                                "example_id": "874008e3-1e03-4a18-985a-ed9a95b2f8fe",
                                "sense_id": "3604b347-5cf3-352f-9377-3faa6e34f97f",
                                "text": "Ceux de la pressédrine se prolongent plus longtemps."
