                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f282b824-d186-4489-8be2-710968e6183a",
                                "sense_id": "68b3eba9-40f9-31c4-85fc-5a9b7b024cf2",
                                "text": "Był to kij w mrowisko, który spowodował, że konsultacje regionalne były podlane sosem szemranej polityki."
