                        "examples": [
                            {
                                "example_id": "1369f273-fa1e-422e-89b5-db1c89e6dd01",
                                "sense_id": "47910f9e-616e-31e3-9bc3-04699f4f2417",
                                "text": "In western Europe, the spirit of the bourgeois developed slowly towards a capitalist mentality. According to Werner Sombart, the bourgeois was a challenger of the nobility and used the accumulation of richdom to get access to the oligarchy of the different courts in Europe."
                            },
                            {
                                "example_id": "63d9d212-5598-4884-9cec-3cb19320e88b",
                                "sense_id": "47910f9e-616e-31e3-9bc3-04699f4f2417",
                                "text": "Free nature in her inexhaustible richdom of forms can never be fettered into the narrow bounds, which we may assign to any of our technic definitions."
                            },
                            {
                                "example_id": "54e67499-ed15-44da-8b82-c497102b1a92",
                                "sense_id": "47910f9e-616e-31e3-9bc3-04699f4f2417",
                                "text": "[...] and therefore still more approaches in its richdom of tan-principle to the genuine Sumach-leaves of Rhus coriaria."
                            },
                            {
                                "example_id": "f5372b7c-1430-47ed-a7b4-7c932fab3889",
                                "sense_id": "47910f9e-616e-31e3-9bc3-04699f4f2417",
                                "text": "Taking into consideration the taming of all creative richdoms of ideas on the basis of our graphic guidelines, we graphic specialists still have enough freedom to sensibly handle all design tasks."
                            }
                        ]
                    }
