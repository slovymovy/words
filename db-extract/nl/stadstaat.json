                    {
                        "sense_id": "942869c4-3023-358f-9e98-e55ba2dc24a4",
                        "entry_id": "b7c1d6f7-7bdc-3828-bef8-7bc37738e30d",
                        "glosses": [
                            "staatsvorm waarbij de staat slechts het grondgebied van één stad omvat."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4de88054-ef8f-4d29-a77c-880d8496c053",
                                "sense_id": "942869c4-3023-358f-9e98-e55ba2dc24a4",
                                "text": "Monaco is een soevereine stadstaat in Zuid-Europa."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0d3c96c7-d975-415a-b9f8-53538ef24a77",
                        "source_entry_id": "b7c1d6f7-7bdc-3828-bef8-7bc37738e30d",
                        "source_sense_id": "942869c4-3023-358f-9e98-e55ba2dc24a4",
                        "source_sense_description": "staatsvorm",
                        "target_lang_word": "Stadtstaat",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Stadtstaat",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9563ff66-fc5d-3ede-8f66-b8fca9dc22ab",
                                        "entry_id": "b55aa9d6-68b4-3f04-90ba-73094b3ac3d8",
                                        "glosses": [
                                            "ein Staat, der nur das Gebiet einer Stadt (und je nach Festlegung der Grenzen sein engeres Umland) umfasst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a80cca57-e79d-4b60-bf30-a5cc6d641236",
                                                "sense_id": "9563ff66-fc5d-3ede-8f66-b8fca9dc22ab",
                                                "text": "Ein typischer Stadtstaat war Venedig."
                                            },
                                            {
                                                "example_id": "bfb5cc74-7e2c-4bd7-a507-1e7dd61fce51",
                                                "sense_id": "9563ff66-fc5d-3ede-8f66-b8fca9dc22ab",
                                                "text": "Singapur ist ein moderner Stadtstaat."
                                            },
                                            {
                                                "example_id": "7e25f394-fe42-43e3-a497-4dca470eceb1",
                                                "sense_id": "9563ff66-fc5d-3ede-8f66-b8fca9dc22ab",
                                                "text": "Der Stadtstaat Bremen steht durch den geplanten Länderfinanzausgleich vor der Pleite."
                                            },
                                            {
                                                "example_id": "f97f8fb0-83b8-4cfd-9fed-1c296c3a56ba",
                                                "sense_id": "9563ff66-fc5d-3ede-8f66-b8fca9dc22ab",
                                                "text": "Unter den deutschen Stadtstaaten scheint es beliebt zu sein, in kontroversen Fragen gesetzliche Vorstöße auf Landesebene zu unternehmen."
                                            },
                                            {
                                                "example_id": "c485a832-2299-4811-ba36-065908c0f241",
                                                "sense_id": "9563ff66-fc5d-3ede-8f66-b8fca9dc22ab",
                                                "text": "Die Besonderheiten beginnen damit, dass Bremen genau genommen kein Stadtstaat ist, sondern ein \"Zwei-Städte-Staat\". Dieser besteht aus zwei eigenständigen Städten - Bremen und Bremerhaven."
                                            },
                                            {
                                                "example_id": "8daeff09-4ca1-4346-a220-c774c28f6fc3",
                                                "sense_id": "9563ff66-fc5d-3ede-8f66-b8fca9dc22ab",
                                                "text": "„Später war es abwechselnd unter der Hoheit der Byzantiner, Karolinger und Venezianer, bis es sich als teilsouveräner Stadtstaat der Habsburgermonarchie anschloss.“"
                                            },
                                            {
                                                "example_id": "4dec33a3-ae0d-4106-84e1-aa3dc474613e",
                                                "sense_id": "9563ff66-fc5d-3ede-8f66-b8fca9dc22ab",
                                                "text": "„Frauen und Sklaven hatten in der Polis, dem griechischen Stadtstaat, nichts zu melden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "49aace1e-9086-41a6-af1d-011279156e88",
                        "source_entry_id": "b7c1d6f7-7bdc-3828-bef8-7bc37738e30d",
                        "source_sense_id": "942869c4-3023-358f-9e98-e55ba2dc24a4",
