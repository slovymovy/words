                "translations": [
                    {
                        "translation_id": "a79fd2b9-985d-4088-b689-91f900d18dd9",
                        "source_entry_id": "3d55d992-681c-3b91-bd53-f8778922c96e",
                        "source_sense_id": "8740dbf6-e430-373b-96b4-872fbfeba31b",
