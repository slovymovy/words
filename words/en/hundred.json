                                "ru": "Начало брифинга запланировано на пятнадцать <w>ноль-ноль</w>.",
                                "zh": "简报会定于十五点<w>整</w>开始。"
                            }
                        },
                        {
                            "text": "We will arrive at the destination by zero six <w>hundred</w>.",
                            "target_lang_translations": {
                                "ru": "Мы прибудем в пункт назначения к шести <w>ноль-ноль</w>.",
                                "zh": "我们将于六点<w>整</w>到达目的地。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "eleven hundred",
                        "eighteen hundred"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "military or technical context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Слово, используемое для обозначения двух нулей при указании точного времени в 24-часовом формате.",
                        "zh": "在24小时制中，用于表示整点时刻的词。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ноль-ноль",
                                "target_lang_sense_clarification": "эквивалент при чтении времени"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "整",
                                "target_lang_sense_clarification": "用于表示整点"
                            }
                        ]
                    }
                }
            ]
        },
        {
