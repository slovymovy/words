                "senses": [
                    {
                        "sense_id": "b6e1c750-e462-3019-b2c7-a0bb38dca198",
                        "entry_id": "3e45ee06-a880-31a2-a8ad-aaf926ccad35",
                        "glosses": [
                            "grundlegende Umstellung der Erzeugung von elektrischer Energie, weg von Kohle-/Öl-/Gaskraftwerken, stattdessen Erzeugung mittels Photovoltaikanlagen"
                        ],
                        "tags": [
                            "Energie",
                            "Plural selten"
                        ],
                        "examples": [
                            {
                                "example_id": "8b96d37b-8549-43ed-b0d4-b9732558fd04",
                                "sense_id": "b6e1c750-e462-3019-b2c7-a0bb38dca198",
                                "text": "„Wir brauchen eine Solarwende.“"
                            },
                            {
                                "example_id": "722d8d8e-b508-4bc7-8324-3d4a684fe5be",
                                "sense_id": "b6e1c750-e462-3019-b2c7-a0bb38dca198",
                                "text": "Der Energiewirtschaft war die Solarwende suspekt."
                            },
                            {
                                "example_id": "0c6ed5ba-d47b-4843-a3a6-f4a07313de85",
                                "sense_id": "b6e1c750-e462-3019-b2c7-a0bb38dca198",
                                "text": "„Ein winziger Inselstaat im Südpazifik führt sie an, die erste „Solarwende“ der Welt: Seit 2012 sichern 4032 Photovoltaik-Module die gesamte Energieversorgung der Kleinstnation Tokelau.“"
                            },
                            {
                                "example_id": "ae0f12b4-3e34-4b2c-8d45-b10f72bf1ec3",
                                "sense_id": "b6e1c750-e462-3019-b2c7-a0bb38dca198",
                                "text": "[Schlagzeile:] „Der Trend: Solarwende in Deutschland – Wie der Drang, dazugehören zu wollen, deutsche Dächer bepflasterte“"
                            },
                            {
                                "example_id": "034cfa4b-ffdb-4da1-804b-50fa7cf61814",
                                "sense_id": "b6e1c750-e462-3019-b2c7-a0bb38dca198",
                                "text": "[Schlagzeile:] „Schwerer Weg bis 2030 – Wie die Solarwende gelingen soll“"
                            },
                            {
                                "example_id": "d389429a-b71b-4f89-b7e9-93a651d0fbcd",
                                "sense_id": "b6e1c750-e462-3019-b2c7-a0bb38dca198",
                                "text": "„Griechenland hat die Solarwende verschlafen“"
                            },
                            {
                                "example_id": "94eac463-70f9-443f-87ff-9b98dff7d37b",
                                "sense_id": "b6e1c750-e462-3019-b2c7-a0bb38dca198",
                                "text": "„Der Vorschlag einer Solarwende kann aus diesem Dilemma herausführen.“"
                            },
                            {
                                "example_id": "77f645c3-0150-4962-b810-077377b3208f",
                                "sense_id": "b6e1c750-e462-3019-b2c7-a0bb38dca198",
                                "text": "„Bisher arbeiten in Deutschland etwa 25.000 Menschen in 5.000 Betrieben an der Solarwende“ […]."
                            },
                            {
                                "example_id": "415b533c-1f58-4b05-a13b-785a1a590340",
                                "sense_id": "b6e1c750-e462-3019-b2c7-a0bb38dca198",
                                "text": "„Ein wichtiger Baustein der Solarwende, wie sie Rot-Rot-Grün vorschwebt, ist das Mieterstrommodell, bei dem die Bewohner eines Mehrfamilienhauses direkt vom günstigen Strom aus eigener Photovoltaik (PV) profitieren.“"
                            },
                            {
                                "example_id": "7ae7bc6a-d337-4ef8-9c23-1e0812b05897",
                                "sense_id": "b6e1c750-e462-3019-b2c7-a0bb38dca198",
                                "text": "„Dass die Solarwende politisch so abrupt ausgebremst wurde, war wohl einer der Gründe dafür, dass Juwi in den vergangenen zwei Jahren fast die Puste ausgegangen wäre. Rund 500 der 1500 Arbeitsplätze musste der Konzern im vergangenen Jahr abbauen oder auslagern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
