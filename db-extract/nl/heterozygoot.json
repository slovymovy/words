                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "heterozygot",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ca28e5ab-8dff-3184-b2f8-cc2ed50a1dd4",
                                        "entry_id": "8c741eec-1ed2-3f22-8aa9-f96cd40e15e5",
                                        "glosses": [
                                            "durch verschiedene mütterliche und väterliche Erbanlagen, den Allelen eines Genpaares, bestimmt"
                                        ],
                                        "tags": [
                                            "Genetik",
                                            "Erbmerkmal bei diploiden Lebewesen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d983b59e-2757-4dac-a53c-b398ea6511b3",
                                                "sense_id": "ca28e5ab-8dff-3184-b2f8-cc2ed50a1dd4",
                                                "text": "Und 44 Prozent der Gene Venters sind heterozygot, liegen also in zwei verschiedenen Ausprägungen vor (eine vom Vater geerbt, eine von der Mutter)."
                                            },
                                            {
                                                "example_id": "513488f1-66a0-4ade-ae3b-a5cbf0999f37",
                                                "sense_id": "ca28e5ab-8dff-3184-b2f8-cc2ed50a1dd4",
                                                "text": "So wirkt diese Variante positiv, wenn ein Mensch sie „heterozygot“ hat, also nur einmal, in nur einer Ausgabe des Gens."
                                            },
                                            {
                                                "example_id": "da05607e-c81a-4964-8d50-1bacd97f350d",
                                                "sense_id": "ca28e5ab-8dff-3184-b2f8-cc2ed50a1dd4",
                                                "text": "Sondern schon die genetische Beratung, die heute bereits auf molekularbiologische Diagnosen heterozygot übertragener Erbkrankheiten zurückgreifen kann, verändert, wenn auch indirekt, den Genpool der Spezies."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
