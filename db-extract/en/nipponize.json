                "senses": [
                    {
                        "sense_id": "357af5fe-e200-3759-84e9-71779fb069f4",
                        "entry_id": "ef7f8514-8b76-3268-a997-5973d43e962d",
                        "glosses": [
                            "To make or become Japanese, as to customs, culture, or style."
                        ],
                        "tags": [
                            "ambitransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "e708ca9e-6b04-478a-8ab4-4c0a325080b9",
                                "sense_id": "357af5fe-e200-3759-84e9-71779fb069f4",
                                "text": "Christianity should be Japan’s greatest ally in Nipponizing its new territory."
                            },
                            {
                                "example_id": "8fe3c019-7420-44b2-b416-432efed5d3f7",
                                "sense_id": "357af5fe-e200-3759-84e9-71779fb069f4",
                                "text": "The movie “Nipponizes” King Lear within the protocols of the formalistic patterns of traditional “Noh” drama."
                            },
                            {
                                "example_id": "f73f7780-0866-427a-a460-c6cb7012fe82",
                                "sense_id": "357af5fe-e200-3759-84e9-71779fb069f4",
                                "text": "He invited me for a meal. The table was set with plates and chopsticks, little dishes of soy sauce and wasabi paste; bigger platters of sushi, sashimi, tempura, and dumplings; bowls of miso soup. “I have been thoroughly Nipponized,” Floyd said."
                            }
                        ]
                    },
