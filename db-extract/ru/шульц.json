                        "entry_id": "314f7501-1f16-3d9c-9cad-b46e31f61157",
                        "glosses": [
                            "деревенский староста в немецкоговорящих странах"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bab7dd3a-3913-4ea2-ba8d-73af32bd9019",
                                "sense_id": "66e2e05a-70f3-3615-8f31-f52aae3dc7f2",
                                "text": "В Пруссии мы обыкновенно обращались с требованием к старшине в деревне, к шульцу, а здесь надлежало собирать всех хозяев."
                            }
                        ]
                    }
