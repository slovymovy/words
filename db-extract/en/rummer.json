                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b459a504-c507-4235-b106-43b2f81be6f3",
                                "sense_id": "1506e77f-a894-3bc3-afc2-64f8d80b0371",
                                "text": "I won, and regaled myself with cold roast beef and rummers of punch."
                            }
                        ]
