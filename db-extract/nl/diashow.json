                        "examples": [
                            {
                                "example_id": "ec811544-ff9d-495f-bc6a-a821f1fe1cad",
                                "sense_id": "3f40637e-d13f-3699-9f63-ed53a12e232a",
                                "text": "De groei is waarschijnlijk vooral te danken aan de nieuwe functies binnen Instagram. Zo werd afgelopen zomer Stories geïntroduceerd waarin je een soort diashow kunt maken van foto's en video's. De app gaat daarmee de concurrentie aan met Snapchat. Ook kunnen gebruikers nu live video's maken en foto's delen die verdwijnen."
                            },
                            {
                                "example_id": "8fb82f26-a936-4dac-acb8-6e35acfa871f",
                                "sense_id": "3f40637e-d13f-3699-9f63-ed53a12e232a",
                                "text": "Naast Rivers werden dit jaar onder anderen BB King, Leonard Nimoy en Frank Gifford geëerd. Tijdens de diashow van de namen speelde het nummer What A Wonderful World."
                            },
                            {
                                "example_id": "bcadd91f-d304-4b29-9f5c-d1ef7339c42e",
                                "sense_id": "3f40637e-d13f-3699-9f63-ed53a12e232a",
                                "text": "Storymaker is een plakboek-app, waarmee foto's, video's en andere zelfgemaakte content samengebracht kan worden in een diashow."
                            }
                        ]
                    }
