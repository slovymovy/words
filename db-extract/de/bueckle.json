                "senses": [
                    {
                        "sense_id": "238a2f0c-bd9b-3274-a3b0-acb3baa9b52f",
                        "entry_id": "b430fa80-9b9f-3fba-a594-a73df01767d0",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2326b991-6e27-4edc-90e1-ff6fa23d4a88",
                                "sense_id": "238a2f0c-bd9b-3274-a3b0-acb3baa9b52f",
                                "text": "Frau Bueckle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "f9ad22cf-bf5f-40e6-b0b3-f1542fd5e078",
                                "sense_id": "238a2f0c-bd9b-3274-a3b0-acb3baa9b52f",
                                "text": "Herr Bueckle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "89526165-edbd-4586-863e-10e0ca39fb9a",
                                "sense_id": "238a2f0c-bd9b-3274-a3b0-acb3baa9b52f",
                                "text": "Die Bueckles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "1ee0eb8d-b7a6-428f-a957-7f2279392b15",
                                "sense_id": "238a2f0c-bd9b-3274-a3b0-acb3baa9b52f",
                                "text": "Der Bueckle trägt nie die Schals, die die Bueckle ihm strickt."
                            },
                            {
                                "example_id": "175afb68-347f-426f-b522-afa72ece23eb",
                                "sense_id": "238a2f0c-bd9b-3274-a3b0-acb3baa9b52f",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Bueckle kommt, geht der Herr Bueckle.“"
                            },
                            {
                                "example_id": "93bd8a99-5ec3-4b5e-92dd-e716cfe56140",
                                "sense_id": "238a2f0c-bd9b-3274-a3b0-acb3baa9b52f",
                                "text": "Bueckle kommt und geht."
                            },
                            {
                                "example_id": "08e6ef89-257a-47d7-88d0-05dba8ce2be5",
                                "sense_id": "238a2f0c-bd9b-3274-a3b0-acb3baa9b52f",
                                "text": "Bueckles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
