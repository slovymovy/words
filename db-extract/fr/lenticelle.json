                    {
                        "sense_id": "1834bf85-f174-32fd-a80a-011b2e31ef93",
                        "entry_id": "a728007a-938b-35aa-b1a4-41160a7e05e2",
                        "glosses": [
                            "Tache ovale sous l’épiderme des arbres, lui servant à échanger avec le milieu extérieur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81e9db34-ac0f-4ef2-9e80-fb1662a2878e",
                                "sense_id": "1834bf85-f174-32fd-a80a-011b2e31ef93",
                                "text": "La lenticelle n’est ni plus ni moins qu’une déchirure du liège, ménageant une ouverture qui devient une zone privilégiée où l’air ambiant peut entrer dans la branche."
                            },
                            {
                                "example_id": "1def50a4-44a5-4367-9ca5-ae30296b4646",
                                "sense_id": "1834bf85-f174-32fd-a80a-011b2e31ef93",
                                "text": "Une des réponses des plantes à l’inondation est la production de lenticelles de grande dimension qui facilitent les échanges gazeux […] et la production, à des fins d’échanges gazeux, de racines adventives situées au-dessus du plan d’immersion."
                            }
                        ]
                    },
                    {
                        "sense_id": "1b1a3d17-8712-3fbc-bf1e-2162f68ed4a1",
                        "entry_id": "a728007a-938b-35aa-b1a4-41160a7e05e2",
                        "glosses": [
                            "Tache rousse et ovale de l’épiderme."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
