                    {
                        "sense_id": "3e6c9167-a305-3cc1-9076-8b5c3a5ec686",
                        "entry_id": "aa01072c-23ef-3116-bda2-2af4c5e65fc8",
                        "glosses": [
                            "dat wat in een (rang)ordening met 68 is aangeduid"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f1a547c9-8318-495e-8268-b4f9a77fc9bd",
                                "sense_id": "3e6c9167-a305-3cc1-9076-8b5c3a5ec686",
                                "text": "Het is weer de achtenzestig die het niet doet, kunnen we die niet simpel vervangen?"
                            },
                            {
                                "example_id": "955781e6-0f8b-4daa-82da-4f9b1e7e0097",
                                "sense_id": "3e6c9167-a305-3cc1-9076-8b5c3a5ec686",
                                "text": "Haar negenenzestigste verjaardag was een belangrijk moment, want haar leven werd heel anders toen ze de achtenzestig eenmaal voorbij was."
                            }
                        ]
                    },
                    {
                        "sense_id": "289ec053-b93d-3966-8c44-55169d58b74b",
                        "entry_id": "aa01072c-23ef-3116-bda2-2af4c5e65fc8",
                        "glosses": [
                            "groep van 68 eenheden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "660b83bc-1d2b-4262-90cb-5c6589d3b890",
                                "sense_id": "289ec053-b93d-3966-8c44-55169d58b74b",
                                "text": "De achtenzestig zijn natuurlijk blij, maar laten we ook denken aan het verdriet van de vier die zijn afgewezen."
                            }
                        ]
                    }
                ],
