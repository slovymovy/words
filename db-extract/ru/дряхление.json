                "senses": [
                    {
                        "sense_id": "6d5779dd-4ec2-3783-8862-647d98a4f2f7",
                        "entry_id": "a894bb40-75ce-3260-a750-abf55ba9176d",
                        "glosses": [
                            "действие по значению гл. дряхлеть"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff9afc90-1593-43f3-84b5-3caececcd731",
                                "sense_id": "6d5779dd-4ec2-3783-8862-647d98a4f2f7",
                                "text": "Нерлин же не обронил ничего и никого ― родителей сразу перевез в Москву, с юрфаковскими одногруппниками до сих пор встречается ― уж и Суренычу поднадоело их брюзжание, не говоря о стремительном дряхлении, особенно заметном, если с боссом сравнивать."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b2555049-c06e-423f-96b9-6c4939fa0c5b",
                        "source_entry_id": "a894bb40-75ce-3260-a750-abf55ba9176d",
                        "source_sense_id": "6d5779dd-4ec2-3783-8862-647d98a4f2f7",
                        "target_lang_word": "senescence",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "senescence",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "80fa7a29-4012-3b26-af70-54fb45a13414",
                                        "entry_id": "5c20b149-aa76-3c5c-b55b-773c33cfe0bc",
                                        "glosses": [
                                            "The state or process of ageing, especially in humans; old age."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6dd69e80-b5a5-40db-872f-74627c3f7ba6",
                                                "sense_id": "80fa7a29-4012-3b26-af70-54fb45a13414",
                                                "text": "Organized shuffleboard has always filled me with dread. Everything about it suggests infirm senescence and death: it’s like it’s a game played on the skin of a void and the rasp of the sliding puck is the sound of that skin getting abraded away bit by bit."
                                            },
                                            {
                                                "example_id": "c64dfcd2-b958-4d40-8a62-60069babe149",
                                                "sense_id": "80fa7a29-4012-3b26-af70-54fb45a13414",
                                                "text": "Over the next 150 years the known age of the Earth expanded a millionfold and lost worlds of the past were found to have overflowed with species now gone. The chain stretched, aged, and eventually succumbed to senescence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "68128719-d23b-3533-9446-1301f7b8feeb",
                                        "entry_id": "5c20b149-aa76-3c5c-b55b-773c33cfe0bc",
                                        "glosses": [
                                            "Ceasing to divide by mitosis because of shortening of telomeres or excessive DNA damage."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ec91d141-bbef-4491-b138-ccdd6139d243",
                                                "sense_id": "68128719-d23b-3533-9446-1301f7b8feeb",
                                                "text": "2018, University of Edinburgh, \"Liver Study Offers Insights into Hard-to-treat Diseases\" (9 March 2018), Drug Discovery & Development.\nTests in mice found that inducing senescence in bile duct cells - mimicking the process seen in human bile duct disease - led to liver scarring and damage of liver function."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d3fae98a-36f7-345e-b7aa-32488f46eac3",
                                        "entry_id": "5c20b149-aa76-3c5c-b55b-773c33cfe0bc",
                                        "glosses": [
                                            "Old age; accumulated damage to macromolecules, cells, tissues and organs with the passage of time."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "067cba95-dce0-385a-b8e8-a4044cda4dc3",
                                        "entry_id": "5c20b149-aa76-3c5c-b55b-773c33cfe0bc",
                                        "glosses": [
                                            "Fruit senescence, leading to ripening of fruit."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "396aa7f7-1c0b-3ae9-bb73-df5441f73707",
                                        "entry_id": "5c20b149-aa76-3c5c-b55b-773c33cfe0bc",
                                        "glosses": [
                                            "Condition when the cell ceases to divide."
                                        ],
