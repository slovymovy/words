                                    {
                                        "sense_id": "780f29c7-bac9-3597-8ea9-cbb88e071ca9",
                                        "entry_id": "00cba8d9-c51e-3d9f-94a6-9105100353c2",
                                        "glosses": [
                                            "Abbreviation of submarine."
                                        ],
