                ],
                "senses": [
                    {
                        "sense_id": "9d0d7fe2-c567-3e0f-a35b-7af33e00ae3d",
                        "entry_id": "98c02274-d6f9-3a81-a448-a485c74456a5",
                        "glosses": [
                            "Relatif au capital, aux investissements en capitaux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb944bbf-62ad-4e58-bf32-15e722d42fe4",
                                "sense_id": "9d0d7fe2-c567-3e0f-a35b-7af33e00ae3d",
                                "text": "[…] : il est normal qu’une entreprise industrielle à forte intensité capitalistique distribue moins de salaires qu’une entreprise de services où l’essentiel de la production repose sur le facteur travail."
                            },
                            {
                                "example_id": "12725f3d-b378-4910-ac98-054e0d07d7a2",
                                "sense_id": "9d0d7fe2-c567-3e0f-a35b-7af33e00ae3d",
                                "text": "[…], cet échange de 3,1% d'actions est trop limité pour etre considéré comme une révolution capitalistique."
                            },
                            {
                                "example_id": "52588ace-dfa8-4a41-89a5-55c651f67f34",
                                "sense_id": "9d0d7fe2-c567-3e0f-a35b-7af33e00ae3d",
                                "text": "Un rapprochement capitalistique était en effet en cours entre ces deux sociétés, l’AMO ayant vocation à devenir prochainement une filiale du cotraitant du groupement candidat."
                            }
                        ]
                    },
                    {
                        "sense_id": "43790e8a-9952-3141-be35-ff411dd119ce",
                        "entry_id": "98c02274-d6f9-3a81-a448-a485c74456a5",
                        "glosses": [
                            "Relatif au capitalisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "489bcdb1-1d89-4601-9097-ab050371af74",
                                "sense_id": "43790e8a-9952-3141-be35-ff411dd119ce",
                                "text": "le système capitalistique doit déboucher inéluctablement sur la révolution prolétarienne."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "360867bb-61de-4bbe-b755-5654f78c7c2d",
                        "source_entry_id": "98c02274-d6f9-3a81-a448-a485c74456a5",
                        "target_lang_word": "kapitalistisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kapitalistisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "853173f1-c45b-3282-9ea2-0bf01913b8ba",
                                        "entry_id": "569fecad-3321-3df5-afa6-7f7c48c2d4c1",
                                        "glosses": [
                                            "den Kapitalismus betreffend oder auf ihm beruhend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c085ccdb-a95a-4078-9d72-ec2ec608a533",
                                                "sense_id": "853173f1-c45b-3282-9ea2-0bf01913b8ba",
                                                "text": "Der Einsatz von Frontex und andere Maßnahmen zur Grenzverstärkung der EU werden von Kritikern als kapitalistischer Schutzwall verspottet."
                                            },
                                            {
                                                "example_id": "c524c28a-6ada-4c26-a9cf-546186ae198e",
                                                "sense_id": "853173f1-c45b-3282-9ea2-0bf01913b8ba",
                                                "text": "Die kapitalistische Maschine, einmal in Gang gesetzt, kennt keine Bremsen. Der Zwang zur Akkumulation und die Konkurrenz zwingen das Kapital zur Eroberung immer neuer Märkte, Rohstoffquellen und billiger Arbeitskräfte."
                                            },
                                            {
                                                "example_id": "f67af25a-391c-44c7-af01-703b809b4d7c",
                                                "sense_id": "853173f1-c45b-3282-9ea2-0bf01913b8ba",
                                                "text": "Des linkspopulistische Ollanta Humala war im Wahlkampf vom venezuelanischen Präsidenten Hugo Chávez unterstützt worden und hatte wie dieser den „US-Imperialismus“ und die neoliberale kapitalistische Wirtschaftsordnung angeprangert."
                                            },
                                            {
                                                "example_id": "a1b0ca08-2bb9-4518-832f-c62684907675",
                                                "sense_id": "853173f1-c45b-3282-9ea2-0bf01913b8ba",
                                                "text": "Den in der Doha-Runde vertretenen Staaten sei es nicht um die Bekämpfung der weltweiten Armut gegangen, sondern das vorrangige Ziel sei es gewesen, die Märkte von Dritte-Welt-Ländern zu öffnen, um die eigenen kapitalistischen Interessen [der G6-Mitglieder unter Führung der USA] zu verfolgen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6d067c1d-e54c-45de-92b6-a2790d7ee5c5",
                        "source_entry_id": "98c02274-d6f9-3a81-a448-a485c74456a5",
                        "target_lang_word": "capitalistic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "capitalistic",
