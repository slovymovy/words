                            {
                                "example_id": "bd58802f-302d-4861-800e-509dd2097f82",
                                "sense_id": "1650bca4-f681-3623-9b70-7e220947c031",
                                "text": "Между тем, именно от неисправности богослужения растет сектанство."
                            },
                            {
                                "example_id": "c7600d6b-1050-4563-aa14-e95c9054bd82",
                                "sense_id": "1650bca4-f681-3623-9b70-7e220947c031",
                                "text": "Нетерпимость, узость, какая-то дешевая, подпольная подозрительность, сектанство, демагогия."
                            }
                        ]
                    }
