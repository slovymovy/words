{
    "word_family": [
        "wenden",
        "wendbaarheid",
        "wending"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "dbc81210-6dde-35e9-ab27-a2942b5d4633",
                    "sense_definition": "Gemakkelijk van richting kunnen veranderen; soepel bewegend.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "manoeuvreerbaar",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Door de korte draaicirkel hebben we hier een van de meest <w>wendbare</w> auto's die ooit gemaakt is.",
                            "target_lang_translations": {
                                "en": "Due to the short turning radius, we have here one of the most <w>maneuverable</w> cars ever made."
                            }
                        },
                        {
                            "text": "De kleine boot was uiterst <w>wendbaar</w> op de smalle rivier.",
                            "target_lang_translations": {
                                "en": "The small boat was extremely <w>maneuverable</w> on the narrow river."
                            }
                        }
                    ],
                    "synonyms": [
                        "manoeuvreerbaar",
                        "beweeglijk",
                        "vlot"
                    ],
                    "antonyms": [
                        "onhandig",
                        "stug",
                        "onbuigzaam"
                    ],
                    "common_phrases": [
                        "uiterst wendbaar",
                        "snel en wendbaar"
                    ],
                    "target_lang_definitions": {
                        "en": "Able to change direction easily; moving smoothly and easily maneuverable."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "maneuverable",
                                "target_lang_sense_clarification": "of vehicles, vessels, or aircraft"
                            },
                            {
                                "target_lang_word": "agile",
                                "target_lang_sense_clarification": "nimble and quick in movement"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "24bd41e8-7e80-3bab-820e-e29d0f051119",
                    "sense_definition": "Snel en behendig in beweging; lenig en alert.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "behendig",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De jonge gymnast bleek erg <w>wendbaar</w> tijdens de moeilijke oefening.",
                            "target_lang_translations": {
                                "en": "The young gymnast proved to be very <w>agile</w> during the difficult exercise."
                            }
                        },
                        {
                            "text": "Een kat is een zeer <w>wendbaar</w> dier dat makkelijk obstakels ontwijkt.",
                            "target_lang_translations": {
                                "en": "A cat is a very <w>nimble</w> animal that easily avoids obstacles."
                            }
                        }
                    ],
                    "synonyms": [
                        "behendig",
                        "lenig",
                        "vlug"
                    ],
                    "antonyms": [
                        "traag",
                        "stijf"
                    ],
                    "common_phrases": [
                        "zeer wendbaar"
                    ],
                    "target_lang_definitions": {
                        "en": "Quick and nimble in movement; supple and alert."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "agile",
                                "target_lang_sense_clarification": "physically quick and nimble"
                            },
                            {
                                "target_lang_word": "nimble",
                                "target_lang_sense_clarification": "quick and light in movement"
                            },
                            {
                                "target_lang_word": "supple",
                                "target_lang_sense_clarification": "flexible and limber"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "11ce4086-7ad0-3eb2-9f6a-18d34cd60f58",
                    "sense_definition": "In staat om zich snel aan te passen aan veranderende omstandigheden; flexibel inzetbaar.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "flexibel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In deze dynamische markt moeten bedrijven een <w>wendbare</w> organisatie hebben om te overleven.",
                            "target_lang_translations": {
                                "en": "In this dynamic market, companies must have an <w>agile</w> organization to survive."
                            }
                        },
                        {
                            "text": "Dankzij zijn <w>wendbare</w> geest kon hij snel een oplossing voor het probleem bedenken.",
                            "target_lang_translations": {
                                "en": "Thanks to his <w>agile</w> mind, he was able to quickly come up with a solution to the problem."
                            }
                        }
                    ],
                    "synonyms": [
                        "flexibel",
                        "veelzijdig",
                        "aanpasbaar"
                    ],
                    "antonyms": [
                        "rigide",
                        "onflexibel"
                    ],
                    "common_phrases": [
                        "wendbare organisatie"
                    ],
                    "target_lang_definitions": {
                        "en": "Able to adapt quickly to changing circumstances; flexible in deployment or mindset."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "agile",
                                "target_lang_sense_clarification": "of organizations, methods, or minds"
                            },
                            {
                                "target_lang_word": "flexible",
                                "target_lang_sense_clarification": "adaptable to change"
                            },
                            {
                                "target_lang_word": "adaptable",
                                "target_lang_sense_clarification": "able to adjust to new conditions"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}