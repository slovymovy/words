                                "target_senses": [
                                    {
                                        "sense_id": "dbd15949-61c9-30f7-b0ac-6316c82b4a07",
                                        "entry_id": "5ad3d0d3-5d6e-3801-9546-44422e858eb7",
                                        "glosses": [
                                            "Dispositif de mise au point automatique de certains systèmes optiques comme sur un appareil photo, permettant de régler la netteté du sujet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "026c836e-4282-40e3-97b7-e056043be26d",
                                                "sense_id": "dbd15949-61c9-30f7-b0ac-6316c82b4a07",
                                                "text": "Sony a développé cette technologie pour trouver une solution aux problèmes d’autofocus que rencontraient les reflex en Live View (visée à l’écran) et en vidéo."
                                            },
                                            {
                                                "example_id": "a4fb52a6-46e2-4af0-931e-6d98e7dbb780",
                                                "sense_id": "dbd15949-61c9-30f7-b0ac-6316c82b4a07",
                                                "text": "Les gamins scrutaient les berges, à la recherche de ragondins, les femmes souriaient, heureuses, et les hommes, l’œil collé à l’autofocus ou au camescope, fixaient cette réalité recadrée dans une éternité de pellicule."
                                            },
                                            {
                                                "example_id": "ed8d4b9d-b731-4f5f-aa29-9ce120062832",
                                                "sense_id": "dbd15949-61c9-30f7-b0ac-6316c82b4a07",
                                                "text": "Un peu massif (127,7 x 85,1 x 65,4 mm, pour 491 g), c’est un véritable expert qui reste utilisable par tous, avec un autofocus très réactif."
                                            }
                                        ]
                                    }
                                ]
                            },
