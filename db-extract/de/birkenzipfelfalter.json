                "senses": [
                    {
                        "sense_id": "4f610f59-747e-3be1-8cf4-5d06cd39b991",
                        "entry_id": "a5192631-2071-3938-94cc-14eb2d633765",
                        "glosses": [
                            "Schmetterlingsart der Gattung Thecla aus der Familie der Bläulinge"
                        ],
                        "tags": [
                            "Lycaenidae"
                        ],
                        "examples": [
                            {
                                "example_id": "dca0b2ff-0519-4b50-b275-1975711e7d3a",
                                "sense_id": "4f610f59-747e-3be1-8cf4-5d06cd39b991",
                                "text": "„Nierenfleck oder Birkenzipfelfalter. Raupe 2 bis 3 cm lang, asselförmig, grün, mit gelbem Rückenstreif, gelben Schrägstrichen, gelblichen Seitenlinien und braunem Kopf auf der Unterseite.“"
                            },
                            {
                                "example_id": "dec3cef3-c77a-47c0-bb00-1f688bd58247",
                                "sense_id": "4f610f59-747e-3be1-8cf4-5d06cd39b991",
                                "text": "„Mehr als 100 Schmetterlingsarten, darunter viele Arten der Roten Liste wie der Birkenzipfelfalter, der Segelfalter und das Trauer-Grün-Widderchen, dient der Weißdorn als Nahrungsquelle und Lebensraum.“"
                            },
                            {
                                "example_id": "68ed360c-fac7-4653-96c7-b7c40504a2d1",
                                "sense_id": "4f610f59-747e-3be1-8cf4-5d06cd39b991",
                                "text": "„Eine Suche nach den Raupen des Grossen Schillerfalters Apatura iris im Winter und der Eier des Birkenzipfelfalters Thecla betulae in den Wäldern des Jorat bei Lausanne erlaubte es, die regionale Verbreitung der beiden Arten zu präzisieren.“"
                            },
                            {
                                "example_id": "d1009403-6d31-4a8b-84e7-3c01e771b9e8",
                                "sense_id": "4f610f59-747e-3be1-8cf4-5d06cd39b991",
                                "text": "„Der Birkenzipfelfalter ist ein Schmetterling, den man nur selten zu sehen bekommt, obwohl es in überall in Europa gibt.“"
                            },
                            {
                                "example_id": "809e4f2e-79cc-4df4-8193-d49179238750",
                                "sense_id": "4f610f59-747e-3be1-8cf4-5d06cd39b991",
                                "text": "„Der Birkenzipfelfalter lebt in den Wäldern Europas.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
