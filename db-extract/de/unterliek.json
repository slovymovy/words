                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a20eb1bf-5a39-4f38-ba4f-65372e5dc57f",
                                                "sense_id": "af876abb-fca1-3915-b7f3-9626dc3b4341",
                                                "text": "[…] Or shepherd-boy, they featly foot the green"
                                            },
                                            {
                                                "example_id": "327e8b85-de02-40f3-a091-769ca0a39836",
                                                "sense_id": "af876abb-fca1-3915-b7f3-9626dc3b4341",
                                                "text": "People who would not have dared to foot the place before crept in and did not come to the house."
                                            }
                                        ]
