                        "glosses": [
                            "Cri aigu d’oiseau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff37c197-7363-4890-b080-cb468d1aeb39",
                                "sense_id": "e3f57b1e-9000-3678-9cd9-fe4d756e87c8",
                                "text": "Elle dit cela franchement, d’un rire qui s’éparpilla dans la pièce, ainsi qu’un égosillement d’oiseau."
                            },
                            {
                                "example_id": "28bd50c2-ee58-41a6-9032-fd83a8de19bf",
                                "sense_id": "e3f57b1e-9000-3678-9cd9-fe4d756e87c8",
                                "text": "Mistigris tourne bien la tête brusquement, d’un côté, de l’autre, comme un malfaiteur inquiet, mais les cailloux ne l’atteignent pas ; il se jette sur le nid et vite, vite, il croque les petits, malgré l’égosillement affreux des deux mésanges."
                            },
                            {
                                "example_id": "18302823-ab3c-4509-a0ba-a9d536976fc2",
                                "sense_id": "e3f57b1e-9000-3678-9cd9-fe4d756e87c8",
                                "text": "Cette nuit-là, l’égosillement de l’animal secoua particulièrement les plus fines oreilles du village."
                            }
                        ]
                    }
