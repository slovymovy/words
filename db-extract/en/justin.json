                "entry_id": "d0769760-d064-3b78-972e-fa0044358172",
                "word": "Justin",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "2610e049-85a1-3e81-9ec2-908d8107b31e",
                        "entry_id": "d0769760-d064-3b78-972e-fa0044358172",
                        "glosses": [
                            "A male given name from Latin, popular in the English-speaking world since the 1970s."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "183ce738-a007-4b7b-8476-7d88b27079e4",
                                "sense_id": "2610e049-85a1-3e81-9ec2-908d8107b31e",
                                "text": "What is there, I wonder, about the name Justin that gives its bearer the quality of leadership? Justin Morrill was a leader of men. Justin Morgan was a leader of horses."
                            },
                            {
                                "example_id": "36158904-9ab5-4f00-b78d-a3decee7c4a4",
                                "sense_id": "2610e049-85a1-3e81-9ec2-908d8107b31e",
                                "text": "'It says here his name was Justin Summers. Now, if that ain't the whitest white-guy name of all time, then I don't know what. It's just a damn shame.'"
                            },
                            {
                                "example_id": "86723f3f-e26a-4853-916b-440523fe8f90",
                                "sense_id": "2610e049-85a1-3e81-9ec2-908d8107b31e",
                                "text": "After Trump spoke with Canadian Prime Minister Justin Trudeau in April 2017, the two sides offered vastly different accounts of what was discussed."
                            }
                        ]
                    },
                    {
                        "sense_id": "a8df3d87-1535-388d-8711-373d1e28ba49",
                        "entry_id": "d0769760-d064-3b78-972e-fa0044358172",
                        "glosses": [
                            "A surname."
