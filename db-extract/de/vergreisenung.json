                ],
                "senses": [
                    {
                        "sense_id": "2ba19ec1-cfec-3096-a001-07057289d373",
                        "entry_id": "7698f2aa-7106-390b-a72b-f00fd23f9367",
                        "glosses": [
                            "ein Lagerstätten bildender geologischer Prozess der Zersetzung von Granit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c2b2f9c1-be78-477b-9a32-ada802c1d5b6",
                                "sense_id": "2ba19ec1-cfec-3096-a001-07057289d373",
                                "text": "„Eine typische hochthermale Alterationserscheinung in intermediären bis sauren Gesteinen ist die Vergreisenung.“"
                            },
                            {
                                "example_id": "20eb0dd9-46c7-4e5b-b7ba-36e114c1a5eb",
                                "sense_id": "2ba19ec1-cfec-3096-a001-07057289d373",
                                "text": "„Oft erfolgte zum Beispiel eine Vergreisenung des Schlotkörpers und damit Vererzung im Nachhinein […].“"
                            },
                            {
                                "example_id": "34df3b11-ac6b-42ce-a645-5cb874fc8fb2",
                                "sense_id": "2ba19ec1-cfec-3096-a001-07057289d373",
                                "text": "„Bei den meisten Lagerstätten sind die zinnführenden Pegmatite nicht an die ausgesprochen pegmatitische Phase gebunden, sondern vorwiegend an die späteren Prozesse der Vergreisenung und Albitisierung bzw. an das pneumatolytische Stadium.“"
                            },
                            {
                                "example_id": "4d6c467e-a1e2-42d8-9150-bafbef385034",
                                "sense_id": "2ba19ec1-cfec-3096-a001-07057289d373",
                                "text": "„Einige der vorliegenden Proben sind bereits merklich geprägt durch die Zinnerzmineralisation (Sn-W-Erze mit Anteilen an Ta, Nb u.a.) und durch postmagmatische Vergreisenungen.“"
                            },
                            {
                                "example_id": "d0fedbb6-8580-49d2-9c44-56141f8902a4",
                                "sense_id": "2ba19ec1-cfec-3096-a001-07057289d373",
                                "text": "„Zwischen dem Erstarrungsmechanismus des Monzogranitkörpers, seines post- magmatischen Lösungsangebotes und der Vergreisenung sowie der daran nachfolgenden Vererzung besteht ein kausaler Zusammenhang […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
