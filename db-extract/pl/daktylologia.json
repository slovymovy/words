                    {
                        "translation_id": "4db3d51d-1a01-433a-b324-d7e9fc290cec",
                        "source_entry_id": "c7bf3268-dc32-3012-a257-33b8197fb08a",
                        "source_sense_id": "f46d44f3-6a0a-3ec5-868e-9551fd85ec00",
                        "target_lang_word": "dactylologie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dactylologie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6f310d52-0248-3f0a-8eb2-943ea5762726",
                                        "entry_id": "46834f18-002c-3181-8fcd-91c8ac9a2c00",
                                        "glosses": [
                                            "Alphabet de la langue des signes, utilisé principalement par les personnes sourdes pour épeler un mot inconnu, par exemple un nom de ville n’ayant pas de signe propre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5cfe21e8-1b52-4b90-b57e-fca4d018c2e6",
                                                "sense_id": "6f310d52-0248-3f0a-8eb2-943ea5762726",
                                                "text": "Le metteur [en pages] donnait aux doigts de sa main droite les positions diverses et rapides représentant les lettres de l’alphabet, qu’ont les doigts des sourds-muets lorsqu’ils causent par la dactylologie.\nPargat répondit d’une voix basse, atone, un peu bafouillante : « Mais ce n’est pas moi, Monsieur. »\nLe metteur dactylologua encore, les yeux arrondis et dardés, puis il s’en retourna à son rang pour corriger une liasse d’épreuves."
                                            },
                                            {
                                                "example_id": "af45b527-5184-4be8-b679-289321dc75e5",
                                                "sense_id": "6f310d52-0248-3f0a-8eb2-943ea5762726",
                                                "text": "On me dit d’épeler mon nom en dactylologie dans le creux de sa main."
                                            },
                                            {
                                                "example_id": "8acb9b14-8b49-42f7-a486-58ceb0f72f32",
                                                "sense_id": "6f310d52-0248-3f0a-8eb2-943ea5762726",
                                                "text": "La dactylologie de la LSF se fait d’une seule main, alors que la britannique se pratique avec les deux mains."
                                            },
                                            {
                                                "example_id": "95e43b40-e3bf-48cf-a88a-15027c9bfdca",
                                                "sense_id": "6f310d52-0248-3f0a-8eb2-943ea5762726",
                                                "text": "Jacob Rodrigue Péreire s’inspire de Juan de Pablo Bonet pour adapter un système plus performant et spécifique à la langue française, qui prend en compte sa forme phonique et orthographique, dans un ouvrage baptisé Dactylologie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
