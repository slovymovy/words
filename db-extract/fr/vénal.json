                                                "sense_id": "5f286aac-63b3-3d8c-a1f9-26cfae875053",
                                                "text": "„Es wurden dunkle Machenschaften in der Kirche bekannt, und es flog ein Ring bestechlicher Richter und Rechtsanwälte auf.“"
                                            },
                                            {
                                                "example_id": "db1cd756-d1bb-44c7-a737-0b7474c05315",
                                                "sense_id": "5f286aac-63b3-3d8c-a1f9-26cfae875053",
                                                "text": "„Die Deutschen, zeigt der Index, sind bestechlicher als manche ihrer europäischen Nachbarn.“"
                                            },
                                            {
                                                "example_id": "23151f7c-3fdd-4214-95cd-98ae0b9b6943",
                                                "sense_id": "5f286aac-63b3-3d8c-a1f9-26cfae875053",
                                                "text": "„Am bestechlichsten sind nicht die Minister, sondern die Steuerbehörden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
