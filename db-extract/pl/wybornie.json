        "pl-extract.jsonl": [
            {
                "entry_id": "67c1e3c5-7f39-30d0-9239-3313ded29054",
                "word": "wybornie",
                "pos": "adv",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "2021c3f4-3b13-3a31-bbaa-779b8aa440e1",
                        "entry_id": "67c1e3c5-7f39-30d0-9239-3313ded29054",
                        "glosses": [
                            "od: wyborny"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da63f3ec-8b9e-401d-9bce-f92b1badd60b",
                                "sense_id": "2021c3f4-3b13-3a31-bbaa-779b8aa440e1",
                                "text": "Goście bawili się wybornie."
                            },
                            {
                                "example_id": "5324e9a0-8653-422f-a0db-d35627a32a39",
                                "sense_id": "2021c3f4-3b13-3a31-bbaa-779b8aa440e1",
                                "text": "Powodzi mi się wybornie, udaje mi się wszystko."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7ae70f1d-6ad3-4afd-80b2-dd2dd122c073",
                        "source_entry_id": "67c1e3c5-7f39-30d0-9239-3313ded29054",
                        "source_sense_id": "2021c3f4-3b13-3a31-bbaa-779b8aa440e1",
                        "target_lang_word": "perfectly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "perfectly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d019e1d9-3adc-3d0f-97a1-09a105b2e3af",
                                        "entry_id": "4a652602-1ad3-3061-933b-044aebeb7602",
                                        "glosses": [
                                            "With perfection."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "75dd76b2-a54d-448e-9325-b5429e858a7a",
                                                "sense_id": "d019e1d9-3adc-3d0f-97a1-09a105b2e3af",
                                                "text": "They completed the first series perfectly."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e8c1b54f-bc99-34bc-89e7-9fef05bd65dd",
                                        "entry_id": "4a652602-1ad3-3061-933b-044aebeb7602",
                                        "glosses": [
                                            "Wholly, completely, totally."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be9de5bb-1a63-4a25-849e-3b66518fc08c",
                                                "sense_id": "e8c1b54f-bc99-34bc-89e7-9fef05bd65dd",
                                                "text": "Their performance was perfectly fine."
                                            },
                                            {
                                                "example_id": "de371d47-7510-4ca2-8c39-522d8dc11d9a",
                                                "sense_id": "e8c1b54f-bc99-34bc-89e7-9fef05bd65dd",
                                                "text": "The Gentiles would not perfectly relinquish all their Idols; so, they were persuaded to turne the Image of Jupiter with his thunderbolt to Christus crucifixus, and Venus and Cupid to the Madonna and her Babe."
                                            },
                                            {
                                                "example_id": "4838019d-2f4f-49c2-ad61-ae011564f221",
                                                "sense_id": "e8c1b54f-bc99-34bc-89e7-9fef05bd65dd",
                                                "text": "I was perfectly stunned. I sat and moistened my lips a little, but otherwise made no effort to do anything: my chest was in a pitiful state."
                                            },
                                            {
                                                "example_id": "435b9b1e-af78-427a-91d9-c92262fbc2b0",
                                                "sense_id": "e8c1b54f-bc99-34bc-89e7-9fef05bd65dd",
                                                "text": "James Milner's angled free-kick was headed on to the post by the tireless [Darren] Bent and [Frank] Lampard the opportunist was perfectly placed to stoop and head in from virtually on the goal-line."
                                            },
                                            {
                                                "example_id": "78d2a611-4fd8-4d42-a8d1-cefc22805a42",
                                                "sense_id": "e8c1b54f-bc99-34bc-89e7-9fef05bd65dd",
                                                "text": "The route taken does not have to be a perfectly straight line, just so long as it is linear and is followed consistently for each transect taken."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c0545583-93e6-4b66-85ee-7bec840b9628",
                        "source_entry_id": "67c1e3c5-7f39-30d0-9239-3313ded29054",
                        "source_sense_id": "2021c3f4-3b13-3a31-bbaa-779b8aa440e1",
                        "target_lang_word": "exquisitely",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "exquisitely",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ab0bcc09-c620-3293-94be-0e6dbb0774ab",
                                        "entry_id": "097c46ab-f217-3c2d-812b-1093c94bf571",
                                        "glosses": [
                                            "In an exquisite manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "59adec98-be1b-4aae-8e9a-1d2afdb91052",
                                                "sense_id": "ab0bcc09-c620-3293-94be-0e6dbb0774ab",
                                                "text": "Over the fish-dish — something sole-like, exquisitely seethed in a strange sauce, garnished with roots and fruits of the country — Tommy became sentimental."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a96cd4f-d925-32d8-a4a1-90fe9c06d64c",
                                        "entry_id": "097c46ab-f217-3c2d-812b-1093c94bf571",
                                        "glosses": [
                                            "Exceedingly; in the highest degree."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "67857444-977b-439a-8503-c0b135b7a046",
                                                "sense_id": "6a96cd4f-d925-32d8-a4a1-90fe9c06d64c",
                                                "text": "There was something exquisitely painful in the memories that crowded upon his mind: a thousand of Constance's daily acts of affection rose before him: neyer till this moment had he felt them unrequited; but now they were remembered like a reproach."
                                            },
                                            {
                                                "example_id": "208af548-4a34-46ad-b7a3-bae4bb70fb5a",
                                                "sense_id": "6a96cd4f-d925-32d8-a4a1-90fe9c06d64c",
                                                "text": "They danced on silently, softly. Their feet played tricks to the beat of the tireless measure, that exquisitely asinine blare which is England's punishment for having lost America."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
