                                        "glosses": [
                                            "The practice of casually mentioning famous or important people or the titles of their works, subtly implying familiarity or association, in order to impress others."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c298e175-6b71-443b-8a16-5f68799c09e6",
                                                "sense_id": "046c3185-c7ec-3fcf-a44c-775187833520",
                                                "text": "“The one thing I don't want anybody to do, the one thing I will not tolerate, is name-dropping. It's bad. Marlon Brando told me that.”"
                                            }
                                        ]
                                    }
