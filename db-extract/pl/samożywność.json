                        "translation_id": "fd3e0a89-e393-4bde-8950-14e43c50bd99",
                        "source_entry_id": "a5610e92-6832-3a50-a5a0-d4617248b79e",
                        "source_sense_id": "d044265b-ab54-33c2-8f13-55203052e56c",
                        "target_lang_word": "autotrophy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "autotrophy",
