                                                "sense_id": "b931a99c-7a3e-35bc-a084-bcce179d7126",
                                                "text": "Just text me when you get here."
                                            },
                                            {
                                                "example_id": "bac51af3-6fc4-4493-817f-de09c6a1577d",
                                                "sense_id": "b931a99c-7a3e-35bc-a084-bcce179d7126",
