                "senses": [
                    {
                        "sense_id": "077c2506-6607-3a0b-8ea2-9969a72813f4",
                        "entry_id": "ed5b4375-21a5-36a8-b76a-0c01301bca0c",
                        "glosses": [
                            "Regrouper des champs, des terrains, pour éviter qu’ils ne soient trop morcelés."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cfcf297e-be8c-4f70-b18f-5ab53a7da610",
                                "sense_id": "077c2506-6607-3a0b-8ea2-9969a72813f4",
                                "text": "Pour le Doubs, la surface totale à remembrer est de 248 700 hectares (soit 47,5 % du territoire du département)."
                            },
                            {
                                "example_id": "3489b683-746b-46ac-82c9-98e35f3edfc0",
                                "sense_id": "077c2506-6607-3a0b-8ea2-9969a72813f4",
                                "text": "Ceux de la commune non remembrée sont en fait partagés : les uns reconnaissent qu'ils auraient dû remembrer, d'autres ont remembré grâce à des stratégies individuelles, certains estiment qu'ils ont bien fait de ne pas remembrer."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "73a44436-7305-4d1b-abf3-e19df4b22217",
                        "source_entry_id": "ed5b4375-21a5-36a8-b76a-0c01301bca0c",
                        "source_sense_id": "077c2506-6607-3a0b-8ea2-9969a72813f4",
                        "target_lang_word": "tập trung",
                        "target_lang_code": "vi",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tập trung",
                                "target_lang_code": "vi",
                                "target_senses": [
                                    {
                                        "sense_id": "f6c2b0dd-2781-369c-8c43-3d20b6dac8e4",
                                        "entry_id": "e43a7af5-c439-3b4b-94d7-a25295eef617",
                                        "glosses": [
                                            "Dồn vào một chỗ, một điểm."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dfd7f129-ad27-466d-8f43-3b7b229d1962",
                                                "sense_id": "f6c2b0dd-2781-369c-8c43-3d20b6dac8e4",
                                                "text": "Nơi tập trung đông người."
                                            },
                                            {
                                                "example_id": "d42322c5-7587-4d93-ab08-27553040be87",
                                                "sense_id": "f6c2b0dd-2781-369c-8c43-3d20b6dac8e4",
                                                "text": "Tập trung hoả lực."
                                            },
                                            {
                                                "example_id": "e96cd85d-f9b7-4ce6-896f-4ac61437e3ef",
                                                "sense_id": "f6c2b0dd-2781-369c-8c43-3d20b6dac8e4",
                                                "text": "Một biểu hiện tập trung của tình đoàn kết."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "202d0674-1010-3241-a121-822b27b7e57d",
                                        "entry_id": "e43a7af5-c439-3b4b-94d7-a25295eef617",
                                        "glosses": [
                                            "Dồn sức hoạt động, hướng các hoạt động vào một việc gì."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5572e511-4160-451f-a022-f54fc6775e5a",
                                                "sense_id": "202d0674-1010-3241-a121-822b27b7e57d",
                                                "text": "Tập trung sản xuất lương thực."
                                            },
                                            {
                                                "example_id": "4cd7f2cf-b492-4829-a059-ec38311f9505",
                                                "sense_id": "202d0674-1010-3241-a121-822b27b7e57d",
                                                "text": "Tập trung suy nghĩ."
                                            },
                                            {
                                                "example_id": "1986559a-52fd-4b71-8799-bb347593301a",
                                                "sense_id": "202d0674-1010-3241-a121-822b27b7e57d",
                                                "text": "Hội nghị tập trung thảo luận một vấn đề."
                                            },
                                            {
                                                "example_id": "985d736c-b39e-4900-9136-111373c9d297",
                                                "sense_id": "202d0674-1010-3241-a121-822b27b7e57d",
                                                "text": "Tư tưởng thiếu tập trung."
                                            }
                                        ]
                                    }
