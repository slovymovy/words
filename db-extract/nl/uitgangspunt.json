                            "neuter"
                        ],
                        "examples": [
                            {
                                "example_id": "35499821-6b42-4533-abbf-2ee31f71df3f",
                                "sense_id": "14430f79-ea44-3b1e-9c15-934d589df6c7",
                                "text": "Dit idee is het belangrijkste uitgangspunt voor ons onderzoek.",
                                "translation": "This idea is the main starting point for our research.",
                                "english": "This idea is the main starting point for our research."
                            },
                            {
                                "example_id": "f0ee1888-b2ee-45ac-9dda-0dee11488a21",
                                "sense_id": "14430f79-ea44-3b1e-9c15-934d589df6c7",
                                "text": "Elke wetenschapper heeft een ander uitgangspunt voor zijn theorie.",
                                "translation": "Every scientist has a different point of departure for their theory.",
                                "english": "Every scientist has a different point of departure for their theory."
                            },
                            {
                                "example_id": "5988c734-80db-4e2b-bb89-22efa54f865d",
                                "sense_id": "14430f79-ea44-3b1e-9c15-934d589df6c7",
                                "text": "Het uitgangspunt van deze discussie is dat iedereen gelijk is.",
                                "translation": "The starting point of this discussion is that everyone is equal.",
                                "english": "The starting point of this discussion is that everyone is equal."
                            }
                        ]
                    }
                ],
