                    {
                        "translation_id": "3e94f82c-5a03-48de-9e29-f717cbd6ba1b",
                        "source_entry_id": "f184c20e-2389-3964-ac98-728402d776b1",
                        "source_sense_description": "The rapid, uncontrollable descent of an aircraft in a steep spiral",
                        "target_lang_word": "што́пор",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "што́пор",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "f5533591-d9e1-33f3-bd46-3195ecbf05ef",
                                        "entry_id": "253388a8-5bd7-34c1-a8eb-fce8a3657054",
                                        "glosses": [
                                            "инструмент в виде винта с ручкой, предназначенный для выдёргивания пробки из бутылки"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5096e553-f18d-4a6f-afe3-bb9ac928c8d5",
                                                "sense_id": "f5533591-d9e1-33f3-bd46-3195ecbf05ef",
                                                "text": "Грешник тут один навстречу попался: штопор калёный в него ввинчен был по самую ручку, из пупка кончик торчал."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e10f192a-0442-3d46-8a9d-155414bc0b70",
                                        "entry_id": "253388a8-5bd7-34c1-a8eb-fce8a3657054",
                                        "glosses": [
                                            "авиац. неконтролируемое падение самолёта, траектория которого напоминает винт"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ebda416-a6f4-4aa0-930d-0aec146274da",
                                                "sense_id": "e10f192a-0442-3d46-8a9d-155414bc0b70",
                                                "text": "На заре авиации штопор был смертельно опасен. После того как учёные раскрыли физическую картину этого явления, удалось выработать приёмы пилотирования для вывода самолета из штопора. Хотя сделано в этом отношении многое, штопор не всегда безопасен и в наши дни."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
