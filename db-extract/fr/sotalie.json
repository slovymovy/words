                        "glosses": [
                            "Nom de différentes espèces de dauphins des genres Sotalia et Sousa."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ebcafea-7e7a-436c-a6da-bccce11f351e",
                                "sense_id": "70cb1489-be30-3a90-977d-c42e76709c64",
                                "text": "Il a la forme d’une pyramide irrégulièrement allongée, telle qu’on la voit dans la plupart des Ziphioïdes, dans les Dauphins et dans les Delphinorhynques, particulièrement dans les Inies et les Sotalies."
                            },
                            {
                                "example_id": "52c97483-aefa-4eaf-8b9b-b03f62048b5e",
                                "sense_id": "70cb1489-be30-3a90-977d-c42e76709c64",
                                "text": "Le Sotalie (alias dauphin guyanais, dauphin d’eau saumâtre, dauphin gris ou Profosu comme on l’appelle au Suriname) ressemble au souffleur (ou dauphin à gros nez) mais il est légèrement plus petit en taille."
                            }
                        ]
                    }
