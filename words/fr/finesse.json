                    "frequency": "High",
                    "semantic_group_id": "intellect",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle a résolu cette énigme avec une remarquable <w>finesse</w> d'esprit."
                        },
                        {
                            "text": "Le professeur a commenté le poème avec beaucoup de <w>finesse</w>."
                        }
                    ],
                    "synonyms": [
