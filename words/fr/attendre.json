{
    "word_family": [
        "attente",
        "inattendu",
        "attentisme",
        "attentiste"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b648ad8f-1f7b-3cd9-9e5f-578c53ac33d1",
                    "sense_definition": "Rester quelque part jusqu'à l'arrivée de quelqu'un ou de quelque chose.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "patienter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je suis à l'arrêt et j'<w>attends</w> le bus tous les matins."
                        },
                        {
                            "text": "Nous <w>attendons</w> nos amis devant le cinéma depuis vingt minutes."
                        }
                    ],
                    "synonyms": [
                        "patienter"
                    ],
                    "antonyms": [
                        "partir"
                    ],
                    "common_phrases": [
                        "attendre le bus",
                        "attendre son tour",
                        "attendre quelqu'un"
                    ]
                },
                {
                    "sense_id": "5ba15f06-97bf-32a0-836e-adb0b7846064",
                    "sense_definition": "Différer ou retarder une action jusqu'à un moment déterminé.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "différer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il préfère <w>attendre</w> le bon moment avant de prendre une décision."
                        },
                        {
                            "text": "Nous devons <w>attendre</w> la fin de la réunion pour poser des questions."
                        }
                    ],
                    "antonyms": [
                        "agir"
                    ],
                    "common_phrases": [
                        "attendre le bon moment",
                        "attendre la fin"
                    ]
                },
                {
                    "sense_id": "62220de4-ad77-3815-9854-dcdd41741b7f",
                    "sense_definition": "Espérer, exiger ou compter sur quelque chose de la part de quelqu'un.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "espérer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les professeurs <w>attendent</w> un travail sérieux de la part des étudiants."
                        },
                        {
                            "text": "Les citoyens <w>attendent</w> beaucoup de ce nouveau projet de loi."
                        }
                    ],
                    "common_phrases": [
                        "attendre beaucoup de",
                        "attendre des résultats"
                    ]
                },
                {
                    "sense_id": "25b05704-7ede-3f2c-88b5-550468189acc",
                    "sense_definition": "S'attendre à : prévoir ou anticiper un événement futur.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "prévoir",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Avec cette météo difficile, nous devons nous <w>attendre</w> au pire."
                        },
                        {
                            "text": "Elle ne s'<w>attendait</w> pas du tout à recevoir cette excellente nouvelle."
                        }
                    ],
                    "common_phrases": [
                        "s'attendre au pire",
                        "s'attendre à tout"
                    ]
                },
                {
                    "sense_id": "2c360aa7-64a0-3da9-9f00-15bf8d603a7e",
                    "sense_definition": "Être destiné ou réservé à quelqu'un dans l'avenir.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "destiner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Personne ne sait exactement ce qui nous <w>attend</w> lors de cette mission."
                        },
                        {
                            "text": "Un brillant avenir <w>attend</w> les jeunes diplômés de cette grande école."
                        }
                    ],
                    "common_phrases": [
                        "ce qui nous attend"
                    ]
                },
                {
                    "sense_id": "88d6f084-868d-3ef1-aab1-8aa4c952e7d1",
                    "sense_definition": "Attendre quelqu'un avec la préposition sur.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "patienter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cela fait plus d'une demi-heure que j'<w>attends</w> sur lui au café."
                        },
                        {
                            "text": "Ne t'inquiète pas, je n'ai pas trop <w>attendu</w> sur toi aujourd'hui."
                        }
                    ],
                    "common_phrases": [
                        "attendre sur quelqu'un"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Régionalisme"
                        }
                    ]
                },
                {
                    "sense_id": "36751749-efe0-3bf7-80e5-a42ab4e74a96",
                    "sense_definition": "Sens ancien équivalent à <w>entendre</w>, ouïr ou percevoir par l'ouïe.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "ouïr",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans ce texte médiéval, le voyageur <w>attendait</w> au loin le son des cloches."
                        },
                        {
                            "text": "Le poète employait ce verbe pour signifier qu'il <w>attendait</w> une douce voix."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Louisiane"
                        }
                    ]
                }
            ]
        }
    ]
}