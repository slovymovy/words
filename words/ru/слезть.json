{
    "word_family": [
        "лазить",
        "лезть",
        "залезть",
        "вылезть",
        "влезть",
        "полезть",
        "прилезть",
        "улезть"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "82540a45-7d44-3109-9f6e-43301dc2d87c",
                    "sense_definition": "Спуститься вниз с чего-либо, используя руки и ноги.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "movement_down",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мальчик быстро <w>слез</w> с высокого дерева.",
                            "target_lang_translations": {
                                "en": "The boy quickly <w>climbed down</w> from the tall tree."
                            }
                        },
                        {
                            "text": "Всадник <w>слез</w> с лошади, чтобы отдохнуть.",
                            "target_lang_translations": {
                                "en": "The rider <w>got off</w> the horse to rest."
                            }
                        }
                    ],
                    "synonyms": [
                        "спуститься"
                    ],
                    "antonyms": [
                        "залезть"
                    ],
                    "common_phrases": [
                        "слезть с дерева",
                        "слезть с лошади"
                    ],
                    "target_lang_definitions": {
                        "en": "To descend or climb down from something using hands and feet."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "climb down",
                                "target_lang_sense_clarification": "to descend from a height using limbs"
                            },
                            {
                                "target_lang_word": "get off",
                                "target_lang_sense_clarification": "to dismount from an animal or vehicle"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7dc94df5-a462-31b1-ab24-75407df8bb1f",
                    "sense_definition": "Выйти из транспортного средства.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "movement_down",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Пассажиры <w>слезли</w> с поезда на нужной станции.",
                            "target_lang_translations": {
                                "en": "The passengers <w>got off</w> the train at the required station."
                            }
                        },
                        {
                            "text": "Нам нужно <w>слезть</w> с автобуса на следующей остановке.",
                            "target_lang_translations": {
                                "en": "We need to <w>get off</w> the bus at the next stop."
                            }
                        }
                    ],
                    "synonyms": [
                        "выйти",
                        "сойти"
                    ],
                    "antonyms": [
                        "сесть"
                    ],
                    "common_phrases": [
                        "слезть с автобуса",
                        "слезть с поезда"
                    ],
                    "target_lang_definitions": {
                        "en": "To exit a vehicle or mode of transport."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "get off",
                                "target_lang_sense_clarification": "to leave a bus, train, or similar transport"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "73d54f0b-7502-37ec-bc5c-8bc29dd78835",
                    "sense_definition": "Отделиться от поверхности, отпасть или сойти (обычно о коже, краске или покрытии).",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "peeling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "После сильного загара кожа на плечах <w>слезла</w>.",
                            "target_lang_translations": {
                                "en": "After a bad sunburn, the skin on my shoulders <w>peeled off</w>."
                            }
                        },
                        {
                            "text": "Старая краска со стены <w>слезла</w> большими кусками.",
                            "target_lang_translations": {
                                "en": "The old paint <w>flaked off</w> the wall in large pieces."
                            }
                        }
                    ],
                    "synonyms": [
                        "отслоиться",
                        "облезть"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "разг."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To peel off, flake, or come away from a surface (usually skin, paint, or coating)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "peel off",
                                "target_lang_sense_clarification": "to come away in layers or strips"
                            },
                            {
                                "target_lang_word": "flake off",
                                "target_lang_sense_clarification": "to come off in small, thin pieces"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1030c112-37e8-3b6a-9e12-6fc0fe6de0fe",
                    "sense_definition": "Сместиться вниз из-за того, что предмет стал слишком свободным.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "movement_down",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Брюки стали велики и постоянно <w>слезали</w> с пояса.",
                            "target_lang_translations": {
                                "en": "The trousers became too big and kept <w>slipping down</w> from the waist."
                            }
                        },
                        {
                            "text": "Кольцо <w>слезло</w> с пальца, когда руки намокли.",
                            "target_lang_translations": {
                                "en": "The ring <w>slipped off</w> my finger when my hands got wet."
                            }
                        }
                    ],
                    "synonyms": [
                        "сползти"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "прост."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To slip down or slide off because an item is too loose."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "slip off",
                                "target_lang_sense_clarification": "to slide off unintentionally"
                            },
                            {
                                "target_lang_word": "slide down",
                                "target_lang_sense_clarification": "to move downward due to lack of friction or fit"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}