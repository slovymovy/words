                "senses": [
                    {
                        "sense_id": "4ae5c424-b604-3b37-8cc4-ca40482e0278",
                        "entry_id": "147a5c23-c114-320d-8c10-ce1f1898ff46",
                        "glosses": [
                            "Unité de convergence des lentilles ou autres systèmes optiques dont le symbole est δ, et se mesure en m⁻¹."
                        ],
                        "tags": [
                            "Optique"
                        ],
                        "examples": [
                            {
                                "example_id": "1316415a-adf1-4919-94b5-90b5f2f9182e",
                                "sense_id": "4ae5c424-b604-3b37-8cc4-ca40482e0278",
                                "text": "On évalue en dioptries le degré de myopie ou de presbytie."
                            },
                            {
                                "example_id": "41685f33-42a4-4fa4-a792-f19417496790",
                                "sense_id": "4ae5c424-b604-3b37-8cc4-ca40482e0278",
                                "text": "L’unité de convergence adoptée est la dioptrie qui correspond à celle d’une lentille ayant 1 m de distance focale."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a821eaa2-43ba-4515-9f02-679dfbabf226",
                        "source_entry_id": "147a5c23-c114-320d-8c10-ce1f1898ff46",
                        "source_sense_id": "4ae5c424-b604-3b37-8cc4-ca40482e0278",
                        "target_lang_word": "Dioptrie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dioptrie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "595cf17b-68c5-3132-8ac8-369789de2d14",
                                        "entry_id": "d84fbdb1-db16-3051-890e-e3822638e1b4",
                                        "glosses": [
                                            "Maßeinheit der Brechkraft"
                                        ],
                                        "tags": [
                                            "Optik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "23bccf5d-4580-4766-8493-6e80105df1ec",
                                                "sense_id": "595cf17b-68c5-3132-8ac8-369789de2d14",
                                                "text": "Meine Brillengläser haben nur wenige Dioptrien."
                                            },
                                            {
                                                "example_id": "e60118f0-cce7-4970-af57-51b15d996975",
                                                "sense_id": "595cf17b-68c5-3132-8ac8-369789de2d14",
                                                "text": "„Sie ist stark kurzsichtig und infolgedessen gezwungen, ständig eine Brille mit Gläsern von minus neun Dioptrien zu tragen, die sie in wasserhelles dünnes Horn fassen läßt, weil sie hofft, daß sie auf diese Weise am unauffälligsten wirkt.“"
                                            },
                                            {
                                                "example_id": "072616fe-a79d-4694-99de-817b59156124",
                                                "sense_id": "595cf17b-68c5-3132-8ac8-369789de2d14",
                                                "text": "„Sie trägt Kontaktlinsen, und auch wenn sie keinen Silberblick hat, sieht man doch, dass ihre Sehschwäche mit über fünf Dioptrien enorm ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
