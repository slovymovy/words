                        "glosses": [
                            "Expresses a demand to stop something; now, now, come on, hold on"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "eadc3205-9726-4224-b678-957ed1be8ba9",
                                "sense_id": "ced18c33-5672-336c-893c-df8558ad4f89",
                                "text": "По́лноте, не сто́ит их обижа́ть.",
                                "translation": "Now, now, there's no need to be demeaning to them.",
                                "english": "Now, now, there's no need to be demeaning to them."
                            }
                        ]
                    },
                    {
