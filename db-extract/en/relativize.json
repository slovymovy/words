                                        "glosses": [
                                            "Considérer de façon relative, ramener à ses justes proportions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f9a29a78-f345-4cfb-80e6-25a4424cad07",
                                                "sense_id": "3912a088-cd1a-3b71-a366-de93a7e657b6",
                                                "text": "L’effort de guerre de nos aïeux, lors de la Seconde Guerre, dura six ans. Penser à ce qu’ils ont vécu, aux horreurs de la Première Guerre aussi, nous permet – à certains égards – de relativiser nos malheurs."
                                            },
                                            {
                                                "example_id": "76624f94-8794-4135-a190-0196c43ad53e",
                                                "sense_id": "3912a088-cd1a-3b71-a366-de93a7e657b6",
                                                "text": "Ce chasseur rentré bredouille relativise son échec avec les conditions météorologiques passées."
                                            }
                                        ]
                                    },
