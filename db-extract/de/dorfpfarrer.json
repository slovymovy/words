                "senses": [
                    {
                        "sense_id": "55ab8090-7e6c-384c-a090-b9165f81c894",
                        "entry_id": "a75936dc-1cbb-3846-a03d-95cfd43cbae9",
                        "glosses": [
                            "Person, die in einer ländlichen Siedlung in der Kirche arbeitet und dort unter anderem die Gottesdienste leitet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "78af9c54-f974-45af-a1aa-6ad3179cfce5",
                                "sense_id": "55ab8090-7e6c-384c-a090-b9165f81c894",
                                "text": "„Nach dem feierlichen Hochamt und der Predigt des Dorfpfarrers, der gemäss Aufforderung der Regierung auf die Bedeutung des Staatsfeiertages in der gefahrvollen, die Existenz des Fürstentums bedrohenden Kriegszeit hinweist, lädt die Gemeinde auf ihre Kosten zu einem Umtrunk ein, den die Dorfvereine mit musikalischen Darbietungen umrahmen.“"
                            },
                            {
                                "example_id": "d89995bb-d636-4355-bc89-930ed647b7fb",
                                "sense_id": "55ab8090-7e6c-384c-a090-b9165f81c894",
                                "text": "„Als Bewohner einer Schülerpension gerät er zunehmend unter den Einfluss des zynischen, etwas älteren Teo, des ebenfalls dort einquartierten Sohnes des Dorfpfarrers.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
