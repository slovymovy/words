                "senses": [
                    {
                        "sense_id": "87848800-0911-3122-ae6d-c60204eeb62a",
                        "entry_id": "432d36ae-74d5-3a65-8741-edaa4dceb05c",
                        "glosses": [
                            "A relay used to control an electrical power circuit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "64fce66a-3877-4407-b909-de080aeb99a2",
                                "sense_id": "87848800-0911-3122-ae6d-c60204eeb62a",
                                "text": "Compressed air is used for the operation of certain contactors, the sanders, the horn, and the re-fuelling equipment, but vacuum brakes are fitted to the locomotive."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fd44368e-48c7-4d3f-87ac-292c8312b166",
                        "source_entry_id": "432d36ae-74d5-3a65-8741-edaa4dceb05c",
                        "source_sense_id": "87848800-0911-3122-ae6d-c60204eeb62a",
                        "source_sense_description": "relay used to control an electrical power circuit",
                        "target_lang_word": "Schütz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schütz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "23cfb557-b76a-3389-b845-858e73f8c81f",
                                        "entry_id": "724f4529-b8eb-3341-a58d-7f5c67900f2b",
                                        "glosses": [
                                            "bewegliche Platte in einem Wassergraben, die den Durchfluss reguliert"
                                        ],
                                        "tags": [
                                            "Wasserbau"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2d46e156-6083-47a5-ab49-e54aafb26103",
                                                "sense_id": "23cfb557-b76a-3389-b845-858e73f8c81f",
                                                "text": "„Robinson ließ den Zapfen des Schützes um drei Löcher steigen und blockierte ihn, indem er einen Stift in das vierte Loch steckte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "59964e13-4611-36d9-ac18-cb2bb6065207",
                                        "entry_id": "724f4529-b8eb-3341-a58d-7f5c67900f2b",
                                        "glosses": [
                                            "elektromagnetischer Schalter für hohe Lastströme (vergleiche Relais)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28ffd2dd-c2bd-4787-910e-524b4e3adec0",
                                                "sense_id": "59964e13-4611-36d9-ac18-cb2bb6065207",
                                                "text": "Fließt ein Steuerstrom durch die Magnetspule eines elektromechanischen Schützes, zieht das Magnetfeld die mechanischen Kontakte in den aktiven Zustand."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Schütz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "97d782de-4739-3110-bd75-efa52f28e9fc",
                                        "entry_id": "a3c74edd-8b1c-3636-9920-b720aae2fc4a",
                                        "glosses": [
                                            "Schütze"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0dde7a6d-987c-4023-a0c8-10f775cbbf3a",
                                                "sense_id": "97d782de-4739-3110-bd75-efa52f28e9fc",
                                                "text": "„Ein solcher Schütz kann sich aufgeben lassen, was er schießen soll, Hirsch, Reh oder Hasen, und braucht dann nur aufs Geratewohl die Flinte zum Fenster hinaus abzudrücken, so muß das Wild fallen.“"
                                            },
                                            {
                                                "example_id": "99cc1388-9ef0-4c0b-852f-724191281b65",
                                                "sense_id": "97d782de-4739-3110-bd75-efa52f28e9fc",
                                                "text": "„Mit so etwas läßt sonst nicht jedes Gespenst sich schrecken, denn wenn man auch schießen will, so geht's nicht los, oder die Kugel fährt zurück und trifft nicht den Geist, sondern den Schütz.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Schütz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fc62ca48-5e7a-3919-bb1c-ad5d440854d3",
                                        "entry_id": "6c757b5c-4549-3b5a-9fa6-47b7cc5838cb",
                                        "glosses": [
                                            "deutschsprachiger Familienname, Nachname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f555677-cf56-401f-81ec-39d78305617e",
                                                "sense_id": "fc62ca48-5e7a-3919-bb1c-ad5d440854d3",
                                                "text": "Schützens kamen, sahen und siegten."
                                            },
                                            {
                                                "example_id": "9b8094f5-8237-44fa-832c-5999dbda9c49",
                                                "sense_id": "fc62ca48-5e7a-3919-bb1c-ad5d440854d3",
                                                "text": "Frau Schütz ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "5731b3aa-20fd-4594-86d9-f07c6dd6ed09",
                                                "sense_id": "fc62ca48-5e7a-3919-bb1c-ad5d440854d3",
                                                "text": "Herr Schütz wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "dfeef14d-ccfa-49a8-86f4-b6078986263b",
                                                "sense_id": "fc62ca48-5e7a-3919-bb1c-ad5d440854d3",
                                                "text": "Die Schütz fliegen heute nach Paris."
                                            },
                                            {
                                                "example_id": "67a9d105-391b-4ad5-a581-2c9ccc9e6465",
                                                "sense_id": "fc62ca48-5e7a-3919-bb1c-ad5d440854d3",
                                                "text": "Der Schütz trägt nie die Pullover, die die Schütz ihm strickt."
                                            },
                                            {
                                                "example_id": "23d9c674-5a3a-4c03-b778-ae3379abdc3d",
                                                "sense_id": "fc62ca48-5e7a-3919-bb1c-ad5d440854d3",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Schütz kommt, geht der Herr Schütz.“"
                                            },
                                            {
                                                "example_id": "d4ac6a68-e0fc-49c9-91de-b4bd04726213",
                                                "sense_id": "fc62ca48-5e7a-3919-bb1c-ad5d440854d3",
                                                "text": "Schütz kommt und geht."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
