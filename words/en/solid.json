                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "favor",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Could you do me a <w>solid</w> and pick up some milk on your way home?",
                            "target_lang_translations": {
                                "ru": "Не мог бы ты сделать мне <w>одолжение</w> и купить молока по дороге домой?",
                                "tr": "Eve gelirken bana bir <w>kıyak</w> yapıp biraz süt alabilir misin?"
                            }
                        },
                        {
                            "text": "I owe him a <w>solid</w> because he helped me move last weekend.",
                            "target_lang_translations": {
