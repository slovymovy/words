                        "glosses": [
                            "Pinus mugo Turra, gatunek drzewa lub krzewu iglastego należący do rodziny sosnowatych, rosnący w górach, powyżej górnej granicy lasu"
                        ],
                        "tags": [
                            "syst."
                        ],
                        "examples": [
                            {
                                "example_id": "0609b318-f635-4041-a396-e0130936152d",
                                "sense_id": "13b2a5a7-f036-38bc-b8ff-b004d9898f07",
                                "text": "Do lat 90. XX wieku reliktowe stanowisko kosodrzewiny znajdowało się w Beskidzie Niskim"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "17ad304c-6af5-301a-b85f-480ac97891e4",
                        "entry_id": "f6f96b90-b8f0-3a63-bf6c-1f8bef8dc663",
                        "glosses": [
                            "krzew z gatunku kosodrzewin (1.1)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8a7c90c-4c81-47c6-a3b3-6e62aaa9910b",
                                "sense_id": "17ad304c-6af5-301a-b85f-480ac97891e4",
                                "text": "Wysyp tę korę wokół kosodrzewiny przy płocie."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "6462c668-3865-3691-aadc-1f179dffdd0a",
                        "entry_id": "f6f96b90-b8f0-3a63-bf6c-1f8bef8dc663",
                        "glosses": [
                            "zarośla kosodrzewiny (1.1) występujące w górach powyżej górnej granicy lasu"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e45197f-6a4b-4644-88e5-eb1c5f0fb9fe",
                                "sense_id": "6462c668-3865-3691-aadc-1f179dffdd0a",
