                                                "example_id": "499542e3-c74c-4c50-9553-6c9cee875e4d",
                                                "sense_id": "1c016c61-1752-3daa-8de6-983f73851c22",
                                                "text": "„Die Paradoxie des Rauchens ist, dass man es mit Freiheit und Abenteuer gleichsetzt, obwohl Sucht das exakte Gegenteil davon ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f67f7ba8-646c-364b-ab91-ee587e11c597",
