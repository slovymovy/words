                    "common_phrases": [
                        "tree a boot",
                        "treed shoes"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вставлять распорки в обувь для сохранения её формы."
                    },
                    "translations": {
                        "ru": [
                            {
