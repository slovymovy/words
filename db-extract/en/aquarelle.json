                                        "entry_id": "1e4677a9-bbb9-369a-8e32-66a0cc1f01c0",
                                        "glosses": [
                                            "ein mit wasserlöslichen, nicht deckenden Farben angefertigtes Bild"
                                        ],
                                        "tags": [
                                            "Bildende Kunst"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "323befe6-2189-4739-aba3-7fd6f31bbca4",
                                                "sense_id": "584ae16d-06c2-3c1d-8195-7b83194b7c2c",
                                                "text": "Ich liebe besonders Aquarelle von Landschaften."
                                            },
                                            {
                                                "example_id": "fc90b79f-0fb5-41e4-a7a5-d5c46028276a",
                                                "sense_id": "584ae16d-06c2-3c1d-8195-7b83194b7c2c",
                                                "text": "„Was bei der Mutter ein beinahe zartes Aquarell ergibt, wird beim Sohn zur monumentalen Klage über den Niedergang einer Industriestadt.“"
                                            },
                                            {
                                                "example_id": "70e394ad-5715-4490-9f14-a3bf9bf3c989",
                                                "sense_id": "584ae16d-06c2-3c1d-8195-7b83194b7c2c",
                                                "text": "„Er nahm die beiden Zeichnungen von der Staffelei und holte aus dem Nebenraum zwei Aquarelle.“"
                                            },
                                            {
                                                "example_id": "43f57405-e909-44f9-b78d-eebd0a8caedb",
                                                "sense_id": "584ae16d-06c2-3c1d-8195-7b83194b7c2c",
                                                "text": "„Bestimmt sieht nicht jeder die Qual, die ich in diesen verrückten Aquarellen dargestellt habe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
