                "senses": [
                    {
                        "sense_id": "05f3cadf-6a3b-3ce3-9473-3a15d7a48e6e",
                        "entry_id": "05c582ed-6a45-30ad-85e8-d65c6f85f9ac",
                        "glosses": [
                            "To flow back again; to flow once more."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "8b991807-002a-4f85-bc40-76fbe70896c8",
                                "sense_id": "05f3cadf-6a3b-3ce3-9473-3a15d7a48e6e",
                                "text": "The sea flows and reflows."
                            },
                            {
                                "example_id": "9da77005-0a86-4fb4-8340-96e763113394",
                                "sense_id": "05f3cadf-6a3b-3ce3-9473-3a15d7a48e6e",
                                "text": "Such an act, you may conceive, had its due weight upon my feelings; but, alas! though it reminded me of the loss I had sustained, and caused my tears to reflow, the remains of my departed husband were not there,—they were left upon a foreign shore."
                            }
                        ]
                    },
                    {
                        "sense_id": "c7945be0-375b-38e8-9ca7-fbb7ecad8024",
                        "entry_id": "05c582ed-6a45-30ad-85e8-d65c6f85f9ac",
                        "glosses": [
                            "To cause to flow again, to remelt."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "ac8c0275-784b-4ef8-816a-c304afb4f01b",
                                "sense_id": "c7945be0-375b-38e8-9ca7-fbb7ecad8024",
                                "text": "Reflowing solder is a common form of rework in the manufacture of printed circuit boards: you heat up the solder and it flows where it should have flowed the first time."
                            }
                        ]
                    },
                    {
                        "sense_id": "f9d12b18-f313-3ad8-a520-ba9cb2757e9c",
                        "entry_id": "05c582ed-6a45-30ad-85e8-d65c6f85f9ac",
                        "glosses": [
                            "To modify the layout of text around other objects in a document."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "977879ca-0821-4370-a3a1-668908a6c212",
                                "sense_id": "f9d12b18-f313-3ad8-a520-ba9cb2757e9c",
                                "text": "The latter option will reflow text to even out the spacing within each paragraph."
                            }
                        ]
