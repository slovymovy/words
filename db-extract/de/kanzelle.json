                "senses": [
                    {
                        "sense_id": "3a8e2a43-6ba9-38e9-9b3b-32ec7e8791fd",
                        "entry_id": "97b01451-ed79-3659-afda-e3a616e208f6",
                        "glosses": [
                            "Bauteil in Harmonium und Mundharmonika"
                        ],
                        "tags": [
                            "Musikinstrument"
                        ],
                        "examples": [
                            {
                                "example_id": "8a0728bf-9bf4-488b-91e8-b0cd93a69d98",
                                "sense_id": "3a8e2a43-6ba9-38e9-9b3b-32ec7e8791fd",
                                "text": "„Durch Blasen und Ziehen kannst du pro Kanzelle zwei unterschiedliche Töne erzeugen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "cf5c32fc-21a0-3314-ac7f-49611a943c21",
                        "entry_id": "97b01451-ed79-3659-afda-e3a616e208f6",
                        "glosses": [
                            "Bauteil der Windlade, in dem der Wind in Richtung Orgelpfeife verteilt wird"
                        ],
                        "tags": [
                            "Orgelbau"
                        ],
                        "examples": [
                            {
                                "example_id": "935244b5-cffd-4562-8ba2-17edefaf5e81",
                                "sense_id": "cf5c32fc-21a0-3314-ac7f-49611a943c21",
                                "text": "„Ist der Klavis für Manualkoppel nicht gedrückt, so ist die Kanzelle a mit Orgelwind angefüllt. Dieser drückt die Membrane b gegen die Offnung c und schließt dieselbe.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "541afcd2-1284-395c-9d4f-0a2254e7be8d",
                        "entry_id": "97b01451-ed79-3659-afda-e3a616e208f6",
                        "glosses": [
                            "Chorschranke, in alten Kirchen eine Mauer im Mittelschiff, welche den Unterchor vom übrigen Raum trennt, später auch als trennendes Gitter/Chorgitter"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "8070ba1b-4d97-4e9a-a8f7-73aebfa3c7d7",
                                "sense_id": "541afcd2-1284-395c-9d4f-0a2254e7be8d",
                                "text": "„Dieser Theil liegt meistens etwas höher als das Schiff und ist durch eine Kanzelle d. i. ein hölzernes oder eisernes Gitter vom Schiffe abgesondert.“ (1842)"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
