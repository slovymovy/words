                "senses": [
                    {
                        "sense_id": "641a043e-c1e0-3984-a095-d04bf9181e4a",
                        "entry_id": "df3d0b2c-b206-3c84-9816-24713f83ada3",
                        "glosses": [
                            "dünne durchsichtige Folie, mit der ein zu schützendes Nahrungsmittel abgedeckt wird"
                        ],
                        "tags": [
                            "Küchenzubehör"
                        ],
                        "examples": [
                            {
                                "example_id": "9d5cc567-42ba-4356-bab6-aa63fd31e536",
                                "sense_id": "641a043e-c1e0-3984-a095-d04bf9181e4a",
                                "text": "[Sie können] „angebrochene Früchte am besten in etwas Klarsichtfolie einwickeln und im Kühlschrank lagern.“"
                            },
                            {
                                "example_id": "f26ef374-d017-4765-9d4f-04f2e0e60fea",
                                "sense_id": "641a043e-c1e0-3984-a095-d04bf9181e4a",
                                "text": "„Danach sollte er [Anmerkung: ein Pastateig] mindestens eine halbe Stunde in Klarsichtfolie gewickelt im Kühlschrank ruhen.“"
                            },
                            {
                                "example_id": "10c49840-2a03-4ece-a67b-2e0598d37a2c",
                                "sense_id": "641a043e-c1e0-3984-a095-d04bf9181e4a",
                                "text": "[Niagarafälle:] „Kameras und Brillen aller Art werden klatschnass, eine Form von Klarsichtfolie als Objektivschutz sollte man mitnehmen.“"
                            },
                            {
                                "example_id": "14be3f58-ae79-4665-aa87-a910b2b32acc",
                                "sense_id": "641a043e-c1e0-3984-a095-d04bf9181e4a",
                                "text": "[Ingwer vorziehen:] „Die erste Zeit kann man den Topf mit Klarsichtfolie bedecken, damit ein feucht-warmes Klima entsteht.“"
                            },
                            {
                                "example_id": "5a27d1f7-9f63-4a72-8722-e4fd607d4683",
                                "sense_id": "641a043e-c1e0-3984-a095-d04bf9181e4a",
                                "text": "[Pflanzen vorziehen:] „Der Standort sollte so gewählt werden, dass die Pflanze ausreichend Sonne genießen kann. Unterstützend wirkt auch eine Klarsichtfolie oder eine Glasplatte, die über den Behälter gespannt oder gelegt wird.“"
                            },
                            {
                                "example_id": "2f9a82f9-c6fc-4170-a75a-38e19c278d78",
                                "sense_id": "641a043e-c1e0-3984-a095-d04bf9181e4a",
                                "text": "„Decken Sie die Gefäße nach der Saat mit Klarsichtfolie oder Kunststoffhauben ab, um ein feuchtes Klima zu schaffen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
