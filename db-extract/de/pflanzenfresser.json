                    {
                        "form_id": "9c5c943c-b93a-4c37-8612-6e0d59a1f386",
                        "entry_id": "b1712dcd-04cc-32ef-a38a-e0527e0526a2",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Pflanzenfresser"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1f3688ac-7781-3677-a2a2-af826be38115",
                        "entry_id": "b1712dcd-04cc-32ef-a38a-e0527e0526a2",
                        "glosses": [
                            "Tier, das ausschließlich, hauptsächlich oder teilweise aus pflanzlichen Organismen seine Nahrung bezieht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c5eaa70-edf9-4e2f-98ce-350a477adfc2",
                                "sense_id": "1f3688ac-7781-3677-a2a2-af826be38115",
                                "text": "Fleischfresser haben ein anderes Gebiss als Pflanzenfresser."
                            },
                            {
                                "example_id": "7b5663d3-cf85-4ebf-b58a-72fb90196a88",
                                "sense_id": "1f3688ac-7781-3677-a2a2-af826be38115",
                                "text": "Der Mensch ist nicht nur Pflanzenfresser, sondern ein Allesfresser, vermutlich weil seine Ahnen Aasfresser waren."
                            },
                            {
                                "example_id": "4477db52-7de9-4e44-b695-6228ae6174f1",
                                "sense_id": "1f3688ac-7781-3677-a2a2-af826be38115",
                                "text": "„Der Ankylosaurier war ein großer, gepanzerter Pflanzenfresser, der während der Kreidezeit lebte.“"
                            },
                            {
                                "example_id": "1ad081de-0752-4b0e-a324-955e77ac3cf0",
                                "sense_id": "1f3688ac-7781-3677-a2a2-af826be38115",
                                "text": "Das Kaninchen ist ein Pflanzenfresser."
                            },
                            {
                                "example_id": "46af2ff2-af49-4329-a54b-be7efa8f4a37",
                                "sense_id": "1f3688ac-7781-3677-a2a2-af826be38115",
                                "text": "„Der Pflanzenfresser beugte den vorderen Teil seines gedrungenen Körpers zum Boden und wölbte den Rücken, sodass die kurzen, dicken Hörner, die seine Haut bedeckten, bedrohlich bevorstanden und die Stacheln um seinen Hals herum wie Lanzen aufragten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "643f8105-834c-48b8-9059-c2b8ea69f075",
                        "source_entry_id": "b1712dcd-04cc-32ef-a38a-e0527e0526a2",
                        "source_sense_id": "1f3688ac-7781-3677-a2a2-af826be38115",
                        "target_lang_word": "herbivore",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "herbivore",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9721be0a-8574-3801-9811-40cc73e76d40",
                                        "entry_id": "0011d00c-6b63-32d4-b7f8-78e2091a56c2",
                                        "glosses": [
                                            "An organism that feeds chiefly on plants; an animal that feeds on herbage or vegetation as the main part of its diet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7c70af3-3358-4e95-8ded-924a0af74401",
                                                "sense_id": "9721be0a-8574-3801-9811-40cc73e76d40",
                                                "text": "It is unlikely that any member of the hominin clade was either an obligate herbivore or an obligate carnivore"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a782a964-7cbe-47be-9e8e-2a60f6d0ebf2",
                        "source_entry_id": "b1712dcd-04cc-32ef-a38a-e0527e0526a2",
                        "source_sense_id": "1f3688ac-7781-3677-a2a2-af826be38115",
                        "target_lang_word": "herbivore",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "herbivore",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "168f0abf-9387-309c-81a1-0ff77bc067af",
                                        "entry_id": "d868937f-1870-33c7-9a63-7f87fc81ac55",
                                        "glosses": [
                                            "Qui se nourrit d'herbe, principalement."
                                        ],
                                        "tags": [
                                            "Élevage"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee140c69-f654-4e7a-aa36-993e4a723f2f",
                                                "sense_id": "168f0abf-9387-309c-81a1-0ff77bc067af",
                                                "text": "Le ragondin présente un régime alimentaire herbivore. C'est un rongeur polyphage qui s'attaque aux bulbes et aux racines des plantes aquatiques en particulier les roseaux. Il aime aussi potamots et laîches, scirpes, trèfles, lentilles d'eau, nénuphars et cultures […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d1180c95-233a-3f3b-9fea-6aed0bc04bd7",
                                        "entry_id": "d868937f-1870-33c7-9a63-7f87fc81ac55",
                                        "glosses": [
                                            "Qui se nourrit de substances végétales."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "919e24dc-e5a3-4366-bf57-f72f1ad306fe",
                                                "sense_id": "d1180c95-233a-3f3b-9fea-6aed0bc04bd7",
                                                "text": "Introduire des herbivores dans les champs peut aussi être une solution. Par exemple, une piste qui est actuellement expérimentée par le CIRAD dans des bananeraies de Guadeloupe est d’utiliser des moutons pour gérer l’enherbement."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "herbivore",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "540f90d1-61cd-31a8-81f3-71355f175ce6",
                                        "entry_id": "1f7c2f3a-27a7-3ede-b1d1-604444f887c8",
                                        "glosses": [
                                            "Animal herbivore."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "75a945e5-0453-4f2d-a07f-0687bc9ce831",
                                                "sense_id": "540f90d1-61cd-31a8-81f3-71355f175ce6",
                                                "text": "Alors qu’un herbivore va détruire une plante, au moins en partie, pour la manger, l’abeille vit en harmonie avec elle."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f4b756ae-56fe-46c1-a9e9-4e5db26519a9",
                        "source_entry_id": "b1712dcd-04cc-32ef-a38a-e0527e0526a2",
                        "source_sense_id": "1f3688ac-7781-3677-a2a2-af826be38115",
