                    {
                        "sense_id": "528d44e2-c945-3027-be52-10894f15df7f",
                        "entry_id": "65dc3bab-0e56-35fd-a0dc-72cf82993a02",
                        "glosses": [
                            "persoonlijk *om+het, *om+ze: om de reden,"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "06c5a0cb-6e4e-4c96-b133-be9b8e544534",
                                "sense_id": "528d44e2-c945-3027-be52-10894f15df7f",
                                "text": "Hij heeft het erom gedaan."
                            },
                            {
                                "example_id": "3014bda0-9c64-4449-9ed3-858391223548",
                                "sense_id": "528d44e2-c945-3027-be52-10894f15df7f",
                                "text": "Hij probeerde een 1 aprilgrap uit te halen, maar niemand moest erom lachen."
                            },
                            {
                                "example_id": "872e75c5-078a-48df-b1e6-f140daf1fbf4",
                                "sense_id": "528d44e2-c945-3027-be52-10894f15df7f",
                                "text": "Het gaat erom dat „bekende overlastgevers” binnen blijven, aldus Dijkhoff. Hij heeft hierover maandag met burgemeesters gesproken, zei hij in het radioprogramma Dit is de Dag."
                            },
                            {
                                "example_id": "093cce5d-ce64-4143-8369-a61580038f9d",
                                "sense_id": "528d44e2-c945-3027-be52-10894f15df7f",
                                "text": "‘Denk erom hè… Geen haast,’ riep hij me na terwijl ik naar de grensmuur liep om mijn hand op het koude ijzer te leggen en mezelf moed in te praten: ‘veilig thuiskomen’."
                            }
                        ]
                    }
