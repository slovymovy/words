                "senses": [
                    {
                        "sense_id": "436082d2-6782-3c00-a020-d76c09e669c9",
                        "entry_id": "e4514040-e061-324e-b646-f0105b274df4",
                        "glosses": [
                            "Methode zur Steigerung der Gedächtnisleistung durch Merkhilfen wie Eselsbrücken, Merksprüche und so weiter"
                        ],
                        "tags": [
                            "jargon"
                        ],
                        "examples": [
                            {
                                "example_id": "87eab408-b567-42d2-bde6-abb0e9e233fc",
                                "sense_id": "436082d2-6782-3c00-a020-d76c09e669c9",
                                "text": "„Um das Jahr 350 v. d. Z. befassten sich sowohl Platon als auch Aristoteles mit Mnemonik, wobei Aristoteles an einem vollständigen Analysesystem arbeitete.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
