                ],
                "senses": [
                    {
                        "sense_id": "86c02e2e-8bb0-3ee6-a0cb-31dd660d0eae",
                        "entry_id": "6e0690bf-db97-31cf-84f7-d66211b1405b",
                        "glosses": [
                            "oberster königlicher Beamter in Polen, der als Vertreter des Königs das Heer anführte und Recht sprach"
                        ],
                        "tags": [
                            "historisch (bis ins 14. Jahrhundert)"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "400d3cce-ab72-3ac3-bc8c-e80ef60f11d7",
                        "entry_id": "6e0690bf-db97-31cf-84f7-d66211b1405b",
                        "glosses": [
                            "ranghöchster Territorialbeamter in Polen, der Mitglied des Senats war"
                        ],
                        "tags": [
                            "historisch (14.–18. Jahrhundert)"
                        ],
                        "examples": [
                            {
                                "example_id": "155e953d-0154-415c-9177-2b41c56851c0",
                                "sense_id": "400d3cce-ab72-3ac3-bc8c-e80ef60f11d7",
                                "text": "„Diese Aufmachung trieb den alten Woiwoden die Tränen in die Augen; aber sie mußten die Pille schlucken, denn unter der russischen Zwangsherrschaft war ihnen nur noch die Fähigkeit des Denkens geblieben.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "00549b6d-2b4c-35c7-a698-965fbf021d7b",
                        "entry_id": "6e0690bf-db97-31cf-84f7-d66211b1405b",
                        "glosses": [
                            "oberster Beamter einer polnischen Provinz (Woiwodschaft)"
                        ],
                        "tags": [
                            "Verwaltung",
                            "Politik (seit dem 20. Jahrhundert)"
                        ],
                        "examples": [],
                        "sense_index_json": "\"3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "921d96b0-69ba-4d95-be31-f3adfe8ef4a6",
                        "source_entry_id": "6e0690bf-db97-31cf-84f7-d66211b1405b",
                        "source_sense_id": "86c02e2e-8bb0-3ee6-a0cb-31dd660d0eae",
                        "target_lang_word": "voïvode",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "voïvode",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6902594c-fe47-30d3-8603-2509d441f3f4",
                                        "entry_id": "82554994-91d0-3380-b5bb-117f41e82e7c",
                                        "glosses": [
                                            "Chef militaire dans certaines régions d’Europe centrale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a5f1a1f-97e7-44e0-b47a-bd2329175cd3",
                                                "sense_id": "6902594c-fe47-30d3-8603-2509d441f3f4",
                                                "text": "Ceux de Werst forment une sorte de petit clan, sous l’autorité d’un voïvode, avec leurs cabanes, leurs « barakas » à toit pointu, leurs légions d’enfants, bien différents par les mœurs et la régularité de leur existence de ceux de leurs congénères qui errent à travers l’Europe."
                                            },
                                            {
                                                "example_id": "3e50735a-3d08-4a8f-9e75-56bee4c44401",
                                                "sense_id": "6902594c-fe47-30d3-8603-2509d441f3f4",
                                                "text": "La plus récente causerie de Wambery portait sur l’existence d’un tyran walachien, le Voïvode Drakula (ou Vlad Drakul), réputé buveur de sang humain."
                                            },
                                            {
                                                "example_id": "dde1e237-917e-4a9d-82a6-148169a95130",
                                                "sense_id": "6902594c-fe47-30d3-8603-2509d441f3f4",
                                                "text": "Le vaïvode lui-même, Adam Kissel, malgré la protection dont il honorait l’académie, défendait qu’on menât les étudiants dans le monde, et voulait qu’on les traitât sévèrement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a16bd09-73fd-3004-ab6d-676f32f22daa",
                                        "entry_id": "82554994-91d0-3380-b5bb-117f41e82e7c",
                                        "glosses": [
                                            "Prince de Valachie ou de Moldavie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee3ee51f-c2bf-4c1e-a249-8b2da6172f7f",
                                                "sense_id": "4a16bd09-73fd-3004-ab6d-676f32f22daa",
                                                "text": "Myrcea, le voïvode, prince de Malachie, dit Ureche, ayant eu vent des troubles dont la Moldavie était le théâtre, crût pouvoir essayer d’accaparer le pays pour qu’il soit sous son obéissance, espérant s’en emparer facilement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1cc5c4ec-5a98-371b-9fb3-022bdb7ca90c",
                                        "entry_id": "82554994-91d0-3380-b5bb-117f41e82e7c",
                                        "glosses": [
                                            "Titre slave adopté par les Turcs et devenu synonyme de gouverneur civil de province ou de district, recevant la dîme et les impôts."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20ae1ddc-8a6c-4ee4-8e97-da3fe155421d",
                                                "sense_id": "1cc5c4ec-5a98-371b-9fb3-022bdb7ca90c",
                                                "text": "Le cadi en présence du voïvode, de l’ayan et des Turcs les plus notables qui portait témoignage de la volonté des proëtos, délivrait le certificat demandé, et le tout était envoyé à la rectification du pacha."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bea336e3-3184-322a-8f20-81e2785f1af1",
                                        "entry_id": "82554994-91d0-3380-b5bb-117f41e82e7c",
                                        "glosses": [
                                            "(moderne) Représentant du gouvernement polonais dans chaque voïvodie (région administrative)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7ec01a0-c7f2-48cc-a443-42c377d809ec",
                                                "sense_id": "bea336e3-3184-322a-8f20-81e2785f1af1",
                                                "text": "Jerzy Miller, naguère ministre de l’Intérieur, reprend le poste de voïvode de Petite-Pologne qu’il occupait avant sa nomination au gouvernement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "611690d7-ee62-4b3d-8333-bd4024e524e6",
