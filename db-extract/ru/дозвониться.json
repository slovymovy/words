                    }
                ],
                "senses": [
                    {
                        "sense_id": "2db01d08-467a-357e-83df-de46bb4fe7e0",
                        "entry_id": "39bba477-78a6-3f3d-a17a-42f363b27fbf",
                        "glosses": [
                            "связаться с кем-либо, чем-либо по телефону (часто — не с первого раза, после неудачных попыток)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ff5e69a-793f-452d-ba00-ecfcf38398b6",
                                "sense_id": "2db01d08-467a-357e-83df-de46bb4fe7e0",
                                "text": "Саша завладел телефоном и дозвонился до своего источника в ГУВД."
                            }
                        ]
                    },
                    {
                        "sense_id": "1ac791ae-9a6d-3af6-983d-9e8bbff78ca5",
                        "entry_id": "39bba477-78a6-3f3d-a17a-42f363b27fbf",
                        "glosses": [
                            "устар. звоня, добиться какого-либо результата"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "418d701d-b76c-4a20-b6dd-702a6dead4c0",
                                "sense_id": "1ac791ae-9a6d-3af6-983d-9e8bbff78ca5",
                                "text": "Однажды, возвратясь домой из суда, он не мог дозвониться у своего подъезда, чтобы ему отворили."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ae6fc151-c2f3-4e58-b98e-1c158e09006e",
                        "source_entry_id": "39bba477-78a6-3f3d-a17a-42f363b27fbf",
                        "target_lang_word": "get through",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "get through",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bde44ae6-e064-3b12-ba7a-249ba45dc083",
                                        "entry_id": "33a067b0-fd12-3302-8933-7332ce452344",
                                        "glosses": [
                                            "To overcome; to endure."
                                        ],
                                        "tags": [
                                            "informal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "10c46e6d-b35a-4554-b2d2-743fcc6c3010",
                                                "sense_id": "bde44ae6-e064-3b12-ba7a-249ba45dc083",
                                                "text": "Military training was hard, but I got through it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "faeeddaf-9581-3db4-9a83-3bc97d68d8c2",
                                        "entry_id": "33a067b0-fd12-3302-8933-7332ce452344",
                                        "glosses": [
                                            "To complete; to finish."
                                        ],
                                        "tags": [
                                            "informal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a18b5a76-c952-4fcc-ba39-9255c1c65cda",
                                                "sense_id": "faeeddaf-9581-3db4-9a83-3bc97d68d8c2",
                                                "text": "She got through her book this morning!"
                                            },
                                            {
                                                "example_id": "ca8b0d28-2624-476f-8ad3-588dfd16bd36",
                                                "sense_id": "faeeddaf-9581-3db4-9a83-3bc97d68d8c2",
                                                "text": "I was so thirsty that I got through three glasses of orange juice."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "193803cd-e313-30de-a0fc-0e7fa926c4ec",
                                        "entry_id": "33a067b0-fd12-3302-8933-7332ce452344",
                                        "glosses": [
                                            "To use up; to expend."
                                        ],
                                        "tags": [
                                            "informal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d8cef5db-d36c-4f3c-9ae1-47c78ed0d316",
                                                "sense_id": "193803cd-e313-30de-a0fc-0e7fa926c4ec",
                                                "text": "Near-synonyms: burn through, run through"
                                            },
                                            {
                                                "example_id": "017bb3e1-427a-4b6a-a9c3-2a8c34c5e5a7",
                                                "sense_id": "193803cd-e313-30de-a0fc-0e7fa926c4ec",
                                                "text": "With near-daily trips to Houston and back, he really gets through a lot of fuel in one month."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4abb4ab6-4262-3dcb-862f-1ac8943f356d",
                                        "entry_id": "33a067b0-fd12-3302-8933-7332ce452344",
                                        "glosses": [
                                            "To communicate successfully across a barrier; to make contact, or get one's point across; to reach the addressee with difficulty."
                                        ],
                                        "tags": [
                                            "informal",
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b535e53b-445e-4eab-b662-de26cdfd45fc",
                                                "sense_id": "4abb4ab6-4262-3dcb-862f-1ac8943f356d",
                                                "text": "Near-synonym: get across"
                                            },
                                            {
                                                "example_id": "ae4b70e8-1980-4212-a567-d72719ff3bf4",
                                                "sense_id": "4abb4ab6-4262-3dcb-862f-1ac8943f356d",
                                                "text": "He was such a dyed-in-the-wool partisan that I just couldn't get through to him and change his mind."
                                            },
                                            {
                                                "example_id": "82712a12-9a44-41fa-a1bc-756226bab2da",
                                                "sense_id": "4abb4ab6-4262-3dcb-862f-1ac8943f356d",
                                                "text": "He was such a dyed-in-the-wool partisan that I just couldn't get it through his skull."
                                            },
                                            {
                                                "example_id": "84cb85c7-f866-4cb0-9522-c9b9696976d9",
                                                "sense_id": "4abb4ab6-4262-3dcb-862f-1ac8943f356d",
                                                "text": "The call wouldn't get through no matter how many times I tried."
                                            },
                                            {
                                                "example_id": "7e5ce431-37ce-489f-8e61-d2db89c050ab",
                                                "sense_id": "4abb4ab6-4262-3dcb-862f-1ac8943f356d",
                                                "text": "My father had a horror of girls' schools (and if he could “get through”—to use the orthodox expression of the spookists—he would find all his opinions on this subject more than justified by the manners, morals and learning of the young ladies of the present day) […]"
                                            },
                                            {
                                                "example_id": "f4606e18-8db7-4f7b-b216-d524d6d53ce8",
                                                "sense_id": "4abb4ab6-4262-3dcb-862f-1ac8943f356d",
                                                "text": "And YOU have meddled with the primal forces of nature, and YOU… WILL… ATONE! Am I getting through to you, Mr. Beale?"
                                            },
                                            {
                                                "example_id": "d45904d5-1bad-42b3-b94b-f1a5d4a6b95b",
                                                "sense_id": "4abb4ab6-4262-3dcb-862f-1ac8943f356d",
                                                "text": "What'll it take to get it through to you precious?\nI'm over this, why do you wanna throw it away like this?\nSuch a mess, why would I want to watch you?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3df23e6f-2b41-44d8-b390-6d139d8a2b0d",
                        "source_entry_id": "39bba477-78a6-3f3d-a17a-42f363b27fbf",
                        "target_lang_word": "Anschluß bekommen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    }
                ],
                "word_linkages": []
            }
        ],
