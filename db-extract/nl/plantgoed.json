                "entry_id": "0e7f6304-8be3-3e7e-9f7d-cd52da193ee6",
                "word": "plantgoed",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "26ecb23d-0e20-38a6-b321-61e108431174",
                        "entry_id": "0e7f6304-8be3-3e7e-9f7d-cd52da193ee6",
                        "glosses": [
                            "kleine gekweekte planten die men later op de definitieve, gewenste plaats in de grond kan stoppen om verder te laten groeien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f530be20-a8f6-4765-9808-5a114dc63fa4",
                                "sense_id": "26ecb23d-0e20-38a6-b321-61e108431174",
                                "text": "Op twee platte wagens liggen zesduizend kleinere en grotere planten te wachten op bezorging. En dat is nog maar de helft van het totale plantgoed."
                            },
                            {
                                "example_id": "5ef76be1-1730-492d-93b7-62184982d102",
                                "sense_id": "26ecb23d-0e20-38a6-b321-61e108431174",
                                "text": "Wanneer de gemeente nog plantgoed heeft, kunnen bewoners daar eventueel gebruik van maken. Nieuw plantgoed moeten de burgers zelf kopen, anders zou de bezuiniging van de gemeente (deels) ongedaan worden gemaakt."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f016b53b-a3ac-42dd-8876-ddda7d93abff",
                        "source_entry_id": "0e7f6304-8be3-3e7e-9f7d-cd52da193ee6",
                        "source_sense_id": "26ecb23d-0e20-38a6-b321-61e108431174",
                        "source_sense_description": "kleine gekweekte planten",
                        "target_lang_word": "transplant",
