                ],
                "senses": [
                    {
                        "sense_id": "d52f71ba-3226-3b84-8e3d-747de14ba8b1",
                        "entry_id": "9f97736b-9ab4-3d5a-beba-9b9a58d5c912",
                        "glosses": [
                            "mit der Nase wahrgenommene Eigenschaft, die von Jod herrührt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9d50cc6-2417-432f-a070-91fb8adecfed",
                                "sense_id": "d52f71ba-3226-3b84-8e3d-747de14ba8b1",
                                "text": "„Jodgeruch liegt in der Luft.“"
                            },
                            {
                                "example_id": "f266e03e-95b3-418e-8824-4f3ab2757f26",
                                "sense_id": "d52f71ba-3226-3b84-8e3d-747de14ba8b1",
                                "text": "„Schliesslich sei noch die Bemerkung gestattet, dass die zahlreichen von Herrn Prof. P. Otto Fehringer im Stiftswalde gesammelten Usnea-Exemplare, von denen ich mit Vergnügen Jedermann mittheilen würde, bei ausgiebiger Anfeuchtung einen penetranten Jodgeruch verbreiten, viel auffälliger als Exemplare anderer Fundorte.“"
                            },
                            {
                                "example_id": "113598ef-3b02-492c-88f7-960da3900409",
                                "sense_id": "d52f71ba-3226-3b84-8e3d-747de14ba8b1",
                                "text": "„Der Einfluss des Wetters auf die Küchenarbeit wird oft unterschätzt: Gebäck, das pappig wird, Fonds, die sauer werden, Fische, deren Jodgeruch sich verstärkt – all das und noch mehr kann durch ein Gewitter ausgelöst werden.“"
                            },
                            {
                                "example_id": "1b690509-d528-445f-b143-bc94d82b2c9d",
                                "sense_id": "d52f71ba-3226-3b84-8e3d-747de14ba8b1",
                                "text": "„Zu erkennen sei eine lebende Auster an der zunächst noch fest verschlossenen Schale – und dem frischen Jodgeruch in ihrem Inneren.“"
                            },
                            {
                                "example_id": "b12da1cb-5302-4d63-a953-19ded6f74a9b",
                                "sense_id": "d52f71ba-3226-3b84-8e3d-747de14ba8b1",
                                "text": "„Bei der Heimkehr in ländliche oder bergige Gebiete Deutschlands vermissen wir das beruhigende Hin und Her der Wellen, die Weite, den Salz- und Jodgeruch, den Strand und den Platz am Ende vom Steg, natürlich das Baden, und eine Sonne, die im Wasser versinkt.“"
                            },
                            {
                                "example_id": "b7bb39fa-aa36-41af-9f82-1674b7d672ac",
                                "sense_id": "d52f71ba-3226-3b84-8e3d-747de14ba8b1",
                                "text": "„Das im Preferal enthaltene Kaliumjodid ist stabil und frei von Jodgeruch.“"
                            },
                            {
                                "example_id": "73323fd7-b6d7-4a75-afe5-49583fb7769c",
                                "sense_id": "d52f71ba-3226-3b84-8e3d-747de14ba8b1",
                                "text": "„Luft und Wasser sind mit intensivem Jodgeruch gesättigt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
