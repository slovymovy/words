                                                "example_id": "205a715b-81d4-4c33-a251-38c2eaae7ad7",
                                                "sense_id": "2239795c-841d-3ece-95e0-1547b22e272d",
                                                "text": "Notching an arrow on the string of his tried and unerring bow, he raised his sinewy arms […]"
                                            },
