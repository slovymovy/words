                    },
                    {
                        "translation_id": "286abf3c-8b88-40ba-aa17-98742f98019b",
                        "source_entry_id": "7b40bfec-88a3-3e92-bce9-58709eaa09aa",
                        "source_sense_id": "7f7ece80-24f2-3ec5-b977-2acf7f051532",
                        "target_lang_word": "acudir corriendo",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "62dafbef-c19e-4733-86f0-0a1264cbbee4",
                        "source_entry_id": "7b40bfec-88a3-3e92-bce9-58709eaa09aa",
                        "source_sense_id": "7f7ece80-24f2-3ec5-b977-2acf7f051532",
                        "target_lang_word": "accorrere",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "accorrere",
                                "target_lang_code": "it",
                                "target_senses": [
                                    {
                                        "sense_id": "860fbd01-3f50-35ac-be18-7d459cd0fa25",
                                        "entry_id": "ab19792a-3eb8-3549-8f4c-1bf717f6bdc4",
                                        "glosses": [
                                            "portarsi il più in fretta possibile in un luogo dove è richiesta la propria presenza, generalmente (ma non esclusivamente) per prestare soccorso o fornire sostegno, aiuto, collaborazione"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb0b94d0-33da-45d9-9c97-0fd17fd0fcbb",
                                                "sense_id": "860fbd01-3f50-35ac-be18-7d459cd0fa25",
                                                "text": "Volarono per soccorrerlo gli amici suoi, mossi a pietà di tanta tragedia, e don Chisciotte ancora vi accorse lasciando Ronzinante. Lo prese fra le braccia, e trovò che non era ancora spirato"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b72f816-f2c5-380d-b4ab-fb01a19a36e4",
                                        "entry_id": "ab19792a-3eb8-3549-8f4c-1bf717f6bdc4",
                                        "glosses": [
                                            "riunirsi, confluire in gran numero e da più parti, generalmente con sollecitudine, nel posto dove si svolge un evento che anima il fervore, l'interesse, la curiosità, lo scalpore, lo sdegno, l'orrore, l'ira collettivi, a una manifestazione popolare o in una struttura organizzata per accogliere molte persone"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ef2708a-4356-491b-b83b-39a3a71ec91d",
                                                "sense_id": "4b72f816-f2c5-380d-b4ab-fb01a19a36e4",
                                                "text": "Ma i fedeli accorrevano egualmente; salivano da tutti i sentieri tortuosi, da tutte le strade serpeggianti, affluendo alla chiesetta come il sangue che dalle vene va su al cuore"
                                            },
                                            {
                                                "example_id": "be485c89-a88a-4411-a510-f87d5b8c9f07",
                                                "sense_id": "4b72f816-f2c5-380d-b4ab-fb01a19a36e4",
                                                "text": "accorrere allo stadio per la finale della Champions', al mare per il ponte di ferragosto, ad un concerto, ad una festa, ad un corteo, ad un raduno di motociclisti, alla maratona di New York, alla sagra del tortello di zucca"
                                            },
                                            {
                                                "example_id": "e5dce7a0-122a-4323-a009-6127edbb891e",
                                                "sense_id": "4b72f816-f2c5-380d-b4ab-fb01a19a36e4",
                                                "text": "accorrete numerosi alla Fiera del Mobile Antico!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
