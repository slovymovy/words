                        "glosses": [
                            "Person, die über ungewöhnlich große Fähigkeiten im Umgang mit Computern verfügt"
                        ],
                        "tags": [
                            "humorous"
                        ],
                        "examples": [
                            {
                                "example_id": "70bc9b17-d672-400a-9d81-d440f7170013",
                                "sense_id": "71c44aef-2496-3692-9bc9-5f84e9725a22",
                                "text": "„Ich habe versucht, ein Computergenie zu finden, das mir die Daten auswerten kann, aber ich bin damit gescheitert.“"
                            },
                            {
                                "example_id": "07f144d5-ff15-41e4-8496-7abf2cd2c262",
                                "sense_id": "71c44aef-2496-3692-9bc9-5f84e9725a22",
                                "text": "„Reginald ›Lithpel‹ Davids war das lispelnde Computergenie bei den Kriminaltechnikern: klein und schmal, jungenhaftes Gesicht, zwei fehlende Schneidezähne und buschiger Afro-Look.“"
                            }
                        ],
