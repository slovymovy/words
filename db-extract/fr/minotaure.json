                "senses": [
                    {
                        "sense_id": "766f966d-1d92-3c06-93c5-728f75dd93e5",
                        "entry_id": "8900f7f3-92f1-3668-af89-458f9b514914",
                        "glosses": [
                            "Monstre au corps d’homme et à tête de taureau, fils de l’épouse de Minos, Pasiphaé et d’un taureau, vivant dans le labyrinthe construit par Dédale."
                        ],
                        "tags": [
                            "Fantastique"
                        ],
                        "examples": [
                            {
                                "example_id": "ab03d8d9-bafd-4937-a11b-09cd8f4d68b2",
                                "sense_id": "766f966d-1d92-3c06-93c5-728f75dd93e5",
                                "text": "Le Minotaure est vaincu par Thésée."
                            },
                            {
                                "example_id": "e4d4ff3d-9cf4-49d8-b377-5d5c12f6e73f",
                                "sense_id": "766f966d-1d92-3c06-93c5-728f75dd93e5",
                                "text": "Gabriel Morange faisait partie d’un groupe d’une vingtaine d’hommes placés sous les ordres du caporal Debaty, un Belge débonnaire aux épaules de Minotaure."
                            }
                        ]
                    }
                ],
