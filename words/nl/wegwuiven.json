{
    "word_family": [
        "wuiven",
        "wegwuiving"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9dd79ae7-fab9-3a6d-9cfd-fa700e3c94f1",
                    "sense_definition": "Iets niet serieus nemen, negeren of doen alsof het onbelangrijk is.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "negeren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De minister probeerde de kritiek op het nieuwe beleid snel te <w>wegwuiven</w>.",
                            "target_lang_translations": {
                                "en": "The minister tried to quickly <w>dismiss</w> the criticism of the new policy."
                            }
                        },
                        {
                            "text": "Je kunt deze ernstige waarschuwingen niet zomaar als onzin <w>wegwuiven</w>.",
                            "target_lang_translations": {
                                "en": "You cannot just <w>brush aside</w> these serious warnings as nonsense."
                            }
                        }
                    ],
                    "synonyms": [
                        "bagatelliseren",
                        "negeren",
                        "afwijzen",
                        "minimaliseren"
                    ],
                    "antonyms": [
                        "erkennen",
                        "accepteren"
                    ],
                    "common_phrases": [
                        "kritiek wegwuiven",
                        "bezwaren wegwuiven"
                    ],
                    "target_lang_definitions": {
                        "en": "To not take something seriously, to ignore it, or to act as if it is unimportant."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "dismiss",
                                "target_lang_sense_clarification": "to treat as unworthy of serious consideration"
                            },
                            {
                                "target_lang_word": "brush aside",
                                "target_lang_sense_clarification": "to dismiss or ignore something, like criticism or objections"
                            },
                            {
                                "target_lang_word": "wave aside",
                                "target_lang_sense_clarification": "to dismiss a suggestion, objection, or criticism"
                            },
                            {
                                "target_lang_word": "shrug off",
                                "target_lang_sense_clarification": "to dismiss something as unimportant"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c4ca046e-6188-3b9a-89cd-ac3a80c29294",
                    "sense_definition": "Met een handgebaar iets of iemand wegsturen of doen verdwijnen.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "fysiek_gebaar",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Met een ongeduldig gebaar <w>wuifde</w> hij de opdringerige vlieg <w>weg</w>.",
                            "target_lang_translations": {
                                "en": "With an impatient gesture, he <w>waved away</w> the pesky fly."
                            }
                        },
                        {
                            "text": "De koning <w>wuifde</w> zijn bediende <w>weg</w> toen hij alleen wilde zijn.",
                            "target_lang_translations": {
                                "en": "The king <w>waved off</w> his servant when he wanted to be alone."
                            }
                        }
                    ],
                    "common_phrases": [
                        "met een gebaar wegwuiven"
                    ],
                    "target_lang_definitions": {
                        "en": "To send someone or something away, or make them disappear, with a hand gesture."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "wave away",
                                "target_lang_sense_clarification": "to dismiss someone or something with a wave of the hand"
                            },
                            {
                                "target_lang_word": "wave off",
                                "target_lang_sense_clarification": "to signal someone to go away using a hand gesture"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}