                                "target_senses": [
                                    {
                                        "sense_id": "ed274146-1a21-3d0d-a612-790a8a9f2302",
                                        "entry_id": "a6918a17-ab4b-3fd5-afd5-dd60197dbb66",
                                        "glosses": [
                                            "Petit poème à sujet pastoral ou amoureux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e053153-d63d-401e-a5d3-99509bd1dfdd",
                                                "sense_id": "ed274146-1a21-3d0d-a612-790a8a9f2302",
                                                "text": "Oh ! les chastes églogues ! Oh ! les idylles chantées par les poètes ! Oh ! les paysanneries enrubannées et naïves qui défilent, conduites par la muse de Mme Deshoulières, au son des flageolets et des tambourins !"
                                            },
                                            {
                                                "example_id": "f767fe37-630b-4a61-aca3-1ddb8c0715b1",
                                                "sense_id": "ed274146-1a21-3d0d-a612-790a8a9f2302",
                                                "text": "Dans un souvenir pastoral, les vers d'une triste idylle écrite par La Fontaine flottèrent devant sa mémoire rêveuse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "64300af9-7fe8-382c-881f-328b3a546d64",
                                        "entry_id": "a6918a17-ab4b-3fd5-afd5-dd60197dbb66",
                                        "glosses": [
                                            "Liaison romantique, aventure amoureuse qui ne reste pas toujours chaste."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "881c1134-787e-43e0-ae38-e0130bd03b35",
                                                "sense_id": "64300af9-7fe8-382c-881f-328b3a546d64",
                                                "text": "Devant ce réveil navré de Paris, elle se trouvait prise d'un attendrissement de jeune fille, d'un besoin de campagne, d'idylle, de quelque chose de doux et de blanc. - Oh ! vous ne savez pas ? dit-elle en revenant à Steiner, vous allez me mener au bois de Boulogne, et nous boirons du lait."
                                            },
                                            {
                                                "example_id": "3bb1de09-b111-4236-8b80-b855b794b6df",
                                                "sense_id": "64300af9-7fe8-382c-881f-328b3a546d64",
                                                "text": "Moi qui connais bien Hélène, je n'ai guère été étonné de la voir entamer une idylle avec un homme jeune, de vingt ans son cadet. Elle est ce qu'on appelle aujourd'hui une cougar."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f21064f8-6267-3c30-b5bf-17c1d5ece3d2",
                                        "entry_id": "a6918a17-ab4b-3fd5-afd5-dd60197dbb66",
                                        "glosses": [
                                            "Amour naïf et tendre vécu affectivement par deux êtres dans la fraîcheur d'un sentiment idéalisé. Relation rêvée dans un climat idéal."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06e049c2-d8b7-4017-ae4d-8aad6d643837",
                                                "sense_id": "f21064f8-6267-3c30-b5bf-17c1d5ece3d2",
                                                "text": "Partie de la trop aimable idylle florianesque, son histoire d'amour peu à peu s'était assombrie jusqu'à prendre les couleurs arrières du roman flaubertien, qui dit l'universelle maldonne."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
