                    {
                        "translation_id": "78fe1c94-b39c-4727-8532-12e266d9e220",
                        "source_entry_id": "35e63c2f-d47f-3059-801b-3156e15a1b4d",
                        "source_sense_id": "4c621ada-7133-39ce-b021-c9c8d9b78e3e",
