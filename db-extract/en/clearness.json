{
    "word": "clearness",
    "lang_code": "en",
    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "7fd9cab1-d6e9-3308-8505-2c609b18a56b",
                "word": "clearness",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "917344c0-6587-4e70-bc9b-cbdf848720e7",
                        "entry_id": "7fd9cab1-d6e9-3308-8505-2c609b18a56b",
                        "tags": [
                            "plural"
                        ],
                        "form": "clearnesses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "62e04169-f057-3b71-ad20-86ab2fe35e77",
                        "entry_id": "7fd9cab1-d6e9-3308-8505-2c609b18a56b",
                        "glosses": [
                            "Brightness, brilliancy."
                        ],
                        "tags": [
                            "obsolete",
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "d86a7928-1c65-4dea-a2c9-e4b5a85aa1a5",
                                "sense_id": "62e04169-f057-3b71-ad20-86ab2fe35e77",
                                "text": "Thenne sayd he Fair swete fader Ihesu Cryst yf euer I dyd thyng that pleasyd the lord / for thy pyte ne haue me not in despyte for my synnes done afore tyme / and that thou shewe me some thynge of that I seke / And with that he sawe the chamber dore open and there came oute a grete clerenes / that the hows was as bryghte as all torches of the world had ben there"
                            }
                        ]
                    },
                    {
                        "sense_id": "965349ae-9ddb-3ab2-b4e8-b6b43a1953f2",
                        "entry_id": "7fd9cab1-d6e9-3308-8505-2c609b18a56b",
                        "glosses": [
                            "Mental or sensory distinctness; clarity of understanding, perception etc."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "3328637b-4109-425c-97c9-f81c8194120f",
                                "sense_id": "965349ae-9ddb-3ab2-b4e8-b6b43a1953f2",
                                "text": "The daily press is the evil principle of the modern world, and time will only serve to disclose this fact with greater and greater clearness."
                            }
                        ]
                    },
                    {
                        "sense_id": "5e78eec1-fe84-3dc2-b0b0-25715f38b5bb",
                        "entry_id": "7fd9cab1-d6e9-3308-8505-2c609b18a56b",
                        "glosses": [
                            "The state of being free from obscurities or opacity; distinctness of light, colour etc."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "c7aebb71-2a62-4547-9457-21673eccb1c3",
                                "sense_id": "5e78eec1-fe84-3dc2-b0b0-25715f38b5bb",
                                "text": "The clearness of the water meant I could still see the key lying on the river-bed."
                            }
                        ]
                    },
                    {
                        "sense_id": "825ce557-cdc4-3489-aed7-bfba4068689f",
                        "entry_id": "7fd9cab1-d6e9-3308-8505-2c609b18a56b",
                        "glosses": [
                            "The state of being free from obstruction or interference."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "72759dca-f818-4653-84c5-37bf11840da8",
                                "sense_id": "825ce557-cdc4-3489-aed7-bfba4068689f",
                                "text": "The clearness of the path made for an easy hike."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8b796b21-2aa8-4e7d-bc21-cdb41de8c46b",
                        "source_entry_id": "7fd9cab1-d6e9-3308-8505-2c609b18a56b",
                        "source_sense_description": "the state or measure of being clear",
                        "target_lang_word": "clarté",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "clarté",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "59194e48-c8cf-3dca-87a4-dd2d4709be15",
                                        "entry_id": "2c18cebc-20bc-3400-b49f-ddc9e506f6ec",
                                        "glosses": [
                                            "Lumière, lueur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f28de0e-fe58-414f-b805-50ba7b811545",
                                                "sense_id": "59194e48-c8cf-3dca-87a4-dd2d4709be15",
                                                "text": "Au jour tombant, il […] prenait un repas frugal à la clarté de la lune, ou à la lueur des étoiles."
                                            },
                                            {
                                                "example_id": "0f73a43d-22a1-4a21-b608-8303a0a7aa48",
                                                "sense_id": "59194e48-c8cf-3dca-87a4-dd2d4709be15",
                                                "text": "[…]; des hommes mûrs pleuraient à la vue du drapeau étoilé soutenu par tout le corps de ballet noyé sous les clartés des projecteurs.."
                                            },
                                            {
                                                "example_id": "de36a558-82c9-46f7-9606-b3795a5b42f3",
                                                "sense_id": "59194e48-c8cf-3dca-87a4-dd2d4709be15",
                                                "text": "Du dehors, à la clarté brutale de l'électricité, je pus apercevoir des couples se désunir et plusieurs individus se défaire, avec un geste brusque, de couteaux ou de revolvers."
                                            },
                                            {
                                                "example_id": "e3130b1b-f01c-4fbd-a998-dc38417c56fa",
                                                "sense_id": "59194e48-c8cf-3dca-87a4-dd2d4709be15",
                                                "text": "[…], et je fus aidé par la clarté de la lune qui venait de se lever doucement sur le lagon à peine ridé entre les îles Tupua et Porapora."
                                            },
                                            {
                                                "example_id": "cfbef424-55b2-4ce0-ae2a-dbf2ff56bedb",
                                                "sense_id": "59194e48-c8cf-3dca-87a4-dd2d4709be15",
                                                "text": "Dans un grand épanchement de clarté, je vois, sous les pins des promontoires, une côte éclatante, d'immenses baies toutes bleues, une théâtrale enluminure, où la ligne déchiquetée des porphyres limite en ses anfractuosités rougeoyantes l'azur doré de la mer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8c4ed9d4-b516-3b1f-97a4-48c15c4cfa17",
                                        "entry_id": "2c18cebc-20bc-3400-b49f-ddc9e506f6ec",
                                        "glosses": [
                                            "Objet, accessoire servant à éclairer."
                                        ],
                                        "tags": [
                                            "Centre"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "15236785-314f-404d-8a42-0f34b4549024",
                                                "sense_id": "8c4ed9d4-b516-3b1f-97a4-48c15c4cfa17",
                                                "text": "— Je vas dire qu’on vous apporte une clarté, dit Jeanne un peu rassurée par les dernières paroles de Marsillat. Vous ne pouvez pas trouver vos papiers comme cela dans la nuit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7a47df0e-5130-32ca-a4f1-a06f900f9516",
                                        "entry_id": "2c18cebc-20bc-3400-b49f-ddc9e506f6ec",
                                        "glosses": [
                                            "Transparence."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8dae8a65-24b3-4463-a3c9-fecd8e00c145",
                                                "sense_id": "7a47df0e-5130-32ca-a4f1-a06f900f9516",
                                                "text": "La clarté du verre."
                                            },
                                            {
                                                "example_id": "957f70a7-ae5a-44a6-a655-1c4364d6478c",
                                                "sense_id": "7a47df0e-5130-32ca-a4f1-a06f900f9516",
                                                "text": "La clarté de l’eau."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c156f3ac-deab-39f0-91f6-9894e64de863",
                                        "entry_id": "2c18cebc-20bc-3400-b49f-ddc9e506f6ec",
                                        "glosses": [
                                            "Qualité des idées, du discours, du style qui les rend propres à être facilement compris."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8af3f8cf-43c3-46eb-952b-0271350b00da",
                                                "sense_id": "c156f3ac-deab-39f0-91f6-9894e64de863",
                                                "text": "Parler, écrire avec clarté."
                                            },
                                            {
                                                "example_id": "f4f730ef-9aec-4a5f-9418-959889f7b946",
                                                "sense_id": "c156f3ac-deab-39f0-91f6-9894e64de863",
                                                "text": "Expliquer quelque chose avec une grande clarté."
                                            },
                                            {
                                                "example_id": "806c0caa-36cb-4711-a650-82ad6c881ff5",
                                                "sense_id": "c156f3ac-deab-39f0-91f6-9894e64de863",
                                                "text": "Ces principes sont d’une grande clarté."
                                            },
                                            {
                                                "example_id": "d66c9293-84a4-4af2-8ee6-5ebb3e234df7",
                                                "sense_id": "c156f3ac-deab-39f0-91f6-9894e64de863",
                                                "text": "En quoi la clarté est-elle différente de la concentration ? La seconde nous aide à garder l'esprit posé sur l'objet de notre choix, la première nous aide à choisir cet objet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b9baa8ef-5fbd-36a5-aa34-97c3dab5b47d",
                                        "entry_id": "2c18cebc-20bc-3400-b49f-ddc9e506f6ec",
                                        "glosses": [
                                            "Tout ce qui éclaire l’esprit."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dc9b6f3c-4f16-4a8a-977b-80ffba0b87fd",
                                                "sense_id": "b9baa8ef-5fbd-36a5-aa34-97c3dab5b47d",
                                                "text": "Simultanément l'armée réalisait avec clarté que sa place n'était plus sur les pitons, mais dans les villages. Elle prenait en main le nettoyage des villes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8720620d-4ed2-3f33-aaf2-0986c3eac01b",
                                        "entry_id": "2c18cebc-20bc-3400-b49f-ddc9e506f6ec",
                                        "glosses": [
                                            "Caractère d’une couleur qui produit sur l’œil une sensation lumineuse de niveau élevé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "95284f3e-871e-4a96-99d6-ebb0ccb0ba45",
                                                "sense_id": "8720620d-4ed2-3f33-aaf2-0986c3eac01b",
                                                "text": "Le terme clarté est employé pour un objet coloré et le terme luminosité pour une source de lumière."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
