                                        "entry_id": "a631589d-7986-3631-a370-ffd5eeb683a5",
                                        "glosses": [
                                            "A traditional textile art form of the Kuna people of Panama and Colombia, consisting of cloth panels to be worn on clothing, featuring complex designs made with multiple layers of cloth in a reverse appliqué technique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e63e9708-5fd4-4f7c-a0b8-f5ffd4abc664",
                                                "sense_id": "ef5461bf-3ea9-3e82-bf52-1196bc33b673",
                                                "text": "The classic mola is pure applique and is distinguished by alternating bands of color."
                                            },
                                            {
                                                "example_id": "01855211-a24e-4e70-932d-66ac243562f7",
                                                "sense_id": "ef5461bf-3ea9-3e82-bf52-1196bc33b673",
                                                "text": "Molas originally served, and still serve, as blouse front and backs."
                                            }
                                        ]
                                    }
