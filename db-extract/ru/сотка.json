                "translations": [
                    {
                        "translation_id": "067894c9-3518-49e8-9fca-f9e3e735d80d",
                        "source_entry_id": "342b03ef-9939-30de-8f80-9641886a7781",
                        "target_lang_word": "hectare",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hectare",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "850e68c6-0d07-30b8-a85e-cb1be4ef3700",
                                        "entry_id": "40d2e494-0afc-3cab-a8b7-6288d2c3aaea",
                                        "glosses": [
                                            "A unit of surface area (symbol ㏊) equal to 100 ares (that is, 10,000 square metres, one hundredth of a square kilometre, or approximately 2.5 acres), used for measuring the areas of geographical features such as land and bodies of water."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2dcb1a0-7db6-47f1-9da9-f6dcb4cf9ad1",
                                                "sense_id": "850e68c6-0d07-30b8-a85e-cb1be4ef3700",
                                                "text": "With careful planning almost anyone can turn the dream of owning a small farm or a few hectares of country land into a reality."
                                            },
                                            {
                                                "example_id": "f4931e24-d29c-4956-ac71-c00a9bd0efd5",
                                                "sense_id": "850e68c6-0d07-30b8-a85e-cb1be4ef3700",
                                                "text": "One hectare (about 2.5 acres) of forest cleared and converted to ranchland or crops produces a piece of land worth, on average, $200 to $500."
                                            },
                                            {
                                                "example_id": "f3cb02b7-430c-44ae-9807-2593a28ccdbd",
                                                "sense_id": "850e68c6-0d07-30b8-a85e-cb1be4ef3700",
                                                "text": "Last year 1m square metres of plant-covered roofing was built in France, as much as in the US, and 10 times more than in Germany, the pioneer in this field. In Paris 22 hectares of roof have been planted, out of a potential total of 80 hectares."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
