                        "sense_id": "9e9e39dc-95d2-3119-8d4a-7ab52e7b65ad",
                        "entry_id": "38a16df2-25f8-3482-8a91-68731b1ef47e",
                        "glosses": [
                            "Tête, crâne."
                        ],
