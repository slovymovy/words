                "senses": [
                    {
                        "sense_id": "08c457db-4694-3036-8213-e6fd4e7610e4",
                        "entry_id": "fcdef8df-5257-31cd-8cd2-5524a56a8747",
                        "glosses": [
                            "A small circumpolar constellation of the southern sky, imagined to resemble a chameleon, which lies south of the constellations Carina and Musca."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2cc77fa1-6ef9-4ce4-8222-1263f2d31caa",
                                "sense_id": "08c457db-4694-3036-8213-e6fd4e7610e4",
                                "text": "1994, Revista Mexicana de Astronomía y Astrofísica, Volumes 28-30, Instituto de Astronomía, Universidad Nacional Autónoma de México, page 50,\nThe X-ray luminosity function has been determined so far only for the far only for the central parts of the Chamaeleon SFR by Fiegelson et al. (1993)."
                            },
                            {
                                "example_id": "dc131346-ec40-446e-85cf-35dbd0e0107b",
                                "sense_id": "08c457db-4694-3036-8213-e6fd4e7610e4",
                                "text": "2001, A. Mizuno, T. Hayakawa, T. Onishi, Y. Fukui, Dense Core Survey toward the Chamaeleon Dark Cloud Complex with the NANTEN Radio Telescope, Alwyn Wootten (editor), Science with the Atacama Large Millimeter Array (ALMA): Proceedings of a Conference, Astronomical Society of the Pacific, page 146."
                            },
                            {
                                "example_id": "7768d929-e44c-43cf-b5e0-99218f4d319e",
                                "sense_id": "08c457db-4694-3036-8213-e6fd4e7610e4",
                                "text": "2005, Memorie Della Società Astronomica Italiana, Volume 76, Issues 1-2, Società Astronomica Italiana, page 263,\nWe note, however, that the surveyed area in Chamaeleon II was relatively small in comparison with the other two regions, covering only part of a cloud core to the north-west."
                            }
                        ]
                    }
