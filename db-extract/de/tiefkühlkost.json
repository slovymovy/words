                ],
                "senses": [
                    {
                        "sense_id": "f3c58885-a44b-34dc-96ab-3e1316dca7d4",
                        "entry_id": "ff404e69-b598-37cd-9741-5a62bea2466d",
                        "glosses": [
                            "durch Tiefkühlung konservierte Lebensmittel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8affb926-2195-4a62-94b0-3ccd3ce07bc3",
                                "sense_id": "f3c58885-a44b-34dc-96ab-3e1316dca7d4",
                                "text": "Tiefkühlkost muss man vor dem Essen auftauen."
                            },
                            {
                                "example_id": "03c0317a-9f68-4e70-8603-b3705c33ffd6",
                                "sense_id": "f3c58885-a44b-34dc-96ab-3e1316dca7d4",
                                "text": "Wenn es schnell gehen muss, steht auch einmal Tiefkühlkost auf dem Speiseplan."
                            },
                            {
                                "example_id": "bbe049a3-6683-487c-9224-2e3e5788c8f9",
                                "sense_id": "f3c58885-a44b-34dc-96ab-3e1316dca7d4",
                                "text": "„Bei gekaufter Tiefkühlkost findet man ein Mindesthaltbarkeitsdatum, bis zu dem sie eine Top-Qualität besitzt, obwohl die Produkte auch danach noch längere Zeit haltbar sind.“"
                            },
                            {
                                "example_id": "f118cf0b-a3d4-442d-937c-9056877b424b",
                                "sense_id": "f3c58885-a44b-34dc-96ab-3e1316dca7d4",
                                "text": "„Die steigende Verbreitung von Fertiggerichten und Tiefkühlkost wurde außerdem durch die wachsende Ausstattung der Haushalte mit Gefriergeräten und Mikrowellenherden begünstigt.“"
                            },
                            {
                                "example_id": "f01daeeb-392e-4279-ac92-a5ff6f033a9d",
                                "sense_id": "f3c58885-a44b-34dc-96ab-3e1316dca7d4",
                                "text": "„Als Roth auf der Highschool war, geriet sein Vater tief in Schulden, denn der Vertrieb von Tiefkühlkost, den er mit Freunden gegründet hatte, machte pleite.“"
                            },
                            {
                                "example_id": "fd8db401-5f75-4916-a36c-b193f6f13509",
                                "sense_id": "f3c58885-a44b-34dc-96ab-3e1316dca7d4",
                                "text": "„Es ist nur eine Frage der Zeit, bis die Chinesen Tiefkühlkost entdecken, und das bloß, damit sie irgendwas in die Kühlschränke stellen können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
