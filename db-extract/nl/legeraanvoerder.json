                                    },
                                    {
                                        "sense_id": "8dae73dc-2a3f-399a-8db8-82448ae6fe9d",
                                        "entry_id": "6f538cef-37ce-3ec3-8ef1-93ab1b4081e7",
                                        "glosses": [
                                            "A great strategist or tactician."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4241ba7d-7b44-4002-bd48-2554c8a45ad4",
                                                "sense_id": "8dae73dc-2a3f-399a-8db8-82448ae6fe9d",
                                                "text": "Hannibal was one of the greatest generals of the ancient world."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9deedf86-f6ef-3730-b883-ef5ee242b1c5",
                                        "entry_id": "6f538cef-37ce-3ec3-8ef1-93ab1b4081e7",
                                        "glosses": [
                                            "A general fact or proposition; a generality."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "55c0055d-91bb-44e9-aadd-0746e93f34af",
                                                "sense_id": "9deedf86-f6ef-3730-b883-ef5ee242b1c5",
                                                "text": "We have dealt with the generals; now let us turn to the particulars."
                                            }
                                        ]
