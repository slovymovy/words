                "senses": [
                    {
                        "sense_id": "7bbebbf3-ffc6-3090-8c5a-808f7d24e7cb",
                        "entry_id": "d15870ac-a6b2-38fc-b972-d341a934a073",
                        "glosses": [
                            "posiłek o charakterze obiadu spożywany w porze kolacji"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "afb73dd5-6d88-4e08-a0bc-ea3be8073395",
                                "sense_id": "7bbebbf3-ffc6-3090-8c5a-808f7d24e7cb",
                                "text": "Po całodziennej wycieczce zjedliśmy wieczorem obiadokolację."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4bcb3984-0345-4959-8ac8-e7b1579bb1ec",
                        "source_entry_id": "d15870ac-a6b2-38fc-b972-d341a934a073",
                        "source_sense_id": "7bbebbf3-ffc6-3090-8c5a-808f7d24e7cb",
                        "target_lang_word": "dinner",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dinner",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a45408e2-87ca-3ae5-8116-35856d515794",
                                        "entry_id": "13e5f024-cd0c-3dde-9fea-a3289f85ab0a",
                                        "glosses": [
                                            "The main meal of the day, often eaten in the evening."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9417a1c0-f52c-4efc-a9c1-30f6ac5b3aac",
                                                "sense_id": "a45408e2-87ca-3ae5-8116-35856d515794",
                                                "text": "1993, Mark Berry as \"King Harkinian\", a character in Animation Magic, Zelda: The Wand of Gamelon, Philips Interactive Media (publ.).\nI wonder what's for dinner."
                                            },
                                            {
                                                "example_id": "68be6a06-5a03-4a46-8aec-11196f1bcaf0",
                                                "sense_id": "a45408e2-87ca-3ae5-8116-35856d515794",
                                                "text": "I want to cook dinner."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "03e69ccd-54af-331d-bc06-73903871e7c3",
                                        "entry_id": "13e5f024-cd0c-3dde-9fea-a3289f85ab0a",
                                        "glosses": [
                                            "An evening meal."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8de1a7af-87a0-42f1-a2a0-48ad64cbeb2d",
                                                "sense_id": "03e69ccd-54af-331d-bc06-73903871e7c3",
                                                "text": "I had some friends to dinner two nights ago."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a49e433d-3591-3521-9499-b4e609c1d1ac",
                                        "entry_id": "13e5f024-cd0c-3dde-9fea-a3289f85ab0a",
                                        "glosses": [
                                            "A midday meal (in a context in which the evening meal is called supper or tea)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3882883a-49ac-474e-8e22-0707ff37e351",
                                                "sense_id": "a49e433d-3591-3521-9499-b4e609c1d1ac",
                                                "text": "At twilight in the summer[…]the mice come out. They[…]eat the luncheon crumbs. Mr. Checkley, for instance, always brought his dinner in a paper parcel in his coat-tail pocket, and ate it when so disposed, sprinkling crumbs lavishly[…]on the floor."
                                            },
                                            {
                                                "example_id": "b1ff1ca0-2953-48a3-a961-43e7d3b76f10",
                                                "sense_id": "a49e433d-3591-3521-9499-b4e609c1d1ac",
                                                "text": "It was already late for school, so the boy took his time and only arrived in the village when Heidi came home for dinner. […] \"Come to the table now and eat with us. Then you can go up with Heidi, and when you bring her back at night, you can get your supper here.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a858e55d-47b4-38fb-94e6-0e36745c2736",
                                        "entry_id": "13e5f024-cd0c-3dde-9fea-a3289f85ab0a",
                                        "glosses": [
                                            "A meal given to an animal."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7ed30ab5-cc38-4e6d-b7a4-12c328d771a0",
                                                "sense_id": "a858e55d-47b4-38fb-94e6-0e36745c2736",
                                                "text": "Give the dog its dinner."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "33b11957-bd94-3d8e-ada1-c372d8c745ef",
                                        "entry_id": "13e5f024-cd0c-3dde-9fea-a3289f85ab0a",
                                        "glosses": [
                                            "A formal meal for many people eaten for a special occasion."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "13e97075-1945-4a1f-84ea-908d3ae935c6",
                                                "sense_id": "33b11957-bd94-3d8e-ada1-c372d8c745ef",
                                                "text": "My family gathers twice a year, namely at Christmas and Thanksgiving dinners."
                                            },
                                            {
                                                "example_id": "093ac33f-22e1-4870-800b-eb6e50baa425",
                                                "sense_id": "33b11957-bd94-3d8e-ada1-c372d8c745ef",
                                                "text": "When I gave a dinner there was generally a cover laid for him. I liked the man for his own sake, and even had he promised to turn out a celebrity it would have had no weight with me."
                                            },
                                            {
                                                "example_id": "7b1288a8-f0b7-425e-adb8-bda02591e604",
                                                "sense_id": "33b11957-bd94-3d8e-ada1-c372d8c745ef",
                                                "text": "Soon after the arrival of Mrs. Campbell, dinner was announced by Abboye. He came into the drawing room resplendent in his gold-and-white turban. […] His cummerbund matched the turban in gold lines."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "599937ed-170a-3270-8a75-40cb28c63353",
                                        "entry_id": "13e5f024-cd0c-3dde-9fea-a3289f85ab0a",
                                        "glosses": [
                                            "The food provided or consumed at any such meal."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "dinner",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1b84ff44-3ca3-3793-a8d2-44d933215d91",
                                        "entry_id": "f6c80708-5161-34cd-9d85-fbe01fe19605",
                                        "glosses": [
                                            "To eat a dinner; to dine."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "66fa1f6b-f1cb-4a2d-956a-696b98409bab",
                                                "sense_id": "1b84ff44-3ca3-3793-a8d2-44d933215d91",
                                                "text": "Once I was geared up, I joined him on the wide, flat seat of the sled which was loaded up with hot food for the jacks who were dinnering out since they worked a forty far from the camp."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c8201cbb-3e66-3db1-916f-3abb5de3bc13",
                                        "entry_id": "f6c80708-5161-34cd-9d85-fbe01fe19605",
                                        "glosses": [
                                            "To provide (someone) with a dinner; to dine."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "22bddf8e-4fa5-4316-821e-651734de1bb4",
                                                "sense_id": "c8201cbb-3e66-3db1-916f-3abb5de3bc13",
                                                "text": "1887, Caroline Emily Cameron, A Devout Lover, London: F.V. White & Co., Volume 1, Chapter 11, p. 181,\nShe had taken her about to concerts and exhibitions—she had dinnered her at the Colonies, and suppered her at the New Club."
                                            },
                                            {
                                                "example_id": "6d08dfef-b42f-41b5-a02a-52f88fed08a5",
                                                "sense_id": "c8201cbb-3e66-3db1-916f-3abb5de3bc13",
                                                "text": "‘The Irish were awful anyway,’ Lady Wolseley said, ‘and their not attending the season should be greeted with relief. The dreary matrons dragging their dreary daughters about the place and dinnering up every possible partner for them. The truth is that no one wants to marry their daughters, no one at all.’"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
