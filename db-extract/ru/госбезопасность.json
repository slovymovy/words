                    },
                    {
                        "translation_id": "32957d91-febb-4122-9612-26e7d9467bdd",
                        "source_entry_id": "24106879-03e9-32a7-8b85-0e51beed1ef4",
                        "source_sense_id": "7c582201-d859-3af1-86b3-4a805ba4ea20",
                        "target_lang_word": "sicurezza dello stato",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "85bca09b-2458-4962-b63c-426ced1730c7",
                        "source_entry_id": "24106879-03e9-32a7-8b85-0e51beed1ef4",
                        "source_sense_id": "7c582201-d859-3af1-86b3-4a805ba4ea20",
                        "target_lang_word": "Staatssicherheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Staatssicherheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a07c1efe-ee73-3361-bb2f-0ea074b313ee",
                                        "entry_id": "63627e76-fb9f-3971-9fc6-b12a62c6408c",
                                        "glosses": [
                                            "geschützter Zustand eines Staates"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ca739f7-2c31-4e6c-9e81-9076d42f5294",
                                                "sense_id": "a07c1efe-ee73-3361-bb2f-0ea074b313ee",
                                                "text": "„Die Leiter der Geheimdienstausschüsse von Repräsentantenhaus und Senat wurden detailliert über die geheime Kampagne der CIA und den Versuch, das Ministerium für Staatssicherheit in Peking zu Fall zu bringen, unterrichtet.“"
                                            },
                                            {
                                                "example_id": "7e125da0-b452-4438-90ba-832ba0822dac",
                                                "sense_id": "a07c1efe-ee73-3361-bb2f-0ea074b313ee",
                                                "text": "„Die Repräsentation des Ministeriums für Staatssicherheit in den 1980er Jahren in Filmen des Fernsehens der DDR.“"
                                            },
                                            {
                                                "example_id": "7738c18d-0f72-4243-ae72-a62b5216963b",
                                                "sense_id": "a07c1efe-ee73-3361-bb2f-0ea074b313ee",
                                                "text": "„Sie können jedoch nichtöffentlich sein, wenn die Mehrheit der anwesenden Abgeordneten dafür stimmt oder der Vorsitzende es für die Staatssicherheit für erforderlich erachtet.“"
                                            },
                                            {
                                                "example_id": "4ac3688d-df53-43c6-bcfd-88b745829ecb",
                                                "sense_id": "a07c1efe-ee73-3361-bb2f-0ea074b313ee",
                                                "text": "„Denn Regelungsgegenstand dieser Normen sei nicht die Meinung als solche, sondern der Schutz der Staatssicherheit als Gemeinschaftsgut.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7848b876-17b1-3312-8600-ca76ac2cc063",
                                        "entry_id": "63627e76-fb9f-3971-9fc6-b12a62c6408c",
                                        "glosses": [
                                            "für den Schutz des Staates zuständiger Geheimdienst oder -polizei; Stasi"
                                        ],
                                        "tags": [
                                            "especially",
                                            "short-form"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4c29ab26-89b8-4388-b8b5-c2b2df72caaa",
                                                "sense_id": "7848b876-17b1-3312-8600-ca76ac2cc063",
                                                "text": "„Ria ist zehn Jahre alt, als ihre Eltern von der Staatssicherheit abgeholt werden.“"
                                            },
                                            {
                                                "example_id": "b0ba3247-fecd-406f-9171-4ee4488ba676",
                                                "sense_id": "7848b876-17b1-3312-8600-ca76ac2cc063",
                                                "text": "„Georg Moll verweigerte die Erklärung zur Zusammenarbeit mit der Staatssicherheit.“"
                                            },
                                            {
                                                "example_id": "c426eacc-c1a8-40b4-a8e8-36706aff0ae7",
                                                "sense_id": "7848b876-17b1-3312-8600-ca76ac2cc063",
                                                "text": "„Die Staatssicherheit agierte in der DDR nach 1961, wie Katharina Lenski in ihrer Studie zeigen kann, weniger als Geheimpolizei, sondern vielmehr als Geheimbürokratie.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "e5a29253-af9a-33e5-9091-d7de0e3f3d36",
                                        "entry_id": "63627e76-fb9f-3971-9fc6-b12a62c6408c",
                                        "glosses": [
                                            "vom Staat ausgezahlter Kredit zur Bedarfsdeckung"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    }
