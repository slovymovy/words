                        "glosses": [
                            "Chancre d’inoculation de la trypanosomiase africaine (maladie du sommeil), correspondant au point de piqûre de la mouche tsé-tsé et causé par la multiplication des trypanosomes in situ."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a4be231-1cee-4266-b319-70b2261b5234",
                                "sense_id": "5a23996b-1df3-302b-b5f6-6c7ac8aefad5",
                                "text": "La maladie était révélée par une fièvre élevée associée à une polyadénopathie et à deux lésions ulcérocroûteuses (trypanomes) à la face interne de chaque cuisse."
                            }
                        ]
