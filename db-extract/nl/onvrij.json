                                        ],
                                        "examples": [
                                            {
                                                "example_id": "556ef2e2-6064-4145-bef1-7bd5ed40767b",
                                                "sense_id": "5d1913d4-f110-3558-9d5c-9b406fa4641b",
                                                "text": "I bound the splint to my leg."
                                            },
                                            {
                                                "example_id": "66e16449-be01-4ddc-b97a-2bc24c5585f6",
                                                "sense_id": "5d1913d4-f110-3558-9d5c-9b406fa4641b",
                                                "text": "I had bound the splint with duct tape."
                                            },
                                            {
                                                "example_id": "1167d91a-3435-4d66-9ac3-ee26099e80db",
                                                "sense_id": "5d1913d4-f110-3558-9d5c-9b406fa4641b",
                                                "text": "The maidens have bound silver snoods about their hair, with gold spangles, and pendent flames (Flammen), that is, sparkling hair-drops : but of their mother's headgear who shall speak?"
                                            },
                                            {
                                                "example_id": "19c7e7fa-59c1-440b-a7a0-27ba18d71437",
                                                "sense_id": "5d1913d4-f110-3558-9d5c-9b406fa4641b",
                                                "text": "“[…] Captain Markam had been found lying half-insensible, gagged and bound, on the floor of the sitting-room, his hands and feet tightly pinioned, and a woollen comforter wound closely round his mouth and neck ; whilst Mrs. Markham's jewel-case, containing valuable jewellery and the secret plans of Port Arthur, had disappeared.[…]”"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bound",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "881cb6e8-d90b-3d0b-9e09-2454d0a084e0",
                                        "entry_id": "2eb808d5-c53c-3055-90e7-b899b908d967",
