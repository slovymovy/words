                "senses": [
                    {
                        "sense_id": "7bd19fd2-4edc-3b86-b765-76e71244a663",
                        "entry_id": "f938b22d-8c04-3282-b3e1-ab430a66bc7c",
                        "glosses": [
                            "japanische Stadt im Südwesten Honshus mit ca. 1,4 Millionen Einwohnern, Verwaltungssitz der gleichnamigen Präfektur"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b75dc08b-a277-4b47-a590-a1139758b399",
                                "sense_id": "7bd19fd2-4edc-3b86-b765-76e71244a663",
                                "text": "Kyoto der Hort der japanischen Teetradition."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "275d9ca8-b446-3dac-85e8-209d084a2a57",
                        "entry_id": "f938b22d-8c04-3282-b3e1-ab430a66bc7c",
                        "glosses": [
                            "das Kyoto-Protokoll, ein Abkommen zum Klimaschutz"
                        ],
                        "tags": [
                            "colloquial",
                            "metonymically"
                        ],
                        "examples": [
                            {
                                "example_id": "bfa884bb-08e7-4093-99b8-bd884d2c0c15",
                                "sense_id": "275d9ca8-b446-3dac-85e8-209d084a2a57",
                                "text": "Es scheint, Japan habe aus Kyoto eine Lehre gezogen."
                            },
                            {
                                "example_id": "8c46a52f-cb4d-4407-866b-ec8e5f6b618b",
                                "sense_id": "275d9ca8-b446-3dac-85e8-209d084a2a57",
                                "text": "„Unter Kyoto kann ein Betrieb entscheiden, keine emissionsvermeidenden Maßnahmen zu setzen und stattdessen ausreichend Emissionszertifikate zu kaufen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
