                            "comment": "informeel gebruik"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "a greeting used when arriving or departing"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "hello",
                                "target_lang_sense_clarification": "greeting upon arrival"
                            },
                            {
                                "target_lang_word": "goodbye",
                                "target_lang_sense_clarification": "greeting upon departure"
                            },
                            {
                                "target_lang_word": "bye",
