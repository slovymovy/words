                "senses": [
                    {
                        "sense_id": "9c5d5823-2a50-37ee-8d17-6eb3aeeb8269",
                        "entry_id": "0ff4c2cf-63c1-3cef-b669-34af0a263214",
                        "glosses": [
                            "Ablehnung oder Unzufriedenheit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a699c360-117f-413c-8bfb-dc3310556e50",
                                "sense_id": "9c5d5823-2a50-37ee-8d17-6eb3aeeb8269",
                                "text": "„Geometrische Formen sind nicht bloss wohlgefällig oder missfällig, sondern ihre Wohlgefälligkeit oder Missfälligkeit hat zugleich jedesmal einen bestimmten Charakter, sie besitzt jedesmal zugleich eine bestimmte Färbung.“"
                            },
                            {
                                "example_id": "3a3cb515-66a8-4836-b3f3-813c216dd3d6",
                                "sense_id": "9c5d5823-2a50-37ee-8d17-6eb3aeeb8269",
                                "text": "„Trotz der Missfälligkeit jener Zeit, welche wir namentlich an den Köpfen zu deln haben, muss die Sculptur als ein originelles, tüchtiges Werk bezeichnet werden.“"
                            },
                            {
                                "example_id": "282f35f4-c395-4987-89d2-d4dd9263e08f",
                                "sense_id": "9c5d5823-2a50-37ee-8d17-6eb3aeeb8269",
                                "text": "„In diesem Fall entsteht der Ärger nicht – wie überwiegend geäußert – aufgrund einiger Missfälligkeiten am Medienprodukt, sondern es ist gerade umgekehrt: Das Medienprodukt gefällt, und man ärgert sich, es verpasst zu haben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
