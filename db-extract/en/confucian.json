                                "target_senses": [
                                    {
                                        "sense_id": "1ee73075-ee22-3a60-bf85-9ecb14a58edf",
                                        "entry_id": "ad3ea71c-c66a-329e-b23a-a2313f3bd528",
                                        "glosses": [
                                            "betrekking hebbend op de leer van Confucius"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09836399-b062-48bd-8342-2f133a43811a",
                                                "sense_id": "1ee73075-ee22-3a60-bf85-9ecb14a58edf",
                                                "text": "Wie in één klap heel veel vliegen wil slaan gaat naar de Lotus Pond in Kaohsiung in het zuiden van Taiwan. Hier staat een hele serie tempels op een hele kleine oppervlakte. De Cijin tempel, de pagode van de draak en de tijger en de nieuwe confuciaanse tempel liggen allemaal op loopafstand van elkaar, idyllisch aan het water."
                                            },
                                            {
                                                "example_id": "ffd2643e-3cf0-4bd6-a53e-8a7d2c8aab02",
                                                "sense_id": "1ee73075-ee22-3a60-bf85-9ecb14a58edf",
                                                "text": "Aanvankelijk komt die kennismaatstok wat houterig over, maar gaandeweg het boek blijkt het een doeltreffende manier om de meeste uiteenlopende kennispatronen te vergelijken: prehistorische streepjespatronen, Confuciaanse [sic!] filosofie, Indiase taalkunde, Griekse geometrie, Chinese anatomie, Arabische tekstkritiek, Afrikaanse chronologieën, Polynesische genealogieën, Ethiopische kronieken, islamitische astronomie, pre-columbiaanse kalenders en wat al niet meer worden allemaal op hun kennismerites beoordeeld."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2b52fbc9-3098-466b-bf2b-29396bd01c59",
                        "source_entry_id": "60987dbf-8416-3b40-a324-f7d578eb00b7",
