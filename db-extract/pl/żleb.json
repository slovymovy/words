                "senses": [
                    {
                        "sense_id": "8e97169a-bb97-34bb-943d-af9b4696bd8a",
                        "entry_id": "ce250523-932e-3d8a-b68c-2e5b88081385",
                        "glosses": [
                            "wcięcie w górskim stoku ze stromymi ścianami"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cde923c4-4ec1-4e86-a067-5dbfa08ececb",
                                "sense_id": "8e97169a-bb97-34bb-943d-af9b4696bd8a",
                                "text": "Musieliśmy uciekać ze żlebu, którym teraz płynęła wartko woda ze stopionego śniegu, zmieszana z popiołem i ziemią"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "549729e1-3e11-42b8-95ba-382b4aa334c0",
                        "source_entry_id": "ce250523-932e-3d8a-b68c-2e5b88081385",
                        "source_sense_id": "8e97169a-bb97-34bb-943d-af9b4696bd8a",
                        "target_lang_word": "couloir",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "couloir",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "448ff4a9-105a-3ef0-851f-96648e7d831d",
                                        "entry_id": "21532ef3-9f8c-34b6-9b5e-8f0052d836a7",
                                        "glosses": [
                                            "A steep gorge along a mountainside."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cca7dfb2-d2df-46e2-91ae-3eb742bf574d",
                                                "sense_id": "448ff4a9-105a-3ef0-851f-96648e7d831d",
                                                "text": "Those deep, dark slots in a mountain known as couloirs are often the most obvious routes of ascent."
                                            },
                                            {
                                                "example_id": "85351098-f246-4f61-aa24-0a500bdfcbd0",
                                                "sense_id": "448ff4a9-105a-3ef0-851f-96648e7d831d",
                                                "text": "Looking up the face I could see directly into the Japanese and Hornbein couloirs, an almost direct 9000 feet to the summit."
                                            },
                                            {
                                                "example_id": "ad8468f9-71bf-41fa-b700-8ecf9e707147",
                                                "sense_id": "448ff4a9-105a-3ef0-851f-96648e7d831d",
                                                "text": "Ascend a long, easy snow couloir back left to the crest of Cassin Ridge at 17700 feet, where there is a campsite."
                                            },
                                            {
                                                "example_id": "71627040-5ce2-45a5-bf3b-2982d4cc812b",
                                                "sense_id": "448ff4a9-105a-3ef0-851f-96648e7d831d",
                                                "text": "2002, American Alpine Club Safety Committee, Alpine Club of Canada Safety Committee, Accidents in North American Mountaineering, Issue 55, page 58,\nWhen they approached the couloir shortly before 0300, the snow was firm enough for them to use crampons."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "34422008-3871-37a6-93ec-b9b00839005c",
                                        "entry_id": "21532ef3-9f8c-34b6-9b5e-8f0052d836a7",
                                        "glosses": [
                                            "A corridor or passage."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "27aa37b2-42ef-4d71-add8-4fcf32579796",
                                                "sense_id": "34422008-3871-37a6-93ec-b9b00839005c",
                                                "text": "It was a hole, in the fence, a large irregular hole, caused by numberless winds, numberless rains, or by a boar, or by a bull, flying, pursuing, a wild boar, a wild bull, blind with fear, blind with rage, or who knows perhaps with carnal desire, crashing at this point, through the fence, weakened by numberless winds, numberless rains. Through this hole I passed, without hurt, or damage to my pretty uniform, and found myself looking about me, for I had not yet recovered my aplomb, in the couloir."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "916089c4-952b-4a4e-ae7d-771bf84049ec",
                        "source_entry_id": "ce250523-932e-3d8a-b68c-2e5b88081385",
                        "source_sense_id": "8e97169a-bb97-34bb-943d-af9b4696bd8a",
                        "target_lang_word": "кулуар",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "кулуар",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "ede0562a-c6e1-3728-8d7b-def3e7122d93",
                                        "entry_id": "3403fc5f-d082-3a97-a17e-78c36c89f76f",
                                        "glosses": [
                                            "подсобное помещение (боковой зал, коридор) в общественном здании, прилегающее к фойе и залу и предназначенное для отдыха в перерывах между заседаниями или в антрактах, для неофициальных встреч, обмена мнениями, работы журналистов"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "78fee070-2e2f-4bcc-9dc9-590fdf56e223",
                                                "sense_id": "ede0562a-c6e1-3728-8d7b-def3e7122d93",
                                                "text": "В кулуар приглашены только избранные."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0d08677d-150a-392e-a1de-15c2c8cd3e4d",
                                        "entry_id": "3403fc5f-d082-3a97-a17e-78c36c89f76f",
                                        "glosses": [
                                            "перен. книжн. полит., среда осведомлённых политических и общественных, прежде всего парламентских кругов, а также неофициальное общение в ней"
                                        ],
                                        "tags": [
                                            "только мн."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "124a684d-12ad-4b79-a2e9-d3e1fe3f12b1",
                                                "sense_id": "0d08677d-150a-392e-a1de-15c2c8cd3e4d",
                                                "text": "Известно из кулуаров."
                                            },
                                            {
                                                "example_id": "12e7a50c-b6ca-4c9a-bfbc-bb458fa18a35",
                                                "sense_id": "0d08677d-150a-392e-a1de-15c2c8cd3e4d",
                                                "text": "Слухи идут из парламентских кулуаров."
                                            },
                                            {
                                                "example_id": "49bde1d0-1a4c-4651-94f3-c66a8e55f45c",
                                                "sense_id": "0d08677d-150a-392e-a1de-15c2c8cd3e4d",
                                                "text": "В кулуарах съезда обсуждали выступление главы партии."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "33d3cd4a-d9f5-30cb-a443-c0ed4c37afbd",
                                        "entry_id": "3403fc5f-d082-3a97-a17e-78c36c89f76f",
                                        "glosses": [
                                            "геол. ложбина на крутом, лишённом растительности склоне горы, определяющая пути сброса снега (лавины), воды или камней"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87d36cf4-a263-4dc6-8413-76dd30004799",
                                                "sense_id": "33d3cd4a-d9f5-30cb-a443-c0ed4c37afbd",
                                                "text": "В гребне цирка видны узкие скальные ворота перевала, к которому ведет снежно-осыпной кулуар (30°, 150 м).]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
