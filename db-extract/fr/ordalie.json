                        "target_lang_word": "Gottesurteil",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gottesurteil",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "21bdfa2e-94b0-3e87-bd96-93f324baeb9f",
                                        "entry_id": "16ef4981-721a-3b73-ab6a-76d451ca419a",
                                        "glosses": [
                                            "ein mittelalterliches Beweismittel wie ein Zweikampf oder ein Losentscheid vor Gericht, wenn andere Beweismittel nicht vorhanden waren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36230b77-39e9-4440-b3a2-0a278846fb54",
                                                "sense_id": "21bdfa2e-94b0-3e87-bd96-93f324baeb9f",
                                                "text": "Im Mittelalter konnten Zweikämpfe oder Losentscheidungen als Gottesurteil vor Gericht herangezogen werden."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c8b2256f-b254-489e-8516-46dd230155d8",
                        "source_entry_id": "a7c626e2-ab1e-3a7a-baf0-e3b322eeaa6f",
                        "source_sense_id": "442dfcae-7741-36b2-9894-fbfd0f939132",
                        "source_sense_description": "épreuve",
                        "target_lang_word": "Feuerprobe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Feuerprobe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4162cbbb-ae04-347f-8fca-ed14ca87c555",
                                        "entry_id": "c4652c37-1545-31dc-afbc-e06478188e0a",
                                        "glosses": [
                                            "mittelalterliches Verfahren für ein Gottesurteil, bei dem Körperteile des Angeklagten (beispielsweise Füße, Hände) kurzzeitig unerträglicher Hitze ausgesetzt wurden. Verheilte die Wunde schnell (beispielsweise innerhalb von drei Tagen), so galt der Angeklagte als unschuldig, anderenfalls wurde er bestraft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e4bbaba4-bfe8-424c-923c-c04b1063d0e7",
                                                "sense_id": "4162cbbb-ae04-347f-8fca-ed14ca87c555",
                                                "text": "Bei der Feuerprobe musste man über glühende Kohlen laufen oder ein glühendes Eisen tragen. Heilte die Wunde, ohne zu eitern, galt das als Unschuldsbeweis."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "fec6b63d-0c53-3e2d-874a-c7dd870033a2",
                                        "entry_id": "c4652c37-1545-31dc-afbc-e06478188e0a",
                                        "glosses": [
                                            "Situation / Test, in der eine Person zeigen soll, dass sie hohen Anforderungen / Belastungen gewachsen ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "02e02a28-bdc5-4a19-97f4-89cabbf5fdb0",
                                                "sense_id": "fec6b63d-0c53-3e2d-874a-c7dd870033a2",
                                                "text": "Mit etwas Glück und großem Kampfgeist hat der Nachwuchs der deutschen [Fußball-]Weltmeister die Feuerprobe gegen heißblütige Chilenen [beim Confed-Cup 2017] bestanden."
                                            },
                                            {
                                                "example_id": "f2807f5f-7860-488a-9a19-a35eee0e2cad",
                                                "sense_id": "fec6b63d-0c53-3e2d-874a-c7dd870033a2",
                                                "text": "Die Feuerprobe für die [aus den Parlamenten ausgeschiedene] FDP und ihren Parteivorsitzenden ist die Landtagswahl in Nordrhein-Westfalen."
                                            },
                                            {
                                                "example_id": "12beebf6-ee22-45c5-a860-ad34926b6625",
                                                "sense_id": "fec6b63d-0c53-3e2d-874a-c7dd870033a2",
                                                "text": "Yehudi Menuhin bezeichnete die 24 Capricen für Violine solo von Niccolò Paganini einmal als „das Neue Testament der Geiger“. Jeder Virtuose muss diesen Parcours geigerischer Höchstschwierigkeiten beherrschen. Er ist die Feuerprobe, die ultimative Herausforderung."
                                            },
                                            {
                                                "example_id": "d9457f66-bd97-4146-a0ec-9691b5d06d6b",
                                                "sense_id": "fec6b63d-0c53-3e2d-874a-c7dd870033a2",
                                                "text": "[…] die Debatte gestern Nachmittag verlief [im niederländischen Parlament …] heftig. Doch Khadija Arib bestand diese Feuerprobe mit Bravour. Souverän leitete die Präsidentin die Debatte, sie ließ sich durch nichts und niemanden aus der Ruhe bringen […]."
                                            },
                                            {
                                                "example_id": "69e808a3-6610-48d7-8bab-607c4d85962b",
                                                "sense_id": "fec6b63d-0c53-3e2d-874a-c7dd870033a2",
                                                "text": "Für Pfarrerin Minder geht's zur Feuerprobe […]. Die neue Pfarrerin Yvonne Minder ist unterwegs zu ihrer ersten Andacht im Alters- und Pflegeheim Regenbogen. Wie werden die Dorfältesten wohl auf die junge, zugezogene Geistliche reagieren?"
                                            },
                                            {
                                                "example_id": "f55f3c00-3667-47aa-9826-cd18edabb1a3",
                                                "sense_id": "fec6b63d-0c53-3e2d-874a-c7dd870033a2",
                                                "text": "Kaum fertig gebaut, wartet auf die Kreuzfahrtschiffe der Meyer Werft die erste Feuerprobe: Die Riesenschiffe müssen über die vergleichsweise schmale Ems manövriert werden."
                                            },
                                            {
                                                "example_id": "eb56c8bd-9e10-40c1-9ddd-b6da96a79524",
                                                "sense_id": "fec6b63d-0c53-3e2d-874a-c7dd870033a2",
                                                "text": "Das Kapital für die Serienfertigung konnten sie bei der Crowdfunding-Plattform Startnext einwerben. „Unsere eigentliche Feuerprobe“, sagt Niklas Keßler. Innerhalb einer Laufzeit von knapp acht Wochen sollten 7500 Euro zusammenkommen – andernfalls hätten die beiden einpacken können."
                                            },
                                            {
                                                "example_id": "a286a674-aac2-4d16-bd58-60391bd9173b",
                                                "sense_id": "fec6b63d-0c53-3e2d-874a-c7dd870033a2",
                                                "text": "Zwar gibt es in Deutschland seit kurzer Zeit eine neues Gesetz zum Schutz von Urheberrechten, die Auslegung, Interpretation und Verfassungsmäßigkeit dieses Gesetzes steht aber noch vor der Feuerprobe, weil es in Konkurrenz zu erheblich höheren und durch das Grundgesetz geschützten Rechten steht."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9369534b-2811-4871-bc38-ef22d75a833c",
                        "source_entry_id": "a7c626e2-ab1e-3a7a-baf0-e3b322eeaa6f",
                        "source_sense_id": "442dfcae-7741-36b2-9894-fbfd0f939132",
