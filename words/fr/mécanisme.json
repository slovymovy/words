                {
                    "sense_id": "2d8ced12-7658-3663-9cf7-c06d3a5c756c",
                    "sense_definition": "Doctrine philosophique selon laquelle tous les phénomènes de la nature s'expliquent par les seules lois du mouvement et de la matière.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "philosophie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le <w>mécanisme</w> cartésien s'oppose fermement aux explications téléologiques des phénomènes naturels."
