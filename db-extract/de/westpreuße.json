                "senses": [
                    {
                        "sense_id": "b496cacf-1aa3-315e-9aa8-2caecb76bcb8",
                        "entry_id": "b3c61b83-f14c-38f1-9377-c61c2b2e107f",
                        "glosses": [
                            "Bewohner Westpreußens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "16eddc68-7f9d-4b64-ac01-2cc0a3d47bce",
                                "sense_id": "b496cacf-1aa3-315e-9aa8-2caecb76bcb8",
                                "text": "„Ein Westpreuße vom Schädel bis zur Sohle, das sieht man auf den ersten Blick.“"
                            },
                            {
                                "example_id": "ec21a397-2d64-4ec5-a4e6-f32479c8ef39",
                                "sense_id": "b496cacf-1aa3-315e-9aa8-2caecb76bcb8",
                                "text": "„Ein Westpreuße war, als Dreijährig-Freiwilliger, 1864 in sein Regiment eingetreten, hatte 1866 als Unterofficier den Feldzug gegen Oesterreich mitgemacht und bei Trautenau, Königsgrätz und Tobitschau mitgekämpft.“"
                            }
                        ],
