                                        "entry_id": "c0ff1e09-8d8a-3bc6-b441-204f2e7be6c9",
                                        "glosses": [
                                            "aquele que se apossa de alguma coisa por meio da força ou da fraude"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b1b03ca-6766-49b4-a05a-f701ac1ad973",
                                                "sense_id": "435dbfdf-8f85-30ba-8b5b-b10b04c15593",
                                                "text": "Mas não é culpa de Harryhausen se seus bonecos viraram, nas mãos do usurpador Don Mancini, assassinos diabólicos como Chuck."
                                            }
                                        ]
                                    }
