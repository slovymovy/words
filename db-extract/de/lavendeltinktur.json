                    {
                        "sense_id": "ba89cdf6-6d0b-3228-8a20-86c01e5cc125",
                        "entry_id": "e5fcbe72-f3fc-33a3-a163-d5fc0b01ff42",
                        "glosses": [
                            "mit Lavendel hergestellte Tinktur"
