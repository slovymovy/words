                "forms": [
                    {
                        "form_id": "f1be9ea1-ab50-466e-967a-36056230ce97",
                        "entry_id": "160f5d02-b5a7-3172-a32f-1c71876d6075",
                        "tags": [
                            "plural"
                        ],
                        "form": "teguments"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3f94cdbd-d345-369a-b426-aaa7f1e8e07b",
                        "entry_id": "160f5d02-b5a7-3172-a32f-1c71876d6075",
                        "glosses": [
                            "Something which covers; a covering or coating."
                        ],
                        "tags": [
                            "uncommon"
                        ],
                        "examples": [
                            {
                                "example_id": "fd8d3b79-e823-4561-ba35-1621d3448348",
                                "sense_id": "3f94cdbd-d345-369a-b426-aaa7f1e8e07b",
                                "text": "1658: But in the Homericall Urne of Patroclus, whatever was the solid Tegument, we finde the immediate covering to be a purple peece of silk — Sir Thomas Browne, Urne-Burial (Penguin 2005, p. 21)"
                            }
                        ]
                    },
                    {
                        "sense_id": "c6fb2ac6-d09c-30d3-be55-c37089a265b4",
                        "entry_id": "160f5d02-b5a7-3172-a32f-1c71876d6075",
                        "glosses": [
                            "A natural covering of the body or of a bodily organ; an integument."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "526eb7d9-0716-4567-b30d-9aa0c0ac7cf4",
                        "source_entry_id": "160f5d02-b5a7-3172-a32f-1c71876d6075",
                        "source_sense_description": "something which covers",
                        "target_lang_word": "couverture",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "couverture",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "977a3fd0-4653-3de8-a9f8-7a561645cf39",
                                        "entry_id": "ab87ffdd-ddd6-3aea-b60b-e87afbae0f77",
                                        "glosses": [
                                            "Grande pièce d’étoffe épaisse couvrant le lit, se plaçant au-dessus des draps."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "73f1c607-fde8-485c-a8ac-76081d0d65e9",
                                                "sense_id": "977a3fd0-4653-3de8-a9f8-7a561645cf39",
                                                "text": "Il se déshabilla en hâte, se blottit sous les couvertures."
                                            },
                                            {
                                                "example_id": "74c17240-15fb-4575-9107-c552608e1bce",
                                                "sense_id": "977a3fd0-4653-3de8-a9f8-7a561645cf39",
                                                "text": "Il saisit Héloïse, l'enlève entre ses bras […], et la transporte doucement, parmi les couvertures qu'il rabat sur elle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e489e86d-2723-334a-80f4-00e7177b9977",
                                        "entry_id": "ab87ffdd-ddd6-3aea-b60b-e87afbae0f77",
                                        "glosses": [
                                            "Première page d’un ouvrage imprimé."
                                        ],
                                        "tags": [
                                            "Imprimerie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d7b2e2f1-698a-45eb-8bef-0dbf3a66c72b",
                                                "sense_id": "e489e86d-2723-334a-80f4-00e7177b9977",
                                                "text": "Je me retourne et je vois Jacques Yonnet, coiffé d'une viscope à carreaux et me tendant un livre d’Ivan Chtcheglov dont la couverture est une colorisation du Paris de ma jeunesse en noir et blanc."
                                            },
                                            {
                                                "example_id": "4e14283f-4f5b-47c2-bff4-5e1500ed7db3",
                                                "sense_id": "e489e86d-2723-334a-80f4-00e7177b9977",
                                                "text": "Soulignant qu’il était inutile que les Français s’en préoccupent plus que cela (“Nous avons une élection dans 25 jours, alors pourquoi perdre notre temps à discuter d’un programme?” estime-t-il), Emmanuel Macron a précisé qu’il s’adressera à eux prochainement directement par l’intermédiaire d’une nouvelle couverture dans Paris Match."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d7fc456c-745d-39e0-af66-c9c294e7a542",
                                        "entry_id": "ab87ffdd-ddd6-3aea-b60b-e87afbae0f77",
                                        "glosses": [
                                            "Partie extérieure d’un livre servant à le protéger."
                                        ],
                                        "tags": [
                                            "Imprimerie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5724c5bb-ab04-4f8d-ac65-5a7b0c97148d",
                                                "sense_id": "d7fc456c-745d-39e0-af66-c9c294e7a542",
                                                "text": "Le relieur-doreur décore les couvertures de livres à partir de fines feuilles d’or."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "51c7eb54-e533-3828-8867-6d5b3fd7a477",
                                        "entry_id": "ab87ffdd-ddd6-3aea-b60b-e87afbae0f77",
                                        "glosses": [
                                            "Partie extérieure de la toiture."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c90c23b-1c2b-4e9e-aaea-df569ef45d7b",
                                                "sense_id": "51c7eb54-e533-3828-8867-6d5b3fd7a477",
                                                "text": "Une petite pluie froide faisait furtivement briller la couverture d’un appentis et tinter sur le zinc, à de rares intervalles, de pesantes gouttes d'eau qui s’échappaient d’une chanlatte percée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8efe0673-50b1-3d92-93d8-e81d7f410fe5",
                                        "entry_id": "ab87ffdd-ddd6-3aea-b60b-e87afbae0f77",
                                        "glosses": [
                                            "Garantie de protection donnée par un assureur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8278d4b-f2b7-4ead-b418-9694103ee861",
                                                "sense_id": "8efe0673-50b1-3d92-93d8-e81d7f410fe5",
                                                "text": "L’assurance santé offre une couverture contre les maladies et les blessures."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ad0a7c35-c8c8-3891-a300-707556d1df6d",
                                        "entry_id": "ab87ffdd-ddd6-3aea-b60b-e87afbae0f77",
                                        "glosses": [
                                            "Garantie donnée pour assurer un paiement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8739edbb-3e16-436e-94d9-568c5814cc8f",
                                                "sense_id": "ad0a7c35-c8c8-3891-a300-707556d1df6d",
                                                "text": "Ce négociant me doit beaucoup, mais j’ai une bonne couverture."
                                            },
                                            {
                                                "example_id": "59102a9d-7cab-43de-9f1e-d10173475ed8",
                                                "sense_id": "ad0a7c35-c8c8-3891-a300-707556d1df6d",
                                                "text": "J’ai tiré sur vous une lettre de change, acceptez-la ; je vous en enverrai la couverture avant l’échéance, Je vous ferai passer les fonds avant l’échéance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "55d989b5-a898-331c-af71-b13a1724846b",
                                        "entry_id": "ab87ffdd-ddd6-3aea-b60b-e87afbae0f77",
                                        "glosses": [
                                            "Dépôt de titres ou d’espèces, que l’agent de change exige du client qui donne des ordres pour des marchés à terme."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "169d1ea1-4839-3290-8404-d104b3c9c599",
                                        "entry_id": "ab87ffdd-ddd6-3aea-b60b-e87afbae0f77",
                                        "glosses": [
                                            "Ce qui sert à cacher ou à dissimuler."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "785d1666-83fb-46fc-8d6c-08c4faea8b64",
                                                "sense_id": "169d1ea1-4839-3290-8404-d104b3c9c599",
                                                "text": "Chacun avait, chacun a encore à l'esprit la célèbre formule de Kipling sur le « fardeau de l'Homme blanc ». Mais cette notion était considérée comme une couverture quelque peu hypocrite, un écran (auto) justificatif d'un phénomène plus profond qu'il appartenait aux historiens d'éclairer."
                                            },
                                            {
                                                "example_id": "c5e33b5c-d9ff-4e1a-a393-5de979092893",
                                                "sense_id": "169d1ea1-4839-3290-8404-d104b3c9c599",
                                                "text": "Par ces décisions, les autorités françaises accordaient aux Allemands des moyens indispensables à la réalisation de leur dessein, car, compte tenu des effectifs de police limités dont ils disposaient en France, ils n'auraient pu accomplir ces actions seuls, ainsi qu'une « couverture légale »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "275a05b4-b193-399e-8c38-6d5054e2eef7",
                                        "entry_id": "ab87ffdd-ddd6-3aea-b60b-e87afbae0f77",
                                        "glosses": [
                                            "Fausse identité endossée ponctuellement par un agent secret ou un policier en mission d’infiltration."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a1de21b5-7481-4ec3-ba87-c50c45595cd5",
                                                "sense_id": "275a05b4-b193-399e-8c38-6d5054e2eef7",
                                                "text": "Il a publié le nom de jeune fille, qu’elle utilisait comme couverture dans son métier d’agent secret."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a71c5ab-5d19-3db2-abd0-edc97d913263",
                                        "entry_id": "ab87ffdd-ddd6-3aea-b60b-e87afbae0f77",
                                        "glosses": [
                                            "Ensemble des moyens militaires servant à se protéger d’une attaque."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d65bfc7b-7989-40c6-91f0-852f210f52d1",
                                                "sense_id": "3a71c5ab-5d19-3db2-abd0-edc97d913263",
                                                "text": "[…], et le 2 août au matin, le 29ᵉ Dragons rejoint la 56ᵉ Division de cavalerie chargée d'assurer la couverture dans la région de Mézières. Pendant trois jours, il demeure « en attente » à Guignicourt-sur-Vence : attente longue à tous, car les nouvelles sont rares […]."
                                            },
                                            {
                                                "example_id": "9cc51409-e84d-4c64-94c7-febe763e9753",
                                                "sense_id": "3a71c5ab-5d19-3db2-abd0-edc97d913263",
                                                "text": "En général, sur le plan offensif, la brigade déploie d’abord une force de reconnaissance légère sur le front pour trouver l’ennemi, puis une force de couverture lourde pour définir et façonner l’ennemi à l’aide de tirs directs, et ce, en vue de la destruction éventuelle de l’ennemi par le gros des troupes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6739ecac-0068-3e95-987c-207d11acfc5b",
                                        "entry_id": "ab87ffdd-ddd6-3aea-b60b-e87afbae0f77",
                                        "glosses": [
                                            "Couche végétale recouvrant le sol."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "547cc3d6-5699-4e4e-b520-830bb1ecfa6c",
                                                "sense_id": "6739ecac-0068-3e95-987c-207d11acfc5b",
                                                "text": "Dans les dépressions où leur puissance était grande, les prêles ont protégé les roches meubles sous-jacentes, tandis que l’érosion déblayait celles-ci là où cette couverture protectrice était absente ou moins épaisse."
                                            },
                                            {
                                                "example_id": "4fea7fd3-8de2-4bf2-bacd-0570f83bdf3b",
                                                "sense_id": "6739ecac-0068-3e95-987c-207d11acfc5b",
                                                "text": "En saison sèche, les Garde-bœuf suivent les feux de forêt et de savane, pour manger les animaux mis à nu par la disparition de la couverture herbacée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "01ea2883-58c7-328d-aff7-a4badb637b9c",
                                        "entry_id": "ab87ffdd-ddd6-3aea-b60b-e87afbae0f77",
                                        "glosses": [
                                            "Paillage."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "21c7e3c9-cc15-467a-9f31-7d658abf2dcb",
                                                "sense_id": "01ea2883-58c7-328d-aff7-a4badb637b9c",
                                                "text": "Le sorgho, planté en succession de la culture commerciale, est desséché sur pied 8 à 10 jours avant de semer le cotonnier (…), afin d'obtenir une couverture morte dans laquelle est effectué le semis."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7e480254-4c97-348c-be00-3d617bc39628",
                                        "entry_id": "ab87ffdd-ddd6-3aea-b60b-e87afbae0f77",
                                        "glosses": [
                                            "La partie d’une surface, d’un territoire, d’une population, d’un ensemble qui est concerné par un service, une modification ou une intervention quelconque, souvent exprimé en termes d’un pourcentage ou d’une fraction."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "18cc4665-f9b7-36b3-9e8e-74e62e3a55c4",
                                        "entry_id": "ab87ffdd-ddd6-3aea-b60b-e87afbae0f77",
                                        "glosses": [
                                            "Zones où peut être activé service téléphonique ou internet, ou un émetteur de radio ou télévision."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d27ef45b-bff7-47d5-8212-d7849af7a4d9",
                                                "sense_id": "18cc4665-f9b7-36b3-9e8e-74e62e3a55c4",
                                                "text": "La couverture des réseaux de télécommunications mobiles a augmenté considérablement ces dernières années."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e535c4ee-f42b-3132-8bb5-7b9463060d23",
                                        "entry_id": "ab87ffdd-ddd6-3aea-b60b-e87afbae0f77",
                                        "glosses": [
                                            "Action d'enquêter puis de relater l'enquête par les journaux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d4b9a66f-ffa1-418c-9370-e4af723aa230",
                                                "sense_id": "e535c4ee-f42b-3132-8bb5-7b9463060d23",
                                                "text": "Son traitement, sa couverture médiatique pourront être assurés par un fait-diversier, journaliste en charge des faits-divers, un enquêteur spécialisé dans les affaires politico-financières ou un chroniqueur judiciaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f5f54356-ffc8-376b-a359-16ea741e0187",
                                        "entry_id": "ab87ffdd-ddd6-3aea-b60b-e87afbae0f77",
                                        "glosses": [
                                            "Une des plumes qui recouvrent la base des rémiges et des rectrices.  ^([1])"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0348d820-33fc-3a33-a99c-95ee548f4c6b",
                                        "entry_id": "ab87ffdd-ddd6-3aea-b60b-e87afbae0f77",
                                        "glosses": [
                                            "Partie non visible du boîtier de la serrure, opposée au palastre."
                                        ],
                                        "tags": [
                                            "Serrurerie"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "60accb85-76f5-3032-b668-0fbf6e3c3bc2",
                                        "entry_id": "ab87ffdd-ddd6-3aea-b60b-e87afbae0f77",
                                        "glosses": [
                                            "Matériau à irradier placé à la périphérie du cœur d’un réacteur à fission."
                                        ],
                                        "tags": [
                                            "Technologie des réacteurs nucléaires"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5b92f061-5568-3f3d-95aa-7f1fda1ca66a",
                                        "entry_id": "ab87ffdd-ddd6-3aea-b60b-e87afbae0f77",
                                        "glosses": [
                                            "Équipement entourant le plasma thermonucléaire, destiné à absorber les neutrons issus des réactions de fusion et assurant la protection des structures et des composants, contribuant également à celle des personnes."
                                        ],
                                        "tags": [
                                            "Fusion nucléaire"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "190458a2-ca43-318b-bc2a-341ba8577fb4",
                                        "entry_id": "ab87ffdd-ddd6-3aea-b60b-e87afbae0f77",
                                        "glosses": [
                                            "Opération ou suite d’opérations de marché ayant pour but de couvrir, ou de compenser, totalement ou partiellement, un risque de variation d’un élément d’actif ou de passif, ce risque provenant d’une fluctuation des cours des titres, des devises ou des taux d’intérêt (ou des prix des matières premières pour les marchandises)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "17793eed-69d1-3283-8d34-39c9ee6dc735",
                                        "entry_id": "ab87ffdd-ddd6-3aea-b60b-e87afbae0f77",
                                        "glosses": [
                                            "Prise de données sur une zone déterminée afin d’en obtenir une représentation."
                                        ],
                                        "tags": [
                                            "Télédétection spatiale",
                                            "Photogrammétrie"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bd353910-e342-3021-94f9-fdd0181c29c6",
                                        "entry_id": "ab87ffdd-ddd6-3aea-b60b-e87afbae0f77",
                                        "glosses": [
                                            "L’ensemble des données obtenues, ou leur représentation sous forme d’images brutes ou prétraitées."
                                        ],
                                        "tags": [
                                            "Télédétection spatiale",
                                            "Photogrammétrie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "36ab102f-f41c-4cfe-bd5d-dbe547e3c0f7",
                                                "sense_id": "bd353910-e342-3021-94f9-fdd0181c29c6",
                                                "text": "Leur mise à disposition du public en septembre 2003 est révolutionnaire à plusieurs points de vue (nous parlons ici surtout du format SRTM3) : le seul format de couverture mondiale précédemment disponible avait une résolution de 1 km (les GTOPO30) […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8be3c260-334d-3ad4-bc4d-6a80ee56abcc",
                                        "entry_id": "ab87ffdd-ddd6-3aea-b60b-e87afbae0f77",
                                        "glosses": [
                                            "Toiture en général, incluant charpente et couverture."
                                        ],
                                        "tags": [
                                            "Québec"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0d5edd2c-c38b-4220-9250-d29b222dffa0",
                        "source_entry_id": "160f5d02-b5a7-3172-a32f-1c71876d6075",
                        "source_sense_description": "something which covers",
                        "target_lang_word": "revêtement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "revêtement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8b073c3e-6cf1-3376-b713-2de8903dff92",
                                        "entry_id": "beb1b864-e25c-3c2d-9d86-4c4f06406c6a",
                                        "glosses": [
                                            "Action de revêtir."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6e1209c5-ec45-3252-b07e-787f218633d9",
                                        "entry_id": "beb1b864-e25c-3c2d-9d86-4c4f06406c6a",
                                        "glosses": [
                                            "Sorte de placage de plâtre, de mortier, de bois, de marbre, etc., qu’on fait à une construction pour l’orner ou la consolider."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8629a95a-7842-463e-823a-5c921aa668c9",
                                                "sense_id": "6e1209c5-ec45-3252-b07e-787f218633d9",
                                                "text": "Par contre, pour le petit granit et pour les ardoises, la crise continue, par suite de la tendance à remplacer les produits indigènes par des produits importés et de l'emploi plus fréquent de pierres blanches et de revêtements en pierre reconstituée."
                                            },
                                            {
                                                "example_id": "8a88b5a3-cc54-488b-a03f-f5afdbba2b1a",
                                                "sense_id": "6e1209c5-ec45-3252-b07e-787f218633d9",
                                                "text": "Il aurait suffi d'un faux mouvement pour qu'elle tombât la tète la première, d'une hauteur de deux mètres, sur le dur revêtement de ciment."
                                            },
                                            {
                                                "example_id": "ea0f5305-ae96-41be-aa66-d6f789af6bce",
                                                "sense_id": "6e1209c5-ec45-3252-b07e-787f218633d9",
                                                "text": "Ce coffrage est rempli de mortier autolissant et autonivelant et peut recevoir tous les revêtements classiques de sols."
                                            },
                                            {
                                                "example_id": "a4665618-d238-4319-bde7-6eb446738f2e",
                                                "sense_id": "6e1209c5-ec45-3252-b07e-787f218633d9",
                                                "text": "Une seconde partie mentionnait la synthèse de revêtements autoréparants à base de polymères fluorés sous champ magnétique oscillant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "44a16990-dac3-3eb4-8d70-6657c8bd0b04",
                                        "entry_id": "beb1b864-e25c-3c2d-9d86-4c4f06406c6a",
                                        "glosses": [
                                            "Ouvrage de pierre, de brique, ou de quelque autre matière, servant à retenir les terres d’un fossé, d’un bastion, d’une terrasse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aeb094a0-07a4-4de4-8942-b6d3165ddeaa",
                                                "sense_id": "44a16990-dac3-3eb4-8d70-6657c8bd0b04",
                                                "text": "Le revêtement de ce fossé est de maçonnerie."
                                            },
                                            {
                                                "example_id": "a35ffb30-8e54-41ac-9771-a85c02dc62c5",
                                                "sense_id": "44a16990-dac3-3eb4-8d70-6657c8bd0b04",
                                                "text": "Les revêtements sont ordinairement en talus, afin de mieux soutenir la poussée des terres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cd2b6614-cb6c-3f19-b2a2-e205c0f8337f",
                                        "entry_id": "beb1b864-e25c-3c2d-9d86-4c4f06406c6a",
                                        "glosses": [
                                            "Ce dont on a recouvert une voie et qui la rend carrossable, partie extérieure superficielle d’un chemin, d’une route, d’une circulation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d3105be-7c82-4483-8ad0-e53f338e5370",
                                                "sense_id": "cd2b6614-cb6c-3f19-b2a2-e205c0f8337f",
                                                "text": "Le revêtement en place, souvent recouvert de gravillons, n'est pas conçu pour être normalement circulable, mais seulement ponctuellement emprunté dans le cadre d'interventions de maintenance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "02cd7e2c-739f-319a-8fe8-1e92b1604336",
                                        "entry_id": "beb1b864-e25c-3c2d-9d86-4c4f06406c6a",
                                        "glosses": [
                                            "Couche superficielle appliquée à un objet, par exemple métallique, et constituée d’un matériau choisi pour ses propriétés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa76417d-95f4-434a-8f56-70fe011142b5",
                                                "sense_id": "02cd7e2c-739f-319a-8fe8-1e92b1604336",
                                                "text": "Le revêtement antiadhésif breveté garantit un nettoyage aisé de votre poêle à frire."
                                            },
                                            {
                                                "example_id": "752e1087-768d-45c8-a918-8345201dbf0b",
                                                "sense_id": "02cd7e2c-739f-319a-8fe8-1e92b1604336",
                                                "text": "Le bois est traité avec un revêtement protecteur qui le rend quasiment inaltérable."
                                            },
                                            {
                                                "example_id": "ad3ec878-a34a-4cb4-8a9d-7737b23687b3",
                                                "sense_id": "02cd7e2c-739f-319a-8fe8-1e92b1604336",
                                                "text": "ICI fabrique des explosifs, des fusils antichars, ainsi que le revêtement des cockpits de la Royal Air Force."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "59284327-d9ed-454e-837d-9f2a11239ff0",
                        "source_entry_id": "160f5d02-b5a7-3172-a32f-1c71876d6075",
                        "source_sense_description": "something which covers",
                        "target_lang_word": "Bedeckung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
