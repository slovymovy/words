{
    "word_family": [
        "gouffre"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "461fb056-1646-378f-8f01-eea8ab37d3f2",
                    "sense_definition": "Pénétrer rapidement et en se précipitant dans un lieu, un véhicule ou un passage étroit.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mouvement_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les voyageurs pressés s'<w>engouffrent</w> dans le métro avant la fermeture automatique des portes."
                        },
                        {
                            "text": "Voyant l'orage éclater, ils se sont <w>engouffrés</w> à l'intérieur du premier café venu."
                        }
                    ],
                    "common_phrases": [
                        "s'engouffrer dans le métro",
                        "s'engouffrer dans un couloir"
                    ]
                },
                {
                    "sense_id": "0f862f5e-3515-3d2f-9c00-5f4b74d9c8f5",
                    "sense_definition": "Pénétrer violemment et en masse dans une ouverture, en parlant d'un fluide comme le vent ou l'eau.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mouvement_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Un courant d'air glacial s'<w>engouffre</w> sous la porte d'entrée dès que l'hiver arrive."
                        },
                        {
                            "text": "Pendant la tempête, les vagues se sont <w>engouffrées</w> dans les ruelles du port."
                        }
                    ],
                    "common_phrases": [
                        "le vent s'engouffre",
                        "s'engouffrer sous la porte"
                    ]
                },
                {
                    "sense_id": "3b8ca6ea-da96-34cd-bfa2-6c143c2d8406",
                    "sense_definition": "Avaler rapidement de la nourriture sans mâcher ou dépenser de très grosses sommes d'argent.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "absorption",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Affamé après son entraînement, il <w>engouffre</w> son déjeuner en moins de dix minutes."
                        },
                        {
                            "text": "Ce projet immobilier trop ambitieux a fini par <w>engouffrer</w> des millions d'euros."
                        }
                    ],
                    "common_phrases": [
                        "engouffrer de la nourriture",
                        "engouffrer des millions"
                    ]
                },
                {
                    "sense_id": "130bb5d1-a00f-3cd0-8775-4bcf773bdb07",
                    "sense_definition": "Faire disparaître au fond d'un abîme, d'une cavité profonde ou dans les flots.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "absorption",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le maelström menaçait d'<w>engouffrer</w> tous les bateaux de pêche qui s'approchaient."
                        },
                        {
                            "text": "La crevasse a <w>engouffré</w> plusieurs tonnes de roche au moment du séisme."
                        }
                    ],
                    "synonyms": [
                        "précipiter"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "souvent employé au sens figuré ou littéraire"
                        }
                    ]
                }
            ]
        }
    ]
}