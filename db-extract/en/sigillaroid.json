    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "332848ac-6a93-367f-a391-d3201e3b41e0",
                "word": "Sigillaroid",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "eadfdc0a-6000-3031-9335-c556fe3ecfce",
                        "entry_id": "332848ac-6a93-367f-a391-d3201e3b41e0",
                        "glosses": [
                            "Of, pertaining to, or having characteristics of the genus Sigillaria of extinct trees."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "8ffb7690-33a9-4338-8776-9bc7f1f63e55",
                                "sense_id": "eadfdc0a-6000-3031-9335-c556fe3ecfce",
                                "text": "On microscopic examination, this mineral charcoal displays elongated wood-cells, some of them with the pores or discs in several rows, as in many Sigillaroid trees."
                            },
                            {
                                "example_id": "f5c6df65-3864-46bc-a531-013f7264d1b5",
                                "sense_id": "eadfdc0a-6000-3031-9335-c556fe3ecfce",
                                "text": "It is, however, possible that this older forest, represented by coaly stumps, may have consisted of Sigillaroid trees."
                            },
                            {
                                "example_id": "75ae9660-1d7c-493b-b394-064b89f0de88",
                                "sense_id": "eadfdc0a-6000-3031-9335-c556fe3ecfce",
                                "text": "In the latter plant, now well known to be a Sigillaroid root, we find no inner or medullary cylinder of vessels."
                            },
                            {
                                "example_id": "0f753d80-2908-4a1d-b720-7449e25ef388",
                                "sense_id": "eadfdc0a-6000-3031-9335-c556fe3ecfce",
                                "text": "Further, in the underclays it is quite a common thing to find a mass of clay literally crammed with ribbon-shaped markings of the roots of Sigillaroid plants."
                            }
                        ]
                    }
                ],
                "translations": [],
