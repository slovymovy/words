                        "glosses": [
                            "Qui fait débecter, qui fait vomir."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3468ffcf-d2f6-4b08-8ec3-901377ef96db",
                                "sense_id": "9364abfa-23cb-3135-bf62-1723935249ad",
                                "text": "25 décembre 40 – On n’aime pas ce qu’on possède trop, paraît-il. Que cette idée est débectante."
                            },
                            {
                                "example_id": "d27afacd-5a50-4568-bd41-064180833fca",
                                "sense_id": "9364abfa-23cb-3135-bf62-1723935249ad",
                                "text": "13 octobre 41 – Première visite à l’Hôpital américain. Beaudouin anonyme dans ce lit en série, dans l’odeur débectante d’une clinique ; il faut attendre d’être imprégné de partout par ce mélange âcre de chloroforme et de fièvre pour ne plus en souffirr."
                            }
                        ]
                    }
