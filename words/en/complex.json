{
    "word_family": [
        "complexity",
        "complexly"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "2d1f0cc3-09db-3bca-bd68-f0dc4d8b77c8",
                    "sense_definition": "Difficult to understand, explain, or deal with because it has many details or parts.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "adj_difficulty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The instructions for the new software were too <w>complex</w> for the beginners to follow.",
                            "target_lang_translations": {
                                "ru": "Инструкции к новому программному обеспечению были слишком <w>сложными</w> для новичков.",
                                "zh": "新软件的说明书对初学者来说太<w>复杂</w>了。"
                            }
                        },
                        {
                            "text": "We are facing a <w>complex</w> situation that requires a careful and thoughtful solution.",
                            "target_lang_translations": {
                                "ru": "Мы столкнулись со <w>сложной</w> ситуацией, требующей осторожного и вдумчивого решения.",
                                "zh": "我们正面临一个<w>复杂</w>的局面，需要谨慎且周全的解决方案。"
                            }
                        }
                    ],
                    "synonyms": [
                        "complicated",
                        "difficult",
                        "hard",
                        "intricate",
                        "tough",
                        "convoluted",
                        "knotty"
                    ],
                    "antonyms": [
                        "simple",
                        "easy",
                        "straightforward",
                        "basic"
                    ],
                    "common_phrases": [
                        "complex problem",
                        "complex issue",
                        "complex situation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Трудный для понимания, объяснения или решения из-за наличия множества деталей или частей.",
                        "zh": "因为包含许多细节或部分而难以理解、解释或处理。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сложный",
                                "target_lang_sense_clarification": "трудный для понимания"
                            },
                            {
                                "target_lang_word": "запутанный",
                                "target_lang_sense_clarification": "имеющий много деталей"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "复杂",
                                "target_lang_sense_clarification": "难以理解或处理"
                            },
                            {
                                "target_lang_word": "繁杂",
                                "target_lang_sense_clarification": "细节多且杂乱"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "29241894-7663-3917-9b77-8f1b4f051e37",
                    "sense_definition": "Made up of several different parts that are connected to each other.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "adj_structure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The human eye is a <w>complex</w> organ capable of distinguishing millions of colors.",
                            "target_lang_translations": {
                                "ru": "Человеческий глаз — это <w>сложный</w> орган, способный различать миллионы цветов.",
                                "zh": "人眼是一个<w>复杂</w>的器官，能够分辨数百万种颜色。"
                            }
                        },
                        {
                            "text": "They built a <w>complex</w> network of tunnels beneath the ancient city.",
                            "target_lang_translations": {
                                "ru": "Они построили <w>сложную</w> сеть туннелей под древним городом.",
                                "zh": "他们在古城下方建造了一个<w>复杂</w>的隧道网络。"
                            }
                        }
                    ],
                    "synonyms": [
                        "detailed",
                        "involved",
                        "manifold"
                    ],
                    "antonyms": [
                        "simple",
                        "basic"
                    ],
                    "common_phrases": [
                        "complex system",
                        "complex structure",
                        "complex network"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состоящий из нескольких различных частей, соединенных друг с другом.",
                        "zh": "由多个相互连接的不同部分组成。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сложный",
                                "target_lang_sense_clarification": "составной, структурный"
                            },
                            {
                                "target_lang_word": "комплексный",
                                "target_lang_sense_clarification": "целостный, охватывающий всё"
                            },
                            {
                                "target_lang_word": "составной",
                                "target_lang_sense_clarification": "собранный из компонентов"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "复杂",
                                "target_lang_sense_clarification": "结构上的复杂"
                            },
                            {
                                "target_lang_word": "综合",
                                "target_lang_sense_clarification": "多方面结合的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fa0daffa-46ca-317e-b6fa-2f3914b63b6c",
                    "sense_definition": "Relating to numbers that involve the imaginary square root of -1.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "adj_math",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In advanced mathematics, a <w>complex</w> number is expressed in the form a + bi.",
                            "target_lang_translations": {
                                "ru": "В высшей математике <w>комплексное</w> число выражается в форме a + bi.",
                                "zh": "在高等数学中，<w>复数</w>以 a + bi 的形式表示。"
                            }
                        },
                        {
                            "text": "The professor explained the properties of <w>complex</w> functions to the class.",
                            "target_lang_translations": {
                                "ru": "Профессор объяснил классу свойства <w>комплексных</w> функций.",
                                "zh": "教授向班级讲解了<w>复变函数</w>的性质。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "complex number",
                        "complex plane",
                        "complex variable"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "mathematics"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к числам, включающим мнимую единицу (квадратный корень из -1).",
                        "zh": "指涉及虚数单位（-1的平方根）的数学概念。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "комплексный",
                                "target_lang_sense_clarification": "математический термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "复数",
                                "target_lang_sense_clarification": "数学术语"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8493387e-89de-33f6-86c4-173d853f2f0e",
                    "sense_definition": "A group of buildings of a similar type or purpose standing together in one place.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "noun_collection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They live in a large apartment <w>complex</w> with a swimming pool and a gym.",
                            "target_lang_translations": {
                                "ru": "Они живут в большом жилом <w>комплексе</w> с бассейном и спортзалом.",
                                "zh": "他们住在一个带有游泳池和健身房的大型公寓<w>综合体</w>里。"
                            }
                        },
                        {
                            "text": "The new sports <w>complex</w> will be open to the public next month.",
                            "target_lang_translations": {
                                "ru": "Новый спортивный <w>комплекс</w> будет открыт для посещения в следующем месяце.",
                                "zh": "新的体育<w>综合体</w>将于下个月向公众开放。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "apartment complex",
                        "sports complex",
                        "shopping complex",
                        "office complex"
                    ],
                    "target_lang_definitions": {
                        "ru": "Группа зданий одного типа или назначения, расположенных в одном месте.",
                        "zh": "位于同一地点、类型或用途相似的一组建筑物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "комплекс",
                                "target_lang_sense_clarification": "группа зданий"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "综合体",
                                "target_lang_sense_clarification": "大型建筑群"
                            },
                            {
                                "target_lang_word": "园区",
                                "target_lang_sense_clarification": "特定功能的建筑群"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b7d9b7cb-0464-3b85-a8b9-0cb6e9ae7d92",
                    "sense_definition": "An emotional problem, fear, or obsession caused by past experiences that influences a person's behavior.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "noun_psych",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He has a <w>complex</w> about his height and refuses to wear flat shoes.",
                            "target_lang_translations": {
                                "ru": "У него <w>комплекс</w> по поводу своего роста, и он отказывается носить обувь на плоской подошве.",
                                "zh": "他对自己身高有<w>情结</w>，拒绝穿平底鞋。"
                            }
                        },
                        {
                            "text": "Developing an inferiority <w>complex</w> can prevent people from reaching their full potential.",
                            "target_lang_translations": {
                                "ru": "Развитие <w>комплекса</w> неполноценности может помешать людям полностью раскрыть свой потенциал.",
                                "zh": "产生自卑<w>情结</w>会阻碍人们充分发挥潜能。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "inferiority complex",
                        "god complex",
                        "persecution complex"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "psychology"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Эмоциональная проблема, страх или навязчивая идея, вызванная прошлым опытом.",
                        "zh": "由过去经历引起的、影响个人行为的情绪问题、恐惧或强迫观念。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "комплекс",
                                "target_lang_sense_clarification": "психологическое состояние"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "情结",
                                "target_lang_sense_clarification": "心理学上的心理负担"
                            },
                            {
                                "target_lang_word": "心理障碍",
                                "target_lang_sense_clarification": "心理上的困扰"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "20d205b9-bb22-3d30-adfd-a46824f63ec0",
                    "sense_definition": "A large system consisting of many similar or connected parts.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "noun_collection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The president warned the nation about the influence of the military-industrial <w>complex</w>.",
                            "target_lang_translations": {
                                "ru": "Президент предупредил нацию о влиянии военно-промышленного <w>комплекса</w>.",
                                "zh": "总统警告全国要警惕军工<w>复合体</w>的影响力。"
                            }
                        },
                        {
                            "text": "This <w>complex</w> of interconnected systems manages the city's water supply.",
                            "target_lang_translations": {
                                "ru": "Этот <w>комплекс</w> взаимосвязанных систем управляет городским водоснабжением.",
                                "zh": "这个由互联系统组成的<w>体系</w>负责管理城市的供水。"
                            }
                        }
                    ],
                    "synonyms": [
                        "constellation"
                    ],
                    "common_phrases": [
                        "military-industrial complex"
                    ],
                    "target_lang_definitions": {
                        "ru": "Крупная система, состоящая из множества похожих или связанных частей.",
                        "zh": "由许多相似或相关部分组成的大型系统。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "комплекс",
                                "target_lang_sense_clarification": "совокупность систем"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "体系",
                                "target_lang_sense_clarification": "系统性的结构"
                            },
                            {
                                "target_lang_word": "复合体",
                                "target_lang_sense_clarification": "多系统结合的整体"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f3eb14c6-5308-35ba-8fbf-b69911296bce",
                    "sense_definition": "A chemical structure consisting of a central atom weakly connected to surrounding atoms or molecules.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "noun_chem",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hemoglobin is a protein <w>complex</w> that carries oxygen in the blood.",
                            "target_lang_translations": {
                                "ru": "Гемоглобин — это белковый <w>комплекс</w>, который переносит кислород в крови.",
                                "zh": "血红蛋白是一种在血液中运输氧气的蛋白质<w>配合物</w>。"
                            }
                        },
                        {
                            "text": "The students studied how the metal <w>complex</w> reacted with the solution.",
                            "target_lang_translations": {
                                "ru": "Студенты изучали, как <w>комплекс</w> металла реагировал с раствором.",
                                "zh": "学生们研究了金属<w>配合物</w>如何与溶液发生反应。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "chemistry"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Химическая структура, состоящая из центрального атома, слабо связанного с окружающими атомами или молекулами.",
                        "zh": "一种化学结构，由中心原子与周围原子或分子弱连接而成。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "комплекс",
                                "target_lang_sense_clarification": "химическое соединение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "配合物",
                                "target_lang_sense_clarification": "化学术语"
                            },
                            {
                                "target_lang_word": "络合物",
                                "target_lang_sense_clarification": "化学术语"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a69820d8-5f7b-32a1-906b-99728e89092c",
                    "sense_definition": "To form a chemical complex with another substance.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "verb_chem",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The reagent is used to <w>complex</w> metal ions in the solution.",
                            "target_lang_translations": {
                                "ru": "Реагент используется, чтобы <w>связывать в комплекс</w> ионы металлов в растворе.",
                                "zh": "该试剂用于<w>络合</w>溶液中的金属离子。"
                            }
                        },
                        {
                            "text": "Certain molecules can <w>complex</w> with DNA to inhibit replication.",
                            "target_lang_translations": {
                                "ru": "Определенные молекулы могут <w>образовывать комплексы</w> с ДНК, подавляя репликацию.",
                                "zh": "某些分子可以与 DNA <w>络合</w>以抑制复制。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "chemistry"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Образовывать химический комплекс с другим веществом.",
                        "zh": "与另一种物质形成化学配合物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "образовывать комплекс",
                                "target_lang_sense_clarification": "вступать в реакцию"
                            },
                            {
                                "target_lang_word": "связывать",
                                "target_lang_sense_clarification": "соединять химически"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "络合",
                                "target_lang_sense_clarification": "化学反应过程"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}