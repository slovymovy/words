                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "humanoid",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "38e9757d-7acd-359d-af8f-9ce37cd868a0",
                                        "entry_id": "944ca070-cf59-3e88-8527-cdd305dec259",
                                        "glosses": [
                                            "dem Menschen ähnlich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8077778-6fb9-4457-9523-1c74191e0499",
                                                "sense_id": "38e9757d-7acd-359d-af8f-9ce37cd868a0",
                                                "text": "Am humanoidesten sind die Humanoiden mit humaner Genetik."
                                            },
                                            {
                                                "example_id": "691b5834-199a-4b1a-939c-bf1752cbe8c2",
                                                "sense_id": "38e9757d-7acd-359d-af8f-9ce37cd868a0",
                                                "text": "„In der Serie werden Vulkanier als hochintelligente, außerirdisch humanoide Spezies, mit einer robusteren Erscheinung als normale Menschen beschrieben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3e43cc80-0efc-4b4e-a29e-e9c781e18a69",
