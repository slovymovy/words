                        "entry_id": "a7007f83-9a14-37e4-bb33-1d3840f29cb8",
                        "glosses": [
                            "Cours d’eau né d'une diffluence, d'un cours d'eau principal en un bras qui s'en éloigne et ne le rejoint pas en aval."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "76aa7b98-32fc-45aa-a9d0-4164adf610a6",
                                "sense_id": "f778ac2c-189b-3334-bea8-df903c12cb76",
                                "text": "Nous avons emprunté un défluent très peu fréquenté et nous l’avons déposé inconscient sur l’île de l’Ange."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9a5f3d79-25a0-424a-9e9f-1219b231d054",
                        "source_entry_id": "a7007f83-9a14-37e4-bb33-1d3840f29cb8",
