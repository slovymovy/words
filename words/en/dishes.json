                    "sense_definition": "plural of <w>dish</w>",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "objects",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please put the clean <w>dishes</w> back in the cupboard.",
