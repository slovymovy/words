{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "992398b4-b0ca-3529-b677-3d00d14b1f57",
                    "sense_definition": "A very large and destructive ocean wave caused by an underwater earthquake or volcanic eruption.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "natural disaster",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A massive <w>tsunami</w> struck the coast of Japan after the powerful earthquake.",
                            "target_lang_translations": {
                                "ru": "Мощное <w>цунами</w> обрушилось на побережье Японии после сильного землетрясения."
                            }
                        },
                        {
                            "text": "Scientists use advanced sensors to detect a <w>tsunami</w> warning before the wave reaches land.",
                            "target_lang_translations": {
                                "ru": "Ученые используют современные датчики для обнаружения предупреждения о <w>цунами</w> до того, как волна достигнет берега."
                            }
                        }
                    ],
                    "synonyms": [
                        "seismic sea wave",
                        "tidal wave"
                    ],
                    "common_phrases": [
                        "tsunami warning",
                        "deadly tsunami",
                        "tsunami wave"
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень большая и разрушительная океанская волна, вызванная подводным землетрясением или извержением вулкана."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "цунами",
                                "target_lang_sense_clarification": "гигантская волна"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9b2668b5-ec75-314f-bfea-c20a45e94c6a",
                    "sense_definition": "A large and overwhelming surge or sudden increase of something, often unstoppable.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "metaphorical surge",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company faced a <w>tsunami</w> of complaints after the software update failed.",
                            "target_lang_translations": {
                                "ru": "Компания столкнулась со <w>шквалом</w> жалоб после неудачного обновления программного обеспечения."
                            }
                        },
                        {
                            "text": "The new policy set off a <w>tsunami</w> of protest among the local citizens.",
                            "target_lang_translations": {
                                "ru": "Новая политика вызвала <w>волну</w> протестов среди местных жителей."
                            }
                        }
                    ],
                    "common_phrases": [
                        "tsunami of complaints",
                        "tsunami of protest",
                        "tsunami of emotion"
                    ],
                    "target_lang_definitions": {
                        "ru": "Большой и непреодолимый всплеск или внезапное увеличение чего-либо, часто неудержимое."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "цунами",
                                "target_lang_sense_clarification": "переносное значение: мощный поток"
                            },
                            {
                                "target_lang_word": "шквал",
                                "target_lang_sense_clarification": "о жалобах или протестах"
                            },
                            {
                                "target_lang_word": "лавина",
                                "target_lang_sense_clarification": "огромное количество чего-либо"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}