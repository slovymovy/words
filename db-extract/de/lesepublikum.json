                ],
                "senses": [
                    {
                        "sense_id": "95368882-d07e-3ad6-9a9f-c8aaa1de59aa",
                        "entry_id": "9378e4cf-4161-3251-9992-1b6e12d972f0",
                        "glosses": [
                            "Bevölkerungsgruppe, die es gewohnt ist zu lesen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8de12129-1540-44d3-b579-74eb765b5649",
                                "sense_id": "95368882-d07e-3ad6-9a9f-c8aaa1de59aa",
                                "text": "„Das deutsche Lesepublikum war gerührt.“"
                            },
                            {
                                "example_id": "973b887a-06c0-4516-8f99-13bc9f56f380",
                                "sense_id": "95368882-d07e-3ad6-9a9f-c8aaa1de59aa",
                                "text": "„An ein weiteres Lesepublikum zu gelangen, auf das es sprachkritisch ankäme, wird ihm kaum gelingen.“"
                            },
                            {
                                "example_id": "53b18a97-d88e-4c58-8067-b73b45c20410",
                                "sense_id": "95368882-d07e-3ad6-9a9f-c8aaa1de59aa",
                                "text": "„Wenn man sich der Mühe unterzieht, vor allem weniger bekannte Stellen zu vergleichen, sieht man Wielands Bemühen, seinem Lese- und natürlich auch Theaterpublikum erst einmal vorzuführen, was Skakespeare eigentlich ist.“"
                            },
                            {
                                "example_id": "96482a31-0cf0-42cc-aea1-6cca10a1acb3",
                                "sense_id": "95368882-d07e-3ad6-9a9f-c8aaa1de59aa",
                                "text": "„Und wie Fitch immer wieder betont, gibt es viele Passagen, die sie in der endgültigen Fassung weggelassen oder umgeschrieben hat, da ihr deutlich bewusst war, dass das Lesepublikum sich vor allem für die berühmten Schriftsteller interessieren würde, die zu Figuren in ihrer Geschichte geworden waren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
