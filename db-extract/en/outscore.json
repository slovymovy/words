                        "sense_id": "8bb48661-555a-3f14-94b2-11464c12a6f2",
                        "entry_id": "c5816671-5864-3c0c-9bd4-b81090691c2d",
                        "glosses": [
                            "To score more than."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "2c8eb72f-f6bf-4b3a-a8c8-e6b6a8602e9c",
                                "sense_id": "8bb48661-555a-3f14-94b2-11464c12a6f2",
                                "text": "Hollande is another possible candidate to succeed President Jacques Chirac - but Royal consistently outscores him in opinion polls."
                            },
                            {
                                "example_id": "b484c2da-7aeb-4e16-bfc7-99f7661c8a86",
                                "sense_id": "8bb48661-555a-3f14-94b2-11464c12a6f2",
                                "text": "But the car that outscored them all was the outrageous, wheelstanding Little Red Wagon pickup, which went for more than half a million dollars."
                            },
                            {
                                "example_id": "5733fe18-590e-4ef4-af68-5bacb2c7c8b9",
                                "sense_id": "8bb48661-555a-3f14-94b2-11464c12a6f2",
                                "text": "Here’s a look at McDavid’s scoring and outscoring numbers from the last three regular seasons, the previous two playoff runs and then this year’s postseason totals."
                            },
                            {
                                "example_id": "ad9066d4-eb25-4787-9076-3ef6b6b4b73b",
                                "sense_id": "8bb48661-555a-3f14-94b2-11464c12a6f2",
                                "text": "A gymnast who performs a difficult vault with some flaws can outscore one who does an easier vault cleanly."
                            }
                        ]
                    }
