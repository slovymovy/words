                ],
                "senses": [
                    {
                        "sense_id": "a7c68a4f-857c-3591-908c-03c8d79889d4",
                        "entry_id": "a49a7b6c-2688-3506-8648-552832c90413",
                        "glosses": [
                            "zahnloser alter Mensch (Greis)"
                        ],
                        "tags": [
                            "derogatory",
                            "humorous",
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "f4538e3d-9fd6-433d-93f4-978bb8d491ac",
                                "sense_id": "a7c68a4f-857c-3591-908c-03c8d79889d4",
                                "text": "„Der schöne junge Schweinehirt kriegt die Prinzessin und der Mümmelgreis, der mit der Goldtruhe kommt, hat das Nachsehen.“"
                            },
                            {
                                "example_id": "2aa14067-7491-43ea-ba37-662e224fbaa8",
                                "sense_id": "a7c68a4f-857c-3591-908c-03c8d79889d4",
                                "text": "„Das Wort Mümmelgreis wurde vor etwa dreißig Jahren von mir gebildet nach dem plattdeutschen Zeitwort mümmeln, was käuen mit zahnlosem Munde bedeutet.“"
                            },
                            {
                                "example_id": "90aa85e3-a132-4a8e-9358-03b81f6da9d2",
                                "sense_id": "a7c68a4f-857c-3591-908c-03c8d79889d4",
                                "text": "„Das Wort \"Mümmelgreis\" ist allerdings von mir zuerst gebraucht; ein Gedicht mit diesem Titel ist aber von irgend einem Proleten unter Mißbrauch meines Namens in Umlauf gesetzt, um solche Leute zu täuschen, von denen man zu sagen pflegt, daß sie nicht alle werden.“"
                            },
                            {
                                "example_id": "0f76dadd-cfca-46d1-b080-d962009669f0",
                                "sense_id": "a7c68a4f-857c-3591-908c-03c8d79889d4",
                                "text": "„Ob es das Verschwinden des Pfirsichgeschmacks bei den gleichnamigen Früchten ist, das Aussterben der Klavierlehrerinnen oder die Stillegung der letzten Dampflokomotive – man hat sich notgedrungen daran gewöhnt, daß die gute alte Zeit bald nur noch in den Erinnerungen von uns Mümmelgreisen existieren wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
