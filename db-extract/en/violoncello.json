                        "examples": [
                            {
                                "example_id": "12afc9a6-fce7-4687-946e-5cbcd437a141",
                                "sense_id": "7aa05789-51b2-39a3-8672-39be0f8efc2a",
                                "text": "A tentative violoncello is playing, invisible and plaintive, then stops with an asthmatic scrape of catgut."
                            },
                            {
                                "example_id": "3fc4a962-0729-4381-9cc0-401f62145573",
                                "sense_id": "7aa05789-51b2-39a3-8672-39be0f8efc2a",
                                "text": "Preserved under the rock-hard amber varnish was a beautifully crafted mythological scene depicting a nude man in a lush landscape playing a violoncello to a rapt audience of peaceful animals, including a jaguar, lion, swan, fox, peacock, horse, parrot, dogs, badger, deer, bull, ostrich, and no less than an elephant coming over the hill to join them."
                            }
                        ]
                    }
