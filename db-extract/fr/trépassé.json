            {
                "entry_id": "05ab6b42-cf37-3cb6-8cd7-c0686db187de",
                "word": "trépassé",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "8c983a6c-0de6-42be-9790-a0ee1f2c35fd",
                        "entry_id": "05ab6b42-cf37-3cb6-8cd7-c0686db187de",
                        "tags": [
