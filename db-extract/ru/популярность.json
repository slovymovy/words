                    }
                ],
                "translations": [
                    {
                        "translation_id": "13ebf8bc-209d-43f4-b067-58e95ff232fd",
                        "source_entry_id": "4c6e14e4-7152-3199-8a9c-c1cbce56edd5",
                        "target_lang_word": "popularity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "popularity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ce3bbbf2-d39a-3445-9698-cb13615e51e2",
                                        "entry_id": "f511ce1f-245b-3d79-adfa-3b6631f40c9d",
                                        "glosses": [
                                            "The quality or state of being popular; especially, the state of being widely liked or in favor with the people at large."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c7cb5d6d-8ad4-4a4e-ad82-562e9e56d3bb",
                                                "sense_id": "ce3bbbf2-d39a-3445-9698-cb13615e51e2",
                                                "text": "This destination has increased in popularity after great reviews in the guide books."
                                            },
                                            {
                                                "example_id": "8404d70b-69b0-4181-b3ae-90b5459661a6",
                                                "sense_id": "ce3bbbf2-d39a-3445-9698-cb13615e51e2",
                                                "text": "Politicians are rarely known for their popularity."
                                            },
                                            {
                                                "example_id": "00283b68-0fc0-4e20-858c-e2267fdee173",
                                                "sense_id": "ce3bbbf2-d39a-3445-9698-cb13615e51e2",
                                                "text": "The massive popularity of the book led to it being adapted into a movie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8c985ed9-c8c9-38d9-b75e-12519ebaa379",
                                        "entry_id": "f511ce1f-245b-3d79-adfa-3b6631f40c9d",
                                        "glosses": [
                                            "The quality or state of being adapted or pleasing to common, poor, or vulgar people"
                                        ],
                                        "tags": [
                                            "archaic",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0d2b2570-6caf-4ec7-b9ed-0f01ebf0cadb",
                                                "sense_id": "8c985ed9-c8c9-38d9-b75e-12519ebaa379",
                                                "text": "So this Gallant, labouring to avoid Popularity, falls into a habit of Affectation, Ten thousand times hatefuller than the former."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9348e407-4935-3a41-8f84-5fd1d074d52e",
                                        "entry_id": "f511ce1f-245b-3d79-adfa-3b6631f40c9d",
                                        "glosses": [
                                            "The quality or state of being adapted or pleasing to common, poor, or vulgar people",
                                            "cheapness; inferiority; vulgarity."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "broadly",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "398400b0-f06a-3110-9b5e-581435162f83",
                                        "entry_id": "f511ce1f-245b-3d79-adfa-3b6631f40c9d",
                                        "glosses": [
                                            "Something which obtains, or is intended to obtain, the favor of the vulgar; claptrap."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "93da9936-1c7e-44fb-8431-201674d04bc1",
                                                "sense_id": "398400b0-f06a-3110-9b5e-581435162f83",
                                                "text": "Popularities, and circumstances which […] sway the ordinary judgment."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f9c4b30e-977e-3d47-b1c3-dc3d90432d5b",
                                        "entry_id": "f511ce1f-245b-3d79-adfa-3b6631f40c9d",
                                        "glosses": [
                                            "The act of courting the favour of the people."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "68c4e93b-72a6-4ed4-b660-41d595645a2b",
                                                "sense_id": "f9c4b30e-977e-3d47-b1c3-dc3d90432d5b",
                                                "text": "Cato (the younger) charged Muraena, and indicted him in open court for popularity and ambition."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cae06abd-504b-3495-add7-10cfede6af93",
                                        "entry_id": "f511ce1f-245b-3d79-adfa-3b6631f40c9d",
                                        "glosses": [
                                            "Public sentiment; general passion."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "210cdc03-7ac0-44e2-a832-fb8991c38f72",
                                                "sense_id": "cae06abd-504b-3495-add7-10cfede6af93",
                                                "text": "A little time be allowed for the madness of popularity to cease."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "814170f0-69c0-4dd4-8ff3-3a0ea56ca64b",
                        "source_entry_id": "4c6e14e4-7152-3199-8a9c-c1cbce56edd5",
                        "target_lang_word": "Popularität",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Popularität",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "78234fcc-a784-31bb-96dc-4291cf71ba4f",
                                        "entry_id": "0e0bb8a7-5644-3659-a5ce-f58e0018bfb6",
                                        "glosses": [
                                            "die Eigenschaft, bekannt und beliebt zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "635bdb46-10f4-4127-a65f-068ea2b766bb",
                                                "sense_id": "78234fcc-a784-31bb-96dc-4291cf71ba4f",
                                                "text": "Fußball erfreut sich großer Popularität."
                                            },
                                            {
                                                "example_id": "cde4faf2-4c3a-4caf-bcff-43ed81757ddf",
                                                "sense_id": "78234fcc-a784-31bb-96dc-4291cf71ba4f",
                                                "text": "„Dem Freiherrn selber jedoch war die Popularität als Lügenbaron eher peinlich, zudem erwies sich sein zweifelhafter Ruf bei einem späteren Scheidungsprozess, der ihn finanziell ruinierte, als wenig vorteilhaft.“"
                                            },
                                            {
                                                "example_id": "38deec6d-5118-4a73-a99b-a89433eca0c2",
                                                "sense_id": "78234fcc-a784-31bb-96dc-4291cf71ba4f",
                                                "text": "„Die ungebrochene Popularität Buschs beruht darauf, dass seine geflügelten Worte bei denen, für die sie gemeint waren, auf behagliche Zustimmung stoßen, bei allen anderen auf das erwartete satirische Vergnügen am Spießigen.“"
                                            },
                                            {
                                                "example_id": "120ad519-5eaf-4631-aa54-e1347d0d0183",
                                                "sense_id": "78234fcc-a784-31bb-96dc-4291cf71ba4f",
                                                "text": "„Teneriffa gab Janosch die Möglichkeit, sich von seiner Popularität zu erholen.“"
                                            },
                                            {
                                                "example_id": "7696d953-8509-46bc-966c-1e4f89906eb0",
                                                "sense_id": "78234fcc-a784-31bb-96dc-4291cf71ba4f",
                                                "text": "„Dahlerup genoss bei weitem nicht die Popularität seines Vorgängers Pløyen, eher im Gegenteil.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
