                                        "entry_id": "3ebe3736-d6f7-3eb8-9657-92b71239f319",
                                        "glosses": [
                                            "seitlich auf jener Seite, wo die meisten Menschen ihr Herz haben und schlagen spüren können"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a46addd4-816e-4996-846a-8dd07d9826df",
                                                "sense_id": "1c33fc86-142e-3be2-9822-3e4863f4ebe3",
                                                "text": "Links ist die Überholspur auf der Autobahn."
                                            },
                                            {
                                                "example_id": "98570bd9-9ec8-4179-856e-a9c14004c9f3",
                                                "sense_id": "1c33fc86-142e-3be2-9822-3e4863f4ebe3",
                                                "text": "Links ist da, wo der Daumen rechts ist."
                                            },
                                            {
                                                "example_id": "71b309a3-2613-4b00-9baa-5c1e3cfe9207",
                                                "sense_id": "1c33fc86-142e-3be2-9822-3e4863f4ebe3",
                                                "text": "Da vorne müssen Sie dann links abbiegen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "da35d969-d0e9-32ce-ab90-b66c9f1e46a3",
                                        "entry_id": "3ebe3736-d6f7-3eb8-9657-92b71239f319",
                                        "glosses": [
                                            "zum politisch linken Spektrum gehörend, welches von der Gleichheit der Menschen ausgeht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df6b7607-142a-4d26-b4b8-281b8d55eee1",
                                                "sense_id": "da35d969-d0e9-32ce-ab90-b66c9f1e46a3",
                                                "text": "Links im Parteienspektrum ist die Partei \"Die Linke\"."
                                            },
                                            {
                                                "example_id": "ea6dca4f-ef3b-44d5-83a8-11e0e7af9f07",
                                                "sense_id": "da35d969-d0e9-32ce-ab90-b66c9f1e46a3",
