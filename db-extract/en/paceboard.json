                        "entry_id": "cdfb6f68-f750-3343-a07a-dc18ef560625",
                        "glosses": [
                            "A board marked with symbols, used to help a person with multiple sclerosis to time their speaking so as to be clearly intelligible."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "213599b4-76c5-4a40-bdef-0a33477fa52a",
                                "sense_id": "f5d13507-32e7-3ce1-83da-50eac7e65376",
                                "text": "However, because this method, as well as the actual paceboard itself, was too cumbersome, we moved to a less rigid method of rate control following one month of this technique."
                            },
                            {
                                "example_id": "791c01dc-1658-4de8-928e-2cd4561a5464",
                                "sense_id": "f5d13507-32e7-3ce1-83da-50eac7e65376",
                                "text": "A simple paceboard, consisting of a pattern of rectangles set next to each other, may slow the person's speech and allow for improved intelligibility. The person points to each square while uttering a single syllable."
                            }
                        ]
                    }
