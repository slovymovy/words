                    {
                        "translation_id": "4cf637f5-033d-4419-86e7-5e8a94c1c563",
                        "source_entry_id": "dfe61aa6-633a-35c1-b95c-c68298c84530",
                        "source_sense_description": "killing or inhibiting bacteria",
