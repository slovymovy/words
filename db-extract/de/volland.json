                ],
                "senses": [
                    {
                        "sense_id": "49ec4175-7924-356d-9227-8566672c61b4",
                        "entry_id": "fae8c02f-2e2c-340e-b0eb-321344e08fda",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6240e1f3-0ffc-46ef-97b8-7434b2fd7d6f",
                                "sense_id": "49ec4175-7924-356d-9227-8566672c61b4",
                                "text": "Frau Volland ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "3b977f6f-59d3-42d7-b01f-19c0e0223d6e",
                                "sense_id": "49ec4175-7924-356d-9227-8566672c61b4",
                                "text": "Herr Volland wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "39e58cfc-64f4-4171-b8b3-1aa3dbd287f4",
                                "sense_id": "49ec4175-7924-356d-9227-8566672c61b4",
                                "text": "Die Vollands fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "83981260-5ec3-4036-be83-097db99dde17",
                                "sense_id": "49ec4175-7924-356d-9227-8566672c61b4",
                                "text": "Der Volland trägt nie die Schals, die die Volland ihm strickt."
                            },
                            {
                                "example_id": "8b4db2f4-c4e3-41d1-bfe3-7f22fb1dd53b",
                                "sense_id": "49ec4175-7924-356d-9227-8566672c61b4",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Volland kommt, geht der Herr Volland.“"
                            },
                            {
                                "example_id": "a64ec3c0-8521-4db7-b034-31b7ed66c6f5",
                                "sense_id": "49ec4175-7924-356d-9227-8566672c61b4",
                                "text": "Volland kommt und geht."
                            },
                            {
                                "example_id": "57553c24-ae4c-4f64-808f-aa9cf638ca9c",
                                "sense_id": "49ec4175-7924-356d-9227-8566672c61b4",
                                "text": "Vollands kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
