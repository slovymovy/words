    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ae9e1b33-8a68-3e8d-861e-528fa63b622a",
                    "sense_definition": "To degenerate, deteriorate, or gradually break down into a worse state.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "deteriorate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The peaceful demonstration slowly began to <w>devolve</w> into a violent riot as the night went on."
                        },
                        {
                            "text": "What started as a friendly debate quickly <w>devolved</w> into personal insults and petty arguments."
                        }
                    ],
                    "antonyms": [
                        "evolve",
                        "improve"
                    ],
                    "common_phrases": [
                        "devolve into chaos"
                    ]
                },
                {
                    "sense_id": "f00b4101-c3d8-3862-9ae6-2fdd8f8ef60f",
                    "sense_definition": "To transfer power, authority, or responsibility from a central level to local or regional bodies.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "transfer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The national parliament decided to <w>devolve</w> powers to local regional councils to improve public services."
                        },
                        {
                            "text": "Ministers agreed to <w>devolve</w> control over education policy to local government officials."
                        }
                    ],
                    "synonyms": [
                        "pass down"
                    ],
                    "common_phrases": [
                        "devolve power to",
                        "devolve powers to"
                    ]
                },
                {
                    "sense_id": "45103454-1b04-38d5-b246-a7560951fddb",
                    "sense_definition": "To be transferred or passed down to a lower or regional level.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "transfer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Significant decision-making authority will <w>devolve</w> to the newly established regional assemblies."
                        },
                        {
                            "text": "Under the new constitution, several critical government functions <w>devolved</w> to local authorities."
                        }
                    ],
                    "common_phrases": [
                        "devolve to local authorities"
                    ]
                },
                {
                    "sense_id": "c6db3b88-9784-3d72-a4bc-95f8d6631f6f",
                    "sense_definition": "To delegate or pass a duty, responsibility, or task to someone else.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "transfer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manager chose to <w>devolve</w> responsibility for the project upon her assistant."
                        },
                        {
                            "text": "He preferred not to manage the daily accounts, choosing instead to <w>devolve</w> the work upon staff."
                        }
                    ],
                    "synonyms": [
                        "pass down"
                    ],
                    "common_phrases": [
                        "devolve responsibility upon"
                    ]
                },
                {
                    "sense_id": "7db849f5-5adf-360d-b0ae-03c2b5e4b48b",
                    "sense_definition": "To fall upon someone as an obligation or responsibility.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "fall_upon",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After the committee chair resigned, the duty to complete the report <w>devolved</w> on the vice president."
                        },
                        {
                            "text": "When the captain fell ill, the difficult task of navigation naturally <w>devolved</w> upon the chief mate."
                        }
                    ],
                    "common_phrases": [
                        "devolve upon someone",
                        "devolve on someone"
                    ]
                },
                {
                    "sense_id": "2f48c0a9-4d05-389f-b62d-6621ff029a6d",
                    "sense_definition": "To pass down to an heir or next successor, especially through inheritance.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "fall_upon",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Upon the demise of the elderly duke, the family title and estates <w>devolved</w> upon his nephew."
                        },
                        {
                            "text": "Because there was no direct heir, the ancestral property will <w>devolve</w> to the closest living relative."
                        }
                    ],
                    "common_phrases": [
                        "devolve upon an heir"
                    ]
                },
                {
                    "sense_id": "91ce10ef-c3b2-3d92-909b-b36a33c34220",
                    "sense_definition": "To roll down or cause to flow downwards.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "roll_down",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mountain stream <w>devolves</w> its rapid waters into the broad valley below."
                        },
                        {
                            "text": "Heavy storms caused the swollen river to <w>devolve</w> huge volumes of muddy water down the hillside."
                        }
                    ],
                    "synonyms": [
                        "roll down"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rare or archaic usage"
                        }
                    ]
                }
            ]
        }
    ]
}