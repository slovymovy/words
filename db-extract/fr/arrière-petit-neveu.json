                        "form": "arrière-petite-nièce"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f5203301-6b21-31ee-aecf-ff055995ec62",
                        "entry_id": "a0020181-345f-3782-a0c5-6d99666ab420",
                        "glosses": [
                            "Fils du petit-neveu ou de la petite-nièce. Petit-fils du neveu ou de la nièce. Arrière-petit-fils du frère ou de la sœur. On est pour son arrière-petit-neveu un arrière-grand-oncle ou une arrière-grand-tante."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92efe79e-1b6f-421f-b920-24973cb555c2",
                                "sense_id": "f5203301-6b21-31ee-aecf-ff055995ec62",
                                "text": "La cité de Montmeillant (Ardennes) se propose d'élever un monument au général du Merbion, […]. Le comité d'initiative a pour président d'honneur M. Devie, maire de Montmeillant, et pour président actif M. Alfred Merlin, de Reims, arrière-petit-neveu du général."
                            },
                            {
                                "example_id": "63a9c156-51d6-401d-bc9d-22319954e2dc",
                                "sense_id": "f5203301-6b21-31ee-aecf-ff055995ec62",
                                "text": "Le grand Panier était sincère et caressait d'un doigt tombant la joue de ses arrière-petits-neveux qui se poussaient du coude en l'apercevant."
                            },
                            {
                                "example_id": "a77e37d6-19df-4d2e-9f55-0c016d587070",
                                "sense_id": "f5203301-6b21-31ee-aecf-ff055995ec62",
                                "text": "C'est au nom de la vieille, moi, je l'accompagne, je suis son arrière-petit-neveu."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1e1d4d42-f6fe-4524-b5b3-1462044342a7",
                        "source_entry_id": "a0020181-345f-3782-a0c5-6d99666ab420",
                        "source_sense_id": "f5203301-6b21-31ee-aecf-ff055995ec62",
                        "target_lang_word": "Urgroßneffe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Urgroßneffe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bf2abe65-4512-3bdf-950f-413d111777f4",
                                        "entry_id": "4ed2e248-f1e8-35db-bf63-ec3abc841068",
                                        "glosses": [
                                            "Sohn von Großnichte oder Großneffe"
                                        ],
                                        "tags": [
                                            "1. Grades oder höher"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e2fbc2bd-ea9c-49c9-abb8-bc46c2abad04",
                                                "sense_id": "bf2abe65-4512-3bdf-950f-413d111777f4",
                                                "text": "Seit kurzem haben wir einen Urgroßneffen."
                                            },
                                            {
                                                "example_id": "ecc675cc-ce55-4acd-90a7-d3600ef7e08e",
                                                "sense_id": "bf2abe65-4512-3bdf-950f-413d111777f4",
                                                "text": "„Der Belgier ist der Urgroßneffe jenes Königs Leopold II., dem das Land 1884/85 im Rahmen internationaler Verträge als persönlicher Herrschaftsbereich zuerkannt worden war (…).“"
                                            },
                                            {
                                                "example_id": "f857cc6b-813a-4285-be0f-31834cec085f",
                                                "sense_id": "bf2abe65-4512-3bdf-950f-413d111777f4",
                                                "text": "„Sein Urgroßneffe lebt angeblich noch immer darin.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
