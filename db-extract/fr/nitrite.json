                ],
                "senses": [
                    {
                        "sense_id": "0e44824c-75d5-3f31-a6f6-43148b782b55",
                        "entry_id": "d40ade8f-53ab-3c92-9da7-dee40e1d5b2f",
                        "glosses": [
                            "Sel produit par la combinaison de l’acide nitreux (HNO₂) avec une base."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4394c6f0-5e71-409c-a5c8-38990c256801",
                                "sense_id": "0e44824c-75d5-3f31-a6f6-43148b782b55",
                                "text": "L’équipe montre pour la première fois, in vivo chez le rat, qu'une charcuterie modèle riche en hème (…), salée, additionnée de nitrites, cuite et oxydée était promotrice du développement du cancer colorectal."
                            },
                            {
                                "example_id": "61586745-6093-4e77-9df8-c04b99414a03",
                                "sense_id": "0e44824c-75d5-3f31-a6f6-43148b782b55",
                                "text": "Les nitrites (E249 et E250). Conservateurs et fixateurs de couleur, ils se retrouvent dans presque toutes les salaisons et les conserves de charcuteries pour empêcher la prolifération de l'agent du botulisme."
                            },
                            {
                                "example_id": "840ee35c-315e-4fab-84e0-d26be6e34243",
                                "sense_id": "0e44824c-75d5-3f31-a6f6-43148b782b55",
                                "text": "Ce nouvel intermédiaire est l’oxyde nitrique (NO) qui, dans des conditions de sol normales, est un précurseur chimique du nitrite qui sera transformé en nitrate."
                            },
                            {
                                "example_id": "17315fb2-5c18-4343-b7f9-343b417264d4",
                                "sense_id": "0e44824c-75d5-3f31-a6f6-43148b782b55",
                                "text": "Ils alimentent leur métabolisme en énergie en oxydant l’ammoniac (NH3) en nitrite (NO₂⁻), la source principale d’azote en mer."
                            }
                        ]
                    }
                ],
