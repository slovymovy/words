                                        "glosses": [
                                            "condizione propria di chi è autonomo, in riferimento ad uno stato o nazione, ed anche a persone, cose e fatti"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6ab7acab-1c61-486c-b0e4-d7000dda788c",
                                                "sense_id": "4d49b7ec-00dd-3b88-b725-1f979f0c0206",
