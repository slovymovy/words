                                        "sense_id": "c297983d-9c39-3749-af77-c78c1611dab2",
                                        "entry_id": "36d2dae1-2005-3f76-b3e4-da9d7c31ece1",
                                        "glosses": [
                                            "An act in the past which may be used as an example to help decide the outcome of similar instances in the future."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b8875d2-861a-4949-b079-9dcf1609c6c7",
                                                "sense_id": "c297983d-9c39-3749-af77-c78c1611dab2",
                                                "text": "Examples for cases can but direct as precedents only."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "93a49664-44c9-35c3-b471-7ce00d32245b",
                                        "entry_id": "36d2dae1-2005-3f76-b3e4-da9d7c31ece1",
                                        "glosses": [
                                            "A decided case which is cited or used as an example to justify a judgment in a subsequent case."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c8cb7300-ad5e-3b4c-b0f0-eae1158ad215",
                                        "entry_id": "36d2dae1-2005-3f76-b3e4-da9d7c31ece1",
                                        "glosses": [
                                            "An established habit or custom."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ea2a6522-6240-3546-b7b4-a0458c207481",
                                        "entry_id": "36d2dae1-2005-3f76-b3e4-da9d7c31ece1",
                                        "glosses": [
                                            "The aforementioned (thing)."
                                        ],
                                        "tags": [
