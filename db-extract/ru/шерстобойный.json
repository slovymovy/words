                "senses": [
                    {
                        "sense_id": "63b18d2b-14b2-32d2-a5c5-5cea7442258a",
                        "entry_id": "723378e2-e0ae-3d49-b60e-0a0df39cc27f",
                        "glosses": [
                            "связанный, соотносящийся по значению с существительными шерстобой, шерстобойка"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "d3763e80-affc-305c-bc70-ca934de719a7",
                        "entry_id": "723378e2-e0ae-3d49-b60e-0a0df39cc27f",
                        "glosses": [
                            "связанный с обработкой шерсти взбиванием или рыхлением"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f5883593-58f0-47f7-8dec-01a66f1a9f81",
                                "sense_id": "d3763e80-affc-305c-bc70-ca934de719a7",
                                "text": "Близ селения работали шерстобойный и круподёрный заводы."
                            },
                            {
                                "example_id": "1288c660-836a-4dff-b389-29a5fca51efa",
                                "sense_id": "d3763e80-affc-305c-bc70-ca934de719a7",
                                "text": "С конца 17 ве́ка в Бишеве стали успешно развиваться другие промыслы: валяльный (производство валенок), шерстобойный, выделка овчин, скорняцкое дело, шерстобойка, крупорушка, маслодельные заводы и др."
                            }
                        ]
                    }
