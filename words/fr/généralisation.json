            "pos": "noun",
            "senses": [
                {
                    "sense_id": "92078935-cd37-3109-b118-7b6583ccf074",
                    "sense_definition": "Action de diffuser ou d'étendre l'usage de quelque chose à un ensemble beaucoup plus vaste.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "diffusion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La <w>généralisation</w> du télétravail a profondément modifié l'organisation du travail dans de nombreuses entreprises."
                        },
                        {
                            "text": "Avec la <w>généralisation</w> des smartphones, l'accès à Internet est devenu simple et quotidien pour tous."
                        }
                    ],
                    "synonyms": [
                        "diffusion",
                        "extension",
                        "propagation"
                    ],
                    "antonyms": [
                        "restriction",
                        "limitation"
                    ],
                    "common_phrases": [
                        "généralisation progressive",
                        "généralisation du télétravail"
                    ]
                },
                {
                    "sense_id": "5759f409-4921-35eb-9d59-965aa28f0977",
                    "sense_definition": "Opération de l'esprit qui consiste à tirer une règle ou une idée générale à partir de cas particuliers.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "pensée",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il faut se méfier de toute <w>généralisation</w> hâtive fondée sur un seul exemple isolé."
                        },
                        {
                            "text": "Les scientifiques procèdent souvent par <w>généralisation</w> après avoir observé plusieurs expériences identiques."
                        }
                    ],
                    "synonyms": [
                        "extrapolation",
                        "induction"
                    ],
                    "antonyms": [
                        "particularisation",
                        "individualisation"
                    ],
                    "common_phrases": [
                        "généralisation abusive",
                        "généralisation hâtive",
                        "faire une généralisation"
                    ]
                },
                {
                    "sense_id": "cc843204-cb68-367f-8340-ebf52ad7c3d7",
                    "sense_definition": "Action d'imposer ou de faire adopter à grande échelle des principes, des règles ou des valeurs communes.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "diffusion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La <w>généralisation</w> de ces normes de sécurité a provoqué de vifs débats parmi les responsables politiques."
                        },
                        {
                            "text": "L'institution encourage la <w>généralisation</w> de principes éthiques dans l'ensemble des pratiques professionnelles."
