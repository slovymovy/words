                        "examples": [
                            {
                                "example_id": "c660580e-c5bb-4241-a5f5-2ad268166a59",
                                "sense_id": "dd254818-6e88-3ddb-a243-49d87d377eda",
                                "text": "At the mention of yaffling—the cant for eating—Ewan felt a pang of hunger in his belly."
                            },
                            {
                                "example_id": "be716ab0-6338-4076-9efa-3f63d09289a7",
                                "sense_id": "dd254818-6e88-3ddb-a243-49d87d377eda",
                                "text": "You're growing squab yaffling our food and then lazing in the hallway."
                            }
                        ]
                    }
