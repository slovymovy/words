                                            {
                                                "example_id": "40ecc90a-0a8f-43ff-ab67-ea9dacb41ea9",
                                                "sense_id": "92a3f64a-d0ac-387c-b5b6-bb1edac78530",
                                                "text": "Urzędnicy w Lagos znani są z tego, że za odpowiednią prowizję gotowi są chętnie reeksportować dostawy broni praktycznie dokądkolwiek."
                                            }
