{
    "word_family": [
        "salutation"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "dc8766a1-4d25-3f3f-812b-17decd4ef9cb",
                    "sense_definition": "To perform a formal gesture of respect or greeting, usually by raising the right hand to the side of the forehead.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "gesture_honor",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldiers stood at attention and <w>saluted</w> their commanding officer.",
                            "target_lang_translations": {
                                "ru": "Солдаты вытянулись в струнку и <w>отдали честь</w> своему командиру.",
                                "zh": "士兵们立正并向指挥官<w>敬礼</w>。"
                            }
                        },
                        {
                            "text": "He <w>saluted</w> the flag with pride during the national anthem.",
                            "target_lang_translations": {
                                "ru": "Он с гордостью <w>отдал честь</w> флагу во время исполнения государственного гимна.",
                                "zh": "国歌响起时，他自豪地向国旗<w>敬礼</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "greet",
                        "acknowledge",
                        "honor",
                        "pay tribute"
                    ],
                    "antonyms": [
                        "ignore"
                    ],
                    "common_phrases": [
                        "salute the flag",
                        "salute an officer",
                        "stand and salute"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выполнять формальный жест уважения или приветствия, обычно поднося правую руку к виску (отдавать честь).",
                        "zh": "通过举手触碰额头侧面等正式动作来表示敬意或问候。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отдава́ть честь",
                                "target_lang_sense_clarification": "военное приветствие"
                            },
                            {
                                "target_lang_word": "приве́тствовать",
                                "target_lang_sense_clarification": "формально"
                            },
                            {
                                "target_lang_word": "салютова́ть",
                                "target_lang_sense_clarification": "торжественно или по-военному"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "敬礼",
                                "target_lang_sense_clarification": "军事或正式场合的礼节"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "13a98623-16f1-3f79-ae60-4ff95804c458",
                    "sense_definition": "To publicly express admiration, respect, or praise for someone's actions or qualities.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "praise",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I want to <w>salute</w> the volunteers for their tireless work this weekend.",
                            "target_lang_translations": {
                                "ru": "Я хочу <w>поприветствовать</w> волонтеров за их неустанную работу в эти выходные.",
                                "zh": "我要向本周末辛勤工作的志愿者们<w>致敬</w>。"
                            }
                        },
                        {
                            "text": "We <w>salute</w> her courage in speaking out against injustice.",
                            "target_lang_translations": {
                                "ru": "Мы <w>отдаем должное</w> её смелости выступить против несправедливости.",
                                "zh": "我们<w>致敬</w>她敢于反抗不公的勇气。"
                            }
                        }
                    ],
                    "synonyms": [
                        "honor",
                        "praise",
                        "commend",
                        "acclaim",
                        "applaud"
                    ],
                    "antonyms": [
                        "criticize",
                        "condemn",
                        "disparage"
                    ],
                    "common_phrases": [
                        "salute someone's courage",
                        "salute the efforts",
                        "salute a hero"
                    ],
                    "target_lang_definitions": {
                        "ru": "Публично выражать восхищение, уважение или похвалу чьим-либо действиям или качествам.",
                        "zh": "公开表达对某人行为或品质的钦佩、尊重或赞扬。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приве́тствовать",
                                "target_lang_sense_clarification": "одобрять, поддерживать"
                            },
                            {
                                "target_lang_word": "отдава́ть до́лжное",
                                "target_lang_sense_clarification": "признавать заслуги"
                            },
                            {
                                "target_lang_word": "че́ствовать",
                                "target_lang_sense_clarification": "прославлять"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "致敬",
                                "target_lang_sense_clarification": "表示敬意或赞赏"
                            },
                            {
                                "target_lang_word": "赞扬",
                                "target_lang_sense_clarification": "公开表彰"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "21a1ba13-712e-397d-bd8d-8f7cce95eae6",
                    "sense_definition": "To greet or address someone with a sign of welcome or recognition.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "general_greeting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The gentleman <w>saluted</w> his neighbors by tipping his hat as he walked by.",
                            "target_lang_translations": {
                                "ru": "Проходя мимо, джентльмен <w>поприветствовал</w> соседей, приподняв шляпу.",
                                "zh": "那位绅士走过时，通过摘帽向邻居<w>问候</w>。"
                            }
                        },
                        {
                            "text": "She <w>saluted</w> the guests warmly as they entered the hall.",
                            "target_lang_translations": {
                                "ru": "Она тепло <w>поприветствовала</w> гостей, когда они вошли в зал.",
                                "zh": "客人们进入大厅时，她热情地向他们<w>问候</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "greet",
                        "welcome",
                        "hail"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "common in older literature"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Здороваться или обращаться к кому-либо со знаком приветствия или признания.",
                        "zh": "以某种欢迎或认可的方式向某人打招呼。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приве́тствовать",
                                "target_lang_sense_clarification": "здороваться"
                            },
                            {
                                "target_lang_word": "кла́няться",
                                "target_lang_sense_clarification": "устаревшее/формальное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "问候",
                                "target_lang_sense_clarification": "打招呼"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1515b1a3-9f6b-3c3f-90ef-4182208e2ab5",
                    "sense_definition": "To kiss someone as a form of greeting.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "kiss",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He bowed low and <w>saluted</w> the lady's hand with great ceremony.",
                            "target_lang_translations": {
                                "ru": "Он низко поклонился и с большой церемонностью <w>поцеловал</w> руку дамы.",
                                "zh": "他深深鞠躬，郑重地<w>亲吻</w>了女士的手。"
                            }
                        },
                        {
                            "text": "In the old play, the hero <w>salutes</w> the heroine before departing for war.",
                            "target_lang_translations": {
                                "ru": "В старой пьесе герой <w>целует</w> героиню перед уходом на войну.",
                                "zh": "在那部老戏里，英雄在奔赴战场前<w>亲吻</w>了女主角。"
                            }
                        }
                    ],
                    "synonyms": [
                        "kiss"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "mostly found in older literary texts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Целовать кого-либо в знак приветствия (устаревшее или литературное значение).",
                        "zh": "作为问候方式亲吻某人（多见于文学作品）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "целова́ть",
                                "target_lang_sense_clarification": "касаться губами"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "亲吻",
                                "target_lang_sense_clarification": "礼节性接触"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a7be56df-bb78-35d6-bd28-5c16cac58b7a",
                    "sense_definition": "A formal gesture of respect or greeting, typically made by raising the hand to the forehead.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "gesture_honor",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The general returned the <w>salute</w> of the young private.",
                            "target_lang_translations": {
                                "ru": "Генерал ответил на <w>приветствие</w> молодого рядового.",
                                "zh": "将军回了那位年轻列兵的<w>敬礼</w>。"
                            }
                        },
                        {
                            "text": "She gave a quick <w>salute</w> to her friends before driving away.",
                            "target_lang_translations": {
                                "ru": "Она послала друзьям быстрый прощальный <w>салют</w>, прежде чем уехать.",
                                "zh": "开车离开前，她向朋友们快速地行了个<w>敬礼</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "greeting",
                        "gesture"
                    ],
                    "common_phrases": [
                        "give a salute",
                        "military salute",
                        "take the salute"
                    ],
                    "target_lang_definitions": {
                        "ru": "Формальный жест уважения или приветствия, обычно выполняемый поднятием руки к голове.",
                        "zh": "一种正式的敬意或问候姿势，通常通过举手至头部完成。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приве́тствие",
                                "target_lang_sense_clarification": "жест"
                            },
                            {
                                "target_lang_word": "отда́ние че́сти",
                                "target_lang_sense_clarification": "военный термин"
                            },
                            {
                                "target_lang_word": "салю́т",
                                "target_lang_sense_clarification": "разговорное или пионерское"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "敬礼",
                                "target_lang_sense_clarification": "动作名称"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "85ffd1be-c764-3a73-83a8-9adee2a0d9c0",
                    "sense_definition": "The firing of guns or cannons as a formal sign of honor or celebration.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "military_display",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A twenty-one-gun <w>salute</w> was fired to mark the royal birthday.",
                            "target_lang_translations": {
                                "ru": "В честь дня рождения монарха был дан <w>салют</w> из двадцати одного орудия.",
                                "zh": "为庆祝皇室生日，鸣放了二十一响<w>礼炮</w>。"
                            }
                        },
                        {
                            "text": "The ship fired a <w>salute</w> as it entered the friendly harbor.",
                            "target_lang_translations": {
                                "ru": "Корабль дал <w>салют</w> при входе в дружественную гавань.",
                                "zh": "船只进入友好港口时鸣放了<w>礼炮</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "volley",
                        "cannonade"
                    ],
                    "common_phrases": [
                        "gun salute",
                        "21-gun salute"
                    ],
                    "target_lang_definitions": {
                        "ru": "Стрельба из орудий или пушек как формальный знак почести или празднования.",
                        "zh": "作为正式荣誉或庆祝标志而鸣放的枪炮声。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "салю́т",
                                "target_lang_sense_clarification": "орудийный залп или фейерверк"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "礼炮",
                                "target_lang_sense_clarification": "鸣放的炮火"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b8243781-cbbf-3e0e-9464-8ff1806a1d3a",
                    "sense_definition": "A kiss given as a greeting or sign of respect.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "kiss",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He planted a gentle <w>salute</w> on her cheek.",
                            "target_lang_translations": {
                                "ru": "Он запечатлел нежный <w>поцелуй</w> на её щеке.",
                                "zh": "他在她脸颊上留下了一个温柔的<w>吻</w>。"
                            }
                        },
                        {
                            "text": "The courtier offered a respectful <w>salute</w> to the queen's hand.",
                            "target_lang_translations": {
                                "ru": "Придворный почтительно запечатлел <w>поцелуй</w> на руке королевы.",
                                "zh": "侍臣恭敬地在女王手上落下一<w>吻</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "kiss",
                        "peck"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "literary usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Поцелуй как знак приветствия или уважения (устаревшее).",
                        "zh": "作为问候或敬意标志的亲吻（古语）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поцелу́й",
                                "target_lang_sense_clarification": "прикосновение губами"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "吻",
                                "target_lang_sense_clarification": "礼节性亲吻"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}