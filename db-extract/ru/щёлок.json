                                        "entry_id": "f9ede68d-7d7c-3b5b-9c2c-31a9b6e4a024",
                                        "glosses": [
                                            "A short side line, connected with the main line; a turn-out; a siding."
                                        ],
                                        "tags": [
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6cf65ea8-2dad-4599-96c8-3f2a68193312",
                                                "sense_id": "e75142cd-08db-3d42-8cd7-4220f9b47dd8",
                                                "text": "Brakevan lye. [same page in the main text] There is also an inclined lye for brakevans at each end of the yard."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
