                        "sense_id": "f46d761d-1814-3417-893a-b6312908484f",
                        "entry_id": "b3a993bb-5f43-3194-b8e8-9249a7b37707",
                        "glosses": [
                            "(Graphisme) Donner un effet néon à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f13b8b20-a4f2-4a21-9a0c-4f8b1bfb1552",
                                "sense_id": "f46d761d-1814-3417-893a-b6312908484f",
                                "text": "voici également le code pour choisir la couleur qu'on veut \"néoner\" dans une image: (…)"
                            },
                            {
                                "example_id": "2e1f8ce4-4a27-41e1-b0ca-a9acc0d3ca70",
                                "sense_id": "f46d761d-1814-3417-893a-b6312908484f",
                                "text": "La musique de fond instaure tout de même l'ambiance en duo avec les graphismes au rendu industriel et néoné que nous proposent les couloirs des niveaux tout au long de l’aventure."
                            }
                        ]
                    },
                    {
                        "sense_id": "6be3af98-e339-3b80-af2b-cc1d3dd74f30",
                        "entry_id": "b3a993bb-5f43-3194-b8e8-9249a7b37707",
                        "glosses": [
                            "Éclairer au néon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f91e522-ac56-4b98-b013-f89dae1f60fc",
                                "sense_id": "6be3af98-e339-3b80-af2b-cc1d3dd74f30",
                                "text": "J'ai pas eu de soucis pour d'autres graines car ils sont en terrarium chauffé et néoné"
                            }
                        ]
                    },
                    {
                        "sense_id": "bcca99a6-7258-354e-a4f8-73b8bd6d7fae",
                        "entry_id": "b3a993bb-5f43-3194-b8e8-9249a7b37707",
                        "glosses": [
                            "Briller comme un néon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6bbdc85d-4cd0-4047-94c0-befef76977ad",
                                "sense_id": "bcca99a6-7258-354e-a4f8-73b8bd6d7fae",
                                "text": "Elle scintille, elle néone, elle embrase, elle irradie, elle étincelle, elle flambe, elle postillonne des reflets, dans sa carapace de joncaille, de diams et de perlouzes."
                            }
                        ]
                    }
