                "senses": [
                    {
                        "sense_id": "a0d719e2-cfb7-3c9e-bc5a-3d4aeb97a238",
                        "entry_id": "d2e0522e-e7f7-3822-b1ff-11d2e30d1ba6",
                        "glosses": [
                            "het niet meer bestuurd worden door een ander, ook niet als die ander \\\"het beste met je voor heeft\\"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "68c33f80-443b-4853-b328-0893c1968a63",
                                "sense_id": "a0d719e2-cfb7-3c9e-bc5a-3d4aeb97a238",
                                "text": "De afgelopen decennia was er sprake van een versnelde ontvoogding van jongeren. De verlaging van de meerderjarigheids­leeftijd van 21 naar 18 jaar is daar een duidelijk voorbeeld van. Voor 1970 moest je tot je dertigste jaar toestemming van je ouders hebben om een huwelijk te kunnen sluiten. Ook wat betreft medische behandelingen is de stem van de desbetreffende jongere zwaarder gaan wegen."
                            },
                            {
                                "example_id": "8a4bb553-7b16-4735-90e5-04d377c90646",
                                "sense_id": "a0d719e2-cfb7-3c9e-bc5a-3d4aeb97a238",
                                "text": "De politieke partijen overkwam hetzelfde. Het is aannemelijk dat men door breder en beter onderwijs en door de ontvoogding in de jaren ’60 en ’70 vond dat men de zuil of de partij niet meer nodig had."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "05cbfdb5-0a2c-4bba-9954-0c7081c620ec",
                        "source_entry_id": "d2e0522e-e7f7-3822-b1ff-11d2e30d1ba6",
                        "source_sense_id": "a0d719e2-cfb7-3c9e-bc5a-3d4aeb97a238",
