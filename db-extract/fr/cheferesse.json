                        "examples": [
                            {
                                "example_id": "d98bd57e-c8da-4a6f-8924-3a9f9251ce66",
                                "sense_id": "0eda196d-3018-3091-b949-162a31c64ca3",
                                "text": "Puis, une valse due à l’inspiration du chef ou de la cheferesse d’orchestre, Mᵐᵉ Amann Weinlich ; cette valse où domine un unisson d’instruments à cordes, s’intitule Fleur des Alpes ; nous y avons trouvé quelques réminiscences de certaines valses d’Olivier Métra."
                            },
                            {
                                "example_id": "be1062cb-5b6d-471e-a6de-3e8548e121f6",
                                "sense_id": "0eda196d-3018-3091-b949-162a31c64ca3",
                                "text": "Les cheferesses de prières jouent également un rôle important : gardiennes des chapelles, elles président les offices religieux en l’absence du missionnaire; et en tant que sacristines et catéchistes, elles l’assistent, quand il est au poste"
                            },
                            {
                                "example_id": "aacc5720-3bc4-456c-95d6-7f4ffa9bb07f",
                                "sense_id": "0eda196d-3018-3091-b949-162a31c64ca3",
                                "text": "[…] la littérature ethnohistorique produite avant 1800 ne comporte aucune autre référence concernant la présence de « cheferesses » exerçant ouvertement le pouvoir politique chez les Oneidas."
                            }
                        ]
                    }
