                "senses": [
                    {
                        "sense_id": "921fcbea-1de6-36f9-b498-5be061eaa6b0",
                        "entry_id": "a2e3a09d-7794-3dde-bfe3-489c2db93fe6",
                        "glosses": [
                            "persoon die tot een barbaarse destructieve groep behoort; een materialistisch ingestelde cultuurbarbaar"
                        ],
                        "tags": [],
