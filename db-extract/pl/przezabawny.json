                                            {
                                                "example_id": "8f3aef96-ae7e-4b27-9c9d-b8dc6c04bd1b",
                                                "sense_id": "d2ea3925-6bf4-3ea6-8242-526804cc61f4",
                                                "text": "Do you like Monty Python? I think they're hilarious."
                                            }
