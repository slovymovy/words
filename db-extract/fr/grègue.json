                    }
                ],
                "senses": [
                    {
                        "sense_id": "b44700f9-f7fb-3298-928e-7dd16367b022",
                        "entry_id": "8826cf51-71e5-3578-85fb-c6cb9d12b4d8",
                        "glosses": [
                            "Haut-de-chausses moulants."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d61ca983-3e39-4317-9218-a5907123e579",
                                "sense_id": "b44700f9-f7fb-3298-928e-7dd16367b022",
                                "text": "Jehan Frollo du Moulin s’aperçut en s’habillant que ses grègues qui contenaient sa bourse ne rendaient aucun son métallique."
                            },
                            {
                                "example_id": "f85d8a73-1868-4e23-a86f-557b5db3f14c",
                                "sense_id": "b44700f9-f7fb-3298-928e-7dd16367b022",
                                "text": "De temps en temps, nous rencontrions des Maragatos en voyage avec leur costume du seizième siècle, justaucorps de cuir serré par une boucle, larges grègues, chapeau à grands bords ; […]."
                            },
                            {
                                "example_id": "4ba1d00b-da36-40c4-a3c2-fee640653009",
                                "sense_id": "b44700f9-f7fb-3298-928e-7dd16367b022",
                                "text": "À votre place, je donnerais deux cigares à l’imbécile qui a pleins pouvoirs dans cette vallée de Josaphat et je tirerais mes grègues du côté de la Drôme où vous avez des chances d’échapper à la saloperie, si ce qu’on dit est vrai."
                            },
                            {
                                "example_id": "718b6104-28c4-410a-92a7-55a8d5d5708a",
                                "sense_id": "b44700f9-f7fb-3298-928e-7dd16367b022",
                                "text": "En d’autres circonstances, il aurait rossé ce coquin buté. Mais s’il le faisait, tous les hommes libres de l’équipage tireraient leurs grègues dès le lendemain."
                            },
                            {
                                "example_id": "f7780dd4-9834-4427-992b-61101944e571",
                                "sense_id": "b44700f9-f7fb-3298-928e-7dd16367b022",
                                "text": "Autran-le-roux rit méchamment, encourage et pousse son bâtard. Et déjà un galop de pattes tambourine aux grègues de Renard, le relance d’un élan forcené."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
