                },
                {
                    "sense_id": "ad69c1c3-7da3-3521-bf91-4794e1c698bf",
                    "sense_definition": "Established to remain in effect or hold a position for an unlimited duration.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "legal_duration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The author sought <w>perpetual</w> copyright for his works to protect his family's legacy.",
                            "target_lang_translations": {
                                "ru": "Автор добивался <w>бессрочного</w> авторского права на свои произведения, чтобы защитить наследие своей семьи.",
                                "tr": "Yazar, ailesinin mirasını korumak için eserleri üzerinde <w>süresiz</w> telif hakkı talep etti."
                            }
                        },
                        {
                            "text": "The treaty was designed to ensure a <w>perpetual</w> peace between the two nations.",
                            "target_lang_translations": {
                                "ru": "Договор был призван обеспечить <w>вечный</w> мир между двумя народами.",
                                "tr": "Antlaşma, iki ulus arasında <w>ebedi</w> bir barışı sağlamak için tasarlanmıştı."
                            }
                        }
