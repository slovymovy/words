                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96c6ffbe-247b-45e8-8c6e-ce1145560173",
                                "sense_id": "1cce1876-cfa2-3a54-a183-66c8e08420a5",
                                "text": "DEN HAM - De festiviteiten op Koninginnedag worden in Den Ham voortaan georganiseerd door de stichting Oranje Hart Den Ham. Deze groep van elf mensen, inclusief voorzitter Johan Vliek, neemt het stokje over van het Oranjecomité Den Ham."
                            },
                            {
                                "example_id": "b916d7d2-e6a3-4d7a-a752-6cc5e3c1e854",
                                "sense_id": "1cce1876-cfa2-3a54-a183-66c8e08420a5",
                                "text": "Het Oranjecomité Vasse zoekt met spoed enkele vaders of moeders die plaats willen nemen in het Oranjecomité. Het comité bestaat nu nog uit vijf moeders, waarvan er na Koninginnedag 2011 één stopt."
                            }
                        ]
