                        "sense_id": "aca115d7-0f75-399e-9d09-774675f83454",
                        "entry_id": "97093b3d-f039-35cc-8bc7-42c260ac841f",
                        "glosses": [
                            "alpenländischer Volkssport auf einer Eisfläche, bei dem zwei Mannschaften versuchen, ihre Eisstöcke möglichst nah an einem Ziel, der Daube, zu platzieren"
                        ],
                        "tags": [
                            "Wintersport"
                        ],
                        "examples": [
                            {
                                "example_id": "9e016531-5f14-469e-893b-c3f26fda06f6",
                                "sense_id": "aca115d7-0f75-399e-9d09-774675f83454",
                                "text": "„Weltweite Aufmerksamkeit erregte das Eisstockschießen erstmals 1936 bei den Olympischen Winterspielen in Garmisch-Partenkirchen, wo dieser Eissport außer Konkurrenz in einem Rahmenprogramm dargeboten und von österreichischen Sportlern dominiert wurde.“"
                            },
                            {
                                "example_id": "730c8aff-3d65-4c1d-acbe-f1dfda3321c8",
                                "sense_id": "aca115d7-0f75-399e-9d09-774675f83454",
                                "text": "„Curling, eine olympische Disziplin, verhält sich zum ‚wilden‘ Eisstockschießen wie ein vollklimatisierter Mittelklassewagen zu einem Pferdefuhrwerk.“"
                            }
                        ],
