                "senses": [
                    {
                        "sense_id": "e189e4f9-ec49-3c73-8ab0-13127b9e09bf",
                        "entry_id": "3d51db94-49be-3a7d-8c79-056db9b01cd0",
                        "glosses": [
                            "Prüfung, bei der festgestellt wird, ob beziehungsweise inwiefern etwas oder jemand für einen Zweck in Frage kommt (geeignet ist)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f90177d-0934-4bfa-ac25-3aa60f518a73",
                                "sense_id": "e189e4f9-ec49-3c73-8ab0-13127b9e09bf",
                                "text": "Zuerst musst du den Eignungstest bestehen."
                            },
                            {
                                "example_id": "fad16c9a-bfcd-4e6e-ab64-70ad7717a0f4",
                                "sense_id": "e189e4f9-ec49-3c73-8ab0-13127b9e09bf",
                                "text": "Junge Menschen, die Verkehrspilot werden wollen, müssen sich einem umfangreichen Eignungstest unterziehen."
                            },
                            {
                                "example_id": "ee83a259-5f1c-4e0c-a62c-69f200165400",
                                "sense_id": "e189e4f9-ec49-3c73-8ab0-13127b9e09bf",
                                "text": "„Mit Ausnahme der obersten Führung mussten die Offiziere verschiedene Eignungstests und Prüfungen durchlaufen, bei denen der Bildungsstand entscheidend wurde.“"
                            },
                            {
                                "example_id": "425d4507-7da4-45e8-b182-9ad972ed5c5d",
                                "sense_id": "e189e4f9-ec49-3c73-8ab0-13127b9e09bf",
                                "text": "„Die Anwärter müssen sich dann als Erstes einem standardisierten Eignungstest unterziehen, der wie folgt abläuft: Angehende Reporter berichten vor einer großen Zuhörerschaft und schreiben tagelang Tests.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
