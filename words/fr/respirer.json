                    "frequency": "Low",
                    "semantic_group_id": "vie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tant que je <w>respirerai</w>, je garderai intact le souvenir de cette belle amitié."
                        },
                        {
                            "text": "Le vieux marquis <w>respirait</w> encore, dernier survivant d'une famille autrefois puissante."
