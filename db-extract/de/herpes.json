                                        "sense_id": "25cb07db-b806-3727-84c6-0d9f59b13a99",
                                        "entry_id": "09622811-41f5-3459-962a-45abe70a5cd4",
                                        "glosses": [
                                            "A viral infection, caused by Human alphaherpesvirus 1 and Human alphaherpesvirus 2, marked by painful, watery blisters in the skin or in the mucous membranes or on the genitals."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f2a35e2a-1bbc-4dc7-9c34-7bb2b81a1637",
                                                "sense_id": "25cb07db-b806-3727-84c6-0d9f59b13a99",
                                                "text": "This, of course, is something only people with that STI would know. For example, herpes is 437737."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a0b35bed-0257-4235-a014-57cf0df34619",
                        "source_entry_id": "940a210a-358a-3b83-8349-b437474093a5",
                        "source_sense_id": "2af2c8c2-ac62-3afe-8308-19e1fda379e6",
                        "source_sense_description": "durch Herpes-simplex-Viren hervorgerufene Infektion",
