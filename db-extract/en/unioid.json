                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "cbe6df09-b35f-44cc-b676-20f85fbcd9cf",
                                "sense_id": "e805bed7-ddf3-3d02-8b93-8fd1a869185c",
                                "text": "Thirty-five bivalve taxa from the Hells Canyon locality are discussed. Of these, seven are new: the mytilid Mysidiella cordillerana n. sp., the limacean Antiquilima vallieri n. sp., the true oyster Liostrea newelli n. sp., the pectinacean Crenamussium concentricum n. gen. and sp., the unioid Cardinioides josephus n. sp., the trigoniacean Erugonia canyonensis n. gen. and sp., and the carditacean Palaeocardita silberlingi n. sp."
                            },
                            {
                                "example_id": "cdfcb030-5d2c-4b16-8d2f-440ba6d6364f",
                                "sense_id": "e805bed7-ddf3-3d02-8b93-8fd1a869185c",
                                "text": "Species of the oldest freshwater bivalve genus, the unioid Archanodon, are well known from Frasnian strata in New York State (Bridge et al. 1986)."
                            },
                            {
                                "example_id": "7a2e0b2c-81b5-4b0d-8917-5e0954788c59",
                                "sense_id": "e805bed7-ddf3-3d02-8b93-8fd1a869185c",
                                "text": "Large unioids like Anodonta, Unio and Hyridella are sometimes abundant in well-mixed macrophyte-dominated lakes and can filter the entire water volume in 1.5–3 days (Ogilvie & Mitchell, 1995)."
                            }
                        ]
                    }
