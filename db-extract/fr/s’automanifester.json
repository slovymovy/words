                        "tags": [],
                        "examples": [
                            {
                                "example_id": "920a4d56-2e68-4b9b-800a-54c1b40d3a43",
                                "sense_id": "c9858f7d-7083-3173-82b5-933960e79aa0",
                                "text": "Un troisième service que doit rendre la cathédrale, c’est de permettre à la vie de l’Église locale de s’automanifester."
                            },
                            {
                                "example_id": "7cee7807-8a93-40fa-8ea2-ef484ddbf804",
                                "sense_id": "c9858f7d-7083-3173-82b5-933960e79aa0",
                                "text": "À l’un comme à l’autre, le glissement de l’hypostase, identifiée par son prosopon, ouvre la possibilité de s’automanifester dans une image."
                            }
                        ]
