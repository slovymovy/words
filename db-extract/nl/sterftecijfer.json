                        "source_sense_id": "25a1689d-5aa4-3470-9a14-123f184b8777",
                        "source_sense_description": "een getal dat aangeeft hoeveel sterfgevallen er in een gebied in een bepaalde tijd hebben plaatsgevonden",
                        "target_lang_word": "смертность",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "смертность",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "96068314-8330-357f-8791-6d1d63623f12",
                                        "entry_id": "93dcf960-0bd1-3229-bb39-a9a1bb19ec3e",
                                        "glosses": [
                                            "неисч. свойство по значению прилагательного смертный; подверженность смерти, неспособность жить вечно"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd3bc9dd-8ad2-47aa-a8b8-8f1f860aa6a3",
                                                "sense_id": "96068314-8330-357f-8791-6d1d63623f12",
                                                "text": "Ты зришь твоё разрушение, ты зришь конечную и неминуемую твою смертность."
                                            },
                                            {
                                                "example_id": "1d809527-d1d5-4729-ab9f-d673413953d7",
                                                "sense_id": "96068314-8330-357f-8791-6d1d63623f12",
                                                "text": "Для существ, более нас совершенных, наша смертность, без сомнения, есть истина, находящаяся в связи с неизъясненным нам явлением природы и так же строго доказанная, как доказываются геометрические теоремы, например квадрат гипотенузы."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "af21e6a6-12a0-3b8e-abeb-d3a1702168db",
                                        "entry_id": "93dcf960-0bd1-3229-bb39-a9a1bb19ec3e",
                                        "glosses": [
                                            "неисч. количество случаев смерти среди определенной совокупности организмов"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba78bd44-16af-430a-84a2-c82c75374fbc",
                                                "sense_id": "af21e6a6-12a0-3b8e-abeb-d3a1702168db",
                                                "text": "С применением антикоагулянтов смертность при лечении инфаркта миокарда уменьшилась вдвое."
                                            },
                                            {
                                                "example_id": "7355597a-110a-48c5-8ec5-efb22c84d3d2",
                                                "sense_id": "af21e6a6-12a0-3b8e-abeb-d3a1702168db",
                                                "text": "Смертность крыс при отрицательной ионизации была минимальная, при положительной ― максимальная."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
