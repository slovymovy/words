                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Laubbaum",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "28285934-3c17-31fc-9bd4-f304701c549b",
                                        "entry_id": "851a3599-1642-33ee-9144-e50e795585fb",
                                        "glosses": [
                                            "Baum, der nicht zu den Nadelbäumen gehört, in der Regel mit breiten bis mäßig schmalen Blättern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae0650f6-7608-4d0d-be65-b3e465c46cd7",
                                                "sense_id": "28285934-3c17-31fc-9bd4-f304701c549b",
                                                "text": "Die Tamariske ist auch ein Laubbaum."
                                            },
                                            {
                                                "example_id": "c460e77c-8d47-43f1-bbd4-bc1a07fe6d18",
                                                "sense_id": "28285934-3c17-31fc-9bd4-f304701c549b",
                                                "text": "„So wachsen auf vielen ehemaligen Fichtenforsten junge Mischwälder heran, die von Laubbäumen geprägt sind.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a52699d3-d907-3900-97ff-caf79346a8fd",
                                        "entry_id": "851a3599-1642-33ee-9144-e50e795585fb",
                                        "glosses": [
                                            "sommergrüner Baum"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e46df012-9345-425a-b63f-2469d6a1dca2",
                                                "sense_id": "a52699d3-d907-3900-97ff-caf79346a8fd",
                                                "text": "„Sein Kopf war nahezu perfekt eiförmig, und er blickte aus dem Fenster auf einen Laubbaum mit zwei zwitschernden Distelfinken, als verkörperten sie den Sinn des Lebens.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aa14c40b-b514-4293-8b80-c92eaaa80b42",
                        "source_entry_id": "e8188e0c-185f-3285-bed0-8537f17ae7f8",
                        "source_sense_id": "8d1f97a3-597d-3ec8-a04d-1b999a0694d9",
