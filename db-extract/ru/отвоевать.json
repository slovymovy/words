                "senses": [
                    {
                        "sense_id": "9bff4d0a-eac7-399e-89ab-db29432cbf76",
                        "entry_id": "11084bdd-5d04-38c7-845a-1b0127e7cbc3",
                        "glosses": [
                            "воюя, возвратить утерянное ранее"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "eaa03b91-b581-39fe-bade-0175d212f03a",
                        "entry_id": "11084bdd-5d04-38c7-845a-1b0127e7cbc3",
                        "glosses": [
                            "получить что-либо, добиться чего-либо в борьбе"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "fd9b2b88-1eb6-32b5-8066-ea76b695340e",
                        "entry_id": "11084bdd-5d04-38c7-845a-1b0127e7cbc3",
                        "glosses": [
                            "прекратить проводить время, воюя"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "935d77cb-1f08-422a-a203-f9b26fad9f85",
                                "sense_id": "fd9b2b88-1eb6-32b5-8066-ea76b695340e",
                                "text": "Отвоевал я своё, сынки."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0bf9e5ab-e141-41c7-a3f6-56d0621e6bca",
                        "source_entry_id": "11084bdd-5d04-38c7-845a-1b0127e7cbc3",
                        "target_lang_word": "regain",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "regain",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "69b9b671-8061-34ec-a451-2f774dedf517",
                                        "entry_id": "d484c87f-5dea-3c76-ab87-bbbc535d0d0c",
                                        "glosses": [
                                            "To get back; to recover possession of."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "20318857-9bb8-4b56-93e2-5aac16ed8369",
                                                "sense_id": "69b9b671-8061-34ec-a451-2f774dedf517",
                                                "text": "DUKAT: I blame no one but myself. I was indiscreet. I compromised myself and have been punished accordingly. If someone under my command had behaved so outrageously, I would do the same thing to him. Besides, I assure you, this is only a temporary setback. Everything I have lost, I will regain. It's only a matter of time."
                                            },
                                            {
                                                "example_id": "72d7bd09-863f-4976-a909-8e34985ffa86",
                                                "sense_id": "69b9b671-8061-34ec-a451-2f774dedf517",
                                                "text": "Sarkozy's total will be seen as a personal failure. It is the first time an outgoing president has failed to win a first-round vote in the past 50 years and makes it harder for Sarkozy to regain momentum."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "regain",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1a27a4e8-abc4-33d1-8b81-62d8272c3ff4",
                                        "entry_id": "6c3a1780-7b51-3f4d-aa81-ae2599f17f52",
                                        "glosses": [
                                            "The act or process of regaining something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "50f68e1b-d53d-4235-8eea-1ee49420da7b",
                                                "sense_id": "1a27a4e8-abc4-33d1-8b81-62d8272c3ff4",
                                                "text": "Patients who plateau after weight loss are more likely to blame the regain on something that they are responsible for – the wrong course of action they took or a specic oversight that they kept repeating–rather than who they are."
                                            },
                                            {
                                                "example_id": "33cc6d4a-5a07-4163-94df-19fd39468c3d",
                                                "sense_id": "1a27a4e8-abc4-33d1-8b81-62d8272c3ff4",
                                                "text": "By beginning deeper, this allows the opposition to start and build much higher, naturally luring them away from their own goal. As long as the actions after a regain are then quick, forward, and performed with quality, counter-attacks can prove a particularly useful attacking strategy to win football matches."
                                            },
                                            {
                                                "example_id": "d47960ea-fad8-4555-9ca6-af707f802648",
                                                "sense_id": "1a27a4e8-abc4-33d1-8b81-62d8272c3ff4",
                                                "text": "The samples with SAPs showed a regain in strength when stored in an RH of more than 90%."
                                            },
                                            {
                                                "example_id": "0f5f5902-b1e5-44aa-adfa-6ad881810089",
                                                "sense_id": "1a27a4e8-abc4-33d1-8b81-62d8272c3ff4",
                                                "text": "Negative collective memories are effective, as much as positive memories, in choosing a regain for lost heritage building associated with them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "14f75e76-5f52-339c-880e-1a9c480b957b",
                                        "entry_id": "6c3a1780-7b51-3f4d-aa81-ae2599f17f52",
                                        "glosses": [
                                            "The amount of width a woven cloth grows by when the fibers swell, used to determine the width of the reed to use in weaving."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93e19459-343d-4db2-86b1-a5c653caf697",
                                                "sense_id": "14f75e76-5f52-339c-880e-1a9c480b957b",
                                                "text": "The number of ends per inch may vary to some slight extent at different places in the width of the cloth and in different pieces woven to the same particulars , but if the regain is correctly estimated , the calculated reed to be used will be the same, unless a special reed has been used in weaving the cloth."
                                            },
                                            {
                                                "example_id": "f5827347-af13-4791-8755-3cd15522d26d",
                                                "sense_id": "14f75e76-5f52-339c-880e-1a9c480b957b",
                                                "text": "In particular, at high humidities the regain of wool is lower."
                                            },
                                            {
                                                "example_id": "f1224004-7f6b-4ca5-a737-b52efddeea95",
                                                "sense_id": "14f75e76-5f52-339c-880e-1a9c480b957b",
                                                "text": "Because of the fiber price per pound, and the size of the lots, the regain must be determined accurately."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
