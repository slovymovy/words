                ],
                "senses": [
                    {
                        "sense_id": "b88e4433-3313-386a-a3f9-88ca95398dbd",
                        "entry_id": "b4ce35ae-2e87-33e6-aa22-5a5e91e48ec0",
                        "glosses": [
                            "Voir ce qui transparaît de."
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "2d171d2e-0ce7-4a0e-905c-9c2428a480ae",
                                "sense_id": "b88e4433-3313-386a-a3f9-88ca95398dbd",
                                "text": "Daniel s’attarda un moment à translucider la tablée. Mais loin de pénétrer les arcanes des intermittences des cœurs, il ne vit soudain, dans cette assemblée de transparences assises, que l’horreur du transit alimentaire […]."
                            },
                            {
                                "example_id": "d618b89d-1e56-48e6-b2bb-4d432a42f0cc",
                                "sense_id": "b88e4433-3313-386a-a3f9-88ca95398dbd",
                                "text": "Il m’est extrêmement facile de ressentir les impressions d’une femme, d’éprouver ce qu’elle éprouve, de la translucider et de la perscruter."
                            }
                        ]
                    },
                    {
                        "sense_id": "475b10d5-94e5-3207-9a78-bf7a2fc6ce21",
                        "entry_id": "b4ce35ae-2e87-33e6-aa22-5a5e91e48ec0",
                        "glosses": [
                            "Faire transparaître."
                        ],
                        "tags": [
                            "Très rare"
                        ],
                        "examples": [
                            {
                                "example_id": "71cdad3a-745b-46c9-8cf5-8e0791ddefae",
                                "sense_id": "475b10d5-94e5-3207-9a78-bf7a2fc6ce21",
                                "text": "En même temps qu’il démasquait l’hérésie, les conciles d’Orient précisaient et consolidaient les dogmes. La condamnation de l’erreur translucidait la vérité."
                            }
                        ]
                    },
                    {
                        "sense_id": "fd4ceae8-2161-38b3-aaa4-00a7ea5f5fae",
                        "entry_id": "b4ce35ae-2e87-33e6-aa22-5a5e91e48ec0",
                        "glosses": [
                            "Réfracter."
                        ],
                        "tags": [
                            "poetic"
                        ],
                        "examples": [
                            {
                                "example_id": "1fbc5999-d9e0-4ef3-b9bc-7dc204d60f58",
                                "sense_id": "fd4ceae8-2161-38b3-aaa4-00a7ea5f5fae",
                                "text": "Et ce fleuve en feu sur ma piste\nCourt translucider l’arc-en-ciel,\nPour devenir l’art symboliste\nDu vitrail existentiel."
                            }
                        ]
                    },
                    {
                        "sense_id": "4b1e38df-499f-34f2-8858-243e3c26af7b",
                        "entry_id": "b4ce35ae-2e87-33e6-aa22-5a5e91e48ec0",
                        "glosses": [
                            "Transparaître."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "0c12b072-385d-46f8-a3dc-fca3dc775a65",
                                "sense_id": "4b1e38df-499f-34f2-8858-243e3c26af7b",
                                "text": "Nagaharou savait tout cela, et sa colère tombait peu à peu devant la terreur mystérieuse que lui inspirait à l’avance cette âme ardente dont le reflet translucidait dans le regard."
                            }
                        ]
                    }
                ],
