                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bbcfcf00-b4d0-4991-80a3-05280cffba97",
                                "sense_id": "4efdc1c3-228a-3eb3-a9bc-8070a8997d13",
                                "text": "„Außerdem hat Uwe schmerzhaftes Rheuma und bereits mehrere Herzoperationen hinter sich.“"
                            },
                            {
                                "example_id": "f5b28c21-7c78-46c9-b3fb-ebb6fccf52a6",
                                "sense_id": "4efdc1c3-228a-3eb3-a9bc-8070a8997d13",
                                "text": "„Ein paar Tage später sollten mir genau die Medikamente verschrieben werden, die auch meiner Mutter nach ihrer Herzoperation verschrieben worden waren.“"
                            }
                        ],
