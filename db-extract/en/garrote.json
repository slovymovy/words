                                        "entry_id": "d5ba60c6-8cef-368b-bfce-6bffa07b9aed",
                                        "glosses": [
                                            "jemandem mechanisch den Hals zudrücken, so dass es zu einem Sauerstoffmangel im Gehirn kommt"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5b0be3dc-faab-4c6a-88a9-2f5eef7a6f86",
                                                "sense_id": "aff20b92-fef1-3f3d-b405-25a67ba8d3a7",
                                                "text": "Das Opfer wurde mit einem Seil stranguliert und dann im Wald verscharrt."
                                            },
                                            {
                                                "example_id": "b5bd2230-cdad-482f-9f9b-6ff398e1a3be",
                                                "sense_id": "aff20b92-fef1-3f3d-b405-25a67ba8d3a7",
                                                "text": "Manch einen erregt es sexuell, wenn er stranguliert wird."
                                            }
