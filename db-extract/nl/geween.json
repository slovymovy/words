                                                "sense_id": "f17dd12b-bec2-35cd-af2d-ba9cf5a65b4a",
                                                "text": "I hope my piteous pearcyng plaintes,"
                                            },
                                            {
                                                "example_id": "be317ac1-921f-4a07-876b-c328c5dc2fa2",
                                                "sense_id": "f17dd12b-bec2-35cd-af2d-ba9cf5a65b4a",
                                                "text": "The night has been unruly: where we lay,\nOur chimneys were blown down; and, as they say,\nLamentings heard i’ th’ air, strange screams of death[…]"
                                            },
                                            {
                                                "example_id": "10a288dd-07c2-48eb-8ba3-421ed0e16f83",
                                                "sense_id": "f17dd12b-bec2-35cd-af2d-ba9cf5a65b4a",
                                                "text": "One Project foil’d, another should be try’d,"
                                            }
                                        ]
                                    }
                                ]
                            }
