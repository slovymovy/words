                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5a035144-ebfb-416e-b4bf-bda287405a40",
                                                "sense_id": "4292886a-80f7-3187-bcbf-61f79a28b864",
                                                "text": "Kannst du mir mal den Rücken einschmieren? Hier ist das Sonnenöl."
                                            },
                                            {
                                                "example_id": "0214b5d6-d076-4890-9337-276bda51c820",
                                                "sense_id": "4292886a-80f7-3187-bcbf-61f79a28b864",
                                                "text": "Schmier doch die Schraube etwas mit Öl ein, dann geht sie leichter reinzudrehen."
                                            }
                                        ],
