                    {
                        "translation_id": "b86c7844-5fed-4c5f-96f4-de98e6d90da6",
                        "source_entry_id": "90defb7d-e348-3277-9f8c-b6b49f85298f",
                        "source_sense_id": "98c87355-336e-3245-aa3f-3f649ae6b98d",
                        "target_lang_word": "Lappe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lappe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f824adf3-44ea-31f0-a230-ce2896b653c5",
                                        "entry_id": "1d7632da-0227-3964-b666-0ebf0148798c",
                                        "glosses": [
                                            "ein eingeborenes Volk, das im Norden Finnlands, Schwedens und Norwegens lebt"
                                        ],
                                        "tags": [
                                            "outdated",
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c3017a8-4d64-4a35-b01e-1eb3ec0288f5",
                                                "sense_id": "f824adf3-44ea-31f0-a230-ce2896b653c5",
                                                "text": "„Das Rentier ist es, das im Winter unter dem flammenden Polarlicht wie im Sommer unter der mildleuchtenden Mitternachtssonne das Leben der Lappen bestimmt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "559c6dc6-a138-36f1-9c2a-97f419049e82",
                                        "entry_id": "1d7632da-0227-3964-b666-0ebf0148798c",
                                        "glosses": [
                                            "ein Angehöriger des gleichnamigen Volkes"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f0144592-0298-42ee-80cb-6968fd5de4ca",
                                                "sense_id": "559c6dc6-a138-36f1-9c2a-97f419049e82",
                                                "text": "„Hinter ihnen erschien als letzter der Lehrer, ein Lappe in europäischer Kleidung.“"
                                            },
                                            {
                                                "example_id": "3acfe174-948a-497e-92cd-d8fcec46ae7b",
                                                "sense_id": "559c6dc6-a138-36f1-9c2a-97f419049e82",
                                                "text": "„Die Anstrengungen, die das Zusammenhalten der Herde u. U. von den Hirten erfordert, kann aber niemand so anschaulich schildern wie der Lappe Turi: […]“"
                                            },
                                            {
                                                "example_id": "e0294ffa-744f-4260-9274-c53d9f9865fb",
                                                "sense_id": "559c6dc6-a138-36f1-9c2a-97f419049e82",
                                                "text": "„Auf diese Art ist der Lappe vorzugsweise auf seinen Reisen bekleidet und diese Kleidung ist ungefähr eine und dieselbe bei Männern und Weibern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
