                    {
                        "sense_id": "8a8be931-0e31-3656-89e2-e78cc627eafa",
                        "entry_id": "93b378b1-a5a3-3f2e-a653-9f66b2850089",
                        "glosses": [
                            "farbloser Kunststoff aus Polyacrylnitril, der zur Herstellung von Textilien und Farben verwendet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2736770f-d24a-4094-a973-4be1bc52a86f",
                                "sense_id": "8a8be931-0e31-3656-89e2-e78cc627eafa",
                                "text": "Das formbare Acryl ermöglicht vielseitige Gestaltungsmöglichkeiten und der hohe Granitanteil verleiht den Spülen ein natürliches Aussehen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "fe1ccd45-6237-3ecb-8df0-1608308825d2",
                        "entry_id": "93b378b1-a5a3-3f2e-a653-9f66b2850089",
                        "glosses": [
                            "wasserlösliche Farbe, die auf Acrylsäure basiert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c36dc4b5-8c0f-46ea-af82-7a67169c45bd",
                                "sense_id": "fe1ccd45-6237-3ecb-8df0-1608308825d2",
                                "text": "Es gab verschiedene Farbenarten wie Gouache, Acryl, Bundstifte, Pastellkreide, Wachs und Ölpastellfarben mit denen man malen konnte."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
