                "senses": [
                    {
                        "sense_id": "8aa4545d-a149-3f76-aeb2-df5831ff2dce",
                        "entry_id": "586ed186-1e05-388a-a535-fcb14538cf63",
                        "glosses": [
                            "hete saus van chilipepers Capsicum frutescensvar. tabasco , azijn en zout"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d2463b8-0248-40da-9351-61cf8d2ea973",
                                "sense_id": "8aa4545d-a149-3f76-aeb2-df5831ff2dce",
                                "text": "Ik had de tijd nog meegemaakt dat de ober op de uitserveertafel het vlees mengde met olie, mosterd, mayo, ui, kappers, tabasco en worcester. Met zijn vork stond hij de smurrie geroutineerd te kloppen, soms omkijkend om te vragen of meneer de steak pikant wenste of mild. Meneer wenste hem altijd zo spicy mogelijk en dronk er graag een gekoelde brouilly of rode sancerre bij."
                            },
                            {
                                "example_id": "90909763-c37c-4912-a5b3-c2ee4630a5a4",
                                "sense_id": "8aa4545d-a149-3f76-aeb2-df5831ff2dce",
                                "text": "'Jonny, je moet wel nuchter blijven voor als je straks moet rijden, dus wat zou je zeggen van een tomatensap met tabasco als versterkingshartje?"
                            },
                            {
                                "example_id": "f43b8e67-e0b9-4337-aefd-bc947cc5a0b7",
                                "sense_id": "8aa4545d-a149-3f76-aeb2-df5831ff2dce",
                                "text": "Drie druppels tabasco in de spaghetti. Dat vertrouwde shampoomerk. Ons vaste plekje op het perron. Tot op zekere hoogte zijn we allemaal gewoontedieren. Dat is maar goed ook, want routine maakt ons gelukkig. Negen redenen om niet alles in het leven spannend te maken."
                            },
                            {
                                "example_id": "b9b67bf1-7230-4a86-b91c-e4f448caf0bd",
                                "sense_id": "8aa4545d-a149-3f76-aeb2-df5831ff2dce",
                                "text": "Stap 4: Maak de mayonaise op smaak met zout en peper en geef er eventueel een eigen twist aan door tabasco of chilisaus toe te voegen."
                            }
                        ]
                    }
                ],
