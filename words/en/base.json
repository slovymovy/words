                                "target_lang_word": "baz",
                                "target_lang_sense_clarification": "beysbol kalesi"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "垒",
                                "target_lang_sense_clarification": "棒球术语"
                            }
                        ]
                    }
