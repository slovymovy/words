                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd1e1dfc-69a4-44d4-b436-726077b67e35",
                                "sense_id": "6aa98770-fe32-37a1-92bd-69de2cc98be2",
                                "text": "The society of beach-combers always repays the small pains you need be at to enjoy it. They are easy of approach and affable in conversation."
                            }
                        ]
                    },
                    {
                        "sense_id": "301779de-3594-3280-84d1-fc70d812bb76",
