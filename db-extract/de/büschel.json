                                "target_senses": [
                                    {
                                        "sense_id": "0aa073d8-54dd-3ca7-9202-9eb7e704488b",
                                        "entry_id": "a258f906-dda9-3175-956f-d8d1b7efb252",
                                        "glosses": [
                                            "A bunch of feathers, grass or hair, etc., held together at the base."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ad1febca-609d-35a9-858c-348943442e4e",
                                        "entry_id": "a258f906-dda9-3175-956f-d8d1b7efb252",
                                        "glosses": [
                                            "A cluster of threads drawn tightly through upholstery, a mattress or a quilt, etc., to secure and strengthen the padding."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bf6c9e4c-d172-3577-b5a3-b0ea61e2d749",
                                        "entry_id": "a258f906-dda9-3175-956f-d8d1b7efb252",
                                        "glosses": [
                                            "A small clump of trees or bushes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4ad12c9-63ce-429f-88c5-8ee0de04c46a",
                                                "sense_id": "bf6c9e4c-d172-3577-b5a3-b0ea61e2d749",
                                                "text": "“Not far from this place, there is a tuft of about a dozen of tall beeches […].”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4fa7a8e8-0317-353c-8809-7d9dcb67c35a",
                                        "entry_id": "a258f906-dda9-3175-956f-d8d1b7efb252",
                                        "glosses": [
                                            "A gold tassel on the cap worn by titled undergraduates at English universities."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "862e3000-f12c-304e-b20f-fbaa42ed04d5",
                                        "entry_id": "a258f906-dda9-3175-956f-d8d1b7efb252",
                                        "glosses": [
                                            "A person entitled to wear such a tassel."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2040311-2f22-43e7-b079-df5ccc9cecfe",
                                                "sense_id": "862e3000-f12c-304e-b20f-fbaa42ed04d5",
                                                "text": "A college tutor, or a nobleman’s toady, who appears one fine day as my right reverend lord, in a silk apron and a shovel-hat, and assumes benedictory airs over me, is still the same man we remember at Oxbridge, when he was truckling to the tufts, and bullying the poor undergraduates in the lecture-room."
                                            },
                                            {
                                                "example_id": "a6ff5e40-f0bf-4575-ad85-fa363bbb7d89",
                                                "sense_id": "862e3000-f12c-304e-b20f-fbaa42ed04d5",
                                                "text": "Several young tufts, and others of the faster men."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tuft",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "16e3c6c6-bbfd-300c-96a5-0e0f5bd90f1a",
