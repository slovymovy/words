                        "examples": [
                            {
                                "example_id": "5d18f7be-7c11-4d4c-ac2c-04578d0d0101",
                                "sense_id": "7bd0314c-f4f9-329d-9b01-bb1b7232e56d",
                                "text": "De schorsing is per direct ingegaan en geldt voor onbepaalde tijd. Het verenigingsbestuur zegt verdere maatregelen niet uit te sluiten. Het is nog niet duidelijk of de studentes aangifte bij de politie gaan doen, maar het bestuur zegt er begrip voor te hebben als ze dat doen."
                            },
                            {
                                "example_id": "451b3c23-02ef-4374-b648-613096cf3a7d",
                                "sense_id": "7bd0314c-f4f9-329d-9b01-bb1b7232e56d",
                                "text": "In december kwam het verenigingsbestuur er voor het eerst achter dat een aantal rekeningen niet was betaald. De penningmeester kreeg tot de jaarwisseling de tijd om alles in orde te maken, maar dat gebeurde niet."
                            }
                        ]
                    }
