            {
                "entry_id": "e3466521-5a6f-3341-8180-3900a408667c",
                "word": "dévorant",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "ff77ba56-9c43-434e-9a28-82f005f60272",
                        "entry_id": "e3466521-5a6f-3341-8180-3900a408667c",
                        "tags": [
