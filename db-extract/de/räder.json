                ],
                "senses": [
                    {
                        "sense_id": "4d6f1742-3101-302b-86cc-329563c40db1",
                        "entry_id": "20c18cf7-0d68-3d1e-a3d4-622c64c5ec6e",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86c0f11e-1d3e-4944-8268-e76f8560a880",
                                "sense_id": "4d6f1742-3101-302b-86cc-329563c40db1",
                                "text": "Frau Räder ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "9234c478-199a-45e9-bd01-1f910975682e",
                                "sense_id": "4d6f1742-3101-302b-86cc-329563c40db1",
                                "text": "Herr Räder wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "52f487a9-12f6-4b3b-8dc5-ed61835d3308",
                                "sense_id": "4d6f1742-3101-302b-86cc-329563c40db1",
                                "text": "Die Räders fliegen heute nach Liverpool."
                            },
                            {
                                "example_id": "6cc90816-9774-47c0-b50d-5982175d1c8f",
                                "sense_id": "4d6f1742-3101-302b-86cc-329563c40db1",
                                "text": "Der Räder trägt nie die Pullover, die die Räder ihm strickt."
                            },
                            {
                                "example_id": "61762770-4bc8-408b-ae4f-5aaa3987633a",
                                "sense_id": "4d6f1742-3101-302b-86cc-329563c40db1",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Räder kommt, geht der Herr Räder.“"
                            },
                            {
                                "example_id": "9d7b7995-b457-4c41-8d7b-5c4568c20409",
                                "sense_id": "4d6f1742-3101-302b-86cc-329563c40db1",
                                "text": "Räder kommt und geht."
                            },
                            {
                                "example_id": "00e1a907-d2aa-4d0a-b1aa-43142df21287",
                                "sense_id": "4d6f1742-3101-302b-86cc-329563c40db1",
                                "text": "Räders kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
