                {
                    "sense_id": "1f0895ec-9150-3547-be9c-3ca4643acd0d",
                    "sense_definition": "O człowieku: często zmieniający swoje poglądy, uczucia lub nastroje.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mój szef ma bardzo <w>zmienny</w> nastrój, nigdy nie wiadomo, czego się spodziewać.",
                            "target_lang_translations": {
                                "ru": "У моего начальника очень <w>переменчивое</w> настроение, никогда не знаешь, чего ожидать.",
                                "en": "My boss has very <w>changeable</w> moods; you never know what to expect.",
                                "nl": "Mijn baas heeft een erg <w>wisselvallig</w> humeur; je weet nooit wat je kunt verwachten.",
                                "de": "Mein Chef hat sehr <w>wechselhafte</w> Launen, man weiß nie, was einen erwartet.",
                                "fr": "Mon patron a une humeur très <w>changeante</w>, on ne sait jamais à quoi s'attendre.",
                                "it": "Il mio capo ha un umore molto <w>mutevole</w>, non si sa mai cosa aspettarsi.",
                                "cs": "Můj šéf má velmi <w>proměnlivou</w> náladu, nikdy se neví, co čekat.",
                                "tr": "Patronum çok <w>değişken</w> bir ruh haline sahip, ne bekleyeceğinizi asla bilemezsiniz.",
                                "es": "Mi jefe tiene un humor muy <w>variable</w>, nunca se sabe qué esperar.",
                                "zh": "我老板的情绪非常<w>阴晴不定</w>，你永远不知道接下来会发生什么。"
                            }
                        },
                        {
                            "text": "On jest zbyt <w>zmienny</w> w uczuciach, by stworzyć trwały i bezpieczny związek.",
                            "target_lang_translations": {
                                "ru": "Он слишком <w>непостоянен</w> в чувствах, чтобы создать прочные и надежные отношения.",
                                "en": "He is too <w>fickle</w> in his feelings to build a lasting and secure relationship.",
                                "nl": "Hij is te <w>wispelturig</w> in zijn gevoelens om een stabiele en veilige relatie op te bouwen.",
                                "de": "Er ist zu <w>unbeständig</w> in seinen Gefühlen, um eine dauerhafte und sichere Beziehung aufzubauen.",
                                "fr": "Il est trop <w>inconstant</w> dans ses sentiments pour construire une relation durable et sereine.",
                                "it": "Lui è troppo <w>volubile</w> nei sentimenti per costruire una relazione duratura e sicura.",
                                "cs": "Je v citech příliš <w>nestálý</w> na to, aby vytvořil trvalý a bezpečný vztah.",
                                "tr": "Kalıcı ve güvenli bir ilişki kuramayacak kadar duygularında <w>sebatsız</w>.",
                                "es": "Él es demasiado <w>inconstante</w> en sus sentimientos para formar una relación estable y segura.",
                                "zh": "他在感情上太<w>善变</w>了，无法建立一段持久而稳定的关系。"
                            }
