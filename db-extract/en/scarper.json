                ],
                "senses": [
                    {
                        "sense_id": "ba1a9eb4-3d21-31ce-8c90-8a91e983dbe0",
                        "entry_id": "a269de28-1e05-3170-a8f8-d43c4d3f7a89",
                        "glosses": [
                            "Chiefly in do a scarper: an act of departing quickly or running away; an escape, a flight."
                        ],
                        "tags": [
                            "UK",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "a1fa68ba-754c-428e-9ffa-a8dc7ccd1de5",
                                "sense_id": "ba1a9eb4-3d21-31ce-8c90-8a91e983dbe0",
                                "text": "As a matter of fact we were all pritty flabergasted, for although we had all planned to do a scarper none of us realy thought we would have the guts to do it."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
