                        ],
                        "examples": [
                            {
                                "example_id": "531066c7-fa07-4cc4-a847-acb9232d47bd",
                                "sense_id": "37a10b8d-9d7f-3bc8-a51d-a3342dd03264",
                                "text": "Ze kwamen hiernaartoe via Parijs of Toulouse, Madrid of Barcelona, beladen met dozen verf en boeken - en typemachines om hun eigen boeken op te schrijven - en koffers met hun initialen erop, koffers die soms op de grond vielen omdat ze zo onhandig waren met de dorpsezels."
                            },
                            {
                                "example_id": "0fa680bd-7d40-4b40-be2a-8a92df7899b2",
                                "sense_id": "37a10b8d-9d7f-3bc8-a51d-a3342dd03264",
                                "text": "Het Prado in Madrid was een geduchte mededinger, en ik neem aan dat Reede zich in de handen heeft gewreven toen zij het niet in bezit kregen."
                            }
                        ]
                    }
                ],
