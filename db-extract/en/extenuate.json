                                        "examples": [
                                            {
                                                "example_id": "628be908-9a67-4f45-aee0-07bc2c2fab3a",
                                                "sense_id": "5e29ce83-56cf-30ba-b56a-d00189955e68",
                                                "text": "Er is geconstateerd dat het laagje slijm tussen de 2 gewrichten van de hoef en been verdund is."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0c1f730e-f9b5-34b0-9610-e3e4c84b87b5",
                                        "entry_id": "de331a11-c904-3469-99ff-d719cbce2ba9",
                                        "glosses": [
                                            "door toevoeging van oplosmiddel de concentratie verlagen"
                                        ],
