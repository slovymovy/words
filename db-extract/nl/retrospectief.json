                    {
                        "translation_id": "fa3e07cc-7bc8-4e05-9c57-8086f66ab21f",
                        "source_entry_id": "110ee548-93d2-3bea-a98c-4cc1fc6eb297",
                        "source_sense_id": "1978eb0c-19c3-3d7d-97bb-9b7726222aeb",
