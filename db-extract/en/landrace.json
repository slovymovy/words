                "senses": [
                    {
                        "sense_id": "f8f5be98-b44f-3f7a-b26d-3e9201853abd",
                        "entry_id": "988813bb-6085-3e3c-a1b4-eeac3af611e3",
                        "glosses": [
                            "Any local variety of a domesticated animal or plant species that has adapted over time to its ecological and cultural environment (including, in some cases, its work)."
                        ],
                        "tags": [
                            "attributive",
                            "often"
                        ],
                        "examples": [
                            {
                                "example_id": "152c6513-f73a-4e5e-8859-435a05734cfe",
                                "sense_id": "f8f5be98-b44f-3f7a-b26d-3e9201853abd",
                                "text": "1961, Breeds of Swine, Farmers' Bulletin No. 1263, US Department of Agriculture, page 7,\nOne of the newer breeds of swine in the United States is the American Landrace. American Landrace hogs (figs. 19 and 20) are descendants of Danish Landrace hogs imported by the United States Department of Agriculture in 1934."
                            },
                            {
                                "example_id": "d40c26c1-1e83-4ee5-884f-3d79dc8c3ef3",
                                "sense_id": "f8f5be98-b44f-3f7a-b26d-3e9201853abd",
                                "text": "2009, Pablo Eyzaguirre, Arwen Bailey, International case studies and tropical home gardens projects: offering lessons for a new research agenda in Europe, A. Bailey, Pablo B. Eyzaguirre, L. Maggioni, Crop genetic resources in European home gardens: Proceedings of a Workshop, page 1,\nFirst, many crop landraces in Europe are being lost without our even knowing what is being lost."
                            },
                            {
                                "example_id": "956815a9-86b3-4cb8-bae9-9cc92b491d5f",
                                "sense_id": "f8f5be98-b44f-3f7a-b26d-3e9201853abd",
                                "text": "In both cases the morphological diversity within the oat accessions did not differ between landraces and modern cultivars."
                            }
                        ]
                    }
                ],
