                                                "sense_id": "89fdd9ef-1a1e-37f3-a75e-8a4ab1fc8fee",
                                                "text": "In der Diskothek der Schule konnte man früher Schallplatten ausleihen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c2ce19a4-9acf-3549-b4da-389c5086f508",
                                        "entry_id": "9f8d775b-3fb9-33a8-b71c-b868181836e8",
                                        "glosses": [
                                            "Räumlichkeit, in der zu Musik getanzt werden kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1104af7-0588-4f57-aea5-b19b6f19a926",
                                                "sense_id": "c2ce19a4-9acf-3549-b4da-389c5086f508",
                                                "text": "„Bei einer Explosion in einer Diskothek der österreichischen Stadt Linz sind am frühen Samstagmorgen 27 Jugendliche verletzt worden.“"
                                            },
                                            {
                                                "example_id": "5c11b85a-de00-403b-945c-3af127bffff4",
                                                "sense_id": "c2ce19a4-9acf-3549-b4da-389c5086f508",
                                                "text": "„In unserer Diskothek sind die Menschen nicht streitsüchtig, das heißt, grundsätzlich ist natürlich nichts ausgeschlossen, aber man muss sich schon sehr anstrengen, um dort verprügelt zu werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
