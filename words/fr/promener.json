                    "frequency": "Low",
                    "semantic_group_id": "tromperie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce client ne paie jamais et nous <w>promène</w> depuis plusieurs mois déjà."
                        },
                        {
                            "text": "J'ai bien compris qu'il cherchait seulement à me <w>promener</w> avec de fausses excuses."
