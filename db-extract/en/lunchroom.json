                        "translation_id": "4d0b176f-fac8-4f67-a63e-93f836fc89ef",
                        "source_entry_id": "a54badaf-8e76-3c37-a9ca-9e9e397e29e1",
                        "source_sense_id": "926f3601-d750-31d6-afc5-1f9e7b9599a3",
