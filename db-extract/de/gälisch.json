                                "target_senses": [
                                    {
                                        "sense_id": "c73bcc87-f356-32bf-9884-85035a51b9d3",
                                        "entry_id": "c4e583f8-9229-3c56-b136-8a8632a25292",
                                        "glosses": [
                                            "Connected with Ireland or the Highlands of Scotland, or to the Gaelic languages spoken in those places."
                                        ],
                                        "tags": [
                                            "dated",
                                            "not-comparable",
