                    {
                        "translation_id": "08c1c4e3-5f9b-44bb-bee6-89f78aaf9a06",
                        "source_entry_id": "49e88400-13de-33b3-87a9-50ac68d6220c",
                        "source_sense_description": "многолетнее травянистое растение семейства Кипрейные, Chamaenerion",
                        "target_lang_word": "épilobe",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "épilobe",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5eceae2c-80d1-3a46-9ee6-c86d1ab1e8bc",
                                        "entry_id": "029d041b-9d6c-3f82-a0b5-e649d1f36683",
                                        "glosses": [
                                            "Genre de plantes herbacées aux fleurs à quatre pétales, de la famille des onagracées ou des œnothéracées. → voir Epilobium"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "062d9f78-4aef-442f-9392-2528e3163f2d",
                                                "sense_id": "5eceae2c-80d1-3a46-9ee6-c86d1ab1e8bc",
                                                "text": "Les papillons de nuit (hétérocères) suivants (classés par famille) se nourrissent d’épilobes :\n- écaille chinée, callimorphe, écaille rouge, Euplagia quadripunctaria (Arctiidae),\n- grand sphinx de la vigne, grand pourceau, Deilephila elpenor,\n- petit sphinx de la vigne, petit pourceau, Deilephila porcellus,\n- sphinx de l’épilobe, sphinx de l’œnothère, Proserpinus proserpina,\n- sphinx phoenix, sphinx du taro, Hippotion celerio,\n- sphinx vespertilio, sphinx chauve-souris, Hyles vespertilio (Sphingidae)."
                                            },
                                            {
                                                "example_id": "8a30ebb0-4ad0-4455-935f-d7fda2ff41ed",
                                                "sense_id": "5eceae2c-80d1-3a46-9ee6-c86d1ab1e8bc",
                                                "text": "À toi : un bouillon d’orignal ;\ndu caribou et ses effluves de lichen ; des bolets\ngrands comme nos visages ;\ndes herbes pour les tisanes, de l’épilobe baignée\ndans l’eau de la source ;\ndes choses simples, des choses vivantes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b440dc2a-3f2b-3f47-9194-01297268fea1",
                                        "entry_id": "029d041b-9d6c-3f82-a0b5-e649d1f36683",
                                        "glosses": [
                                            "Épilobe en épi."
                                        ],
                                        "tags": [
                                            "ellipsis",
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e2f31a9d-229f-4180-808d-dd9dba24e452",
                                                "sense_id": "b440dc2a-3f2b-3f47-9194-01297268fea1",
                                                "text": "Il y avait là de hauts épilobes dans une clairière de quelques mètres carrés."
                                            },
                                            {
                                                "example_id": "2317c717-9c4e-4cf6-81b8-cc690884d1cf",
                                                "sense_id": "b440dc2a-3f2b-3f47-9194-01297268fea1",
                                                "text": "Une autre histoire, moins dénuée de sens, m’attendait au sommet de la colline où un carré envahi par les épilobes, les asclépiades et les vernonies […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
