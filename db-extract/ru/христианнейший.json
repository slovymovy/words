                    {
                        "translation_id": "bcb8da30-c58d-49d9-84ec-0856a576d999",
                        "source_entry_id": "63c5c99f-c8ca-36f9-9544-c8741abc0a7c",
                        "source_sense_description": "воплощающий в себе всё христианское",
                        "target_lang_word": "très chrétien",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "très chrétien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "50cb7af3-66b3-31c0-8c7f-9759da323734",
                                        "entry_id": "2463d576-1929-3fb3-99a0-3102dba8da18",
                                        "glosses": [
                                            "Variante orthographique de très-chrétien."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "74e64947-fb39-4d46-b747-96f1577a4f8f",
                                                "sense_id": "50cb7af3-66b3-31c0-8c7f-9759da323734",
                                                "text": "À Aix-la-Chapelle, autre don, mais de la part de la France : le drap mortuaire qui servait à l’enterrement d’un monarque très chrétien était envoyé au tombeau de Charlemagne, comme un drapeau-lige au fief dominant."
                                            },
                                            {
                                                "example_id": "c063e25f-c9d5-48c5-9716-25985c4b1342",
                                                "sense_id": "50cb7af3-66b3-31c0-8c7f-9759da323734",
                                                "text": "Dans quelques heures, à Froshdorf, la dernière épopée finira, on clouera dans un cercueil le drapeau blanc, la tradition de mille ans, le trône très chrétien, le trône de saint Louis et de Louis le Grand."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
