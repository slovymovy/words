                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ressources",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette nouvelle stratégie commerciale permettra de <w>dégager</w> des bénéfices importants dès cette année."
                        },
                        {
                            "text": "Il essaie de <w>dégager</w> du temps libre pour pouvoir s'occuper de ses enfants."
                        }
                    ],
                    "common_phrases": [
                        "dégager des bénéfices",
                        "dégager du temps",
                        "dégager des fonds"
                    ]
                },
                {
                    "sense_id": "d1a454fe-61ad-3c72-a13a-52b68784fe5d",
                    "sense_definition": "Affranchir quelqu'un ou soi-même d'un devoir, d'un engagement moral ou d'une responsabilité juridique.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "obligation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette clause contractuelle permet à l'entreprise de se <w>dégager</w> de toute responsabilité en cas de panne."
                        },
                        {
                            "text": "Le directeur a accepté de le <w>dégager</w> de sa promesse sans exiger d'indemnités."
