                    ],
                    "common_phrases": [
                        "minorité opposante"
                    ]
                },
                {
                    "sense_id": "f664f253-b584-3e34-b104-85f89877a3df",
                    "sense_definition": "Qui forme une opposition en justice contre l'exécution d'une décision ou d'un acte juridique.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "droit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La partie <w>opposante</w> a immédiatement contesté la validité de la saisie immobilière."
                        },
                        {
                            "text": "L'avocat a déposé une requête pour son client devenu <w>opposant</w> à la vente."
                        }
                    ],
                    "common_phrases": [
                        "partie opposante",
                        "créancier opposant"
                    ]
                }
            ]
        },
