                "senses": [
                    {
                        "sense_id": "654f6414-7943-3afd-a7cf-afb8205a0810",
                        "entry_id": "fb8606e6-c67d-3d31-b2e0-bda7f4e56458",
                        "glosses": [
                            "Turbine, die mit der Energie des Dampfes angetrieben wird und diese in mechanische Arbeit (Drehbewegung des Rotor) umwandelt"
                        ],
                        "tags": [
                            "Kraftmaschine"
                        ],
                        "examples": [
                            {
                                "example_id": "1d0053fa-45c9-41d1-bf31-443cd8ce2b2b",
                                "sense_id": "654f6414-7943-3afd-a7cf-afb8205a0810",
                                "text": "Im Wärmekraftwerken werden Dampfturbinen verwendet."
                            },
                            {
                                "example_id": "f7b43b13-83d1-40d7-883a-680b3cc8bffc",
                                "sense_id": "654f6414-7943-3afd-a7cf-afb8205a0810",
                                "text": "„Das Herzstück eines solarthermischen Kraftwerks, das primär über den Wirkungsgrad entscheidet, ist die Dampfturbine.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
