                        "examples": [
                            {
                                "example_id": "861b5948-d91a-48f9-aea8-42bb6fe2b214",
                                "sense_id": "8df83728-8e72-36c3-a3b8-b0dcc99a5270",
                                "text": "„Einst hatten Frauen Macht: Das Leben drehte sich in den Höhlen noch ums Mysterium der Kindgeburt, wir dienten Muttergöttinnen, nicht väterlichen Göttern.“"
                            },
                            {
                                "example_id": "03e77bca-95a8-42c9-805b-bf55600cabd2",
                                "sense_id": "8df83728-8e72-36c3-a3b8-b0dcc99a5270",
                                "text": "„Ich musste nicht; ich war die Muttergöttin, meine Macht absolut.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
