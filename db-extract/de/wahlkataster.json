                ],
                "senses": [
                    {
                        "sense_id": "3290ee6a-cff8-37e8-abe0-eacd5b81d59a",
                        "entry_id": "a733ded9-5870-3d42-a875-a1a4dd962697",
                        "glosses": [
                            "Verzeichnis der Wahlberechtigten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3275fd6a-5116-4a7d-a47b-0355d15b9ff9",
                                "sense_id": "3290ee6a-cff8-37e8-abe0-eacd5b81d59a",
                                "text": "„Er sei Mitglied der deutschen Feuerwehr und werde für die nächsten Wahlen seine Einschreibung in den deutschen Wahlkataster veranlassen.“"
                            },
                            {
                                "example_id": "a13dbe7b-6f57-4c4e-b48d-52933f4378bf",
                                "sense_id": "3290ee6a-cff8-37e8-abe0-eacd5b81d59a",
                                "text": "„Für die Landtagswahlen sei er in den deutschen Wahlkataster eingetragen, für die Reichsratswahlen in den tschechischen.“"
                            },
                            {
                                "example_id": "efce420b-83e3-43fa-8420-216c976821c8",
                                "sense_id": "3290ee6a-cff8-37e8-abe0-eacd5b81d59a",
                                "text": "„Indessen beruht dieser Wahlkataster nicht auf der freien Nationalitätserklärung.“"
                            },
                            {
                                "example_id": "bf89a458-f284-4ba3-8455-77ee305e78ed",
                                "sense_id": "3290ee6a-cff8-37e8-abe0-eacd5b81d59a",
                                "text": "„Der Bürgerkataster wurde vom Konskriptionsamt erstellt und dann dem Steuer- und Wahlkataster zur weiteren Evidenzhaltung übergeben.“"
                            },
                            {
                                "example_id": "6926bf8f-0267-4a48-9ea8-0f576025acb4",
                                "sense_id": "3290ee6a-cff8-37e8-abe0-eacd5b81d59a",
                                "text": "„Im Hinblick auf die Wahl der beiden nationalen Kurien (der deutschen und der tschechischen), die beide im Reichstag von Brünn vertreten sein sollten, wurde ein nationaler Wahlkataster gegründet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
