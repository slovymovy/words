                        "source_entry_id": "91c67a2c-05bc-384b-a614-310e998f55b0",
                        "source_sense_id": "6bd14cf8-69a2-3ee5-8126-333b724ca99d",
                        "source_sense_description": "eine Datensammlung in alphabetischer oder systematischer Ordnung",
                        "target_lang_word": "ouvrage de référence",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ouvrage de référence",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "72288c25-ed43-3641-8c72-89fafa3b5192",
                                        "entry_id": "3c59008c-764c-3008-baf1-66c689a4f293",
                                        "glosses": [
                                            "Recueil d’informations classées qui n’est pas destiné à être lu de la première à la dernière page, mais consulté par rubriques, articles ou entrées."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ca1fce2-5468-4d6c-9330-9b945d74f062",
                                                "sense_id": "72288c25-ed43-3641-8c72-89fafa3b5192",
                                                "text": "Les instruments de la recherche bibliographique et documentaire sont des ouvrages de référence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f0a333fa-3e98-357e-97a9-28369c2d5664",
                                        "entry_id": "3c59008c-764c-3008-baf1-66c689a4f293",
                                        "glosses": [
                                            "Ouvrage qui sert de référentiel dans un domaine de la connaissance, qui est populaire sans être une somme de connaissances."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0f05df26-d6ee-4566-b04b-b7c79d7441a1",
                                                "sense_id": "f0a333fa-3e98-357e-97a9-28369c2d5664",
                                                "text": "Créé en 1843, L’Illustration est devenu dès 1906 l’ouvrage de référence sur Paris. Durant plus d’un siècle, le journal dépeint un Paris en pleine reconstruction, raconte la vie des Parisiens et relate les grands événements qui se déroulent dans la capitale et qui ont marqué l’histoire de France."
                                            },
                                            {
                                                "example_id": "830ea0f5-7e0b-4c66-8eb2-835b0a8b85b6",
                                                "sense_id": "f0a333fa-3e98-357e-97a9-28369c2d5664",
                                                "text": "Et pour le Professeur Souleymane Bachir Diagne, préfacier de ce livre, « cette étude pionnière et magistrale va de toute évidence constituer un ouvrage de référence »."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
