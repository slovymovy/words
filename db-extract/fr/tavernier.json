                        "examples": [
                            {
                                "example_id": "67e94c71-65cc-499f-93af-dbcba37f88d5",
                                "sense_id": "e25ec446-02b1-3a2a-b4e2-23cfb65bcdfc",
                                "text": "Le soir le tavernier mettait dans sa poche la clef de la taverne, et s’en allait."
