{
    "word_family": [
        "przepraszać",
        "przeprosiny"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d86775e8-af85-3f97-979b-4aef2efa32be",
                    "sense_definition": "Wyrazić żal z powodu wyrządzonej komuś przykrości, popełnionego błędu lub nietaktu i poprosić o wybaczenie.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Chciałbym cię serdecznie <przeprosić> za moje wczorajsze zachowanie.",
                            "target_lang_translations": {
                                "ru": "Я хотел бы искренне <w>извиниться</w> перед тобой за мое вчерашнее поведение.",
                                "en": "I would like to sincerely <w>apologize</w> for my behavior yesterday."
                            }
                        },
                        {
                            "text": "Uczeń <przeprosił> nauczycielkę za spóźnienie na lekcję.",
                            "target_lang_translations": {
                                "ru": "Ученик <w>извинился</w> перед учительницей за опоздание на урок.",
                                "en": "The student <w>apologized</w> to the teacher for being late for class."
                            }
                        }
                    ],
                    "synonyms": [
                        "wyrazić skruchę"
                    ],
                    "antonyms": [
                        "obrazić"
                    ],
                    "common_phrases": [
                        "przeprosić za spóźnienie",
                        "przeprosić za kłopot",
                        "chcieć przeprosić",
                        "oficjalnie przeprosić"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выразить сожаление по поводу причиненной неприятности, ошибки или бестактности и попросить прощения.",
                        "en": "To express regret for causing someone distress, making a mistake, or a social blunder, and to ask for forgiveness."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "извиниться",
                                "target_lang_sense_clarification": "попросить прощения за поступок"
                            },
                            {
                                "target_lang_word": "попросить прощения",
                                "target_lang_sense_clarification": "выразить сожаление"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "apologize",
                                "target_lang_sense_clarification": "to express regret for a mistake or offense"
                            },
                            {
                                "target_lang_word": "say sorry",
                                "target_lang_sense_clarification": "to express regret in a more informal or direct way"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6dff8851-b851-3f4b-b79a-fbf3ce0d9b62",
                    "sense_definition": "Pogodzić się z kimś po kłótni, wybaczając sobie wzajemnie urazy.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Po długiej kłótni sąsiedzi w końcu się <przeprosili>.",
                            "target_lang_translations": {
                                "ru": "После долгой ссоры соседи наконец <w>помирились</w>.",
                                "en": "After a long argument, the neighbors finally <w>made up</w>."
                            }
                        },
                        {
                            "text": "Musisz się z nią <przeprosić>, jeśli chcesz, żeby w domu panował spokój.",
                            "target_lang_translations": {
                                "ru": "Ты должен с ней <w>помириться</w>, если хочешь, чтобы в доме царил покой.",
                                "en": "You need to <w>make up</w> with her if you want peace in the house."
                            }
                        }
                    ],
                    "synonyms": [
                        "pogodzić się"
                    ],
                    "antonyms": [
                        "pokłócić się"
                    ],
                    "common_phrases": [
                        "przeprosić się z kimś",
                        "przeprosić się nawzajem"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "używane z zaimkiem \"się\""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Помириться с кем-то после ссоры, простив друг другу обиды.",
                        "en": "To reconcile with someone after an argument, forgiving each other's grievances."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "помириться",
                                "target_lang_sense_clarification": "восстановить отношения после ссоры"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "make up",
                                "target_lang_sense_clarification": "to reconcile after a disagreement"
                            },
                            {
                                "target_lang_word": "reconcile",
                                "target_lang_sense_clarification": "to restore friendly relations"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0c8e6cd5-033a-3479-9776-ae46f73e76c4",
                    "sense_definition": "Zacząć ponownie używać czegoś lub robić coś, czego się wcześniej zaniechało lub unikało.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kiedy samochód się zepsuł, musiałem się <przeprosić> z rowerem.",
                            "target_lang_translations": {
                                "ru": "Когда машина сломалась, мне пришлось <w>вернуться</w> к велосипеду.",
                                "en": "When the car broke down, I had to <w>go back to</w> using my bike."
                            }
                        },
                        {
                            "text": "Zimą wielu kierowców musi się <przeprosić> ze skrobaczką do szyb.",
                            "target_lang_translations": {
                                "ru": "Зимой многим водителям приходится <w>вернуться</w> к скребку для стекол.",
                                "en": "In winter, many drivers have to <w>return to</w> using an ice scraper."
                            }
                        }
                    ],
                    "common_phrases": [
                        "przeprosić się z czymś"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "używane z zaimkiem \"się\""
                        },
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Снова начать использовать что-то или делать что-то, от чего ранее отказались или чего избегали.",
                        "en": "To start using something again or doing something that was previously abandoned or avoided."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вернуться к",
                                "target_lang_sense_clarification": "возобновить использование чего-либо"
                            },
                            {
                                "target_lang_word": "снова начать пользоваться",
                                "target_lang_sense_clarification": "начать использовать заново"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "go back to",
                                "target_lang_sense_clarification": "to return to using or doing something"
                            },
                            {
                                "target_lang_word": "return to",
                                "target_lang_sense_clarification": "to resume the use of something"
                            }
                        ]
                    }
                }
            ]
        }
    ]
