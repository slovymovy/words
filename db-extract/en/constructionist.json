                        "glosses": [
                            "Of, pertaining to, or advocating constructionism."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "24b4d6ad-6bd5-4375-ba33-700eb54fbca1",
                                "sense_id": "00ca9e7d-178f-354f-ae57-9f97bbff2399",
                                "text": "According to the constructionist approach that dominates queer scholarship, homosexuality and heterosexuality are not essential aspects of the self (biological or otherwise), but culturally and historically specific classifications used to explain and regulate sexuality and to produce docile sexual subjects."
                            }
                        ]
                    }
