                        "translation_id": "c1393991-74b1-4a90-9d7b-e5307e1bb808",
                        "source_entry_id": "db4f77e5-cfdd-3800-8652-250c5eec5c58",
                        "source_sense_id": "b1d2116e-7fc3-3c77-97c2-c33a0f79d286",
