                    },
                    {
                        "form_id": "854401ae-5892-4b31-94a1-1da216264a97",
                        "entry_id": "c8ff9bc1-9ee2-38ad-ba09-b487ccdc0363",
                        "tags": [
                            "plural",
                            "prepositional"
                        ],
                        "form": "кругозо́рах"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d1711dfb-3011-31e7-8e75-afe586660d3c",
                        "entry_id": "c8ff9bc1-9ee2-38ad-ba09-b487ccdc0363",
                        "glosses": [
                            "пространство, которое можно окинуть взором"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e76477a-34f8-4990-8cfd-df05d172d8cc",
                                "sense_id": "d1711dfb-3011-31e7-8e75-afe586660d3c",
                                "text": "А взобраться на вершину да глянуть окрест себя ― Господи! что за кругозор откроется пред тобой! что за даль раскинется там вёрст на девяносто в окружности!"
                            },
                            {
                                "example_id": "e682b921-347e-4410-b47e-72ace2788e14",
                                "sense_id": "d1711dfb-3011-31e7-8e75-afe586660d3c",
                                "text": "При одном этом имени как-то вдруг просветляется взгляд у нашего поэта, раздвигается дальше его кругозор, все становится у него шире, и он сам как бы облекается величием, становясь превыше обыкновенного человека."
                            }
                        ]
                    },
                    {
                        "sense_id": "586794b7-4f89-33d3-892b-3a19e2bfebe7",
                        "entry_id": "c8ff9bc1-9ee2-38ad-ba09-b487ccdc0363",
                        "glosses": [
                            "перен. объём познаний, интересов, представлений кого-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d362968-8538-48d5-8226-abd797d268ae",
                                "sense_id": "586794b7-4f89-33d3-892b-3a19e2bfebe7",
                                "text": "Другая вредная подмесь нашей жизни ― это неисправимая ограниченность кругозоров."
                            },
                            {
                                "example_id": "5760838e-a3c0-4d11-9c3a-ae4b6fd5d097",
                                "sense_id": "586794b7-4f89-33d3-892b-3a19e2bfebe7",
                                "text": "Не должно ли было это просто значить, что человек, имевший от природы добрую совесть, немножко пораздвинул свой умственный кругозор и, не изменяя вере отцов своих, попытался иметь своё мнение о духе закона, сокрываемом буквою, ― стал больше заботиться об очищении своего сердца, чем об умывании рук и полоскании скляниц, ― и вот дело готово: он «опасный вольнодумец», которого фарисейский талмудизм стремится разорить, уничтожить и стереть с лица земли."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "eaa1596b-05c4-4014-8400-0b8717b6d5be",
                        "source_entry_id": "c8ff9bc1-9ee2-38ad-ba09-b487ccdc0363",
                        "source_sense_description": "пространство, которое можно окинуть взором",
                        "target_lang_word": "horizon",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "horizon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dab68cb6-6c83-3268-a342-898f99c5199b",
                                        "entry_id": "fd63e1ce-c7df-3230-9d9c-a02fb23aed50",
                                        "glosses": [
                                            "The visible horizontal line (in all directions) where the sky appears to meet the earth in the distance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4dcc85a1-ae28-42ed-abbf-45d54a92e8d4",
                                                "sense_id": "dab68cb6-6c83-3268-a342-898f99c5199b",
                                                "text": "A tall building was visible on the whole sweep of the horizon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0124603f-5fa3-39b0-9690-31441d21aa70",
                                        "entry_id": "fd63e1ce-c7df-3230-9d9c-a02fb23aed50",
                                        "glosses": [
                                            "The range or limit of one's knowledge, experience or interest; a boundary or threshold."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e11f22e3-120c-4efc-bf26-87f55bf33ac6",
                                                "sense_id": "0124603f-5fa3-39b0-9690-31441d21aa70",
                                                "text": "Some students take a gap year after finishing high school to broaden their horizons."
                                            },
                                            {
                                                "example_id": "4e637c15-024b-485c-b992-7bbf2f1c9d8c",
                                                "sense_id": "0124603f-5fa3-39b0-9690-31441d21aa70",
                                                "text": "With clinical researchers hard at work, a new treatment is on the horizon."
                                            },
                                            {
                                                "example_id": "abfaba7f-4584-4d2c-a39a-4ad363b66cf0",
                                                "sense_id": "0124603f-5fa3-39b0-9690-31441d21aa70",
                                                "text": "It is because theirs has become the only explicit general philosophy of social policy held by a large group, the only system or theory which raises new problems and opens new horizons, that they have succeeded in inspiring the imagination of the intellectual."
                                            },
                                            {
                                                "example_id": "9cd34097-8faf-4a10-805f-b218d2c95338",
                                                "sense_id": "0124603f-5fa3-39b0-9690-31441d21aa70",
                                                "text": "The Indians of the Americas totaled no less than 70 million when the foreign conquerors appeared on the horizon; a century and a half later they had been reduced to 3.5 million."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c2d661b4-bff7-3a99-b413-511c3d8549ee",
                                        "entry_id": "fd63e1ce-c7df-3230-9d9c-a02fb23aed50",
                                        "glosses": [
                                            "The range or limit of any dimension in which one exists."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92082519-4936-4abc-b2c5-7c047336fe8c",
                                                "sense_id": "c2d661b4-bff7-3a99-b413-511c3d8549ee",
                                                "text": "Only mortality, this irreducible and primordial horizon, that very horizon which, in Being and Time, Heidegger so compellingly revealed as the unsurpassable and defining possibility, remains."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8aa78fd1-d0f5-34b9-97d7-391ee1422b18",
                                        "entry_id": "fd63e1ce-c7df-3230-9d9c-a02fb23aed50",
                                        "glosses": [
                                            "A specific layer of soil, or stratum"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d9860d0f-f9d8-3133-b43e-50d7acd34166",
                                        "entry_id": "fd63e1ce-c7df-3230-9d9c-a02fb23aed50",
                                        "glosses": [
                                            "A cultural sub-period or level within a more encompassing time period."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2cc4e1de-a563-37b8-82cc-85dabb3506b9",
                                        "entry_id": "fd63e1ce-c7df-3230-9d9c-a02fb23aed50",
                                        "glosses": [
                                            "Any level line or surface."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ffab316f-5542-37bc-b413-b5aaa375e241",
                                        "entry_id": "fd63e1ce-c7df-3230-9d9c-a02fb23aed50",
                                        "glosses": [
                                            "The point at which a computer chess algorithm stops searching for further moves."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
