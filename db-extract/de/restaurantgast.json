                        "examples": [
                            {
                                "example_id": "ce857045-9c03-4ef8-bd2c-5b1b2fed670b",
                                "sense_id": "82acca8a-983a-3ac9-8b38-0ef2a5274f15",
                                "text": "„An den anderen Tischen in seiner Umgebung beobachteten einige Restaurantgäste stumm vor Staunen diese Prozession.“"
                            },
                            {
                                "example_id": "3026c3cf-e8d9-4e36-b58b-c4099fa13730",
                                "sense_id": "82acca8a-983a-3ac9-8b38-0ef2a5274f15",
                                "text": "„Er streckte schon die Hand aus, um die Aufnahme abzuschalten, doch da begannen die beiden Security-Leute an der Bar eine Unterhaltung, während sie ihre Blicke über die Lobby und die Restaurantgäste schweifen ließen.“"
                            }
                        ],
