                        "target_lang_word": "divisibilité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "divisibilité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9540c6c1-26ae-35f0-b952-2fd748546d66",
                                        "entry_id": "9b791467-830c-3003-9f03-9447f48850a6",
                                        "glosses": [
                                            "Qualité de ce qui peut être divisé."
                                        ],
                                        "tags": [
                                            "Didactique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d7b0938c-aa14-4f8d-aab8-03eb16ba8b4f",
                                                "sense_id": "9540c6c1-26ae-35f0-b952-2fd748546d66",
                                                "text": "Les cas de divisibilité des nombres."
                                            },
                                            {
                                                "example_id": "4d78d19e-8dc1-4ad4-ab1a-f9a6a4bca3a0",
                                                "sense_id": "9540c6c1-26ae-35f0-b952-2fd748546d66",
                                                "text": "La divisibilité d’un nombre par 3, par 5."
                                            },
                                            {
                                                "example_id": "cf7d8462-10fb-413b-920e-2b0071a7a244",
                                                "sense_id": "9540c6c1-26ae-35f0-b952-2fd748546d66",
                                                "text": "La divisibilité de la matière."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "77f8bb87-a47a-3879-99b1-96c44c7572eb",
                                        "entry_id": "9b791467-830c-3003-9f03-9447f48850a6",
                                        "glosses": [
                                            "Relation d’ordre partiel de l’ensemble ℕ des entiers naturels ou de l’ensemble ℤ des entiers relatifs, vérifiée quand le second entier d’une paire est multiple du premier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a7e46204-8e9a-4b4c-9c5e-6f7430837eb0",
                                                "sense_id": "77f8bb87-a47a-3879-99b1-96c44c7572eb",
                                                "text": "Le caractère",
                                                "translation": "est le symbole de la divisibilité. Exemple : “ 7"
                                            },
                                            {
                                                "example_id": "a160613f-d058-49aa-99f7-aff640e47b61",
                                                "sense_id": "77f8bb87-a47a-3879-99b1-96c44c7572eb",
                                                "text": "Une somme des chiffres divisible par neuf est un critère de divisibilité par neuf."
                                            },
                                            {
                                                "example_id": "ef53dbb5-8561-480f-b2d9-56314731027b",
                                                "sense_id": "77f8bb87-a47a-3879-99b1-96c44c7572eb",
                                                "text": "Pour la divisibilité, zéro est le plus grand élément de l’ensemble ℤ des entiers. Autrement dit, zéro est multiple de n’importe quel entier."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "90a25198-a77f-41be-8e89-35502197937f",
                        "source_entry_id": "992c3461-75aa-331c-8481-8070c817ada3",
                        "source_sense_description": "количество",
                        "target_lang_word": "multiplicité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "multiplicité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4850b483-9530-3758-844c-2bab40a93546",
                                        "entry_id": "5f6f18e2-afda-3e1a-bc09-ecb99144fbd4",
                                        "glosses": [
                                            "État de ce qui est multiple ; pluralité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8cd37bb2-6a06-4e7a-a031-4483101047f6",
                                                "sense_id": "4850b483-9530-3758-844c-2bab40a93546",
                                                "text": "La multiplicité des modes de prélèvements sanguins."
                                            },
                                            {
                                                "example_id": "0af3d668-9956-41bd-8e57-ba9c436a6be8",
                                                "sense_id": "4850b483-9530-3758-844c-2bab40a93546",
                                                "text": "Pour Don Juan, « la féminité tout à fait abstraite est l'essentiel », l’individualité n'existe pas : il n'y a jamais eu à ses yeux ni infidélité ni tromperie, mais seulement répétition et multiplicité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "68c068bd-fd4e-3f3a-b4b7-5914fce2a018",
                                        "entry_id": "5f6f18e2-afda-3e1a-bc09-ecb99144fbd4",
                                        "glosses": [
                                            "Nombre considérable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bcaac478-ca1a-4f07-acee-fae8dae2791a",
                                                "sense_id": "68c068bd-fd4e-3f3a-b4b7-5914fce2a018",
                                                "text": "La première loi de ambitu contre la corruption électorale, est de 181. Elle fut suivie de beaucoup d’autres dont la multiplicité démontre assez l’impuissance."
                                            },
                                            {
                                                "example_id": "594f10bd-56e5-4422-ad27-d126addb180f",
                                                "sense_id": "68c068bd-fd4e-3f3a-b4b7-5914fce2a018",
                                                "text": "Pour s’évader de la mentalité scolastique, il fallait répudier le réalisme des universaux qui suscitait quantité de pseudo-problèmes comme celui de […] l’unité ou de la multiplicité numérique de chaque espèce angélique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8a0c9007-ee82-4b17-945b-324e2a983d9c",
                        "source_entry_id": "992c3461-75aa-331c-8481-8070c817ada3",
                        "source_sense_description": "количество",
                        "target_lang_word": "fréquence",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fréquence",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3ee584f6-2429-33ef-be9e-77e378fbcd9b",
                                        "entry_id": "c19e8606-26df-361f-ad04-5abd540602d0",
                                        "glosses": [
                                            "Répétition incessante et régulière d’une action ou d’un fait."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "206e2c56-461a-475d-867e-10585b36b3c0",
                                                "sense_id": "3ee584f6-2429-33ef-be9e-77e378fbcd9b",
                                                "text": "Alors que les risques auxquels les militaires sont exposés imposent une fréquence d’examen annuelle, certaines cellules avaient institué une fréquence bisannuelle pour les examens, ce qui correspondait plutôt à ce qu'elles étaient capables d'assurer, […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9e00b2e5-d2f0-3501-ac8b-3b248ac65eee",
                                        "entry_id": "c19e8606-26df-361f-ad04-5abd540602d0",
                                        "glosses": [
                                            "Probabilité de la survenance d'un phénomène."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f4d26c18-b793-43c4-bdf8-53b690784a88",
                                                "sense_id": "9e00b2e5-d2f0-3501-ac8b-3b248ac65eee",
                                                "text": "Une population est optimalement adaptée si, dans un contexte environnemental donné et constant, la fréquence la plus avantageuse du génotype le plus avantageux est stable et que la population se perpétue."
                                            },
                                            {
                                                "example_id": "fd7c552e-fcfc-4a26-ace7-e130ca9f130c",
                                                "sense_id": "9e00b2e5-d2f0-3501-ac8b-3b248ac65eee",
                                                "text": "Des erreurs lors de la réplication de l’ADN (mutations) ou des transferts de gènes s'accumulent à fréquence faible mais constante au cours du temps, ce qui augmente progressivement le polymorphisme au sein de chaque écotype."
                                            },
                                            {
                                                "example_id": "74c542d7-4a50-431e-808f-a20ef5a902f5",
                                                "sense_id": "9e00b2e5-d2f0-3501-ac8b-3b248ac65eee",
                                                "text": "Les infections fungiques sont démontrées chez environ 5 % des patients présentant une neutropénie fébrile ; cette fréquence a tendance à augmenter dans de nombreux centres, au cours des dernières années."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d19c6ac8-2e83-3778-8861-4f97b4d52959",
                                        "entry_id": "c19e8606-26df-361f-ad04-5abd540602d0",
                                        "glosses": [
                                            "Succession rapide des battements, en parlant du pouls, du cœur ou des mouvements nécessaires à la respiration."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "920afd82-2d95-47b6-bdfa-69431c590560",
                                                "sense_id": "d19c6ac8-2e83-3778-8861-4f97b4d52959",
                                                "text": "Plus rarement, il existe des troubles cardiaques très marqués : petitesse et fréquence extrême du pouls, lipothymies et syncopes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a0c1bbfd-f7ad-321c-8145-da5a94f79e8c",
                                        "entry_id": "c19e8606-26df-361f-ad04-5abd540602d0",
                                        "glosses": [
                                            "Nombre de fois que la période est contenue dans une unité de temps, lors d'un mouvement périodique."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "note": "La fréquence est généralement mesurée en hertz",
                                        "examples": [
                                            {
                                                "example_id": "f6a43f37-5201-4796-876a-0c0915cc1e20",
                                                "sense_id": "a0c1bbfd-f7ad-321c-8145-da5a94f79e8c",
                                                "text": "Cette salle des machines est découpée en deux. Deux tiers de l'énergie sont distribués à une fréquence de 50 Hz pour alimenter des sites industriels en Bavière. Le tiers restant, qui affiche 16,7 Hz, est fourni à la Deutsche Bahn, pour faire rouler ses trains dans le land."
                                            },
                                            {
                                                "example_id": "42e10fbe-e945-4809-99b4-dc099b8e4065",
                                                "sense_id": "a0c1bbfd-f7ad-321c-8145-da5a94f79e8c",
                                                "text": "C'est le cas du son de la voix, on l'a noté, enregistrable par le sonagraphe, retraçable par un sonagramme où les fréquences sont portées en ordonnée et le temps en abscisse."
                                            },
                                            {
                                                "example_id": "6ee9e010-b212-42fa-b435-0aa0e6b1a3fd",
                                                "sense_id": "a0c1bbfd-f7ad-321c-8145-da5a94f79e8c",
                                                "text": "Cet animal s'oriente dans l’espace par écholocation : il émet des sons de très haute fréquence et utilise l’écho renvoyé par les obstacles ou les proies pour les localiser."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9a526c97-daf3-3f3a-8531-cffe11c5344d",
                                        "entry_id": "c19e8606-26df-361f-ad04-5abd540602d0",
                                        "glosses": [
                                            "Gamme d'ondes sur laquelle se font les télécommunications."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2e4371c1-37fe-46d8-8f27-8d06c36b8396",
                                                "sense_id": "9a526c97-daf3-3f3a-8531-cffe11c5344d",
                                                "text": "Ils sortirent le matériel, branchèrent la gégène que René enfourcha pour pédaler. Le courant passait. L'opérateur radio pouvait émettre le message que lui avait donné Gaëtan. La communication était mauvaise et le radio dut changer de fréquence."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
