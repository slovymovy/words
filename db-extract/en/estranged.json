                    {
                        "sense_id": "63ed9617-a3cb-3fba-b44a-4db053191d07",
                        "entry_id": "dcda8230-ff70-30f4-a2ad-5d4075356091",
                        "glosses": [
                            "Having become a stranger, of one who formerly was close, as a relative, friend, lover, or spouse."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3af1ed7a-6c4b-443c-875d-672f799fb0b7",
                        "source_entry_id": "dcda8230-ff70-30f4-a2ad-5d4075356091",
                        "source_sense_id": "63ed9617-a3cb-3fba-b44a-4db053191d07",
                        "source_sense_description": "having become a stranger",
                        "target_lang_word": "éloigné",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "éloigné",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "08e5f82b-23e3-30ef-9f1b-0feeb15865a7",
                                        "entry_id": "70a8e2e1-bdc1-360b-abc1-838f25a7aa71",
                                        "glosses": [
                                            "ou Qui est loin."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "literally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3ba483d1-56de-44de-be69-b64ffc09f12a",
                                                "sense_id": "08e5f82b-23e3-30ef-9f1b-0feeb15865a7",
                                                "text": "En outre, tous les cafés, tous les mastroquets étincelaient de lumière, ce qui est rare dans ce quartier éloigné de Paris, surtout à une heure si tardive."
                                            },
                                            {
                                                "example_id": "f95fa47e-1ae6-467c-a122-f08d9f9e055a",
                                                "sense_id": "08e5f82b-23e3-30ef-9f1b-0feeb15865a7",
                                                "text": "Temps éloigné."
                                            },
                                            {
                                                "example_id": "8542c2fc-bbb3-42a9-a774-6b9f59f47b94",
                                                "sense_id": "08e5f82b-23e3-30ef-9f1b-0feeb15865a7",
                                                "text": "Postérité éloignée."
                                            },
                                            {
                                                "example_id": "9d62a3e0-1cc5-4a63-8972-2912acf658e1",
                                                "sense_id": "08e5f82b-23e3-30ef-9f1b-0feeb15865a7",
                                                "text": "Ce récit est bien éloigné de la vérité."
                                            },
                                            {
                                                "example_id": "af6e80bc-357d-4d81-8fa9-ba783bb93c40",
                                                "sense_id": "08e5f82b-23e3-30ef-9f1b-0feeb15865a7",
                                                "text": "Cela est fort éloigné de ma pensée."
                                            },
                                            {
                                                "example_id": "d8c27b9b-eec2-4ff0-a73d-151d0247e31d",
                                                "sense_id": "08e5f82b-23e3-30ef-9f1b-0feeb15865a7",
                                                "text": "Leurs doctrines étaient peu éloignées l’une de l’autre."
                                            },
                                            {
                                                "example_id": "41d8278d-ae93-4e89-bc65-d1548abaa637",
                                                "sense_id": "08e5f82b-23e3-30ef-9f1b-0feeb15865a7",
                                                "text": "N’être pas éloigné de penser, de croire,"
                                            },
                                            {
                                                "example_id": "2ab9cfec-8fe5-46c6-8940-af681d2fd51a",
                                                "sense_id": "08e5f82b-23e3-30ef-9f1b-0feeb15865a7",
                                                "text": "On ne voyait pas les tramways. […]. Pourtant les quais où ils roulaient, avec des piaulements plaintifs, n’étaient guère éloignés, car la rue, quelquefois, tremblait à leur passage […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e6ac0305-eec3-3e89-beaa-2c1ad93aa113",
                                        "entry_id": "70a8e2e1-bdc1-360b-abc1-838f25a7aa71",
                                        "glosses": [
                                            "N’avoir pas l’intention ou le pouvoir."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c1435b67-7132-4ba3-851a-fb50c01c33f6",
                                                "sense_id": "e6ac0305-eec3-3e89-beaa-2c1ad93aa113",
                                                "text": "Il est bien éloigné de faire ce que vous dites, ce que vous souhaitez ; il en est bien éloigné."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "éloigné",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "63c839ef-4859-3334-bfea-c351955445f4",
                                        "entry_id": "f29c20cc-b959-3c3b-9995-98c3d352856c",
                                        "glosses": [
                                            "Participe passé masculin singulier du verbe éloigner."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f5504240-c3df-47fc-be3b-00e456f84d23",
                                                "sense_id": "63c839ef-4859-3334-bfea-c351955445f4",
                                                "text": "Mais il a rendu la vie possible. Il a éloigné les démons, désasticoté l’ambiance."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "éloigné",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6c415dc5-1fc6-3f7b-a434-51b011e2c8b1",
                                        "entry_id": "428f00d7-3be7-38ce-af15-d52c6f0abbfa",
                                        "glosses": [
                                            "Temps utilisé dans certains créoles pour marquer l'éloignement du présent (passé)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
