                "senses": [
                    {
                        "sense_id": "8925646f-47cb-3b5a-8144-e362b7e558ab",
                        "entry_id": "8d82ff14-9b0a-3695-af86-a39f05534a66",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname, selten vorkommend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f26ce8d1-82b8-4979-a26a-d28e6551b033",
                                "sense_id": "8925646f-47cb-3b5a-8144-e362b7e558ab",
                                "text": "Frau Grafenschäfer ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "ede28dd7-3bfd-4093-b5cb-1e9e94bca621",
                                "sense_id": "8925646f-47cb-3b5a-8144-e362b7e558ab",
                                "text": "Herr Grafenschäfer wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "5a1a9dd1-cd91-40ce-9406-222ee42609b4",
                                "sense_id": "8925646f-47cb-3b5a-8144-e362b7e558ab",
                                "text": "Die Grafenschäfers fahren heute ins Sauerland."
                            },
                            {
                                "example_id": "caa8f05b-8bea-48e9-9d0f-2c2e3355850d",
                                "sense_id": "8925646f-47cb-3b5a-8144-e362b7e558ab",
                                "text": "Der Grafenschäfer trägt nie die Schals, die die Grafenschäfer ihm strickt."
                            },
                            {
                                "example_id": "eb2f52ee-dd17-4ddb-8bf8-3d3a3215cb58",
                                "sense_id": "8925646f-47cb-3b5a-8144-e362b7e558ab",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Grafenschäfer kommt, geht der Herr Grafenschäfer.“"
                            },
                            {
                                "example_id": "3233cdf0-86ea-438c-b37f-6a6dc28c0968",
                                "sense_id": "8925646f-47cb-3b5a-8144-e362b7e558ab",
                                "text": "Grafenschäfer kommt und geht."
                            },
                            {
                                "example_id": "ee613c95-f220-4aa5-af3c-52c3fa2567cf",
                                "sense_id": "8925646f-47cb-3b5a-8144-e362b7e558ab",
                                "text": "Grafenschäfers kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
