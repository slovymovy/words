                    },
                    {
                        "sense_id": "3ffb681b-805c-3121-9f90-72045e9282c7",
                        "entry_id": "bba93ec0-bb4e-3e52-bf11-7c7cda78a614",
                        "glosses": [
                            "Ne pas dormir pour cause d’insomnie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a96478fd-63b6-40d6-93ff-3bd0d715d581",
                                "sense_id": "3ffb681b-805c-3121-9f90-72045e9282c7",
                                "text": "Tout a commencé dans la nuit du 2 au 3, j'étais peinarde en train d'insomniaquiser avec mes mots croisés."
                            },
                            {
                                "example_id": "ae3cddb9-e74c-4401-8d66-9c8ccd237061",
                                "sense_id": "3ffb681b-805c-3121-9f90-72045e9282c7",
                                "text": "Moralité je saute du lit tôt, à 11 H 30 (je vous rappelle que j'insomniaquise depuis des mois), j’avale mon thé et je me précipite vers la salle de bain où je prépare tout ce qu’il faut…"
                            }
                        ]
                    }
