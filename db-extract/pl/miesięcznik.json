                                    {
                                        "sense_id": "5ad0b330-ad50-3518-8042-0368f98a343c",
                                        "entry_id": "c372d491-40e1-351c-96ab-5ee98e3ce1e9",
                                        "glosses": [
                                            "A publication that is published once a month."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71368b97-0ef0-494e-9b1a-7dafc455ebe6",
                                                "sense_id": "5ad0b330-ad50-3518-8042-0368f98a343c",
                                                "text": "Of the 10 monthlies with the worst declines in January, four were Condé Nast magazines: Wired, Architectural Digest, Vogue and Lucky."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e01c717-3086-3cfc-9ba8-d805bb9dad92",
                                        "entry_id": "c372d491-40e1-351c-96ab-5ee98e3ce1e9",
                                        "glosses": [
                                            "The menstrual period."
                                        ],
                                        "tags": [
                                            "euphemistic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bca9aa7f-ea5c-412c-85eb-ac3a1589720b",
                                                "sense_id": "6e01c717-3086-3cfc-9ba8-d805bb9dad92",
                                                "text": "Katherine assumed she was having her monthly. She could recall times when her own monthly was so intense that it showed on her face."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a9979f39-b0c6-494f-9489-88b35e54bfdc",
                        "source_entry_id": "61d4f1b1-f14a-3f9f-b287-24616e22fd51",
                        "source_sense_id": "4d085468-0661-3849-8bc0-abf273fd4e73",
