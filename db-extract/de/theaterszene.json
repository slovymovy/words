                "senses": [
                    {
                        "sense_id": "c93db114-e22e-32dd-b567-dca13465df97",
                        "entry_id": "ddd4910e-de27-3348-b79f-48b8e1e14ad4",
                        "glosses": [
                            "das Umfeld, in dem Theatervorstellungen geboten und besucht werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a6730c2a-d009-45f8-a2d5-dab186950a9c",
                                "sense_id": "c93db114-e22e-32dd-b567-dca13465df97",
                                "text": "„Die vielfältige Theaterszene in Israel gerät unter den Druck der neuen israelischen Regierung , die im Mai aus rechten und religiösen Parteien gebildet wurde. Kulturministerin Miri Regev, eine Politikerin vom rechten Rand der Likud-Partei, drohte am Mittwoch im Armee-Radio mit \"weiteren Mittelstreichungen für Kultureinrichtungen, die den israelischen Staat schädigen\".“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "7238b42c-3d29-3972-926f-405a5fda20e5",
                        "entry_id": "ddd4910e-de27-3348-b79f-48b8e1e14ad4",
                        "glosses": [
                            "bestimmte, zu einem Theaterstück gehörende Szene"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3399e89-667b-44b6-be24-16b3f6b00195",
                                "sense_id": "7238b42c-3d29-3972-926f-405a5fda20e5",
                                "text": "„Die gezeigten Bilder und Themen reichen von Eroten und Bildern aus der Frauenwelt über Theaterszenen bis hin zu dionysischen Szenen, wobei sich die Bemalung häufig auf den oberen Teil des Vasenkörpers beschränkt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
