                                "target_senses": [
                                    {
                                        "sense_id": "ba889b87-b18f-3cc1-8576-85de46fc4e9f",
                                        "entry_id": "b2a40248-c325-322e-9c7e-47df09303c20",
                                        "glosses": [
                                            "eine einsprachige, meist umfangreiche und nach Themen sortierte Wörtersammlung mit Vokabular, dessen Begriffe durch Relationen miteinander verbunden sind"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe02b451-1b5b-4093-b0c2-a4d64868646d",
                                                "sense_id": "ba889b87-b18f-3cc1-8576-85de46fc4e9f",
                                                "text": "Als Thesaurus werden Wörterbücher bezeichnet, mit denen versucht wird, den gesamten Wortschatz einer Sprache, einer Epoche oder eines Autors darzustellen."
                                            },
                                            {
                                                "example_id": "b4be7cb9-618c-4c5e-b835-f5efbc3e2588",
                                                "sense_id": "ba889b87-b18f-3cc1-8576-85de46fc4e9f",
                                                "text": "Ein Thesaurus einer Sprache ordnet deren Wörter nach Themen und Wortfeldern, dient vor allem zum Auffinden besser passender Wörter beim Schreiben und enthält dafür in der Regel einen alphabetischen Index."
                                            },
                                            {
                                                "example_id": "99e60a51-c494-410b-90a9-392f4cad634c",
                                                "sense_id": "ba889b87-b18f-3cc1-8576-85de46fc4e9f",
                                                "text": "Die häufigsten Relationen in einem Thesaurus sind Äquivalenz-, Assoziations- und hierarchische Relationen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1a8110f2-4678-35ec-a763-3bfa33b5153d",
                                        "entry_id": "b2a40248-c325-322e-9c7e-47df09303c20",
                                        "glosses": [
                                            "in ein Textverarbeitungsprogramm integriertes Synonymwörterbuch"
                                        ],
                                        "tags": [
                                            "EDV"
                                        ],
                                        "examples": [
