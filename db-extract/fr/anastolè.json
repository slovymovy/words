                "senses": [
                    {
                        "sense_id": "21407882-18dc-31c9-b7c8-9e290860c29e",
                        "entry_id": "d59b029e-08b5-3d89-8d52-e427bd168b1e",
                        "glosses": [
                            "Coiffure caractérisée par des mèches de cheveux bouclées sur le front représentée dans l'art grec hellénistique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "88fe739e-df36-481c-b6fb-b93db949a4cd",
                                "sense_id": "21407882-18dc-31c9-b7c8-9e290860c29e",
                                "text": "Le dieu est en effet figuré avec la tête légèrement tournée de trois quarts vers le côté gauche, il porte une chevelure mi-longue et souple, que l'on peut qualifier de « léonine », laquelle forme une double boucle, l'anastolè, située au-dessus du front, et son visage qu'illuminent des yeux démesurément ouverts et levés vers le ciel se révèle épais."
                            },
                            {
                                "example_id": "4d3bb615-944f-4d5a-bcc9-50f509ad6c65",
                                "sense_id": "21407882-18dc-31c9-b7c8-9e290860c29e",
                                "text": "Les mèches frontales en anastolé sont formées de deux larges mèches en accolade réparties en pince à partir de l'axe de symétrie du visage."
                            }
                        ]
                    }
                ],
