                    {
                        "translation_id": "7502d346-1efb-4fa3-98eb-d7feda019360",
                        "source_entry_id": "e6db2944-e3eb-3434-bc0a-bc8279761a85",
                        "source_sense_id": "91e2594e-22a5-307a-8c2e-c2c85f46110b",
