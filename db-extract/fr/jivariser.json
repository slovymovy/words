                "senses": [
                    {
                        "sense_id": "9534dce7-abfc-3e78-b112-9d28cdb43b3b",
                        "entry_id": "d729b52e-4eeb-3017-bd5d-dcb4305c24e5",
                        "glosses": [
                            "Réduire de taille, faire rétrécir."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b126daa2-a189-4279-936b-62655aae16af",
                                "sense_id": "9534dce7-abfc-3e78-b112-9d28cdb43b3b",
                                "text": "En cas de dépassement, le secrétariat de rédaction situé à l’étage directorial se chargeait de « jivariser » notre prose pour la mettre « à la longueur »."
                            },
                            {
                                "example_id": "286361f2-d4d1-4346-9bf6-72723122ddaf",
                                "sense_id": "9534dce7-abfc-3e78-b112-9d28cdb43b3b",
                                "text": "Le vertueux doit réduire à néant son adversaire ; il doit le jivariser."
                            },
                            {
                                "example_id": "a6a37812-bdc6-468c-be25-84e06c60ef7b",
                                "sense_id": "9534dce7-abfc-3e78-b112-9d28cdb43b3b",
                                "text": "Qu’est-ce que c’est cette fiction d’un narrateur qui se fait tout petit, qui se jivarise, pour entrer dans la peau de ses personnages"
                            }
                        ]
                    }
