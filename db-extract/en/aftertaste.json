                        "examples": [
                            {
                                "example_id": "907f0d92-f16d-4c7f-93c2-b0bf8c0c50b8",
                                "sense_id": "f94cbd02-a0e2-319d-b6cc-860dacbfc9a7",
                                "text": "Canopy 19 is perfectly placed\nFor the reasonably frightening fall from the aftertaste\nYou'll have to slip away, I am unhappy to say\nBehold as the crook in the hammock plays"
                            }
                        ]
                    },
                    {
                        "sense_id": "a87e7fbe-fce1-3ca1-bc1f-c1c9c97450f4",
                        "entry_id": "7b3e4bf3-2a93-3137-9d74-b1f3329bd5a1",
