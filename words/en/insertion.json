                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс в ядерной физике, заключающийся в переходе из подкритического состояния в мгновенно критическое."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ввод",
                                "target_lang_sense_clarification": "например, ввод реактивности в ядерном реакторе"
                            },
                            {
