                            },
                            {
                                "example_id": "c2aa440c-9bab-4033-a18d-154cd3c85e0d",
                                "sense_id": "02ce6bb4-8790-316a-a520-162a05320fb3",
                                "text": "People in their twenties should have better things to be doing than writing autobiographies.",
                                "translation": "У двадцатилетних должны быть дела и поважнее, чем писать автобиографии."
                            },
                            {
                                "example_id": "5c80c3e4-22d7-4ae0-9219-7d7c40f3d918",
                                "sense_id": "02ce6bb4-8790-316a-a520-162a05320fb3",
                                "text": "She includes extracts from letters and diaries as well as autobiographies.",
                                "translation": "Она включает в себя выдержки из писем и дневников, а также автобиографии."
                            }
                        ]
                    },
                    {
                        "sense_id": "77d4c651-d1f3-328c-8b39-11d6d6c0f3a9",
                        "entry_id": "16b2f52d-62c5-3091-8da1-0053af4b6401",
                        "glosses": [
                            "автобиография (как литературный жанр)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cebae2bc-f2b7-440d-99ba-b5efcf7b01a9",
                                "sense_id": "77d4c651-d1f3-328c-8b39-11d6d6c0f3a9",
                                "text": "The book is a curious mixture of autobiography and fantasy.",
                                "translation": "Эта книга представляет собой любопытную смесь автобиографии и фэнтези."
                            }
                        ]
                    }
                ],
