                                "sense_id": "f9c38e92-937d-36c5-8ddc-5cb2ee870173",
                                "text": "„[Bouffier] betonte außerdem, dass Bürger keinen Schaden an der Lösung im Dieselstreit nehmen dürften.“"
                            },
                            {
                                "example_id": "b6893e1b-384e-4569-ae30-035c2d5400e4",
                                "sense_id": "f9c38e92-937d-36c5-8ddc-5cb2ee870173",
                                "text": "„Bundesumweltministerin Svenja Schulze (SPD) geht von einer Einigung der großen Koalition im Dieselstreit aus.“"
                            },
                            {
                                "example_id": "d7b1417d-b3bd-4744-b345-0a12c36ac954",
                                "sense_id": "f9c38e92-937d-36c5-8ddc-5cb2ee870173",
                                "text": "„Die Nacht soll eine Einigung im Dieselstreit gebracht haben, das signalisiert man zumindest nach außen.“"
                            },
                            {
                                "example_id": "c64f4421-beae-457c-b259-ad2b2a3d5fe4",
                                "sense_id": "f9c38e92-937d-36c5-8ddc-5cb2ee870173",
                                "text": "„Die Einigung im Dieselstreit gibt den Investoren ein wenig Sicherheit in dieser Angelegenheit zurück.“"
                            }
