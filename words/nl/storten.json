                {
                    "sense_id": "38c5eb6c-c441-33a8-8d19-bf204b6857fd",
                    "sense_definition": "Zichzelf met kracht ergens in werpen of van een hoogte naar beneden vallen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_motion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De dappere man <w>stortte</w> zich in de wilde rivier om de hond te redden.",
                            "target_lang_translations": {
                                "en": "The brave man <w>plunged</w> into the wild river to save the dog.",
                                "ru": "Храбрый мужчина <w>бросился</w> в бурную реку, чтобы спасти собаку.",
                                "pl": "Odważny mężczyzna <w>rzucił się</w> do dzikiej rzeki, aby uratować psa."
                            }
