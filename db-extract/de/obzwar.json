                "senses": [
                    {
                        "sense_id": "8efbd2b7-fe3a-342b-8673-151bee189529",
                        "entry_id": "6c72943a-7bd0-3f52-9f69-c6dd5800eb07",
                        "glosses": [
                            "儘管，即便，縱使"
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "d3224f2b-d5dc-4323-98eb-d820d25dfae3",
                                "sense_id": "8efbd2b7-fe3a-342b-8673-151bee189529",
                                "text": "Es war ein gelungenes Konzert, und die Stimmung war ausgezeichnet, obzwar das Orchester nicht in voller Besetzung spielte.",
                                "translation": "即便樂團並沒有全部成員到場，音樂會仍然很成功，氣氛也非常好。"
                            },
                            {
                                "example_id": "3ef26f8c-816c-4f9e-8953-870bded98d97",
                                "sense_id": "8efbd2b7-fe3a-342b-8673-151bee189529",
                                "text": "Sie nickte zustimmend, obzwar ablehnend gemeint, was sollte das bedeuten, fragte er sich, oder verstehe ich ihre Gesten einfach nicht richtig.",
                                "translation": "她點頭表示同意，儘管實際上是想表達拒絕的意思，這到底是什麼意思呢，他心裡想著，還是我根本就沒有正確理解她的手勢。"
                            },
                            {
                                "example_id": "c46d5f5d-9ac5-465d-9061-5667203af193",
                                "sense_id": "8efbd2b7-fe3a-342b-8673-151bee189529",
                                "text": "Die Gemeinde wollte die historische Fassade des alten Rathauses, obzwar nur von wenigen Passanten täglich wahrgenommen, unbedingt restaurieren lassen: 15.000 Euro Renovierungskosten würde sie dafür aufwenden.",
                                "translation": "市政委員會決心修復老市政廳的歷史立面，縱使每天只有寥寥幾個路人路過：他們準備為此花費 15,000 歐元。"
                            }
                        ]
                    }
                ],
