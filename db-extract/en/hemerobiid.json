                        "entry_id": "100567c9-a350-3ddc-a64d-8de2ad2c6e5b",
                        "glosses": [
                            "Any insect of the brown lacewing family (Hemerobiidae)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97581df9-5312-473c-bf36-430d3ed4251a",
                                "sense_id": "5be3b6d7-6317-3a26-978d-39f7e0cdad20",
                                "text": "Recent hemerobiids (brown lacewings) are terrestrial insects and both adults and larvae prey on small soft-bodied arthropods."
                            },
                            {
                                "example_id": "52edf37b-5e7e-4171-a953-7bf11d51e843",
                                "sense_id": "5be3b6d7-6317-3a26-978d-39f7e0cdad20",
                                "text": "Hemerobiids often are active at relatively low temperatures; thus they can be useful as biological control agents in temperate regions early in the season when other natural enemies remain inactive."
                            },
                            {
                                "example_id": "0954a320-fa9e-47f8-ba38-bd29fac865d1",
                                "sense_id": "5be3b6d7-6317-3a26-978d-39f7e0cdad20",
                                "text": "Coccinellid beetles and hemerobiids (brown lacewings), and other such predators are most likely to have a major impact on aphid densities."
                            }
                        ]
                    }
                ],
