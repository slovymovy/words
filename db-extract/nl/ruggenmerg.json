                    {
                        "translation_id": "99464f3d-d5e0-4aac-8992-8bd00cb92210",
                        "source_entry_id": "a7547c9b-65e8-3ef0-9f16-3035ee21d4ed",
                        "source_sense_id": "6a1d1c3c-0f80-3026-8a17-924edb8608f9",
                        "target_lang_word": "moelle épinière",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "moelle épinière",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "73e11a26-8793-3859-904b-7a33925ac379",
                                        "entry_id": "8f26b3b9-1f4f-30b0-8a4b-94fc664cf512",
                                        "glosses": [
                                            "Partie du système nerveux central se trouvant sous le tronc cérébral et contenue dans les vertèbres formant la colonne vertébrale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b948c54-d856-4320-95c7-d01b38881985",
                                                "sense_id": "73e11a26-8793-3859-904b-7a33925ac379",
                                                "text": "Le père prévenu, court furieux, après son voisin, lui lance un marteau de sellier, dont la partie tranchante s'enfonça dans l'endroit appelé la fossette du cou, et coupa la moelle épinière, ce qui occasiona la mort à l'instant même."
                                            },
                                            {
                                                "example_id": "cf1a8be2-52bc-412b-b8f2-f74bb92c19c9",
                                                "sense_id": "73e11a26-8793-3859-904b-7a33925ac379",
                                                "text": "Il ne l’avait guère eue en main que quelques secondes lors d’une visite à Drouot, pourtant l’impression demeurait encore saisissante, effroyable à ses yeux : il se remémorait avec précision le totem, le collier de fer mat et, derrière, le filetage et son volant de fonte, larges et brillants comme une presse de notaire ; la pointe de fer peint, surtout, qui vient se ficher dans la nuque afin de disjoindre les vertèbres et d’écraser la moelle épinière."
                                            },
                                            {
                                                "example_id": "ef10cef6-0122-4c32-9daf-c4414be68944",
                                                "sense_id": "73e11a26-8793-3859-904b-7a33925ac379",
                                                "text": "Or, en observant alors un faible nombre de connexions dans la moelle épinière ou dans le cerveau, nous avons suspecté que nous avions là une image très incomplète des circuits moteurs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
