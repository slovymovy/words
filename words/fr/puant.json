    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "0b326d23-b22d-34e9-8e7c-e55e52924860",
                    "sense_definition": "Qui dégage une odeur très désagréable et repoussante.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "odeur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une fumée noire et <w>puante</w> s'échappait de la vieille usine abandonnée.",
                            "target_lang_translations": {
                                "en": "Black, <w>foul-smelling</w> smoke was escaping from the old, abandoned factory.",
                                "ru": "Из старой заброшенной фабрики вырывался чёрный <w>зловонный</w> дым.",
                                "de": "Schwarzer, <w>stinkender</w> Rauch stieg aus der alten, verlassenen Fabrik auf.",
                                "es": "Una humareda negra y <w>apestosa</w> salía de la vieja fábrica abandonada.",
                                "zh": "那座废弃的老工厂里冒出一股又黑又<w>臭</w>的浓烟。"
                            }
                        },
                        {
                            "text": "Il a immédiatement jeté ses chaussettes sales et <w>puantes</w> dans la machine à laver.",
                            "target_lang_translations": {
                                "en": "He immediately threw his dirty, <w>smelly</w> socks into the washing machine.",
                                "ru": "Он сразу же бросил в стиральную машину свои грязные <w>вонючие</w> носки.",
                                "de": "Er warf seine schmutzigen, <w>stinkenden</w> Socken sofort in die Waschmaschine.",
                                "es": "Inmediatamente echó sus calcetines sucios y <w>apestosos</w> en la lavadora.",
                                "zh": "他立刻把又脏又<w>臭</w>的袜子扔进了洗衣机。"
                            }
                        }
                    ],
                    "synonyms": [
                        "fétide",
                        "malodorant",
                        "pestilentiel"
                    ],
                    "antonyms": [
                        "odorant",
                        "parfumé"
                    ],
                    "common_phrases": [
                        "odeur puante",
                        "haleine puante"
                    ],
                    "target_lang_definitions": {
                        "en": "Giving off a very unpleasant and repulsive smell.",
                        "ru": "Издающий очень неприятный, отталкивающий запах.",
                        "de": "Einen sehr unangenehmen, abstoßenden Geruch verbreitend.",
                        "es": "Que despide un olor muy desagradable y repugnante.",
                        "zh": "散发出非常难闻、令人反感的气味。"
                    },
                    "translations": {
