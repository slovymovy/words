                "senses": [
                    {
                        "sense_id": "5d25c95d-8022-32ae-8b59-e752a32d597c",
                        "entry_id": "1ae325aa-f2c0-398b-b169-e400fe7fb1a6",
                        "glosses": [
                            "elementy i środki zastosowane np. w dziele literackim, teatralnym czy w sytuacji życiowej, nie najistotniejsze dla idei dzieła lub w danej sytuacji, a jedynie uzupełniające lub ozdabiające coś"
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "cd6371db-ac55-4183-afae-f1cfedfcfa09",
                                "sense_id": "5d25c95d-8022-32ae-8b59-e752a32d597c",
                                "text": "Sztafaż jego filmów przywodzi na myśl kino postkomunistyczne, jednak retoryka jest inna"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "6cab590c-f733-3bfd-b654-381a2352be2f",
                        "entry_id": "1ae325aa-f2c0-398b-b169-e400fe7fb1a6",
                        "glosses": [
                            "postacie ludzi i zwierząt lub przedmioty uzupełniające obraz, fotografię, rysunek itp., których głównym tematem jest krajobraz lub wnętrza"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bdeecb32-d20e-4020-bcf0-e3c6173855eb",
                                "sense_id": "6cab590c-f733-3bfd-b654-381a2352be2f",
                                "text": "Sztafaż uzyskuje się, zestawiając temat zdjęcia z obiektami o dobrze znanych rozmiarach"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
