                "senses": [
                    {
                        "sense_id": "5b57d8f1-6d3f-3987-a66d-41a3d769ac4d",
                        "entry_id": "df269e8c-203b-3485-97f2-9e9a0f70f016",
                        "glosses": [
                            "Empaqueter une application et ses dépendances dans un conteneur isolé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2f098a65-2b44-4e08-ac13-29cb4444408b",
                                "sense_id": "5b57d8f1-6d3f-3987-a66d-41a3d769ac4d",
                                "text": "Dockeriser un serveur entier peut être une excellente solution si vous avez besoin de sécuriser un serveur de prod existant tel que le mien ici sans documentation, sans dépôt GitHub, et sans les développeurs historiques."
                            },
                            {
                                "example_id": "fc2a3cd6-570a-44d2-b0e8-c94c2cc5f982",
                                "sense_id": "5b57d8f1-6d3f-3987-a66d-41a3d769ac4d",
                                "text": "Donc tu as juste a dockeriser ce nginx et a lui mapper les ports 80 et 443 dehors, pour les autres applications tu ne map pas leurs ports ou alors uniquement en local et le tour et jouer.^([sic])"
                            }
                        ]
                    }
