                        "entry_id": "55d6523b-b92f-3110-9fd0-eb732c08a0ce",
                        "glosses": [
                            "Objet artisanal ojibwé, composé d’un anneau et d’un filet lâche."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61689b2d-21b9-4352-953c-8880ac5babff",
                                "sense_id": "b12ea8dd-4d7a-300e-82a6-73f24e44ab03",
                                "text": "Heureusement, la présence de Scarlet soulageait tous mes maux. Elle était comme mon attrape-rêve, chassant les cauchemars qui me tourmentaient."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "317960cf-0556-4683-8fa9-fb804da1af13",
                        "source_entry_id": "55d6523b-b92f-3110-9fd0-eb732c08a0ce",
                        "source_sense_id": "b12ea8dd-4d7a-300e-82a6-73f24e44ab03",
                        "target_lang_word": "Traumfänger",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Traumfänger",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ef076f2c-9b70-3e03-aef1-5c42f0b7184c",
                                        "entry_id": "06bb152d-ca72-3ff6-8e5c-35d2659ca381",
                                        "glosses": [
                                            "ein traditionelles Objekt der Indianer, dem nachgesagt wird, dass es die schlechten Träume von den Schlafenden fern hält"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "caceab1e-bb6c-4d67-9fd8-02a4488a62e9",
                                                "sense_id": "ef076f2c-9b70-3e03-aef1-5c42f0b7184c",
                                                "text": "Ich werde keine Albträume mehr haben, denn ich habe einen Traumfänger über meinem Bett aufgehängt."
                                            },
                                            {
                                                "example_id": "0b59b771-24a5-4f7d-874a-d3cfdf6bdad4",
                                                "sense_id": "ef076f2c-9b70-3e03-aef1-5c42f0b7184c",
                                                "text": "Über dem Bett hing ein Traumfänger, so ein rundes Ding mit nachgebildeten Spinnweben und Perlen in der Mitte."
                                            },
                                            {
                                                "example_id": "8bffa8fc-ee35-40a1-b9e6-b93613eda51a",
                                                "sense_id": "ef076f2c-9b70-3e03-aef1-5c42f0b7184c",
                                                "text": "Traumfänger werden über das Bett gehängt, um die Träume einzufangen. Damit soll bewirkt werden, daß die Seele nicht all zu weit wegwandert."
                                            },
                                            {
                                                "example_id": "374ba3e7-4de5-43ff-b6ae-731827b629d1",
                                                "sense_id": "ef076f2c-9b70-3e03-aef1-5c42f0b7184c",
                                                "text": "Im integrierten Shop gibt es Düfte und Cremes und fedengeschmückte Traumfänger, die Dämonen den Zutritt in die Traumwelt verwehren sollen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c76c21b8-866a-4c4c-b90d-0b91e9518f7e",
