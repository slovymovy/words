                ],
                "senses": [
                    {
                        "sense_id": "6bf5730e-89ff-3ddb-8792-c93e29330f8e",
                        "entry_id": "ad7b7e48-71e7-3d09-8a91-b4a4e5bb06f4",
                        "glosses": [
                            "Wahrscheinlichkeit/Gefahr, an Hautkrebs zu erkranken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "88b4d98a-8447-485a-b2f8-5a75fd89d611",
                                "sense_id": "6bf5730e-89ff-3ddb-8792-c93e29330f8e",
                                "text": "Sonnencreme senkt das Hautkrebsrisiko deutlich."
                            },
                            {
                                "example_id": "9772d2c4-48d4-4e70-abe2-470b108a7580",
                                "sense_id": "6bf5730e-89ff-3ddb-8792-c93e29330f8e",
                                "text": "Helle Hauttypen haben ein höheres/größeres Hautkrebsrisiko als dunkle Hauttypen."
                            },
                            {
                                "example_id": "bbbed1f3-bb57-4bfb-ad5c-5ab455e31ae4",
                                "sense_id": "6bf5730e-89ff-3ddb-8792-c93e29330f8e",
                                "text": "„Darüber hinaus ist das Hautkrebsrisiko durch Sonneneinstrahlung bei Rothaarigen (ähnlich wie bei Albinos) wesentlich höher als bei Menschen mit dunklerer Hautfarbe, weil die UV-Strahlen der Sonne bei ihnen leichter bis zu den Zellkernen und zur DNA der Hautzellen vordringen können. Dadurch wird das Erbgut geschädigt und es entsteht Krebs.“"
                            },
                            {
                                "example_id": "dec8bcdd-89b5-40b0-bb3e-987349a45679",
                                "sense_id": "6bf5730e-89ff-3ddb-8792-c93e29330f8e",
                                "text": "[Schlagzeile:] „Höheres Hautkrebsrisiko für Sportler“"
                            },
                            {
                                "example_id": "1f87c178-3594-4e5b-a14a-4c846876bb7f",
                                "sense_id": "6bf5730e-89ff-3ddb-8792-c93e29330f8e",
                                "text": "„Das erhöhte Hautkrebsrisiko von Marathonläufern ist Mahnung zu konsequentem Sonnenschutz.“"
                            },
                            {
                                "example_id": "804136fc-5ff6-4aa5-9f97-aa43d775bebe",
                                "sense_id": "6bf5730e-89ff-3ddb-8792-c93e29330f8e",
                                "text": "Das Hautkrebsrisiko steigt mit jedem Sonnenbrand."
                            },
                            {
                                "example_id": "a85d5fd4-cdac-456d-9e95-fafddf7ac94c",
                                "sense_id": "6bf5730e-89ff-3ddb-8792-c93e29330f8e",
                                "text": "„UV-Strahlung lässt die Haut schneller altern und, noch wichtiger, erhöht maßgeblich das Hautkrebsrisiko.“"
                            },
                            {
                                "example_id": "9f9be43e-cb6c-46a2-8baf-7e3d657b0462",
                                "sense_id": "6bf5730e-89ff-3ddb-8792-c93e29330f8e",
                                "text": "„»Die Haut vergisst nicht. Sonnenbrände in jungen Jahren erhöhen das Hautkrebsrisiko im Erwachsenenalter deutlich.«“"
                            },
                            {
                                "example_id": "56d44996-9a82-4f4d-af56-e71015c1bca0",
                                "sense_id": "6bf5730e-89ff-3ddb-8792-c93e29330f8e",
                                "text": "„Daher ist etwa in Australien, wo die Ozonschicht sehr dünn ist, das Hautkrebsrisiko besonders hoch.“"
                            },
                            {
                                "example_id": "ace76abe-710a-42fe-8341-dd2d82dd5658",
                                "sense_id": "6bf5730e-89ff-3ddb-8792-c93e29330f8e",
                                "text": "„Minderjährigen soll der Solarium-Besuch wegen des Hautkrebsrisikos künftig verboten sein.“"
                            },
                            {
                                "example_id": "685c2cab-1f27-4aa8-923c-3fa1498cf186",
                                "sense_id": "6bf5730e-89ff-3ddb-8792-c93e29330f8e",
                                "text": "[Schlagzeile:] „Hautkrebsrisiko – Australien verbietet Solarien“"
                            },
                            {
                                "example_id": "2b52e68a-5530-483c-b276-8b2b75dea4a1",
                                "sense_id": "6bf5730e-89ff-3ddb-8792-c93e29330f8e",
                                "text": "[Schlagzeile:] „Blutdrucksenker erhöht Hautkrebsrisiko“"
                            },
                            {
                                "example_id": "2faf7360-11c9-4789-850c-59fec882a893",
                                "sense_id": "6bf5730e-89ff-3ddb-8792-c93e29330f8e",
                                "text": "„Dabei stellte sich heraus, dass zwischen Kaffeekonsum und Hautkrebsrisiko ein umgekehrter Zusammenhang bestand: Mit jeder Tasse Kaffee, die mehr getrunken wurde, sank die Häufigkeit der NMHK-Erkrankungen um 1 %.“"
                            },
                            {
                                "example_id": "21d0c00b-3336-4c42-bb26-0628afc90447",
                                "sense_id": "6bf5730e-89ff-3ddb-8792-c93e29330f8e",
                                "text": "„»Prävention ist das beste Mittel, um das Hautkrebsrisiko zu senken. Sei es durch Sonnencreme mit hohem Lichtschutzfaktor, langärmlige Kleidung, Sonnenhüte und die Vermeidung der direkten Sonne«, sagt Birgit Dziuk.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
