                "senses": [
                    {
                        "sense_id": "f396b75f-180b-3a7c-925f-d4ce2fac3ad1",
                        "entry_id": "e90ccbc4-e697-3715-9858-a693aee94d93",
                        "glosses": [
                            "letzter Tag eines Monats"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d9e7572-999b-4119-8bca-1aead2e260ac",
                                "sense_id": "f396b75f-180b-3a7c-925f-d4ce2fac3ad1",
                                "text": "Schon lange vor dem Monatsletzten hat Eugen regelmäßig sein ganzes Geld ausgegeben."
                            },
                            {
                                "example_id": "f9e21771-d503-461d-aefe-7e1fb8b7168f",
                                "sense_id": "f396b75f-180b-3a7c-925f-d4ce2fac3ad1",
                                "text": "Dieses Projekt muss unbedingt bis zum Monatsletzten abgeschlossen sein."
                            },
                            {
                                "example_id": "f9808d66-19b0-461f-aac1-8b285c5fab2a",
                                "sense_id": "f396b75f-180b-3a7c-925f-d4ce2fac3ad1",
                                "text": "Sobald der Monatsletzte naht, verfällt Bertram in hektische Betriebsamkeit, um sein Monatssoll noch zu erfüllen."
                            },
                            {
                                "example_id": "53789a24-1400-4a56-a1b6-3979fd2ad656",
                                "sense_id": "f396b75f-180b-3a7c-925f-d4ce2fac3ad1",
                                "text": "Petrus hat uns doch noch einen herrlich sonnigen Monatsletzten beschert."
                            },
                            {
                                "example_id": "30364540-e4df-414b-a8ac-9f93e1bbadec",
                                "sense_id": "f396b75f-180b-3a7c-925f-d4ce2fac3ad1",
                                "text": "An einem der kommenden Monatsletzten soll das Fest stattfinden."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
