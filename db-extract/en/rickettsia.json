                "translations": [
                    {
                        "translation_id": "e1c25c26-256a-4bd8-a955-007605b94fef",
                        "source_entry_id": "347d763e-bbcc-3d8c-960c-b075a5bb890f",
                        "source_sense_description": "Rickettsia-genus bacterium",
                        "target_lang_word": "rickettsie",
