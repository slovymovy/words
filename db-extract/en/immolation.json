                                    {
                                        "sense_id": "29dcb669-ffca-369e-ba9a-a7e91dc14637",
                                        "entry_id": "7b05ca4f-91bf-3d68-a986-da9418731616",
                                        "glosses": [
                                            "Action d’immoler une personne humaine ou animale."
                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9f47b698-9a73-4327-98fa-d1ee569fc62c",
                                                "sense_id": "29dcb669-ffca-369e-ba9a-a7e91dc14637",
                                                "text": "Il importe de bien comprendre la nouveauté représentée par l’idée que la création s’effectue par une immolation ou une auto-immolation. Les mythologies précédentes connaissaient surtout le type de création à partir d’une substance primordiale façonnée par le dieu."
                                            },
                                            {
                                                "example_id": "88d2c997-5c72-467d-b8de-991936a27d87",
                                                "sense_id": "29dcb669-ffca-369e-ba9a-a7e91dc14637",
                                                "text": "L’immolation d’Iphigénie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bfb63a2c-4c60-3be2-992c-1135d539735d",
                                        "entry_id": "7b05ca4f-91bf-3d68-a986-da9418731616",
                                        "glosses": [
                                            "Action de s’immoler soi-même, de consentir au sacrifice de soi ; auto-immolation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60c6f87c-d4f4-4ddd-a6aa-27f29f4f341c",
                                                "sense_id": "bfb63a2c-4c60-3be2-992c-1135d539735d",
                                                "text": "L’immolation de Jésus."
                                            },
                                            {
                                                "example_id": "ad8f9892-51de-4034-ba89-4bc0cf130b59",
                                                "sense_id": "bfb63a2c-4c60-3be2-992c-1135d539735d",
                                                "text": "Sentiment d’immolation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "172f4e29-4da0-3fcb-b43d-d0cdbe9ebded",
                                        "entry_id": "7b05ca4f-91bf-3d68-a986-da9418731616",
                                        "glosses": [
                                            "Mise à mort d’un grand nombre d’hommes."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "013cca8b-dc0e-451d-8baf-ea65be10f35d",
                                                "sense_id": "172f4e29-4da0-3fcb-b43d-d0cdbe9ebded",
                                                "text": "Les grandes immolations de la guerre."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fcc0695a-d318-4170-a6d8-10230fd588fc",
                        "source_entry_id": "c0b283b9-b555-3248-99a5-9ad5859f2b7d",
                        "source_sense_description": "act of immolating",
                        "target_lang_word": "Aufopferung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Aufopferung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6d5c2fd2-d392-3fdf-b339-1a5670d37b38",
                                        "entry_id": "a1668c96-9540-30dc-a73f-72be17b20566",
                                        "glosses": [
                                            "sich jemandem oder etwas hingeben, darbieten oder opfern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cbf908ec-d76c-459e-b990-7915e30ac399",
                                                "sense_id": "6d5c2fd2-d392-3fdf-b339-1a5670d37b38",
                                                "text": "„Das offenbart sich auch den Besuchern, denn die Liebe und Aufopferung der SOS-Mitarbeiter spiegelt sich in den Augen derer wider, die sonst nie so einfach Kind sein könnten.“"
                                            },
                                            {
                                                "example_id": "d0125087-a45e-4b93-b9be-e7df30bb9369",
                                                "sense_id": "6d5c2fd2-d392-3fdf-b339-1a5670d37b38",
                                                "text": "„Heger, die ihre Rolle trotz Krankheit spielte, zeigt eine Claudel zwischen Aufopferung und Ehrgeiz, die in einer Männerdomäne um Anerkennung kämpft.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ef3ec233-fa36-4a28-adb4-630b210eda29",
