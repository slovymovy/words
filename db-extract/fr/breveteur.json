                        "glosses": [
                            "Personne ou entité qui brevète."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd1403d6-44e7-43b2-b2bd-6b5f6da825f6",
                                "sense_id": "6894f9db-6605-3399-9df4-04e9418f1808",
                                "text": "D’ailleurs, de plus en plus de laboratoires proposent aujourd’hui de fabriquer eux-mêmes le générique. Si celui-ci est repris par un autre laboratoire, le breveteur accepte de plus en plus souvent de réduire le coût de son médicament d’origine au niveau de celui du générique."
                            }
                        ]
                    }
                ],
                "translations": [
