                "senses": [
                    {
                        "sense_id": "7d7a64e3-23d4-333e-9589-0f40347da5ed",
                        "entry_id": "45b92873-811d-3a0a-a960-1e98b9af1d6c",
                        "glosses": [
                            "Teasing; tempting, especially that which is beyond reach."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd273ef0-aceb-4176-af85-08fdc3d713d7",
                                "sense_id": "7d7a64e3-23d4-333e-9589-0f40347da5ed",
                                "text": "...then it was that monomaniac Ahab, furious with this tantalizing vicinity of his foe, which placed him all alive and helpless in the very jaws he hated; frenzied with all this, he seized the long bone with his naked hands, and wildly strove to wrench it from its gripe."
                            },
                            {
                                "example_id": "adf5e0e1-cdc4-452d-a9b2-ad7b1a3d72df",
                                "sense_id": "7d7a64e3-23d4-333e-9589-0f40347da5ed",
                                "text": "The tantalising theory that a fifth force of nature could exist has been given a boost thanks to unexpected wobbling by a subatomic particle, physicists have revealed."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
