                {
                    "sense_id": "ac918690-f90c-30c9-b56d-d31b57a27990",
                    "sense_definition": "A river in the Scottish Borders area that partly forms the border between Scotland and England before flowing into the North Sea.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "river_tweed",
                    "name_type": "geographical_feature",
                    "examples": [
                        {
                            "text": "The <w>Tweed</w> is famous for its rich salmon fishing grounds and picturesque bridges.",
