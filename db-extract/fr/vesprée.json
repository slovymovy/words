                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "70854cbd-108b-41b4-9198-95378f4dd939",
                                "sense_id": "1e1a8a89-ea9d-37e9-af5a-6644b3a64414",
                                "text": "Mignonne, allons voir si la rose\nQui ce matin avoit déclose\nSa robe de pourpre au Soleil,\nA point perdu ceste vesprée\nLes plis de sa robe pourprée,\nEt son teint au vostre pareil."
                            },
                            {
                                "example_id": "5b1dc453-9e15-4f48-aea9-27814d6eaebf",
                                "sense_id": "1e1a8a89-ea9d-37e9-af5a-6644b3a64414",
                                "text": "Et voici que cette halte à la vesprée est toute semblable à la première halte."
                            },
                            {
                                "example_id": "046cc5ab-97f1-4f22-a70d-bc4f6414f42a",
                                "sense_id": "1e1a8a89-ea9d-37e9-af5a-6644b3a64414",
                                "text": "De mœurs assez dissolues, en ce temps-là c’était péché mignon, ce moine paillard et de franches lippées fut un jour enlevé par Satan lui-même, en pleine vesprée de décembre autour de l’âtre du château, sous les yeux horrifiés des siens."
                            }
                        ]
                    }
