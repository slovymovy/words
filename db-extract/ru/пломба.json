                                                "text": "Le plombage d’un faîte."
                                            },
                                            {
                                                "example_id": "8d2e32e0-76e6-4134-a444-a9c3ce823bdd",
                                                "sense_id": "4112716f-bc4b-3dad-97b8-19933a58a474",
