                "senses": [
                    {
                        "sense_id": "d056acf7-c694-3a1b-8589-7d3d36e99d6d",
                        "entry_id": "3ad686e4-53f0-3ef9-bfbe-465868ed4945",
                        "glosses": [
                            "Trinquer, cogner les verres en signe de joie, pour marquer son amitié ou pour faire un vœu."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44f94b94-d4f5-4764-a21e-b52301aef3fc",
                                "sense_id": "d056acf7-c694-3a1b-8589-7d3d36e99d6d",
                                "text": "Comme je range ma guitare pour le second set, Xavier me force à rester et à jouer encore : ça lui plaît ma façon de tchin-tchiner, à cette tête de lard ! Je m’exécute et je rejoue…"
                            },
                            {
                                "example_id": "33b6dafc-5cc0-45c2-b89e-7dbecb5f18d2",
                                "sense_id": "d056acf7-c694-3a1b-8589-7d3d36e99d6d",
                                "text": "Ceci dit, vu la médiocrité des champagnes, achetés par les CE à vil prix et parfois pires que des mousseux de caisse d’épargne, servis alors dans des gobelets en plastique, tchin-tchiner au Champomy sera le bienvenu."
                            },
                            {
                                "example_id": "da531e7d-2e75-40dc-a837-969f447dbcf7",
                                "sense_id": "d056acf7-c694-3a1b-8589-7d3d36e99d6d",
                                "text": "Vous « tchin-tchinez » avec ceux qui sont autour de vous après leur avoir montré votre travail !"
                            }
                        ]
                    },
                    {
                        "sense_id": "5ea4faf8-f843-38a1-8320-7411690a3c45",
                        "entry_id": "3ad686e4-53f0-3ef9-bfbe-465868ed4945",
                        "glosses": [
                            "Faire un bruit de tchin-tchin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c6bde15-c78c-4d86-a18d-f3cf323978da",
                                "sense_id": "5ea4faf8-f843-38a1-8320-7411690a3c45",
                                "text": "Autant faire comme nous et se rendre à votre terrasse sans perdre de temps ! — Sans perdre de temps ! acquiesçai-je en faisant tchin-tchiner nos verres."
                            },
                            {
                                "example_id": "15141876-87ad-4530-9f59-60802e7b71cd",
                                "sense_id": "5ea4faf8-f843-38a1-8320-7411690a3c45",
                                "text": "Brouhaha de jetons qui cliquettent sur les tapis verts, de coupes de champagne qui « tchin-tchinent » et de disco qui pulse en contrebas depuis le dancefloor du Jimmy’z."
                            }
                        ]
                    }
