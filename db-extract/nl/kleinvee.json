                                "sense_id": "9e508740-426a-324c-9a3c-9a6359dd01ae",
                                "text": "Het kleinvee graast dichtbij de boerderij.",
                                "translation": "The small livestock grazes near the farm.",
                                "english": "The small livestock grazes near the farm."
                            },
                            {
                                "example_id": "ffa84851-cded-49f6-95fe-52f32367b50b",
                                "sense_id": "9e508740-426a-324c-9a3c-9a6359dd01ae",
                                "text": "Ze hebben voornamelijk kleinvee, zoals schapen en geiten.",
                                "translation": "They primarily have small livestock, such as sheep and goats.",
                                "english": "They primarily have small livestock, such as sheep and goats."
                            },
                            {
                                "example_id": "959e359c-5162-4ccf-aa0d-6806e4332799",
                                "sense_id": "9e508740-426a-324c-9a3c-9a6359dd01ae",
                                "text": "De boerderij houdt bijen als onderdeel van hun kleinvee.",
                                "translation": "The farm keeps bees as part of their small-sized livestock.",
                                "english": "The farm keeps bees as part of their small-sized livestock."
                            }
                        ]
                    }
