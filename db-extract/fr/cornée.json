            {
                "entry_id": "008e2f60-f1a4-32ff-aeb3-9db34039a4be",
                "word": "cornée",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "a913f6e9-c822-4b6a-b64b-6a77a0708857",
                        "entry_id": "008e2f60-f1a4-32ff-aeb3-9db34039a4be",
                        "tags": [
