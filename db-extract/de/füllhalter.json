                        "form": "die Füllhalter"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "650390cd-7ced-3170-a24f-2c21b46279b8",
                        "entry_id": "ae7d35d9-5592-3ec2-a2b6-c5e56e3ef96a",
                        "glosses": [
                            "Schreibgerät, das einen kleinen Speicher für Tinte enthält und somit andauerndes Schreiben mit Tinte ermöglicht"
                        ],
                        "tags": [
                            "Kurzform von Füllfederhalter"
                        ],
                        "examples": [
                            {
                                "example_id": "eb5a6eb9-e53f-4355-ad29-dd48d96afd6c",
                                "sense_id": "650390cd-7ced-3170-a24f-2c21b46279b8",
                                "text": "Mein Füllhalter macht Kratzer in das Papier."
                            },
                            {
                                "example_id": "ce24148e-2361-4c9a-a829-c189ec7170d0",
                                "sense_id": "650390cd-7ced-3170-a24f-2c21b46279b8",
                                "text": "Ich sage lieber Füller als Füllhalter oder Füllfederhalter."
                            },
                            {
                                "example_id": "c3a7e2ed-13d5-487d-8b57-e22df7cb5e1c",
                                "sense_id": "650390cd-7ced-3170-a24f-2c21b46279b8",
                                "text": "Die Füllhalter hier hat mir mein Großvater vererbt."
                            },
                            {
                                "example_id": "e1be1bdb-3366-424d-8a56-a5ae55b555b1",
                                "sense_id": "650390cd-7ced-3170-a24f-2c21b46279b8",
                                "text": "Mit Füllhaltern geschriebene Texte sehen einfach schöner aus als welche, die mit Kugelschreibern geschrieben wurden."
                            },
                            {
                                "example_id": "17877f30-ef66-4777-95eb-1b594fd0cdf8",
                                "sense_id": "650390cd-7ced-3170-a24f-2c21b46279b8",
                                "text": "„Prüfend ergriff er den Füllhalter und schrieb einige Notizen auf, um sich in Stichworten des Gewesenen zu versichern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
