                                "target_senses": [
                                    {
                                        "sense_id": "e379b372-d28c-3d1a-b2bd-083b30818568",
                                        "entry_id": "7cdd1bc8-c7ec-3bd2-a0f2-bea9855105e6",
                                        "glosses": [
                                            "Of or pertaining to competition."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c7a5affc-d1a6-4b71-b907-06dbd7684714",
                                                "sense_id": "e379b372-d28c-3d1a-b2bd-083b30818568",
                                                "text": "The final remnants of the competitive spirit between companies will be eliminated, and there is no reasonable prospect that the dull uniformity of standardisation will be offset by greater efficiency in operation."
                                            },
                                            {
                                                "example_id": "9d7b413a-dd76-40ca-b575-28df839a10cc",
                                                "sense_id": "e379b372-d28c-3d1a-b2bd-083b30818568",
                                                "text": "Manchester United's Tom Cleverley impressed on his first competitive start and Lampard demonstrated his continued worth at international level in a performance that was little more than a stroll once England swiftly exerted their obvious authority."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1256c8c3-29c4-3aee-bc4e-04826204132b",
                                        "entry_id": "7cdd1bc8-c7ec-3bd2-a0f2-bea9855105e6",
                                        "glosses": [
                                            "Inclined to compete."
                                        ],
