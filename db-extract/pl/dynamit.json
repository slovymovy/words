                                "example_id": "c9031809-a1ce-4403-8020-39a5d7e1abf0",
                                "sense_id": "93cd87e3-b8aa-3572-8be7-4eb701edaab3",
                                "text": "Do wysadzenia tego budynku wystarczyła jedna laska dynamitu."
