                {
                    "sense_id": "5e3ed408-7e71-37e3-8ff1-5d7b390fb26d",
                    "sense_definition": "Scharnieren of dubbelvouwen (vaak gebruikt in samenstellingen of met voorzetsels).",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De stoelen <w>klappen</w> makkelijk in zodat je ze kunt opbergen.",
                            "target_lang_translations": {
                                "en": "The chairs <w>fold</w> up easily so you can store them.",
                                "ru": "Стулья легко <w>складываются</w>, так что их можно убрать.",
                                "fr": "Les chaises <w>se replient</w> facilement pour que tu puisses les ranger."
