                "entry_id": "a5271c33-ce2e-36ea-8213-0fab25ceb160",
                "word": "pâlement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "43e70c91-7ff2-3328-ad7a-4278afd2ef45",
                        "entry_id": "a5271c33-ce2e-36ea-8213-0fab25ceb160",
                        "glosses": [
                            "Avec un aspect pâle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f3f98f8-2243-484a-b4b9-ba5ce17e7731",
                                "sense_id": "43e70c91-7ff2-3328-ad7a-4278afd2ef45",
                                "text": "Pâlement bleu : Bleu pâle."
                            },
                            {
                                "example_id": "c15eb745-c37a-4f09-a58d-5f67bff0f991",
                                "sense_id": "43e70c91-7ff2-3328-ad7a-4278afd2ef45",
                                "text": "Le ciel pâlement bleu et pâlement jaune, semble le lit d’un grand fleuve desséché."
                            }
                        ]
                    },
                    {
                        "sense_id": "b6528a2b-91a2-3c72-8beb-e18c09496411",
                        "entry_id": "a5271c33-ce2e-36ea-8213-0fab25ceb160",
                        "glosses": [
                            "Faiblement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ef94135-f14f-4c66-81b8-989637435a57",
                                "sense_id": "b6528a2b-91a2-3c72-8beb-e18c09496411",
                                "text": "Cet atelier, pâlement éclairé par un jour blanc, est amusant."
                            },
                            {
                                "example_id": "262e6b0d-dca7-4848-b2a6-9f3f5ee4eb7e",
                                "sense_id": "b6528a2b-91a2-3c72-8beb-e18c09496411",
                                "text": "Mais ce langage des choses n’est pas tout auditif. Il est aussi formé d’autres signes qui s’ébauchent pâlement sur notre âme, qui l’impressionnent trop faiblement encore, mais qui viendront mieux."
                            },
                            {
                                "example_id": "05b2eceb-fb1b-40b5-9a27-c2536b45fe49",
                                "sense_id": "b6528a2b-91a2-3c72-8beb-e18c09496411",
                                "text": "Il y a en France une infamie dans le système judiciaire qui préfigure pâlement le fléau que pourrait devenir l’ordinateur, c’est l’institution du casier judiciaire et sa délivrance par extrait sur demande."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b1b9b58c-ed7b-4c53-bf68-86b887e9f12c",
                        "source_entry_id": "a5271c33-ce2e-36ea-8213-0fab25ceb160",
                        "target_lang_word": "palely",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "palely",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "29587c0e-78e7-3e0a-b72a-116556fa092f",
                                        "entry_id": "0c5cf85e-a4f9-3c9c-b4ed-c36acc33d043",
                                        "glosses": [
                                            "In a pale manner; lightly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2242c677-7443-47a1-a38a-d67a9d11dd80",
                                                "sense_id": "29587c0e-78e7-3e0a-b72a-116556fa092f",
                                                "text": "O what can ail thee, knight-at-arms, / Alone and palely loitering? / The sedge has withered from the lake, / And no birds sing."
                                            },
                                            {
                                                "example_id": "c830c347-8964-4835-b784-c5c117ea2183",
                                                "sense_id": "29587c0e-78e7-3e0a-b72a-116556fa092f",
                                                "text": "The people are palely prosperous. They lead monotonous lives."
                                            },
                                            {
                                                "example_id": "898fa626-7579-43fa-973f-52319a588c4e",
                                                "sense_id": "29587c0e-78e7-3e0a-b72a-116556fa092f",
                                                "text": "It was a warm dark night of faint clouds through which the moon shone palely as through a thin silk canopy."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
