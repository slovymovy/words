                ],
                "senses": [
                    {
                        "sense_id": "19e42c47-97c0-317b-8e4e-f671dbde14af",
                        "entry_id": "be0b138a-8f5d-30cc-bcd6-ce54c7a8181b",
                        "glosses": [
                            "Utiliser des tweets pour raconter quelque chose qui est en train de se passer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ebd6e08-9bf1-423a-a5dc-24a95f26fb80",
                                "sense_id": "19e42c47-97c0-317b-8e4e-f671dbde14af",
                                "text": "Attention, donc, à ne pas jouer les Bridget Jones (raconter sa vie sentimentale), à ne pas live-tweeter vos soirées « Nouvelle Star », à parler buzz ou de la quiche lorraine de ce midi."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7d64b48e-f30b-4b7d-8fbf-30d5f18346d3",
                        "source_entry_id": "be0b138a-8f5d-30cc-bcd6-ce54c7a8181b",
                        "source_sense_id": "19e42c47-97c0-317b-8e4e-f671dbde14af",
                        "target_lang_word": "live-tweet",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "live-tweet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8f719fae-b0e9-382c-9a3d-8f9769018395",
                                        "entry_id": "f68ab32b-6378-34a1-a10d-eef295359648",
                                        "glosses": [
                                            "To provide real-time updates or commentary on an event in progress through Twitter posts."
                                        ],
                                        "tags": [
                                            "Internet"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7605d4ce-c644-45c5-b57f-90be1d034e76",
                                                "sense_id": "8f719fae-b0e9-382c-9a3d-8f9769018395",
                                                "text": "Or maybe, like Stern, you can live-tweet comments about a television show as it is broadcast."
                                            },
                                            {
                                                "example_id": "ce257c75-d94e-4ba3-95c3-5324dd2f9b4f",
                                                "sense_id": "8f719fae-b0e9-382c-9a3d-8f9769018395",
                                                "text": "Realizing the need he had discovered—no record of the General Assembly's proceedings had to that point existed on Twitter—he returned the next night to live-tweet the whole event."
                                            },
                                            {
                                                "example_id": "90219584-0272-478e-80c9-4a3b7771cf5b",
                                                "sense_id": "8f719fae-b0e9-382c-9a3d-8f9769018395",
                                                "text": "We weren't planning to live-tweet the birth, but we felt in that moment that we needed the power of prayer."
                                            },
                                            {
                                                "example_id": "fbdf38a2-73e3-4e75-b1a0-889e90a10d0b",
                                                "sense_id": "8f719fae-b0e9-382c-9a3d-8f9769018395",
                                                "text": "He dreams of Mars as he bestrides Earth, square-jawed and indomitable. Lately, Elon Musk also likes to live-tweet his poops."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
