                        "examples": [
                            {
                                "example_id": "7e08937d-a03f-4dab-8934-329bad0dcc59",
                                "sense_id": "de221cba-5a35-340e-829e-73bd14043cff",
                                "text": "La partie de la Transcaucasie qui comprend les bassins du Tchorokh, de l’Ingour et du Rion, le haut plateau et le bassin central de la Koura jusqu’à son confluent l’Alazane, est occupée en ce moment par la race des Kartvels ou ^([sic]) Georgiens."
                            },
                            {
                                "example_id": "49b7c276-b6c0-40f8-b316-e163408f0197",
                                "sense_id": "de221cba-5a35-340e-829e-73bd14043cff",
                                "text": "C’est ainsi qu’en 988 se constitue le Royaume uni des Abkhazes, des Kartvels, des Rans et des Kakhs, dont le roi est Bagrat II et la capitale Koutaïssi."
                            }
                        ]
                    }
