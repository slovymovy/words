                        "entry_id": "bc926924-d28d-3943-b29d-081622decb77",
                        "glosses": [
                            "Endroit pour le dépôt sélectif des déchets encombrants ou susceptibles d'être recyclés."
                        ],
                        "tags": [
                            "Belgique"
                        ],
                        "examples": [
                            {
                                "example_id": "21797f68-6c4b-4cb0-8a83-a7931d2d543c",
                                "sense_id": "f6332ec9-ca30-35ea-b0cc-014175ee1e05",
                                "text": "Avant toute venue au Recypark, il est essentiel de trier les déchets que vous apporterez."
                            },
                            {
                                "example_id": "7949cea2-7179-4071-809c-39b10dc20fe6",
                                "sense_id": "f6332ec9-ca30-35ea-b0cc-014175ee1e05",
                                "text": "Durant le mois de mai, un parc à conteneurs mobile dit « recypark » se déplacera dans toute la commune de Woluwe-Saint-Pierre afin de permettre aux citoyens de la commune de se débarrasser de leurs encombrants."
                            }
                        ]
                    }
