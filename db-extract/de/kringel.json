                                        "glosses": [
                                            "ο βαθμός μηδέν στο σχολείο ή σε εξετάσεις"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "80a7b93b-db17-45de-be68-4ffaa02caf8b",
