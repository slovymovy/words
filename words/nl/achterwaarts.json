                            "target_lang_translations": {
                                "en": "He wasn't paying attention and stepped <w>backwards</w> onto the street."
                            }
                        },
                        {
                            "text": "De auto reed langzaam <w>achterwaarts</w> de garage in.",
                            "target_lang_translations": {
                                "en": "The car slowly drove <w>backwards</w> into the garage."
                            }
                        }
