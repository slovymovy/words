                ],
                "senses": [
                    {
                        "sense_id": "20ccc6cb-6086-349a-a669-50fafcffa56a",
                        "entry_id": "3768e4f9-dc02-3122-ad2f-422da54d72cd",
                        "glosses": [
                            "Gesamtheit der Entscheidungen/Überlegungen eines Paares dazu, ob, und wenn ja, wann und wie viele Kinder es haben möchte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a6b07187-3329-4eda-aab9-08b26dc8f34a",
                                "sense_id": "20ccc6cb-6086-349a-a669-50fafcffa56a",
                                "text": "In ihrer Familienplanung waren höchstens zwei Kinder vorgesehen."
                            },
                            {
                                "example_id": "47917c34-5002-4b6c-969c-d04645977b16",
                                "sense_id": "20ccc6cb-6086-349a-a669-50fafcffa56a",
                                "text": "„Mein Nachbar hatte krasse kulturelle Unterschiede zwischen Einheimischen und Zugezogenen bei der Familienplanung festgestellt.“"
                            },
                            {
                                "example_id": "3bb27753-b1ad-4d21-b99e-bbb8dc629568",
                                "sense_id": "20ccc6cb-6086-349a-a669-50fafcffa56a",
                                "text": "„Die neue Verhütungsmethode veränderte nicht nur die Art und Weise der Familienplanung, sondern gab zum ersten Mal in der Geschichte den Frauen die Freiheit, über die eigene Zukunft entscheiden zu können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "efe9fa1b-e001-304a-a54c-93f538cf05db",
                        "entry_id": "3768e4f9-dc02-3122-ad2f-422da54d72cd",
                        "glosses": [
                            "politische Maßnahmen zur Beschränkung oder Förderung der Geburtenrate"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49eeb1d2-73e7-40a8-aad0-c4f7d4afa950",
                                "sense_id": "efe9fa1b-e001-304a-a54c-93f538cf05db",
                                "text": "„Gegenüber fiel mir eine Werbetafel für Familienplanung auf, die einen Mann und eine Frau mit ihrem Baby auf dem Rücken zeigte.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
