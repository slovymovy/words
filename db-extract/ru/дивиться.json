                "senses": [
                    {
                        "sense_id": "d9971646-b93a-3fd1-8d42-c42106a5d48f",
                        "entry_id": "9e21a360-2185-37af-9491-04a16ad948b2",
                        "glosses": [
                            "разг. приходить в удивление; удивляться кому-либо, чему-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48af546e-adc2-4cc5-ae67-80150f35cc89",
                                "sense_id": "d9971646-b93a-3fd1-8d42-c42106a5d48f",
                                "text": "Не привыкайте к чудесам — дивитесь им, дивитесь!"
                            }
                        ]
                    },
                    {
                        "sense_id": "21bf2d24-bada-3178-b9ec-00147d3a72c6",
                        "entry_id": "9e21a360-2185-37af-9491-04a16ad948b2",
                        "glosses": [
                            "прост. глядеть с восхищением, с изумлением на кого-либо, что-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e859b63-c164-40bb-aa6b-26d083059f90",
                                "sense_id": "21bf2d24-bada-3178-b9ec-00147d3a72c6",
                                "text": "Дивиться вечерним небом."
                            },
                            {
                                "example_id": "ed671e11-1622-42b7-9215-4bce7cb94562",
                                "sense_id": "21bf2d24-bada-3178-b9ec-00147d3a72c6",
                                "text": "Дивиться на чужого человека."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "914dbd7a-f047-4439-88a3-c0dad235bfd4",
                        "source_entry_id": "9e21a360-2185-37af-9491-04a16ad948b2",
                        "target_lang_word": "s'étonner",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
