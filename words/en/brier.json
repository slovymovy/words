            "senses": [
                {
                    "sense_id": "881bc5cb-0b37-38f1-be70-a10390d2f826",
                    "sense_definition": "A thorny plant or shrub, especially a wild rose.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "plant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hiker struggled to walk through the thick <w>brier</w> patch.",
                            "target_lang_translations": {
                                "de": "Der Wanderer hatte Mühe, durch das dichte <w>Dornengestrüpp</w> zu laufen."
                            }
                        },
                        {
                            "text": "Sharp <w>brier</w> thorns caught on her clothing as she walked through the woods.",
                            "target_lang_translations": {
                                "de": "Scharfe <w>Dornen</w> verfingen sich in ihrer Kleidung, als sie durch den Wald ging."
                            }
                        }
                    ],
                    "synonyms": [
                        "briar",
                        "bramble"
                    ],
                    "common_phrases": [
                        "brier patch"
                    ],
                    "target_lang_definitions": {
                        "de": "Eine dornige Pflanze oder ein Strauch, insbesondere eine wilde Rose."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Dornenstrauch",
                                "target_lang_sense_clarification": "Allgemeiner Begriff für einen dornigen Strauch."
                            },
                            {
                                "target_lang_word": "Brombeergestrüpp",
                                "target_lang_sense_clarification": "Bezieht sich oft auf dichtes, dorniges Unterholz."
                            }
                        ]
                    }
                }
            ]
        },
        {
