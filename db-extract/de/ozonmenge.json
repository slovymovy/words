                        "glosses": [
                            "Menge an Ozon"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "47fac27b-f5ce-43c2-9b86-7032180fa67c",
                                "sense_id": "2dcfbe61-511d-3046-addc-6a92d3575e82",
                                "text": "„Während zwischen 1979 und 1997 mehr als ein Zehntel der weltweit vorhandenen Ozonmenge durch Chemikalien wie die FCKW zerstört worden war, nahm der globale Gehalt seitdem wieder um rund ein Prozent zu.“"
                            },
                            {
                                "example_id": "f1f4d69f-1633-4f40-babb-ba35852291ea",
                                "sense_id": "2dcfbe61-511d-3046-addc-6a92d3575e82",
                                "text": "„Über der Antarktis sinkt die Ozonmenge in jedem Frühjahr (September/Oktober) auf ein Minimum ab (starke Zunahme der Lichteinstrahlung) und steigt im November und Dezember wieder auf den Vorjahreswert an.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
