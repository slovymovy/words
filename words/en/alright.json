{
    "word_family": [
        "right",
        "rightly",
        "righteous",
        "rightful",
        "upright",
        "downright"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "a4ab09d6-dd99-3dd4-96fa-92c8c593022d",
                    "sense_definition": "Satisfactory, acceptable, or in a state of well-being.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "satisfactory_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Don't worry, everything will be <w>alright</w> in the end.",
                            "target_lang_translations": {
                                "ru": "Не волнуйся, в конце концов всё будет <w>в порядке</w>.",
                                "zh": "别担心，最后一切都会<w>没问题</w>的。"
                            }
                        },
                        {
                            "text": "The movie was <w>alright</w>, but I have seen better ones.",
                            "target_lang_translations": {
                                "ru": "Фильм был <w>нормальный</w>, но я видел и получше.",
                                "zh": "这部电影<w>还可以</w>，但我看过更好的。"
                            }
                        }
                    ],
                    "synonyms": [
                        "okay",
                        "fine",
                        "acceptable",
                        "satisfactory",
                        "decent",
                        "good enough"
                    ],
                    "antonyms": [
                        "bad",
                        "unacceptable",
                        "unsatisfactory"
                    ],
                    "common_phrases": [
                        "be alright",
                        "feel alright",
                        "look alright",
                        "seem alright"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often considered a non-standard spelling of 'all right'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Удовлетворительный, приемлемый или находящийся в порядке.",
                        "zh": "令人满意的、可以接受的，或处于健康、平安的状态。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "в порядке",
                                "target_lang_sense_clarification": "о состоянии дел или самочувствии"
                            },
                            {
                                "target_lang_word": "нормальный",
                                "target_lang_sense_clarification": "приемлемый, средний по качеству"
                            },
                            {
                                "target_lang_word": "хорошо",
                                "target_lang_sense_clarification": "благополучно"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "没问题",
                                "target_lang_sense_clarification": "表示事情进展顺利或状态良好"
                            },
                            {
                                "target_lang_word": "还可以",
                                "target_lang_sense_clarification": "表示质量一般，尚可接受"
                            },
                            {
                                "target_lang_word": "平安",
                                "target_lang_sense_clarification": "指身体健康或处境安全"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "9916951f-201b-342d-a108-6300b4da802a",
                    "sense_definition": "Used to express agreement, acceptance, or resignation.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "agreement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Alright</w>, I will help you with your homework later.",
                            "target_lang_translations": {
                                "ru": "<w>Ладно</w>, я помогу тебе с домашним заданием позже.",
                                "zh": "<w>好吧</w>，我待会儿帮你做作业。"
                            }
                        },
                        {
                            "text": "<w>Alright</w>, let's go to the park now.",
                            "target_lang_translations": {
                                "ru": "<w>Хорошо</w>, давай сейчас пойдем в парк.",
                                "zh": "<w>行</w>，我们现在去公园吧。"
                            }
                        }
                    ],
                    "synonyms": [
                        "okay",
                        "OK",
                        "fine",
                        "very well",
                        "all right",
                        "sure"
                    ],
                    "common_phrases": [
                        "alright then"
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется для выражения согласия, принятия или смирения.",
                        "zh": "用于表示同意、接受或妥协。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ладно",
                                "target_lang_sense_clarification": "выражение согласия или уступки"
                            },
                            {
                                "target_lang_word": "хорошо",
                                "target_lang_sense_clarification": "подтверждение договоренности"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "好吧",
                                "target_lang_sense_clarification": "表示勉强同意或接受建议"
                            },
                            {
                                "target_lang_word": "行",
                                "target_lang_sense_clarification": "表示确认或同意某事"
                            },
                            {
                                "target_lang_word": "好的",
                                "target_lang_sense_clarification": "表示礼貌的同意"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "97a2dcfe-9eda-3710-a94d-1e70447a1f85",
                    "sense_definition": "A casual greeting used to say hello or ask how someone is.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "greeting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Alright</w>? I haven't seen you in a long time.",
                            "target_lang_translations": {
                                "ru": "<w>Как дела</w>? Я тебя давно не видел.",
                                "zh": "<w>你好</w>吗？好久不见了。"
                            }
                        },
                        {
                            "text": "<w>Alright</w>, Dave? How is it going?",
                            "target_lang_translations": {
                                "ru": "<w>Здорово</w>, Дэйв? Как оно?",
                                "zh": "<w>你好</w>，戴夫？最近怎么样？"
                            }
                        }
                    ],
                    "synonyms": [
                        "hello",
                        "hi",
                        "hey",
                        "how are you",
                        "hiya",
                        "how's it going"
                    ],
                    "common_phrases": [
                        "alright mate"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "common in British English"
                        },
                        {
                            "trait_type": "colloquial",
                            "comment": "informal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Неформальное приветствие, используемое, чтобы поздороваться или спросить, как дела.",
                        "zh": "一种非正式的问候语，用于打招呼或询问对方近况。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "как дела",
                                "target_lang_sense_clarification": "вопрос о состоянии при встрече"
                            },
                            {
                                "target_lang_word": "здорово",
                                "target_lang_sense_clarification": "разговорное приветствие"
                            },
                            {
                                "target_lang_word": "привет",
                                "target_lang_sense_clarification": "общее приветствие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "你好",
                                "target_lang_sense_clarification": "通用的问候语"
                            },
                            {
                                "target_lang_word": "最近怎么样",
                                "target_lang_sense_clarification": "询问对方近况的问候"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "66b4adaf-52ac-3d89-a8b8-2e75207c3b81",
                    "sense_definition": "In a satisfactory or adequate manner; well enough.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "satisfactory_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The interview went <w>alright</w>, so I might get the job.",
                            "target_lang_translations": {
                                "ru": "Интервью прошло <w>нормально</w>, так что я могу получить работу.",
                                "zh": "面试进行得<w>还行</w>，所以我可能会得到这份工作。"
                            }
                        },
                        {
                            "text": "Did you sleep <w>alright</w> last night?",
                            "target_lang_translations": {
                                "ru": "Ты <w>хорошо</w> спал прошлой ночью?",
                                "zh": "你昨晚睡得<w>好</w>吗？"
                            }
                        }
                    ],
                    "synonyms": [
                        "well",
                        "satisfactorily",
                        "okay",
                        "fine"
                    ],
                    "antonyms": [
                        "badly",
                        "poorly"
                    ],
                    "common_phrases": [
                        "do alright",
                        "get on alright"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often considered a non-standard spelling of 'all right'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Удовлетворительно или адекватно; достаточно хорошо.",
                        "zh": "以令人满意或适当的方式；足够好。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нормально",
                                "target_lang_sense_clarification": "удовлетворительно"
                            },
                            {
                                "target_lang_word": "хорошо",
                                "target_lang_sense_clarification": "успешно, без проблем"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "还行",
                                "target_lang_sense_clarification": "表示程度尚可，没有问题"
                            },
                            {
                                "target_lang_word": "不错",
                                "target_lang_sense_clarification": "表示表现良好"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}