                                "example_id": "55118f24-5761-4d25-9458-2d5587a1813a",
                                "sense_id": "6ea06832-d193-3104-badc-a2014926bb38",
                                "text": "Bonsoir mon amie Cath, jolis bassins engrenouillés, j'ai déjà essayé d'identifier des grenouilles et j'ai vite abandonné."
                            }
                        ]
                    },
                    {
                        "sense_id": "8ab1836c-a1d9-3f88-84c6-ad1bf0d6ad80",
                        "entry_id": "d75a7750-8fb1-3735-b352-367b7a3397cd",
                        "glosses": [
