                "senses": [
                    {
                        "sense_id": "939bb38b-8d4a-3bf6-aa2a-52f020c46b47",
                        "entry_id": "49632894-16fd-3759-97ab-9ffca1ee52ab",
                        "glosses": [
                            "Littéralement “sein d’homme”, qu’il contienne des mamelles ou soit purement graisseux."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "97fb7592-8556-4519-a257-39161434dde4",
                                "sense_id": "939bb38b-8d4a-3bf6-aa2a-52f020c46b47",
                                "text": "Plutôt que de verser dans la moquerie de ces poitrines masculines, tentons d’en discerner le caractère érotique à l’aide de ces typologies qui reproduisent assez fidèlement la réalité des moobs."
                            },
                            {
                                "example_id": "2e15965e-2f0f-4b8d-923a-7fc69d5805eb",
                                "sense_id": "939bb38b-8d4a-3bf6-aa2a-52f020c46b47",
                                "text": "Je sais, vous avez essayé toutes sortes d’entraînements pour la poitrine, y compris des séries infinies de presses à haltères et de mouches à câble pour faire disparaître vos moobs. Pourtant, rien ne semble fonctionner."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "13e0e97b-db8b-4351-a07a-da7e77addeba",
                        "source_entry_id": "49632894-16fd-3759-97ab-9ffca1ee52ab",
                        "source_sense_id": "939bb38b-8d4a-3bf6-aa2a-52f020c46b47",
                        "target_lang_word": "moob",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "moob",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0fbf71d8-536f-3c81-9026-97115cc872a2",
                                        "entry_id": "202b4ca8-646c-3d71-9a37-e7f04680b69f",
                                        "glosses": [
                                            "A plump or untoned breast on a man."
                                        ],
                                        "tags": [
                                            "plural-normally",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f2fabd69-ec96-450f-b809-1a8bb51d26f6",
                                                "sense_id": "0fbf71d8-536f-3c81-9026-97115cc872a2",
                                                "text": "Vince has Moobs (man boobs = moobs)"
                                            },
                                            {
                                                "example_id": "1af922b3-404b-42ac-8bcf-8dc356e5e77f",
                                                "sense_id": "0fbf71d8-536f-3c81-9026-97115cc872a2",
                                                "text": "2001 September 3, miha ³, \"Re: I know I shouldn't be doing this but...\", in alt.games.video.nintendo.gamecube, Usenet,\nYeah, put a shirt on gene, we don't want to see your fatty moobs."
                                            },
                                            {
                                                "example_id": "fb535ec1-3d8b-4ca7-8e40-fb8338eec5b5",
                                                "sense_id": "0fbf71d8-536f-3c81-9026-97115cc872a2",
                                                "text": "Often – I refer you in particular to Rod Stewart and Tony Blair – these moobs are strangely taut and unsaggy, and have that bee-stung, 12-year-old girl look."
                                            },
                                            {
                                                "example_id": "def0128b-83be-4ca5-a66c-d0beff755928",
                                                "sense_id": "0fbf71d8-536f-3c81-9026-97115cc872a2",
                                                "text": "Ranged along the sides of the broad chamber were curtained booths containing day beds, and from time to time an overweight East End cabbie would emerge from one of these, his moobs glistening with sweat, [...]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "moob",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "514b5357-8b13-309c-809e-9513b2dffaa6",
                                        "entry_id": "79a995fa-2f68-3711-8434-0eb048f1439e",
                                        "glosses": [
                                            "To rapidly adjust the evaluation of a position towards zero, indicating a likely draw."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8efbff4a-3066-4b2e-ba63-67eb6ee598f5",
                                                "sense_id": "514b5357-8b13-309c-809e-9513b2dffaa6",
                                                "text": "Stockfish was slightly moobing until Leela played Qf5. An innocuous looking move that immediately sent alarm bells ringing and Stockfishes^([sic]) evaluation just kept rising."
                                            },
                                            {
                                                "example_id": "7d9853db-a789-49c0-b908-1f1841408bab",
                                                "sense_id": "514b5357-8b13-309c-809e-9513b2dffaa6",
                                                "text": "The time taken for an engine to boom / moob can be quite a while because that time taken is completely dependent on the hardware you're running the program on."
                                            },
                                            {
                                                "example_id": "413f3e8b-f09a-4f9e-97a7-2dec000bfa97",
                                                "sense_id": "514b5357-8b13-309c-809e-9513b2dffaa6",
                                                "text": "The reverse was also won uneventfully by LEELA although the fish emotes were numerous in the chat as STOCKFISH 'moobed' to a mere 0.40 evaluation after its 25th move!"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "moob",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "04476626-32a9-36e2-b4fd-3a88155b03d0",
                                        "entry_id": "958ee25a-6a00-3deb-b311-499e797e2449",
                                        "glosses": [
                                            "An instance of moobing."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ab87dd9-200d-4fe5-aa8c-83592d26d38d",
                                                "sense_id": "04476626-32a9-36e2-b4fd-3a88155b03d0",
                                                "text": "The evaluation boom and moob continued as Stockfish headed for a queen-rook-knight vs queen-rook-knight position that looked pretty nasty to me!"
                                            },
                                            {
                                                "example_id": "bd6ce356-9482-4f86-8a71-05d99e7b84db",
                                                "sense_id": "04476626-32a9-36e2-b4fd-3a88155b03d0",
                                                "text": "The latest Stockfish on my laptop finds mate in 22 in less than a minute. Do you have any examples where a boom (or moob) occurs after 2-3 minutes of evaluation?"
                                            },
                                            {
                                                "example_id": "af66caf3-cbac-4744-a73a-461562b97baa",
                                                "sense_id": "04476626-32a9-36e2-b4fd-3a88155b03d0",
                                                "text": "One notable exception to the missing lines being interesting: Sometimes on a moob the sudden insight is 'I'm going to hit the 50 move rule before realizing my advantage'."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
