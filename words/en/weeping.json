{
    "word_family": [
        "weep",
        "weeper"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "58597149-5ec0-3392-8b31-0d2c34492fd1",
                    "sense_definition": "The present participle and gerund of <w>weep</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "crying",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The child was <w>weeping</w> because he lost his favorite toy.",
                            "target_lang_translations": {
                                "es": "El niño estaba <w>llorando</w> porque perdió su juguete favorito."
                            }
                        },
                        {
                            "text": "She could not stop <w>weeping</w> after hearing the sad news.",
                            "target_lang_translations": {
                                "es": "No podía dejar de <w>llorar</w> tras escuchar la triste noticia."
                            }
                        }
                    ],
                    "synonyms": [
                        "crying",
                        "sobbing"
                    ],
                    "antonyms": [
                        "laughing",
                        "smiling"
                    ],
                    "common_phrases": [
                        "weeping bitterly",
                        "weeping openly"
                    ],
                    "target_lang_definitions": {
                        "es": "Forma de participio presente o gerundio del verbo llorar."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "llorando",
                                "target_lang_sense_clarification": "acción continua de verter lágrimas"
                            },
                            {
                                "target_lang_word": "sollozando",
                                "target_lang_sense_clarification": "llorar con respiración entrecortada"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7eb08caa-94ba-3743-8d6a-986544364bb0",
                    "sense_definition": "The act of shedding tears.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "crying",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Their constant <w>weeping</w> kept the neighbors awake all night.",
                            "target_lang_translations": {
                                "es": "Su constante <w>llanto</w> mantuvo despiertos a los vecinos toda la noche."
                            }
                        },
                        {
                            "text": "He was tired of the endless <w>weeping</w> and wanted to find a solution.",
                            "target_lang_translations": {
                                "es": "Estaba cansado del interminable <w>llanto</w> y quería encontrar una solución."
                            }
                        }
                    ],
                    "synonyms": [
                        "crying",
                        "sobbing"
                    ],
                    "target_lang_definitions": {
                        "es": "El acto de derramar lágrimas; llanto."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "llanto",
                                "target_lang_sense_clarification": "acto de llorar"
                            },
                            {
                                "target_lang_word": "sollozo",
                                "target_lang_sense_clarification": "llanto entrecortado"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}