                    {
                        "sense_id": "b432bdae-08d3-3b2d-8433-5b39b3963b60",
                        "entry_id": "a87d4df5-a631-3277-b7b3-eaf9af8ebd9f",
                        "glosses": [
                            "rzecz. odczas. od wydalać"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "80786a16-3e80-4b44-8259-1b3c2dd5133a",
                                "sense_id": "b432bdae-08d3-3b2d-8433-5b39b3963b60",
                                "text": "Regulują gospodarkę wodną organizmu - sód zatrzymuje wodę, zaś potas zwiększa jej wydalanie - poza tym wpływają one na równowagę kwasowo-zasadową i utrzymują właściwe ciśnienie osmotyczne."
                            },
                            {
                                "example_id": "049f27c7-4618-41cc-8592-db507cd24805",
                                "sense_id": "b432bdae-08d3-3b2d-8433-5b39b3963b60",
                                "text": "Nadmierne wydzielanie aldosteronu przez nadnercza zmniejsza nerkowe wydalanie Na⁺, zwiększa natomiast wydalanie z moczem K⁺, Mg₂⁺ i NH₄⁺."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
