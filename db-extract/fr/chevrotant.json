                ],
                "senses": [
                    {
                        "sense_id": "9bcbded4-e254-3a47-94eb-0c9ae6cac59f",
                        "entry_id": "8c046601-5ffb-32ee-99e3-5ff28ec082be",
                        "glosses": [
                            "Qui chevrote, se comporte à la manière d’une chèvre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd768c41-e510-46de-b8fc-f60d105a5718",
                                "sense_id": "9bcbded4-e254-3a47-94eb-0c9ae6cac59f",
                                "text": "Cette pendule antique avait une voix chevrotante d’amie très vieille, qui les amusait, dans l’obscurité, quand ils veillaient, aux bras l’un de l’autre."
                            },
                            {
                                "example_id": "3d842e75-f7ef-46cd-988e-4711a4f51ac3",
                                "sense_id": "9bcbded4-e254-3a47-94eb-0c9ae6cac59f",
                                "text": "Parfois, elles chantent des couplets d’amour qui sonnent étrangement dans leurs bouches à la voix chevrotante, presque éteinte déjà."
                            },
                            {
                                "example_id": "905ba14f-8013-4085-be64-a6a14442dd23",
                                "sense_id": "9bcbded4-e254-3a47-94eb-0c9ae6cac59f",
                                "text": "Les chanteuses, d’une voix chevrotante, entonnent une étrange mélopée: « […] »."
                            },
                            {
                                "example_id": "4ab627b3-06c2-4a81-9bd6-04dd0dd1402a",
                                "sense_id": "9bcbded4-e254-3a47-94eb-0c9ae6cac59f",
                                "text": "La deudeuche fit une embardée, partit brouter quelques mètres de sillon du champ labouré, se cabra, se rétablit en grognant de toute la puissance chevrotante de son moteur, reprit enfin sa danse sur le chemin."
                            }
                        ]
                    }
