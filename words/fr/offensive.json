            "senses": [
                {
                    "sense_id": "36a31e78-f60e-3021-bb6f-3a11065e237d",
                    "sense_definition": "Attaque militaire ou action énergique menée pour s'imposer face à un adversaire ou sur un marché.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "attaque",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'armée a décidé de lancer une <w>offensive</w> majeure pour repousser les troupes ennemies.",
                            "target_lang_translations": {
                                "en": "The army decided to launch a major <w>offensive</w> to push back the enemy troops.",
                                "ru": "Армия решила начать крупное <w>наступление</w>, чтобы отбросить вражеские войска.",
                                "de": "Die Armee beschloss, eine große <w>Offensive</w> zu starten, um die feindlichen Truppen zurückzudrängen.",
                                "es": "El ejército decidió lanzar una gran <w>ofensiva</w> para rechazar a las tropas enemigas.",
                                "zh": "军队决定发动一场大规模<w>攻势</w>，以击退敌军。"
                            }
                        },
                        {
                            "text": "Face aux critiques, le directeur a immédiatement choisi de passer à l'<w>offensive</w>.",
                            "target_lang_translations": {
                                "en": "Faced with criticism, the director immediately decided to go on the <w>offensive</w>.",
                                "ru": "Столкнувшись с критикой, директор тут же решил перейти в <w>наступление</w>.",
                                "de": "Angesichts der Kritik beschloss der Direktor sofort, in die <w>Offensive</w> zu gehen.",
                                "es": "Ante las críticas, el director optó de inmediato por pasar a la <w>ofensiva</w>.",
                                "zh": "面对批评，经理立即决定转入<w>攻势</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "assaut",
                        "attaque"
                    ],
                    "antonyms": [
                        "défensive",
                        "retraite"
                    ],
                    "common_phrases": [
                        "passer à l'offensive",
                        "lancer une offensive",
                        "mener une offensive"
                    ],
                    "target_lang_definitions": {
                        "en": "A military attack or energetic move to gain the upper hand against an opponent or in the market.",
                        "ru": "Военное наступление или энергичные действия, направленные на то, чтобы одержать верх над противником или на рынке.",
                        "de": "Militärischer Angriff oder energisches Vorgehen, um sich gegen einen Gegner oder auf dem Markt durchzusetzen.",
                        "es": "Ataque militar o acción enérgica para imponerse frente a un adversario o en el mercado.",
                        "zh": "为夺取优势而发动的军事进攻，或在市场等领域采取的积极强硬行动。"
