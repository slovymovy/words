                {
                    "sense_id": "b362e8eb-f842-30fa-a5ee-9280c416f295",
                    "sense_definition": "A person who is very interested in and involved with a particular subject or activity.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "interest",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "As a dedicated fitness <w>enthusiast</w>, she goes to the gym every single morning before work.",
                            "target_lang_translations": {
                                "ru": "Как преданный <w>любитель</w> фитнеса, она ходит в спортзал каждое утро перед работой."
                            }
                        },
                        {
                            "text": "I would challenge any rock <w>enthusiast</w> to refrain from tapping their foot when listening to such music.",
                            "target_lang_translations": {
                                "ru": "Я бы бросил вызов любому <w>поклоннику</w> рока удержаться от того, чтобы не топать ногой в такт, слушая такую музыку."
                            }
                        }
                    ],
                    "synonyms": [
                        "aficionado",
                        "buff",
                        "devotee",
                        "fan",
                        "fancier"
                    ],
                    "common_phrases": [
                        "fitness enthusiast",
                        "outdoor enthusiast",
                        "car enthusiast",
                        "tech enthusiast"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который очень интересуется какой-либо темой или деятельностью и активно ими занимается."
                    },
