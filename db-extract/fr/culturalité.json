                                            {
                                                "example_id": "9086025e-d771-4fc4-b21f-de4947e2e29c",
                                                "sense_id": "7e41a992-40e8-38fd-84be-6e4d6e4fe77a",
                                                "text": "Just as culture is not simply rooted in the logic of the state, culturalities have a much broader basis—including family, ethnic, global cultural flows, and discourses about popular and high culture."
                                            },
                                            {
                                                "example_id": "8af5aad3-bfb3-4c61-a2ee-71ea9c651f57",
                                                "sense_id": "7e41a992-40e8-38fd-84be-6e4d6e4fe77a",
                                                "text": "To the extent that the human form of life is a social one, then, it tends to constitute forms of likeness that issue in culturality."
                                            }
