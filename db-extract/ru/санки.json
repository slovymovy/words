                "senses": [
                    {
                        "sense_id": "e6f9ea0e-b655-3377-a4a8-66249c889aaf",
                        "entry_id": "11d5e8b4-657e-32ae-a36f-c82e317e71a1",
                        "glosses": [
                            "лёгкие сани, рассчитанные на перевозку небольшого числа пассажиров"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95284b76-141f-4a6b-88d7-a32aa5a1efe5",
                                "sense_id": "e6f9ea0e-b655-3377-a4a8-66249c889aaf",
                                "text": "Приятно думать у лежанки. // Но знаешь: не велеть ли в санки // Кобылку бурую запречь?"
                            }
                        ]
                    },
                    {
                        "sense_id": "c018aff5-fc36-3e30-a212-c80106cb3f3f",
                        "entry_id": "11d5e8b4-657e-32ae-a36f-c82e317e71a1",
                        "glosses": [
                            "небольшие сани, как правило, рассчитанные на ребёнка"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "198411f5-0e4d-4f2e-84a4-cfaefda4ddd3",
                                "sense_id": "c018aff5-fc36-3e30-a212-c80106cb3f3f",
                                "text": "С восьмилетним двоюродным племянником я карабкались на гору, чтобы с визгом восторга, оседлав санки, скатиться вниз."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4819ff7a-1cef-4b6f-bf62-c42ab2d3e477",
                        "source_entry_id": "11d5e8b4-657e-32ae-a36f-c82e317e71a1",
                        "target_lang_word": "sledge",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sledge",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0b4907e8-aa6e-33db-877b-ffb3614f5e4f",
                                        "entry_id": "bf92a37b-b1d2-3cf0-a347-b9c09511026f",
                                        "glosses": [
                                            "A heavy, long handled maul or hammer used to drive stakes, wedges, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d13b6941-319f-4fbd-8b8b-3d701096c2dc",
                                                "sense_id": "0b4907e8-aa6e-33db-877b-ffb3614f5e4f",
                                                "text": "[based on information from Major Hill, Master of the Silver Mills, in 1662, describing silver mining in Cardiganshire] They dig the Oar thus; One holds a little Picque, or Punch of Iron, having a long Handle of Wood which they call a Gad; Another with a great Iron Hammer, or Sledge, drives it into the Vein."
                                            },
                                            {
                                                "example_id": "db6d4dcb-4abc-4aab-9b15-776003e41338",
                                                "sense_id": "0b4907e8-aa6e-33db-877b-ffb3614f5e4f",
                                                "text": "Sledge hammers are only used for heavy-duty persuading when working on vehicles or machinery."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sledge",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2e4dfb19-03cb-38a3-8eb9-1440b908a2df",
                                        "entry_id": "01915084-2c35-3025-9981-8a3a3d3f7b49",
                                        "glosses": [
                                            "To hit with a sledgehammer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8cbcf13-cc86-4128-9d84-fc2c0909e327",
                                                "sense_id": "2e4dfb19-03cb-38a3-8eb9-1440b908a2df",
                                                "text": "The rapid and violent exertion of smiths, mightily sledging the glowing iron masses of their furnaces."
                                            },
                                            {
                                                "example_id": "160b99ad-e8cd-4e75-b6f1-86cbb4584f02",
                                                "sense_id": "2e4dfb19-03cb-38a3-8eb9-1440b908a2df",
                                                "text": "When I inquired the reason of this wire being used in the construction of the safe, I was told it was to prevent the doors being broken by either sledging or wedging."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sledge",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3ce47366-8423-32e8-9744-d5a3469c5a31",
                                        "entry_id": "bf5a987b-247b-3cb7-aa5b-59d45592e006",
                                        "glosses": [
                                            "A low sled drawn by animals, typically on snow, ice or grass."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "542d4f39-64c9-4cf1-8f6a-79453b97ccd8",
                                                "sense_id": "3ce47366-8423-32e8-9744-d5a3469c5a31",
                                                "text": "The sledge ran far better upon the ice; I cannot say the same for the dogs."
                                            },
                                            {
                                                "example_id": "56db76d7-0bcb-4c2c-94df-a94031c2f345",
                                                "sense_id": "3ce47366-8423-32e8-9744-d5a3469c5a31",
                                                "text": "The sledges of the Esquimaux are of large size, varying from six and a half to nine and even eleven feet in length, and from eighteen inches to two feet in breadth."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d5132d4c-3acd-360c-b7d2-e5c7b065e50b",
                                        "entry_id": "bf5a987b-247b-3cb7-aa5b-59d45592e006",
                                        "glosses": [
                                            "any type of sled or sleigh."
                                        ],
                                        "tags": [
                                            "British"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5bcb798c-b188-4812-9042-fd2b57feb200",
                                                "sense_id": "d5132d4c-3acd-360c-b7d2-e5c7b065e50b",
                                                "text": "Aged wore out Coal-Horses, which after some time Wrought you will have, may serve turn for Sledge-Horses."
                                            },
                                            {
                                                "example_id": "06a44c77-a2e6-49c3-9f4a-139ddda741e1",
                                                "sense_id": "d5132d4c-3acd-360c-b7d2-e5c7b065e50b",
                                                "text": "Ty'd upon the Sledge, a Papist and a Protestant in front, being two very disparate and antipathetick Companions, was a very ridiculous Science of Cruelty, even worst than Death it self (says he)."
                                            },
                                            {
                                                "example_id": "f4d5c7a7-eaeb-46c6-a5e4-bb9beb835ab7",
                                                "sense_id": "d5132d4c-3acd-360c-b7d2-e5c7b065e50b",
                                                "text": "There are also Winter Paralympic Games with Alpine and Nordic events, as well as sledge hockey - a form of ice hockey using a seated sledge."
                                            },
                                            {
                                                "example_id": "70c70220-0867-4b38-b85a-051dbef37088",
                                                "sense_id": "d5132d4c-3acd-360c-b7d2-e5c7b065e50b",
                                                "text": "For anyone who can recall their schooldays, when you used to get snow every winter, flying down hills on a polythene bag the thickness of an atom, and a lovely old sledge your Grandpa made for you (the only Christmas it DIDN'T snow),..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f888733b-33e1-3347-8ae8-4f6d98cb620c",
                                        "entry_id": "bf5a987b-247b-3cb7-aa5b-59d45592e006",
                                        "glosses": [
                                            "A card game resembling all fours and seven-up; old sledge."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "sledge",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "21d963b8-9e82-32f0-93aa-df7bfd87f7cb",
                                        "entry_id": "f08d204f-118a-305d-bf7d-747be61e194d",
                                        "glosses": [
                                            "To drag or draw a sledge."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ae16bf6-c39b-487c-98df-e06173862699",
                                                "sense_id": "21d963b8-9e82-32f0-93aa-df7bfd87f7cb",
                                                "text": "It should be remembered, that these explorations were nearly all made by our seamen and officers on foot, dragging sledges, on which were piled tents, provision, fuel for cooking, and raiment. This sledging was brought to perfection by Captain M'Clintock."
                                            },
                                            {
                                                "example_id": "3505ae5d-b165-4a99-8a28-24921fb09f19",
                                                "sense_id": "21d963b8-9e82-32f0-93aa-df7bfd87f7cb",
                                                "text": "Sledging en route to Mt. Logan on the 1925 first ascent. [caption to photo of four men dragging a sledge]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e02d182a-301c-3645-b516-182a3a0ea01c",
                                        "entry_id": "f08d204f-118a-305d-bf7d-747be61e194d",
                                        "glosses": [
                                            "To ride, travel with or transport in a sledge."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e12b59d-1c83-45c0-8427-87262d3084ef",
                                                "sense_id": "e02d182a-301c-3645-b516-182a3a0ea01c",
                                                "text": "He was also to initiate me in the American pastime of sleighing, or sledging."
                                            },
                                            {
                                                "example_id": "db806207-682c-4889-b007-cad9f0737f02",
                                                "sense_id": "e02d182a-301c-3645-b516-182a3a0ea01c",
                                                "text": "When \"the great fen or moor\" which washed the city walls on the north was frozen over, sliding, sledging, and skating were the sports of crowds."
                                            },
                                            {
                                                "example_id": "f022bded-4aec-4bff-8ad0-b4716669df9d",
                                                "sense_id": "e02d182a-301c-3645-b516-182a3a0ea01c",
                                                "text": "2006, Godfrey (EDT) Baldacchino, Extreme Tourism: Lessons from the World's Cold Water Islands\nSome of these may be closely associated with the day-to-day lifestyle of such communities — marine activities (fishing, wildlife viewing), mountain activities (abseiling, climbing, hunting) or winter sports (dog sledging)."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sledge",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9232b637-140b-3ca4-8667-f50fcceefd6e",
                                        "entry_id": "6fd39769-049d-3cd8-84da-f9f3cdfba8ef",
                                        "glosses": [
                                            "To verbally insult or abuse an opponent in order to distract them (considered unsportsmanlike)."
                                        ],
                                        "tags": [
                                            "Australia"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cf623481-c3cc-4bf7-a183-6f2de98621af",
                                                "sense_id": "9232b637-140b-3ca4-8667-f50fcceefd6e",
                                                "text": "I've never been one to sledge on the field. I was normally too tired to be bothered, but the one time I did, didn't I cop it."
                                            },
                                            {
                                                "example_id": "f52b3775-884a-4f65-a8d1-a5349d5165aa",
                                                "sense_id": "9232b637-140b-3ca4-8667-f50fcceefd6e",
                                                "text": "Batteries of fast bowlers softened batsmen up with short-pitched bowling, while fielders tried to disturb their concentration with a running commentary of insults commonly known as sledging."
                                            },
                                            {
                                                "example_id": "dc49de22-8b85-4ad8-92f0-7030999d79e2",
                                                "sense_id": "9232b637-140b-3ca4-8667-f50fcceefd6e",
                                                "text": "Then, all these...government legislators...would be able to totally concentrate on their roles and functions, without being entangled in interparty sledging and squabbles."
                                            },
                                            {
                                                "example_id": "cc019501-4940-4982-bf80-dfe3040eea9e",
                                                "sense_id": "9232b637-140b-3ca4-8667-f50fcceefd6e",
                                                "text": "The 2000 Code of the Laws of Cricket includes new anti-sledging provisions."
                                            },
                                            {
                                                "example_id": "08419ed6-516e-4cba-8e13-fc938b1c62b0",
                                                "sense_id": "9232b637-140b-3ca4-8667-f50fcceefd6e",
                                                "text": "\"Bloody hell even their sledging is now shite!!!\" he sledged."
                                            },
                                            {
                                                "example_id": "c09fccaa-6459-4e91-b276-843b1e6e1ef8",
                                                "sense_id": "9232b637-140b-3ca4-8667-f50fcceefd6e",
                                                "text": "it would be eccentric to change governments when we're delivering so much and when we have such a vast mandate and when we're actually only a handful of points behind in the polls, even in mid-term, after quite a few months of pretty relentless sledging and when the economic scene is so difficult domestically and internationally."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sledge",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5358abc2-e6d8-3b00-ac43-67c59e7c1cc8",
                                        "entry_id": "a0d7d65c-06f7-3601-8cfd-b22328df4c7b",
                                        "glosses": [
                                            "An instance of sledging."
                                        ],
                                        "tags": [
                                            "Australia"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17d2ee0d-e240-4575-86ca-18ff9396f2ba",
                                                "sense_id": "5358abc2-e6d8-3b00-ac43-67c59e7c1cc8",
                                                "text": "Now that's what I call a sledge."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
