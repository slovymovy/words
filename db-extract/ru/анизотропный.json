                                "target_word": "anisotrópico",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "d1f65d88-d134-3881-b502-9b22611c2df1",
                                        "entry_id": "15223afa-da44-34fe-bfb8-8d4609cf597d",
                                        "glosses": [
                                            "Que tiene propiedades diferentes en diferentes ejes, que tiene anisotropía"
                                        ],
