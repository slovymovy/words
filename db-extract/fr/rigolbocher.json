                "senses": [
                    {
                        "sense_id": "2ef3dd4b-22ae-3c0f-a212-eeae9e8c1654",
                        "entry_id": "b03953e2-d394-3be4-a7a9-92ada00e0809",
                        "glosses": [
                            "Danser, rire, à la manière de Rigolboche."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "2eb1ce63-2473-478c-aa88-caa06c837edb",
                                "sense_id": "2ef3dd4b-22ae-3c0f-a212-eeae9e8c1654",
                                "text": "C’est bien fait ! À mort ! Dansons, chantons, rigolbochons ! »\nMais la ribouldingue n’a pas duré longtemps."
                            },
                            {
                                "example_id": "1d3f4876-837b-4d46-ae99-0a5a3ede98ad",
                                "sense_id": "2ef3dd4b-22ae-3c0f-a212-eeae9e8c1654",
                                "text": "Je vais le faire rigolbocher, il ne va pas être déçu du voyage, celui-là."
                            },
                            {
                                "example_id": "abea0a20-feab-4244-aac1-0ad8477674b9",
                                "sense_id": "2ef3dd4b-22ae-3c0f-a212-eeae9e8c1654",
                                "text": "Ne criez pas au drame supposé de votre sort : comment voudriez-vous qu'aucun ne s’en vînt au contraire émouvoir au point de trouver motif à rigolbocher s’il entend le dénouement de votre épopée fixe…"
                            }
                        ]
                    }
