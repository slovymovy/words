                "senses": [
                    {
                        "sense_id": "4170e6cf-20fe-32a3-982d-f9b7c3897f3b",
                        "entry_id": "71001bb0-050f-3f2e-8332-2aceadf8dd18",
                        "glosses": [
                            "Inclure au départ."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8b06429-3b5e-4f25-9648-3fb7b6af8e50",
                                "sense_id": "4170e6cf-20fe-32a3-982d-f9b7c3897f3b",
                                "text": "Comme pour l'étude ANOCOR, il sera possible de pré-inclure un dossier si le diagnostic a été fait dans les 12 mois précédents."
                            },
                            {
                                "example_id": "6bf117db-adad-4a52-9119-966742072206",
                                "sense_id": "4170e6cf-20fe-32a3-982d-f9b7c3897f3b",
                                "text": "Lors de l'EPS, afin de pré-inclure les consultants dans les ateliers, les infirmières disposent d'un outil créé spécifiquement à Nancy."
                            },
                            {
                                "example_id": "108f72d8-8562-40af-8c5b-bb7e5089bad4",
                                "sense_id": "4170e6cf-20fe-32a3-982d-f9b7c3897f3b",
                                "text": "Depuis, je soutiens sans réserve tous ceux qui montent les pc sans pré-inclure de force des logiciels."
                            }
                        ]
                    }
