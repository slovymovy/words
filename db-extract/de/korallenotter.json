                                        "glosses": [
                                            "Nom donné à plusieurs espèces de serpents venimeux, souvent très colorés, de la famille des élapidés."
                                        ],
                                        "tags": [
                                            "Ophiologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "24564390-95bb-422e-965f-2e3e35b41045",
                                                "sense_id": "61fbcc27-391d-3008-a25f-421a51f9427c",
                                                "text": "Je ne puis passer sous silence le serpent corail, qu’on nomme ainsi à cause de sa couleur incarnate, qui est entremêlée de taches noires, grises, blanches & jaunes."
                                            },
                                            {
                                                "example_id": "7fcff0ce-b8e5-447e-8463-92a97910d3a6",
                                                "sense_id": "61fbcc27-391d-3008-a25f-421a51f9427c",
                                                "text": "En Amérique, les serpents corail (Micrurus et Micruroides) sont fouisseurs et ophiophages."
                                            },
                                            {
                                                "example_id": "8a184d47-426e-4711-8039-6f9c9b3620ee",
                                                "sense_id": "61fbcc27-391d-3008-a25f-421a51f9427c",
                                                "text": "On rencontre des serpents corail en Asie, en Afrique, en Australie et en Amérique."
                                            }
