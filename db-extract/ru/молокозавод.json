                    {
                        "translation_id": "ce598e48-d5f6-46c7-985d-73cc81ce84fe",
                        "source_entry_id": "ef622f36-c5f1-338f-9d71-d57010e06ddb",
                        "source_sense_id": "d661d7ec-1c1d-36ac-bbc1-2f27883a2d7a",
                        "target_lang_word": "Molkerei",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Molkerei",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3a6ed4d6-06fd-3217-b8c1-7d1f482e4cfc",
                                        "entry_id": "7464f4f7-1907-35fb-afd0-489072fb8a1b",
                                        "glosses": [
                                            "Betrieb zur Verarbeitung von Milch"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3d1b4b5-d505-482f-950f-7fcbf9377818",
                                                "sense_id": "3a6ed4d6-06fd-3217-b8c1-7d1f482e4cfc",
                                                "text": "„In den Räumen der ehemaligen Molkerei in der Osterweder Straße haben sich eine Reihe verschiedener Kunsthandwerksbetriebe, Ateliers und Galerien angesiedelt.“"
                                            },
                                            {
                                                "example_id": "87704605-49be-4108-a03c-7a99616b2470",
                                                "sense_id": "3a6ed4d6-06fd-3217-b8c1-7d1f482e4cfc",
                                                "text": "„Bei Milch, Käse und Joghurt gibt es längerfristige Verträge, nur beim Streichfett verhandeln Molkereien und Handel ihre Kontrakte monatlich neu.“"
                                            },
                                            {
                                                "example_id": "40b86b0b-3957-4d62-939b-7768ee2d4159",
                                                "sense_id": "3a6ed4d6-06fd-3217-b8c1-7d1f482e4cfc",
                                                "text": "„Überall gibt es noch Kühe, jedoch keine Lieferungen mehr an die Molkerei von Glowitz.“"
                                            },
                                            {
                                                "example_id": "07536cb5-62a1-40fb-a750-f13e67389521",
                                                "sense_id": "3a6ed4d6-06fd-3217-b8c1-7d1f482e4cfc",
                                                "text": "„Sie arbeiten im Familienbetrieb, der Molkerei, aber die Eltern wollen sie glüklich verheiratet sehen, und Tewje erählt, wie es ihnen dabei ergeht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
