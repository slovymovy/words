                    }
                ],
                "translations": [
                    {
                        "translation_id": "038fed69-def0-4a14-84ed-b00266d7d2f3",
                        "source_entry_id": "a33d1656-2946-3242-ba46-0b68f2b227f4",
                        "target_lang_word": "cuneiform",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cuneiform",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f6362294-5631-3bfc-a729-6fce172cd356",
                                        "entry_id": "01a36cd0-f5cd-3794-9038-85d5f94b2c69",
                                        "glosses": [
                                            "Having the form of a wedge; wedge-shaped, especially with a tapered end."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eed5c571-9988-4321-9cb9-8ca649d45b59",
                                                "sense_id": "f6362294-5631-3bfc-a729-6fce172cd356",
                                                "text": "About midway across the larger log a cuneiform notch or cut about six inches deep was made."
                                            },
                                            {
                                                "example_id": "ad6b7fdb-1efa-4bd0-8ecc-7cf770321460",
                                                "sense_id": "f6362294-5631-3bfc-a729-6fce172cd356",
                                                "text": "The cuneiform tendon is always sharply defined when the hock is flexed by the action of the muscle."
                                            },
                                            {
                                                "example_id": "41829c23-75f1-4010-b134-f145b85583c2",
                                                "sense_id": "f6362294-5631-3bfc-a729-6fce172cd356",
                                                "text": "The cuneiform leaf is not the characteristic heart-shaped early form (O. and P., p. 241)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "98e32f47-a876-3204-bd40-d2c82ee50fb8",
                                        "entry_id": "01a36cd0-f5cd-3794-9038-85d5f94b2c69",
                                        "glosses": [
                                            "Written in the cuneiform writing system."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af767033-5001-4815-a84b-b2f7028c4c9a",
                                                "sense_id": "98e32f47-a876-3204-bd40-d2c82ee50fb8",
                                                "text": "There, too, it was originally the vulgar script in contrast with the official cuneiform script employed for all official documents, compacts, etc."
                                            },
                                            {
                                                "example_id": "257c9e32-97d7-4ac3-ac2e-32ac000aa42b",
                                                "sense_id": "98e32f47-a876-3204-bd40-d2c82ee50fb8",
                                                "text": "The text is inscribed on a clay tablet of a very unusual format. The only other known mathematical cuneiform text on a clay tablet of a similar format is also the only previously known Kassite (and therefore post-Old-Babylonian) mathematical cuneiform text."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "cuneiform",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "894aab41-1a26-3a91-b45f-f5f5a201bd9a",
                                        "entry_id": "32f877b6-58b8-3a13-8974-8d5121f9179a",
                                        "glosses": [
                                            "An ancient Mesopotamian writing system, adapted within several language families, originating as pictograms in Sumer around the 30th century BC, evolving into more abstract and characteristic wedge shapes formed by a blunt reed stylus on clayen tablets."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e39a0571-3796-311b-8055-875b31562f8b",
                                        "entry_id": "32f877b6-58b8-3a13-8974-8d5121f9179a",
                                        "glosses": [
                                            "A wedge-shaped bone, especially a cuneiform bone."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
