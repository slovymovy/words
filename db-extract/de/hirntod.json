                        "form": "die Hirntode"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ce0f3218-5f91-3b87-9141-26ad63e74827",
                        "entry_id": "b7644067-ec8d-3d6e-8e5c-2b4082b887ef",
                        "glosses": [
                            "endgültiges und vollständiges Erlöschen der lebensnotwendigen Gehirnfunktionen"
                        ],
                        "tags": [
                            "jargon"
                        ],
                        "examples": [
                            {
                                "example_id": "d4935bce-b226-418e-b5c8-5fa7c89027ea",
                                "sense_id": "ce0f3218-5f91-3b87-9141-26ad63e74827",
                                "text": "„Findet schon durch das gängige Hirntodkriterium eine Reduktion des im Grunde ganzheitlichen Prozeßgeschehens Sterben auf einen Moment, nämlich den des Hirntodes, statt, dann ist das potentielle Ausmaß der weiteren Vereinnahmung des Sterbens durch einen noch zu schaffenden Gebietsarzt für \"Transplantationsthanatologie\" kaum absehbar.“"
                            },
                            {
                                "example_id": "9fdaf547-36e9-4806-a015-e64a84c28b22",
                                "sense_id": "ce0f3218-5f91-3b87-9141-26ad63e74827",
                                "text": "„Sicheres Zeichen des Hirntodes ist der Nachweis einer fehlenden Durchblutung aller Hirnarterien mittels Angiografie der Hirngefäße.“"
                            },
                            {
                                "example_id": "7b4ebffe-82b8-4b2b-86cd-750fec745a8f",
                                "sense_id": "ce0f3218-5f91-3b87-9141-26ad63e74827",
                                "text": "„Die Diagnostik des zentralen Hirntods spielt vor allem in der Transplantationsmedizin eine zentrale Rolle: Der Hirntod ist eine der Voraussetzungen für eine Organentnahme.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
