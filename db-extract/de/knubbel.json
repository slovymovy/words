                "senses": [
                    {
                        "sense_id": "41619fae-5b97-34c9-9b19-8e7a681b2cc8",
                        "entry_id": "2c5ab379-f1eb-3b24-94bd-de328133d9ef",
                        "glosses": [
                            "knob, knot (a swollen or thick spot on something)"
                        ],
                        "tags": [
                            "masculine",
                            "regional",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "b37a0631-7095-4258-87d8-d775ead2727f",
                                "sense_id": "41619fae-5b97-34c9-9b19-8e7a681b2cc8",
                                "text": "Diesen Knubbel hier am Bein hatte ich immer schon.",
                                "translation": "I've always had this knob here on my leg.",
                                "english": "I've always had this knob here on my leg."
                            },
                            {
                                "example_id": "bc8f490c-8417-4a49-9802-3c12f7f5d3e6",
                                "sense_id": "41619fae-5b97-34c9-9b19-8e7a681b2cc8",
                                "text": "Seitdem mein Mann gestrichen hat, sind hier überall Knübbelchen an der Wand.",
                                "translation": "Since my husband painted [the house], there are little clumps at the walls everywhere.",
                                "english": "Since my husband painted [the house], there are little clumps at the walls everywhere."
                            }
                        ]
                    },
                    {
                        "sense_id": "04d602a8-641f-30b1-af78-4d34b02fca8c",
                        "entry_id": "2c5ab379-f1eb-3b24-94bd-de328133d9ef",
                        "glosses": [
                            "knot (of people)"
                        ],
                        "tags": [
                            "Germany",
                            "Western",
                            "masculine",
                            "regional",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "622648e8-7e1c-4040-95e4-fd0dc76d3692",
                                "sense_id": "04d602a8-641f-30b1-af78-4d34b02fca8c",
                                "text": "Vor dem kleinen Fernseher stand ein ganzer Knubbel Leute.",
                                "translation": "A knot of people was standing in front of that small TV.",
                                "english": "A knot of people was standing in front of that small TV."
                            }
                        ]
                    },
                    {
                        "sense_id": "f177932f-9d4c-3012-b2ef-449e53b42728",
                        "entry_id": "2c5ab379-f1eb-3b24-94bd-de328133d9ef",
                        "glosses": [
                            "a subdivision in certain carnival clubs that are organised on a mock-military basis, equivalent to a platoon"
                        ],
                        "tags": [
                            "Germany",
                            "Western",
                            "masculine",
                            "regional",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "97c1cb37-cb20-4f92-b677-125c350b5807",
                                "sense_id": "f177932f-9d4c-3012-b2ef-449e53b42728",
                                "text": "Und jetzt der dritte Knubbel des Stadtsoldatenregiments unter der Leitung von Willi Fischer!",
                                "translation": "And now the third platoon of the municipal soldier regiment under the direction of Willi Fischer!",
                                "english": "And now the third platoon of the municipal soldier regiment under the direction of Willi Fischer!"
                            }
                        ]
                    }
