                "senses": [
                    {
                        "sense_id": "5be4d344-c177-3c24-84c4-25527fdd158c",
                        "entry_id": "6228b55d-110f-3395-8cb0-08dab518738e",
                        "glosses": [
                            "rzecz. odczas. od niszczyć"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96a93568-3fee-43d1-a9ef-4f4721d77eec",
                                "sense_id": "5be4d344-c177-3c24-84c4-25527fdd158c",
                                "text": "Genetycznie modyfikowane szczepionki przeciwnowotworowe pobudzają układ odpornościowy pacjenta do rozpoznawania i niszczenia komórek nowotworowych, które normalnie pozostają bezkarne."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8e86906c-b36a-4e7e-8c75-91cc21d21572",
                        "source_entry_id": "6228b55d-110f-3395-8cb0-08dab518738e",
                        "source_sense_id": "5be4d344-c177-3c24-84c4-25527fdd158c",
                        "target_lang_word": "destruction",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "destruction",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c1655afd-3fba-3942-8b7b-575cccedac61",
                                        "entry_id": "3260a78f-e26e-3b49-9506-2a1ed0b9375e",
                                        "glosses": [
                                            "The act of destroying."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd2840b9-f2af-4db7-9ced-a7d5699dc729",
                                                "sense_id": "c1655afd-3fba-3942-8b7b-575cccedac61",
                                                "text": "The destruction of the condemned building will take place at noon."
                                            },
                                            {
                                                "example_id": "aa3fc8a7-592f-4aa6-971b-02f7ed67f191",
                                                "sense_id": "c1655afd-3fba-3942-8b7b-575cccedac61",
                                                "text": "It may be that a free society as we have known it carries in itself the forces of its own destruction, that once freedom has been achieved it is taken for granted and ceases to be valued, and that the free growth of ideas which is the essence of a free society will bring about the destruction of the foundations on which it depends."
                                            },
                                            {
                                                "example_id": "919585b2-bf88-4745-91ca-c6a9ed067ab1",
                                                "sense_id": "c1655afd-3fba-3942-8b7b-575cccedac61",
                                                "text": "About 1500 B.C., however, a powerful earthquake caused widespread destruction, and thereafter there were major changes. An earlier script, undeciphered, but known as Linear A, was replaced by the Greek Linear B."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "63ddea86-b825-30dd-a211-227c5fe5ec06",
                                        "entry_id": "3260a78f-e26e-3b49-9506-2a1ed0b9375e",
                                        "glosses": [
                                            "The results of a destructive event."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "78fd7c37-1092-48a2-b733-b4ce19fe90f7",
                                                "sense_id": "63ddea86-b825-30dd-a211-227c5fe5ec06",
                                                "text": "Amid the seemingly endless destruction, a single flower bloomed."
                                            },
                                            {
                                                "example_id": "68cf2d12-32a8-44fe-956d-2fc339b69457",
                                                "sense_id": "63ddea86-b825-30dd-a211-227c5fe5ec06",
                                                "text": "If destruction be our lot we must ourselves be its author and finisher. As a nation of freemen we must live through all time or die by suicide."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f064b243-3a36-3f7d-87f9-e688d741fc2a",
                                        "entry_id": "3260a78f-e26e-3b49-9506-2a1ed0b9375e",
                                        "glosses": [
                                            "A group of feral cats."
                                        ],
                                        "tags": [
                                            "collective",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bb69c659-442b-40db-b854-1989f309279f",
                                                "sense_id": "f064b243-3a36-3f7d-87f9-e688d741fc2a",
                                                "text": "A group of wild cats is called a destruction."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
