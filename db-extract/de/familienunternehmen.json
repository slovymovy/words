                "senses": [
                    {
                        "sense_id": "aaf7ac97-fce4-316a-806e-b46d6d913c4e",
                        "entry_id": "c8e4d5ce-d2e5-3d49-9896-5310d371a164",
                        "glosses": [
                            "Unternehmen, welches von einer Familie geführt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4cebc0c2-ae00-4dbd-b57a-25de2292e715",
                                "sense_id": "aaf7ac97-fce4-316a-806e-b46d6d913c4e",
                                "text": "Die Schuhfabrik nebenan ist ein Familienunternehmen."
                            },
                            {
                                "example_id": "7504b1f2-a21d-429c-aa9f-472736b9d429",
                                "sense_id": "aaf7ac97-fce4-316a-806e-b46d6d913c4e",
                                "text": "„Das Familienunternehmen erzielte im Jahr 2023 einen Umsatz von 25,6 Milliarden Euro.“"
                            },
                            {
                                "example_id": "df2e8abe-4d8c-4bee-8695-091424df580a",
                                "sense_id": "aaf7ac97-fce4-316a-806e-b46d6d913c4e",
                                "text": "„Die Größe seines Familienunternehmens erwähnt Iwan fast beiläufig, die bloßen Zahlen sind beeindruckend genug.“"
                            },
                            {
                                "example_id": "a46eb5ce-390f-4072-98ca-a224db802279",
                                "sense_id": "aaf7ac97-fce4-316a-806e-b46d6d913c4e",
                                "text": "„Fast vier Jahrzehnte lange hat Angola wie ein korruptes Familienunternehmen funktioniert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
