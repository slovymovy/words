                        "target_lang_word": "Hochschule",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hochschule",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "849f2136-018d-3106-9091-8b04a875fb27",
                                        "entry_id": "93197fdf-8a38-3fe8-93ed-b2832858c4c2",
                                        "glosses": [
                                            "eine wissenschaftliche Einrichtung des Tertiären Bildungsbereichs, die der Pflege der Wissenschaften und Künste durch Forschung und Lehre sowie der beruflichen Ausbildung und Weiterbildung dient."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9976d15c-a1f4-42d4-b6d1-4b9035ed72bd",
                                                "sense_id": "849f2136-018d-3106-9091-8b04a875fb27",
                                                "text": "Der Dozent lehrt an einer Hochschule."
                                            },
                                            {
                                                "example_id": "0401e71b-6dfc-4ba4-b205-bd1958bb8dda",
                                                "sense_id": "849f2136-018d-3106-9091-8b04a875fb27",
                                                "text": "„Ein Vater besucht die Hochschule, wo der Sohn studiert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8de8adc1-cdcf-4854-98e4-b6a11ee5ed28",
                        "source_entry_id": "fda42423-4c08-39cf-86cf-da8984115f0f",
                        "source_sense_description": "onderwijsinstelling voor hoger beroepsonderwijs",
                        "target_lang_word": "Universität",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Universität",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "db8758fc-2bf2-38e5-b51f-3c1a998e1269",
                                        "entry_id": "a5fa70fe-bd58-309e-9ca6-de7bfd41a65c",
                                        "glosses": [
                                            "eine in Fakultäten gegliederte, höchste wissenschaftliche Bildungsstätte, Lehranstalt und Forschungseinrichtung, an der auf vielen verschiedenen (universellen) Wissenschaftsgebieten gelehrt und geforscht wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58292006-8de7-449e-bdd8-7f222ce1f0f1",
                                                "sense_id": "db8758fc-2bf2-38e5-b51f-3c1a998e1269",
                                                "text": "Alex studiert an der Universität in Magdeburg."
                                            },
                                            {
                                                "example_id": "0cd3165e-4a50-4bb4-895a-ff4aa5e78de0",
                                                "sense_id": "db8758fc-2bf2-38e5-b51f-3c1a998e1269",
                                                "text": "„Es war die Zeit, als sich die Jugend an der Universität noch siezte, als Studenten Anzüge und Krawatten trugen und ihre Kommilitoninnen Kleider mit weißen Kragen oder Perlenketten.“"
                                            },
                                            {
                                                "example_id": "8080a00c-e8d8-4bad-8f8c-e42433abbdd6",
                                                "sense_id": "db8758fc-2bf2-38e5-b51f-3c1a998e1269",
                                                "text": "„Die Universität Cambridge ist eine der ältesten und berühmtesten der Welt.“"
                                            },
                                            {
                                                "example_id": "21be419f-dbe7-4458-9666-e90ea379883d",
                                                "sense_id": "db8758fc-2bf2-38e5-b51f-3c1a998e1269",
                                                "text": "„Gewiß muß die Universität zum Teil von dieser Welt sein.“"
                                            },
                                            {
                                                "example_id": "3a9295cd-91ac-4a14-b03d-1271ebe68f58",
                                                "sense_id": "db8758fc-2bf2-38e5-b51f-3c1a998e1269",
                                                "text": "„Die Universitäten wollen den Studierenden künftig wieder mehr Raum für Sinnfindung geben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1ac7b653-84f8-3229-b04a-b90205824171",
                                        "entry_id": "a5fa70fe-bd58-309e-9ca6-de7bfd41a65c",
                                        "glosses": [
                                            "zusammenfassend für den Lehrkörper, die Studierendenschaft und die Beschäftigten von [1]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2878b5cd-bc6e-4c34-83e4-44a6858c3ae0",
                                                "sense_id": "1ac7b653-84f8-3229-b04a-b90205824171",
                                                "text": "„Als „ehrgeizig, aber überzeugend“ hat die Deutsche Forschungsgemeinschaft (DFG) das Gleichstellungskonzept der Universität Osnabrück gelobt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "bbcdc940-6706-3e10-9c83-b58f2c34986f",
                                        "entry_id": "a5fa70fe-bd58-309e-9ca6-de7bfd41a65c",
                                        "glosses": [
                                            "das Universitätsgebäude, das Hauptgebäude, Verwaltungsgebäude von [1]"
                                        ],
                                        "tags": [
                                            "short-form"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3839261f-c19e-4af4-ae16-5def82b5a528",
                                                "sense_id": "bbcdc940-6706-3e10-9c83-b58f2c34986f",
                                                "text": "„Diese Studentinnen bauten gerade einen Verkaufsstand auf dem abendlichen Markt in der Nähe der Universität für Flugtechnik und Raumfahrt auf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
