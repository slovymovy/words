{
    "word_family": [
        "latchkey",
        "unlatch"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e1d62c98-c07d-33d5-91a9-4d48a5f33b5e",
                    "sense_definition": "To fasten or close a door or gate using a latch.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "fasten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please make sure you <w>latch</w> the garden gate so the dog does not escape.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, не забудь <w>запереть на щеколду</w> садовую калитку, чтобы собака не убежала."
                            }
                        },
                        {
                            "text": "She heard the heavy wooden door <w>latch</w> firmly behind her as she entered the house.",
                            "target_lang_translations": {
                                "ru": "Войдя в дом, она услышала, как тяжелая деревянная дверь плотно <w>защёлкнулась</w> за её спиной."
                            }
                        }
                    ],
                    "synonyms": [
                        "fasten",
                        "secure",
                        "close"
                    ],
                    "antonyms": [
                        "unlatch",
                        "open"
                    ],
                    "common_phrases": [
                        "latch the gate",
                        "latch the door"
                    ],
                    "target_lang_definitions": {
                        "ru": "Закрывать или запирать дверь или ворота на щеколду или защелку."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "запирать на щеколду",
                                "target_lang_sense_clarification": "использовать механический запор"
                            },
                            {
                                "target_lang_word": "защёлкивать",
                                "target_lang_sense_clarification": "закрывать до щелчка"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "212be4fb-1939-3215-8962-3b0880cb4116",
                    "sense_definition": "To attach or connect to the breast for feeding.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "breastfeeding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The midwife helped the new mother ensure the baby would <w>latch</w> correctly.",
                            "target_lang_translations": {
                                "ru": "Акушерка помогла молодой маме убедиться, что ребенок правильно <w>захватывает грудь</w>."
                            }
                        },
                        {
                            "text": "It can take several days for a newborn to <w>latch</w> on effectively during nursing.",
                            "target_lang_translations": {
                                "ru": "Новорожденному может потребоваться несколько дней, чтобы научиться эффективно <w>прикладываться</w> во время кормления."
                            }
                        }
                    ],
                    "common_phrases": [
                        "latch on"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прикладываться или прикрепляться к груди для кормления."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "захватывать грудь",
                                "target_lang_sense_clarification": "о младенце при кормлении"
                            },
                            {
                                "target_lang_word": "прикладываться",
                                "target_lang_sense_clarification": "к груди"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "28071657-26c6-33e3-8a81-247295ae5c5c",
                    "sense_definition": "To catch or lay hold of something.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "grasp",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The detective managed to <w>latch</w> onto a vital piece of evidence that solved the case.",
                            "target_lang_translations": {
                                "ru": "Детективу удалось <w>зацепиться</w> за важную улику, которая помогла раскрыть дело."
                            }
                        },
                        {
                            "text": "He tried to <w>latch</w> the falling rope before it slipped out of reach.",
                            "target_lang_translations": {
                                "ru": "Он попытался <w>схватить</w> падающую веревку, прежде чем она выскользнула из рук."
                            }
                        }
                    ],
                    "synonyms": [
                        "grasp",
                        "seize",
                        "clutch"
                    ],
                    "antonyms": [
                        "release",
                        "drop"
                    ],
                    "common_phrases": [
                        "latch onto"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ухватиться за что-либо или зацепиться за идею/улику."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ухватиться",
                                "target_lang_sense_clarification": "за предмет или идею"
                            },
                            {
                                "target_lang_word": "зацепиться",
                                "target_lang_sense_clarification": "за информацию или улику"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6f26302e-4d37-3cf3-b936-a75160ad4413",
                    "sense_definition": "To smear or anoint.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "anoint",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The spirit was told to <w>latch</w> the sleeping man's eyes with the magic juice.",
                            "target_lang_translations": {
                                "ru": "Духу велели <w>смазать</w> глаза спящего волшебным соком."
                            }
                        },
                        {
                            "text": "In the old play, the character would <w>latch</w> the potion onto the victim's eyelids.",
                            "target_lang_translations": {
                                "ru": "В старинной пьесе герой <w>наносил</w> зелье на веки жертвы."
                            }
                        }
                    ],
                    "synonyms": [
                        "anoint",
                        "smear"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in historical literary contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Смазывать или помазывать (устаревшее)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "смазывать",
                                "target_lang_sense_clarification": "наносить жидкость или мазь"
                            },
                            {
                                "target_lang_word": "помазать",
                                "target_lang_sense_clarification": "архаичное использование"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ea362870-a609-3d1c-aa76-2d11ddac74cc",
                    "sense_definition": "A mechanical fastening for a door or gate, typically consisting of a bar that falls into a notch.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "fastener",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The metal <w>latch</w> clicked shut, signaling that the shed was finally secure.",
                            "target_lang_translations": {
                                "ru": "Металлическая <w>защёлка</w> щелкнула, сигнализируя о том, что сарай наконец заперт."
                            }
                        },
                        {
                            "text": "He lifted the <w>latch</w> and pushed the heavy oak door open.",
                            "target_lang_translations": {
                                "ru": "Он поднял <w>щеколду</w> и толкнул тяжелую дубовую дверь."
                            }
                        }
                    ],
                    "synonyms": [
                        "catch",
                        "fastener",
                        "bolt"
                    ],
                    "common_phrases": [
                        "door latch",
                        "gate latch",
                        "lift the latch"
                    ],
                    "target_lang_definitions": {
                        "ru": "Механический запор для двери или ворот, обычно состоящий из пластины или стержня."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "щеколда",
                                "target_lang_sense_clarification": "подвижная пластинка с рычажком"
                            },
                            {
                                "target_lang_word": "защёлка",
                                "target_lang_sense_clarification": "автоматический запорный механизм"
                            },
                            {
                                "target_lang_word": "задвижка",
                                "target_lang_sense_clarification": "стержень для запирания"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5f19373b-176a-335c-83eb-8a265d925a8b",
                    "sense_definition": "The manner in which a baby identifies and attaches to the breast for breastfeeding.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "breastfeeding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A good <w>latch</w> is essential for comfortable and successful breastfeeding.",
                            "target_lang_translations": {
                                "ru": "Правильный <w>захват</w> необходим для комфортного и успешного грудного вскармливания."
                            }
                        },
                        {
                            "text": "The lactation consultant checked the infant's <w>latch</w> to ensure proper feeding.",
                            "target_lang_translations": {
                                "ru": "Консультант по лактации проверила <w>прикладывание</w> младенца, чтобы обеспечить правильное кормление."
                            }
                        }
                    ],
                    "common_phrases": [
                        "good latch",
                        "proper latch"
                    ],
                    "target_lang_definitions": {
                        "ru": "Способ, которым ребенок захватывает грудь во время кормления."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "захват",
                                "target_lang_sense_clarification": "груди при кормлении"
                            },
                            {
                                "target_lang_word": "прикладывание",
                                "target_lang_sense_clarification": "к груди"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "40bb59b5-131d-347f-8ac7-4975c3519bf6",
                    "sense_definition": "An electronic circuit used to store information, triggered by signal levels.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "electronics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The engineer explained how the <w>latch</w> maintains its state until the input changes.",
                            "target_lang_translations": {
                                "ru": "Инженер объяснил, как <w>защёлка</w> сохраняет свое состояние до изменения входного сигнала."
                            }
                        },
                        {
                            "text": "In digital logic, a <w>latch</w> is different from a flip-flop because it is level-triggered.",
                            "target_lang_translations": {
                                "ru": "В цифровой логике <w>латч</w> отличается от триггера тем, что он управляется уровнем сигнала."
                            }
                        }
                    ],
                    "common_phrases": [
                        "data latch",
                        "logic latch"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical term in electronics"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Электронная схема для хранения информации, управляемая уровнем сигнала."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "защёлка",
                                "target_lang_sense_clarification": "в цифровой электронике"
                            },
                            {
                                "target_lang_word": "регистр-защёлка",
                                "target_lang_sense_clarification": "технический термин"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "507a6097-e123-3fd6-8397-ea141d0563ba",
                    "sense_definition": "A low-level synchronization mechanism used to protect shared data structures from concurrent access.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The database performance suffered because of a <w>latch</w> contention during peak hours.",
                            "target_lang_translations": {
                                "ru": "Производительность базы данных пострадала из-за конкуренции за <w>латчи</w> в часы пик."
                            }
                        },
                        {
                            "text": "A <w>latch</w> is used by the system to ensure data integrity in memory.",
                            "target_lang_translations": {
                                "ru": "<w>Латч</w> используется системой для обеспечения целостности данных в памяти."
                            }
                        }
                    ],
                    "common_phrases": [
                        "latch contention"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical term in computing"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Механизм синхронизации низкого уровня для защиты структур данных в памяти."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "латч",
                                "target_lang_sense_clarification": "в базах данных и программировании"
                            },
                            {
                                "target_lang_word": "краткосрочная блокировка",
                                "target_lang_sense_clarification": "в контексте СУБД"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9a77d56b-4e8b-3bcb-9ce6-18ab6699fc80",
                    "sense_definition": "An old term for a crossbow.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "weapon",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The museum displayed an ancient <w>latch</w> used by soldiers in the Middle Ages.",
                            "target_lang_translations": {
                                "ru": "В музее был выставлен древний <w>арбалет</w>, который использовали солдаты в Средние века."
                            }
                        },
                        {
                            "text": "He carried a <w>latch</w> across his back while hunting in the forest.",
                            "target_lang_translations": {
                                "ru": "Он нес <w>арбалет</w> за спиной во время охоты в лесу."
                            }
                        }
                    ],
                    "synonyms": [
                        "crossbow"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historical term for a weapon"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Старинное название арбалета."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "арбалет",
                                "target_lang_sense_clarification": "исторический термин"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "88366966-9396-3bb2-9a46-015d79b7b5fa",
                    "sense_definition": "A system for installing child safety seats in cars without using seat belts.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "safety",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Most modern vehicles are equipped with the <w>LATCH</w> system for easier car seat installation.",
                            "target_lang_translations": {
                                "ru": "Большинство современных автомобилей оснащены системой <w>LATCH</w> для более простой установки автокресел."
                            }
                        },
                        {
                            "text": "Check your car manual to locate the <w>LATCH</w> anchors in the back seat.",
                            "target_lang_translations": {
                                "ru": "Проверьте руководство к автомобилю, чтобы найти крепления <w>LATCH</w> на заднем сиденье."
                            }
                        }
                    ],
                    "common_phrases": [
                        "LATCH system",
                        "LATCH anchors"
                    ],
                    "target_lang_definitions": {
                        "ru": "Система крепления детских автокресел без использования ремней безопасности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "LATCH",
                                "target_lang_sense_clarification": "американский стандарт крепления автокресел"
                            },
                            {
                                "target_lang_word": "система крепления",
                                "target_lang_sense_clarification": "детских сидений"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}