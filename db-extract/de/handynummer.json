                "senses": [
                    {
                        "sense_id": "3e3f6892-8c4d-3844-aa9e-3b49c102261f",
                        "entry_id": "2cf5c064-4710-319d-a7b9-e67f04d9dcb3",
                        "glosses": [
                            "Zahlenkombination, mit der man einen bestimmten Teilnehmer auf dem Mobiltelefon erreichen kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa789187-8b14-4256-87a8-6bf354c95559",
                                "sense_id": "3e3f6892-8c4d-3844-aa9e-3b49c102261f",
                                "text": "Kannst du mir deine Handynummer aufschreiben, damit ich dich unterwegs erreichen kann?"
                            },
                            {
                                "example_id": "61512adf-5f09-4406-97fa-a27da1bf3425",
                                "sense_id": "3e3f6892-8c4d-3844-aa9e-3b49c102261f",
                                "text": "„Zwei Nummern tauchten oft auf, Handynummern.“"
                            },
                            {
                                "example_id": "d24b686a-263d-43da-985a-0a50894bfd85",
                                "sense_id": "3e3f6892-8c4d-3844-aa9e-3b49c102261f",
                                "text": "„Er hatte ihr am Vortag seine Handynummer gegeben.“"
                            },
                            {
                                "example_id": "aec007d9-0711-480f-9a50-43809e55bc6b",
                                "sense_id": "3e3f6892-8c4d-3844-aa9e-3b49c102261f",
                                "text": "„Alternativ besticht oder überredet die Gruppe Mitarbeiter von Mobilfunkunternehmen, ihnen fremde Handynummern auf ihre eigenen Geräte zu übertragen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
