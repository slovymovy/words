                ],
                "senses": [
                    {
                        "sense_id": "e4daf1cc-0513-37ec-825b-fbe72e065bb8",
                        "entry_id": "2ef96884-2a68-31f6-b2a4-32f51719279b",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f1938626-fa08-4633-a231-d271572cda9b",
                                "sense_id": "e4daf1cc-0513-37ec-825b-fbe72e065bb8",
                                "text": "Frau Strässle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "acad8815-5c6f-44f8-ae3a-f0d342f308a9",
                                "sense_id": "e4daf1cc-0513-37ec-825b-fbe72e065bb8",
                                "text": "Herr Strässle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "9a9854a7-5589-44b8-8f86-0f297b7a17a0",
                                "sense_id": "e4daf1cc-0513-37ec-825b-fbe72e065bb8",
                                "text": "Die Strässles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "ceb5c85e-eb3c-4325-b42c-d0f5802eb0c6",
                                "sense_id": "e4daf1cc-0513-37ec-825b-fbe72e065bb8",
                                "text": "Der Strässle trägt nie die Pullover, die die Strässle ihm strickt."
                            },
                            {
                                "example_id": "5ad305ab-1084-4d32-9910-591d4c75276c",
                                "sense_id": "e4daf1cc-0513-37ec-825b-fbe72e065bb8",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Strässle kommt, geht der Herr Strässle.“"
                            },
                            {
                                "example_id": "96a88885-af77-4370-a942-7f4f87c96627",
                                "sense_id": "e4daf1cc-0513-37ec-825b-fbe72e065bb8",
                                "text": "Strässle kommt und geht."
                            },
                            {
                                "example_id": "ec3a2e74-8bc9-43dc-912c-b82780db2043",
                                "sense_id": "e4daf1cc-0513-37ec-825b-fbe72e065bb8",
                                "text": "Strässles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
