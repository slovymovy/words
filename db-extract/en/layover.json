                    {
                        "sense_id": "98017a61-ef24-3e41-8696-8920f957a4d8",
                        "entry_id": "a9e67be7-9faf-3369-941d-fb93824a19ea",
                        "glosses": [
                            "A break between stages of a journey."
                        ],
                        "tags": [
                            "Australia",
                            "Canada",
                            "US"
                        ],
                        "examples": [
                            {
                                "example_id": "e61ff6df-f99c-4807-ab1d-0b3c3a5853a0",
                                "sense_id": "98017a61-ef24-3e41-8696-8920f957a4d8",
                                "text": "We had a layover while waiting to change planes, so we stretched our legs."
                            },
                            {
                                "example_id": "82bc90dc-dc91-4d76-85f7-c4e8a32ec087",
                                "sense_id": "98017a61-ef24-3e41-8696-8920f957a4d8",
                                "text": "We could restore a second platform at Battersby to eliminate the long layover in the branch stub that is currently required for trains to pass one another."
                            },
                            {
                                "example_id": "541e89ab-317c-47ab-b63b-280325a8fef5",
                                "sense_id": "98017a61-ef24-3e41-8696-8920f957a4d8",
                                "text": "Waddicor will be here for a while. The double shunts take an hour. But it's a scheduled four-hour reload and layover, ahead of his return train back to Didcot."
                            }
                        ]
                    }
                ],
