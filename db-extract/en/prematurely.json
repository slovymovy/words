                                    {
                                        "sense_id": "596ee6b8-0e2d-3fa5-afc2-c6c6f73347fa",
                                        "entry_id": "a1d4570e-2353-38e6-ae9c-880263e20a4c",
                                        "glosses": [
                                            "zu schnell (eilig), ohne sich Zeit zum Nachdenken zu geben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2fbe7028-c380-4aee-b8b1-4829330bba43",
                                                "sense_id": "596ee6b8-0e2d-3fa5-afc2-c6c6f73347fa",
                                                "text": "Uschi ist beim Kauf der ersten Lebkuchen noch voreiliger als Renate gewesen."
                                            },
                                            {
                                                "example_id": "49f096d3-2378-413e-9fe8-cf0a9306deb5",
                                                "sense_id": "596ee6b8-0e2d-3fa5-afc2-c6c6f73347fa",
                                                "text": "Ich bitte Sie inständig, keine voreiligen Schlüsse zu ziehen!"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ad543294-4b39-4066-9dc5-5b7dc025b446",
                        "source_entry_id": "ee4615d5-ae19-3d5c-8a21-13b158dd58b9",
                        "source_sense_id": "ed94aaa0-4a19-3f6f-9085-eb022647a973",
                        "source_sense_description": "in a premature manner",
                        "target_lang_word": "vorschnell",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vorschnell",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "195137ff-f5ec-30fa-b53c-e97428249254",
                                        "entry_id": "58bca82e-4f32-362c-a56f-825433defc3c",
                                        "glosses": [
                                            "zu schnell, zu früh, da unbedacht und unüberlegt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c2c2866-341a-4ff2-afc9-cffc43932b9c",
                                                "sense_id": "195137ff-f5ec-30fa-b53c-e97428249254",
                                                "text": "„Und so ist die Unterhaltung in den Orchesterpausen oft recht aufschlußreich; hier kreuzen und befruchten einander die Meinungen des reiferen Alters, das die Herrlichkeiten der Klassiker auszuschöpfen und voll nachzuerleben weiß, mit dem oft vorschnellen Urteil der talentierten, in Sturm und Drang endlich mal Neues witternden Jugend, der Standpunkt des Erfahrenen, der mit dem weiteren Horizont die Modernen aus höherer Perspektive betrachtet, mit dem des klassisch geschulten und gegen ungewohnte Härten empfindlichen Jungen, der glaubt, ablehnen zu müssen, wo der abgeklärte Kollege zumindest duldsam lächelt.“"
                                            },
                                            {
                                                "example_id": "85391d57-f590-4fc2-915c-2b26bb7cc04b",
                                                "sense_id": "195137ff-f5ec-30fa-b53c-e97428249254",
                                                "text": "„Auch wird niemand, der sachlich urteilt, behaupten wollen, die Zeiten der Demokratie seien aus irgendwelchen mythischen Gründen vorüber. Die Kraft, die heute in der Welt gerade, von den demokratischen Staaten ausstrahle zeigt, daß ein solcher Schluß vorschnell und ungerechtfertigt ist.“"
                                            },
                                            {
                                                "example_id": "7c9773ec-5903-4ac3-bba8-cc5b0776f291",
                                                "sense_id": "195137ff-f5ec-30fa-b53c-e97428249254",
                                                "text": "„Egal, wie einmalig die Gelegenheit erscheinen mag: Kapitalanleger sollten sich auf keinen Fall unter Druck setzen lassen und vorschnell Kaufentscheidungen treffen, bei denen es um viel Geld geht.“"
                                            },
                                            {
                                                "example_id": "0b2b4edc-bc22-4f24-a5d1-68cc385c67c2",
                                                "sense_id": "195137ff-f5ec-30fa-b53c-e97428249254",
                                                "text": "„Die Bahn hat vorschnell die Sanierung als großen Erfolg dargestellt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bf7e0a4d-d49a-4796-89b9-465d55ea6879",
                        "source_entry_id": "ee4615d5-ae19-3d5c-8a21-13b158dd58b9",
