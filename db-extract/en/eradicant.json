                        "entry_id": "dc9d111a-e653-3b04-8e42-324eb65a3b51",
                        "glosses": [
                            "A substance that serves to eradicate an infestation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d5494cd-44fd-490c-acb8-ba7604650ace",
                                "sense_id": "d3765a5f-8122-3a4f-86c4-9c03c6b64836",
                                "text": "If inclement weather delays a scheduled protectant spray, apply an eradicant when conditions permit but within the kickback period."
                            },
                            {
                                "example_id": "81bde6ec-17d0-4e5a-822f-7cfb665786aa",
                                "sense_id": "d3765a5f-8122-3a4f-86c4-9c03c6b64836",
                                "text": "Some eradicants act by blocking spore production and reducing the potential of established infections to serve as sources of secondary inoculum for new infections."
                            },
                            {
                                "example_id": "a725acf1-5923-48d0-a44b-42258dcbdaf0",
                                "sense_id": "d3765a5f-8122-3a4f-86c4-9c03c6b64836",
                                "text": "Usually, these eradicants exhibit a wide range of control over many organisms, and are detrimental to the crop as well."
                            }
                        ]
                    }
                ],
