                        "examples": [
                            {
                                "example_id": "f83c896c-e254-4ac1-809d-cb1494d342a6",
                                "sense_id": "f0bb1543-24d0-3636-9afd-94399f0cb6ab",
                                "text": "All the golfers shown played in the N.Z. Annual \"wingies\" and \"limbies\" tournament, total number of competitors, 40."
                            },
                            {
                                "example_id": "92949e66-4fcd-4c41-8252-b6c9f7c5af24",
                                "sense_id": "f0bb1543-24d0-3636-9afd-94399f0cb6ab",
                                "text": "In May 1918, work by New Zealand 'limbies' shown in London at the Allied Conference on After Care of Disabled Soldiers was 'reported to be the best and most practical display in the whole exhibition."
                            },
                            {
                                "example_id": "4c729e1b-b37d-498e-98fa-8c6dcdc9f98d",
                                "sense_id": "f0bb1543-24d0-3636-9afd-94399f0cb6ab",
                                "text": "Although there were three storeys, the 'limbies' like Hutton occupied the ground floor, 'so that there is no trouble climbing stairs'."
                            }
                        ]
