                    },
                    {
                        "sense_id": "fe1d3fe8-859d-3742-8962-732e2a00aad4",
                        "entry_id": "63a8898e-d090-303f-b098-f16a6c24ef4d",
                        "glosses": [
                            "A long time."
                        ],
                        "tags": [
                            "excessive"
                        ],
                        "examples": [
                            {
                                "example_id": "47d7ba18-81ce-4239-82ce-fd49b122da6b",
                                "sense_id": "fe1d3fe8-859d-3742-8962-732e2a00aad4",
                                "text": "It'll be ages until/before we meet again."
                            },
                            {
                                "example_id": "1ba5ba07-63e4-4cd0-be9b-8bfe6076a84b",
                                "sense_id": "fe1d3fe8-859d-3742-8962-732e2a00aad4",
                                "text": "Does the Station go on still? That was ages and ages ago. It must be crumbling to pieces. All except the Amirtollah kutcha road. I don't believe that could crumble till the Day of Judgment."
                            },
                            {
                                "example_id": "cee62882-a6bd-4a41-85f6-50c5373a4e62",
                                "sense_id": "fe1d3fe8-859d-3742-8962-732e2a00aad4",
                                "text": "“He's been gone ages,” she said, and she went with little light steps to the door, opened it, and crossed the passage into his room."
                            },
                            {
                                "example_id": "562e9be2-61d0-4798-a201-bbbd2799bc44",
                                "sense_id": "fe1d3fe8-859d-3742-8962-732e2a00aad4",
                                "text": "Judith, aged 58, described her experience of seeking help for persistent back pain: \"You don't actually see the consultant. You wait for ages and ages and ages and you come out feeling totally baffled really.\""
                            }
                        ]
                    }
                ],
