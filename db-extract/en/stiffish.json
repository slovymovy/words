                            {
                                "example_id": "0b4a1974-8cdf-4a4a-b645-a9f9e808c572",
                                "sense_id": "e0b33e1b-765d-3502-a8b0-a2323fc6647c",
                                "text": "Ahead of us to-night is a stiffish incline and it looks as though there might be pressure behind it."
                            },
                            {
                                "example_id": "757e2b92-99a7-4889-9eb2-25e797f51b4f",
                                "sense_id": "e0b33e1b-765d-3502-a8b0-a2323fc6647c",
                                "text": "Beyond the latter station—reached after traversing the only level mile of track between East Suffolk Junction and Beccles—a stiffish climb leads across heathland to Wickham Market Station, which is actually at Campsea Ashe, 1½ miles from the town of Wickham Market."
                            },
                            {
                                "example_id": "50617e88-820f-4e38-857e-4d3b108e2366",
                                "sense_id": "e0b33e1b-765d-3502-a8b0-a2323fc6647c",
                                "text": "Even the shabbiest of shore-boats, hired for the shortest time, exacts a stiffish fare."
                            },
                            {
                                "example_id": "a4c35063-5fab-48d1-897b-a1922f1c4eb8",
                                "sense_id": "e0b33e1b-765d-3502-a8b0-a2323fc6647c",
                                "text": "Th' main sewer will have to be brought clean across i' this direction, an' it'll be a stiffish job."
                            }
                        ]
                    }
