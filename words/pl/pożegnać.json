    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "44a79b9f-1cbf-3f2d-99ea-b29ecc6e7371",
                    "sense_definition": "powiedzieć komuś do widzenia przy rozstaniu",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "pożegnanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Muszę już iść, żeby <w>pożegnać</w> się z gośćmi przed ich wyjazdem.",
                            "target_lang_translations": {
                                "ru": "Мне пора идти, чтобы <w>попрощаться</w> с гостями перед их отъездом."
                            }
                        },
                        {
                            "text": "Przyszliśmy na dworzec, aby <w>pożegnać</w> przyjaciela wyjeżdżającego w daleką podróż.",
                            "target_lang_translations": {
                                "ru": "Мы пришли на вокзал, чтобы <w>проститься</w> с другом, уезжающим в дальнее путешествие."
                            }
                        }
                    ],
                    "synonyms": [
                        "odprowadzić"
                    ],
                    "antonyms": [
                        "przywitać"
                    ],
                    "common_phrases": [
                        "pożegnać się"
                    ],
                    "target_lang_definitions": {
                        "ru": "сказать кому-либо «до свидания» при расставании"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "попрощаться",
                                "target_lang_sense_clarification": "обменяться словами или жестами при расставании"
                            },
                            {
                                "target_lang_word": "проститься",
                                "target_lang_sense_clarification": "формальный или эмоциональный вариант расставания"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "abe0263b-345d-34a2-b2ee-d6f842f46a52",
                    "sense_definition": "zakończyć współpracę z kimś lub z czymś, często w sposób definitywny",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "pożegnanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zarząd zdecydował się <w>pożegnać</w> trenera po serii słabych wyników drużyny.",
                            "target_lang_translations": {
                                "ru": "Руководство решило <w>расстаться</w> с тренером после серии слабых результатов команды."
                            }
                        },
                        {
                            "text": "Firma musiała <w>pożegnać</w> wielu pracowników z powodu kryzysu finansowego.",
                            "target_lang_translations": {
                                "ru": "Компания была вынуждена <w>уволить</w> многих сотрудников из-за финансового кризиса."
                            }
                        }
                    ],
                    "synonyms": [
                        "zwolnić",
                        "odprawić"
                    ],
                    "antonyms": [
                        "zatrudnić"
                    ],
                    "common_phrases": [
                        "pożegnać pracownika"
                    ],
                    "target_lang_definitions": {
                        "ru": "прекратить сотрудничество или отношения с кем-либо, часто окончательно"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "расстаться",
                                "target_lang_sense_clarification": "прекратить рабочие или личные отношения"
                            },
                            {
                                "target_lang_word": "уволить",
                                "target_lang_sense_clarification": "в контексте прекращения трудовых отношений"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "39927564-5dd8-3a15-b4a4-dcc90067515a",
                    "sense_definition": "stracić nadzieję na coś lub pogodzić się z utratą czegoś",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "pożegnanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Po tej porażce musieliśmy <w>pożegnać</w> się z marzeniami o mistrzostwie kraju.",
                            "target_lang_translations": {
                                "ru": "После этого поражения нам пришлось <w>расстаться</w> с мечтами о чемпионстве страны."
                            }
                        },
                        {
                            "text": "Musisz <w>pożegnać</w> się z myślą o szybkim awansie w tej firmie.",
                            "target_lang_translations": {
                                "ru": "Ты должен <w>расстаться</w> с мыслью о быстром повышении в этой компании."
                            }
                        }
                    ],
                    "synonyms": [
                        "pogodzić się",
                        "zrezygnować"
                    ],
                    "common_phrases": [
                        "pożegnać się z marzeniami"
                    ],
                    "target_lang_definitions": {
                        "ru": "потерять надежду на что-либо или смириться с утратой чего-то"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "расстаться с мыслью",
                                "target_lang_sense_clarification": "перестать надеяться на что-то"
                            },
                            {
                                "target_lang_word": "проститься с мечтами",
                                "target_lang_sense_clarification": "смириться с невозможностью осуществления желаемого"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "112054cd-5f9d-39c1-92f4-dd362698c4b1",
                    "sense_definition": "aspekt dokonany od czasownika <w>żegnać</w>",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "pożegnanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mieszkańcy zebrali się na rynku, by <w>pożegnać</w> stary rok huczną zabawą.",
                            "target_lang_translations": {
                                "ru": "Жители собрались на площади, чтобы <w>проститься</w> со старым годом шумным праздником."
                            }
                        },
                        {
                            "text": "Wszyscy zebrani chcieli <w>pożegnać</w> odchodzącego na emeryturę dyrektora.",
                            "target_lang_translations": {
                                "ru": "Все собравшиеся хотели <w>попрощаться</w> с уходящим на пенсию директором."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "aspekt dokonany"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "совершенный вид глагола «прощаться»"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "попрощаться",
                                "target_lang_sense_clarification": "совершить действие прощания"
                            },
                            {
                                "target_lang_word": "проститься",
                                "target_lang_sense_clarification": "совершить действие прощания (часто в торжественной или окончательной обстановке)"
                            }
                        ]
                    }
                }
            ]
        }
    ]
