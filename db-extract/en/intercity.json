    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "892d4251-ed4c-3aae-83a5-665c8eb3d956",
                "word": "intercity",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "d9f47768-576f-33c9-bfa2-8146f705c925",
                        "entry_id": "892d4251-ed4c-3aae-83a5-665c8eb3d956",
                        "glosses": [
                            "Between cities; connecting cities with other cities."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "d2d9d0d6-efa2-44f6-b583-b99b32952332",
                                "sense_id": "d9f47768-576f-33c9-bfa2-8146f705c925",
                                "text": "I plan to catch an intercity train, or bus."
                            },
                            {
                                "example_id": "fdfb03a7-aa12-4b85-9dec-b771203398f6",
                                "sense_id": "d9f47768-576f-33c9-bfa2-8146f705c925",
                                "text": "A “moving platform” scheme […] is more technologically ambitious than maglev trains even though it relies on conventional rails. Local trains would use side-by-side rails to roll alongside intercity trains and allow passengers to switch trains by stepping through docking bays."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2188503a-8f42-4992-8af8-90c320a05824",
                        "source_entry_id": "892d4251-ed4c-3aae-83a5-665c8eb3d956",
                        "source_sense_id": "d9f47768-576f-33c9-bfa2-8146f705c925",
                        "source_sense_description": "between cities",
                        "target_lang_word": "meziměstský",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "ff479600-cf68-4da6-b731-36fc98d82202",
                        "source_entry_id": "892d4251-ed4c-3aae-83a5-665c8eb3d956",
                        "source_sense_id": "d9f47768-576f-33c9-bfa2-8146f705c925",
