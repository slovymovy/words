                    {
                        "sense_id": "b3b74847-962a-3218-8ba2-e57feda59464",
                        "entry_id": "d9bb6cf7-befa-3ad5-979c-6c4879e79550",
                        "glosses": [
                            "hoeveelheid geld waarmee men financiële tegenvallers kan opvangen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a5e8c8c4-cb48-433e-a2a3-3b8dbfd15024",
                                "sense_id": "b3b74847-962a-3218-8ba2-e57feda59464",
                                "text": "In de stroppenpot van het rijk zit 200 miljoen euro. Dat is een eenmalig beschikbaar gesteld bedrag, waaruit gemeenten kunnen putten om grote tekorten voor jeugdhulp en wmo kunnen opvangen."
                            },
                            {
                                "example_id": "0ee118db-4acd-4e51-8cfd-2c4df79ce03d",
                                "sense_id": "b3b74847-962a-3218-8ba2-e57feda59464",
                                "text": "Sinds een aantal jaren zijn gemeenten voor jeugdzorg en andere zorgtaken. Die werden overgeheveld vanuit het Rijk, maar de vergoeding die daar tegenover stond bleek lang niet voor alle gemeenten voldoende. Daarom spraken het rijk en de gemeenten af dat er een zogenaamde stroppenpot zou komen voor gemeenten die er echt zwaar bij in schoten."
                            }
                        ]
                    }
                ],
