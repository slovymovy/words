                "senses": [
                    {
                        "sense_id": "0eecd1db-1ef7-3eba-b2bf-3693657f5fd9",
                        "entry_id": "96c1f72e-030d-315e-8d94-c8bcba68e05b",
                        "glosses": [
                            "Faire perdre son caractère bleuté à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be343dca-cdc6-43c3-96aa-3c59752c6c8f",
                                "sense_id": "0eecd1db-1ef7-3eba-b2bf-3693657f5fd9",
                                "text": "Peu après, ma mère nous a annoncé que sa coiffeuse était d’accord pour essayer de recolorer mes mèches et de « débleuter » le noir de Léa."
                            },
                            {
                                "example_id": "36e2afc7-20e3-406e-ad28-b0879db7c3e4",
                                "sense_id": "0eecd1db-1ef7-3eba-b2bf-3693657f5fd9",
                                "text": "un ciel impondérable qui ne s’obscurcissait pas encore, mais semblait pâlir, se débleuter, tandis que s’allumaient, avec parcimonie, de toutes petites étoiles, infiniment lointaines."
                            }
                        ]
                    }
