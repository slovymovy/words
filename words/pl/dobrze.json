                },
                {
                    "sense_id": "92d07805-23da-3307-807e-5fa8f1c2f18d",
                    "sense_definition": "W sposób przyjemny, miły, wywołujący zadowolenie; odnosi się także do dobrego samopoczucia lub zdrowia.",
