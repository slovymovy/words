                                "target_senses": [
                                    {
                                        "sense_id": "b250f7c6-9267-35a3-8723-61f2cdeec14a",
                                        "entry_id": "ecc90b5a-a8b7-32a4-92b0-88dc9f646f34",
                                        "glosses": [
                                            "A carriage drawn by four horses controlled by one driver."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d86e490-41ca-4fd9-9480-2fae85afa10e",
                                                "sense_id": "b250f7c6-9267-35a3-8723-61f2cdeec14a",
                                                "text": "‘I must see him!’ he exclaimed; but at that moment the Duke of Berwick's four-in-hand came between, and when it had left the space clear, the carriage had swept out of the Park."
                                            },
                                            {
                                                "example_id": "1e5a0f8c-af9d-4478-b923-a424c944a6ac",
                                                "sense_id": "b250f7c6-9267-35a3-8723-61f2cdeec14a",
                                                "text": "Judge Short had gone to town, and Farrar was off for a three days' cruise up the lake. I was bitterly regretting I had not gone with him when the distant notes of a coach horn reached my ear, and I descried a four-in-hand winding its way up the inn road from the direction of Mohair."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "080e4090-8a95-3513-bb35-01f6784f71a0",
                                        "entry_id": "ecc90b5a-a8b7-32a4-92b0-88dc9f646f34",
                                        "glosses": [
                                            "A slip knot with one end hanging in front of the other; a simple necktie."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f6fcba71-b089-40e4-8f2f-4ca8d230ed3b",
                                                "sense_id": "080e4090-8a95-3513-bb35-01f6784f71a0",
                                                "text": "He wore a black frock coat and light trousers, his cravat a gray four-in-hand."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
