                        "entry_id": "0e0113ca-7b43-3e2f-8986-b440928781be",
                        "glosses": [
                            "baal waarin men suiker in grotere hoeveelheden vervoert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0341143-24b7-4709-a47e-8e3394e4e3b0",
                                "sense_id": "57d07bf2-0968-3721-9396-56f953291eb2",
                                "text": "Het schip Chong Chon Gang werd in juli gecontroleerd bij het binnenvaren van het Panamakanaal. De vracht bleek te bestaan uit zwaar wapentuig uit Cuba, dat was verstopt onder een vracht suikerzakken."
                            }
