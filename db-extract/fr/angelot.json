                    },
                    {
                        "translation_id": "1fda6ff6-7c93-46cf-bc02-bcfd8f6d1dac",
                        "source_entry_id": "4b1e80f2-54e6-3b96-be4e-2f7760c993f4",
                        "source_sense_description": "Figurine d’ange",
                        "target_lang_word": "querubín",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "querubín",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "c98dcffb-eb19-3206-815d-3c83b360c216",
                                        "entry_id": "e5fc5a2c-b69a-37fc-bd38-7123bcd70cde",
                                        "glosses": [
                                            "En teología cristiana, tipo de ángel que ocupa el segundo coro en la jerarquía celeste."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24b07b8d-05ae-4bff-9362-5db3bf27b50a",
                                                "sense_id": "c98dcffb-eb19-3206-815d-3c83b360c216",
                                                "text": "¡El Paraíso Terrenal, Ana María! Tu vida entera no fue sino la búsqueda ansiosa de ese jardín ya irremisiblemente vedado al hombre por el querubín de la espada de fuego."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "921ec57f-e48f-4550-a7ff-8c915eebca64",
