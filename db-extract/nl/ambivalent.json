                "senses": [
                    {
                        "sense_id": "05db1e68-6d98-375c-8806-a3f8fc8e6826",
                        "entry_id": "c96e1d44-7642-3258-9c19-df63cc99ef6f",
                        "glosses": [
                            "op hetzelfde moment twee verschillende, vaak tegengestelde, gevoelens hebbend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cdc9ff8f-cb10-4d69-9de0-7163191e528b",
                                "sense_id": "05db1e68-6d98-375c-8806-a3f8fc8e6826",
                                "text": "Het dier vertoont ambivalent gedrag."
                            },
                            {
                                "example_id": "08aceceb-7bac-4e8c-8b39-36b8d73bb242",
                                "sense_id": "05db1e68-6d98-375c-8806-a3f8fc8e6826",
                                "text": "Zij had ambivalente gevoelens bij haar nieuwe vriendje."
                            },
                            {
                                "example_id": "328dcbb0-b90d-426e-af25-cdeb246a7f6f",
                                "sense_id": "05db1e68-6d98-375c-8806-a3f8fc8e6826",
                                "text": "Ambivalentie Om het met het lievelingswoord van de radelozen te zeggen: Mia's verhouding tot Kramer is ambivalent."
                            },
                            {
                                "example_id": "9be6bec1-f001-4081-9e5e-10a4455164da",
                                "sense_id": "05db1e68-6d98-375c-8806-a3f8fc8e6826",
                                "text": "Meestal hadden we ambivalente, min of meer misselijkmakende gesprekken over dat we hoopten dat we geen afschuwelijke vergissing hadden begaan."
                            },
                            {
                                "example_id": "2142b171-4b80-465c-9bfa-e69396d64edd",
                                "sense_id": "05db1e68-6d98-375c-8806-a3f8fc8e6826",
                                "text": "In zijn boek The Location of Culture (1994) bespreekt Bhabha het intrinsiek ambivalente karakter van de postkoloniale ervaring."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ce1c122e-4b69-4afe-9162-1e6dd2d3caf3",
                        "source_entry_id": "c96e1d44-7642-3258-9c19-df63cc99ef6f",
                        "source_sense_id": "05db1e68-6d98-375c-8806-a3f8fc8e6826",
                        "source_sense_description": "op hetzelfde moment twee verschillende, meestal positieve en negatieve, waardes hebbend",
                        "target_lang_word": "ambivalent",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ambivalent",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "36411d0c-342c-3462-bc7e-b97eb7ed5d21",
                                        "entry_id": "eb3bc788-bba3-3075-991f-e7e43a1c75d5",
                                        "glosses": [
                                            "doppelwertig"
                                        ],
                                        "tags": [
                                            "keine Steigerung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "45fa8f22-bcb9-4e09-afee-4a9034c7c3f5",
                                                "sense_id": "36411d0c-342c-3462-bc7e-b97eb7ed5d21",
                                                "text": "Seine Gefühle ihr gegenüber sind ambivalent, sowohl positiv als auch negativ."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b2798712-710b-3c01-85c6-18f75d08b310",
                                        "entry_id": "eb3bc788-bba3-3075-991f-e7e43a1c75d5",
                                        "glosses": [
                                            "widersprüchlich, zwiespältig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "141d56cd-1135-4a7a-922c-4958768f1427",
                                                "sense_id": "b2798712-710b-3c01-85c6-18f75d08b310",
                                                "text": "„Kehrer ist wohl eine der ambivalentesten Figuren der damaligen Zeit.“"
                                            },
                                            {
                                                "example_id": "c47d0d72-eb92-4a1a-970e-8ced020752fa",
                                                "sense_id": "b2798712-710b-3c01-85c6-18f75d08b310",
                                                "text": "„Nicht, wer die Menschheit, wer die Partei oder sonst eine Abstraktion, nicht, wer allein die Madonna oder ein anderes Numinosum liebt, ist kultiviert, sondern wer erst einmal einen Menschen lieben kann, durch alle Spannungen ambivalenter Erlebnisse hindurch, die er mit ihm haben wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3fc5e6d9-d0b3-416f-9ce9-8d7e2c172720",
                        "source_entry_id": "c96e1d44-7642-3258-9c19-df63cc99ef6f",
                        "source_sense_id": "05db1e68-6d98-375c-8806-a3f8fc8e6826",
                        "source_sense_description": "op hetzelfde moment twee verschillende, meestal positieve en negatieve, waardes hebbend",
                        "target_lang_word": "ambivalent",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ambivalent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "634ff416-77b7-3e55-a58f-7a2e0e46f107",
                                        "entry_id": "afadba3b-b0f5-376e-89ae-1dc5bbe7eb65",
                                        "glosses": [
                                            "Simultaneously experiencing or expressing opposing or contradictory feelings, beliefs, motivations, or meanings."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1ab8a23-d3ab-4ee1-992d-1882e1d367fd",
                                                "sense_id": "634ff416-77b7-3e55-a58f-7a2e0e46f107",
                                                "text": "In modern burlesque [...] sexual and erotic stimuli are often present in concealed and ambivalent doubles entendres."
                                            },
                                            {
                                                "example_id": "d643c973-569b-48ea-9f7d-8067bbe3b818",
                                                "sense_id": "634ff416-77b7-3e55-a58f-7a2e0e46f107",
                                                "text": "The great sociologist Zygmunt Bauman argued that philo-Semitism and anti-Semitism both fall under “allosemitism”: literally Othering the Jew. He defined it not as resentment of what is different, which is xenophobia, but rather of what defies order and clear categories. In 1997, he wrote, “The Jew is ambivalence incarnate. And ambivalence is ambivalence mostly because it cannot be contemplated without ambivalent feeling: it is simultaneously attractive and repelling.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "97cf73ae-fb84-39e6-b8f2-4b988ce5d542",
                                        "entry_id": "afadba3b-b0f5-376e-89ae-1dc5bbe7eb65",
                                        "glosses": [
                                            "Alternately being or having one opinion or feeling, and then the opposite."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "daf3ffb1-7011-4f79-a892-9db158895425",
                                                "sense_id": "97cf73ae-fb84-39e6-b8f2-4b988ce5d542",
                                                "text": "His feelings toward his parents are ambivalent."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fb02dc8f-13ef-456c-b688-d13d27d91448",
                        "source_entry_id": "c96e1d44-7642-3258-9c19-df63cc99ef6f",
                        "source_sense_id": "05db1e68-6d98-375c-8806-a3f8fc8e6826",
                        "source_sense_description": "op hetzelfde moment twee verschillende, meestal positieve en negatieve, waardes hebbend",
                        "target_lang_word": "ambivalent",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ambivalent",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8ab9fa85-73cd-3254-a2f7-52f1a59ee3b7",
                                        "entry_id": "c1511bcc-9b14-3707-956e-30a116941664",
                                        "glosses": [
                                            "Qui est doué d’ambivalence."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ff4e4c20-83a4-3d34-b03f-ae45ef048ed2",
                                        "entry_id": "c1511bcc-9b14-3707-956e-30a116941664",
                                        "glosses": [
                                            "Qui a plusieurs valeurs, plusieurs propriétés, plusieurs comportements différents, contradictoires, voire opposés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a760806-92c6-431d-a0ff-821b9808ce95",
                                                "sense_id": "ff4e4c20-83a4-3d34-b03f-ae45ef048ed2",
                                                "text": "Étant donné la nature ambivalente du Corps des carabiniers du Chili (force de police et force constituant virtuellement une quatrième Arme), c'est par un double canal que se sont développées ses relations avec les États-Unis."
                                            },
                                            {
                                                "example_id": "af2f508a-3cf5-47b4-a569-e1d790d25af7",
                                                "sense_id": "ff4e4c20-83a4-3d34-b03f-ae45ef048ed2",
                                                "text": "Les années quatre-vingt ont consacré l’enfant-roi mais aussi travaillé en profondeur les mentalités vers toujours plus d’individualisme, cet état ambivalent de l’autonomie et de l’hypersolitude."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
