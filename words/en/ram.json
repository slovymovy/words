{
    "word_family": [
        "rammer",
        "ramrod"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a45963c7-8483-36ed-a1d2-909790084ec7",
                    "sense_definition": "A male sheep, typically uncastrated.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "animal_sheep",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmer kept the <w>ram</w> in a separate field from the ewes during the winter.",
                            "target_lang_translations": {
                                "ru": "Фермер держал <w>барана</w> на отдельном поле от овец зимой.",
                                "zh": "冬天，农夫把<w>公羊</w>和母羊分在不同的田里饲养。"
                            }
                        },
                        {
                            "text": "We saw a large <w>ram</w> with curved horns grazing on the hillside.",
                            "target_lang_translations": {
                                "ru": "Мы увидели большого <w>барана</w> с изогнутыми рогами, пасущегося на склоне холма.",
                                "zh": "我们看到一只长着弯角的巨大<w>公羊</w>在山坡上吃草。"
                            }
                        }
                    ],
                    "antonyms": [
                        "ewe"
                    ],
                    "target_lang_definitions": {
                        "ru": "Самец овцы, обычно некастрированный.",
                        "zh": "公羊，通常指未阉割的雄性绵羊。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "баран",
                                "target_lang_sense_clarification": "животное"
                            },
                            {
                                "target_lang_word": "овен",
                                "target_lang_sense_clarification": "устар., книжн."
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "公羊",
                                "target_lang_sense_clarification": "雄性绵羊"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "94f3d477-49e3-3f89-8013-898327f5e4f7",
                    "sense_definition": "Acronym of random-access memory; computer memory used for temporary data storage.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "computing_memory",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My laptop is running slowly because it does not have enough <w>RAM</w>.",
                            "target_lang_translations": {
                                "ru": "Мой ноутбук работает медленно, потому что в нем недостаточно <w>оперативной памяти</w>.",
                                "zh": "我的笔记本电脑运行缓慢，因为<w>内存</w>不足。"
                            }
                        },
                        {
                            "text": "You should check if the new software is compatible with your computer's <w>RAM</w>.",
                            "target_lang_translations": {
                                "ru": "Тебе следует проверить, совместимо ли новое программное обеспечение с <w>оперативной памятью</w> твоего компьютера.",
                                "zh": "你应该检查一下新软件是否与你电脑的<w>内存</w>兼容。"
                            }
                        }
                    ],
                    "synonyms": [
                        "memory"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "acronym"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Оперативная память компьютера, используемая для временного хранения данных.",
                        "zh": "随机存取存储器，即计算机用于临时存储数据的内存。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оперативная память",
                                "target_lang_sense_clarification": "компьютерный термин"
                            },
                            {
                                "target_lang_word": "ОЗУ",
                                "target_lang_sense_clarification": "аббревиатура"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "内存",
                                "target_lang_sense_clarification": "计算机存储器"
                            },
                            {
                                "target_lang_word": "随机存取存储器",
                                "target_lang_sense_clarification": "全称"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "641fac87-4d41-3fa1-b15a-de6176e9447f",
                    "sense_definition": "A heavy object, such as a log or beam, used for breaking through doors or walls.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "force_impact",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police used a battering <w>ram</w> to force open the reinforced door.",
                            "target_lang_translations": {
                                "ru": "Полиция использовала <w>таран</w>, чтобы взломать укрепленную дверь.",
                                "zh": "警察用<w>撞门槌</w>强行打开了加固的门。"
                            }
                        },
                        {
                            "text": "In medieval times, soldiers would swing a massive <w>ram</w> against the castle gates.",
                            "target_lang_translations": {
                                "ru": "В средние века солдаты раскачивали массивный <w>таран</w>, ударяя им в ворота замка.",
                                "zh": "中世纪时，士兵们会挥动巨大的<w>攻城槌</w>撞击城堡大门。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "battering ram"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тяжелое орудие (бревно или балка) для разрушения дверей или стен.",
                        "zh": "用于撞击并破坏门或墙壁的重型物体，如圆木或横梁。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "таран",
                                "target_lang_sense_clarification": "осадное орудие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "攻城槌",
                                "target_lang_sense_clarification": "古代攻城武器"
                            },
                            {
                                "target_lang_word": "撞门槌",
                                "target_lang_sense_clarification": "现代破门工具"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f14a7b89-a1e4-3990-93c2-9a4779c24a57",
                    "sense_definition": "A piston powered by hydraulic pressure used in machines.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mechanics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hydraulic <w>ram</w> lifted the heavy container with ease.",
                            "target_lang_translations": {
                                "ru": "Гидравлический <w>плунжер</w> с легкостью поднял тяжелый контейнер.",
                                "zh": "液压<w>柱塞</w>轻松地举起了沉重的集装箱。"
                            }
                        },
                        {
                            "text": "Engineers inspected the <w>ram</w> for any leaks in the hydraulic system.",
                            "target_lang_translations": {
                                "ru": "Инженеры осмотрели <w>плунжер</w> на предмет утечек в гидравлической системе.",
                                "zh": "工程师检查了<w>液压缸</w>，看液压系统是否有泄漏。"
                            }
                        }
                    ],
                    "synonyms": [
                        "piston"
                    ],
                    "common_phrases": [
                        "hydraulic ram"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Поршень, приводимый в движение гидравлическим давлением в механизмах.",
                        "zh": "机械中利用液压驱动的活塞装置。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "плунжер",
                                "target_lang_sense_clarification": "технический термин"
                            },
                            {
                                "target_lang_word": "поршень",
                                "target_lang_sense_clarification": "деталь механизма"
                            },
                            {
                                "target_lang_word": "гидроцилиндр",
                                "target_lang_sense_clarification": "устройство"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "液压缸",
                                "target_lang_sense_clarification": "机械装置"
                            },
                            {
                                "target_lang_word": "柱塞",
                                "target_lang_sense_clarification": "活塞部件"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b510454e-f52c-3835-a88f-be6d11737646",
                    "sense_definition": "To crash or collide violently with an object.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "force_impact",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The driver lost control on the ice and <w>rammed</w> into a parked car.",
                            "target_lang_translations": {
                                "ru": "Водитель потерял управление на льду и <w>врезался</w> в припаркованный автомобиль.",
                                "zh": "司机在冰面上失去控制，<w>撞</w>上了一辆停着的车。"
                            }
                        },
                        {
                            "text": "Ships were designed to <w>ram</w> enemy vessels during the ancient naval battle.",
                            "target_lang_translations": {
                                "ru": "Корабли были спроектированы так, чтобы <w>таранить</w> вражеские суда во время древних морских сражений.",
                                "zh": "古代海战中，战舰被设计用来<w>冲撞</w>敌船。"
                            }
                        }
                    ],
                    "synonyms": [
                        "crash",
                        "collide",
                        "smash",
                        "hit"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сильно ударять или врезаться во что-либо.",
                        "zh": "猛烈地撞击或碰撞某物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "таранить",
                                "target_lang_sense_clarification": "наносить удар корпусом"
                            },
                            {
                                "target_lang_word": "врезаться",
                                "target_lang_sense_clarification": "сталкиваться"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "撞击",
                                "target_lang_sense_clarification": "猛烈碰撞"
                            },
                            {
                                "target_lang_word": "冲撞",
                                "target_lang_sense_clarification": "船只或车辆碰撞"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f1a2624b-7f8a-3ead-8564-918a55b008d5",
                    "sense_definition": "To force something into a small space or to force a proposal through a process roughly.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "force_impact",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He tried to <w>ram</w> all his clothes into the small suitcase before the flight.",
                            "target_lang_translations": {
                                "ru": "Он пытался <w>запихнуть</w> всю свою одежду в маленький чемодан перед полетом.",
                                "zh": "飞行前，他试图把所有的衣服都<w>塞进</w>那个小行李箱里。"
                            }
                        },
                        {
                            "text": "The committee attempted to <w>ram</w> the new policy through without proper debate.",
                            "target_lang_translations": {
                                "ru": "Комитет пытался <w>протолкнуть</w> новую политику без надлежащих дебатов.",
                                "zh": "委员会试图在没有充分辩论的情况下<w>强行通过</w>这项新政策。"
                            }
                        }
                    ],
                    "synonyms": [
                        "force",
                        "cram",
                        "thrust",
                        "stuff"
                    ],
                    "common_phrases": [
                        "ram down someone's throat",
                        "ram home"
                    ],
                    "target_lang_definitions": {
                        "ru": "С силой вталкивать что-то в тесное пространство или навязывать решение.",
                        "zh": "强行将某物塞入狭小空间，或粗暴地强行推进某项提议。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "втискивать",
                                "target_lang_sense_clarification": "помещать с усилием"
                            },
                            {
                                "target_lang_word": "запихивать",
                                "target_lang_sense_clarification": "разг., грубо вкладывать"
                            },
                            {
                                "target_lang_word": "проталкивать",
                                "target_lang_sense_clarification": "перен., навязывать решение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "塞入",
                                "target_lang_sense_clarification": "强行放入"
                            },
                            {
                                "target_lang_word": "强行通过",
                                "target_lang_sense_clarification": "指政策或提议"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "b6eb193d-2f27-32ee-a276-6e7028dfb7bc",
                    "sense_definition": "The constellation Aries, often represented as a male sheep.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "animal_sheep",
                    "name_type": "astronomical_name",
                    "examples": [
                        {
                            "text": "In astrology, the <w>Ram</w> is considered the first sign of the zodiac.",
                            "target_lang_translations": {
                                "ru": "В астрологии <w>Овен</w> считается первым знаком зодиака.",
                                "zh": "在占星术中，<w>白羊座</w>被认为是黄道十二宫的第一个星座。"
                            }
                        },
                        {
                            "text": "You can see the <w>Ram</w> in the northern sky during late autumn and winter.",
                            "target_lang_translations": {
                                "ru": "Вы можете увидеть <w>Овна</w> в северной части неба поздней осенью и зимой.",
                                "zh": "在深秋和冬季，你可以在北方的天空中看到<w>白羊座</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "Aries"
                    ],
                    "target_lang_definitions": {
                        "ru": "Созвездие Овен, часто изображаемое в виде барана.",
                        "zh": "白羊座，黄道十二星座之一，常以公羊形象表示。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Овен",
                                "target_lang_sense_clarification": "знак зодиака"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "白羊座",
                                "target_lang_sense_clarification": "星座名称"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "0c938c57-f4f9-309a-a5d6-c730a70272ce",
                    "sense_definition": "Rancid; having an offensive smell or taste.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The butter had gone <w>ram</w> after being left out in the heat for days.",
                            "target_lang_translations": {
                                "ru": "Масло стало <w>прогорклым</w>, пролежав на жаре несколько дней.",
                                "zh": "黄油在高温下放了几天后已经<w>哈喇</w>了。"
                            }
                        },
                        {
                            "text": "A <w>ram</w> smell drifted from the old cellar when we opened the door.",
                            "target_lang_translations": {
                                "ru": "<w>Зловонный</w> запах доносился из старого подвала, когда мы открыли дверь.",
                                "zh": "当我们打开门时，一股<w>腐臭</w>味从旧地窖里飘了出来。"
                            }
                        }
                    ],
                    "synonyms": [
                        "rancid",
                        "fetid"
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "rare"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прогорклый; имеющий неприятный запах или вкус.",
                        "zh": "指油脂变质，有难闻的气味或味道。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прогорклый",
                                "target_lang_sense_clarification": "о вкусе/запахе жиров"
                            },
                            {
                                "target_lang_word": "зловонный",
                                "target_lang_sense_clarification": "неприятно пахнущий"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "哈喇的",
                                "target_lang_sense_clarification": "形容油脂变质"
                            },
                            {
                                "target_lang_word": "腐臭的",
                                "target_lang_sense_clarification": "形容难闻气味"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}