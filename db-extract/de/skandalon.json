                "senses": [
                    {
                        "sense_id": "b6ed64ca-17f6-3500-9b76-3f28f31d8fcc",
                        "entry_id": "4934d449-70cf-39ae-b656-e246f355cf9e",
                        "glosses": [
                            "etwas Anstößiges, Skandalträchtiges"
                        ],
                        "tags": [
                            "formal"
                        ],
                        "examples": [
                            {
                                "example_id": "4a402438-ebe7-4a7f-b05a-9dce73f2d1c2",
                                "sense_id": "b6ed64ca-17f6-3500-9b76-3f28f31d8fcc",
                                "text": "„Das moralische Skandalon ihres amoralischen Lebensstils ist längst konsensfähig geworden, vorausgesetzt, man verfügt über das nötige Kleingeld.“"
                            },
                            {
                                "example_id": "42bccbcd-37e7-4b52-a52c-806efcd9b5af",
                                "sense_id": "b6ed64ca-17f6-3500-9b76-3f28f31d8fcc",
                                "text": "„Bellizist, Militarist, Technokrat, Wegbereiter beziehungsweise Sympathisant des Nationalsozialismus, elitärer Ästhet – so lauten zusammengefasst die seit 1945 vorgetragenen Verdikte seiner Gegner über das Skandalon Jünger.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
