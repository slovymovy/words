                    },
                    {
                        "translation_id": "97c4a424-0730-4814-a26b-9aca73d1bbca",
                        "source_entry_id": "0348a63a-8dae-3511-add8-17571bd4750f",
                        "source_sense_id": "4b09f54f-b63d-321d-90f1-90ec58bb3e98",
                        "target_lang_word": "Großmut",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Großmut",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d0f5c81c-395f-3134-9352-dae8d77fe0ac",
                                        "entry_id": "c35a084e-712f-3825-83d9-32b161215754",
                                        "glosses": [
                                            "Eigenschaft einer Person, anderen etwas gönnen und leicht vergeben zu können"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd9acf9f-6d93-42e6-b977-0a0ae804d32a",
                                                "sense_id": "d0f5c81c-395f-3134-9352-dae8d77fe0ac",
                                                "text": "„Nathan der Weise wird vom Volk und von allen Menschen vor allem wegen seiner Güte und Großmut gelobt.“"
                                            },
                                            {
                                                "example_id": "f6e3d138-9dac-418b-a2fa-3e20d024ae94",
                                                "sense_id": "d0f5c81c-395f-3134-9352-dae8d77fe0ac",
                                                "text": "„Roms Widerstandskraft war nach Cannae durchaus nicht gebrochen. Dem Adressaten dieser Botschaft soll der [sic; richtig wäre: die] römische Großmut sowie die Solidarität der Römer in einer Notlage vorgeführt werden und im Gegensatz dazu die karthagische Kleinmütigkeit.“"
                                            },
                                            {
                                                "example_id": "72e42e2c-f6fa-4af2-92fb-3c1dccbb9ff4",
                                                "sense_id": "d0f5c81c-395f-3134-9352-dae8d77fe0ac",
                                                "text": "„Die Großmut kam ihm daher wie lindernder Balsam auf seine tödlich eiternde Wunde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "63c5ad32-a52e-4ecf-b38d-4a30f7ff1716",
                        "source_entry_id": "0348a63a-8dae-3511-add8-17571bd4750f",
                        "source_sense_id": "4b09f54f-b63d-321d-90f1-90ec58bb3e98",
                        "target_lang_word": "Edelmut",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Edelmut",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "23ef243f-fc29-3167-b09f-15e31eeb0bac",
                                        "entry_id": "c35fa14b-4d9c-3f8d-8ec5-c7ce39592ae0",
                                        "glosses": [
                                            "edle Gesinnung, die egoistische Motive hintenan stellt"
                                        ],
                                        "tags": [
                                            "gehoben"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d983599d-62fe-4b4d-88da-20d416f3ba47",
                                                "sense_id": "23ef243f-fc29-3167-b09f-15e31eeb0bac",
                                                "text": "Mit dieser Aktion hat er einmal mehr seinen Edelmut bewiesen."
                                            },
                                            {
                                                "example_id": "e4b5072f-b7d7-4e86-9b19-08bada82acb6",
                                                "sense_id": "23ef243f-fc29-3167-b09f-15e31eeb0bac",
                                                "text": "„»so gütig werden Sie nicht immer denken; es wird sich eine Stimme finden, die Sie von diesem Edelmut abzubringen suchen wird.« – »Sie irren, d'Artagnan, der Rat, Herrn d'Herblay nicht weiter zu verfolgen, rührt von Colbert selbst her.“"
                                            },
                                            {
                                                "example_id": "17e3a2ad-790b-4ba5-a988-e1d69b790710",
                                                "sense_id": "23ef243f-fc29-3167-b09f-15e31eeb0bac",
                                                "text": "„Der Edelmut, mit dem Napoleon in Moskau verfahren wollte, riss ihn selbst hin.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "338f2703-d3a2-4745-b67e-173ad69dc537",
                        "source_entry_id": "0348a63a-8dae-3511-add8-17571bd4750f",
                        "source_sense_id": "4b09f54f-b63d-321d-90f1-90ec58bb3e98",
                        "target_lang_word": "grootmoedigheid",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grootmoedigheid",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "7434e0dd-71f3-387a-b70a-309e54eae824",
                                        "entry_id": "7114cb4c-b6e9-36f4-8862-de223092a6fe",
                                        "glosses": [
                                            "op een krachtige manier heel gul zijn"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "337c8963-f84f-4396-ac6d-5988a999071a",
                                                "sense_id": "7434e0dd-71f3-387a-b70a-309e54eae824",
                                                "text": "De vicomte zei dat de hertog van Enghien het slachtoffer van zijn eigen grootmoedigheid was geworden, en dat er speciale redenen waren voor Bonapartes woede."
                                            },
                                            {
                                                "example_id": "a8d3dfa7-8d9a-4077-8d67-4a3cfa69455e",
                                                "sense_id": "7434e0dd-71f3-387a-b70a-309e54eae824",
                                                "text": "Van de ene op de andere dag besloot Merkel vluchtelingen uit Hongarije op te gaan halen en Syriërs kregen vrij toegang tot het land. Inmiddels zijn ruim een miljoen vluchtelingen Duitsland binnengekomen. Haar grootmoedigheid is anders dan velen van haar gewend zijn."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "57c46cdc-9494-3690-9b19-5d97bb0eda1e",
                                        "entry_id": "7114cb4c-b6e9-36f4-8862-de223092a6fe",
                                        "glosses": [
                                            "iets wat getuigt van grote gulheid"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
