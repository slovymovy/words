{
    "word_family": [
        "contradict",
        "contradictory",
        "contradictable"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3b32e89b-f168-3622-a4d8-e5bb396917d2",
                    "sense_definition": "A statement or situation where two things are said or happen that cannot both be true at the same time.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "logical inconsistency",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There is a clear <w>contradiction</w> in what you say because she cannot be both married and single.",
                            "target_lang_translations": {
                                "ru": "В ваших словах есть явное <w>противоречие</w>, так как она не может быть одновременно замужем и не замужем."
                            }
                        },
                        {
                            "text": "The witness's story was a direct <w>contradiction</w> of the evidence found at the crime scene.",
                            "target_lang_translations": {
                                "ru": "Рассказ свидетеля был прямым <w>противоречием</w> уликам, найденным на месте преступления."
                            }
                        }
                    ],
                    "synonyms": [
                        "conflict",
                        "discrepancy"
                    ],
                    "common_phrases": [
                        "direct contradiction",
                        "apparent contradiction",
                        "internal contradiction"
                    ],
                    "target_lang_definitions": {
                        "ru": "Утверждение или ситуация, в которой две вещи исключают друг друга и не могут быть истинными одновременно."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "противоречие",
                                "target_lang_sense_clarification": "несоответствие фактов или слов"
                            },
                            {
                                "target_lang_word": "несоответствие",
                                "target_lang_sense_clarification": "отсутствие совпадения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "34abfc46-558f-3641-befc-1847ef00d4b3",
                    "sense_definition": "The act of saying that something someone else has said is wrong or not true.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "act of opposing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His quick <w>contradiction</w> of the proposal was very interesting to the rest of the committee.",
                            "target_lang_translations": {
                                "ru": "Его быстрое <w>возражение</w> против предложения было очень интересным для остальных членов комитета."
                            }
                        },
                        {
                            "text": "She spoke with such confidence that no one dared to offer a <w>contradiction</w> to her claims.",
                            "target_lang_translations": {
                                "ru": "Она говорила с такой уверенностью, что никто не осмелился <w>возразить</w> её утверждениям."
                            }
                        }
                    ],
                    "common_phrases": [
                        "offer a contradiction",
                        "without contradiction"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие, выражающееся в заявлении о том, что сказанное кем-то другим неверно или ошибочно."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "возражение",
                                "target_lang_sense_clarification": "высказывание несогласия"
                            },
                            {
                                "target_lang_word": "опровержение",
                                "target_lang_sense_clarification": "доказательство ложности"
                            },
                            {
                                "target_lang_word": "противоречие",
                                "target_lang_sense_clarification": "акт несогласия со словами другого"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f58a3754-16dd-31c2-8cd2-5cc699f46a88",
                    "sense_definition": "A lack of agreement or harmony between two or more ideas, forces, or social elements.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "logical inconsistency",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Marx believed that the internal <w>contradictions</w> of capitalism would eventually lead to a new social system.",
                            "target_lang_translations": {
                                "ru": "Маркс верил, что внутренние <w>противоречия</w> капитализма в конечном итоге приведут к новой социальной системе."
                            }
                        },
                        {
                            "text": "The inherent <w>contradiction</w> between economic growth and environmental protection is a major global challenge.",
                            "target_lang_translations": {
                                "ru": "Неотъемлемое <w>противоречие</w> между экономическим ростом и защитой окружающей среды является серьезной глобальной проблемой."
                            }
                        }
                    ],
                    "common_phrases": [
                        "inherent contradiction",
                        "fundamental contradiction"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отсутствие согласия или гармонии между идеями, силами или социальными элементами."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "противоречие",
                                "target_lang_sense_clarification": "диалектическое или социальное несоответствие"
                            },
                            {
                                "target_lang_word": "антагонизм",
                                "target_lang_sense_clarification": "непримиримое противоречие"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9ee86b40-f424-3f6f-8f9a-e1bd02055dc3",
                    "sense_definition": "In logic, a proposition that is false for all possible values of its variables.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "formal logic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In formal logic, the statement 'P and not P' is a classic example of a <w>contradiction</w>.",
                            "target_lang_translations": {
                                "ru": "В формальной логике утверждение «P и не P» является классическим примером <w>противоречия</w>."
                            }
                        },
                        {
                            "text": "The proof failed because it resulted in a logical <w>contradiction</w> that could not be resolved.",
                            "target_lang_translations": {
                                "ru": "Доказательство не удалось, так как оно привело к логическому <w>противоречию</w>, которое невозможно было разрешить."
                            }
                        }
                    ],
                    "synonyms": [
                        "↯",
                        "⇒⇐",
                        "⊥",
                        "↮",
                        "※"
                    ],
                    "antonyms": [
                        "tautology"
                    ],
                    "common_phrases": [
                        "logical contradiction",
                        "formal contradiction"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical term in logic"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "В логике: суждение, которое является ложным при любых значениях входящих в него переменных."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "противоречие",
                                "target_lang_sense_clarification": "логическая несовместимость"
                            },
                            {
                                "target_lang_word": "логическое противоречие",
                                "target_lang_sense_clarification": "формальный термин"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}