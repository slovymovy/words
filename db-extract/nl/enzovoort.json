                    {
                        "sense_id": "83746f68-fc32-386f-891c-cc1e9beb764a",
                        "entry_id": "c91522ea-cab2-312c-b6ff-1ef034a14c51",
                        "glosses": [
                            "aanduiding van het feit dat een verdere opsomming overbodig geacht wordt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7dbc0d3e-550b-4be8-80a4-ec6e2b3935ee",
                                "sense_id": "83746f68-fc32-386f-891c-cc1e9beb764a",
                                "text": "En dan heb je nog de kosten op de trail zelf: eten, de resupplypostpakketkosten, hostel- en motelkosten enzovoort. Je bent hier al met al tussen 2.500 euro tot 4.500 euro aan kwijt."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4a497a62-6ca1-456f-9ac3-57c18b013571",
                        "source_entry_id": "c91522ea-cab2-312c-b6ff-1ef034a14c51",
                        "source_sense_id": "83746f68-fc32-386f-891c-cc1e9beb764a",
                        "target_lang_word": "und so weiter",
                        "target_lang_code": "de",
