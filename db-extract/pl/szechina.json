                        "source_sense_id": "60861ebe-7816-3887-b0bb-11f8c52f3d15",
                        "target_lang_word": "Schechina",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schechina",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7d052e01-545c-3798-b029-0ee7b6f2450c",
                                        "entry_id": "a0b347e4-5111-3fa5-9dab-f9fe134e26d9",
                                        "glosses": [
                                            "die immanente Gegenwart Gottes, besonders im Tempel und im Land Israel; die einwohnende Herrlichkeit Gottes in der Welt (nach rabbinischer, kabbalistischer und chassidischer Tradition)"
                                        ],
                                        "tags": [
                                            "Judentum"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17e4d446-f23d-4684-9956-a79f1495ed19",
                                                "sense_id": "7d052e01-545c-3798-b029-0ee7b6f2450c",
                                                "text": "»Wenn zwei Menschen zusammensitzen und über die Tora reden, dann ist die Schechina anwesend« (Mischna, Awot 3,2)"
                                            },
                                            {
                                                "example_id": "fd663a71-066b-4e6d-bf4b-db8cceaaab9b",
                                                "sense_id": "7d052e01-545c-3798-b029-0ee7b6f2450c",
                                                "text": "Deuteronomium 23 beschreibt, wie Verstöße gegen die Reinheitsvorschriften, Götzendienst, Blutvergießen, Gotteslästerung und Unzucht bewirken, dass die Schechina sich vom Lager entfernt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
