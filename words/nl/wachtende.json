                    "sense_definition": "Iemand die aan het wachten is.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er zijn nog drie <w>wachtenden</w> voor u in de rij bij de kassa.",
                            "target_lang_translations": {
                                "it": "Ci sono ancora tre <w>persone in attesa</w> prima di lei in fila alla cassa."
                            }
                        },
                        {
                            "text": "De <w>wachtende</w> op het perron keek ongeduldig op zijn horloge.",
                            "target_lang_translations": {
                                "it": "La <w>persona in attesa</w> sulla banchina guardò con impazienza il suo orologio."
                            }
                        }
                    ],
                    "common_phrases": [
                        "aantal wachtenden",
                        "wachtenden voor u"
                    ],
                    "target_lang_definitions": {
                        "it": "Qualcuno che sta aspettando."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "persona in attesa",
                                "target_lang_sense_clarification": "riferito a qualcuno che aspetta il proprio turno o un evento"
                            },
                            {
                                "target_lang_word": "utente in attesa",
                                "target_lang_sense_clarification": "spesso usato in contesti di servizi o code telefoniche"
                            }
                        ]
                    }
                }
            ]
        },
        {
