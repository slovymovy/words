                                        "entry_id": "cb20dc69-8c79-3ad0-9dc1-973634065be3",
                                        "glosses": [
                                            "An item of footwear, usually of rubber, secured by two straps which join to pass between the big toe and its neighbour."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "plural-normally"
                                        ],
                                        "examples": [
                                            {
