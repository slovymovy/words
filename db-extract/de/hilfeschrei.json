                "translations": [
                    {
                        "translation_id": "eff4f1a8-cb19-4a60-8c9f-ba3a7c992012",
                        "source_entry_id": "cf108977-b684-3b3d-9b3f-6d33a305918f",
                        "source_sense_id": "f65d04f2-7c27-3443-b196-2114ce8f8569",
                        "source_sense_description": "lauter Ruf nach Hilfe aus einer Notsituation",
                        "target_lang_word": "cry for help",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cry for help",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f6bc9074-2ffa-3656-9d86-93ccb87bf044",
                                        "entry_id": "0025720a-6243-3ce5-b07d-4f7f9b235144",
                                        "glosses": [
                                            "Used other than figuratively or idiomatically: see cry, for, help."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea6e4c7d-faf5-4857-a415-ba2781ffe169",
                                                "sense_id": "f6bc9074-2ffa-3656-9d86-93ccb87bf044",
                                                "text": "We heard the drowning woman's cries for help and ran to assist."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a3734405-5c47-359e-8763-1d7314f8da93",
                                        "entry_id": "0025720a-6243-3ce5-b07d-4f7f9b235144",
                                        "glosses": [
                                            "Acting out as a means of displaying a subconscious desire for attention or help."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5eb575d2-4c44-49cd-bc52-6a08a0ee574c",
                                                "sense_id": "a3734405-5c47-359e-8763-1d7314f8da93",
                                                "text": "In her second year at the school Alexis stopped doing her homework and would often scribble on walls. Her teachers wondered whether this was a cry for help, or if she was simply misbehaving."
                                            },
                                            {
                                                "example_id": "58251345-c02c-4950-95cb-50ccc27d8cb0",
                                                "sense_id": "a3734405-5c47-359e-8763-1d7314f8da93",
                                                "text": "Tucker Carlson (also a jacket and tie guy) picked up on the hoo-ha on his Fox News show, calling the hoodie-jacket combination a “cry for help” and inviting Roger Stone, the disgraced former political operative and author of his own “Best and Worst dressed List,” to comment."
                                            }
                                        ]
                                    }
                                ]
                            }
