{
    "word_family": [
        "have",
        "have-not",
        "haves"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "defa46d8-3fee-33fd-827b-945fd8ba984d",
                    "sense_definition": "The present participle and gerund of <w>have</w>.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We are <having> a wonderful time at the beach this summer.",
                            "target_lang_translations": {
                                "ru": "Мы чудесно <проводим> время на пляже этим летом.",
                                "tr": "Bu yaz plajda harika vakit <geçiriyoruz>."
                            }
                        },
                        {
                            "text": "<Having> finished his homework, the boy went out to play with his friends.",
                            "target_lang_translations": {
                                "ru": "<Закончив> домашнюю работу, мальчик пошел играть с друзьями.",
                                "tr": "Ödevini <bitirince>, çocuk arkadaşlarıyla oynamak için dışarı çıktı."
                            }
                        }
                    ],
                    "common_phrases": [
                        "having said that",
                        "having fun",
                        "having a baby",
                        "having trouble",
                        "having a look"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle and gerund"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени и герундий от глагола have (иметь).",
                        "tr": "\"have\" fiilinin şimdiki zaman sıfat-fiili ve ulaç biçimi."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "имея",
                                "target_lang_sense_clarification": "деепричастие"
                            },
                            {
                                "target_lang_word": "имеющий",
                                "target_lang_sense_clarification": "причастие"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "sahip olarak",
                                "target_lang_sense_clarification": "ulaç/zarf-fiil"
                            },
                            {
                                "target_lang_word": "sahip olan",
                                "target_lang_sense_clarification": "sıfat-fiil"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "fd9af5e4-fdcc-31bd-860e-35e1e288fdf9",
                    "sense_definition": "The act of possessing or ownership.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "possession_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "For him, the joy was in the creating, not merely the <having>.",
                            "target_lang_translations": {
                                "ru": "Для него радость была в созидании, а не просто в <обладании>.",
                                "tr": "Onun için sevinç yalnızca <sahip olmada> değil, yaratmaktaydı."
                            }
                        },
                        {
                            "text": "She valued the <having> of knowledge far above material wealth.",
                            "target_lang_translations": {
                                "ru": "Она ценила <владение> знаниями гораздо выше материального богатства.",
                                "tr": "Bilgiye <sahip olmayı> maddi zenginliğin çok üstünde tutuyordu."
                            }
                        }
                    ],
                    "synonyms": [
                        "possession",
                        "ownership"
                    ],
                    "antonyms": [
                        "lacking"
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт владения или обладания чем-либо.",
                        "tr": "Bir şeye sahip olma veya mülkiyet durumu."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обладание",
                                "target_lang_sense_clarification": "процесс владения"
                            },
                            {
                                "target_lang_word": "владение",
                                "target_lang_sense_clarification": "право собственности"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "sahip olma",
                                "target_lang_sense_clarification": "bir şeye mülk olarak sahip bulunma"
                            },
                            {
                                "target_lang_word": "sahiplik",
                                "target_lang_sense_clarification": "mülkiyet durumu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4de9c5db-2ca4-36e5-bf23-fd46ab39ebf0",
                    "sense_definition": "Something owned, such as goods or an estate.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "possession_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The wealthy merchant boasted of his vast <having> and many lands.",
                            "target_lang_translations": {
                                "ru": "Богатый купец хвастался своим огромным <состоянием> и множеством земель.",
                                "tr": "Zengin tüccar, büyük <varlığıyla> ve birçok arazisiyle övünüyordu."
                            }
                        },
                        {
                            "text": "He lost his entire <having> in a single game of cards.",
                            "target_lang_translations": {
                                "ru": "Он проиграл всё свое <имущество> в одной карточной игре.",
                                "tr": "Tek bir iskambil oyununda tüm <mülkünü> kaybetti."
                            }
                        }
                    ],
                    "synonyms": [
                        "property",
                        "goods",
                        "estate"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Имущество, собственность или состояние (устаревшее значение).",
                        "tr": "Mal, mülk veya servet gibi sahip olunan şeyler (eskimiş)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "имущество",
                                "target_lang_sense_clarification": "собственность"
                            },
                            {
                                "target_lang_word": "состояние",
                                "target_lang_sense_clarification": "богатство"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "varlık",
                                "target_lang_sense_clarification": "servet, mal mülk"
                            },
                            {
                                "target_lang_word": "mülk",
                                "target_lang_sense_clarification": "taşınmaz veya sahip olunan şey"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "dd3d5b39-08c0-3ee2-a050-ca7291dc063f",
                    "sense_definition": "Grasping or greedy in nature.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <having> landlord demanded the rent weeks before it was actually due.",
                            "target_lang_translations": {
                                "ru": "<Алчный> домовладелец потребовал арендную плату за несколько недель до срока.",
                                "tr": "<Açgözlü> ev sahibi, kirayı vadesinden haftalar önce talep etti."
                            }
                        },
                        {
                            "text": "He had a <having> look in his eyes when he saw the pile of gold.",
                            "target_lang_translations": {
                                "ru": "У него был <жадный> взгляд, когда он увидел груду золота.",
                                "tr": "Altın yığınını gördüğünde gözlerinde <haris> bir bakış vardı."
                            }
                        }
                    ],
                    "synonyms": [
                        "greedy",
                        "acquisitive"
                    ],
                    "antonyms": [
                        "generous"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Жадный или алчный по натуре (устаревшее значение).",
                        "tr": "Açgözlü veya haris bir yapıda olan (eskimiş)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жадный",
                                "target_lang_sense_clarification": "стремящийся к наживе"
                            },
                            {
                                "target_lang_word": "алчный",
                                "target_lang_sense_clarification": "корыстолюбивый"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "açgözlü",
                                "target_lang_sense_clarification": "doyumsuz, hırslı"
                            },
                            {
                                "target_lang_word": "haris",
                                "target_lang_sense_clarification": "hep daha fazlasını isteyen"
                            }
                        ]
                    }
                }
            ]
        }
    ]
