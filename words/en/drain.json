{
    "word_family": [
        "drainage",
        "drainer",
        "draining",
        "undrained"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "46e9ea85-19ae-3e1d-acc1-90bf95661f17",
                    "sense_definition": "to cause liquid to flow out of a container or space",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "liquid_removal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please <w>drain</w> the sink because it is full of dirty water.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, <w>спусти</w> воду из раковины, потому что она полна грязной воды."
                            }
                        },
                        {
                            "text": "You should <w>drain</w> the pasta before adding the tomato sauce.",
                            "target_lang_translations": {
                                "ru": "Тебе следует <w>слить</w> воду с пасты перед добавлением томатного соуса."
                            }
                        }
                    ],
                    "common_phrases": [
                        "drain the sink",
                        "drain the pasta",
                        "drain the pool"
                    ],
                    "target_lang_definitions": {
                        "ru": "выпускать или сливать жидкость из контейнера или пространства"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сливать",
                                "target_lang_sense_clarification": "жидкость из емкости"
                            },
                            {
                                "target_lang_word": "спускать",
                                "target_lang_sense_clarification": "воду из раковины или бассейна"
                            },
                            {
                                "target_lang_word": "выкачивать",
                                "target_lang_sense_clarification": "с помощью насоса"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "516190b0-a64d-3756-a36c-536f0ef359cb",
                    "sense_definition": "to lose liquid or become empty of liquid gradually",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "liquid_removal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The clogged sink <w>drained</w> slowly after we used the plunger.",
                            "target_lang_translations": {
                                "ru": "Забитая раковина <w>опустошалась</w> медленно после того, как мы воспользовались вантузом."
                            }
                        },
                        {
                            "text": "Wait for the water to <w>drain</w> away before you start cleaning the tub.",
                            "target_lang_translations": {
                                "ru": "Подожди, пока вода <w>стечет</w>, прежде чем начнешь чистить ванну."
                            }
                        }
                    ],
                    "common_phrases": [
                        "drain slowly",
                        "drain away"
                    ],
                    "target_lang_definitions": {
                        "ru": "постепенно вытекать или пустеть (о жидкости)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стекать",
                                "target_lang_sense_clarification": "постепенно уходить"
                            },
                            {
                                "target_lang_word": "уходить",
                                "target_lang_sense_clarification": "о воде в сток"
                            },
                            {
                                "target_lang_word": "оттекать",
                                "target_lang_sense_clarification": "утекать в сторону"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f39443e0-b443-3127-ba69-b16f30c6ad6a",
                    "sense_definition": "to deplete someone or something of energy, money, or resources",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "depletion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The stress of this new job is really <w>draining</w> me lately.",
                            "target_lang_translations": {
                                "ru": "Стресс на этой новой работе в последнее время меня очень <w>изматывает</w>."
                            }
                        },
                        {
                            "text": "Constant repairs on the old car will <w>drain</w> your bank account quickly.",
                            "target_lang_translations": {
                                "ru": "Постоянный ремонт старой машины быстро <w>опустошит</w> твой банковский счет."
                            }
                        }
                    ],
                    "synonyms": [
                        "bleed"
                    ],
                    "common_phrases": [
                        "drain your energy",
                        "drain resources"
                    ],
                    "target_lang_definitions": {
                        "ru": "истощать чью-либо энергию, деньги или ресурсы"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "истощать",
                                "target_lang_sense_clarification": "силы или ресурсы"
                            },
                            {
                                "target_lang_word": "выматывать",
                                "target_lang_sense_clarification": "о стрессе или работе"
                            },
                            {
                                "target_lang_word": "опустошать",
                                "target_lang_sense_clarification": "банковский счет"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2396adc8-3bdc-3e8d-baca-fc5a76b62101",
                    "sense_definition": "to make a wet area of land dry by providing a way for water to flow out",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "liquid_removal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They had to <w>drain</w> the swampy land before the parking lot could be built.",
                            "target_lang_translations": {
                                "ru": "Им пришлось <w>осушить</w> болотистую местность, прежде чем можно было построить парковку."
                            }
                        },
                        {
                            "text": "Engineers worked for months to <w>drain</w> the marsh for the new housing project.",
                            "target_lang_translations": {
                                "ru": "Инженеры работали месяцами, чтобы <w>дренировать</w> болото для нового жилищного проекта."
                            }
                        }
                    ],
                    "common_phrases": [
                        "drain the swamp",
                        "drain the land"
                    ],
                    "target_lang_definitions": {
                        "ru": "осушать участок земли, обеспечивая отвод воды"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "осушать",
                                "target_lang_sense_clarification": "землю или болото"
                            },
                            {
                                "target_lang_word": "дренировать",
                                "target_lang_sense_clarification": "почву"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9576386c-248f-334b-bcee-edd5edda900b",
                    "sense_definition": "to drink the entire contents of a glass or container",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "consumption",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>drained</w> his glass of water in one long gulp.",
                            "target_lang_translations": {
                                "ru": "Он <w>осушил</w> свой стакан воды одним долгим глотком."
                            }
                        },
                        {
                            "text": "The thirsty traveler <w>drained</w> the cup to the very last drop.",
                            "target_lang_translations": {
                                "ru": "Жаждущий путешественник <w>выпил</w> чашку до самой последней капли."
                            }
                        }
                    ],
                    "common_phrases": [
                        "drain the glass",
                        "drain a cup"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used for drinking quickly or completely"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "выпивать все содержимое стакана или емкости"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "осушить",
                                "target_lang_sense_clarification": "бокал до дна"
                            },
                            {
                                "target_lang_word": "выпить",
                                "target_lang_sense_clarification": "залпом"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6daf010e-9959-3f5e-b771-ba831ca94645",
                    "sense_definition": "a pipe or hole through which liquid or sewage is carried away",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "conduit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>drain</w> in the kitchen sink is clogged with food waste.",
                            "target_lang_translations": {
                                "ru": "<w>Слив</w> в кухонной раковине забит пищевыми отходами."
                            }
                        },
                        {
                            "text": "Water swirled around the <w>drain</w> as the bathtub emptied.",
                            "target_lang_translations": {
                                "ru": "Вода кружилась вокруг <w>стока</w>, пока ванна пустела."
                            }
                        }
                    ],
                    "common_phrases": [
                        "clogged drain",
                        "sink drain",
                        "floor drain"
                    ],
                    "target_lang_definitions": {
                        "ru": "труба или отверстие, через которое отводится жидкость или канализация"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "слив",
                                "target_lang_sense_clarification": "в раковине или ванне"
                            },
                            {
                                "target_lang_word": "сток",
                                "target_lang_sense_clarification": "отверстие для воды"
                            },
                            {
                                "target_lang_word": "водосток",
                                "target_lang_sense_clarification": "система отвода воды"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "af379a13-b2b3-3729-a430-2c46bd5ff96c",
                    "sense_definition": "something that uses up a lot of time, money, or energy without giving anything back",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "depletion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "That rental property is a <w>drain</w> on our finances every month.",
                            "target_lang_translations": {
                                "ru": "Эта арендная недвижимость ежемесячно становится <w>утечкой</w> для наших финансов."
                            }
                        },
                        {
                            "text": "The long commute is a major <w>drain</w> on my energy.",
                            "target_lang_translations": {
                                "ru": "Долгая дорога на работу — это серьезная <w>трата</w> моей энергии."
                            }
                        }
                    ],
                    "common_phrases": [
                        "drain on resources",
                        "financial drain"
                    ],
                    "target_lang_definitions": {
                        "ru": "что-то, что поглощает много времени, денег или энергии без отдачи"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "утечка",
                                "target_lang_sense_clarification": "ресурсов или финансов"
                            },
                            {
                                "target_lang_word": "обуза",
                                "target_lang_sense_clarification": "в переносном смысле"
                            },
                            {
                                "target_lang_word": "расход",
                                "target_lang_sense_clarification": "постоянная трата"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "38868cf6-b0bf-3667-911e-c4f876d9ae82",
                    "sense_definition": "a natural or artificial channel that carries water away from an area of land",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "conduit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmer dug a deep <w>drain</w> to keep the field from flooding.",
                            "target_lang_translations": {
                                "ru": "Фермер выкопал глубокий <w>канал</w>, чтобы поле не затопило."
                            }
                        },
                        {
                            "text": "Heavy rains caused the main <w>drain</w> of the valley to overflow.",
                            "target_lang_translations": {
                                "ru": "Сильные дожди привели к переполнению основного <w>водоотвода</w> долины."
                            }
                        }
                    ],
                    "common_phrases": [
                        "main drain",
                        "storm drain"
                    ],
                    "target_lang_definitions": {
                        "ru": "естественный или искусственный канал для отвода воды с территории"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дренаж",
                                "target_lang_sense_clarification": "система отвода почвенных вод"
                            },
                            {
                                "target_lang_word": "канал",
                                "target_lang_sense_clarification": "водоотводная канава"
                            },
                            {
                                "target_lang_word": "водоотвод",
                                "target_lang_sense_clarification": "инженерное сооружение"
                            }
                        ]
                    }
                }
            ]
        },
        {
