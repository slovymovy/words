                "senses": [
                    {
                        "sense_id": "3f9e3876-45ac-306c-9cfa-66e504c3a189",
                        "entry_id": "0e07ad39-68c6-3ba9-8152-724a6e5e8d3b",
                        "glosses": [
                            "in der Seefahrt eine Vorrichtung zum Befestigen von Fasertauwerk, die aus zwei gegenüberliegenden Hörnern besteht und auf einem Untergrund befestigt ist"
                        ],
                        "tags": [
                            "Seemannssprache"
                        ],
                        "examples": [
                            {
                                "example_id": "a9a54a69-8b3d-478a-b65b-6c4352fc7f6b",
                                "sense_id": "3f9e3876-45ac-306c-9cfa-66e504c3a189",
                                "text": "Zur Befestigung des Schiffs wird die Klampe in der Regel mit Kreuzschlägen und einem Kopfschlag belegt."
                            },
                            {
                                "example_id": "b87cb585-1af8-442b-ac0f-4d0520d7e516",
                                "sense_id": "3f9e3876-45ac-306c-9cfa-66e504c3a189",
                                "text": "Kleinere Klampen sind aus Kunststoff oder Holz, größere meistens aus Metall."
                            },
                            {
                                "example_id": "f543c237-2667-4900-a497-2ccf559804d9",
                                "sense_id": "3f9e3876-45ac-306c-9cfa-66e504c3a189",
                                "text": "„Smoaks begann es an der Klampe zu vertäuen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
