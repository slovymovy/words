{
    "word_family": [
        "состояние",
        "состоятельный"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "920ce414-b255-3277-bb7f-8b612091b71c",
                    "sense_definition": "Произойти, осуществиться (о мероприятии, событии, встрече).",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Долгожданная встреча <w>состоится</w> в следующую пятницу. ",
                            "target_lang_translations": {
                                "en": "The long-awaited meeting will <w>take place</w> next Friday."
                            }
                        },
                        {
                            "text": "Концерт <w>состоится</w> завтра вечером в центральном зале города.",
                            "target_lang_translations": {
                                "en": "The concert will <w>be held</w> tomorrow evening in the city's central hall."
                            }
                        }
                    ],
                    "synonyms": [
                        "произойти",
                        "осуществиться"
                    ],
                    "antonyms": [
                        "провалиться"
                    ],
                    "common_phrases": [
                        "встреча состоится",
                        "концерт состоится"
                    ],
                    "target_lang_definitions": {
                        "en": "To happen, occur, or be held (about an event, meeting, or gathering)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "take place",
                                "target_lang_sense_clarification": "for an event or meeting to happen as planned"
                            },
                            {
                                "target_lang_word": "be held",
                                "target_lang_sense_clarification": "for an event to take place at a specific location or time"
                            },
                            {
                                "target_lang_word": "happen",
                                "target_lang_sense_clarification": "to occur or take place"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c6fe3b70-d40f-3784-8f92-273cfbe88233",
                    "sense_definition": "Утвердиться в определенном качестве, стать успешным или полноценным специалистом, личностью.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "За годы работы он <w>состоялся</w> как профессиональный врач.",
                            "target_lang_translations": {
                                "en": "Over the years of work, he <w>established himself</w> as a professional doctor."
                            }
                        },
                        {
                            "text": "Она стремилась <w>состояться</w> как художник, несмотря на все трудности.",
                            "target_lang_translations": {
                                "en": "She strove to <w>fulfill herself</w> as an artist despite all the difficulties."
                            }
                        }
                    ],
                    "synonyms": [
                        "реализоваться",
                        "воплотиться"
                    ],
                    "common_phrases": [
                        "состояться как специалист",
                        "состояться в профессии"
                    ],
                    "target_lang_definitions": {
                        "en": "To establish oneself, become successful, or fulfill oneself as a professional or individual."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "fulfill oneself",
                                "target_lang_sense_clarification": "to achieve one's potential or success in a role or profession"
                            },
                            {
                                "target_lang_word": "establish oneself",
                                "target_lang_sense_clarification": "to gain recognition or success in a career"
                            },
                            {
                                "target_lang_word": "make it",
                                "target_lang_sense_clarification": "to succeed as a professional or person"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}