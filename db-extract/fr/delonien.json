                    {
                        "sense_id": "f99dd0e7-6478-36eb-9c06-5dec28b68595",
                        "entry_id": "39ad6ff4-8c3c-3c5a-b9d4-7fd4ce71a204",
                        "glosses": [
                            "Propre ou relatif à Alain Delon et à ses interprétations."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7b59ccf9-af10-4029-b661-b77db33f3d45",
                                "sense_id": "f99dd0e7-6478-36eb-9c06-5dec28b68595",
                                "text": "\"Le Battant\", super-concentré delonien déjà évoqué, renonce à la fin tragique manière \"Clan des Siciliens\", ou triste manière \"Mélodie en sous-sol\"."
                            },
                            {
                                "example_id": "82cdb5c3-7ebe-4efe-9031-e39a84ff2f33",
                                "sense_id": "f99dd0e7-6478-36eb-9c06-5dec28b68595",
                                "text": "Posez-lui une question sur son travail, son enfance, sa vie, il vous répondra systématiquement par ce déconcertant pronom personnel : \"nous\". Délire narcissique ? Melon delonien ? C'est tout le contraire."
                            },
                            {
                                "example_id": "3b59062b-a2de-46ff-8b4b-c322c397e8f7",
                                "sense_id": "f99dd0e7-6478-36eb-9c06-5dec28b68595",
                                "text": "Taddéi reçoit Delon dans \"Ce soir ou jamais\" pour retracer le parcours du « héros delonien », dont l’œuvre et la vie s’interpénètrent."
                            },
                            {
                                "example_id": "cc5d97d3-3152-47c4-b424-5af1ebe88a3b",
                                "sense_id": "f99dd0e7-6478-36eb-9c06-5dec28b68595",
                                "text": "En créant Frank Riva, un autre héros delonien quelque temps plus tard, et en perpétuant le mythe du Samouraï dans une saga policière sur six films de 90 minutes."
                            }
                        ]
                    }
