                ],
                "senses": [
                    {
                        "sense_id": "ef4f20d5-3114-32ff-8e3b-04130dc62d6e",
                        "entry_id": "d793f01b-1173-3379-8399-53449569e90e",
                        "glosses": [
                            "letzte Probe vor der Premiere unter Aufführungsbedingungen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c4143d3c-1710-431f-abe1-d5aece817b47",
                                "sense_id": "ef4f20d5-3114-32ff-8e3b-04130dc62d6e",
                                "text": "Die Generalprobe ist für Samstag angesetzt. Am Sonntag findet die Premiere statt."
                            },
                            {
                                "example_id": "dad1c204-983b-4b90-b2d0-3fd880e52ca7",
                                "sense_id": "ef4f20d5-3114-32ff-8e3b-04130dc62d6e",
                                "text": "„Bei den letzten Proben und der Generalprobe vor dem großen Tag teilte der zugezogene und dann probeweise sich langsam öffnende Vorhang die ganze Welt für ihn in zwei Teile.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a1411f28-4238-40e6-91c6-1dd82a11327e",
                        "source_entry_id": "d793f01b-1173-3379-8399-53449569e90e",
                        "source_sense_id": "ef4f20d5-3114-32ff-8e3b-04130dc62d6e",
                        "source_sense_description": "letzte Probe vor der Premiere unter Aufführungsbedingungen",
                        "target_lang_word": "final rehearsal",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "93fa519b-3d5f-4a55-a123-4bf52d37b564",
                        "source_entry_id": "d793f01b-1173-3379-8399-53449569e90e",
                        "source_sense_id": "ef4f20d5-3114-32ff-8e3b-04130dc62d6e",
                        "source_sense_description": "letzte Probe vor der Premiere unter Aufführungsbedingungen",
                        "target_lang_word": "dress rehearsal",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dress rehearsal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b5548c4b-a8ea-3323-bf10-681b134d6f81",
                                        "entry_id": "0f63e98e-71e0-3ee4-bb9d-bfd632b4c36a",
                                        "glosses": [
                                            "A rehearsal prior to a public spectacle, where all the performers are in costume, in order to test all aspects of the production by closely reproducing the actual conditions of a performance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4a307cb-4287-477a-8de6-38a725adf2f5",
                                                "sense_id": "b5548c4b-a8ea-3323-bf10-681b134d6f81",
                                                "text": "We've got three dress rehearsals before the opening night to prepare ourselves for any potential technicalities."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "70d9e27b-9b91-3be8-a036-919556a21c7b",
                                        "entry_id": "0f63e98e-71e0-3ee4-bb9d-bfd632b4c36a",
                                        "glosses": [
                                            "The final rehearsal before a performance, whether or not costumes or performance dress are worn."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8c633116-2949-3800-a30e-2dd7d3d5bb81",
                                        "entry_id": "0f63e98e-71e0-3ee4-bb9d-bfd632b4c36a",
                                        "glosses": [
                                            "Any complex activity that serves to prepare for a more important iteration of it later."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "794fd56f-22aa-4289-9db0-7d978dc0e21a",
                                                "sense_id": "8c633116-2949-3800-a30e-2dd7d3d5bb81",
                                                "text": "Although the train derailment ended up not being very serious, the emergency services' response served as a dress rehearsal in case of a much worse disaster."
                                            },
                                            {
                                                "example_id": "12e5c574-1dc4-4d7d-ad3d-4e4a636430fb",
                                                "sense_id": "8c633116-2949-3800-a30e-2dd7d3d5bb81",
                                                "text": "Sunday, November 6, was spent in a second full-scale dress rehearsal of the complete weekday electric timetable, [...] during which the public were invited to make their first trial of the trains—and 15,000 did so."
                                            },
                                            {
                                                "example_id": "d142089f-fd3d-4395-80d6-640387ca1f65",
                                                "sense_id": "8c633116-2949-3800-a30e-2dd7d3d5bb81",
                                                "text": "And if anybody thinks that that was not a dress rehearsal for what they may try to attempt in January of 2025, I’m sorry to say, but I think that’s a very naïve assumption."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5a35ecad-8e5a-4695-892e-682d0801eed4",
                        "source_entry_id": "d793f01b-1173-3379-8399-53449569e90e",
                        "source_sense_id": "ef4f20d5-3114-32ff-8e3b-04130dc62d6e",
                        "source_sense_description": "letzte Probe vor der Premiere unter Aufführungsbedingungen",
                        "target_lang_word": "répétition générale",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "répétition générale",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4a06f92e-5762-3726-ac26-cbf8c161a0cb",
                                        "entry_id": "f18ff696-4017-3982-bc0f-d24ea7dd922b",
                                        "glosses": [
                                            "Dernière répétition d’un spectacle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "41264f71-6fc1-4032-aa3f-cae307cd1453",
                                                "sense_id": "4a06f92e-5762-3726-ac26-cbf8c161a0cb",
                                                "text": "Ce changement de la situation d’Odette s’accomplissait de sa part avec une discrétion qui le rendait plus sûr et plus rapide, mais ne le laissait nullement soupçonner du public enclin à s’en remettre aux critiques du Gaulois des progrès ou de la décadence d’un salon, de sorte qu’un jour, à une répétition générale d’une pièce de Bergotte donnée dans une salle des plus élégantes au bénéfice d’une œuvre de charité, ce fut un vrai coup de théâtre quand on vit dans la loge de face, qui était celle de l’auteur, venir s’asseoir à côté de Mme Swann, Mme de Marsantes et celle qui par l’effacement progressif de la duchesse de Guermantes (rassasiée d’honneurs, et s’annihilant par moindre effort), était en train de devenir la lionne, la reine du temps, la comtesse Molé."
                                            },
                                            {
                                                "example_id": "81c4b454-ead3-47c2-a7bc-b54f2de84d3a",
                                                "sense_id": "4a06f92e-5762-3726-ac26-cbf8c161a0cb",
                                                "text": "La Société des auteurs et le Syndicat des directeurs de théâtres de Paris, estimant trop sévères certains articles publiés par les critiques au lendemain de la présentation des pièces, ont décidé d'abolir les répétitions générales."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e613768-3326-3507-a057-afefd7d3388e",
                                        "entry_id": "f18ff696-4017-3982-bc0f-d24ea7dd922b",
                                        "glosses": [
                                            "Dernière répétition avant un évènement important, complexe, pour en éprouver l’organisation."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3d70d3cb-da97-42bd-93e4-f4abe62efaa4",
                                                "sense_id": "1e613768-3326-3507-a057-afefd7d3388e",
                                                "text": "La Semaine sportive internationale de Tokyo, véritable répétition générale des Jeux olympiques qui auront lieu dans un an, s’est ouverte vendredi en présence de soixante-douze mille spectateurs.."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "127161ff-4345-4f65-8a8b-e851617d5a58",
