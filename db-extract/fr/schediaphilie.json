                                "target_senses": [
                                    {
                                        "sense_id": "fa7b5d40-7558-3a61-8b6e-bdd453b10dee",
                                        "entry_id": "cfa743b1-f12e-3ad0-92f9-fc1a11f36630",
                                        "glosses": [
                                            "Sexual and/or romantic attraction to cartoon or anime characters."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9332977b-a2f3-47c6-bf88-07fdf6344a17",
                                                "sense_id": "fa7b5d40-7558-3a61-8b6e-bdd453b10dee",
                                                "text": "Yes, that particular four-parter has a special place in my heart... it was the main root from which my toonophilia, and later my furriness, grew. (Well, more likely the root was already there, and it was the fertilizer.)"
                                            },
                                            {
                                                "example_id": "eed12735-88b6-4638-9843-22cf69cc323a",
                                                "sense_id": "fa7b5d40-7558-3a61-8b6e-bdd453b10dee",
                                                "text": "Toonophilia isn't furry fandom, but it can bring people to it, because it's similar to begin with."
                                            },
                                            {
                                                "example_id": "f33cc7bb-628d-4182-94ed-aee2dae38525",
                                                "sense_id": "fa7b5d40-7558-3a61-8b6e-bdd453b10dee",
                                                "text": "I'm not an Otakusexual — although I respect toonophilia as a sexually responsible choice."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
