                "senses": [
                    {
                        "sense_id": "85e0aa7a-b47f-3430-b2c1-5d489cd2ee6e",
                        "entry_id": "31ea944d-80b0-3d90-9d23-f6ad5b3ba108",
                        "glosses": [
                            "Küchengerät zur Fertigung von Brot"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "798e057f-28ec-49f5-a5e3-761317423f5e",
                                "sense_id": "85e0aa7a-b47f-3430-b2c1-5d489cd2ee6e",
                                "text": "Seine Frau machte ihm mit dem Brotbackautomaten frisches Brot zum Frühstück."
                            },
                            {
                                "example_id": "b50c6d48-7d0f-4dc0-a2bc-cee8110cbb74",
                                "sense_id": "85e0aa7a-b47f-3430-b2c1-5d489cd2ee6e",
                                "text": "„Wie sich später herausstellte, hatte eine belgische Urlauberfamilie auf dem Ceranofen in der Küche einen Brotbackautomaten abgestellt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "60786cb2-0c6c-4ca6-bbc3-2f384d8abc3d",
                        "source_entry_id": "31ea944d-80b0-3d90-9d23-f6ad5b3ba108",
                        "source_sense_id": "85e0aa7a-b47f-3430-b2c1-5d489cd2ee6e",
