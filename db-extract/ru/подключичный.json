                        "source_sense_id": "b433b2f8-047e-3a5d-986a-67eac5c7140a",
                        "target_lang_word": "subclavian",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "subclavian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "807c00fe-470d-35e8-9acf-d1ad5c33c9e7",
                                        "entry_id": "91cbeff2-8473-3e02-a91c-a733293513ee",
                                        "glosses": [
                                            "Relating to or denoting an artery or vein which serves the neck and arm on the left or right side of the body."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff79cc5a-7970-44d2-8d4f-cb531ae493b5",
                                                "sense_id": "807c00fe-470d-35e8-9acf-d1ad5c33c9e7",
                                                "text": "There I was struck on the shoulder by a Jezail bullet, which shattered the bone and grazed the subclavian artery."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "subclavian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "455e2f9b-fb98-3815-b97e-c2a2f0f0eb48",
                                        "entry_id": "b021eea4-9033-3a83-bd4e-6f723cbe48a4",
                                        "glosses": [
                                            "A subclavian part (such as an artery, vein, or nerve)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fdd2a594-6425-4cc7-ba1c-ee7398dbeb16",
                                                "sense_id": "455e2f9b-fb98-3815-b97e-c2a2f0f0eb48",
                                                "text": "The carotids were in their natural state; the arteria innominata and the subclavian were twice their natural diameter: their smaller branches were proportionally dilated and bent zigzag."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3a59b391-25ad-4a0c-8629-f0b7058e4de1",
                        "source_entry_id": "6fcfeb6a-96c8-3c2d-adab-38a193c97909",
                        "source_sense_id": "b433b2f8-047e-3a5d-986a-67eac5c7140a",
                        "target_lang_word": "subclavicular",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
