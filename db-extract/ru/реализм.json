                                "target_senses": [
                                    {
                                        "sense_id": "5dbb9d72-b990-350a-9484-c68fd058b9ac",
                                        "entry_id": "99ff55f0-26d4-3839-ba23-e7a72ec393eb",
                                        "glosses": [
                                            "richtige, angemessene Einschätzung der Wirklichkeit; Wirklichkeitssinn"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ce046e86-db4e-477d-a964-5e2f04a1f6d1",
                                                "sense_id": "5dbb9d72-b990-350a-9484-c68fd058b9ac",
                                                "text": "Mit seinem Realismus erkannte er, wo seine Grenzen sind."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ac855915-41f8-331d-b22f-2b3b12c9fe47",
                                        "entry_id": "99ff55f0-26d4-3839-ba23-e7a72ec393eb",
                                        "glosses": [
                                            "künstlerische und literarische Strömung in der zweiten Hälfte des 19. Jahrhunderts mit dem Ziel, das, was für wirklich gehalten wurde, künstlerisch darzustellen"
                                        ],
                                        "tags": [
                                            "Kunst/Literaturwissenschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b4dc751c-9f36-403f-a303-4c63156cbb1f",
                                                "sense_id": "ac855915-41f8-331d-b22f-2b3b12c9fe47",
                                                "text": "Jeremias Gotthelf ist ein Autor des Realismus."
                                            },
                                            {
                                                "example_id": "bb83b10a-aea2-4e45-ab2c-b2dd24a2986b",
                                                "sense_id": "ac855915-41f8-331d-b22f-2b3b12c9fe47",
                                                "text": "„Schon der Gegenstand seines ersten Werkes aus dem Jahr 1946 ist raumgreifend wie kein anderer. An ihm hat Klein schon früh seinen phantastischen Realismus erprobt.“"
                                            },
                                            {
                                                "example_id": "bf40eb9d-40ce-41c6-88c4-7b6e17fd712b",
                                                "sense_id": "ac855915-41f8-331d-b22f-2b3b12c9fe47",
                                                "text": "„Der Gegensatz von Realismus und Idealismus ist nicht nur für die unterschiedliche Fassung der Darstellungsfunktion von Belang, sondern auch für die Bestimmung der Kommunikationsfunktion.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "783ff624-ab38-3924-a32a-8da2d7f201dd",
                                        "entry_id": "99ff55f0-26d4-3839-ba23-e7a72ec393eb",
                                        "glosses": [
