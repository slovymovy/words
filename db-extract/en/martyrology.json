                                "example_id": "c2e2b508-1005-4f5a-bb11-726a1c092f30",
                                "sense_id": "f79a9d91-c268-3fd4-b948-808b4ce72530",
                                "text": "It needs further study for what it suggests of the gender dimension to martyrdom and martyrology."
                            }
