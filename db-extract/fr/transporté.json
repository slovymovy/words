                                    {
                                        "sense_id": "f18cca63-440c-3863-9ebb-456e38be623d",
                                        "entry_id": "360cc432-5a3d-353a-a771-a0dc486d34f2",
                                        "glosses": [
                                            "Fascinated by something; entranced as if by a spell; captivated."
                                        ],
                                        "tags": [],
                                        "examples": [
