{
    "word_family": [
        "swear",
        "swearer",
        "swearing"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "3a009fd5-3386-354f-86d7-64fa3b434a09",
                    "sense_definition": "Given or declared under oath.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "oath",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The witness provided a <w>sworn</w> statement to the court.",
                            "target_lang_translations": {
                                "fr": "Le témoin a fourni une déclaration <w>sous serment</w> au tribunal."
                            }
                        },
                        {
                            "text": "He gave a <w>sworn</w> testimony regarding the accident.",
                            "target_lang_translations": {
                                "fr": "Il a donné un témoignage <w>sous serment</w> concernant l'accident."
                            }
                        }
                    ],
                    "synonyms": [
                        "affirmed",
                        "certified"
                    ],
                    "common_phrases": [
                        "sworn statement",
                        "sworn testimony"
                    ],
                    "target_lang_definitions": {
                        "fr": "Donné ou déclaré sous serment."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "sous serment",
                                "target_lang_sense_clarification": "utilisé pour décrire une déclaration faite officiellement"
                            },
                            {
                                "target_lang_word": "assermenté",
                                "target_lang_sense_clarification": "qui a prêté serment, souvent utilisé pour des documents ou des traducteurs"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5723cbc8-2999-30c5-9fbc-162c08b01b5f",
                    "sense_definition": "Bound as though by an oath.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "oath",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am <w>sworn</w> to secrecy about the project details.",
                            "target_lang_translations": {
                                "fr": "Je suis <w>tenu au secret</w> concernant les détails du projet."
                            }
                        },
                        {
                            "text": "They are <w>sworn</w> to protect the kingdom at all costs.",
                            "target_lang_translations": {
                                "fr": "Ils ont <w>juré</w> de protéger le royaume à tout prix."
                            }
                        }
                    ],
                    "synonyms": [
                        "bound",
                        "committed"
                    ],
                    "common_phrases": [
                        "sworn to secrecy"
                    ],
                    "target_lang_definitions": {
                        "fr": "Lié par un engagement solennel ou un serment."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "lié par serment",
                                "target_lang_sense_clarification": "engagé par une promesse solennelle"
                            },
                            {
                                "target_lang_word": "tenu par serment",
                                "target_lang_sense_clarification": "obligé de respecter une promesse"
                            },
                            {
                                "target_lang_word": "juré",
                                "target_lang_sense_clarification": "lié par un serment (participe)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "21071b0b-7ed0-3684-8814-f219dabe564d",
                    "sense_definition": "Ardent, devout.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "devotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They have been <w>sworn</w> enemies for over twenty years.",
                            "target_lang_translations": {
                                "fr": "Ils sont des ennemis <w>jurés</w> depuis plus de vingt ans."
                            }
                        },
                        {
                            "text": "She is a <w>sworn</w> supporter of the local charity.",
                            "target_lang_translations": {
                                "fr": "Elle est une partisane <w>inconditionnelle</w> de l'association caritative locale."
                            }
                        }
                    ],
                    "synonyms": [
                        "avowed",
                        "staunch"
                    ],
                    "common_phrases": [
                        "sworn enemy"
                    ],
                    "target_lang_definitions": {
                        "fr": "Ardent, convaincu, inconditionnel."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "juré",
                                "target_lang_sense_clarification": "utilisé pour souligner une conviction forte ou une inimitié profonde"
                            },
                            {
                                "target_lang_word": "inconditionnel",
                                "target_lang_sense_clarification": "qui soutient quelqu'un ou quelque chose sans réserve"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "da3763f2-fe39-3ff6-b3a0-946b2e5eb181",
                    "sense_definition": "The past participle of <w>swear</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "verb_form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He has <w>sworn</w> to tell the truth in court.",
                            "target_lang_translations": {
                                "fr": "Il a <w>juré</w> de dire la vérité au tribunal."
                            }
                        },
                        {
                            "text": "They have <w>sworn</w> an oath of loyalty to the king.",
                            "target_lang_translations": {
                                "fr": "Ils ont <w>prêté</w> un serment de loyauté au roi."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past participle of swear"
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Le participe passé du verbe jurer."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "juré",
                                "target_lang_sense_clarification": "participe passé du verbe jurer"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}