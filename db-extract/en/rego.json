                "senses": [
                    {
                        "sense_id": "ed465a60-aa8c-3019-9eb5-87ac7a47c174",
                        "entry_id": "90d2f2bc-92f2-3fe9-9693-bff635371cae",
                        "glosses": [
                            "Registration for a motor vehicle."
                        ],
                        "tags": [
                            "Australia",
                            "New-Zealand",
                            "colloquial",
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "650157c1-4752-4342-8cd9-c3ffa028218d",
                                "sense_id": "ed465a60-aa8c-3019-9eb5-87ac7a47c174",
                                "text": "The police pulled me over for driving with an expired rego."
                            },
                            {
                                "example_id": "72e06539-dae5-43cd-8e9b-1bbea186a962",
                                "sense_id": "ed465a60-aa8c-3019-9eb5-87ac7a47c174",
                                "text": "You might give these people a badge or some livery for their boat and you can give them a discount on the rego of their boat."
                            },
                            {
                                "example_id": "5d4fe174-ffec-46a7-b222-da3ce01ed047",
                                "sense_id": "ed465a60-aa8c-3019-9eb5-87ac7a47c174",
                                "text": "They gave us permission to drive in Australia under the British rego, meaning we still had our GB number plates."
                            },
                            {
                                "example_id": "c5460403-d521-4e9a-ac04-f57d81361300",
                                "sense_id": "ed465a60-aa8c-3019-9eb5-87ac7a47c174",
                                "text": "When you come to buy or sell a car, every state has its own regulations, particularly with rego (registration)."
                            }
                        ]
                    },
                    {
                        "sense_id": "177c63b2-155e-38d1-ad7b-5a1e5b92d76c",
                        "entry_id": "90d2f2bc-92f2-3fe9-9693-bff635371cae",
                        "glosses": [
                            "The fee required for such registration."
                        ],
                        "tags": [
                            "Australia",
                            "New-Zealand",
                            "colloquial",
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "661a4834-51da-4c9c-ace7-17ba12cf1f2b",
                                "sense_id": "177c63b2-155e-38d1-ad7b-5a1e5b92d76c",
                                "text": "David couldn′t drive his car as he hadn′t paid his rego."
                            }
                        ]
                    },
                    {
                        "sense_id": "c57fb1fd-3b0b-3249-a85f-03ae98b6457b",
                        "entry_id": "90d2f2bc-92f2-3fe9-9693-bff635371cae",
                        "glosses": [
                            "The registration number of a motor vehicle, used by police to access registration details such as the identity of the owner."
                        ],
                        "tags": [
                            "Australia",
                            "New-Zealand",
                            "colloquial",
                            "countable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "c0c6a50c-a4e0-4069-bbfd-3d715a630caa",
                                "sense_id": "c57fb1fd-3b0b-3249-a85f-03ae98b6457b",
                                "text": "“They also got the regos of the cars. There were two commercial travelers whose cars were trapped inside by the pickets, and they got hit with writs.[…]”"
                            },
                            {
                                "example_id": "6fcc9b0f-7dd8-40dd-90ff-684211fc9d89",
                                "sense_id": "c57fb1fd-3b0b-3249-a85f-03ae98b6457b",
                                "text": "A line of cars was parked along one side, presumably belonging to the sex workers and their clients. ‘Get their regos,’ Borghini said to one of his people."
                            }
                        ]
                    }
