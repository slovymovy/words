                ],
                "senses": [
                    {
                        "sense_id": "cf4b2e9b-5463-33c2-a813-661b64ffef77",
                        "entry_id": "b96390ab-bbc7-3d9c-bead-556747fb7071",
                        "glosses": [
                            "Méridien opposé au méridien de Greenwich et traversant le Pacifique, i.e. le 180ᵉ méridien."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a0629f8e-f834-42ba-8f5a-c1392a30f4a8",
                                "sense_id": "cf4b2e9b-5463-33c2-a813-661b64ffef77",
                                "text": "La ligne de changement de date ne correspond pas toujours à l’antiméridien."
                            },
                            {
                                "example_id": "0a26430a-bcdf-43e3-afe6-f395beaf7e57",
                                "sense_id": "cf4b2e9b-5463-33c2-a813-661b64ffef77",
                                "text": "Je fais un peu de prospective et en conclus que je peux franchir l’antiméridien avant le jour de l’an."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7c4871c0-9fed-4b6e-a73d-5d56b20b747a",
                        "source_entry_id": "b96390ab-bbc7-3d9c-bead-556747fb7071",
                        "source_sense_id": "cf4b2e9b-5463-33c2-a813-661b64ffef77",
                        "target_lang_word": "antimeridian",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "antimeridian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "67129f2b-4586-3603-a54c-39c56bcfa3ec",
                                        "entry_id": "00fccb6f-f3db-3977-8439-a5256fcac6ea",
                                        "glosses": [
                                            "The reference line at 180° longitude, on the opposite side of earth to the prime meridian."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9838b67-6ba4-4d1e-b7fd-bb6cc7136430",
                                                "sense_id": "67129f2b-4586-3603-a54c-39c56bcfa3ec",
                                                "text": "On the opposite side of the Earth from Greenwich is the antimeridian, a line of longitude that is 180° both east and west of the prime meridian. It cuts through parts of eastern Russia, the Fiji Islands and the middle of the Pacific Ocean."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "609831ff-ce38-3f70-8dc1-4d16676aa396",
                                        "entry_id": "00fccb6f-f3db-3977-8439-a5256fcac6ea",
                                        "glosses": [
                                            "A meridian of longitude opposite to any given meridian used as a point of reference."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90a47bc7-0cd0-4332-8d74-fd62fb4a89fb",
                                                "sense_id": "609831ff-ce38-3f70-8dc1-4d16676aa396",
                                                "text": "123° west is the antimeridian of the 57° east meridian."
                                            },
                                            {
                                                "example_id": "52846d74-8b1e-46e4-9915-ef1c3030bd62",
                                                "sense_id": "609831ff-ce38-3f70-8dc1-4d16676aa396",
                                                "text": "The antimeridian contains your nadir and the opposite celestial pole for your hemisphere. The local meridian and the antimeridian together form the great circle simply called the meridian."
                                            },
                                            {
                                                "example_id": "51e5d668-f1dc-4fa9-a528-ce10435b4e04",
                                                "sense_id": "609831ff-ce38-3f70-8dc1-4d16676aa396",
                                                "text": "Other prime meridians were presented as candidates for the world's baseline: Jersualem; Ferro; Kamchatka; the mid-Atlantic; the Bering Strait; and Greenwich's antimeridian."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
