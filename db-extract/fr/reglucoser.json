                "senses": [
                    {
                        "sense_id": "4e6c93d2-0c22-3b23-ba4c-5cadd4f0aa2a",
                        "entry_id": "ce618b96-8c52-3d18-bcdd-2f2c6930d9b7",
                        "glosses": [
                            "Administrer le glucose manquant à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8cff4a77-3421-4a2f-a933-69424bb6ef21",
                                "sense_id": "4e6c93d2-0c22-3b23-ba4c-5cadd4f0aa2a",
                                "text": "Le 30 octobre voyant que la situation ne s'améliore pas et qu'au contraire les vomissements persistent, je fais entrer la malade en clinique, pour la réhydrater, la rechlorurer, la reglucoser et enfin l'avoir mieux en observation."
                            },
                            {
                                "example_id": "19c38640-fb73-4e2a-96ed-1191caeb9a4a",
                                "sense_id": "4e6c93d2-0c22-3b23-ba4c-5cadd4f0aa2a",
                                "text": "En cas de coup de mou mental, une demi-banane pour reglucoser le cerveau."
                            },
                            {
                                "example_id": "dcc211c6-4ffe-43a4-9856-31b5dbd67438",
                                "sense_id": "4e6c93d2-0c22-3b23-ba4c-5cadd4f0aa2a",
                                "text": "J'y avais fait une hypoglycémie me contraignant à m'arrêter sur un rocher en pleine montée, à me reglucoser la glotte et à me reposer."
                            }
                        ]
                    }
                ],
