{
    "word_family": [
        "likeness",
        "liking",
        "likely",
        "liken"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "fe1a8389-0f57-3dab-94b5-71653cecbb42",
                    "sense_definition": "The same to you; used as a short response to a greeting or well-wish.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "social_response",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It was very nice meeting you, Samantha. — <w>Likewise</w>, Mr. Thompson. ",
                            "target_lang_translations": {
                                "ru": "Был очень рад знакомству, Саманта. — <w>Взаимно</w>, мистер Томпсон."
                            }
                        },
                        {
                            "text": "I hope you have a wonderful weekend. — <w>Likewise</w>!",
                            "target_lang_translations": {
                                "ru": "Надеюсь, вы отлично проведёте выходные. — <w>И вам того же</w>!"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Взаимно; используется как краткий ответ на приветствие или доброе пожелание."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "взаимно",
                                "target_lang_sense_clarification": "универсальный ответ"
                            },
                            {
                                "target_lang_word": "и вам того же",
                                "target_lang_sense_clarification": "вежливый ответ на пожелание"
                            },
                            {
                                "target_lang_word": "и тебе того же",
                                "target_lang_sense_clarification": "неформальный ответ на пожелание"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9ac6a6fd-77e7-37cd-aec6-6d09d22038f8",
                    "sense_definition": "In addition to what has been mentioned; also or moreover.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "addition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Margaret enjoys playing tennis on Saturdays, and Jeremy <w>likewise</w> spends his weekends outdoors.",
                            "target_lang_translations": {
                                "ru": "Маргарет любит играть в теннис по субботам, и Джереми <w>также</w> проводит свои выходные на свежем воздухе."
                            }
                        },
                        {
                            "text": "The new policy will improve safety and <w>likewise</w> reduce long-term costs for the company.",
                            "target_lang_translations": {
                                "ru": "Новая политика повысит безопасность и <w>вместе с тем</w> снизит долгосрочные издержки компании."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "В дополнение к сказанному; также или более того."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "также",
                                "target_lang_sense_clarification": "в значении дополнения"
                            },
                            {
                                "target_lang_word": "тоже",
                                "target_lang_sense_clarification": "в значении присоединения"
                            },
                            {
                                "target_lang_word": "кроме того",
                                "target_lang_sense_clarification": "вводное слово"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "652dac79-4350-3674-b49b-fcb378aaecdc",
                    "sense_definition": "In a similar manner or in the same way.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "similarity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Public transportation is virtually inaccessible in this country; <w>likewise</w>, its hospitals are also not very user-friendly.",
                            "target_lang_translations": {
                                "ru": "Общественный транспорт в этой стране практически недоступен; <w>аналогично</w>, её больницы также не очень удобны для людей."
                            }
                        },
                        {
                            "text": "The first experiment failed, and the second attempt <w>likewise</w> yielded no significant results.",
                            "target_lang_translations": {
                                "ru": "Первый эксперимент провалился, и вторая попытка <w>подобным образом</w> не принесла значимых результатов."
                            }
                        }
                    ],
                    "synonyms": [
                        "similarly"
                    ],
                    "target_lang_definitions": {
                        "ru": "Подобным образом или точно так же."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "аналогично",
                                "target_lang_sense_clarification": "таким же образом"
                            },
                            {
                                "target_lang_word": "подобным образом",
                                "target_lang_sense_clarification": "сходным путем"
                            },
                            {
                                "target_lang_word": "так же",
                                "target_lang_sense_clarification": "в такой же степени или манере"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}