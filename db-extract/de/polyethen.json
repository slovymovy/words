                                "target_senses": [
                                    {
                                        "sense_id": "cec7168c-f21e-378f-afbb-822deef583ba",
                                        "entry_id": "e17aae7f-1888-3e48-8cf7-63b9e18f4da1",
                                        "glosses": [
                                            "Polymère de l'éthène (ou éthylène), variante de polyéthylène (dénomination plus courante)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "080ce408-4ade-434d-8370-d3e89b0c289a",
                                                "sense_id": "cec7168c-f21e-378f-afbb-822deef583ba",
                                                "text": "Cette fille montrée du doigt se voit enfermée dans un sac en polyéthène qui contient les gens pas bien, ensevelis parmi les autres, les boutonneux, les glaireux."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "73b5d7fa-9be5-43e6-857c-faa09a0ea9e2",
                        "source_entry_id": "71c95b1f-7295-3f2d-b4c8-7a5f8f32e9bb",
                        "source_sense_id": "2d4aa65d-1afd-3c43-9da7-2c424c2b7002",
                        "source_sense_description": "Chemie: Polymer des Ethen; ein Kunststoff",
                        "target_lang_word": "polyéthylène",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "polyéthylène",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "708c9a28-4198-3e93-b393-57a0fde49a6c",
                                        "entry_id": "f9d06f40-46ea-3cbe-848b-3a4af14f586c",
                                        "glosses": [
                                            "Polymère d'éthylène."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fff2ff10-b776-4d64-a6b4-8060e15e97cf",
                                                "sense_id": "708c9a28-4198-3e93-b393-57a0fde49a6c",
                                                "text": "L’hypocondriaque y trouvera des huiles de silicone anti-mousse qui vous déglinguent le foie, des cires en polyéthylène pour enrober les agrumes qui exigeraient qu’on se lave les mains après avoir manipulé les fruits en question, des agents de turbidité (dans les boissons) pouvant provoquer des fausses couches, du sel d’aspartame capable de déclencher des douleurs articulaires ou des trous de mémoire, des arômes « naturels » à base de glutamate monosodique potentiellement neurotoxique, des extraits de pétrole (dans le chewing-gum) qui plomberaient le système lymphatique… — (« Additifs : La lettre et le néant », Malbouffe, le dico, Les Dossiers du Canard enchaîné nᵒ 147, avril 2018, page 8)"
                                            },
                                            {
                                                "example_id": "7ce84697-79e8-4993-8130-dbe74de794a7",
                                                "sense_id": "708c9a28-4198-3e93-b393-57a0fde49a6c",
                                                "text": "L’entreprise va investir 3 milliards d’euros pour construire un « craqueur » qui transformera de l’éthane de schiste américain en éthylène, substance de base pour la production du polyéthylène, donc des granulés de plastique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
