                        "entry_id": "698bb4c9-16e5-3512-a111-909c79c4ed27",
                        "glosses": [
                            "Verbesserung der Qualität, der Leistung oder der Benutzerfreundlichkeit eines Produktes oder einer Dienstleistung"
                        ],
