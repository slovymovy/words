                "entry_id": "9cda8d54-5ea0-3e51-a7e7-29693ff3847f",
                "word": "mousquetade",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "61e2a38f-ebdd-4392-b94c-a56db9ee76e1",
                        "entry_id": "9cda8d54-5ea0-3e51-a7e7-29693ff3847f",
                        "tags": [
                            "plural"
                        ],
                        "form": "mousquetades"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3408b4a7-6b1d-3817-9410-71140768ea6a",
                        "entry_id": "9cda8d54-5ea0-3e51-a7e7-29693ff3847f",
                        "glosses": [
                            "Coup de mousquet."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "15f0ebbd-1b25-4c9f-980a-9076ea67a942",
                                "sense_id": "3408b4a7-6b1d-3817-9410-71140768ea6a",
                                "text": "Il fut blessé d’une mousquetade."
                            },
                            {
                                "example_id": "a75bf96a-9143-4b1a-9623-1f8712c928f3",
                                "sense_id": "3408b4a7-6b1d-3817-9410-71140768ea6a",
                                "text": "Il essuya quelques mousquetades."
                            },
                            {
                                "example_id": "0150bd73-2ebb-4815-ab92-a2fdf434bff6",
                                "sense_id": "3408b4a7-6b1d-3817-9410-71140768ea6a",
                                "text": "Un second roulement, pétillant comme une mousquetade et grave comme un tonnerre, vida les maisons, où ne demeurèrent que les malades, les grabataires et femmes en gésine."
                            },
                            {
                                "example_id": "3487b29b-adae-42d5-93bc-bcdce04079f4",
                                "sense_id": "3408b4a7-6b1d-3817-9410-71140768ea6a",
                                "text": "Ainsi la journée se passa gentiment, sans trop de dégât. Si ce n’est que l’un des nôtres, le gros Gueneau de Pousseaux, ayant voulu, dans sa ribote, se promener sur la muraille, le verre en main pour les narguer, eut d’une mousquetade sa cervelle et son verre mis en capilotade."
                            },
                            {
                                "example_id": "e6512603-4aab-4f8a-a680-6ca686a7b425",
                                "sense_id": "3408b4a7-6b1d-3817-9410-71140768ea6a",
                                "text": "Nous étions à peine dans les murs qu’une mousquetade nous cueillit par surprise."
                            }
                        ]
                    },
                    {
                        "sense_id": "bb10c3ff-ce0c-34c2-8bef-7eee2c015db4",
                        "entry_id": "9cda8d54-5ea0-3e51-a7e7-29693ff3847f",
                        "glosses": [
                            "Plusieurs coups de mousquet tirés à la fois ou continûment par un corps de gens armés."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4edafb01-cfab-4781-8501-2a321b305c52",
                                "sense_id": "bb10c3ff-ce0c-34c2-8bef-7eee2c015db4",
                                "text": "On a entendu une vive mousquetade."
                            },
                            {
                                "example_id": "23c7c465-dd39-4596-82c3-6232128021ce",
                                "sense_id": "bb10c3ff-ce0c-34c2-8bef-7eee2c015db4",
                                "text": "Enfin une nouvelle mousquetade se fit entendre, et cette fois les balles vinrent s’aplatir sur les cailloux, autour des quatre amis, et siffler lugubrement à leurs oreilles."
                            }
                        ]
                    }
                ],
