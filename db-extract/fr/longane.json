                "forms": [
                    {
                        "form_id": "315d5ce9-f121-42b7-8a05-8c3a46767ed0",
                        "entry_id": "d7d3ceaf-d1df-3158-97b3-cd2ef11f7beb",
                        "tags": [
                            "plural"
                        ],
                        "form": "longanes"
