                                                "sense_id": "518a42f9-cccd-3e75-912a-40b585f5ab20",
                                                "text": "Raviver une plaie,"
                                            },
                                            {
                                                "example_id": "4b68cac9-82a1-44e8-b887-93df5125a31c",
                                                "sense_id": "518a42f9-cccd-3e75-912a-40b585f5ab20",
                                                "text": "Raviver les chairs d’une plaie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e0c14380-fd1d-3254-a0dc-cf7811c9d548",
                                        "entry_id": "e916ed84-115d-3bfb-8847-8ce282a6f13c",
                                        "glosses": [
                                            "Ranimer."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
