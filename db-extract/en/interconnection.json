    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "e36bf100-cc8a-310c-b107-7c8fca5fa3f7",
                "word": "interconnection",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "b790ad74-1206-4285-b434-ffbbc09fcec9",
                        "entry_id": "e36bf100-cc8a-310c-b107-7c8fca5fa3f7",
                        "tags": [
                            "plural"
                        ],
                        "form": "interconnections"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "afd72c37-2a13-3d2e-903c-aae2963394cf",
                        "entry_id": "e36bf100-cc8a-310c-b107-7c8fca5fa3f7",
                        "glosses": [
                            "A connection (physical or logical) between multiple things"
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "69ef6ce2-2d56-4525-9de6-88a42aad74c5",
                                "sense_id": "afd72c37-2a13-3d2e-903c-aae2963394cf",
                                "text": "As socialists we see the interconnection between the institutions of classism, sexism, and racism in our personal working lives."
                            },
                            {
                                "example_id": "7721b2bd-19cc-4a8f-b0d0-2e13d2b9ac60",
                                "sense_id": "afd72c37-2a13-3d2e-903c-aae2963394cf",
                                "text": "Specifically, a connection between two parts."
                            },
                            {
                                "example_id": "7ba1e22c-98df-4305-9ee5-ca14bee0688e",
                                "sense_id": "afd72c37-2a13-3d2e-903c-aae2963394cf",
                                "text": "Based on the latest data by ENTSO-E, there are 82 interconnections between the EU and its ten neighbouring countries, affecting 22 borders: Belarus, Moldova, Russia, and Ukraine at the Eastern EU border, Albania, Bosnia-Herzegovina, North Macedonia and Serbia in the Balkans, Turkey, as well as Morocco in the Southern Mediterranean."
                            },
                            {
                                "example_id": "35a76a60-9b29-45c1-aca3-57f16ca233db",
                                "sense_id": "afd72c37-2a13-3d2e-903c-aae2963394cf",
                                "text": "Nemo Link is one example of the value of interconnection between mainland Europe and Great Britain."
                            }
                        ]
                    },
                    {
                        "sense_id": "762da9f2-1125-3110-bf14-a9abeffbe716",
                        "entry_id": "e36bf100-cc8a-310c-b107-7c8fca5fa3f7",
                        "glosses": [
                            "The connecting of renewable-energy systems to the power grid"
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "4c77445d-62c2-4f2c-a44a-4b43a19e8b5d",
                                "sense_id": "762da9f2-1125-3110-bf14-a9abeffbe716",
                                "text": "A dozen states have implemented policies for interconnection."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2ef4fa06-4835-4ec7-808a-7f376e7ab2e0",
                        "source_entry_id": "e36bf100-cc8a-310c-b107-7c8fca5fa3f7",
                        "source_sense_description": "connection between multiple things",
                        "target_lang_word": "interconnexion",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "interconnexion",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e46bcbb6-77c4-312e-90d1-ea31bd64edc5",
                                        "entry_id": "4663713d-1299-391e-bdac-470c0b5f04e3",
                                        "glosses": [
                                            "Intégration d’un ensemble par des connexions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52695b7a-990d-40c6-a862-7eedba59f7fc",
                                                "sense_id": "e46bcbb6-77c4-312e-90d1-ea31bd64edc5",
                                                "text": "Notre cerveau contient six milliards de cellules nerveuses. Chacune d’elles peut se relier à vingt-cinq mille autres. Le nombre des interconnexions possibles a de quoi faire vaciller l’esprit…"
                                            },
                                            {
                                                "example_id": "c126cbee-e5c6-4f2a-a84e-d3e50e57b17f",
                                                "sense_id": "e46bcbb6-77c4-312e-90d1-ea31bd64edc5",
                                                "text": "Les équipements d’interconnexion d’un réseau informatique sont les briques constitutives des réseaux informatiques physiques."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "01ec6ad0-4b12-3b43-9fa0-bef104f21110",
                                        "entry_id": "4663713d-1299-391e-bdac-470c0b5f04e3",
                                        "glosses": [
                                            "Connexion qui intègre un ou plusieurs systèmes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1eeae6ae-a9b9-497e-ab3a-fc05a167558d",
                                                "sense_id": "01ec6ad0-4b12-3b43-9fa0-bef104f21110",
                                                "text": "Le traitement et les fichiers ne font l’objet d’aucune interconnexion, aucun rapprochement ni aucune forme de mise en relation avec d’autres traitements ou fichiers."
                                            },
                                            {
                                                "example_id": "5aadddbf-c909-445f-93cc-de77994341e3",
                                                "sense_id": "01ec6ad0-4b12-3b43-9fa0-bef104f21110",
                                                "text": "Le routage sur internet n’est pas effectué par une instance centralisée, vu la taille du réseau et son organisation. Difficile d’organiser autour d’un seul protocole ce qui est avant tout une interconnexion de réseaux très différents."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
