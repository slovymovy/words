                "senses": [
                    {
                        "sense_id": "d6fb0b02-b05e-3ad8-932f-746020431e8e",
                        "entry_id": "271ba817-e80d-3f24-87a5-dcfd713cb227",
                        "glosses": [
                            "Not explained; of unknown cause or origin."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "8fd8b877-9b6f-4ba2-b21a-31af8b037a01",
                                "sense_id": "d6fb0b02-b05e-3ad8-932f-746020431e8e",
                                "text": "Why this already very fast train should be speeded up still further, when none of the other more easily timed S.R. West of England trains has a single minute pared from its schedule, is unexplained - unless this is a playful dig at the Western Region, most of whose expresses, by reason of additional stops, will be decelerated from the same date."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "255e7ed9-0c10-4cb3-9017-d19b2715ece7",
                        "source_entry_id": "271ba817-e80d-3f24-87a5-dcfd713cb227",
                        "source_sense_id": "d6fb0b02-b05e-3ad8-932f-746020431e8e",
                        "source_sense_description": "not explained",
                        "target_lang_word": "onverklaard",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "onverklaard",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "15eef7f6-1d28-37c7-9414-d8c614d0b150",
                                        "entry_id": "e99bb766-f6d4-31c7-b358-a0090633b02d",
                                        "glosses": [
                                            "wat geen nadere uitleg (nodig) heeft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb57b9f7-9b06-46f6-a530-3af64b89defa",
                                                "sense_id": "15eef7f6-1d28-37c7-9414-d8c614d0b150",
                                                "text": "Een theorie is natuurlijk als ze geen onverklaarde en heel precies afgestemde invoerwaarden (nodig) heeft."
                                            },
                                            {
                                                "example_id": "931c0777-dd49-4928-964b-18c5d99b85ae",
                                                "sense_id": "15eef7f6-1d28-37c7-9414-d8c614d0b150",
                                                "text": "Uit verbondenheid met de kolonie had hij beloofd zo snel mogelijk weer te keren, maar nu liet hij iedereen domweg in de steek en zette hij met zijn onverklaarde wegblijven zelfs heel dat liefdewerk op het spel."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6c4fcbbe-feaa-4274-b98f-d6db16fb2b03",
                        "source_entry_id": "271ba817-e80d-3f24-87a5-dcfd713cb227",
