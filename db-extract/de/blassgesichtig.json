                ],
                "senses": [
                    {
                        "sense_id": "8ecd9ec1-3147-3020-856a-c0273da34cae",
                        "entry_id": "62fee2fe-1092-30ac-941d-9698fb341480",
                        "glosses": [
                            "ein blasses Gesicht habend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "abe526c9-d25f-4516-9b3d-a6e3fafb1072",
                                "sense_id": "8ecd9ec1-3147-3020-856a-c0273da34cae",
                                "text": "„Weil die Kalorien rationiert sind und er sich die meiste Zeit bücken und zusammenkauern muss, sieht Berto wie eine blassgesichtige, rothaarige Stabheuschrecke aus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "24e405a0-0b21-45c2-9f80-58c617d045fd",
                        "source_entry_id": "62fee2fe-1092-30ac-941d-9698fb341480",
                        "source_sense_id": "8ecd9ec1-3147-3020-856a-c0273da34cae",
                        "source_sense_description": "ein blasses Gesicht habend",
                        "target_lang_word": "palefaced",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "palefaced",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "18e63a67-6990-39de-938c-d78f625ed205",
                                        "entry_id": "7e5e58da-d36a-3c5f-9b89-15180363a3c0",
                                        "glosses": [
                                            "Having a pale face."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3646abb6-089c-45ac-b440-73784926c19c",
                                                "sense_id": "18e63a67-6990-39de-938c-d78f625ed205",
                                                "text": "It was soon arranged that I should go with a palefaced youth who had a seat to spare in his tandem, while my friend accompanied our host."
                                            },
                                            {
                                                "example_id": "14c43006-cde7-407b-9436-35ee2f03aa7d",
                                                "sense_id": "18e63a67-6990-39de-938c-d78f625ed205",
                                                "text": "By the side of the tired animal was a pale-faced man, who never once used his worn-out whip, but gave kindly words to his steed in the place of lashes. He was poorly dressed and looked wan and anxious."
                                            }
                                        ]
