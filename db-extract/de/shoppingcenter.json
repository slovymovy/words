                    {
                        "sense_id": "8fff340f-f23e-372a-8e91-53b7624c39ab",
                        "entry_id": "b86070d8-bec9-388d-894a-be515e73a935",
                        "glosses": [
                            "Gebäude oder Gebäudekomplex in dem mehrere Einzelhandelsgeschäfte untergebracht sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc88c612-7683-4b45-bab3-77fdf57bf6f1",
                                "sense_id": "8fff340f-f23e-372a-8e91-53b7624c39ab",
                                "text": "Die großen Shoppingcenter am Stadtrand sind eine große Konkurrenz für die kleinen Einzelhändler in der Innenstadt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
