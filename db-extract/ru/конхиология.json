                    {
                        "translation_id": "707f6b9d-6824-44d9-af0d-cb28d3f6288a",
                        "source_entry_id": "a7b4f989-738b-3a30-8339-85d8853a6ddb",
                        "target_lang_word": "conchyliologie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "conchyliologie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ac0f5dc6-9dbe-3065-aeb6-ae913e1928da",
                                        "entry_id": "3136f197-d9a8-3411-be1e-014760f5570f",
                                        "glosses": [
                                            "Branche de la malacologie consacrée à l’étude des coquillages de mer ou d’eau douce."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7bb8d205-5381-4275-b458-64086ac178df",
                                                "sense_id": "ac0f5dc6-9dbe-3065-aeb6-ae913e1928da",
                                                "text": "J’ai donné la même attention à l’étude des mollusques fossiles qu’à celle des mollusques actuels ; il n’y a pas, en effet, deux conchyliologies, et l’examen isolé des formes vivantes ne donnerait que la plus pauvre idée du type mollusque."
                                            },
                                            {
                                                "example_id": "0013a41d-ae71-448f-b704-6accf14512c4",
                                                "sense_id": "ac0f5dc6-9dbe-3065-aeb6-ae913e1928da",
                                                "text": "Les amateurs instruits de la conchyliologie verront avec grand plaisir le cabinet de M. Jacob, à Seversham."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
