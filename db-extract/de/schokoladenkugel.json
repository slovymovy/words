                "senses": [
                    {
                        "sense_id": "c7da623f-4cb2-3fff-abe6-b6366a6686a8",
                        "entry_id": "fcdfe90e-110e-3ad5-8004-8431567ac7cb",
                        "glosses": [
                            "Süßware aus Schokolade in Form einer Kugel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ac2acdd-db2d-4c86-a327-b414af780acc",
                                "sense_id": "c7da623f-4cb2-3fff-abe6-b6366a6686a8",
                                "text": "„Vor Schreck achtete Katharina nicht auf ihr Eis und die Schokoladenkugel purzelte aus ihrer Waffel direkt auf ihre blütenweiße Reiterbluse.“"
                            },
                            {
                                "example_id": "622bfb3d-833d-4449-b0ff-5e2aee0dac7f",
                                "sense_id": "c7da623f-4cb2-3fff-abe6-b6366a6686a8",
                                "text": "„Einem Jungen fällt eine Schokoladenkugel aus seiner Waffel und er heult, bis seine Mutter ihm ihr Eis gibt.“"
                            },
                            {
                                "example_id": "f2701d94-21fa-47fc-ba86-4499eb702e24",
                                "sense_id": "c7da623f-4cb2-3fff-abe6-b6366a6686a8",
                                "text": "„Sie öffnet die Kordel und fischt eine grüne Schokoladenkugel sowie einen weiteren Zettel aus ihrem Beutel.“"
                            },
                            {
                                "example_id": "00c18cf4-c76d-4522-870f-7bd467a9f21c",
                                "sense_id": "c7da623f-4cb2-3fff-abe6-b6366a6686a8",
                                "text": "„Sie hängt den Teebeutel in die Kanne und schnippt die Schokoladenkugel von der Sachertorte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
