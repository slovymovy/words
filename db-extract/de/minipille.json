                                "sense_id": "eb2109ed-8d92-3782-b478-3422bbc96fdc",
                                "text": "„Die Minipille enthält eine geringe Menge an Gestagen (0,075mg Norgestrel oder 0,35mg Norethindon) und kein Östrogen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
