                ],
                "senses": [
                    {
                        "sense_id": "dee3019b-c80f-3857-8811-f6dd79c409fb",
                        "entry_id": "5cf623f6-11f0-377f-b8cc-e6b8526908b5",
                        "glosses": [
                            "in einem Garten oder einer Gartenkolonie von Laubenpiepern errichtetes (kleines) Haus zum Beispiel zum vorübergehenden Aufenthalt (beispielsweise im Sommer) oder zur Aufbewahrung von Gartenutensilien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "588bc563-d9b9-49e8-87ec-8fd6c3b0d659",
                                "sense_id": "dee3019b-c80f-3857-8811-f6dd79c409fb",
                                "text": "Ich wohne im Sommer in meinem Gartenhäuschen am Stadtrand."
                            },
                            {
                                "example_id": "4e6b8373-221d-43f1-9368-364a68138f93",
                                "sense_id": "dee3019b-c80f-3857-8811-f6dd79c409fb",
                                "text": "„Letztes Jahr investierte [Thomas Hibbeler] 1.500 Euro in ein neues Dach für sein Gartenhäuschen.“"
                            },
                            {
                                "example_id": "5198a363-ca83-488d-a41d-9fe1ef0f3412",
                                "sense_id": "dee3019b-c80f-3857-8811-f6dd79c409fb",
                                "text": "„Aktuell bauen Wespen und Hornissen ihre Nester auch in Rolladenkästen, Dachböden oder Gartenhäuschen.“"
                            },
                            {
                                "example_id": "0aebcdd6-a208-4514-b6d2-66161175aee3",
                                "sense_id": "dee3019b-c80f-3857-8811-f6dd79c409fb",
                                "text": "„Je nach Police sind selbst Schäden an Gartenhäuschen und Carports eingeschlossen.“"
                            },
                            {
                                "example_id": "8d066c15-fcc1-403a-9f7e-1ea2604d4f15",
                                "sense_id": "dee3019b-c80f-3857-8811-f6dd79c409fb",
                                "text": "„Ein Haus, einen Carport oder ein Gartenhäuschen dürfen Grundbesitzer nun [in den im letzten Jahr ausgewiesenen elf Überschwemmungsgebieten von Hamburg] nicht mehr bauen […]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
