                                    {
                                        "sense_id": "5aa977fd-bc84-37e9-b592-519d8c4e834d",
                                        "entry_id": "703ca70e-790c-3e84-a941-9edb9938bc7d",
                                        "glosses": [
                                            "Greatly diminished size or form; reduced scale."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b41dfbf7-6b70-3ab4-a17a-9ad054e489b5",
                                        "entry_id": "703ca70e-790c-3e84-a941-9edb9938bc7d",
                                        "glosses": [
                                            "A small version of something; a model of reduced scale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e9b9188d-8206-4d10-8e42-4fc149882753",
                                                "sense_id": "b41dfbf7-6b70-3ab4-a17a-9ad054e489b5",
                                                "text": "There was a miniature of a whaling ship in a glass bottle over the mantelpiece."
                                            },
                                            {
                                                "example_id": "ab91df49-0bf5-493a-8600-e8febff3254c",
                                                "sense_id": "b41dfbf7-6b70-3ab4-a17a-9ad054e489b5",
                                                "text": "The twelve days from Christmas to Epiphany are conceived as a miniature of the whole year, the character of each particular day answering to the character of a particular month."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "86c8440f-b317-3d53-a5d7-170ee8f3bd51",
                                        "entry_id": "703ca70e-790c-3e84-a941-9edb9938bc7d",
                                        "glosses": [
                                            "A small, highly detailed painting, a portrait miniature."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb25f0a5-e5ba-45e3-9c21-3a803fc836a3",
                                                "sense_id": "86c8440f-b317-3d53-a5d7-170ee8f3bd51",
                                                "text": "The miniature was a picture of Leo's Greek mother - a lovely, dark-eyed creature."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d3d77b7-53dc-33e8-9310-49eb73d508aa",
                                        "entry_id": "703ca70e-790c-3e84-a941-9edb9938bc7d",
                                        "glosses": [
                                            "The art of painting such highly detailed miniature works."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "af8caca4-1dc6-33e9-9f27-77019ae531da",
                                        "entry_id": "703ca70e-790c-3e84-a941-9edb9938bc7d",
                                        "glosses": [
                                            "An illustration in an illuminated manuscript."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "590bb731-0a5e-3b29-ab3a-b30f450cf50f",
                                        "entry_id": "703ca70e-790c-3e84-a941-9edb9938bc7d",
                                        "glosses": [
                                            "A musical composition which is short in duration."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5f0a287-33d3-4982-a8d6-5d2931397bd6",
                                                "sense_id": "590bb731-0a5e-3b29-ab3a-b30f450cf50f",
                                                "text": "Sacha composed a miniature for strings as a final project at the conservatory."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "da9d2831-814b-3eb7-ab49-1718a8839fc4",
                                        "entry_id": "703ca70e-790c-3e84-a941-9edb9938bc7d",
                                        "glosses": [
                                            "A chess game which is concluded with very few moves."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e9a95021-7a07-3fc9-a0df-c0f0d3aed618",
                                        "entry_id": "703ca70e-790c-3e84-a941-9edb9938bc7d",
                                        "glosses": [
                                            "A token in a game representing a unit or character."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1901568a-50b3-420f-aabc-07e00427b1fc",
                                                "sense_id": "e9a95021-7a07-3fc9-a0df-c0f0d3aed618",
                                                "text": "Jack had dozens of miniatures of Napoleonic footsoldiers painted in detailed period regalia for his wargames."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5d5e7861-05ed-3197-99f2-7886c78bf717",
                                        "entry_id": "703ca70e-790c-3e84-a941-9edb9938bc7d",
                                        "glosses": [
                                            "Lettering in red; rubric distinction."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6536eb31-b21e-3ea5-a29a-f07895bf6419",
                                        "entry_id": "703ca70e-790c-3e84-a941-9edb9938bc7d",
                                        "glosses": [
                                            "A particular feature or trait."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "969758ee-33c7-4ad2-b312-0e195788bc2a",
                                                "sense_id": "6536eb31-b21e-3ea5-a29a-f07895bf6419",
                                                "text": "There's no miniature / In her fair face, but is a copious theme / Which would, discoursed at large of, make a volume."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "miniature",
