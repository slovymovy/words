                        "sense_id": "5fb9a09f-9d60-3b40-a9e0-aa785a5414d4",
                        "entry_id": "2cd076ea-9024-3bb5-9710-2e34844a542a",
                        "glosses": [
                            "musicology (the scientific study of music)"
                        ],
                        "tags": [
                            "feminine",
                            "no-diminutive"
                        ],
                        "examples": [
                            {
                                "example_id": "9c17b10e-5c02-44c9-8f60-09508adce49f",
                                "sense_id": "5fb9a09f-9d60-3b40-a9e0-aa785a5414d4",
                                "text": "Met de benaming godsdienstwetenschap heeft men niet willen beslissen, dat de godsdienst eene wetenschap is, evenmin als het bestaan eener muziekwetenschap de muziek tot eene wetenschap maakt.",
                                "translation": "With the name religiology one does not attempt to decree that religion is a science, just like the existence of musicology does not make music a science.",
                                "english": "With the name religiology one does not attempt to decree that religion is a science, just like the existence of musicology does not make music a science."
                            },
                            {
                                "example_id": "9b2a56e4-790c-4981-b1a2-76c8814ca459",
                                "sense_id": "5fb9a09f-9d60-3b40-a9e0-aa785a5414d4",
                                "text": "De muziekwetenschap wint in ons land aan invloed, aan gezag en aan jeugdige beoefenaren.",
                                "translation": "Musicology is gaining influence, status and young practicioners in our country.",
                                "english": "Musicology is gaining influence, status and young practicioners in our country."
                            },
                            {
                                "example_id": "12f61d5a-5c26-4f00-9c8d-27e9acce0216",
                                "sense_id": "5fb9a09f-9d60-3b40-a9e0-aa785a5414d4",
                                "text": "Hij is dan ook een van degenen die de grondslagen legde voor de vergelijkende muziekwetenschap, die in de twintigste eeuw etnomusicologie zou gaan heten.",
                                "translation": "He is also one of those that formed the foundation for the comparative musicology, which would start to be called ethnomusicology in the twentieth century.",
                                "english": "He is also one of those that formed the foundation for the comparative musicology, which would start to be called ethnomusicology in the twentieth century."
                            }
                        ]
                    }
                ],
