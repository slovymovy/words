                "senses": [
                    {
                        "sense_id": "bfec8f11-e383-3be0-99ab-e0dac422b337",
                        "entry_id": "2ddef291-212f-3b80-84d3-2a6faa7675fe",
                        "glosses": [
                            "Fruit du cacaoyer de forme ovoïde et cannelée. C’est une sorte de baie qui contient de 15 à 40 graines."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed71d9a2-51ad-48a8-8d8c-cff2123d58f6",
                                "sense_id": "bfec8f11-e383-3be0-99ab-e0dac422b337",
                                "text": "Chaque année, en effet, le cacaoyer ne produit que 40 à 50 fruits, les « cabosses »."
                            },
                            {
                                "example_id": "5f57d0e6-822c-41b6-9f89-a071ebb71c45",
                                "sense_id": "bfec8f11-e383-3be0-99ab-e0dac422b337",
                                "text": "Lorsque l’on ouvre une cabosse, les fèves qui s’y trouvent sont blanches et n’ont pas du tout le goût de chocolat. Ce sont les étapes de fermentation puis de torréfaction, comme pour le café, qui lui donneront ses arômes et sa couleur."
                            }
                        ]
                    },
                    {
                        "sense_id": "4cc470bb-2be1-3753-8195-6e9bf88df6fe",
                        "entry_id": "2ddef291-212f-3b80-84d3-2a6faa7675fe",
                        "glosses": [
                            "Fruit du cacaoyer de forme ovoïde et cannelée. C’est une sorte de baie qui contient de 15 à 40 graines.",
                            "Épi de maïs."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": []
                    }
