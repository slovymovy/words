                    }
                ],
                "senses": [
                    {
                        "sense_id": "c6fad8ca-6b2d-301a-9d84-1ca49ef7677d",
                        "entry_id": "4c313afa-8bd6-38de-907d-228f632b641f",
                        "glosses": [
                            "подвергать (подвергнуть) суду Линча, то есть самосуду и убийству толпой, как правило через повешение"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ecd8d2f9-a0f9-48cb-aad7-064e700b76bf",
                                "sense_id": "c6fad8ca-6b2d-301a-9d84-1ca49ef7677d",
                                "text": "Вчера вечером многотысячная толпа линчевала Негра, обвинявшегося в насилии над молодой девушкой, и сожгла его труп."
                            },
                            {
                                "example_id": "76706d5c-af92-44de-b0e3-41f2ba89a12f",
                                "sense_id": "c6fad8ca-6b2d-301a-9d84-1ca49ef7677d",
                                "text": "— В правилах воспрещается, — заявил проводник, — уходите. Усатый попятился к выходу, но тут в конфликт вмешался великий комбинатор. — Что же это вы, папаша, — сказал он проводнику, — пассажиров не надо линчевать без особой необходимости."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "aa580b4f-95f6-462a-8ff7-40474d316610",
                        "source_entry_id": "4c313afa-8bd6-38de-907d-228f632b641f",
                        "source_sense_id": "c6fad8ca-6b2d-301a-9d84-1ca49ef7677d",
                        "target_lang_word": "lynch",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lynch",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "226ce736-4484-3814-8265-654a0e3aaf7f",
                                        "entry_id": "a43dfd81-edc0-3501-a3bc-df71616010ce",
                                        "glosses": [
                                            "To execute (somebody) without a proper legal trial or procedure, especially by hanging and backed by a mob."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7816f5f1-c717-4a08-937e-238d137bd000",
                                                "sense_id": "226ce736-4484-3814-8265-654a0e3aaf7f",
                                                "text": "Public anger erupted. Soldiers were lynched in the streets including young recruits proven to have been deceived by their generals about the true intentions of the attack."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e7f18fb7-8007-3dbd-a5de-5f8f1aae5511",
                                        "entry_id": "a43dfd81-edc0-3501-a3bc-df71616010ce",
                                        "glosses": [
                                            "To castigate severely."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "colloquial",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c74967f8-b80c-49ec-ae5e-f88e78a93fcc",
                                                "sense_id": "e7f18fb7-8007-3dbd-a5de-5f8f1aae5511",
                                                "text": "I telephoned Bill Brandon in Oxford and begged him to get the new refrigeration unit into production before I got lynched."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "lynch",
                                "target_lang_code": "en",
                                "target_senses": [
