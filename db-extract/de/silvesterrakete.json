                        "examples": [
                            {
                                "example_id": "ea30fa4e-3262-4f9a-9332-3195c71a47e9",
                                "sense_id": "0352105a-487e-3c17-8323-bb456970f55e",
                                "text": "„Der Mann war geladen wie eine Silvesterrakete um kurz vor zwölf.“"
                            },
                            {
                                "example_id": "7a618967-1c11-4f9d-82da-aefac405c071",
                                "sense_id": "0352105a-487e-3c17-8323-bb456970f55e",
                                "text": "„Eine 60-jährige Frau ist in Salzgitter von einer Silvesterrakete auf der Straße lebensgefährlich verletzt worden.“"
                            },
                            {
                                "example_id": "296b6caf-3462-4098-8bf3-4114165fc12f",
                                "sense_id": "0352105a-487e-3c17-8323-bb456970f55e",
                                "text": "„Der Brand in dem Mehrfamilienhaus ist nach ersten Erkenntnissen durch eine Silvesterrakete ausgelöst worden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
