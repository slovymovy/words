                                        "sense_id": "91bb7bad-c26b-3ea4-9f75-01a084db1521",
                                        "entry_id": "7a80b609-82fc-35e3-aaff-b6c33521aec6",
                                        "glosses": [
                                            "Forme intermédiaire entre le colloïde et le cristal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6ed3902e-9fdb-4305-8cad-62130b9b5b1d",
                                                "sense_id": "91bb7bad-c26b-3ea4-9f75-01a084db1521",
                                                "text": "Les concepts de colloïde et de cristalloïde correspondent à des états de la matière, non à des substances. Un corps peut passer de l'état colloïdal à l'état cristalloïde. La silice notamment. D'où, très pragmatiquement, l'importance de spécifier - notamment lors d'un achat - que l'on souhaite par exemple une silice colloïdale ou bien une silice cristalloïde."
                                            },
                                            {
                                                "example_id": "e3fb0378-09c5-494e-ba39-b00b77b49b5c",
                                                "sense_id": "91bb7bad-c26b-3ea4-9f75-01a084db1521",
                                                "text": "Si la solution mise dans le dialyseur contient un cristalloïde, le corps dissous diffuse rapidement de la solution vers l’eau pure."
                                            }
                                        ]
                                    }
                                ]
                            }
