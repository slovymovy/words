                                "target_senses": [
                                    {
                                        "sense_id": "12504e71-c173-336c-9202-4521c12bfb1f",
                                        "entry_id": "6a95b198-e6a4-3162-89b1-76b6a09ab6e2",
                                        "glosses": [
                                            "A style of malt loaf bread (sweet, chewy, caramel-colored leavened bread made with malted wheat), traditionally produced across the UK and Ireland but today eaten mainly in Northern Ireland."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d291e4c-5fad-4c7a-89dc-f0a6b170e3e7",
                                                "sense_id": "12504e71-c173-336c-9202-4521c12bfb1f",
                                                "text": "'Slip a few slices of Veda in that package you're making up for your Boy. In Damp-Proof Packet . . . the ONLY bread that reaches the Trenches fresh and sweet'"
                                            },
                                            {
                                                "example_id": "d5e91dad-6df6-415a-a668-c09dab15176d",
                                                "sense_id": "12504e71-c173-336c-9202-4521c12bfb1f",
                                                "text": "One of the best and least known mixtures for filling sandwiches is green butter, and it is particularly good between slices of Veda bread."
                                            },
                                            {
                                                "example_id": "e82cc215-109c-4a28-a448-cb18c92a5361",
                                                "sense_id": "12504e71-c173-336c-9202-4521c12bfb1f",
                                                "text": "[…] Toasted veda! [Normal] What d'fuck did you mention that for? Frig me, I would kill orphaned childer d'get [some]."
                                            },
                                            {
                                                "example_id": "81ca650a-fbce-40eb-94dc-0eb74acd5040",
                                                "sense_id": "12504e71-c173-336c-9202-4521c12bfb1f",
                                                "text": "'I've heard all about your so-called photograph. It's not my son. And if you even think about printing it, I'll have an injunction on you faster than you can toast Veda. I will sue you […]'"
                                            },
                                            {
                                                "example_id": "d56ae3dc-7f57-4591-901f-3ef04ec77145",
                                                "sense_id": "12504e71-c173-336c-9202-4521c12bfb1f",
                                                "text": "[…] A big fried mushroom between two toasted slices of Veda, with the butter melting and running down to your wrist a right royal feast."
                                            },
                                            {
                                                "example_id": "d2ecd146-0246-4bd5-a8ac-314cbca5633c",
                                                "sense_id": "12504e71-c173-336c-9202-4521c12bfb1f",
                                                "text": "Toasted Veda with strawberry jam, one of my favourite snacks"
                                            },
                                            {
                                                "example_id": "a6464ba2-9808-4627-9901-cc39d55f556d",
                                                "sense_id": "12504e71-c173-336c-9202-4521c12bfb1f",
                                                "text": "I hate waste too, which is my major issue with this scenario, but last nights pasta bake is not winning the fight over toasted Veda and cheese today 😑 still maybe the dog will like some of it over her biscuits as a treat 🤔"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
