                        ],
                        "form": "den Spätnachmittag"
                    },
                    {
                        "form_id": "5431e646-a5b0-45ea-9585-658c015242bd",
                        "entry_id": "a2e25393-1075-322c-8bf8-f396eecd584b",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Spätnachmittage"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1a17ebb6-ff40-378f-865d-fc8c37352a8a",
                        "entry_id": "a2e25393-1075-322c-8bf8-f396eecd584b",
                        "glosses": [
                            "nicht genau festgelegter, unscharfer Zeitraum am Ende des Nachmittages und am Beginn des Abends (etwa zwischen 17 und 18 Uhr)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "84e723f8-6115-4599-9b3b-6205d3f2abe2",
                                "sense_id": "1a17ebb6-ff40-378f-865d-fc8c37352a8a",
                                "text": "Verlegen wir unser Treffen auf den Spätnachmittag?"
                            },
                            {
                                "example_id": "bd6e299c-77a6-4516-8772-52b6c8851f09",
                                "sense_id": "1a17ebb6-ff40-378f-865d-fc8c37352a8a",
                                "text": "„Am Spätnachmittag warten sie auf der Straße.“"
                            },
                            {
                                "example_id": "ea0be434-0831-400c-8d94-9a955ac31893",
                                "sense_id": "1a17ebb6-ff40-378f-865d-fc8c37352a8a",
                                "text": "„Ich saß die Sache genauso aus und schwatzte mit ihnen, um die Zeit totzuschlagen, bis am Spätnachmittag alle an Bord waren.“"
                            },
                            {
                                "example_id": "c0618a22-8f60-47db-bcb3-a1b2e0cb7dff",
                                "sense_id": "1a17ebb6-ff40-378f-865d-fc8c37352a8a",
                                "text": "„Die Terrasse war menschenvoll; selbst am Spätnachmittag noch der typische Kaffee-Rummel, mit klirrenden Gläsern und Tassen.“"
                            },
                            {
                                "example_id": "4e3e0c34-d484-4a7c-922e-4c19bc7ff4b6",
                                "sense_id": "1a17ebb6-ff40-378f-865d-fc8c37352a8a",
                                "text": "„Roths Post wurde am Spätnachmittag gebracht, wenn er es versäumt hatte, vorher zum Postamt zu gehen, doch inzwischen verzichtete er nur ungern auf das morgendliche Ritual, die Post abzuholen, im Cornwall-Bridge-Gemischtwarenladen eine Zeitung zu kaufen und sich an sonnigen Tagen zu einem Picknicktisch am Housatonic zu begeben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
