{
    "word_family": [
        "bunt"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2e7bd483-0333-30e3-b117-e8ca8bd0d427",
                    "sense_definition": "Strips of material used as festive decoration, especially in the colours of the national flag.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "festive_decorations",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The streets were decorated with colorful <w>bunting</w> for the King's coronation.",
                            "target_lang_translations": {
                                "ru": "Улицы были украшены разноцветными <w>гирляндами из флажков</w> к коронации короля."
                            }
                        },
                        {
                            "text": "We hung festive <w>bunting</w> across the garden for the summer party.",
                            "target_lang_translations": {
                                "ru": "Мы развесили праздничные <w>флажки</w> по всему саду для летней вечеринки."
                            }
                        }
                    ],
                    "synonyms": [
                        "streamers",
                        "garland"
                    ],
                    "common_phrases": [
                        "festive bunting",
                        "hang bunting"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ленты или гирлянды из флажков, используемые в качестве праздничного украшения, особенно в цветах национального флага."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гирлянда из флажков",
                                "target_lang_sense_clarification": "праздничное украшение"
                            },
                            {
                                "target_lang_word": "флажки",
                                "target_lang_sense_clarification": "декоративные флажки на ленте"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e8361093-eb67-3a62-826e-644602f39d7a",
                    "sense_definition": "Flags considered collectively as a group.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "festive_decorations",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ship was decked out in bright <w>bunting</w> to welcome the returning sailors.",
                            "target_lang_translations": {
                                "ru": "Корабль был украшен яркими <w>флагами расцвечивания</w>, чтобы поприветствовать возвращающихся моряков."
                            }
                        },
                        {
                            "text": "A display of patriotic <w>bunting</w> covered the front of the town hall.",
                            "target_lang_translations": {
                                "ru": "Фасад ратуши был украшен патриотическими <w>флагами</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "flags",
                        "banners"
                    ],
                    "common_phrases": [
                        "patriotic bunting"
                    ],
                    "target_lang_definitions": {
                        "ru": "Флаги, рассматриваемые коллективно как группа или элемент праздничного убранства."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "флаги",
                                "target_lang_sense_clarification": "совокупность флагов для украшения"
                            },
                            {
                                "target_lang_word": "расцвечивание флагами",
                                "target_lang_sense_clarification": "праздничное убранство"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "530adc38-252b-3b32-acc8-35db2ba68b81",
                    "sense_definition": "A thin cloth of woven wool from which flags are made.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "textiles",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sailmaker selected a durable wool <w>bunting</w> to construct the new signal flags.",
                            "target_lang_translations": {
                                "ru": "Мастер по парусам выбрал прочный шерстяной <w>флагдук</w> для изготовления новых сигнальных флагов."
                            }
                        },
                        {
                            "text": "Historically, naval flags were made of lightweight <w>bunting</w> to ensure they could fly in light winds.",
                            "target_lang_translations": {
                                "ru": "Исторически морские флаги изготавливались из легкого <w>флагдука</w>, чтобы они могли развеваться даже при слабом ветре."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Тонкая шерстяная ткань редкого переплетения, из которой изготавливают флаги."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "флагдук",
                                "target_lang_sense_clarification": "шерстяная ткань для флагов"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4bd91f64-f983-3a6c-865f-f12d79cdc654",
                    "sense_definition": "Any of various small songbirds of the genus Emberiza, typically having short bills and brown or gray plumage.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "birds",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We spotted a rare corn <w>bunting</w> singing from the top of the hedgerow.",
                            "target_lang_translations": {
                                "ru": "Мы заметили редкую просяную <w>овсянку</w>, поющую на вершине живой изгороди."
                            }
                        },
                        {
                            "text": "The reed <w>bunting</w> is commonly found in wetland habitats across Europe.",
                            "target_lang_translations": {
                                "ru": "Камышовая <w>овсянка</w> часто встречается в водно-болотных угодьях по всей Европе."
                            }
                        }
                    ],
                    "common_phrases": [
                        "reed bunting",
                        "corn bunting"
                    ],
                    "target_lang_definitions": {
                        "ru": "Любая из различных мелких певчих птиц семейства овсянковых, обычно с коротким клювом и бурым или серым оперением."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "овсянка",
                                "target_lang_sense_clarification": "птица семейства воробьиных"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "876c7ffb-a2b0-3653-ad50-62a4f93a9f91",
                    "sense_definition": "A warm, often hooded infant garment used as outerwear or sleepwear.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "clothing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She bundled the newborn into a cozy baby <w>bunting</w> before going out into the snow.",
                            "target_lang_translations": {
                                "ru": "Она укутала новорожденного в уютный детский <w>спальный мешок</w>, прежде чем выйти на заснеженную улицу."
                            }
                        },
                        {
                            "text": "This fleece <w>bunting</w> keeps the infant warm during winter stroller rides.",
                            "target_lang_translations": {
                                "ru": "Этот флисовый <w>конверт</w> согревает младенца во время зимних прогулок в коляске."
                            }
                        }
                    ],
                    "synonyms": [
                        "sleepsack"
                    ],
                    "common_phrases": [
                        "baby bunting"
                    ],
                    "target_lang_definitions": {
                        "ru": "Теплый, часто с капюшоном, детский спальный мешок или комбинезон, используемый как верхняя одежда или одежда для сна."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "детский спальный мешок",
                                "target_lang_sense_clarification": "теплый конверт для младенца"
                            },
                            {
                                "target_lang_word": "конверт для новорожденного",
                                "target_lang_sense_clarification": "утепленный конверт-комбинезон"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a70a37ef-1b31-3583-9ff1-04949fb31e87",
                    "sense_definition": "A pushing or shoving action.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "actions",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The playful <w>bunting</w> of the calves in the field was amusing to watch.",
                            "target_lang_translations": {
                                "ru": "За игривым <w>боданием</w> телят в поле было забавно наблюдать."
                            }
                        },
                        {
                            "text": "With a gentle <w>bunting</w> motion, the goat nudged its kid forward.",
                            "target_lang_translations": {
                                "ru": "Легким <w>толчком</w> головы коза подтолкнула своего козленка вперед."
                            }
                        }
                    ],
                    "synonyms": [
                        "nudging",
                        "shoving",
                        "pushing"
                    ],
                    "target_lang_definitions": {
                        "ru": "Толкание или бодание головой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бодание",
                                "target_lang_sense_clarification": "толчок головой"
                            },
                            {
                                "target_lang_word": "подталкивание",
                                "target_lang_sense_clarification": "легкий толчок"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5928e36a-a5de-337a-b00e-1c8bbb7e3b0c",
                    "sense_definition": "A strong timber or stout prop used in mining or construction.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "construction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The miners reinforced the shaft ceiling with a heavy wooden <w>bunting</w>.",
                            "target_lang_translations": {
                                "ru": "Шахтеры укрепили свод шахты тяжелой деревянной <w>стойкой</w>."
                            }
                        },
                        {
                            "text": "They secured the excavation walls using a thick <w>bunting</w> to prevent collapse.",
                            "target_lang_translations": {
                                "ru": "Они укрепили стены котлована толстой <w>подпоркой</w> для предотвращения обрушения."
                            }
                        }
                    ],
                    "synonyms": [
                        "prop",
                        "timber",
                        "support"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прочное бревно или подпорка, используемая в горном деле или строительстве."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стойка",
                                "target_lang_sense_clarification": "крепежная крепь, подпорка"
                            },
                            {
                                "target_lang_word": "подпорка",
                                "target_lang_sense_clarification": "деревянная опора"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "664ed15c-f175-3e7e-99ae-bc3a8dbe0361",
                    "sense_definition": "An old boys' game, played with sticks and a small piece of wood.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "games",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children in the village used to play <w>bunting</w> in the streets during the summer.",
                            "target_lang_translations": {
                                "ru": "Летом деревенские дети играли на улицах в <w>чижа</w>."
                            }
                        },
                        {
                            "text": "He wrote about playing <w>bunting</w> and other traditional games of his youth.",
                            "target_lang_translations": {
                                "ru": "Он писал о том, как играл в <w>чижа</w> и другие традиционные игры своей юности."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Refers to an old traditional game"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Старинная мальчишеская игра, в которую играли палками и небольшим кусочком дерева."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чиж",
                                "target_lang_sense_clarification": "старинная детская игра"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "441aa227-5618-3942-8d7a-762d673128a1",
                    "sense_definition": "Present participle and gerund of <w>bunt</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The batter succeeded in <w>bunting</w> the ball to advance the runner to second base.",
                            "target_lang_translations": {
                                "ru": "Бьющему удалось <w>направить мяч коротким ударом</w>, чтобы продвинуть раннера на вторую базу."
                            }
                        },
                        {
                            "text": "The goat was <w>bunting</w> its head against the fence to get our attention.",
                            "target_lang_translations": {
                                "ru": "Коза <w>бодала</w> забор головой, чтобы привлечь наше внимание."
                            }
                        }
                    ],
                    "common_phrases": [
                        "bunting the ball"
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени и герундий от глагола bunt (бодать, делать короткий удар в бейсболе)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бодающий",
                                "target_lang_sense_clarification": "о действии животного"
                            },
                            {
                                "target_lang_word": "выполнение банта",
                                "target_lang_sense_clarification": "в бейсболе"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "32d658cd-dd08-3530-9d2e-59ef8e94f480",
                    "sense_definition": "A surname transferred from the nickname.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The local library was named after the prominent historian, Professor <w>Bunting</w>.",
                            "target_lang_translations": {
                                "ru": "Местная библиотека была названа в честь выдающегося историка, профессора <w>Бантинга</w>."
                            }
                        },
                        {
                            "text": "We invited Mr. <w>Bunting</w> to speak at our annual community meeting.",
                            "target_lang_translations": {
                                "ru": "Мы пригласили мистера <w>Бантинга</w> выступить на нашем ежегодном собрании общины."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "A family name"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия, произошедшая от прозвища Бантинг."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Бантинг",
                                "target_lang_sense_clarification": "английская фамилия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}