                    {
                        "sense_id": "9203a7d9-f47a-3802-86be-eda692182acf",
                        "entry_id": "0f7f9214-be27-3954-a0aa-a1509c8894df",
                        "glosses": [
                            "Beschaffung von geheimen Informationen von fremdem Organisationen, Staaten oder dergleichen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e49bd59-fc45-4015-b20c-f7cd7592d789",
                                "sense_id": "9203a7d9-f47a-3802-86be-eda692182acf",
                                "text": "„In Turin wird der weltberühmte italienische Fallschirmspringer Giorgio Rinaldi unter dem Verdacht der Spionage festgenommen.“"
                            },
                            {
                                "example_id": "9377055b-df55-45df-8e73-8ffc85903f5f",
                                "sense_id": "9203a7d9-f47a-3802-86be-eda692182acf",
                                "text": "„In Norwegen wurden Jahnn und Harms der Spionage verdächtigt.“"
                            },
                            {
                                "example_id": "f7d5d3e7-e54f-424f-8f65-97a7697a31c4",
                                "sense_id": "9203a7d9-f47a-3802-86be-eda692182acf",
                                "text": "„Martha Dodd kehrt 1937 in die USA zurück, zusammen mit ihrem deprimierten und desillusionierten Vater, und gerät noch während des Kriegs in den Verdacht der Spionage für die Sowjetunion.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2b0d035d-3163-412a-8c83-08c0205930cb",
                        "source_entry_id": "0f7f9214-be27-3954-a0aa-a1509c8894df",
                        "source_sense_id": "9203a7d9-f47a-3802-86be-eda692182acf",
                        "source_sense_description": "Beschaffung von geheimen Informationen von fremdem Organisationen, Staaten oder dergleichen",
                        "target_lang_word": "espionage",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "espionage",
