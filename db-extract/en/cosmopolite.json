                                    {
                                        "sense_id": "3bf7d94f-5f4c-354b-a90f-ae7ce1134592",
                                        "entry_id": "87bad403-91b5-3c28-93a1-e6bb967b470c",
                                        "glosses": [
                                            "Mensch, der sich der gesamten Menschheit verbunden fühlt"
                                        ],
                                        "tags": [],
