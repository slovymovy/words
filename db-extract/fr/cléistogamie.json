                "senses": [
                    {
                        "sense_id": "6f28e5ed-061d-3e45-a292-2581cceadee6",
                        "entry_id": "d370ac0a-d8de-30f3-b723-e32590e2071a",
                        "glosses": [
                            "Reproduction de certaines plantes par autopollinisation avec des fleurs qui ne s’ouvrent pas."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "27a8c49b-2cb3-4131-82a7-2a9cca090a14",
                                "sense_id": "6f28e5ed-061d-3e45-a292-2581cceadee6",
                                "text": "La cléistogamie est une forme d’autofécondation due au fait que la fleur ne s’ouvre pas."
                            },
                            {
                                "example_id": "94a9c6e9-8e31-4fa9-8798-9b93303cb585",
                                "sense_id": "6f28e5ed-061d-3e45-a292-2581cceadee6",
                                "text": "L’autogamie extrême et exclusive est pratiquée dans des fleurs qui ne s’épanouissent pas ; c’est le phénomène de la cléistogamie (de Cleistos = fermé)."
                            },
                            {
                                "example_id": "b432625e-1319-47c1-86fe-a8cf33035307",
                                "sense_id": "6f28e5ed-061d-3e45-a292-2581cceadee6",
                                "text": "On peut même parler de cléistogamie quand les populations présentent des corolles réduites (voir F. officinalis) : la taille étant un critère de détermination important, la détermination s'en trouve compliquée."
                            }
                        ]
                    }
                ],
