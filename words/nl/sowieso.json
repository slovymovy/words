                                "target_lang_sense_clarification": "неизбежно; как необходимое условие"
                            },
                            {
                                "target_lang_word": "автоматически",
                                "target_lang_sense_clarification": "как прямое следствие"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "koniecznie",
                                "target_lang_sense_clarification": "nieuchronnie lub jako warunek konieczny"
                            },
                            {
                                "target_lang_word": "automatycznie",
                                "target_lang_sense_clarification": "jako bezpośredni rezultat"
                            },
                            {
                                "target_lang_word": "sam z siebie",
                                "target_lang_sense_clarification": "z definicji, sam przez się"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "forcément",
                                "target_lang_sense_clarification": "de manière inévitable ou obligatoire"
                            },
                            {
                                "target_lang_word": "nécessairement",
                                "target_lang_sense_clarification": "par nécessité logique"
                            },
                            {
                                "target_lang_word": "automatiquement",
                                "target_lang_sense_clarification": "par voie de conséquence immédiate"
                            }
                        ]
                    }
                }
            ]
        }
    ]
