                        "cross_references": [
                            {
                                "target_word": "traditionalist",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "86776994-cc11-3479-9b7e-82474f7f9ed8",
                                        "entry_id": "4f06682b-f6f6-3d17-8509-89b0e2211121",
                                        "glosses": [
                                            "iemand die wil vasthouden aan de opvattingen en handelwijzen die we van voorgangers hebben geleerd"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "986b37fc-1b73-4b90-b1ad-070623abc4c6",
                                                "sense_id": "86776994-cc11-3479-9b7e-82474f7f9ed8",
                                                "text": "Heppener hield in de jaren vijftig tot zeventig afstand van het serialisme; de soms extreem doorgevoerde rationalisering die toen de Europese muziek domineerde. Dat leverde hem aanvankelijk het stempel van traditionalist op, al schuwde hij de atonaliteit niet. Sinds de jaren tachtig, toen de traditie uit de taboesfeer kwam, kreeg hij steeds meer erkenning."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "07f1bd18-822a-482b-85f9-70aa74d42ec6",
                        "source_entry_id": "d0e8138b-e2c1-3d33-a2e3-09c189e0f964",
                        "source_sense_id": "6bd3668a-5875-3786-921d-fd5337da15df",
                        "target_lang_word": "tradycjonalista",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tradycjonalista",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "9991b931-04c4-3fc5-8493-ab39bef7a678",
                                        "entry_id": "4b65df45-5b8a-3665-91b7-2621e05f93c4",
                                        "glosses": [
                                            "zwolennik tradycjonalizmu, człowiek przywiązany do tradycji"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5bf816cc-162e-4ca9-a1a6-f9a2acd67bb8",
                                                "sense_id": "9991b931-04c4-3fc5-8493-ab39bef7a678",
                                                "text": "Twardogłowy tradycjonalista może nie być w stanie wznieść się ponad przeszkody, takie jak tatuaże czy kolczyki w języku, by nawiązać kontakt z drugą osobą"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b3c1ed38-ce6e-4787-a003-cede80fa224b",
                        "source_entry_id": "d0e8138b-e2c1-3d33-a2e3-09c189e0f964",
                        "source_sense_id": "6bd3668a-5875-3786-921d-fd5337da15df",
                        "target_lang_word": "traditionaliste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "traditionaliste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "005230c7-fdec-3197-96eb-dbb77028d666",
                                        "entry_id": "1a4f9af9-9f2b-3913-9d6a-5d5e5c495872",
                                        "glosses": [
                                            "Qui professe le traditionalisme, qui est attaché aux idées, aux coutumes transmises par la tradition."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b12ef76-1708-4875-8357-fee772e0cba7",
                                                "sense_id": "005230c7-fdec-3197-96eb-dbb77028d666",
                                                "text": "Une position qui ne satisfait ni les militants du MNR ni ceux du FN, qui rassemblent des gens de « sensibilités différentes » et mélangent des catholiques traditionalistes, des anciens de l’OAS, des royalistes, des racialistes, des paganistes."
                                            },
                                            {
                                                "example_id": "62a7ea21-ab69-41f8-8478-433dc8a05f3e",
                                                "sense_id": "005230c7-fdec-3197-96eb-dbb77028d666",
                                                "text": "Bref, les frontières entre catholiques « observants », « traditionalistes » et « intégristes » semblent poreuses dans l’entre-soi versaillais."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "traditionaliste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fbd9bf83-f6b5-3fc7-95d5-7fc50a591a5e",
