                        "examples": [
                            {
                                "example_id": "0c6738da-a17a-4ef3-80f4-8a7b78665d9f",
                                "sense_id": "0012c36c-d239-3f68-8694-34327adc4424",
                                "text": "Le 12 octobre 2007, la policière, qui était patrouilleuse dans le sud-ouest de Montréal, a vérifié la plaque d’immatriculation d’un véhicule qui se trouvait près de la maison de son père, Fernand Lauzon, à la demande de ce dernier."
                            },
                            {
                                "example_id": "5d24f388-889c-4a03-867d-3801a923df2f",
                                "sense_id": "0012c36c-d239-3f68-8694-34327adc4424",
                                "text": "La fin de la vidéo de sept minutes est bouleversante. Elle montre des patrouilleuses de la police de Terrebonne en train d’effectuer des manœuvres de réanimation sur le corps inerte du suspect."
                            }
                        ]
                    },
