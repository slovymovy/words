                                                "sense_id": "529d2bfb-5634-3218-a2a2-771a2959aa80",
                                                "text": "Er muss Alimente für seine geschiedene Frau und die beiden Kinder bezahlen."
                                            },
                                            {
                                                "example_id": "a4faa058-d27a-42ce-a4a7-adb0fbb6aa94",
                                                "sense_id": "529d2bfb-5634-3218-a2a2-771a2959aa80",
                                                "text": "„Der ältere Bruder Lothar-Günther wird für ihn eine Art Ersatzvater, denn beide leiblichen Väter bekennen sich nicht zu ihren Söhnen und zahlen keine Alimente.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
