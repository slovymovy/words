                    "sense_definition": "A family name of English or Germanic origin.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The local library was named after Mr. <w>Mutter</w>, a prominent historian in the town.",
                            "target_lang_translations": {
                                "ru": "Местная библиотека была названа в честь мистера <w>Муттера</w>, выдающегося городского историка."
                            }
