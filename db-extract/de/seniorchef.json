                "senses": [
                    {
                        "sense_id": "a213eb2c-1a52-3291-8259-c5b070030e2b",
                        "entry_id": "8c01dd13-8221-33b6-b6bd-57452dbef40e",
                        "glosses": [
                            "älterer Teilhaber einer Firma oder eines Geschäfts, meist Vater des Juniors"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74ac74fd-c4b2-46ed-8673-33150ede9621",
                                "sense_id": "a213eb2c-1a52-3291-8259-c5b070030e2b",
                                "text": "„Doch ehe Keno oder Frau Becker antworten konnten, öffnete sich die Tür, und der Seniorchef kam herein.“"
                            },
                            {
                                "example_id": "45113c1e-6d31-45ed-9415-aba31e08908a",
                                "sense_id": "a213eb2c-1a52-3291-8259-c5b070030e2b",
                                "text": "„Schon einen Tag nach dieser Warnung wurde Ernst ins Büro gebeten, vom Seniorchef persönlich, Mikes Vater.“"
                            },
                            {
                                "example_id": "b35a2921-8233-42ac-8a5d-43b09ba42ea9",
                                "sense_id": "a213eb2c-1a52-3291-8259-c5b070030e2b",
                                "text": "„Dann ergriff der Seniorchef das Wort und machte ihn auf die Unregelmäßigkeiten in der Finanzbilanz des Vorjahres aufmerksam.“"
                            },
                            {
                                "example_id": "8e656465-17d3-4641-af91-b7d525b2e85d",
                                "sense_id": "a213eb2c-1a52-3291-8259-c5b070030e2b",
                                "text": "„Hier bastelt, entwirft und grübelt der Seniorchef bis zum heutigen Tag an neuen Ideen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
