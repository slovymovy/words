                "senses": [
                    {
                        "sense_id": "b753d6d6-f6b5-3a98-a3c5-db450adf0e27",
                        "entry_id": "a39b5cfc-07b3-3bbc-916e-2d4ccca8bf9f",
                        "glosses": [
                            "Küste, die am Atlantischen Ozean liegt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f068eec8-7662-44f8-9d25-c2b4c86d6db3",
                                "sense_id": "b753d6d6-f6b5-3a98-a3c5-db450adf0e27",
                                "text": "„Ein mächtiger Sturm hat den Portugiesen Bartolomeu Diaz mit seiner Flottille an Afrikas Atlantikküste weit nach Süden verschlagen.“"
                            },
                            {
                                "example_id": "9914d2a3-4246-45d7-b003-90acb88af63c",
                                "sense_id": "b753d6d6-f6b5-3a98-a3c5-db450adf0e27",
                                "text": "„Cristóbal an der Atlantikküste wurde der Haupthafen der Kanalzone, während das administrative Zentrum in Balboa an der Küste des Stillen Ozeans eingerichtet wurde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
