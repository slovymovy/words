{
    "word_family": [
        "glare"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "6c1315c5-f588-309c-aebd-5db307972a43",
                    "sense_definition": "Very obvious or noticeable, especially in a negative way.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "obvious",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "How could you miss this <w>glaring</w> error? It is right on page one!",
                            "target_lang_translations": {
                                "pl": "Jak mogłeś przeoczyć ten <w>rażący</w> błąd? Jest na pierwszej stronie!"
                            }
                        },
                        {
                            "text": "The company made a <w>glaring</w> mistake by ignoring the needs of its customers.",
                            "target_lang_translations": {
                                "pl": "Firma popełniła <w>rażący</w> błąd, ignorując potrzeby swoich klientów."
                            }
                        }
                    ],
                    "common_phrases": [
                        "glaring error",
                        "glaring omission"
                    ],
                    "target_lang_definitions": {
                        "pl": "Bardzo oczywisty lub zauważalny, zwłaszcza w negatywnym znaczeniu."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "rażący",
                                "target_lang_sense_clarification": "używane w odniesieniu do błędów, braków lub niesprawiedliwości"
                            },
                            {
                                "target_lang_word": "ewidentny",
                                "target_lang_sense_clarification": "podkreślający oczywistość czegoś"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4be8a811-18a3-35b8-bce8-4ebd671b3fe9",
                    "sense_definition": "Shining with a harsh, bright, or dazzling light.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "light",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>glaring</w> sun made it difficult to see the road ahead.",
                            "target_lang_translations": {
                                "pl": "<w>Oślepiające</w> słońce utrudniało widoczność drogi przed nami."
                            }
                        },
                        {
                            "text": "We had to wear sunglasses because of the <w>glaring</w> reflection off the water.",
                            "target_lang_translations": {
                                "pl": "Musieliśmy założyć okulary przeciwsłoneczne z powodu <w>oślepiającego</w> odbicia od wody."
                            }
                        }
                    ],
                    "common_phrases": [
                        "glaring light",
                        "glaring sun"
                    ],
                    "target_lang_definitions": {
                        "pl": "Świecący ostrym, jasnym lub oślepiającym światłem."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "oślepiający",
                                "target_lang_sense_clarification": "powodujący chwilową utratę wzroku przez zbyt jasne światło"
                            },
                            {
                                "target_lang_word": "rażący",
                                "target_lang_sense_clarification": "dotyczący światła, które męczy wzrok"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "027947b3-09c6-30ac-89b8-f9423c9bb2ad",
                    "sense_definition": "A collective noun for a group of cats.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The shelter was overwhelmed by a <w>glaring</w> of stray cats.",
                            "target_lang_translations": {
                                "pl": "Schronisko było przepełnione przez <w>grupę</w> bezdomnych kotów."
                            }
                        },
                        {
                            "text": "She kept a <w>glaring</w> of cats in her small apartment.",
                            "target_lang_translations": {
                                "pl": "Trzymała <w>grupę</w> kotów w swoim małym mieszkaniu."
                            }
                        }
                    ],
                    "synonyms": [
                        "clowder"
                    ],
                    "target_lang_definitions": {
                        "pl": "Zbiorcze określenie grupy kotów."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "stado",
                                "target_lang_sense_clarification": "ogólne określenie grupy zwierząt"
                            },
                            {
                                "target_lang_word": "grupa",
                                "target_lang_sense_clarification": "neutralne określenie zbiorowości"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "93efaedd-4887-3960-a93b-c8105c7bb262",
                    "sense_definition": "The act of looking at someone in an angry or fierce way.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "look",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His <w>glaring</w> at the waiter made everyone at the table feel uncomfortable.",
                            "target_lang_translations": {
                                "pl": "Jego <w>wrogie spojrzenie</w> na kelnera sprawiło, że wszyscy przy stole poczuli się nieswojo."
                            }
                        },
                        {
                            "text": "The constant <w>glaring</w> between the two rivals created a tense atmosphere.",
                            "target_lang_translations": {
                                "pl": "Ciągłe <w>mierzenie się wzrokiem</w> między dwoma rywalami stworzyło napiętą atmosferę."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in a literary or dated context."
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Akt patrzenia na kogoś w gniewny lub groźny sposób."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "wrogie spojrzenie",
                                "target_lang_sense_clarification": "spojrzenie pełne gniewu lub niechęci"
                            },
                            {
                                "target_lang_word": "gniewne patrzenie",
                                "target_lang_sense_clarification": "czynność patrzenia na kogoś z wściekłością"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "cff8b816-55a0-3ebd-8f49-4104ae304873",
                    "sense_definition": "Present participle and gerund of <w>glare</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "look",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was <w>glaring</w> at him because he was late again.",
                            "target_lang_translations": {
                                "pl": "<w>Patrzyła na niego gniewnie</w>, ponieważ znów się spóźnił."
                            }
                        },
                        {
                            "text": "Stop <w>glaring</w> at your brother and try to be polite.",
                            "target_lang_translations": {
                                "pl": "Przestań <w>patrzeć gniewnie</w> na swojego brata i spróbuj być uprzejmy."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Grammatical form of the verb glare."
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Imiesłów czasu teraźniejszego i rzeczownik odczasownikowy od czasownika 'glare' (patrzeć gniewnie)."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "patrzenie gniewnie",
                                "target_lang_sense_clarification": "czynność patrzenia na kogoś z wściekłością"
                            },
                            {
                                "target_lang_word": "mierzenie wzrokiem",
                                "target_lang_sense_clarification": "patrzenie na kogoś w sposób wyzywający lub pełen pretensji"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}