                },
                {
                    "sense_id": "aae1f7a9-6aa1-3191-9307-f498ff819d94",
                    "sense_definition": "Occurring repeatedly or continuing without interruption.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "continuous",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The office was filled with the <w>perpetual</w> noise of ringing phones and typing.",
