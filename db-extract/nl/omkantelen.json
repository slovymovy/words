        "nl-extract.jsonl": [
            {
                "entry_id": "b421fed9-29be-36cd-8dd1-a04965906d10",
                "word": "omkantelen",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "975cd075-caa7-3af7-9f3b-1ecc02a9ca78",
                        "entry_id": "b421fed9-29be-36cd-8dd1-a04965906d10",
                        "glosses": [
                            "vallen door een draaibeweging om een horizontale as"
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "51abe472-f9d4-490a-9240-950f4a705143",
                                "sense_id": "975cd075-caa7-3af7-9f3b-1ecc02a9ca78",
                                "text": "Na de toren van Pisa heeft Londen binnenkort misschien ook een scheve toren. De beroemde klok Big Ben is langzaam maar zeker aan het omkantelen. Volgens experts is al met het blote oog te zien dat Big Ben scheef staat."
                            },
                            {
                                "example_id": "98cb40f5-6e75-4daa-806e-83c005b62bb8",
                                "sense_id": "975cd075-caa7-3af7-9f3b-1ecc02a9ca78",
                                "text": "Hoezeer de overwinning de beeldschone Alfa ook toekwam, de verkiezing werd in zekere zin overschaduwd door de perikelen rondom de Mercedes-Benz A-Klasse. Deze ongekend innovatieve auto van Das Haus werd op voorhand tot de grote kanshebbers gerekend, totdat de A-Klasse tijdens de beruchte uitwijkproef omkantelde."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b65a27a8-8c39-41ca-91c6-19e50dd6d85e",
                        "source_entry_id": "b421fed9-29be-36cd-8dd1-a04965906d10",
                        "source_sense_id": "975cd075-caa7-3af7-9f3b-1ecc02a9ca78",
                        "target_lang_word": "overturn",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "overturn",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "115e070d-ce1b-3125-b905-9db06eaeb3aa",
                                        "entry_id": "ee2c013f-f62b-31c6-a4ca-bdca2cda04b6",
                                        "glosses": [
                                            "To turn over, capsize or upset."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "be37e520-1e25-4306-a27a-dff5bcba3110",
                                                "sense_id": "115e070d-ce1b-3125-b905-9db06eaeb3aa",
                                                "text": "About three or four minutes later still an express freight on the up main line ran into the wreckage at about 35 m.p.h. Its engine also overturned and 15 more wagons were added to the mounting pile of wreckage."
                                            },
                                            {
                                                "example_id": "e1626e28-253a-4621-a388-9eeb74c1d61c",
                                                "sense_id": "115e070d-ce1b-3125-b905-9db06eaeb3aa",
                                                "text": "We also found that the only emergency egress from the tram was by smashing the front or rear windscreens, and that emergency lighting had failed when the tram overturned."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "932676e8-4f10-3d27-a856-15593f686963",
                                        "entry_id": "ee2c013f-f62b-31c6-a4ca-bdca2cda04b6",
                                        "glosses": [
                                            "To overthrow or destroy."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "92903ab3-cfa2-3503-b8c8-d4c090ca6be9",
                                        "entry_id": "ee2c013f-f62b-31c6-a4ca-bdca2cda04b6",
                                        "glosses": [
                                            "To reverse (a decision); to overrule or rescind."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f9054276-ca9c-4dd4-8b05-59c9347e357c",
                                                "sense_id": "92903ab3-cfa2-3503-b8c8-d4c090ca6be9",
                                                "text": "In a report for the Sun on Sunday, Barak claimed that Andrew is consulting lawyers about overturning that settlement."
                                            },
                                            {
                                                "example_id": "5d130127-37aa-48a0-8209-00df08924351",
                                                "sense_id": "92903ab3-cfa2-3503-b8c8-d4c090ca6be9",
                                                "text": "Harvey was rightfully convicted. It’s unfortunate that the court has overturned his conviction. As a survivor, I am beyond disappointed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "07570e8c-faf6-393e-b656-5c0e2df80b9c",
                                        "entry_id": "ee2c013f-f62b-31c6-a4ca-bdca2cda04b6",
                                        "glosses": [
                                            "To diminish the significance of a previous defeat by winning; to make a comeback from."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd8c1012-d41c-4f0d-a656-5ff1f083fc41",
                                                "sense_id": "07570e8c-faf6-393e-b656-5c0e2df80b9c",
                                                "text": "Villa spent most of the second period probing from wide areas and had a succession of corners but despite their profligacy they will be glad to overturn the 6-0 hammering they suffered at St James' Park in August following former boss Martin O'Neill's departure"
                                            },
                                            {
                                                "example_id": "698f377c-462e-4535-af4e-943ca49e49e2",
                                                "sense_id": "07570e8c-faf6-393e-b656-5c0e2df80b9c",
                                                "text": "There were so many heroes for Leicester on an evening when they played with tremendous courage and belief to overturn the 2-1 deficit from the first leg, yet it was hard to look beyond Kasper Schmeichel for the game’s outstanding performer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f55a3663-5d87-3725-83c1-fe01bb17a8ce",
                                        "entry_id": "ee2c013f-f62b-31c6-a4ca-bdca2cda04b6",
                                        "glosses": [
                                            "To undergo a limnic eruption, where dissolved gas suddenly erupts from the depths."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "overturn",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e4e9f5e8-ed85-303d-95ab-34a563644f74",
                                        "entry_id": "c0ae5650-a494-3519-906f-d112e7a46482",
                                        "glosses": [
                                            "A turning over or upside-down; inversion."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d9d3f23c-afcb-3a05-b6b1-8314d8c6003e",
                                        "entry_id": "c0ae5650-a494-3519-906f-d112e7a46482",
                                        "glosses": [
                                            "The overturning or overthrow of some institution or state of affairs; ruin."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "83e757c4-697d-4489-a674-cc9f6ced81d8",
                        "source_entry_id": "b421fed9-29be-36cd-8dd1-a04965906d10",
                        "source_sense_id": "975cd075-caa7-3af7-9f3b-1ecc02a9ca78",
                        "target_lang_word": "turn over",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "turn over",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d9cd0cc9-1005-3ea8-a997-ef65929ada3c",
                                        "entry_id": "1cc30e3f-9d0e-33d4-86a2-0ed840600b5a",
                                        "glosses": [
                                            "Used other than figuratively or idiomatically: see turn, over."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c13a19c1-3c9c-4117-b9a4-5e44c4e008e9",
                                                "sense_id": "d9cd0cc9-1005-3ea8-a997-ef65929ada3c",
                                                "text": "The family feeling was intensified as we stopped to speak to mothers in the cottage gardens, or waved to distant tractors turning over chocolate-brown furrows and driven by 'my dad' or 'my Uncle Bob'."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c601b6de-865a-3027-b64d-3068859b5524",
                                        "entry_id": "1cc30e3f-9d0e-33d4-86a2-0ed840600b5a",
                                        "glosses": [
                                            "To flip over; to rotate uppermost to bottom."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc541dbe-1590-46ea-a7f5-4cad57373e51",
                                                "sense_id": "c601b6de-865a-3027-b64d-3068859b5524",
                                                "text": "Turn over the box and look at the bottom."
                                            },
                                            {
                                                "example_id": "8e3ca753-639f-40f8-9aaa-b47722af32f2",
                                                "sense_id": "c601b6de-865a-3027-b64d-3068859b5524",
                                                "text": "The brakes were applied immediately, but the engine ran into a sand drag at approximately 20 m.p.h., plunged down the embankment, and turned over on its side at the bottom."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4aee2c21-470a-3a5f-8726-571a937b3bb3",
                                        "entry_id": "1cc30e3f-9d0e-33d4-86a2-0ed840600b5a",
                                        "glosses": [
                                            "To relinquish; give back."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f3320888-a884-43b2-8842-9b9f2745b774",
                                                "sense_id": "4aee2c21-470a-3a5f-8726-571a937b3bb3",
                                                "text": "They turned over the evidence to the authorities."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f86eeb8e-54b5-3377-8267-9466e7c6c2fe",
                                        "entry_id": "1cc30e3f-9d0e-33d4-86a2-0ed840600b5a",
                                        "glosses": [
                                            "To transfer."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "65f628d1-54e2-490b-ad4b-d43306df6c39",
                                                "sense_id": "f86eeb8e-54b5-3377-8267-9466e7c6c2fe",
                                                "text": "But what is to be done with our manufacturing population […] This one thing, of doing for them by ‘underselling all people,’ and filling our own bursten pockets and appetites by the road; and turning over all care for any ‘population,’ or human or divine consideration except cash only, to the winds, with a “Laissez-faire” and the rest of it: this is evidently not the thing."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f016351f-b7d6-34c2-890d-c032a8052282",
                                        "entry_id": "1cc30e3f-9d0e-33d4-86a2-0ed840600b5a",
                                        "glosses": [
                                            "To produce, complete, or cycle through."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b5961d3a-4b9b-49c2-aaff-4ed7f702d8a5",
                                                "sense_id": "f016351f-b7d6-34c2-890d-c032a8052282",
                                                "text": "They can turn over about three hundred units per hour."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "00c7a62d-35ab-321b-b0a1-471c8627733a",
                                        "entry_id": "1cc30e3f-9d0e-33d4-86a2-0ed840600b5a",
                                        "glosses": [
                                            "To generate (a certain amount of money from sales)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f05fe5af-09a2-441e-9b93-2b3954ec8f78",
                                                "sense_id": "00c7a62d-35ab-321b-b0a1-471c8627733a",
                                                "text": "The business turned over £1m last year."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "63b58d5d-992f-34cd-ad59-6fef2d6a5c82",
                                        "entry_id": "1cc30e3f-9d0e-33d4-86a2-0ed840600b5a",
                                        "glosses": [
                                            "To mull, ponder"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "45326ce2-059f-4cf6-9926-7e4c5aee678e",
                                                "sense_id": "63b58d5d-992f-34cd-ad59-6fef2d6a5c82",
                                                "text": "Thus they dwelled for nearly a year, and in that time Robin Hood often turned over in his mind many means of making an even score with the Sheriff"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "797cbb7e-6622-3cd9-bbbd-013b0770b261",
                                        "entry_id": "1cc30e3f-9d0e-33d4-86a2-0ed840600b5a",
                                        "glosses": [
                                            "To spin the crankshaft of an internal combustion engine using the starter or hand crank in an attempt to make it run."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3f6184af-a765-3a7f-a4a7-92a981854f79",
                                        "entry_id": "1cc30e3f-9d0e-33d4-86a2-0ed840600b5a",
                                        "glosses": [
                                            "To give up control (of the ball and thus the ability to score)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "faf81cc6-249f-42e9-a562-730cd9639aba",
                                                "sense_id": "3f6184af-a765-3a7f-a4a7-92a981854f79",
                                                "text": "The Giants didn't turn the ball over in their last four games."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2268291e-2e3b-330c-a850-8364d350cad5",
                                        "entry_id": "1cc30e3f-9d0e-33d4-86a2-0ed840600b5a",
                                        "glosses": [
                                            "To cause extensive disturbance or disruption to (a room, storage place, etc.), e.g. while searching for an item, or ransacking a property."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "211dfb9e-84a8-4b56-a599-c519df1979fb",
                                                "sense_id": "2268291e-2e3b-330c-a850-8364d350cad5",
                                                "text": "I've turned over the whole place, but I still can't find my glasses."
                                            },
                                            {
                                                "example_id": "b52bd1cc-f7b2-4b64-be76-bdebc9e19722",
                                                "sense_id": "2268291e-2e3b-330c-a850-8364d350cad5",
                                                "text": "Thieves turned over the apartment while the owners were away on holiday."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "427fb53f-fe0f-482d-ba6e-8debce2f5b2b",
                        "source_entry_id": "b421fed9-29be-36cd-8dd1-a04965906d10",
                        "source_sense_id": "975cd075-caa7-3af7-9f3b-1ecc02a9ca78",
                        "target_lang_word": "topple",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "topple",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "10239b2b-7e72-3171-b2c4-1b17be1f6c6d",
                                        "entry_id": "00fff9d6-b7e7-3ad8-85b4-a5944bc426f6",
                                        "glosses": [
                                            "To push or throw over."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3b0931a9-a492-4551-90ad-dc2af2140047",
                                                "sense_id": "10239b2b-7e72-3171-b2c4-1b17be1f6c6d",
                                                "text": "The massed crowds toppled the statue of the former dictator."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4df9f773-7daf-30cc-b6df-67f746350374",
                                        "entry_id": "00fff9d6-b7e7-3ad8-85b4-a5944bc426f6",
                                        "glosses": [
                                            "To overturn."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f3e9b955-1d3a-3a9f-a72c-0ace2973bbec",
                                        "entry_id": "00fff9d6-b7e7-3ad8-85b4-a5944bc426f6",
                                        "glosses": [
                                            "To overthrow something."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c198517d-02b9-4483-b029-3f4d4c1819e7",
                                                "sense_id": "f3e9b955-1d3a-3a9f-a72c-0ace2973bbec",
                                                "text": "to topple one's rival"
                                            },
                                            {
                                                "example_id": "1b88f5db-3733-4253-97fc-361f5b4affdc",
                                                "sense_id": "f3e9b955-1d3a-3a9f-a72c-0ace2973bbec",
                                                "text": "Barla Von: Most people think I deal in finances, but my real currency is knowledge. I trade information and it has made me very wealthy.\nBarla Von: But the Shadow Broker is the true master. Every day, he buys and sells secrets that could topple governments, always giving them to the highest bidder."
                                            },
                                            {
                                                "example_id": "bc3c4925-025e-4094-9743-f3f9b67cceec",
                                                "sense_id": "f3e9b955-1d3a-3a9f-a72c-0ace2973bbec",
                                                "text": "He now confronts the daunting endeavor of toppling a former president whose belligerence and loyal base of support have discouraged most leading Republicans — including, up to now, Mr. DeSantis — from making frontal attacks against him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f9ec1e22-baa4-3df6-816b-345578c61d47",
                                        "entry_id": "00fff9d6-b7e7-3ad8-85b4-a5944bc426f6",
                                        "glosses": [
                                            "To totter and fall, or to lean as if about to do so."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c4588560-207b-46ea-812a-e7231a042a61",
                                                "sense_id": "f9ec1e22-baa4-3df6-816b-345578c61d47",
                                                "text": "The pile of pennies began to topple."
                                            },
                                            {
                                                "example_id": "30b60916-6033-4f52-a0e6-b19c87827b68",
                                                "sense_id": "f9ec1e22-baa4-3df6-816b-345578c61d47",
                                                "text": "[…] yonder cloud\nThat rises upward always higher,\n⁠And onward drags a labouring breast,\n⁠And topples round the dreary west,\nA looming bastion fringed with fire."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "topple",
