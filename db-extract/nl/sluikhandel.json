                        "glosses": [
                            "heimelijke handel die indruist tegen de bepalingen van een overheid"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aaec4756-bcc8-4a38-aaca-6855ca38b20d",
                                "sense_id": "d51d88de-223b-3653-a504-dec88c20f087",
                                "text": "Het verdrag van de Verenigde Naties tegen de sluikhandel in verdovende middelen en psychotrope stoffen heeft het nummer 003363 gekregen."
                            }
                        ]
                    }
                ],
