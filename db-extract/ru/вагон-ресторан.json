                        ]
                    },
                    {
                        "translation_id": "05012ccd-d2d6-46a1-b394-0e473b8bba1f",
                        "source_entry_id": "ab493a41-41b4-3dda-ac19-4f78404ab7ab",
                        "source_sense_id": "a39735be-c1dc-302f-bf22-2b84ea77738f",
                        "target_lang_word": "wagon-restaurant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wagon-restaurant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e2091808-a82d-37be-8020-6ce0ad4d6bf8",
                                        "entry_id": "e8886922-8452-359e-be5a-980cd2d124ad",
                                        "glosses": [
                                            "Voiture aménagée pour y servir des repas aux voyageurs d’un train."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e299e688-3369-4a3e-a228-d313156257a6",
                                                "sense_id": "e2091808-a82d-37be-8020-6ce0ad4d6bf8",
                                                "text": "Je visite alors le wagon-restaurant. Il est d’un tiers plus long que les autres wagons, une véritable salle à manger, garnie d’une unique table ; à l’arrière, d’un côté se trouve un office, de l’autre une cuisine, où fonctionnent le cuisinier et le maître d’hôtel, tous les deux d’origine moscovite."
                                            },
                                            {
                                                "example_id": "6cfe835f-95ed-4839-a113-88fd600c5327",
                                                "sense_id": "e2091808-a82d-37be-8020-6ce0ad4d6bf8",
                                                "text": "[…] elle suppliait sa cousine Florence de l’interroger sur la traduction de tel mot, de telle locution, plutôt que la laisser savourer la poularde à la crème qu’une escouade de grooms leur présentait en soulevant des cloches argentées dans le wagon-restaurant."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
