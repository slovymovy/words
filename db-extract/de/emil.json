                "senses": [
                    {
                        "sense_id": "375424d9-05ce-3960-9ed5-c9926825baf0",
                        "entry_id": "16ca09e8-609c-34da-b087-6e7a69d0a810",
                        "glosses": [
                            "männlicher Vorname; Emil"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c5b3df1-ab4e-4d5b-8398-e0c7854d2fa1",
                                "sense_id": "375424d9-05ce-3960-9ed5-c9926825baf0",
                                "text": "Wir werden Emil morgen zu seinem Geburtstag gratulieren."
                            },
                            {
                                "example_id": "7a24f034-4b77-4a0c-afc5-157892acda2f",
                                "sense_id": "375424d9-05ce-3960-9ed5-c9926825baf0",
                                "text": "Emil Spannocchi kam als jüngstes von drei Kindern von Anton Graf Spannocchi und Gabriele Gräfin von Attems 1916 auf Schloss Aigen, heute Teil der Stadt Salzburg, zur Welt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7ca46982-4175-4e69-a6c5-e796b0d1ca79",
                        "source_entry_id": "16ca09e8-609c-34da-b087-6e7a69d0a810",
                        "source_sense_id": "375424d9-05ce-3960-9ed5-c9926825baf0",
                        "source_sense_description": "Männlicher Vorname",
                        "target_lang_word": "Emil",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Emil",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a50cb6b7-04d9-303f-a6e2-7ad8720271b2",
                                        "entry_id": "0c6e6ec7-602c-30c0-9cdb-b2e02939fa8f",
                                        "glosses": [
                                            "A male given name from Latin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a7967af-dce6-4955-ab87-cf9561afb57f",
                                                "sense_id": "a50cb6b7-04d9-303f-a6e2-7ad8720271b2",
                                                "text": "Homan, who was on the ground in Chicago, maintained it was a “criminal operation.” Acting Deputy Attorney General Emil Bove was also in Chicago on Sunday to observe immigration enforcement operations."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ccc5a1f7-0754-4ec7-9e34-63d516814c2a",
                        "source_entry_id": "16ca09e8-609c-34da-b087-6e7a69d0a810",
                        "source_sense_id": "375424d9-05ce-3960-9ed5-c9926825baf0",
                        "source_sense_description": "Männlicher Vorname",
                        "target_lang_word": "Émile",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Émile",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8594b659-4943-324b-9f96-3ec74874b998",
                                        "entry_id": "0eecad42-d06e-305f-be17-26b9da0cc413",
                                        "glosses": [
                                            "Prénom masculin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d4d59ad9-3ddc-46de-a817-19e1b06b4586",
                                                "sense_id": "8594b659-4943-324b-9f96-3ec74874b998",
                                                "text": "Émile Blondet nous a fait une peinture des agréments d’une femme d’aujourd'hui ; mais au besoin cette femme qui minaude, qui parade, qui gazouille les idées de messieurs tels et tels, serait héroïque !"
                                            },
                                            {
                                                "example_id": "079de27f-dfcc-422d-b074-d8f07fa9a1ea",
                                                "sense_id": "8594b659-4943-324b-9f96-3ec74874b998",
                                                "text": "Émile doit rejoindre, dès dix heures du matin, au deuxième jour de la mobilisation. Il est désolé. Les plus sombres pressentiments le poignent."
                                            },
                                            {
                                                "example_id": "e301bcc7-054a-4100-8862-e09470cc2f34",
                                                "sense_id": "8594b659-4943-324b-9f96-3ec74874b998",
                                                "text": "J'allai de ce pas voir Émile l’aubergiste, ma darne de requin à la main. L’événement que m'avait rapporté le poissonnier ne pouvait attendre. La darne non plus."
                                            },
                                            {
                                                "example_id": "79bcd552-62ef-4107-abc4-68916c4dcbf4",
                                                "sense_id": "8594b659-4943-324b-9f96-3ec74874b998",
                                                "text": "Menées de deux sets, les joueuses d’Émile Rousseaux ont obtenu deux occasions de réussir leur come-back, mais les Colombiennes ont retrouvé une solidité mentale qui leur a permis de les sauver et d’arracher la victoire lors du set décisif."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
