{
    "word_family": [
        "rooster"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0889e3e6-1af5-3f4b-8dec-bb1ecb7fc018",
                    "sense_definition": "A place where a bird sleeps, such as a nest or a branch.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "bird_habitat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The owl returned to its <w>roost</w> as the sun began to rise.",
                            "target_lang_translations": {
                                "ru": "Сова вернулась на свой <w>насе́ст</w>, когда солнце начало вставать."
                            }
                        },
                        {
                            "text": "Many birds share the same <w>roost</w> in the old oak tree.",
                            "target_lang_translations": {
                                "ru": "Многие птицы делят один и тот же <w>насе́ст</w> на старом дубе."
                            }
                        }
                    ],
                    "synonyms": [
                        "perch",
                        "nest"
                    ],
                    "common_phrases": [
                        "bird roost"
                    ],
                    "target_lang_definitions": {
                        "ru": "Место, где птицы спят или отдыхают, например, ветка или специальная перекладина."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "насе́ст",
                                "target_lang_sense_clarification": "перекладина или жёрдочка в курятнике для птиц"
                            },
                            {
                                "target_lang_word": "ме́сто ночле́га",
                                "target_lang_sense_clarification": "общее обозначение места, где птицы устраиваются на ночь"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "812fcdaa-c530-3456-97c0-39cb092b85fd",
                    "sense_definition": "A group of birds resting or sleeping together.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "bird_habitat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A large <w>roost</w> of starlings gathered on the power lines.",
                            "target_lang_translations": {
                                "ru": "Большая <w>стая</w> скворцов собралась на линиях электропередач."
                            }
                        },
                        {
                            "text": "The researchers studied the behavior of the <w>roost</w> throughout the winter.",
                            "target_lang_translations": {
                                "ru": "Исследователи изучали поведение этой <w>стаи</w> на протяжении всей зимы."
                            }
                        }
                    ],
                    "synonyms": [
                        "flock"
                    ],
                    "target_lang_definitions": {
                        "ru": "Группа птиц, отдыхающих или спящих вместе в одном месте."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стая",
                                "target_lang_sense_clarification": "группа птиц, собравшихся вместе для отдыха"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "fa07bbaa-c011-395c-97df-bbd2a82bc43f",
                    "sense_definition": "To settle on a perch or branch to sleep or rest.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "bird_behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The chickens <w>roost</w> in the coop every evening.",
                            "target_lang_translations": {
                                "ru": "Куры <w>садятся на насе́ст</w> в курятнике каждый вечер."
                            }
                        },
                        {
                            "text": "We watched the eagles <w>roost</w> high up in the pine trees.",
                            "target_lang_translations": {
                                "ru": "Мы наблюдали, как орлы <w>устраиваются на ночле́г</w> высоко на соснах."
                            }
                        }
                    ],
                    "synonyms": [
                        "perch"
                    ],
                    "common_phrases": [
                        "roost in"
                    ],
                    "target_lang_definitions": {
                        "ru": "Устраиваться на ветке или перекладине для сна или отдыха."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сади́ться на насе́ст",
                                "target_lang_sense_clarification": "устраиваться на перекладине для сна"
                            },
                            {
                                "target_lang_word": "ночева́ть",
                                "target_lang_sense_clarification": "устраиваться на ночлег (о птицах)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a8fc8888-bf6b-3654-b480-0a083cb7e3f2",
                    "sense_definition": "To stay or sleep in a particular place for the night.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "bird_behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The delivery vans <w>roost</w> in the underground garage overnight.",
                            "target_lang_translations": {
                                "ru": "Фургоны доставки <w>остаются на ночле́г</w> в подземном гараже."
                            }
                        },
                        {
                            "text": "Many migratory birds <w>roost</w> here during their long journey.",
                            "target_lang_translations": {
                                "ru": "Многие перелетные птицы <w>останавливаются здесь на ночле́г</w> во время своего долгого пути."
                            }
                        }
                    ],
                    "synonyms": [
                        "lodge",
                        "stay"
                    ],
                    "common_phrases": [
                        "roost overnight"
                    ],
                    "target_lang_definitions": {
                        "ru": "Оставаться или ночевать в каком-либо месте."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "останавливаться на ночле́г",
                                "target_lang_sense_clarification": "устраиваться на ночь в определенном месте"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}