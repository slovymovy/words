                "senses": [
                    {
                        "sense_id": "909777e1-6463-3be4-81ab-de96d5c5ea5a",
                        "entry_id": "bc615f04-d750-3422-8b8c-d24cc4bfa872",
                        "glosses": [
                            "herauskommen"
