                        "entry_id": "5f1d05bc-17b2-3bf0-9c93-8049e6b6d9fa",
                        "glosses": [
                            "That wants or desires."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "d6a050da-f0cc-33a3-8d4a-90550f70c8b4",
                        "entry_id": "5f1d05bc-17b2-3bf0-9c93-8049e6b6d9fa",
                        "glosses": [
                            "Absent or lacking."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a822988-c55e-41db-b6c1-7499908bf4ab",
                                "sense_id": "d6a050da-f0cc-33a3-8d4a-90550f70c8b4",
                                "text": "Already Cæſar\nHas ravaged more than half the Globe, and ſees\nMankind grown thin by his deſtructive Sword:\nShould he go further, Numbers would be wanting\nTo form new Battels, and ſupport his Crimes."
                            },
                            {
                                "example_id": "ecdf2a77-a9ae-4eb8-9d14-54deb4aaa522",
                                "sense_id": "d6a050da-f0cc-33a3-8d4a-90550f70c8b4",
                                "text": "[…] but where other powers of entertainment are wanting, the true philosopher will derive benefit from such as are given."
                            },
                            {
                                "example_id": "18c86783-1370-4c01-9179-12ed96c8d646",
                                "sense_id": "d6a050da-f0cc-33a3-8d4a-90550f70c8b4",
                                "text": "Discal black dot small or wanting. Transverse posterior line reduced to two dotlets or altogether wanting."
                            }
                        ]
                    },
                    {
                        "sense_id": "96041a12-71b6-31cc-85ac-28cc078d436e",
                        "entry_id": "5f1d05bc-17b2-3bf0-9c93-8049e6b6d9fa",
                        "glosses": [
                            "Deficient."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b407857-75e4-4f82-a3a3-5d96201f2ae1",
                                "sense_id": "96041a12-71b6-31cc-85ac-28cc078d436e",
                                "text": "Kate felt privileged to have been permitted to speak through it and she was glad that, as before, she had been judged and not found wanting"
                            }
                        ]
                    }
                ],
