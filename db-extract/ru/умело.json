                        "source_sense_id": "3959fc2e-9cfa-3e58-ac85-0a1fcfe35dac",
                        "target_lang_word": "skillfully",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "skillfully",
