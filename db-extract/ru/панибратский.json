                                    {
                                        "sense_id": "feded4bb-424c-3416-a0a7-f27580f53ad7",
                                        "entry_id": "026630a7-7f2a-3c7d-bda4-ffacd3550a97",
                                        "glosses": [
                                            "auf die Familie bezogen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab7bc8a3-be06-4b23-b9b7-5881b24338b7",
                                                "sense_id": "feded4bb-424c-3416-a0a7-f27580f53ad7",
                                                "text": "Karl hat wohl familiäre Sorgen, aber er wollte nichts Genaues sagen."
                                            },
                                            {
                                                "example_id": "9542d7d3-19bf-4824-b0ff-bc04305d25af",
                                                "sense_id": "feded4bb-424c-3416-a0a7-f27580f53ad7",
                                                "text": "„Berthold Otto ist Begründer des freien Gesamtunterrichts, den er neben dem üblichen Fachunterricht mit allen Jahrgängen seiner Schule gemeinsam in einer Stunde am Wochenende […] in Form einer familiären Unterhaltung pflegt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6b4e28b7-a70a-3a8e-bf5c-e512e12d96d9",
                                        "entry_id": "026630a7-7f2a-3c7d-bda4-ffacd3550a97",
                                        "glosses": [
                                            "auf Freundschaft fußend; ohne Zwang"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25a6ceae-93d2-47a1-a9a5-82639a68a102",
                                                "sense_id": "6b4e28b7-a70a-3a8e-bf5c-e512e12d96d9",
                                                "text": "„Die Atmosphäre ist familiär, Hierarchien gibt es nicht, selbst die Dozenten werden mit Vornamen angeredet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "8a25dc5e-97eb-31ee-9dd6-7da1f94be444",
                                        "entry_id": "026630a7-7f2a-3c7d-bda4-ffacd3550a97",
                                        "glosses": [
                                            "(allzu) intim, eng verbunden"
                                        ],
                                        "tags": [
                                            "auch abwertend"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c7437a62-7b90-47ae-b847-9b1607baa129",
                                                "sense_id": "8a25dc5e-97eb-31ee-9dd6-7da1f94be444",
                                                "text": "Dieses familiäre Benehmen wirkte auf mich unseriös."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "7d22d8d9-9885-3037-9a66-d2580d34190e",
                                        "entry_id": "026630a7-7f2a-3c7d-bda4-ffacd3550a97",
                                        "glosses": [
                                            "auf Worte oder Wendungen bezogen, die nur in einem von besonderer Vertrautheit gekennzeichneten Umfeld — also im engen Freundeskreis oder innerhalb der Familie — verwendet werden"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "913dea43-eac6-431f-a588-7c9ad09b2e45",
                        "source_entry_id": "b8888413-c97a-3d95-86f8-5a9600e91f4f",
                        "source_sense_id": "58bfd8c3-be67-3d29-8a94-c6ecfb0a1d7a",
                        "target_lang_word": "respektlos",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "respektlos",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0f8dad19-54e2-341f-b0f0-33030540559c",
                                        "entry_id": "22bcd000-0015-36fd-b5a8-4c4c1483684d",
                                        "glosses": [
                                            "ohne Respekt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38dfdd90-de43-4cf1-b861-d0693cca764b",
                                                "sense_id": "0f8dad19-54e2-341f-b0f0-33030540559c",
                                                "text": "Sein respektloses Verhalten gegenüber dem Lehrer hatte Konsequenzen."
                                            },
                                            {
                                                "example_id": "86cdd514-9b04-4a1a-81cb-ba6c796cbc0f",
                                                "sense_id": "0f8dad19-54e2-341f-b0f0-33030540559c",
                                                "text": "„Ein Kunde einer Pizzeria dürfte einen gehörigen Schock erlebt haben, als sein Blick auf den Kassenzettel fiel: Ein Angestellter des Restaurants hatte darauf respektlose Worte hinterlassen.“"
                                            },
                                            {
                                                "example_id": "d0694205-8972-41a7-978c-71f6e73da939",
                                                "sense_id": "0f8dad19-54e2-341f-b0f0-33030540559c",
                                                "text": "„Double-Gewinner Niko Kovac vom FC Bayern München hat einen respektlosen Umgang mit den Fußball-Trainern in der Bundesliga beklagt.“"
                                            },
                                            {
                                                "example_id": "3d5dd527-f2f3-40ed-80e6-5802f61e0943",
                                                "sense_id": "0f8dad19-54e2-341f-b0f0-33030540559c",
                                                "text": "„Über Trumps respektlosen Umgang mit verheirateten Frauen hat auch Trumps ehemalige Geschäftspartnerin Jill Harth berichtet, die über einen längeren Zeitraum von ihm sexuell belästigt worden sein soll.“"
                                            },
                                            {
                                                "example_id": "0b5fdaf6-f058-429a-b0b9-cb023ee2c910",
                                                "sense_id": "0f8dad19-54e2-341f-b0f0-33030540559c",
                                                "text": "„Diskus-Olympiasieger Christoph Harting hat nach seinen respektlosen Äußerungen und herablassenden Sprüchen über Verband und Konkurrenten offenbar einen Denkzettel erhalten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
