                ],
                "senses": [
                    {
                        "sense_id": "8fc9f1eb-3b6c-33c0-9ce1-f558f21bfea5",
                        "entry_id": "1520f0f4-185c-386d-b7d1-242eabd780b6",
                        "glosses": [
                            "Méthode de transfert de fichier sans réseau informatique, qui fonctionne par exemple par l'intermédiaire de clés USB ou de disques durs externes."
                        ],
                        "tags": [
                            "slang"
                        ],
