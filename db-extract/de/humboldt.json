                "senses": [
                    {
                        "sense_id": "37f0a341-ccd0-3a1b-89a2-cdd4895ba22d",
                        "entry_id": "d4126a8e-e52a-3de2-8341-9876000faa1f",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "16f94eee-3dbd-4316-b5bf-3471ca4b890f",
                                "sense_id": "37f0a341-ccd0-3a1b-89a2-cdd4895ba22d",
                                "text": "Frau Humboldt ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "af898cdc-9d36-44bc-b47d-d3a26cd7d66c",
                                "sense_id": "37f0a341-ccd0-3a1b-89a2-cdd4895ba22d",
                                "text": "Herr Humboldt wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "41f2b51a-1882-4f8e-ad1c-b105ada3b5c8",
                                "sense_id": "37f0a341-ccd0-3a1b-89a2-cdd4895ba22d",
                                "text": "Die Humboldts kommen heute aus Berlin."
                            },
                            {
                                "example_id": "47f9f88a-bf02-4682-9dae-c27c76f7cd92",
                                "sense_id": "37f0a341-ccd0-3a1b-89a2-cdd4895ba22d",
                                "text": "Der Humboldt trägt nie die Schals, die die Humboldt ihm strickt."
                            },
                            {
                                "example_id": "b8744c37-b74e-4de1-a256-b2e54bd99d86",
                                "sense_id": "37f0a341-ccd0-3a1b-89a2-cdd4895ba22d",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Humboldt kommt, geht der Herr Humboldt.“"
                            },
                            {
                                "example_id": "b55f1ff8-0a02-4ed9-aaaa-78373f27b5f7",
                                "sense_id": "37f0a341-ccd0-3a1b-89a2-cdd4895ba22d",
                                "text": "Humboldt kommt und geht."
                            },
                            {
                                "example_id": "2058522e-1825-43fb-be63-6d95e990c0ba",
                                "sense_id": "37f0a341-ccd0-3a1b-89a2-cdd4895ba22d",
                                "text": "Humboldts kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
