                        "glosses": [
                            "zabójca własnego syna"
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "520b0330-95dd-4c6d-8ee3-6b29cab2b9bd",
                                "sense_id": "62237431-171b-356f-aa2b-ed9bd69a1998",
                                "text": "Proces Czesława H., którego prokuratura oskarżyła o zabicie syna Sebastiana, zaczął się wczoraj w łódzkim Sądzie Okręgowym. Synobójcy grozi dożywocie"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5b47bfbc-b807-4746-9a79-685910293839",
                        "source_entry_id": "f16b6e76-b7c1-371f-8721-db855c11eb88",
