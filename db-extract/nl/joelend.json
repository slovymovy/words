                                                "example_id": "b6002f56-6591-4baf-97eb-5438bcfe76e9",
                                                "sense_id": "5ff49237-4c99-345e-b9a4-bf1344aff2d7",
                                                "text": "All undergraduate libraries have been a screaming success as study halls. The Undergraduate Library of the University of Michigan may be the smash hit of all time; the attendance in that library during 1968-69 was 1,899,000."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "40f91e1a-f96f-3a9a-977b-4089f3517d26",
                                        "entry_id": "29f78197-903d-3eec-be67-db1ff78ca0e9",
                                        "glosses": [
                                            "Hilariously funny; calculated to make people roar with laughter."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
