                {
                    "sense_id": "7f675a76-8e79-3d47-85a4-69848542f61e",
                    "sense_definition": "Relating to Norway, its people, or its language.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "norway_related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>Norwegian</w> landscape is famous for its beautiful fjords and mountains.",
                            "target_lang_translations": {
                                "ru": "<w>Норвежский</w> пейзаж славится своими красивыми фьордами и горами.",
                                "zh": "<w>挪威的</w>风景以其美丽的峡湾和山脉而闻名。"
                            }
                        },
                        {
                            "text": "We bought a warm <w>Norwegian</w> sweater for the cold winter.",
                            "target_lang_translations": {
                                "ru": "Мы купили тёплый <w>норвежский</w> свитер для холодной зимы.",
                                "zh": "我们买了一件保暖的<w>挪威</w>毛衣来过冬。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "Norwegian salmon",
                        "Norwegian wood",
                        "Norwegian Sea",
                        "Norwegian cruise"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к Норвегии, её народу или языку.",
                        "zh": "与挪威、挪威人或挪威语相关的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "норвежский",
                                "target_lang_sense_clarification": "прилагательное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "挪威的",
                                "target_lang_sense_clarification": "形容词，表示所属或相关"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c1ee3192-6c74-3f3b-b75e-0a3d9a9546d7",
                    "sense_definition": "A native or inhabitant of Norway.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "norway_related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many <w>Norwegians</w> enjoy skiing and other outdoor activities.",
