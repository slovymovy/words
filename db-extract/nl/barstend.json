                        "cross_references": [
                            {
                                "target_word": "exploding",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c7d0fb48-1e5d-3991-a1bf-3d93f24dca9f",
                                        "entry_id": "42d865ed-021d-330f-be04-f427d2f88b83",
                                        "glosses": [
                                            "Explosion."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8422aa16-4394-4c14-a245-16d8c02791f5",
                                                "sense_id": "c7d0fb48-1e5d-3991-a1bf-3d93f24dca9f",
                                                "text": "When helpless, a soldier lay racked with his goadings Of wounds he'd received in the battle's explodings."
                                            },
                                            {
                                                "example_id": "fbf19614-f5d9-4ad2-ab12-859f7037e4f0",
                                                "sense_id": "c7d0fb48-1e5d-3991-a1bf-3d93f24dca9f",
                                                "text": "Blowings up —explodings— Such would be your fate; Streams of fire 'neath us! — Bless us, what a state!"
                                            },
                                            {
                                                "example_id": "b852e800-ed7c-4f51-afeb-4909208b99cd",
                                                "sense_id": "c7d0fb48-1e5d-3991-a1bf-3d93f24dca9f",
                                                "text": "How can these vitality affects be described? They are surgings, fadings, explodings, collapsings, slowings down, drawing out or drifting, feelings."
                                            },
                                            {
                                                "example_id": "67064b04-08b8-4385-a2f0-426e89ef334e",
                                                "sense_id": "c7d0fb48-1e5d-3991-a1bf-3d93f24dca9f",
                                                "text": "Nietzsche judged in advance [präjudiziert] this exploding of the heavens by elevated humanness [gesteigerte Meschhaftigkeit], an exploding that, religiously (also for Nietzsche), is and remains inculpation."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "exploding",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "06ec32b1-044c-3ea6-9f1e-74aa4c93bfb0",
                                        "entry_id": "787a6911-3a78-354d-8f4a-c4261b84d3d8",
                                        "glosses": [
                                            "present participle and gerund of explode"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "gerund",
