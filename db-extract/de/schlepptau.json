                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dragrope",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8dcac7eb-fc97-353b-91f1-c371bf95680c",
                                        "entry_id": "a64c13f3-20e5-3a9f-bcfe-822590b813ce",
                                        "glosses": [
                                            "A rope used to drag something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d622944-2375-4f63-b7ca-e6492d9be92a",
                                                "sense_id": "8dcac7eb-fc97-353b-91f1-c371bf95680c",
                                                "text": "Starting in 1818, a few women managed to break a the sex barrier that excluded them from active firefighting. [It was] hard work to draw the engine; but among the few who had hold of the dragrope was Molly, pulling away for dear life."
                                            },
                                            {
                                                "example_id": "8fcd8448-5042-40f5-aeb9-084acefbefe6",
                                                "sense_id": "8dcac7eb-fc97-353b-91f1-c371bf95680c",
                                                "text": "The side of our ship was wasp-coloured as befits a warship, black and yellow and streaming. Certainly the first operation of the dragrope had been successful until it jammed. There was no doubt of that.[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d97d380-7e88-31b2-8e52-ab346057d2ed",
                                        "entry_id": "a64c13f3-20e5-3a9f-bcfe-822590b813ce",
                                        "glosses": [
                                            "Alternative form of drag rope (“rope carried in a hot air balloon”)."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
