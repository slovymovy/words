                "senses": [
                    {
                        "sense_id": "48a54574-337a-392b-b865-36a36ad83b67",
                        "entry_id": "efb87c67-7c98-3d04-ad7a-73059d263dfb",
                        "glosses": [
                            "To put on the throne in a formal installation ceremony called enthronement, equivalent to (and often combined with) coronation and/or other ceremonies of investiture."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "1ec2d68b-7a65-4003-a3fc-a89362d8e755",
                                "sense_id": "48a54574-337a-392b-b865-36a36ad83b67",
                                "text": "Near-synonyms: coronate, crown"
                            },
                            {
                                "example_id": "a72a8568-bffb-48b5-90b0-c940fe40ecd1",
                                "sense_id": "48a54574-337a-392b-b865-36a36ad83b67",
                                "text": "ceremonially enthrone"
                            },
                            {
                                "example_id": "7e46007d-8f17-45dc-8903-adc592de40c2",
                                "sense_id": "48a54574-337a-392b-b865-36a36ad83b67",
                                "text": "enthrone a monarch"
                            },
                            {
                                "example_id": "81285ece-e980-451e-a83d-1a0047ffee31",
                                "sense_id": "48a54574-337a-392b-b865-36a36ad83b67",
                                "text": "The bishop came to enthrone the new archbishop."
                            }
                        ]
                    },
                    {
                        "sense_id": "127a03d7-9c0d-3fd6-9b43-720e766692a9",
                        "entry_id": "efb87c67-7c98-3d04-ad7a-73059d263dfb",
                        "glosses": [
                            "To help a candidate to the succession of a monarchy (as a kingmaker does), or by extension in any other major organisation."
                        ],
                        "tags": [
                            "figuratively",
                            "transitive"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8b318af1-189d-4ceb-8faf-0658bc5ffe17",
                        "source_entry_id": "efb87c67-7c98-3d04-ad7a-73059d263dfb",
                        "source_sense_description": "put on the throne",
                        "target_lang_word": "introniser",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "introniser",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ec205c38-5621-3d97-a7c0-403900d22b2e",
                                        "entry_id": "e2ce2785-3238-349d-a4eb-20735c9ecb34",
                                        "glosses": [
                                            "Placer sur le trône en cérémonie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe45ce28-ed4b-46ad-9558-f1dac099867e",
                                                "sense_id": "ec205c38-5621-3d97-a7c0-403900d22b2e",
                                                "text": "Ce prince fut sacré et intronisé."
                                            },
                                            {
                                                "example_id": "12cf16b9-26a8-47c0-8db1-f0f3d5fb9355",
                                                "sense_id": "ec205c38-5621-3d97-a7c0-403900d22b2e",
                                                "text": "On lui fit prêter le serment avant de l’introniser."
                                            },
                                            {
                                                "example_id": "ce21ba55-7ef5-45f6-82c8-8c17ffbe8701",
                                                "sense_id": "ec205c38-5621-3d97-a7c0-403900d22b2e",
                                                "text": "À peine le pape fut-il intronisé qu’il voulut bénir la ville de Rome."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f7346006-7532-3150-94a2-b61b9907bd4d",
                                        "entry_id": "e2ce2785-3238-349d-a4eb-20735c9ecb34",
                                        "glosses": [
                                            "Placer sur le trône en cérémonie.",
                                            "Placer un évêque sur son siège épiscopal, lorsqu’il prend possession de son église métropolitaine."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "daf5fba1-91db-4125-b063-d15fb6fbbff3",
                                                "sense_id": "f7346006-7532-3150-94a2-b61b9907bd4d",
                                                "text": "Après l’avoir intronisé, on chanta le Te Deum."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f6a50bdb-ace1-389b-b071-d0b0f08e2bc6",
                                        "entry_id": "e2ce2785-3238-349d-a4eb-20735c9ecb34",
                                        "glosses": [
                                            "Installer ou réinstaller une personne physique ou morale dans une fonction nouvelle ou précédemment déjà occupée."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3c57e7d3-b6c2-49dd-b396-4349d5829392",
                                                "sense_id": "f6a50bdb-ace1-389b-b071-d0b0f08e2bc6",
                                                "text": "Née en 1983, sur une idée de Jean-Philippe Lecat et à l’initiative des viticulteurs du cru, cette confrérie intronise des « baillis de Pommard ». Ruban : rouge, bleu et or. Insigne : une médaille. Haut lieu : le caveau communal de Pommard."
                                            },
                                            {
                                                "example_id": "f62e5695-56d9-4d85-96cb-0b92d8767a6c",
                                                "sense_id": "f6a50bdb-ace1-389b-b071-d0b0f08e2bc6",
                                                "text": "On nous dit qu’il faut remettre la Russie dans le jeu. Mais quel intérêt y a-t-il à introniser à nouveau un pays dont le but avoué est la destruction de l’ordre international et le ralliement de toute l’Europe à son régime militaro-policier ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
