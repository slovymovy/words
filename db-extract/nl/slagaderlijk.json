                        "examples": [
                            {
                                "example_id": "7dc90473-a624-4352-be19-3f66875af961",
                                "sense_id": "393a218e-3e81-321d-acee-4379f3c37a10",
                                "text": "De combinatie van wijsheid en slagaderlijk bloed was onweerstaanbaar, en Hillman had de les van zijn grootmoeder nooit vergeten. Zorg dat mensen op hun gemak zijn, en verkoop ze dan wat je maar wilt."
                            },
                            {
                                "example_id": "a6b89cb7-1fa5-4130-b8a9-7bf443c4b7bd",
                                "sense_id": "393a218e-3e81-321d-acee-4379f3c37a10",
                                "text": "Om soldaten beter te trainen kan de computergestuurde dummy bewegen en natuurgetrouw slagaderlijk bloeden. „Voorheen oefenden soldaten op elkaar”, vertelt instructeur John Hayden. „Maar dan trek je een tourniquet toch niet zo hard aan als zou moeten.”"
                            }
                        ]
                    }
