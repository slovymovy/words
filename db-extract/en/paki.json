                    {
                        "sense_id": "3c8614ed-7088-3afe-b2ac-71a726a68f27",
                        "entry_id": "d5612c67-0155-3bc7-bd50-a967d509ad5e",
                        "glosses": [
                            "A Pakistani."
                        ],
                        "tags": [
                            "Canada",
