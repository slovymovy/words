                            {
                                "example_id": "c62f90fe-c8d8-4ba3-864c-e0f13e737e02",
                                "sense_id": "d7e0b0f0-9274-327f-9daf-4d339a2d84a6",
                                "text": "Un certain nombre de grands magasins et de supermarchés, où les caissières étaient déguisées en sorcières, vendirent toutes sortes de produits « halloweenesques » (car cet adjectif fit son apparition) : des aliments, des boissons, des shampoings et même du papier hygiénique, sans oublier les déguisements et les décors."
                            }
                        ]
                    },
                    {
                        "sense_id": "057997be-8a44-3e75-b6d9-64ffd7945e17",
                        "entry_id": "839ee72e-6a48-379a-b2c5-8bfdfc4b6bba",
