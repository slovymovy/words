                "senses": [
                    {
                        "sense_id": "3e808737-a089-3bfb-960d-31eb25295921",
                        "entry_id": "92b43b7a-dbda-3611-9de4-d7d1b34ad9b2",
                        "glosses": [
                            "für die öffentliche Sicherheit verantwortliche Behörde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1469cc76-aea9-41e8-b13d-677975195b0e",
                                "sense_id": "3e808737-a089-3bfb-960d-31eb25295921",
                                "text": "„Was die Sicherheitsbehörden jedoch beunruhigt, ist das Umstand, dass sich die Tat in eine Serie von ähnlich erscheinenden Anschlägen einzureihen scheint.“"
                            },
                            {
                                "example_id": "5e4e3cc6-6576-4f8c-a1b7-3c7e43db6133",
                                "sense_id": "3e808737-a089-3bfb-960d-31eb25295921",
                                "text": "„Für die Pariser Sicherheitsbehörden ist der Fall heikel.“"
                            },
                            {
                                "example_id": "5e7763a6-9c9d-4dd0-a9a2-bc8c101ca9ea",
                                "sense_id": "3e808737-a089-3bfb-960d-31eb25295921",
                                "text": "„Sie galt den finnischen Sicherheitsbehörden zwischenzeitlich als Spionin.“"
                            },
                            {
                                "example_id": "fb0fbdf4-ae88-4b5e-86f2-3baf15b37c77",
                                "sense_id": "3e808737-a089-3bfb-960d-31eb25295921",
                                "text": "„Vor den Augen der Sicherheitsbehörden hat sich eine Szene von jungen, gewaltbereiten Neonazis etabliert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
