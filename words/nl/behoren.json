                },
                {
                    "sense_id": "1d65e83b-8b15-3767-95fe-3a83a0c53296",
                    "sense_definition": "passend of gepast zijn voor een bepaalde situatie of persoon",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "gepastheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het <w>behoort</w> niet aan mij om daarover te oordelen.",
                            "target_lang_translations": {
                                "en": "It does not <w>behoove</w> me to judge that.",
                                "ru": "Не мне <w>надлежит</w> судить об этом."
                            }
                        },
                        {
                            "text": "Zulk gedrag <w>behoort</w> een heer niet in het openbaar.",
                            "target_lang_translations": {
                                "en": "Such behavior does not <w>befit</w> a gentleman in public.",
                                "ru": "Такое поведение не <w>подобает</w> джентльмену на людях."
                            }
                        }
                    ],
                    "synonyms": [
                        "betamen",
                        "passen"
                    ],
                    "common_phrases": [
