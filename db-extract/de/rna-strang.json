                "senses": [
                    {
                        "sense_id": "41c19611-24aa-3fb3-8c8b-873a6ddf141e",
                        "entry_id": "43e6b972-267f-31b4-b550-f38c0e75e020",
                        "glosses": [
                            "Kette von hintereinanderhängenden Ribonukleotide/Nukleinbasen, die zusammen eine RNA bilden"
                        ],
                        "tags": [
                            "Molekularbiologie",
                            "molekulare Medizin"
                        ],
                        "examples": [
                            {
                                "example_id": "a45079b1-4005-42cf-911b-1e6f153aed03",
                                "sense_id": "41c19611-24aa-3fb3-8c8b-873a6ddf141e",
                                "text": "„Je drei im DNA- oder RNA-Strang aufeinanderfolgende Basen werden als Codon oder Basentriplett bezeichnet. Im oberen Beispiel wären ATG/AUG, CGC, AAT/AAU, usw. einzelne Codons oder Basentripletts.“"
                            },
                            {
                                "example_id": "da43fddd-d5ea-48ea-b8c4-0234dde805b9",
                                "sense_id": "41c19611-24aa-3fb3-8c8b-873a6ddf141e",
                                "text": "„Auch die RNA-Nukleotide werden über eine Esterbindung des Phosphatrests mit dem nächsten Zucker verknüpft und bilden so RNA-Stränge, die – als weiterer Unterschied zur DNA – allerdings einzelsträngig sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
