                        "glosses": [
                            "de leeftijd waarop men begint met het ontvangen van een ouderdomspensioen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86475044-accd-42e2-92e4-144d7e64240c",
                                "sense_id": "98fbe2f1-3dc5-3194-9b1b-9f59f088d7ec",
                                "text": "Zodra de werknemer de pensioenleeftijd heeft bereikt stopt automatisch het dienstverband en vervalt zijn recht op een ontslagvergoeding. Duizenden mensen hebben volgens vakbonden en juristen zo'n slapend dienstverband en stappen in toenemende mate naar de rechter."
                            },
                            {
                                "example_id": "9337302e-b02e-4d9c-8589-bef1b3a4e5be",
                                "sense_id": "98fbe2f1-3dc5-3194-9b1b-9f59f088d7ec",
                                "text": "Polen is door het Europees Hof van Justitie veroordeeld wegens discriminatie. Een Poolse wet waarin de pensioenleeftijd van vrouwelijke en mannelijke rechters verschilt, is in strijd met het Europees recht, is het oordeel van de rechters in Luxemburg."
                            }
                        ]
