                ],
                "senses": [
                    {
                        "sense_id": "410984cc-27a4-3619-9a50-790166a117d3",
                        "entry_id": "83401a66-c98e-3a86-8855-1795ad2f56e0",
                        "glosses": [
                            "Stoff/Substanz, das zur Pflege von etwas dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d832d30-49bc-4ef9-b5eb-f7d69b40c33c",
                                "sense_id": "410984cc-27a4-3619-9a50-790166a117d3",
                                "text": "„Verwende milde Reinigungs- und Pflegemittel und verzichte auf Duft-, Farb- und sonstige synthetische Zusatzstoffe.“"
                            },
                            {
                                "example_id": "f7a4936e-0eae-4372-8559-02b2cd6c7f52",
                                "sense_id": "410984cc-27a4-3619-9a50-790166a117d3",
                                "text": "„Eine Reihe von im Haushalt verwendeten Produkten (Reiniger, Pflegemittel, Spülmittel) enthalten zur Zeit geringe Mengen von Formaldehyd.“"
                            },
                            {
                                "example_id": "26b801ae-fd20-4521-8cef-42b61e5183df",
                                "sense_id": "410984cc-27a4-3619-9a50-790166a117d3",
                                "text": "„Vor dem Polieren tragen Sie zunächst das Pflegemittel auf.“"
                            },
                            {
                                "example_id": "063dba3a-2927-4176-a2be-9562ebf954b6",
                                "sense_id": "410984cc-27a4-3619-9a50-790166a117d3",
                                "text": "„Grafit ist als Pflegemittel ungeeignet, da es in Verbindung mit einem Flüssigspray zu einem Verkleben des Zylinders führt.“"
                            },
                            {
                                "example_id": "1001f0e9-1305-49cb-8676-8027628af33d",
                                "sense_id": "410984cc-27a4-3619-9a50-790166a117d3",
                                "text": "„Das Pflegepersonal muss sich über die Pflegemittel, die auf der Station verwendet werden und direkt oder indirekt mit der Haut des Patienten in Berührung kommen, informieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
