                        "glosses": [
                            "A red pimple."
                        ],
                        "tags": [
                            "nonce-word",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "93e1cd60-d619-47a8-b50c-fe3eb3641ac6",
                                "sense_id": "cfed64c1-5e89-3f75-91ef-a18dfd59e720",
                                "text": "His face is all bubukles, and whelks, and knobs, and flames o' fire; and his lips blows at his nose, and it is like a coal of fire, sometimes plue and sometimes red; but his nose is executed, and his fire's out."
                            },
                            {
                                "example_id": "2b5dac44-5d72-444a-b4ec-48bf7e3197af",
                                "sense_id": "cfed64c1-5e89-3f75-91ef-a18dfd59e720",
                                "text": "His moon face wore the perpetual smile of a simpleton and was headlighted by a bubukle nose. The facial blotch was not congenital but was from mustard gas in '17."
                            },
                            {
                                "example_id": "0f119eab-888d-4ec4-a035-a7fb68375a32",
                                "sense_id": "cfed64c1-5e89-3f75-91ef-a18dfd59e720",
                                "text": "Probably it was less painful to have white whelks than red carbuncles and bubukles."
                            }
                        ]
                    }
                ],
