                        "entry_id": "c7d8ed43-8cd2-3065-b088-65fd469303b4",
                        "glosses": [
                            "Femme qui ajoute les anses à des poteries ou céramiques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e449cfdf-4e4e-4c4f-9087-ebbf597758a2",
                                "sense_id": "418244c0-05da-3084-ac7a-df6f7e045cb3",
                                "text": "La femme devient garnisseuse. Elle colle aux pots et aux tasses les anses de porcelaine."
