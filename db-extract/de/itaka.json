                                    {
                                        "sense_id": "c6d1c785-791c-30b4-8c4c-3c8392c1dda7",
                                        "entry_id": "8abbc6ed-b517-3c60-827f-b6c515b7a850",
                                        "glosses": [
                                            "An Italian."
                                        ],
                                        "tags": [
                                            "British",
                                            "US",
                                            "derogatory",
                                            "ethnic",
                                            "slang",
                                            "slur"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17137962-3acd-4a03-9ba9-3c3761d6edda",
                                                "sense_id": "c6d1c785-791c-30b4-8c4c-3c8392c1dda7",
                                                "text": "The only danger of gas from the Eyeties was when they breathed garlic on you."
                                            },
                                            {
                                                "example_id": "fcecab3e-cb33-433c-aea0-3513d31936d5",
                                                "sense_id": "c6d1c785-791c-30b4-8c4c-3c8392c1dda7",
                                                "text": "We got out to sea again, but it was not long before the Eyeties were on our track again."
                                            },
                                            {
                                                "example_id": "e411f553-2a9c-4882-a117-d35e11f52ac4",
                                                "sense_id": "c6d1c785-791c-30b4-8c4c-3c8392c1dda7",
                                                "text": "The Frenchies eat 'em [small birds] and so do the Eyeties."
                                            },
                                            {
                                                "example_id": "1176b5fc-6513-4437-bbc7-4474d3bf0d22",
                                                "sense_id": "c6d1c785-791c-30b4-8c4c-3c8392c1dda7",
                                                "text": "D'you think they're Eyeties? Supposed to be great lovers..."
                                            },
                                            {
                                                "example_id": "1c12f018-7856-456e-a99f-2301c2d8f46c",
                                                "sense_id": "c6d1c785-791c-30b4-8c4c-3c8392c1dda7",
                                                "text": "'Someone give this girl the bumps! She's getting married. Ah, the good die young. What's his name again? Francesco. An eye-tie? I move for a mistrial."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
