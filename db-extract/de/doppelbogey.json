                "senses": [
                    {
                        "sense_id": "b49448d7-317e-38e4-bea3-32248d930ee3",
                        "entry_id": "fd6f0633-1204-32c0-96af-e01d0618c13e",
                        "glosses": [
                            "Bewältigung der Spielbahn mit zwei zusätzlichen Schlägen über Par"
                        ],
                        "tags": [
                            "Golfsport"
                        ],
                        "examples": [
                            {
                                "example_id": "e651a810-f6bc-48ba-87ff-9d1073ff9747",
                                "sense_id": "b49448d7-317e-38e4-bea3-32248d930ee3",
                                "text": "Das Doppelbogey am letzten Loch nahm ihm alle Siegermöglichkeiten."
                            },
                            {
                                "example_id": "4c7ebd2e-8195-4195-a652-d86aa4482a50",
                                "sense_id": "b49448d7-317e-38e4-bea3-32248d930ee3",
                                "text": "Insgesamt drei Bogeys und ein Doppelbogey bei nur zwei Birdies machten eine bessere Platzierung von Österreichs Aushängeschild zunichte."
                            },
                            {
                                "example_id": "db280210-a325-4a9a-9322-4823838f9c72",
                                "sense_id": "b49448d7-317e-38e4-bea3-32248d930ee3",
                                "text": "\"Warum sich mit Bogey begnügen, wenn es auch Doppelbogeys gibt?\" Sein Schlußsatz: \"Schönes Spiel!\""
                            },
                            {
                                "example_id": "676bcae8-f6ce-4881-aabc-4e3ff2c0abc2",
                                "sense_id": "b49448d7-317e-38e4-bea3-32248d930ee3",
                                "text": "Bei der Jagd auf seinen dritten Sieg nach 2001 und 2002 aber verlor er durch einen Doppelbogey am dritten Loch den Anschluss. Er hatte sich den falschen Schläger ausgesucht. »Das kann immer mal passieren«, meinte er anschließend."
                            },
                            {
                                "example_id": "454d3a49-eaa3-41f4-ac5f-1eb151e1aa22",
                                "sense_id": "b49448d7-317e-38e4-bea3-32248d930ee3",
                                "text": "Besonders Mickelson spielte überragend, erzielte auf den ersten acht Löchern sechs Birdies und stellte mit 30 Schlägen den Rekord für die ersten neun Löcher ein. Ein Doppelbogey am zwölften Loch beendete die Aufholjagd Mickelsons jedoch abrupt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
