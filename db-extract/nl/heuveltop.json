                                        "entry_id": "764c1ef4-5dbb-3e19-bc25-110433176b35",
                                        "glosses": [
                                            "Any of several birds in the family Regulidae, including the goldcrests and firecrests."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
