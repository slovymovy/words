                "senses": [
                    {
                        "sense_id": "9b68549c-80de-3f07-8275-02edd225ce80",
                        "entry_id": "f99a71a9-72e5-38ba-9793-81d0891fac8d",
                        "glosses": [
                            "von den Eskimos (Inuit) entwickelte Technik zum Aufrichten eines gekenterten Kajaks, ohne dabei auszusteigen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "40d43db4-c9eb-4fc4-aadd-8492d6a3ec86",
                                "sense_id": "9b68549c-80de-3f07-8275-02edd225ce80",
                                "text": "„Der Schwimmlehrer geht ins Becken, demonstriert, wie man mit dem Kanu eine Eskimorolle macht.“"
                            },
                            {
                                "example_id": "834bf490-33c8-49d0-ab54-6c489873af6c",
                                "sense_id": "9b68549c-80de-3f07-8275-02edd225ce80",
                                "text": "„Dann kippen sie jedoch zur Seite und kommen wie die Kajakfahrer nach einer Eskimorolle, wieder nach oben.“"
                            },
                            {
                                "example_id": "8313fdf4-c4b3-4fd9-b147-339e17928a3b",
                                "sense_id": "9b68549c-80de-3f07-8275-02edd225ce80",
                                "text": "„Kajakfreunden lehrte er unermüdlich die Eskimorolle.“"
                            },
                            {
                                "example_id": "9dede5c8-6aab-4c27-b1ee-3c6de5cf5885",
                                "sense_id": "9b68549c-80de-3f07-8275-02edd225ce80",
                                "text": "„Im Sommer geht es unter fachmännischer Anleitung zum Kajakfahren - auch Kurse zum Erlernen der Eskimorolle -, Rafting, Abseilen oder Power-Kiting.“"
                            },
                            {
                                "example_id": "6f60123f-c928-4585-b1bb-47d08f1e677d",
                                "sense_id": "9b68549c-80de-3f07-8275-02edd225ce80",
                                "text": "„Das Schiff ist so gebaut, dass es sich – egal was passiert – immer wieder nach oben dreht, eine Eskimorolle macht.“"
                            },
                            {
                                "example_id": "f0176809-c4a8-47c6-b5b1-c6d5c7b4383a",
                                "sense_id": "9b68549c-80de-3f07-8275-02edd225ce80",
                                "text": "„Schon mit neun Jahren schaffte er eine Eskimorolle, und mit zehn die Handrolle.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
