                        "examples": [
                            {
                                "example_id": "ff81ad1a-0809-4695-8f02-bbba74d35d23",
                                "sense_id": "32400f70-5c68-339d-948a-82fe4d8b85f3",
                                "text": "Twee medewerkers in het politiebureau zagen een auto op ongeveer 25 meter van het gebouw stoppen. Door het geopende portierraam werd een lang vuurwapen naar buiten gestoken, waarop de medewerkers meteen dekking zochten en alarm sloegen."
                            },
                            {
                                "example_id": "19cfa087-98d6-4d6f-af0f-ed17d083a33b",
                                "sense_id": "32400f70-5c68-339d-948a-82fe4d8b85f3",
                                "text": "Zeker een van de kogels verbrijzelt het portierraam aan de bestuurderskant."
                            }
                        ]
                    }
