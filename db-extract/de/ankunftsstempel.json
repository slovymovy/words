                "senses": [
                    {
                        "sense_id": "78da2536-c607-3cd1-9232-5cef32595a10",
                        "entry_id": "c670f388-4009-3834-9ad1-247011ff892b",
                        "glosses": [
                            "Stempel, mit dem bestätigt wird, dass und wann eine Postsendung am Ziel angekommen ist"
                        ],
                        "tags": [
                            "Philatelie"
                        ],
                        "examples": [
                            {
                                "example_id": "46beff61-fbd4-42cc-a029-fb18945657e7",
                                "sense_id": "78da2536-c607-3cd1-9232-5cef32595a10",
                                "text": "„Wichtig ist bei derartigen Ballonbriefen, dass sie einen Ankunftsstempel tragen, denn nur das beweist, dass es gelang, den Brief aus Paris auszufliegen.“"
                            },
                            {
                                "example_id": "b7200c05-1191-44e9-afe1-ebce7e3838e6",
                                "sense_id": "78da2536-c607-3cd1-9232-5cef32595a10",
                                "text": "„Diese Karte vom Rathaus mit Stadtwappen wurde im Farbkunstdruckverfahren hergestellt, trägt den Postaufgabestempel Duderstadt vom 13. Juni 1903 und den Ankunftsstempel Homburg v.d.H. vom 16. Juni 1903.“"
                            },
                            {
                                "example_id": "bb62410e-0626-4035-aa5a-6ce8cf7d5641",
                                "sense_id": "78da2536-c607-3cd1-9232-5cef32595a10",
                                "text": "„Ankunftsstempel waren in Deutschland nur bei eingeschriebenen Sendungen üblich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
