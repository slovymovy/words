                "senses": [
                    {
                        "sense_id": "b8349491-6c6e-3845-bbcb-e0574cd9a7ea",
                        "entry_id": "48aa600f-3702-3f09-aa86-c48d496bc91d",
                        "glosses": [
                            "Fähigkeit eines Menschen, Verantwortung für sein eigenes Leben zu übernehmen und die verschiedenen Aspekte seines Lebens aktiv zu steuern und zu gestalten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "744ebf16-4325-42b9-a596-7e17eacee329",
                                "sense_id": "b8349491-6c6e-3845-bbcb-e0574cd9a7ea",
                                "text": "„Selbstmanagement ist eine der wichtigsten Fähigkeiten, die man im Leben erlernen sollte.“"
                            },
                            {
                                "example_id": "641bfebf-847e-44f7-bd63-dfb772538b1c",
                                "sense_id": "b8349491-6c6e-3845-bbcb-e0574cd9a7ea",
                                "text": "„Die Fähigkeit zum Selbstmanagement gehört zu den wichtigen Eigenschaften einer Führungskraft.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "36b1a8fe-fc39-4327-9215-1cf2d411134b",
                        "source_entry_id": "48aa600f-3702-3f09-aa86-c48d496bc91d",
                        "source_sense_id": "b8349491-6c6e-3845-bbcb-e0574cd9a7ea",
                        "source_sense_description": "Steuerung des eigenen Lebens",
                        "target_lang_word": "self-management",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "self-management",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6ccb3f61-9808-334e-b0d5-f3670069a402",
                                        "entry_id": "36aab378-9518-3533-a9d6-503baaba266e",
                                        "glosses": [
                                            "a form of management encompassing self-directed work processes by an organization's workforce with or without joint control by workers and management."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06301de5-f82c-46b3-9160-65d586f77aea",
                                                "sense_id": "6ccb3f61-9808-334e-b0d5-f3670069a402",
                                                "text": "The self-management idea has many variants. All the workers may manage together directly, by means of an assembly, or indirectly by electing a supervisory board. They may manage in co-operation with a group of specialized managers or they may do without them."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
