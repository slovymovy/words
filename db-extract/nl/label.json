                "senses": [
                    {
                        "sense_id": "0cbe1628-ef4f-3641-98a2-6ea9af9d3b0a",
                        "entry_id": "d7874722-34fd-3ecb-8cd5-d60d5d8a5b30",
                        "glosses": [
                            "kaart met extra informatie, etiket"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "26d3fe3b-4ec4-47e3-9fbb-a4c33adbe638",
                                "sense_id": "0cbe1628-ef4f-3641-98a2-6ea9af9d3b0a",
                                "text": "Op het label in de trui kun je lezen wat de maat is en wat het wasvoorschrift is."
                            },
                            {
                                "example_id": "cca462b4-b9fb-4403-8272-1fceb42ddb5c",
                                "sense_id": "0cbe1628-ef4f-3641-98a2-6ea9af9d3b0a",
                                "text": "Webwinkels zijn het beu dat een deel van de klanten kleding en andere spullen gebruikt om het vervolgens retour te sturen. Ze starten samen met brancheorganisatie Thuiswinkel.org een proef met labels die aan producten worden bevestigd. Alleen als het label nog aan het product zit, mag het binnen 14 dagen worden teruggestuurd en kunnen klanten het volledige bedrag terugkrijgen."
                            }
                        ]
                    },
                    {
                        "sense_id": "92f3db93-5713-3503-8e20-a1c58a8ef063",
                        "entry_id": "d7874722-34fd-3ecb-8cd5-d60d5d8a5b30",
                        "glosses": [
                            "cd- of grammofoonplatenmerk"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aeca9d6a-72bd-43d6-8c76-e3d656d89972",
                                "sense_id": "92f3db93-5713-3503-8e20-a1c58a8ef063",
                                "text": "Phonogram is een bekend platenlabel."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7ba0b285-f1d1-47cc-a853-714602f7792b",
                        "source_entry_id": "d7874722-34fd-3ecb-8cd5-d60d5d8a5b30",
                        "target_lang_word": "etiquette",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "etiquette",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ffd73367-51f2-326c-a930-eeab2f8b8951",
                                        "entry_id": "b0c4c6f7-4781-3169-8da6-02bebe01b166",
                                        "glosses": [
                                            "The manners or decent behaviour to be observed in social or professional life; conventional decorum; the ceremonial code of polite society."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "25c2b673-52ed-4d41-b804-fe8bcfc083c6",
                                                "sense_id": "ffd73367-51f2-326c-a930-eeab2f8b8951",
                                                "text": "20 May 2018, Hadley Freeman in The Guardian, Is Meghan Markle the American the royals have needed all along?\nMuch shock was expressed in the British press about the Palace’s utter failure to control the Markles and the Markles’ lack of etiquette."
                                            },
                                            {
                                                "example_id": "ada3d8e4-ae5d-4dff-be11-dbbd1123d7d2",
                                                "sense_id": "ffd73367-51f2-326c-a930-eeab2f8b8951",
                                                "text": "Whenever Root would put his elbows on the table or clatter his dishes or commit any other breach of etiquette, the Professor would gently correct him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2c848035-96c2-36d1-8b0c-90a3e6bf48da",
                                        "entry_id": "b0c4c6f7-4781-3169-8da6-02bebe01b166",
                                        "glosses": [
                                            "The customary behavior of members of a profession, business, law, or sports team towards each other."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a7455b6f-2423-4c77-92df-de670558da0e",
                                                "sense_id": "2c848035-96c2-36d1-8b0c-90a3e6bf48da",
                                                "text": "Cycling's complex etiquette contains an unwritten rule that riders in contention for a race win should not be penalised for sheer misfortune."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a0c4aaa-91d6-3d15-86f5-41b82b439c28",
                                        "entry_id": "b0c4c6f7-4781-3169-8da6-02bebe01b166",
                                        "glosses": [
                                            "A label used to indicate that a letter is to be sent by airmail."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "00b1978f-f757-4aec-ac1e-fca7f6df9b60",
                        "source_entry_id": "d7874722-34fd-3ecb-8cd5-d60d5d8a5b30",
                        "target_lang_word": "label",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "label",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "63ff2689-a316-3275-8ba6-51a572c7dd6b",
                                        "entry_id": "b2e32605-e6ac-3e96-8019-a8694ba44797",
                                        "glosses": [
                                            "A small ticket or sign giving information about something to which it is attached or intended to be attached."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b69f686-05cd-4a8b-9267-60eaf35af4df",
                                                "sense_id": "63ff2689-a316-3275-8ba6-51a572c7dd6b",
                                                "text": "We laughed at her because the label was still on her new sweater."
                                            },
                                            {
                                                "example_id": "dae0a64b-43f4-4e37-96de-15d348a9a151",
                                                "sense_id": "63ff2689-a316-3275-8ba6-51a572c7dd6b",
                                                "text": "The label says this silk scarf should not be washed in the washing machine."
                                            },
                                            {
                                                "example_id": "ca46dc98-ba32-41d0-a9b7-8f18746f9237",
                                                "sense_id": "63ff2689-a316-3275-8ba6-51a572c7dd6b",
                                                "text": "Although the label priced this poster at three pounds, I got it for two."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "56a091c4-12b4-3919-95db-79bf91931577",
                                        "entry_id": "b2e32605-e6ac-3e96-8019-a8694ba44797",
                                        "glosses": [
                                            "A name given to something or someone to categorise them as part of a particular social group."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c956cfec-4732-482d-bdf9-f042ef0fc2c9",
                                                "sense_id": "56a091c4-12b4-3919-95db-79bf91931577",
                                                "text": "Ever since he started going to the rock club, he's been given the label \"waster\"."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4dc85d6a-9f35-3caf-9386-9fc007a4ee0c",
                                        "entry_id": "b2e32605-e6ac-3e96-8019-a8694ba44797",
                                        "glosses": [
                                            "A company that sells records."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ba471b8-d8a9-481d-8671-acd7ccb9df8f",
                                                "sense_id": "4dc85d6a-9f35-3caf-9386-9fc007a4ee0c",
                                                "text": "The label signed the band after hearing a demo tape."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7960a659-3f37-361c-a39d-e7dbbe0725d9",
                                        "entry_id": "b2e32605-e6ac-3e96-8019-a8694ba44797",
                                        "glosses": [
                                            "A user-defined alias for a numerical designation, the reverse of an enumeration."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56cc8f3c-9bef-479f-95e1-06fae6c567cb",
                                                "sense_id": "7960a659-3f37-361c-a39d-e7dbbe0725d9",
                                                "text": "Storage devices can be given by label or ID."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f34de842-6c2e-31f6-be63-62f8227e6210",
                                        "entry_id": "b2e32605-e6ac-3e96-8019-a8694ba44797",
                                        "glosses": [
                                            "A named place in source code that can be jumped to using a GOTO or equivalent construct."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6ee8d5e4-3d7e-3513-9a82-ea0c59e883a1",
                                        "entry_id": "b2e32605-e6ac-3e96-8019-a8694ba44797",
                                        "glosses": [
                                            "A charge resembling the strap crossing the horse’s chest from which pendants are hung."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9f5fbd9b-2100-388d-96ac-057e3eea07b6",
                                        "entry_id": "b2e32605-e6ac-3e96-8019-a8694ba44797",
                                        "glosses": [
                                            "A tassel."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "36fa1ad0-ddc2-4db9-9899-cf6b430dec83",
                                                "sense_id": "9f5fbd9b-2100-388d-96ac-057e3eea07b6",
                                                "text": "the arms or escutcheon of France , hanging by a label on an oak"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3d36142b-042f-3074-bdb7-f920ece2e825",
                                        "entry_id": "b2e32605-e6ac-3e96-8019-a8694ba44797",
                                        "glosses": [
                                            "A small strip, especially of paper or parchment (or of some material attached to parchment to carry the seal), but also of iron, brass, land, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92bfd12d-9ce4-4f0d-b859-f6452b68096d",
                                                "sense_id": "3d36142b-042f-3074-bdb7-f920ece2e825",
                                                "text": "Ere this hand, by thee to Romeo seal'd, / Shall be the label to another deed."
                                            },
                                            {
                                                "example_id": "e87b29fe-66c2-4687-8e2d-94c15200d1db",
                                                "sense_id": "3d36142b-042f-3074-bdb7-f920ece2e825",
                                                "text": "They […] 'sealed the grave, and rolled a great stone at the mouth of it' and as an ancient tradition says, bound it about with labels of iron."
                                            },
                                            {
                                                "example_id": "fc3ab569-9362-4096-8d2d-cd5adb3ae32f",
                                                "sense_id": "3d36142b-042f-3074-bdb7-f920ece2e825",
                                                "text": "Where Balak met Balaam, standing as it were on his tiptoes on the very last labell of his land, to reach forth […]"
                                            },
                                            {
                                                "example_id": "b88e04ef-40bc-4791-a2f6-326a0828fd7d",
                                                "sense_id": "3d36142b-042f-3074-bdb7-f920ece2e825",
                                                "text": "The flesh and skin hung down in long Collops and Labels."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4e3463b1-3d20-39a3-aa1d-8d41b3b8d9c6",
                                        "entry_id": "b2e32605-e6ac-3e96-8019-a8694ba44797",
                                        "glosses": [
                                            "A piece of writing added to something, such as a codicil appended to a will."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b299ea71-b0ff-3837-a25b-47f81a5a52c3",
                                        "entry_id": "b2e32605-e6ac-3e96-8019-a8694ba44797",
                                        "glosses": [
                                            "A brass rule with sights, formerly used with a circumferentor to take altitudes."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fd2a141b-6483-3024-8e63-20280a0064e0",
                                        "entry_id": "b2e32605-e6ac-3e96-8019-a8694ba44797",
                                        "glosses": [
                                            "The projecting moulding by the sides, and over the tops, of openings in mediaeval architecture."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e90e7986-646f-4681-82f9-2f0635933a98",
                                                "sense_id": "fd2a141b-6483-3024-8e63-20280a0064e0",
                                                "text": "Sculptured ends of labels are called label-stops."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b5ed6e0-8d10-3091-9e05-c8623195013e",
                                        "entry_id": "b2e32605-e6ac-3e96-8019-a8694ba44797",
                                        "glosses": [
                                            "In mediaeval and later art, a representation of a band or scroll containing an inscription."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43862f1e-81e4-404d-b5e8-3ca9924e27d5",
                                                "sense_id": "4b5ed6e0-8d10-3091-9e05-c8623195013e",
                                                "text": "2654. Two-handled globular vase; early Deruta lustred ware; centre surrounded by a band of scroll work; on each side the neck is an oval compartment with clasped hands, and a label scroll inscribed \"Co pura fe.;\" decoration, blue outline on white ground filled in with yellow lustre."
                                            },
                                            {
                                                "example_id": "e81fd5c6-f267-4274-a90e-17fc76153c43",
                                                "sense_id": "4b5ed6e0-8d10-3091-9e05-c8623195013e",
                                                "text": "Boime correctly suggests that medieval artists who employed labels or scrolls to gloss illustrations typically configured text and image in visually overlapping, but cognitively separate, spaces."
                                            },
                                            {
                                                "example_id": "3534bafc-6072-477d-bc07-667f4e5e651b",
                                                "sense_id": "4b5ed6e0-8d10-3091-9e05-c8623195013e",
                                                "text": "The author notes that:\nEach of these held in one Hand a Scroll or Label, upon which were inscribed in Latin, but in the Old English Character, the Names of Kings and Saints of the Royal Line of MERCIA. Many of the Labels are broke off, others are so much defaced, that only a Syllable or two can be read."
                                            },
                                            {
                                                "example_id": "e41f88fb-16eb-4f37-af10-b5a2f157dca0",
                                                "sense_id": "4b5ed6e0-8d10-3091-9e05-c8623195013e",
                                                "text": "While word balloons had been present in Europe for some time, from the phylactery (inscribed scroll) seen in medieval art to the 'labels' or 'banners' of nineteenth-century English satirical illustrator George Cruikshank, among others ..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a5a0e53-8379-3008-9aac-e9308cf79f89",
                                        "entry_id": "b2e32605-e6ac-3e96-8019-a8694ba44797",
                                        "glosses": [
                                            "A non-interactive control or widget displaying text, often used to describe the purpose of another control."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "label",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "41c4c52a-c077-3fd0-9e42-4d91ab376c2c",
                                        "entry_id": "c467307d-5660-377a-9fba-0655df6418c5",
                                        "glosses": [
                                            "To put a label (a ticket or sign) on (something)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc8b2c08-b51f-49f3-b02b-274068b7004a",
                                                "sense_id": "41c4c52a-c077-3fd0-9e42-4d91ab376c2c",
                                                "text": "The shop assistant labeled all the products in the shop."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4d687195-35c4-3762-ac25-c20c68b8f70e",
                                        "entry_id": "c467307d-5660-377a-9fba-0655df6418c5",
                                        "glosses": [
                                            "To give a label to (someone or something) in order to categorise that person or thing."
                                        ],
                                        "tags": [
                                            "ditransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "81a5dc5b-d44a-468d-9236-d87a1dc17bc2",
                                                "sense_id": "4d687195-35c4-3762-ac25-c20c68b8f70e",
                                                "text": "He's been unfairly labeled as a cheat, although he's only ever cheated once."
                                            },
                                            {
                                                "example_id": "90d810f5-9fdb-4095-8802-8f4043f96c7b",
                                                "sense_id": "4d687195-35c4-3762-ac25-c20c68b8f70e",
                                                "text": "A friend of mine who runs an intellectual magazine was grousing about his movie critic, complaining that though the fellow had liked The Godfather (page 58), he had neglected to label it clearly as a masterpiece."
                                            },
                                            {
                                                "example_id": "c813f4f1-3afa-4ef4-8c8a-9c87c6f9ba7c",
                                                "sense_id": "4d687195-35c4-3762-ac25-c20c68b8f70e",
                                                "text": "And the liberal blogosphere has long labeled Clinton part of the neoconservative wing, a conservative intellectual movement that supports an interventionist foreign policy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3d022f6f-781d-3ae7-bfe2-86d244e245e1",
                                        "entry_id": "c467307d-5660-377a-9fba-0655df6418c5",
                                        "glosses": [
                                            "To replace specific atoms by their isotope in order to track the presence or movement of this isotope through a reaction, metabolic pathway or cell."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d130ec96-851f-3599-977e-fc9275a4f8a6",
                                        "entry_id": "c467307d-5660-377a-9fba-0655df6418c5",
                                        "glosses": [
                                            "To add a detectable substance, either transiently or permanently, to a biological substance in order to track the presence of the label-substance combination either in situ or in vitro"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3111f36-405d-4089-8058-30c6ef865170",
                                                "sense_id": "d130ec96-851f-3599-977e-fc9275a4f8a6",
                                                "text": "They may be used to label and image a protein within tissue, to isolate cells on the basis of marker expression, or to physically capture a protein from a complex biological mixture...."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "959d2413-f579-472e-b3f9-ba8302cddba8",
