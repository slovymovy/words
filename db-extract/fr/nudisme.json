        "fr-extract.jsonl": [
            {
                "entry_id": "801b18df-b155-3fe3-a444-bafb9a1ea839",
                "word": "nudisme",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "988dbbc9-9bfb-4b20-a71d-3f1879a31118",
                        "entry_id": "801b18df-b155-3fe3-a444-bafb9a1ea839",
                        "tags": [
                            "plural"
                        ],
                        "form": "nudismes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e876c7f0-8805-36fb-ba31-fac9945f57da",
                        "entry_id": "801b18df-b155-3fe3-a444-bafb9a1ea839",
                        "glosses": [
                            "Mouvement qui prône la nudité pour assurer une bonne hygiène du corps et de l'esprit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "29b96e53-0ffd-41e5-9ccc-e09aa9017a8d",
                                "sense_id": "e876c7f0-8805-36fb-ba31-fac9945f57da",
                                "text": "Etonnez-vous, après cela, qu'un prophète se soit élevé récemment aux Etats-Unis pour prêcher le retour à la nature, le nudisme édénique que préconisaient déjà les adamites du dix-huitième siècle !"
                            },
                            {
                                "example_id": "4a65ccda-7f1e-47e7-a567-4a10a7608efb",
                                "sense_id": "e876c7f0-8805-36fb-ba31-fac9945f57da",
                                "text": "Etonnez-vous, après cela, qu'un prophète se soit élevé récemment aux Etats-Unis pour prêcher le retour à la nature, le nudisme édénique que préconisaient déjà les adamites du dix-huitième siècle !"
                            },
                            {
                                "example_id": "70c7e8e5-1a5f-430e-9d7d-82d3ccf61492",
                                "sense_id": "e876c7f0-8805-36fb-ba31-fac9945f57da",
                                "text": "Les détracteurs du nudisme - les moralistes ou hygiénistes conservateurs d’État ou d’Église - prétendent que la vue du nu, que la fréquentation entre nudistes des deux sexes exaltent le désir érotique."
                            },
                            {
                                "example_id": "40a74513-7d93-4097-99af-9080c91d76bf",
                                "sense_id": "e876c7f0-8805-36fb-ba31-fac9945f57da",
                                "text": "C'était l'époque où le nudisme sportif et pédagogique commençait à ravager la conscience allemande, où des pasteurs dans la force de l'âge, hennissant à l'appel du nu, éprouvaient soudain le besoin de se mettre nus au fond des bois."
                            }
                        ]
                    }
                ],
