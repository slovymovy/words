                    {
                        "translation_id": "c0d9ba95-447d-450c-bbfb-5957f7340a68",
                        "source_entry_id": "32e4dd9a-6e8c-3b91-a7bc-7a82f9df5030",
                        "source_sense_description": "age 30–39",
                        "target_lang_word": "trentaine",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "trentaine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9588bbbb-f462-308e-9180-9458172237d4",
                                        "entry_id": "0d03e74d-f9c7-384f-81a3-1d2e9061c490",
                                        "glosses": [
                                            "Réunion de personnes ou de choses de même nature au nombre de trente ou environ."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f2eb313-d265-4075-9d27-620a38a0bab9",
                                                "sense_id": "9588bbbb-f462-308e-9180-9458172237d4",
                                                "text": "Après quelques années passées à Paris sous le spécieux prétexte de faire son droit, Artémon était revenu à La Ciotat, laissant une trentaine de mille francs de dettes derrière lui, qui avaient sans doute aidé au retour de l’enfant prodigue."
                                            },
                                            {
                                                "example_id": "5dc63c10-0043-421c-bfae-6d4a15245333",
                                                "sense_id": "9588bbbb-f462-308e-9180-9458172237d4",
                                                "text": "Pour une trentaine de sous, on achetait un lapin aux éclusiers et on le fricassait en chemin, sur un coupon garni de gazon et de pierres."
                                            },
                                            {
                                                "example_id": "172ae001-89a1-49ab-a5d0-174a009772d1",
                                                "sense_id": "9588bbbb-f462-308e-9180-9458172237d4",
                                                "text": "Le canot bascule sur le berthon, se met à glisser vers l'avant écrasant une trentaine de personnes et blessant grièvement à la jambe Isaac Lehmann."
                                            },
                                            {
                                                "example_id": "9f4892b0-50f8-4ba8-86a2-9ebfcac2a9a8",
                                                "sense_id": "9588bbbb-f462-308e-9180-9458172237d4",
                                                "text": "Un mât d'une trentaine de mètres fend le ciel gris de Jouy-le-Châtel, en Seine-et-Marne. De loin, c'est la partie la plus visible d'une immense plate-forme de forage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0b4f5b60-fc72-3d4c-a4ca-53f0a493c1a5",
                                        "entry_id": "0d03e74d-f9c7-384f-81a3-1d2e9061c490",
                                        "glosses": [
                                            "L’âge de trente ans."
                                        ],
                                        "tags": [
                                            "Absolument"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "452a31c4-ef22-45d5-8735-1c4413ed1d4b",
                                                "sense_id": "0b4f5b60-fc72-3d4c-a4ca-53f0a493c1a5",
                                                "text": "Pau, Camille, Juliette, Tiphaine, Laura et Samuel, tous proches de la trentaine, ont choisi de fonder une éco-location, dans le 12ᵉ arrondissement."
                                            },
                                            {
                                                "example_id": "fb1c01b4-cedf-40cc-ad5d-030ef318a983",
                                                "sense_id": "0b4f5b60-fc72-3d4c-a4ca-53f0a493c1a5",
                                                "text": "Vous voilà encore dans la fleur de l’âge. Cependant, quand on a passé la trentaine, croyez-moi, on commence à devenir vieux garçon."
                                            },
                                            {
                                                "example_id": "d70ce9c3-b8e2-400d-b33b-d8281b6092b1",
                                                "sense_id": "0b4f5b60-fc72-3d4c-a4ca-53f0a493c1a5",
                                                "text": "[…] : ce petit branleur avait indiscutablement une tête de vainqueur. Une petite trentaine, les cheveux courts, blonds, brossés en arrière et dorés par le soleil, un physique de maître-nageur, tout du cliché."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ecba004f-cc1b-3eba-b491-2364d334e9a9",
                                        "entry_id": "0d03e74d-f9c7-384f-81a3-1d2e9061c490",
                                        "glosses": [
                                            "Période de la vie entre 30 et 39 ans."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12e1d5d2-ddd0-4040-b178-d1e935499e00",
                                                "sense_id": "ecba004f-cc1b-3eba-b491-2364d334e9a9",
                                                "text": "Autour de la trentaine, soit avant l'épuisement des stocks de follicules ovariens, le processus commence à dysfonctionner et la fertilité à chuter."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
