            "senses": [
                {
                    "sense_id": "b6d4767f-d578-3351-88c1-25901a6a7c0d",
                    "sense_definition": "Qui exprime une louange ou une appréciation agréable et valorisante.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le directeur a fait un éloge très <w>flatteur</w> de notre travail devant toute l'équipe."
                        },
                        {
                            "text": "Recevoir une telle distinction est particulièrement <w>flatteur</w> pour un jeune chercheur."
                        }
                    ],
                    "common_phrases": [
                        "éloge flatteur",
                        "remarque flatteuse"
                    ]
                },
                {
                    "sense_id": "6d05be9a-5a87-36ac-9800-5934b0508077",
                    "sense_definition": "Qui met en valeur une personne ou avantage son apparence physique.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette nouvelle robe rouge a une coupe très <w>flatteuse</w> pour sa silhouette."
                        },
                        {
                            "text": "Le photographe a choisi une lumière particulièrement <w>flatteuse</w> pour ce portrait."
                        }
                    ],
                    "common_phrases": [
