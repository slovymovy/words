                        "sense_id": "6f0842ab-38df-3caf-a7f9-74c1468a04a9",
                        "entry_id": "b5c268f6-13f6-3fab-89b8-cbcb4296ebf8",
                        "glosses": [
                            "farewell party held before the demolition of a building"
                        ],
                        "tags": [
                            "colloquial",
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "1128a101-b4b8-4c03-b80b-cdfdcc35b4a1",
                                "sense_id": "6f0842ab-38df-3caf-a7f9-74c1468a04a9",
                                "text": "So groß die Lust ist, sich von der Realität auszuklinken und mit seinen Freund_innen für die nächsten Jahre eine einzige, unendliche Abrissparty zu feiern, so ist der Ekel vor dem Egoismus der ­Boomer zu groß, um sich deren Verhalten anzueignen.",
                                "translation": "As appealing as it may be to unplug from reality and spend the next few years throwing one endless demolition party with your friends, the disgust toward the selfishness of the boomers is too overwhelming to ever mimic their behavior.",
                                "english": "As appealing as it may be to unplug from reality and spend the next few years throwing one endless demolition party with your friends, the disgust toward the selfishness of the boomers is too overwhelming to ever mimic their behavior."
                            }
                        ]
                    }
