                                            {
                                                "example_id": "b20b8040-5951-4657-b993-53fa7d42d072",
                                                "sense_id": "f97356df-7a97-3e0a-ac7e-2218f26f9e0c",
                                                "text": "Incrustée dans mes narines, l’odeur de tant de crimes : matricides, parricides, viols et vols, homicides et meurtres et surtout, l’odeur de tant de souffrances."
                                            },
                                            {
                                                "example_id": "271a2ec9-148f-45a5-9caf-9b8d4c6f96b9",
                                                "sense_id": "f97356df-7a97-3e0a-ac7e-2218f26f9e0c",
                                                "text": "Dans le grand monde, on ne se vantait jamais de s’être masturbé. Se battre les couilles en neige à l’heure où blanchit la campagne ne représentait d’aucune façon une prouesse glorieuse. Se souiller à la paluche restait pourtant acte d’anarchie. Le premier, avant même le matricide."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "matricide",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "36c60af6-95c5-36c8-a61e-7c555f7e259d",
                                        "entry_id": "0cfcb18b-bfcf-389b-9045-842e3099da82",
                                        "glosses": [
                                            "Qui tue la mère."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf466096-3f35-4e22-9572-4c707c5a1e32",
                                                "sense_id": "36c60af6-95c5-36c8-a61e-7c555f7e259d",
                                                "text": "Il existe d’ailleurs toute une littérature autour du thème de l’écriture vue comme phénomène matricide. En effet, si écrire c’est naître une deuxième fois, c’est aussi refuser sa naissance matricielle. C’est se réinventer."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
