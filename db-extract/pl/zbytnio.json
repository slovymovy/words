                                                "example_id": "2f202b5b-816e-4bea-9598-65ea94a5ce4a",
                                                "sense_id": "37071dc2-7f76-398e-b030-7ceadd590072",
                                                "text": "そうめんのあまりを炒めて食べた。"
                                            },
                                            {
                                                "example_id": "1f02c450-f560-462b-ae67-c123554e8443",
                                                "sense_id": "37071dc2-7f76-398e-b030-7ceadd590072",
                                                "text": "欠点を補ってあまりあるだけの魅力がある。"
                                            },
