                "senses": [
                    {
                        "sense_id": "ecfd99e2-33a1-3045-9641-60d5adf10e94",
                        "entry_id": "c05fe245-f660-3652-b027-2962c72f4929",
                        "glosses": [
                            "Data that describes other data, serving as an informative label."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "e0ddab99-3e21-47a4-8fd5-9040e35aef5a",
                                "sense_id": "ecfd99e2-33a1-3045-9641-60d5adf10e94",
                                "text": "Most websites contain metadata to tell the computer how to lay out the content on the screen."
                            }
                        ]
                    },
                    {
                        "sense_id": "9794f291-930c-3299-b963-2368b543c27b",
                        "entry_id": "c05fe245-f660-3652-b027-2962c72f4929",
                        "glosses": [
                            "Structured information about a file (date created, creator, software used to create, last modified, file format, file fingerprint, etc)."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "1679edd5-34f5-4213-bae8-1bcdc64ec5f7",
                                "sense_id": "9794f291-930c-3299-b963-2368b543c27b",
                                "text": "That photo's metadata suggests it was edited using Photoshop."
                            }
                        ]
                    }
                ],
                "translations": [
