                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "rahat",
                                "target_lang_sense_clarification": "stresten uzak, keyifli"
                            },
                            {
                                "target_lang_word": "huzurlu",
                                "target_lang_sense_clarification": "sakin ve dingin"
                            },
                            {
                                "target_lang_word": "sakin",
                                "target_lang_sense_clarification": "telaşsız ve telaş uyandırmayan"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "wyluzowany",
                                "target_lang_sense_clarification": "spokojny, bez napięcia i stresu"
                            },
                            {
                                "target_lang_word": "spokojny",
                                "target_lang_sense_clarification": "zrelaksowany, sielski"
                            },
                            {
                                "target_lang_word": "leniwy",
                                "target_lang_sense_clarification": "o czasie lub nastroju sprzyjającym odpoczynkowi"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "rilassato",
                                "target_lang_sense_clarification": "privo di stress, calmo"
                            },
                            {
                                "target_lang_word": "tranquillo",
                                "target_lang_sense_clarification": "sereno, facile al contatto"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "relaxed",
                                "target_lang_sense_clarification": "ontspannen en zonder zorgen"
                            },
                            {
                                "target_lang_word": "gemoedelijk",
                                "target_lang_sense_clarification": "aangenaam, ontspannen en gezellig"
                            },
                            {
                                "target_lang_word": "chille",
                                "target_lang_sense_clarification": "informeel voor ontspannen en kalm"
