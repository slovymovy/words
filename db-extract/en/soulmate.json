                    {
                        "sense_id": "fecde609-3886-3df8-a976-8d354b96b02c",
                        "entry_id": "282bd495-723d-367e-a14f-129637f3480d",
                        "glosses": [
                            "Someone, especially a romantic partner, with whom one is exceptionally or uniquely compatible or has a special, almost spiritual connection."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "29fb3ccc-fbe2-42af-896b-d7ce34cbff82",
                                "sense_id": "fecde609-3886-3df8-a976-8d354b96b02c",
                                "text": "Finding your wonderful soulmate is very similar to the process of sowing a seed and nurturing it into a beautiful blossoming plant."
                            },
                            {
                                "example_id": "d6056c7a-b73a-4127-b594-3ab556a8e8bc",
                                "sense_id": "fecde609-3886-3df8-a976-8d354b96b02c",
                                "text": "I'm all over the place, I can't sit in one place / I'm not ashamed at all / Still findin' myself, let alone a soulmate, I'm just sayin'"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
