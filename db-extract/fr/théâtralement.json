                                        "entry_id": "0f67817e-95eb-399c-b80a-a8fe2b019c70",
                                        "glosses": [
                                            "in a theatrical or dramatic manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4baf4119-53e3-4eda-917b-ce74fe071c61",
                                                "sense_id": "d02dd9d9-d7df-3860-a749-0a9a5dc8a6b5",
                                                "text": "So it's not surprising that Terry McCabe's theatrically assured, combustibly comic staging is superior to Borealis Theatre's revival two months ago."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6382e76e-f526-3e86-a9f8-32ac95f48d31",
                                        "entry_id": "0f67817e-95eb-399c-b80a-a8fe2b019c70",
                                        "glosses": [
                                            "In theaters, or in terms of the theater."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
