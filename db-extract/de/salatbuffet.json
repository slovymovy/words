                "senses": [
                    {
                        "sense_id": "91d88c04-c66b-3947-8fdc-94dacedc51e4",
                        "entry_id": "e38b652c-9ece-31ca-ad7e-8896a85b08ab",
                        "glosses": [
                            "zur Selbstbedienung bereitgestellte Salate (in einem Restaurant, Hotel oder dergleichen)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a49cb64b-44fb-47aa-b0a3-2d5dab01ba3b",
                                "sense_id": "91d88c04-c66b-3947-8fdc-94dacedc51e4",
                                "text": "„Sie träumt von einem Wellnessurlaub an der Ostsee, mit Salatbuffet und frisch gefangenem Fisch, von einer Massage und entspannten Tagen.“"
                            },
                            {
                                "example_id": "09bc483a-35d4-4586-aef5-eea9317dd22d",
                                "sense_id": "91d88c04-c66b-3947-8fdc-94dacedc51e4",
                                "text": "„Neben den täglich wechselnden Gerichten bieten Salatbuffet und Nudeltheke vertraute Möglichkeiten, satt zu werden.“"
                            },
                            {
                                "example_id": "bf758ec4-608d-45ba-8d4b-11b7270c7f7a",
                                "sense_id": "91d88c04-c66b-3947-8fdc-94dacedc51e4",
                                "text": "„Ja, es gibt jeden Tag eine vegetarische Alternative und ein sehr gutes Salatbuffet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
