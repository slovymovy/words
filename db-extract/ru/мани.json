                                                "sense_id": "434223f5-ec86-3daf-955d-7e1c19bffe4c",
                                                "text": "He was born with money."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e244a68-96ec-36e2-a162-5ef6c28a2b80",
                                        "entry_id": "e6dc159f-839e-376e-8bee-1bbdd5b5c38f",
                                        "glosses": [
                                            "A person, family or class that possesses wealth."
                                        ],
                                        "tags": [
                                            "plural",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "faa7f122-28ed-4e13-a987-15de5365a330",
                                                "sense_id": "0e244a68-96ec-36e2-a162-5ef6c28a2b80",
                                                "text": "He married money."
                                            },
                                            {
                                                "example_id": "20accec8-5110-4441-90e2-41075c3af62e",
                                                "sense_id": "0e244a68-96ec-36e2-a162-5ef6c28a2b80",
                                                "text": "He was born into money."
                                            },
                                            {
                                                "example_id": "e3c93962-66cd-45db-b38c-af71c83cb79f",
                                                "sense_id": "0e244a68-96ec-36e2-a162-5ef6c28a2b80",
                                                "text": "I grew up in Ballybeg, neither of my working-class parents came from money or went to university, so I was part of a working-class family, I assumed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "164bf40a-eecc-3ab1-a3f2-2feffa890926",
