                ],
                "senses": [
                    {
                        "sense_id": "9d53535c-a474-3eea-b579-ccaf70d54ae3",
                        "entry_id": "c822ff49-fe8a-3c8c-84d0-5856c18f80c6",
                        "glosses": [
                            "Verschmelzung leichter Atomkerne zu einem schwereren"
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [
                            {
                                "example_id": "24692918-9873-488c-bff8-b2cce0f8a6f4",
                                "sense_id": "9d53535c-a474-3eea-b579-ccaf70d54ae3",
                                "text": "„Sie wird in rund fünf Milliarden Jahren ihren Vorrat an Wasserstoff für die Kernverschmelzung aufgebraucht haben, sich anschließend auf das Zehnfache ihrer derzeitigen Größe aufblähen und ihre Leuchtkraft verfünfzigfachen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "dfd774a2-b269-367e-80fd-00fe090e9fdf",
                        "entry_id": "c822ff49-fe8a-3c8c-84d0-5856c18f80c6",
                        "glosses": [
                            "Verschmelzung von mehreren Zellkernen zu einem Zellkern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "346f65f8-1abe-43b5-be62-c9752f5189cd",
                                "sense_id": "dfd774a2-b269-367e-80fd-00fe090e9fdf",
                                "text": "„Als Embryo gilt jede befruchtete, menschliche Eizelle vom Zeitpunkt der sogenannten Kernverschmelzung an sowie jede von einem Embryo entnommene Zelle, die sich wieder zu einem Embryo weiterentwickeln könnte.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
