                    {
                        "sense_id": "083996d5-f81d-3c9f-ae06-00fe37435d11",
                        "entry_id": "a867582c-2491-383c-85bf-f6b5223dc8b6",
                        "glosses": [
                            "een (Amerikaanse) ruimtevaarder"
                        ],
                        "tags": [
                            "ruimtevaart",
                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "4fdcb15c-7fac-4aa9-a5e3-61346e860c12",
                                "sense_id": "083996d5-f81d-3c9f-ae06-00fe37435d11",
                                "text": "Als een stoïcijnse astronaut staat hij in de felverlichte hal ondanks het warme weer met een dikke jas aan."
                            },
                            {
                                "example_id": "5b3b8fad-b1b3-481d-95fe-59a1204f2293",
                                "sense_id": "083996d5-f81d-3c9f-ae06-00fe37435d11",
                                "text": "Neil Armstrong was de beroemdste astronaut."
                            },
                            {
                                "example_id": "8a3669c9-f75d-43c6-9fec-4d54061ba57f",
                                "sense_id": "083996d5-f81d-3c9f-ae06-00fe37435d11",
                                "text": "SLS moet de grootste en krachtigste raket ooit worden. In 2024 wil NASA er astronauten mee naar de maan brengen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "65b3b652-05b8-40a6-8ec5-d92a89921c0c",
                        "source_entry_id": "a867582c-2491-383c-85bf-f6b5223dc8b6",
                        "source_sense_id": "083996d5-f81d-3c9f-ae06-00fe37435d11",
                        "source_sense_description": "een Amerikaanse ruimtevaarder",
                        "target_lang_word": "Astronaut",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Astronaut",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a9dd2e4c-fb94-371c-aa1b-717137b31a81",
                                        "entry_id": "7327d519-4684-32a6-b449-4bf05d1ff4a7",
                                        "glosses": [
                                            "Weltraumfahrer (besonders der westlichen Weltgemeinschaft), der an einem Raumflug teilnimmt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "239b86ed-ebe4-4a32-ad08-104bf839317f",
                                                "sense_id": "a9dd2e4c-fb94-371c-aa1b-717137b31a81",
                                                "text": "Im Jahr 1961 startete der erste Astronaut ins All."
                                            },
                                            {
                                                "example_id": "c421a9b8-7a91-45aa-9af0-3cc23dee5d78",
                                                "sense_id": "a9dd2e4c-fb94-371c-aa1b-717137b31a81",
                                                "text": "„Ein »Astronaut«, der den Mond betritt, hat mit der Reise von der Erde bis dorthin von der Entfernung, die uns vom sonnennächsten Fixstern trennt, noch weniger, nämlich 1 Hundertmillionstel, zurückgelegt.“"
                                            },
                                            {
                                                "example_id": "d7860fb8-9741-43c0-8cea-27cb260781ef",
                                                "sense_id": "a9dd2e4c-fb94-371c-aa1b-717137b31a81",
                                                "text": "„Nach dem Mondflug waren die Astronauten mit einer Kapsel im Pazifik gelandet.“"
                                            },
                                            {
                                                "example_id": "ac62de76-5373-42f5-aef7-37b974d9e01f",
                                                "sense_id": "a9dd2e4c-fb94-371c-aa1b-717137b31a81",
                                                "text": "„Und die, die auf ihn herabschauten, waren Astronauten.“"
                                            },
                                            {
                                                "example_id": "34f66875-dc39-4cac-92ca-535420085c6b",
                                                "sense_id": "a9dd2e4c-fb94-371c-aa1b-717137b31a81",
                                                "text": "„Wir fühlten uns wie Astronauten, die auf die Erde blicken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ca4b82e3-1778-463d-85d1-bc29482e5378",
                        "source_entry_id": "a867582c-2491-383c-85bf-f6b5223dc8b6",
                        "source_sense_id": "083996d5-f81d-3c9f-ae06-00fe37435d11",
                        "source_sense_description": "een Amerikaanse ruimtevaarder",
                        "target_lang_word": "astronaut",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "astronaut",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "752d9f6e-9cbb-3d53-89e2-c87f039e93b0",
                                        "entry_id": "19f5172b-87fa-335f-bee4-95f4719e9cf5",
                                        "glosses": [
                                            "A member of the crew of a spaceship or other spacecraft that travels beyond Earth's atmosphere, or someone trained to serve that purpose."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e392b371-50e0-3e9f-a3b1-f203fd3bb7be",
                                        "entry_id": "19f5172b-87fa-335f-bee4-95f4719e9cf5",
                                        "glosses": [
                                            "A member of the crew of a spaceship or other spacecraft that travels beyond Earth's atmosphere, or someone trained to serve that purpose.",
                                            "An American space traveler, when contrasted against equivalent terms from other countries such as cosmonaut, taikonaut, spationaut, and vyomanaut."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25a06f5c-135e-4fcd-a2d7-9704e471a58b",
                                                "sense_id": "e392b371-50e0-3e9f-a3b1-f203fd3bb7be",
                                                "text": "Though from different social, economic, and political worlds, the astronauts and cosmonauts had much in common, both as professionals and human beings."
                                            },
                                            {
                                                "example_id": "f39e87f6-421a-4aa2-ab46-8076dde111ef",
                                                "sense_id": "e392b371-50e0-3e9f-a3b1-f203fd3bb7be",
                                                "text": "The American astronauts in the competing Mercury program may have joked about being “Spam in a can,” but it seems clear that Korolev wanted to have plenty of cosmonauts on hand in case another rocket blew up."
                                            },
                                            {
                                                "example_id": "a536c303-9204-4fb3-8e79-e0e9779646ac",
                                                "sense_id": "e392b371-50e0-3e9f-a3b1-f203fd3bb7be",
                                                "text": "Longtime NASA astronaut Don Pettit, who has ventured to space four times, returned to Earth on Saturday night from the International Space Station. Pettit, who turned 70 on Sunday, landed at 9:20 p.m. ET in a Soyuz spacecraft with Roscosmos cosmonauts Alexey Ovchinin and Ivan Vagner near Zhezkazgan, Kazakhstan, after a seven-month stay aboard the orbiting laboratory. […] Space doesn't just appear dark to astronauts aboard the space station."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "10b3cf56-18b8-3319-9301-ca7861b98e31",
                                        "entry_id": "19f5172b-87fa-335f-bee4-95f4719e9cf5",
                                        "glosses": [
                                            "A person (typically man) working abroad away from their family."
                                        ],
                                        "tags": [
                                            "Hong-Kong"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f51bf71d-ca28-40f6-8668-80ad1f3a2ca5",
                        "source_entry_id": "a867582c-2491-383c-85bf-f6b5223dc8b6",
