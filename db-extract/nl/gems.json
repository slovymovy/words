                    {
                        "translation_id": "38bf275a-5483-4f6c-a084-8b4f709d64c9",
                        "source_entry_id": "0e8c9d74-41d0-3e6a-8553-8abef432d4c1",
                        "source_sense_id": "f04fba42-8678-3266-92f5-821fd0933b2e",
