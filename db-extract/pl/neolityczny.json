                                "sense_id": "8a68c7f8-1384-3d7f-9206-d9f860c17838",
                                "text": "Pozostałości takich neolitycznych (i późniejszych) konstrukcji odkryto zarówno w Europie, jak i na innych kontynentach"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
