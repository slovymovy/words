                            {
                                "example_id": "77c9ad4c-bea6-4474-83cb-89037b7e31bf",
                                "sense_id": "63e8e13f-1945-3b4f-8935-875d814ff75c",
                                "text": "Elle est venue te chercher, tu peux le dire, et moi je te le dis comme je le pense : une dégrafée qui, à son âge, vient relancer un homme marié n’est pas une fille comme il faut."
                            },
                            {
                                "example_id": "f8f32b5c-732f-4ad2-9c4e-10e78f825a6a",
                                "sense_id": "63e8e13f-1945-3b4f-8935-875d814ff75c",
                                "text": "Je ne te parle pas de ce collier : je parle de ce que cette dégrafée a osé faire avec ces nains pour l’obtenir !"
                            },
                            {
                                "example_id": "8c6650ff-10fa-42c1-a44d-2537d7fe3180",
                                "sense_id": "63e8e13f-1945-3b4f-8935-875d814ff75c",
                                "text": "Parmi ces dégrafées célèbres qu’Alexandre, déambulant ou assis sur une chaise de fer, voyait passer en voiture, une l’affolait positivement : Cora Pearl."
                            }
                        ]
                    }
