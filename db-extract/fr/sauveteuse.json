                        ]
                    },
                    {
                        "translation_id": "bd185d03-5aba-476a-8cd3-6764b7a0c26c",
                        "source_entry_id": "cec223da-611e-3a58-96bf-f9d029c2ee1c",
                        "source_sense_id": "2c5b242d-34c2-39c3-a11e-7125babb0bc3",
                        "target_lang_word": "rescuer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rescuer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "19fb928c-ab14-3e36-b009-11eced92b8ed",
                                        "entry_id": "bf171520-6f4c-3f09-a9a1-13218fce3c79",
                                        "glosses": [
                                            "A person who rescues someone or something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff5c5fad-e6cd-4c8e-a798-6bb306fdd8a6",
                                                "sense_id": "19fb928c-ab14-3e36-b009-11eced92b8ed",
                                                "text": "As Tarzan’s heavy hand fell upon his shoulder the priest dropped his victim, and turned upon her would-be rescuer."
                                            },
                                            {
                                                "example_id": "de0bc4f8-08b3-4c3d-94e0-8f2fc2777c2c",
                                                "sense_id": "19fb928c-ab14-3e36-b009-11eced92b8ed",
                                                "text": "[…] an opportunistic relative masquerading as his rescuer, […]"
                                            },
                                            {
                                                "example_id": "da94585f-1240-4c71-9e9c-fcc2e34ade6e",
                                                "sense_id": "19fb928c-ab14-3e36-b009-11eced92b8ed",
                                                "text": "She knew from avalanche safety courses that outstretched hands might puncture the ice surface and alert rescuers. She knew that if victims ended up buried under the snow, cupped hands in front of the face could provide a small pocket of air for the mouth and nose. Without it, the first breaths could create a suffocating ice mask."
                                            },
                                            {
                                                "example_id": "72a52a80-5d2b-4c29-bc21-543b44f5ddbf",
                                                "sense_id": "19fb928c-ab14-3e36-b009-11eced92b8ed",
                                                "text": "By now, a new worry had emerged. With the rescuers working close to so many dead bodies, there was fear of disease taking hold."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0dbf692e-a5eb-43d8-8b0a-0c05139e8c82",
                        "source_entry_id": "cec223da-611e-3a58-96bf-f9d029c2ee1c",
                        "source_sense_id": "2c5b242d-34c2-39c3-a11e-7125babb0bc3",
                        "target_lang_word": "lifeguard",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lifeguard",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0c76c8ee-243e-3edc-8381-ce230d3e8c18",
                                        "entry_id": "3a10748f-3e67-335b-8c70-cd002d2e9b12",
                                        "glosses": [
                                            "A lifesaver: a rescuer, usually an expert swimmer, employed to save swimmers in trouble or near drowning at a body of water."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "591eaf41-5bd9-3175-b882-6c2deeb24c99",
                                        "entry_id": "3a10748f-3e67-335b-8c70-cd002d2e9b12",
                                        "glosses": [
                                            "A bodyguard or unit of bodyguards, a guard of someone's (especially a king's) life or person."
                                        ],
                                        "tags": [
                                            "uncommon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0595e318-06a4-43da-8c7e-1ba4f9099bc6",
                                                "sense_id": "591eaf41-5bd9-3175-b882-6c2deeb24c99",
                                                "text": "\"The people's love is the king's lifeguard.\""
                                            },
                                            {
                                                "example_id": "efe2831a-c8a5-4896-bbf4-005a86ccafaa",
                                                "sense_id": "591eaf41-5bd9-3175-b882-6c2deeb24c99",
                                                "text": "[I]n the reserve were the king's lifeguard, commanded by the earl of Lindsey, and prince Rupert's regiment of foot[.]"
                                            },
                                            {
                                                "example_id": "34672baa-0850-41fe-a068-5e36c6550e47",
                                                "sense_id": "591eaf41-5bd9-3175-b882-6c2deeb24c99",
                                                "text": "Constantine the Great is known to have raised the five scholae of horsemen who formed the actual lifeguard of the prince, and followed his person whenever he went out to war."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d1c2ef37-8306-3c4a-9599-ded01ed3e974",
                                        "entry_id": "3a10748f-3e67-335b-8c70-cd002d2e9b12",
                                        "glosses": [
                                            "A sturdy metal bracket fixed in front of each of the leading wheels of a train to deflect small objects away from the wheels to prevent derailment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b787a09c-6730-4f6f-a6c9-2e8cc6d2cee3",
                                                "sense_id": "d1c2ef37-8306-3c4a-9599-ded01ed3e974",
                                                "text": "It also looked at what effect stronger lifeguards might have had. They protect the leading wheels from small obstacles and in modern trains have coped with hitting landslip debris."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
