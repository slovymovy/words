                                "target_lang_sense_clarification": "активности, популярности"
                            },
                            {
                                "target_lang_word": "ослабление",
                                "target_lang_sense_clarification": "влияния, позиций"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "898f5ae2-8113-307a-ad23-0d9c6562abe7",
                    "sense_definition": "The period or process in which the visible surface of the moon decreases.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "lunar",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ancient farmers timed their planting by the waxing and <w>waning</w> of the moon.",
                            "target_lang_translations": {
                                "ru": "Древние земледельцы согласовывали посадку с ростом и <w>убыванием</w> луны."
                            }
                        },
                        {
                            "text": "The poem describes the silent <w>waning</w> of the night sky.",
                            "target_lang_translations": {
                                "ru": "Стихотворение описывает безмолвное <w>угасание</w> ночного неба."
                            }
                        }
                    ],
                    "antonyms": [
                        "waxing"
                    ],
                    "common_phrases": [
