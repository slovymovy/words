                ],
                "senses": [
                    {
                        "sense_id": "59669d91-d31b-3b57-a4a7-6aacb9191234",
                        "entry_id": "22d26c05-e80a-3a07-b115-aa82f1d523f6",
                        "glosses": [
                            "обсц. инициативно совершать половой акт"
                        ],
                        "tags": [
                            "кого."
                        ],
                        "examples": [
                            {
                                "example_id": "91897495-a0c0-4092-90e8-94c6d34d184d",
                                "sense_id": "59669d91-d31b-3b57-a4a7-6aacb9191234",
                                "text": "Е́ти-е́ти на повети, — // Парень девку ерепетит: // Девка-то хохочет, // А парень ещё ебти хочет!"
                            },
                            {
                                "example_id": "84f7e692-8f2b-4b6d-9dba-6ab62a40de43",
                                "sense_id": "59669d91-d31b-3b57-a4a7-6aacb9191234",
                                "text": "Эх, ёб я тебя // На завалинке, — // Послетали с тебя // Чулки-валенки!"
                            },
                            {
                                "example_id": "d1239870-8bd5-4fb8-8411-940cea3ee173",
                                "sense_id": "59669d91-d31b-3b57-a4a7-6aacb9191234",
                                "text": "Меня девки унижали, — // Издевались как могли: // В тесной комнатке зажали // — // И ебли, ебли, ебли!"
                            },
                            {
                                "example_id": "70f3f544-8eb6-45f6-b607-4f4a838c3cf0",
                                "sense_id": "59669d91-d31b-3b57-a4a7-6aacb9191234",
                                "text": "Запустили в пруд селедку, — // Там водились караси! // Караси ебли селёдку, — // Получились иваси!"
                            },
                            {
                                "example_id": "6b868c54-690c-45d4-8657-7ed22e894b9d",
                                "sense_id": "59669d91-d31b-3b57-a4a7-6aacb9191234",
                                "text": "Не те / бляди, / что хлеба / ради / спереди / и сзади / дают нам / ебти, — / Бог их прости! // А те бляди, — / лгущие, / деньги / сосущие, / еть / не дающие, — / вот бляди / сущие, — / мать их ети!"
                            }
                        ]
                    }
                ],
