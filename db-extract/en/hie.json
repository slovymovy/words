                                "target_senses": [
                                    {
                                        "sense_id": "484c6cb7-cbf8-3fd7-a34e-64f57478194c",
                                        "entry_id": "7c423dd6-c6eb-3154-b252-0079b26a83e4",
                                        "glosses": [
                                            "postupovat rychle"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83337c31-60c3-4ad7-ae18-4a62ee7f0f12",
                                                "sense_id": "484c6cb7-cbf8-3fd7-a34e-64f57478194c",
                                                "text": "Musíme teď spěchat, zbývá nám málo času."
                                            },
                                            {
                                                "example_id": "4ee90443-b37a-41b8-af0b-b4bf708bd586",
                                                "sense_id": "484c6cb7-cbf8-3fd7-a34e-64f57478194c",
                                                "text": "»Prosím vás — to se tak nebere! On dostal Švarc pěkné místo — tak zas přišel a spěchal na to...«"
                                            },
                                            {
                                                "example_id": "d9b8af78-5d3e-49e9-8515-d59e8910d14c",
                                                "sense_id": "484c6cb7-cbf8-3fd7-a34e-64f57478194c",
                                                "text": "Hele, tady je to jako na vojně: spěchá se, aby se čekalo, a čeká se, aby se spěchalo."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "87e01735-f325-495e-b503-e8c39af8648e",
