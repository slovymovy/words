{
    "word_family": [
        "wazka",
        "wazowy"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9e35736a-4b53-3961-ab85-2d15672570e0",
                    "sense_definition": "duże, głębokie naczynie z pokrywką i uchwytami, służące do serwowania zupy",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "naczynie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kelner postawił na stole dużą <w>wazę</w> pełną gorącego rosołu.",
                            "target_lang_translations": {
                                "ru": "Официант поставил на стол большую <w>супницу</w>, полную горячего бульона."
                            }
                        },
                        {
                            "text": "Podczas niedzielnego obiadu nalewała zupę prosto z porcelanowej <w>wazy</w>.",
                            "target_lang_translations": {
                                "ru": "Во время воскресного обеда она наливала суп прямо из фарфоровой <w>супницы</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "waza do zupy",
                        "porcelanowa waza",
                        "waza z rosołem"
                    ],
                    "target_lang_definitions": {
                        "ru": "большая глубокая посуда с крышкой и ручками для подачи супа на стол"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "супница",
                                "target_lang_sense_clarification": "посуда для супа"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bdcd55ad-8b20-3c02-9b95-0f5d3a8fcac9",
                    "sense_definition": "duże, ozdobne naczynie ceramiczne lub kamienne, pełniące funkcję dekoracyjną",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "naczynie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W rogu salonu stała starożytna kamienna <w>waza</w> przywieziona z podróży.",
                            "target_lang_translations": {
                                "ru": "В углу гостиной стояла древняя каменная <w>ваза</w>, привезенная из путешествия."
                            }
                        },
                        {
                            "text": "Dekorator wnętrz umieścił w holu biura piękną <w>wazę</w> stylizowaną na ludowo.",
                            "target_lang_translations": {
                                "ru": "Дизайнер интерьеров поставил в холле офиса красивую <w>вазу</w>, стилизованную под народное творчество."
                            }
                        }
                    ],
                    "synonyms": [
                        "wazon"
                    ],
                    "common_phrases": [
                        "ozdobna waza",
                        "kamienna waza"
                    ],
                    "target_lang_definitions": {
                        "ru": "крупный декоративный сосуд из керамики или камня"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ваза",
                                "target_lang_sense_clarification": "декоративный сосуд"
                            },
                            {
                                "target_lang_word": "вазон",
                                "target_lang_sense_clarification": "крупная декоративная чаша или емкость"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "41a5fdd7-1578-3e2f-9fac-4413443217f2",
                    "sense_definition": "płaskie naczynie na nóżce do podawania owoców lub ciast; patera",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "naczynie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Gospodyni położyła na <w>wazie</w> świeże owoce zebrane rano z ogrodu.",
                            "target_lang_translations": {
                                "ru": "Хозяйка положила в <w>вазу для фруктов</w> свежие плоды, собранные утром в саду."
                            }
                        },
                        {
                            "text": "Na środku stołu leżały ciastka ułożone na szklanej <w>wazie</w>.",
                            "target_lang_translations": {
                                "ru": "В центре стола лежало печенье, выложенное на стеклянную <w>вазочку</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "taca"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Bukowina"
                        },
                        {
                            "trait_type": "dialectal",
                            "comment": "Bukowina"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "плоская посуда на ножке для фруктов или сладостей; вазочка, этажерка"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ваза для фруктов",
                                "target_lang_sense_clarification": "посуда на ножке"
                            },
                            {
                                "target_lang_word": "вазочка",
                                "target_lang_sense_clarification": "для сладостей и фруктов"
                            },
                            {
                                "target_lang_word": "менажница",
                                "target_lang_sense_clarification": "горка или тарелка для десертов"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "7915d119-cdd2-3fbb-9f39-bfff89b9c84b",
                    "sense_definition": "członek lub przedstawiciel szwedzko-polskiej dynastii królewskiej Wazów",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "dynastia",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Zygmunt III <w>Waza</w> przeniósł polski dwór królewski z Krakowa do Warszawy.",
                            "target_lang_translations": {
                                "ru": "Сигизмунд III <w>Ваза</w> перенес польский королевский двор из Кракова в Варшаву."
                            }
                        },
                        {
                            "text": "W podręczniku opisano panowanie kolejnego króla z rodu <w>Wazów</w>.",
                            "target_lang_translations": {
                                "ru": "В учебнике описывалось правление очередного короля из рода <w>Ваза</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "Zygmunt III Waza",
                        "Władysław IV Waza",
                        "Jan Kazimierz Waza"
                    ],
                    "target_lang_definitions": {
                        "ru": "представитель королевской династии Ваза (Васа)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Ваза",
                                "target_lang_sense_clarification": "представитель династии"
                            },
                            {
                                "target_lang_word": "Васа",
                                "target_lang_sense_clarification": "шведский вариант написания фамилии"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "158ffff8-2632-3b33-9854-58191f876397",
                    "sense_definition": "szwedzka dynastia panująca w Rzeczypospolitej Obojga Narodów w latach 1587–1668",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "dynastia",
                    "name_type": "historical_name",
                    "examples": [
                        {
                            "text": "W XVII wieku pod rządami dynastii <w>Wazów</w> Rzeczpospolita toczyła liczne wojny.",
                            "target_lang_translations": {
                                "ru": "В XVII веке под властью династии <w>Ваза</w> Речь Посполитая вела многочисленные войны."
                            }
                        },
                        {
                            "text": "Groby królów z rodu <w>Wazów</w> znajdują się w kryptach katedry wawelskiej.",
                            "target_lang_translations": {
                                "ru": "Гробницы королей из рода <w>Ваза</w> находятся в криптах Вавельского собора."
                            }
                        }
                    ],
                    "common_phrases": [
                        "dynastia Wazów",
                        "czasy Wazów"
                    ],
                    "target_lang_definitions": {
                        "ru": "королевская династия шведского происхождения, правившая в Польше в 1587–1668 годах"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Ваза",
                                "target_lang_sense_clarification": "династия"
                            },
                            {
                                "target_lang_word": "Васа",
                                "target_lang_sense_clarification": "династия (шведский вариант)"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}