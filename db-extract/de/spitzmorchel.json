                        "cross_references": [
                            {
                                "target_word": "сморчок",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "62ae1762-b90b-380f-9e0b-e8a93b6b86ae",
                                        "entry_id": "e3792d71-6ce1-3921-ae6b-e87803c105e9",
                                        "glosses": [
                                            "микол. гриб семейства сморчковых, или моршелловых (Morchella)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03017a35-527c-4bfd-ab7a-162b2f467481",
                                                "sense_id": "62ae1762-b90b-380f-9e0b-e8a93b6b86ae",
                                                "text": "Для настоящего ужина повар им приготовил фаршированного поросёнка под галантиром, соус из сморчков и чирков с свежим салатом."
                                            },
                                            {
                                                "example_id": "505e97ed-68e4-44fc-85c0-715b39400875",
                                                "sense_id": "62ae1762-b90b-380f-9e0b-e8a93b6b86ae",
                                                "text": "Мы блуждали по лесным гущам, собирая грибы-подберёзовики, подосиновики, сморчки, опёнки…"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "сморчок",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "d831242a-e86c-3d5c-9026-2d75d6b0ed76",
                                        "entry_id": "d3426155-6269-3cb1-bde7-202a5e7b18d0",
                                        "glosses": [
                                            "разг., пренебр. тщедушный, невзрачный человек"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a261647-e5a5-4d8b-bc5b-bb66b75cd663",
                                                "sense_id": "d831242a-e86c-3d5c-9026-2d75d6b0ed76",
                                                "text": "Рядом с ним Тит Горбатый выглядел сморчком: низенький, сгорбленный, с бородкой клинышком и длинными худыми руками, мотавшимися, как деревянные."
                                            },
                                            {
                                                "example_id": "7315176a-00e6-465d-aa86-d08b45798d83",
                                                "sense_id": "d831242a-e86c-3d5c-9026-2d75d6b0ed76",
                                                "text": "Красавица брюнетка с фигурой богини ― и рядом муж, маленький сморчок…"
                                            }
                                        ]
                                    }
                                ]
                            },
