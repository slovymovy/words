                },
                {
                    "sense_id": "786f7e52-f9f5-3610-b4c0-dad524c38096",
                    "sense_definition": "The outward aspect, guise, or form of something.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the moonlight, the old castle took on a ghostly <w>apparel</w>.",
