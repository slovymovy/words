                                                "example_id": "1c8a0a28-8ba2-45ec-a7d9-3b94c0d9cba3",
                                                "sense_id": "f93367ec-7de2-3da2-96ec-5ee9e031112d",
                                                "text": "Les combattants ont quitté les régions de Voronej et de Lipetsk, au sud de Moscou, étapes de leur tentative de rallier la capitale, selon les autorités locales."
                                            }
                                        ]
                                    },
