                "senses": [
                    {
                        "sense_id": "11761c35-9b80-371f-ab92-a62fe387ffe8",
                        "entry_id": "57d649af-d98b-351f-885b-9c819cfd0927",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "632df777-ef70-425d-9169-b381bd3469f9",
                                "sense_id": "11761c35-9b80-371f-ab92-a62fe387ffe8",
                                "text": "Frau Ulmann ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "358a8d20-65fe-4f44-a864-d1f63c304fd4",
                                "sense_id": "11761c35-9b80-371f-ab92-a62fe387ffe8",
                                "text": "Herr Ulmann wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "ec673f05-9530-49b5-866d-0f9c25979207",
                                "sense_id": "11761c35-9b80-371f-ab92-a62fe387ffe8",
                                "text": "Die Ulmanns fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "257a0819-2d3f-44bf-aee3-d0e397ced08e",
                                "sense_id": "11761c35-9b80-371f-ab92-a62fe387ffe8",
                                "text": "Der Ulmann trägt nie die Schals, die die Ulmann ihm strickt."
                            },
                            {
                                "example_id": "e760e236-923f-4c67-a848-74c328374355",
                                "sense_id": "11761c35-9b80-371f-ab92-a62fe387ffe8",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Ulmann kommt, geht der Herr Ulmann.“"
                            },
                            {
                                "example_id": "a3bcaf59-15c1-40cc-948f-27bb30c57c46",
                                "sense_id": "11761c35-9b80-371f-ab92-a62fe387ffe8",
                                "text": "Ulmann kommt und geht."
                            },
                            {
                                "example_id": "93f05e13-7da6-4c09-8bc2-216ed386c696",
                                "sense_id": "11761c35-9b80-371f-ab92-a62fe387ffe8",
                                "text": "Ulmanns kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
