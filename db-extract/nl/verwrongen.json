                    {
                        "sense_id": "029d136e-ae0c-306b-a9c3-c5eed2a99cb5",
                        "entry_id": "f2ee08af-d2d6-3f09-b47f-c09e57494ab8",
                        "glosses": [
                            "voltooid deelwoord van verwringen"
                        ],
