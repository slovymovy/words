    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "1f6794dc-e481-3052-a404-6073057957dd",
                    "sense_definition": "Having keen mental perception and understanding",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "insight",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>perspicacious</w> detective noticed the small detail that everyone else had completely overlooked.",
                            "target_lang_translations": {
                                "tr": "<w>Ferasetli</w> dedektif, diğer herkesin tamamen gözden kaçırdığı küçük ayrıntıyı fark etti."
                            }
                        },
                        {
                            "text": "Her <w>perspicacious</w> analysis of the market trends helped the company avoid a major financial loss.",
                            "target_lang_translations": {
                                "tr": "Piyasa eğilimlerine ilişkin <w>basiretli</w> analizi, şirketin büyük bir mali kayıptan kaçınmasına yardımcı oldu."
                            }
                        }
                    ],
                    "synonyms": [
                        "astute",
                        "perceptive",
                        "insightful",
                        "shrewd"
                    ],
                    "antonyms": [
                        "obtuse",
                        "dull"
                    ],
                    "target_lang_definitions": {
                        "tr": "Keskin bir kavrayış ve anlama yeteneğine sahip olan; basiretli, ferasetli"
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "basiretli",
                                "target_lang_sense_clarification": "öngörülü ve derin kavrayışlı"
                            },
                            {
                                "target_lang_word": "ferasetli",
                                "target_lang_sense_clarification": "sezgisi ve anlama kabiliyeti kuvvetli"
                            },
                            {
                                "target_lang_word": "zeki",
                                "target_lang_sense_clarification": "çabuk ve kolay kavrayan"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f72fe9dd-069f-35b5-ac3f-1db35a19852c",
                    "sense_definition": "Having the ability to see clearly or sharply",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "vision",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The eagle is a <w>perspicacious</w> hunter that can spot movement from great distances.",
                            "target_lang_translations": {
                                "tr": "Kartal, çok uzak mesafelerden bile hareketi fark edebilen <w>keskin gözlü</w> bir avcıdır."
                            }
                        },
                        {
                            "text": "With <w>perspicacious</w> eyes, the sailor scanned the horizon for any sign of land.",
                            "target_lang_translations": {
                                "tr": "Denizci, <w>keskin</w> gözleriyle herhangi bir kara belirtisi bulmak için ufku taradı."
                            }
                        }
                    ],
                    "synonyms": [
                        "sharp-sighted",
                        "keen-eyed"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This sense is rarely used in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Çok net, keskin görebilme yeteneği olan (görme duyusu için)"
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "keskin gözlü",
                                "target_lang_sense_clarification": "gözleri çok iyi gören"
                            },
                            {
                                "target_lang_word": "keskin görüşlü",
                                "target_lang_sense_clarification": "görme yetisi keskin olan"
                            }
                        ]
