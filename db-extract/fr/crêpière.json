                    },
                    {
                        "form_id": "9a146fb7-3de4-47a3-86cd-7bc71be1033e",
                        "entry_id": "4fa47710-9666-33b8-95e3-aa33bf2d865e",
                        "tags": [
                            "masculine"
                        ],
                        "form": "crêpier"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9172d790-c597-36cd-ac61-811f7ad639b9",
                        "entry_id": "4fa47710-9666-33b8-95e3-aa33bf2d865e",
                        "glosses": [
                            "Celle qui fait des crêpes pour les vendre voire qui tient une crêperie."
                        ],
                        "tags": [
                            "Métier"
                        ],
                        "examples": [
                            {
                                "example_id": "829c7d31-8996-475f-b8f4-3af373db273a",
                                "sense_id": "9172d790-c597-36cd-ac61-811f7ad639b9",
                                "text": "Vous lui avez envoyé, ma chère cousine, des crêpes qui ne sont pas trop bonnes, on les a trouvées trop épaisses, trop grasses et pas assez sucrées. Nous vous serons bien obligés si vous voulez bien nous en envoyer vingt quatre douzaines et recommander à la crêpière qu’elles soient meilleures."
                            },
                            {
                                "example_id": "ef3260bb-f6e2-4975-95b9-e036b95e8bb4",
                                "sense_id": "9172d790-c597-36cd-ac61-811f7ad639b9",
                                "text": "Nous téléphonons dans les bureaux de placement et passons des annonces pour recruter d’urgence une serveuse et une crêpière."
                            }
                        ]
                    },
                    {
                        "sense_id": "c2a605c8-0590-3e0b-8a3a-41f246e68771",
                        "entry_id": "4fa47710-9666-33b8-95e3-aa33bf2d865e",
                        "glosses": [
                            "Sorte de poêle pour cuire les crêpes, presque dépourvue de bords."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d54c4943-892d-4473-8831-216b501a4dcd",
                                "sense_id": "c2a605c8-0590-3e0b-8a3a-41f246e68771",
                                "text": "Faire chauffer la crêpière à feu vif et passer un essuie-tout imbibé d’un peu d’huile."
                            },
                            {
                                "example_id": "12ebbb4d-f9c4-4d05-bdea-9b16d146dcbb",
                                "sense_id": "c2a605c8-0590-3e0b-8a3a-41f246e68771",
                                "text": "Les crêpes c’est forcément un des goûts de mon enfance. J’adore l’odeur du blé noir qui cuit sur la crêpière."
                            }
                        ]
                    },
                    {
                        "sense_id": "6a38aaca-2404-3959-b674-599a34fb370b",
                        "entry_id": "4fa47710-9666-33b8-95e3-aa33bf2d865e",
                        "glosses": [
                            "Plaque en fonte destinée à faire cuire crêpes et galettes."
                        ],
                        "tags": [
                            "Électroménager"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fb79ea6e-6a4e-4d05-ad77-47178b6ce57c",
                        "source_entry_id": "4fa47710-9666-33b8-95e3-aa33bf2d865e",
                        "source_sense_id": "9172d790-c597-36cd-ac61-811f7ad639b9",
