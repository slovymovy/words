                "senses": [
                    {
                        "sense_id": "3890b973-a0e5-375d-859b-84141b8111e3",
                        "entry_id": "395a5829-ebd1-3bea-9c39-7bd12533e232",
                        "glosses": [
                            "Variante de picocher."
                        ],
                        "tags": [
                            "Québec"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "d0e707eb-d745-316f-8b35-4a6e9fe19c07",
                        "entry_id": "395a5829-ebd1-3bea-9c39-7bd12533e232",
                        "glosses": [
                            "Darder à plusieurs reprises pour tenter de capturer quelque chose."
                        ],
                        "tags": [
                            "Québec"
                        ],
                        "examples": [
                            {
                                "example_id": "34351481-3afa-4087-a5bc-728322613b0f",
                                "sense_id": "d0e707eb-d745-316f-8b35-4a6e9fe19c07",
                                "text": "Maudits petits pois. On n'arrête pas de picosser pour attraper ça !"
                            }
                        ]
                    },
                    {
                        "sense_id": "24da1477-ad37-3897-8efe-f4bd96a08570",
                        "entry_id": "395a5829-ebd1-3bea-9c39-7bd12533e232",
                        "glosses": [
                            "Agacer quelqu'un en revenant inlassablement sur un sujet qui l'asticote."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "eb5e6948-200d-419e-863e-1b1e48df28c6",
                                "sense_id": "24da1477-ad37-3897-8efe-f4bd96a08570",
                                "text": "– « Oui » tu peux tout expliquer, ou « oui » c'est non ?\n– ... « oui » c'est non. Picosse donc pas pour rien, mon amour, là."
                            },
                            {
                                "example_id": "471e65b4-593b-4ea8-ba39-a873aefbafd6",
                                "sense_id": "24da1477-ad37-3897-8efe-f4bd96a08570",
                                "text": "Plus la population sentira que tel ou tel groupe fait de l'obstruction égoïste, ou purement idéologique, ou cherche à « picosser » pour marquer des petits points politiques, plus cela renforcera le jeu de cartes dans la main du gouvernement."
                            },
                            {
                                "example_id": "7e531037-99bf-4f41-b112-9704a8687bb3",
                                "sense_id": "24da1477-ad37-3897-8efe-f4bd96a08570",
                                "text": "Lorsqu’il s’est fait picosser par Paul St-Pierre Plamondon à la période des questions, c’était évident que l’abandon de sa première cause politique, la souveraineté, commençait à le rattraper."
                            }
                        ]
                    }
                ],
