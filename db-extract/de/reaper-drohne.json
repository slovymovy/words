                "senses": [
                    {
                        "sense_id": "4762da9a-31be-3867-b7d0-cea3920e65b2",
                        "entry_id": "d587c303-9a15-3981-a08d-925189580779",
                        "glosses": [
                            "Drohne vom Typ General Atomics MQ-9"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b788fa93-3472-4945-afaf-29cb5f910ace",
                                "sense_id": "4762da9a-31be-3867-b7d0-cea3920e65b2",
                                "text": "„Die Reaper-Drohnen der CIA waren angeblich unterwegs, aber aus unerfindlichen Gründen verspäteten sie sich, womit Grauers Drohne die einzige war, über die sich das Geschehen mitverfolgen ließ.“"
                            },
                            {
                                "example_id": "1c9c86ea-ab0f-4373-8bd2-5258da187d40",
                                "sense_id": "4762da9a-31be-3867-b7d0-cea3920e65b2",
                                "text": "„›Dieser Typ ist nicht böse, nur korrupt. Ich bin sogar schon mal bei ihm zu Hause gewesen. Das ist einer, der weiß, wie man überlebt. Was die Fahrt über den Chaiber angeht, habe ich mit ihm eine klare Vereinbarung getroffen: Wenn er versucht, mich zu verarschen, lass ich eine unserer Reaper-Drohnen aus der Luft auf ihn los und er wird brennen.‹“"
                            },
                            {
                                "example_id": "1a16f96f-261b-43b8-b3da-333c9ff6c29c",
                                "sense_id": "4762da9a-31be-3867-b7d0-cea3920e65b2",
                                "text": "„Nein, die größte Gefahr für die Anführer der terroristischen Organisation waren die von den Amerikanern eingesetzten Predator- und Reaper-Drohnen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
