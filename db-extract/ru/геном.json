                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bba25bd4-6c8e-433d-8852-dc4bc9e2711d",
                        "source_entry_id": "f2c7e59b-a7a9-3b93-bdc7-b4cdcf3148c1",
