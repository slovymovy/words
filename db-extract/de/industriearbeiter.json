                        "glosses": [
                            "Person, die in einem Industriebetrieb als Arbeiter beschäftigt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0c02e103-0fc0-492e-bf69-db498aa88d20",
                                "sense_id": "af01ce93-391d-3e71-9609-418325709342",
                                "text": "„Anders als 1945, als sich die Ansiedler hauptsächlich aus landwirtschaftlichen Hilfsarbeitern und Gewerbetreibenden rekrutierten, nahmen jetzt vermehrt akut benötigte Industriearbeiter an der Siedlungsbewegung teil.“"
                            },
                            {
                                "example_id": "e5c6eb95-5205-4cac-bb58-37e63d64a50c",
                                "sense_id": "af01ce93-391d-3e71-9609-418325709342",
                                "text": "„Etwa 50000 Industriearbeiter legten aus Protest gegen den Prozess die Arbeit nieder.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
