                ],
                "senses": [
                    {
                        "sense_id": "0fc47d91-7c39-3240-b188-988a7764b2ab",
                        "entry_id": "494b4f9f-de49-32da-bad4-b8e36475fdf3",
                        "glosses": [
                            "Laufen/Joggen oder Laufveranstaltung in der Nacht"
                        ],
                        "tags": [
                            "Laufsport"
                        ],
                        "examples": [
                            {
                                "example_id": "84293504-0506-48be-b282-314c08f22467",
                                "sense_id": "0fc47d91-7c39-3240-b188-988a7764b2ab",
                                "text": "„Der Nachtlauf bietet allen schnelleren Läufern die Gelegenheit, auf der pfeilschnellen Strecke um Bestzeiten und Platzierungen zu kämpfen.“"
                            },
                            {
                                "example_id": "37715875-0cf6-44bc-9ef1-a0328227ec12",
                                "sense_id": "0fc47d91-7c39-3240-b188-988a7764b2ab",
                                "text": "„Der Nachtlauf führte zweimal um den beliebten Badesee der Fuggerstädter und addiert sich auf fünf Kilometer.“"
                            },
                            {
                                "example_id": "46ec939e-ac93-47c7-9d66-ff6019279d07",
                                "sense_id": "0fc47d91-7c39-3240-b188-988a7764b2ab",
                                "text": "„Es gibt auch immer wieder spezielle Touren, wie Höhenmetertraining, um sich auf einen Berglauf vorzubereiten oder Nachtläufe um mal die Natur in der Dunkelheit zu erleben.“"
                            },
                            {
                                "example_id": "8edef962-48dc-493d-95c7-9976ec687013",
                                "sense_id": "0fc47d91-7c39-3240-b188-988a7764b2ab",
                                "text": "„Der winterliche Nachtlauf führt in Richtung Toblach, entlang des Toblacher Sees und endet im Langlaufzentrum Nordic Arena.“"
                            },
                            {
                                "example_id": "013a2416-164e-49f4-9206-c81aae00a6e1",
                                "sense_id": "0fc47d91-7c39-3240-b188-988a7764b2ab",
                                "text": "„Wir erlebten einen stimmungsvollen wie rasanten Nachtlauf über zehn englische Meilen durch das Ravensberger Bergstädtchen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "9be9ca13-06e5-3380-96d0-e6c9f9564f24",
                        "entry_id": "494b4f9f-de49-32da-bad4-b8e36475fdf3",
                        "glosses": [
                            "(geplante) Durchführung bestimmter Prozesse oder Aufgaben (wie Systemaktualisierungen, Datenbankwartungen oder Backups) in der Nacht (um den normalen Betrieb tagsüber nicht zu beeinträchtigen)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce493a58-b55e-4746-b2d5-249bfc497006",
                                "sense_id": "9be9ca13-06e5-3380-96d0-e6c9f9564f24",
                                "text": "„Sie werden in der Regel in Nachtläufen aktualisiert.“"
                            },
                            {
                                "example_id": "beb5afdf-5309-489c-a07b-562cc50d6337",
                                "sense_id": "9be9ca13-06e5-3380-96d0-e6c9f9564f24",
                                "text": "„In Nachtläufen werden entscheidungsrelevante Daten geladen, strukturiert und aufbereitet.“"
                            },
                            {
                                "example_id": "8e76da65-e8a3-4c95-b056-da8aa01878aa",
                                "sense_id": "9be9ca13-06e5-3380-96d0-e6c9f9564f24",
                                "text": "„Gegeben ist außerdem ein bestehender Nachtlauf in Form eines DB-Jobs über den ein auf dem Server hinterlegtes Programm (in diesem Fall Visual Basic Script) aufgerufen werden kann.“"
                            },
                            {
                                "example_id": "83013229-1ef3-468b-93e7-4ff77fb1e21f",
                                "sense_id": "9be9ca13-06e5-3380-96d0-e6c9f9564f24",
                                "text": "„Das macht Sinn, da das System kurz nach Mitternacht, die vollständigen Daten für den Vortag vorfindet und bei einem Nachtlauf auch recht wenig Besucher gestört werden (Performancelast, größere Antwortzeiten des Servers).“"
                            },
                            {
                                "example_id": "2dcab5f2-3b98-466a-be80-7ac5e474a241",
                                "sense_id": "9be9ca13-06e5-3380-96d0-e6c9f9564f24",
                                "text": "„Die Aufforderungen dazu erhalten sie regelmäßig über Listen, beispielsweise, wenn im Nachtlauf bestimmte Zahlungen nicht so durchgeführt wurden wie geplant.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
