                    }
                ],
                "senses": [
                    {
                        "sense_id": "f82d2943-7f61-39b4-b252-84dfa27d5aea",
                        "entry_id": "c5e4e837-36bf-3704-b26c-a68e794b0f8a",
                        "glosses": [
                            "in omgekeerde richting."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9743a45d-2e01-4d1b-b54c-c905d1bf7ba2",
                                "sense_id": "f82d2943-7f61-39b4-b252-84dfa27d5aea",
                                "text": "Na de rechtse steek volg je met een averechtse."
                            },
                            {
                                "example_id": "657e1b2f-576c-46be-8f72-778cdf3ed3b5",
                                "sense_id": "f82d2943-7f61-39b4-b252-84dfa27d5aea",
                                "text": "Een verbod heeft bij pubers vaak een averechts effect, wat je wilt verbieden wordt ineens een stuk aantrekkelijker juist omdat het verboden is."
                            },
                            {
                                "example_id": "0b2b94fe-8227-42ee-8179-fe480f4e9e0e",
                                "sense_id": "f82d2943-7f61-39b4-b252-84dfa27d5aea",
                                "text": "Als ze een scène maakte zou dat slechts averechts werken, wist ze."
                            },
                            {
                                "example_id": "ad9c1968-4790-4cf3-b531-da7380d357a7",
                                "sense_id": "f82d2943-7f61-39b4-b252-84dfa27d5aea",
                                "text": "Zoals alle mensen van zijn rang, had hij niet door dat de theatrale mesquinerie een averechtse werking had, dat mensen van hogere rangen juist een enorme walging voelden voor alles wat onderdanig was, zij keken zelf immers omhoog, zoals iedereen omhoogkeek, en dan wilde je er niet aan herinnerd worden dat er ook van alles onder je gebeurde, dat ook daar mensen leefden die iets van je wilden, zoals jij van diegenen boven je iets wilde."
                            },
                            {
                                "example_id": "ded8bdf7-d0c8-4a1a-bcfe-d4ff5d9b414b",
                                "sense_id": "f82d2943-7f61-39b4-b252-84dfa27d5aea",
                                "text": "Azzedine slaat zijn glas op de tafel en zegt dat de Arabische eenheid een fabel is van demagogen, zoals elke vorm van politiek het product is van de menselijke verbeelding, maar dat dit vooral een illusie is die niet werkt, die misschien zelfs averechts werkt."
                            }
                        ]
                    }
                ],
