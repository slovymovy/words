                ],
                "senses": [
                    {
                        "sense_id": "31b324a4-34e9-3df9-a9e8-a74c742d9e68",
                        "entry_id": "a23cf0ca-5b85-352e-a9ad-4661e0c7fb6a",
                        "glosses": [
                            "zwanzigster Bezirk der österreichischen Bundeshauptstadt Wien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf8df538-2965-4e32-8632-32f821b45545",
                                "sense_id": "31b324a4-34e9-3df9-a9e8-a74c742d9e68",
                                "text": "Bereits 1871 wurde die erste Petition an den Wiener Gemeinderat überreicht, um eine Abtrennung der Brigittenau von der Leopoldstadt zu bewirken."
                            },
                            {
                                "example_id": "444b3fdd-5249-4a36-876e-8a8a1ae048c9",
                                "sense_id": "31b324a4-34e9-3df9-a9e8-a74c742d9e68",
                                "text": "Die Brigittenau, das ist jener Bezirk, wo ein Frisörbesuch - für Männer - im Schnitt nur 10 Euro kostet und das Eis in den meisten Fällen nach Industrie und nicht nach frischen Früchten schmeckt."
                            },
                            {
                                "example_id": "3dfb5fae-b4df-4c26-a007-7904e32c594a",
                                "sense_id": "31b324a4-34e9-3df9-a9e8-a74c742d9e68",
                                "text": "Nach der Donaustadt wird die Brigittenau in den kommenden Jahren der am zweitstärksten wachsende Bezirk von ganz Wien sein."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "151dac4d-435b-3295-8cb7-4da6bb7c7f7c",
                        "entry_id": "a23cf0ca-5b85-352e-a9ad-4661e0c7fb6a",
                        "glosses": [
                            "ehemaliger Vorort, nunmehr Ortsteil des gleichnamigen Bezirkes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e27c92e-cbb0-4ed3-b439-d95cf3c0f4a6",
                                "sense_id": "151dac4d-435b-3295-8cb7-4da6bb7c7f7c",
                                "text": "Vor 1850 gehörten die beiden Ortschaften Brigittenau und Zwischenbrücken zu Niederösterreich."
                            },
                            {
                                "example_id": "43d3d461-bbdf-44fa-a5e1-30c14df148b8",
                                "sense_id": "151dac4d-435b-3295-8cb7-4da6bb7c7f7c",
                                "text": "Bis zum Jahre 1598 - 1600 hing die Brigittenau mit der Klosterneuburger-Aue und der Spittel-Au zusammen."
                            },
                            {
                                "example_id": "b9ba24cb-f188-49d6-8eeb-3c7aa63385df",
                                "sense_id": "151dac4d-435b-3295-8cb7-4da6bb7c7f7c",
                                "text": "Der Sporn an der Brigittenau wurde angelegt, die Aue durchschnitten, und auf diese Weise ein neuer Donauarm (der Wienerkanal) hart an die Wälle der Hauptstadt hereingeleitet."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
