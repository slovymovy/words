                        "target_lang_word": "осмотрительность",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "осмотрительность",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "a5b185be-c317-333b-9827-710cad6c895c",
                                        "entry_id": "2fc9b266-37f5-3552-b347-48ac8284b27b",
                                        "glosses": [
                                            "осторожность, предусмотрительность в действиях и поступках"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f289b135-fab2-4c7e-8a2a-7a18ec57243c",
                                                "sense_id": "a5b185be-c317-333b-9827-710cad6c895c",
                                                "text": "Наистрожайше вам подтверждаю иметь бдение и крайнюю осмотрительность и никаких судов без строгого осмотра не пропускать…"
                                            },
                                            {
                                                "example_id": "0a5e6713-424f-4d39-ac62-2823a9e45163",
                                                "sense_id": "a5b185be-c317-333b-9827-710cad6c895c",
                                                "text": "Взятку берёт чиновник с осмотрительностью, а иногда и с невольным угрызением совести, а едучи на обед, он не ощущает ничего, кроме удовольствия."
                                            },
                                            {
                                                "example_id": "cac01050-2d2e-4731-83cb-e47d42ff46af",
                                                "sense_id": "a5b185be-c317-333b-9827-710cad6c895c",
                                                "text": "А между тем, невзирая на великую свою хитрость и осмотрительность, заурядные мошенники отличаются часто совсем детскою, поражающею наивностью."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
