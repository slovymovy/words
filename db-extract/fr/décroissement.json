                        "entry_id": "02ba44a2-a40b-3586-afc6-20147d149a12",
                        "glosses": [
                            "Diminution progressive."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "905f4303-3d27-4e3c-8c45-d1dcb41bc117",
                                "sense_id": "616215aa-a4cf-3bb6-89ba-08a4c1929d00",
                                "text": "Le décroissement de la rivière. - Le décroissement des jours."
                            },
                            {
                                "example_id": "e3a37c9b-40d8-4c5e-baa3-16e8afacb8ea",
                                "sense_id": "616215aa-a4cf-3bb6-89ba-08a4c1929d00",
                                "text": "Jusqu’au niveau de l’inversion, le décroissement de la température de l’air est, en général, de 0°,7 pour 100 mètres."
                            }
                        ]
                    }
                ],
                "translations": [
