                                        "entry_id": "c25ccc59-a635-3d49-949f-dd152a7283e4",
                                        "glosses": [
                                            "The fact of having a regular, proper and systematic arrangement."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9f4cff7a-1d41-4126-82c0-017cf539f06a",
                                                "sense_id": "682c5487-69a2-39d9-be0d-52ea89906fd9",
                                                "text": "Even at the busiest periods, an air of quiet orderliness pervades the hall, and the first impression gained by the traveller is one of efficiency, neatness and cleanliness."
                                            },
                                            {
                                                "example_id": "18b07546-6a75-4d00-9d36-a762e5a9e157",
                                                "sense_id": "682c5487-69a2-39d9-be0d-52ea89906fd9",
                                                "text": "Voltaire had drawn on Newton to demonstrate an allegedly divine orderliness in the natural world which left no space for God's intervention in human affairs [...]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d74b45da-41cb-37a9-ade6-58d5cb1c2f8c",
                                        "entry_id": "c25ccc59-a635-3d49-949f-dd152a7283e4",
                                        "glosses": [
                                            "Orderly behaviour."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
