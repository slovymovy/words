                "entry_id": "944b71b7-9e8e-3878-bb09-5cb4a2a20362",
                "word": "azoic",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "cf8327bf-e2c6-31eb-9f74-575e479330a7",
                        "entry_id": "944b71b7-9e8e-3878-bb09-5cb4a2a20362",
                        "glosses": [
                            "Destitute of any vestige of organic life, or at least of animal life."
                        ],
                        "tags": [
                            "dated",
                            "not-comparable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "5ec5a8eb-7ba3-3cd7-91a6-f2a5a77aed61",
                        "entry_id": "944b71b7-9e8e-3878-bb09-5cb4a2a20362",
                        "glosses": [
                            "Before the existence of animal life."
                        ],
                        "tags": [
                            "dated",
                            "not-comparable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d2b8dd3d-02f0-4817-8d3e-5a02ac5ecfdb",
                        "source_entry_id": "944b71b7-9e8e-3878-bb09-5cb4a2a20362",
                        "source_sense_description": "anterior to the existence of animal life",
                        "target_lang_word": "azoïque",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "azoïque",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4e946d54-e90a-3554-85ca-4678cabd0801",
                                        "entry_id": "da21ce66-6e05-32fa-be66-bcfeae03af55",
                                        "glosses": [
                                            "Qualifie une molécule, un produit, qui contient un radical -N=N- dans sa formule chimique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "966a7b56-34fb-449b-a6f4-7c5b902749cb",
                                                "sense_id": "4e946d54-e90a-3554-85ca-4678cabd0801",
                                                "text": "L’impossibilité de la diquaternisation du pigment à diméthyl-aniline dans le cas des colorants azoïques a été démontrée par A. I. Kiprianov (8) […]"
                                            },
                                            {
                                                "example_id": "89577aef-2e07-442d-9cb3-c7586941c731",
                                                "sense_id": "4e946d54-e90a-3554-85ca-4678cabd0801",
                                                "text": "De nombreux jaunes, par exemple, qu’ils soient d’origine naturelle (flavoniques) ou artificielle (azoïques) présentent une fluorescence non négligeable."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "azoïque",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ba77f678-c7f0-36a1-84dc-798050fae1ad",
                                        "entry_id": "65daa1a7-6d6b-3e9a-8239-69752bbabf0c",
                                        "glosses": [
                                            "Qualifie des zones de la terre dépourvues d’animaux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cae0b97f-93b4-4967-bdcd-48dd95d04a29",
                                                "sense_id": "ba77f678-c7f0-36a1-84dc-798050fae1ad",
                                                "text": "Cette hypothèse, dite azoïque, formulée par le naturaliste britannique Edward Forbes, paraissait logique […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5045b1cd-bd0c-348c-ab8d-a4d818a2a4f2",
                                        "entry_id": "65daa1a7-6d6b-3e9a-8239-69752bbabf0c",
                                        "glosses": [
                                            "Qualifie une couche géologique dépourvue de fossiles animaux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83333bb8-dd94-4b48-aa11-69a54e43cb12",
                                                "sense_id": "5045b1cd-bd0c-348c-ab8d-a4d818a2a4f2",
                                                "text": "Le terrain azoïque occupe des espaces plus ou moins considérables dans l’arrondissement de Beaupreau […]"
                                            },
                                            {
                                                "example_id": "d56bac89-f3e9-4d78-8e7b-b7f915507103",
                                                "sense_id": "5045b1cd-bd0c-348c-ab8d-a4d818a2a4f2",
                                                "text": "Le schiste argileux cédait la place au grès, puis ce fut une roche quartzeuse métamorphosée qui, probablement, se rattache au groupe des schistes azoïques."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e21f9b0-32de-3cbd-8037-aeeeabf4e331",
                                        "entry_id": "65daa1a7-6d6b-3e9a-8239-69752bbabf0c",
                                        "glosses": [
                                            "Qualifie la période géologique de la terre durant laquelle les animaux n’existaient pas encore."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "846f1dcf-50fe-41b0-af0c-7a659e44ecf0",
                                                "sense_id": "1e21f9b0-32de-3cbd-8037-aeeeabf4e331",
                                                "text": "Pendant l’époque azoïque, les mouvements violents et les ruptures se manifestent à de plus longs intervalles, mais augmentent d’importance, l’effort croissant en raison de la résistance."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
