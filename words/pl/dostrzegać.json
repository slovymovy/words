{
    "word_family": [
        "dostrzegalny",
        "niedostrzegalny",
        "dostrzeżenie"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5915bca9-0776-3f7b-ae04-0b9aab0f1fb7",
                    "sense_definition": "zwracać uwagę na coś, zauważać coś",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "percepcja",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Filip <w>dostrzegał</w> w Paulinie wybitne zdolności artystyczne.",
                            "target_lang_translations": {
                                "ru": "Филип <w>замечал</w> в Паулине выдающиеся художественные способности."
                            }
                        },
                        {
                            "text": "Trudno <w>dostrzec</w> jakiekolwiek zmiany w tym projekcie.",
                            "target_lang_translations": {
                                "ru": "Трудно <w>заметить</w> какие-либо изменения в этом проекте."
                            }
                        }
                    ],
                    "synonyms": [
                        "zauważać",
                        "spostrzegać",
                        "widzieć"
                    ],
                    "common_phrases": [
                        "dostrzegać różnicę",
                        "dostrzegać potencjał"
                    ],
                    "target_lang_definitions": {
                        "ru": "обращать внимание на что-либо, замечать что-либо"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "замечать",
                                "target_lang_sense_clarification": "обнаруживать что-либо и уделять этому внимание"
                            },
                            {
                                "target_lang_word": "разглядеть",
                                "target_lang_sense_clarification": "увидеть, понять что-то скрытое или неявное"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "71237fb2-247a-359a-aa00-da2fd0b1d311",
                    "sense_definition": "widzieć coś z dużej odległości",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "percepcja",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Czy <w>dostrzega</w> Pani ten statek na horyzoncie?",
                            "target_lang_translations": {
                                "ru": "Вы <w>видите</w> тот корабль на горизонте?"
                            }
                        },
                        {
                            "text": "Z wieży można <w>dostrzec</w> całą okolicę.",
                            "target_lang_translations": {
                                "ru": "С башни можно <w>разглядеть</w> всю округу."
                            }
                        }
                    ],
                    "synonyms": [
                        "widzieć",
                        "spostrzegać"
                    ],
                    "common_phrases": [
                        "dostrzec na horyzoncie"
                    ],
                    "target_lang_definitions": {
                        "ru": "видеть что-либо на большом расстоянии"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "замечать",
                                "target_lang_sense_clarification": "визуально обнаруживать объект на расстоянии"
                            },
                            {
                                "target_lang_word": "разглядеть",
                                "target_lang_sense_clarification": "увидеть что-то удаленное или нечеткое"
                            },
                            {
                                "target_lang_word": "видеть",
                                "target_lang_sense_clarification": "воспринимать зрением"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1a944bee-e9f7-359a-b2ab-2b4d3faf83d1",
                    "sense_definition": "zauważać jeden drugiego",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "percepcja",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W tłumie ludzie rzadko <w>dostrzegają</w> <w>się</w> nawzajem.",
                            "target_lang_translations": {
                                "ru": "В толпе люди редко <w>замечают</w> <w>друг</w> <w>друга</w>."
                            }
                        },
                        {
                            "text": "Po latach <w>dostrzegli</w> <w>się</w> na dworcu i od razu poznali.",
                            "target_lang_translations": {
                                "ru": "Спустя годы они <w>увидели</w> <w>друг</w> <w>друга</w> на вокзале и сразу узнали."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "замечать друг друга"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "замечать друг друга",
                                "target_lang_sense_clarification": "обращать внимание на присутствие другого человека"
                            },
                            {
                                "target_lang_word": "увидеть друг друга",
                                "target_lang_sense_clarification": "встретиться взглядом или обнаружить присутствие"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}