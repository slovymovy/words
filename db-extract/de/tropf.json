                                "sense_id": "be8927f6-fba8-3a7d-bd3b-a16dae23f343",
                                "text": "armer Tropf",
                                "translation": "Pauvre (homme)"
                            },
                            {
                                "example_id": "c0b679dc-0f9a-49a0-84a1-c95cd3629684",
                                "sense_id": "be8927f6-fba8-3a7d-bd3b-a16dae23f343",
                                "text": "Lass ihn in Frieden, der arme Tropf hat's schwer genug.",
                                "translation": "Laisse le tranquille, le pauvre souffre déjà assez."
                            }
