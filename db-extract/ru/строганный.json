                "senses": [
                    {
                        "sense_id": "1062f33e-31ae-3bdb-8da3-7b28da571543",
                        "entry_id": "2bcdbac2-02c5-368b-817c-9059394c920c",
                        "glosses": [
                            "страд. прич. прош. вр. от строгать"
                        ],
                        "tags": [
                            "participle"
                        ],
                        "examples": [
                            {
                                "example_id": "4eb829f7-92d9-4a72-90b4-664e9f55aa71",
                                "sense_id": "1062f33e-31ae-3bdb-8da3-7b28da571543",
                                "text": "Колоты они были из трость-дерева, строганы в Новегороде, клеены клеем осетра рыбы, оперены перьем сизого орла."
                            },
                            {
                                "example_id": "5ece2905-4b2c-4015-8eb2-4b67b12f2f2f",
                                "sense_id": "1062f33e-31ae-3bdb-8da3-7b28da571543",
                                "text": "Предварительно строганый шпон нужно протравить в горячем растворе квасцов."
                            }
                        ]
                    }
