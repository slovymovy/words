                                "text": "a uniquely gifted musician"
                            },
                            {
                                "example_id": "90ac901e-b6da-4e0b-a713-e858dcb99dbe",
                                "sense_id": "c4de7638-1dc2-3a4f-8fd5-2e2c9f503105",
                                "text": "components that are uniquely numbered for identification"
