                "senses": [
                    {
                        "sense_id": "8354d143-b557-30cd-af56-40786597a4ed",
                        "entry_id": "cb897e0a-e7a7-327e-b64e-1689572485db",
                        "glosses": [
                            "samenvoeging ('plakken') van verschillende onderdelen tot één kunstwerk"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b04b72ae-9de7-43bf-84c4-754cf297510a",
                                "sense_id": "8354d143-b557-30cd-af56-40786597a4ed",
                                "text": "Met klassieke afrobeat heeft de plaat niets te maken, het is een collage van traditioneel en experimenteel, Afro-Caribisch en westers. Alsof de Haïtiaanse muziek van zichzelf nog niet hypnotiserend genoeg is, zitten de tracks vol elektronica met hetzelfde effect."
                            },
                            {
                                "example_id": "c230c2aa-b6c2-4b3f-bca9-694324fb836b",
                                "sense_id": "8354d143-b557-30cd-af56-40786597a4ed",
                                "text": "Fotocollage van de slachtoffers: Er komen twee lange wanden te staan met de namen van alle slachtoffers. Nabestaanden en genodigden kunnen daar een bloem achterlaten zodat een erehaag ontstaat. Aan het einde van de ceremonie wordt een collage geprojecteerd van foto's van de slachtoffers. De nabestaanden hebben die foto's ingezonden."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1104a202-adfd-41dd-9986-ec451f357b2f",
                        "source_entry_id": "cb897e0a-e7a7-327e-b64e-1689572485db",
                        "source_sense_id": "8354d143-b557-30cd-af56-40786597a4ed",
                        "target_lang_word": "Collage",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Collage",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f0cec7e2-29fc-3c11-a568-3275f6386a25",
                                        "entry_id": "6c86c6eb-6a02-3cd3-a990-7dc2cdfcf671",
                                        "glosses": [
                                            "Technik, bei der durch Aufkleben verschiedener Elemente auf einen Träger ein neues Gesamtkunstwerk geschaffen wird"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b3c9657-3c93-416e-9975-064f32ef780a",
                                                "sense_id": "f0cec7e2-29fc-3c11-a568-3275f6386a25",
                                                "text": "Mittels der Collage erreicht der Künstler mit den verschiedenen Materialien nie gekannte optische Effekte und fesselt das Auge des Betrachters."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "269e814d-e0e6-3436-9354-212b7eac4199",
                                        "entry_id": "6c86c6eb-6a02-3cd3-a990-7dc2cdfcf671",
                                        "glosses": [
                                            "ein in der unter [1] beschriebenen Technik erstelltes Kunstwerk"
                                        ],
                                        "tags": [
                                            "Bildende Kunst"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3d34a219-1d72-450e-a13c-45cd70d8ff78",
                                                "sense_id": "269e814d-e0e6-3436-9354-212b7eac4199",
                                                "text": "„Wer will, kann das Ganze eine Collage nennen, aber es ist mehr, mehr als eine Aneinanderreihung von Fundstücken.“"
                                            },
                                            {
                                                "example_id": "ee5ba58a-9b0f-4fe3-8ebf-001ba2ebb019",
                                                "sense_id": "269e814d-e0e6-3436-9354-212b7eac4199",
                                                "text": "„Wie bei einer Collage sind die Ränder der einzelnen, formal und inhaltlich ganz unterschiedlichen Beiträge durch Orts- und Zeitangaben oder durch Asteriskus sichtbar.“"
                                            },
                                            {
                                                "example_id": "2b7e0c61-f484-4de3-99f7-06b84b8808d7",
                                                "sense_id": "269e814d-e0e6-3436-9354-212b7eac4199",
                                                "text": "„Kreativ sind immer nur Muttis, die einen Gewürzbindekurs in der VHS absolvieren, oder Allianz-Vertreter, die im Strategieworkshop Collagen schnipseln.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "05d7b420-dc1d-46a9-97fb-398e772a27f4",
                        "source_entry_id": "cb897e0a-e7a7-327e-b64e-1689572485db",
