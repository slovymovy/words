                "senses": [
                    {
                        "sense_id": "f83be404-d26e-3e29-bc00-9f325746ae89",
                        "entry_id": "c22658c0-0458-3288-859e-4cecf89b6b4b",
                        "glosses": [
                            "die nächsten Tage, Monate, Jahre"
                        ],
                        "tags": [
                            "meist Singular, je nach Zusammenhang"
                        ],
                        "examples": [
                            {
                                "example_id": "3f95a34a-11ab-450b-8075-f0165e33096b",
                                "sense_id": "f83be404-d26e-3e29-bc00-9f325746ae89",
                                "text": "„Unter den fränkischen und sächsischen Herrschern wuchs in der Folgezeit die Zahl der Münzstätten ebenso wie die Münzproduktion stark an.“"
                            },
                            {
                                "example_id": "b2985c57-ee23-446b-a70a-2e6d79455df8",
                                "sense_id": "f83be404-d26e-3e29-bc00-9f325746ae89",
                                "text": "„In der Folgezeit sollten die Inder, gerade weil ihnen die Briten den Parlamentarismus vorenthielten, nur noch entschiedener danach verlangen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
