        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "1ac4c5f7-ea96-3f66-8154-763866353e38",
                "word": "prerevolutionary",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "02486649-daff-3095-9f9b-e58e28d80feb",
                        "entry_id": "1ac4c5f7-ea96-3f66-8154-763866353e38",
                        "glosses": [
                            "Occurring before a revolution."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "0753ab11-bfca-4bc7-a92a-d30c7d807b0d",
                                "sense_id": "02486649-daff-3095-9f9b-e58e28d80feb",
                                "text": "Although Brogan sees the history as a “medley of fiction and wishful thinking,” he is deeply impressed with Tocqueville’s pioneering use of local archives, which allowed him to lay out the continuity between prerevolutionary and postrevolutionary France."
                            },
                            {
                                "example_id": "dbbe6dda-56ce-4cfa-9f13-7435307443cc",
                                "sense_id": "02486649-daff-3095-9f9b-e58e28d80feb",
                                "text": "But there are those within the senior ranks of the Party who count you among the heroes of the prerevolutionary cause."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c23d5875-e52e-4c96-a602-d221fce9f19e",
                        "source_entry_id": "1ac4c5f7-ea96-3f66-8154-763866353e38",
                        "source_sense_id": "02486649-daff-3095-9f9b-e58e28d80feb",
                        "source_sense_description": "occurring before a revolution",
                        "target_lang_word": "prérévolutionnaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prérévolutionnaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2e149850-0d8f-3b91-911c-0bc1ed73520a",
                                        "entry_id": "3c49a683-9165-393a-b5d1-d62230dd3ffa",
                                        "glosses": [
                                            "Qui précède, qui vient avant la révolution."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c07a355-39e0-431d-8023-eb031f3000ce",
                                                "sense_id": "2e149850-0d8f-3b91-911c-0bc1ed73520a",
                                                "text": "Ils s’inquiètent de ce qui se passe et établissent un parallèle avec l’immoralité des années prérévolutionnaires, le chaos et la destruction du pays dans les années 1990 », a renchéri le patriarche début février."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bb4b71ef-1ece-43fc-80d5-4fe821859520",
                        "source_entry_id": "1ac4c5f7-ea96-3f66-8154-763866353e38",
                        "source_sense_id": "02486649-daff-3095-9f9b-e58e28d80feb",
                        "source_sense_description": "occurring before a revolution",
                        "target_lang_word": "vorrevolutionär",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vorrevolutionär",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d16c07e9-2179-3622-b8c7-d29403e51ce6",
                                        "entry_id": "7372da00-d9de-3d9f-8858-feb53a01b2e9",
                                        "glosses": [
                                            "den Zeitraum vor einer Revolution betreffend, aus ihm stammend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5911f806-77eb-4d31-975f-79fffe961ac4",
                                                "sense_id": "d16c07e9-2179-3622-b8c7-d29403e51ce6",
                                                "text": "„Der Junge wanderte gewöhnlich in südlicher Richtung weiter, vorbei an den langen Reihen vorrevolutionärer Häuser mit ihren wuchtigen Mittelkaminen und altehrwürdigen Eingängen.“"
                                            },
                                            {
                                                "example_id": "f07b0867-f8cb-4e3f-a843-5d50566a7aef",
                                                "sense_id": "d16c07e9-2179-3622-b8c7-d29403e51ce6",
                                                "text": "„Während der vorrevolutionären Wirren war Sadrs rechte Hand Mustafa Chamran - er gehörte wie Berri ebenfalls dem Führungsrat der AMAL an - nach Iran zurückgekehrt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
