                        ],
                        "examples": [
                            {
                                "example_id": "f86c5c7a-e690-4cd4-8b54-7793c77b2a3d",
                                "sense_id": "b3103b9d-8f59-3387-997a-0907c74d122b",
                                "text": "'Olive kreeg een afwezige blik in haar ogen, terwijl ze zich begon terug te trekken uit de omgeving van haar zolder en dichter bij haar kunstzinnige visie kwam."
                            },
                            {
                                "example_id": "90580bc9-d310-4526-9aa0-63e288e8e17e",
                                "sense_id": "b3103b9d-8f59-3387-997a-0907c74d122b",
                                "text": "In de ongemakkelijke stilte die er in de kamer hing, keken zij beiden met afwezige blik naar de rug van Jeroen."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
