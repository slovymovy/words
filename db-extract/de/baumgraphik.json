                "senses": [
                    {
                        "sense_id": "5262e511-6e6d-3c24-91c8-c21198c6a0e7",
                        "entry_id": "a509d215-519c-3b6b-b076-432a7010a2d6",
                        "glosses": [
                            "Darstellungsmittel, um die hierarchische Struktur sprachlicher Einheiten (Wörter oder Sätze) zu veranschaulichen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ccfab73-9ef4-487a-b065-055a699fb312",
                                "sense_id": "5262e511-6e6d-3c24-91c8-c21198c6a0e7",
                                "text": "Eine Baumgraphik veranschaulicht die engeren oder weniger engen Beziehungen zwischen den Bestandteilen einer sprachlichen Einheit, wie sie durch die IC-Analyse ermittelt werden."
                            },
                            {
                                "example_id": "3d0c6834-c214-4af2-8029-138835d4ee21",
                                "sense_id": "5262e511-6e6d-3c24-91c8-c21198c6a0e7",
                                "text": "„In einer „Repräsentation als Baumgraphik (`Phrasenstrukturbaum')“ wird ein sehr einfacher Satz dargestellt.“"
                            },
                            {
                                "example_id": "993ebdaf-b6ec-4e89-80bd-16920dd40a68",
                                "sense_id": "5262e511-6e6d-3c24-91c8-c21198c6a0e7",
                                "text": "„Man kann das auf verschiedene Weise darstellen, etwa durch eine Klammerung oder durch eine Baumgrafik...“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
