                        "glosses": [
                            "Nom vernaculaire du tyran quiquivi (Pitangus sulphuratus), espèce de passereau de la famille des Tyrannidae implantée en Amérique latine."
                        ],
                        "tags": [
                            "Guyane"
                        ],
                        "examples": [
                            {
                                "example_id": "b799cc93-2df2-4a69-a642-08dbb64bcd67",
                                "sense_id": "c0b0d2f8-dbf5-3a8a-8800-11bb3ee2aec3",
                                "text": "Un kikiwi vint se poser sur la liane de maracuja."
                            },
                            {
                                "example_id": "1e1c6b47-3f6e-4414-a3fe-ad4fba4e619d",
                                "sense_id": "c0b0d2f8-dbf5-3a8a-8800-11bb3ee2aec3",
                                "text": "L’eau s'évapore sur le sol, le bois flambe plus aisément, les kikiwis, les aras et autres volatiles colorés chantent de plus belle, les moustiques se cachent, et les sourires éclairent les visages."
                            }
                        ]
                    }
