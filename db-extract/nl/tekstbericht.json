                "senses": [
                    {
                        "sense_id": "b175958c-ecca-336c-80b7-6621eac9330d",
                        "entry_id": "9085d688-72d2-35b3-a796-f5df78d5d08b",
                        "glosses": [
                            "boodschap verstuurd via het mobiele telefoonnetwerk die niet bestaat uit gesproken woorden maar uit getypte tekst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "82fd4775-d43b-4841-b584-485536251b50",
                                "sense_id": "b175958c-ecca-336c-80b7-6621eac9330d",
                                "text": "Een Amerikaanse tiener is gisteren overleden toen hij tijdens een jaarlijkse bergloop bij Anchorage werd aangevallen door een zwarte beer. De jongen (16) had vlak voor zijn dood het thuisfront gealarmeerd in een tekstbericht maar alle hulp kwam te laat."
                            },
                            {
                                "example_id": "21059e42-4ab0-4217-b7f8-76dd559839c9",
                                "sense_id": "b175958c-ecca-336c-80b7-6621eac9330d",
                                "text": "Het nieuws over de digitale aanval lekte volgens de BBC uit via een lid van het Hogerhuis, het House of Lords. Chris Rennard twitterde dat urgente boodschappen voor hem per tekstbericht verstuurd moesten worden, omdat het mailsysteem vanwege een cyberaanval niet gebruikt kon worden."
                            },
                            {
                                "example_id": "95b91bd4-5d2f-4452-9e3c-9fa0b385d932",
                                "sense_id": "b175958c-ecca-336c-80b7-6621eac9330d",
                                "text": "Ik zag een tekstbericht maar begreep niet wat er stond omdat het in het Japans was geschreven. En toen was dit luchtalarm hoorbaar in de hele stad. De eerste keer om 07.00 uur, de tweede keer om 07.07 uur. Ik heb het bericht vertaald met mijn telefoon en het betekent: 'Zoek een schuilplek in een kelder, Noord-Korea heeft zojuist een raket afgevuurd."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a9c8542d-db0e-4b39-95d8-da348a1ac008",
                        "source_entry_id": "9085d688-72d2-35b3-a796-f5df78d5d08b",
                        "source_sense_id": "b175958c-ecca-336c-80b7-6621eac9330d",
                        "target_lang_word": "text message",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "text message",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a968b927-53e1-33e8-b6be-1a72f0996b87",
                                        "entry_id": "d1fe3ea3-12d5-3562-86e2-ea066f7be492",
                                        "glosses": [
                                            "A brief electronic message sent between mobile phones."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c89f9200-3a27-4c01-a58d-df6da0217e45",
                                                "sense_id": "a968b927-53e1-33e8-b6be-1a72f0996b87",
                                                "text": "After the kitten had died, Robins sent a text message to Knutton saying: \"Remember the saying: 'What goes around comes around?' It has started already to bite you in the arse. The cat? Karma.\""
                                            },
                                            {
                                                "example_id": "8fdb036b-a21a-44f7-b0d2-5f8cfc685579",
                                                "sense_id": "a968b927-53e1-33e8-b6be-1a72f0996b87",
                                                "text": "A farmer could place an order for a new tractor part by text message and pay for it by mobile money-transfer. A supplier many miles away would then take the part to the local matternet station for airborne dispatch via drone."
                                            },
                                            {
                                                "example_id": "c23a123d-3c11-42f7-8417-e4dd62663456",
                                                "sense_id": "a968b927-53e1-33e8-b6be-1a72f0996b87",
                                                "text": "Similarly, Fingilish usually refers to transliterated Farsi in chatrooms, text messages, and the like."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "text message",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "38519088-75f9-3386-955e-0f1604f1e033",
                                        "entry_id": "06a070f7-db92-3d42-bf72-a53aa7e5712d",
                                        "glosses": [
                                            "To transmit a text message."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7efeecfc-ba67-43d4-9ad2-329f0299f626",
                                                "sense_id": "38519088-75f9-3386-955e-0f1604f1e033",
                                                "text": "I told him to text message you when he's finished."
                                            },
                                            {
                                                "example_id": "571a6ba3-2d5c-4c3c-9988-6774ad1d3321",
                                                "sense_id": "38519088-75f9-3386-955e-0f1604f1e033",
                                                "text": "Please text message the directions to me."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
