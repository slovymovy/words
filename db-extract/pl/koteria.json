                    }
                ],
                "senses": [
                    {
                        "sense_id": "c2183b49-79e8-3c1c-bad1-369716f8432e",
                        "entry_id": "55f386f6-bc60-3f9a-8697-c58fef8f3c61",
                        "glosses": [
                            "ekskluzywna grupa ludzi i środowisk związanych ze sobą wspólnym interesem, popierających się nawzajem, aby trwać na różnych poziomach i wymiarach władzy"
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "f5ada6da-9f75-4427-aefb-be10dd0081f1",
                                "sense_id": "c2183b49-79e8-3c1c-bad1-369716f8432e",
                                "text": "Chciał być niezależny, nie związany z żadną koterią, całkowicie wolny i był w tym szczęśliwym położeniu, że mógł sobie na to pozwolić"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7481c675-ce97-4f46-8ea5-5ab3c8869b40",
                        "source_entry_id": "55f386f6-bc60-3f9a-8697-c58fef8f3c61",
                        "source_sense_id": "c2183b49-79e8-3c1c-bad1-369716f8432e",
                        "target_lang_word": "coterie",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "coterie",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a924872b-1e90-362e-938a-d286339863cf",
                                        "entry_id": "dbf79a95-0217-3d31-b8be-362e31dfa2aa",
                                        "glosses": [
                                            "A circle of individuals who associate with one another for a common purpose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1939ad8d-1073-4b52-9359-91aeb04145b1",
                                                "sense_id": "a924872b-1e90-362e-938a-d286339863cf",
                                                "text": "The new junior employee joined our merry after-hours coterie."
                                            },
                                            {
                                                "example_id": "9e5049d5-26b8-4970-b8b5-ea617f9e8725",
                                                "sense_id": "a924872b-1e90-362e-938a-d286339863cf",
                                                "text": "A tightly knit coterie of executive powerbrokers made all the real decisions in the company."
                                            },
                                            {
                                                "example_id": "9a9219a2-4828-44f5-9f9c-c1f06e69136a",
                                                "sense_id": "a924872b-1e90-362e-938a-d286339863cf",
                                                "text": "Baskets of game had reached her house, but not a single line, in his own hand, had met her eye. Better it should be so: Georgiana was not yet in a state to \"lure the gentle tassel back,\" but no thanks to the chattering coterie whom she had courted for the sole purpose of rendering the marquis reassured on the subject of proper acquaintance."
                                            },
                                            {
                                                "example_id": "c292b9b6-95b3-4046-bf19-751c6a565e53",
                                                "sense_id": "a924872b-1e90-362e-938a-d286339863cf",
                                                "text": "The verses were copied out, handed about, sneered at, admired, passed from coterie to coterie."
                                            },
                                            {
                                                "example_id": "702c5d22-8109-4f40-90b4-4b0cf8d4b33b",
                                                "sense_id": "a924872b-1e90-362e-938a-d286339863cf",
                                                "text": "The branch was worked by pull-and push ^([sic]) trains, drawn or propelled by one of a small coterie of the sprightly little Wolverhampton type of 0-4-2 side tanks."
                                            },
                                            {
                                                "example_id": "aacafac5-0bf6-494d-8cd9-a324a1382b04",
                                                "sense_id": "a924872b-1e90-362e-938a-d286339863cf",
                                                "text": "In the case of a crack-smoking, prostitute-frequenting Mr. Sheen, many people in Hollywood say there is a long list of enablers: managers and agents and publicists; a coterie of assistants and party buddies; prostitutes, drug dealers and sex film stars; and the tabloid media, which have fed on Mr. Sheen’s antics for years."
                                            },
                                            {
                                                "example_id": "b92811cb-c318-4b59-b6b6-62cf23354738",
                                                "sense_id": "a924872b-1e90-362e-938a-d286339863cf",
                                                "text": "So the thought of closing the Academy is not based in malice; the action might prove enlightening and refreshing. The old club coterie has very little excuse, and its loss would leave few casualties."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "47b678ac-85c7-376b-bbc5-394c1f932266",
                                        "entry_id": "dbf79a95-0217-3d31-b8be-362e31dfa2aa",
                                        "glosses": [
                                            "A communal burrow of prairie dogs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "345b0c1f-9d71-4072-86d3-725f2db3b6fa",
                                                "sense_id": "47b678ac-85c7-376b-bbc5-394c1f932266",
                                                "text": "The coterie was located in the middle of our wheat field."
                                            },
                                            {
                                                "example_id": "f0dd4cf3-2a76-4a18-8256-93a1490ee3c5",
                                                "sense_id": "47b678ac-85c7-376b-bbc5-394c1f932266",
                                                "text": "The population of each coterie constantly changes over a period of a few months or years, by death, birth, and emigration. But the coterie boundary remains about the same, being learned by each prairie dog born into it."
                                            },
                                            {
                                                "example_id": "5bf079b9-8acd-42aa-9cab-19ceb67e99f4",
                                                "sense_id": "47b678ac-85c7-376b-bbc5-394c1f932266",
                                                "text": "The odd part of prairie dog life is that this friendly state exists only among the members of each coterie, and does not extend between coteries."
                                            },
                                            {
                                                "example_id": "2f9b60d5-f338-4420-b1ef-3c0f50fc4185",
                                                "sense_id": "47b678ac-85c7-376b-bbc5-394c1f932266",
                                                "text": "Young prairie dogs in a coterie are brothers and sisters. They have the same father and sometimes the same mother. To find a mate from a different family, young prairie dogs must travel to a new area."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f0bc8a37-1eb4-48c7-b831-c426437dbda1",
                        "source_entry_id": "55f386f6-bc60-3f9a-8697-c58fef8f3c61",
                        "source_sense_id": "c2183b49-79e8-3c1c-bad1-369716f8432e",
                        "target_lang_word": "coterie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "coterie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bf259e92-4e43-323e-9ce4-a758e6491fab",
                                        "entry_id": "5b8053e4-3d68-3f47-a34a-277a3c1f5f06",
                                        "glosses": [
                                            "Société de villageois réunis pour tenir d’un seigneur quelque héritage."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7192fdd1-aabf-36e0-86c2-125762730236",
                                        "entry_id": "5b8053e4-3d68-3f47-a34a-277a3c1f5f06",
                                        "glosses": [
                                            "Groupe d’ouvriers appartenant à un même corps de métier, spécialement dans le cadre du compagnonnage et des métiers du bâtiment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89747239-da4a-4419-acb0-10cd60c04389",
                                                "sense_id": "7192fdd1-aabf-36e0-86c2-125762730236",
                                                "text": "Un coup ébranla les ais de la fenêtre, tandis qu’une grosse voix, joyeuse et bourrue, criait au dehors :\n— Ben quoi ! La coterie ! Tout le monde roupille là dedans ; y a pu d’amour ?"
                                            },
                                            {
                                                "example_id": "5c8765ed-95eb-472f-b03f-345314c8e6ef",
                                                "sense_id": "7192fdd1-aabf-36e0-86c2-125762730236",
                                                "text": "[Il] monta vers la gare, accompagné par la coterie qui portait en chantant deux lourdes caisses pleines de ses outils."
                                            },
                                            {
                                                "example_id": "850964e8-560e-4f1b-bfc5-14acb62783fe",
                                                "sense_id": "7192fdd1-aabf-36e0-86c2-125762730236",
                                                "text": "La coterie Iosef prit un large ciseau à bois, fendit une des pièces en plusieurs parties, égales puis, avec le même ciseau, les arrondit et les affûta d'un bout."
                                            },
                                            {
                                                "example_id": "a3ac662b-1b23-41c9-a257-39ab95d55cff",
                                                "sense_id": "7192fdd1-aabf-36e0-86c2-125762730236",
                                                "text": "Les maçons travaillaient dans la bonne humeur et sans doute une joie créatrice les animait-elle. Ils sifflaient sur leurs échelle. Ils montaient les seaux de mortier et de pierres à l’aide d’un treuil qu’ils actionnaient à deux. Ils s’interpellaient :\n« Alors, ça va la coterie ? »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7da6c97d-6fa6-35df-bfb0-f826b9ab7e90",
                                        "entry_id": "5b8053e4-3d68-3f47-a34a-277a3c1f5f06",
                                        "glosses": [
                                            "Groupe restreint de personnes liées par des intérêts ou des idées communes et qui cabalent contre ceux qui sont en dehors de ce groupe."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0f225228-fa77-4246-bb85-768a0b338e2b",
                                                "sense_id": "7da6c97d-6fa6-35df-bfb0-f826b9ab7e90",
                                                "text": "Il porta délicatement l’index à la perpendiculaire de sa bouche, puis l’écarta d’un geste ample et prompt, geste de coterie qui scellait on ne savait quel serment, mais qui allait de soi. Il signifiait avec une solennité furtive que nous étions des compagnons et qu’il y avait de l’honneur à n’être pas compris."
                                            },
                                            {
                                                "example_id": "c71444ea-d7a7-4a14-a48c-825efdc0d1fa",
                                                "sense_id": "7da6c97d-6fa6-35df-bfb0-f826b9ab7e90",
                                                "text": "Cette femme, dévouée avec calcul à la fortune politique de son mari, tenait à connaître l’opinion des moindres coteries."
                                            },
                                            {
                                                "example_id": "9fc15195-5b06-4f6c-a128-0b244413645f",
                                                "sense_id": "7da6c97d-6fa6-35df-bfb0-f826b9ab7e90",
                                                "text": "Considérant que M. Fidèle Simon a toujours professé les opinions d’une coterie politique qui a été néfaste à la République, en mécontentant le pays tout entier par son intolérance et sa maladresse…"
                                            },
                                            {
                                                "example_id": "1590bd3a-86ea-4c76-ad5e-f337e43d5f9c",
                                                "sense_id": "7da6c97d-6fa6-35df-bfb0-f826b9ab7e90",
                                                "text": "Comme beaucoup de femmes du faubourg Saint-Germain, la présence dans un endroit où elle se trouvait de quelqu’un de sa coterie, et auquel d’ailleurs elle n’avait rien de particulier à dire, accaparait exclusivement son attention aux dépens de tout le reste."
                                            },
                                            {
                                                "example_id": "55d710d7-4997-45a7-8299-cc36bc8dc4f3",
                                                "sense_id": "7da6c97d-6fa6-35df-bfb0-f826b9ab7e90",
                                                "text": "Je veux sortir l’art contemporain des discours sur les cotes et les coteries. L’espace des Capucins de Landerneau n’est pas réservé aux « sachants »."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e636acca-8713-4d1a-9d64-6fae73491121",
                        "source_entry_id": "55f386f6-bc60-3f9a-8697-c58fef8f3c61",
                        "source_sense_id": "c2183b49-79e8-3c1c-bad1-369716f8432e",
                        "target_lang_word": "камари́лья",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "камари́лья",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "f02dedbe-0173-39c8-81d4-e7ba7589c2b0",
                                        "entry_id": "d41c1618-2f8f-3154-8b8a-54ac79fb01b4",
                                        "glosses": [
                                            "собир., уничиж. группа приближенных к власти людей, пытающихся влиять на ход событий скрытыми интригами"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6ec024ab-3703-4a2e-acb4-b3ed41d93b2a",
                                                "sense_id": "f02dedbe-0173-39c8-81d4-e7ba7589c2b0",
                                                "text": "Мэры, пэры и их лизоблюдская камарилья, как выразился Мурашов, давно покинули больницу, но их место заняли подчиненные Смирницкого."
                                            },
                                            {
                                                "example_id": "9033947f-3913-4dea-9256-c194666fc38a",
                                                "sense_id": "f02dedbe-0173-39c8-81d4-e7ba7589c2b0",
                                                "text": "Это была типичная придворная камарилья, не имевшая поддержки ни среди населения, ни в широких политических и финансово-промышленных кругах."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
