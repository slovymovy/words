                        "glosses": [
                            "Linie/Verlauf mit mehrfachen Wechseln in jeweils entgegengesetzte Richtungen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e96db57-5a7b-439d-9c62-432845525d7f",
                                "sense_id": "442cb0ef-ba07-3903-88b5-6de237dd8ca6",
                                "text": "„So geht es immer weiter in langen Zickzacklinien zwischen den Bergwänden abwärts.“"
                            },
                            {
                                "example_id": "17854caf-fd1e-4a41-bebf-0771e09eb91d",
                                "sense_id": "442cb0ef-ba07-3903-88b5-6de237dd8ca6",
                                "text": "„Diese Spur war so verworren, sie führte ihn in Zickzacklinien nun aufwärts den Kamm, nun wieder abwärts, daß bereits das Dunkel hereinzubrechen anfing, ohne daß er noch bis zu dem Sumpf gekommen war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
