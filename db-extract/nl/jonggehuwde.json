                    {
                        "translation_id": "2708f9db-9248-4b40-88d6-35fe6ba060ee",
                        "source_entry_id": "e7bd7d4f-22cd-3be2-922c-437b35001604",
                        "source_sense_id": "3fa45f77-3ecb-3d78-861c-9a553cb30e91",
