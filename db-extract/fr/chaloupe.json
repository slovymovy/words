        "fr-extract.jsonl": [
            {
                "entry_id": "e02dec83-3442-33e6-a4f9-781f0b15eb7c",
                "word": "chaloupe",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "3c0e3a0b-d0de-406a-8bf0-76955887a873",
                        "entry_id": "e02dec83-3442-33e6-a4f9-781f0b15eb7c",
                        "tags": [
                            "plural"
                        ],
                        "form": "chaloupes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ac94be35-054e-31f2-bc11-40a581d6c4e6",
                        "entry_id": "e02dec83-3442-33e6-a4f9-781f0b15eb7c",
                        "glosses": [
                            "Grand canot dont on se sert principalement dans les ports et les rades pour le transport des vivres, des fardeaux, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7637da24-7f06-4106-bed3-8294242a6e76",
                                "sense_id": "ac94be35-054e-31f2-bc11-40a581d6c4e6",
                                "text": "Jean Donnard et Pierre Kerhuon embarquaient les filets dans la chaloupe, amarrée au quai, près de la cale qu’ensanglantaient des débris de poissons fraîchement éventrés."
                            },
                            {
                                "example_id": "155d33b0-1f4d-4132-b961-7288f524702d",
                                "sense_id": "ac94be35-054e-31f2-bc11-40a581d6c4e6",
                                "text": "Écopée, la barque avait été remise à flot et pendant que ses canotiers ramaient, la chaloupe de Laignel l'aidait à passer les mauvais rouleaux en la remorquant."
                            }
                        ]
                    },
                    {
                        "sense_id": "3bbe2efe-d5ba-367b-8371-66c51510e4c8",
                        "entry_id": "e02dec83-3442-33e6-a4f9-781f0b15eb7c",
                        "glosses": [
                            "Canot à rame ou à moteur embarqué à bord des bateaux pour rejoindre le rivage ou évacuer les passagers."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "014fcf86-5c74-4061-8fae-af8430d76d75",
                                "sense_id": "3bbe2efe-d5ba-367b-8371-66c51510e4c8",
                                "text": "Ce kayak, souple et léger, toujours enlevé sur le dos des lames, insubmersible, chavirable peut-être, […] peut résister et résiste, en effet, là où des chaloupes seraient immanquablement brisées."
                            }
                        ]
                    },
                    {
                        "sense_id": "cf2a5150-c569-3c25-9551-c7162051cb17",
                        "entry_id": "e02dec83-3442-33e6-a4f9-781f0b15eb7c",
                        "glosses": [
                            "Surchaussure protégeant les chaussures de la neige et de l’eau. On dit aussi claque."
                        ],
                        "tags": [
                            "Canada"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "93b5d082-b1c4-4a6d-8430-1a8a083b97b7",
                        "source_entry_id": "e02dec83-3442-33e6-a4f9-781f0b15eb7c",
                        "source_sense_description": "Canot à rame ou à moteur embarqué à bord des bateaux pour rejoindre le rivage ou évacuer les passagers.",
                        "target_lang_word": "Schaluppe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schaluppe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "68c9fea5-f37b-3e86-b00c-b2f84e947e4f",
                                        "entry_id": "89e300b8-21bf-3d1e-9b69-7f5e50a2f9e9",
                                        "glosses": [
                                            "Schiff für den küstennahen Verkehr"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e594b177-72df-44ee-9f9b-e168578dab3a",
                                                "sense_id": "68c9fea5-f37b-3e86-b00c-b2f84e947e4f",
                                                "text": "„Den Mittelpunkt des Marinebetriebes bildete das flußabwärts und ziemlich weit von der Stadt gelegene Gladstone Dock: es war schon mit Zerstörern und Schaluppen und mit den Korvetten, die jetzt in beträchtlicher Zahl von den Werften abliefen, überfüllt.“"
                                            },
                                            {
                                                "example_id": "6f87907b-6648-48bc-8c92-5fa26e358a1b",
                                                "sense_id": "68c9fea5-f37b-3e86-b00c-b2f84e947e4f",
                                                "text": "„Als sie das Geld ausgezahlt hatten, lud William sie an Bord der Schaluppe, wohin sie auch kamen…“"
                                            },
                                            {
                                                "example_id": "82c56e3b-374e-4439-84a2-fcb2560e5fec",
                                                "sense_id": "68c9fea5-f37b-3e86-b00c-b2f84e947e4f",
                                                "text": "„Eine prächtige Schaluppe fuhr neben uns her, das Vorsegel wie eine geblähte Schärpe, und der ganze Küstenverkehr stampfte mühsam den Sund hinauf oder wälzte sich schwer in Richtung New York.“"
                                            },
                                            {
                                                "example_id": "4762fafb-6f4a-4521-8272-cd8159dc7bf9",
                                                "sense_id": "68c9fea5-f37b-3e86-b00c-b2f84e947e4f",
                                                "text": "„Da alles in Ordnung war, hielt uns die Schaluppe nicht auf, und wir durften weitersegeln.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ffe7280e-7a73-38ea-b0fd-260b0cd48626",
                                        "entry_id": "89e300b8-21bf-3d1e-9b69-7f5e50a2f9e9",
                                        "glosses": [
                                            "als Beiboot verwendetes kleines Schiff"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c02b12b-8af5-4322-a703-259f60dff412",
                                                "sense_id": "ffe7280e-7a73-38ea-b0fd-260b0cd48626",
                                                "text": "„Nachdem sie die Schaluppe an Land gezogen hatten, hatte der Bootsmann die Matrosen aufgeteilt, um auf der Suche nach Trinkwasser mehr Chancen zu haben.“"
                                            },
                                            {
                                                "example_id": "d0d27a59-820f-487b-937d-299414591ef6",
                                                "sense_id": "ffe7280e-7a73-38ea-b0fd-260b0cd48626",
                                                "text": "„Nach diesen Beobachtungen brachte er acht Flinten und ebensoviele Säbel in der Schaluppe unter, deckte alles mit einem geteerten Segeltuch zu und beschloß, den günstigsten Augenblick abzuwarten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ae31f568-6ba0-4f38-8720-6b87137c37ca",
                        "source_entry_id": "e02dec83-3442-33e6-a4f9-781f0b15eb7c",
                        "source_sense_description": "Canot à rame ou à moteur embarqué à bord des bateaux pour rejoindre le rivage ou évacuer les passagers.",
                        "target_lang_word": "shallop",
