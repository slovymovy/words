    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "ef391354-4e7e-3d0f-bbf3-bc12eb910877",
                "word": "luncheon",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "7b727a68-8d73-43e8-acd3-5661b4be050f",
                        "entry_id": "ef391354-4e7e-3d0f-bbf3-bc12eb910877",
                        "tags": [
                            "plural"
                        ],
                        "form": "luncheons"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6a4189a9-2282-3951-8173-c5bac7abecdc",
                        "entry_id": "ef391354-4e7e-3d0f-bbf3-bc12eb910877",
                        "glosses": [
                            "A formal meal served in the middle of the day."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "3d727ecb-cecc-4fd3-b8c6-d02c40bdefe3",
                                "sense_id": "6a4189a9-2282-3951-8173-c5bac7abecdc",
                                "text": "Now that she had rested and had fed from the luncheon tray Mrs. Broome had just removed, she had reverted to her normal gaiety. She looked cool in a grey tailored cotton dress with a terracotta scarf and shoes and her hair a black silk helmet."
                            },
                            {
                                "example_id": "be63fc12-3ee0-4729-807f-7e92b51983bb",
                                "sense_id": "6a4189a9-2282-3951-8173-c5bac7abecdc",
                                "text": "Superintendent Chalmers: Well, Seymour, I made it — despite your directions.\nPrincipal Skinner: Ahhh, Superintendent Chalmers! Welcome! I hope you're prepared for an unforgettable luncheon."
                            },
                            {
                                "example_id": "44451d72-934c-4b63-a244-e690b7c99fe9",
                                "sense_id": "6a4189a9-2282-3951-8173-c5bac7abecdc",
                                "text": "Most people thought the food at the luncheon was mediocre."
                            }
                        ]
                    },
                    {
                        "sense_id": "29c09bf8-2f21-3549-ad82-4245571d146f",
                        "entry_id": "ef391354-4e7e-3d0f-bbf3-bc12eb910877",
                        "glosses": [
                            "A large, cheap, processed sausage served in thin slices."
                        ],
                        "tags": [
                            "New-Zealand",
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "1897ed4c-d555-4f66-9d2f-2e1063c4664f",
                                "sense_id": "29c09bf8-2f21-3549-ad82-4245571d146f",
                                "text": "Filled Roll (x2) 1x luncheon, tomato, lettuce, and mayonnaise / 1x cheese and onion"
                            },
                            {
                                "example_id": "c8213e62-d477-4ae9-9055-412d9f464518",
                                "sense_id": "29c09bf8-2f21-3549-ad82-4245571d146f",
                                "text": "Ian bought the luncheon since it was on special."
                            }
                        ]
                    },
                    {
                        "sense_id": "026e759f-a445-345d-a129-def33852aad6",
                        "entry_id": "ef391354-4e7e-3d0f-bbf3-bc12eb910877",
                        "glosses": [
                            "Any midday meal; lunch."
                        ],
                        "tags": [
                            "countable",
                            "dated",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "5f3ed077-7409-4bae-810d-ac55bcaf0d83",
                                "sense_id": "026e759f-a445-345d-a129-def33852aad6",
                                "text": "Have you had luncheon?"
                            }
                        ]
                    },
                    {
                        "sense_id": "e64e808f-f92e-3c78-a28a-2d7b6c5b1535",
                        "entry_id": "ef391354-4e7e-3d0f-bbf3-bc12eb910877",
                        "glosses": [
                            "A lump of food."
                        ],
                        "tags": [
                            "countable",
                            "obsolete",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "5f5ebbf0-e16d-329f-a749-de6c9bfcda40",
                        "entry_id": "ef391354-4e7e-3d0f-bbf3-bc12eb910877",
                        "glosses": [
                            "A portion of food taken at any time except at a regular meal; an informal or light repast."
                        ],
                        "tags": [
                            "countable",
                            "obsolete",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "72116f8f-d06a-4b27-9bed-b5587bc1da60",
                                "sense_id": "5f5ebbf0-e16d-329f-a749-de6c9bfcda40",
                                "text": "At twilight in the summer there is never anybody to fear—man, woman, or cat—in the chambers and at that hour the mice come out. They do not eat parchment or foolscap or red tape, but they eat the luncheon crumbs."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "226d85b0-d52a-4ba1-b96f-71bd113afe1b",
                        "source_entry_id": "ef391354-4e7e-3d0f-bbf3-bc12eb910877",
                        "source_sense_description": "formal meal served in the middle of the day — see also lunch",
                        "target_lang_word": "(slavnostní) oběd",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "2d349e4b-62b5-40cf-a56f-50b6c3d05f8c",
                        "source_entry_id": "ef391354-4e7e-3d0f-bbf3-bc12eb910877",
                        "source_sense_description": "formal meal served in the middle of the day — see also lunch",
                        "target_lang_word": "обед",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "обед",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "75271fcf-08f2-3d59-b9be-11d00f7a16ef",
                                        "entry_id": "6cf6ba8f-b468-3e8e-9152-36c84ab59afb",
                                        "glosses": [
                                            "действие по значению гл. обедать; основной дневной приём пищи"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fdbef858-2f22-4b57-a89c-16f4d56f7cd7",
                                                "sense_id": "75271fcf-08f2-3d59-b9be-11d00f7a16ef",
                                                "text": "Обед кончился очень весело; но когда были поданы бутылки с лафитом и шамбертеном, Привалов отказался наотрез, что больше не будет пить вина."
                                            },
                                            {
                                                "example_id": "c3a0af74-8f02-459d-9649-1890c090195d",
                                                "sense_id": "75271fcf-08f2-3d59-b9be-11d00f7a16ef",
                                                "text": "За обедом я сидел подле Маруси и был очень счастлив."
                                            },
                                            {
                                                "example_id": "e9301576-5777-4653-a483-a1e2416ea073",
                                                "sense_id": "75271fcf-08f2-3d59-b9be-11d00f7a16ef",
                                                "text": "Было уже четыре часа, когда мы воротились домой, следовательно, до обеда оставался ещё час."
                                            },
                                            {
                                                "example_id": "3faf3287-c935-4b90-8194-4e9e4e935bef",
                                                "sense_id": "75271fcf-08f2-3d59-b9be-11d00f7a16ef",
                                                "text": "Моя мамаша подала за обедом не два блюда, как всегда, а четыре."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2c41915f-31b0-3bb7-979d-34d4a68a5042",
                                        "entry_id": "6cf6ba8f-b468-3e8e-9152-36c84ab59afb",
                                        "glosses": [
                                            "кушанья, предназначаемые для дневного приёма пищи"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f5be452-6265-40fa-b621-20a4d26a9fd7",
                                                "sense_id": "2c41915f-31b0-3bb7-979d-34d4a68a5042",
                                                "text": "В этот день Катя сама на рынок сходила, купила говядины для супа (у них к обеду только суп; вместо второго блюда — чай) и приготовила обед."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2313d016-947c-3eb4-866a-4c38dff0b6b3",
                                        "entry_id": "6cf6ba8f-b468-3e8e-9152-36c84ab59afb",
                                        "glosses": [
                                            "разг. обеденное время в середине дня"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7616b97c-0c20-4251-a6ac-aa679a78e601",
                                                "sense_id": "2313d016-947c-3eb4-866a-4c38dff0b6b3",
                                                "text": "— Барышня забыла вам передать это письмецо от госпожи Хохлаковой, оно у них с обеда лежит."
                                            },
                                            {
                                                "example_id": "97b8b703-96b1-44d3-8481-cf08fa65709f",
                                                "sense_id": "2313d016-947c-3eb4-866a-4c38dff0b6b3",
                                                "text": "И обед не в обед."
                                            },
                                            {
                                                "example_id": "a483d721-a652-4d97-a5bd-1f1e652cbaed",
                                                "sense_id": "2313d016-947c-3eb4-866a-4c38dff0b6b3",
                                                "text": "— Скоро ли наш батюшка-то пожалует? — Завтра — в обед, — отвечал Вадим, стараясь отделаться."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "20a258a6-5ebc-3259-9a49-ea846324af96",
                                        "entry_id": "6cf6ba8f-b468-3e8e-9152-36c84ab59afb",
                                        "glosses": [
                                            "дневной приём пищи, устраиваемый как угощение, с приглашением гостей"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8fc07235-54f3-4fb4-8cf7-bdaf069e52c9",
                                                "sense_id": "20a258a6-5ebc-3259-9a49-ea846324af96",
                                                "text": "Два-три раза в году зададут обед — и баста, а сами ни к кому ни ногой…"
                                            },
                                            {
                                                "example_id": "78f8d499-2416-4a01-9979-3d1545b9995f",
                                                "sense_id": "20a258a6-5ebc-3259-9a49-ea846324af96",
                                                "text": "От обеда он отказался, ссылаясь на головную боль, но не выразил ничего против, когда граф посоветовал ему пообедать в своей комнате, в постели."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
