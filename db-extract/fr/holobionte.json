                        "entry_id": "109f6fe1-f914-3c36-b2b7-56bb0153e6e8",
                        "glosses": [
                            "Ensemble composé par un organisme animal ou végétal et les micro-organismes qu’il héberge."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c863f332-b9ca-4600-9253-f5be6bd00034",
                                "sense_id": "0603e2b1-0c6d-3151-b440-cc57aa42ee95",
                                "text": "De ce fait, le concept de symbiose n’est pas approprié et l’on a de plus en plus tendance à employer le terme «holobionte» pour désigner les lichens."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "10f914b6-80db-49cd-a959-d1f2f43280ca",
                        "source_entry_id": "109f6fe1-f914-3c36-b2b7-56bb0153e6e8",
