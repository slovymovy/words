                    {
                        "form_id": "86ea2391-8df8-4fac-95a3-baf23e7d73b8",
                        "entry_id": "9a5120f6-3a1b-3652-8649-1d4b3b14816c",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Meutereien"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "52a13e8d-2c6e-337c-bcca-68dadf8708c4",
                        "entry_id": "9a5120f6-3a1b-3652-8649-1d4b3b14816c",
                        "glosses": [
                            "gewalttätiger Streik einer Belegschaft (zumeist in Verbindung mit Schiffsbesatzungen verwendet), verbunden mit einer Absetzung des Anführers/Chefs/Kapitäns"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c7119e3d-e6c6-416c-b84a-763ca2e17904",
                                "sense_id": "52a13e8d-2c6e-337c-bcca-68dadf8708c4",
                                "text": "Die Meuterei auf der Bounty. (Filmtitel)"
                            },
                            {
                                "example_id": "04ec1a99-5f73-417a-94e4-7031cf0a57cc",
                                "sense_id": "52a13e8d-2c6e-337c-bcca-68dadf8708c4",
                                "text": "„Daß Solly Flood diese Geschichte für wahr hielt, beweist, wie sehr er sich in seine eigene Theorie von Mord und Meuterei verrannt hatte.“"
                            },
                            {
                                "example_id": "4f80d319-f315-42c8-8416-cceab006f682",
                                "sense_id": "52a13e8d-2c6e-337c-bcca-68dadf8708c4",
                                "text": "„Power und mehrere Besatzungsmitglieder hatten, ermutigt durch den Umstand, dass zwei Drittel der Seesoldaten dienstunfähig waren, eine Meuterei geplant.“"
                            },
                            {
                                "example_id": "6081d228-bb00-4b64-8f54-c96e06b71049",
                                "sense_id": "52a13e8d-2c6e-337c-bcca-68dadf8708c4",
                                "text": "„Die Meuterei wurde im Keim erstickt.“"
                            },
                            {
                                "example_id": "cf1b932f-8cc4-44c6-be04-e3950a806b12",
                                "sense_id": "52a13e8d-2c6e-337c-bcca-68dadf8708c4",
                                "text": "„So kurz wie möglich berichtete ich ihm alles, was seit der Meuterei geschehen war.“"
                            },
                            {
                                "example_id": "a051576d-1fce-4623-98dc-e73f9e97b75f",
                                "sense_id": "52a13e8d-2c6e-337c-bcca-68dadf8708c4",
                                "text": "„Keine Meuterei ist zudem gefährlich, wenn die Offiziere über sie informiert und einigermaßen auf sie vorbereitet sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a7bd3ea5-994e-42e8-81b4-45c650cb2444",
                        "source_entry_id": "9a5120f6-3a1b-3652-8649-1d4b3b14816c",
                        "source_sense_id": "52a13e8d-2c6e-337c-bcca-68dadf8708c4",
                        "target_lang_word": "mutiny",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mutiny",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b9623de2-a588-30c0-8c37-2e5aba003466",
                                        "entry_id": "e3786921-7ed5-3309-867c-01a3ff3070ca",
                                        "glosses": [
                                            "An organized rebellion against a legally constituted authority, especially by seamen against their officers."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9f658b94-a2fd-4f6d-839b-491835b43702",
                                                "sense_id": "b9623de2-a588-30c0-8c37-2e5aba003466",
                                                "text": "In every mutiny against the discipline of the college, he was the ringleader."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7f2f4d5d-6c88-3d3a-8d17-5dde292a02c0",
                                        "entry_id": "e3786921-7ed5-3309-867c-01a3ff3070ca",
                                        "glosses": [
                                            "Violent commotion; tumult; strife."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b46423d-5ca7-4e67-9de3-730fce9fd246",
                                                "sense_id": "7f2f4d5d-6c88-3d3a-8d17-5dde292a02c0",
                                                "text": "Raise a mutiny betwixt yourselves."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "mutiny",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7e1b9d88-9e26-304d-97ad-09575b2baae9",
                                        "entry_id": "44b817bc-dfec-396a-80ee-dc7171901966",
                                        "glosses": [
                                            "To commit a mutiny."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "443bf91b-a8f7-4ee2-8382-3e32ab7ae195",
                                                "sense_id": "7e1b9d88-9e26-304d-97ad-09575b2baae9",
                                                "text": "The crew of the Bounty mutinied because of the harsh discipline of Captain Bligh."
                                            },
                                            {
                                                "example_id": "b70c93da-8f76-4b63-8994-1c7ad87298d3",
                                                "sense_id": "7e1b9d88-9e26-304d-97ad-09575b2baae9",
                                                "text": "In the long run, the High Seas Fleet would rarely emerge looking for a fleet action, and, indeed, would be withdrawn if it seemed that the Grand Fleet was out. In 1918, when faced with an order to sail against the British, who had now been augmented by the Sixth Battle Squadron, made up of American warships, the sailors of the High Seas Fleet mutinied instead."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "958ab973-cb5d-4304-9275-7d289a6dab99",
                        "source_entry_id": "9a5120f6-3a1b-3652-8649-1d4b3b14816c",
                        "source_sense_id": "52a13e8d-2c6e-337c-bcca-68dadf8708c4",
                        "target_lang_word": "mutinerie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mutinerie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ab40c444-59c3-312f-b20e-328661aa4102",
                                        "entry_id": "da64a7f1-8a94-3d36-a80c-ae42151cae74",
                                        "glosses": [
                                            "Action de se mutiner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1dd6d4a9-c5d5-428f-b4c8-6d91a04eb99c",
                                                "sense_id": "ab40c444-59c3-312f-b20e-328661aa4102",
                                                "text": "Le 3 janvier 36 une mutinerie éclate à Turin dans un régiment alpin désigné pour l'embarquement."
                                            },
                                            {
                                                "example_id": "efecdebc-17f3-4a84-8985-624bc85d3925",
                                                "sense_id": "ab40c444-59c3-312f-b20e-328661aa4102",
                                                "text": "[…] ; le transfert de si nombreux colons les effrayait ; on exprima même des craintes au sujet d'une mutinerie possible parmi ces têtes brûlées. — (Nicolas Gogol, Les âmes mortes, 1842 ; traduction de Henri Mongault, 1949)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4822e8e4-4bfc-3c35-98dc-fb3ebd8dcf3c",
                                        "entry_id": "da64a7f1-8a94-3d36-a80c-ae42151cae74",
                                        "glosses": [
                                            "Indiscipline."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1703b0d5-980c-4ec9-b870-29bafb6e3ae5",
                                                "sense_id": "4822e8e4-4bfc-3c35-98dc-fb3ebd8dcf3c",
                                                "text": "Les mutineries de cet écolier sont insupportables."
                                            },
                                            {
                                                "example_id": "fef49c5a-1f99-4e7a-a4a3-d23035d552a0",
                                                "sense_id": "4822e8e4-4bfc-3c35-98dc-fb3ebd8dcf3c",
                                                "text": "La figure de cette dame, assise si inopinément sur le dos d’une Chronique de Nuremberg, exprimait une noblesse mélangée de mutinerie. Elle avait l’air d’une reine, mais d’une reine capricieuse."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
