                "senses": [
                    {
                        "sense_id": "0a27fcf7-81fd-3bd9-927f-2a65135ec055",
                        "entry_id": "199e3438-2fbc-32b6-a193-66846b6dc263",
                        "glosses": [
                            "Gegenstand, Gehalt, Substanz eines bestimmten Spiels"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a4c73eb6-dfa9-48f3-b02a-658d2d090eca",
                                "sense_id": "0a27fcf7-81fd-3bd9-927f-2a65135ec055",
                                "text": "„Kein Kind kann nämlich zum Spielen gezwungen werden, einerlei um welchen Spielinhalt es dabei geht.“"
                            },
                            {
                                "example_id": "7f41fb04-35a2-472d-9142-ec94ff15f8fb",
                                "sense_id": "0a27fcf7-81fd-3bd9-927f-2a65135ec055",
                                "text": "„Erzählen Kinder von ihrem Tageslauf, ihren Spielinhalten, interessierte es ihre Spielgefährten im Kindergarten des gleichen Ortes wenig.“"
                            },
                            {
                                "example_id": "ce959ea6-907b-4b0e-8310-16d1e0e1a416",
                                "sense_id": "0a27fcf7-81fd-3bd9-927f-2a65135ec055",
                                "text": "„Bei bestimmten Spielinhalten gehe es letztlich um die Aufforderung zur Gewaltanwendung gegen Menschen und menschenähnliche Wesen, betonte Monssen-Engberding.“"
                            },
                            {
                                "example_id": "49776c6d-6298-48cc-ac7c-961d79e7cc4f",
                                "sense_id": "0a27fcf7-81fd-3bd9-927f-2a65135ec055",
                                "text": "„Der Spielinhalt darf nicht gewalt- oder kriegsverherrlichend, rassendiskriminierend oder frauenverachtend sein (zum Beispiel Menschen mit einem Maschinengewehr vernichten oder einen Laserkrieg im Weltraum führen).“"
                            },
                            {
                                "example_id": "5f6afec2-cdde-4725-80e2-d0ead0aa744a",
                                "sense_id": "0a27fcf7-81fd-3bd9-927f-2a65135ec055",
                                "text": "„Die Wissenschaftlerin interessiert vor allem, welchen Einfluss die Spielinhalte auf unsere Träume haben.“"
                            },
                            {
                                "example_id": "6ac54a26-61d5-4c00-8ab4-a69f181c1d74",
                                "sense_id": "0a27fcf7-81fd-3bd9-927f-2a65135ec055",
                                "text": "„Es soll sein wie die Bezugsperson, ein hauptberuflich anwesender Pädagoge, der auf einem sich anschließenden Abenteuerspielplatz für die größeren Kinder beobachtet, Konsequenzen sozialen Verhaltens erklärt, Hilfestellung gibt, über Anregung von Spielinhalten bei Rollen- und Theaterspielen solidarisches Verhalten fördert, Zielvorstellungen zu verwirklichen hilft.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
