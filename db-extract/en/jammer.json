                                            {
                                                "example_id": "853fc848-474a-431c-8cae-e4aebb28795b",
                                                "sense_id": "c6a2b49c-3d53-3200-abec-b3335439d516",
                                                "text": "Illegale radiozenders die als stoorzender werken moeten hun uitzendingen staken."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "afc6a1dc-8fb2-3c9e-a16b-9d36451fa794",
                                        "entry_id": "b0f5db3d-3ea2-367b-80b4-33170406148f",
                                        "glosses": [
                                            "een hinderlijk persoon die de actie van een ander persoon verstoort"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e278eacf-9e09-428e-99b8-9ca092a82837",
                                                "sense_id": "afc6a1dc-8fb2-3c9e-a16b-9d36451fa794",
                                                "text": "Ik moest die vervelende stoorzender wel de klas uit sturen want anders kon ik niet lesgeven."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
