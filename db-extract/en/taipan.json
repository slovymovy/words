                                "example_id": "c34fc2b7-b44d-41ef-90a1-7207d7711e82",
                                "sense_id": "7606bfbf-2708-3d30-89f3-ec15953555a2",
                                "text": "The British taipans stood in one sodden circle with their womenfolk, like bored officers at a garrison get-together."
                            }
