                "senses": [
                    {
                        "sense_id": "9aafb210-324d-3c57-9ffe-9dcc5228fdb0",
                        "entry_id": "bd3810ba-6a08-320e-bbd3-1b442c9fff58",
                        "glosses": [
                            "Stadt im Südwesten von Südkorea"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d0302a33-3d9a-4b7c-87a3-584826ad33a0",
                                "sense_id": "9aafb210-324d-3c57-9ffe-9dcc5228fdb0",
                                "text": "„Die neuen KTX-Züge fahren seit Dienstag mit rund 300 km/h von der Hauptstadt Seoul nach Busan im Südosten und Gwangju im Südwesten des Landes, wie Korail mitteilte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6787307d-80e1-4351-b269-cd2b693c9043",
                        "source_entry_id": "bd3810ba-6a08-320e-bbd3-1b442c9fff58",
