                                    {
                                        "sense_id": "9c7192c0-1f59-3900-ab97-1bb8b6f5c5da",
                                        "entry_id": "5184fb49-9830-3d92-99de-853371be123b",
                                        "glosses": [
                                            "издать всхлип"
