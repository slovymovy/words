{
    "word_family": [
        "laired"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "225cccfd-e702-3cb6-87a0-14aea0940d4d",
                    "sense_definition": "A place inhabited by a wild animal, often a cave or a hole in the ground.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "animal_shelter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bear returned to its <w>lair</w> to sleep through the winter.",
                            "target_lang_translations": {
                                "de": "Der Bär kehrte in seine <w>Höhle</w> zurück, um den Winter zu verschlafen."
                            }
                        },
                        {
                            "text": "The hunter tracked the wolf to its hidden <w>lair</w> in the forest.",
                            "target_lang_translations": {
                                "de": "Der Jäger verfolgte den Wolf bis zu seinem versteckten <w>Bau</w> im Wald."
                            }
                        }
                    ],
                    "synonyms": [
                        "burrow",
                        "den",
                        "holt"
                    ],
                    "common_phrases": [
                        "animal lair"
                    ],
                    "target_lang_definitions": {
                        "de": "Ein von einem Wildtier bewohnter Ort, oft eine Höhle oder ein Erdloch."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Bau",
                                "target_lang_sense_clarification": "Ein in den Boden gegrabener Unterschlupf für Tiere wie Füchse oder Dachse."
                            },
                            {
                                "target_lang_word": "Höhle",
                                "target_lang_sense_clarification": "Ein natürlicher Hohlraum, der oft als Behausung für größere Tiere wie Bären dient."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a05ff5f1-8109-3cda-bd97-4b681d9791a3",
                    "sense_definition": "A place inhabited by a criminal, superhero, or supervillain; a secret hideaway.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "secret_hideout",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hero finally discovered the villain's secret <w>lair</w>.",
                            "target_lang_translations": {
                                "de": "Der Held entdeckte endlich das geheime <w>Versteck</w> des Bösewichts."
                            }
                        },
                        {
                            "text": "Police raided the criminal's <w>lair</w> after weeks of investigation.",
                            "target_lang_translations": {
                                "de": "Die Polizei stürmte nach wochenlangen Ermittlungen den <w>Unterschlupf</w> des Kriminellen."
                            }
                        }
                    ],
                    "synonyms": [
                        "den",
                        "hide-out"
                    ],
                    "common_phrases": [
                        "villain's lair"
                    ],
                    "target_lang_definitions": {
                        "de": "Ein geheimer Aufenthaltsort für Kriminelle, Superhelden oder Superschurken."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Versteck",
                                "target_lang_sense_clarification": "Ein geheimer Ort, an dem sich jemand verbirgt."
                            },
                            {
                                "target_lang_word": "Unterschlupf",
                                "target_lang_sense_clarification": "Ein Ort, der Schutz bietet, oft im kriminellen Kontext verwendet."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aeef85d0-7389-3e51-a14c-867807243a3b",
                    "sense_definition": "A grave or a cemetery plot.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "burial",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The family visited the old <w>lair</w> to pay their respects.",
                            "target_lang_translations": {
                                "de": "Die Familie besuchte die alte <w>Grabstätte</w>, um ihre Ehrerbietung zu erweisen."
                            }
                        },
                        {
                            "text": "He purchased a <w>lair</w> in the local cemetery for his parents.",
                            "target_lang_translations": {
                                "de": "Er kaufte eine <w>Grabstelle</w> auf dem örtlichen Friedhof für seine Eltern."
                            }
                        }
                    ],
                    "common_phrases": [
                        "cemetery lair"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Primarily used in Scotland."
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Ein Grab oder eine Grabstätte auf einem Friedhof."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Grabstätte",
                                "target_lang_sense_clarification": "Ein Ort, an dem Verstorbene beigesetzt sind."
                            },
                            {
                                "target_lang_word": "Familiengrab",
                                "target_lang_sense_clarification": "Eine Grabstelle, die für mehrere Familienmitglieder vorgesehen ist."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a29ed071-43f6-3669-ad83-e7dabc6de445",
                    "sense_definition": "An obsolete form of <w>layer</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient manuscript described a <w>lair</w> of dust covering the floor.",
                            "target_lang_translations": {
                                "de": "Das alte Manuskript beschrieb eine <w>Schicht</w> aus Staub, die den Boden bedeckte."
                            }
                        },
                        {
                            "text": "He applied a thin <w>lair</w> of paint to the wooden surface.",
                            "target_lang_translations": {
                                "de": "Er trug eine dünne <w>Schicht</w> Farbe auf die Holzoberfläche auf."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "This spelling is no longer in standard use."
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Eine veraltete Schreibweise für 'Schicht' (layer)."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Schicht",
                                "target_lang_sense_clarification": "Eine Lage oder Schicht von Material."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "138ed050-7765-3eee-9a60-2ddf6ef0f216",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The author of the article is named Mr. <w>Lair</w>.",
                            "target_lang_translations": {
                                "de": "Der Autor des Artikels heißt Herr <w>Lair</w>."
                            }
                        },
                        {
                            "text": "The <w>Lair</w> family has lived in this town for generations.",
                            "target_lang_translations": {
                                "de": "Die Familie <w>Lair</w> lebt seit Generationen in dieser Stadt."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Used as a family name."
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Ein Familienname."
                    },
                    "translations": {
                        "de": []
                    }
                }
            ]
        }
    ]
}