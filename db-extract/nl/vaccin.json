                "translations": [
                    {
                        "translation_id": "07cdcfd1-9a9d-415b-8adb-8538c3a925e8",
                        "source_entry_id": "26d18972-f793-3566-9f3d-53789bcfb2a4",
                        "source_sense_id": "11e2182f-22d3-356c-b562-760ecee69eb9",
                        "source_sense_description": "uit verzwakte ziekteverwekkers bestaande entstof om afweer op te bouwen",
                        "target_lang_word": "Impfstoff",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Impfstoff",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d3ceb780-4006-3855-b18f-c1a7a58fa641",
                                        "entry_id": "0d0714c2-8920-3ab7-b9ae-5323373f0f58",
                                        "glosses": [
                                            "Stoff, der dem Körper gegeben wird, um die Produktion von Antikörpern anzuregen und so eine Immunität gegen eine Krankheit zu erreichen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81388aee-5a0e-4da4-b0b5-ea99224e56f5",
                                                "sense_id": "d3ceb780-4006-3855-b18f-c1a7a58fa641",
                                                "text": "In einigen Gegenden Afrikas gibt es keine Kühlschränke, um den Impfstoff kühl zu halten."
                                            },
                                            {
                                                "example_id": "b98bffa5-55cd-4e00-a7b5-d7fc95741bf0",
                                                "sense_id": "d3ceb780-4006-3855-b18f-c1a7a58fa641",
                                                "text": "Impfstoffe können aus abgeschwächten oder abgetöteten Erregern hergestellt werden."
                                            },
                                            {
                                                "example_id": "4b385674-ffa3-4df5-8c8b-e3afa60f5362",
                                                "sense_id": "d3ceb780-4006-3855-b18f-c1a7a58fa641",
                                                "text": "[Coronapandmie 2022:] „»Man muss aber eindeutig festhalten: Gegen eine schwere Infektion und den Tod schützen die Impfstoffe absolut und nachhaltig – auch bei Omikron.«“"
                                            },
                                            {
                                                "example_id": "a9d10889-633e-4dd3-94c6-9353548d99fb",
                                                "sense_id": "d3ceb780-4006-3855-b18f-c1a7a58fa641",
                                                "text": "„Alltägliche Nahrungsmittel, die Impfstoffe oder andere medizinisch wirksame Zusatzstoffe enthalten, gibt es zwar noch nicht zu kaufen, sie sind aber schon Gegenstand der Forschung.“"
                                            },
                                            {
                                                "example_id": "0c690e20-c5e5-4a17-ba49-461ac2f9c4d1",
                                                "sense_id": "d3ceb780-4006-3855-b18f-c1a7a58fa641",
                                                "text": "„Er rief seinen Cousin Sandy Kuvin an, einen bekannten Arzt für Infektionskrankheiten, und ließ sich von ihm ausführlich erklären, wie Polio übertragen wird und wie es in der Zeit vor dem Impfstoff behandelt wurde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d6a08f38-db64-4a5a-be06-ba2a1a1402cf",
                        "source_entry_id": "26d18972-f793-3566-9f3d-53789bcfb2a4",
                        "source_sense_id": "11e2182f-22d3-356c-b562-760ecee69eb9",
                        "source_sense_description": "uit verzwakte ziekteverwekkers bestaande entstof om afweer op te bouwen",
                        "target_lang_word": "Vakzin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vakzin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "30a8792a-2b56-35cb-a455-4d3860523d9b",
                                        "entry_id": "71fb575e-bf71-3446-bcdb-0742c9c0522a",
                                        "glosses": [
                                            "Impfstoff, der einen Körper zur Bildung von Antikörpern anregt, das Immunsystem aktiviert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64fcac61-7181-4fcd-8873-a6b9f4eb0467",
                                                "sense_id": "30a8792a-2b56-35cb-a455-4d3860523d9b",
                                                "text": "„Ein weltweites Wettrennen zum Vakzin ist gestartet. Doch diesmal treten die beteiligten Firmen, Universitäten und Behörden mit ihren High-Tech-Methoden nicht gegeneinander an – sondern gemeinsam gegen Corona.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "75dfe778-47bc-4513-9a89-cc6b3350d60e",
                        "source_entry_id": "26d18972-f793-3566-9f3d-53789bcfb2a4",
                        "source_sense_id": "11e2182f-22d3-356c-b562-760ecee69eb9",
