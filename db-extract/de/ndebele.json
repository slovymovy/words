                "senses": [
                    {
                        "sense_id": "37301226-8dc6-3916-96e9-bede67cfaae0",
                        "entry_id": "aafffb7b-e8d4-381b-aff6-c3c6cde28163",
                        "glosses": [
                            "in Simbabwe (dort Amtssprache), Botsuana und Namibia gesprochene Nguni-Sprache"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "08fdb28b-02b1-4e96-8dc5-4e554a98b250",
                                "sense_id": "37301226-8dc6-3916-96e9-bede67cfaae0",
                                "text": "Außerdem zeichnet sich Ndebele durch Klicklaute aus."
                            },
                            {
                                "example_id": "830419cb-d085-4646-91b3-79473363131a",
                                "sense_id": "37301226-8dc6-3916-96e9-bede67cfaae0",
                                "text": "Ndebele hat geschätzte 4 Millionen, Shona etwa 10 Millionen Sprecher."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "49acb3fa-419c-3926-8672-8f430bf8297d",
                        "entry_id": "aafffb7b-e8d4-381b-aff6-c3c6cde28163",
                        "glosses": [
                            "in den südafrikanischen Provinzen Gauteng, Mpumalanga und Limpopo gesprochene Sotho-Tswana-Sprache"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8b42f10-0724-4d6e-a251-aa79c17954cc",
                                "sense_id": "49acb3fa-419c-3926-8672-8f430bf8297d",
                                "text": "Ndebele hat etwa 600.000 Muttersprachler, während es noch über eine weitere Million als Zweitsprache benutzen."
                            },
                            {
                                "example_id": "886c5334-7d57-4fc8-8f9f-037092cc635d",
                                "sense_id": "49acb3fa-419c-3926-8672-8f430bf8297d",
                                "text": "„Von da an zählen wir kleinere Sprachen wie Nord-Sotho, Tswana, Süd-Sotho, Tsonga, Tswati, Venda und Ndebele.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
