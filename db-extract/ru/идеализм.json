                                    {
                                        "sense_id": "c1d625ce-7180-32ba-ae13-553354746e94",
                                        "entry_id": "3849e21d-d9f8-3cf2-a575-f44834bac042",
                                        "glosses": [
                                            "streven naar een betere wereld"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eed21ef8-2378-4e25-8a19-fa7eb8f69685",
                                                "sense_id": "c1d625ce-7180-32ba-ae13-553354746e94",
                                                "text": "Uit idealisme een jaar vrijwilligerswerk doen in een ontwikkelingsland."
                                            },
                                            {
                                                "example_id": "9d4b08ea-0007-441c-a5dc-99440d3c0f59",
                                                "sense_id": "c1d625ce-7180-32ba-ae13-553354746e94",
                                                "text": "Zijn grote mond, iets te harde stem, irritante enthousiasme en overdreven positiviteit waren herkenbaar maar ook zijn ongepolijste bravoure, idealisme en romantische dromen om de wereld te verbeteren."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8a2fe52e-bf24-34c7-9342-272e4643ee22",
                                        "entry_id": "3849e21d-d9f8-3cf2-a575-f44834bac042",
                                        "glosses": [
                                            "systeem waarin de ideeën of grondbegrippen belangrijker dan de werkelijkheid worden beschouwd"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "957c9c80-9827-4302-a973-f6afb1e6544b",
                                                "sense_id": "8a2fe52e-bf24-34c7-9342-272e4643ee22",
                                                "text": "In hun idealisme ontkennen de pacifisten het gevaar van de autoritaire agressie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f0e19c7b-057c-4d19-8f7d-c7739552f02d",
                        "source_entry_id": "37512271-9be0-320f-9d23-2dbea4eebacf",
                        "target_lang_word": "idéalisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "idéalisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "941b055e-9b72-3214-9236-5138246edd7c",
                                        "entry_id": "5299c27d-835a-3219-aed4-8f21324a11c0",
                                        "glosses": [
                                            "Attitude de celui qui agit en fonction d’un idéal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "241ffe11-55b5-44e8-9049-af4f13ee7968",
                                                "sense_id": "941b055e-9b72-3214-9236-5138246edd7c",
                                                "text": "Élus et clientèle électorale formaient un bloc contre lequel l’idéalisme de Jacques venait se briser."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "02e35dbf-a9cd-394d-8709-c8e89e36e5f9",
                                        "entry_id": "5299c27d-835a-3219-aed4-8f21324a11c0",
                                        "glosses": [
                                            "Disposition d’esprit de celui qui ne prend pas en compte la réalité pour régler sa pensée ou son action."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "73f79f2f-03e7-406f-9a0d-ea5a96337bd0",
                                                "sense_id": "02e35dbf-a9cd-394d-8709-c8e89e36e5f9",
                                                "text": "Ce refus de contextualiser revient à pratiquer ce qu'on pourrait appeler un idéalisme moral dans le cadre duquel on saurait toujours avec certitude – et ce, quelle que soit la situation – où se situent le Bien, le Mal, le Juste."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e73a8ae-42e7-36e4-916c-0a0f71acda54",
                                        "entry_id": "5299c27d-835a-3219-aed4-8f21324a11c0",
                                        "glosses": [
                                            "Système philosophique qui considère les idées comme le principe de la connaissance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7fd7d643-9c44-4e40-ac0e-8bade45357e7",
                                                "sense_id": "1e73a8ae-42e7-36e4-916c-0a0f71acda54",
                                                "text": "Idéalisme subjectif, idéalisme de Kant, celui où l'on considère que la connaissance de l'essence et de la raison dernière des choses n'est possible que par les idées."
                                            },
                                            {
                                                "example_id": "34a04cad-fb03-443f-a993-b75025120168",
                                                "sense_id": "1e73a8ae-42e7-36e4-916c-0a0f71acda54",
                                                "text": "Ses ouvrages […] contiennent nombre de pensées inspirées par ce vaillant optimisme matérialiste et orientées contre l’agnosticisme , le relativisme et d'autres variétés d’idéalisme."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "736620f5-206d-3b2b-a74e-e0ff7d6f7522",
                                        "entry_id": "5299c27d-835a-3219-aed4-8f21324a11c0",
                                        "glosses": [
                                            "Se dit, par opposition au réalisme, de la doctrine selon laquelle l’art doit représenter l’idéal et non le réel."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a9206542-61df-34d5-a487-43d53c1fe2a2",
                                        "entry_id": "5299c27d-835a-3219-aed4-8f21324a11c0",
                                        "glosses": [
                                            "Fait de rendre idéale une œuvre, de lui faire atteindre l'idéal par l'emploi de procédés stylistiques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aabbe8eb-01ff-40f4-9fc8-5e4a31227cba",
                                                "sense_id": "a9206542-61df-34d5-a487-43d53c1fe2a2",
                                                "text": "Ce qu'on nomme figures, en poésie et éloquence, en est un exemple : ces figures, destinées à relever la pensée, à lui donner plus de force, de relief, d'intérêt, sont ce que j'appellerai des idéalismes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "415d74ed-1f1a-34e0-8032-f621034bf527",
                                        "entry_id": "5299c27d-835a-3219-aed4-8f21324a11c0",
                                        "glosses": [
                                            "Nom donné à un ensemble de théorie des relations internationales dans laquelle la conduite des États est soumise à l'existence de règles et valeurs communes supérieures à l'intérêt national et régissant leurs actions."
                                        ],
                                        "tags": [
                                            "Relations internationales"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
