                    {
                        "sense_id": "6672e752-e334-3496-a8a3-40acb735e8fd",
                        "entry_id": "ab50b0d3-e384-3d94-8a39-2d76981177f8",
                        "glosses": [
                            "Postsendung, die durch einen Eilboten zugestellt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "072d6ff2-5d1e-40d5-83b2-5b67fe783b28",
                                "sense_id": "6672e752-e334-3496-a8a3-40acb735e8fd",
                                "text": "Eine Eilsendung ist teurer, dafür allerdings schneller."
                            },
                            {
                                "example_id": "a0c71d72-18cb-4823-8afc-07c9d93ed6bb",
                                "sense_id": "6672e752-e334-3496-a8a3-40acb735e8fd",
                                "text": "„Es wurde sogar ein spezieller Nachgebührenstempel zu 4 Kronen angeschafft, um solche Eilsendungen nachzutaxieren, die wegen des entsprechenden Verlangens, aber ohne entsprechende Freimachung per Eilboten zugestellt wurden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
