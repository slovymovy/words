            {
                "entry_id": "39da2e76-4056-3a8a-a8fe-1b5e404182b2",
                "word": "catamaran",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "b2425c99-e007-4b1d-9e67-7ae3487f2772",
                        "entry_id": "39da2e76-4056-3a8a-a8fe-1b5e404182b2",
                        "tags": [
                            "plural"
