                "senses": [
                    {
                        "sense_id": "6cb8ce17-22de-3898-a771-f964082af543",
                        "entry_id": "771cd84e-5e02-3196-b6c7-9d041e6c0019",
                        "glosses": [
                            "jemand, der Videospiele ausschließlich oder bevorzugt auf einer Spielkonsole anstatt auf einem PC spielt"
                        ],
                        "tags": [
                            "Jargon"
                        ],
                        "examples": [
                            {
                                "example_id": "32b2f021-f59e-46d8-8774-7b44ba404785",
                                "sense_id": "6cb8ce17-22de-3898-a771-f964082af543",
                                "text": "„Egal ob Konsolero oder PCler: Ohne Grafikkarten läuft in der Industrie nichts. Keine schönen Bilder, keine Spiele, nichts.“"
                            },
                            {
                                "example_id": "76291071-41e8-472b-b4f1-09917dd205ca",
                                "sense_id": "6cb8ce17-22de-3898-a771-f964082af543",
                                "text": "„Die Konsoleros schielen immer gerne zu den PC-Spielern herüber. Warum? Weil die eben keine angeflanschten Premiumservices bezahlen müssen, um ihre Spiele mit anderen spielen zu dürfen.“"
                            },
                            {
                                "example_id": "b6259f49-589e-4242-9d87-1f540316ca6a",
                                "sense_id": "6cb8ce17-22de-3898-a771-f964082af543",
                                "text": "„Strategiespiele sind, ähnlich wie Berufssimulationen oder komplexe Militär-Simulationen und klassische Computer-Rollenspiele nach Vorbild von Baldur’s Gate, auf Konsole auch weiterhin Mangelware. Auf PC-Dauerbrenner wie Civilization, Arma oder gar […] XCOM 2 müssen Konsoleros nämlich verzichten.“"
                            },
                            {
                                "example_id": "227fec14-e9b9-494d-96e1-3b191c1a8cc9",
                                "sense_id": "6cb8ce17-22de-3898-a771-f964082af543",
                                "text": "„[…] Bei altgedienten PC-Spielern [rufen] klassische MS-DOS-Spiele genau dieselben Retro-Gefühle hervor als Uralt-Videospiele bei Konsoleros.“"
                            },
                            {
                                "example_id": "948da119-bc93-4666-a887-41b4df70cab6",
                                "sense_id": "6cb8ce17-22de-3898-a771-f964082af543",
                                "text": "„Mehr als eineinhalb Jahre – genau genommen satte 574 Tage – mussten PC-Spieler seit September 2013 ausharren, bis Rockstars Gangster-Epos ‚Grand Theft Auto 5‘ den Sprung von PS3 und Xbox 360 auf das heimische System schafft. […] Und während sich Konsoleros ordentlich in Los Santos austobten, stellte die Wartezeit selbst die geduldigsten Computerspieler vor echte Bewährungsproben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
