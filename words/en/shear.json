    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0d2b6ad4-4c22-3da4-9a53-266ffa1e99b6",
                    "sense_definition": "A large cutting tool similar to scissors.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "cutting_tool",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The gardener used heavy <w>shears</w> to trim the thick hedges.",
                            "target_lang_translations": {
                                "tr": "Bahçıvan kalın çitleri budamak için ağır bir <w>budama makası</w> kullandı."
                            }
                        },
                        {
                            "text": "Keep the <w>shears</w> in a safe place away from children.",
                            "target_lang_translations": {
                                "tr": "<w>Makası</w> çocuklardan uzak, güvenli bir yerde saklayın."
                            }
                        }
                    ],
                    "synonyms": [
                        "shears"
                    ],
                    "common_phrases": [
                        "garden shears"
                    ],
                    "target_lang_definitions": {
                        "tr": "Genellikle iki bıçaklı, büyük makas benzeri kesme aleti."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "makas",
                                "target_lang_sense_clarification": "Genel kesme aleti."
                            },
                            {
                                "target_lang_word": "budama makası",
                                "target_lang_sense_clarification": "Bahçe işlerinde kullanılan büyük makas."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0140397a-e74e-3bdb-a68e-9f663e7ddf97",
                    "sense_definition": "A large industrial machine used for cutting sheet metal.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "cutting_tool",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The factory installed a new hydraulic <w>shear</w> to process the steel plates.",
                            "target_lang_translations": {
                                "tr": "Fabrika, çelik levhaları işlemek için yeni bir hidrolik <w>giyotin makas</w> kurdu."
                            }
                        },
                        {
                            "text": "Operators must wear protective gear when working with the metal <w>shear</w>.",
                            "target_lang_translations": {
                                "tr": "Operatörler metal <w>kesme makinesi</w> ile çalışırken koruyucu ekipman giymelidir."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Metal levhaları kesmek için kullanılan büyük endüstriyel makine."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "giyotin makas",
                                "target_lang_sense_clarification": "Metal levhaları kesmek için kullanılan endüstriyel makine."
                            },
                            {
                                "target_lang_word": "sac kesme makinesi",
                                "target_lang_sense_clarification": "Endüstriyel metal kesme ekipmanı."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ec75923f-0b41-3b3c-9f65-76f6e8e799ac",
                    "sense_definition": "A sudden change in wind speed or direction at different altitudes.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "weather_phenomenon",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pilot warned passengers about potential wind <w>shear</w> during the landing.",
                            "target_lang_translations": {
                                "tr": "Pilot, iniş sırasında olası bir <w>rüzgar kırılması</w> konusunda yolcuları uyardı."
                            }
                        },
                        {
                            "text": "Severe wind <w>shear</w> can make it very difficult for planes to maintain stability.",
                            "target_lang_translations": {
                                "tr": "Şiddetli <w>rüzgar makası</w>, uçakların dengede kalmasını çok zorlaştırabilir."
                            }
                        }
                    ],
                    "common_phrases": [
                        "wind shear"
                    ],
                    "target_lang_definitions": {
                        "tr": "Farklı irtifalarda rüzgarın hız veya yönündeki ani değişim."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "rüzgar kırılması",
                                "target_lang_sense_clarification": "Meteorolojik terim olarak rüzgarın yön veya hız değiştirmesi."
                            },
                            {
                                "target_lang_word": "rüzgar makası",
                                "target_lang_sense_clarification": "Havacılıkta kullanılan rüzgar değişimi terimi."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "006c8b88-fe8f-3d7e-bd86-976bb1405c5b",
                    "sense_definition": "To cut the wool or fleece off an animal.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "cutting_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Farmers <w>shear</w> their sheep once a year in the spring.",
                            "target_lang_translations": {
                                "tr": "Çiftçiler koyunlarını yılda bir kez, ilkbaharda <w>kırkarlar</w>."
                            }
                        },
                        {
                            "text": "It takes a skilled worker to <w>shear</w> a llama without hurting the animal.",
                            "target_lang_translations": {
                                "tr": "Hayvana zarar vermeden bir lamayı <w>kırkmak</w> usta bir işçi gerektirir."
                            }
                        }
                    ],
                    "synonyms": [
                        "fleece#Verb"
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir hayvanın yününü veya tüyünü kesmek."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "kırkmak",
                                "target_lang_sense_clarification": "Koyun, keçi gibi hayvanların tüylerini kesmek."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "afc3e9e3-2ae6-3ef0-a139-2ab64544593a",
                    "sense_definition": "To break or separate suddenly due to excessive force.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "breaking_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heavy load caused the metal bolt to <w>shear</w> off completely.",
                            "target_lang_translations": {
                                "tr": "Ağır yük, metal cıvatanın tamamen <w>kopmasına</w> neden oldu."
                            }
                        },
                        {
                            "text": "If the pressure is too high, the connection will <w>shear</w> under the strain.",
                            "target_lang_translations": {
                                "tr": "Basınç çok yüksekse, bağlantı gerilim altında <w>kırılacaktır</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "shear off"
                    ],
                    "target_lang_definitions": {
                        "tr": "Aşırı kuvvet nedeniyle aniden kırılmak veya ayrılmak."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "kopmak",
                                "target_lang_sense_clarification": "Gerilim veya kuvvet altında aniden ayrılmak."
                            },
                            {
                                "target_lang_word": "kırılmak",
                                "target_lang_sense_clarification": "Basınç veya zorlama ile parçalanmak."
                            }
                        ]
                    }
                }
            ]
        },
