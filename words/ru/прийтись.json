{
    "word_family": [
        "приход",
        "приходить",
        "приходный",
        "прихожий"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "57180b63-07ec-361c-b1f0-f822a808776c",
                    "sense_definition": "Быть вынужденным сделать что-либо из-за обстоятельств.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "necessity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Нам <w>пришлось</w> уйти очень быстро из-за дождя.",
                            "target_lang_translations": {
                                "it": "Ci <w>è toccato</w> andarcene molto rapidamente a causa della pioggia."
                            }
                        },
                        {
                            "text": "Завтра мне <w>придётся</w> встать очень рано.",
                            "target_lang_translations": {
                                "it": "Domani <w>dovrò</w> alzarmi molto presto."
                            }
                        }
                    ],
                    "common_phrases": [
                        "пришлось уйти",
                        "придётся сделать"
                    ],
                    "target_lang_definitions": {
                        "it": "Essere costretto o trovarsi nella necessità di fare qualcosa a causa delle circostanze."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "dovere",
                                "target_lang_sense_clarification": "essere costretto da circostanze esterne"
                            },
                            {
                                "target_lang_word": "toccare",
                                "target_lang_sense_clarification": "in forma impersonale (toccare a qcn fare qc)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "42d5036e-7316-31f5-aa2f-6a8a1914e610",
                    "sense_definition": "Оказаться подходящим, приятным или уместным.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "suitability",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Это новое платье <w>пришлось</w> ей по вкусу.",
                            "target_lang_translations": {
                                "it": "Questo vestito nuovo le <w>è piaciuto</w> molto."
                            }
                        },
                        {
                            "text": "Ваш совет <w>пришёлся</w> очень кстати в этой ситуации.",
                            "target_lang_translations": {
                                "it": "Il vostro consiglio <w>è caduto a fagiolo</w> in questa situazione."
                            }
                        }
                    ],
                    "common_phrases": [
                        "прийтись по вкусу",
                        "прийтись кстати",
                        "прийтись по душе"
                    ],
                    "target_lang_definitions": {
                        "it": "Risultare gradito, adatto o opportuno."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "piacere",
                                "target_lang_sense_clarification": "risultare gradito o di proprio gusto"
                            },
                            {
                                "target_lang_word": "cadere a fagiolo",
                                "target_lang_sense_clarification": "giungere al momento opportuno"
                            },
                            {
                                "target_lang_word": "andare a genio",
                                "target_lang_sense_clarification": "essere gradito o conforme alle preferenze"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b8c09012-2e38-31a0-a69e-422f0cd8a7c6",
                    "sense_definition": "Совпасть по времени или месту с чем-либо.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "coincidence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Праздник <w>пришёлся</w> на выходной день.",
                            "target_lang_translations": {
                                "it": "La festa <w>è caduta</w> di giorno festivo."
                            }
                        },
                        {
                            "text": "Удар <w>пришёлся</w> точно в цель.",
                            "target_lang_translations": {
                                "it": "Il colpo <w>è andato</w> dritto al bersaglio."
                            }
                        }
                    ],
                    "common_phrases": [
                        "прийтись на"
                    ],
                    "target_lang_definitions": {
                        "it": "Coincidere nel tempo o nello spazio con qualcosa."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "cadere",
                                "target_lang_sense_clarification": "coincidere con una data o giorno"
                            },
                            {
                                "target_lang_word": "colpire",
                                "target_lang_sense_clarification": "arrivare esattamente su un punto o bersaglio"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1a11b9de-3b02-3e2c-bda9-3582dd652a88",
                    "sense_definition": "Использоваться в конструкциях, означающих «любой», «какой угодно» (без разбора).",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "indifference",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он ест всё, что <w>придётся</w>.",
                            "target_lang_translations": {
                                "it": "Mangia tutto quello che gli <w>capita</w>."
                            }
                        },
                        {
                            "text": "Они ночуют там, где <w>придётся</w>.",
                            "target_lang_translations": {
                                "it": "Pernottano dove <w>capita</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "где придётся",
                        "что придётся",
                        "как придётся"
                    ],
                    "target_lang_definitions": {
                        "it": "Usato in espressioni per indicare qualcosa di casuale, qualsiasi cosa senza distinzione."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "capitare",
                                "target_lang_sense_clarification": "in espressioni come 'quello che capita'"
                            },
                            {
                                "target_lang_word": "a caso",
                                "target_lang_sense_clarification": "senza un criterio preciso"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}