                ],
                "senses": [
                    {
                        "sense_id": "7b38ce09-d7b2-36ee-917e-9edf82643beb",
                        "entry_id": "3049f68d-cc50-3550-b6d0-f993e3acbe66",
                        "glosses": [
                            "człowiek chytry, przebiegły, często nieuczciwy"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "ad8a0305-7470-463b-ab0e-4894452e960a",
                                "sense_id": "7b38ce09-d7b2-36ee-917e-9edf82643beb",
                                "text": "Moglibyśmy także Holendrom posłać takich frantów, że dosyć na którego spojrzeć, żeby się złapać za kieszeń"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "553cdbd2-c702-3da4-9f40-3b189ee2b1e2",
                        "entry_id": "3049f68d-cc50-3550-b6d0-f993e3acbe66",
                        "glosses": [
                            "w dawnej Polsce: wędrowny komediant, błazen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f01ce5e0-8a09-4606-9b3e-95b222f6756a",
                                "sense_id": "553cdbd2-c702-3da4-9f40-3b189ee2b1e2",
                                "text": "Zewsząd przepędzany, stał się nasz autor wędrownym frantem, nowym sowizdrzałem"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "ac9c00df-1cda-3788-b996-db3a8331974b",
                        "entry_id": "3049f68d-cc50-3550-b6d0-f993e3acbe66",
                        "glosses": [
                            "człowiek dbający o wygląd i spędzający czas na hulankach"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "ffd8d784-1847-4450-92ed-3d8c939efb7a",
                                "sense_id": "ac9c00df-1cda-3788-b996-db3a8331974b",
                                "text": "I po chwili przyprowadził jej franta w modnym surducie, który nawet do jedzenia nie zdejmował rękawiczek"
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    },
                    {
                        "sense_id": "fb565782-a302-3e90-b14d-bc44049a536c",
                        "entry_id": "3049f68d-cc50-3550-b6d0-f993e3acbe66",
                        "glosses": [
                            "człowiek lubiący błaznować"
                        ],
                        "tags": [
                            "metaphoric",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "4f573634-0b92-4e46-9afa-d0157f0ffdea",
                                "sense_id": "fb565782-a302-3e90-b14d-bc44049a536c",
                                "text": "Ale jest to w naturze wieczne napomknienie, które w żarty frant kładzie"
                            }
                        ],
                        "sense_index_json": "\"1.4\""
                    }
                ],
