                    "sense_definition": "gebiedende wijs van <w>keveren</w>",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "keveren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Kever</w> niet zo tegen me als ik probeer te werken!.",
                            "target_lang_translations": {
                                "en": "Don't <w>nag</w> me like that when I'm trying to work!"
                            }
                        },
                        {
                            "text": "Houd op en <w>kever</w> onmiddellijk over iets anders.",
                            "target_lang_translations": {
                                "en": "Stop it and <w>chatter</w> about something else immediately."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "gebiedende wijs"
                        }
                    ],
                    "target_lang_definitions": {
