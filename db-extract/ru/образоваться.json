                "senses": [
                    {
                        "sense_id": "a46af152-54d8-3b6e-9bff-d03c9898725f",
                        "entry_id": "a66b7693-c054-3dae-b365-d57dbd83a7df",
                        "glosses": [
                            "получиться, возникнуть"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0e8d415-ffb4-48f5-a179-283692d3f557",
                                "sense_id": "a46af152-54d8-3b6e-9bff-d03c9898725f",
                                "text": "В горах образовались трещины."
                            },
                            {
                                "example_id": "95aa8a8b-6ffd-4f60-84fd-21f851fbeb05",
                                "sense_id": "a46af152-54d8-3b6e-9bff-d03c9898725f",
                                "text": "На лбу образовалась страдальческая морщина."
                            },
                            {
                                "example_id": "28db1fdf-eea4-4327-9512-df0294a91f31",
                                "sense_id": "a46af152-54d8-3b6e-9bff-d03c9898725f",
                                "text": "Гений образуется из соединения глубокого разума с сильным рассудком."
                            }
                        ]
                    },
                    {
                        "sense_id": "abfa7c8a-dce1-341c-8871-fe66e39b7490",
                        "entry_id": "a66b7693-c054-3dae-b365-d57dbd83a7df",
                        "glosses": [
                            "сформироваться, составиться, организоваться"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a13cc046-41a3-4ed8-b62b-035528efbd73",
                                "sense_id": "abfa7c8a-dce1-341c-8871-fe66e39b7490",
                                "text": "Новая школа французских историков образовалась под влиянием шотландского романиста."
                            }
                        ]
                    },
                    {
                        "sense_id": "60e86ced-a277-3957-b6f4-9c2864e4c1bc",
                        "entry_id": "a66b7693-c054-3dae-b365-d57dbd83a7df",
                        "glosses": [
                            "разг. устроиться благополучно, уладиться, обойтись"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b9a1781-3e9d-43b8-9d0f-cef82bf304f2",
                                "sense_id": "60e86ced-a277-3957-b6f4-9c2864e4c1bc",
                                "text": "Это, я думаю, само собой уладится, или, как говорит лакей у Толстого, образуется."
                            }
                        ]
                    },
                    {
                        "sense_id": "d244e68a-a2b2-32c2-964f-a99f75bb2714",
                        "entry_id": "a66b7693-c054-3dae-b365-d57dbd83a7df",
                        "glosses": [
                            "разг. получить образование, научиться чему-нибудь"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "36a717ba-f59a-4bed-9a0f-4480e8faad05",
                                "sense_id": "d244e68a-a2b2-32c2-964f-a99f75bb2714",
                                "text": "Он… захотел образоваться."
                            }
                        ]
                    }
