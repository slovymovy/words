                "senses": [
                    {
                        "sense_id": "4e18dfac-552f-3662-a9cf-51574b918ffe",
                        "entry_id": "b300fb5e-8f4f-3984-a443-4b0a1fae928a",
                        "glosses": [
                            "steuer- und wirtschaftspolitisches Gremium der Europäischen Union, das die Staaten der Eurozone betrifft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8eb5e45b-68b0-406d-b68e-c759ee137f88",
                                "sense_id": "4e18dfac-552f-3662-a9cf-51574b918ffe",
                                "text": "„Haben sich die Griechen im Schuldenstreit selbst sabotiert? Die Euro-Gruppe vertagt weitere Beratungen, erst wird das Referendum abgewartet. Grund ist auch die Kampfrede von Ministerpräsident Tsipras.“"
                            },
                            {
                                "example_id": "421a1532-bcab-4dda-a089-6431f942cb4a",
                                "sense_id": "4e18dfac-552f-3662-a9cf-51574b918ffe",
                                "text": "„Was die Euro-Gruppe tun werde, wenn das griechische Volk in einem Referendum für den Vorschlag der Gläubigerinstitutionen anzunehmen, beantwortete Dijsselbloem zunächst mit dem Hinweis, er spekuliere nicht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
