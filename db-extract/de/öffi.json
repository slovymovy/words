                ],
                "translations": [
                    {
                        "translation_id": "94ea93a2-d40e-4419-b870-dcb944cd0b6e",
                        "source_entry_id": "223fa6f6-5868-3a60-89b0-bf6a12c8037d",
                        "source_sense_id": "bf631bf9-a00d-31a3-a3ac-2ded96c251a8",
                        "target_lang_word": "public transport",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "public transport",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5323d932-dfd0-35ac-8798-ca38dfbc1f96",
                                        "entry_id": "0c0f49a0-14ed-315e-8b79-4753a4b48f10",
                                        "glosses": [
                                            "Any form of transport that can be used by a member of public (who usually pays a fare); as opposed to private ownership of e.g. cars."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "New-Zealand",
                                            "UK",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "05f13bca-2321-4899-93d5-da1ddcd50d33",
                                                "sense_id": "5323d932-dfd0-35ac-8798-ca38dfbc1f96",
                                                "text": "Nevertheless, China’s investment in subway systems is overwhelmingly positive. And there are also encouraging signs, too, that Chinese cities are beginning to shape urban development around public transport hubs. For example, Tiantongyuan, a high-density community of giant housing blocks in the suburbs of northern Beijing, has three subway stations."
                                            },
                                            {
                                                "example_id": "b977fa4a-7e8d-4b6d-a0a0-98ac1dacaa66",
                                                "sense_id": "5323d932-dfd0-35ac-8798-ca38dfbc1f96",
                                                "text": "The Airports National Policy Statement objectives require the proportion of journeys made to the airport by passengers to be at least 50% by public transport by 2030 and 55% by 2040."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0820187f-bea0-4b8a-b01d-99cb10552d6a",
                        "source_entry_id": "223fa6f6-5868-3a60-89b0-bf6a12c8037d",
                        "source_sense_id": "bf631bf9-a00d-31a3-a3ac-2ded96c251a8",
                        "target_lang_word": "transport en commun",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "transport en commun",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "910f370c-7db0-33d7-af54-3346cdcc1dfb",
                                        "entry_id": "a7dd5480-9c68-3264-a128-7c4e5dc835be",
                                        "glosses": [
                                            "Système adapté au transport simultané de plusieurs personnes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a4e8fe1-9757-4a89-aa57-27080d4c1e79",
                                                "sense_id": "910f370c-7db0-33d7-af54-3346cdcc1dfb",
                                                "text": "Le bus, le métro ou encore le tramway sont des transports en commun."
                                            },
                                            {
                                                "example_id": "8d4d01b1-4a08-47b5-99f9-01d6a274e7ef",
                                                "sense_id": "910f370c-7db0-33d7-af54-3346cdcc1dfb",
                                                "text": "Face à cette situation, 5 % des Franciliennes ont arrêté de prendre les transports en commun."
                                            },
                                            {
                                                "example_id": "32293aac-8159-4c7e-a584-f979a9ab1181",
                                                "sense_id": "910f370c-7db0-33d7-af54-3346cdcc1dfb",
                                                "text": "On a vu de grandes compagnies établir des services de transport en commun sur toutes les principales routes de France, et s’y créer un monopole de fait par un moyen fort simple."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
