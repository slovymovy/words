                        ],
                        "form": "der Christianismus"
                    },
                    {
                        "form_id": "38f5d9da-ce5b-4cf5-b183-45065c562a93",
                        "entry_id": "193e20b3-bbd9-3663-af65-c09b36697aa7",
                        "tags": [
