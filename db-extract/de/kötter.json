                ],
                "senses": [
                    {
                        "sense_id": "58f2c5b1-214c-31c7-9d1d-2dd8459a73a9",
                        "entry_id": "f0a04f94-57dc-387a-89a2-79240c7ef87b",
                        "glosses": [
                            "Inhaber einer Kote (kleinen Hütte)"
                        ],
                        "tags": [
                            "North German"
                        ],
                        "examples": [
                            {
                                "example_id": "0f6a7220-3d66-40e6-8b77-e1d6ccea5cae",
                                "sense_id": "58f2c5b1-214c-31c7-9d1d-2dd8459a73a9",
                                "text": "„Ist endlich das dem Kötter zur Miethe übergebene Land zu bearbeiten, so geschieht dieß abermals mit dem Pfluge des Bauern.“"
                            },
                            {
                                "example_id": "244c8188-367b-4ad7-99e0-e6f24db8d3b8",
                                "sense_id": "58f2c5b1-214c-31c7-9d1d-2dd8459a73a9",
                                "text": "Der Ackerbesitz des Kötters, „mochte er auch 30 Morgen und mehr umfassen, war der Flurverfassung nicht als Hufe bekannt, sondern als unbenanntes, zufälliges Konglomerat von einzelnen Ackerstücken.[…]“"
                            },
                            {
                                "example_id": "d261d84b-d8f4-43ed-9bc5-c69d4708d8ce",
                                "sense_id": "58f2c5b1-214c-31c7-9d1d-2dd8459a73a9",
                                "text": "Ein Beispiel für eine aufwendige Fleischhochzeit war die in Moese bei Mastholte veranstalte Gebehochzeit des Kötters Josef Küstersteffen zu Mastholte (StA Rietberg - Amt Rietberg B 2832)."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d4a4d4dd-29e4-4e08-b1f3-71cc73f17053",
                        "source_entry_id": "f0a04f94-57dc-387a-89a2-79240c7ef87b",
                        "source_sense_id": "58f2c5b1-214c-31c7-9d1d-2dd8459a73a9",
                        "source_sense_description": "norddeutsch: Inhaber einer Kote (kleinen Hütte)",
                        "target_lang_word": "cottager",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cottager",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "db00faa4-84fa-3e77-9dae-399f7a61f80c",
                                        "entry_id": "affd3d6a-0a13-3453-bf19-187cfc591329",
                                        "glosses": [
                                            "A person who has the tenure of a cottage, usually also the occupant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82f32f56-7f06-4b32-a7b5-e2606d56897b",
                                                "sense_id": "db00faa4-84fa-3e77-9dae-399f7a61f80c",
                                                "text": "The silver hair and benevolent countenance of the aged cottager, won my reverence; while the gentle manners of the girl enticed my love."
                                            },
                                            {
                                                "example_id": "cf51313c-e7fe-4626-93a6-ce11594c0c25",
                                                "sense_id": "db00faa4-84fa-3e77-9dae-399f7a61f80c",
                                                "text": "A cottager, I mark’d a throne\nOf half the world as all my own,\nAnd murmur’d at such lowly lot!"
                                            },
                                            {
                                                "example_id": "5388f680-7289-4961-b3d3-84d6718c19ba",
                                                "sense_id": "db00faa4-84fa-3e77-9dae-399f7a61f80c",
                                                "text": "I don't like shoppy people. I think we are far better off, knowing only cottagers and labourers, and people without pretence."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "cottager",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "eb52e9c9-7c2b-3c8c-90b5-e814f93ac559",
                                        "entry_id": "9e7fd6be-cc11-32ed-a785-4b974b091466",
                                        "glosses": [
                                            "One who engages in sex in public lavatories; a practitioner of cottaging."
                                        ],
                                        "tags": [
                                            "British",
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
