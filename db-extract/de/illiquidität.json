                "senses": [
                    {
                        "sense_id": "f5f58094-cc88-3b1c-9e17-193fe7f8228d",
                        "entry_id": "c3cd15c7-4ffc-3c44-8c07-4a2660952df9",
                        "glosses": [
                            "Tatsache, dass (zur Zeit) kein Geld (keine liquiden Mittel) zum Bedienen/Bezahlen von Forderungen/Rechnungen vorhanden ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5cb71c6b-7761-4df9-b2e8-cb9ebbfd87c0",
                                "sense_id": "f5f58094-cc88-3b1c-9e17-193fe7f8228d",
                                "text": "„Als Gegenteil zur Liquidität bezeichnet Illiquidität den Zustand eines Unternehmens, seine Zahlungsverpflichtungen nicht mehr dauerhaft erfüllen zu können.“"
                            },
                            {
                                "example_id": "c2ff6b67-7f91-4761-9796-9bc8259a1531",
                                "sense_id": "f5f58094-cc88-3b1c-9e17-193fe7f8228d",
                                "text": "„Bei einem illiquiden Unternehmen kommt es entscheidend darauf an, ob es sich um eine vorübergehende oder eine strukturelle Illiquidität handelt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
