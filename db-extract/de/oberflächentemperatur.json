                "senses": [
                    {
                        "sense_id": "0d14af5a-2924-34aa-8f66-4aa01351aea0",
                        "entry_id": "a726703b-2343-3ab6-b247-2dc69fb5fe97",
                        "glosses": [
                            "Temperatur eines Körpers an dessen Oberfläche; die von außen sichtbare oder messbare Temperatur in Bezug auf die Wärmestrahlung eines Körpers"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ee15d35-05ed-4b93-a42e-cbed7d9a4918",
                                "sense_id": "0d14af5a-2924-34aa-8f66-4aa01351aea0",
                                "text": "„Mit Hilfe des Stefan-Boltzmannschen Gesetzes kann man die Oberflächentemperatur eines heißen Körpers bestimmen, indem man die von ihm ausgehende Strahlung misst. So lässt sich z. B. die Temperatur von geschmolzenem Metall berührungsfrei messen oder die Oberflächentemperatur der Sonne bestimmen.“"
                            },
                            {
                                "example_id": "6e698f26-e77e-46c5-a330-261087507ce4",
                                "sense_id": "0d14af5a-2924-34aa-8f66-4aa01351aea0",
                                "text": "„Im Bereich von Wärmebrücken sinkt bei niedrigen Außentemperaturen die raumseitige Oberflächentemperatur von Bauteilen stärker ab als in den ‚Normalbereichen‘.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
