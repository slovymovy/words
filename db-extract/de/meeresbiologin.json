                "senses": [
                    {
                        "sense_id": "43a48b02-d9f0-3b87-828c-db0237f0577c",
                        "entry_id": "da94f076-f5b6-3874-98b5-d9a52dc106e0",
                        "glosses": [
                            "Wissenschaftlerin, die sich mit der Erforschung der Lebewesen und Lebensvorgänge in Meeren und Ozeanen beschäftigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f58a4dd3-0682-4f48-ad73-8f73770b53ce",
                                "sense_id": "43a48b02-d9f0-3b87-828c-db0237f0577c",
                                "text": "„In Exmouth, am neun Autostunden entfernten Nordkap der Korallenküste, bricht am frühen Morgen die junge Meeresbiologin Jackie Brown zum Ningaloo-Riff auf.“"
                            },
                            {
                                "example_id": "e3eec765-49f2-4658-a872-51fe80aa11ef",
                                "sense_id": "43a48b02-d9f0-3b87-828c-db0237f0577c",
                                "text": "„\"Wir waren sehr überrascht, wie weit sich unser Müll in den Meeren schon verbreitet hat\", erklärt Melanie Bergmann, Meeresbiologin am AWI.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
