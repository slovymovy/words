{
    "word_family": [
        "schemeren",
        "schemering",
        "doorschemering"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a2efcae9-65c2-3bb8-9a96-c727fc662726",
                    "sense_definition": "Samen met het werkwoord 'laten': indirect of subtiel kenbaar maken; iets laten doorschemeren.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "figuurlijk_doorschemeren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De directeur <w>liet</w> zijn te nemen beslissing <w>doorschemeren</w> aan zijn naaste medewerkers.",
                            "target_lang_translations": {
                                "en": "The director <w>hinted at</w> his upcoming decision to his closest associates."
                            }
                        },
                        {
                            "text": "Zonder het direct te zeggen, <w>liet</w> zij haar ontevredenheid duidelijk <w>doorschemeren</w> tijdens het gesprek.",
                            "target_lang_translations": {
                                "en": "Without saying it directly, she clearly <w>let</w> her dissatisfaction <w>show through</w> during the conversation."
                            }
                        }
                    ],
                    "synonyms": [
                        "suggereren",
                        "insinueren",
                        "doorschemeren"
                    ],
                    "common_phrases": [
                        "laten doorschemeren"
                    ],
                    "target_lang_definitions": {
                        "en": "To let something be known indirectly or subtly; to hint at or imply something."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "hint",
                                "target_lang_sense_clarification": "to suggest or imply something indirectly"
                            },
                            {
                                "target_lang_word": "let slip",
                                "target_lang_sense_clarification": "to reveal a secret or plan unintentionally or subtly"
                            },
                            {
                                "target_lang_word": "intimate",
                                "target_lang_sense_clarification": "to state or make known subtly or indirectly"
                            },
                            {
                                "target_lang_word": "imply",
                                "target_lang_sense_clarification": "to suggest something without stating it directly"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "74f95d40-9d4c-34e2-bbac-caefe1291f1e",
                    "sense_definition": "Zwak of vaag zichtbaar zijn door iets anders heen.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "letterlijk_doorschemeren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De omtrekken van het schip <w>schemerden</w> door de mist heen.",
                            "target_lang_translations": {
                                "en": "The outlines of the ship <w>loomed</w> through the fog."
                            }
                        },
                        {
                            "text": "Het zachte ochtendlicht begon al door de dunne gordijnen heen te <w>doorschemeren</w>.",
                            "target_lang_translations": {
                                "en": "The soft morning light was already starting to <w>shine through</w> the thin curtains."
                            }
                        }
                    ],
                    "synonyms": [
                        "doorschijnen"
                    ],
                    "common_phrases": [
                        "door de mist doorschemeren"
                    ],
                    "target_lang_definitions": {
                        "en": "To shine through or be faintly visible through something else."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "shine through",
                                "target_lang_sense_clarification": "to be visible through a semi-transparent barrier"
                            },
                            {
                                "target_lang_word": "glimmer through",
                                "target_lang_sense_clarification": "to shine faintly through something"
                            },
                            {
                                "target_lang_word": "show through",
                                "target_lang_sense_clarification": "to be visible through a layer or mist"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}