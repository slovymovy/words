                    {
                        "translation_id": "cb5806cc-b213-4477-b359-8e8bc050b519",
                        "source_entry_id": "c9efe1a3-3f93-3402-89a1-6e732170e1a6",
                        "source_sense_description": "intoxicating agent",
                        "target_lang_word": "Rauschmittel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rauschmittel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6d2d860a-c964-32c1-b137-c3080d63e3c9",
                                        "entry_id": "7cf01feb-7f2c-3283-8f2f-ff719a78d5ee",
                                        "glosses": [
                                            "Sammelbezeichnung für Stoffe, die einen Rausch verursachen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea49851c-38f0-4464-9858-452acc175d24",
                                                "sense_id": "6d2d860a-c964-32c1-b137-c3080d63e3c9",
                                                "text": "Die meisten Rauschmittel werden in Deutschland im Betäubungsmittelgesetz geregelt."
                                            },
                                            {
                                                "example_id": "5558d958-1683-4f2e-b1fb-0037e2a9dc9a",
                                                "sense_id": "6d2d860a-c964-32c1-b137-c3080d63e3c9",
                                                "text": "Auch gesetzlich erlaubte Rauschmittel, wie zum Beispiel der Alkohol, sind letztlich Drogen und schaden der Gesundheit."
                                            },
                                            {
                                                "example_id": "5164878a-734b-40e4-8bce-67c70a8d65ac",
                                                "sense_id": "6d2d860a-c964-32c1-b137-c3080d63e3c9",
                                                "text": "Mancherorts ist es nicht strafbar Rauschmittel zu konsumieren, aber der gewerbsmäßige Handel damit ist es in jedem Fall."
                                            },
                                            {
                                                "example_id": "c7d2c97e-d5d6-4dbe-b281-13850aabd9f4",
                                                "sense_id": "6d2d860a-c964-32c1-b137-c3080d63e3c9",
                                                "text": "»Legal highs«, also legale Rauschmittel, sind zum Beispiel die Naturdrogen Tollkirsche, Stechapfel und Fliegenpilz."
                                            },
                                            {
                                                "example_id": "ed2ee703-a831-49f5-951a-76711cffb5c1",
                                                "sense_id": "6d2d860a-c964-32c1-b137-c3080d63e3c9",
                                                "text": "Der Zoll beschlagnahmte 30 kg Rauschmittel."
                                            },
                                            {
                                                "example_id": "be266fc9-9309-4dd9-8448-2b68953f4c7c",
                                                "sense_id": "6d2d860a-c964-32c1-b137-c3080d63e3c9",
                                                "text": "„Die Tutanchamun mit in den Sarg gegebenen Alraunenfrüchte waren als Rauschmittel und Aphrodisiakum gedacht.“"
                                            },
                                            {
                                                "example_id": "72ba72e2-3534-46fc-b6a1-d28a4713c557",
                                                "sense_id": "6d2d860a-c964-32c1-b137-c3080d63e3c9",
                                                "text": "„Er mimt, jedenfalls mir gegenüber, den asketischen Anachoreten, dem du weder mit alkoholischen Getränken noch mit anderen Rauschmitteln kommen kannst, und erst recht nicht mit oszönen Texten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
