                            {
                                "example_id": "7c4620e8-84c3-4dc7-9442-5f0edc7e0fd5",
                                "sense_id": "727efa4e-aaf2-3e1c-9e32-baed7f562b68",
                                "text": "в тесноте́, да не в оби́де",
                                "translation": "the more the merrier",
                                "english": "the more the merrier"
                            },
                            {
                                "example_id": "028f6b43-21aa-46f9-807f-7fb3738c6b83",
                                "sense_id": "727efa4e-aaf2-3e1c-9e32-baed7f562b68",
                                "text": "Украша́ли ёлку все вме́сте. Поэ́тому бы́ло те́сно, и и́з-за тесноты́ Ни́на умудри́лась разби́ть два ша́рика.",
                                "translation": "They all decorated the New Year's tree together. So they were crowded, and because of the crowding, Nina managed to smash two balls.",
                                "english": "They all decorated the New Year's tree together. So they were crowded, and because of the crowding, Nina managed to smash two balls."
                            }
                        ]
                    }
