                },
                {
                    "sense_id": "5f118b47-f90e-319d-93f9-d93fbf7f8775",
                    "sense_definition": "Widespread fighting.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_harm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government is trying to stop the <w>violence</w> between the rebel groups.",
