                            {
                                "target_lang_word": "равный",
                                "target_lang_sense_clarification": "по силам"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "wyrównany",
                                "target_lang_sense_clarification": "o walce, wyniku"
                            },
                            {
                                "target_lang_word": "zacięty",
                                "target_lang_sense_clarification": "o rywalizacji"
                            }
