                    {
                        "sense_id": "0f07f61c-3933-3837-96d9-75f66e94ab68",
                        "entry_id": "a3332060-8f67-3244-9521-229738f0025a",
                        "glosses": [
                            "Of, pertaining to, or characteristic of hippopotamuses; large, rotund, indulgent."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "47aee4e6-fbc9-42a9-8e35-71cd0976b871",
                                "sense_id": "0f07f61c-3933-3837-96d9-75f66e94ab68",
                                "text": "The baby animal trotted cheerfully around the grassy enclosure, adorable in her hippopotamine rotundness."
                            },
                            {
                                "example_id": "5b398660-d6a2-409f-9b86-3ae09ba0055c",
                                "sense_id": "0f07f61c-3933-3837-96d9-75f66e94ab68",
                                "text": "It is thus evident that about thirty years is the extreme limit of Hippopotamine existence..."
                            },
                            {
                                "example_id": "89f7f0a9-8fc5-4382-b810-8c838bc8d279",
                                "sense_id": "0f07f61c-3933-3837-96d9-75f66e94ab68",
                                "text": "Meanwhile, the wonderful series of hippopotamine remains from the Val d'Arno was attracting more attention..."
                            },
                            {
                                "example_id": "242803a6-87a7-4a7a-91d8-31b2c2040f43",
                                "sense_id": "0f07f61c-3933-3837-96d9-75f66e94ab68",
                                "text": "Away on a hilltop sat combing her hair/His fair Hippopotamine maid..."
                            },
                            {
                                "example_id": "23610343-0760-46d3-8571-9a6fa0ca37e9",
                                "sense_id": "0f07f61c-3933-3837-96d9-75f66e94ab68",
                                "text": "But most important, a dinner of hippopotamine dimensions, portions you can wallow in, can be had, if you're cautious, for $9.50..."
                            },
                            {
                                "example_id": "4dea3654-99fc-4a8f-b50a-8f98b7b3af2c",
                                "sense_id": "0f07f61c-3933-3837-96d9-75f66e94ab68",
                                "text": "Fragmentary remains of a relatively small hippopotamine species referred to as imaguncula have been reported from the Western Rift of Uganda..."
                            },
                            {
                                "example_id": "101eafd9-4d9a-4ff2-a166-74e698a9ea11",
                                "sense_id": "0f07f61c-3933-3837-96d9-75f66e94ab68",
                                "text": "Taweret was a protector of women during pregnancy and childbirth, and of young children. This hippopotamine association derived from the well-known phenomenon of fearless female hippopotamuses protecting their young."
                            }
                        ]
                    }
