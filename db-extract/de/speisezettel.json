                    },
                    {
                        "translation_id": "5982373a-047a-4b33-8580-1aa24d880d3d",
                        "source_entry_id": "7344a194-ea46-39ea-9c07-132bdeeabe8d",
                        "source_sense_id": "964939e3-b77b-3d7b-9d0c-2307e188e41c",
                        "source_sense_description": "Liste für geplante Speisen",
                        "target_lang_word": "menu",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "menu",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0d068f39-fb64-3dfc-bbcd-f860c4c8384a",
                                        "entry_id": "2a65abf6-9f7c-3b56-bec7-7e0bc375cfa2",
                                        "glosses": [
                                            "Qui est délié, qui a peu de volume, peu de grosseur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "089f280b-fce8-4bd0-9342-010e0cbfb872",
                                                "sense_id": "0d068f39-fb64-3dfc-bbcd-f860c4c8384a",
                                                "text": "C’était un jeune chat, menu et décharné, qui frottait sa tête contre les jambes de Bert, en ronronnant."
                                            },
                                            {
                                                "example_id": "2c5e97e2-8acb-475b-b8e1-f38147a8d9e8",
                                                "sense_id": "0d068f39-fb64-3dfc-bbcd-f860c4c8384a",
                                                "text": "Le lendemain de cette soirée où Léonora Galigaï vint consulter Lorenzo, le nain se promenait à pas menus dans sa boutique du rez-de-chaussée."
                                            },
                                            {
                                                "example_id": "bff2b584-6bb4-4bd0-9987-e1ae292389c1",
                                                "sense_id": "0d068f39-fb64-3dfc-bbcd-f860c4c8384a",
                                                "text": "Les aliments détaillés en menus morceaux sont sautés très rapidement avec très peu de matière grasse dans un récipient hémisphérique placé sur un brûleur très puissant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ae512d1d-b835-3ca4-9bfa-ab7a6c309a64",
                                        "entry_id": "2a65abf6-9f7c-3b56-bec7-7e0bc375cfa2",
                                        "glosses": [
                                            "Qui est de peu d’importance."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2d329f6-53f8-4bf2-bf00-7a240db68b7c",
                                                "sense_id": "ae512d1d-b835-3ca4-9bfa-ab7a6c309a64",
                                                "text": "Il s’allongea de nouveau, s’ingéniant […] à stipuler divers menus legs, avec des codicilles de plus en plus fantasques et extravagants…."
                                            },
                                            {
                                                "example_id": "5e5e2b15-a98e-4819-a0f6-17dae4b727a0",
                                                "sense_id": "ae512d1d-b835-3ca4-9bfa-ab7a6c309a64",
                                                "text": "Très curieux de son naturel, il était toujours informé avant quiconque des menus potins du pays et n'avait pas son pareil pour les répandre et les amplifier."
                                            },
                                            {
                                                "example_id": "e3c0c8f4-177e-4ae4-90f0-42eb52f1193f",
                                                "sense_id": "ae512d1d-b835-3ca4-9bfa-ab7a6c309a64",
                                                "text": "[…], et il est très adroit aux menus travaux du campement : montage des tentes, pansage des bêtes, construction d'un four, etc."
                                            },
                                            {
                                                "example_id": "76a60df5-aee6-4a33-a069-2644209b1d68",
                                                "sense_id": "ae512d1d-b835-3ca4-9bfa-ab7a6c309a64",
                                                "text": "Je me résignai donc à imiter les autres visiteurs en engageant, pour quelques menues pièces, un jeune adolescent qui s’occuperait de m’éventer et d’écarter les insectes."
                                            },
                                            {
                                                "example_id": "fe1dcb2a-95bd-4ad1-ac22-79878f504992",
                                                "sense_id": "ae512d1d-b835-3ca4-9bfa-ab7a6c309a64",
                                                "text": "« Loue chambre prix modeste contre menus services », disait l’annonce, puisqu’elle s’exprimait très bien dans un ton assez désuet."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "menu",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "21dd750a-67e7-3fbb-aaae-d31a630a6f5c",
                                        "entry_id": "69813caf-cf67-35fb-adda-b39bf81fb951",
                                        "glosses": [
                                            "Chose petite, de détail."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1573d318-2c3f-4ab5-982d-9e579ee2645c",
                                                "sense_id": "21dd750a-67e7-3fbb-aaae-d31a630a6f5c",
                                                "text": "Compter par le menu, Avec un grand détail."
                                            },
                                            {
                                                "example_id": "4e257737-3019-4590-acf3-28feb7b29e8a",
                                                "sense_id": "21dd750a-67e7-3fbb-aaae-d31a630a6f5c",
                                                "text": "Je vous dirai, je vous raconterai, je vous expliquerai la chose par le menu."
                                            },
                                            {
                                                "example_id": "c3bbc696-d3c5-4335-8e4c-184e4b54d0a9",
                                                "sense_id": "21dd750a-67e7-3fbb-aaae-d31a630a6f5c",
                                                "text": "Vous saurez tout par le menu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e909bf41-b4c7-38bd-840a-b2e3c27c2af8",
                                        "entry_id": "69813caf-cf67-35fb-adda-b39bf81fb951",
                                        "glosses": [
                                            "Ensemble des mets qui composent un repas."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63e5a277-8aa3-49ad-a85e-59605850fa2d",
                                                "sense_id": "e909bf41-b4c7-38bd-840a-b2e3c27c2af8",
                                                "text": "Elle décidait de l’entrée au logis et de la mort des cochons, frondait le jardinier, arrêtait le menu du déjeuner et du dîner, allait de la cave au grenier, du grenier dans la cave, en y balayant tout à sa fantaisie sans rien trouver qui lui résistât."
                                            },
                                            {
                                                "example_id": "0cd362b2-3ddf-4a26-9894-1e9ade8b923a",
                                                "sense_id": "e909bf41-b4c7-38bd-840a-b2e3c27c2af8",
                                                "text": "En fait, c'était quasiment le menu unique : le sifflard d'entrée, le steack frites, le calendot et la crème glacée. Le tout avec une vinasse baptisée Côtes de Provence, ou Beaujolais."
                                            },
                                            {
                                                "example_id": "bcc0fd00-a20d-473a-a6a4-5d2e3f04aa40",
                                                "sense_id": "e909bf41-b4c7-38bd-840a-b2e3c27c2af8",
                                                "text": "Le menu que je préfère,\nC'est la chair de votre cou."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "72689ba7-bb5f-3f8e-8e8f-9cded28b47fe",
                                        "entry_id": "69813caf-cf67-35fb-adda-b39bf81fb951",
                                        "glosses": [
                                            "Liste écrite détaillée des mets qui seront servis au cours du repas."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "745b35e8-2651-4f18-9a03-10ad936d4013",
                                                "sense_id": "72689ba7-bb5f-3f8e-8e8f-9cded28b47fe",
                                                "text": "Placer un menu devant chaque convive. — Consulter le menu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f6f53155-4046-3040-8750-5611d9e98b71",
                                        "entry_id": "69813caf-cf67-35fb-adda-b39bf81fb951",
                                        "glosses": [
                                            "Programme ; ordre du jour."
                                        ],
                                        "tags": [
                                            "analogy",
                                            "figuratively"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ba410e9e-506a-3bcc-991e-ef0c58fa20cf",
                                        "entry_id": "69813caf-cf67-35fb-adda-b39bf81fb951",
                                        "glosses": [
                                            "Élément d’interface graphique, généralement rectangulaire, dans lequel est présentée une liste de commandes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef2130ab-6bd9-41aa-8264-42ede89f0365",
                                                "sense_id": "ba410e9e-506a-3bcc-991e-ef0c58fa20cf",
                                                "text": "Il faut bien avouer que l' ergonomie des commandes est en retrait depuis la généralisation des touches numériques. Les boutons à poussoir présentent l'avantage d'être actionnables en un geste auquel le conducteur se familiarise d'ailleurs rapidement. Un vrai plus en termes de sécurité routière apprécié par beaucoup d'automobilistes. Leurs homologues tactiles, eux, obligent souvent à quitter la route des yeux, surtout lorsque la fonctionnalité choisie est accessible via des menus, pas toujours intuitifs au demeurant. Or c'est précisément ce que dénonce le dirigeant d'Euro NCAP. Qui explique : « La surutilisation des écrans tactiles est un problème à l'échelle de l'industrie. Presque tous les constructeurs automobiles déplacent les commandes clés sur des écrans tactiles centraux, obligeant les conducteurs à quitter la route des yeux et augmentant le risque d'accidents liés à la distraction. »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d24c1c40-f8d2-3f46-9779-6a46a0cdc4bf",
                                        "entry_id": "69813caf-cf67-35fb-adda-b39bf81fb951",
                                        "glosses": [
                                            "Intestin grêle du porc, du mouton."
                                        ],
                                        "tags": [
                                            "Boucherie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bac1c8a6-337d-468b-baff-0eab9b98489c",
                                                "sense_id": "d24c1c40-f8d2-3f46-9779-6a46a0cdc4bf",
                                                "text": "L’une et l’autre se font avec la ventrée du cochon comme matière première, la Guéméné n’utilisant que les chaudins (gros intestin), alors que la Vire mélange le chaudin avec le menu et l’estomac."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "menu",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a59cb75a-758f-3af2-ad70-698c40aca85a",
                                        "entry_id": "230b8daf-81b0-3254-a71e-231750f2018b",
                                        "glosses": [
                                            "En tout petits morceaux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3dcacc29-624b-4e3d-aa1b-c77ad6eccdcf",
                                                "sense_id": "a59cb75a-758f-3af2-ad70-698c40aca85a",
                                                "text": "Hachez cela menu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dd5b3d79-8003-3299-8de7-a7f8d5382b3d",
                                        "entry_id": "230b8daf-81b0-3254-a71e-231750f2018b",
                                        "glosses": [
                                            "et Vous serez hachés menu comme chair à pâté."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "80095241-103b-49ca-8a50-99a14a402af0",
                                                "sense_id": "dd5b3d79-8003-3299-8de7-a7f8d5382b3d",
                                                "text": "Écrire menu, écrire en lettres fort petites."
                                            },
                                            {
                                                "example_id": "4dc62788-86be-4439-a5de-386c0aded283",
                                                "sense_id": "dd5b3d79-8003-3299-8de7-a7f8d5382b3d",
                                                "text": "Marcher, trotter dur et menu, Marcher vite et à petits pas."
                                            },
                                            {
                                                "example_id": "9a2adcbe-9cbc-4eb5-9619-ee16c7b56a8e",
                                                "sense_id": "dd5b3d79-8003-3299-8de7-a7f8d5382b3d",
                                                "text": "Cela se rapprochait rapidement, car la chanteuse trottait, trottait, menu mais vite ; presque aussitôt elle était sous nos fenêtres, répétant de tout près, à pleine voix fêlée, sa continuelle chanson."
                                            },
                                            {
                                                "example_id": "cbe7c0eb-3172-46f4-89c4-dad2b02fb783",
                                                "sense_id": "dd5b3d79-8003-3299-8de7-a7f8d5382b3d",
                                                "text": "– À Il faut prier, dit la mamma.\n– C’est quoi des pedz…\n– Ben des péquenots, quoi ! Ils aiment le crincrin de village et d’autres machins comme ça..."
                                            },
                                            {
                                                "example_id": "18ae625d-b350-466e-a7ea-915a9857d94a",
                                                "sense_id": "dd5b3d79-8003-3299-8de7-a7f8d5382b3d",
                                                "text": "Dans un coin de ma tête, j’avais pas encore écarté la possibilité que tout cela soit un piège et que je me fasse de nouveau tabasser menu."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
