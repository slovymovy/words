                                            {
                                                "example_id": "5e0fcf7b-e101-4198-aa71-2e647a5b21a3",
                                                "sense_id": "93d90db2-a8cf-31d1-b8f8-fa105690399d",
                                                "text": "Der größte bebaute Teil Rostocks befindet sich auf der westlichen Seite der Warnow."
                                            },
                                            {
                                                "example_id": "8794f839-528e-4b70-acc7-6ca9bffa1b78",
                                                "sense_id": "93d90db2-a8cf-31d1-b8f8-fa105690399d",
                                                "text": "Ich bin in Rostock geboren."
                                            },
                                            {
                                                "example_id": "101f11e8-5a62-44d7-8e0f-0d181def1a7e",
                                                "sense_id": "93d90db2-a8cf-31d1-b8f8-fa105690399d",
                                                "text": "Ich habe in Rostock meinen Urlaub verbracht."
                                            },
                                            {
                                                "example_id": "0cdc76e4-f249-474c-ad4f-4e42436ee736",
                                                "sense_id": "93d90db2-a8cf-31d1-b8f8-fa105690399d",
                                                "text": "Nach Rostock führen viele Wege."
                                            },
                                            {
                                                "example_id": "df303902-5b62-4a59-842c-a35fe617d975",
                                                "sense_id": "93d90db2-a8cf-31d1-b8f8-fa105690399d",
                                                "text": "„In den Küstenstädten Wismar, Rostock und Stralsund sind moderne und leistungsfähige Werften entstanden.“"
