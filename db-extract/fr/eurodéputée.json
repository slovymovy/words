                ],
                "senses": [
                    {
                        "sense_id": "4c3e1f55-7ba0-3b43-9e49-01c5507cc7bf",
                        "entry_id": "34262a2c-479d-3623-80f0-8821a9549f64",
                        "glosses": [
                            "Députée au parlement européen."
                        ],
                        "tags": [
                            "European-Union"
                        ],
                        "examples": [
                            {
                                "example_id": "7601ee23-1c16-41fb-8803-09dceb50bed4",
                                "sense_id": "4c3e1f55-7ba0-3b43-9e49-01c5507cc7bf",
                                "text": "Celui qui serait passé à proximité de l’hémicycle du Parlement européen l’après-midi du 6 mai 1999, un peu avant l’heure de l’apéritif, aurait dressé l’oreille en percevant les hauts cris d’une eurodéputée irlandaise."
                            },
                            {
                                "example_id": "edcecff6-045e-4973-8973-4dd79e43de2b",
                                "sense_id": "4c3e1f55-7ba0-3b43-9e49-01c5507cc7bf",
                                "text": "Eurodéputée depuis 2019, Mme Zacharopoulou, 46 ans, a été nommée secrétaire d’Etat le mois dernier."
                            },
                            {
                                "example_id": "3d4f2206-5664-4cdc-9c07-fbdc4d2e7a8c",
                                "sense_id": "4c3e1f55-7ba0-3b43-9e49-01c5507cc7bf",
                                "text": "« Nous sommes arrivés à un accord historique, qui réconcilie l’automobile et le climat, deux frères ennemis », s’est réjouie l’eurodéputée écologiste française Karima Delli, présidente de la commission Transports au Parlement européen."
                            }
                        ]
                    }
                ],
