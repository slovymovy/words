                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "667ff987-c309-3308-9184-3a2d3922550e",
                                        "entry_id": "e3a215fa-4667-37ed-a5bb-d8d8b73aa1b7",
                                        "glosses": [
                                            "To decorate or perfume with lavender."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "57a1fdf2-be45-42d6-b4c3-a776d42ef537",
                                                "sense_id": "667ff987-c309-3308-9184-3a2d3922550e",
                                                "text": "Short shafts of dying sunlight mingled with the deepening grey, lavendering the horizon, and all nature seemed to hush as though waiting to welcome the night."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3f8f770a-f96f-4af0-9037-7747f3af927c",
                        "source_entry_id": "f6401928-cd1a-35d1-a38c-a6db64b70caa",
                        "source_sense_id": "14153633-109b-3a58-a77a-ca0994323fdb",
                        "source_sense_description": "Lavandula, een struik uit de lipbloemenfamilie Lamiaceae",
                        "target_lang_word": "lavande",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lavande",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8d6f500c-c2cb-361f-868a-47e75e6335e9",
                                        "entry_id": "e33e5c19-5fc5-3b2f-9de8-d4f877c2b4ef",
                                        "glosses": [
                                            "Synonyme de lavande vraie (Lavandula angustifolia)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f593fb6a-1dd5-4835-a764-9979dedd2532",
                                                "sense_id": "8d6f500c-c2cb-361f-868a-47e75e6335e9",
                                                "text": "Depuis que l'on sait extraire le parfum de la lavande par des procédés industriels, on ne s'est plus contenté de ramasser la lavande en baïassière, c'est-à-dire à l'état sauvage, on a fait des plantations."
                                            },
                                            {
                                                "example_id": "66331bcf-0848-4640-b498-fa9b0092bacb",
                                                "sense_id": "8d6f500c-c2cb-361f-868a-47e75e6335e9",
                                                "text": "On s'est longtemps contenté de cueillir les fleurs des lavandes sauvages, croissant spontanément dans les friches, entre 700 et 1400 m d'altitude, en essaims plus ou moins denses appelés baïassières."
                                            },
                                            {
                                                "example_id": "3fba5bf0-4c6a-4760-811e-1d8c81760b72",
                                                "sense_id": "8d6f500c-c2cb-361f-868a-47e75e6335e9",
                                                "text": "La lavande est un trésor, un trésor de beauté, de santé, de sérénité."
                                            },
                                            {
                                                "example_id": "e51aa3fe-bc95-42c9-b4ed-8eed28337509",
                                                "sense_id": "8d6f500c-c2cb-361f-868a-47e75e6335e9",
                                                "text": "Des lavandes faisaient bordure devant une touffe de sauge, deux ou trois rosiers pomponnants et un épais buisson d'herbe de la pampa arborant ses plumets vaniteusement décoratifs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "176a54e6-789f-36bb-9292-b4a3cacb35cf",
                                        "entry_id": "e33e5c19-5fc5-3b2f-9de8-d4f877c2b4ef",
                                        "glosses": [
                                            "Parfum extrait des fleurs de cette plante."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "352490a1-764c-4c43-8346-6cae4c74c606",
                                                "sense_id": "176a54e6-789f-36bb-9292-b4a3cacb35cf",
                                                "text": "Parfumer du linge avec de la lavande."
                                            },
                                            {
                                                "example_id": "a5cb012e-68c9-4600-85cd-248a59758d26",
                                                "sense_id": "176a54e6-789f-36bb-9292-b4a3cacb35cf",
                                                "text": "Plus tard, dans le souvenir de Louis, ce parc d'attractions, la rivière, le bruit des machines à sous furent associés à l'odeur de lavande d'Odile, qui avait découvert une bouteille de ce parfum au fond du placard de leur chambre du Boscombe College."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "lavande",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a8f4bed8-e6e5-320f-b3da-ef16b1ce230e",
                                        "entry_id": "9d90251f-1e5b-3cab-8f4e-81f94e764042",
                                        "glosses": [
                                            "Couleur bleu mauve clair. #9683EC"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ee6c730-a1f9-4f68-9a3d-c0fb7521d2e0",
                                                "sense_id": "a8f4bed8-e6e5-320f-b3da-ef16b1ce230e",
                                                "text": "À l’entrée de sa loge, le Marseillais s’exhibait dans un smoking lavande fleuri d’un œillet pourpre."
                                            }
                                        ]
                                    }
                                ]
                            },
