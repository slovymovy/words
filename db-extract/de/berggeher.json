                ],
                "senses": [
                    {
                        "sense_id": "81b19c86-5b10-39d2-806f-647867ddf977",
                        "entry_id": "08fa83a6-4b91-3b15-87c7-4f095647333e",
                        "glosses": [
                            "Person, die im Gebirge wandern geht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1248a3fb-1c49-47ff-9b73-8e937e4cbd94",
                                "sense_id": "81b19c86-5b10-39d2-806f-647867ddf977",
                                "text": "„Berg- und Almbauern waren also alarmiert, und Wanderer und Berggeher fürchteten Einschränkungen und gesperrte Natur.“"
                            },
                            {
                                "example_id": "0d1ca6ad-6a96-4519-8e9d-f80845d517df",
                                "sense_id": "81b19c86-5b10-39d2-806f-647867ddf977",
                                "text": "„Jeder Berggeher kennt das, dass man sich auf dem Gipfel ein Stück abhebt aus den Alltagssorgen und all den unwichtigen Kleinigkeiten des Lebens.“"
                            },
                            {
                                "example_id": "443ee636-f95e-4ed4-9813-530f03a54f03",
                                "sense_id": "81b19c86-5b10-39d2-806f-647867ddf977",
                                "text": "„Nach einigen Sätzen meinten sie, ob sie nicht den Hinweis gelesen hätten: Nur für erfahrene Berggeher.“"
                            },
                            {
                                "example_id": "d2139bec-173b-4669-8052-64797406efdb",
                                "sense_id": "81b19c86-5b10-39d2-806f-647867ddf977",
                                "text": "„Bernd ist ein hervorragender, sehr umsichtiger Berggeher, ich habe ihn selbst ausgebildet.“"
                            },
                            {
                                "example_id": "fab09028-84b4-4593-b677-f7261a46443d",
                                "sense_id": "81b19c86-5b10-39d2-806f-647867ddf977",
                                "text": "„Es sind Lieder, die jeder Berggeher kennt und die für gute Stimmung und ein Zusammengehörigkeitsgefühl sorgen.“"
                            },
                            {
                                "example_id": "8751d705-1113-4d6d-876a-d3c7a20dd3a0",
                                "sense_id": "81b19c86-5b10-39d2-806f-647867ddf977",
                                "text": "„Dieses Hilfsmittel ermöglicht es auch wenig versierten Berggehern, die Gefahr abzuschätzen.“"
                            },
                            {
                                "example_id": "2ca881ce-5386-43e0-be68-f161ea97df10",
                                "sense_id": "81b19c86-5b10-39d2-806f-647867ddf977",
                                "text": "„Viele Berggeher wollen gar nur deswegen auf den Gipfel, weil einem dort oben die Welt zu Füßen liegt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
