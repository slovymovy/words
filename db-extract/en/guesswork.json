                        "target_lang_word": "Vermutung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vermutung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3dbf34b1-9082-378a-b003-17ed4924cf2b",
                                        "entry_id": "44ffd4ea-3e42-3686-bee5-f85c08d46291",
                                        "glosses": [
                                            "eine ungesicherte Erkenntnis oder Annahme"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "669f34f2-9b21-4e18-901d-b90b2b76d8ee",
                                                "sense_id": "3dbf34b1-9082-378a-b003-17ed4924cf2b",
                                                "text": "Mit seiner Vermutung lag er richtig."
                                            },
                                            {
                                                "example_id": "4790bd5b-4f12-4496-9730-cc6cdd90e826",
                                                "sense_id": "3dbf34b1-9082-378a-b003-17ed4924cf2b",
                                                "text": "„Um den Ursprung des Lebens zu verstehen, haben Wissenschaftler Vermutungen über die Entstehung von Zellen und Genen angestellt.“"
                                            },
                                            {
                                                "example_id": "bfa26b9c-0fed-44f6-b685-17f3969638c0",
                                                "sense_id": "3dbf34b1-9082-378a-b003-17ed4924cf2b",
                                                "text": "„Eine weitere Vermutung war, dass er Madams Leibwächter sei.“"
                                            },
                                            {
                                                "example_id": "9bc267b5-6af4-4a16-8f7a-f059fc756b98",
                                                "sense_id": "3dbf34b1-9082-378a-b003-17ed4924cf2b",
                                                "text": "„Deutlicher konnte sie mir meine Vermutung nicht bestätigen, daß die angebliche Nichte ihre Tochter war und ich ihr Onkel.“"
                                            },
                                            {
                                                "example_id": "34b50fbc-7743-4a31-8199-640ad416ad8f",
                                                "sense_id": "3dbf34b1-9082-378a-b003-17ed4924cf2b",
                                                "text": "„Eine einfache Suche hatte Hörđurs Vermutung bestätigt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
