                        "tags": [
                            "comparative"
                        ],
                        "form": "more unmerry"
                    },
                    {
                        "form_id": "80ba489f-ed49-421a-97e9-e96e84cf2cfd",
                        "entry_id": "8cee180d-d4ee-3b86-8fbc-d8e515b07e01",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most unmerry"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f19c359c-a60b-3e1c-8095-2ad5439eb406",
                        "entry_id": "8cee180d-d4ee-3b86-8fbc-d8e515b07e01",
                        "glosses": [
                            "Not merry, the opposite of merry; sad, gloomy."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fccd8473-a9d3-45b2-9451-04f32b2da368",
                                "sense_id": "f19c359c-a60b-3e1c-8095-2ad5439eb406",
                                "text": "\"Yea, much,\" she said; \"it seems joyous to me: and I shall tell thee that I have mostly dwelt in unmerry houses, though they were of greater cost than this.\""
                            },
                            {
                                "example_id": "759011ca-5236-46e0-8a1d-d301acf9a0ba",
                                "sense_id": "f19c359c-a60b-3e1c-8095-2ad5439eb406",
                                "text": "But the Maiden, though she might hope the more to see her friend come back whole and sound, was unmerry at the tidings, she could scarce tell for why; neither did the Carline blame her therefore."
                            },
                            {
                                "example_id": "6bb585c1-498e-4c46-979f-a37156e54b97",
                                "sense_id": "f19c359c-a60b-3e1c-8095-2ad5439eb406",
                                "text": "In an impassive 17th-century mansion in the Faubourg Saint-Germain Newman finds his prize possession an unmerry widow named Claire de Cintre."
                            }
                        ]
                    }
                ],
