                                    {
                                        "sense_id": "f609658e-2340-32d0-9828-8138e8ac3a38",
                                        "entry_id": "4031d892-8c36-3ca2-9aa4-dc5d481031a8",
                                        "glosses": [
                                            "Dull; uninteresting; insipid."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "59e28701-03bf-4c2a-a66c-0ed8c140b25f",
                                                "sense_id": "f609658e-2340-32d0-9828-8138e8ac3a38",
                                                "text": "Well, the new restaurant seems nice, but their menu is a little blah."
                                            },
                                            {
                                                "example_id": "86052150-ae63-470b-a3c0-f9671030468f",
                                                "sense_id": "f609658e-2340-32d0-9828-8138e8ac3a38",
                                                "text": "He was struck by how much pleasure they seemed to take in their daytime lives, how blah their night work was by contrast, how altogether meaningless; […]"
                                            },
                                            {
                                                "example_id": "5ba1cfff-92e1-4fe5-9405-59f4cef5e44d",
                                                "sense_id": "f609658e-2340-32d0-9828-8138e8ac3a38",
                                                "text": "[…] although the show deliberately showcases various luxury goods […], the overall ambience is extraordinarily bare of style and beauty, offering instead a world of blah décor, undistinguished fashions and cavernous homes that just look like overpriced McMansions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3205b791-1b14-3188-8087-54ca593fb798",
                                        "entry_id": "4031d892-8c36-3ca2-9aa4-dc5d481031a8",
                                        "glosses": [
                                            "Low in spirit or health; down."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d72398dc-6373-4f30-bf87-fefc6b2aa785",
                                                "sense_id": "3205b791-1b14-3188-8087-54ca593fb798",
                                                "text": "I decided to go exercise rather than sit around all day feeling blah."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "blah",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "860aabdc-47fa-3adc-92d0-d800ceefbc8f",
                                        "entry_id": "719eda7b-6981-36cf-8531-1080e0d956a8",
                                        "glosses": [
                                            "An expression of mild frustration."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "02186a7d-152b-4a7f-bff1-fd36e581c699",
                                                "sense_id": "860aabdc-47fa-3adc-92d0-d800ceefbc8f",
                                                "text": "Blah! Why can't I get this computer to work!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ec67d6ab-5d06-3921-b294-e79a71e76463",
                                        "entry_id": "719eda7b-6981-36cf-8531-1080e0d956a8",
                                        "glosses": [
                                            "Imitative of idle, meaningless talk; used sometimes in a slightly derogatory manner to mock or downplay another's words, or to show disinterest in a diatribe, rant, instructions, unsolicited advice, parenting, etc. Also used when recalling and retelling another's words, as a substitute for the portions of the speech deemed irrelevant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "467604b6-9100-4f2c-86ca-2d11608c714a",
                                                "sense_id": "ec67d6ab-5d06-3921-b294-e79a71e76463",
                                                "text": "Yeah, yeah, blah blah blah, Mom, you said this all yesterday."
                                            },
                                            {
                                                "example_id": "25b9aa28-6660-40b3-8d66-aa1a52cd1039",
                                                "sense_id": "ec67d6ab-5d06-3921-b294-e79a71e76463",
                                                "text": "And then he was like, \"Oh, my brother's an Internet millionaire, blah blah blah.\" Like I care!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6cd50359-1485-32e6-8e8f-f4de35249537",
                                        "entry_id": "719eda7b-6981-36cf-8531-1080e0d956a8",
                                        "glosses": [
                                            "Representing the sound of vomiting."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "blah",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8a24b7b2-c893-3e98-a835-2915e90bc7d6",
                                        "entry_id": "c2bb224a-fddd-3e15-88f5-18d1ace9e9d8",
                                        "glosses": [
                                            "To utter idle, meaningless talk."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "963f9c98-e064-4bbd-b07e-97609b001252",
                                                "sense_id": "8a24b7b2-c893-3e98-a835-2915e90bc7d6",
                                                "text": "Ooh, I feel so guilty, I've got far too much money — […] So give it away, endow a charitable foundation, burn it, but stop blahing on about it […]"
                                            },
                                            {
                                                "example_id": "d6af144b-b62b-4272-ace0-6ee776aeb880",
                                                "sense_id": "8a24b7b2-c893-3e98-a835-2915e90bc7d6",
                                                "text": "Someone else said to me: “If you’re writing something again, don’t blah on about winning elections; it really offends them.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
