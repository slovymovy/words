                        "glosses": [
                            "своенравный, своевольный, с постоянными капризами"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb31ff32-307e-45f2-bff9-f8297b2d6399",
                                "sense_id": "88d95556-2eef-3c18-a24f-f030bb130cf1",
                                "text": "Оксана знала и слышала все, что про нее говорили, и была капризна, как красавица."
                            }
                        ]
                    },
                    {
                        "sense_id": "dc2aa311-2af2-306e-b41f-79ebcb32efd0",
