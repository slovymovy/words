                    },
                    {
                        "translation_id": "af26220f-ebb7-446a-9724-f17f3fc9c1c7",
                        "source_entry_id": "95cd2d76-031d-3edd-85ce-53b6dc54b96b",
                        "source_sense_id": "b75d0669-1935-370c-8092-161b2f54b3d4",
                        "target_lang_word": "commerçante",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "commerçante",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "06f107d6-895b-377d-bce4-c288209fccf8",
                                        "entry_id": "727d0c5a-623e-3b7f-bb09-130c362cf265",
                                        "glosses": [
                                            "Celle qui gagne sa vie en faisant du commerce."
                                        ],
                                        "tags": [
                                            "Métier"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "209eea57-0f0a-4239-beed-59b1892864c9",
                                                "sense_id": "06f107d6-895b-377d-bce4-c288209fccf8",
                                                "text": "En amour, monsieur, nous sommes toujours des naïfs, et les femmes des commerçantes."
                                            },
                                            {
                                                "example_id": "1c27bc5f-611a-49a1-aeb6-db2369315381",
                                                "sense_id": "06f107d6-895b-377d-bce4-c288209fccf8",
                                                "text": "Marie-Thérèse est une commerçante, elle aime le contact avec les clients ainsi que les profits liés à la vente de ses produits."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a26f85e1-241e-3987-a8fd-e54f65f802ac",
                                        "entry_id": "727d0c5a-623e-3b7f-bb09-130c362cf265",
                                        "glosses": [
                                            "Épouse d’un commerçant."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f7e4d0b9-44b5-4288-8858-dc261737737c",
                                                "sense_id": "a26f85e1-241e-3987-a8fd-e54f65f802ac",
                                                "text": "— C’est tout ? lui demanda la commerçante, en pensant que ce n’était pas Angélina qui faisait vivre le magasin."
                                            }
                                        ]
                                    }
                                ]
                            },
