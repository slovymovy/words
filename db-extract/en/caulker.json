                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9861005-385a-487e-b6cd-7d9420b3112c",
                                "sense_id": "882286d1-f9ad-3af5-b5ab-1b76d6265ab6",
                                "text": "He was one of the best caulkers around."
                            }
                        ]
                    },
                    {
                        "sense_id": "2743a1cd-d557-3ba9-a96d-e97c98feb175",
                        "entry_id": "55ed2bd2-1194-3adb-8279-98e2082c72c7",
                        "glosses": [
                            "A tool used for caulking ships; a caulking iron."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "093a74c4-f878-3efc-82c3-d3793839c6ef",
                        "entry_id": "55ed2bd2-1194-3adb-8279-98e2082c72c7",
                        "glosses": [
                            "An alcoholic drink; a dram."
                        ],
                        "tags": [
                            "archaic",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "528701c8-9e9a-4736-8362-e1128dada369",
                                "sense_id": "093a74c4-f878-3efc-82c3-d3793839c6ef",
                                "text": "“Will you taste, messmate?” he asked; and when I had refused: “Well, I’ll take a dram myself, Jim,” said he. “I need a caulker, for there’s trouble on hand. And talking o’ trouble, why did that doctor give me the chart, Jim?”"
                            }
                        ]
                    },
                    {
                        "sense_id": "03cbdb6f-a2cd-39be-8881-fdad876a8a58",
                        "entry_id": "55ed2bd2-1194-3adb-8279-98e2082c72c7",
                        "glosses": [
                            "Archaic form of corker (“something large or remarkable, a whopper”)."
                        ],
                        "tags": [
                            "alt-of",
                            "archaic",
                            "informal"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "46e566d2-11d1-44e5-8611-cb02aef541f3",
                        "source_entry_id": "55ed2bd2-1194-3adb-8279-98e2082c72c7",
                        "source_sense_description": "A person who caulks various structures (as ships) and certain types of piping",
                        "target_lang_word": "calfat",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "calfat",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6bf0d052-3eed-35c7-a4f3-bc432009a7a7",
                                        "entry_id": "d8545b2d-5a02-3ac4-a2b7-674027585172",
                                        "glosses": [
                                            "Celui qui calfate ; calfateur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90301312-9a3d-4b54-972b-1746fcff7beb",
                                                "sense_id": "6bf0d052-3eed-35c7-a4f3-bc432009a7a7",
                                                "text": "De notre horrible malheur\nSeul le calfat est l’auteur."
                                            },
                                            {
                                                "example_id": "5ceb8405-3f9d-40d1-b37c-6cf2bc134a01",
                                                "sense_id": "6bf0d052-3eed-35c7-a4f3-bc432009a7a7",
                                                "text": "Au loin, les marteaux des calfats tamponnaient des carènes, et une brise lourde apportait la senteur du goudron."
                                            },
                                            {
                                                "example_id": "77ad1914-26d3-4191-8968-05eb347d7230",
                                                "sense_id": "6bf0d052-3eed-35c7-a4f3-bc432009a7a7",
                                                "text": "Le marteau des calfats sonnait sur les coques, des fumées bleues montaient des marmites où l’on chauffait le goudron, le vent qui passait charriait des odeurs de poix et de résine."
                                            },
                                            {
                                                "example_id": "b54adcd4-3bc3-4e30-823e-8c824d533647",
                                                "sense_id": "6bf0d052-3eed-35c7-a4f3-bc432009a7a7",
                                                "text": "À 10 heures j’avais trouvé un calfat, un charpentier et un forgeron, et les réparations commençaient."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc336e37-b223-3abf-b872-7e50dcaa7127",
                                        "entry_id": "d8545b2d-5a02-3ac4-a2b7-674027585172",
                                        "glosses": [
                                            "Outil qui sert à calfater."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de561b87-f2e8-454a-a848-c9d154daa979",
                                                "sense_id": "dc336e37-b223-3abf-b872-7e50dcaa7127",
                                                "text": "Quant au Ceylan, il est si mutilé lui-même, qu’il ne peut quitter sa place avant que le calfat n’ait pansé ses mille blessures."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fd34a2c1-c2b8-34a1-9d93-9a27b34ea74a",
                                        "entry_id": "d8545b2d-5a02-3ac4-a2b7-674027585172",
                                        "glosses": [
                                            "Calfatage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "59fd02c6-29ad-45c5-9078-671354c48e16",
                                                "sense_id": "fd34a2c1-c2b8-34a1-9d93-9a27b34ea74a",
                                                "text": "En 1778, le plus beau vaisseau de la flotte coula à fond dans la mer Noire. Comme il n'était pas assez solide, son calfat se détacha, et l’eau entra par les interstices."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3e847b45-4f8a-3fa2-85c7-e15c80798f98",
                                        "entry_id": "d8545b2d-5a02-3ac4-a2b7-674027585172",
                                        "glosses": [
                                            "Étoupe goudronnée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed98e9fd-22d2-4f15-a8b4-52a0e2221645",
                                                "sense_id": "3e847b45-4f8a-3fa2-85c7-e15c80798f98",
                                                "text": "Et à celui-là que je découvrais appuyé, blême, contre une poutre et qui écoutait à travers les calfats épais le chant interdit de la mer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "998c07b4-98fd-3776-8c27-ff937550b8a3",
                                        "entry_id": "d8545b2d-5a02-3ac4-a2b7-674027585172",
                                        "glosses": [
                                            "Ciseau à calfater."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8cd1a34d-07de-479f-ac5b-c74717afc124",
                                                "sense_id": "998c07b4-98fd-3776-8c27-ff937550b8a3",
                                                "text": "Calfat : Instrument de fer pour calfater un vaisseau."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "calfat",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "91be2ef5-aa26-3de5-ae4f-0713f297bfdc",
                                        "entry_id": "71e62ff0-6bb5-3892-95d5-aa4b025371b6",
                                        "glosses": [
                                            "Sénégali."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc5346a8-da44-4e62-8b75-84fac23417c2",
                                                "sense_id": "91be2ef5-aa26-3de5-ae4f-0713f297bfdc",
                                                "text": "Il [le peintre japonais] ajouta à la fin, au haut de son panneau, un cinquième grimpereau, un calfat au bec de corail."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
