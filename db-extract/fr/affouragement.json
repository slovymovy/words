                        "form": "affourragement"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5decd65b-e10d-32d9-94ce-a8909ef500f1",
                        "entry_id": "c4a659ba-9b07-38cb-b0bf-9530c1441db5",
                        "glosses": [
                            "Action d’affourager."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ebeebe9-ed18-49c9-9e78-5e866ecb32bc",
                                "sense_id": "5decd65b-e10d-32d9-94ce-a8909ef500f1",
                                "text": "En France, l'affouragement en vert peut se dérouler 5 mois par an, à partir du mois d'avril."
                            },
                            {
                                "example_id": "77dadf5c-9ae8-46bc-b581-c19078054f33",
                                "sense_id": "5decd65b-e10d-32d9-94ce-a8909ef500f1",
                                "text": "L’article L425-5 du code de l’environnement devra être modifié en ce sens, pour interdire le nourrissage du grand gibier et limiter l’agrainage et l'affouragement à l’objectif de prévention des dégâts agricoles, c'est-à-dire l’agrainage de dissuasion."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f8af25c2-a16c-4a9b-bc26-86647be664f9",
                        "source_entry_id": "c4a659ba-9b07-38cb-b0bf-9530c1441db5",
                        "source_sense_id": "5decd65b-e10d-32d9-94ce-a8909ef500f1",
                        "target_lang_word": "Fütterung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fütterung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "147f2651-8851-38a9-85ca-c87d8e074a32",
                                        "entry_id": "f8093725-c644-3902-9173-e5a34194b0bc",
                                        "glosses": [
                                            "die Versorgung von einem oder mehreren Tieren mit Nahrung (= Futter)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "094dd158-6106-4de7-965f-c480485dc53b",
                                                "sense_id": "147f2651-8851-38a9-85ca-c87d8e074a32",
                                                "text": "Die Fütterungvon Wild im Winter durch Jäger ist in Deutschland umstritten."
                                            },
                                            {
                                                "example_id": "4a3ecea0-ad88-4397-adc6-d494238c27c9",
                                                "sense_id": "147f2651-8851-38a9-85ca-c87d8e074a32",
                                                "text": "In einem dritten Versuch kombinierte Pawlow die Fütterung mit dem Klingelzeichen, und auch hier war eine vermehrte Speichelbildung zu beobachten."
                                            },
                                            {
                                                "example_id": "e41f1f75-5881-489e-bd32-7a2154a25868",
                                                "sense_id": "147f2651-8851-38a9-85ca-c87d8e074a32",
                                                "text": "\"Wir werden die [Wisent-]Herde aber auch weiter managen müssen\", erklärt Johannes Röhl. \"Dazu gehört vor allem eine Fütterung im Winter.\""
                                            },
                                            {
                                                "example_id": "8355fd86-e512-4e8c-b031-36018d1a2af8",
                                                "sense_id": "147f2651-8851-38a9-85ca-c87d8e074a32",
                                                "text": "Kritisch [für das Klima] sind Viehhaltung und weltweit wachsender Fleischkonsum auch wegen des zunehmenden Bedarfs an Soja für die Fütterung. Für den Soja-Anbau werden Regenwälder abgeholzt."
                                            },
                                            {
                                                "example_id": "21e06f42-0609-4d63-92ae-0238ded940b2",
                                                "sense_id": "147f2651-8851-38a9-85ca-c87d8e074a32",
                                                "text": "Zur Fütterung ihrer Jungen fliegen sie [die Mauersegler] bei schlechten Wetterbedingungen zur Nahrungssuche bis zu 100 Kilometer vom Nest weg und können bei günstigen Windverhältnissen dabei einen Zweistundenrhythmus einhalten."
                                            },
                                            {
                                                "example_id": "0037dd44-783a-4693-9c64-57e6e868420d",
                                                "sense_id": "147f2651-8851-38a9-85ca-c87d8e074a32",
                                                "text": "Die Rohfütterung bietet gegenüber der Fütterung mit Fertigfutter keine ernährungsphysiologischen Vorteile und birgt neben der Gefahr einer Mangelernährung auch mikrobiologische Risiken sowohl für die roh gefütterten Tiere als auch die mit ihnen zusammen lebenden Menschen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "934c7cb0-10a0-3c3a-8ae2-89b7b5f342ea",
                                        "entry_id": "f8093725-c644-3902-9173-e5a34194b0bc",
                                        "glosses": [
                                            "das wärmende Fleece in einer Jacke, einem Mantel oder einem Schlafsack, was unter dem Futter eingenäht ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c7d59f59-2063-4503-ba98-ec57338815e8",
                                                "sense_id": "934c7cb0-10a0-3c3a-8ae2-89b7b5f342ea",
                                                "text": "Die Qualität der Fütterung bestimmt, ob der Schlafsack im Winter benutzbar ist."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
