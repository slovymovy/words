                "senses": [
                    {
                        "sense_id": "38aeb08e-29d6-3751-9deb-7f1b82946f2b",
                        "entry_id": "c7a200d3-3d18-37dd-8355-be26f5a51548",
                        "glosses": [
                            "Mann, der bei Männern besonders gut ankommt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1152f68-b978-4697-b2f8-b300abdcb521",
                                "sense_id": "38aeb08e-29d6-3751-9deb-7f1b82946f2b",
                                "text": "„Der schwule Männerheld bedürfe der männlichen Gesellschaft so notwendig wie der Fisch des Wassers, da sie ihn vor Vereinsamung bewahre und somit eine Art von Ersatzfamilie darstelle.“"
                            },
                            {
                                "example_id": "9fe1efc0-91bd-498d-b37d-21278dceaeed",
                                "sense_id": "38aeb08e-29d6-3751-9deb-7f1b82946f2b",
                                "text": "„Der ›Männerheld‹ verfüge über schöpferische und erotische Fähigkeiten, mit deren Hilfe er Gemeinschaften und Bewegungen ›hervorbringe‹.“"
                            },
                            {
                                "example_id": "935ea990-8974-4d5a-aa70-63b29071e7d3",
                                "sense_id": "38aeb08e-29d6-3751-9deb-7f1b82946f2b",
                                "text": "„Der Männerheld sollte darüber hinaus unabhängig sein, rational, abenteuerlustig, moralisch integer sowie physisch und psychisch unversehrt, d. h. stark sein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
