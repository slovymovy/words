                "senses": [
                    {
                        "sense_id": "9c3d24b3-9c03-3311-9bdb-40458f72592e",
                        "entry_id": "2f10166e-3d1b-3a04-a0f7-be71864e5906",
                        "glosses": [
                            "рабочее вещество (обычно жидкость или газ) холодильной машины, которое при кипении (испарении, плавлении или даже сублимации) отнимает теплоту от охлаждаемого объекта и затем после сжатия передаёт её охлаждающей среде"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ce0804cb-fdd9-479f-9346-91983da28712",
                        "source_entry_id": "2f10166e-3d1b-3a04-a0f7-be71864e5906",
                        "source_sense_id": "9c3d24b3-9c03-3311-9bdb-40458f72592e",
                        "target_lang_word": "refrigerating fluid",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "487f7c97-80e8-46f7-a18b-201fb348d84e",
                        "source_entry_id": "2f10166e-3d1b-3a04-a0f7-be71864e5906",
                        "source_sense_id": "9c3d24b3-9c03-3311-9bdb-40458f72592e",
                        "target_lang_word": "cooling agent",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "394f49b8-da92-43d8-868e-094d6634da5a",
                        "source_entry_id": "2f10166e-3d1b-3a04-a0f7-be71864e5906",
                        "source_sense_id": "9c3d24b3-9c03-3311-9bdb-40458f72592e",
                        "target_lang_word": "coolant",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "coolant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b019f72b-e6ae-3267-91d4-b340401ffb94",
                                        "entry_id": "029bb350-e5e0-37c2-b0e7-e59bf6de9640",
                                        "glosses": [
                                            "A medium, usually fluid, used to draw heat from an object."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d636eb25-3c91-43c6-8c15-3e190c3832af",
                                                "sense_id": "b019f72b-e6ae-3267-91d4-b340401ffb94",
                                                "text": "Coolant is used in car engines and industrial processes, where excess heat could cause machine damage."
                                            },
                                            {
                                                "example_id": "b97c4eb3-45cc-4cf9-9f5e-02102b1eb0d8",
                                                "sense_id": "b019f72b-e6ae-3267-91d4-b340401ffb94",
                                                "text": "Anti-freeze has not been found necessary, even in the most severe conditions, since the water is drained out if a locomotive spends any appreciable time out of service and in normal working conditions the coolant is always warm."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2d9fe83a-bf27-4145-b0b4-fbdfbf30159e",
                        "source_entry_id": "2f10166e-3d1b-3a04-a0f7-be71864e5906",
                        "source_sense_id": "9c3d24b3-9c03-3311-9bdb-40458f72592e",
                        "target_lang_word": "refrigerant",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "refrigerant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "be023059-3d71-3ec4-9e1f-f62a38026a46",
                                        "entry_id": "f33043d3-f2aa-3ad7-bd54-f2e35bd6ab8c",
                                        "glosses": [
                                            "A substance used in a heat cycle that undergoes a phase change between gas and liquid to allow the cooling, as in refrigerators, air conditioners, etc."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5bdfad4a-d574-3f4c-8872-6a004f0ef1f7",
                                        "entry_id": "f33043d3-f2aa-3ad7-bd54-f2e35bd6ab8c",
                                        "glosses": [
                                            "That which makes cool or cold, such as a medicine for allaying the symptoms of fever."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "78a64a6c-b38d-41e0-b9b1-f2a3061a58d3",
                                                "sense_id": "5bdfad4a-d574-3f4c-8872-6a004f0ef1f7",
                                                "text": "1783, Hugh Blair, Lectures on Rhetoric and Belles Lettres, Dublin: Whitestone et al., Volume 2, Lecture 32, p. 403,\n[…] never give warning that you are about to be pathetic; and call upon your hearers, as is sometimes done, to follow you in the attempt. This almost never fails to prove a refrigerant to passion."
                                            },
                                            {
                                                "example_id": "a0296120-96b8-4db4-9ac4-940028e62b43",
                                                "sense_id": "5bdfad4a-d574-3f4c-8872-6a004f0ef1f7",
                                                "text": "[…] taking a blue and white soda-powder, [she] mingled the same in water, and encouraged me to drink the result. It might be a specific for seasickness, but it was not for home-sickness. The fiz was a mockery, and the saline refrigerant struck a colder chill to my despondent heart."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "refrigerant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d60e6aa6-a5d7-318e-b4fa-e183106f4d22",
                                        "entry_id": "79bbe793-bcfc-3cc6-b63a-5794ef39fa8c",
                                        "glosses": [
                                            "That cools or freezes; providing relief from heat or fever."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "64702bba-26be-4321-8d12-23a182340260",
                                                "sense_id": "d60e6aa6-a5d7-318e-b4fa-e183106f4d22",
                                                "text": "Here on a bank, refrigerant seat,\nScreen’d from the Sun’s o’ercoming heat,\nSome stretch’d at ease the hours employ,\nIn Bacchus’s unbounded joy,"
                                            },
                                            {
                                                "example_id": "b8dac007-ad86-4ccd-ac6e-534b460607b7",
                                                "sense_id": "d60e6aa6-a5d7-318e-b4fa-e183106f4d22",
                                                "text": "1627, Francis Bacon, Sylua Syluarum: or A Naturall Historie in Ten Centuries, London: William Lee, VIII. Century, p. 204,\nThis Experiment may be transferred vnto the Cure of Gangrenes, either Comming of themselues, or induced by too much Applying of Opiates: Wherein you must beware of Dry Heat, and resort to Things that are Refrigerant, with an Inward Warmth, and Vertue of Cherishing."
                                            },
                                            {
                                                "example_id": "63dafa71-be61-42a6-8312-74072dec9164",
                                                "sense_id": "d60e6aa6-a5d7-318e-b4fa-e183106f4d22",
                                                "text": "1859, Richard Francis Burton, The Lake Regions of Central Equatorial Africa, Journal of the Royal Geographical Society of London, Volume 29, Chapter 2, pp. 54-55,\nThey employ the coco-nut extensively; […] This immoderate use of the fruit is, according to the people, far from wholesome: it is considered, by its refrigerant properties, to cause rheumatic pains […]"
                                            },
                                            {
                                                "example_id": "07a32c34-4a1d-4477-82f6-57462d4bc8e3",
                                                "sense_id": "d60e6aa6-a5d7-318e-b4fa-e183106f4d22",
                                                "text": "[He] is robust and can safely take refrigerant food."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
