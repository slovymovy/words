                    {
                        "translation_id": "2e1caa97-369f-4d32-945e-11f77794089d",
                        "source_entry_id": "be6f243e-bf62-310c-9762-144773a05c01",
                        "source_sense_id": "97295354-b721-398d-b3de-1f4136bf7398",
