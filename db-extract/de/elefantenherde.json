                    {
                        "sense_id": "68acceb4-5efb-3eea-91a2-a1f03d3fdbd0",
                        "entry_id": "7ffc2d7f-f01e-3da5-ae3e-ef3e73b19345",
                        "glosses": [
                            "Gruppe (Herde) von zusammenlebenden Elefanten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "522308a3-c1a4-4358-b5b6-27e8aafaec52",
                                "sense_id": "68acceb4-5efb-3eea-91a2-a1f03d3fdbd0",
                                "text": "„Wir sahen Schwarzfersen-Antilopen, Zebras, Warzenschweine und eine Fülle von Vögeln, doch den stärksten Eindruck hinterließ bei mir eine gemächlich weidende Elefantenherde.“"
                            },
                            {
                                "example_id": "3313fa3a-f5b7-430f-b684-69177f69d48f",
                                "sense_id": "68acceb4-5efb-3eea-91a2-a1f03d3fdbd0",
                                "text": "„Eine Elefantenherde war kreuz und quer über die Seite verteilt und bekam durch einen für mich nicht nachvollziehbaren perspektivischen Dreh eine sensationelle Dynamik.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
