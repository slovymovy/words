            "senses": [
                {
                    "sense_id": "8818872f-e650-3a6a-96d3-cf1cae08fc1d",
                    "sense_definition": "Vêtement déchiré, en lambeaux ou très usé, souvent porté par une personne misérable.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "vetement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le mendiant marchait lentement dans le froid hivernal vêtu de <w>haillons</w> déchirés."
                        },
                        {
                            "text": "Après des semaines passées dans la forêt, ses vêtements n'étaient plus que des <w>haillons</w>."
                        }
                    ],
                    "synonyms": [
                        "guenille",
                        "oripeau"
                    ],
                    "common_phrases": [
                        "couvert de haillons",
                        "vêtu de haillons"
                    ]
                },
                {
                    "sense_id": "fdbeefed-4394-36a1-a383-4819bc216844",
                    "sense_definition": "Morceau ou vieux lambeau d'étoffe déchirée.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "tissu",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le mécanicien nettoyait les pièces grasses avec un vieux <w>haillon</w> poussiéreux."
                        },
                        {
                            "text": "La tempête avait déchiré la toile jusqu'à n'en laisser qu'un misérable <w>haillon</w>."
                        }
                    ],
                    "synonyms": [
                        "guenille",
                        "guenillon",
                        "lambeau"
                    ],
                    "common_phrases": [
                        "un vieux haillon"
                    ]
                },
                {
                    "sense_id": "49f3c3af-f2ed-3054-95c6-45818eddc9d3",
                    "sense_definition": "Variante de <w>hayon</w>, petite hutte servant d'abri aux ouvriers dans une ardoisière.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "construction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les ouvriers de l'ardoisière se rassemblaient sous un <w>haillon</w> pour se protéger de la pluie."
                        },
                        {
                            "text": "Pendant leur courte pause, les carriers prenaient leur repas à l'intérieur du <w>haillon</w>."
                        }
                    ],
