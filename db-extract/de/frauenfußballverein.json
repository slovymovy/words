                ],
                "senses": [
                    {
                        "sense_id": "e3209143-c1f3-387c-85c8-6a8f59439f5b",
                        "entry_id": "222c8d7e-5f9f-3d96-8d8c-6e4c1c17f03c",
                        "glosses": [
                            "ein Zusammenschluss (Verein) von Frauen, die den Ballsport Fußball betreiben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7383fd64-7ef7-4f78-a8ed-12a0036fd4cb",
                                "sense_id": "e3209143-c1f3-387c-85c8-6a8f59439f5b",
                                "text": "„31 Jahre später wurde der erste Frauenfußballverein der Welt, der Londoner British Lady Football Club, gegründet.“"
                            },
                            {
                                "example_id": "341fd3b4-7516-4f2c-8872-ae0d6f9ccddd",
                                "sense_id": "e3209143-c1f3-387c-85c8-6a8f59439f5b",
                                "text": "„Der neu gegründete Frauenfußballverein trägt seine Heimspiele im Heidewaldstadion in Gütersloh aus.“"
                            },
                            {
                                "example_id": "89a786bd-f3cf-4cc2-ad65-1874cf81b778",
                                "sense_id": "e3209143-c1f3-387c-85c8-6a8f59439f5b",
                                "text": "„In Frankfurt am Main kam es z.B. 1930 zur Gründung eines Frauenfußballvereins, der gleich zu Beginn drei Dutzend 18- bis 20jährige Mitglieder aufwies, allerdings ohne Aussicht auf Wettspielrunden.“"
                            },
                            {
                                "example_id": "32582ad5-6f9b-4f98-a358-822134afac11",
                                "sense_id": "e3209143-c1f3-387c-85c8-6a8f59439f5b",
                                "text": "„Die Frauenfußballvereine der 1. und 2. Bundesliga erwarten in Folge der FIFA Frauenfußball-WM 2011 einen Anstieg der Gesamtumsätze ihrer Clubs.“"
                            },
                            {
                                "example_id": "8f234f9a-d0de-4b10-a146-7eeaf3ba38cc",
                                "sense_id": "e3209143-c1f3-387c-85c8-6a8f59439f5b",
                                "text": "„Gleichwohl ist es Frauen im Iran nur unter Ausschluss der Öffentlichkeit erlaubt, Sport zu treiben. Die rund 20 Frauenfußballvereine des Landes trainieren also hinter verschlossenen Türen in Hallen, zu denen nur Frauen Zutritt haben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
