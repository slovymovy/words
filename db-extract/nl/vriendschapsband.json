                "senses": [
                    {
                        "sense_id": "423380c3-c112-34a8-b702-ac87058a72f8",
                        "entry_id": "1c078b3c-7b1a-3051-8f04-f99c4da57edb",
                        "glosses": [
                            "een verbintenis tussen twee of meer mensen of organisaties op basis van vriendschap"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba573cf8-dda3-4086-951b-db0d12f0ee73",
                                "sense_id": "423380c3-c112-34a8-b702-ac87058a72f8",
                                "text": "FC Twente verkocht tot dusverre 16.500 kaarten voor de wedstrijd. Schalke neemt ongeveer 2100 fans mee naar Enschede. Beide clubs hebben al jaren een vriendschapsband. Supporters van beide clubs bezoeken regelmatig wedstrijden van elkaar."
                            },
                            {
                                "example_id": "b4e1b18a-d1fa-4fb6-945d-be758524941f",
                                "sense_id": "423380c3-c112-34a8-b702-ac87058a72f8",
                                "text": "“Ik heb een heel goede vriendschapsband opgebouwd met Tom Lanoye, mijn Vlaamse gabber. Christophe Vekeman, Ronald Giphart, Bart Chabot, Tommy Wieringa en Maartje Wortel kom ik weleens tegen op literaire festivals. En vroeger was ik bevriend met Joost Zwagerman. Ja, hij was wel een vriend.”"
                            },
                            {
                                "example_id": "c729695a-c302-4843-828a-43e5605668a3",
                                "sense_id": "423380c3-c112-34a8-b702-ac87058a72f8",
                                "text": "Wanneer de vriend van Bunty overlijdt tijdens een bombardement, sneuvelt tegelijkertijd hun innige vriendschap. Is Emmy in staat om de vriendschapsbanden nieuw leven in te blazen? Deze debuutroman van de Engelse schrijfster Pearce zet de vriendschapsband tussen twee vriendinnen centraal."
                            }
                        ]
                    }
