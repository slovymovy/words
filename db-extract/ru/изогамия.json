                "senses": [
                    {
                        "sense_id": "11b32b19-6baf-35a7-87bd-5dd879a33640",
                        "entry_id": "c9aa1ee6-9acd-31bf-a264-686b16cc0c87",
                        "glosses": [
                            "биол. примитивная форма полового процесса, при котором сливаются две одинаковые морфологически и по величине гаметы"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6df32e9b-bf30-407d-93e0-cd1291ac7206",
                                "sense_id": "11b32b19-6baf-35a7-87bd-5dd879a33640",
                                "text": "Изогамия действительно может быть примитивным состоянием в эволюции полового процесса."
                            }
                        ]
                    }
                ],
