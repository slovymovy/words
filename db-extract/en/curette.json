                    {
                        "translation_id": "fe2cf148-d4bc-44dd-a820-7bf3d21b9837",
                        "source_entry_id": "686fdea0-0bfe-3a63-aed8-1bb43786fc70",
                        "source_sense_id": "e2c1a00d-46fe-35ee-a4a6-0a45dd8b2977",
