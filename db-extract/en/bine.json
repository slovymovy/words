                        "sense_id": "5e977953-c378-33a2-8177-ef5fbb6a1f64",
                        "entry_id": "966417df-d719-302c-8dc8-ae929a573e21",
                        "glosses": [
                            "To fill with bullets, to shoot."
                        ],
                        "tags": [
