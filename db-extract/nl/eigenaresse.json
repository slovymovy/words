                        "examples": [
                            {
                                "example_id": "771fba6d-95bc-4872-82b9-e1540a0a7c43",
                                "sense_id": "73221224-db79-3c81-bc96-ff86bc16db71",
                                "text": "Zij is de eigenaresse van een grote bierbrouwerij"
                            },
                            {
                                "example_id": "a7ce6bb1-d742-4385-91c3-469fbbd59759",
                                "sense_id": "73221224-db79-3c81-bc96-ff86bc16db71",
                                "text": "‘Get in. I’m Terrie Anderson from Casa de Luna. Gotcha!’ Ze gierde van het lachen terwijl ik naast een hond op de achterbank kroop. Dit was dus blijkbaar de eigenaresse van Casa de Luna."
                            },
                            {
                                "example_id": "fa8037af-d18f-4da2-8478-3177542b7e32",
                                "sense_id": "73221224-db79-3c81-bc96-ff86bc16db71",
                                "text": "Maar de kokkinnen bij de bouw van de Spoorlijn Bergen waren anders dan Britta, zijn verhuurster en, naar hij aannam, de eigenaresse van het houten huisje aan de rivieroever."
                            }
                        ]
                    }
