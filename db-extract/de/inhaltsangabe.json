                "senses": [
                    {
                        "sense_id": "752fb8de-5792-3d90-b625-009630cc4fbb",
                        "entry_id": "4cf33758-e318-31d6-afff-8c75582413b2",
                        "glosses": [
                            "kurze, zusammenfassende Darstellung des Inhaltes eines längeren Textes, eines Films etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e1b89603-394a-451b-afa4-d1e7b7bbf9e2",
                                "sense_id": "752fb8de-5792-3d90-b625-009630cc4fbb",
                                "text": "Bevor ich in die Oper gehe, lese ich mir immer die Inhaltsangabe im Opernführer durch, denn ich verstehe leider kein Italienisch."
                            },
                            {
                                "example_id": "521f40e3-ced4-4eb5-8d07-2878198bbe33",
                                "sense_id": "752fb8de-5792-3d90-b625-009630cc4fbb",
                                "text": "„Man sieht aus dieser Inhaltsangabe, daß Oxtiern ein Schaustück ist, in dem die Tugend belohnt wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "337fbb67-0ec2-4b20-8bfd-bc7a4f840bd2",
                        "source_entry_id": "4cf33758-e318-31d6-afff-8c75582413b2",
                        "source_sense_id": "752fb8de-5792-3d90-b625-009630cc4fbb",
                        "target_lang_word": "summary",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "summary",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "75e58772-41b5-329e-9f72-87f51d2f4d07",
                                        "entry_id": "eda3d8e6-d07e-3097-b6b9-4eea89dbec9d",
                                        "glosses": [
                                            "Concise, brief, or presented in a condensed form; presenting information in such a form."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f4c1a81-bba1-43b2-bfed-e2eaa48b0165",
                                                "sense_id": "75e58772-41b5-329e-9f72-87f51d2f4d07",
                                                "text": "Near-synonym: abstractive"
                                            },
                                            {
                                                "example_id": "7e7a26bb-31b9-4271-9e8e-7b57e69b5ad9",
                                                "sense_id": "75e58772-41b5-329e-9f72-87f51d2f4d07",
                                                "text": "A summary review is in the appendix."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b2ac47ec-fc47-3902-934c-4945d06ac0c5",
                                        "entry_id": "eda3d8e6-d07e-3097-b6b9-4eea89dbec9d",
                                        "glosses": [
                                            "Performed speedily, without formal ceremony, and (especially) without regard to legality."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a1bb4e7-b2c5-4417-8bf5-4ccf0b662180",
                                                "sense_id": "b2ac47ec-fc47-3902-934c-4945d06ac0c5",
                                                "text": "Near-synonym: extrajudicial"
                                            },
                                            {
                                                "example_id": "cc754fd1-61b3-4dad-85c9-91095651a858",
                                                "sense_id": "b2ac47ec-fc47-3902-934c-4945d06ac0c5",
                                                "text": "They used summary executions to break the resistance of the people."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "26e72f1e-d317-3e02-a83a-57ea5f96e3f2",
                                        "entry_id": "eda3d8e6-d07e-3097-b6b9-4eea89dbec9d",
                                        "glosses": [
                                            "Performed by omitting the procedures of a full trial, but within a legally valid framework."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "95145664-a8fe-4d88-bfa2-bc5a75ad3134",
                                                "sense_id": "26e72f1e-d317-3e02-a83a-57ea5f96e3f2",
                                                "text": "The matter was brought to a close by summary dismissal of the cases."
                                            },
                                            {
                                                "example_id": "a2e04e66-6ad3-47ce-815f-8a61cdcc8b05",
                                                "sense_id": "26e72f1e-d317-3e02-a83a-57ea5f96e3f2",
                                                "text": "The summary executions caused outrage."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "summary",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ebd3cae9-35d5-3467-8842-01c642f06ab3",
                                        "entry_id": "d947c01d-ade8-3399-b229-97f61db5b733",
                                        "glosses": [
                                            "An abstract or a condensed presentation of the substance of a body of material."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "76f6d089-0467-481d-954e-a63cf061fb32",
                                                "sense_id": "ebd3cae9-35d5-3467-8842-01c642f06ab3",
                                                "text": "I'd forgotten what happened in the first Harry Potter book so I read a summary of the narrative before starting the second one."
                                            },
                                            {
                                                "example_id": "f944ba4e-9411-401e-8ef1-1f8e2a8151c1",
                                                "sense_id": "ebd3cae9-35d5-3467-8842-01c642f06ab3",
                                                "text": "make a summary of the events"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
