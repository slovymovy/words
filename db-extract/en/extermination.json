                        "sense_id": "2c291d99-2231-3b1b-ba9a-08bdf31f9cd0",
                        "entry_id": "5256ea7f-e63f-3b25-8a50-4ed104f45d1e",
                        "glosses": [
                            "The act of exterminating; total destruction or eradication."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "f742bcad-ce15-4a19-8dd0-04e1562588b6",
                                "sense_id": "2c291d99-2231-3b1b-ba9a-08bdf31f9cd0",
                                "text": "extermination of error or vice"
                            },
                            {
                                "example_id": "5e441e0a-fbdb-4b82-85c2-5a3d93307b49",
                                "sense_id": "2c291d99-2231-3b1b-ba9a-08bdf31f9cd0",
                                "text": "extermination of weeds from a field"
                            },
                            {
                                "example_id": "851ead1f-33fd-4148-990a-aa91323c2216",
                                "sense_id": "2c291d99-2231-3b1b-ba9a-08bdf31f9cd0",
                                "text": "Depending on the case, extermination of a group of people may constitute genocide or crime against humanity."
                            },
                            {
                                "example_id": "d9bebe52-1f03-404c-b554-3041b6789f68",
                                "sense_id": "2c291d99-2231-3b1b-ba9a-08bdf31f9cd0",
                                "text": "Caley locomotive types, especially such numerous things as McIntosh goods and tank engines, have defied extermination over a good many years now."
                            }
                        ]
                    },
                    {
                        "sense_id": "047b7ff8-b93a-33a3-8264-295c20c24749",
