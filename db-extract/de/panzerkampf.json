                "senses": [
                    {
                        "sense_id": "2ec13b76-9146-3117-b103-2267e8199957",
                        "entry_id": "21b99be7-4608-3386-87e7-05a2e50635d6",
                        "glosses": [
                            "Kampf zwischen Panzern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aff35585-98d6-4fd6-8627-a617d124ca1a",
                                "sense_id": "2ec13b76-9146-3117-b103-2267e8199957",
                                "text": "„In den Panzerkämpfen der letzten Tage in Belgien zeichnete sich der Oberleutnant in einem Panzerregiment, Baron Nolde, durch besondere Kaltblütigkeit aus.“"
                            },
                            {
                                "example_id": "54826ab6-e412-45f3-8fbc-e990af8241a5",
                                "sense_id": "2ec13b76-9146-3117-b103-2267e8199957",
                                "text": "„Beide Seiten erlitten in den größten Panzerkämpfen des Zweiten Weltkriegs schwere Verluste.“"
                            },
                            {
                                "example_id": "7900dc8f-4f7b-448d-92d5-17bcdb5250f4",
                                "sense_id": "2ec13b76-9146-3117-b103-2267e8199957",
                                "text": "„Sowjetische Entlastungsangriffe im Raum nördlich und nordwestlich Orel führen zu schweren Panzerkämpfen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
