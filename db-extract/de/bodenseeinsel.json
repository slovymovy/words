                "senses": [
                    {
                        "sense_id": "761f02c0-fe40-3b01-91fd-822de983e853",
                        "entry_id": "8fd4b8b7-faaa-356f-967e-9c2d97d869be",
                        "glosses": [
                            "Insel, die im Bodensee gelegen ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f29175d0-5501-4213-9091-5e3f08cbb540",
                                "sense_id": "761f02c0-fe40-3b01-91fd-822de983e853",
                                "text": "Mainau ist eine Bodenseeinsel."
                            },
                            {
                                "example_id": "cbe25e6d-d9ac-4b10-9774-7e61c86b7d7d",
                                "sense_id": "761f02c0-fe40-3b01-91fd-822de983e853",
                                "text": "„Die Pläne für die karolingische Klosterstadt wurden zwischen 819 und 826 auf der Bodenseeinsel Reichenau gezeichnet und lagern heute in der Stiftsbibliothek von St. Gallen.“"
                            },
                            {
                                "example_id": "d6767454-69e0-4f44-8fef-925396562dcc",
                                "sense_id": "761f02c0-fe40-3b01-91fd-822de983e853",
                                "text": "„Bettina Gräfin Bernadotte und der Agraringenieur Philipp Haug haben einander am Freitag in der Schlosskirche der Bodenseeinsel Mainau das Jawort gegeben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
