                ],
                "senses": [
                    {
                        "sense_id": "8107a7ef-d4b6-361d-956c-13e54b983cd8",
                        "entry_id": "a76bb0c4-22ee-3ec3-ba97-59f4be33aac5",
                        "glosses": [
                            "The idea that some knowledge of the physical world can be derived logically from general principles."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "6c37f4c7-1562-4b7c-85d4-d254513647e1",
                                "sense_id": "8107a7ef-d4b6-361d-956c-13e54b983cd8",
                                "text": "The linguistic apriorism of Chomsky has stimulated some psychologists to search for nonlinguistic roots of language development."
                            },
                            {
                                "example_id": "d03cec6b-7730-4f7d-8724-d75f1ba29cf3",
                                "sense_id": "8107a7ef-d4b6-361d-956c-13e54b983cd8",
                                "text": "What was needed for modern science to take shape was a renunciation of their bookish a priorism, with its Aristotelian notion that all things can be deduced by logical, abstract argument from (ultimately arbitrary) first principles."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "eee1558e-b87d-45aa-bf8d-e780331e068a",
                        "source_entry_id": "a76bb0c4-22ee-3ec3-ba97-59f4be33aac5",
                        "source_sense_id": "8107a7ef-d4b6-361d-956c-13e54b983cd8",
                        "source_sense_description": "the idea that some knowledge of the physical world can be derived logically",
                        "target_lang_word": "apriorisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "apriorisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0d313ad9-43e9-3422-bd73-d6e90aee5c70",
                                        "entry_id": "fd4250af-bd00-3591-bb75-4495ad455d0e",
                                        "glosses": [
                                            "Thèse selon laquelle il existe des idées ou formes a priori."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "601b1ace-88c7-431c-a55f-0ecdcbd48b6a",
                                                "sense_id": "0d313ad9-43e9-3422-bd73-d6e90aee5c70",
                                                "text": "Contre l’apriorisme kantien, Mill soutient donc que le concept de nombre a son origine dans la manipulation que nous faisons des objets et qui nous conduit à les classer et à les ordonner."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eb7973a0-8654-40a8-ba16-41616130e7d9",
                        "source_entry_id": "a76bb0c4-22ee-3ec3-ba97-59f4be33aac5",
                        "source_sense_id": "8107a7ef-d4b6-361d-956c-13e54b983cd8",
                        "source_sense_description": "the idea that some knowledge of the physical world can be derived logically",
                        "target_lang_word": "Apriorismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Apriorismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5965ff8e-6d48-30de-9da9-1c58d54518e0",
                                        "entry_id": "1326bd27-b585-3b4d-9ce8-10d0f4114472",
                                        "glosses": [
                                            "Lehre von der Möglichkeit einer Erkenntnis a priori"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "626b805d-8f8c-4694-a272-a0ece58a0df8",
                                                "sense_id": "5965ff8e-6d48-30de-9da9-1c58d54518e0",
                                                "text": "„Wir sind hoffnungslos in einen historischen Apriorismus eingesperrt, den wir günstigstenfalls begreifen, niemals durchbrechen können.“"
                                            },
                                            {
                                                "example_id": "149cc522-8152-4b64-9e35-b87a381bf197",
                                                "sense_id": "5965ff8e-6d48-30de-9da9-1c58d54518e0",
                                                "text": "„Jene legt in den Geist bestimmte Wissensinhalte, die in dessen reiner Eigenentwicklung und von aller Erfahrung, aller erworbenen Erkenntnis unabhängig hervortreten; für den Apriorismus seinerseits muß aller Wissensstoff dem an sich völlig inhaltlosen Geiste gegeben werden, dieser ist nichts als die funktionelle Form, die jenen Stoff zu der – allein gültigen – empirischen Erkenntnis gestaltet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
