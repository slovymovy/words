{
    "word_family": [
        "neighing"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b14a6a87-268d-34bd-b0b5-30b743260642",
                    "sense_definition": "To make the characteristic high-pitched cry of a horse.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "horse_sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The horse began to <w>neigh</w> loudly when it saw its owner approaching with a bucket of fresh oats.",
                            "target_lang_translations": {
                                "pl": "Koń zaczął głośno <w>rżeć</w>, gdy zobaczył swojego właściciela zbliżającego się z wiadrem świeżego owsa."
                            }
                        },
                        {
                            "text": "We could hear the horses <w>neigh</w> in the distance as they ran freely across the open field.",
                            "target_lang_translations": {
                                "pl": "Słyszeliśmy, jak konie <w>rżą</w> w oddali, biegając swobodnie po otwartym polu."
                            }
                        }
                    ],
                    "common_phrases": [
                        "horses neigh in the stable",
                        "loudly neigh"
                    ],
                    "target_lang_definitions": {
                        "pl": "Wydawać charakterystyczny, wysoki głos właściwy dla konia."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "rżeć",
                                "target_lang_sense_clarification": "o koniu"
                            },
                            {
                                "target_lang_word": "zarżeć",
                                "target_lang_sense_clarification": "o koniu, jednorazowo"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "094b91c1-a1c9-36eb-978b-53b6a7166898",
                    "sense_definition": "To make a sound similar to a horse's cry, such as a high-pitched laugh.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "horse_sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She would <w>neigh</w> with laughter whenever someone told a particularly ridiculous joke.",
                            "target_lang_translations": {
                                "pl": "Zaczynała <w>rżeć</w> ze śmiechu za każdym razem, gdy ktoś opowiedział wyjątkowo niedorzeczny żart."
                            }
                        },
                        {
                            "text": "The crowd began to <w>neigh</w> in amusement at the comedian's silly imitation.",
                            "target_lang_translations": {
                                "pl": "Tłum zaczął <w>rżeć</w> z rozbawienia na widok głupiej imitacji komika."
                            }
                        }
                    ],
                    "common_phrases": [
                        "neigh with laughter"
                    ],
                    "target_lang_definitions": {
                        "pl": "Wydawać dźwięk podobny do rżenia konia, np. głośno i piskliwie się śmiać."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "rżeć",
                                "target_lang_sense_clarification": "głośno, hałaśliwie się śmiać"
                            },
                            {
                                "target_lang_word": "parskać",
                                "target_lang_sense_clarification": "śmiechem"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bc5739c3-a76f-3ead-af1f-e9ad44e6a5e6",
                    "sense_definition": "To scoff, sneer, or mock someone.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They <w>neighed</w> at his poverty and made his misfortune their daily pastime.",
                            "target_lang_translations": {
                                "pl": "<w>Szydzili</w> z jego ubóstwa i uczynili z jego nieszczęścia swoją codzienną rozrywkę."
                            }
                        },
                        {
                            "text": "It is cruel to <w>neigh</w> at those who are struggling to find their way in life.",
                            "target_lang_translations": {
                                "pl": "To okrutne <w>wyśmiewać</w> tych, którzy z trudem szukają swojej drogi w życiu."
                            }
                        }
                    ],
                    "common_phrases": [
                        "neigh at his misfortune"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in the sense of scoffing or mocking"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Szydzić, wyśmiewać się lub drwić z kogoś."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "szydzić",
                                "target_lang_sense_clarification": "drwić z kogoś"
                            },
                            {
                                "target_lang_word": "wyśmiewać",
                                "target_lang_sense_clarification": "drwić z czyjegoś nieszczęścia"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3cf2b1e5-7879-34c9-affe-550d3ff92359",
                    "sense_definition": "The characteristic high-pitched cry of a horse.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden <w>neigh</w> of a horse startled the birds in the trees.",
                            "target_lang_translations": {
                                "pl": "Nagłe <w>rżenie</w> konia spłoszyło ptaki na drzewach."
                            }
                        },
                        {
                            "text": "We recognized the gentle <w>neigh</w> of our favorite pony as we walked into the barn.",
                            "target_lang_translations": {
                                "pl": "Gdy weszliśmy do stajni, rozpoznaliśmy łagodne <w>rżenie</w> naszego ulubionego kuca."
                            }
                        }
                    ],
                    "synonyms": [
                        "neighing#Noun"
                    ],
                    "common_phrases": [
                        "sudden neigh of a horse",
                        "gentle neigh"
                    ],
                    "target_lang_definitions": {
                        "pl": "Charakterystyczny, wysoki odgłos wydawany przez konia."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "rżenie",
                                "target_lang_sense_clarification": "odgłos konia"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}