                                "example_id": "7f0c86a3-1026-492a-b927-d823dd8452ca",
                                "sense_id": "f02d56b2-c033-31de-8648-b4365c7fc73c",
                                "text": "You are an advertising executive in Freedonia. Since before you were born, it has been illegal to advertise cigarettes on Freedonia television, one of the many limits on cigarette ads."
