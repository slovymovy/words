                        "examples": [
                            {
                                "example_id": "42b92238-6a40-497e-9218-529d6de9d19d",
                                "sense_id": "d112ddc0-2c83-3310-aa1c-02281e2eda17",
                                "text": "Ils sont indépendants dans les montagnes du Mandara, mais actuellement très-affaiblis par leurs dissensions intérieures, et leur qualité de payens les expose aux grazzies de leurs voisins musulmans."
                            },
                            {
                                "example_id": "8c2ef369-22d5-4792-ab3d-5f7510caba1b",
                                "sense_id": "d112ddc0-2c83-3310-aa1c-02281e2eda17",
                                "text": "[…] ; si, par exemple , on peut dire à la honte de nôtre Religion , que les Dames Chrétiennes sont maintenant plus Payennes que les Payennes mêmes , en ce qui regarde l'immodestie & le luxe de leurs habits ; […]"
                            }
                        ]
                    }
