                "senses": [
                    {
                        "sense_id": "a180b22b-29cb-3c85-947e-1e04609640c4",
                        "entry_id": "828b6719-f467-39bb-b40b-324ccb7d8f41",
                        "glosses": [
                            "Methode der Dehnung von Muskeln und Mobilisation von Gelenken (die unter anderem darauf abzielt, Beweglichkeit zu fördern, Verspannungen zu lösen, die Durchblutung zu verbessern und die Flexibilität sowie Stabilität des Körpers zu erhöhen)"
                        ],
                        "tags": [
                            "Fitness",
                            "Physiotherapie"
                        ],
                        "examples": [
                            {
                                "example_id": "175098e0-e0a1-41d9-b086-763dacbdb4cd",
                                "sense_id": "a180b22b-29cb-3c85-947e-1e04609640c4",
                                "text": "„Einige effektive Dehntechniken, die Sie ausprobieren können, sind das statische Dehnen, bei dem Sie eine Dehnposition 10–30 Sekunden lang halten, und das dynamische Dehnen, bei dem Sie sich durch verschiedene Bewegungen bewegen, um Muskeln und Gelenke aufzuwärmen.“"
                            },
                            {
                                "example_id": "93f3ae73-3ae8-41c6-a311-90502127d1de",
                                "sense_id": "a180b22b-29cb-3c85-947e-1e04609640c4",
                                "text": "„Mit speziellen aktiven Übungen, Drainage-Lagerungen sowie Vibrations- und Dehntechniken können wir die Vitalkapazität steigern – und wir üben mit Ihnen alltagstaugliche Methoden ein, mit denen Sie Ihre Atem- und Lebensqualität selbst immer weiter verbessern können.“"
                            },
                            {
                                "example_id": "938b7fe6-5c8c-4391-8f2d-1d55210baba9",
                                "sense_id": "a180b22b-29cb-3c85-947e-1e04609640c4",
                                "text": "„Hierbei versucht er mittels gelenknaher Griffe, Dehntechniken an verkürzter Muskulatur oder der Stabilisation hypermobiler, instabiler Strukturen, [sic!] die Störungen zu beheben.“"
                            },
                            {
                                "example_id": "c6f9f5f2-37a5-4cf1-974e-c5c8b8456dae",
                                "sense_id": "a180b22b-29cb-3c85-947e-1e04609640c4",
                                "text": "„Mittels verschiedener Druck- und Dehntechniken wird der gesamte Körper bearbeitet, Gelenke mobilisiert, Energiebahnen sowie das Fasziengewebe angeregt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
