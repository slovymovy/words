                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b8096fb-9372-4c9c-9a63-ad8d427e9385",
                                "sense_id": "cf112552-bf75-3913-b5c5-6295f82f4c62",
                                "text": "Коро́ль отве́тил:\n— Глу́пости! —\nКоро́ль сказа́л:\n— О, бо́же мой! —\nКоро́ль вздохну́л: — О, Го́споди! —\nИ сно́ва лёг в крова́ть.",
                                "translation": "The King said,\n“Bother!”\nAnd then he said,\n“Oh, dear me!”\nThe King sobbed, “Oh, deary me!”\nAnd went back to bed.",
                                "english": "The King said,\n“Bother!”\nAnd then he said,\n“Oh, dear me!”\nThe King sobbed, “Oh, deary me!”\nAnd went back to bed."
                            }
                        ]
                    }
