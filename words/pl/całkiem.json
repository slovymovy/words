                    "semantic_group_id": "degree",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ten film był <w>całkiem</w> dobry, choć trochę za długi.",
                            "target_lang_translations": {
                                "ru": "Этот фильм был <w>довольно</w> хорошим, хотя и немного затянутым.",
                                "en": "This film was <w>pretty</w> good, although a bit too long.",
                                "nl": "Deze film was <w>nogal</w> goed, hoewel een beetje te lang.",
                                "de": "Der Film war <w>ziemlich</w> gut, wenn auch etwas zu lang.",
                                "fr": "Ce film était <w>assez</w> bon, bien qu'un peu trop long.",
                                "it": "Questo film era <w>abbastanza</w> buono, anche se un po' troppo lungo.",
                                "cs": "Ten film byl <w>docela</w> dobrý, i když trochu moc dlouhý.",
                                "tr": "Bu film <w>oldukça</w> iyiydi, gerçi biraz fazla uzundu.",
                                "es": "Esta película era <w>bastante</w> buena, aunque un poco larga.",
                                "zh": "这部电影<w>还</w>不错，虽然有点太长了。"
                            }
                        },
                        {
                            "text": "Czuję się już <w>całkiem</w> dobrze i mogę iść do pracy.",
                            "target_lang_translations": {
                                "ru": "Я чувствую себя уже <w>вполне</w> хорошо и могу идти на работу.",
                                "en": "I feel <w>quite</w> well now and can go to work.",
                                "nl": "Ik voel me al <w>vrij</w> goed en kan naar mijn werk gaan.",
                                "de": "Ich fühle mich schon <w>ganz</w> gut und kann zur Arbeit gehen.",
                                "fr": "Je me sens déjà <w>assez</w> bien et je peux aller travailler.",
                                "it": "Mi sento già <w>piuttosto</w> bene e posso andare al lavoro.",
                                "cs": "Už se cítím <w>docela</w> dobře a můžu jít do práce.",
                                "tr": "Kendimi artık <w>oldukça</w> iyi hissediyorum ve işe gidebilirim.",
                                "es": "Ya me siento <w>bastante</w> bien y puedo ir a trabajar.",
                                "zh": "我已经感觉<w>相当</w>好了，可以去上班了。"
                            }
                        }
