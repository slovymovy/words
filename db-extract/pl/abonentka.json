                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b7fbbe4a-dba9-4caf-8d9d-4226ad25b9f0",
                                                "sense_id": "389774ef-c07a-3f76-a8e4-71c4e31ec9a9",
                                                "text": "Sie ist schon lange Kundin bei uns."
                                            },
                                            {
                                                "example_id": "4b4fa06b-b121-4b60-a3f3-6818b05d4e56",
                                                "sense_id": "389774ef-c07a-3f76-a8e4-71c4e31ec9a9",
                                                "text": "„Die treuesten Kundinnen sind die Mütter.“"
                                            },
