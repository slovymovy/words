                    {
                        "translation_id": "6b5d8578-5bca-4b39-bbc0-1ae92f1798e0",
                        "source_entry_id": "4df5a8fb-8c82-363c-8395-0edf4945cb7e",
                        "source_sense_description": "a dreamlike state",
                        "target_lang_word": "фантасмаго́рия",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "фантасмаго́рия",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "79684f33-bd86-3081-8109-5debe7d2576d",
                                        "entry_id": "94e8d1bb-28d5-3fbe-b222-02d3855b8446",
                                        "glosses": [
                                            "устар. световые картины, фигуры, получаемые при помощи оптических устройств"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a4cebad-7f5f-44fe-9fe7-0bd4b7fefa6a",
                                                "sense_id": "79684f33-bd86-3081-8109-5debe7d2576d",
                                                "text": "Он решился сделаться фокусником и проехал Европу, показывая опыты фантасмагории, химии, физики."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3355ab4c-60d5-3f08-a15f-bb64c42bfc9c",
                                        "entry_id": "94e8d1bb-28d5-3fbe-b222-02d3855b8446",
                                        "glosses": [
                                            "нечто нереальное, призрачное, созданное мечтой, воображением, в бреду"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b384387-6528-408e-b90e-bf5083d2800f",
                                                "sense_id": "3355ab4c-60d5-3f08-a15f-bb64c42bfc9c",
                                                "text": "Фантасмагория красок, образов."
                                            },
                                            {
                                                "example_id": "cb4288cc-d031-4e16-920a-abebf8f6e5b8",
                                                "sense_id": "3355ab4c-60d5-3f08-a15f-bb64c42bfc9c",
                                                "text": "Счастье для него кончилось, и какое счастье? фантасмагория, обман."
                                            },
                                            {
                                                "example_id": "db0118ea-3f21-4fe2-942a-31796c7616da",
                                                "sense_id": "3355ab4c-60d5-3f08-a15f-bb64c42bfc9c",
                                                "text": "Костя, несмотря на свой сорокалетний возраст, болезненную жену и троих детей, имел ум безответственный и склонный к фантасмагориям."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f155ad03-08d0-31aa-89b6-e99b4fea0e81",
                                        "entry_id": "94e8d1bb-28d5-3fbe-b222-02d3855b8446",
                                        "glosses": [
                                            "причудливые, фантастические события, происшествия"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7935b0de-e597-4a7a-a4b2-a3a7b3de819c",
                                                "sense_id": "f155ad03-08d0-31aa-89b6-e99b4fea0e81",
                                                "text": "В этом нас убеждает обозначенный на афише жанр спектакля — фантасмагория."
                                            },
                                            {
                                                "example_id": "83c12b2a-6019-4bb1-ab32-1f04e8ef88e8",
                                                "sense_id": "f155ad03-08d0-31aa-89b6-e99b4fea0e81",
                                                "text": "Какая быстрая совершается на нём фантасмагория в течение одного только дня!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "36c9583b-43f1-36a8-8ef9-98e6e2525ce1",
                                        "entry_id": "94e8d1bb-28d5-3fbe-b222-02d3855b8446",
                                        "glosses": [
                                            "перен. разг. чепуха, невозможная вещь"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3661539e-4c3d-4298-b643-a8ff5c338100",
                                                "sense_id": "36c9583b-43f1-36a8-8ef9-98e6e2525ce1",
                                                "text": "Это сплошная фантасмагория."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
