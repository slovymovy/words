                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e13438ee-ace9-4029-8df3-89a0d97119cd",
                                "sense_id": "f2b91c5f-7af3-3a53-9aee-ea1dc844505f",
                                "text": "„Es ist in der Folge dieses Werk, das hauptsächlich seinen Ruhm und seine vielzitierte Verruchtheit ausmacht, das ihm den dauerhaften Haß der bürgerlichen Gesellschaft einbringt und verfolgung bis in unsere Zeit.“"
                            },
                            {
                                "example_id": "9ef70f85-724e-4dd8-bce3-078cccb909f0",
                                "sense_id": "f2b91c5f-7af3-3a53-9aee-ea1dc844505f",
                                "text": "„Die brennende Glut der Scham und kalte Schauer des Entsetzens überfallen mich jetzt, da ich jener höllischen Verruchtheit gedenke.“"
                            }
                        ],
