    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "67744b82-83be-3079-b106-9078807f1c8e",
                "word": "hexagon",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "0b2e7e28-0180-40b2-a7a1-b6ac6f280fff",
                        "entry_id": "67744b82-83be-3079-b106-9078807f1c8e",
