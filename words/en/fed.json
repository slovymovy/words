                                "target_lang_word": "la Fed",
                                "target_lang_sense_clarification": "abréviation courante"
                            },
                            {
                                "target_lang_word": "la Réserve fédérale",
                                "target_lang_sense_clarification": "nom officiel"
                            }
                        ]
