                                "sense_id": "2b68fa7e-bd25-3854-a17c-ae421157ccbc",
                                "text": "Ça va faire, le garrochage de roches dans la cour d'école !"
                            },
                            {
                                "example_id": "0274da6f-0f56-4581-b621-4e837b7529cc",
                                "sense_id": "2b68fa7e-bd25-3854-a17c-ae421157ccbc",
