                ],
                "senses": [
                    {
                        "sense_id": "cd6cdfd6-52fe-3d45-9fb4-a2f38cd768ba",
                        "entry_id": "23474bc7-357c-3459-b252-c26188e1a89f",
                        "glosses": [
                            "glückseliger Zustand, der zum Beispiel durch friedvolles Lächeln sichtbar wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d1a00ee-4bd4-4145-ba38-fdf5c057a52e",
                                "sense_id": "cd6cdfd6-52fe-3d45-9fb4-a2f38cd768ba",
                                "text": "Daß solche Verklärung nichts Idyllisches, nicht »heiteres Darüberstehen« meinen kann, hat die Fontaneforschung immer wieder betont,“ und unsere Deutung von »Effi Briest« bestätigt dies."
                            },
                            {
                                "example_id": "c694f4e2-f516-47e4-8501-de725bf2d919",
                                "sense_id": "cd6cdfd6-52fe-3d45-9fb4-a2f38cd768ba",
                                "text": "Er sprach mit gefühlvoller Verklärung von diesem, seinem Gott."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "278f61e3-3368-33ce-8579-85920b1f115a",
                        "entry_id": "23474bc7-357c-3459-b252-c26188e1a89f",
                        "glosses": [
                            "Beschönigung, Darstellung in einem besseren Licht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0735dcff-a0d4-4525-95c7-c1dc01116016",
                                "sense_id": "278f61e3-3368-33ce-8579-85920b1f115a",
                                "text": "Immer wieder treffen wir auf eine romantische Verklärung der eigenen Kindheit."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "1d5dc5dd-9478-31b7-b969-fb9aaf6273ea",
                        "entry_id": "23474bc7-357c-3459-b252-c26188e1a89f",
                        "glosses": [
                            "Verwandlung; im Ausdruck „die Verklärung Jesu“"
                        ],
                        "tags": [
                            "Theologie"
                        ],
                        "examples": [
                            {
                                "example_id": "f27c430d-171d-4465-9692-2f02da9f8386",
                                "sense_id": "1d5dc5dd-9478-31b7-b969-fb9aaf6273ea",
                                "text": "Der Text Mt 17,1−13 wird (ebenso wie Mk 9,2−13 und Lk 9,28−36) traditionell als „Verklärung Jesu“ bezeichnet."
                            },
                            {
                                "example_id": "01001b1b-4cdf-433a-ae7c-7188f69860c4",
                                "sense_id": "1d5dc5dd-9478-31b7-b969-fb9aaf6273ea",
                                "text": "Ruhm und Treue, Königtum und Selbstvertrauen sind die löwenspezifischen Themen, die in diesem Abschnitt des Markus-Evangeliums erforscht werden, am genauesten im Bericht über die Verklärung."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
