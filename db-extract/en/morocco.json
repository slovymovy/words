        "de-extract.jsonl": [
            {
                "entry_id": "17f78738-61d5-3225-8dfc-ada9b9fb8df1",
                "word": "Morocco",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "993ec8f7-502d-3941-a128-977e8bdd814d",
                        "entry_id": "17f78738-61d5-3225-8dfc-ada9b9fb8df1",
                        "glosses": [
                            "Marokko"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3d3a3c25-a746-4512-9c77-858ce3f1126a",
                        "source_entry_id": "17f78738-61d5-3225-8dfc-ada9b9fb8df1",
                        "source_sense_id": "993ec8f7-502d-3941-a128-977e8bdd814d",
                        "source_sense_description": "Marokko",
                        "target_lang_word": "Marokko",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Marokko",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ba9e88be-b8a8-3cf5-a855-28a95d4337a1",
                                        "entry_id": "cad63621-26c5-380d-b261-6c09e9e82208",
                                        "glosses": [
                                            "Staat im Nordwesten von Afrika"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "494773f0-6328-400a-84c8-1db14c02fcb4",
                                                "sense_id": "ba9e88be-b8a8-3cf5-a855-28a95d4337a1",
                                                "text": "Wir fahren im Urlaub nach Marokko."
                                            },
                                            {
                                                "example_id": "cba08a59-ccfb-481c-943c-746e95c8f224",
                                                "sense_id": "ba9e88be-b8a8-3cf5-a855-28a95d4337a1",
                                                "text": "Rabat ist die Hauptstadt von Marokko."
                                            },
                                            {
                                                "example_id": "e385be07-b68e-4909-87a2-508ecf5701ea",
                                                "sense_id": "ba9e88be-b8a8-3cf5-a855-28a95d4337a1",
                                                "text": "„Hier liegen die höchsten Erhebungen des gesamten Atlas-Gebirgssystems, ja ganz Nordafrikas, darunter auch der höchste Berg Marokkos, der Jabal Toubkal (4.167 m).“"
                                            },
                                            {
                                                "example_id": "662633bc-be92-4217-b323-ee10069b2c38",
                                                "sense_id": "ba9e88be-b8a8-3cf5-a855-28a95d4337a1",
                                                "text": "Ob das Marokko des 21. Jahrhunderts modern oder rückständig ist, darüber kann man streiten."
                                            },
                                            {
                                                "example_id": "9e91793a-f0ad-473c-9bd4-9b624ba9b224",
                                                "sense_id": "ba9e88be-b8a8-3cf5-a855-28a95d4337a1",
                                                "text": "„Auf Marokko folgten die Westsahara und dann Mauretanien und der Senegal.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2ecb0cfa-a46f-48b0-828b-ccafa5ab7c7c",
                        "source_entry_id": "17f78738-61d5-3225-8dfc-ada9b9fb8df1",
                        "source_sense_id": "993ec8f7-502d-3941-a128-977e8bdd814d",
                        "source_sense_description": "Marokko",
                        "target_lang_word": "Maroc",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Maroc",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d5dd754d-a70f-3ed5-89f0-6b520aeb3733",
                                        "entry_id": "cae5c4a2-399b-3376-ac40-6067303536c3",
                                        "glosses": [
                                            "Pays d’Afrique du Nord, situé dans l'Ouest du Maghreb entre l’Algérie et l'océan Atlantique et dont la capitale est Rabat."
                                        ],
                                        "tags": [
                                            "Pays"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e79ce017-f7a7-4952-82b3-9dbb72c81b1b",
                                                "sense_id": "d5dd754d-a70f-3ed5-89f0-6b520aeb3733",
                                                "text": "Si certaines industries du Maroc sont technologiquement proches de l’Oldowayen, en l’absence de fouille de sols d’habitat, on ne peut rien dire sur le plan palethnologique du mode de vie de leurs auteurs."
                                            },
                                            {
                                                "example_id": "6c50f8f8-a829-4b05-9c3b-d50d9fc5920d",
                                                "sense_id": "d5dd754d-a70f-3ed5-89f0-6b520aeb3733",
                                                "text": "On sait que « le Maroc », El-Maghrib El-Akça (Extrême-Occident) des Arabes, n’est qu’un terme géographique servant à désigner la vaste région qui s’étend de la frontière algérienne à l’Atlantique et de la Méditerranée au Sahara. Mais ce territoire d’un demi-million de kilomètres carrés de surface, dont la population est estimée à une dizaine de millions d’habitants, est loin d’avoir la cohésion d’un État européen, et l’autorité effective des sultans ne s’est jamais étendue qu’à un tiers, tout au plus, du Maroc."
                                            },
                                            {
                                                "example_id": "ab327a78-1481-4464-a369-a291a9de0fb5",
                                                "sense_id": "d5dd754d-a70f-3ed5-89f0-6b520aeb3733",
                                                "text": "Dès lors, les Sahraouis ne purent se déplacer entre les zones contrôlées par le Maroc que dans des convois militaires. Seuls quelques commerçants de confiance restent autorisés à se rendre aux îles Canaries munis de passeports marocains."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": [
