                "senses": [
                    {
                        "sense_id": "19df9a62-75e3-3619-8801-e40b9989a304",
                        "entry_id": "300592cf-9eb3-3908-9a46-10a36622ab41",
                        "glosses": [
                            "członek starożytnego ludu celtyckiego, którego ziemie podbite zostały przez Rzymian w I w. p.n.e."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": [
                            {
                                "example_id": "7c6cbd76-9dc9-48f8-acde-7534761d8ec3",
                                "sense_id": "19df9a62-75e3-3619-8801-e40b9989a304",
                                "text": "W życiu Helwetów dużą rolę odgrywali kapłani, zwani druidami, rekrutujący się zwykle z czołowych rodów plemienia."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
