                ],
                "senses": [
                    {
                        "sense_id": "0f967b44-9a5a-3f82-861a-70152f69f61f",
                        "entry_id": "30505ffb-e259-33db-92e6-526e0444f51a",
                        "glosses": [
                            "Variante orthographique de chou-fleuriser."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe93df7b-eebc-4623-bffe-1825007534da",
                                "sense_id": "0f967b44-9a5a-3f82-861a-70152f69f61f",
                                "text": "Tout ce que je peux t'accorder, c'est que tout commence ici et se terminera ce soir dans un lit où je vais te choufleuriser ! s'esclaffe-t-il.\n— Me chou... quoi ?!\n— Te choufleuriser. Te mettre l'entrejambe en chou-fleur comme tu dis si joliment."
                            },
                            {
                                "example_id": "a7fd61e3-dcf6-4486-ba97-877abcf38922",
                                "sense_id": "0f967b44-9a5a-3f82-861a-70152f69f61f",
                                "text": "Bien que celui^((le nez)) du caporal commence à choufleuriser. Mais ce type me fait peur. Faudrait pas, qu'en plus, il commence à me draguer ! — (Jacques Hirt , Le fourmi-lion, Éd. RomPol, 2018)"
                            },
                            {
                                "example_id": "e7d28b12-a14c-4e3c-b3cd-e2210ff89c89",
                                "sense_id": "0f967b44-9a5a-3f82-861a-70152f69f61f",
                                "text": "Ses oreilles choufleurisées conservent de beaux restes. Il finit par dénicher une prostituée – une femme, une vraie –, la quarantaine, qui fume une cigarette sur jambe et sous un lampadaire."
                            }
                        ]
                    }
                ],
