                                        "entry_id": "a8006552-6a22-3451-becf-19cdc561e370",
                                        "glosses": [
                                            "The capability of a system to absorb heat energy; the amount of thermal energy required to raise the temperature of a system by one temperature unit without any change of phase."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9a6da9c2-3d7c-437b-99b7-2b68bc6657c0",
                                                "sense_id": "5612a658-215f-3097-9f99-05d39a8e1068",
                                                "text": "500 J introduced to a system caused the temperature of the system to increase by 2 K; thus, the heat capacity is 250 J/K. If the system consists of a single material with a mass of 500 g, the specific heat capacity of that material is 500 J/K/kg."
                                            }
                                        ]
                                    }
                                ]
                            }
