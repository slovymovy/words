                                        "entry_id": "6c041434-c494-3275-858a-9eaf7d428248",
                                        "glosses": [
                                            "Without fingers.",
                                            "Without fingers owing to either a birth defect or amputation."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "76ed036f-ff86-4b68-b603-7ef07ce73b36",
                                                "sense_id": "2977c1b5-2af8-39b2-89f8-47ba43ff9e48",
                                                "text": "born with a fingerless hand"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0c4acf2e-d4fe-3093-b379-a7f48e13a355",
                                        "entry_id": "6c041434-c494-3275-858a-9eaf7d428248",
                                        "glosses": [
                                            "Without fingers.",
                                            "With holes, such that the fingers are not covered."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9058a72f-d4b1-4924-8d6d-42fb4177ff0c",
                                                "sense_id": "0c4acf2e-d4fe-3093-b379-a7f48e13a355",
                                                "text": "fingerless gloves"
                                            },
                                            {
                                                "example_id": "ced6ef52-7f9e-45f3-b3d3-ae26506b3838",
                                                "sense_id": "0c4acf2e-d4fe-3093-b379-a7f48e13a355",
                                                "text": "And while his signature starched collar and fingerless gloves are yet to make an appearance, his looks are already topped off with another of his soon-to-be trademarks: a pair of dark aviator sunglasses."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f40e391b-9c99-4bca-af49-3333a587b1a3",
                        "source_entry_id": "5f3e86a9-f393-3f4a-b8a6-3b82188d3d23",
                        "source_sense_id": "7193e090-74de-3b12-b8e0-f2a318a3599c",
                        "target_lang_word": "fingerlos",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fingerlos",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d1a1766c-cd94-3636-b94d-427e5f4833ab",
                                        "entry_id": "831f9dd0-5914-333b-9621-e6abbf4698d8",
                                        "glosses": [
                                            "ohne Finger, keine Finger habend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec2f5555-e839-4825-b851-33649687b15d",
                                                "sense_id": "d1a1766c-cd94-3636-b94d-427e5f4833ab",
                                                "text": "„Er hätte sich besser den Luxus einiger künstlicher Finger für seine linke Hand gestattet, die völlig fingerlos war, doch schien ihm das keinerlei Verdruss zu bereiten, und seine Wachsohren genügten ihm.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "699400de-a2bf-4be6-851a-060e20c8e94f",
                        "source_entry_id": "5f3e86a9-f393-3f4a-b8a6-3b82188d3d23",
                        "source_sense_id": "7193e090-74de-3b12-b8e0-f2a318a3599c",
                        "target_lang_word": "беспалый",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "беспалый",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "a21a366d-9b67-3d2f-9aa0-4f3ff3d8aacc",
                                        "entry_id": "d2d90830-c659-31ed-82cf-e03e7b3447e5",
                                        "glosses": [
                                            "не имеющий пальца или пальцев"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90d79b26-7615-4c45-84df-36f08f8399bd",
                                                "sense_id": "a21a366d-9b67-3d2f-9aa0-4f3ff3d8aacc",
                                                "text": "❬…❭ Тут было сборище самого непригодного, старого, завалящего хламу, всевозможных родов и качеств: черенья от ножей и вилок, сломанные рамы от картин, битая посуда и стекло, рваные книги, полусгнившие лоскутья, беспалые перчатки, облупившиеся портреты, костыли, изъеденное ржавчиной железо, каска без шишака и так далее .."
                                            },
                                            {
                                                "example_id": "66dd2d89-d576-425d-953e-d0f356afac3d",
                                                "sense_id": "a21a366d-9b67-3d2f-9aa0-4f3ff3d8aacc",
                                                "text": "❬…❭ На прииске Бучинского не любили, и старатели просто называли его беспалым Фомкой, потому что у него на левой руке недоставало одного пальца. ❬…❭"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
