                        "sense_id": "0fa0793f-e6d5-3211-81db-de1d4de78e15",
                        "entry_id": "2d0faa2e-ba0f-36ae-8507-bb897538b598",
                        "glosses": [
                            "pleitbezorger voor ongelijke behandeling van mensen op grond van aangeboren uiterlijke kenmerken of afstamming van een etnische groep"
                        ],
                        "tags": [
                            "person"
                        ],
                        "examples": [
                            {
                                "example_id": "1449a87f-ba87-41d2-9614-f8cd05b6bf9c",
                                "sense_id": "0fa0793f-e6d5-3211-81db-de1d4de78e15",
                                "text": "Vergeleken met hedendaagse normen was Lincoln zeker voor hij president werd, een racist: hij geloofde in de superioriteit van de blanken en wilde niet dat beide rassen op gelijke voet zouden samenleven."
                            },
                            {
                                "example_id": "8cccf18f-79a9-4591-a656-6c90fe4009d5",
                                "sense_id": "0fa0793f-e6d5-3211-81db-de1d4de78e15",
                                "text": "De persoon die in die tijd het dichtst in de buurt van Trump nu kwam was George Wallace, een racist en aanhanger van segregatie, zij het nog altijd minder grof en leugenachtig dan de huidige gekozen president."
                            }
                        ]
                    }
