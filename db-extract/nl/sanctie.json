                        "sense_id": "4cbf5dde-472d-3dd6-928a-e85656eb3395",
                        "entry_id": "0f75a8a8-eb26-37e8-bd54-1502ff418d48",
                        "glosses": [
                            "bekrachtiging of goedkeuring",
                            "sanctie van studie: het geheel van regels waarmee in Vlaanderen een leerjaar of studie wordt afgesloten"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dcd60586-7220-490b-94c6-5f1b48842357",
                        "source_entry_id": "0f75a8a8-eb26-37e8-bd54-1502ff418d48",
                        "source_sense_id": "b7ed999b-a2db-317a-b484-b6c60ace0c81",
