                        "glosses": [
                            "Gruft aus Stein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e81f4dd-3c43-48aa-9527-f8e2e1130365",
                                "sense_id": "1630af1d-c2b3-3678-a2b2-ed3de7ec1268",
                                "text": "„Für mich war nichts Groteskes an den Gebeinen und Gerippen, die auf dem Boden mancher Steingruft tief unten im Fundament verstreut lagen.“"
                            },
                            {
                                "example_id": "4f366e2f-74e8-4648-b045-2fe912e0e0a1",
                                "sense_id": "1630af1d-c2b3-3678-a2b2-ed3de7ec1268",
                                "text": "„Atlantis hatte sich noch nicht aus dem dampfenden Ozean erhoben, als diese niedrigen Steingrüfte mit ihren flachen Dächern errichtet wurden ...“"
                            }
                        ],
                        "sense_index_json": "\"1\""
