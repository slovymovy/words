                "senses": [
                    {
                        "sense_id": "274b70b9-fcc2-35ba-ab63-b74591b6d57a",
                        "entry_id": "4e85dcbd-82e6-387c-931e-153cd9f76270",
                        "glosses": [
                            "Ring, der mit einem oder mehreren Brillanten versehen ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ceddd43b-7ba0-42c9-8406-62c1180d69f6",
                                "sense_id": "274b70b9-fcc2-35ba-ab63-b74591b6d57a",
                                "text": "„Der Chevaliergardist und die Dame mit den Brillantringen haben ihre Tür der Wärme wegen geöffnet.“"
                            },
                            {
                                "example_id": "b13b7ce9-25ab-48fb-b9d0-0b5ea8610bc4",
                                "sense_id": "274b70b9-fcc2-35ba-ab63-b74591b6d57a",
                                "text": "„Der diensttuende Stabsoffizier der Abteilung, ein hübscher, stutzerhaft gekleideter Mann mit einem Brillantring am Zeigefinger, einer der Offiziere, die schlecht, aber gern Französisch sprachen, erbot sich, den Fürsten Andrej zu führen.“"
                            },
                            {
                                "example_id": "7cf4deb7-0e50-41f0-b2b1-956200ed5c27",
                                "sense_id": "274b70b9-fcc2-35ba-ab63-b74591b6d57a",
                                "text": "„Thomas bemerkte, daß Lakuleit drei Brillantringe mit großen Steinen an den Würstchenfingern trug.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
