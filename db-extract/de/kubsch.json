                "senses": [
                    {
                        "sense_id": "557d2475-39b9-3c0c-ae38-113b0774d282",
                        "entry_id": "a960f379-9a45-37d0-bb30-554fce11c3f1",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dab6049e-bb6c-492c-a628-4ace8cbf0eea",
                                "sense_id": "557d2475-39b9-3c0c-ae38-113b0774d282",
                                "text": "Frau Kubsch ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "a78b105d-7462-46ce-8915-0ea6e72012e3",
                                "sense_id": "557d2475-39b9-3c0c-ae38-113b0774d282",
                                "text": "Herr Kubsch wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "2c28d9b4-f9b3-4be0-b212-62832cd13bfe",
                                "sense_id": "557d2475-39b9-3c0c-ae38-113b0774d282",
                                "text": "Die Kubschs fahren heute nach Rotterdam."
                            },
                            {
                                "example_id": "5d92005f-7831-4165-b7e9-60d9302ce1b3",
                                "sense_id": "557d2475-39b9-3c0c-ae38-113b0774d282",
                                "text": "Der Kubsch trägt nie die Pullover, die die Kubsch ihm strickt."
                            },
                            {
                                "example_id": "ef8bdff0-e1c6-4b9a-8e47-7741f832ac6d",
                                "sense_id": "557d2475-39b9-3c0c-ae38-113b0774d282",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Kubsch kommt, geht der Herr Kubsch.“"
                            },
                            {
                                "example_id": "55a74dcb-82dc-437d-bb96-d24a102c9d8b",
                                "sense_id": "557d2475-39b9-3c0c-ae38-113b0774d282",
                                "text": "Kubsch kommt und geht."
                            },
                            {
                                "example_id": "9d0948bf-a0a0-4e80-a5c6-e71cd3830060",
                                "sense_id": "557d2475-39b9-3c0c-ae38-113b0774d282",
                                "text": "Kubschs kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
