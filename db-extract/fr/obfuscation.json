                ],
                "senses": [
                    {
                        "sense_id": "e269e0b2-80c5-3acf-9441-ae02e49c51a4",
                        "entry_id": "620f9300-f934-34c0-898e-430e120b66ef",
                        "glosses": [
                            "Stratégie de protection de la vie privée sur internet qui consiste à publier des informations fausses ou imprécises de manière à dissimuler les informations pertinentes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f4e7174-033b-4ca9-8f93-74cb30808ab7",
                                "sense_id": "e269e0b2-80c5-3acf-9441-ae02e49c51a4",
                                "text": "Selon Finn Brunton, coauteur d’un ouvrage sur l’obfuscation et d’une histoire des spams, les données que nous générons sans le savoir créent autour de nous des doubles fantomatiques. Ils racontent tout de nous : notre grossesse, notre orientation sexuelle, nos parti-pris militants …"
                            }
                        ]
                    },
                    {
                        "sense_id": "4bebde5d-adf1-3d67-8abd-96c9cc544f9a",
                        "entry_id": "620f9300-f934-34c0-898e-430e120b66ef",
                        "glosses": [
                            "Technique qui consiste à rendre illisible pour un humain un programme, tout en le gardant pleinement fonctionnel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "72d53dba-72eb-4063-89a7-563dec78b19f",
                                "sense_id": "4bebde5d-adf1-3d67-8abd-96c9cc544f9a",
                                "text": "Grâce à une série d' obfuscation complexe de code, le processus de construction de liblzma extrait un fichier objet préconstruit d'un fichier de test déguisé existant dans le code source, qui est ensuite utilisé pour modifier des fonctions spécifiques dans le code liblzma. Il en résulte une bibliothèque liblzma modifiée, qui peut être utilisée par tout logiciel lié à cette bibliothèque, interceptant et modifiant l'interaction des données avec cette bibliothèque."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "80ec2184-4cad-4f89-89fb-18297e9c1e26",
                        "source_entry_id": "620f9300-f934-34c0-898e-430e120b66ef",
                        "target_lang_word": "obfuscation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "obfuscation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2f5fe75d-0cb7-39db-87f8-848c38541f55",
                                        "entry_id": "3cf1c94b-9f5d-3765-8d7d-4b7045ef1b4f",
                                        "glosses": [
                                            "The act or process of obfuscating, or obscuring the perception of something; the concept of concealing the meaning of a communication by making it more confusing and harder to interpret."
                                        ],
                                        "tags": [
                                            "formal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cf687866-f791-4fdc-9509-f632900d9d6f",
                                                "sense_id": "2f5fe75d-0cb7-39db-87f8-848c38541f55",
                                                "text": "Until the 1920s, American newspapers heavily relied upon their London correspondents, the British Press and Reuters (which had a mutually beneficial, monopoly agreement with the Government of India for preferential access) for news about India. The news was hence generally from the British perspective and news obfuscation attempts on events that cast the Raj in a poor light, like details of the Jallianwala Bagh massacre, usually succeeded."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cbbf6102-5b8c-345c-a30d-3ca4c91c03a7",
                                        "entry_id": "3cf1c94b-9f5d-3765-8d7d-4b7045ef1b4f",
                                        "glosses": [
                                            "The act or process of obfuscating, or obscuring the perception of something; the concept of concealing the meaning of a communication by making it more confusing and harder to interpret.",
                                            "The alteration of computer code to preserve its behavior while concealing its structure and intent."
                                        ],
                                        "tags": [
                                            "formal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da78062e-b0b2-46be-bb46-e2db370ded98",
                                                "sense_id": "cbbf6102-5b8c-345c-a30d-3ca4c91c03a7",
                                                "text": "You need to turn on obfuscation for these classes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7b8d28a3-503e-319e-9b4c-5daf7960f83e",
                                        "entry_id": "3cf1c94b-9f5d-3765-8d7d-4b7045ef1b4f",
                                        "glosses": [
                                            "Confusion, bewilderment, or a baffled state resulting from something obfuscated, or made more opaque and muddled with the intent to obscure information."
                                        ],
                                        "tags": [
                                            "formal",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ae0d48e2-0796-3efd-ab12-7e27016153d0",
                                        "entry_id": "3cf1c94b-9f5d-3765-8d7d-4b7045ef1b4f",
                                        "glosses": [
                                            "A single instance of intentionally obscuring the meaning of something to make it more difficult to grasp."
                                        ],
                                        "tags": [
                                            "countable",
                                            "formal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ecb65b34-c3ca-4bfd-8f1c-09800ddae10b",
                                                "sense_id": "ae0d48e2-0796-3efd-ab12-7e27016153d0",
                                                "text": "During the debate, the candidate sighed at his opponent's obfuscations."
                                            }
