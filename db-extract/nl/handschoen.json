                ],
                "senses": [
                    {
                        "sense_id": "47c194b3-0830-3b4e-8da8-172f08b836c5",
                        "entry_id": "56a40b2c-6e73-3475-9104-76f167a64db9",
                        "glosses": [
                            "een handkledingstuk met aparte vingers"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "741d772e-a14d-4ac8-8e33-0cbf7d4994a6",
                                "sense_id": "47c194b3-0830-3b4e-8da8-172f08b836c5",
                                "text": "Verdorie, ik ben mijn handschoenen vergeten mee te nemen."
                            },
                            {
                                "example_id": "92088c62-f753-49fe-8187-44f9e3990f46",
                                "sense_id": "47c194b3-0830-3b4e-8da8-172f08b836c5",
                                "text": "Er viel as van mijn sigaret op mijn pantalon terwijl ik de naam van die stad uitsprak. Hij had het gezien en voordat ik kon protesteren, had hij een van zijn witte handschoenen uitgetrokken en wijdde hij zich met volledige aandacht aan het werkje om mijn broekspijp daarmee af te kloppen. Hij had magere, donkere handen."
                            },
                            {
                                "example_id": "14d5e113-a340-4f32-8b1e-49495b312e73",
                                "sense_id": "47c194b3-0830-3b4e-8da8-172f08b836c5",
                                "text": "Met een doorrookte stem vertelde hij me dat zijn paarden in deze hitte vijftig liter per dag nodig hadden. ‘Ze hebben een temperamentje, net als mijn vrouw!’ Hij aaide de schimmel over zijn neus, die in de handschoen van de man probeerde te bijten."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "da03065b-5ffa-4cb7-bf81-5f5aecac24e1",
                        "source_entry_id": "56a40b2c-6e73-3475-9104-76f167a64db9",
                        "source_sense_id": "47c194b3-0830-3b4e-8da8-172f08b836c5",
                        "source_sense_description": "een handkledingstuk met aparte vingers",
                        "target_lang_word": "Handschuh",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Handschuh",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "12246dc9-113a-3ac3-9e54-3a18e414ee59",
                                        "entry_id": "fd04bca5-fb9a-31fb-b1c1-50127d2f7633",
                                        "glosses": [
                                            "Kleidungsstück, das Hand und Finger bedeckt, wärmt oder schützt; aus den verschiedensten Materialien, zum Beispiel Leder, Wolle, Metall, Satin und für die verschiedensten Zwecke, zum Beispiel als Arbeitshandschuhe oder Ballhandschuhe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30fe6bb5-be10-432f-8214-7bf280748393",
                                                "sense_id": "12246dc9-113a-3ac3-9e54-3a18e414ee59",
                                                "text": "„Missmutig tasten sie uns mit Handschuhen ab und bedeuten uns, dass wir weitergehen können.“"
                                            },
                                            {
                                                "example_id": "649a4b68-6023-4a41-a03f-9b3baef61482",
                                                "sense_id": "12246dc9-113a-3ac3-9e54-3a18e414ee59",
                                                "text": "Zieh dir lieber Handschuhe an, es ist kalt draußen."
                                            },
                                            {
                                                "example_id": "f90ee1da-18b0-4480-8f94-a1a38979ca69",
                                                "sense_id": "12246dc9-113a-3ac3-9e54-3a18e414ee59",
                                                "text": "Jetzt habe ich schon wieder meine Handschuhe liegen lassen."
                                            },
                                            {
                                                "example_id": "156f814d-7357-4ad9-ae82-ec1decc286c4",
                                                "sense_id": "12246dc9-113a-3ac3-9e54-3a18e414ee59",
                                                "text": "„Da fällt von des Altans Rand | Ein Handschuh von schöner Hand | Zwischen den Tiger und den Leun | Mitten hinein.“"
                                            },
                                            {
                                                "example_id": "702cd8e3-d721-4df6-af82-77b1aa95c43d",
                                                "sense_id": "12246dc9-113a-3ac3-9e54-3a18e414ee59",
                                                "text": "Ihre Handschuhe passen farblich perfekt zu ihrem Kleid."
                                            },
                                            {
                                                "example_id": "f626a541-6656-4f3d-9fd8-671402f05a8b",
                                                "sense_id": "12246dc9-113a-3ac3-9e54-3a18e414ee59",
                                                "text": "Küsst ein Herr die Hand einer Dame, so darf diese ihre Handschuhe anbehalten."
                                            },
                                            {
                                                "example_id": "ce02f4c0-c396-4cbb-bc11-beff7d62db43",
                                                "sense_id": "12246dc9-113a-3ac3-9e54-3a18e414ee59",
                                                "text": "„Da lag der Handschuh am Straßenrand im Schneematsch.“"
                                            },
                                            {
                                                "example_id": "81391e75-2c91-43fd-8664-d72d19878325",
                                                "sense_id": "12246dc9-113a-3ac3-9e54-3a18e414ee59",
                                                "text": "„Ohne Handschuhe konnte sie vom Handschweiß beschmutzt werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cba40618-b803-4454-84e6-d2345b6e8cac",
                        "source_entry_id": "56a40b2c-6e73-3475-9104-76f167a64db9",
