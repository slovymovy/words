{
    "word_family": [
        "sprigged",
        "spriggy"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "eea72bf0-2e45-3a13-a811-8c2f2f3acf8c",
                    "sense_definition": "A small stem or part of a plant with leaves or flowers, often used for cooking or decoration.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "plant_part",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The chef garnished the soup with a fresh <w>sprig</w> of parsley.",
                            "target_lang_translations": {
                                "ru": "Шеф-повар украсил суп свежей <w>веточкой</w> петрушки.",
                                "de": "Der Koch garnierte die Suppe mit einem frischen <w>Zweiglein</w> Petersilie."
                            }
                        },
                        {
                            "text": "She placed a small <w>sprig</w> of lavender in the vase on her desk.",
                            "target_lang_translations": {
                                "ru": "Она поставила маленькую <w>веточку</w> лаванды в вазу на своем столе.",
                                "de": "Sie stellte ein kleines <w>Zweiglein</w> Lavendel in die Vase auf ihrem Schreibtisch."
                            }
                        }
                    ],
                    "synonyms": [
                        "shoot",
                        "spray",
                        "twig"
                    ],
                    "common_phrases": [
                        "sprig of parsley",
                        "sprig of mint",
                        "sprig of thyme",
                        "sprig of rosemary",
                        "sprig of holly"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшой стебель или часть растения с листьями или цветами, часто используемые в кулинарии или для украшения.",
                        "de": "Ein kleiner Stängel oder Teil einer Pflanze mit Blättern oder Blüten, oft zum Kochen oder als Dekoration verwendet."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ве́точка",
                                "target_lang_sense_clarification": "часть растения"
                            },
                            {
                                "target_lang_word": "побе́г",
                                "target_lang_sense_clarification": "ботанический термин"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Zweiglein",
                                "target_lang_sense_clarification": "kleiner Zweig"
                            },
                            {
                                "target_lang_word": "Zweig",
                                "target_lang_sense_clarification": "Pflanzenteil"
                            },
                            {
                                "target_lang_word": "Spross",
                                "target_lang_sense_clarification": "Pflanzentrieb"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1214a95b-11bc-3354-a6a1-7cea61aea9d7",
                    "sense_definition": "A decorative pattern, design, or object shaped like a small plant stem.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "decoration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The wallpaper featured a delicate floral <w>sprig</w> repeated every few inches.",
                            "target_lang_translations": {
                                "ru": "На обоях был изображен нежный цветочный <w>узор в виде веточки</w>, повторяющийся каждые несколько дюймов.",
                                "de": "Die Tapete wies ein zartes blumiges <w>Zweigmuster</w> auf, das sich alle paar Zentimeter wiederholte."
                            }
                        },
                        {
                            "text": "She wore a dress embroidered with a silver <w>sprig</w> on the collar.",
                            "target_lang_translations": {
                                "ru": "На ней было платье с вышитой серебряной <w>веточкой</w> на воротнике.",
                                "de": "Sie trug ein Kleid, das am Kragen mit einem silbernen <w>Zweigmotiv</w> bestickt war."
                            }
                        }
                    ],
                    "synonyms": [
                        "motif"
                    ],
                    "target_lang_definitions": {
                        "ru": "Декоративный узор, рисунок или предмет в форме небольшого стебля растения.",
                        "de": "Ein dekoratives Muster, Design oder Objekt in Form eines kleinen Pflanzenstängels."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "узор в виде веточки",
                                "target_lang_sense_clarification": "орнамент"
                            },
                            {
                                "target_lang_word": "веточка",
                                "target_lang_sense_clarification": "элемент декора"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Zweigmuster",
                                "target_lang_sense_clarification": "Muster oder Ornament"
                            },
                            {
                                "target_lang_word": "Zweigmotiv",
                                "target_lang_sense_clarification": "dekoratives Element"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2f4e74e6-1310-3251-b5a4-d551b474c8fa",
                    "sense_definition": "A small nail without a head, often used in woodworking or shoemaking.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "hardware",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The carpenter used a <w>sprig</w> to hold the thin molding in place.",
                            "target_lang_translations": {
                                "ru": "Плотник использовал <w>шпильку</w>, чтобы закрепить тонкий молдинг.",
                                "de": "Der Tischler verwendete einen <w>Stift</w>, um die dünne Leiste an Ort und Stelle zu halten."
                            }
                        },
                        {
                            "text": "He hammered a tiny <w>sprig</w> into the heel of the boot.",
                            "target_lang_translations": {
                                "ru": "Он забил крошечный <w>гвоздик</w> в каблук ботинка.",
                                "de": "Er schlug einen winzigen <w>Stift</w> in den Absatz des Stiefels."
                            }
                        }
                    ],
                    "synonyms": [
                        "brad"
                    ],
                    "target_lang_definitions": {
                        "ru": "Маленький гвоздь без шляпки, часто используемый в столярном или сапожном деле.",
                        "de": "Ein kleiner Stift oder Nagel ohne Kopf, der oft in der Tischlerei oder Schuhmacherei verwendet wird."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шпилька",
                                "target_lang_sense_clarification": "крепеж без шляпки"
                            },
                            {
                                "target_lang_word": "гвоздик без шляпки",
                                "target_lang_sense_clarification": "столярный или сапожный"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Stift",
                                "target_lang_sense_clarification": "kopfloser Nagel"
                            },
                            {
                                "target_lang_word": "Drahtstift",
                                "target_lang_sense_clarification": "kleiner Nagel ohne Kopf"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1f5d5f3e-4802-3fce-b978-b2e91028d320",
                    "sense_definition": "A young person, especially a young man.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old man thought the boy was just an arrogant young <w>sprig</w>.",
                            "target_lang_translations": {
                                "ru": "Старик считал мальчика просто высокомерным <w>юнцом</w>.",
                                "de": "Der alte Mann hielt den Jungen nur für einen arroganten <w>jungen Hüpfer</w>."
                            }
                        },
                        {
                            "text": "He is a mere <w>sprig</w> compared to the experienced veterans in the room.",
                            "target_lang_translations": {
                                "ru": "Он сущий <w>мальчишка</w> по сравнению с опытными ветеранами в этой комнате.",
                                "de": "Verglichen mit den erfahrenen Veteranen im Raum ist er ein bloßer <w>junger Hüpfer</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "lad",
                        "youth",
                        "stripling"
                    ],
                    "common_phrases": [
                        "young sprig"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Молодой человек, юноша (часто с оттенком иронии или пренебрежения).",
                        "de": "Ein junger Mensch, insbesondere ein junger Mann."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "юнец",
                                "target_lang_sense_clarification": "молодой человек"
                            },
                            {
                                "target_lang_word": "о́тпрыск",
                                "target_lang_sense_clarification": "потомок, иронично"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "junger Hüpfer",
                                "target_lang_sense_clarification": "umgangssprachlich, leicht spöttisch"
                            },
                            {
                                "target_lang_word": "Spross",
                                "target_lang_sense_clarification": "Nachkomme oder junger Mensch"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5922372f-a562-3937-a3cf-cc6eaecd6ac9",
                    "sense_definition": "To decorate material, such as fabric or pottery, with patterns of small plant stems.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "decorate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artisan <w>sprigged</w> the ceramic vase with tiny clay leaves.",
                            "target_lang_translations": {
                                "ru": "Ремесленник <w>украсил</w> керамическую вазу крошечными глиняными листьями.",
                                "de": "Der Kunsthandwerker <w>verzierte</w> die Keramikvase mit winzigen Tonblättern."
                            }
                        },
                        {
                            "text": "They <w>sprigged</w> the white muslin with blue flowers for a summer look.",
                            "target_lang_translations": {
                                "ru": "Они <w>расшили</w> белый муслин синими цветами для летнего образа.",
                                "de": "Für einen sommerlichen Look <w>bestickten</w> sie den weißen Nesseltuchstoff mit blauen Blumen."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Украшать материал (ткань или керамику) узорами из небольших растительных стеблей.",
                        "de": "Material wie Stoff oder Keramik mit Mustern kleiner Pflanzenstängel dekorieren."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "украшать узором из веточек",
                                "target_lang_sense_clarification": "декорирование"
                            },
                            {
                                "target_lang_word": "расшивать веточками",
                                "target_lang_sense_clarification": "о ткани"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "mit Zweigmustern verzieren",
                                "target_lang_sense_clarification": "Dekoration von Stoff oder Keramik"
                            },
                            {
                                "target_lang_word": "mit Blütenzweigen besticken",
                                "target_lang_sense_clarification": "Textilgestaltung"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "78330ec5-1584-32ec-b57a-f47e6bb26058",
                    "sense_definition": "To fasten the sole of a shoe using small headless nails.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "shoemaking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cobbler <w>sprigged</w> the heavy boots to ensure they would last.",
                            "target_lang_translations": {
                                "ru": "Сапожник <w>подбил гвоздиками</w> тяжелые ботинки, чтобы они служили дольше.",
                                "de": "Der Schuster <w>stiftete</w> die schweren Stiefel, um sicherzustellen, dass sie hielten."
                            }
                        },
                        {
                            "text": "He learned how to <w>sprig</w> a sole securely during his apprenticeship.",
                            "target_lang_translations": {
                                "ru": "Во время обучения он научился надежно <w>прибивать</w> подошву.",
                                "de": "Während seiner Lehre lernte er, wie man eine Sohle sicher <w>stiftet</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прикреплять подошву обуви с помощью маленьких гвоздей без шляпок.",
                        "de": "Die Sohle eines Schuhs mit kleinen kopflosen Nägeln befestigen."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прибивать гвоздиками",
                                "target_lang_sense_clarification": "сапожное дело"
                            },
                            {
                                "target_lang_word": "крепить шпильками",
                                "target_lang_sense_clarification": "ремонт обуви"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "stiften",
                                "target_lang_sense_clarification": "mit kleinen Nägeln befestigen"
                            },
                            {
                                "target_lang_word": "beipfropfen",
                                "target_lang_sense_clarification": "Schuhmacherhandwerk"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}