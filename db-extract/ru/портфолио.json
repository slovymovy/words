                        "cross_references": [
                            {
                                "target_word": "Portefeuille",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1c773ec3-413d-361e-b9c8-f219f5f6db1b",
                                        "entry_id": "8cc03512-6953-3f96-be87-ba80f9bc2f66",
                                        "glosses": [
                                            "Mappe, meist eine Zusammenfassung der bisherigen Leistungen, üblich als Arbeitsprobe bei Journalisten und Künstlern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04d970e4-ce2b-48f7-abc1-479c9060c3a2",
                                                "sense_id": "1c773ec3-413d-361e-b9c8-f219f5f6db1b",
                                                "text": "Es wäre gut, wenn Sie zu dem Termin mit Professor Rauschenbach ihr Portefeuille mitbringen."
                                            },
                                            {
                                                "example_id": "5135cf84-205a-428b-baee-76e79cd02795",
                                                "sense_id": "1c773ec3-413d-361e-b9c8-f219f5f6db1b",
                                                "text": "„Es war nichts zu hören als das Geräusch des erbitterten Ringens um das Portefeuille.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ec7fc4e0-b453-33f2-b846-94e598d65557",
                                        "entry_id": "8cc03512-6953-3f96-be87-ba80f9bc2f66",
                                        "glosses": [
                                            "Amtsbereich, Geschäftsbereich, zum Beispiel eines Ministers"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "099bbe89-22a3-409f-8783-3126115d4212",
                                                "sense_id": "ec7fc4e0-b453-33f2-b846-94e598d65557",
                                                "text": "Als Minister ohne Portefeuille ist er zwar Regierungsmitglied, aber eben doch mit einem anderen Gewicht, als seine Kollegen und Kolleginnen mit einem klar umgrenzten Aufgabenbereich."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "d1fffe61-af14-34be-a285-f6578121ea0b",
                                        "entry_id": "8cc03512-6953-3f96-be87-ba80f9bc2f66",
                                        "glosses": [
                                            "Gesamtbestand an Wertpapieren"
                                        ],
                                        "tags": [
                                            "Bankwesen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bfef01fe-f774-4bc7-a0cb-dbb9f8dc1ace",
                                                "sense_id": "d1fffe61-af14-34be-a285-f6578121ea0b",
                                                "text": "Zum Portefeuille der Privatbank gehören auch Schuldverschreibungen Griechenlands."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
