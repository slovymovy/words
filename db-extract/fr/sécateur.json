                                        "sense_id": "fa05e627-bd4e-352a-ac00-c2c081fb9be3",
                                        "entry_id": "633a7a03-e249-3e27-9316-7fedb1e95e69",
                                        "glosses": [
                                            "Gartengerät mit langen Griffen zum Schneiden einer Hecke"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a32265b8-ddff-440c-81a7-9bac3b2c59bb",
                                                "sense_id": "fa05e627-bd4e-352a-ac00-c2c081fb9be3",
                                                "text": "Mit meiner Heckenschere schneide ich regelmäßig meine Hecke."
                                            },
                                            {
                                                "example_id": "3ec0157c-5e57-4fa7-b79e-b95aeb8b78b3",
                                                "sense_id": "fa05e627-bd4e-352a-ac00-c2c081fb9be3",
                                                "text": "„Im Bois de Païolive überrascht der Papa die Mama mit einer Heckenschere, die er aus seiner Umhängetasche holt und von der sie nicht einmal wußte, daß er sie mit in den Urlaub genommen hat.“"
                                            },
                                            {
                                                "example_id": "9f1d9df5-d712-45f5-bc6b-60f8b20c2814",
                                                "sense_id": "fa05e627-bd4e-352a-ac00-c2c081fb9be3",
                                                "text": "„In der Ferne sah ich Jeans Gärtner mit einer Heckenschere in der Hand zwischen den Spalier stehenden Weinreben verschwinden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
