                "senses": [
                    {
                        "sense_id": "d63f6bd1-2adf-3063-ab46-86b849ff72ad",
                        "entry_id": "66b9af3e-c409-3735-8a4d-55420e6c6fd4",
                        "glosses": [
                            "kleiner Stempel zum Entwerten oder Markieren eines Briefes oder ähnlicher Sendungen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c3949289-2075-4c1d-b35a-c2c2a0e09b96",
                                "sense_id": "d63f6bd1-2adf-3063-ab46-86b849ff72ad",
                                "text": "„Die Handstempel wurden von den jeweiligen anglikanischen Inselpastoren, die bis 1952 in Personalunion auch die Funktion des Postmeisters ausübten, verwahrt und verwendet.“"
                            },
                            {
                                "example_id": "4cdfef00-4260-4b03-abba-801eb5d9938c",
                                "sense_id": "d63f6bd1-2adf-3063-ab46-86b849ff72ad",
                                "text": "„Außer dem Handstempel wurde 1934 in Stuttgart für eingehende Luftpost auch ein schöner Rollstempel verwendet, von dem ich derzeit nur einen nicht ganz perfekten Abschlag (oben Briefmitte) zeigen kann.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
