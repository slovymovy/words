                            {
                                "target_lang_word": "супер",
                                "target_lang_sense_clarification": "очень"
                            },
                            {
                                "target_lang_word": "очень",
                                "target_lang_sense_clarification": "высокая степень"
                            },
                            {
                                "target_lang_word": "безумно",
                                "target_lang_sense_clarification": "крайне"
                            }
                        ],
                        "zh": [
