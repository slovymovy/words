                ],
                "senses": [
                    {
                        "sense_id": "9b68ea45-8422-3779-8411-348f8b2abde5",
                        "entry_id": "ddc5a826-f4ac-308f-bb15-ab0542d98fb2",
                        "glosses": [
                            "Annahme fremder Kultur, Angleichung an fremde Kultur"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c3e39e7-8896-4038-bf76-251a25b8bb68",
                                "sense_id": "9b68ea45-8422-3779-8411-348f8b2abde5",
                                "text": "„Im Laufe der Zeit kam es zu einer Akkulturation der eingewanderten Westsemiten, wenn auch nicht in demselben Ausmaß wie rund 1000 Jahre früher im Falle der Amurriter.“"
                            },
                            {
                                "example_id": "e2a72c11-7004-442d-82ad-1bfcf3fe0620",
                                "sense_id": "9b68ea45-8422-3779-8411-348f8b2abde5",
                                "text": "„In der zweiten Hälfte des 19. Jahrhunderts gingen die Auseinandersetzungen zwischen Misnagdim und Chassidim zurück, weil beide Gruppen sich gleichermaßen von den Kräften der allgemeinen Modernisierung und der beginnenden Akkulturation an die Welt der Nichtjuden bedroht sahen.“"
                            },
                            {
                                "example_id": "36ba53fa-4dbb-4c04-b001-61aa1ab8872b",
                                "sense_id": "9b68ea45-8422-3779-8411-348f8b2abde5",
                                "text": "„Die vorliegende Abhandlung befasst sich mit dieser aktuellen Thematik und durchleuchtet nicht nur die Akkulturation und das neue Leben von unbegleiteten minderjährigen Flüchtlingen im Aufnahmeland Deutschland, sondern befasst sich auch mit ihren Förderungsmöglichkeiten und der interkulturellen Kompetenz.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4bc9161d-1d43-4456-b34f-3427317b9727",
