{
    "word_family": [
        "тянуть",
        "тяга",
        "тяжесть",
        "тяжёлый",
        "натяжение",
        "растяжка",
        "стягивание"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3fa5a759-e669-3523-8bca-28ae55117b72",
                    "sense_definition": "Туго соединить концы чего-либо, завязывая или закрепляя их.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "tightening",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Перед выходом на улицу нужно <w>затянуть</w> шнурки на ботинках.",
                            "target_lang_translations": {
                                "de": "Bevor man nach draußen geht, muss man die Schnürsenkel an den Schuhen <w>festziehen</w>."
                            }
                        },
                        {
                            "text": "Чтобы узел не развязался, его следует крепко <w>затянуть</w>.",
                            "target_lang_translations": {
                                "de": "Damit sich der Knoten nicht löst, sollte man ihn fest <w>festziehen</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "завязать",
                        "закрепить"
                    ],
                    "antonyms": [
                        "ослабить",
                        "развязать"
                    ],
                    "common_phrases": [
                        "затянуть узел",
                        "затянуть пояс"
                    ],
                    "target_lang_definitions": {
                        "de": "Etwas festziehen, indem man es verknotet oder fixiert."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "festziehen",
                                "target_lang_sense_clarification": "allgemein für Knoten, Schrauben oder Schnürsenkel"
                            },
                            {
                                "target_lang_word": "schnüren",
                                "target_lang_sense_clarification": "speziell für Schnürsenkel oder Korsetts"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2e0f0bc9-68d0-3521-8f19-28270c70c885",
                    "sense_definition": "Покрыться чем-либо (о ране, поверхности воды или земли).",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "covering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Неглубокая царапина на руке быстро <w>затянулась</w>.",
                            "target_lang_translations": {
                                "de": "Der kleine Kratzer an der Hand ist schnell <w>verheilt</w>."
                            }
                        },
                        {
                            "text": "Пруд за лето <w>затянуло</w> тиной.",
                            "target_lang_translations": {
                                "de": "Der Teich ist über den Sommer mit Algen <w>überwachsen</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "зажить",
                        "покрыться"
                    ],
                    "common_phrases": [
                        "рану затянуло",
                        "затянуло тиной"
                    ],
                    "target_lang_definitions": {
                        "de": "Sich mit etwas überziehen oder zuwachsen (von Wunden, Oberflächen)."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "verheilen",
                                "target_lang_sense_clarification": "bei Wunden"
                            },
                            {
                                "target_lang_word": "überwachsen",
                                "target_lang_sense_clarification": "bei Oberflächen wie Teichen oder Erde"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "28c5b2d3-7763-3770-be59-45c2a25f2ad5",
                    "sense_definition": "Неоправданно увеличить время выполнения чего-либо.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "delay",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Строители сильно <w>затянули</w> сроки сдачи объекта.",
                            "target_lang_translations": {
                                "de": "Die Bauarbeiter haben die Fertigstellungstermine stark <w>hinausgezögert</w>."
                            }
                        },
                        {
                            "text": "Не стоит <w>затягивать</w> решение этого важного вопроса.",
                            "target_lang_translations": {
                                "de": "Man sollte die Entscheidung in dieser wichtigen Angelegenheit nicht <w>hinauszögern</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "отложить",
                        "задержать"
                    ],
                    "antonyms": [
                        "ускорить"
                    ],
                    "common_phrases": [
                        "затянуть сроки",
                        "затянуть дело"
                    ],
                    "target_lang_definitions": {
                        "de": "Die Dauer einer Tätigkeit unnötig in die Länge ziehen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "hinauszögern",
                                "target_lang_sense_clarification": "einen Prozess verzögern"
                            },
                            {
                                "target_lang_word": "in die Länge ziehen",
                                "target_lang_sense_clarification": "etwas unnötig verlängern"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1f6d0a6e-9dc1-3f66-9b8b-379b84616b96",
                    "sense_definition": "Сильно увлечь, заинтересовать кого-либо.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "engross",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Эта компьютерная игра меня полностью <w>затянула</w>.",
                            "target_lang_translations": {
                                "de": "Dieses Computerspiel hat mich völlig <w>gefesselt</w>."
                            }
                        },
                        {
                            "text": "Сюжет книги был таким интересным, что она сразу <w>затянула</w> читателя.",
                            "target_lang_translations": {
                                "de": "Die Handlung des Buches war so interessant, dass sie den Leser sofort <w>gefesselt</w> hat."
                            }
                        }
                    ],
                    "synonyms": [
                        "увлечь",
                        "заинтересовать"
                    ],
                    "common_phrases": [
                        "затянуло в процесс"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "часто используется в разговорной речи"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Jemanden stark fesseln oder in eine Tätigkeit hineinziehen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "fesseln",
                                "target_lang_sense_clarification": "jemandes Aufmerksamkeit stark binden"
                            },
                            {
                                "target_lang_word": "mitreißen",
                                "target_lang_sense_clarification": "jemanden emotional oder aktiv einbeziehen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "90827a17-7349-3221-9830-44431eba5b08",
                    "sense_definition": "Начать петь протяжно или монотонно.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "singing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "После нескольких рюмок гость <w>затянул</w> свою любимую народную песню.",
                            "target_lang_translations": {
                                "de": "Nach ein paar Gläsern Schnaps hat der Gast sein Lieblingsvolkslied <w>angestimmt</w>."
                            }
                        },
                        {
                            "text": "Он снова <w>затянул</w> старую песню о своих былых успехах.",
                            "target_lang_translations": {
                                "de": "Er hat wieder sein altes Lied von seinen früheren Erfolgen <w>angestimmt</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "запеть"
                    ],
                    "common_phrases": [
                        "затянуть песню"
                    ],
                    "target_lang_definitions": {
                        "de": "Anfangen, etwas langgezogen oder monoton zu singen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "anstimmen",
                                "target_lang_sense_clarification": "mit dem Singen beginnen"
                            },
                            {
                                "target_lang_word": "anheben",
                                "target_lang_sense_clarification": "gehoben für das Anstimmen eines Liedes"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}