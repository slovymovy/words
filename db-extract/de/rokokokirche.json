                                "example_id": "364b9d5c-dc62-4d0d-9f8b-75f76e046b98",
                                "sense_id": "f8444f1b-3fb7-3a52-87a1-27c29a6283a2",
                                "text": "„In der kleinen Rokokokirche in der Krolewska beten die Visitandinerinnen auf polnisch vor den vom Weihrauch der Jahrhunderte geschwärzten Marien.“"
                            },
                            {
                                "example_id": "4288aa51-c25a-4089-943a-bc3bb0cfff14",
                                "sense_id": "f8444f1b-3fb7-3a52-87a1-27c29a6283a2",
                                "text": "„Fast genau 30 Jahre nach der Tragödie läuft Ried durch eine Rokokokirche nicht weit vom Unglückssee.“"
                            }
                        ],
