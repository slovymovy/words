                                "target_senses": [
                                    {
                                        "sense_id": "00eb4707-b866-3555-90cb-30343420185b",
                                        "entry_id": "3651a114-4bb1-3da4-b111-36062f7fdbfd",
                                        "glosses": [
                                            "etwas herstellen, ein Produkt erschaffen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7d498de7-e806-40b4-aa98-a7439c29cf8c",
                                                "sense_id": "00eb4707-b866-3555-90cb-30343420185b",
                                                "text": "Die Fabrik produziert Reifen für Baumaschinen."
                                            },
                                            {
                                                "example_id": "4d6ca77c-32ee-410a-b848-56e00592c5d0",
                                                "sense_id": "00eb4707-b866-3555-90cb-30343420185b",
                                                "text": "„Blumen produzieren Pollenkörner. Sie sind klein und leicht und einige von ihnen so geformt, dass sie über lange Entfernungen durch die Luft treiben können.“"
                                            },
                                            {
                                                "example_id": "7594fa46-8732-4abe-8815-8763236fec6c",
                                                "sense_id": "00eb4707-b866-3555-90cb-30343420185b",
                                                "text": "Die Drüse produziert das Hormon."
                                            },
                                            {
                                                "example_id": "07948fa3-8f95-45c3-89a0-15e8d8fea2e5",
                                                "sense_id": "00eb4707-b866-3555-90cb-30343420185b",
                                                "text": "„Heute werden jährlich Millionen Tonnen Hefe produziert.“"
                                            },
                                            {
                                                "example_id": "8e951dc1-cb2c-4ce8-a82a-7edde2340c2c",
                                                "sense_id": "00eb4707-b866-3555-90cb-30343420185b",
                                                "text": "[…] „Mal produzieren Wind und Sonne große Überschüsse, die das Netz überlasten; mal so wenig, dass wir vorübergehend zu wenig Strom zur Verfügung hätten.“"
                                            },
                                            {
                                                "example_id": "2eb69e89-5751-43ed-8ee4-f60065a998d7",
                                                "sense_id": "00eb4707-b866-3555-90cb-30343420185b",
                                                "text": "„»Wir Menschen sind Wärmemaschinen, selbst beim Schlafen produzieren wir Wärme.«“"
                                            },
                                            {
                                                "example_id": "5c818e9f-42ec-4f4b-8794-b75a7624b34b",
                                                "sense_id": "00eb4707-b866-3555-90cb-30343420185b",
                                                "text": "„117 Kilogramm Sauerstoff kann ein großer Baum im Jahr produzieren. Im Gegenzug nimmt er in dieser Zeit 22 Kilogramm Kohlendioxyd auf.“"
                                            },
                                            {
                                                "example_id": "734e9599-8261-468d-b263-bffef46e72e3",
                                                "sense_id": "00eb4707-b866-3555-90cb-30343420185b",
                                                "text": "Ihr Verhalten produziert doch nur noch mehr Ärger!"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "367ee548-df05-3b5b-b94e-06f8dfc8519e",
                                        "entry_id": "3651a114-4bb1-3da4-b111-36062f7fdbfd",
                                        "glosses": [
                                            "sich in der Öffentlichkeit darstellen"
                                        ],
                                        "tags": [
                                            "reflexive",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "32a07081-8e39-4ac0-9f8e-0a65760e96bc",
                                                "sense_id": "367ee548-df05-3b5b-b94e-06f8dfc8519e",
                                                "text": "Gib ihm eine Bühne und er produziert sich!"
                                            },
                                            {
                                                "example_id": "6034a8cd-cc6e-4bef-a966-0ce0e1a7f362",
                                                "sense_id": "367ee548-df05-3b5b-b94e-06f8dfc8519e",
                                                "text": "In monomanischer Sucht nach Anerkennung produzierte sich hier was reich, schön oder berühmt war."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
