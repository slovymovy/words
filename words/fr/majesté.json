{
    "word_family": [
        "majestueux",
        "majestueusement"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a1e25c0f-b48d-3947-b3c7-091ad6205994",
                    "sense_definition": "Titre d'honneur donné aux souverains régnants, tels que les rois ou les empereurs, ainsi qu'à leurs conjoints.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "titre",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les ambassadeurs se sont inclinés avec respect devant Sa <w>Majesté</w> le roi."
                        },
                        {
                            "text": "Le ministre a demandé à Votre <w>Majesté</w> l'autorisation de signer cet accord de paix."
                        }
                    ],
                    "common_phrases": [
                        "Sa Majesté",
                        "Votre Majesté"
                    ]
                },
                {
                    "sense_id": "53530c12-4525-3f0f-832a-e504514af5a0",
                    "sense_definition": "Grandeur imposante, noble ou solennelle qui inspire l'admiration et le respect.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "grandeur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce vieux monument conserve toute sa <w>majesté</w> malgré le passage des siècles."
                        },
                        {
                            "text": "Les grandes montagnes enneigées imposent le silence par leur beauté et leur <w>majesté</w>."
                        }
                    ],
                    "synonyms": [
                        "grandeur",
                        "noblesse",
                        "splendeur"
                    ],
                    "antonyms": [
                        "bassesse",
                        "médiocrité"
                    ],
                    "common_phrases": [
                        "dans toute sa majesté",
                        "pleine de majesté"
                    ]
                },
                {
                    "sense_id": "de997a55-5ff3-3404-b173-04f31af2de7b",
                    "sense_definition": "Caractère auguste, absolu et supérieur propre à une autorité souveraine, à une institution ou à Dieu.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "grandeur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le juge a rappelé la <w>majesté</w> des lois que chaque citoyen doit observer."
                        },
                        {
                            "text": "L'avocat a défendu avec ferveur la <w>majesté</w> de la justice et la séparation des pouvoirs."
                        }
                    ],
                    "synonyms": [
                        "souveraineté"
                    ],
                    "common_phrases": [
                        "crime de lèse-majesté",
                        "majesté des lois"
                    ]
                }
            ]
        }
    ]
}