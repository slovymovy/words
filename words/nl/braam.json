    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "105782b9-e9d8-36b4-9168-34534cb3a0e2",
                    "sense_definition": "de eetbare zwarte of donkerpaarse vrucht van de braamstruik",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "vrucht",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In de zomer plukken we vaak een <w>braam</w> in het bos.",
                            "target_lang_translations": {
                                "en": "In the summer we often pick a <w>blackberry</w> in the forest.",
                                "ru": "Летом мы часто собираем <w>ежевику</w> в лесу."
                            }
                        },
                        {
                            "text": "Deze verse <w>braam</w> smaakt heerlijk zoet.",
                            "target_lang_translations": {
                                "en": "This fresh <w>blackberry</w> tastes wonderfully sweet.",
                                "ru": "Эта свежая <w>ежевика</w> очень сладкая на вкус."
                            }
                        }
                    ],
                    "synonyms": [
                        "braambes"
                    ],
                    "common_phrases": [
                        "verse braam",
                        "rijpe braam"
                    ],
                    "target_lang_definitions": {
                        "en": "the edible black or dark purple fruit of the blackberry bush",
                        "ru": "съедобный черный или темно-фиолетовый плод ежевичного куста"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "blackberry",
                                "target_lang_sense_clarification": "the fruit"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "ежевика",
                                "target_lang_sense_clarification": "ягода"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2b386cf0-64f1-3c20-8e21-b3d5f53f34c4",
                    "sense_definition": "een stekelige struik uit het geslacht Rubus die bramen voortbrengt",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "plant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>braam</w> groeit weelderig langs de rand van het pad.",
                            "target_lang_translations": {
                                "en": "The <w>blackberry bush</w> grows lushly along the edge of the path.",
                                "ru": "<w>Ежевика</w> пышно растет вдоль края тропинки."
                            }
                        },
                        {
                            "text": "Pas op voor de doorns van de <w>braam</w> als je erlangs loopt.",
                            "target_lang_translations": {
                                "en": "Watch out for the thorns of the <w>bramble</w> when you walk past it.",
                                "ru": "Остерегайтесь шипов <w>ежевики</w>, когда проходите мимо."
                            }
                        }
                    ],
                    "synonyms": [
                        "braambos",
                        "braamstruik",
                        "gewone braam"
                    ],
                    "common_phrases": [
                        "wilde braam"
                    ],
                    "target_lang_definitions": {
                        "en": "a prickly shrub of the genus Rubus that produces blackberries",
                        "ru": "колючий кустарник рода Rubus, на котором растет ежевика"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "blackberry",
                                "target_lang_sense_clarification": "the plant"
                            },
                            {
