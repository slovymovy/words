                        "entry_id": "81874f1d-5f90-34f2-b2ed-50b66b4bfe26",
                        "glosses": [
                            "Any of several small-leaved herbs of the genera Cerastium and Stellaria.",
                            "especially common chickweed (Stellaria media), a common, edible weed in North America and Europe."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "734e7eae-e3af-4c30-a827-9079953404fd",
                                "sense_id": "45a0ff74-4e9d-3ac9-8a62-f53cbe3e9de8",
                                "text": "I look at the little sprigs of chickweed trembling among the bean shoots and I am strangely moved. Such steadfastness! Such yearning! They want to live too. That is all they ask: to have their little moment in the world."
                            }
                        ]
