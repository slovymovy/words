                                    {
                                        "sense_id": "ceee695e-5ea5-3582-a900-b43c911660e6",
                                        "entry_id": "1f607df6-b97d-3bd3-91ae-7c1e9cd31fc7",
                                        "glosses": [
                                            "Stadt in Deutschland, Hauptstadt von Niedersachsen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91fc5328-ef5d-4a97-9d4d-132cca277029",
                                                "sense_id": "ceee695e-5ea5-3582-a900-b43c911660e6",
                                                "text": "Hannover liegt an der Leine."
                                            },
                                            {
                                                "example_id": "eb22c106-c7b8-4632-b606-7a0265bc81da",
                                                "sense_id": "ceee695e-5ea5-3582-a900-b43c911660e6",
                                                "text": "„Alle hatten bereits erfahren, ich weiß nicht wie, daß sie von Wesel bis Hannover mit mir gefahren war.“"
                                            },
                                            {
                                                "example_id": "add8e764-3495-405b-8b96-ccef43771c07",
                                                "sense_id": "ceee695e-5ea5-3582-a900-b43c911660e6",
                                                "text": "„Neulich las ich gar von einer Frau, die sich den Innenstadtplan von Hannover auf ihren Rücken hat tätowieren lassen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
