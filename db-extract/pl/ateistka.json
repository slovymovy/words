                        "cross_references": []
                    },
                    {
                        "translation_id": "a57b8249-ee45-42e1-9fc0-04bec83e5e81",
                        "source_entry_id": "b0b2c624-d391-366c-b72c-139385155c5c",
                        "source_sense_id": "e2ccb810-dcd2-320a-ae2b-7f64ec28d597",
                        "target_lang_word": "Atheistin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Atheistin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "08859139-48da-3aa2-a995-ec3b29ba99d2",
                                        "entry_id": "64a0094b-45ac-397a-a426-cfeb9800e623",
                                        "glosses": [
                                            "Frau, welche die Existenz Gottes abstreitet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b6938e54-8053-4587-b295-73566ff6609c",
                                                "sense_id": "08859139-48da-3aa2-a995-ec3b29ba99d2",
                                                "text": "Sie war eine Atheistin, so wie ihre Mutter auch."
                                            },
                                            {
                                                "example_id": "467daa0d-496f-4b55-b1ab-2a727e7854a7",
                                                "sense_id": "08859139-48da-3aa2-a995-ec3b29ba99d2",
                                                "text": "„Die finnische Frau nimmt religiöse Fragen sehr ernst, vor allem wenn sie Atheistin ist.“"
                                            },
                                            {
                                                "example_id": "379b47f8-bf5d-4aa3-af9d-2cb5feff49c5",
                                                "sense_id": "08859139-48da-3aa2-a995-ec3b29ba99d2",
                                                "text": "„Doro aber gab sich heute als erklärte Atheistin und wollte von einer Messe nichts wissen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3d1b0870-89a3-4aec-8b55-ebf5e53e4847",
                        "source_entry_id": "b0b2c624-d391-366c-b72c-139385155c5c",
                        "source_sense_id": "e2ccb810-dcd2-320a-ae2b-7f64ec28d597",
                        "target_lang_word": "атеистка",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "атеистка",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "645f7ab6-d739-3a9b-90e6-ce366c71a8ae",
                                        "entry_id": "2f2ad6b0-79c7-3b7a-af90-aa0ea3173a96",
                                        "glosses": [
                                            "женск. к атеист"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a3450981-c2b4-434b-8c43-ab3e4653bc38",
                                                "sense_id": "645f7ab6-d739-3a9b-90e6-ce366c71a8ae",
                                                "text": "Атеистка поневоле, я понимала, что единственно правильный ответ мне даст, конечно, наука, то есть именно вот этот тяжеленный, холодный, темно-фиолетовый фолиант."
                                            },
                                            {
                                                "example_id": "8f4f7687-4d2c-4727-81f9-c1c3b81015ee",
                                                "sense_id": "645f7ab6-d739-3a9b-90e6-ce366c71a8ae",
                                                "text": "Это сказки Шехерезады. ― Вы мусульманка? ― Атеистка. Студентка. Учу восточные языки."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
