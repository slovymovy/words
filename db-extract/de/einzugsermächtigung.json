                        "entry_id": "fe06e9d4-4670-3962-9ba3-b06d20f919f1",
                        "glosses": [
                            "Vergabe einer Berechtigung, einen Betrag von einem bestimmten Konto abzubuchen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d49e9d2-f634-46e1-8d79-c2b02875a765",
                                "sense_id": "d32a3fc2-ae58-3788-bc03-55705e031d5c",
                                "text": "Wenn ich der Zeitung eine Einzugsermächtigung erteile, kann sie die Abo-Kosten im Lastschriftverfahren von meinem Konto abbuchen, und ich muss mich nicht mehr darum kümmern."
                            },
                            {
                                "example_id": "5e5bb22b-b350-4e6c-abba-a5c59f8025e0",
                                "sense_id": "d32a3fc2-ae58-3788-bc03-55705e031d5c",
                                "text": "„Abokarten können nur per Einzugsermächtigung bezahlt werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
