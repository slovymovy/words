                                "example_id": "ebaea5c3-f42f-4905-9aa3-df889596d572",
                                "sense_id": "f6615090-2ff4-32f9-aab7-daba011774de",
                                "text": "But the thought that he would finally be able to complete his mother's shraadha would make the son emotional."
                            }
                        ]
                    }
