                "senses": [
                    {
                        "sense_id": "4c66eeda-8829-3577-b659-375faa8ede03",
                        "entry_id": "7d0c43cd-d192-359e-98c7-3271ae637081",
                        "glosses": [
                            "Mobiltelefon, bei dem das Display auf die Tastatur geklappt werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "14a31a2f-ca4d-44cb-a131-5f21633b6224",
                                "sense_id": "4c66eeda-8829-3577-b659-375faa8ede03",
                                "text": "„Der Vorläufer, das Klapphandy Emporia Connect, ist gerade bei der Berliner IFA vorgestellt worden.“"
                            },
                            {
                                "example_id": "87300140-0e6a-46ca-a7b8-d69e7ac8419d",
                                "sense_id": "4c66eeda-8829-3577-b659-375faa8ede03",
                                "text": "„So war das Motorola Startac 1996 das erste Klapphandy der Welt, das flache Razr ein zig Millionen Mal verkaufter Publikumsliebling und das Rokr das erste MP3-Handy, das sich mit Apples Segen von iTunes aus mit Musik betanken ließ.“"
                            },
                            {
                                "example_id": "7720df4c-0690-4c94-9fcb-698c6c30d434",
                                "sense_id": "4c66eeda-8829-3577-b659-375faa8ede03",
                                "text": "„Das weltweit erste Klapphandy bringt Motorola 1989 auf den Markt: das MicroTAC 9800X.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
