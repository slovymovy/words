                "senses": [
                    {
                        "sense_id": "aad49450-8d99-36ca-8d03-b4994947e210",
                        "entry_id": "ea538063-d4fb-3269-a018-cf1fcae5f35d",
                        "glosses": [
                            "Vogelart aus der Gattung Fratercula (deutsch: Lunde)"
                        ],
                        "tags": [
                            "Zoologische Taxonomie"
                        ],
                        "examples": [
                            {
                                "example_id": "464f4266-275f-452a-8656-de02804a2a0b",
                                "sense_id": "aad49450-8d99-36ca-8d03-b4994947e210",
                                "text": "„Wie andere Lunde überwintern Hornlunde fernab der Küste und sind dann im Nordpazifik weit verbreitet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e4b4615a-9512-317f-b994-c6a3ecc5a3bb",
                        "entry_id": "ea538063-d4fb-3269-a018-cf1fcae5f35d",
                        "glosses": [
                            "Kurzform für den Arktischen Lund, eine Vogelart aus der Familie der Alkenvögel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c833080e-1e5f-484e-8f26-74ad82c8e1ad",
                                "sense_id": "e4b4615a-9512-317f-b994-c6a3ecc5a3bb",
                                "text": "„Der Name leitet sich vom Normannischen lund-ey (Insel der Lunde) ab.“"
                            },
                            {
                                "example_id": "46296545-2202-454d-af9a-742c5cd19397",
                                "sense_id": "e4b4615a-9512-317f-b994-c6a3ecc5a3bb",
                                "text": "„Einmal emporgekommen, fliegt der Lund geradeaus, unter schwirrender Bewegung seiner Flügel und zwar so schnell dahin, daß der Schütze im Anfange immer zu kurz schießt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9b0cc884-353a-4c1c-a7fd-c284a624c6e5",
