                        {
                            "text": "Het festival eindigde gisteravond met een <w>knallende</w> afsluiter waar iedereen nog lang over napraatte.",
                            "target_lang_translations": {
                                "en": "The festival ended last night with a <w>smashing</w> finale that everyone talked about for a long time."
                            }
                        }
                    ],
                    "synonyms": [
                        "dreunend"
                    ],
                    "common_phrases": [
