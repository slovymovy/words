    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "96b7a6ad-9df7-3235-b6b3-8cbabc7e32a3",
                    "sense_definition": "A diurnal predatory bird of the family Accipitridae, smaller than an eagle.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "birds of prey",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>hawk</w> circled high above the field, searching for its next meal.",
                            "target_lang_translations": {
                                "ru": "<w>Ястреб</w> кружил высоко над полем в поисках добычи.",
                                "de": "Der <w>Habicht</w> kreiste hoch über dem Feld auf der Suche nach seiner nächsten Mahlzeit.",
                                "zh": "<w>鹰</w>在田野上空盘旋，寻找下一顿美餐。"
                            }
                        },
                        {
                            "text": "It is illegal to hunt <w>hawks</w> or other raptors in many parts of the world.",
                            "target_lang_translations": {
                                "ru": "Во многих частях мира охота на <w>ястребов</w> или других хищных птиц запрещена законом.",
                                "de": "Es ist in vielen Teilen der Welt illegal, <w>Habichte</w> oder andere Greifvögel zu jagen.",
                                "zh": "在世界许多地方，猎杀<w>鹰</w>或其他猛禽是违法的。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "hawk eyes",
                        "soaring hawk",
                        "predatory hawk"
                    ],
                    "target_lang_definitions": {
                        "ru": "Дневная хищная птица семейства ястребиных, размером меньше орла.",
                        "de": "Ein tagaktiver Greifvogel aus der Familie der Habichtartigen, kleiner als ein Adler.",
                        "zh": "一种日间活动的猛禽，属于鹰科，体型比鹰小。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ястреб",
                                "target_lang_sense_clarification": "хищная птица"
                            },
                            {
                                "target_lang_word": "сокол",
                                "target_lang_sense_clarification": "в широком смысле о хищных птицах"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Habicht",
                                "target_lang_sense_clarification": "Greifvogel aus der Gattung Accipiter"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "鹰",
                                "target_lang_sense_clarification": "猛禽的统称"
                            },
                            {
                                "target_lang_word": "隼",
                                "target_lang_sense_clarification": "指代小型猛禽"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c1b17e25-474f-320e-a0b8-65e6c6da3a4a",
                    "sense_definition": "An advocate of aggressive political positions and actions, especially in favor of war or military intervention.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "political stances",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The senator is known as a foreign policy <w>hawk</w> who supports increased military spending.",
                            "target_lang_translations": {
                                "ru": "Сенатор известен как внешнеполитический <w>ястреб</w>, поддерживающий увеличение военных расходов.",
                                "de": "Der Senator ist als außenpolitischer <w>Falke</w> bekannt, der höhere Militärausgaben unterstützt.",
                                "zh": "这位参议员以支持增加军费开支的对外政策<w>鹰派</w>而闻名。"
                            }
                        },
                        {
                            "text": "In the debate between the <w>hawks</w> and the doves, the president chose a middle path.",
                            "target_lang_translations": {
                                "ru": "В споре между <w>ястребами</w> и голубями президент выбрал срединный путь.",
                                "de": "In der Debatte zwischen den <w>Falken</w> und den Tauben wählte der Präsident einen Mittelweg.",
                                "zh": "在<w>鹰派</w>与鸽派的辩论中，总统选择了折中路线。"
                            }
                        }
                    ],
                    "synonyms": [
                        "warmonger",
                        "war hawk"
                    ],
                    "antonyms": [
                        "dove"
                    ],
                    "common_phrases": [
                        "political hawk",
                        "hawks and doves"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сторонник агрессивной политической позиции, особенно в пользу войны или военного вмешательства.",
                        "de": "Ein Befürworter einer aggressiven politischen Haltung, insbesondere in Bezug auf Krieg oder militärische Interventionen.",
                        "zh": "主张采取强硬政治立场或行动的人，尤指支持战争或军事干预者。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ястреб",
                                "target_lang_sense_clarification": "политический термин"
                            },
                            {
                                "target_lang_word": "милитарист",
                                "target_lang_sense_clarification": "сторонник военной мощи"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Falke",
                                "target_lang_sense_clarification": "politisch für eine harte Vorgehensweise"
                            },
                            {
                                "target_lang_word": "Kriegstreiber",
                                "target_lang_sense_clarification": "Person, die zum Krieg aufstachelt"
                            },
                            {
                                "target_lang_word": "Militarist",
                                "target_lang_sense_clarification": "Befürworter militärischer Stärke"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "鹰派",
                                "target_lang_sense_clarification": "政治上的强硬派"
                            },
                            {
                                "target_lang_word": "主战派",
                                "target_lang_sense_clarification": "支持战争的立场"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "db5fcafa-2d72-3858-a580-719e8546651a",
                    "sense_definition": "A cold, sharp, or biting wind.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "weather",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He turned up his collar against the <w>hawk</w> blowing from the river.",
                            "target_lang_translations": {
                                "ru": "Он поднял воротник, защищаясь от <w>ледяного ветра</w>, дующего с реки.",
                                "de": "Er schlug seinen Kragen hoch gegen den <w>eisigen Wind</w>, der vom Fluss her wehte.",
                                "zh": "他竖起衣领，抵御从河边吹来的<w>寒风</w>。"
                            }
                        },
                        {
                            "text": "The <w>hawk</w> blowing off the lake was enough to make your teeth drop right out of your skull.",
                            "target_lang_translations": {
                                "ru": "<w>Резкий ветер</w> с озера был таким сильным, что зубы были готовы выскочить изо рта.",
                                "de": "Der <w>schneidende Wind</w> vom See war so stark, dass einem die Zähne aus dem Mund zu fallen schienen.",
                                "zh": "从湖上吹来的<w>寒风</w>冷得让人牙齿打颤。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "the hawk blowing"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Particularly associated with Chicago"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Холодный, резкий или пронизывающий ветер.",
                        "de": "Ein kalter, scharfer oder beißender Wind.",
                        "zh": "一种寒冷、刺骨或强劲的风。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ледяной ветер",
                                "target_lang_sense_clarification": "пронизывающий холод"
                            },
                            {
                                "target_lang_word": "резкий ветер",
                                "target_lang_sense_clarification": "о погоде"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "eisiger Wind",
                                "target_lang_sense_clarification": "sehr kalter Wind"
                            },
                            {
                                "target_lang_word": "schneidender Wind",
                                "target_lang_sense_clarification": "sehr starker, unangenehmer Wind"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "寒风",
                                "target_lang_sense_clarification": "寒冷刺骨的风"
                            },
                            {
                                "target_lang_word": "凛冽的寒风",
                                "target_lang_sense_clarification": "形容风势强劲且寒冷"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e09001d2-6a35-374b-a88a-f63de56f429d",
                    "sense_definition": "A plasterer's tool consisting of a flat square surface with a handle below, used to hold plaster.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "tools",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The plasterer held the <w>hawk</w> in one hand and the trowel in the other.",
                            "target_lang_translations": {
                                "ru": "Штукатур держал <w>сокол</w> в одной руке, а мастерок — в другой.",
                                "de": "Der Stuckateur hielt die <w>Glättkelle</w> in der einen und die Maurerkelle in der anderen Hand.",
                                "zh": "泥瓦匠一手拿着<w>托灰板</w>，另一手拿着抹刀。"
                            }
                        },
                        {
                            "text": "He loaded a fresh batch of mortar onto his <w>hawk</w> before climbing the ladder.",
                            "target_lang_translations": {
                                "ru": "Он положил свежую порцию раствора на свой <w>соколок</w>, прежде чем подняться по лестнице.",
                                "de": "Er lud eine frische Portion Mörtel auf sein <w>Mörtelbrett</w>, bevor er die Leiter hinaufstieg.",
                                "zh": "他在爬梯子前，往<w>托灰板</w>上装了一份新砂浆。"
                            }
                        }
                    ],
                    "synonyms": [
                        "mortarboard"
                    ],
                    "common_phrases": [
                        "plasterer's hawk"
                    ],
                    "target_lang_definitions": {
                        "ru": "Инструмент штукатура, представляющий собой плоскую квадратную поверхность с ручкой снизу, используемый для удержания раствора.",
                        "de": "Ein Werkzeug des Stuckateurs, bestehend aus einer flachen quadratischen Platte mit einem Griff an der Unterseite, zum Halten von Putz.",
                        "zh": "一种泥瓦匠使用的工具，由一块带有手柄的平坦方形板组成，用于盛放灰泥。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сокол",
                                "target_lang_sense_clarification": "штукатурный инструмент"
                            },
                            {
                                "target_lang_word": "соколок",
                                "target_lang_sense_clarification": "уменьшительное название инструмента"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Glättkelle",
                                "target_lang_sense_clarification": "Werkzeug zum Auftragen und Glätten von Putz"
                            },
                            {
                                "target_lang_word": "Mörtelbrett",
                                "target_lang_sense_clarification": "Ablage für Putz oder Mörtel"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "灰板",
                                "target_lang_sense_clarification": "泥瓦匠盛灰的工具"
                            },
                            {
                                "target_lang_word": "托灰板",
                                "target_lang_sense_clarification": "专业名称"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "da5ca773-fa30-3491-92f5-0c52d4058f6c",
                    "sense_definition": "To sell goods or offer them for sale by calling out in the street; to peddle.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "selling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The vendors were <w>hawking</w> their wares from little tables lining the market square.",
                            "target_lang_translations": {
                                "ru": "Торговцы <w>продавали вразнос</w> свои товары с маленьких столиков, расставленных вдоль рыночной площади.",
                                "de": "Die Händler <w>priesen</w> ihre Waren von kleinen Tischen aus an, die den Marktplatz säumten.",
                                "zh": "小贩们在市场广场边的小桌旁<w>叫卖</w>着他们的商品。"
                            }
                        },
                        {
                            "text": "He spent the afternoon <w>hawking</w> newspapers to people passing by on the sidewalk.",
                            "target_lang_translations": {
                                "ru": "Вторую половину дня он провел, <w>предлагая</w> газеты прохожим на тротуаре.",
                                "de": "Er verbrachte den Nachmittag damit, Passanten auf dem Gehweg Zeitungen <w>anzubieten</w>.",
                                "zh": "他整个下午都在人行道上向路人<w>兜售</w>报纸。"
                            }
                        }
                    ],
                    "synonyms": [
                        "tout"
                    ],
                    "common_phrases": [
                        "hawk wares",
                        "hawk goods"
                    ],
                    "target_lang_definitions": {
                        "ru": "Продавать товары, предлагая их вразнос или выкрикивая на улице.",
                        "de": "Waren durch lautes Anpreisen auf der Straße verkaufen; hausieren.",
                        "zh": "在街上叫卖或兜售商品。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "торговать вразнос",
                                "target_lang_sense_clarification": "предлагать товары на улице"
