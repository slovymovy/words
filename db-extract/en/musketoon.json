                    {
                        "sense_id": "1fe5caac-74b6-392d-9f9b-44c77745f5c4",
                        "entry_id": "fe8c86a7-d377-3724-a92c-b0b9ee50b890",
                        "glosses": [
                            "A firearm, similar to a musket but with a shorter barrel and a large bore."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "1dad9872-2616-413b-843f-6dd97e4b6860",
                                "sense_id": "1fe5caac-74b6-392d-9f9b-44c77745f5c4",
                                "text": "And d'Artagnan set the example. Then, turning toward Planchet, he made him a sign to uncock his musketoon. The Englishmen, convinced of these peaceful proceedings, sheathed their swords grumblingly."
                            }
                        ]
                    },
                    {
                        "sense_id": "a3fe71e7-9614-3223-ab3a-912099c06c49",
                        "entry_id": "fe8c86a7-d377-3724-a92c-b0b9ee50b890",
                        "glosses": [
                            "One who is armed with such a musket."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "95514998-21e8-4f47-b8bf-934df4979769",
                        "source_entry_id": "fe8c86a7-d377-3724-a92c-b0b9ee50b890",
                        "source_sense_description": "type of musket",
                        "target_lang_word": "mousqueton",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mousqueton",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9778b268-dc5b-321a-9708-c02f90087160",
                                        "entry_id": "fa3d5930-3385-3e0f-976b-99c1abde200a",
                                        "glosses": [
                                            "Ancienne arme à feu, du même calibre que le mousquet, mais plus courte que celui-ci."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad9617c3-26cf-42a2-92ae-19551eefcc8d",
                                                "sense_id": "9778b268-dc5b-321a-9708-c02f90087160",
                                                "text": "En fait d’armes, le lieutenant Hobson emportait, avec des munitions en quantité suffisante, les mousquetons réglementaires délivrés par la Compagnie, des pistolets et quelques sabres d’ordonnance."
                                            },
                                            {
                                                "example_id": "e4e450b5-1fcc-4a7e-a89c-8d217ead1831",
                                                "sense_id": "9778b268-dc5b-321a-9708-c02f90087160",
                                                "text": "« Je ne compte pas vous surprendre ni surtout provoquer votre indignation en vous disant que la balle, une fois extraite, se révéla être une balle de mousqueton. Et même de mousqueton réglementaire de gendarmerie, me dit mon père. »"
                                            },
                                            {
                                                "example_id": "e5f3fd43-2fc2-42a3-96f1-eef4afe31b2c",
                                                "sense_id": "9778b268-dc5b-321a-9708-c02f90087160",
                                                "text": "Il pense au gardien de la mine d’Ichmoul mettant en fuite les bandits avec les quatre cartouches de son vieux mousqueton."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "50fd88c0-66fd-38b2-b9a6-393dcd99161c",
                                        "entry_id": "fa3d5930-3385-3e0f-976b-99c1abde200a",
                                        "glosses": [
                                            "Fusil court, dont étaient armés les cavaliers, les servants d’artillerie et les mitrailleurs d’infanterie, et qui peut être porté en bandoulière."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "15e0f57e-a250-4f07-9cd3-08fe100adb23",
                                                "sense_id": "50fd88c0-66fd-38b2-b9a6-393dcd99161c",
                                                "text": "Des escouades de gardes mobiles, casqués, vêtus de cirés noirs, chaussés de brodequins, le mousqueton à la main, longeaient lentement le boulevard Sébastopol."
                                            },
                                            {
                                                "example_id": "8c8ab5a7-458f-4185-9cf7-966862815b75",
                                                "sense_id": "50fd88c0-66fd-38b2-b9a6-393dcd99161c",
                                                "text": "Abraham empoigna son fusil dans son dos, embrassa le demi-cœur à son cou, et se planta en lisière d’une grotte creusée à flanc de coteau. Quelques compagnons, équipés de mousquetons antédiluviens, l’imitèrent. Un feu dérisoire s’abattit sur les assaillants, quelques-uns décrochèrent, mais d’autres, plus nombreux, se lancèrent avec fougue à l’attaque des cavernes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6ee6b7a4-6753-3f2e-ae5b-4a734e2ade97",
                                        "entry_id": "fa3d5930-3385-3e0f-976b-99c1abde200a",
                                        "glosses": [
                                            "Porte-mousqueton, sorte de crochet à déclic qui s’ouvre et se ferme pour recevoir un anneau."
                                        ],
                                        "tags": [
                                            "Par abréviation"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
