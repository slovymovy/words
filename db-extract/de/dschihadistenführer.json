                ],
                "senses": [
                    {
                        "sense_id": "4e028e55-3fa5-3ed3-a0f2-26944e843338",
                        "entry_id": "1a2813a3-2c40-3ef8-847e-c7906d4fadce",
                        "glosses": [
                            "Führer einer Dschihadistengruppe"
                        ],
                        "tags": [
                            "Islam",
                            "Islamismus"
                        ],
                        "examples": [
                            {
                                "example_id": "d0591a8f-fcd3-4fa4-b4d7-9c2fd5f1bcd0",
                                "sense_id": "4e028e55-3fa5-3ed3-a0f2-26944e843338",
                                "text": "„Algerien meldet Tötung von Dschihadistenführer“"
                            },
                            {
                                "example_id": "0bc85f34-8079-4449-a37c-ecdbc6d99160",
                                "sense_id": "4e028e55-3fa5-3ed3-a0f2-26944e843338",
                                "text": "„Algeriens Armee tötet Dschihadistenführer: Abdelmalek Gouri, ein Führer der Islamisten-Gruppe al-Khilafa, ist offenbar bei einem Einsatz der algerischen Armee getötet worden. Die Leiche sei bereits identifiziert, erklärte ein Sprecher am Dienstag.“"
                            },
                            {
                                "example_id": "7e4e03b3-308c-43ef-93c1-ee8ccce025d0",
                                "sense_id": "4e028e55-3fa5-3ed3-a0f2-26944e843338",
                                "text": "„Nie zuvor verfügte ein Dschihadistenführer über eine so große Anzahl von Kämpfern, ein so großes Einflussgebiet und scheinbar unerschöpfliche finanzielle Mittel.“"
                            },
                            {
                                "example_id": "5d8ba5f5-b760-428c-9fba-251aa2da8410",
                                "sense_id": "4e028e55-3fa5-3ed3-a0f2-26944e843338",
                                "text": "„Nach Angaben aus Sicherheitskreisen vom Freitag gab es erneut 109 Festnahmen – auch drei Dschihadistenführer seien aufgegriffen worden.“"
                            },
                            {
                                "example_id": "eae450a9-6647-4df6-91f2-f039ec41c403",
                                "sense_id": "4e028e55-3fa5-3ed3-a0f2-26944e843338",
                                "text": "„AQIM sei jedoch \"vom rechten Pfad\" abgewichen, begründete der Dschihadistenführer die Abspaltung und Gründung von \"Dschund al-Chilafa\".“"
                            },
                            {
                                "example_id": "29640184-20ac-431d-8a10-b005a090c2c0",
                                "sense_id": "4e028e55-3fa5-3ed3-a0f2-26944e843338",
                                "text": "„Mehrere wichtige Dschihadistenführer wie der Algerier Mokhtar Belmokhtar hätten im Süden Libyens Zuflucht gefunden.“"
                            },
                            {
                                "example_id": "0bd91090-b878-4b95-ba52-cb836de5fb91",
                                "sense_id": "4e028e55-3fa5-3ed3-a0f2-26944e843338",
                                "text": "„Die irakische Regierung hatte zuvor geprüft, ob der Dschihadistenführer Abu Bakr al-Bagdadi bei einem Luftangriff getötet worden war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
