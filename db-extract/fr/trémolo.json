                    {
                        "translation_id": "3e03691a-0211-4fbd-b927-7c9933729bf1",
                        "source_entry_id": "dea7963b-f900-3b5f-a8d0-ce53fd396eef",
                        "target_lang_word": "тремоло",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "тремоло",
