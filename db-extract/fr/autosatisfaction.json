                        "translation_id": "60282c47-7ceb-4abb-8bcc-9f0a3eb7338e",
                        "source_entry_id": "1019f862-a268-3d90-900c-2e50075137c2",
                        "source_sense_id": "a01d4454-da54-3a59-b9fe-3e28856aeb4d",
                        "target_lang_word": "Selbstzufriedenheit",
