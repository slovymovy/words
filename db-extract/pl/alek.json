                "senses": [
                    {
                        "sense_id": "98a1313e-021b-32b9-b781-c2aaf076ae0c",
                        "entry_id": "e23f6953-f450-3d92-b412-7798b6a79cee",
                        "glosses": [
                            "imię męskie od Aleksy, Aleksander"
                        ],
                        "tags": [
                            "diminutive"
                        ],
                        "examples": [
                            {
                                "example_id": "fb2a9b84-4f2a-4765-a6c0-c433817c6ff8",
                                "sense_id": "98a1313e-021b-32b9-b781-c2aaf076ae0c",
                                "text": "Pojechaliśmy z Alkiem nad morze."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ae7827e2-8ef0-4a5b-9f1d-fbee711433f0",
                        "source_entry_id": "e23f6953-f450-3d92-b412-7798b6a79cee",
                        "source_sense_id": "98a1313e-021b-32b9-b781-c2aaf076ae0c",
                        "target_lang_word": "Alexis",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Alexis",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7bc7cf37-a1fa-3c64-96a0-eb2922af9c05",
                                        "entry_id": "d052c8db-45b2-3cfa-97d1-e37127406134",
                                        "glosses": [
                                            "A male given name from Ancient Greek."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5af61f29-90b4-4996-a331-fea1278becb1",
                                                "sense_id": "7bc7cf37-a1fa-3c64-96a0-eb2922af9c05",
                                                "text": "To the maid of his choice, / With a heart palpitating, / Comes Alexis the brave."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b0453c18-6869-3766-bd00-183f26ba5dc4",
                                        "entry_id": "d052c8db-45b2-3cfa-97d1-e37127406134",
                                        "glosses": [
                                            "A female given name from Ancient Greek, transferred from the male name and used since the 1940s."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e4abe471-ebcb-4941-b6bc-a8361b3df7e9",
                                                "sense_id": "b0453c18-6869-3766-bd00-183f26ba5dc4",
                                                "text": "He wondered how parents who had named their daughter Alexis could possibly have known she'd turn out to be such a beauty."
                                            },
                                            {
                                                "example_id": "e425cef0-c90b-4f1d-9dfd-bec93f42cb24",
                                                "sense_id": "b0453c18-6869-3766-bd00-183f26ba5dc4",
                                                "text": "\"It's almost too realistic, too digital and computery,\" complains Alexis Vogel, a veteran celebrity makeup artist who recently worked on \"Stacked,\" a high-def show starring Pamela Anderson."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bd2d38ab-a982-4e73-9b7d-a46c505c903f",
                        "source_entry_id": "e23f6953-f450-3d92-b412-7798b6a79cee",
                        "source_sense_id": "98a1313e-021b-32b9-b781-c2aaf076ae0c",
                        "target_lang_word": "Alex",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Alex",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0c58d5fe-5e0a-3c41-be72-cfe71c6bfb4f",
                                        "entry_id": "565de5c5-cc43-33e1-bc1b-5c166fce4520",
                                        "glosses": [
                                            "männlicher Vorname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4acf8354-fb53-4321-ae34-6be1c5a12333",
                                                "sense_id": "0c58d5fe-5e0a-3c41-be72-cfe71c6bfb4f",
                                                "text": "„»Ja ja ja ja«, sagte Jochen, wandte sich seiner Nachbarin zu, dieser Silke aus Kopenhagen im Piratenkostüm, der zweiten Frau seines Sohnes Alex.“"
                                            },
                                            {
                                                "example_id": "ebe4d30d-2d6c-4517-97c0-544a9502d00e",
                                                "sense_id": "0c58d5fe-5e0a-3c41-be72-cfe71c6bfb4f",
                                                "text": "„Alex Honnold, geboren 1985 in Sacramento, ist der derzeit mit Abstand beste Freikletterer der Welt. Und nachdem er in Valley Uprising schon als Nebendarsteller eine Rolle spielte, gehört ihm jetzt Free Solo ganz allein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Alex",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8d0de28d-7faf-3525-b8a3-5e06fa88a867",
                                        "entry_id": "69b61652-b8ce-388e-820d-50be95733881",
                                        "glosses": [
                                            "weiblicher Vorname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89b5b18c-dce0-48ce-8407-c5cb9246cf6c",
                                                "sense_id": "8d0de28d-7faf-3525-b8a3-5e06fa88a867",
                                                "text": "„‚Alex, zieh nicht alles ins Lächerliche‘, ermahnte Elke ihre Freundin.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Alex",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8fddd006-3e12-3cc1-9b9e-d212d47c4bd6",
                                        "entry_id": "0c0eb2af-08b8-3d51-9158-67b35532f537",
                                        "glosses": [
                                            "Alexanderplatz in Berlin"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cbbcfc7a-b020-4110-ac77-791bd6e701c9",
                                                "sense_id": "8fddd006-3e12-3cc1-9b9e-d212d47c4bd6",
                                                "text": "„Als Reporterin verkaufte sie Eis und Bockwurst auf dem Alex, spielte Kindergärtnerin oder schlüpfte in die Rolle einer Verkäuferin und schrieb darüber.“"
                                            },
                                            {
                                                "example_id": "0d06c9fb-d171-48fb-900f-544e58460a1e",
                                                "sense_id": "8fddd006-3e12-3cc1-9b9e-d212d47c4bd6",
                                                "text": "„Der Alex bleibt ein Ort, der großes Kopfzerbrechen bereiten muss.“"
                                            },
                                            {
                                                "example_id": "23ed4125-1ee9-409d-9bed-6e338d3d41fe",
                                                "sense_id": "8fddd006-3e12-3cc1-9b9e-d212d47c4bd6",
                                                "text": "„Was passiert, wenn der Fernsehturm am Alex umkippt? Dann kann man mit dem Fahrstuhl in den Westen fahren.“"
                                            },
                                            {
                                                "example_id": "a9a1563d-d926-40ea-b684-1cb144468443",
                                                "sense_id": "8fddd006-3e12-3cc1-9b9e-d212d47c4bd6",
                                                "text": "„‚Eine Wetterstation wie die auf dem Alex ist in Europa ganz selten‘, erklärt Tremmel.“"
                                            },
                                            {
                                                "example_id": "81c0d729-1149-4f28-9056-8510a8cf3563",
                                                "sense_id": "8fddd006-3e12-3cc1-9b9e-d212d47c4bd6",
                                                "text": "„Beim letzten Versuch schreibt Richard: Wenn du mir etwas sagen willst – ich warte morgen auf dich am Alex. Weltzeituhr 3 p.m.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
