{
    "word_family": [
        "stink",
        "stinky"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "42c5c806-d107-3ec2-b590-6c670eb86af0",
                    "sense_definition": "A person who is unpleasant or contemptible.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "unpleasant_person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Stop crying, you little <w>stinker</w>!",
                            "target_lang_translations": {
                                "zh": "别哭了，你这个小<w>讨厌鬼</w>！"
                            }
                        },
                        {
                            "text": "Never be a <w>stinker</w>, because bad behavior will eventually cause you trouble.",
                            "target_lang_translations": {
                                "zh": "千万别做个<w>坏蛋</w>，因为不良行为终究会给你带来麻烦。"
                            }
                        }
                    ],
                    "synonyms": [
                        "creep",
                        "rotter",
                        "scoundrel"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Informal and often used to describe children or annoying people."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "指令人讨厌或卑劣的人。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "讨厌鬼",
                                "target_lang_sense_clarification": "指令人厌烦的人，常用于口语。"
                            },
                            {
                                "target_lang_word": "坏蛋",
                                "target_lang_sense_clarification": "指品行不端或令人不快的人。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e9daa7cb-9eb5-321a-8346-f356045c68a5",
                    "sense_definition": "Something that is very difficult or an unpleasant piece of writing.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "unpleasant_thing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Today's difficult crossword puzzle is a real <w>stinker</w>.",
                            "target_lang_translations": {
                                "zh": "今天的填字游戏真是个<w>难题</w>。"
                            }
                        },
                        {
                            "text": "I was so angry that I wrote him a <w>stinker</w> of a letter.",
                            "target_lang_translations": {
                                "zh": "我当时太生气了，就给他写了一封<w>恶语信</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "hatchet job",
                        "nastygram"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Informal usage."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "指非常困难的事情或措辞严厉、令人不快的文字。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "难题",
                                "target_lang_sense_clarification": "指极难处理或解决的事情。"
                            },
                            {
                                "target_lang_word": "恶语信",
                                "target_lang_sense_clarification": "指充满愤怒或攻击性言辞的信件。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "debdfb4d-8d55-3ef2-949f-45528156f338",
                    "sense_definition": "Something of very poor quality.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "unpleasant_thing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new movie is a total <w>stinker</w> that nobody should watch.",
                            "target_lang_translations": {
                                "zh": "这部新电影简直是部<w>烂片</w>，谁都不该去看。"
                            }
                        },
                        {
                            "text": "His latest book is a <w>stinker</w> compared to his earlier work.",
                            "target_lang_translations": {
                                "zh": "和他的早期作品相比，他最近出的书简直是<w>垃圾</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "clunker"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Informal usage."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "指质量极差的东西。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "烂片",
                                "target_lang_sense_clarification": "特指质量极差的电影。"
                            },
                            {
                                "target_lang_word": "垃圾",
                                "target_lang_sense_clarification": "泛指质量低劣、毫无价值的东西。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b41b2ffd-3b97-3f6b-b98a-96eb850a7bef",
                    "sense_definition": "A very hot day.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "weather",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is going to be a real <w>stinker</w> of a day today.",
                            "target_lang_translations": {
                                "zh": "今天注定会是<w>酷热天</w>。"
                            }
                        },
                        {
                            "text": "We stayed inside all afternoon because it was such a <w>stinker</w> outside.",
                            "target_lang_translations": {
                                "zh": "我们整个下午都待在室内，因为外面实在太<w>酷热</w>了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "scorcher"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Informal usage."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "指非常炎热的天气。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "酷热天",
                                "target_lang_sense_clarification": "指气温极高、令人难受的日子。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7f07eade-0452-374d-ba08-878a74aa670a",
                    "sense_definition": "A person or animal that smells very bad.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "smell",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Skunks are the most famous <w>stinkers</w> in the animal kingdom.",
                            "target_lang_translations": {
                                "zh": "臭鼬是动物界最出名的<w>臭家伙</w>。"
                            }
                        },
                        {
                            "text": "The wet dog was a real <w>stinker</w> after playing in the mud.",
                            "target_lang_translations": {
                                "zh": "那只狗在泥里玩过之后，简直是个<w>臭家伙</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "stinkard"
                    ],
                    "target_lang_definitions": {
                        "zh": "指散发出恶臭的人或动物。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "臭家伙",
                                "target_lang_sense_clarification": "指身上有难闻气味的人或动物。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}