                ],
                "senses": [
                    {
                        "sense_id": "6e60bba3-36b7-36b9-9a3e-7c0008ec20ff",
                        "entry_id": "ef6e5e0b-e24e-3198-b468-01f5a324392c",
                        "glosses": [
                            "экон.заготовка лесных материалов, древесины"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d4bb574-e02d-4b53-af82-17f42548ceed",
                                "sense_id": "6e60bba3-36b7-36b9-9a3e-7c0008ec20ff",
                                "text": "Дед по матери ― Абрам Ильич ― работал десятником на лесозаготовках."
                            },
                            {
                                "example_id": "1a0b1154-ce8f-47ac-a167-81b841243eec",
                                "sense_id": "6e60bba3-36b7-36b9-9a3e-7c0008ec20ff",
                                "text": "Вторая наиболее проблемная отрасль ― это отрасль лесозаготовки и деревопереработки."
                            },
                            {
                                "example_id": "72d90f80-a120-4e41-b7b8-f81d0d3728a4",
                                "sense_id": "6e60bba3-36b7-36b9-9a3e-7c0008ec20ff",
                                "text": "Так, если по лесозаготовке мы занимаем 2-е место, то по производству бумаги — лишь 14-е."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cce61a75-24c8-41cb-83d6-8d802fb66dac",
                        "source_entry_id": "ef6e5e0b-e24e-3198-b468-01f5a324392c",
                        "source_sense_id": "6e60bba3-36b7-36b9-9a3e-7c0008ec20ff",
                        "target_lang_word": "lumbering",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lumbering",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8a09bbb4-2ffd-31bc-b2d7-fae8d2efac93",
                                        "entry_id": "117f6dd4-c198-3543-bb2a-d886b65fe59a",
                                        "glosses": [
                                            "The act of one who lumbers; heavy, clumsy movement."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c3497912-b7f7-4064-b06c-8ee95046e12e",
                                                "sense_id": "8a09bbb4-2ffd-31bc-b2d7-fae8d2efac93",
                                                "text": "Only the old harbor-master was there, singing out, as by duty bound, his lusty oaths at their lumberings."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "92c7bff3-4e6b-3aa9-b7e3-8efd6ad3af96",
                                        "entry_id": "117f6dd4-c198-3543-bb2a-d886b65fe59a",
                                        "glosses": [
                                            "The business of felling trees for lumber."
                                        ],
                                        "tags": [
                                            "US",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "lumbering",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c310acec-71d8-3cb9-af19-5f81effcb0c9",
                                        "entry_id": "10bdcebd-cffb-369a-9dd1-d77c0b88481d",
                                        "glosses": [
                                            "Clumsy or awkward."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7b3d5ae-0f96-48b6-8b79-b6b405578905",
                                                "sense_id": "c310acec-71d8-3cb9-af19-5f81effcb0c9",
                                                "text": "I've kidnapped that lumbering fool Donkey Kong and you will never see him again. Har-har-har-har!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "64893779-2bf1-3a8a-98f7-f920d95741a3",
                                        "entry_id": "10bdcebd-cffb-369a-9dd1-d77c0b88481d",
                                        "glosses": [
                                            "Heavy, slow and laborious; ponderous."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ceabf33e-fbc2-4cfb-a5ef-b25948fbb2e5",
                                                "sense_id": "64893779-2bf1-3a8a-98f7-f920d95741a3",
                                                "text": "The solitary, lumbering trolls of Scandinavian mythology would sometimes be turned to stone by exposure to sunlight. Barack Obama is hoping that several measures announced on June 4th will have a similarly paralysing effect on their modern incarnation, the patent troll."
                                            }
                                        ]
                                    }
                                ]
                            }
