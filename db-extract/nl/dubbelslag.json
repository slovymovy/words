                        "examples": [
                            {
                                "example_id": "92fcbd19-6887-489a-8fc8-8d29cec841b4",
                                "sense_id": "ac8d3d98-d29b-3bcf-8d24-78454a99725c",
                                "text": "IHC zegt hiermee een dubbelslag te slaan: versterking van zijn positie als leverancier van totaaloplossingen en van zijn aanwezigheid in de belangrijke Braziliaanse markt."
                            },
                            {
                                "example_id": "c91fcd0d-3c5a-4529-aed7-6418c177d644",
                                "sense_id": "ac8d3d98-d29b-3bcf-8d24-78454a99725c",
                                "text": "Verschuren kwam, zoals gebruikelijk, langzaam op gang. Hij keerde na 50 meter als laatste, maar kwam in het tweede stuk sterk opzetten. Bijna leverde hem dat zelfs het goud op, maar Dotto bleef de aanstormende Verschuren net voor. De Italiaan won in 48,25, Verschuren sloeg daar kort achter een persoonlijke dubbelslag."
                            }
                        ]
