                    },
                    {
                        "translation_id": "30cd1880-2fd4-451e-818d-49acc06a2e78",
                        "source_entry_id": "962c6ada-978b-34a3-a813-bfc2ef586647",
                        "source_sense_description": "one who prevaricates",
                        "target_lang_word": "veinzer",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "veinzer",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "d0d85aa3-94d1-39d2-b746-c1c257fb7b32",
                                        "entry_id": "d534570f-7102-3cf3-b7b0-22fbb10f4047",
                                        "glosses": [
                                            "iemand die veinst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3189a723-8780-436c-a43b-d53675d420eb",
                                                "sense_id": "d0d85aa3-94d1-39d2-b746-c1c257fb7b32",
                                                "text": "Theophrastus onderscheidde dertig mensentypen. In dertien van de dertig herkennen wij duidelijk iets van Trump: de veinzer, de wauwelaar, de behaagzieke, de desperado, de schaamteloze, de vlegel, de achterdochtige, de weerzinwekkende, de lomperik, de ijdeltuit, de verwaande, de kwaadspreker en de opschepper"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "008d0161-0200-48e5-87b1-6b775a826535",
                        "source_entry_id": "962c6ada-978b-34a3-a813-bfc2ef586647",
                        "source_sense_description": "one who prevaricates",
                        "target_lang_word": "prévaricateur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prévaricateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2a9d4cc5-10ce-361c-8335-cff507e6f47c",
                                        "entry_id": "e8a379a1-0bd7-32c0-ab35-5fa530ac1235",
                                        "glosses": [
                                            "Celui qui prévarique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "14dd130d-a735-4313-aa6d-2a78f613ff46",
                                                "sense_id": "2a9d4cc5-10ce-361c-8335-cff507e6f47c",
                                                "text": "Adam premier prevaricateur avoit livre toute sa posterite a cette damnation de mort, […]"
                                            },
                                            {
                                                "example_id": "1ef4b58b-509c-4ca1-b267-8d99d3fc6268",
                                                "sense_id": "2a9d4cc5-10ce-361c-8335-cff507e6f47c",
                                                "text": "[S]i nous substituons l’irascibilité de l’amour-propre à l’énergie du patriotisme, les méfiances à la discussion, de petites passions haineuses, des réminiscences régulières à des débats réguliers, et vraiment faits pour nous éclairer, nous ne sommes que d’égoïstes prévaricateurs."
                                            },
                                            {
                                                "example_id": "697d38dd-ce15-48b2-a40b-f83efceed24f",
                                                "sense_id": "2a9d4cc5-10ce-361c-8335-cff507e6f47c",
                                                "text": "— Au nom du Dieu vivant, je t’ajourne à trois ans, Laubardemont, juge prévaricateur !"
                                            },
                                            {
                                                "example_id": "206493ca-ca10-476a-aa18-c675e6541935",
                                                "sense_id": "2a9d4cc5-10ce-361c-8335-cff507e6f47c",
                                                "text": "Le temps de rajuster mon turban, et déjà il m’exhibe tel un trophée surréaliste devant une bande de prévaricateurs extrêmement fiers de leur embonpoint."
                                            },
                                            {
                                                "example_id": "e2626480-6997-4d60-828d-0df36264a9a2",
                                                "sense_id": "2a9d4cc5-10ce-361c-8335-cff507e6f47c",
                                                "text": "Le matin aussi, tous les crieurs jurés de la bonne ville de Paris avaient parcouru les quartiers de la cité, surtout les halles et les faubourgs, annonçant de leurs voix rauques et infatigables la grande justice faite par le roi sur deux prévaricateurs, deux larrons affameurs du peuple."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "prévaricateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4df526ea-ecdc-39d9-82e5-209bb214680e",
                                        "entry_id": "b8e0acf5-1a96-3bad-b7fd-301d7404d58d",
                                        "glosses": [
                                            "Qui prévarique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a23839b-5060-483b-a2e1-c66612c50708",
                                                "sense_id": "4df526ea-ecdc-39d9-82e5-209bb214680e",
                                                "text": "Celui qui prefere l’opinion qui flate^([sic]) sa liberté & sa cupidité n'a pas cette assurance : au contraire il doute ou il a lieu de douter s’il n’est point prévaricateur de la Loi de Dieu."
                                            },
                                            {
                                                "example_id": "f659896b-6b35-498c-a3a3-cdbcfc4f6957",
                                                "sense_id": "4df526ea-ecdc-39d9-82e5-209bb214680e",
                                                "text": "Il faut déployer la responsabilité physique, qui est, en dernière analyse, la plus sûre gardienne de la liberté : elle consiste dans la punition des fonctionnaires publics prévaricateurs."
                                            },
                                            {
                                                "example_id": "0c5a1132-59f3-44aa-8d64-b0e00d879355",
                                                "sense_id": "4df526ea-ecdc-39d9-82e5-209bb214680e",
                                                "text": "Vous n’ignorez pas qu’au moment du vote Barroux était à l’Intérieur et Monferrand aux Travaux publics, de sorte que les voilà accusés d’être des ministres prévaricateurs, le plus noir des crimes sociaux."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ab3bcef8-9c45-4296-b790-c1d6183cba2b",
                        "source_entry_id": "962c6ada-978b-34a3-a813-bfc2ef586647",
                        "source_sense_description": "one who prevaricates",
                        "target_lang_word": "prévaricatrice",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prévaricatrice",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cac73549-027a-3c19-a56b-2c160457b351",
                                        "entry_id": "40ab7fc4-a3d3-36d9-a655-fd08eff9ccdf",
                                        "glosses": [
                                            "Celle qui manque gravement aux obligations de sa fonction."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e21bf4df-413b-4c68-af9f-2168a1ce9990",
                                                "sense_id": "cac73549-027a-3c19-a56b-2c160457b351",
                                                "text": "N’êtes vous donc pas une parjure, & une prévaricatrice, de faire hardiment ce que vous avez abjuré avec des termes si sacrez ?^([sic : graphie d’origine])"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "prévaricatrice",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1622a1b3-915b-33ec-9ee2-24319f7b21b9",
                                        "entry_id": "037df0b9-d556-3027-91f0-5e4d82050901",
                                        "glosses": [
                                            "Féminin singulier de prévaricateur."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1e072146-6144-4149-8ca6-c1b447123807",
                                                "sense_id": "1622a1b3-915b-33ec-9ee2-24319f7b21b9",
                                                "text": "Cette femme est blasphématrice et contemptrice de Dieu, dans ses sacrements ; prévaricatrice de loi divine, de la sainte doctrine et des ordonnances ecclésiastiques"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
