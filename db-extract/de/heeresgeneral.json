                "senses": [
                    {
                        "sense_id": "d82f6e5e-f9ec-3e24-b04d-f3401652279b",
                        "entry_id": "5b73bdfc-b36d-3295-a919-d8e694c559ba",
                        "glosses": [
                            "General des Heeres"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7883ff0d-7901-4d9d-83d7-1403c5cfaab1",
                                "sense_id": "d82f6e5e-f9ec-3e24-b04d-f3401652279b",
                                "text": "„In die Herrschaft teilen sich jetzt noch zwei Heeresgenerale und ein Konteradmiral.“"
                            },
                            {
                                "example_id": "25fb4023-ddde-4161-9492-7bc3ef5680f5",
                                "sense_id": "d82f6e5e-f9ec-3e24-b04d-f3401652279b",
                                "text": "„Nach dem Putsch wurde der Heeresgeneral im Mai 1989 mit überwältigender Mehrheit zum Staatschef gewählt.“"
                            },
                            {
                                "example_id": "8a1bc726-8988-4589-9c3b-006a35a4948a",
                                "sense_id": "d82f6e5e-f9ec-3e24-b04d-f3401652279b",
                                "text": "„Keitel: ‚Dafür kommen ja nur Sie in Frage, denn einem anderen Heeresgeneral werden Sie sich (als Oberbefehlshaber der Luftwaffe) ja wohl nicht unterstellen.‘“"
                            },
                            {
                                "example_id": "69d7ddf4-d7ac-4e0b-893c-b1aa4b01f9c2",
                                "sense_id": "d82f6e5e-f9ec-3e24-b04d-f3401652279b",
                                "text": "„Er verwies auf die Erkundungsmission des Heeresgenerals Friedrich Riechmann, die jetzt ausgewertet wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
