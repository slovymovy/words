                "senses": [
                    {
                        "sense_id": "38545503-9600-3e3f-b2fc-86b065d3e12e",
                        "entry_id": "e43bef7c-9b79-3150-9082-3547550e0998",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ac5b888a-4d45-4fc4-8046-081601b4fbfb",
                                "sense_id": "38545503-9600-3e3f-b2fc-86b065d3e12e",
                                "text": "Frau Prasun ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "efad3f3c-e2ed-4527-b8cd-44361aa29ac1",
                                "sense_id": "38545503-9600-3e3f-b2fc-86b065d3e12e",
                                "text": "Herr Prasun wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "b6ee0c08-3816-4c16-8079-a4073a4bc928",
                                "sense_id": "38545503-9600-3e3f-b2fc-86b065d3e12e",
                                "text": "Die Prasuns fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "2491f65f-d140-473f-b4d1-e1f8962d3640",
                                "sense_id": "38545503-9600-3e3f-b2fc-86b065d3e12e",
                                "text": "Der Prasun trägt nie die Schals, die die Prasun ihm strickt."
                            },
                            {
                                "example_id": "9b564011-7ead-4f5f-8700-f5914faeccf4",
                                "sense_id": "38545503-9600-3e3f-b2fc-86b065d3e12e",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Prasun kommt, geht der Herr Prasun.“"
                            },
                            {
                                "example_id": "0d393e2e-b1ab-49d2-a4ba-2b50c52b5c45",
                                "sense_id": "38545503-9600-3e3f-b2fc-86b065d3e12e",
                                "text": "Prasun kommt und geht."
                            },
                            {
                                "example_id": "b397958e-258e-451a-af17-834762c26137",
                                "sense_id": "38545503-9600-3e3f-b2fc-86b065d3e12e",
                                "text": "Prasuns kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
