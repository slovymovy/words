                        "glosses": [
                            "organisatie die consumenten adviseert op het gebied van hypotheken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e8fc0130-f103-44cd-a618-74b632ca4213",
                                "sense_id": "d0eaff6e-d193-3a60-a9dd-53a13074bb6e",
                                "text": "De bedrijven bieden abonnementen aan voor nazorg of als aanvulling op het verstrekte hypotheekadvies. Dat blijkt uit onderzoek van de bond samen met een hypotheekadviesbureau dat zelf geen abonnementen aanbiedt. De kosten voor dergelijke abonnementen lopen uiteen van 7 euro tot 50 euro per maand."
                            },
                            {
                                "example_id": "161f0eed-de8c-4362-be21-e123507dcdb4",
                                "sense_id": "d0eaff6e-d193-3a60-a9dd-53a13074bb6e",
                                "text": "Het hypotheekadviesbureau noemt de stijging opvallend omdat het voor starters doorgaans juist moeilijk is een huis te kopen. Het aantal starters in de leeftijd 25 tot 35 neemt al enige tijd af doordat de hypotheekregels steeds strenger worden en er te weinig starterswoningen zijn. Jongeren stellen het kopen van een huis dan ook uit."
                            }
                        ]
                    }
