                "senses": [
                    {
                        "sense_id": "92474d3a-25ef-3781-a09b-100cbfb4c4f5",
                        "entry_id": "ee3f48e0-f882-367b-9935-a525e6a75a51",
                        "glosses": [
                            "Staatsbürgerin des Sudan"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af8bcfd9-58c5-4466-a140-0218da67ab24",
                                "sense_id": "92474d3a-25ef-3781-a09b-100cbfb4c4f5",
                                "text": "„Sie erzählten, dass die Sudanesinnen schwere Goldringe in der Nase trügen, dass der König der Fungi zu Sennar, der Hauptstadt seines Reiches, eine Serieba von Elefantenzähnen um seinen Strohpalast gezogen habe, wie man sich dasselbe noch heutzutage vom Sultan Darfurs erzählt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "28b105e2-13c2-451c-a19d-349ad3cc6c9b",
