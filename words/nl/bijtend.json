                                "target_lang_sense_clarification": "froid ou substance"
                            },
                            {
                                "target_lang_word": "glaçant",
                                "target_lang_sense_clarification": "pour le froid vif"
                            },
                            {
                                "target_lang_word": "cuisant",
                                "target_lang_sense_clarification": "douleur ou froid"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "000e5048-3f71-30c9-9ccc-b74c60366a9a",
                    "sense_definition": "op een scherpe, hatelijke of kwetsende manier sarcastisch",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "figuurlijk_scherp",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij maakte een <w>bijtende</w> opmerking over het werk van zijn collega.",
                            "target_lang_translations": {
                                "fr": "Il a fait une remarque <w>acerbe</w> sur le travail de son collègue."
                            }
                        },
                        {
                            "text": "Haar reactie was buitengewoon <w>bijtend</w> en maakte iedereen stil.",
                            "target_lang_translations": {
                                "fr": "Sa réaction a été extrêmement <w>cinglante</w> et a fait taire tout le monde."
                            }
                        }
                    ],
                    "synonyms": [
                        "bits",
                        "hatelijk",
                        "sarcastisch"
                    ],
                    "common_phrases": [
                        "bijtende spot",
                        "bijtende humor"
                    ],
                    "target_lang_definitions": {
                        "fr": "sarcastique d'une manière tranchante, blessante ou acerbe"
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "mordant",
                                "target_lang_sense_clarification": "ironie ou ton tranchant"
                            },
                            {
                                "target_lang_word": "acerbe",
                                "target_lang_sense_clarification": "critique ou parole blessante"
                            },
                            {
                                "target_lang_word": "caustique",
                                "target_lang_sense_clarification": "humour ou remarque piquante"
                            },
                            {
                                "target_lang_word": "cinglant",
                                "target_lang_sense_clarification": "réplique ou remarque sèche"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "46e5463b-0606-3e59-b455-00bd9c128c5d",
                    "sense_definition": "onvoltooid deelwoord van <w>bijten</w>",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "werkwoord_vorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Al nagels <w>bijtend</w> wachtte hij nerveus op de uitslag van het examen.",
                            "target_lang_translations": {
                                "fr": "<w>En se rongeant</w> les ongles, il attendait nerveusement les résultats de l'examen."
                            }
                        },
                        {
                            "text": "De hond rende luid blaffend en wild om zich heen <w>bijtend</w> door de straat.",
                            "target_lang_translations": {
                                "fr": "Le chien courait dans la rue en aboyant bruyamment et <w>mordant</w> sauvagement tout autour de lui."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "deelwoord"
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "participe présent du verbe « bijten » (mordre)"
                    },
                    "translations": {
