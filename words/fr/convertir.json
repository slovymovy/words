                        "convertir en euros"
                    ]
                },
                {
                    "sense_id": "2fe60af5-200a-3295-aa13-03fc9342f26c",
                    "sense_definition": "Persuader une personne de changer d'avis, d'opinion ou de rallier une cause.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle a présenté des arguments solides pour <w>convertir</w> ses collègues à sa proposition."
                        },
                        {
                            "text": "Il est souvent difficile de <w>convertir</w> les électeurs hésitants durant une campagne politique."
                        }
                    ],
                    "synonyms": [
