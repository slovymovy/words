                "entry_id": "b8e8dabf-adae-392d-8bec-64cbdd4b15bd",
                "word": "gauwigheid",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "2914e5eb-a412-3ecc-a3e0-1aceb730dcef",
                        "entry_id": "b8e8dabf-adae-392d-8bec-64cbdd4b15bd",
                        "glosses": [
                            "in de gauwigheid: door (te) snel te handelen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa9b5fbe-5bee-43d5-9b1d-acde436593f9",
                                "sense_id": "2914e5eb-a412-3ecc-a3e0-1aceb730dcef",
                                "text": "Op de laatste zaterdagmiddag van oktober zit het goed vol bij CEO Baas van de Lunch, zowel binnen als buiten op de stoep van de Karel Doormanstraat. In de gauwigheid zie ik één vrije tafel voor twee, zo’n verhoogde tafel, maar vooruit. Ik stel me op voor de bar waarachter twee medewerkers druk in de weer zijn, een ander loopt met volle borden heen en met lege borden terug."
                            },
                            {
                                "example_id": "f373d127-de1c-439f-a199-43a204287fb6",
                                "sense_id": "2914e5eb-a412-3ecc-a3e0-1aceb730dcef",
                                "text": "Revu-hoofdredacteur Erik Noomen geeft het goede voorbeeld, terwijl andere journalisten het principe van wederhoor in de gauwigheid weleens vergeten."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b48e5a51-87d8-4c4e-9e60-c6aa5ad185bc",
                        "source_entry_id": "b8e8dabf-adae-392d-8bec-64cbdd4b15bd",
                        "source_sense_id": "2914e5eb-a412-3ecc-a3e0-1aceb730dcef",
                        "source_sense_description": "in de gauwigheid: door (te) snel te handelen",
                        "target_lang_word": "haste",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "haste",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "da841aba-33f7-32e7-9346-199998d71748",
                                        "entry_id": "e73e886f-a3a2-3e88-b9d0-d84cf4398665",
                                        "glosses": [
                                            "Speed; swiftness; dispatch."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cb629ba1-01cc-4369-aaff-4b193d014748",
                                                "sense_id": "da841aba-33f7-32e7-9346-199998d71748",
                                                "text": "We were running late so we finished our meal in haste."
                                            },
                                            {
                                                "example_id": "e26fe443-48f3-4216-9734-3cce36b475f4",
                                                "sense_id": "da841aba-33f7-32e7-9346-199998d71748",
                                                "text": "The king's business required haste."
                                            },
                                            {
                                                "example_id": "8237e6d2-1b87-4831-b523-92b79fbf78d9",
                                                "sense_id": "da841aba-33f7-32e7-9346-199998d71748",
                                                "text": "There was a stampede as the congressmen jumped the banister in their hastes to be the first to sign away their souls."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "939de1ff-3111-34b7-9e35-5ee573b888e1",
                                        "entry_id": "e73e886f-a3a2-3e88-b9d0-d84cf4398665",
                                        "glosses": [
                                            "Urgency; sudden excitement of feeling or passion; precipitance; vehemence."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6e36dcc4-29e3-429d-8163-a831c9449f85",
                                                "sense_id": "939de1ff-3111-34b7-9e35-5ee573b888e1",
                                                "text": "I said in my haste, All men are liars."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "haste",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cf212c29-f3c4-39a5-85d3-2f4ff4491b50",
                                        "entry_id": "c857a620-110a-3b5a-bda5-190f1d500897",
                                        "glosses": [
                                            "To urge onward; to hasten."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb38f945-f0bc-45fe-895c-c8a8718e0b3a",
                                                "sense_id": "cf212c29-f3c4-39a5-85d3-2f4ff4491b50",
                                                "text": "Baſſ. You may doe ſo, but let it be ſo haſted that ſupper be readie at the fartheſt by fiue of the clocke."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1f557222-1d96-30d3-92f6-db4a9c7f5957",
                                        "entry_id": "c857a620-110a-3b5a-bda5-190f1d500897",
                                        "glosses": [
                                            "To move with haste."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ebac4c0-5611-4571-b56d-22ac1b4ebaa2",
                                                "sense_id": "1f557222-1d96-30d3-92f6-db4a9c7f5957",
                                                "text": "The city is amaz'd, for Sylla hastes / To enter Rome with fury, sword and fire."
                                            },
                                            {
                                                "example_id": "f3d2ad6d-dc25-49fe-af2e-59600a3ea89f",
                                                "sense_id": "1f557222-1d96-30d3-92f6-db4a9c7f5957",
                                                "text": "He hastes away to another, whom his affairs have called to a distant place, and, having seen the empty house, goes away disgusted by a disappointment which could not be intended, because it could not be foreseen."
                                            },
                                            {
                                                "example_id": "021c6186-251c-4c2c-83ac-ea640c50805d",
                                                "sense_id": "1f557222-1d96-30d3-92f6-db4a9c7f5957",
                                                "text": "Samson hastes not; but neither does he pause to rest."
                                            },
                                            {
                                                "example_id": "e6ca14eb-14c9-486f-8c7d-91c2b599e783",
                                                "sense_id": "1f557222-1d96-30d3-92f6-db4a9c7f5957",
                                                "text": "Waziri’s warriors marched at a rapid trot through the jungle in the direction of the village. For a few minutes, the sharp cracking of guns ahead warned them to haste, but finally the reports dwindled to an occasional shot, presently ceasing altogether."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
