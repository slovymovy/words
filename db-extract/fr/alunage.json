                "senses": [
                    {
                        "sense_id": "307461f7-f326-3da8-9fa8-1538a72b2531",
                        "entry_id": "b200da35-d53f-3ab3-a868-c101cc600881",
                        "glosses": [
                            "Action d’aluner ; traitement par l'alun."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc0351d0-17e1-445e-a6f3-123fa65132b6",
                                "sense_id": "307461f7-f326-3da8-9fa8-1538a72b2531",
                                "text": "Lʼalunage se fait de préférence avec lʼacétate neutre dʼalumine, ou mordant à lʼacétosulfate dʼalumine."
                            },
                            {
                                "example_id": "32478df3-1e58-41ae-828e-5ef9ca525627",
                                "sense_id": "307461f7-f326-3da8-9fa8-1538a72b2531",
                                "text": "On a donné plusieurs formules d’alunage, soit à l’aide de l’alun de potasse, soit à l’aide de l’alun de chrome : […]."
                            },
                            {
                                "example_id": "f9cb6eac-17ce-482e-b17e-02e80f07d4c1",
                                "sense_id": "307461f7-f326-3da8-9fa8-1538a72b2531",
                                "text": "Pour faire ces verds, après avoir cuit la soie, on l’alune fortement ; après l’alunage, on raffraîchit à la riviere, & on distribue la soie en petits mateaux comme de quatre ou cinq onces."
                            }
                        ]
                    }
                ],
