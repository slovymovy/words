                "senses": [
                    {
                        "sense_id": "3b9c9db7-bd37-3330-a882-8e8395d7f2fc",
                        "entry_id": "21e75b3b-3334-32ef-8661-d6ad68f2325c",
                        "glosses": [
                            "прич. от загнить, начавший гнить; ставший гнилым"
                        ],
                        "tags": [
                            "participle"
                        ],
                        "examples": [
                            {
                                "example_id": "7b6506af-88e0-41e4-8304-a85758efbf26",
                                "sense_id": "3b9c9db7-bd37-3330-a882-8e8395d7f2fc",
                                "text": "Куски сахара, сушёные фрукты, загнивший лук, мятые пачки махорки разлетались по полу."
                            },
                            {
                                "example_id": "18095526-8b48-4ebb-a897-dd7ba152d5f7",
                                "sense_id": "3b9c9db7-bd37-3330-a882-8e8395d7f2fc",
                                "text": "Повсюду лужи загнившей воды, и ужасная вонь поднимается со всех сторон."
                            }
                        ]
                    },
                    {
                        "sense_id": "4baa6b73-86bb-3546-abb0-6b95dd74eaf3",
                        "entry_id": "21e75b3b-3334-32ef-8661-d6ad68f2325c",
                        "glosses": [
                            "перен. прич. от загнить пришедший в упадок, перешедший к разложению"
                        ],
