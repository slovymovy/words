                    },
                    {
                        "translation_id": "9d3d7dad-cf86-4994-a134-ce11bd90583b",
                        "source_entry_id": "01b5e678-21fc-377c-b2b7-e35276a09e3b",
                        "source_sense_id": "7e49fcef-a59c-3b7a-a99a-9165454a8358",
                        "target_lang_word": "Kegelbahn",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kegelbahn",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cce83d26-41d3-3cd9-8874-8c7ce77085fa",
                                        "entry_id": "67420681-2e73-3f24-9275-5a4cb9aac4eb",
                                        "glosses": [
                                            "Bahn zum Kegeln, hergestellt aus Asphalt, Holz oder Kunststoff"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9485a7e-6968-4148-9412-edcc91fe838c",
                                                "sense_id": "cce83d26-41d3-3cd9-8874-8c7ce77085fa",
                                                "text": "Die Kegelbahn wurde gerade von einer Poliermaschine gereinigt."
                                            },
                                            {
                                                "example_id": "608e7d90-a157-4272-8b7e-83f40ad8cdd6",
                                                "sense_id": "cce83d26-41d3-3cd9-8874-8c7ce77085fa",
                                                "text": "„Georg Kroll ist knapp vierzig Jahre; aber sein Kopf glänzt bereits wie die Kegelbahn im Gartenrestaurant Boll.“"
                                            },
                                            {
                                                "example_id": "df5cdd52-d7f6-4800-9585-008f3b38e46a",
                                                "sense_id": "cce83d26-41d3-3cd9-8874-8c7ce77085fa",
                                                "text": "„Ich sagte, dass ich große Lust zum Kegeln hätte, Papa aber sagte, dass man nicht am Nachmittag kegle, sondern am Abend, und wenn die Kegelbahn frei sei, würden wir dann auch versuchen, am Abend zu kegeln, vorher aber sollten wir uns die Mosel anschauen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
