                                "example_id": "b8265971-94a2-4a5a-b9a9-67b29d043f2f",
                                "sense_id": "24c3f5dd-1d08-3b9b-9c61-c3d750d69dfe",
                                "text": "„Die morphologischen Veränderungen bei Asthma entsprechen einer serös-katarrhalischen Entzündung, die durch die besonderen Verhältnisse in der Atemwegsschleimhaut geprägt ist.“"
                            },
                            {
                                "example_id": "2c5b590d-4206-4e4d-b9e7-2bac2da0759c",
                                "sense_id": "24c3f5dd-1d08-3b9b-9c61-c3d750d69dfe",
                                "text": "„Die kausale therapeutische Alternative besteht in der Stimulation der lokalen Immunantwort der Atemwegsschleimhaut.“"
                            },
                            {
                                "example_id": "38588209-f041-4987-9d9a-1a47b2a2ce14",
                                "sense_id": "24c3f5dd-1d08-3b9b-9c61-c3d750d69dfe",
                                "text": "„Außerdem tragen die Atemwegsschleimhäute zur Erwärmung und Anfeuchtung der eingeatmeten Luft bei […].“"
                            }
