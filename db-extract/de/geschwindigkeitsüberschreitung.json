                "senses": [
                    {
                        "sense_id": "be119a92-3f49-3f44-9923-e420b6421ad4",
                        "entry_id": "5e98ce2e-45e4-31d3-a45b-b9976c562a69",
                        "glosses": [
                            "Excès de vitesse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "165be0bf-34fa-456d-9fe0-5ce8cac120e0",
                                "sense_id": "be119a92-3f49-3f44-9923-e420b6421ad4",
                                "text": "Am 3.März 1991 wird Rodney King wegen einer Geschwindigkeitsüberschreitung von der kalifornischen Polizei angehalten.",
                                "translation": "Le 3 mars 199, Rodney King est arrêté par la police californienne pour un excès de vitesse."
                            },
                            {
                                "example_id": "9388683e-de0f-4668-b574-da4e67883e48",
                                "sense_id": "be119a92-3f49-3f44-9923-e420b6421ad4",
                                "text": "Eine Geschwindigkeitsüberschreitung bis zu 20 km/h wird einen Kraftfahrer in Polen beispielsweise bis zu 25 Euro (100 PLN) kosten. Bei höheren Geschwindigkeitsüberschreitungen kann ein Bußgeld zwischen 25 und 125 Euro (100 und 500 PLN) erhoben werden.",
                                "translation": "En Pologne, un chauffeur [de bus, de camion] ayant commis excès de vitesse allant jusqu’à 20 km/h doit s’acquitter d’une amende de 25 euros (100 PLN). Pour des plus grands excès de vitesse, la contravention peut s’élever jusqu’à 125 euros (500 PLN)."
                            }
                        ]
                    }
