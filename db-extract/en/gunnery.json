    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "4258807a-acc4-3969-a8c3-c4e9d5e453ef",
                "word": "gunnery",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "14ee3b8c-e2f7-413b-84c9-24988c945d52",
                        "entry_id": "4258807a-acc4-3969-a8c3-c4e9d5e453ef",
                        "tags": [
                            "plural"
                        ],
                        "form": "gunneries"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3a92363d-34f7-3482-b7cf-8285e63c6be4",
                        "entry_id": "4258807a-acc4-3969-a8c3-c4e9d5e453ef",
                        "glosses": [
                            "The science of guns and gunfire, including aspects of bullet flight and impact."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "86556d9d-b9bc-42e0-9680-d62a9f562233",
                                "sense_id": "3a92363d-34f7-3482-b7cf-8285e63c6be4",
                                "text": "When I have learnt what progress has been made in modern gunnery— / When I know more of tactics than a novice in a nunnery,—"
                            }
                        ]
                    },
                    {
                        "sense_id": "cb97a393-82d9-35f1-bf91-40b45b30ee2e",
                        "entry_id": "4258807a-acc4-3969-a8c3-c4e9d5e453ef",
                        "glosses": [
                            "The design and manufacture of guns, particularly those of a large caliber."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "29420783-343a-4209-a49f-3f54a171b4ed",
                                "sense_id": "cb97a393-82d9-35f1-bf91-40b45b30ee2e",
                                "text": "Originally, doubtless, that petty officer's function was the instruction of the men in the use of arms, sword, or cutlass. But very long ago, owing to the advance in gunnery, making hand-to-hand encounters less frequent, and giving to nitre and sulphur the preeminence over steel, that function ceased [...]"
                            }
                        ]
                    },
                    {
                        "sense_id": "bddb0b29-afe9-3d94-9da8-eb1960bd8710",
                        "entry_id": "4258807a-acc4-3969-a8c3-c4e9d5e453ef",
                        "glosses": [
                            "The firing of guns."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "06f2d04c-de31-4a1d-8754-dfe886a75213",
                                "sense_id": "bddb0b29-afe9-3d94-9da8-eb1960bd8710",
                                "text": "Northward incessantly, the flickering gunnery rumbles, / Far off, like a dull rumour of some other war."
                            },
                            {
                                "example_id": "c787807a-18a3-4698-b008-89b4c481f45b",
                                "sense_id": "bddb0b29-afe9-3d94-9da8-eb1960bd8710",
                                "text": "The 12th march company telephoned claiming that someone in the office had heard that they were waiting to do some shooting practice at moveable targets and that they would only leave after gunnery practice under front conditions."
                            },
                            {
                                "example_id": "c482ffe0-d58c-4bce-b70f-5a4adcc48e5c",
                                "sense_id": "bddb0b29-afe9-3d94-9da8-eb1960bd8710",
                                "text": "Basically, the problem was actually the British had too many ships! The Grand Fleet wasn't half bad with its gunnery, but there was so many battleships throwing fire at the battlecruisers and battleships of the High Seas Fleet that it was actually very difficult to tell \"Is that splash from us? Is that splash from that ship? Is that splash from a ship in another division? We don't know!\", so a lot of incorrect estimates and measures were taken, which lead to an awful lot of waterspouts going up, but not anywhere near the number of hits that you would otherwise expect[…]"
                            }
                        ]
                    },
                    {
                        "sense_id": "818c370f-3617-301b-ae51-04dfab4e4abb",
                        "entry_id": "4258807a-acc4-3969-a8c3-c4e9d5e453ef",
                        "glosses": [
                            "A place where guns are tested, or where people are trained in their use."
                        ],
                        "tags": [
                            "countable",
                            "usually"
                        ],
                        "examples": []
                    }
                ],
