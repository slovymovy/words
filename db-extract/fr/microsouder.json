                "senses": [
                    {
                        "sense_id": "d4538c8e-ee9a-32c3-8ff7-058907529bac",
                        "entry_id": "57185f32-8329-3822-a198-f97a318c1e6d",
                        "glosses": [
                            "Faire une microsoudure."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2f19ae2a-7d38-45d1-9bf1-8aee46bdd5b1",
                                "sense_id": "d4538c8e-ee9a-32c3-8ff7-058907529bac",
                                "text": "Après polissage au carbure de silicium de gradation 600, dégraissage à l'acétone puis lavage aux ultrasons et séchage, les échantillons sont munis d'un crochet de platine microsoudé électriquement de façon à permettre la suspension à la thermobalance."
                            },
                            {
                                "example_id": "e341cacb-3ad4-4e52-8d5e-d02d684d61c6",
                                "sense_id": "d4538c8e-ee9a-32c3-8ff7-058907529bac",
                                "text": "Nous pouvons tourner, fraiser, meuler, couder, épointer, polir, percer de très petits orifices, braser (brasure tendre ou à l'argent) et microsouder."
                            }
                        ]
                    }
