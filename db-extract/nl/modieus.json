                        "cross_references": [
                            {
                                "target_word": "modisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5c1aee85-39d1-3402-9b11-ac474f8c7085",
                                        "entry_id": "453468f0-5ced-3405-827f-4dd910b2f1b3",
                                        "glosses": [
                                            "sehr auf sein Äußeres achtend und dabei sich dem zeitbedingten Geschmack anpassend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26046492-f8f2-4210-a566-398129711e3f",
                                                "sense_id": "5c1aee85-39d1-3402-9b11-ac474f8c7085",
                                                "text": "Im Osten hat's damals nicht so viele modische Sachen gegeben, deshalb waren die Jugendlichen ganz wild auf \"West-Jeans\"."
                                            },
                                            {
                                                "example_id": "1d977c71-1983-4bb3-ab38-af417facecb1",
                                                "sense_id": "5c1aee85-39d1-3402-9b11-ac474f8c7085",
                                                "text": "Schlipse waren ursprünglich Halstücher, bei denen es Geschick und Kreativität erforderte, sie modisch zu falten und zu binden."
                                            },
                                            {
                                                "example_id": "a79188e7-bbb8-4d40-913e-3aa4259e8e35",
                                                "sense_id": "5c1aee85-39d1-3402-9b11-ac474f8c7085",
                                                "text": "Der urbane Radfahrer möchte nicht nur ein auf seinen Geschmack zugeschnittenes Fahrrad, er selbst möchte beim Radeln auch gut und modisch aussehen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "08d535bf-5e17-3fbe-afed-04cdbf1b355f",
                                        "entry_id": "453468f0-5ced-3405-827f-4dd910b2f1b3",
                                        "glosses": [
                                            "dem aktuellen Zeitgeist oder der vorherrschenden Meinung entsprechend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb0a437d-88de-478d-9f07-9ea1beb36ba9",
                                                "sense_id": "08d535bf-5e17-3fbe-afed-04cdbf1b355f",
                                                "text": "Was [der Autor Ewald] Palmetshofers in seinem Stück [\"die unverheiratete\", mit dem er in der Inszenierung des Burgtheaters Wien den renommierten Mülheimer Dramatikerpreis 2015 gewonnen hat,] sprachlich wage, sei sehr eigen, nicht modisch."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7eaf7145-9c78-4126-a27e-bb56ef01870d",
                        "source_entry_id": "43184a1b-2042-3231-931c-6c4a3a81b5d1",
                        "source_sense_id": "46e92db9-b140-31f3-8521-0d5dc576bbe1",
