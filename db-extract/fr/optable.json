                        "glosses": [
                            "Pour quoi on peut opter."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b656136d-cdc7-4eab-a61a-9ec4097267c5",
                                "sense_id": "ccb2216a-39f6-383c-b355-c97791015c3e",
                                "text": "Régime du bénéfice mondial consolidé qui était optable càd qu'on pouvait opter pour ce régime."
                            },
                            {
                                "example_id": "9a7a704b-02e5-45da-892b-87de0edaad07",
                                "sense_id": "ccb2216a-39f6-383c-b355-c97791015c3e",
                                "text": "Alors que le régime actuel prévoit une option globale qui s’applique automatiquement à l’ensemble des opérations optables lorsqu’elle est formulée, le nouveau régime permettrait de substituer à ce caractère global une option précise opération par opération, sans cantonnement par type d’activité."
                            },
                            {
                                "example_id": "ecc79685-af87-4b7e-afdf-62f236ae5cd1",
                                "sense_id": "ccb2216a-39f6-383c-b355-c97791015c3e",
                                "text": "Opérations taxables, exonérées et optables."
                            }
                        ]
                    }
