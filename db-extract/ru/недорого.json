                    {
                        "translation_id": "872ffc1f-d68c-4bb0-8c9c-f1f68932a79f",
                        "source_entry_id": "6b7ea6df-b9ea-35dd-bddd-770511e4f03b",
                        "source_sense_description": "по низкой цене",
                        "target_lang_word": "à bon marché",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "à bon marché",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ff2f6526-1316-3cf7-96be-6cc9b91b784d",
                                        "entry_id": "97342c78-82f1-32dd-aaa0-31f724573427",
                                        "glosses": [
                                            "Avec moins de perte, de dommage qu’on n’en avait à craindre."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf13d2e1-e5a5-4558-9dbf-a7081c33599c",
                                                "sense_id": "ff2f6526-1316-3cf7-96be-6cc9b91b784d",
                                                "text": "En être quitte, en sortir à bon marché."
                                            },
                                            {
                                                "example_id": "bacbdc4a-e1c3-4292-8d34-328bfae7bb4d",
                                                "sense_id": "ff2f6526-1316-3cf7-96be-6cc9b91b784d",
                                                "text": "Elle courait follement, heureuse d’en être quitte à si bon marché."
                                            },
                                            {
                                                "example_id": "1b0d2eda-025a-42d2-9ffe-08db12ae4945",
                                                "sense_id": "ff2f6526-1316-3cf7-96be-6cc9b91b784d",
                                                "text": "Ils se levèrent tous pour le départ, heureux évidemment d’en être quittes à si bon marché."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "65faf955-7725-3216-b363-2ef2d1e8c10e",
                                        "entry_id": "97342c78-82f1-32dd-aaa0-31f724573427",
                                        "glosses": [
                                            "À peu de frais, sans beaucoup de peine."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c76db521-ea07-4432-8555-a6071e469dd0",
                                                "sense_id": "65faf955-7725-3216-b363-2ef2d1e8c10e",
                                                "text": "Ne donner que son superflu, c’est être généreux à bon marché. — Dans ce temps-là, on se faisait une réputation d’esprit à bon marché."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "88f65055-3586-3943-a29c-3cc870c994b1",
                                        "entry_id": "97342c78-82f1-32dd-aaa0-31f724573427",
                                        "glosses": [
                                            "À bas prix ; à des conditions particulièrement avantageuses."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "874852c4-6ad1-4db5-80a7-e893fef6b7b7",
                                                "sense_id": "88f65055-3586-3943-a29c-3cc870c994b1",
                                                "text": "En dehors de cela, de la vie réelle, personnelle, on leur avait laissé deux choses : l’abrutissement de l’alcool et la jouissance immédiate, à bon marché, à la maison publique."
                                            },
                                            {
                                                "example_id": "be7850e2-835a-4ed7-b1b5-022ed2c7e778",
                                                "sense_id": "88f65055-3586-3943-a29c-3cc870c994b1",
                                                "text": "Ils plaçaient aussi des phonographes à bon marché et tiraient quelques profits de la vente des boîtes à musique."
                                            },
                                            {
                                                "example_id": "35855e53-8374-4e41-83de-219c38158d18",
                                                "sense_id": "88f65055-3586-3943-a29c-3cc870c994b1",
                                                "text": "Au bout d'une vingtaine de mètres, il s’arrêta devant un restaurant, une boite à bon marché, et nous invita à entrer avec lui, histoire de manger et de boire un peu."
                                            },
                                            {
                                                "example_id": "fd17b6ea-d5e9-4c03-a30f-6d006f113b41",
                                                "sense_id": "88f65055-3586-3943-a29c-3cc870c994b1",
                                                "text": "Dans le but de fournir l'eau chaude à bon marché dans les maisons du Congo belge, il serait possible d'établir des chauffe-eaux solaires."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
