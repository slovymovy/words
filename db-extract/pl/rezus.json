                                "target_senses": [
                                    {
                                        "sense_id": "b44a18a3-ba92-325e-b149-76bfda6970ca",
                                        "entry_id": "d39813ff-a652-3256-a6c3-776f931560fe",
                                        "glosses": [
                                            "Macaca mulatta een makaak uit de familie der apen van de Oude Wereld (Cercopithecidae) waarbij de resusfactor het eerst ontdekt werd"
                                        ],
                                        "tags": [
                                            "primaten"
                                        ],
