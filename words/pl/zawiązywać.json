                        {
                            "text": "Po obfitym kwitnieniu krzewy zaczęły <w>zawiązywać</w> owoce.",
                            "target_lang_translations": {
                                "ru": "После обильного цветения кустарники начали <w>завязывать</w> плоды."
                            }
                        }
                    ],
                    "synonyms": [
                        "tworzyć"
                    ],
                    "common_phrases": [
