                "senses": [
                    {
                        "sense_id": "e48898ff-44a2-32c2-83e8-a3af607b4d9a",
                        "entry_id": "31ee04b0-b47b-3a98-955a-c74fa88bb603",
                        "glosses": [
                            "wroetende of stampende beweging maken op een onvaste bodem"
                        ],
                        "tags": [
                            "unergative"
                        ],
                        "examples": [
                            {
                                "example_id": "2cf11207-b39e-401e-b6fc-a1822a2dd68e",
                                "sense_id": "e48898ff-44a2-32c2-83e8-a3af607b4d9a",
                                "text": "Uit het slijk steken roestige skeletten van vliegtuigen, waarin en waaromheen modderige kinderen spelen. Op sommige plaatsen staan grote plassen water waar de kleinsten in rond dabberen."
                            },
                            {
                                "example_id": "e3589869-a864-49f3-ae33-1d8c220acf8a",
                                "sense_id": "e48898ff-44a2-32c2-83e8-a3af607b4d9a",
                                "text": "Doch, Argus, 't is vergeefs in al dit vuil te dabberen."
                            }
                        ]
                    },
