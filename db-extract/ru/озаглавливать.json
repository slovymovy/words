                                        "sense_id": "bcac1354-0975-3e0f-9572-97371523ff61",
                                        "entry_id": "c35d39ff-7888-3303-a435-1fdbcd9b419d",
                                        "glosses": [
                                            "The heading or title of a magazine or newspaper article."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "083c33e6-8671-48f3-aa40-83d3e4e4f8a8",
                                                "sense_id": "bcac1354-0975-3e0f-9572-97371523ff61",
                                                "text": "The headline on today's newspaper reads \"John Doe Wins Wood-Splitting Competition.\""
                                            },
                                            {
                                                "example_id": "999c7082-d6b1-4b95-9f22-01f50dc6fc5c",
                                                "sense_id": "bcac1354-0975-3e0f-9572-97371523ff61",
                                                "text": "Say that you'll never, never, never, never need it\nOne headline, why believe it?\nEverybody wants to rule the world"
                                            },
                                            {
                                                "example_id": "c4678da1-5b47-479f-937f-0963e0dfc7d7",
                                                "sense_id": "bcac1354-0975-3e0f-9572-97371523ff61",
                                                "text": "Risk is everywhere. From tabloid headlines insisting that coffee causes cancer (yesterday, of course, it cured it) to stern government warnings about alcohol and driving, the world is teeming with goblins. For each one there is a frighteningly precise measurement of just how likely it is to jump from the shadows and get you."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "73776773-4c2f-3b9e-b38c-69882a921e4e",
                                        "entry_id": "c35d39ff-7888-3303-a435-1fdbcd9b419d",
                                        "glosses": [
                                            "The line at the top of a page containing the folio or number of the page."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "86c7cf2b-7545-3e93-93dd-0bcdfdc23efe",
                                        "entry_id": "c35d39ff-7888-3303-a435-1fdbcd9b419d",
                                        "glosses": [
                                            "The top-billed attraction."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "749ae4e9-9f04-37cd-9d6e-781cc9c2d0b6",
                                        "entry_id": "c35d39ff-7888-3303-a435-1fdbcd9b419d",
                                        "glosses": [
                                            "A headrope."
                                        ],
                                        "tags": [],
