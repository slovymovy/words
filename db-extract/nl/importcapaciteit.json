                        "examples": [
                            {
                                "example_id": "d7087931-55f8-4f00-90f2-eb33036d7e61",
                                "sense_id": "0070d3a4-6423-31a6-af2f-8450341022c5",
                                "text": "Er is de afgelopen maanden gewerkt aan alternatieven voor Russisch gas. Zo verdubbelt dit jaar de importcapaciteit van lng (vloeibaar gemaakt gas) van zo'n 12 miljard naar 24 miljard kubieke meter. Nederland gebruikt jaarlijks zo'n 40 miljard kubieke meter."
                            },
                            {
                                "example_id": "639aa98d-770d-46dc-a590-117ee54c47a9",
                                "sense_id": "0070d3a4-6423-31a6-af2f-8450341022c5",
                                "text": "Het Nederlandse kabinet werkt intussen alvast aan het vergroten van de importcapaciteit van lng. Gedacht wordt aan uitbreiding van een bestaande terminal in Rotterdam en aan een drijvende lng-terminal in de Eemshaven."
                            }
                        ]
