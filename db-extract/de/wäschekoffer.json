                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5880072a-2501-4d7e-8385-b3362bf6a3cc",
                                "sense_id": "991eeb33-d631-31ce-b593-5089a0e20e54",
                                "text": "„Mit Hilfe von Clairmont schleppte ich sogleich meinen Wäschekoffer in ihr Zimmer und sagte ihr, ich würde jeden Tag ein Hemd, eine Weste, eine Halsbinde, eine Unterhose und zwei Taschentücher benötigen, die Wahl sei mir gleichgültig.“"
                            },
                            {
                                "example_id": "5e4305b0-ae3c-4708-8865-40e5d4dd65cb",
                                "sense_id": "991eeb33-d631-31ce-b593-5089a0e20e54",
                                "text": "„Viele ordneten dieses Album 2015 irgendwo ein, betrachteten es als Teil einer größeren Bewegung, für die der an sich gut zusammengefaltete Begriff Austropop wieder aus dem Wäschekoffer mit der Winterbekleidung gezerrt wurde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
