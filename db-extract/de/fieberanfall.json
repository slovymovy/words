                ],
                "senses": [
                    {
                        "sense_id": "5c66244a-8313-36ef-b11f-0d8138c8d280",
                        "entry_id": "02bce5eb-13ea-3fdd-9ce8-81f139a858c7",
                        "glosses": [
                            "plötzlich ausbrechendes Fieber"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d73611c4-9133-44f6-bc9e-99878fc30393",
                                "sense_id": "5c66244a-8313-36ef-b11f-0d8138c8d280",
                                "text": "„Doch dann quälen auch ihn Fieberanfälle, sodass er sich auf dem Rückweg kaum auf seinem Pferd halten kann.“"
                            },
                            {
                                "example_id": "f43fe5e4-eed0-401b-8809-416623c964b8",
                                "sense_id": "5c66244a-8313-36ef-b11f-0d8138c8d280",
                                "text": "„Es war die Zeit, in der Karatajew nach seinem Fieberanfall gewöhnlich etwas auflebte und nun besonders munter war.“"
                            },
                            {
                                "example_id": "21c6e532-fd8c-4414-b3c3-723f2645434c",
                                "sense_id": "5c66244a-8313-36ef-b11f-0d8138c8d280",
                                "text": "„Der Übergang von der Angst zu einem unerwarteten Glücksrausch warf mich in einen Paroxysmus, wie ihn der stärkste Fieberanfall nicht ärger hätte verursachen können.“"
                            },
                            {
                                "example_id": "ce0825d7-7aea-4918-82db-27434d734ae4",
                                "sense_id": "5c66244a-8313-36ef-b11f-0d8138c8d280",
                                "text": "„Während er dem dritten Fieberanfall entgegendämmerte, schwoll auch noch seine Leber an.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
