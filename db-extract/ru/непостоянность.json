                "senses": [
                    {
                        "sense_id": "c6d2bda8-437b-3cb0-a915-590ff3008aa7",
                        "entry_id": "63b45285-63ed-3009-973a-3e5f7f33742e",
                        "glosses": [
                            "свойство по значению прилагательного непостоянный; изменчивость"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fca82ea7-f4fc-47c0-a039-29e64def8eb6",
                                "sense_id": "c6d2bda8-437b-3cb0-a915-590ff3008aa7",
                                "text": "История показывает непостоянность бытия, границ и форм государств, создаваемых как на территориально-этнической основе, так и в силу экономических, политических, военных и иных подобных причин."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "075955a8-6ab6-4b86-b184-815ba70519e1",
                        "source_entry_id": "63b45285-63ed-3009-973a-3e5f7f33742e",
                        "source_sense_id": "c6d2bda8-437b-3cb0-a915-590ff3008aa7",
                        "target_lang_word": "inconstancy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inconstancy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0cdb7e2f-a5b9-30d7-abd0-03a452ac8246",
                                        "entry_id": "4a5b3c7d-0776-3c1f-b989-33b28cd9c306",
                                        "glosses": [
                                            "Lack of constancy; lack of consistency in thought, emotion or action."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ce0b96f9-e8e8-4d32-aac1-8a06c7ce1e20",
                                                "sense_id": "0cdb7e2f-a5b9-30d7-abd0-03a452ac8246",
                                                "text": "Although she loved him for many years, his inconstancy eventually drove her to another."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c1c77440-9c2a-42ae-a329-24bf73d6c0c9",
                        "source_entry_id": "63b45285-63ed-3009-973a-3e5f7f33742e",
                        "source_sense_id": "c6d2bda8-437b-3cb0-a915-590ff3008aa7",
                        "target_lang_word": "mutability",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mutability",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6a927072-42e8-3456-87a1-f7cdcfe05df4",
                                        "entry_id": "649e98d5-4aeb-3adf-8eb4-5eca42299000",
                                        "glosses": [
                                            "The quality or state of being mutable."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0bf9be1e-6075-4343-ad55-43369c13f3ab",
                                                "sense_id": "6a927072-42e8-3456-87a1-f7cdcfe05df4",
                                                "text": "He did indeed account somewhat unfairly for this sudden change; for besides some hard and unjust surmises concerning female fickleness and mutability, he began to suspect that he owed this want of civility to his want of horses […]"
                                            },
                                            {
                                                "example_id": "3d23c79e-34d0-42e1-982f-fba61fede8dc",
                                                "sense_id": "6a927072-42e8-3456-87a1-f7cdcfe05df4",
                                                "text": "There rise authors now and then, who seem proof against the mutability of language, because they have rooted themselves in the unchanging principles of human nature."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
