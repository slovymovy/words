                ],
                "senses": [
                    {
                        "sense_id": "a5263c79-c34c-36e5-ae21-b1e4692f0d53",
                        "entry_id": "78186302-2a1c-35fa-b945-56e61d04e8e0",
                        "glosses": [
                            "The day of a person's death, especially when viewed as being appointed by fate."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "18863af6-24b8-49a7-b1f3-66a2adf2ff6d",
                                "sense_id": "a5263c79-c34c-36e5-ae21-b1e4692f0d53",
                                "text": "The placing of the dragon is inevitable: a man can but die upon his death-day."
                            }
                        ]
                    },
                    {
                        "sense_id": "788fcbf2-60d4-31c1-907d-026194395eaa",
                        "entry_id": "78186302-2a1c-35fa-b945-56e61d04e8e0",
                        "glosses": [
                            "The anniversary of a death, the date upon which someone earlier died."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed4e66b0-2635-42e9-809d-44849518426d",
                                "sense_id": "788fcbf2-60d4-31c1-907d-026194395eaa",
                                "text": "\"Is it her deathday?\" I asked. \"Nope,\" he said."
                            },
                            {
                                "example_id": "faa7a9b5-f3ff-4b48-87be-72138a4d9f3c",
                                "sense_id": "788fcbf2-60d4-31c1-907d-026194395eaa",
                                "text": "It only just dawned on me that intrinsically it felt better to honor her on her birthday rather than her deathday. It has always struck me as odd that more people remember the day Elvis or John Lennon died than the dates they were born."
                            },
                            {
                                "example_id": "efe824c8-2ed6-4b85-ad7e-27a09cd2fabc",
                                "sense_id": "788fcbf2-60d4-31c1-907d-026194395eaa",
                                "text": "[…] just then we needed a tenth man and needed him badly, because one of us had a deathday to observe and wanted to say the mourner's prayer."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "46dedc75-d2cf-4aa1-bd1f-2c47526408cb",
                        "source_entry_id": "78186302-2a1c-35fa-b945-56e61d04e8e0",
                        "source_sense_description": "anniversary of a death",
                        "target_lang_word": "Todestag",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Todestag",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "baf56a6a-5c93-32c3-8144-87669ecfc7b1",
                                        "entry_id": "a664313c-b815-3582-86f8-d02745204899",
                                        "glosses": [
                                            "der Tag, an dem ein Lebewesen stirbt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8dfd8cf1-687f-47ce-a870-64b2eaab9abc",
                                                "sense_id": "baf56a6a-5c93-32c3-8144-87669ecfc7b1",
                                                "text": "Bis zu seinem Todestag engagierte er sich für die Armen."
                                            },
                                            {
                                                "example_id": "de3c64a5-ef6b-40a4-8273-36e2579d8b6c",
                                                "sense_id": "baf56a6a-5c93-32c3-8144-87669ecfc7b1",
                                                "text": "„Im Memorienbuch (Nekrolog) des Koblenzer Stifts St. Kastor von 1426 findet sich am Todestag des Trierer Erzbischofs Hetti (814-847) zum 29. Mai die Eintragung, er habe zu Lebzeiten die Kirchen St. Kastor, St. Georg und St. Beatus eingeweiht.“"
                                            },
                                            {
                                                "example_id": "90bbd96e-e62d-48c9-89f7-5977158603b4",
                                                "sense_id": "baf56a6a-5c93-32c3-8144-87669ecfc7b1",
                                                "text": "„Er ahnte nicht im geringsten, daß nach Himmelsgesetz das Maß seiner Schuld voll war, daß schon ein Unholdsgeist als Häscher unterwegs war, daß nahe war sein Todestag, seines Daseins Endpunkt.“"
                                            },
                                            {
                                                "example_id": "42cf7844-da72-45a3-ac10-7e53fbf4132f",
                                                "sense_id": "baf56a6a-5c93-32c3-8144-87669ecfc7b1",
                                                "text": "„Der Adelsmarschall war am Todestage des Fürsten, dem 15. August, in Prinzessin Marja gedrungen, noch am gleichen Tage abzufahren, da die Lage immer gefährlicher werde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "15b7775e-6688-32e2-a77b-7b736ea9d700",
                                        "entry_id": "a664313c-b815-3582-86f8-d02745204899",
                                        "glosses": [
                                            "der wiederkehrende Jahrestag des Todes eines Lebewesens"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "213b9da6-57ae-4fc2-977e-b3be34a97b9d",
                                                "sense_id": "15b7775e-6688-32e2-a77b-7b736ea9d700",
                                                "text": "Anlässlich des 100. Todestages des Dichters wurde ihm zu Ehren ein Denkmal eingeweiht."
                                            },
                                            {
                                                "example_id": "8a5ebf62-dd19-4418-a5f5-c32adae88f05",
                                                "sense_id": "15b7775e-6688-32e2-a77b-7b736ea9d700",
                                                "text": "„Sie brachte auf alle ihre Gräber an den Todestagen Kränze, aber sie kniete nicht nieder und betete nicht.“"
                                            },
                                            {
                                                "example_id": "38b92e84-7a6c-4e6f-84a3-b85c0f1b631d",
                                                "sense_id": "15b7775e-6688-32e2-a77b-7b736ea9d700",
                                                "text": "„Jedes Jahr an ihrem Todestag wunderte ich mich, eine rote Rose auf ihrem Grab zu finden.“"
                                            },
                                            {
                                                "example_id": "a3cac89a-9a6e-4f89-a8d5-3bf7bc56429d",
                                                "sense_id": "15b7775e-6688-32e2-a77b-7b736ea9d700",
                                                "text": "„Jedes Jahr zum Todestag des Vaters solle er das Gedenkgebet, den Kaddisch der Waisen, sprechen und dies ja nicht vergessen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
