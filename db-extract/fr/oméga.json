                        "entry_id": "7a866e52-b1dc-3cd8-b704-ffcf1e5bc48b",
                        "glosses": [
                            "Nom de ω, Ω, vingt-quatrième et dernière lettre et septième voyelle de l’alphabet grec."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2547df7b-f534-4f66-8d04-180500757e68",
                                "sense_id": "d9df36b1-3ef5-3bb4-926f-e018f627aa2f",
                                "text": "Dans son ouvrage sur Sainte-Sabine, Gisela Jeremias interprète la scène du registre supérieur comme une vision à caractère apocalyptique, eschatologique et parousiaque, que renforcent la présence des lettres alpha et oméga ainsi que celle des Vivants."
                            }
                        ]
                    },
                    {
                        "sense_id": "42bc9de7-ef65-3fec-89b7-fa8a89c83606",
                        "entry_id": "7a866e52-b1dc-3cd8-b704-ffcf1e5bc48b",
                        "glosses": [
                            "Membre le moins respecté d’une meute de loups."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "29e16fc4-6b9f-3545-b928-95912b29ae95",
