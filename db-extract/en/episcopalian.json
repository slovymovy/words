            {
                "entry_id": "d7d63233-94f1-3906-a825-5ade1f5318dc",
                "word": "Episcopalian",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "c5c1799b-fab4-40f1-bbfe-a21477dbc6b2",
                        "entry_id": "d7d63233-94f1-3906-a825-5ade1f5318dc",
                        "tags": [
                            "plural"
                        ],
                        "form": "Episcopalians"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "916c668b-515e-3544-9acb-c0e03eee1060",
                        "entry_id": "d7d63233-94f1-3906-a825-5ade1f5318dc",
                        "glosses": [
                            "An adherent of an Anglican church, especially the Scottish Episcopal Church, the Episcopal Church in the United States of America, or the Anglican churches in the Philippines, western Asia, South Sudan, the Horn of Africa, and most of north Africa."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a2ef8ae4-d33c-4c31-9e7c-f46f6c9724a3",
                                "sense_id": "916c668b-515e-3544-9acb-c0e03eee1060",
                                "text": "But on that Sunday it was filled with Episcopalians from around the country who had traveled to South Bend to attend his campaign launch."
                            },
                            {
                                "example_id": "aeb26965-3271-4c45-8092-53419689370e",
                                "sense_id": "916c668b-515e-3544-9acb-c0e03eee1060",
                                "text": "I was raised an Episcopalian but no longer belong to a church."
                            },
                            {
                                "example_id": "c002ecec-585f-4893-8864-f4049a296b7f",
                                "sense_id": "916c668b-515e-3544-9acb-c0e03eee1060",
                                "text": "Jill Erickson and her partner have embraced the label ever since it was first coined on the television show, \"The OC,\" in the mid-2000s. To Erickson, who is Episcopalian, and her Jewish partner, Chrismukkah represents their efforts to incorporate their respective traditions into the holiday season."
                            }
                        ]
                    },
