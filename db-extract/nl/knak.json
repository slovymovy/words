                    {
                        "translation_id": "fe7505d4-341d-4778-9508-277775f70883",
                        "source_entry_id": "63e2d315-006a-37b2-ae97-31dca8bc0632",
                        "source_sense_id": "dd167b9b-f03e-37ce-82af-e3cda335285e",
