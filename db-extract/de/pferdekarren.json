                                "example_id": "d892c4de-d61e-4e81-84c7-80ba2283eaee",
                                "sense_id": "d88d8286-d62b-3f2f-b790-d4908619b8a9",
                                "text": "„Manche Händler hatten noch Pferdekarren, ander waren bereits motorisiert.“"
                            },
                            {
