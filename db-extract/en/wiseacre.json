{
    "word": "wiseacre",
    "lang_code": "en",
    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "ee5594af-5098-3932-9cd7-fab7e322654b",
                "word": "wiseacre",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "111bc4d3-d622-4b3b-b62e-a552e91fe3df",
                        "entry_id": "ee5594af-5098-3932-9cd7-fab7e322654b",
                        "tags": [
                            "plural"
                        ],
                        "form": "wiseacres"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3cdcbd08-be4e-3526-9956-32e453800926",
                        "entry_id": "ee5594af-5098-3932-9cd7-fab7e322654b",
                        "glosses": [
                            "One who feigns knowledge or cleverness; one who is wisecracking; an insolent upstart."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af613eeb-8dc6-4eca-96d2-7e2cbedbf2e3",
                                "sense_id": "3cdcbd08-be4e-3526-9956-32e453800926",
                                "text": "That other class of wiseacres who twist prophecy in such a manner as to make it promise the destruction and desolation of the same city, use judgement just as bad, since the city is in a very flourishing condition now, unhappily for them."
                            },
                            {
                                "example_id": "13d43133-2b60-4372-ab56-4261f08a4044",
                                "sense_id": "3cdcbd08-be4e-3526-9956-32e453800926",
                                "text": "But noooooo! Some wiseacre “expert” will patronizingly explain that because gymnast Kim Zmeskal’s left little toenail was off center by the length of an eyelash, the judges will be forced to dock a tenth of a point from her score."
                            }
                        ]
                    },
                    {
                        "sense_id": "7586daab-29b0-3a63-8e35-3a918badc723",
                        "entry_id": "ee5594af-5098-3932-9cd7-fab7e322654b",
                        "glosses": [
                            "A learned or wise man."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "8b732ff2-8838-4ee8-9a73-f9cb76f8984e",
                                "sense_id": "7586daab-29b0-3a63-8e35-3a918badc723",
                                "text": "A fool's paradise is better than a wiseacre's purgatory."
                            },
                            {
                                "example_id": "20bbe6be-1f6b-4d74-9009-d507897ede81",
                                "sense_id": "7586daab-29b0-3a63-8e35-3a918badc723",
                                "text": "Peter Gower, a Grecian, journied for cunning in Egypt, and in Syria, and in every land where the Venetians had planted Masonry; and winning entrance into all lodges of Masons, he learned much, and returned and dwelt in Grecia Magna; watching and becoming a mighty wiseacre, and greatly renowned, and here he framed a grat lodge at Groton, (Crotona. Mr. Locke,) and maked many Masons; wherefrom, in process of time, the art passed into England."
                            },
                            {
                                "example_id": "ef288a44-5fbc-4ff6-b29a-24f3fe9bab69",
                                "sense_id": "7586daab-29b0-3a63-8e35-3a918badc723",
                                "text": "At their village the woman consulted the local wiseacre, explaining the difficulties her son-in-law was creating."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fa53be1f-9927-42fc-8230-65e0d0e2937a",
                        "source_entry_id": "ee5594af-5098-3932-9cd7-fab7e322654b",
                        "source_sense_description": "one who feigns knowledge or cleverness",
                        "target_lang_word": "Klugscheißer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Klugscheißer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "05535941-aaab-3c30-81f9-dd2c5e09508d",
                                        "entry_id": "6329d216-dd1d-36a3-a358-26262116ba86",
                                        "glosses": [
                                            "Person, die immer alles besser wissen will"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f0e72c8b-a7b1-4dba-a145-58d2f905d76d",
                                                "sense_id": "05535941-aaab-3c30-81f9-dd2c5e09508d",
                                                "text": "Ich habe die Nase voll von diesen arroganten Klugscheißern!"
                                            },
                                            {
                                                "example_id": "3f793568-26f7-4c11-9ec0-4d1c166ed94f",
                                                "sense_id": "05535941-aaab-3c30-81f9-dd2c5e09508d",
                                                "text": "„Als er sich die Zähne putzen gegangen war, bezeichnete Mama Gustav als Klugscheißer, und Papa sagte, das komme eben dabei raus, wenn ein Junge von seinen Großeltern erzogen werde.“"
                                            },
                                            {
                                                "example_id": "3e58260b-3208-41ef-9c2f-3404482ef436",
                                                "sense_id": "05535941-aaab-3c30-81f9-dd2c5e09508d",
                                                "text": "„Ich deutscher Klugscheißer wusste damals nicht mal, wo der Kandidat Mitterand eigentlich herkam.“"
                                            },
                                            {
                                                "example_id": "29c432d1-b92b-4158-beab-039c7d7f8939",
                                                "sense_id": "05535941-aaab-3c30-81f9-dd2c5e09508d",
                                                "text": "„„Wade, Sie sind ein kleiner Klugscheißer. Sie waren schon bei dem Prozess ein Klugscheißer. Und jetzt sind Sie immer noch ein Klugscheißer. Ich wette, Sie sind schon als Klugscheißer geboren worden. Und ich bin sicher, Ihre Mama war auch schon eine Klugscheißerin und ihre beiden Kinder sind mit Sicherheit auch Klugscheißer. Sie können einfach nicht anders, stimmt's? Aber jetzt hören Sie mir mal zu, Sie kleiner Klugscheißer, ab jetzt werden Sie eine Stunde lang kein Klugscheißer mehr sein. Haben Sie das verstanden, Wade?““"
                                            },
                                            {
                                                "example_id": "d863d523-c6e5-419b-890f-300a02dc8094",
                                                "sense_id": "05535941-aaab-3c30-81f9-dd2c5e09508d",
                                                "text": "»Du redest wie ein kleiner Klugscheißer.« »Es ist ein Zitat von Friedrich Nietzsche.« »Trotzdem Klugscheißer …« »Könnten nicht auch Klugscheißer manchmal recht haben?« »Schon möglich. Aber musst du es jeden spüren lassen?«"
                                            },
                                            {
                                                "example_id": "55d792ef-17e3-4b4e-a727-79ad3b7becd6",
                                                "sense_id": "05535941-aaab-3c30-81f9-dd2c5e09508d",
                                                "text": "„„Und sind Sie sicher, dass Sie nicht schon immer ein Klugscheißer waren?““"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8ce431f5-7c34-474a-bb83-325e4c05da41",
                        "source_entry_id": "ee5594af-5098-3932-9cd7-fab7e322654b",
                        "source_sense_description": "one who feigns knowledge or cleverness",
                        "target_lang_word": "Besserwisser",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Besserwisser",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d350449a-a6ac-3c6d-ab4c-eb18a5344683",
                                        "entry_id": "8b9639e1-ad17-30b5-b8d4-ed9262e389a8",
                                        "glosses": [
                                            "Person, die immer alles besser wissen will und damit angibt"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "33e58b41-85bb-47e1-ac38-45ba3f7aac56",
                                                "sense_id": "d350449a-a6ac-3c6d-ab4c-eb18a5344683",
                                                "text": "Er ist ein solcher Besserwisser, dass nicht einmal die Lehrer mit ihm diskutieren mögen."
                                            },
                                            {
                                                "example_id": "aa9269af-bbaa-41f5-aef2-09845e1ab125",
                                                "sense_id": "d350449a-a6ac-3c6d-ab4c-eb18a5344683",
                                                "text": "„Auch in Meister Pfriem setzten die Brüder Grimm einem Nörgler, Besserwisser und Rechthaber par excellence ein unvergessliches Denkmal …“"
                                            },
                                            {
                                                "example_id": "b61b2efd-7405-4f2d-8a36-d1f90f3bd6cd",
                                                "sense_id": "d350449a-a6ac-3c6d-ab4c-eb18a5344683",
                                                "text": "„Gewiss trat Wieland nicht als spröder Besserwisser auf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
