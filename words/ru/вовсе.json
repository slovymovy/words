{
    "word_family": [
        "весь"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "3a3bc59a-b634-3b1c-af03-a6393ca400fc",
                    "sense_definition": "Совсем, совершенно (обычно используется для усиления отрицания).",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "negation_emphasis",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Это решение <вовсе> не кажется мне правильным.",
                            "target_lang_translations": {
                                "en": "This decision does not seem right to me <at all>.",
                                "zh": "这个决定我<w>根本</w>不觉得正确。",
                                "de": "Diese Entscheidung scheint mir <w>überhaupt</w> nicht richtig zu sein."
                            }
                        },
                        {
                            "text": "Я <вовсе> не хотел вас обидеть своими словами.",
                            "target_lang_translations": {
                                "en": "I did not mean to offend you with my words <at all>.",
                                "zh": "我<w>一点也不</w>想用那些话冒犯你。",
                                "de": "Ich wollte Sie mit meinen Worten <w>keineswegs</w> beleidigen."
                            }
                        }
                    ],
                    "synonyms": [
                        "совсем",
                        "совершенно",
                        "отнюдь"
                    ],
                    "common_phrases": [
                        "вовсе нет",
                        "вовсе не"
                    ],
                    "target_lang_definitions": {
                        "en": "At all, completely (usually used to emphasize negation)",
                        "zh": "完全，彻底（通常用于加强否定语气）。",
                        "de": "Überhaupt nicht, keineswegs (wird meist zur Verstärkung einer Verneinung verwendet)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "at all",
                                "target_lang_sense_clarification": "used in negative sentences for emphasis"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "根本",
                                "target_lang_sense_clarification": "用于否定句，强调完全不"
                            },
                            {
                                "target_lang_word": "一点也不",
                                "target_lang_sense_clarification": "用于否定句，强调程度"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "überhaupt nicht",
                                "target_lang_sense_clarification": "wird zur nachdrücklichen Verneinung verwendet"
                            },
                            {
                                "target_lang_word": "keineswegs",
                                "target_lang_sense_clarification": "gehobener Ausdruck für eine starke Verneinung"
                            },
                            {
                                "target_lang_word": "gar nicht",
                                "target_lang_sense_clarification": "umgangssprachliche Verstärkung der Verneinung"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f6e4be27-c945-3f5a-a2a9-a28d0cfff651",
                    "sense_definition": "Полностью, окончательно (часто о завершении или прекращении чего-либо).",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "completion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Сначала он звонил редко, а потом и <вовсе> перестал.",
                            "target_lang_translations": {
                                "en": "At first he called rarely, and then he stopped <altogether>.",
                                "zh": "起初他很少打电话，后来<w>干脆</w>就不打了。",
                                "de": "Zuerst rief er selten an, und dann hörte er <w>ganz</w> auf."
                            }
                        },
                        {
                            "text": "Дождь пошёл сильнее, а к вечеру и <вовсе> превратился в ливень.",
                            "target_lang_translations": {
                                "en": "The rain fell harder, and by evening it turned into a downpour <completely>.",
                                "zh": "雨下得更大了，到了傍晚<w>完全</w>变成了倾盆大雨。",
                                "de": "Der Regen wurde stärker und entwickelte sich gegen Abend <w>gänzlich</w> zu einem Wolkenbruch."
                            }
                        }
                    ],
                    "synonyms": [
                        "полностью",
                        "окончательно",
                        "совсем"
                    ],
                    "common_phrases": [
                        "и вовсе"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "часто используется в разговорной речи"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Completely, finally (often about finishing or stopping something)",
                        "zh": "完全地，最终地（常用于表示某事结束或停止）。",
                        "de": "Völlig, endgültig oder gänzlich (oft im Zusammenhang mit dem Aufhören oder einer vollständigen Veränderung)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "altogether",
                                "target_lang_sense_clarification": "completely; with verbs of stopping or changing"
                            },
                            {
                                "target_lang_word": "completely",
                                "target_lang_sense_clarification": "entirely"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "干脆",
                                "target_lang_sense_clarification": "表示索性、彻底地做某事"
                            },
                            {
                                "target_lang_word": "完全",
                                "target_lang_sense_clarification": "表示彻底地改变或停止"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "schließlich",
                                "target_lang_sense_clarification": "drückt ein endgültiges Resultat aus"
                            },
                            {
                                "target_lang_word": "ganz",
                                "target_lang_sense_clarification": "drückt eine vollständige Veränderung aus"
                            },
                            {
                                "target_lang_word": "gänzlich",
                                "target_lang_sense_clarification": "betont die Vollständigkeit eines Vorgangs"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}