                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba0a8ebd-1c99-47a5-8d48-caefbb841f86",
                                "sense_id": "8a0b9307-7b54-396b-acaa-eb8436c65ca7",
                                "text": "Священники поражали своим благообразием и сытостью."
                            }
                        ]
                    },
                    {
                        "sense_id": "39d82a98-02d2-381b-b752-1d387fde7c0e",
                        "entry_id": "6d81f833-6dd7-3f40-8c91-62b2a600763f",
                        "glosses": [
                            "порядок, приличие"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c3f9cb58-3726-4687-aa24-7b5f7fbbd002",
                                "sense_id": "39d82a98-02d2-381b-b752-1d387fde7c0e",
                                "text": "Чаще наезжал в острог, чаще кричал, чаще кидался на людей, чаще забирал народ в кордегардию и усиленно смотрел за чистотой и благообразием."
                            }
                        ]
                    }
