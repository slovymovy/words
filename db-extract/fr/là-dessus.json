        "fr-extract.jsonl": [
            {
                "entry_id": "57a0475f-e240-33a1-b72e-d01e6d17cf42",
                "word": "là-dessus",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "dc8c66ca-e37b-3176-99a0-f9e035b1c03a",
                        "entry_id": "57a0475f-e240-33a1-b72e-d01e6d17cf42",
                        "glosses": [
                            "Sur cela."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cbbe0a64-15eb-4eb9-acd4-2d3c00babb7e",
                                "sense_id": "dc8c66ca-e37b-3176-99a0-f9e035b1c03a",
                                "text": "Tu vas me déclouter toutes les planches de ce couvercle qui est là et tu le mettras là-dessus, sur sa caisse."
                            },
                            {
                                "example_id": "bd9b3485-a9b6-4ed2-8aa5-27252b0cbc8c",
                                "sense_id": "dc8c66ca-e37b-3176-99a0-f9e035b1c03a",
                                "text": "— Mais le diable a soufflé là-dessus, de son haleine fiévreuse et empestée, et les pires billevesées ont pris leur vol. L'homme a inventé les dieux et il a crée l'amour avec son cortège de sensibleries ridicules ou criminelles."
                            }
                        ]
                    },
                    {
                        "sense_id": "a6ea31aa-ff9c-33e5-99b0-5347e6a1739f",
                        "entry_id": "57a0475f-e240-33a1-b72e-d01e6d17cf42",
                        "glosses": [
                            "Sur ce sujet, sur cette affaire, sur la réalité de telle ou telle chose."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "31b64bce-513b-4af9-bb70-b0c7b9feedac",
                                "sense_id": "a6ea31aa-ff9c-33e5-99b0-5347e6a1739f",
                                "text": "Pourquoi revenir toujours là-dessus ?"
                            },
                            {
                                "example_id": "82b29f6c-1ad8-4a33-b2d7-10375c738b8d",
                                "sense_id": "a6ea31aa-ff9c-33e5-99b0-5347e6a1739f",
                                "text": "Que n’a-t-on pas écrit là-dessus ?"
                            },
                            {
                                "example_id": "66f90f99-4095-412c-889d-afd1e780d316",
                                "sense_id": "a6ea31aa-ff9c-33e5-99b0-5347e6a1739f",
                                "text": "Vous pouvez compter là-dessus."
                            },
                            {
                                "example_id": "5d152874-0221-4326-8a1d-3d77ed30ab10",
                                "sense_id": "a6ea31aa-ff9c-33e5-99b0-5347e6a1739f",
                                "text": "Nous pouvons travailler là-dessus demain."
                            }
                        ]
                    },
                    {
                        "sense_id": "45fe6614-3860-3d4e-a65e-59a55cd8daed",
                        "entry_id": "57a0475f-e240-33a1-b72e-d01e6d17cf42",
                        "glosses": [
                            "Aussitôt après cela, après ces mots."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c208e75d-1baf-4a92-a628-0a97da39a7e8",
                                "sense_id": "45fe6614-3860-3d4e-a65e-59a55cd8daed",
                                "text": "On me l’a dit : il faut que je me venge.\nLà-dessus, au fond des forêts,\nLe Loup l’emporte, et puis le mange,\nSans autre forme de procès."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3e9ec292-25a4-4eaf-9d31-f3c17f3f82e5",
                        "source_entry_id": "57a0475f-e240-33a1-b72e-d01e6d17cf42",
                        "target_lang_word": "lì sopra",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "9bcd7d22-c5cb-46d6-b8b2-5c1d10e81e08",
                        "source_entry_id": "57a0475f-e240-33a1-b72e-d01e6d17cf42",
                        "target_lang_word": "daarover",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "daarover",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "e47cf433-aec7-3731-837f-38cd1a7eba9f",
                                        "entry_id": "840ca2f7-bda8-33a5-9380-cf6646ba8cb3",
                                        "glosses": [
                                            "over dat, over die"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1004909-1085-475b-b1da-cbb7be3ed62e",
                                                "sense_id": "e47cf433-aec7-3731-837f-38cd1a7eba9f",
                                                "text": "Daarover werd niet gerept."
                                            },
                                            {
                                                "example_id": "05db177f-395a-4e13-bb11-ac6564df8f0c",
                                                "sense_id": "e47cf433-aec7-3731-837f-38cd1a7eba9f",
                                                "text": "Daar werd niet over gesproken."
                                            },
                                            {
                                                "example_id": "16dac553-4bea-4345-9ef7-40a0763c393f",
                                                "sense_id": "e47cf433-aec7-3731-837f-38cd1a7eba9f",
                                                "text": "Toen hij de onvoldoendes zag op het rapport van zijn zoon verbaasde hij zich daarover."
                                            },
                                            {
                                                "example_id": "7daeb6f3-d7da-4aec-bd99-1d98dc6d6937",
                                                "sense_id": "e47cf433-aec7-3731-837f-38cd1a7eba9f",
                                                "text": "'Irene, heb jij weleens gehoord van respect? Niet zozeer tegenover de kerk, ik weet hoe jij daarover denkt, maar naar papa en mama."
                                            },
                                            {
                                                "example_id": "137bc923-3ccc-4fbb-b9b5-8d48d96c667e",
                                                "sense_id": "e47cf433-aec7-3731-837f-38cd1a7eba9f",
                                                "text": "Lauren vertelde over haar vader, de relatie met haar broer en de perikelen rondom haar familiebedrijf, maar ik probeerde deze onderwerpen subtiel te vermijden, want ik wist dat ze daarover met mijn collega sprak."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b4fd68d4-0544-406b-a2f4-32a67c49d364",
                        "source_entry_id": "57a0475f-e240-33a1-b72e-d01e6d17cf42",
