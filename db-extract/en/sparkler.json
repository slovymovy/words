                    },
                    {
                        "translation_id": "731116aa-f1eb-4af3-ab1f-b039d8ca34ba",
                        "source_entry_id": "9b0509ae-7fd8-3698-878e-60ccfcb341c1",
                        "source_sense_description": "hand-held firework",
                        "target_lang_word": "Wunderkerze",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wunderkerze",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e8433487-c20a-3d2b-8404-0fbb1f68177a",
                                        "entry_id": "c62ba74a-4860-35ad-bc6e-73dfa817ddd2",
                                        "glosses": [
                                            "Draht, der größtenteils mit einer brennbaren Masse überzogen ist, die beim Abbrennen Funken versprüht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63a16795-26bb-4f45-a686-c4a70855dd3c",
                                                "sense_id": "e8433487-c20a-3d2b-8404-0fbb1f68177a",
                                                "text": "„Es duftete bei Gott wie am Weihnachtstag nach Wunderkerzen.“"
                                            },
                                            {
                                                "example_id": "b80e8ae4-6c52-4c72-8c45-e8612e2eb811",
                                                "sense_id": "e8433487-c20a-3d2b-8404-0fbb1f68177a",
                                                "text": "„Vor dem Hotel International steht die Belegschaft Spalier, aus einem Fenster des Neuen Gewandhauses hält eine junge Frau eine Wunderkerze, von den Balkonen der Häuser winken und klatschen viele Bewohner.“"
                                            },
                                            {
                                                "example_id": "24a24744-c98b-465e-a43f-53bc96203431",
                                                "sense_id": "e8433487-c20a-3d2b-8404-0fbb1f68177a",
                                                "text": "„Eine Wunderkerze am Weihnachtsbaum hat am Montagabend den Wohnungsbrand in Neukölln ausgelöst, bei dem ein 30-Jähriger getötet wurde.“"
                                            },
                                            {
                                                "example_id": "80157135-eeb3-4878-a972-b43ddce1a853",
                                                "sense_id": "e8433487-c20a-3d2b-8404-0fbb1f68177a",
                                                "text": "„Um Mitternacht durften wir mit brennenden Wunderkerzen durch den Garten rennen und das Schaltjahr begrüßen.“"
                                            },
                                            {
                                                "example_id": "87295138-9a49-4bf1-8467-0d7a8e7e5a7a",
                                                "sense_id": "e8433487-c20a-3d2b-8404-0fbb1f68177a",
                                                "text": "„Mal tanzten Flammen auf den Schultern unserer Kellner, mal versprühten Wunderkerzen Funken, mal krachte ein Tischfeuerwerk.“"
                                            },
                                            {
                                                "example_id": "0d7581e1-c093-4a51-aaf9-f205378fa964",
                                                "sense_id": "e8433487-c20a-3d2b-8404-0fbb1f68177a",
                                                "text": "„Am Heiligen Abend hatte der an den Lichterbaum der westlichen Welt die Wunderkerze eines ‚Friedens-Appells‘ gehängt.“"
                                            },
                                            {
                                                "example_id": "384c15d5-4dbe-4045-ade7-98f6ee8f43f3",
                                                "sense_id": "e8433487-c20a-3d2b-8404-0fbb1f68177a",
                                                "text": "„In seiner Seele flammte es auf wie Wunderkerzen in der kindlichen Weihnachtszeit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
