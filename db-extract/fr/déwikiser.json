                        ],
                        "examples": [
                            {
                                "example_id": "20205feb-8c35-4783-af28-e7ad82c0ab84",
                                "sense_id": "cbccd2d0-19b7-38fa-a4e6-690a44512fe0",
                                "text": "\"Déwikiser\" permet d’encore plus contrôler mais il impose que les articles soient envoyés à une ou plusieurs personnes qui valideront et mettront en ligne."
                            },
                            {
                                "example_id": "7e58661f-43ce-4a4d-b7ec-b0788b95cfcf",
                                "sense_id": "cbccd2d0-19b7-38fa-a4e6-690a44512fe0",
                                "text": "Wiki créé. A vous de le remplir, sinon il sera déwikisé en moins de deux."
                            }
                        ]
                    }
