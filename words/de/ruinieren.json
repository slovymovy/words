                    "semantic_group_id": "finanzieller_ruin",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er hat sich durch riskante Spekulationen an der Börse völlig <w>ruiniert</w>."
                        },
                        {
                            "text": "Die unerwartet hohen Schulden drohen das kleine Familienunternehmen zu <w>ruinieren</w>."
                        }
                    ],
                    "synonyms": [
