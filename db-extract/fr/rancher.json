        "fr-extract.jsonl": [
            {
                "entry_id": "3fbb11d1-c100-3226-bf2a-848398381027",
                "word": "rancher",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "ee9a4f21-db5c-4350-bd9a-0732d12cc39c",
                        "entry_id": "3fbb11d1-c100-3226-bf2a-848398381027",
                        "tags": [
                            "plural"
                        ],
                        "form": "ranchers"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "88ee3638-2c98-3f5f-a6fe-272acd8f1fd8",
                        "entry_id": "3fbb11d1-c100-3226-bf2a-848398381027",
                        "glosses": [
                            "Sorte d’échelle, pièce de bois garnie de chevilles qui servent d’échelons, utilisée en particulier pour les grues."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "88696aec-8023-4ec1-a32d-5e52a82ec855",
                                "sense_id": "88ee3638-2c98-3f5f-a6fe-272acd8f1fd8",
                                "text": "La piece de bois qui porte & qui sert à élever les fardeaux, s’appelle échelier ou rancher ; elle est garnie de chevilles ou ranches, & posée sur un pivot de fer qui est au bout du poinçon de l’arbre : il est assemblé avec plusieurs moises à des liens montans."
                            }
                        ]
                    },
                    {
                        "sense_id": "30bec0bd-1dd3-37db-b97a-f2d068a5bc5c",
                        "entry_id": "3fbb11d1-c100-3226-bf2a-848398381027",
                        "glosses": [
                            "Barre verticale disposée en bordure d’une plateforme ou d’un panier, destinée à retenir les charges de grande longueur, comme des grumes, des tubes, des rails."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "346ec904-d978-4413-bc8a-cc40a4af0a8a",
                                "sense_id": "30bec0bd-1dd3-37db-b97a-f2d068a5bc5c",
                                "text": "Les wagonnets, ou porteurs proprement dits, sont de petites plates-formes roulantes, à essieux (fig. 88) disposées de manière à recevoir, selon les cas, ou la matière à transporter maintenue par quatre ranchers, ou de simples corbeilles en osier, ou des caisses à claire-voie, destinées à contenir des racines ou des substances analogues."
                            },
                            {
                                "example_id": "f879027e-819e-4b51-946a-0193a23af928",
                                "sense_id": "30bec0bd-1dd3-37db-b97a-f2d068a5bc5c",
                                "text": "Des ranchers hauts sont indispensables pour charger un nombre élevé de grumes ( 8 à 12 en Okoumé )."
                            },
                            {
                                "example_id": "5070f9e0-5ead-499c-b5bf-3e5e7dc1f717",
                                "sense_id": "30bec0bd-1dd3-37db-b97a-f2d068a5bc5c",
                                "text": "L’autre option est FlexBunk, avec des tubes de rancher hydrauliques et des élargisseurs maniés avec la grue afin d’augmenter la capacité de chargement. LoadFlex optimise également la capacité de chargement et augmente la flexibilité de tri. La disposition basse et large des ranchers LoadFlex augmente également la vitesse de chargement et déchargement."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b2787be5-334d-4b7c-868c-1c7e189d8a46",
                        "source_entry_id": "3fbb11d1-c100-3226-bf2a-848398381027",
                        "source_sense_description": "Barre verticale maintenant une charge",
                        "target_lang_word": "Pfahl",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pfahl",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8e66377b-29e8-3b18-a19a-45b295d94b6d",
                                        "entry_id": "c60e9529-771e-3487-93fa-20b9f78168ac",
                                        "glosses": [
                                            "bearbeitetes, schmales, aufrecht stehendes säulenartiges Bauteil, zum Beispiel aus Holz, Metall oder Stein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "908db9b4-9d8a-4544-aaba-d58e374d3741",
                                                "sense_id": "8e66377b-29e8-3b18-a19a-45b295d94b6d",
                                                "text": "Sie fesselten ihn an den Pfahl und verbanden ihm die Augen."
                                            },
                                            {
                                                "example_id": "4a5de8bf-b3f4-4d9d-a721-561dcddeda27",
                                                "sense_id": "8e66377b-29e8-3b18-a19a-45b295d94b6d",
                                                "text": "„Dort pflegte er seine Haifischleine auszulegen und sie an einem Pfahl zu vertäuen, den er in den Sand getrieben hatte.“"
                                            },
                                            {
                                                "example_id": "3f747ef9-33a4-4beb-8e9d-5cd2b2033905",
                                                "sense_id": "8e66377b-29e8-3b18-a19a-45b295d94b6d",
                                                "text": "„Rechts und links von dem Pfahl standen geschlossene französische Formationen mit blauen Monturen, roten Epauletten, Stiefeletten und Tschakos.“"
                                            },
                                            {
                                                "example_id": "16039436-6f85-4b05-bb54-d6b5350767a8",
                                                "sense_id": "8e66377b-29e8-3b18-a19a-45b295d94b6d",
                                                "text": "„Um ein zweites waren Pfähle in die Erde getrieben, über denen Querhölzer sich kreuzten, auf denen Hirschkeulem und Vorderschenkel zum Trocknen hingen.“"
                                            },
                                            {
                                                "example_id": "dc3734a9-fd4d-4b0f-9977-8f9b87c8bf6c",
                                                "sense_id": "8e66377b-29e8-3b18-a19a-45b295d94b6d",
                                                "text": "„Als Auflage wurden Pfähle in den Fluß gerammt, und die Brücke konstruierte Smith als Bogenbrücke, um ihre Tragkraft zu erhöhen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "689845f3-153f-3015-b36c-569ef245ccb2",
                                        "entry_id": "c60e9529-771e-3487-93fa-20b9f78168ac",
                                        "glosses": [
                                            "senkrechter Streifen, in der Mitte eines Wappenschildes, von abweichender Farbe"
                                        ],
                                        "tags": [
                                            "Heraldik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5e06decf-87e9-4296-865f-9bbfea522c8f",
                                                "sense_id": "689845f3-153f-3015-b36c-569ef245ccb2",
                                                "text": "„Da Niederwürzbach von 1337 bis 1661, also mehr als 300 Jahre, zu Kurtrier gehörte, wurde das rote Kreuz des Kurstaates in das Wappen aufgenommen, während der silberne Pfahl aus dem Wappen der Grafen Von der Leyen stammt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Pfahl",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "75bad945-c326-386b-a258-e0d2fe7ab875",
