                                                "example_id": "f25d1d35-d762-4970-92ae-126a7f30fb24",
                                                "sense_id": "7b75af5c-daf2-3b57-b094-a530c0c11af6",
                                                "text": "As with other exotic pets, sound husbandry is essential for captive sugar gliders to flourish."
                                            },
