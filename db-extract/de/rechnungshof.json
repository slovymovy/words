                        "entry_id": "bf3989f4-d3ae-344e-a0b5-c5a92790a2d5",
                        "glosses": [
                            "unabhängig arbeitende Behörde, die die Finanzen der öffentlichen Verwaltung kontrolliert"
                        ],
                        "tags": [
                            "Finanzen"
                        ],
                        "examples": [
