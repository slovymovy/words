                "senses": [
                    {
                        "sense_id": "1a1a4674-54a7-34fe-b94e-24399ceb0146",
                        "entry_id": "ded2786d-1206-3f70-99f0-e55c7c74edfd",
                        "glosses": [
                            "воен., устар. военнослужащий, который носит знамя воинской части"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f78a08e0-d68a-42cc-a226-f12ddd6e232c",
                                "sense_id": "1a1a4674-54a7-34fe-b94e-24399ceb0146",
                                "text": "И, как над покорённым станом // Знамёнщик ставит знамена, // В чужом краю за океаном // Мы сеем эти семяна."
                            },
                            {
                                "example_id": "5f83e880-b9df-400c-aef0-c8893b935f2d",
                                "sense_id": "1a1a4674-54a7-34fe-b94e-24399ceb0146",
                                "text": "Несут виденье алое // Вдоль улицы знамёнщики, // Воспряньте, все усталые! // Долой, труда погонщики!"
                            }
                        ]
                    }
