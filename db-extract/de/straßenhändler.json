                                        "glosses": [
                                            "Any of various nymphalid butterflies of the genus Acraea."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "142a0efe-da04-4d8d-9a87-b2bc9ecc13d4",
                        "source_entry_id": "052ea035-731f-3e02-84eb-f0700db72dd0",
                        "source_sense_id": "1c02e77d-ae25-3897-b062-1f1652d55304",
