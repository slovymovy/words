                                        "sense_id": "5350b622-3a64-3f01-a6bb-af9e4dfe4618",
                                        "entry_id": "aeda7a3a-60d9-355f-a388-e2b8af56a4c4",
                                        "glosses": [
                                            "Influential, important; authoritative."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba8f95ce-420a-406f-9a89-f3487393083c",
                                                "sense_id": "5350b622-3a64-3f01-a6bb-af9e4dfe4618",
                                                "text": "An illiterate fool sits in a mans seat; and the common people hold him learned, grave, and wise."
                                            }
