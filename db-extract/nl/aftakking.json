                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "67509b2d-b7eb-3c3b-868d-02a64d0949a4",
                                        "entry_id": "cc2b931a-d20b-3b85-8fbe-c9cae554de0d",
                                        "glosses": [
                                            "One of the portions of a curve that extends outwards to an indefinitely great distance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65e64a3a-c8a4-47f9-805f-366271f5a16c",
                                                "sense_id": "67509b2d-b7eb-3c3b-868d-02a64d0949a4",
                                                "text": "the branches of a hyperbola"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d580eca7-5be2-39c0-beb6-3763731b7a84",
                                        "entry_id": "cc2b931a-d20b-3b85-8fbe-c9cae554de0d",
                                        "glosses": [
                                            "A location of an organization with several locations."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5242677d-8ae9-4301-a9b7-b71acea87fa9",
                                                "sense_id": "d580eca7-5be2-39c0-beb6-3763731b7a84",
                                                "text": "Our main branch is downtown, and we have branches in all major suburbs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a1d9b059-5735-3e61-8ddb-ebc53939e75a",
                                        "entry_id": "cc2b931a-d20b-3b85-8fbe-c9cae554de0d",
                                        "glosses": [
                                            "A line of family descent, in distinction from some other line or lines from the same stock; any descendant in such a line."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6cc5080d-e83d-485b-a203-415e7bf8cca4",
                                                "sense_id": "a1d9b059-5735-3e61-8ddb-ebc53939e75a",
                                                "text": "the English branch of a family"
                                            },
                                            {
                                                "example_id": "99776071-47f0-49f5-8efb-1c0098b9586d",
                                                "sense_id": "a1d9b059-5735-3e61-8ddb-ebc53939e75a",
                                                "text": "his father, a younger branch of the ancient stock"
                                            },
                                            {
                                                "example_id": "ba093bc7-67e8-43eb-926a-6b81fc785a59",
                                                "sense_id": "a1d9b059-5735-3e61-8ddb-ebc53939e75a",
                                                "text": "The gens could admit a new cognomen either for an individual or for a whole branch […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "676ee897-e676-365c-923d-b73856824b10",
                                        "entry_id": "cc2b931a-d20b-3b85-8fbe-c9cae554de0d",
                                        "glosses": [
                                            "A local congregation of the LDS Church that is not large enough to form a ward; see Wikipedia article on ward in LDS church."
                                        ],
                                        "tags": [
                                            "Mormonism"
