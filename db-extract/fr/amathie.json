                "senses": [
                    {
                        "sense_id": "de58e1a8-20c4-314d-a8dd-49905e1d61df",
                        "entry_id": "e2b137e2-4dd8-3e5f-9ca2-73b1deb890ae",
                        "glosses": [
                            "Polypier, du genre des sertulaires."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "afec483d-3c4f-4944-bd67-3959fb56c64c",
                                "sense_id": "de58e1a8-20c4-314d-a8dd-49905e1d61df",
                                "text": "Les Amathies, par leurs nombreuses cellules et par leur tige cornée, fistuleuse et remplie, dans l'état de vie, d'une substance gélatineuse irritable, offrent le caractère général à toutes les Sertulariées."
                            },
                            {
                                "example_id": "6b675f58-4bef-44c9-b1a5-1111b23150cf",
                                "sense_id": "de58e1a8-20c4-314d-a8dd-49905e1d61df",
                                "text": "Ainsi, malgré la différence que l'on observe entre les Amathies lendigère & spirale, il est impossible d'en faire des genres particuliers."
                            }
                        ]
                    },
                    {
                        "sense_id": "7b7f31dc-eb6e-3e56-84af-fe3465778de8",
                        "entry_id": "e2b137e2-4dd8-3e5f-9ca2-73b1deb890ae",
                        "glosses": [
                            "Crustacé brachyure méditerranéen (Anamathia rissoana) de la famille des Epialtidae (anciennement de l'ordre des oxyrhynques dans la taxinomie du XIXème siècle)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f2f8dfb-bd5f-4165-8f3d-72cfb7abbc6e",
                                "sense_id": "7b7f31dc-eb6e-3e56-84af-fe3465778de8",
                                "text": "Le genre Amathie de M. Roux a quelques rapports avec les Péricères de M. Latreille."
                            },
                            {
                                "example_id": "33be90b1-6dc8-468b-a2d0-d44cd92ab65d",
                                "sense_id": "7b7f31dc-eb6e-3e56-84af-fe3465778de8",
                                "text": "Les Amathies sont des Macropodiens à yeux non rétractiles qui ont le troisième article des pattes-mâchoires externes presque carré et donnant insertion au quatrième article par son angle interne."
                            }
                        ]
                    },
                    {
                        "sense_id": "d50c1474-1e41-3128-8b92-2ebf1fcc384b",
                        "entry_id": "e2b137e2-4dd8-3e5f-9ca2-73b1deb890ae",
                        "glosses": [
                            "Papillon nocturne, voisin du phalène, appartenant au genre Amata de l'ordre des Lépidoptères."
                        ],
                        "tags": [],
                        "examples": []
                    }
