                        "cross_references": [
                            {
                                "target_word": "grenzüberschreitend",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "922bcbe2-4866-3e41-a523-5db0e40f76c8",
                                        "entry_id": "4a46366b-a7cd-3020-a6c9-818ce3ee6ca8",
                                        "glosses": [
                                            "eine Trennlinie (Grenze, Landesgrenze) überquerend, nicht nur in einem eingegrenzten Gebiet geltend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09444450-55fc-4d2d-bdf7-004611ef0465",
                                                "sense_id": "922bcbe2-4866-3e41-a523-5db0e40f76c8",
                                                "text": "„Damit soll auf die internationale, grenzüberschreitende Bedeutung der Wälder der Erde hingewiesen werden.“"
                                            },
                                            {
                                                "example_id": "fa2c5fcb-b828-4f7b-87ba-7249fe5c8630",
                                                "sense_id": "922bcbe2-4866-3e41-a523-5db0e40f76c8",
                                                "text": "Bei Geldwäsche handelt es sich eindeutig um ein grenzüberschreitendes Problem."
                                            },
                                            {
                                                "example_id": "4ca9c2d0-06a2-4239-8cf4-7f4e3e44cb77",
                                                "sense_id": "922bcbe2-4866-3e41-a523-5db0e40f76c8",
                                                "text": "Das steht so in der UN-Konvention zur nicht-schiffahrtlichen Nutzung grenzüberschreitender Wasserläufe."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3fb4ea54-a756-4b31-bba7-70a3fb3c6972",
                        "source_entry_id": "dba1f04b-9f6d-3535-867e-a577ec194536",
                        "source_sense_description": "involving transgression",
                        "target_lang_word": "übergriffig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "übergriffig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1ffec986-0288-3202-95d7-74d14551dc7f",
                                        "entry_id": "acefba71-a8fc-385c-8f62-570cae5895ba",
                                        "glosses": [
                                            "Übergriffe in die Rechte, den Bereich, die Angelegenheiten und insbesondere in die sexuelle Selbstbestimmung anderer verübend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f30487d7-fca2-4821-89a6-4ccb275ed78c",
                                                "sense_id": "1ffec986-0288-3202-95d7-74d14551dc7f",
                                                "text": "„Zwei Tage später reisten die Erzbischöfe Zollitsch und Marx nach Rom, um dort mit dem Papst über die Umstände von Mixas Rücktrittsgesuch zu reden; am Morgen vor der Abreise hatte sie jener Missbrauchs-Verdacht erreicht, bei dem das angebliche Opfer später dementieren sollte, dass der Bischof ihm gegenüber übergriffig geworden sei.“"
                                            },
                                            {
                                                "example_id": "d31e7124-f549-4602-a541-3fc5c0dba78c",
                                                "sense_id": "1ffec986-0288-3202-95d7-74d14551dc7f",
                                                "text": "„Auch Valerij M. wird von der zierlichen Frau als übergriffig beschrieben: Er habe sie an Po und Busen begrapscht.“"
                                            },
                                            {
                                                "example_id": "2605676d-23af-492d-90c0-443c14dd93d2",
                                                "sense_id": "1ffec986-0288-3202-95d7-74d14551dc7f",
                                                "text": "„Sven findet, Ilka müsse um Erlaubnis fragen, sie sei übergriffig. Ilka sagt, sie habe doch nur Urlaubsfotos gucken wollen.“"
                                            },
                                            {
                                                "example_id": "49cf82aa-b624-472b-a3b8-8c5d55c752b6",
                                                "sense_id": "1ffec986-0288-3202-95d7-74d14551dc7f",
                                                "text": "„Es muss ja nicht der sexuell übergriffige Dominique Strauss-Kahn gewesen sein. Hat Madame Bruni-Sarkozy, als Topmodel ans Licht der Scheinwerfer gewöhnt, nicht erst kürzlich mit dem auf junge Frauen fixierten Woody Allen gedreht?“"
                                            },
                                            {
                                                "example_id": "a3dca086-5d58-473c-8c95-1d2f165517a0",
                                                "sense_id": "1ffec986-0288-3202-95d7-74d14551dc7f",
                                                "text": "„Der Krimi traf den Siebziger-Jahre-Sound mit den duzfüßigen Sozialkundelehrern, die sich übergriffig an die Schülerinnen heranmachten und die nach der natürlichen Triebordnung in Frage kommenden Jungen ins Abseits schickten.“"
                                            },
                                            {
                                                "example_id": "ca643151-8d48-4bbd-8326-cd7215b91cfe",
                                                "sense_id": "1ffec986-0288-3202-95d7-74d14551dc7f",
                                                "text": "„In Weimar habe er gelernt, dass die angeblich so neutrale öffentliche Hand viel übergriffiger sei, als es sich Konzerne je erlauben würden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9f37c5d3-8fe5-3396-a6a5-8e3b55d865a2",
                                        "entry_id": "acefba71-a8fc-385c-8f62-570cae5895ba",
                                        "glosses": [
                                            "so dick, dass ein Mann den Stamm mit beiden Armen nicht umfassen kann"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "69f02519-f374-4697-b577-e9fe399c942b",
                                                "sense_id": "9f37c5d3-8fe5-3396-a6a5-8e3b55d865a2",
                                                "text": "Mammutbäume dürften die übergriffigsten Stämme überhaupt haben."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
