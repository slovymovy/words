                "senses": [
                    {
                        "sense_id": "88a905ff-4161-3453-87c2-880b6bf2d284",
                        "entry_id": "810f7c07-01f3-37a0-8d3e-5e0c1b32b9f6",
                        "glosses": [
                            "техн. роликовая машина для зиговки – гибки листового металла, образования на нем выступов и углублений (зигов)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e607e7b2-8c21-48ef-9a2f-2c4db0db6393",
                                "sense_id": "88a905ff-4161-3453-87c2-880b6bf2d284",
                                "text": "С помощью зигмашины выполняется несколько операция, в том числе: резка; рифление; отбортировка."
                            },
                            {
                                "example_id": "12282462-baa5-4f1f-b477-a54339d8bdf5",
                                "sense_id": "88a905ff-4161-3453-87c2-880b6bf2d284",
                                "text": "Зигмашина - в вентиляции механическое устройство с электроприводом и без, применяемое для прокатки соединительных загибов, для скрепления круглых воздуховодов между собой, а также кольцевых выпуклостей - зигов."
                            }
                        ]
                    }
