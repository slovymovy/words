                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8071ea08-7ee7-4f4a-9cb0-7c5f8dc152a3",
                                "sense_id": "9960db49-163b-3c15-8b54-52c347f8f486",
                                "text": "„Der belieferte europäische Safterzeuger mit Apfelsaftkonzentrat en gros, bis man herausfand, dass es statt Apfelsaft nur Chemikalien enthielt.“"
                            },
                            {
                                "example_id": "53a6f91a-2685-461a-aef6-4e7165f98230",
                                "sense_id": "9960db49-163b-3c15-8b54-52c347f8f486",
                                "text": "„Chinesisches Apfelsaftkonzentrat wird sehr günstig auf dem Weltmarkt angeboten.“"
                            },
                            {
                                "example_id": "c928b3ae-cfeb-457c-9c89-a21e432da53c",
                                "sense_id": "9960db49-163b-3c15-8b54-52c347f8f486",
                                "text": "„China deckt die Hälfte des weltweiten Bedarfs an Apfelsaftkonzentrat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
