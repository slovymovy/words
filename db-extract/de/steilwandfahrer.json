                        "glosses": [
                            "jemand, der mit einem Motorrad an den senkrechten Wänden eines zylinderförmigen Raumes im Kreis fährt (als Jahrmarktsattraktion)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f86ca3a7-a578-4d01-863f-ac2c34ac738a",
                                "sense_id": "a081ae3b-4a96-3df0-9246-f272a74305e9",
                                "text": "„Die wenigen Steilwandfahrer, die es noch gibt, betrachten die Wiesn als heiligen Boden.“"
                            },
                            {
                                "example_id": "2d3b69ae-231a-4626-84a3-0f3c28d5af8d",
                                "sense_id": "a081ae3b-4a96-3df0-9246-f272a74305e9",
                                "text": "„Wenn sie sauber an der Wand fahren, sind Steilwandfahrer sicher: Die Zentrifugalkraft drückt sie gegen die Bretter. Ein Fahrfehler aber reicht, und die Schwerkraft hat sie wieder.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
