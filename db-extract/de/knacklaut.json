                ],
                "senses": [
                    {
                        "sense_id": "43675fa7-290a-357c-8d5c-ea53bb84c044",
                        "entry_id": "cf69b9d6-2538-34ab-8e78-276d41f1fd2b",
                        "glosses": [
                            "glottaler Verschlusslaut, der beispielsweise im Deutschen von vielen Sprechern einer mit einem Vokal beginnenden Silbe vorangestellt wird"
                        ],
                        "tags": [
                            "Phonetik"
                        ],
                        "examples": [
                            {
                                "example_id": "802265bf-64d5-4669-b18c-251c773fec20",
                                "sense_id": "43675fa7-290a-357c-8d5c-ea53bb84c044",
                                "text": "Wörter wie \"Akt\" und Silben wie \"-alt-\" in \"veralten\" haben vor dem anlautenden Buchstaben zusätzlich einen Knacklaut [ʔ]: [ʔakt], [fɛɐ̯ˈʔaltn̩]."
                            },
                            {
                                "example_id": "9272e865-66f0-4b09-bc59-764b8d1b222c",
                                "sense_id": "43675fa7-290a-357c-8d5c-ea53bb84c044",
                                "text": "„Im Deutschen setzen zum Beispiel alle auf Vokal anlautenden Wörter mit einem Knacklaut - und wenn man so will - mit einem Stoßton ein (…).“"
                            },
                            {
                                "example_id": "3d637bc9-d8c1-43fe-925d-54e2166c47d4",
                                "sense_id": "43675fa7-290a-357c-8d5c-ea53bb84c044",
                                "text": "„Im übrigen läßt sich natürlich auch der glottale Verschlußlaut (Knacklaut), der vor vokalisch beginnenden Wörtern steht, als Ersatzkonsonant betrachten.“"
                            },
                            {
                                "example_id": "4692978a-078d-499f-a157-005c4de01400",
                                "sense_id": "43675fa7-290a-357c-8d5c-ea53bb84c044",
                                "text": "„Manche werden ganz vorne an den Lippen gebildet, andere tief unten im Kehlkopf wie der Glottisschlag oder Knacklaut.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
