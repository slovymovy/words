                                                "example_id": "ee31f522-4d0c-442e-a217-c16548a88538",
                                                "sense_id": "748d4aaa-a1bd-3304-baf8-229b752c3445",
                                                "text": "[…] the Ottomans were a dynasty like every other, subject to the same laws of the rise and fall of states."
                                            }
