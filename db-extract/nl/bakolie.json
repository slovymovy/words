                "senses": [
                    {
                        "sense_id": "6c52c919-815a-3433-9e72-4bd043f52173",
                        "entry_id": "1a156ca7-14ed-3742-98bd-a92c5a7ad2f2",
                        "glosses": [
                            "olie waarin men voedsel kan bakken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0144d033-d597-441d-9584-1f3fed1222c2",
                                "sense_id": "6c52c919-815a-3433-9e72-4bd043f52173",
                                "text": "In de fritesoven van Aviko in het Limburgse Lomm heeft zondag brand gewoed. Volgens de brandweer stond duizend liter bakolie in brand."
                            },
                            {
                                "example_id": "ec1d8ec2-a10a-4493-b937-cf3e5083cddc",
                                "sense_id": "6c52c919-815a-3433-9e72-4bd043f52173",
                                "text": "Biodiesel is eenvoudig te maken uit gebruikt frituurvet en bakolie. De waterschappen vragen al jaren om het gebruikte vet in te leveren, maar desondanks ontstaan elk jaar kostbare storingen in de waterzuivering door vastgekoekt vet in het riool. Verwijderen van een liter vet uit afvalwater kost een schap 2,80 euro."
                            },
                            {
                                "example_id": "6de2c481-7166-4411-a058-b28db87b62d0",
                                "sense_id": "6c52c919-815a-3433-9e72-4bd043f52173",
                                "text": "Vluchtelingen in Bangui proberen een voedseldistributiecentrum binnen te dringen. Sinds dinsdag krijgen zij van de Verenigde Naties rijst, bakolie, matten om op te slapen en andere spullen."
                            }
                        ]
                    }
