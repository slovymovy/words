    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "424e0bf6-a06e-3208-8549-9ab61217f78c",
                "word": "drawbridge",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "f9bc4877-7970-4530-b412-1ebffff540d2",
                        "entry_id": "424e0bf6-a06e-3208-8549-9ab61217f78c",
                        "tags": [
                            "plural"
                        ],
                        "form": "drawbridges"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2ff14f21-f117-3f25-92b1-b882d83dd00f",
                        "entry_id": "424e0bf6-a06e-3208-8549-9ab61217f78c",
                        "glosses": [
                            "A hinged bridge which can be raised (to prevent its being crossed, as across a moat, or to allow watercraft to travel beneath it)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97a074d8-47cb-4789-a7b1-d99378edeee6",
                                "sense_id": "2ff14f21-f117-3f25-92b1-b882d83dd00f",
                                "text": "I might jump an open drawbridge, or Tarzan from a vine / 'Cause I'm the unknown stuntman that makes Eastwood look so fine"
                            }
                        ]
                    },
                    {
                        "sense_id": "b8ce3f5c-7acb-39bd-a967-eff81760b00b",
                        "entry_id": "424e0bf6-a06e-3208-8549-9ab61217f78c",
                        "glosses": [
                            "A tendency to provide only limited access."
                        ],
                        "tags": [
                            "attributive",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "f559d832-e369-4587-9698-453e6b9ffaf3",
                                "sense_id": "b8ce3f5c-7acb-39bd-a967-eff81760b00b",
                                "text": "And He gave me the steps I needed to take to let down the drawbridge of my heart again."
                            },
                            {
                                "example_id": "b476d5f3-65a9-4eee-855b-9dc66088b27d",
                                "sense_id": "b8ce3f5c-7acb-39bd-a967-eff81760b00b",
                                "text": "They push against the drawbridge of my mind, shaking me to the core."
                            },
                            {
                                "example_id": "d9872444-51db-4200-ae4a-a8caea321bd2",
                                "sense_id": "b8ce3f5c-7acb-39bd-a967-eff81760b00b",
                                "text": "drawbridge mentality"
                            },
                            {
                                "example_id": "81c82cfa-8413-41e9-bccb-29fd307aa5df",
                                "sense_id": "b8ce3f5c-7acb-39bd-a967-eff81760b00b",
                                "text": "I looked at her with wide eyes, and the drawbridge of her reserve fell instantly."
                            },
                            {
                                "example_id": "a7ebfff1-8bac-4fea-8b49-276294de8835",
                                "sense_id": "b8ce3f5c-7acb-39bd-a967-eff81760b00b",
                                "text": "\"Yeah, some people have a drawbridge mentality,” remarks Barry.“They move to an island and then they think that nobody else should be let in after them. […]"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "41992501-d0a7-450e-96b7-3995d220fbdb",
                        "source_entry_id": "424e0bf6-a06e-3208-8549-9ab61217f78c",
