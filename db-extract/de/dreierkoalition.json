                "senses": [
                    {
                        "sense_id": "de9fac31-aae7-37e0-b0a8-083db2b588db",
                        "entry_id": "6873e300-f77a-3130-93d4-1f26a27af88d",
                        "glosses": [
                            "aus drei Parteien bestehendes politisches Bündnis zur Durchsetzung bestimmter Ziele"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a99aafee-fffd-429c-85af-ecc091860bc6",
                                "sense_id": "de9fac31-aae7-37e0-b0a8-083db2b588db",
                                "text": "„Im Gespräch ist man rasch beim Kern des Debakels: Nicht nur, daß die Dreierkoalition zerbröckelt und zerfasert; bis in die Spitze der Exekutive schlagen widersprüchliche oder unvereinbare Parteiinteressen in einem Maße durch, wie man das selten erlebt hat.“"
                            },
                            {
                                "example_id": "7af3e5e2-5a8c-4385-8f67-eed722df81a3",
                                "sense_id": "de9fac31-aae7-37e0-b0a8-083db2b588db",
                                "text": "„Noch fehlt der sich abzeichnenden neuen Dreierkoalition etwas, das ihre Vorgängerin hatte.“"
                            },
                            {
                                "example_id": "18331270-9a18-412f-9b89-f70fed687cb2",
                                "sense_id": "de9fac31-aae7-37e0-b0a8-083db2b588db",
                                "text": "„Dieses wäre aus seiner Sicht eingetreten, wenn das Bündnis Sahra Wagenknecht es noch in den Bundestag geschafft hätte, und die CDU gezwungen gewesen wäre, eine Dreierkoalition zu bilden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
