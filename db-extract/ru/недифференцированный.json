                "senses": [
                    {
                        "sense_id": "d5bfc56b-eff1-3674-814e-1c6649b2c357",
                        "entry_id": "68d2097f-2bd7-3cd0-8c3b-bd3c98ac9ab7",
                        "glosses": [
                            "книжн. не подразумевающий разделения, различения чего-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0cd95dfc-c68d-46e2-89aa-c76879840731",
                                "sense_id": "d5bfc56b-eff1-3674-814e-1c6649b2c357",
                                "text": "Австралийцы представляют собой протоморфный недифференцированный тип, более близкий к исходным расовым формам, чем какая-либо другая раса."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "aee8b543-ccdc-497e-a73d-a1d4a6ce1d7e",
                        "source_entry_id": "68d2097f-2bd7-3cd0-8c3b-bd3c98ac9ab7",
                        "source_sense_id": "d5bfc56b-eff1-3674-814e-1c6649b2c357",
                        "target_lang_word": "undifferentiated",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "undifferentiated",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f6bce672-c1cf-3d93-ab02-ce622a9867e9",
                                        "entry_id": "8bd35539-ff8b-3df5-9851-97391107c607",
                                        "glosses": [
                                            "Not differentiated, not different, alike."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "befb8176-a7b9-4cb9-b59e-8ad608886ead",
                                                "sense_id": "f6bce672-c1cf-3d93-ab02-ce622a9867e9",
                                                "text": "If we just plopped down a dot for every observation we’d end up with an undifferentiated black blob, so the weathergami technique visualizes frequency of temperature pairs: we divide the chart area into a fine hexagonal grid, and then color each hexagon according to how many daily observations fall within it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2a908bca-23ac-371c-adea-dce51575df3f",
                                        "entry_id": "8bd35539-ff8b-3df5-9851-97391107c607",
                                        "glosses": [
                                            "Not differentiated, not different, alike.",
                                            "Describing tissues where the individual cells have not yet developed mature or distinguishing features, or describes embryonic organisms where the organs cannot be identified."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb2bb601-c582-4574-9854-fc4aa4320a51",
                                                "sense_id": "2a908bca-23ac-371c-adea-dce51575df3f",
                                                "text": "This further exacerbated the diagnostic challenge posed by undifferentiated febrile illness during a “twindemic” of both COVID-19 and dengue, as both illnesses could potentially present with febrile syndromes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "622175ea-1de1-3ade-a37d-c544b34fe91d",
                                        "entry_id": "8bd35539-ff8b-3df5-9851-97391107c607",
                                        "glosses": [
                                            "Not differentiated, not different, alike.",
                                            "Describing a plant body where the vascular tissue has not developed, as in the thallophytes."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
