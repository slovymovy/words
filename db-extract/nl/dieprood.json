                ],
                "senses": [
                    {
                        "sense_id": "f09432a6-10b9-36b8-b66f-f19ad7ed0cc5",
                        "entry_id": "9b027fa1-b72d-36f6-be64-757631ad51b0",
                        "glosses": [
                            "met een intense rode kleur"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "438799ed-f456-413a-bf13-0e9df45e0c9d",
                                "sense_id": "f09432a6-10b9-36b8-b66f-f19ad7ed0cc5",
                                "text": "De Europese aandelenbeurzen herstelden dinsdag iets van de stevige verliezen van de voorbije handelsdagen. Sinds de uitslag van het Britse referendum, waarbij voor een vertrek uit de EU werd gestemd, kleurden de koersborden dieprood. Hoewel er grote onzekerheid blijft bestaan, durfden vooral koopjesjagers het aan posities in te nemen."
                            },
                            {
                                "example_id": "0372cddc-e8bb-4879-ac2f-135c3a2a6698",
                                "sense_id": "f09432a6-10b9-36b8-b66f-f19ad7ed0cc5",
                                "text": "De platanen in de Violierstraat worden vervangen door de van oorsprong Noord-Amerikaanse amberboom, die mooie herfstkleuren heeft: dieprood, geel en oranje."
                            },
                            {
                                "example_id": "ef6de72d-1def-4d6a-895c-579bb23cb7e7",
                                "sense_id": "f09432a6-10b9-36b8-b66f-f19ad7ed0cc5",
                                "text": "Het Deense sportmerk Hummel sponsort de Afghaanse nationale voetbalploegen en dat blijft niet onopgemerkt. Terwijl de mannenploegen een dieprood truitje met groene en zwarte accenten krijgen, is er voor de dames een primeur: shirts voorzien van een onderlaag met hoofddoek."
                            }
                        ]
                    },
                    {
                        "sense_id": "367bd777-d05b-3fde-baa4-8bd4ab8420b3",
                        "entry_id": "9b027fa1-b72d-36f6-be64-757631ad51b0",
                        "glosses": [
                            "zeer verliesgevend"
                        ],
