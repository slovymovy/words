                ],
                "senses": [
                    {
                        "sense_id": "4842bd40-7f58-3235-9a88-98ced1a385a4",
                        "entry_id": "cd22ea52-a097-34a5-bd40-6f2095ddabc7",
                        "glosses": [
                            "Something written (or engraved) on the surface, outside, or above something else; specifically, an address on a letter, envelope, etc."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "0227f8da-5ae1-4c97-b10f-6d7bc56c2bfa",
                                "sense_id": "4842bd40-7f58-3235-9a88-98ced1a385a4",
                                "text": "Hovv counterfeit a coin they are vvho friends / Bear in their Superſcription (of the moſt / I vvould be underſtood) in proſperous days / They ſvvarm, but in adverſe vvithdravv their head / Not to be found, though ſought."
                            },
                            {
                                "example_id": "db40673e-913f-4fbc-adc7-8a74ad5e12aa",
                                "sense_id": "4842bd40-7f58-3235-9a88-98ced1a385a4",
                                "text": "\"Dear me, Mr. Holmes. Dear me!\" said this singular epistle. There was neither superscription nor signature. I laughed at the quaint message; but Holmes showed unwonted seriousness."
                            },
                            {
                                "example_id": "03248226-995b-4f33-bbb7-b61d484fac10",
                                "sense_id": "4842bd40-7f58-3235-9a88-98ced1a385a4",
                                "text": "Its superscription was my name, and the name of the sender, my mother."
                            },
                            {
                                "example_id": "d271997e-129d-4631-b570-d668f49cd0f6",
                                "sense_id": "4842bd40-7f58-3235-9a88-98ced1a385a4",
                                "text": "Schwartz glanced at the printed superscription on the envelope and grumbled as he put the envelope away in his overcoat pocket, to read at leisure."
                            }
                        ]
                    },
                    {
                        "sense_id": "268df918-83f6-34af-a187-ea17fea4592e",
                        "entry_id": "cd22ea52-a097-34a5-bd40-6f2095ddabc7",
                        "glosses": [
                            "An editorial addition at the beginning, often indicating the authorship of a piece."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "d6eb94dc-fb91-4e67-a878-05d0df137e98",
                                "sense_id": "268df918-83f6-34af-a187-ea17fea4592e",
                                "text": "1911, Encyclopædia Britannica\nBy a pure error, or perhaps through a confusion in the traditions, Achish the Philistine (of Gath, 1 Sam. xxi., xxvii.), to whom David fled, is called Abimelech in the superscription to Psalm 34."
                            }
                        ]
                    },
                    {
                        "sense_id": "279a85e1-0727-3535-a15a-56732687a984",
                        "entry_id": "cd22ea52-a097-34a5-bd40-6f2095ddabc7",
                        "glosses": [
                            "The act of superscribing."
                        ],
