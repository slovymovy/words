                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "creation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après cette longue crise, les dirigeants ont cherché à <w>recréer</w> un climat de confiance au sein de l'équipe."
                        },
                        {
                            "text": "Il faudra plusieurs années d'efforts constants pour <w>recréer</w> les conditions favorables au développement économique."
                        }
                    ],
