                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "644286d6-c1e6-39dd-aa12-30a92e5006f6",
                                        "entry_id": "4a15340a-cad3-38e6-aa38-5df602bcafbf",
                                        "glosses": [
                                            "weibliche Person, die mit Hilfe von Gewalt politische Ziele durchzusetzen versucht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1cccc822-c481-47f3-9166-0e068f3d3273",
                                                "sense_id": "644286d6-c1e6-39dd-aa12-30a92e5006f6",
                                                "text": "Die Terroristinnen drohten die Geiseln zu töten, wenn ihre Forderungen nicht erfüllt würden."
                                            },
                                            {
                                                "example_id": "d0cc02d5-e86a-4880-9780-46675ea58b40",
                                                "sense_id": "644286d6-c1e6-39dd-aa12-30a92e5006f6",
                                                "text": "„Im Kinofilm über die RAF ist sie die Terroristin Brigitte Mohnhaupt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dea6249c-e019-4942-ae36-00179846b60a",
                        "source_entry_id": "656b1400-47cb-3ff7-9fa5-410ac45c4377",
                        "source_sense_id": "e2f52e7f-b7f8-3e12-97b1-e9f31222f48b",
