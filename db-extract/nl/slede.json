                                        "entry_id": "cd0daa04-3eeb-3987-b869-d8d39d6432fc",
                                        "glosses": [
                                            "A vehicle, generally pulled by an animal, which moves over snow or ice on runners, used for transporting persons or goods. (contrast \\\"sled\\\", which is smaller)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27b818e8-6b0a-4a78-a818-c9cb4c500813",
                                                "sense_id": "feed8e18-309c-307e-aa32-c852f10fe78e",
                                                "text": "Santa travels in a sleigh."
                                            },
                                            {
                                                "example_id": "a85cf3d1-a73e-4f35-8cd0-28b3e29d81fa",
                                                "sense_id": "feed8e18-309c-307e-aa32-c852f10fe78e",
                                                "text": "In 1958, it was reported that for \"the fourth year in succession, staff of four South London stations have combined to decorate the booking hall at Peckham Rye station\". They installed a nativity scene, models of Father Christmas, and a sleigh driven by huskies, and Christmas trees were placed around the station."
                                            }
                                        ]
