                "senses": [
                    {
                        "sense_id": "cc01ac4c-a6b5-316c-85e2-ae3c6b0ef748",
                        "entry_id": "cf510b6b-f263-3ccd-bd61-b2a615113f96",
                        "glosses": [
                            "Eigenschaft/Zustand, in Prozent (prozentual) ausgedrückt zu sein, eine Prozentzahl darzustellen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a345aca4-35c0-461d-985c-1a0a29d127e2",
                                "sense_id": "cc01ac4c-a6b5-316c-85e2-ae3c6b0ef748",
                                "text": "„Die positive Prozentualität der Transplantation ist jedoch von dem Vorhandensein oder Nichtvorhandensein des Ovariums nicht abhängig.“"
                            },
                            {
                                "example_id": "bba6873d-03a2-483f-8e69-0ca6f8cbf536",
                                "sense_id": "cc01ac4c-a6b5-316c-85e2-ae3c6b0ef748",
                                "text": "„Meine Zusammenstellungen haben nur solche Fälle aufgenommen, in denen das Os trigonum deutlich abgesetzt war, zudem muß die errechnete Prozentualität sicher sogar noch niedriger als die an dem Material tatsächlich bestehende sein.“"
                            },
                            {
                                "example_id": "10d30f72-9c91-47da-baaf-21d4280710b6",
                                "sense_id": "cc01ac4c-a6b5-316c-85e2-ae3c6b0ef748",
                                "text": "„[…] gegenüber einer von Schwalbe und Pfitzner berechneten Prozentualität von 3,0 Proz. in ihrer ersten, 0,7 Proz. in ihrer zweiten und 7 Proz. in ihrer dritten Untersuchungsreihe.“"
                            },
                            {
                                "example_id": "6622232f-8235-4ae6-8e0e-7ee609882c36",
                                "sense_id": "cc01ac4c-a6b5-316c-85e2-ae3c6b0ef748",
                                "text": "„Daneben figuriert dann die Gesamtzahl der Ossifikationen und deren Prozentualität.“"
                            },
                            {
                                "example_id": "ccf6da39-ee2b-4cac-99e2-ef63b234646f",
                                "sense_id": "cc01ac4c-a6b5-316c-85e2-ae3c6b0ef748",
                                "text": "„Und die Prozentualität der Werthsteuer ist es, die diesen unangenehmen Prozeß für den Winzer wesentlich verschärft.“ (1894)"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
