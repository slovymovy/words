    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5855d132-ff09-3b06-8fd3-d0b045b898fd",
                    "sense_definition": "Een afgesloten voorwerp, vaak met een gleuf, waarin men contant geld bewaart en opspaart.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "fysieke_spaarpot",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kleine jongen deed elke week een muntje in zijn <w>spaarpot</w>.",
                            "target_lang_translations": {
                                "en": "The little boy put a coin in his <w>piggy bank</w> every week."
                            }
                        },
                        {
                            "text": "Mijn <w>spaarpot</w> zit vol met glimmende euro's.",
                            "target_lang_translations": {
                                "en": "My <w>money box</w> is full of shiny euros."
                            }
                        }
                    ],
                    "synonyms": [
                        "spaarbus"
                    ],
                    "common_phrases": [
                        "een volle spaarpot"
                    ],
                    "target_lang_definitions": {
                        "en": "A closed container, often with a slot, in which cash is kept and saved."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "piggy bank",
                                "target_lang_sense_clarification": "a physical container for saving coins"
                            },
                            {
                                "target_lang_word": "money box",
                                "target_lang_sense_clarification": "a small box for keeping money"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "24db51be-c9ae-3b73-9ab1-389f7235b2bb",
                    "sense_definition": "Een opgespaarde hoeveelheid geld die dient als financiële reserve voor onvoorziene uitgaven.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "financiele_reserve",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij heeft gelukkig nog een <w>spaarpotje</w> om de nieuwe wasmachine te kunnen kopen.",
                            "target_lang_translations": {
                                "en": "Fortunately, she still has some <w>savings</w> to buy the new washing machine."
                            }
                        },
                        {
                            "text": "Het is verstandig om een <w>spaarpot</w> op te bouwen voor onverwachte kosten.",
                            "target_lang_translations": {
                                "en": "It is wise to build up a <w>nest egg</w> for unexpected costs."
                            }
                        }
                    ],
                    "synonyms": [
                        "reserve",
                        "appeltje voor de dorst"
                    ],
                    "common_phrases": [
                        "een spaarpotje opbouwen"
                    ],
                    "target_lang_definitions": {
                        "en": "An accumulated amount of money that serves as a financial reserve for unforeseen expenses."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "savings",
                                "target_lang_sense_clarification": "money saved up"
                            },
                            {
                                "target_lang_word": "nest egg",
                                "target_lang_sense_clarification": "a sum of money saved for the future"
                            },
                            {
                                "target_lang_word": "rainy day fund",
                                "target_lang_sense_clarification": "money reserved for unexpected expenses"
                            }
                        ]
                    }
                }
            ]
        }
    ]
