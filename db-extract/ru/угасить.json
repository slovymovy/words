                "senses": [
                    {
                        "sense_id": "d2f4e1be-32da-3900-b6c1-8a8cbdb69be6",
                        "entry_id": "09e3c7c5-931c-30e9-b4f1-f12c3cc86f7f",
                        "glosses": [
                            "книжн. заглушить, погасить, не допустив дальнейшего развития"
                        ],
                        "tags": [],
