                "senses": [
                    {
                        "sense_id": "fd9eba27-f2f4-3dc4-be2e-0d80bc30e1fc",
                        "entry_id": "5e43b0f8-5fcb-373c-ad48-976de70be6a5",
                        "glosses": [
                            "Qui calme, au sens physique ou au sens moral."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d06ee7a4-0713-43a3-8b93-14a26aeb31dd",
                                "sense_id": "fd9eba27-f2f4-3dc4-be2e-0d80bc30e1fc",
                                "text": "Chose bizarre, par un retour subit à des impressions si lointaines, je fus rappelé tout à coup vers les aspects les plus austères et les plus calmants de ma vie champêtre."
                            },
                            {
                                "example_id": "d61f3922-a1d6-4474-9ddb-9d58bf3204bb",
                                "sense_id": "fd9eba27-f2f4-3dc4-be2e-0d80bc30e1fc",
                                "text": "Souvent, au milieu de la journée, elle tombait dans de longs sommeils paisibles, calmants, réparateurs."
                            },
                            {
                                "example_id": "a19c1f87-e775-4240-975a-563dfa038139",
                                "sense_id": "fd9eba27-f2f4-3dc4-be2e-0d80bc30e1fc",
                                "text": "Pour le « débestialiser » — pour le « discipliner », aurait dit Foucault, un autre maître à penser de Sloterdijk —, on lui ferait donc ingérer dès sa plus tendre enfance les « grands auteurs » dont la vertu principale résiderait dans les effets calmants."
                            }
                        ]
                    }
                ],
