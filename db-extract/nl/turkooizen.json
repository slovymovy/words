                                "example_id": "071465eb-cb0f-4c8c-ae76-bace0ee0f36f",
                                "sense_id": "f242d4e8-493a-37db-9b06-b402dac39ed9",
                                "text": "We genieten van de parelwitte stranden en de turkooizen zee."
                            }
                        ]
                    },
                    {
                        "sense_id": "c9c60f9a-b70a-3b57-aca2-2245b39991e7",
