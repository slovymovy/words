                        "cross_references": [
                            {
                                "target_word": "sperm",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "588f006a-0e3e-320d-be9d-2af3e3efc253",
                                        "entry_id": "af4480e9-6a27-3e7d-83e1-366703809860",
                                        "glosses": [
                                            "The reproductive cell or gamete of the male; a spermatozoon."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "946d548b-9ee5-4dd8-8906-2df1961a37b4",
                                                "sense_id": "588f006a-0e3e-320d-be9d-2af3e3efc253",
                                                "text": "In the Fall into the division of labor, Levi-Strauss sees the great hunters trading women to create the exogamous bonds of one hunting band with another. The egg is, but the sperm does. The tiny sperm may be furious in its activity, but its highway to the egg is paved by the alkaline trail set down by the Great Mother."
                                            },
                                            {
                                                "example_id": "10a4dca7-e755-4e6c-a923-7d9c116d5ef1",
                                                "sense_id": "588f006a-0e3e-320d-be9d-2af3e3efc253",
                                                "text": "Seeing the two little moving cells – the result of her egg and Luke's sperm – was incredible, and two very long weeks later the clinic confirmed I was pregnant."
                                            },
                                            {
                                                "example_id": "e306fc6c-7e88-4ac8-aeb7-ebd918e01656",
                                                "sense_id": "588f006a-0e3e-320d-be9d-2af3e3efc253",
                                                "text": "“Female may accept the sperms of male that can catapult but deplete the sperms of male that can be easily caught by her,” he said."
                                            },
                                            {
                                                "example_id": "1e15c219-584a-4b5d-a699-dee41edb0df7",
                                                "sense_id": "588f006a-0e3e-320d-be9d-2af3e3efc253",
                                                "text": "However, in some men precum will contain sperm so adequate protection should be used to prevent pregnancy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "77fccdde-1a19-3a42-ad05-6636aedfcdb3",
                                        "entry_id": "af4480e9-6a27-3e7d-83e1-366703809860",
                                        "glosses": [
                                            "Semen; the generative substance of male animals."
                                        ],
                                        "tags": [
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2e208e08-5d89-4674-abac-6f934c0d5041",
                                                "sense_id": "77fccdde-1a19-3a42-ad05-6636aedfcdb3",
                                                "text": "Other Nations there are, that never have use of fire; Others, whose sperme is of a blacke colour."
                                            },
                                            {
                                                "example_id": "520e95b7-01c8-439c-a0b6-f61b7309a703",
                                                "sense_id": "77fccdde-1a19-3a42-ad05-6636aedfcdb3",
                                                "text": "Deer sperm was in used among the Romans as an aphrodisiac."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d6030705-fe02-3e88-b27d-80240a120e62",
                                        "entry_id": "af4480e9-6a27-3e7d-83e1-366703809860",
                                        "glosses": [
                                            "Sperm oil; whale oil from a sperm whale; spermaceti."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "11235671-8e5b-462b-8cce-ee21a9076429",
                                                "sense_id": "d6030705-fe02-3e88-b27d-80240a120e62",
                                                "text": "Holding his candle so that he could read the coffin plates, and so holding it that the sperm dropped in white patches which congealed as they touched the metal, he made assurance of Lucy’s coffin."
                                            }
                                        ]
                                    }
