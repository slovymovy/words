                "senses": [
                    {
                        "sense_id": "aca5575b-ae2c-3c90-aba8-5643b56f8c6a",
                        "entry_id": "cfe5af6a-f61c-3b50-af1d-c6c05030377c",
                        "glosses": [
                            "Oberfläche des Meeres"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1304b846-40a9-4051-a08c-1364a4b17071",
                                "sense_id": "aca5575b-ae2c-3c90-aba8-5643b56f8c6a",
                                "text": "Die Wassertemperatur an der Meeresoberfläche schwankt beträchtlich."
                            },
                            {
                                "example_id": "26548509-7684-4b6a-9a64-f5b3b238e976",
                                "sense_id": "aca5575b-ae2c-3c90-aba8-5643b56f8c6a",
                                "text": "„Aber die Meeresoberfläche war glatt und leer, auch an der Küste entdeckten sie nichts Auffälliges.“"
                            },
                            {
                                "example_id": "6986ce95-bf2f-4d05-912f-1655a0b7a2f9",
                                "sense_id": "aca5575b-ae2c-3c90-aba8-5643b56f8c6a",
                                "text": "„Die Algen wiegten sich auf der Meeresoberfläche, und die Luft roch salzig.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
