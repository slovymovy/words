                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "17bedf32-b81b-3859-9800-5f04a412e9ea",
                    "sense_definition": "To stop suddenly and refuse to move forward.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "stop_refuse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The stubborn horse decided to <w>balk</w> right in the middle of the path.",
                            "target_lang_translations": {
                                "es": "El caballo obstinado decidió <w>pararse en seco</w> justo en medio del camino."
                            }
                        },
                        {
                            "text": "When the dog <w>balked</w> at the gate, we had to pull him gently.",
                            "target_lang_translations": {
                                "es": "Cuando el perro se <w>negó a avanzar</w> en la puerta, tuvimos que tirar de él suavemente."
                            }
                        }
                    ],
                    "synonyms": [
                        "jib"
                    ],
                    "common_phrases": [
                        "horse balks"
                    ],
                    "target_lang_definitions": {
                        "es": "Detenerse de repente y negarse a avanzar."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "pararse en seco",
                                "target_lang_sense_clarification": "Detenerse repentinamente por obstinación."
                            },
                            {
                                "target_lang_word": "encabritarse",
                                "target_lang_sense_clarification": "Específicamente para animales que se niegan a avanzar."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9dbea27a-c6f2-3dbd-a12e-c37f0f482f51",
                    "sense_definition": "To hinder, block, or prevent someone from doing something.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "hinder",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heavy rain <w>balked</w> our plans for a picnic in the park.",
                            "target_lang_translations": {
                                "es": "La fuerte lluvia <w>obstaculizó</w> nuestros planes de hacer un picnic en el parque."
                            }
                        },
                        {
                            "text": "Unexpected technical issues <w>balked</w> the team's progress on the project.",
                            "target_lang_translations": {
                                "es": "Problemas técnicos inesperados <w>frustraron</w> el progreso del equipo en el proyecto."
                            }
                        }
                    ],
                    "synonyms": [
                        "thwart",
                        "baffle",
                        "frustrate"
                    ],
                    "target_lang_definitions": {
                        "es": "Obstaculizar, bloquear o impedir que alguien haga algo."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "obstaculizar",
                                "target_lang_sense_clarification": "Poner obstáculos al progreso de algo."
                            },
                            {
                                "target_lang_word": "frustrar",
                                "target_lang_sense_clarification": "Impedir que algo se realice o tenga éxito."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0a29bab0-c083-3db8-aa1a-b67705803975",
                    "sense_definition": "To intentionally avoid or skip something.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "avoid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We decided to <w>balk</w> the crowded city center and stay in the suburbs.",
                            "target_lang_translations": {
                                "es": "Decidimos <w>evitar</w> el concurrido centro de la ciudad y quedarnos en las afueras."
                            }
                        },
                        {
                            "text": "He tried to <w>balk</w> his responsibilities by leaving early.",
                            "target_lang_translations": {
                                "es": "Intentó <w>esquivar</w> sus responsabilidades yéndose temprano."
                            }
                        }
                    ],
                    "synonyms": [
                        "avoid",
                        "shun",
                        "shirk"
                    ],
                    "target_lang_definitions": {
                        "es": "Evitar o saltarse algo intencionadamente."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "evitar",
                                "target_lang_sense_clarification": "Eludir una situación o responsabilidad."
                            },
                            {
                                "target_lang_word": "esquivar",
                                "target_lang_sense_clarification": "Evitar algo con habilidad o intención."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a043b893-7191-3d07-b9fc-d1c155d9db1e",
                    "sense_definition": "To disappoint or frustrate someone's expectations.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "hinder",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden cancellation of the show <w>balked</w> the audience's expectations.",
                            "target_lang_translations": {
                                "es": "La repentina cancelación del espectáculo <w>frustró</w> las expectativas del público."
                            }
                        },
                        {
                            "text": "Nothing could <w>balk</w> his determination to succeed.",
                            "target_lang_translations": {
                                "es": "Nada pudo <w>frenar</w> su determinación de triunfar."
                            }
                        }
                    ],
                    "synonyms": [
                        "frustrate",
                        "thwart"
                    ],
                    "common_phrases": [
                        "balk expectation"
                    ],
                    "target_lang_definitions": {
                        "es": "Decepcionar o frustrar las expectativas de alguien."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "frustrar",
                                "target_lang_sense_clarification": "Dejar sin efecto una esperanza o expectativa."
                            },
                            {
                                "target_lang_word": "decepcionar",
                                "target_lang_sense_clarification": "No cumplir con lo que se esperaba."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a7f79eb8-7207-317c-9c25-91e469f47e62",
                    "sense_definition": "To miss or overlook something by chance.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "avoid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I accidentally <w>balked</w> the last page of the document while reading.",
                            "target_lang_translations": {
                                "es": "Accidentalmente <w>pasé por alto</w> la última página del documento mientras leía."
                            }
                        },
                        {
                            "text": "It is easy to <w>balk</w> a small detail when you are in a hurry.",
                            "target_lang_translations": {
                                "es": "Es fácil <w>omitir</w> un pequeño detalle cuando tienes prisa."
                            }
                        }
                    ],
                    "synonyms": [
                        "miss",
                        "overlook"
                    ],
                    "target_lang_definitions": {
                        "es": "Pasar por alto algo por casualidad."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "pasar por alto",
                                "target_lang_sense_clarification": "No notar o ignorar algo involuntariamente."
                            },
                            {
                                "target_lang_word": "omitir",
                                "target_lang_sense_clarification": "Dejar de incluir o mencionar algo."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "62b6b848-7b10-305e-bf33-8317c67aaf50",
                    "sense_definition": "A hindrance, check, or disappointment.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "hinder",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lack of funding was a major <w>balk</w> to our research goals.",
                            "target_lang_translations": {
                                "es": "La falta de financiación fue un gran <w>obstáculo</w> para nuestros objetivos de investigación."
                            }
                        },
                        {
                            "text": "His sudden resignation served as a <w>balk</w> to the company's expansion plans.",
                            "target_lang_translations": {
                                "es": "Su repentina dimisión supuso un <w>contratiempo</w> para los planes de expansión de la empresa."
                            }
                        }
                    ],
                    "synonyms": [
                        "failure"
                    ],
                    "target_lang_definitions": {
                        "es": "Un obstáculo, freno o decepción."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "obstáculo",
                                "target_lang_sense_clarification": "Algo que impide el avance."
                            },
                            {
                                "target_lang_word": "contratiempo",
                                "target_lang_sense_clarification": "Suceso inoportuno que dificulta un plan."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}