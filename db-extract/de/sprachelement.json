                "senses": [
                    {
                        "sense_id": "ccda0413-510a-37ab-9fda-d25f09fd171d",
                        "entry_id": "00c2211e-efb1-3ddc-9e59-734982eb05cc",
                        "glosses": [
                            "beliebiger Bestandteil einer Sprache"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae87c964-936b-4eec-ad3e-156d999fb9ce",
                                "sense_id": "ccda0413-510a-37ab-9fda-d25f09fd171d",
                                "text": "„Keineswegs aber baut sich das Jiddisch nur aus den drei genannten Sprachelementen auf, den deutschen, semitischen und slawischen.“"
                            },
                            {
                                "example_id": "a307da21-dd8f-452f-9afe-5b3d13ad481a",
                                "sense_id": "ccda0413-510a-37ab-9fda-d25f09fd171d",
                                "text": "„Das methodologisch Neue ist dabei, daß dem chronologischen Verfahren, in dem jedes neue Sprachelement registriert wurde, ein synchronisches zur Seite steht, wodurch die Sprachfähigkeit des Kindes zu einem bestimmten Zeitpunkt festgestellt werden konnte.“"
                            },
                            {
                                "example_id": "b7f6c99f-d3eb-411d-aa60-38a45830b7b6",
                                "sense_id": "ccda0413-510a-37ab-9fda-d25f09fd171d",
                                "text": "„Gemeinsam ist ihnen, daß zusätzliche Sprachelemente eine Rolle spielen, die zumindest aus der Sicht der Stilkritik aks Symptome unnötiger Wortemacherei erscheinen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
