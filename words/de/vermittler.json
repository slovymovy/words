                    "frequency": "Middle",
                    "semantic_group_id": "schlichtung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Im Streit zwischen den beiden Nachbarn trat der Bürgermeister als unparteiischer <w>Vermittler</w> auf."
                        },
                        {
                            "text": "Beide Parteien stimmten zu, einen unabhängigen <w>Vermittler</w> zur Beilegung des Konflikts einzusetzen."
                        }
                    ],
                    "synonyms": [
                        "Mediator",
                        "Mittler",
                        "Unterhändler"
