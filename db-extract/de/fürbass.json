            {
                "entry_id": "3a40c65c-ae44-39a3-8418-1ddf3ba6bead",
                "word": "fürbass",
                "pos": "adv",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "818da09f-e25d-38b8-b434-e505c2f4a7a2",
                        "entry_id": "3a40c65c-ae44-39a3-8418-1ddf3ba6bead",
                        "glosses": [
                            "weiter, vorwärts"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "9c003642-1dcf-4fae-8562-9a71b598cc6e",
                                "sense_id": "818da09f-e25d-38b8-b434-e505c2f4a7a2",
                                "text": "„Er holt sich in einem Schweinmetzgerladen einen halben Kranz geselchte Würscht und geht wieder fürbaß auf Kraglfing zu.“"
                            },
                            {
                                "example_id": "66241f9e-0361-4116-9b7e-c247754cfecc",
                                "sense_id": "818da09f-e25d-38b8-b434-e505c2f4a7a2",
                                "text": "„Doch der Bursche schien seinen Katzenfreund noch nicht so ganz zu kennen; denn während er ihm seinen Rücken zugewandt hatte und eben fürbaß wollte, fühlte er mit einem Ruck die Jagdbeute sich entrissen, und zugleich schlug eine scharfe Kralle ihm ins Fleisch.“"
                            },
                            {
                                "example_id": "2040b2f2-2e9f-40ce-9e5f-7e88cc57b912",
                                "sense_id": "818da09f-e25d-38b8-b434-e505c2f4a7a2",
                                "text": "„Dann band er das Tuch zusammen, steckte seinen Gehstock durch dasselbe und warf das ziemlich große und schwere Paket über die Schultern; lustig schritt er so bepackt fürbaß weiter.“"
                            },
                            {
                                "example_id": "4bee6a49-b6c6-4cfa-b1d1-16cda4230cb2",
                                "sense_id": "818da09f-e25d-38b8-b434-e505c2f4a7a2",
                                "text": "„Treibt zusammen, treibt zusammen die Schäflein fürbass“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
