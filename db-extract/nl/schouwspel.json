                                        "glosses": [
                                            "Something that exhibits exceptional quality, something worth being shown."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9b9d962-9991-41bf-9c1c-b8b2b03d55e0",
                                                "sense_id": "a8a9dd4b-8298-3579-a5f2-396f51a5d90f",
                                                "text": "Drogba's goal early in the second half - his fourth in this Wembley showpiece - proved decisive as the remarkable turnaround in Chelsea's fortunes under interim manager Roberto di Matteo was rewarded with silverware."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7f5b4611-c771-305a-86e3-1514a2953206",
                                        "entry_id": "bcb8ed9d-4b2e-31c0-abf3-4dbc54645be4",
