                "senses": [
                    {
                        "sense_id": "3c3054ad-6e67-3912-a4df-1f2e1f69b188",
                        "entry_id": "9cd0119c-a385-34e3-88b9-45c7ad170266",
                        "glosses": [
                            "Toxine produite par des algues, dont les microalgues unicellulaires du phytoplancton."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf0e1ec5-c855-4705-8486-1b61a233e5e0",
                                "sense_id": "3c3054ad-6e67-3912-a4df-1f2e1f69b188",
                                "text": "Nous intervenons pour aider à améliorer les méthodes d’identification des phycotoxines ou pour approfondir la taxonomie des espèces algales toxiques."
                            },
                            {
                                "example_id": "4e97c3a5-90b5-473c-b530-a40a66d7a0b5",
                                "sense_id": "3c3054ad-6e67-3912-a4df-1f2e1f69b188",
                                "text": "Surveillance des phycotoxines et du phycoplancton 1 159 000 €."
                            },
                            {
                                "example_id": "6c05b057-b502-4045-9d3b-bd9aeba27f68",
                                "sense_id": "3c3054ad-6e67-3912-a4df-1f2e1f69b188",
                                "text": "Certaines phycotoxines marines de la famille des spiroimines, comme la gymnodimine et les spirolides sont produites par des dinoflagellés et se concentrent dans les mollusques filtreurs."
                            },
                            {
                                "example_id": "47485871-aef4-4481-9be3-f0761f8ba08e",
                                "sense_id": "3c3054ad-6e67-3912-a4df-1f2e1f69b188",
                                "text": "Ils ont détecté un taux effarant d’acide domoïque, une phycotoxine amnésiante que l’on trouve dans les crustacés contaminés par une algue microscopique…"
                            }
                        ]
                    }
