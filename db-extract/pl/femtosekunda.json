                        "glosses": [
                            "jednostka czasu równa jednej biliardowej części sekundy"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb158247-7038-488a-bd8b-56f1ea9571a1",
                                "sense_id": "9b22bf6d-9a93-3b7b-bc6b-65ffbd5677bd",
                                "text": "Zewail w latach osiemdziesiątych dysponował jednak już znacznie potężniejszym źródłem światła: laserami, które mogły emitować impulsy świetlne trwające zaledwie femtosekundy."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8534ed0e-40fb-4b25-b6ec-a482c8102f30",
                        "source_entry_id": "6be7d84a-b032-3099-bad8-89f03d51b1e7",
                        "source_sense_id": "9b22bf6d-9a93-3b7b-bc6b-65ffbd5677bd",
                        "target_lang_word": "femtosecond",
