{
    "word_family": [
        "corrupt",
        "corruption",
        "corruptible",
        "uncorrupted",
        "corruptive"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "7b117fe6-a509-3da4-8b41-bac5af1642f9",
                    "sense_definition": "Containing errors, especially of data in a computer file or on a storage medium.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "damaged_data",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It proved impossible to recover any data from the <w>corrupted</w> disk.",
                            "target_lang_translations": {
                                "ru": "Восстановить какие-либо данные с <w>повреждённого</w> диска оказалось невозможным.",
                                "cs": "Ukázalo se, že z <w>poškozeného</w> disku není možné obnovit žádná data."
                            }
                        },
                        {
                            "text": "The system crashed because of a <w>corrupted</w> file in the main directory.",
                            "target_lang_translations": {
                                "ru": "Система дала сбой из-за <w>повреждённого</w> файла в корневом каталоге.",
                                "cs": "Systém zkolaboval kvůli <w>poškozenému</w> souboru v hlavním adresáři."
                            }
                        }
                    ],
                    "common_phrases": [
                        "corrupted file",
                        "corrupted data"
                    ],
                    "target_lang_definitions": {
                        "ru": "Содержащий ошибки, поврежденный (особенно о данных в компьютерном файле или на носителе информации).",
                        "cs": "Obsahující chyby, zejména pokud jde o data v počítačovém souboru nebo na paměťovém médiu."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "повреждённый",
                                "target_lang_sense_clarification": "о файлах, данных или дисках"
                            },
                            {
                                "target_lang_word": "испорченный",
                                "target_lang_sense_clarification": "о цифровых носителях или файлах"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "poškozený",
                                "target_lang_sense_clarification": "o souborech nebo datech"
                            },
                            {
                                "target_lang_word": "porušený",
                                "target_lang_sense_clarification": "o digitálních datech"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7e68ab32-a8af-31aa-9eb0-49efdd690311",
                    "sense_definition": "Marked by immorality, perversion, or depravity.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "moral_decay",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The youth were led astray by the <w>corrupted</w> morals of the local gang leaders.",
                            "target_lang_translations": {
                                "ru": "Молодежь была сбита с пути <w>развращёнными</w> нравами лидеров местной банды.",
                                "cs": "Mládež byla svedena na scestí <w>zkaženou</w> morálkou vůdců místního gangu."
                            }
                        },
                        {
                            "text": "He lived a <w>corrupted</w> lifestyle that eventually led to his downfall.",
                            "target_lang_translations": {
                                "ru": "Он вел <w>порочный</w> образ жизни, который в конце концов привел его к краху.",
                                "cs": "Vedl <w>zkažený</w> životní styl, který nakonec vedl k jeho pádu."
                            }
                        }
                    ],
                    "synonyms": [
                        "corrupt"
                    ],
                    "common_phrases": [
                        "corrupted morals",
                        "corrupted mind"
                    ],
                    "target_lang_definitions": {
                        "ru": "Характеризующийся аморальностью, развращенностью или порочностью.",
                        "cs": "Vyznačující se nemorálností, zkažeností nebo mravním úpadkem."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "развращённый",
                                "target_lang_sense_clarification": "о нравах, образе жизни"
                            },
                            {
                                "target_lang_word": "испорченный",
                                "target_lang_sense_clarification": "о морали, разуме"
                            },
                            {
                                "target_lang_word": "порочный",
                                "target_lang_sense_clarification": "о поведении или образе жизни"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "zkažený",
                                "target_lang_sense_clarification": "o morálce nebo životním stylu"
                            },
                            {
                                "target_lang_word": "mravně narušený",
                                "target_lang_sense_clarification": "o chování či povaze"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a21fb233-8634-3e82-bb50-bb469f027be0",
                    "sense_definition": "Dishonest, especially through taking bribes or abusing power.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "dishonesty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The citizens protested against the <w>corrupted</w> politicians who stole public funds.",
                            "target_lang_translations": {
                                "ru": "Граждане протестовали против <w>коррумпированных</w> политиков, воровавших государственные средства.",
                                "cs": "Občané protestovali proti <w>zkorumpovaným</w> politikům, kteří kradli veřejné finance."
                            }
                        },
                        {
                            "text": "An investigation was launched to expose the <w>corrupted</w> officials in the department.",
                            "target_lang_translations": {
                                "ru": "Было начато расследование с целью разоблачить <w>продажных</w> чиновников в ведомстве.",
                                "cs": "Bylo zahájeno vyšetřování s cílem odhalit <w>úplatné</w> úředníky v daném oddělení."
                            }
                        }
                    ],
                    "synonyms": [
                        "corrupt"
                    ],
                    "common_phrases": [
                        "corrupted officials",
                        "corrupted system"
                    ],
                    "target_lang_definitions": {
                        "ru": "Нечестный, берущий взятки или злоупотребляющий властью.",
                        "cs": "Nečestný, zejména přijímáním úplatků nebo zneužíváním moci."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "коррумпированный",
                                "target_lang_sense_clarification": "о политиках, чиновниках, системе"
                            },
                            {
                                "target_lang_word": "продажный",
                                "target_lang_sense_clarification": "о должностных лицах"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "zkorumpovaný",
                                "target_lang_sense_clarification": "o politicích, úřednících či systému"
                            },
                            {
                                "target_lang_word": "úplatný",
                                "target_lang_sense_clarification": "o činitelích přijímajících úplatky"
                            },
                            {
                                "target_lang_word": "prodejný",
                                "target_lang_sense_clarification": "o osobách jednající ze zištných důvodů"
                            }
                        ]
                    }
                }
            ]
        },
        {
