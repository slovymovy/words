                "senses": [
                    {
                        "sense_id": "5fc1de82-566a-3cfd-a060-8df90caaadb0",
                        "entry_id": "8a57d231-07ba-3b29-ba94-b276ccc1c9c8",
                        "glosses": [
                            "Dialekt des Deutschen, genauer des Oberdeutschen, der in Teilen der Oberpfalz, von Oberfranken, Mittelfranken und im südlichsten Teil Sachsens gesprochen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6504cb17-1352-444a-a2e2-3f929e8fe508",
                                "sense_id": "5fc1de82-566a-3cfd-a060-8df90caaadb0",
                                "text": "„Das Nordbairische erfüllt die Oberpfalz und das Egerland in Böhmen.“"
                            },
                            {
                                "example_id": "24dcbeb2-6f1a-4598-85f8-9d7b1aa8e3d3",
                                "sense_id": "5fc1de82-566a-3cfd-a060-8df90caaadb0",
                                "text": "„Das Bairisch-Österreichische zerfällt wieder in drei Gebiete: das Nordbairische, zu dem das Oberpfälzische und Westböhmische gehört; das Mittelbairische, das Altbaiern, Ober- und Niederösterreich und Salzburg umfaßt; das Südbairische: das Gebiet von Ammer und Loisach, Tirol, Kärnten, Steiermark.“"
                            },
                            {
                                "example_id": "84aaf51e-5dd6-4e0d-b956-4e0fd06cc0dc",
                                "sense_id": "5fc1de82-566a-3cfd-a060-8df90caaadb0",
                                "text": "„Die Mda. [Mundarten] des Böhmerwaldes gehören dem bairischen Dialekte an. Dieser zerfällt in das Süd- oder Alpenbairische, das Mittel- oder Donaubairische und das Nordbairische (Nordgauische, Oberpfälzische).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
