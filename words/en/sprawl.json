                    ],
                    "synonyms": [
                        "splay",
                        "splay"
                    ],
                    "common_phrases": [
                        "sprawl across the floor",
                        "sprawl over the hills"
                    ],
                    "target_lang_definitions": {
                        "ru": "Беспорядочно или неравномерно распространяться на большой территории."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разрастаться",
                                "target_lang_sense_clarification": "занимать всё больше места"
                            },
                            {
                                "target_lang_word": "раскидываться",
                                "target_lang_sense_clarification": "занимать широкое пространство"
