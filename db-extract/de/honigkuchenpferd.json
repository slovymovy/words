                "senses": [
                    {
                        "sense_id": "3c1f1809-69c0-33dc-8e64-f141cc104d12",
                        "entry_id": "de4114c7-ba7c-3793-89ec-0fa091aac01c",
                        "glosses": [
                            "Gebäck aus Honigkuchen in der Form eines Pferdes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bedc1759-751b-402b-98ee-470278fe8ce6",
                                "sense_id": "3c1f1809-69c0-33dc-8e64-f141cc104d12",
                                "text": "In der Bäckerei gibt es heute Honigkuchenpferde zu kaufen."
                            },
                            {
                                "example_id": "d9eb24e5-d84f-4055-a58c-7cd16c2b825b",
                                "sense_id": "3c1f1809-69c0-33dc-8e64-f141cc104d12",
                                "text": "„Oma strahlte wie ein Honigkuchenpferd, als wir da waren, und Opa stellte fest, daß ich gewachsen sei.“"
                            },
                            {
                                "example_id": "60dfd8ea-7168-408e-9e9b-9cb0bba61868",
                                "sense_id": "3c1f1809-69c0-33dc-8e64-f141cc104d12",
                                "text": "„Drei Minuten später trinken wir eine große Schorle und sehen zufrieden wie zwei Honigkuchenpferde aus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
