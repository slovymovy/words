                            {
                                "example_id": "9e4cce5b-eaf5-48c9-9c95-2a305162c6b7",
                                "sense_id": "1fa1976a-a9c4-3cb9-8e50-f8105cd67724",
                                "text": "He greeted her for the first time in three years with a restrained embrace."
                            }
                        ]
                    },
                    {
                        "sense_id": "6f8818de-55c4-308a-8c9f-8f8bfdea71a8",
                        "entry_id": "515c94ee-b8c2-33e4-b6a1-078a6cd4c656",
                        "glosses": [
                            "Proscribed, restricted."
