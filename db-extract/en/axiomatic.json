                                    {
                                        "sense_id": "d3df7f80-8599-394f-b9a2-099d9eb473b4",
                                        "entry_id": "f6e843b9-db8d-3ee1-95b2-34b5f4d7e151",
                                        "glosses": [
                                            "auf Axiomen beruhend, sie betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cfbcbf1b-02a0-46ed-b6d3-d50c4d05f5da",
                                                "sense_id": "d3df7f80-8599-394f-b9a2-099d9eb473b4",
                                                "text": "„Während die Mathematiker ab 1900 noch das Programm ihres Meisters befolgen und die Widerspruchsfreiheit und Vollständigkeit axiomatischer Systeme zu beweisen suchen, regt sich Kritik an dem Konzept der Vollständigkeit noch von ganz anderer Seite, und zwar aus philosophischer Perspektive.“"
                                            }
                                        ],
