                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Smiling</w> uses fewer muscles than frowning does.",
                            "target_lang_translations": {
                                "ru": "<w>Улыбка</w> задействует меньше мышц, чем хмурый взгляд.",
                                "zh": "<w>微笑</w>比皱眉动用的肌肉更少。",
                                "nl": "<w>Glimlachen</w> gebruikt minder spieren dan fronsen.",
                                "pl": "<w>Uśmiechanie się</w> angażuje mniej mięśni niż marszczenie brwi.",
                                "de": "<w>Lächeln</w> beansprucht weniger Muskeln als Stirnrunzeln.",
                                "fr": "Le <w>sourire</w> utilise moins de muscles que le froncement de sourcils.",
                                "it": "<w>Sorridere</w> usa meno muscoli rispetto all'accigliarsi.",
                                "cs": "<w>Usmívání</w> využívá méně svalů než mračení.",
                                "tr": "<w>Gülümsemek</w>, kaş çatmaktan daha az kas çalıştırır.",
                                "es": "<w>Sonreír</w> usa menos músculos que fruncir el ceño."
                            }
                        },
                        {
                            "text": "Her constant <w>smiling</w> made the guests feel very welcome.",
                            "target_lang_translations": {
                                "ru": "Её постоянная <w>улыбка</w> заставляла гостей чувствовать себя очень желанными.",
                                "zh": "她始终保持<w>微笑</w>，让客人们感到非常受欢迎。",
                                "nl": "Haar constante <w>glimlachen</w> zorgde ervoor dat de gasten zich erg welkom voelden.",
                                "pl": "Jej ciągły <w>uśmiech</w> sprawiał, że goście czuli się bardzo mile widziani.",
                                "de": "Ihr ständiges <w>Lächeln</w> gab den Gästen das Gefühl, sehr willkommen zu sein.",
                                "fr": "Son <w>sourire</w> constant a fait en sorte que les invités se sentent très bien accueillis.",
                                "it": "Il suo costante <w>sorridere</w> ha fatto sentire gli ospiti molto benvenuti.",
                                "cs": "Díky jejímu neustálému <w>usmívání</w> se hosté cítili velmi vítaní.",
                                "tr": "Sürekli <w>gülümsemesi</w> misafirlerin kendilerini çok hoş karşılanmış hissetmelerini sağladı.",
                                "es": "Su <w>sonrisa</w> constante hizo que los invitados se sintieran muy bienvenidos."
                            }
