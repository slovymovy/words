                "translations": [
                    {
                        "translation_id": "5aff9d61-1abe-4638-a2b0-cf0a3cca279b",
                        "source_entry_id": "b7db7d2c-5f6b-3afa-a1de-cb4601d450de",
                        "target_lang_word": "gregorianisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gregorianisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d224d130-8c03-383a-8ebd-7d2a550b8416",
                                        "entry_id": "38722b21-e67a-3284-ba2e-da5a3bfeec2b",
                                        "glosses": [
                                            "auf die kirchlichen Gesänge bezogen, die nach Papst Gregor dem Großen benannt wurden"
                                        ],
                                        "tags": [
                                            "meist in festen Wendungen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "64b0300f-fa2d-4b59-8c12-22ec42a65b90",
                                                "sense_id": "d224d130-8c03-383a-8ebd-7d2a550b8416",
                                                "text": "„Die Texte der gregorianischen Gesänge sind fast ausschließlich der Bibel, teilweise aber auch den Apokryphen entnommen und bestehen zu einem großen Teil aus Psalmversen.“"
                                            },
                                            {
                                                "example_id": "4a752f97-3175-4e56-9342-ef31ff4f8574",
                                                "sense_id": "d224d130-8c03-383a-8ebd-7d2a550b8416",
                                                "text": "„Nur wer für die Schwachen schreit, darf auch gregorianisch singen. Und: Nur wer gregorianisch singt, kann auch für die Schwachen schreien!“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "62d58199-2c27-3b61-91b3-8c6794f820c2",
                                        "entry_id": "38722b21-e67a-3284-ba2e-da5a3bfeec2b",
                                        "glosses": [
                                            "auf den Kalender bezogen, der unter Papst Gregor XIII. eingeführt wurde (Vergleiche julianisch)"
                                        ],
                                        "tags": [
                                            "meist in festen Wendungen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5310aef5-f1eb-4618-8e77-7bef5768781d",
                                                "sense_id": "62d58199-2c27-3b61-91b3-8c6794f820c2",
                                                "text": "„Heute ist der gregorianische Kalender auch in den meisten islamischen Staaten eingeführt und letztlich wichtiger als der islamische Kalender, der im Alltag außer für islamische Feste keine Rolle spielt.“"
                                            },
                                            {
                                                "example_id": "b174b9a5-201e-4337-9635-bb9dd5b34e32",
                                                "sense_id": "62d58199-2c27-3b61-91b3-8c6794f820c2",
                                                "text": "„Ist das Datum julianisch, so wird das zugehörige gregorianische Datum in runden Klammern beigefügt.“"
                                            },
                                            {
                                                "example_id": "82fbef85-152f-47db-b9d5-cc5442d03609",
                                                "sense_id": "62d58199-2c27-3b61-91b3-8c6794f820c2",
                                                "text": "„Erst im Jahre 1700 vereinigten sich die protestantischen Stände der verschiedenen Staaten in Folge der Bemühungen von Leibnitz und Weigel dahin, nach dem 18. Februar auf den 1. März überzugehen und sich so der gregorianischen Rechnung anzuschließen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3bc34a95-2c22-4f07-8664-46c31720ff94",
