    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3f4c8090-5042-35f6-a1a1-4383bf9de7b8",
                    "sense_definition": "A flower with a pleasant smell and soft petals, often red, pink, white, or yellow, or the prickly bush it grows on.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "botany",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He gave her a beautiful red <w>rose</w> for her birthday.",
                            "target_lang_translations": {
                                "ru": "Он подарил ей красивую красную <w>розу</w> на день рождения.",
                                "zh": "他送了她一朵美丽的红<w>玫瑰</w>作为生日礼物。"
                            }
                        },
                        {
                            "text": "The gardener pruned the <w>rose</w> bushes in the spring.",
                            "target_lang_translations": {
                                "ru": "Садовник подрезал кусты <w>роз</w> весной.",
                                "zh": "园丁在春天修剪了<w>玫瑰</w>丛。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "red rose",
                        "white rose",
                        "bed of roses",
                        "smell the roses"
                    ],
                    "target_lang_definitions": {
                        "ru": "Цветок с приятным запахом и мягкими лепестками, часто красный, розовый, белый или желтый, или колючий куст, на котором он растет.",
                        "zh": "一种带有芬芳气味和柔软花瓣的花，通常为红色、粉色、白色或黄色，也指生长这种花的带刺灌木。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "роза",
                                "target_lang_sense_clarification": "цветок или куст"
                            },
                            {
                                "target_lang_word": "шиповник",
                                "target_lang_sense_clarification": "дикая роза"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "玫瑰",
                                "target_lang_sense_clarification": "花朵或灌木"
                            },
                            {
                                "target_lang_word": "玫瑰花",
                                "target_lang_sense_clarification": "花朵"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9f51343f-0164-39d2-9d36-44c78f6448e0",
                    "sense_definition": "A purplish-red or pink color.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "color",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She chose a soft <w>rose</w> for the walls of her bedroom.",
