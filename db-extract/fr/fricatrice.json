                            {
                                "example_id": "5da354f3-442b-48fd-b13b-420264b47b51",
                                "sense_id": "567610d0-bf6c-3ac1-b198-034b848ad1d6",
                                "text": "En outre, la « fricatrice » avait pour atout d’assumer un rôle d’homme, ce qui était valorisant, alors que l’homosexuel passif s’abaissait au niveau de la femme."
                            },
                            {
                                "example_id": "731ae3c7-b91d-4c53-aa44-df541eae7956",
                                "sense_id": "567610d0-bf6c-3ac1-b198-034b848ad1d6",
                                "text": "Toute femme suspectée d’avoir des rapports avec une autre femme était considérée comme une tribade, comme une fricatrice, car elle usurpait à l’homme le rôle qui procédait du frottement."
                            }
                        ]
                    }
