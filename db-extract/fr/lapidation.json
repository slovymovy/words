                                        "entry_id": "6c8e2e44-8214-3b75-ad7e-02a589353303",
                                        "glosses": [
                                            "lapidation: punishment by throwing stones, usually resulting in death"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7893f8f1-bb41-4c9e-bc72-350d4148d555",
                                                "sense_id": "07bf837d-70a3-3fd1-bb9e-af08d3f907e4",
                                                "text": "The stonings came as something of a surprise, in that Iranian officials had said they had suspended that method of execution."
                                            }
