                "senses": [
                    {
                        "sense_id": "a31ed1b4-8602-3e7d-8a7f-f36a5051e19d",
                        "entry_id": "5a9e524e-a7a4-33b5-9de8-5b07a3e01652",
                        "glosses": [
                            "Prénom masculin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "56e8b3f5-8758-4133-b3c6-5acd86d9a284",
                                "sense_id": "a31ed1b4-8602-3e7d-8a7f-f36a5051e19d",
                                "text": "Avant même l’éviction de Laurent Blanc, l’Américain a ainsi rencontré Graham Potter (ex-Chelsea), Oliver Glasner (ex-Francfort), Habib Beye (Red Star), Gennaro Gattuso (ex-Valence) et désormais Frank Lampard (ex-Chelsea)."
                            },
                            {
                                "example_id": "2ef4e131-cd9b-44ca-8b15-64b10e65a91a",
                                "sense_id": "a31ed1b4-8602-3e7d-8a7f-f36a5051e19d",
                                "text": "Peut-être est-il important de rappeler que, selon la BBC, avant les années 1800, la moitié des hommes anglais portaient les quatre mêmes prénoms: Harry, Oliver, Jack et Charlie!"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
