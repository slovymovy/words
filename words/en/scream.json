{
    "word_family": [
        "screamer"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "cb7d2e52-a4a9-36b3-a654-ce2afe5562a7",
                    "sense_definition": "To cry out with a loud, high-pitched voice, usually because of fear, pain, or excitement.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "sound_production",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She started to <w>scream</w> when she saw the large spider on the wall.",
                            "target_lang_translations": {
                                "ru": "Она начала <w>кричать</w>, когда увидела большого паука на стене.",
                                "zh": "她看到墙上的大蜘蛛时，开始<w>尖叫</w>起来。"
                            }
                        },
                        {
                            "text": "Please do not <w>scream</w> at me just because you are angry.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, не <w>кричи</w> на меня только потому, что ты злишься.",
                                "zh": "请不要因为生气就对我<w>大喊大叫</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "shriek",
                        "yell",
                        "shout",
                        "cry",
                        "screech",
                        "howl",
                        "wail"
                    ],
                    "antonyms": [
                        "whisper",
                        "murmur"
                    ],
                    "common_phrases": [
                        "scream for help",
                        "scream in pain",
                        "scream at someone",
                        "scream with laughter"
                    ],
                    "target_lang_definitions": {
                        "ru": "Издавать громкий, высокий звук голосом, обычно из-за страха, боли или волнения.",
                        "zh": "用又高又响的声音喊叫，通常是因为害怕、疼痛或激动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кричать",
                                "target_lang_sense_clarification": "издавать громкий звук"
                            },
                            {
                                "target_lang_word": "вопить",
                                "target_lang_sense_clarification": "громко и протяжно кричать (обычно от боли или страха)"
                            },
                            {
                                "target_lang_word": "визжать",
                                "target_lang_sense_clarification": "издавать высокий, пронзительный звук"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "尖叫",
                                "target_lang_sense_clarification": "因恐惧、疼痛或激动而发出的高声喊叫"
                            },
                            {
                                "target_lang_word": "大叫",
                                "target_lang_sense_clarification": "大声喊叫，较口语"
                            },
                            {
                                "target_lang_word": "大喊大叫",
                                "target_lang_sense_clarification": "对人怒喊、吼叫"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bcb3e877-9eb7-3fa1-a696-435bb2b761f9",
                    "sense_definition": "To show or express a characteristic very clearly and obviously.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "metaphorical_indication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her expensive designer outfit <w>screams</w> wealth and status.",
                            "target_lang_translations": {
                                "ru": "Её дорогой дизайнерский наряд <w>кричит</w> о богатстве и статусе.",
                                "zh": "她那身昂贵的名牌衣服非常<w>彰显</w>财富和地位。"
                            }
                        },
                        {
                            "text": "The disorganized pile of papers on his desk <w>screams</w> that he is too busy.",
                            "target_lang_translations": {
                                "ru": "Беспорядочная кипа бумаг на его столе <w>кричит</w> о том, что он слишком занят.",
                                "zh": "他桌上那堆乱七八糟的文件明显<w>表明</w>他忙得不可开交。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "scream quality",
                        "scream success"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used metaphorically"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Явно и очевидно демонстрировать или выражать какую-либо характеристику.",
                        "zh": "非常明显、直白地表现或显示出某种特征。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кричать",
                                "target_lang_sense_clarification": "перен. ярко свидетельствовать о чем-либо"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "彰显",
                                "target_lang_sense_clarification": "非常明显地表现出某种特征"
                            },
                            {
                                "target_lang_word": "表明",
                                "target_lang_sense_clarification": "清楚地显示出、表明"
                            },
                            {
                                "target_lang_word": "显得很",
                                "target_lang_sense_clarification": "带有口语色彩，指‘一看就知道’"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f3dfac3c-2b24-3bfb-b756-6a128d1ba1d5",
                    "sense_definition": "To move very quickly, often making a loud noise like an engine revving.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police car came <w>screaming</w> around the corner with its sirens on.",
                            "target_lang_translations": {
                                "ru": "Полицейская машина <w>вылетела</w> из-за угла с включенными сиренами.",
                                "zh": "警车鸣着警笛从拐角处<w>飞驰</w>而来。"
                            }
                        },
                        {
                            "text": "We watched the fighter jets <w>scream</w> across the sky at the air show.",
                            "target_lang_translations": {
                                "ru": "Мы наблюдали, как истребители <w>проносились</w> по небу на авиашоу.",
                                "zh": "在航展上，我们看着战斗机从天空中<w>呼啸</w>而过。"
                            }
                        }
                    ],
                    "synonyms": [
                        "speed",
                        "race",
                        "zoom",
                        "rush",
                        "hurtle"
                    ],
                    "antonyms": [
                        "crawl"
                    ],
                    "common_phrases": [
                        "scream down the road",
                        "scream past"
                    ],
                    "target_lang_definitions": {
                        "ru": "Двигаться очень быстро, часто издавая громкий звук (например, рев двигателя).",
                        "zh": "快速移动，常伴有像发动机轰鸣那样的巨大声响。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мчаться",
                                "target_lang_sense_clarification": "быстро ехать"
                            },
                            {
                                "target_lang_word": "нестись",
                                "target_lang_sense_clarification": "стремительно двигаться"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "飞驰",
                                "target_lang_sense_clarification": "快速奔驰、疾驰"
                            },
                            {
                                "target_lang_word": "呼啸而过",
                                "target_lang_sense_clarification": "形容高速移动并带有很大声响"
                            },
                            {
                                "target_lang_word": "疾驰",
                                "target_lang_sense_clarification": "飞快地冲过去"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3abed995-d403-325d-9d2a-35b0bc61347f",
                    "sense_definition": "A loud, high-pitched cry expressing extreme emotion like fear, pain, or excitement.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "sound_production",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We heard a terrifying <w>scream</w> coming from the old house.",
                            "target_lang_translations": {
                                "ru": "Мы услышали ужасающий <w>крик</w>, доносившийся из старого дома.",
                                "zh": "我们听到老房子里传来一声可怕的<w>尖叫</w>。"
                            }
                        },
                        {
                            "text": "She let out a loud <w>scream</w> of joy when she won the lottery.",
                            "target_lang_translations": {
                                "ru": "Она издала громкий <w>крик</w> радости, когда выиграла в лотерею.",
                                "zh": "她中彩票时发出了一声响亮的<w>欢叫</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "shriek",
                        "yell",
                        "cry",
                        "shout",
                        "screech",
                        "howl",
                        "wail"
                    ],
                    "antonyms": [
                        "whisper",
                        "murmur"
                    ],
                    "common_phrases": [
                        "let out a scream",
                        "loud scream",
                        "scream of terror"
                    ],
                    "target_lang_definitions": {
                        "ru": "Громкий, высокий возглас, выражающий сильные эмоции, такие как страх, боль или волнение.",
                        "zh": "表达恐惧、疼痛或兴奋等强烈情绪的高而响的叫声。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "крик",
                                "target_lang_sense_clarification": "громкий звук голоса"
                            },
                            {
                                "target_lang_word": "вопль",
                                "target_lang_sense_clarification": "отчаянный или сильный крик"
                            },
                            {
                                "target_lang_word": "визг",
                                "target_lang_sense_clarification": "пронзительный высокий крик"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "尖叫",
                                "target_lang_sense_clarification": "又高又响的叫声"
                            },
                            {
                                "target_lang_word": "叫声",
                                "target_lang_sense_clarification": "泛指大声喊叫、呼喊"
                            },
                            {
                                "target_lang_word": "欢叫",
                                "target_lang_sense_clarification": "因快乐而发出的高声叫喊"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "87fb65ba-968e-31dd-bd12-56ec8f536448",
                    "sense_definition": "A loud vocal sound made by an animal, often in pain or fear.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sound_production",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>scream</w> of the eagle echoed through the mountain valley.",
                            "target_lang_translations": {
                                "ru": "<w>Крик</w> орла эхом разнесся по горной долине.",
                                "zh": "鹰的<w>尖啸</w>声在山谷中回荡。"
                            }
                        },
                        {
                            "text": "Hunters can often identify the <w>scream</w> of a wounded rabbit.",
                            "target_lang_translations": {
                                "ru": "Охотники часто могут узнать <w>крик</w> раненого кролика.",
                                "zh": "猎人往往能辨认出受伤兔子的<w>尖叫</w>声。"
                            }
                        }
                    ],
                    "synonyms": [
                        "cry",
                        "screech"
                    ],
                    "target_lang_definitions": {
                        "ru": "Громкий звук, издаваемый животным, часто от боли или страха.",
                        "zh": "动物发出的响亮叫声，常常是因为疼痛或恐惧。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "крик",
                                "target_lang_sense_clarification": "звук животного"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "尖啸",
                                "target_lang_sense_clarification": "鸟类等动物发出的尖厉叫声"
                            },
                            {
                                "target_lang_word": "尖叫声",
                                "target_lang_sense_clarification": "动物因疼痛或恐惧发出的尖锐叫声"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3cc68307-b43d-3ab1-84db-d03e2828f3ad",
                    "sense_definition": "A singing style in metal music characterized by a rough, distorted voice.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "sound_production",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lead singer is famous for his powerful and sustained <w>scream</w>.",
                            "target_lang_translations": {
                                "ru": "Вокалист известен своим мощным и продолжительным <w>скримом</w>.",
                                "zh": "这位主唱以他强劲而持久的<w>嘶吼唱腔</w>闻名。"
                            }
                        },
                        {
                            "text": "Learning how to perform a metal <w>scream</w> safely takes a lot of practice.",
                            "target_lang_translations": {
                                "ru": "Обучение безопасному исполнению метал-<w>скрима</w> требует большой практики.",
                                "zh": "学习如何安全地唱出金属<w>嘶吼唱腔</w>需要大量练习。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "death metal scream"
                    ],
                    "target_lang_definitions": {
                        "ru": "Стиль пения в метал-музыке, характеризующийся грубым, искаженным голосом.",
                        "zh": "金属音乐中的一种演唱方式，特点是声音粗粝、失真。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скрим",
                                "target_lang_sense_clarification": "вокальный прием"
                            },
                            {
                                "target_lang_word": "крик",
                                "target_lang_sense_clarification": "общее значение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "嘶吼唱腔",
                                "target_lang_sense_clarification": "金属乐中粗粝、失真、持续的吼唱方式"
                            },
                            {
                                "target_lang_word": "嘶吼",
                                "target_lang_sense_clarification": "音乐圈常用说法，指金属风格的 scream"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "99288eba-cde7-3df8-a609-7d84598a9d25",
                    "sense_definition": "A person or thing that is very funny or entertaining.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "metaphorical_indication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The party last night was a real <w>scream</w>.",
                            "target_lang_translations": {
                                "ru": "Вчерашняя вечеринка была просто <w>умора</w>.",
                                "zh": "昨晚的派对真是太<w>搞笑</w>了。"
                            }
                        },
                        {
                            "text": "Her new comedy show is an absolute <w>scream</w> from start to finish.",
                            "target_lang_translations": {
                                "ru": "Её новое комедийное шоу — это полная <w>умора</w> от начала до конца.",
                                "zh": "她的新喜剧秀从头到尾都特别<w>逗</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "riot",
                        "hoot"
                    ],
                    "antonyms": [
                        "bore"
                    ],
                    "common_phrases": [
                        "a real scream",
                        "an absolute scream"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "idiomatic usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек или вещь, которые очень смешны или забавны.",
                        "zh": "非常滑稽或有趣的人或事物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "умора",
                                "target_lang_sense_clarification": "разг. что-то очень смешное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "笑料",
                                "target_lang_sense_clarification": "口语，指特别好笑的人或事"
                            },
                            {
                                "target_lang_word": "乐子",
                                "target_lang_sense_clarification": "口语，指非常逗、非常好笑的事物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c17e53ac-e738-33c4-9e50-727eaca91376",
                    "sense_definition": "An exclamation mark.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "symbol",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Some programmers refer to the exclamation point as a <w>scream</w>.",
                            "target_lang_translations": {
                                "ru": "Некоторые программисты называют восклицательный знак <w>криком</w>.",
                                "zh": "有些程序员把感叹号叫作<w>叹号</w>。"
                            }
                        },
                        {
                            "text": "You forgot to put a <w>scream</w> at the end of that command.",
                            "target_lang_translations": {
                                "ru": "Ты забыл поставить <w>восклицательный знак</w> в конце этой команды.",
                                "zh": "你忘了在那条命令末尾加上<w>感叹号</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "bang",
                        "exclamation mark"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "computing context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Восклицательный знак.",
                        "zh": "感叹号。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "восклицательный знак",
                                "target_lang_sense_clarification": "знак препинания"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "感叹号",
                                "target_lang_sense_clarification": "标点符号“!”的常见说法"
                            },
                            {
                                "target_lang_word": "叹号",
                                "target_lang_sense_clarification": "较口语的简称"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}