                        ],
                        "examples": [
                            {
                                "example_id": "f8ff1534-aad8-475b-8d35-3ba688f2034b",
                                "sense_id": "56b98e58-880b-37b8-a9e1-8a791452de1c",
                                "text": "Schröder was met de Holsteiner ruin New Orleans een van de vier combinaties die in de barrage foutloos rondgingen. De Canadees Eric Lamaze en de Duitser Christian Ahlmann waren sneller dan de Tubberger."
                            },
                            {
                                "example_id": "3250358a-bebe-4055-bdf3-a85855c2845e",
                                "sense_id": "56b98e58-880b-37b8-a9e1-8a791452de1c",
                                "text": "Zo 'bestelde' de paardenminnende koningin Elizabeth bij haar bezoek aan Bonn in 1978 twee paarden: een bruine Holsteiner van 167 tot 169 centimeter (\"niet te licht, zeker niet te donker\") en een schimmel van 166 tot 168 centimeter (\"zo mogelijk wit, in elk geval niet vies grijs\"). Kosten: omgerekend 60.000 euro."
                            }
                        ]
