                        "glosses": [
                            "een kort dagbericht dat in de morgen uitgegeven wordt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8786470d-89ba-4499-bbf7-454b2c13c1c9",
                                "sense_id": "43b0e307-e22d-390b-822e-c9acbffdfe3c",
                                "text": "De ochtendbespreking gebeurt aan de hand van een schriftelijk ochtendbulletin waarin bijzonderheden vermeld staan, inclusief bijzondere aandachtspunten met betrekking tot individuele patiënten."
                            }
                        ]
                    },
                    {
                        "sense_id": "016ebde3-5794-36a0-8ab2-43900210a11f",
                        "entry_id": "1721fd72-59b5-3207-968e-46cf7dc1f124",
                        "glosses": [
                            "een nieuwsuitzending 's morgens"
                        ],
                        "tags": [
                            "media",
                            "radio, tv"
                        ],
                        "examples": [
                            {
                                "example_id": "bc15d2fd-bfd8-420a-9aec-9f4d64edff0d",
                                "sense_id": "016ebde3-5794-36a0-8ab2-43900210a11f",
                                "text": "De ochtendbulletins laten een mix zien van het laatste nieuws, het nieuws van de vorige avond, het belangrijkste sportnieuws en het weer voor de dag."
                            }
                        ]
                    }
                ],
