                {
                    "sense_id": "c15f2325-5775-3f0b-8967-ad80a354da7f",
                    "sense_definition": "At a later or succeeding time; after that.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "time_sequence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We went to the cinema and had dinner <w>afterwards</w>.",
                            "target_lang_translations": {
                                "ru": "Мы пошли в кино, а <w>потом</w> поужинали.",
                                "zh": "我们去看了电影，<w>然后</w>吃了晚饭。",
                                "pl": "Poszliśmy do kina, a <w>potem</w> zjedliśmy kolację."
                            }
                        },
                        {
                            "text": "She left the party, and he arrived shortly <w>afterwards</w>.",
                            "target_lang_translations": {
                                "ru": "Она ушла с вечеринки, а он приехал немного <w>позже</w>.",
                                "zh": "她离开了聚会，他没过多久就<w>后来</w>到了。",
                                "pl": "Wyszła z przyjęcia, a on przybył niedługo <w>później</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "afterward",
                        "subsequently",
                        "later",
                        "then"
                    ],
                    "antonyms": [
                        "beforehand"
                    ],
                    "common_phrases": [
                        "shortly afterwards",
                        "soon afterwards",
                        "immediately afterwards"
                    ],
                    "target_lang_definitions": {
                        "ru": "В более позднее время; после этого.",
                        "zh": "在之后的时间；此后。",
                        "pl": "W późniejszym czasie; po tym wydarzeniu."
                    },
