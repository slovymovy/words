                "senses": [
                    {
                        "sense_id": "56198bf6-d35e-3571-af32-b7b12990eff0",
                        "entry_id": "4dda8eec-2d8b-3416-b26d-a9b8927a5ca7",
                        "glosses": [
                            "Dinosaure de taille titanesque, membre du genre de dinosaure sauropode qui a vécu à la fin du Crétacé il y a environ de 83 à 65 millions d’années, entre le Campanien et le Maastrichtien."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e85b3dac-144f-407d-9c49-7fb8b91de7f3",
                                "sense_id": "56198bf6-d35e-3571-af32-b7b12990eff0",
                                "text": "Le titanosaure s’apparente plus à un genre de vache géante, un herbivore d’une quinzaine de mètres de long qui broutait paisiblement voici soixante- dix millions d’années."
                            },
                            {
                                "example_id": "b23fa4d2-df06-42ad-983f-96d7053e901d",
                                "sense_id": "56198bf6-d35e-3571-af32-b7b12990eff0",
                                "text": "Un titanosaure adulte est 2.500 fois plus lourd que son petit alors que chez l’éléphant Elephas maximus, ce rapport n’est que de 25."
                            },
                            {
                                "example_id": "bedb83f6-0d0e-4bd3-804b-6ae9214a9a60",
                                "sense_id": "56198bf6-d35e-3571-af32-b7b12990eff0",
                                "text": "Toutefois, les scientifiques notent que les larves de guêpes ont sans doute eu un rôle important dans la santé de la portée du titanosaure."
                            }
                        ]
                    }
                ],
