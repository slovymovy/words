                                    {
                                        "sense_id": "6c046292-09b2-3cc6-b228-ccaa998d8e36",
                                        "entry_id": "6a17dcda-9591-3bb9-9272-f79dbb88b3c9",
                                        "glosses": [
                                            "명사나 대명사에 붙여 장소를 나타내는 부사격 조사."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83421842-6e55-40d4-bf22-211279b7b729",
                                                "sense_id": "6c046292-09b2-3cc6-b228-ccaa998d8e36",
                                                "text": "사전에서 찾아보니까..."
                                            },
                                            {
                                                "example_id": "821891aa-8288-4a17-8555-aad047126641",
                                                "sense_id": "6c046292-09b2-3cc6-b228-ccaa998d8e36",
                                                "text": "집에서 낮잠 자다."
                                            },
                                            {
                                                "example_id": "68a94fda-0440-421f-8e6b-9046a64aa7f7",
                                                "sense_id": "6c046292-09b2-3cc6-b228-ccaa998d8e36",
                                                "text": "광명(光明)을 배반(背反)한 아득한 동굴(洞窟)에서/ 다 썩은 들보라 무너진 성채(城砦) 위 너 홀로 돌아다니는 / 가엾은 박쥐여! 어둠에 왕자(王者)여!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c5ab8a82-aa64-39a1-b524-afddac4e406c",
                                        "entry_id": "6a17dcda-9591-3bb9-9272-f79dbb88b3c9",
                                        "glosses": [
                                            "명사나 대명사에 붙여 출발점을 나타내는 부사격 조사."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ef0ac97-fcfc-405d-82cb-b22d4b1668a6",
                                                "sense_id": "c5ab8a82-aa64-39a1-b524-afddac4e406c",
                                                "text": "머리에서 발끝까지 훝어보다."
                                            },
                                            {
                                                "example_id": "807ae4fa-06bf-4489-affc-54f2fca617eb",
                                                "sense_id": "c5ab8a82-aa64-39a1-b524-afddac4e406c",
                                                "text": "오전에서 오후까지."
                                            },
                                            {
                                                "example_id": "44213197-3f0c-43e2-8036-84bab9a88201",
                                                "sense_id": "c5ab8a82-aa64-39a1-b524-afddac4e406c",
                                                "text": "집에서 학교까지 어떻게 가요？"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "32089b95-bb12-35cb-9309-129f757420ae",
                                        "entry_id": "6a17dcda-9591-3bb9-9272-f79dbb88b3c9",
                                        "glosses": [
                                            "명사나 대명사에 붙여 이유나 근거를 나타내는 부사격 조사."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8acb6c98-13bb-4701-88a8-3c401c7de857",
                                                "sense_id": "32089b95-bb12-35cb-9309-129f757420ae",
                                                "text": "하찮은 말에서 싸움이 벌어졌다."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8e787450-e490-3c13-881b-098ec8cabf2b",
                                        "entry_id": "6a17dcda-9591-3bb9-9272-f79dbb88b3c9",
                                        "glosses": [
                                            "명사나 대명사에 붙여 장소를 나타내며 그것을 주어로 만드는 주격 조사."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0eebd8f-2811-486a-9ef2-2d63b5470b8c",
                                                "sense_id": "8e787450-e490-3c13-881b-098ec8cabf2b",
                                                "text": "이웃 집에서 또 부부싸움을 하는 것 같다."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
