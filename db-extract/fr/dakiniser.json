                "senses": [
                    {
                        "sense_id": "6fccbb06-96aa-3521-88bb-e93870140f3a",
                        "entry_id": "8443d250-a0cb-324f-a88e-c80881e5ffd3",
                        "glosses": [
                            "Traiter au liquide de Dakin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d708ad35-743b-4e58-88c5-ab5f071cf232",
                                "sense_id": "6fccbb06-96aa-3521-88bb-e93870140f3a",
                                "text": "Mais il faut surveiller attentivement le blessé et savoir que, même dans, les cas favorables, il se produit presque toujours un épanchement qu'il faudra drainer et Dakiniser."
                            },
                            {
                                "example_id": "08498d01-586a-4010-a488-8c0ef2eda466",
                                "sense_id": "6fccbb06-96aa-3521-88bb-e93870140f3a",
                                "text": "le moignon de Lolo s'est bien cicatrisé, je n'ai plus besoin de dakiniser/eau oxygénéiser/bétadiniser/compressiser etc."
                            },
                            {
                                "example_id": "9adb080c-a791-4078-81fa-79e09027e6bc",
                                "sense_id": "6fccbb06-96aa-3521-88bb-e93870140f3a",
                                "text": "Dieu a des habitudes épouvantables, il boit le sang, il fouette les gens, il crache dans l'espace, il « dakinise », dieu de tonnerre, dieu d'amour..."
                            }
                        ]
                    }
