                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Instrumental case singular of the noun \"part\".",
                        "zh": "名词“部分”的工具格单数形式。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "part",
