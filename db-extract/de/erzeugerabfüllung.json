                "senses": [
                    {
                        "sense_id": "b52cd620-c1fa-3ad6-a53e-c5b980f8bb98",
                        "entry_id": "27c36569-b512-34ba-b382-8b2a93c21b39",
                        "glosses": [
                            "ein Wein, der direkt beim Erzeuger, im Idealfall beim Winzer, abgefüllt wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7687e7f1-2bff-4562-85e3-06fee63d0ef9",
                                "sense_id": "b52cd620-c1fa-3ad6-a53e-c5b980f8bb98",
                                "text": "Weinkenner präferieren normalerweise Erzeugerabfüllungen, da diese hinsichtlich der Verarbeitung als reiner und originärer gelten als andere Abfüllungsformen."
                            },
                            {
                                "example_id": "06c80e60-91c5-435e-bbc1-396f521222de",
                                "sense_id": "b52cd620-c1fa-3ad6-a53e-c5b980f8bb98",
                                "text": "„Baron Philippe de Rothschild (1902-1988) war es, der in den 1920er-Jahren für sein Château Mouton-Rothschild in Pauillac bei Bordeaux die Erzeugerabfüllung einführte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
