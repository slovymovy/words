                ],
                "senses": [
                    {
                        "sense_id": "2654b32e-d23c-34cb-b8d1-e9296e1760ec",
                        "entry_id": "ea9e2398-1e37-3328-99c6-6650f1d3894d",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df47f421-61f1-4c62-9baa-b0971a648c5a",
                                "sense_id": "2654b32e-d23c-34cb-b8d1-e9296e1760ec",
                                "text": "Frau Cantzler ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "7427827e-5e5e-4bb2-bbd7-92d506198be6",
                                "sense_id": "2654b32e-d23c-34cb-b8d1-e9296e1760ec",
                                "text": "Herr Cantzler wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "d9764b61-e70b-4c4c-8464-01b2970cb9e2",
                                "sense_id": "2654b32e-d23c-34cb-b8d1-e9296e1760ec",
                                "text": "Die Cantzlers fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "ab5cf466-1402-4087-a312-23655d80dd03",
                                "sense_id": "2654b32e-d23c-34cb-b8d1-e9296e1760ec",
                                "text": "Der Cantzler trägt nie die Schals, die die Cantzler ihm strickt."
                            },
                            {
                                "example_id": "31cfa868-eef5-4ee4-b73e-ba8f20a2fe48",
                                "sense_id": "2654b32e-d23c-34cb-b8d1-e9296e1760ec",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Cantzler kommt, geht der Herr Cantzler.“"
                            },
                            {
                                "example_id": "35115433-eb1d-4e37-8661-1603f56a54b5",
                                "sense_id": "2654b32e-d23c-34cb-b8d1-e9296e1760ec",
                                "text": "Cantzler kommt und geht."
                            },
                            {
                                "example_id": "b77251be-31bb-4bbf-800a-1e12f079022c",
                                "sense_id": "2654b32e-d23c-34cb-b8d1-e9296e1760ec",
                                "text": "Cantzlers kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
