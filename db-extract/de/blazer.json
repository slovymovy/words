                ],
                "senses": [
                    {
                        "sense_id": "285cf988-c5e4-3ccf-b9a9-011763cbccd1",
                        "entry_id": "6ce83799-1507-33de-a390-df4c1e7a8751",
                        "glosses": [
                            "meist blaue Klubjacke für Männer mit Abzeichen und Metallknöpfen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7cfcf572-ba1b-48d0-944d-014416a8a4e2",
                                "sense_id": "285cf988-c5e4-3ccf-b9a9-011763cbccd1",
                                "text": "„Zwei Kameramänner und zwei Tontechniker waren gekommen, und auch ein Ansager in grünem Blazer, auf dem auf der linken Brusttasche das WSOU-TV-Zeichen aufgestickt war.“"
                            },
                            {
                                "example_id": "2fec3556-f482-460e-8f55-8d0a23540b1a",
                                "sense_id": "285cf988-c5e4-3ccf-b9a9-011763cbccd1",
                                "text": "„Mit federndem Schritt ging er hinüber zum Flügel, knöpfte den Blazer auf und rückte die Klavierbank zurecht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a0c66b74-716f-33b9-9f90-f6710a6711d3",
                        "entry_id": "6ce83799-1507-33de-a390-df4c1e7a8751",
                        "glosses": [
                            "sportliches Jackett für Frauen und Männer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b49fb42-fd08-416d-a872-5d19a9fb91d8",
                                "sense_id": "a0c66b74-716f-33b9-9f90-f6710a6711d3",
                                "text": "„Mit federndem Schritt ging er hinüber zum Flügel, knöpfte den Blazer auf und rückte die Klavierbank zurecht.“"
                            },
                            {
                                "example_id": "364ceda4-2308-44da-b808-1da7844e588c",
                                "sense_id": "a0c66b74-716f-33b9-9f90-f6710a6711d3",
                                "text": "„Eine vielleicht sechzigjährige Frau mit einem strengen grauen Dutt, in einem schwarzen Blazer und Bleistiftrock blinzelte uns durch die riesigen Gläser ihrer roten Cat-Eye-Brille entgegen.“"
                            },
                            {
                                "example_id": "e60eb54a-8c58-48e4-807a-2e96a933840e",
                                "sense_id": "a0c66b74-716f-33b9-9f90-f6710a6711d3",
                                "text": "„Ich hatte den Blazer bei diesem Gespräch getragen, danach nie wieder, und jetzt hatte ich ihn wieder hervorgeholt, als ob darin eine Kraft läge, die beweisen könnte, dass auch in mir eine Chefredakteurin steckte.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
