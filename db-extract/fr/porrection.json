                                "example_id": "0e07f01a-1df0-4a64-a86a-5b4ceae5391e",
                                "sense_id": "44a6918b-131b-32ca-b78b-14ac2b713eee",
                                "text": "Et, durant l'hymne de porrection de la déesse et du dieu, nous demeurons immobiles, main dans la main."
                            }
                        ]
