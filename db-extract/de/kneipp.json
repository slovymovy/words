                ],
                "senses": [
                    {
                        "sense_id": "f6af42b4-374e-3a82-8602-6201aea138d1",
                        "entry_id": "68c1e860-791e-3d73-8f99-aca8959d5e05",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f92adabf-a197-4405-b3c6-7420d60500bb",
                                "sense_id": "f6af42b4-374e-3a82-8602-6201aea138d1",
                                "text": "Frau Kneipp ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "993afafd-175d-4c11-b41b-74d522e4a0d7",
                                "sense_id": "f6af42b4-374e-3a82-8602-6201aea138d1",
                                "text": "Herr Kneipp wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "961dc399-c398-476f-bc64-3e5892d6a962",
                                "sense_id": "f6af42b4-374e-3a82-8602-6201aea138d1",
                                "text": "Die Kneipps fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "c15796c1-7f58-4530-99cc-e6e935d4746b",
                                "sense_id": "f6af42b4-374e-3a82-8602-6201aea138d1",
                                "text": "Der Kneipp trägt nie die Schals, die die Kneipp ihm strickt."
                            },
                            {
                                "example_id": "f95ab090-fc52-478f-b883-47c9d2a885b8",
                                "sense_id": "f6af42b4-374e-3a82-8602-6201aea138d1",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Kneipp kommt, geht der Herr Kneipp.“"
                            },
                            {
                                "example_id": "f5321571-a666-4e9a-9fbf-9c68840f3848",
                                "sense_id": "f6af42b4-374e-3a82-8602-6201aea138d1",
                                "text": "Kneipp kommt und geht."
                            },
                            {
                                "example_id": "c8dd9528-523d-4afc-bf80-b8795d24a6d4",
                                "sense_id": "f6af42b4-374e-3a82-8602-6201aea138d1",
                                "text": "Kneipps kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
