    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f69169fb-597b-3588-b19a-05a89eb608ca",
                    "sense_definition": "Relatif à l'impressionnisme ou qui s'inspire de ce mouvement artistique.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "art",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le musée consacre une exposition temporaire à la peinture <w>impressionniste</w>."
                        },
                        {
                            "text": "Ce tableau utilise une technique résolument <w>impressionniste</w> pour représenter les reflets de l'eau."
                        }
                    ],
                    "common_phrases": [
                        "peinture impressionniste",
                        "mouvement impressionniste",
                        "style impressionniste"
                    ]
                },
                {
                    "sense_id": "be655ca8-0e7f-32c3-848a-173d0eb79136",
                    "sense_definition": "Qui se fonde sur l'impression subjective ou le ressenti personnel plutôt que sur une analyse raisonnée.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "subjectivité",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le critique a rédigé une chronique <w>impressionniste</w> basée sur ses seules émotions."
                        },
                        {
                            "text": "Ce récit de voyage propose une vision <w>impressionniste</w> des paysages traversés."
                        }
                    ],
                    "synonyms": [
                        "intuitif",
                        "subjectif"
                    ],
                    "antonyms": [
                        "objectif",
                        "rationnel"
                    ],
                    "common_phrases": [
                        "critique impressionniste",
                        "touche impressionniste"
                    ]
                },
                {
                    "sense_id": "9a715628-17e2-3fe7-9479-e1c63d18f0fb",
                    "sense_definition": "Qui manque de rigueur méthodologique, vague ou approximatif.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "subjectivité",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La commission a regretté l'évaluation trop <w>impressionniste</w> des résultats du projet."
                        },
                        {
                            "text": "Une gestion financière ne peut pas reposer sur une démarche <w>impressionniste</w> sans indicateurs précis."
                        }
                    ],
                    "synonyms": [
                        "approximatif",
                        "flou"
                    ],
                    "antonyms": [
                        "méthodique",
                        "rigoureux"
                    ],
                    "common_phrases": [
                        "approche impressionniste",
                        "lecture impressionniste"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e2d14066-494a-301d-a1b9-ea92111aca6b",
                    "sense_definition": "Artiste, en particulier peintre de la fin du XIXᵉ siècle, adepte de l'impressionnisme.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "art",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Claude Monet est l'<w>impressionniste</w> dont les toiles attirent le plus de visiteurs à Paris."
                        },
                        {
                            "text": "Les <w>impressionnistes</w> ont profondément renouvelé l'art de peindre la lumière au dix-neuvième siècle."
                        }
                    ]
                }
            ]
        }
    ]
