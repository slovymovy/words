        "fr-extract.jsonl": [
            {
                "entry_id": "22c8db29-4889-366c-917f-fbe4997c58df",
                "word": "chatouillement",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "89fbce74-b88a-4fbd-889f-e54384ba3e0a",
                        "entry_id": "22c8db29-4889-366c-917f-fbe4997c58df",
                        "tags": [
                            "plural"
                        ],
                        "form": "chatouillements"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e8923211-87d4-36d5-8a08-8fe54d781e83",
                        "entry_id": "22c8db29-4889-366c-917f-fbe4997c58df",
                        "glosses": [
                            "Action de chatouiller ou résultat de cette action."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "02c1fdfa-2de4-45a2-bb66-4f20f5ae193a",
                                "sense_id": "e8923211-87d4-36d5-8a08-8fe54d781e83",
                                "text": "à chaque voyage de l'insecte un rire fou jaillissait; et, lorsque le vieux, ennuyé par ce chatouillement, murmura: « Elle est bougrement obstinée », Jeanne et le vicomte se mirent à pleurer de gaieté, se tordant, étouffant, la serviette sur la bouche pour ne pas crier."
                            },
                            {
                                "example_id": "cb4c479d-9774-41fe-be12-fa693e0456f2",
                                "sense_id": "e8923211-87d4-36d5-8a08-8fe54d781e83",
                                "text": "Être sensible au moindre chatouillement. Le chatouillement excite ordinairement à rire."
                            },
                            {
                                "example_id": "d53ccef8-4082-4b07-b82b-ec784af537b4",
                                "sense_id": "e8923211-87d4-36d5-8a08-8fe54d781e83",
                                "text": "Et toute la journée du lendemain ses boutons de la nuit le démangèrent, tandis que des chatouillements neufs l’avertissaient qu’il était toujours fréquenté."
                            }
                        ]
                    },
                    {
                        "sense_id": "b100b8ea-2a16-3fdb-a018-50faef72c67e",
                        "entry_id": "22c8db29-4889-366c-917f-fbe4997c58df",
                        "glosses": [
                            "Certaines impressions agréables que reçoivent les sens."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "bbf60099-e85f-48af-9267-55b9522c3f96",
                                "sense_id": "b100b8ea-2a16-3fdb-a018-50faef72c67e",
                                "text": "Cette harmonie cause à l’oreille un doux chatouillement."
                            }
                        ]
                    },
                    {
                        "sense_id": "c7304146-5202-309d-be78-7bfc4089735e",
                        "entry_id": "22c8db29-4889-366c-917f-fbe4997c58df",
                        "glosses": [
                            "Picotement qui se produit dans une partie du corps."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "54b03d1c-eb21-4484-9a1d-38e671abf968",
                                "sense_id": "c7304146-5202-309d-be78-7bfc4089735e",
                                "text": "Chatouillement de la gorge."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bf1a9500-766f-4c59-b4c9-4919e8a52bb8",
                        "source_entry_id": "22c8db29-4889-366c-917f-fbe4997c58df",
                        "source_sense_description": "Action de chatouiller ou résultat de cette action",
