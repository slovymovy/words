                                "target_word": "clair-obscur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8f2d3539-c75e-3119-a981-d6869e1d5763",
                                        "entry_id": "6a0b2d48-2b5a-39ff-80e3-5363d4a00c52",
                                        "glosses": [
                                            "Une espèce d’insecte lépidoptère (papillon) de nuit de la famille des noctuidés (Noctuidae), cosmopolite."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2631c6b-487d-477d-90a7-c42783906119",
                                                "sense_id": "8f2d3539-c75e-3119-a981-d6869e1d5763",
                                                "text": "La chenille du clair-obscur se nourrit sur des liserons et des ipomées dont la patate douce."
                                            }
