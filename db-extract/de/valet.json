                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d7730612-1333-3ef8-90b4-65b70e013005",
                                        "entry_id": "a7c047f2-b168-36e4-b93d-2cde5a01d1c6",
                                        "glosses": [
                                            "Jeune écuyer au service d’un seigneur."
                                        ],
                                        "tags": [
                                            "literally"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2deac491-a6c1-344b-a071-b1fd2995a801",
                                        "entry_id": "a7c047f2-b168-36e4-b93d-2cde5a01d1c6",
                                        "glosses": [
                                            "Dénomination des domestiques et serviteurs qui tenaient certains offices dans la maison (du roi et dans celles des princes, des nobles…) dans une ferme ou dans la société civile dont seules quelques dénominations sont encore en usage. (voir dérivés fonctions)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "095dcd06-89c6-4a86-b254-f597c72fe412",
                                                "sense_id": "2deac491-a6c1-344b-a071-b1fd2995a801",
                                                "text": "Aussi, à peine le comte Karl eut-il mis pied à terre, qu’une troupe de valets et de serviteurs se présenta pour s’emparer de son cheval et le conduire dans les écuries."
                                            },
                                            {
                                                "example_id": "1fca0eef-14da-4c47-9919-0cf12c687dad",
                                                "sense_id": "2deac491-a6c1-344b-a071-b1fd2995a801",
                                                "text": "Sa gaieté, quand il m’avait vu lui donnant débonnairement une somme si énorme, me parut alors être la joie des valets de théâtre attrapant quelque Géronte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "56e9dfa0-66b7-3f31-8d11-d8fb4acd0612",
                                        "entry_id": "a7c047f2-b168-36e4-b93d-2cde5a01d1c6",
                                        "glosses": [
                                            "Carte sur laquelle est peinte la figure d’un page ou valet, et qui existe dans chacune des quatre couleurs d’un jeu."
                                        ],
                                        "tags": [
                                            "Cartes à jouer"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6870b32f-f8bf-4d5d-ba4b-43eb51b3b7ef",
                                                "sense_id": "56e9dfa0-66b7-3f31-8d11-d8fb4acd0612",
                                                "text": "Valet de cœur, de carreau, de pique, de trèfle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b0ea8486-ee7f-39f7-ac6a-6396eb44e6a2",
                                        "entry_id": "a7c047f2-b168-36e4-b93d-2cde5a01d1c6",
                                        "glosses": [
                                            "Désigne certains outils, accessoires ou organes mécaniques qui font la fonction d'un serviteur ou d'une aide."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7e118c12-cf7e-3247-8197-6b93f85a5ee2",
                                        "entry_id": "a7c047f2-b168-36e4-b93d-2cde5a01d1c6",
                                        "glosses": [
                                            "Instrument de fer coudé qui sert à immobiliser sur l'établi la pièce de bois que l’on travaille."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63e253b2-fa74-49c7-868d-e2a9a8ed2ce7",
                                                "sense_id": "7e118c12-cf7e-3247-8197-6b93f85a5ee2",
                                                "text": "Toute la bile que j’amassais depuis une heure me sauta à la figure… J’agrippe le valet de l’établi et je cogne…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b21e7320-50a2-379c-8900-2ac3f876e3e8",
                                        "entry_id": "a7c047f2-b168-36e4-b93d-2cde5a01d1c6",
                                        "glosses": [
                                            "Anneau de bois ou de paille tressée qui permet de déposer en équilibre un vase à fond bombé."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1d4a1214-8a41-3011-91b3-32b9fdc67b0d",
                                        "entry_id": "a7c047f2-b168-36e4-b93d-2cde5a01d1c6",
                                        "glosses": [
                                            "Contrepoids placé derrière une porte pour la faire se fermer seule."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1abd672f-9369-3cc3-8afa-9e3cb4873a37",
                                        "entry_id": "a7c047f2-b168-36e4-b93d-2cde5a01d1c6",
                                        "glosses": [
                                            "Petit support, appui, derrière un miroir portatif."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e0faa58c-5964-344f-9d7c-dd85fa0a30bb",
                                        "entry_id": "a7c047f2-b168-36e4-b93d-2cde5a01d1c6",
                                        "glosses": [
                                            "Peloton de fil caret qui retenait la charge dans le canon."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b90a58be-d5bc-35b0-a753-21c6e991e936",
                                        "entry_id": "a7c047f2-b168-36e4-b93d-2cde5a01d1c6",
                                        "glosses": [
                                            "Désigne quelqu’un de servile et dévoué à un homme, à une cause… ou à des avantages pécuniers."
                                        ],
                                        "tags": [
                                            "analogy",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "823e8a21-7e2f-484c-a485-23d1d7b2cb99",
                                                "sense_id": "b90a58be-d5bc-35b0-a753-21c6e991e936",
                                                "text": "Valets des impérialistes."
                                            },
                                            {
                                                "example_id": "831fb1e0-9482-4671-8c4f-d9ece502fb33",
                                                "sense_id": "b90a58be-d5bc-35b0-a753-21c6e991e936",
                                                "text": "C'est un vrai valet, toujours prêt à gagner quelque monnaie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8b68ed43-eaf6-34cb-b5a4-672da199fe4a",
                                        "entry_id": "a7c047f2-b168-36e4-b93d-2cde5a01d1c6",
                                        "glosses": [
                                            "Pièce de mobilier utilisée pour déposer ses vêtements, la nuit."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b1dd8fd5-16a6-4b88-8d5a-4417e8835998",
                                                "sense_id": "8b68ed43-eaf6-34cb-b5a4-672da199fe4a",
                                                "text": "Valet de chambre, valet de nuit, valet pliant"
                                            },
                                            {
                                                "example_id": "ca6084f2-4afa-4948-96fe-c281d7050959",
                                                "sense_id": "8b68ed43-eaf6-34cb-b5a4-672da199fe4a",
                                                "text": "À gauche, une vieille armoire de chêne et deux valets de bois et de cuivre feraient face à un petit fauteuil crapaud tendu d’une soie grise finement rayée et à une coiffeuse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "13cd4588-c1da-321b-98b9-02588c2caf26",
                                        "entry_id": "a7c047f2-b168-36e4-b93d-2cde5a01d1c6",
                                        "glosses": [
                                            "(Suisse) Le fils."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
