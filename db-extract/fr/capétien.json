                "translations": [
                    {
                        "translation_id": "fbc4df3b-9fbb-41c2-82fc-c9824219ebb9",
                        "source_entry_id": "3c460f40-fc24-3478-acf2-f44a422d280e",
                        "source_sense_id": "375ba38a-841a-3f55-8dc4-a9bd66474394",
                        "target_lang_word": "Capetian",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Capetian",
