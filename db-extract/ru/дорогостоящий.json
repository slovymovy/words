                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c32070a-5c4b-4c4e-8b39-a02af25bea33",
                                                "sense_id": "5079520c-ac57-34b2-8501-3ca8a408790c",
                                                "text": "Das Anerkennungsverfahren für meine Zusatzausbildung gehört zu den aufwendigsten, die ich jemals mitgemacht habe."
                                            },
                                            {
                                                "example_id": "7e2dca41-6607-4f7f-b0ac-35236915e1f1",
                                                "sense_id": "5079520c-ac57-34b2-8501-3ca8a408790c",
                                                "text": "Der Heimatverein hat eine aufwendig bebilderte Fotodokumentation herausgegeben."
                                            },
                                            {
                                                "example_id": "125f9329-1455-4e59-a247-fecf05eda179",
                                                "sense_id": "5079520c-ac57-34b2-8501-3ca8a408790c",
                                                "text": "„Bei Sichtweiten von nur wenigen Metern begann […] ein aufwendiger Einsatz von Bodenkräften, zudem kreiste ein Hubschrauber konstant über dem Berg, um die beiden bei einer Wolkenlücke sofort mit einer Winde an Bord holen zu können.“"
                                            },
                                            {
                                                "example_id": "03883117-9800-4d5d-ae11-6a1887589532",
                                                "sense_id": "5079520c-ac57-34b2-8501-3ca8a408790c",
                                                "text": "Für den Kongress sind aufwendige Vorbereitungen erforderlich."
                                            },
                                            {
                                                "example_id": "2359103d-d6b9-4edc-800f-c52461ecf714",
                                                "sense_id": "5079520c-ac57-34b2-8501-3ca8a408790c",
                                                "text": "Am Wochenende hatte die neue, aufwendige Inszenierung der Zauberflöte Premiere."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5ed68b4d-29fe-3b26-a354-97c08ddfba86",
                                        "entry_id": "98a868ab-9215-31ea-b56d-afa647399f95",
                                        "glosses": [
                                            "mit hohen Ausgaben verbunden"
                                        ],
                                        "tags": [],
