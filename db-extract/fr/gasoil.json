                                        "glosses": [
                                            "A vehicle powered by a diesel engine."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0a7ddfb1-71d8-48ea-9990-97c144aa8c4c",
                                                "sense_id": "de2a566c-d756-3061-be2c-ba0890c0c16a",
                                                "text": "His next truck will be a diesel."
                                            },
                                            {
                                                "example_id": "5b5cbf29-16fc-48b4-b09b-84122ceed9f2",
                                                "sense_id": "de2a566c-d756-3061-be2c-ba0890c0c16a",
                                                "text": "1959, Steam's Finest Hour, edited by David P. Morgan, Kalmbach Publishing Co., referring to Mexico's last new steam locomotives.\nTheir effective service life was cut short by an almost simultaneous switch to diesels - a circumstance shared with many an engine north of the border."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b785405-9759-3bac-a1a2-8ff23d4d2265",
                                        "entry_id": "d5c9f971-0c3f-36fd-9139-fd9d06b80f3e",
