                "senses": [
                    {
                        "sense_id": "062f6025-3131-32e9-810e-f1189e5b3f0a",
                        "entry_id": "d397abab-a9f7-34b1-99e7-c2e984b85520",
                        "glosses": [
                            "Qui est orné ou bordé de galon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "24f431f2-dd2b-438d-aa33-aaaf5d64b609",
                                "sense_id": "062f6025-3131-32e9-810e-f1189e5b3f0a",
                                "text": "Un chapeau galonné."
                            },
                            {
                                "example_id": "5b7a9bd1-1684-4f01-bf27-c3b7aae48e9e",
                                "sense_id": "062f6025-3131-32e9-810e-f1189e5b3f0a",
                                "text": "Alain disait vrai. On voyait briller en haut de la falaise les bicornes galonnés."
                            },
                            {
                                "example_id": "a22ce3ff-dc06-4a93-abde-c72dd2c9362c",
                                "sense_id": "062f6025-3131-32e9-810e-f1189e5b3f0a",
                                "text": "Tout de même, quand on s’adressait à lui, il y avait une nuance de considération et de respect, le respect un peu méfiant qu’ont les simples pour les représentants de l’autorité, pour ceux qui portent des képis galonnés, et des plaques, sur leur blouse."
                            },
                            {
                                "example_id": "62774803-0cbc-4ab3-b9dd-4a1c6c158768",
                                "sense_id": "062f6025-3131-32e9-810e-f1189e5b3f0a",
                                "text": "Herbillon s’admirait dans la glace ovale, galonnée de vieil argent, lorsque le rythme d’un pas vif lui serra le cœur."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
