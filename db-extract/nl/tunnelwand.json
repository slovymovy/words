                        "examples": [
                            {
                                "example_id": "0f5a51b3-d761-48b6-9afd-989c0ac2343a",
                                "sense_id": "f97caa43-2f58-3036-9202-fbdbbfaf6508",
                                "text": "Tunnelwand: De bus verongelukte gisteravond op de terugweg naar België, na een skivakantie in le Val d' Anniviers. In een tunnel op de snelweg A9 bij Sierre, in kanton Wallis botste de bus bij een noodparkeerplaats met hoge snelheid frontaal tegen de linkerwand van de tunnel. Er waren geen andere voertuigen bij betrokken."
                            },
                            {
                                "example_id": "20e93c8c-45d9-400a-bbc9-8ca174337ecb",
                                "sense_id": "f97caa43-2f58-3036-9202-fbdbbfaf6508",
                                "text": "In de Schipholtunnel zijn twee rijstroken in de richting van Amsterdam afgesloten vanwege ijspilaren die afgelopen weekend zijn ontstaan. Door een lekkage aan de tunnelwand druppelt er water van het plafond naar het wegdek. Dat water is bevroren waardoor lange pilaren van ijs zijn gevormd."
                            }
                        ]
