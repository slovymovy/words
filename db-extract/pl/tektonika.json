                        "cross_references": [
                            {
                                "target_word": "tectónica",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "9e87fd37-2313-314a-b4ed-3d21fccc51b0",
                                        "entry_id": "488487c5-0647-34d1-92f6-5d16c48e493b",
                                        "glosses": [
                                            "Ciencia que estudia la estructura de la corteza terrestre a partir del conjunto de procesos (plegamientos, fracturas, y fenómenos magmáticos), que modifican dicha corteza ."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6d01c134-f6ff-40f6-a22f-30cf0754bb5b",
                        "source_entry_id": "97116487-dfa5-30fe-9b93-60611a23e302",
                        "source_sense_id": "2b98a58c-7d96-3cea-91bc-6e543e7927c8",
                        "target_lang_word": "Tektonik",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tektonik",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6f02143a-2293-3738-abc1-1abfbfb31039",
                                        "entry_id": "31f28f34-95f8-303d-8d5b-5cabe5aae1ce",
                                        "glosses": [
                                            "die Lehre vom Aufbau der Erdkruste in ihrer Struktur und großräumigen Bewegung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8ccbc2a-92fa-46c3-8f30-d6223e0c11b0",
                                                "sense_id": "6f02143a-2293-3738-abc1-1abfbfb31039",
                                                "text": "Wie oben angeführt bilden die Ergebnisse der conodontenstratigraphischen Untersuchungen die Grundlage für eine gesicherte Tektonik der Lagerstätte."
                                            },
                                            {
                                                "example_id": "aa96de09-8a5a-4ef1-8010-cb70e711c934",
                                                "sense_id": "6f02143a-2293-3738-abc1-1abfbfb31039",
                                                "text": "„Die Geologie ist demnach eine beschreibend-erklärende, im wesentlichen jedoch eine historische Wissenschaft, die folgendermaßen gegliedert werden kann: 1) allgemeine oder dynamische Geologie […] 2) Tektonik […] 3) historische Geologie […] 4) Paläogeographie […] 5) Paläoklimatologie […].“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7c813634-5b04-3ed0-ac21-44d66d96fcdc",
                                        "entry_id": "31f28f34-95f8-303d-8d5b-5cabe5aae1ce",
                                        "glosses": [
                                            "die Lehre vom Zusammensetzen eines harmonischen Ganzen aus einzelnem"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "226091d8-e4f3-4f27-94d7-6cb9cc0e949d",
                                                "sense_id": "7c813634-5b04-3ed0-ac21-44d66d96fcdc",
                                                "text": "Gute Architektur basiert immer auf dem harmonischen Zusammenspiel von Tektonik und Ornamentik."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "c8c18f8c-10a6-318c-a7d5-270d90df9491",
                                        "entry_id": "31f28f34-95f8-303d-8d5b-5cabe5aae1ce",
                                        "glosses": [
                                            "Verbindung von Architektur und Malerei"
                                        ],
                                        "tags": [
                                            "Bildende Kunst"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3a544dc5-dae9-4f87-92d2-e8c29c0d61f7",
                                                "sense_id": "c8c18f8c-10a6-318c-a7d5-270d90df9491",
                                                "text": "Der Begriff der Tektonik - der im Kontext der bildenden Kunst zumeist auf seine metaphorische Bedeutung reduziert wird - gewinnt so seine ursprüngliche Bedeutung zurück."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "0a9045ce-a302-3754-8a79-034c68aaf6ac",
                                        "entry_id": "31f28f34-95f8-303d-8d5b-5cabe5aae1ce",
                                        "glosses": [
                                            "Aufbau eines Gedichts"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1362be82-fda0-453e-9bb2-0d1e8b2f9fe8",
                                                "sense_id": "0a9045ce-a302-3754-8a79-034c68aaf6ac",
                                                "text": "In den vorher analysierten Gedichten hatte Britting seine Eindrücke und Einfälle sehr viel stärker in Klang, Rhythmus und eine ebenso sinnfällige wie kunstvolle Tektonik des Inhalts umgesetzt."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "29bb769f-0db8-3586-bc94-c680cdd44155",
                                        "entry_id": "31f28f34-95f8-303d-8d5b-5cabe5aae1ce",
                                        "glosses": [
                                            "Gliederung eines Archivs"
                                        ],
                                        "tags": [
                                            "Archivwesen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8a6a19b1-9d86-4ad7-951d-9f46197ba4cc",
                                                "sense_id": "29bb769f-0db8-3586-bc94-c680cdd44155",
                                                "text": "Der Inhalt des Archivinformationssystems kann wahlweise über die Tektonik (hierarchische Gliederung) per Mausklick durchstöbert oder durch Eingabe von Suchbegriffen durchsucht werden."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
