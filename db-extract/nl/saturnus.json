                                            {
                                                "example_id": "ab64f8a0-2bbb-44c9-b16e-66bc9afa4cd3",
                                                "sense_id": "fe054489-660e-3077-b58c-e455a31c8c6c",
                                                "text": "Saturn promised us no-haggle purchasing and no-dent body panels."
                                            }
