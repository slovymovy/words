                                    },
                                    {
                                        "sense_id": "3a947460-3e35-39ed-815f-6d6d8dff1304",
                                        "entry_id": "79d9cc43-98b9-3852-80db-55cd67ad717d",
                                        "glosses": [
                                            "Homme chargé de la préparation physique, technique, tactique et mentale d’un sportif, d’une sportive ou d’une équipe sportive."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f5736d9d-7ff9-4bf4-843d-481b25b12781",
                                                "sense_id": "3a947460-3e35-39ed-815f-6d6d8dff1304",
                                                "text": "Selon cet entraineur, il importe de changer l’ambiance avant et après les matches. Excités par les entraineurs, les juniors pensent trop à gagner et pas assez à jouer pour le plaisir."
                                            },
                                            {
                                                "example_id": "654dc0c7-3ea1-4cbc-80f1-3bf8532dbc71",
                                                "sense_id": "3a947460-3e35-39ed-815f-6d6d8dff1304",
                                                "text": "Espérons que cette branlée mémorable aura au moins le mérite de remettre en cause quelques certitudes chez nos chers entraineurs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4845c4c6-5ed1-3e92-999c-b11227e601eb",
                                        "entry_id": "79d9cc43-98b9-3852-80db-55cd67ad717d",
                                        "glosses": [
                                            "femme qui entraine une équipe sportive."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "65e8d77c-9a20-4e94-ae43-13887e5147d7",
                                                "sense_id": "4845c4c6-5ed1-3e92-999c-b11227e601eb",
                                                "text": "… j'étais justement en train de faire pousser une femme, entraîneur sportif de profession... véridique !"
                                            }
                                        ]
                                    }
                                ]
                            }
