                ],
                "senses": [
                    {
                        "sense_id": "d76eab3b-9ae4-3723-ad34-b0e81115bee3",
                        "entry_id": "aa4c72c1-a04a-3a7c-9c0b-6b0e4c2fc31d",
                        "glosses": [
                            "Sitzgelegenheit für mehrere Personen in einer Grünanlage, Bank in einem Park"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc774b94-c1d7-42c2-b684-25dc921923f3",
                                "sense_id": "d76eab3b-9ae4-3723-ad34-b0e81115bee3",
                                "text": "Bei schönem Wetter sitze ich gerne auf einer Parkbank und sonne mich."
                            },
                            {
                                "example_id": "bb5715e5-e40c-412b-88b7-b7b2bb8c8b37",
                                "sense_id": "d76eab3b-9ae4-3723-ad34-b0e81115bee3",
                                "text": "„Auf diesen Satz hin, den er in Wien von einer alten Frau auf einer Parkbank völlig zusammenhanglos aufgeschnappt habe, sei das ganze Stück geschrieben.“"
                            },
                            {
                                "example_id": "17cb40b8-8c2b-43bd-8a4e-80c09e61aebd",
                                "sense_id": "d76eab3b-9ae4-3723-ad34-b0e81115bee3",
                                "text": "„Ein alter Herr unterhält sich auf der Parkbank mit einer älteren Dame über seine verschiedenen Zipperlein.“"
                            },
                            {
                                "example_id": "2459b631-e500-4625-832e-7a799273a4fe",
                                "sense_id": "d76eab3b-9ae4-3723-ad34-b0e81115bee3",
                                "text": "„Kurz dahinter hatte die Promenade eine Ausbuchtung, auf der sich mehrere Parkbänke mit Blick aufs Wasser befanden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
