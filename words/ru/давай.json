{
    "word_family": [
        "давать",
        "отдавать",
        "раздавать",
        "передавать",
        "выдавать",
        "подавать"
    ],
    "entries": [
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "a980c7ae-5a5d-3c7f-8c4a-538d6ef199de",
                    "sense_definition": "Используется для побуждения к совместному действию.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "pobuzhdenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Давай</w> вместе почитаем интересную книгу.",
                            "target_lang_translations": {
                                "en": "<w>Let's</w> read an interesting book together."
                            }
                        },
                        {
                            "text": "<w>Давай</w> сходим сегодня в кино вечером.",
                            "target_lang_translations": {
                                "en": "<w>Let's</w> go to the cinema this evening."
                            }
                        }
                    ],
                    "common_phrases": [
                        "давай сделаем",
                        "давай пойдем"
                    ],
                    "target_lang_definitions": {
                        "en": "Used to encourage someone to join in a shared action or to suggest doing something together."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "let's",
                                "target_lang_sense_clarification": "Used to propose a joint action."
                            },
                            {
                                "target_lang_word": "come on",
                                "target_lang_sense_clarification": "Used as an informal encouragement to start an activity."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "da0e0eb6-324f-32f7-ad72-918486fed244",
                    "sense_definition": "Разговорное выражение при прощании.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "proshanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ну всё, <w>давай</w>, увидимся завтра утром.",
                            "target_lang_translations": {
                                "en": "Right, <w>take care</w>, see you tomorrow morning."
                            }
                        },
                        {
                            "text": "Мне пора идти, <w>давай</w>, до связи.",
                            "target_lang_translations": {
                                "en": "I have to go, <w>bye</w>, talk to you later."
                            }
                        }
                    ],
                    "synonyms": [
                        "пока",
                        "до встречи"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "разговорное"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A colloquial expression used when saying goodbye."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "take care",
                                "target_lang_sense_clarification": "A common, friendly way to say goodbye."
                            },
                            {
                                "target_lang_word": "bye",
                                "target_lang_sense_clarification": "A standard, informal farewell."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3508655c-67f4-3921-a904-165470bf6bfa",
                    "sense_definition": "Разговорное выражение для подтверждения согласия или договорённости.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "soglasie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "— Встретимся в парке в пять? — <w>Давай</w>, я буду ждать.",
                            "target_lang_translations": {
                                "en": "— Shall we meet in the park at five? — <w>Sure</w>, I'll be waiting."
                            }
                        },
                        {
                            "text": "— Купишь хлеба по дороге? — <w>Давай</w>, без проблем.",
                            "target_lang_translations": {
                                "en": "— Will you buy some bread on the way? — <w>Okay</w>, no problem."
                            }
                        }
                    ],
                    "synonyms": [
                        "договорились"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "разговорное"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A colloquial expression used to confirm agreement or accept a proposal."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sure",
                                "target_lang_sense_clarification": "Used to express agreement or willingness."
                            },
                            {
                                "target_lang_word": "okay",
                                "target_lang_sense_clarification": "Used to confirm an arrangement or agreement."
                            },
                            {
                                "target_lang_word": "deal",
                                "target_lang_sense_clarification": "Used to confirm a mutual agreement or bargain."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "929f1ce2-dac2-346c-8f42-e86cdf34cb14",
                    "sense_definition": "Форма второго лица единственного числа повелительного наклонения глагола <w>давать</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "grammatika",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Пожалуйста, <w>давай</w> мне книгу каждый раз после прочтения.",
                            "target_lang_translations": {
                                "en": "Please <w>give</w> me the book every time after you finish reading it."
                            }
                        },
                        {
                            "text": "Не <w>давай</w> собаке сладкое, это вредно для неё.",
                            "target_lang_translations": {
                                "en": "Do not <w>give</w> the dog anything sweet, it is harmful to her."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "грамматическая форма"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The second-person singular imperative form of the verb 'to give'."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "give",
                                "target_lang_sense_clarification": "The base form of the verb used to command or request someone to hand something over."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}