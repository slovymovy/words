                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mijn vader <w>doet</w> elke zaterdag de boodschappen voor de hele week.",
                            "target_lang_translations": {
                                "ru": "Мой отец <w>делает</w> покупки на всю неделю каждую субботу.",
                                "en": "My father <w>does</w> the shopping for the whole week every Saturday.",
                                "zh": "我父亲每周六都会<w>做</w>好这一周的采购。",
