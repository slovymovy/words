                                    {
                                        "sense_id": "45b1acd8-3136-3303-829d-1d3127a3f7a9",
                                        "entry_id": "b780e6b6-257a-37ad-b150-88bf8de50999",
                                        "glosses": [
                                            "And; sum of the previous one and the following one."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a760b3fb-40b4-404a-b64f-586180465c93",
                                                "sense_id": "45b1acd8-3136-3303-829d-1d3127a3f7a9",
                                                "text": "Two plus two equals four."
                                            },
                                            {
                                                "example_id": "5915dd94-eb0f-4179-b00b-41c356ecb834",
                                                "sense_id": "45b1acd8-3136-3303-829d-1d3127a3f7a9",
                                                "text": "A water molecule is made up of two hydrogen atoms plus one of oxygen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d243be61-31a0-3990-a437-4afdca07557e",
                                        "entry_id": "b780e6b6-257a-37ad-b150-88bf8de50999",
                                        "glosses": [
                                            "With; having in addition."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6cc155b4-9643-463a-89da-5e09c8832724",
                                                "sense_id": "d243be61-31a0-3990-a437-4afdca07557e",
                                                "text": "I've won a holiday to France plus five hundred euros in spending money!"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "plus",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "83f910ca-11d5-3335-90d0-5c0cf232a0ee",
                                        "entry_id": "bab23aa9-9ab9-30c4-b603-f45b1adb237c",
                                        "glosses": [
                                            "And also; in addition; besides (which)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8f33034-4418-483d-97ec-e44ab39c6f22",
                                                "sense_id": "83f910ca-11d5-3335-90d0-5c0cf232a0ee",
                                                "text": "Let's go home now. It's late, plus I'm not feeling too well."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "plus",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f3dab151-3173-31b6-afb7-bbb7812e6c9d",
                                        "entry_id": "5b7e9f52-6d7c-3bab-8568-5d5b582bd2b9",
                                        "glosses": [
                                            "A positive quantity."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30ac3dc7-b6fe-4d6b-8b8f-746e351153e0",
                                                "sense_id": "f3dab151-3173-31b6-afb7-bbb7812e6c9d",
                                                "text": "But the pluses far outweigh the criticisms."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "976c2fec-8368-36ac-929c-159f51e5690f",
                                        "entry_id": "5b7e9f52-6d7c-3bab-8568-5d5b582bd2b9",
                                        "glosses": [
                                            "An asset or useful addition."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "083e068d-9f5d-4db1-bdfa-0e6cf17e74b9",
                                                "sense_id": "976c2fec-8368-36ac-929c-159f51e5690f",
                                                "text": "He is a real plus to the team."
                                            },
                                            {
                                                "example_id": "7f421f8f-fae6-4e83-aa6c-800ccac6a827",
                                                "sense_id": "976c2fec-8368-36ac-929c-159f51e5690f",
                                                "text": "Look at Trife. He's got two felonies. That means he's finished in society. But he can rap. His two felonies, in rap, man, that's a plus."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "da7e5fcc-d00e-3491-a503-92c11a56a992",
                                        "entry_id": "5b7e9f52-6d7c-3bab-8568-5d5b582bd2b9",
                                        "glosses": [
                                            "A plus sign: +."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dbbcf720-8f15-3e64-858e-3d4ecb227fb6",
                                        "entry_id": "5b7e9f52-6d7c-3bab-8568-5d5b582bd2b9",
                                        "glosses": [
                                            "Abbreviation of LGBT+"
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "plus",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "80116854-c9e0-3da3-b368-9d2fd471b0f6",
                                        "entry_id": "cdbb440c-f747-317c-940a-dd824b0042cd",
