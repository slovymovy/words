                "senses": [
                    {
                        "sense_id": "6b980fdb-75d0-3fd0-8a7e-6e3038837e68",
                        "entry_id": "ea14f0df-6792-3fe5-a6d0-938537927a68",
                        "glosses": [
                            "uit het diepst van je gemoed gemeend,"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c1fc9e35-21c2-4ecc-9e39-0ac6af5d7dd6",
                                "sense_id": "6b980fdb-75d0-3fd0-8a7e-6e3038837e68",
                                "text": "Ik heb een hartgrondige hekel aan wiskunde."
                            },
                            {
                                "example_id": "c6aaa5f8-7353-497f-9d83-5e1b8232edb2",
                                "sense_id": "6b980fdb-75d0-3fd0-8a7e-6e3038837e68",
                                "text": "De Birò is nog minder gewenst dan de fatbike en bierfiets bij elkaar opgeteld. De enige goede eigenschap is dat het afzichtelijke mormel op wieltjes alle andere verkeersdeelnemers, van voetganger tot truckchauffeur, weet te verenigen in een gezamenlijke afkeer: eindelijk iets waar ze het hartgrondig wél over eens kunnen zijn."
                            }
                        ]
                    },
                    {
                        "sense_id": "5c87039d-d7ca-3a43-816a-167250e6fdd2",
                        "entry_id": "ea14f0df-6792-3fe5-a6d0-938537927a68",
                        "glosses": [
                            "oprecht, welgemeend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed1247d3-e4da-44ee-8880-90a7c7dfc9b0",
                                "sense_id": "5c87039d-d7ca-3a43-816a-167250e6fdd2",
                                "text": "Hartgrondige dank."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2e482f7b-aa33-447b-bcf2-5f9e31a3bc4c",
                        "source_entry_id": "ea14f0df-6792-3fe5-a6d0-938537927a68",
                        "target_lang_word": "cordial",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cordial",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "df9652bd-8207-36a2-843d-f6aeb7dc342d",
                                        "entry_id": "de88aa44-783e-3c16-b608-240d2b8f72f9",
                                        "glosses": [
                                            "Hearty; sincere; warm; affectionate."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7da2ed6e-aea6-4d08-a5ab-1f1dd01fd91d",
                                                "sense_id": "df9652bd-8207-36a2-843d-f6aeb7dc342d",
                                                "text": "I have a cordial dislike for arachnids."
                                            },
                                            {
                                                "example_id": "ce1d1882-eae9-426a-be0c-6980a62622b6",
                                                "sense_id": "df9652bd-8207-36a2-843d-f6aeb7dc342d",
                                                "text": "He, on his side / Leaning half raised, with looks of cordial love / Hung over her enamoured."
                                            },
                                            {
                                                "example_id": "4ba976fc-97b5-4ddf-a639-98a809c82b95",
                                                "sense_id": "df9652bd-8207-36a2-843d-f6aeb7dc342d",
                                                "text": "The relations between the Earl of Bellomont and Colonel Schuyler were formal, but not cordial from the first."
                                            },
                                            {
                                                "example_id": "f5007513-705c-423d-ad46-87615fef4bf3",
                                                "sense_id": "df9652bd-8207-36a2-843d-f6aeb7dc342d",
                                                "text": "Joshua maintained his serious demeanour when Wilder took the microphone - his gaze not leaving the Alabama fighter who was cordial and respectful in return."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "18cc0cab-e5bb-35d8-abb3-264b162aa31b",
                                        "entry_id": "de88aa44-783e-3c16-b608-240d2b8f72f9",
                                        "glosses": [
                                            "Radiating warmth and friendliness; genial."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48d6d0db-3f2e-4e68-ab2e-ae28a407595f",
                                                "sense_id": "18cc0cab-e5bb-35d8-abb3-264b162aa31b",
                                                "text": "The sight of London warmed my heart with various emotions, such as a cordial man must draw from the heart of all humanity."
                                            },
                                            {
                                                "example_id": "9fcef673-7bfa-46af-9d69-51ae5944a1e6",
                                                "sense_id": "18cc0cab-e5bb-35d8-abb3-264b162aa31b",
                                                "text": "Since then, though, discussions have become more collaborative and cordial."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c107ecf2-a4ae-3dd1-85d6-1c6033b54248",
                                        "entry_id": "de88aa44-783e-3c16-b608-240d2b8f72f9",
                                        "glosses": [
                                            "Tending to revive, cheer, or invigorate; giving strength or spirits."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "94f350d3-215f-4e3b-97eb-ec55710184e7",
                                                "sense_id": "c107ecf2-a4ae-3dd1-85d6-1c6033b54248",
                                                "text": "I vvas baptized in thy Cordiall vvater, againſt Original ſinne, and I haue drunke of thy Cordiall Blood, for my recouerie, from actuall, and habituall ſinne, in the other Sacrament."
                                            },
                                            {
                                                "example_id": "67f16710-0657-4f94-b4bd-82be5a17b7de",
                                                "sense_id": "c107ecf2-a4ae-3dd1-85d6-1c6033b54248",
                                                "text": "And first behold this cordial julep here / That flames and dances in his crystal bounds, / With spirits of balm, and fragrant syrups mix'd.",
                                                "translation": "Comus",
                                                "english": "Comus"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3fe39fbf-3bf2-3d73-9a38-706d370fd269",
                                        "entry_id": "de88aa44-783e-3c16-b608-240d2b8f72f9",
                                        "glosses": [
                                            "Proceeding from the heart."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b6417a4-1c53-44c8-95b6-e012ddf9de74",
                                                "sense_id": "3fe39fbf-3bf2-3d73-9a38-706d370fd269",
                                                "text": "Who stooping op'n'd my left side, and took / From thence a Rib with cordial spirits warm, / And Life-blood streaming fresh;"
                                            }
                                        ]
                                    }
                                ]
                            },
