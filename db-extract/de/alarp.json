                "senses": [
                    {
                        "sense_id": "2cd32930-d536-33e0-9d20-869d2c8903a6",
                        "entry_id": "c1dc4577-6815-34d4-8f90-1ebfbcfaa597",
                        "glosses": [
                            "Prinzip der Risikoreduzierung, das besagt, dass Risiken auf ein Maß zu reduzieren sind, welches den höchstens Sicherheitsgrad garantiert, der vernünftigerweise noch praktikabel, demnach finanziell und/oder mit technisch vertretbaren Aufwand zu verwirklichen ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bed713a9-77b5-45c3-8328-c79efd7bfa2e",
                                "sense_id": "2cd32930-d536-33e0-9d20-869d2c8903a6",
                                "text": "Risiken, die im inakzeptablen Bereich liegen, müssen durch risikoverringernde Maßnahmen in den ALARP-Bereich gebracht werden."
                            },
                            {
                                "example_id": "5e2720b5-f0de-46cc-a53b-2d50c72bcf74",
                                "sense_id": "2cd32930-d536-33e0-9d20-869d2c8903a6",
                                "text": "„ALARP ist ein Prinzip aus dem Bereich Risikomanagement, bei dem es darauf ankommt, mit vernünftigem Aufwand ein möglichst geringes Risiko einzugehen“."
                            },
                            {
                                "example_id": "7ded2bee-ae53-4a9b-a1f9-8d79d07e5ad0",
                                "sense_id": "2cd32930-d536-33e0-9d20-869d2c8903a6",
                                "text": "„Frei übersetzt ist ALARP ein Prinzip der Risikoreduzierung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
