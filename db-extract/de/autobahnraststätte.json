                        "glosses": [
                            "Rasthof, der an einer Autobahn gelegen ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49fe9d0c-17f7-4502-9361-afb537ff5a90",
                                "sense_id": "18d1284a-d488-3543-a8bb-be16303604d9",
                                "text": "Auf unserer Rückfahrt hielten wir kurz an einer Autobahnraststätte."
                            },
                            {
                                "example_id": "3bed0d5d-d481-4c0f-8e38-bed2bcc33b46",
                                "sense_id": "18d1284a-d488-3543-a8bb-be16303604d9",
                                "text": "„Nach der langen Autofahrt, die wir nur für ein paar Stopps an Autobahnraststätten mit unsäglichem Filterkaffee unterbrochen hatten, hatte mich der Rhythmus der langsam an uns vorbeiziehenden Landschaft eingelullt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
