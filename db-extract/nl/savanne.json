                    {
                        "translation_id": "6664a353-934f-4fed-b028-cb53e6dac101",
                        "source_entry_id": "9e4bfd09-5caa-36a8-9ff3-b60432a08de8",
                        "source_sense_id": "29cd36cf-ffe4-3d3d-9321-1d7f06bbc012",
                        "source_sense_description": "een grasland met verspreid voorkomende bomengroei",
                        "target_lang_word": "savane",
