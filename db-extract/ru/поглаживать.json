                    }
                ],
                "translations": [
                    {
                        "translation_id": "5a7d4aa6-df29-447b-9791-fa7557bf584d",
                        "source_entry_id": "21a1ca5a-dae9-30e8-8925-f1d8d44b9097",
                        "source_sense_id": "047caf03-fa99-381f-866e-29491518ba4c",
                        "target_lang_word": "caresser",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "caresser",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1a6a8dd2-b510-3bcd-91c7-70360758e373",
                                        "entry_id": "ed8c9d1a-cbbc-3674-8298-4c44c208afc5",
                                        "glosses": [
                                            "Faire des caresses de la main ou des lèvres."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e27155a-2d21-4aca-ac67-7b2688243a0c",
                                                "sense_id": "1a6a8dd2-b510-3bcd-91c7-70360758e373",
                                                "text": "Pan dansa comme les autres & en suite prit une satyrelle qu'il caressa de la bonne maniere au milieu de la chambre, alors on n'entendit de tous côtez que cris de joye."
                                            },
                                            {
                                                "example_id": "7c765a11-ed86-4cbd-8b5a-21e0d117f265",
                                                "sense_id": "1a6a8dd2-b510-3bcd-91c7-70360758e373",
                                                "text": "Et tandis qu’elle lui caressait ses cheveux blancs, exténué et rassuré, trop rassuré, il s’endormit sur la descente de lit, et, un bon moment, alors qu’elle le croyait encore éveillé, elle ne caressa plus que son sommeil."
                                            },
                                            {
                                                "example_id": "87fab3ca-647a-42c5-9871-b1efd345cc07",
                                                "sense_id": "1a6a8dd2-b510-3bcd-91c7-70360758e373",
                                                "text": "Helmy buvait ses paroles, contemplait ses yeux alternativement enflammés et tendres, et caressait lentement la main qu’elle lui abandonnait."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "991d63cf-0b15-3749-a645-5929acd7c973",
                                        "entry_id": "ed8c9d1a-cbbc-3674-8298-4c44c208afc5",
                                        "glosses": [
                                            "Frôler."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "poetic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17d53b65-235a-483b-b1fb-efd4c2a4b626",
                                                "sense_id": "991d63cf-0b15-3749-a645-5929acd7c973",
                                                "text": "Le zéphyr caresse les fleurs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b0ba6431-56c9-31f2-a6f5-eadd836770c6",
                                        "entry_id": "ed8c9d1a-cbbc-3674-8298-4c44c208afc5",
                                        "glosses": [
                                            "Flatter ; cajoler."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7e038592-e7b4-480c-9471-25d0988b9bfd",
                                                "sense_id": "b0ba6431-56c9-31f2-a6f5-eadd836770c6",
                                                "text": "Les sœurs de la Belle manquèrent mourir de douleur quand elles la virent habillée comme une princesse, et plus belle que le jour. Elle eut beau les caresser, rien ne put étouffer leur jalousie, qui augmenta beaucoup quand elle leur eut conté combien elle était heureuse."
                                            },
                                            {
                                                "example_id": "42d12aa5-f675-400e-b41c-d3fe6f69dc93",
                                                "sense_id": "b0ba6431-56c9-31f2-a6f5-eadd836770c6",
                                                "text": "Elle caressait, en lui témoignant de la confiance, un des faibles de son mari."
                                            },
                                            {
                                                "example_id": "88d8bcc9-408f-410e-bc16-9473cf087a6a",
                                                "sense_id": "b0ba6431-56c9-31f2-a6f5-eadd836770c6",
                                                "text": "Lisbeth, que le baron Hulot désirait lier avec madame Marneffe pour avoir un œil dans ce ménage, avait déjà dîné chez Valérie, qui, de son côté, voulant avoir une oreille dans la famille Hulot, caressait beaucoup la vieille fille."
                                            },
                                            {
                                                "example_id": "f719fb84-c2b8-45ec-b92f-d999d7871c5e",
                                                "sense_id": "b0ba6431-56c9-31f2-a6f5-eadd836770c6",
                                                "text": "Attiré par la gloire de Canalis, […] un jeune Référendaire à la Cour des Comptes se constitua le secrétaire bénévole du poète, et fut caressé par lui comme un spéculateur caresse son premier bâilleur de fonds."
                                            },
                                            {
                                                "example_id": "7b57f2ea-73c3-46cf-9f8f-a7541a58e06b",
                                                "sense_id": "b0ba6431-56c9-31f2-a6f5-eadd836770c6",
                                                "text": "À quoi servent les faits divers ? […]. En règle générale, à faire du très mauvais journalisme, caressant le lecteur dans ses pulsions malsaines quitte à pulvériser les lignes jaunes du métier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9853c51b-3ea8-386c-aada-1a81417573ab",
                                        "entry_id": "ed8c9d1a-cbbc-3674-8298-4c44c208afc5",
                                        "glosses": [
                                            "Se complaire dans un travail ou dans une pensée."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d67ac7bc-354b-49ff-a597-a87db68dfe87",
                                                "sense_id": "9853c51b-3ea8-386c-aada-1a81417573ab",
                                                "text": "Mais il trouvait un secret plaisir à se dire qu’à sa place bien d’autres n’eussent pas été aussi délicats, et tout en caressant en lui-même le sentiment de sa propre vertu, il arrivait à trouver cette vertu plus méritoire qu’il ne l’aurait imaginé une heure auparavant."
                                            },
                                            {
                                                "example_id": "d56bf2d5-272e-4d72-b721-d880f6caabec",
                                                "sense_id": "9853c51b-3ea8-386c-aada-1a81417573ab",
                                                "text": "Le Valdemar devait pousser son voyage de circumnavigation jusqu'à Seidisfiord, station située sur la côte orientale de l'Islande ; mais comme je caressais toujours l'idée de gagner Reykjavík par terre en franchissant le désert du Stórisandr, le moment était venu de prendre congé du capitaine Kihl et de mes compagnons de traversée."
                                            },
                                            {
                                                "example_id": "117bd858-e226-4698-9d11-2af55797c171",
                                                "sense_id": "9853c51b-3ea8-386c-aada-1a81417573ab",
                                                "text": "Ai-je donc la figure d’un homme qui caresse de mauvais desseins ?"
                                            },
                                            {
                                                "example_id": "1018994c-eb91-4709-a00e-08a96cdc7023",
                                                "sense_id": "9853c51b-3ea8-386c-aada-1a81417573ab",
                                                "text": "Fin février, on se rendait compte dans tous les milieux français et indigènes qu’il fallait faire une fois de plus son deuil des espérances que l’on avait caressées."
                                            },
                                            {
                                                "example_id": "a39e7501-3f42-4756-afa1-e29100be344f",
                                                "sense_id": "9853c51b-3ea8-386c-aada-1a81417573ab",
                                                "text": "Dire qu’il y a des années que je caresse cette chimère, que je vis avec cette idée folle : mon journal à moi […]. Je l’ai réalisé, ce rêve impossible, je le tiens, l’oiseau bleu, entre mes doigts. Le Justicier. C’est un journal de finance."
                                            },
                                            {
                                                "example_id": "31ab3023-696c-4ed0-90e6-e5b772998efd",
                                                "sense_id": "9853c51b-3ea8-386c-aada-1a81417573ab",
                                                "text": "Quand je partis pour Lyon avec Louise et ma sœur, je caressai l’espoir d’affronter l’Ennemi à visage découvert."
                                            },
                                            {
                                                "example_id": "6da190de-46b1-46b8-9671-cf771cacb2a5",
                                                "sense_id": "9853c51b-3ea8-386c-aada-1a81417573ab",
                                                "text": "Elle ne manque pas d’allure la Porsche 912 coupé, couleur crème, millésime 1968, garée sur un boulevard parisien. Un vrai petit bijou pour collectionneurs que plusieurs passants caressent d’un œil connaisseur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ac091456-417c-35d2-b0dc-b7cf208231dd",
                                        "entry_id": "ed8c9d1a-cbbc-3674-8298-4c44c208afc5",
                                        "glosses": [
                                            "Donner un beau fini à une œuvre, un ouvrage."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "092953c7-752a-4e6a-8673-3886d1ab7201",
                                                "sense_id": "ac091456-417c-35d2-b0dc-b7cf208231dd",
                                                "text": "Le fracas de l’orchestre leur arrivait, assourdissant. Par instants, les violons dominaient le vacarme qu’ils semblaient apaiser, caresser, contenir, mais le saxo, le piston, la clarinette et surtout la trompette […] se mettaient ensemble à mugir et à pétarader de telle sorte que personne ne parlait plus."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1546b4d1-61b3-31ef-a8ae-332d3c5dac8b",
                                        "entry_id": "ed8c9d1a-cbbc-3674-8298-4c44c208afc5",
                                        "glosses": [
                                            "Se masturber."
                                        ],
                                        "tags": [
                                            "especially",
                                            "euphemism",
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "449c98e5-b2c2-46fd-bcfa-e7f16c35fdd4",
                                                "sense_id": "1546b4d1-61b3-31ef-a8ae-332d3c5dac8b",
                                                "text": "En attendant, je devais me caresser pour me calmer. J'ai ouvert un autre classeur à souvenirs. La langue de Mandy m'est venue en tête, au creux de la main."
                                            },
                                            {
                                                "example_id": "8ff2a632-7f1d-4515-8af5-caefc23fa8d1",
                                                "sense_id": "1546b4d1-61b3-31ef-a8ae-332d3c5dac8b",
                                                "text": "Elle se caressait souvent, même amoureuse, même enceinte, même heureuse, sous la douche, le matin, au travail, dans les avions parfois, et dans sa caisse, si ça lui chantait."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
