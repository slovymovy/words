                        "entry_id": "5c3496e8-2dcf-3f79-93fb-a62dea16189e",
                        "glosses": [
                            "Action de provoquer la sueur ; fait de suer naturellement ou par l’effet d’un médicament approprié."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc2d451f-8596-47b2-a6b2-c17ce1786ddc",
                                "sense_id": "c51225c1-4ca6-3bb0-9856-6c3a416673be",
                                "text": "Ma pensée échappait à cette sudation en vase clos à quoi la pratique de la réflexion philosophique la réduisait."
                            },
                            {
                                "example_id": "5e847499-6d7d-4196-a0d1-ff94903b2bca",
                                "sense_id": "c51225c1-4ca6-3bb0-9856-6c3a416673be",
                                "text": "Un vent de panique me soulève et perturbe la régulation de ma sudation, menaçant ma robe volée de l’infamie d’auréoles."
                            },
                            {
                                "example_id": "58cd2ada-618c-4896-86cd-87319ee6e43e",
                                "sense_id": "c51225c1-4ca6-3bb0-9856-6c3a416673be",
                                "text": "Le prince souffrirait d’une impossibilité de «sudation» depuis la guerre des Malouines en 1982."
                            }
                        ]
                    }
