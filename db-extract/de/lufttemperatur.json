                ],
                "senses": [
                    {
                        "sense_id": "c9527bf1-1cff-3f41-85a6-b067e693861d",
                        "entry_id": "8d335dce-f8b9-3ee9-981c-53982e55c288",
                        "glosses": [
                            "Temperatur, die man in der Luft in der Nähe des Bodens misst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3cf7008-23ca-4956-b6ce-f96fe86c1e60",
                                "sense_id": "c9527bf1-1cff-3f41-85a6-b067e693861d",
                                "text": "Die Lufttemperatur beträgt heute 12 °C."
                            },
                            {
                                "example_id": "871b8ce9-10a3-490e-8fd0-615b43fdf554",
                                "sense_id": "c9527bf1-1cff-3f41-85a6-b067e693861d",
                                "text": "„Die Änderung der Lufttemperatur mit der Höhe ist das am weitesten verbreitete Kriterium zur Einteilung der Erdatmosphäre in verschiedene Schichten.“"
                            },
                            {
                                "example_id": "42e68e29-026c-4c7f-a5e2-c87e1f6a18de",
                                "sense_id": "c9527bf1-1cff-3f41-85a6-b067e693861d",
                                "text": "„Die Lufttemperatur stand in einem ordnungsgemäßen Verhältnis zur mittleren Jahrestemperatur, zur Temperatur des kältesten wie des wärmsten Monats und zur aperiodischen monatlichen Temperaturschwankung.“"
                            },
                            {
                                "example_id": "9eb2d412-9150-48b2-b542-0e5ffd2b78a5",
                                "sense_id": "c9527bf1-1cff-3f41-85a6-b067e693861d",
                                "text": "„Die Lufttemperatur und -feuchtigkeit wird dort konstant gehalten, um den Schriftbestand bestmöglich zu erhalten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
