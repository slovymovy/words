{
    "word_family": [
        "bevel",
        "bevelhebber",
        "bevelvoering",
        "aanbevelen"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "39617829-b2da-3280-8c7a-86e38b1b3677",
                    "sense_definition": "een dwingende opdracht geven aan iemand",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "opdracht geven",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De generaal beval zijn soldaten onmiddellijk de grens over te steken.",
                            "target_lang_translations": {
                                "en": "The general <w>commanded</w> his soldiers to cross the border immediately.",
                                "ru": "Генерал <w>приказал</w> своим солдатам немедленно пересечь границу."
                            }
                        },
                        {
                            "text": "Ik laat mij door niemand <w>bevelen</w> wat ik in mijn vrije tijd moet doen.",
                            "target_lang_translations": {
                                "en": "I don't let anyone <w>order</w> me around regarding what I should do in my spare time.",
                                "ru": "Я никому не позволю <w>командовать</w> мной и указывать, что мне делать в свободное время."
                            }
                        }
                    ],
                    "synonyms": [
                        "ordonneren",
                        "commanderen",
                        "opdragen"
                    ],
                    "antonyms": [
                        "gehoorzamen"
                    ],
                    "common_phrases": [
                        "iemand iets bevelen",
                        "zichzelf bevelen"
                    ],
                    "target_lang_definitions": {
                        "en": "To give a compelling or authoritative order to someone.",
                        "ru": "Давать обязательное для исполнения распоряжение или приказ кому-либо."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "command",
                                "target_lang_sense_clarification": "to order with authority"
                            },
                            {
                                "target_lang_word": "order",
                                "target_lang_sense_clarification": "to tell someone to do something"
                            },
                            {
                                "target_lang_word": "bid",
                                "target_lang_sense_clarification": "to command or request (formal/literary)"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "приказывать",
                                "target_lang_sense_clarification": "отдавать официальный приказ"
                            },
                            {
                                "target_lang_word": "командовать",
                                "target_lang_sense_clarification": "отдавать команды, распоряжаться"
                            },
                            {
                                "target_lang_word": "велеть",
                                "target_lang_sense_clarification": "распоряжаться в более разговорном или литературном стиле"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c06d84f6-99ab-3c6b-8a18-e91ab21672c3",
                    "sense_definition": "iets of iemand aan de zorg van een ander of God toevertrouwen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "toevertrouwen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In zijn laatste uren sprak hij de woorden: Vader, in Uw handen <w>beveel</w> Ik Mijn geest.",
                            "target_lang_translations": {
                                "en": "In his final hours he spoke the words: Father, into Your hands I <w>commend</w> My spirit.",
                                "ru": "В свои последние часы он произнес слова: Отче, в Твои руки <w>вверяю</w> дух Мой."
                            }
                        },
                        {
                            "text": "Na de begrafenis zeiden de nabestaanden dat zij hun vader in Gods hand <w>bevelen</w>.",
                            "target_lang_translations": {
                                "en": "After the funeral, the relatives said that they <w>entrust</w> their father into God's hands.",
                                "ru": "После похорон родственники сказали, что <w>вверяют</w> своего отца в руки Божьи."
                            }
                        }
                    ],
                    "common_phrases": [
                        "in Gods hand bevelen",
                        "Gode bevolen"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vaak in religieuze of plechtige context"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To entrust something or someone to the care of another or to God.",
                        "ru": "Вверять кого-либо или что-либо заботе другого лица или Бога."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "commend",
                                "target_lang_sense_clarification": "to entrust to someone's care, often in a religious context"
                            },
                            {
                                "target_lang_word": "entrust",
                                "target_lang_sense_clarification": "to put into someone's care or protection"
                            },
                            {
                                "target_lang_word": "commit",
                                "target_lang_sense_clarification": "to give over for safekeeping"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "вверять",
                                "target_lang_sense_clarification": "отдавать под чью-либо опеку или защиту"
                            },
                            {
                                "target_lang_word": "предавать",
                                "target_lang_sense_clarification": "в религиозном контексте, например, предавать душу Богу"
                            },
                            {
                                "target_lang_word": "поручать",
                                "target_lang_sense_clarification": "передавать на попечение"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9ed5bad7-665c-3036-b8a4-d7544c4910a9",
                    "sense_definition": "meervoud van het zelfstandig naamwoord <w>bevel</w>",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "pluralis",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De soldaten kregen strikte <w>bevelen</w> om de poort de hele nacht te bewaken.",
                            "target_lang_translations": {
                                "en": "The soldiers received strict <w>orders</w> to guard the gate all night.",
                                "ru": "Солдаты получили строгие <w>приказы</w> охранять ворота всю ночь."
                            }
                        },
                        {
                            "text": "Het is gevaarlijk om militaire <w>bevelen</w> te negeren tijdens een actieve missie.",
                            "target_lang_translations": {
                                "en": "It is dangerous to ignore military <w>commands</w> during an active mission.",
                                "ru": "Опасно игнорировать военные <w>команды</w> во время активной миссии."
                            }
                        }
                    ],
                    "common_phrases": [
                        "strikte bevelen",
                        "bevelen opvolgen"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "plural form"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Plural form of the noun 'order' or 'command'.",
                        "ru": "Форма множественного числа существительного «приказ» или «команда»."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "commands",
                                "target_lang_sense_clarification": "authoritative instructions"
                            },
                            {
                                "target_lang_word": "orders",
                                "target_lang_sense_clarification": "directions given by someone in authority"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "приказы",
                                "target_lang_sense_clarification": "официальные распоряжения"
                            },
                            {
                                "target_lang_word": "команды",
                                "target_lang_sense_clarification": "указания к действию"
                            }
                        ]
                    }
                }
            ]
        }
    ]
