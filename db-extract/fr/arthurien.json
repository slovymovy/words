                "senses": [
                    {
                        "sense_id": "deed85e6-1ddd-3fdc-85ef-686767cd6720",
                        "entry_id": "19631fc6-2ab2-3198-8042-358c40a44300",
                        "glosses": [
                            "Relatif à la légende du roi Arthur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d2180fc-45bb-4b95-bbcb-159e6666d142",
                                "sense_id": "deed85e6-1ddd-3fdc-85ef-686767cd6720",
                                "text": "Dans le complexe de représentations qui sont accolées à la figure du roi dans la littérature arthurienne du XIIᵉ siècle, celle du primus inter pares, du souverain féodal au milieu de ses barons, est la plus visible."
                            },
                            {
                                "example_id": "f00e3f08-9157-406b-9db3-2d3d3eb6bc40",
                                "sense_id": "deed85e6-1ddd-3fdc-85ef-686767cd6720",
                                "text": "Mais alors que chez Twain, l’Angleterre arthurienne était une métaphore de l’arriération du Sud des États-Unis, elle représente désormais tout simplement l’inverse de l’American way of life…"
                            }
                        ]
                    }
                ],
