{
    "word_family": [
        "gourmandise",
        "gourmandiser",
        "gourmandement"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "315116e4-0318-371f-931b-738356a87a80",
                    "sense_definition": "Qui aime la bonne nourriture, les friandises et le plaisir de manger.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "plaisir_gustatif",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mon petit frère est très <w>gourmand</w> et adore manger du chocolat après l'école."
                        },
                        {
                            "text": "Elle reste toujours très <w>gourmande</w> de pâtisseries fraîches préparées par sa grand-mère."
                        }
                    ],
                    "synonyms": [
                        "friand"
                    ],
                    "common_phrases": [
                        "très gourmand",
                        "gourmand de chocolat"
                    ]
                },
                {
                    "sense_id": "d6cc10e8-168d-3742-bca7-c948190b0a85",
                    "sense_definition": "Qui est savoureux, appétissant et généreux, propre à faire plaisir aux amateurs de bonne cuisine.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "plaisir_gustatif",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "À la fin de notre déjeuner, nous avons commandé un café <w>gourmand</w> servi avec trois mini desserts délicieux."
                        },
                        {
                            "text": "Cette petite auberge propose une pause <w>gourmande</w> idéale pour les randonneurs affamés."
                        }
                    ],
                    "common_phrases": [
                        "café gourmand",
                        "pause gourmande"
                    ]
                },
                {
                    "sense_id": "3f37f2cb-6165-3911-a0f4-b2a79acb5cc6",
                    "sense_definition": "Qui mange avec excès, voracité ou avidité.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "exces_nourriture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cet enfant trop <w>gourmand</w> a mangé tous les bonbons sans en laisser à ses camarades de classe."
                        },
                        {
                            "text": "Le chien s'est montré particulièrement <w>gourmand</w> en avalant toute sa gamelle en quelques secondes."
                        }
                    ],
                    "synonyms": [
                        "glouton",
                        "vorace",
                        "goulu",
                        "avide"
                    ],
                    "common_phrases": [
                        "appétit gourmand"
                    ]
                },
                {
                    "sense_id": "712d7f79-edff-3e4e-96a5-758c98a4e8eb",
                    "sense_definition": "Qui exige d'importantes ressources ou qui demande une part excessive de bénéfices.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "exces_general",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce nouveau logiciel pour ordinateur est très <w>gourmand</w> en mémoire vive et ralentit le système."
                        },
                        {
                            "text": "Il a perdu son contrat commercial parce qu'il s'est montré trop <w>gourmand</w> pendant les négociations financières."
                        }
                    ],
                    "synonyms": [
                        "avide"
                    ],
                    "common_phrases": [
                        "trop gourmand",
                        "gourmand en énergie"
                    ]
                },
                {
                    "sense_id": "6847abfc-5961-3880-8fb6-d484a95c0f03",
                    "sense_definition": "Qualifie un rameau végétal vigoureux qui pousse rapidement en épuisant la sève de la plante.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "botanique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il faut tailler cette branche <w>gourmande</w> pour préserver le bon développement des fruits de l'arbre."
                        },
                        {
                            "text": "Les tiges <w>gourmandes</w> du rosier captent l'énergie de la plante et réduisent l'apparition des fleurs."
                        }
                    ],
                    "common_phrases": [
                        "branche gourmande"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "01e2d118-bc45-3549-baa3-0ef0c18a77b7",
                    "sense_definition": "Personne qui aime les plaisirs de la table, les bonnes préparations ou les douceurs sucrées.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "personne",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette boulangerie artisanale propose une vitrine qui attire chaque matin de nombreux <w>gourmands</w> du quartier."
                        },
                        {
                            "text": "En véritable <w>gourmande</w>, elle prend toujours un grand plaisir à goûter de nouvelles recettes de gâteaux."
                        }
                    ],
                    "synonyms": [
                        "gourmet",
                        "glouton"
                    ],
                    "common_phrases": [
                        "plaisir de gourmand",
                        "pour les gourmands"
                    ]
                },
                {
                    "sense_id": "1ca8665b-7ba9-3b17-b887-632523f6d036",
                    "sense_definition": "Rameau stérile et vigoureux se développant sur un végétal au détriment des branches fruitières.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "botanique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pendant tout l'été, le jardinier coupe chaque <w>gourmand</w> sur les pieds de tomates pour obtenir de beaux fruits."
                        },
                        {
                            "text": "Si vous laissez pousser les <w>gourmands</w>, la vigne produira moins de raisins de bonne qualité."
                        }
                    ],
                    "common_phrases": [
                        "couper les gourmands",
                        "tailler les gourmands"
                    ]
                }
            ]
        }
    ]
}