                            },
                            {
                                "target_lang_word": "удушение",
                                "target_lang_sense_clarification": "процесс лишения кислорода"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f16048b3-1c97-354b-b179-38ba4807b154",
                    "sense_definition": "An instance or act of dying or being killed by asphyxiation.",
