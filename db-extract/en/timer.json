                                                "example_id": "9468fedc-24ef-4d0b-ab15-4aa7d6aa28a0",
                                                "sense_id": "0961df3c-abfa-32fd-aee4-87ed23978e62",
                                                "text": "Elles ouvrent grand leur portefeuille, leurs jambes, leur bouche, et reprochent ensuite au garçon d’avoir un minuteur à la place du cœur."
                                            }
