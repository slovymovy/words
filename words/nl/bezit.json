            "senses": [
                {
                    "sense_id": "99da3e13-b0e3-3e37-8524-f1d23a334404",
                    "sense_definition": "de eerste persoon enkelvoud tegenwoordige tijd van <w>bezitten</w>",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>bezit</w> een zeldzame verzameling postzegels uit de negentiende eeuw.",
                            "target_lang_translations": {
                                "en": "I <w>possess</w> a rare collection of stamps from the nineteenth century.",
                                "ru": "Я <w>владею</w> редкой коллекцией марок девятнадцатого века."
                            }
                        },
                        {
                            "text": "Hoewel ik weinig geld heb, <w>bezit</w> ik veel goede boeken.",
                            "target_lang_translations": {
                                "en": "Although I have little money, I <w>own</w> many good books.",
                                "ru": "Хотя у меня мало денег, я <w>обладаю</w> множеством хороших книг."
                            }
                        }
                    ],
