                "senses": [
                    {
                        "sense_id": "0129eb54-0f07-3b14-abed-2dfd6cbd5357",
                        "entry_id": "fc9fa747-75e7-3fe2-85e1-0ebc862d818c",
                        "glosses": [
                            "Kosten, die für Postsendungen anfallen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "287fecf6-2b00-4af4-aef6-dc577eae75ea",
                                "sense_id": "0129eb54-0f07-3b14-abed-2dfd6cbd5357",
                                "text": "„Die Portogebühren sind eine ins Gewicht fallende Kostenart im Rahmen der Allgemeinen Praxiskosten.“"
                            },
                            {
                                "example_id": "6fb4ba1f-bfe3-4461-af58-03f591ec38ef",
                                "sense_id": "0129eb54-0f07-3b14-abed-2dfd6cbd5357",
                                "text": "„Im Gegensatz betragen bei einem quadratischen Flyer die Portogebühren 1,45 Euro.“"
                            },
                            {
                                "example_id": "a4024374-c65f-4bda-ad9a-917b3bae93a8",
                                "sense_id": "0129eb54-0f07-3b14-abed-2dfd6cbd5357",
                                "text": "„Für die Sendung der Zahlungserinnerung fordert die PRS außerdem eine Portogebühr von 70 Cent.“"
                            },
                            {
                                "example_id": "6344ff2f-f68b-4a6e-8d31-2e41c1c6a2c1",
                                "sense_id": "0129eb54-0f07-3b14-abed-2dfd6cbd5357",
                                "text": "„Auch der Briefverkehr ist nicht so lebhaft, als er sein könnte und sollte, weil die Portogebühr zu hoch ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
