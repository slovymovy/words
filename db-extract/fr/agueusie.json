            {
                "entry_id": "cbaafa73-122f-30a8-a1b3-ab81cb225183",
                "word": "agueusie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "a1402fc8-7cd3-418c-9d7a-84a8e102565b",
                        "entry_id": "cbaafa73-122f-30a8-a1b3-ab81cb225183",
                        "tags": [
