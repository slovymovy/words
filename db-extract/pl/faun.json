                "forms": [],
                "senses": [
                    {
                        "sense_id": "1aa37b11-0d74-3ed1-8b9f-dbab6fed6644",
                        "entry_id": "cb65b8b9-60e5-3a0f-8851-099f38f24772",
                        "glosses": [
                            "staroitalski bóg płodności o pół koziej posturze, bóstwo lasów górskich, opiekun pasterzy, który darzy płodnością ich stada i uczy uprawy roli"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "41737f66-7ae8-445d-8b96-3f47457172da",
                                "sense_id": "1aa37b11-0d74-3ed1-8b9f-dbab6fed6644",
                                "text": "W mitologii rzymskiej odpowiednikiem Pana był Faun."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4241a5b3-8ba9-41fb-a192-6fc6a6afd764",
                        "source_entry_id": "cb65b8b9-60e5-3a0f-8851-099f38f24772",
                        "source_sense_id": "1aa37b11-0d74-3ed1-8b9f-dbab6fed6644",
                        "target_lang_word": "Fauno",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "4bae659c-e0b4-48dc-bc9a-6b376f1c7325",
                        "source_entry_id": "cb65b8b9-60e5-3a0f-8851-099f38f24772",
                        "source_sense_id": "1aa37b11-0d74-3ed1-8b9f-dbab6fed6644",
                        "target_lang_word": "Faun",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Faun",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "86af3196-d79c-3e66-adf8-4a4c96c3d95c",
                                        "entry_id": "50b9d27d-08e4-38cc-89c0-3eafd6992182",
                                        "glosses": [
                                            "altrömischer Waldgeist oder Gott des Waldes, der gehörnt und bocksfüßig dargestellt wird und in Literatur und Kunst als Symbol der hemmungslosen sexuellen Triebhaftigkeit dient"
                                        ],
                                        "tags": [
                                            "römische Mythologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b8ac570c-9e9e-4b39-84a4-1b5efc4b35a5",
                                                "sense_id": "86af3196-d79c-3e66-adf8-4a4c96c3d95c",
                                                "text": "Faun ist das römische Pendent zu Pan."
                                            },
                                            {
                                                "example_id": "dbb37d95-c380-4b16-bfc5-4a875c9901e4",
                                                "sense_id": "86af3196-d79c-3e66-adf8-4a4c96c3d95c",
                                                "text": "„Seine Gemahlin hieß Fatua oder Fauna, und sie gebar ihm das mißgebildete, zottelhaarige, ziegenfüßige Geschlecht der Faunen, Halbgötter mit Bockshörnern und braunen Nasen, welche in den Wäldern wohnten, diese mit Geschrei erfüllten, und ein Schrecken aller Nymphen und Erdentöchter waren.“"
                                            },
                                            {
                                                "example_id": "1475f14f-9028-49b2-abe5-8a58e4fbe9d3",
                                                "sense_id": "86af3196-d79c-3e66-adf8-4a4c96c3d95c",
                                                "text": "„Es handelt sich ja nicht nur um die Frage, ob man unter Umständen an einem ungehobelten, wiewohl virilen Faun Gefallen finden mag, sondern um einen erpressten Beischlaf, wir würden es Vergewaltigung nennen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3da22988-aaad-3b06-8da7-6ffd69732cea",
                                        "entry_id": "50b9d27d-08e4-38cc-89c0-3eafd6992182",
                                        "glosses": [
                                            "Mensch, der sehr lüstern ist"
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "66147ef8-ea02-4442-88f0-70dfbe4e0472",
                                                "sense_id": "3da22988-aaad-3b06-8da7-6ffd69732cea",
                                                "text": "Klaus wirkt zwar immer so bieder, aber in Wahrheit ist er ein Faun."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
