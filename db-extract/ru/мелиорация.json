                                        "sense_id": "444ba945-6d38-333a-9bf8-89636911777c",
                                        "entry_id": "e38411ad-d534-3fed-be8d-db4070060a95",
                                        "glosses": [
                                            "The act of making better."
                                        ],
                                        "tags": [
