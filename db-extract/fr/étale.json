                "senses": [
                    {
                        "sense_id": "0fce8138-eaa8-3dac-8de2-df9ec399c2e4",
                        "entry_id": "9068c575-8191-3017-9a04-cefef69239af",
                        "glosses": [
                            "Moment où la mer est stationnaire, sans mouvement important de marée."
                        ],
                        "tags": [
                            "ellipsis"
                        ],
                        "examples": [
                            {
                                "example_id": "4fb611cc-ef53-4c1e-9ea3-2f4180e6454f",
                                "sense_id": "0fce8138-eaa8-3dac-8de2-df9ec399c2e4",
                                "text": "Les capitaines de goélettes m’avaient tous conseillé d’entrer à l’étale de basse mer quand le courant est nul."
                            },
                            {
                                "example_id": "8f1d0083-5f64-4deb-bfcb-cb7dc089f5fe",
                                "sense_id": "0fce8138-eaa8-3dac-8de2-df9ec399c2e4",
                                "text": "Il me semblait flotter comme une ombre au milieu du navire gris, du jour gris, de l’eau grise, le cœur défait dans cette étale morne du petit jour."
                            },
                            {
                                "example_id": "fe7af009-38a3-4f47-a500-8cae271c81ac",
                                "sense_id": "0fce8138-eaa8-3dac-8de2-df9ec399c2e4",
                                "text": "Les deux dangers à craindre en rapport avec la profondeur d’eau, sont le cabanement (arrière qui plonge) et le salut (étrave qui plonge), le lancement doit se faire à l’étale pour éviter tout courant risquant de porter le navire de travers."
                            }
                        ]
                    }
                ],
