{
    "word_family": [
        "solicitation",
        "solicitor",
        "solicitous",
        "solicitude"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5cdebd46-5649-310e-bd3c-c57fedf2ae68",
                    "sense_definition": "To persistently try to obtain something or bring about an event.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "request",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The charity workers <w>solicit</w> donations from passersby on the busy street.",
                            "target_lang_translations": {
                                "zh": "慈善工作者在繁忙的街道上向路人<w>征求</w>捐款。"
                            }
                        },
                        {
                            "text": "They <w>solicit</w> support for their new environmental project from local businesses.",
                            "target_lang_translations": {
                                "zh": "他们向当地企业<w>征求</w>对其新环保项目的支持。"
                            }
                        }
                    ],
                    "synonyms": [
                        "request",
                        "appeal",
                        "petition"
                    ],
                    "common_phrases": [
                        "solicit support",
                        "solicit donations",
                        "solicit feedback"
                    ],
                    "target_lang_definitions": {
                        "zh": "持续地试图获得某物或促成某事。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "征求",
                                "target_lang_sense_clarification": "指征求意见、支持或捐款等。"
                            },
                            {
                                "target_lang_word": "募集",
                                "target_lang_sense_clarification": "特指募集资金或捐赠。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "65d63840-0aab-33d4-95e8-0a78bf106cc4",
                    "sense_definition": "To make a formal request or petition.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "request",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The citizens decided to <w>solicit</w> the government for better public transportation.",
                            "target_lang_translations": {
                                "zh": "市民们决定向政府<w>请求</w>改善公共交通。"
                            }
                        },
                        {
                            "text": "Lawyers often <w>solicit</w> the court to reconsider previous rulings based on new evidence.",
                            "target_lang_translations": {
                                "zh": "律师经常<w>恳求</w>法院根据新证据重新考虑之前的裁决。"
                            }
                        }
                    ],
                    "synonyms": [
                        "petition",
                        "supplicate",
                        "plead"
                    ],
                    "common_phrases": [
                        "solicit the court"
                    ],
                    "target_lang_definitions": {
                        "zh": "提出正式请求或请愿。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "请求",
                                "target_lang_sense_clarification": "通用的正式请求。"
                            },
                            {
                                "target_lang_word": "恳求",
                                "target_lang_sense_clarification": "语气较强，带有请求批准或重新考虑的意味。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b8bf58c8-4735-314e-96bd-73e0d6289ca6",
                    "sense_definition": "To persuade or incite someone to commit an illegal or immoral act.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "incite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is a serious crime to <w>solicit</w> someone to commit a violent act.",
                            "target_lang_translations": {
                                "zh": "<w>教唆</w>他人实施暴力行为是严重的犯罪。"
                            }
                        },
                        {
                            "text": "The criminal tried to <w>solicit</w> an undercover officer to help him break into the store.",
                            "target_lang_translations": {
                                "zh": "罪犯试图<w>教唆</w>一名卧底警官帮他闯入商店。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "劝说或煽动某人从事非法或不道德的行为。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "教唆",
                                "target_lang_sense_clarification": "指怂恿他人犯罪。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "711c4b8e-26aa-333e-93fc-67fe8f8c7385",
                    "sense_definition": "To offer to perform sexual activity in exchange for payment.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "incite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police arrested the individual for attempting to <w>solicit</w> a prostitute.",
                            "target_lang_translations": {
                                "zh": "警方因该人试图<w>拉皮条</w>将其逮捕。"
                            }
                        },
                        {
                            "text": "Laws against those who <w>solicit</w> for sex are strictly enforced in this city.",
                            "target_lang_translations": {
                                "zh": "本市严格执行针对<w>卖淫</w>者的法律。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "以金钱为交换条件提供性服务。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "拉皮条",
                                "target_lang_sense_clarification": "指招揽性交易。"
                            },
                            {
                                "target_lang_word": "卖淫",
                                "target_lang_sense_clarification": "指从事性交易行为。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d0b1de79-bf56-3eac-8edf-f93599e536a5",
                    "sense_definition": "To disturb, trouble, or harass someone.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "disturb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Anxious thoughts continued to <w>solicit</w> his mind throughout the long night.",
                            "target_lang_translations": {
                                "zh": "焦虑的念头在漫长的黑夜里不断<w>困扰</w>着他。"
                            }
                        },
                        {
                            "text": "Do not let minor problems <w>solicit</w> your peace of mind during the vacation.",
                            "target_lang_translations": {
                                "zh": "度假期间，别让琐事<w>困扰</w>你的心情。"
                            }
                        }
                    ],
                    "synonyms": [
                        "worry"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This sense is largely archaic."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "打扰、困扰或骚扰某人。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "困扰",
                                "target_lang_sense_clarification": "指思想或情绪上的不安。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "daae584c-c153-3374-8999-60a14f5c5761",
                    "sense_definition": "The act of soliciting.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "request",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>solicit</w> for donations was met with generous contributions from the community.",
                            "target_lang_translations": {
                                "zh": "社区对这次捐款<w>请求</w>给予了慷慨的回应。"
                            }
                        },
                        {
                            "text": "He received a formal <w>solicit</w> to join the board of directors.",
                            "target_lang_translations": {
                                "zh": "他收到了一份加入董事会的正式<w>请求</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "request",
                        "petition"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Rare usage as a noun; solicitation is preferred."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "请求或征求的行为。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "请求",
                                "target_lang_sense_clarification": "指正式的申请或要求。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}