{
    "word_family": [
        "рядовой",
        "рядом",
        "порядок",
        "разряд",
        "отряд",
        "наряд",
        "подряд",
        "упорядочить"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "edbfc4bd-7b0a-361a-b334-8866656923c1",
                    "sense_definition": "Совокупность однородных предметов или людей, расположенных друг за другом или вытянутых в одну линию.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "physical_arrangement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы купили билеты в первый <w>ряд</w> кинотеатра.",
                            "target_lang_translations": {
                                "en": "We bought tickets for the first <w>row</w> of the cinema.",
                                "zh": "我们买了电影院第一<w>排</w>的票。"
                            }
                        },
                        {
                            "text": "Солдаты выстроились в <w>ряд</w> на плацу.",
                            "target_lang_translations": {
                                "en": "The soldiers lined up in a <w>row</w> on the parade ground.",
                                "zh": "士兵们在操场上排成一<w>行</w>。"
                            }
                        },
                        {
                            "text": "Вдоль дороги рос длинный <w>ряд</w> высоких деревьев.",
                            "target_lang_translations": {
                                "en": "A long <w>row</w> of tall trees grew along the road.",
                                "zh": "路边长着一长<w>排</w>高大的树木。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "первый ряд",
                        "стоять в ряд",
                        "задний ряд",
                        "в одном ряду"
                    ],
                    "target_lang_definitions": {
                        "en": "A line of objects, people, or things arranged side by side or one behind another.",
                        "zh": "指排列在一起或前后相连的一组人或物。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "row",
                                "target_lang_sense_clarification": "line of seats, trees, or objects"
                            },
                            {
                                "target_lang_word": "line",
                                "target_lang_sense_clarification": "general arrangement of things or people"
                            },
                            {
                                "target_lang_word": "rank",
                                "target_lang_sense_clarification": "line of soldiers standing side by side"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "排",
                                "target_lang_sense_clarification": "指座位、树木或物体的行列"
                            },
                            {
                                "target_lang_word": "行",
                                "target_lang_sense_clarification": "指人或物的排列"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "78e78f34-8cdc-3a79-9c5d-b031116a61c7",
                    "sense_definition": "Некоторое, обычно немалое количество чего-либо; совокупность явлений или предметов.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "quantity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "У комиссии возник целый <w>ряд</w> вопросов к директору.",
                            "target_lang_translations": {
                                "en": "The commission had a whole <w>number</w> of questions for the director.",
                                "zh": "委员会对主任有一<w>系列</w>的问题。"
                            }
                        },
                        {
                            "text": "В <w>ряде</w> случаев это лекарство помогает лучше других.",
                            "target_lang_translations": {
                                "en": "In a <w>number</w> of cases, this medicine helps better than others.",
                                "zh": "在<w>许多</w>情况下，这种药比其他药更有效。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "целый ряд",
                        "ряд вопросов",
                        "в ряде случаев",
                        "ряд причин"
                    ],
                    "target_lang_definitions": {
                        "en": "A considerable number or collection of things, events, or phenomena.",
                        "zh": "指相当数量或一系列的事物、现象。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "number",
                                "target_lang_sense_clarification": "quantity, used in 'a number of'"
                            },
                            {
                                "target_lang_word": "series",
                                "target_lang_sense_clarification": "sequence of similar things"
                            },
                            {
                                "target_lang_word": "range",
                                "target_lang_sense_clarification": "variety or selection"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "一系列",
                                "target_lang_sense_clarification": "指连续的或相关的一组事物"
                            },
                            {
                                "target_lang_word": "许多",
                                "target_lang_sense_clarification": "指数量较多"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4ee6a3c6-e089-392b-97de-5cb977c56831",
                    "sense_definition": "Состав, совокупность членов какой-либо организации, партии или войскового соединения.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "organization_membership",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Молодой специалист быстро влился в <w>ряды</w> нашей компании.",
                            "target_lang_translations": {
                                "en": "The young specialist quickly joined the <w>ranks</w> of our company.",
                                "zh": "这位年轻的专家很快加入了我们公司的<w>行列</w>。"
                            }
                        },
                        {
                            "text": "В наши <w>ряды</w> вступили новые добровольцы.",
                            "target_lang_translations": {
                                "en": "New volunteers joined our <w>ranks</w>.",
                                "zh": "新的志愿者加入了我们的<w>行列</w>。"
                            }
                        },
                        {
                            "text": "Он был призван в <w>ряды</w> армии сразу после института.",
                            "target_lang_translations": {
                                "en": "He was drafted into the <w>ranks</w> of the army immediately after the institute.",
                                "zh": "他大学毕业后立即应征入伍，加入了军队的<w>行列</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "коллектив"
                    ],
                    "common_phrases": [
                        "вступить в ряды",
                        "в наших рядах",
                        "пополнить ряды"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "usually plural"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The collective membership of an organization, party, or military force.",
                        "zh": "指组织、团体或军队的成员集体。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "ranks",
                                "target_lang_sense_clarification": "members of a group or army"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "行列",
                                "target_lang_sense_clarification": "指加入某个组织或团体"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d442643e-3ddb-3b5d-bc41-766d4a270481",
                    "sense_definition": "Последовательность величин, событий или понятий, сменяющих друг друга в определённом порядке; в математике — сумма членов такой последовательности.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sequence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "За последние годы произошёл <w>ряд</w> важных исторических событий.",
                            "target_lang_translations": {
                                "en": "A <w>series</w> of important historical events has occurred in recent years.",
                                "zh": "近年来发生了一<w>系列</w>重要的历史事件。"
                            }
                        },
                        {
                            "text": "Студенты изучали сходимость числового <w>ряда</w> на лекции по математическому анализу.",
                            "target_lang_translations": {
                                "en": "Students studied the convergence of a numerical <w>series</w> at the lecture on mathematical analysis.",
                                "zh": "学生们在数学分析课上学习了数项<w>级数</w>的收敛性。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "числовой ряд",
                        "временной ряд",
                        "степенной ряд"
                    ],
                    "target_lang_definitions": {
                        "en": "A sequence of values, events, or concepts; in mathematics, the sum of a sequence's terms.",
                        "zh": "指按一定顺序排列的数值、事件或概念；在数学中指级数。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "series",
                                "target_lang_sense_clarification": "mathematical or sequential set"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "系列",
                                "target_lang_sense_clarification": "指连续的序列"
                            },
                            {
                                "target_lang_word": "级数",
                                "target_lang_sense_clarification": "数学术语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dffe941c-a262-37c2-98c5-ff550c700d18",
                    "sense_definition": "Лингвистический термин, характеризующий место образования гласного звука в зависимости от движения языка по горизонтали.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "linguistics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Гласные переднего <w>ряда</w> произносятся с продвижением языка вперёд.",
                            "target_lang_translations": {
                                "en": "Vowels of the front <w>series</w> are pronounced with the tongue moving forward.",
                                "zh": "前<w>舌位</w>元音发音时舌头向前移动。"
                            }
                        },
                        {
                            "text": "В русском языке звук «и» относится к переднему <w>ряду</w>.",
                            "target_lang_translations": {
                                "en": "In Russian, the sound 'i' belongs to the front <w>series</w>.",
                                "zh": "在俄语中，“и”音属于前<w>舌位</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "передний ряд",
                        "задний ряд",
                        "гласные среднего ряда"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "technical (linguistics)"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A linguistic category classifying vowels based on the horizontal position of the tongue (front, central, back).",
                        "zh": "语言学术语，根据舌位前后位置对元音进行的分类。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "series",
                                "target_lang_sense_clarification": "phonetic category"
                            },
                            {
                                "target_lang_word": "row",
                                "target_lang_sense_clarification": "literal translation, place of articulation"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "舌位",
                                "target_lang_sense_clarification": "指元音发音时的舌头位置"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d770d030-edd4-3f37-a803-808c3d365ec4",
                    "sense_definition": "Договор, соглашение или условие (в историческом контексте Древней Руси).",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "historical_agreement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Князь заключил <w>ряд</w> с дружиной о разделе добычи.",
                            "target_lang_translations": {
                                "en": "The prince concluded a <w>treaty</w> with the druzhina regarding the division of loot.",
                                "zh": "公爵与亲兵队就战利品的分配达成了一项<w>协议</w>。"
                            }
                        },
                        {
                            "text": "Нарушить <w>ряд</w> считалось тяжким преступлением в те времена.",
                            "target_lang_translations": {
                                "en": "Violating the <w>agreement</w> was considered a grave crime in those times.",
                                "zh": "在那个时代，违反<w>协议</w>被视为严重的罪行。"
                            }
                        }
                    ],
                    "synonyms": [
                        "уговор",
                        "соглашение"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historical"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A contract, agreement, or treaty in the context of medieval Russia.",
                        "zh": "古代俄罗斯语境下的契约、协议或条约。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "agreement",
                                "target_lang_sense_clarification": "historical contract"
                            },
                            {
                                "target_lang_word": "treaty",
                                "target_lang_sense_clarification": "formal pact"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "协议",
                                "target_lang_sense_clarification": "历史上的契约"
                            },
                            {
                                "target_lang_word": "条约",
                                "target_lang_sense_clarification": "正式的契约"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}