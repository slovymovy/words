                "senses": [
                    {
                        "sense_id": "1fc8cac9-12ef-3e11-82a5-34cbc17a32e6",
                        "entry_id": "bf46a2b0-e519-33db-b54f-ad13c4668f51",
                        "glosses": [
                            "Person, die sich für die Richtigkeit der Theorie der natürlichen Selektion nach Charles Darwin ^(→ WP) ausspricht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0255f12d-8c43-48b1-b56d-187ac8638b73",
                                "sense_id": "1fc8cac9-12ef-3e11-82a5-34cbc17a32e6",
                                "text": "„Über diese beiden Sichtweisen ist in der Evolutionsbiologie eine jahrzehntelange kontroverse Debatte zwischen „Selektionisten“ und „Neutralisten“ entbrannt.“"
                            },
                            {
                                "example_id": "21fefb9d-4c4d-4926-9080-d5b60cebddd7",
                                "sense_id": "1fc8cac9-12ef-3e11-82a5-34cbc17a32e6",
                                "text": "„Ein Selektionist würde sagen, daß die häufiger vorkommenden Tripletts aus irgendwelchen Gründen öfter durch natürliche Selektion begünstigt werden […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
