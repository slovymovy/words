                    },
                    {
                        "translation_id": "d4bbd035-abb7-40df-9398-0e09be9440d8",
                        "source_entry_id": "ebd113f4-d68f-32aa-b3a9-fcd11b9459ca",
                        "source_sense_id": "f9450f3f-8299-3f31-b30b-4ebc682e5dcb",
                        "target_lang_word": "Pointer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pointer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "edeb1fa3-84d1-3bc6-aa06-40bb2a58588e",
                                        "entry_id": "360d965e-83db-3957-83bb-17bd350df4ec",
                                        "glosses": [
                                            "Variable, die eine Speicheradresse enthält, also eine Referenz auf einen Wert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ffc5a7d0-b57a-4b29-9cfd-a6b3139867fe",
                                                "sense_id": "edeb1fa3-84d1-3bc6-aa06-40bb2a58588e",
                                                "text": "Beim Umgang mit Pointern ist Vorsicht geboten: man kann leicht versehentlich den Inhalt des Pointers verändern, obwohl man den Inhalt der Variable verändern wollte, auf die er sich bezieht."
                                            },
                                            {
                                                "example_id": "bc5194a4-a248-49d2-bd7e-2f5ab36b2bc3",
                                                "sense_id": "edeb1fa3-84d1-3bc6-aa06-40bb2a58588e",
                                                "text": "Im Prozessor gibt es einen Speicher, den sogenannten „program counter“, der einen Pointer auf den als nächstes auszuführenden Befehl enthält."
                                            },
                                            {
                                                "example_id": "f9620962-822f-430c-a729-b11c5b66cdd6",
                                                "sense_id": "edeb1fa3-84d1-3bc6-aa06-40bb2a58588e",
                                                "text": "Ein Beispiel für einen Pointer in der natürlichen Sprache wäre „Grundgesetz Deutschlands, Artikel 1, Satz 1“. Der referenzierte Wert wäre dann „Die Würde des Menschen ist unantastbar.“."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Pointer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a3149be4-070b-3298-b796-3bb9e98f9dd7",
                                        "entry_id": "86eae578-b515-32a3-a0df-1810d9bfef16",
                                        "glosses": [
                                            "mittelgroßer Jagdhund mit glattem, weißem oder geflecktem Fell und Hängeohren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab72b0e5-c22e-47da-823b-091558e5f545",
                                                "sense_id": "a3149be4-070b-3298-b796-3bb9e98f9dd7",
                                                "text": "„Dabei hat es ihn sehr verwundert, dass die Rolle des Pointers während und nach der Tat kein Thema war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
