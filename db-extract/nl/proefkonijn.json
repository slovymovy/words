                        "examples": [
                            {
                                "example_id": "d6c0a4bd-ae63-433f-b123-82bc00527a9d",
                                "sense_id": "469fd04c-0db2-3767-9268-4b99e85737e6",
                                "text": "Ik ben proefkonijn geweest voor een nieuw middel tegen malaria.",
                                "translation": "I have been a guinea pig for a new drug against malaria.",
                                "english": "I have been a guinea pig for a new drug against malaria."
                            },
                            {
                                "example_id": "71ad14fe-11e4-4d8e-b5c7-f6b8a9a2b2e6",
                                "sense_id": "469fd04c-0db2-3767-9268-4b99e85737e6",
                                "text": "Ik maak deze soep voor de eerste keer, dus jij bent mijn proefkonijn.",
                                "translation": "I have never made this soup before, so you are my guinea pig.",
                                "english": "I have never made this soup before, so you are my guinea pig."
                            }
                        ]
                    }
