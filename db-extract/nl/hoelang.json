                "senses": [
                    {
                        "sense_id": "a35a0f2c-b10e-39d4-a53e-a0beb3161479",
                        "entry_id": "7417d752-362a-374d-b4c2-09d16444a436",
                        "glosses": [
                            "gedurende welke hoeveelheid tijd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f931c256-87c7-470f-a530-4ab32b4e8fc7",
                                "sense_id": "a35a0f2c-b10e-39d4-a53e-a0beb3161479",
                                "text": "Hoelang kan een mens eigenlijk zonder eten, zonder drinken? Ik hoor de stem van mijn moeder in mijn hoofd, die me als kind al vertelde hoe haar ouders hadden moeten overleven ir1 de concentratiekampen, in de kou, met honger en gebrek aan slaap."
                            },
                            {
                                "example_id": "d9bd001f-50fa-4baf-a9fd-7b0cf6746310",
                                "sense_id": "a35a0f2c-b10e-39d4-a53e-a0beb3161479",
                                "text": "Hoelang is het geleden dat ik haar de liefde van mijn leven heb genoemd? Lauren en ik hebben elkaar ontmoet op het strand van Noordwijk."
                            }
                        ]
                    },
                    {
                        "sense_id": "57262177-5286-3ccd-abdb-f3592f219b6c",
                        "entry_id": "7417d752-362a-374d-b4c2-09d16444a436",
                        "glosses": [
                            "tot ~: tot welk tijdstip"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f29f92bd-b0d0-498e-90c4-317a7f619725",
                                "sense_id": "57262177-5286-3ccd-abdb-f3592f219b6c",
                                "text": "Hij wist niet precies tot hoelang hij verondersteld was te blijven wachten."
                            }
                        ]
                    }
                ],
