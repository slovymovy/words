                        "examples": [
                            {
                                "example_id": "e1cc8238-d64b-4388-aebf-d86cf5c1ee32",
                                "sense_id": "af7c5826-332f-3fe2-a76b-04234e906722",
                                "text": "„Ich war auf meinem Stuhl neben dem Telefon festgeleimt, meine Füße steckten im Minikühlschrank – in der Sommerhitze ist jede Kühlung willkommen –, und ich wartete auf einen Anruf der Yomiuri Shimbun, der angesehensten japanischen Zeitung.“"
                            },
                            {
                                "example_id": "0343f93e-8c55-48ec-9033-0be01642986c",
                                "sense_id": "af7c5826-332f-3fe2-a76b-04234e906722",
                                "text": "„Sie hatte etwas Wasser aus einer Flasche aus dem Minikühlschrank getrunken und eine halbe Stunde lang ferngesehen, irgendeinen Mist, bevor sie sich im Bad umgezogen hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
