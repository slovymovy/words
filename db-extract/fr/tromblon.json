        "fr-extract.jsonl": [
            {
                "entry_id": "89b80841-9e4b-315c-9a08-3d02d43ef370",
                "word": "tromblon",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "b4907e72-6f99-4788-abd2-0052449d6add",
                        "entry_id": "89b80841-9e4b-315c-9a08-3d02d43ef370",
                        "tags": [
                            "plural"
                        ],
                        "form": "tromblons"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "411661a8-11dd-3b7b-8f5e-0e10bbf3b995",
                        "entry_id": "89b80841-9e4b-315c-9a08-3d02d43ef370",
                        "glosses": [
                            "Arme à feu portative dont le canon est évasé."
                        ],
                        "tags": [
                            "Armement"
                        ],
                        "examples": [
                            {
                                "example_id": "3d882a7d-3f05-40be-8706-ea1ee93f8cca",
                                "sense_id": "411661a8-11dd-3b7b-8f5e-0e10bbf3b995",
                                "text": "Simplement vêtu comme un Chouan, le Gars portait son tromblon en bandoulière derrière sa peau de bique,…"
                            },
                            {
                                "example_id": "7b11c289-97f3-4139-8db9-53dea8c3e093",
                                "sense_id": "411661a8-11dd-3b7b-8f5e-0e10bbf3b995",
                                "text": "Surpris au dernier point, il se jette à bas de sa monture, relève de la main les gueules des tromblons, et se nomme."
                            },
                            {
                                "example_id": "04062680-1221-4c98-b888-e8380fdce025",
                                "sense_id": "411661a8-11dd-3b7b-8f5e-0e10bbf3b995",
                                "text": "Avec une agilité et une prestesse qui tenaient du prodige, elle tournoyait, voltigeait, cabriolait, tromblon au poing."
                            }
                        ]
                    },
                    {
                        "sense_id": "64394906-3dd0-3f4a-93ab-192fbc915b4b",
                        "entry_id": "89b80841-9e4b-315c-9a08-3d02d43ef370",
                        "glosses": [
                            "Ensemble diffuseur pour extincteur au dioxyde de carbone, facilitant la formation de neige carbonique."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "5b13d849-938e-31f6-9a5e-2357966654a7",
                        "entry_id": "89b80841-9e4b-315c-9a08-3d02d43ef370",
                        "glosses": [
                            "(Souvent accompagné de vieux) Objet ou personnage, ancien et suranné."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "6c13aec8-1b54-4af5-abec-b95b64ef4254",
                                "sense_id": "5b13d849-938e-31f6-9a5e-2357966654a7",
                                "text": "Bah à ce prix, tu auras dans le meilleur des cas un vieux tromblon tapé jusqu’à la moelle vieux de 15 ans au moins…"
                            },
                            {
                                "example_id": "315ac17e-f563-4b50-b930-eed969859177",
                                "sense_id": "5b13d849-938e-31f6-9a5e-2357966654a7",
                                "text": "Il fallait faire avancer le plus loin possible, à la force des bras, un vieux tromblon automobile destiné à la casse."
                            },
                            {
                                "example_id": "bd417acf-7377-4996-ae7d-71db402cbe1c",
                                "sense_id": "5b13d849-938e-31f6-9a5e-2357966654a7",
                                "text": "Vieux tromblon ! Vieux tromblon ! On doit avoir à peu près le même âge, et je me sens pas vieux tromblon !!! Juste un peu vieux con de temps en temps."
                            }
                        ]
                    },
                    {
                        "sense_id": "3afcf8cb-f2ba-3d36-b3c1-d19a7b22aa7e",
                        "entry_id": "89b80841-9e4b-315c-9a08-3d02d43ef370",
                        "glosses": [
                            "Chapeau haut de forme dont le fond est élargi."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7eaca95a-b6c8-48b5-aa7f-7b2ee4cd3831",
                                "sense_id": "3afcf8cb-f2ba-3d36-b3c1-d19a7b22aa7e",
                                "text": "Les gens que l’on rencontre en costume moderne, coiffés de chapeaux tromblons, vêtus de redingotes à la propriétaire, vous produisent involontairement un effet désagréable et vous semblent plus ridicules qu’ils ne le sont ; car ils ne peuvent réellement pas se promener, pour la plus grande gloire de la couleur locale, avec l’albornoz more du temps de Boabdil ou l’armure de fer du temps de Ferdinand et d’Isabelle la Catholique."
                            },
                            {
                                "example_id": "d5010eb2-83f8-4a2b-9529-84bff9ce9f7a",
                                "sense_id": "3afcf8cb-f2ba-3d36-b3c1-d19a7b22aa7e",
                                "text": "M. Caterna a son chapeau traversé, et, qu’on ne l’oublie pas, c’est son chapeau de marié de village, son tromblon gris à longs poils."
                            },
                            {
                                "example_id": "71224d01-4b93-4490-8075-0d30202ecc60",
                                "sense_id": "3afcf8cb-f2ba-3d36-b3c1-d19a7b22aa7e",
                                "text": "Je le rencontrais [Leconte de Lisle], hors de chez Lemerre ou de la maison paternelle, se promenant dans les allées du Luxembourg, avec ses joues de bébé féroce, sous un de ces vastes et luisants chapeaux tromblons que Mallarmé appelle « un météore ténébreux »."
                            },
                            {
                                "example_id": "5ee3e295-a924-4635-82f3-a20195201a29",
                                "sense_id": "3afcf8cb-f2ba-3d36-b3c1-d19a7b22aa7e",
                                "text": "Cette fois-là il avait l’air, le pauvre cher immortel garçon, de jouer les traîtres sous le Directoire, au théâtre de Belleville. Sa longue redingote boutonnée, un chapeau quasi tromblon dégoulinant d’eau sur les bords, car il pleuvait, et un parapluie de vente à la criée, tordu comme une voile autour d’un mât pendant la tempête, lui prêtaient cette physionomie mélodramatique."
                            },
                            {
                                "example_id": "b5e21745-20e8-4599-800a-77673108eb53",
                                "sense_id": "3afcf8cb-f2ba-3d36-b3c1-d19a7b22aa7e",
                                "text": "Mon oncle mit sa redingote à brandebourgs, prit son chapeau tromblon, et nous descendîmes dans la rue, qui m’avait l’air extraordinairement changée."
                            },
                            {
                                "example_id": "23e941fe-c705-462a-bb3a-1b2b5f797b43",
                                "sense_id": "3afcf8cb-f2ba-3d36-b3c1-d19a7b22aa7e",
                                "text": "Le cavalier avait une redingote boutonnée jusqu’au cou, sanglée très étroit, sans brandebourgs, mais un gibus tromblon d’une insolence rare. Les dimensions, les courbures, le poil, la façon dont il était posé de côté, quoique un peu sur le front, l’habileté qu’il fallait pour le porter en équilibre constant dans les voltes et passes à droite du cheval, faisaient de ce chapeau comme un coup de pied au cul collectif et circulaire à tous ceux qui le regardaient."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7dfba928-0ab3-4b83-8bb5-e96086169ffb",
                        "source_entry_id": "89b80841-9e4b-315c-9a08-3d02d43ef370",
                        "target_lang_word": "blunderbuss",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "blunderbuss",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "044847b5-3fa5-3ba8-ab6b-0f02195eb9ae",
                                        "entry_id": "d57fb6f9-2d27-319d-998b-017df5535656",
                                        "glosses": [
                                            "An old style of muzzleloading firearm and early form of shotgun with a distinctive short, large caliber barrel that is flared at the muzzle, therefore able to fire scattered quantities of nails, stones, shot, etc. at short range."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a33a2b6-6263-4e0d-93df-4b778110832e",
                                                "sense_id": "044847b5-3fa5-3ba8-ab6b-0f02195eb9ae",
                                                "text": "We fired the blunderbuss several times by way of salute, and soon after landed at the bank near the village of the Mahahas, or Shoe Indians, and were received by a crowd of people, who came to welcome our return."
                                            },
                                            {
                                                "example_id": "a86c69d3-69fd-4f5c-98fc-6098253f43d0",
                                                "sense_id": "044847b5-3fa5-3ba8-ab6b-0f02195eb9ae",
                                                "text": "One of the most picturesque of the old flintlock guns is the blunderbuss, which was often carried by coach guards for protection against highwaymen."
                                            },
                                            {
                                                "example_id": "3ee800aa-4663-4e14-b514-6b9af46c6db4",
                                                "sense_id": "044847b5-3fa5-3ba8-ab6b-0f02195eb9ae",
                                                "text": "The blunderbuss never gained great favor in the American colonies or early United States."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "blunderbuss",
                                "target_lang_code": "en",
