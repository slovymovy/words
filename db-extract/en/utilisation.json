                ],
                "translations": [
                    {
                        "translation_id": "5b6ead06-b369-448f-835e-1b67f9d88c30",
                        "source_entry_id": "fbdd66d3-2ddb-31c7-b098-5d0b64c66bf2",
                        "source_sense_description": "act of using",
                        "target_lang_word": "gebruik",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gebruik",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "0073548d-60fc-385b-b608-0c39e1bc2616",
                                        "entry_id": "0270afe1-56bf-3da2-b873-de40361c081e",
                                        "glosses": [
                                            "een standaard manier van doen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ffbe83a1-4d65-4ec1-917e-d96e2af90668",
                                                "sense_id": "0073548d-60fc-385b-b608-0c39e1bc2616",
                                                "text": "Het schudden van de rechterhand is, in Nederland, het gebruik om een onbekende te begroeten."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "94dcd96f-5fa1-3bbe-9cae-6129f6553deb",
                                        "entry_id": "0270afe1-56bf-3da2-b873-de40361c081e",
                                        "glosses": [
                                            "toepassen van iets"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c0d6b9d4-06fa-44af-8531-5be91e0fc11f",
                                                "sense_id": "94dcd96f-5fa1-3bbe-9cae-6129f6553deb",
                                                "text": "Het gebruik van een woordenboek is aan te raden voor het controleren van de spelling."
                                            },
                                            {
                                                "example_id": "1dece434-7be7-4818-a0d1-4d9d4622a439",
                                                "sense_id": "94dcd96f-5fa1-3bbe-9cae-6129f6553deb",
                                                "text": "In de Duitse wereld waren er speciale Fechtakademies en Fechtbücher die de jonge aristocraat voorbereidden op een leven waarin hij geregeld gebruik moest maken van geweld."
                                            },
                                            {
                                                "example_id": "83cf0512-38b1-4ec6-ac66-e676d37ba314",
                                                "sense_id": "94dcd96f-5fa1-3bbe-9cae-6129f6553deb",
                                                "text": "Deze chaotische situatie zorgde ervoor dat pas in 2012 ontdekt werd dat Nederlandse roeiers (van de overkoepelende studentenroeivereniging Minerva) bij deze Spelen een medaille hadden gewonnen: omdat ze gebruik hadden gemaakt van een anonieme Franse stuurman werd hun overwinning geteld als één van het internationale team."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "gebruik",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "fe78d513-dacd-3f1a-8d62-6e86a233dc53",
                                        "entry_id": "93bd0e7a-bfaa-3a85-aa36-daa7c08b18c0",
                                        "glosses": [
                                            "eerste persoon enkelvoud tegenwoordige tijd van gebruiken"
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb26450d-a049-48f6-a59c-9d598263d8d8",
                                                "sense_id": "fe78d513-dacd-3f1a-8d62-6e86a233dc53",
                                                "text": "Ik gebruik."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e74aee92-eae8-389e-9302-f899b1b71f12",
                                        "entry_id": "93bd0e7a-bfaa-3a85-aa36-daa7c08b18c0",
                                        "glosses": [
                                            "gebiedende wijs van gebruiken"
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e09d7634-1f9e-4baa-a22f-5b6948098d99",
                                                "sense_id": "e74aee92-eae8-389e-9302-f899b1b71f12",
                                                "text": "Gebruik!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f34cb52c-65f4-3f34-8d77-2c20a5d0e6b8",
                                        "entry_id": "93bd0e7a-bfaa-3a85-aa36-daa7c08b18c0",
                                        "glosses": [
                                            "tweede persoon enkelvoud tegenwoordige tijd van gebruiken"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "inversion"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "134f9fd9-bf81-40b7-b64a-e2e7d3995c52",
                                                "sense_id": "f34cb52c-65f4-3f34-8d77-2c20a5d0e6b8",
                                                "text": "Gebruik je?"
                                            },
                                            {
                                                "example_id": "89eb5791-adf3-430f-9e07-5840d26e16ba",
                                                "sense_id": "f34cb52c-65f4-3f34-8d77-2c20a5d0e6b8",
                                                "text": "Mijn stem is misschien wel het belangrijkste instrument in mijn leven omdat ik veel praat. Ik gebruik mijn stem om verhalen te vertellen, iets duidelijk te maken en te overtuigen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e06d9953-39e2-49c0-89e7-e8a10e2184c2",
                        "source_entry_id": "fbdd66d3-2ddb-31c7-b098-5d0b64c66bf2",
                        "source_sense_description": "act of using",
                        "target_lang_word": "utilisation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "utilisation",
