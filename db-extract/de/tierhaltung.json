                "senses": [
                    {
                        "sense_id": "08c6ab24-1cf1-3f50-95c6-e8109fa1bd4c",
                        "entry_id": "826c2588-6dce-33a2-960e-192b092d422a",
                        "glosses": [
                            "Versorgung und Pflege eines oder mehrerer Tiere in menschlicher Obhut"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46bad7ac-4b93-42c5-9503-669f7159f8a0",
                                "sense_id": "08c6ab24-1cf1-3f50-95c6-e8109fa1bd4c",
                                "text": "Ein Mieter hatte in seinem Mietvertrag eine Klausel, wonach \"jede Tierhaltung, insbesondere von Hunden und Katzen, mit Ausnahme von Ziervögeln und Zierfischen, … der Zustimmung des Vermieters\" bedürfe."
                            },
                            {
                                "example_id": "10b67801-9a65-4a9a-90d5-627c204804ba",
                                "sense_id": "08c6ab24-1cf1-3f50-95c6-e8109fa1bd4c",
                                "text": "Der Luzerner Hans Vanja Palmers setzt sich neu mit einem Elefanten-Mobil für bessere Tierhaltung im Zirkus ein."
                            },
                            {
                                "example_id": "ba68a9df-8aac-45dc-be54-93a2f241e1c1",
                                "sense_id": "08c6ab24-1cf1-3f50-95c6-e8109fa1bd4c",
                                "text": "Die Landwirte hier leben überwiegend von der Tierhaltung."
                            },
                            {
                                "example_id": "fccdf79b-0f90-4713-8fc6-02e3f273eee5",
                                "sense_id": "08c6ab24-1cf1-3f50-95c6-e8109fa1bd4c",
                                "text": "Erwin Kessler, der Präsident des VgT, setzt sich noch immer für eine Ausstrahlung der Bilder aus industriellen Tierhaltungen ein."
                            },
                            {
                                "example_id": "1ce77156-0975-4b1c-8959-5e72fdd73d43",
                                "sense_id": "08c6ab24-1cf1-3f50-95c6-e8109fa1bd4c",
                                "text": "„Laut Umweltbundesamt verursachte die Landwirtschaft 2023 inklusive der Emissionen aus Böden und Maschinen 14 Prozent der Treibhausgase in Deutschland. Der Großteil hängt mit der Tierhaltung zusammen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "32952447-2bca-400d-bb8c-f569291d0969",
