                                "sense_id": "bb50b2b4-1333-3013-b435-a9cb1bc31bfb",
                                "text": "\"The test was terrifically hard,\" said the tired student."
                            },
                            {
                                "example_id": "1f1e168f-1c47-4eaf-aced-4582e6c9043c",
                                "sense_id": "bb50b2b4-1333-3013-b435-a9cb1bc31bfb",
                                "text": "Upon examination it was found that a large breakage had been made, directly under their bows, and the sea was rushing in terrifically."
                            }
                        ]
                    }
