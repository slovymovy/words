                        "glosses": [
                            "Option politique préconisant l’intégration européenne."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "d29bb5cb-6eb3-4f3f-add6-f1acb612c2a9",
                                "sense_id": "71ec1d78-f0ec-3240-9cda-992afcf311cf",
                                "text": "Le b.a.-ba de l’européisme, c’est Pascal Lamy qui, avec sa franchise coutumière, en rappelle la recette dans la revue Le Débat : on y fabrique du politique avec de l’économique, et c’est ainsi qu’il faut continuer."
                            },
                            {
                                "example_id": "100eb4c0-f209-41fc-acb5-40724f174bf3",
                                "sense_id": "71ec1d78-f0ec-3240-9cda-992afcf311cf",
                                "text": "L’européisme espagnol n’a pas son équivalent en France malgré notre rôle pionnier."
                            }
                        ]
                    }
