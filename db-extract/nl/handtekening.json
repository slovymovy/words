                        "examples": [
                            {
                                "example_id": "9db97e1a-2d8d-40dd-b943-e6f48bc0ac86",
                                "sense_id": "d55bd939-982b-3066-b09f-9e5b15d92068",
                                "text": "Zonder handtekening is dit contract ongeldig.",
                                "translation": "This contract is not valid without a signature.",
                                "english": "This contract is not valid without a signature."
                            },
                            {
                                "example_id": "fd32a951-b5c7-4e7e-8756-2b4466137b4b",
                                "sense_id": "d55bd939-982b-3066-b09f-9e5b15d92068",
                                "text": "Zou u even uw handtekening willen zetten?",
                                "translation": "Would you please sign this?",
                                "english": "Would you please sign this?"
                            },
                            {
                                "example_id": "24daa133-97aa-4452-abf0-f5b53bc1c81e",
                                "sense_id": "d55bd939-982b-3066-b09f-9e5b15d92068",
                                "text": "Een handtekening van Elvis is geld waard.",
                                "translation": "Elvis's autograph is worth money.",
                                "english": "Elvis's autograph is worth money."
                            },
                            {
                                "example_id": "2ee489ea-1251-45f3-a056-5cfe0957121b",
                                "sense_id": "d55bd939-982b-3066-b09f-9e5b15d92068",
                                "text": "Deze diefstal draagt overduidelijk haar handtekening.",
                                "translation": "This theft has her name written all over it.",
                                "english": "This theft has her name written all over it."
                            }
                        ]
                    }
