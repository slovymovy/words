                    {
                        "sense_id": "e935b187-b64b-3674-b9a8-49645cce1434",
                        "entry_id": "2743b1cd-1708-3e51-b460-274becfd207f",
                        "glosses": [
                            "twee mensen (m/m, m/v of v/v) die met elkaar getrouwd zijn m/m m/v of v/v"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "72110a49-10bf-488f-bca9-ef8aa3c8df0a",
                                "sense_id": "e935b187-b64b-3674-b9a8-49645cce1434",
                                "text": "Het echtpaar doet vrijwel alles samen."
                            },
                            {
                                "example_id": "b3b21315-da42-4914-9e11-b222effc8b06",
                                "sense_id": "e935b187-b64b-3674-b9a8-49645cce1434",
                                "text": "Ik ken geen echtpaar dat geen problemen heeft gehad."
                            },
                            {
                                "example_id": "c9f436bb-7540-435d-8b54-51419178660d",
                                "sense_id": "e935b187-b64b-3674-b9a8-49645cce1434",
                                "text": "Het echtpaar loopt weg langs de mahoniehouten lambrisering, de met rode vlekken besmeurde tafelkleden, de omgegooide zilveren kannen en de voedselresten."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fae624aa-90f6-4adb-8fe8-3f8fd234aa40",
                        "source_entry_id": "2743b1cd-1708-3e51-b460-274becfd207f",
                        "source_sense_id": "e935b187-b64b-3674-b9a8-49645cce1434",
