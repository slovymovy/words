                                            {
                                                "example_id": "7080d8e8-b4e0-4a95-87e1-fbec139e5de3",
                                                "sense_id": "cba54c3d-0c7a-3f1d-84fe-da3357cdc52e",
                                                "text": "L’addition et la multiplication des nombres complexes sont des opérations commutatives."
                                            },
                                            {
                                                "example_id": "31c5ca55-ca1a-4c74-a902-63cc1fd75cf0",
                                                "sense_id": "cba54c3d-0c7a-3f1d-84fe-da3357cdc52e",
                                                "text": "La multiplication des quaternions n'est pas commutative."
                                            }
