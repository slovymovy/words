                ],
                "senses": [
                    {
                        "sense_id": "433fd1ed-e761-385d-9a47-64f4a26e14c9",
                        "entry_id": "14cc00f2-b146-3979-ae12-4cc3f5c695bd",
                        "glosses": [
                            "eine Silbe, deren Gipfel ein Vollvokal ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "72362f4d-3544-4186-b70d-03a30afbb0be",
                                "sense_id": "433fd1ed-e761-385d-9a47-64f4a26e14c9",
                                "text": "„Die s-Flexion dehnt sich insgesamt über Eigennamen, Abkürzungen, Kurzwörter und Wörter mit offener Vollsilbe als Ultima schnell aus und wird manchmal sogar als der markierte Flexionstyp des Substantivs angesehen (…).“"
                            },
                            {
                                "example_id": "124b71aa-02ed-455a-bce1-602bad93315e",
                                "sense_id": "433fd1ed-e761-385d-9a47-64f4a26e14c9",
                                "text": "„Selbst bei Lehnwörtern gibt es die Tendenz, die Aussprache dem Muster Vorsilbe-Vollsilbe anzupassen.“"
                            },
                            {
                                "example_id": "aa30fbb7-dc14-4799-a0dd-ddaa67e7b476",
                                "sense_id": "433fd1ed-e761-385d-9a47-64f4a26e14c9",
                                "text": "„Vollsilben können den Wortakzent tragen, Reduktionssilben nicht. Da Wörter betonbar sein müssen, folgt, dass ein Wort aus mindestens einer Vollsilbe bestehen muss.“"
                            },
                            {
                                "example_id": "b1bf4af0-e0b5-4104-b6be-3757583ce72d",
                                "sense_id": "433fd1ed-e761-385d-9a47-64f4a26e14c9",
                                "text": "„Im Zuge der Synkopierungen ändert sich die prosodische Struktur der meisten mittelhochdeutschen Wörter derart, dass sie aus einer Folge von einer betonten Vollsilbe und einer unbetonten Reduktionssilbe bestehen.“"
                            },
                            {
                                "example_id": "891a87c3-7038-420b-9e14-c5fbf4c06562",
                                "sense_id": "433fd1ed-e761-385d-9a47-64f4a26e14c9",
                                "text": "„Langvokale kommen nur in Vollsilben, nie in Reduktionssilben vor.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
