                            "Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94d0323e-f5c8-47ab-b556-16ee4b987ab5",
                                "sense_id": "297e0721-893f-35af-a23c-49f510c2bad1",
                                "text": "Frau Podivinsky ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "5d9d764b-40a3-4585-a87c-ca7777bf4157",
                                "sense_id": "297e0721-893f-35af-a23c-49f510c2bad1",
                                "text": "Herr Podivinsky wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "ab8d7fb4-8e9a-4aeb-ae46-dffdcfd89d99",
                                "sense_id": "297e0721-893f-35af-a23c-49f510c2bad1",
                                "text": "Die Podivinskys fahren heute nach Oldenburg."
                            },
                            {
                                "example_id": "4422f1de-b090-4de7-b8ed-8b053ed001b9",
                                "sense_id": "297e0721-893f-35af-a23c-49f510c2bad1",
                                "text": "Der Podivinsky trägt nie die Schals, die die Podivinsky ihm strickt."
                            },
                            {
                                "example_id": "7c350780-08cb-40ab-ba17-9b1260b47187",
                                "sense_id": "297e0721-893f-35af-a23c-49f510c2bad1",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Podivinsky kommt, geht der Herr Podivinsky.“"
                            },
                            {
                                "example_id": "7555702a-bf9a-4a9b-8c3e-3771d522114a",
                                "sense_id": "297e0721-893f-35af-a23c-49f510c2bad1",
                                "text": "Podivinsky kommt und geht."
                            },
                            {
                                "example_id": "e33dd9fa-c9df-4d9c-87fd-f5b36d2e493f",
                                "sense_id": "297e0721-893f-35af-a23c-49f510c2bad1",
                                "text": "Podivinskys kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
