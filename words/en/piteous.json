{
    "word_family": [
        "pity",
        "piteousness",
        "piteously",
        "pitiful",
        "pitiless"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "ffdfb0ac-16c6-3864-bde3-4b76977c822d",
                    "sense_definition": "Demanding or provoking feelings of pity, sorrow, or sympathy.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "arousing_pity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The injured puppy let out a <w>piteous</w> cry that broke everyone's heart.",
                            "target_lang_translations": {
                                "es": "El cachorro herido soltó un llanto <w>lastimero</w> que partió el corazón de todos."
                            }
                        },
                        {
                            "text": "It was a <w>piteous</w> sight to see the refugees shivering in the bitter cold.",
                            "target_lang_translations": {
                                "es": "Era una estampa <w>lamentable</w> ver a los refugiados temblar en el frío gélido."
                            }
                        }
                    ],
                    "synonyms": [
                        "heartbreaking",
                        "heartrending",
                        "lamentable",
                        "pathetic",
                        "pitiful"
                    ],
                    "common_phrases": [
                        "piteous cry",
                        "piteous sight"
                    ],
                    "target_lang_definitions": {
                        "es": "Que despierta o merece compasión, lástima o dolor."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "lamentable",
                                "target_lang_sense_clarification": "digno de lástima o dolor"
                            },
                            {
                                "target_lang_word": "lastimero",
                                "target_lang_sense_clarification": "que causa o manifiesta lástima, especialmente sonidos o quejas"
                            },
                            {
                                "target_lang_word": "desgarrador",
                                "target_lang_sense_clarification": "que conmueve profundamente el corazón"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9f7cb6c7-58fa-3015-9516-9496af925638",
                    "sense_definition": "Feeling or showing compassion and mercy towards others.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "feeling_pity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The judge listened with a <w>piteous</w> heart and decided to reduce the sentence.",
                            "target_lang_translations": {
                                "es": "El juez escuchó con un corazón <w>compasivo</w> y decidió reducir la condena."
                            }
                        },
                        {
                            "text": "She looked upon the beggar with soft and <w>piteous</w> eyes.",
                            "target_lang_translations": {
                                "es": "Miró al mendigo con ojos suaves y <w>piadosos</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "compassionate",
                        "tender"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used in modern English in the sense of showing compassion."
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Que siente o muestra compasión, misericordia o piedad hacia los demás."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "compasivo",
                                "target_lang_sense_clarification": "lleno de compasión hacia otros"
                            },
                            {
                                "target_lang_word": "misericordioso",
                                "target_lang_sense_clarification": "propenso a la misericordia o al perdón"
                            },
                            {
                                "target_lang_word": "piadoso",
                                "target_lang_sense_clarification": "que tiene o manifiesta piedad"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6dcfb2b7-7ee1-39a1-8ea0-025ded32c03d",
                    "sense_definition": "Pathetically small, poor, or inadequate; of little worth.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "contemptibly_small",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After weeks of hard labor, they were rewarded with a <w>piteous</w> sum of money.",
                            "target_lang_translations": {
                                "es": "Tras semanas de duro trabajo, fueron recompensados con una suma de dinero <w>miserable</w>."
                            }
                        },
                        {
                            "text": "He offered a <w>piteous</w> excuse that failed to convince anyone.",
                            "target_lang_translations": {
                                "es": "Ofreció una excusa <w>pobre</w> que no convenció a nadie."
                            }
                        }
                    ],
                    "synonyms": [
                        "miserable",
                        "paltry",
                        "mean",
                        "pitiful"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used historically to describe insignificant or poor quality work or value."
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Patéticamente escaso, pobre o insignificante; de escaso valor."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "miserable",
                                "target_lang_sense_clarification": "extremadamente escaso o mezquino"
                            },
                            {
                                "target_lang_word": "írrito",
                                "target_lang_sense_clarification": "insignificante o ridículamente pequeño"
                            },
                            {
                                "target_lang_word": "pobre",
                                "target_lang_sense_clarification": "insuficiente o de escasa calidad"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3eb5b8c2-ac39-3f1b-b010-b407697fca85",
                    "sense_definition": "Pious; showing religious devotion to God.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "pious",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ancient scriptures praised the <w>piteous</w> men who remained faithful through trials.",
                            "target_lang_translations": {
                                "es": "Las antiguas escrituras elogiaban a los hombres <w>devotos</w> que permanecieron fieles en las tribulaciones."
                            }
                        },
                        {
                            "text": "The monks led a quiet and <w>piteous</w> life dedicated wholly to prayer.",
                            "target_lang_translations": {
                                "es": "Los monjes llevaban una vida tranquila y <w>piadosa</w> dedicada por entero a la oración."
                            }
                        }
                    ],
                    "synonyms": [
                        "devout",
                        "pious"
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "No longer used in the sense of devout or pious."
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Piadoso; que muestra devoción religiosa hacia Dios."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "piadoso",
                                "target_lang_sense_clarification": "devoto o religioso"
                            },
                            {
                                "target_lang_word": "devoto",
                                "target_lang_sense_clarification": "dedicado fervientemente a la religión"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}