                                            {
                                                "example_id": "2f27fbad-a0d2-4066-b1e3-ff0c9e42011b",
                                                "sense_id": "5d1d7d53-d825-3bc6-b788-188c7341856a",
                                                "text": "The Gisarme called also gisaring, and, by Fleta, sisarmes is likewise an ancient weapon of the staff kind, but of what for seems doubtful."
                                            }
