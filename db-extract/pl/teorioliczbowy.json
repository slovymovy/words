                                    {
                                        "sense_id": "4d8c063e-ba8c-3eac-8936-9b0dc669e061",
                                        "entry_id": "10cde8b8-efb5-36fa-a4bb-85faea111800",
                                        "glosses": [
                                            "die Theorie der Zahlen betreffend, auf die Theorie der Zahlen bezogen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "41915ae6-8c91-4537-9b4b-81f9321faebd",
                                                "sense_id": "4d8c063e-ba8c-3eac-8936-9b0dc669e061",
                                                "text": "„Auf breiter fachlicher Ebene werden in dem Lehrbuch einfache elementare zahlentheoretische Inhalte besprochen, aber auch Stoffkomplexe aus der analytischen und algebraischen Zahlentheorie dargestellt.“"
                                            },
                                            {
                                                "example_id": "b82b5ec9-c512-4a6c-b764-e8a049e087c6",
                                                "sense_id": "4d8c063e-ba8c-3eac-8936-9b0dc669e061",
                                                "text": "„Letztere Eigenschaft, die auch den binären quadratischen Formen zukommt, hebt aus allen Formen höheren Grades die zahlentheoretisch interessantesten heraus, […]“"
                                            }
                                        ],
