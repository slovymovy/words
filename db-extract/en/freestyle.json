                    }
                ],
                "translations": [
                    {
                        "translation_id": "a93ef183-75e3-427e-9b13-63c6a7183f51",
                        "source_entry_id": "7d44be18-6fa0-325c-991a-bf6746a8441a",
                        "source_sense_description": "to ad-lib in rap music",
                        "target_lang_word": "freestylen",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "freestylen",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "a47f2c33-63c9-3f30-aa97-789d8fddf9da",
                                        "entry_id": "dac0b8e2-4c32-3044-87d1-ce9cac9be6d4",
                                        "glosses": [
                                            "op een vrije, improviserende en kunstzinnige manier iets doen (met name bij rappen of sporten)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10fc9030-35b8-4c70-b204-2cf0b65813e4",
                                                "sense_id": "a47f2c33-63c9-3f30-aa97-789d8fddf9da",
                                                "text": "\"Willen jullie nog even freestylen?\" vraagt de lerares opgewekt, alsof haar liezen niet branden als oogverblindend hellevuur. Ik glimlach vriendelijk, maar huil van binnen."
                                            },
                                            {
                                                "example_id": "2002e85e-0bd5-44cb-9561-365113a6c82b",
                                                "sense_id": "a47f2c33-63c9-3f30-aa97-789d8fddf9da",
                                                "text": "\"Weer iets helemaal nieuws. Zo probeer ik steeds het moment voor te zijn dat mensen denken: die trucjes kennen we nou wel. Het freestylen zal altijd centraal staan, ook nu. Maar het voetbal opent de deur naar bijzondere gesprekken. Voetballers laten een kant van zichzelf zien die ze, denk ik, nog niet eerder hebben laten zien.\""
                                            }
                                        ]
                                    }
                                ]
                            }
