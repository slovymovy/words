                    {
                        "sense_id": "35b41846-7b5a-3d01-870e-6bdd3c117ee9",
                        "entry_id": "d4d9ad6b-cfac-3835-829c-79510f730839",
                        "glosses": [
                            "de witte met schuim bedekte kop van een golf"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "624822a2-2a90-40c4-9b00-551165f45097",
                                "sense_id": "35b41846-7b5a-3d01-870e-6bdd3c117ee9",
                                "text": "Vlinders fladderen rond ons hoofd, in de struiken met vrolijke gele bloemetjes naast het pad kwetteren vogels. Aan de voet van de helling slaat het blauwgroene water van een sprookjesachtig mooie baai plat op een gladgestreken zandstrand. Op de golven dansen witte schuimkopjes. Behalve het geruis van het water en het suizen van de wind is niets te horen."
                            },
                            {
                                "example_id": "47d52f60-cf4b-4eb9-8ab1-7542374e8d1f",
                                "sense_id": "35b41846-7b5a-3d01-870e-6bdd3c117ee9",
                                "text": "De bemanning van ABN Amro I zoekt halverwege de race wanhopig naar wind. Een rimpeling op zee, een schuimkop of het zeil van een plezierjacht dat plotseling opbolt. Zeiler Rob Greenhalgh zit boven in de mast, dertig meter boven het water, en praat via de radio met het dek."
                            }
                        ]
                    },
                    {
                        "sense_id": "68607b40-4051-3019-ad1c-2bfbbaf6df6a",
                        "entry_id": "d4d9ad6b-cfac-3835-829c-79510f730839",
                        "glosses": [
                            "de witte met schuim bedekte kop van een biertje"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d3babbb3-7e99-43aa-b378-2162ac6fb1b0",
                                "sense_id": "68607b40-4051-3019-ad1c-2bfbbaf6df6a",
                                "text": "Bierfabrikant Heineken en Douwe Egbert Senseo hebben de koppen bij elkaar gestoken en een baanbrekend product bedacht. Na de koffie- en theepads brengen ze in samenwerking met Philips de Heineken SENSEO® bierpad uit. ‘Voor koud bier met een heerlijke schuimkop, op een moment dat jou uitkomt. Al het genot in één handzaam apparaat. Proost!"
                            }
                        ]
                    }
