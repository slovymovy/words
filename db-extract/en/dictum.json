    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "354e72a5-0f60-33f3-a16e-d021ade17bfb",
                "word": "dictum",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "e2dfe8fb-d9af-4483-b3c0-d383c9c6a63c",
                        "entry_id": "354e72a5-0f60-33f3-a16e-d021ade17bfb",
                        "tags": [
