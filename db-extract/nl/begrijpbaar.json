                "senses": [
                    {
                        "sense_id": "6316c1b4-fd72-306f-83f1-68298a73b6fd",
                        "entry_id": "972bad2d-63d7-3205-8d0e-7c7fb51068c7",
                        "glosses": [
                            "makkelijk te begrijpen, meestal in de zin dat het goed aangevoeld kan worden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd0420ac-11b3-43cd-90b0-f7b94dce85de",
                                "sense_id": "6316c1b4-fd72-306f-83f1-68298a73b6fd",
                                "text": ",,Het is goed begrijpbaar dat u zo boos bent, maar als u zo blijft reageren, weten wij ook niet meer hoe het nu verder moet. Nogmaals: richt u zich tot de leiding van dit bedrijf. Deze trein is trouwens ruim een halfuur te laat. U kunt formulieren invullen, zodat u een deel van uw geld kunt terugkrijgen. Die moet u ook naar de leiding van dit bedrijf sturen."
                            }
                        ]
                    }
