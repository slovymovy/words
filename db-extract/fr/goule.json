        "fr-extract.jsonl": [
            {
                "entry_id": "1ac3e9ca-1a8b-3aa5-b781-35b29d3b3b66",
                "word": "goule",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "30d608bb-1909-4739-9d5d-ef9aba93b96e",
                        "entry_id": "1ac3e9ca-1a8b-3aa5-b781-35b29d3b3b66",
                        "tags": [
                            "plural"
                        ],
                        "form": "goules"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "bf033750-248e-3376-b8ac-beaaa6ba9918",
                        "entry_id": "1ac3e9ca-1a8b-3aa5-b781-35b29d3b3b66",
                        "glosses": [
                            "Génie dévorant, d’après les superstitions du Levant, les corps morts dans les cimetières, resurrectionniste."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0cb2fd2a-701f-431e-afe3-6d24a6888d54",
                                "sense_id": "bf033750-248e-3376-b8ac-beaaa6ba9918",
                                "text": "Aux déités folles des vieux empires,\nNous opposons des diables peu tentants,\nDes loups-garous, des goules, des vampires."
                            },
                            {
                                "example_id": "02693e23-bbe0-4638-9abc-370e67fff53e",
                                "sense_id": "bf033750-248e-3376-b8ac-beaaa6ba9918",
                                "text": "Goules, dont la lèvre\nJamais ne se sèvre\nDu sang noir des morts !"
                            },
                            {
                                "example_id": "0c01903b-168e-4e99-a423-21255b89b959",
                                "sense_id": "bf033750-248e-3376-b8ac-beaaa6ba9918",
                                "text": "Elle me rappelait cette goule des Mille et une Nuits qui se mettait à table comme les autres, mais seulement pour manger quelques grains de riz avec un cure-dents."
                            },
                            {
                                "example_id": "1d337b31-358f-4fea-9548-0759f0434bef",
                                "sense_id": "bf033750-248e-3376-b8ac-beaaa6ba9918",
                                "text": "Nous dînâmes tous ensemble dans la cour, à la lueur de trois ou quatre lampes de cuivre jaune assez semblables aux lampes antiques funèbres, dont l’air de la nuit faisait vaciller la flamme en ombres et en lumières bizarres qui nous donnaient l’air de lamies et de goules déchirant des morceaux d’enfant déterré."
                            },
                            {
                                "example_id": "62b2349e-77db-4717-91f4-015e6039d4b5",
                                "sense_id": "bf033750-248e-3376-b8ac-beaaa6ba9918",
                                "text": "Ce genre de rire me semblait dépasser son objet. Il s’inspirait des vedettes de cinéma. Il s’alliait à la mode des grandes bouches de goules, tartinées de rouge jusqu’aux oreilles."
                            }
                        ]
                    },
                    {
                        "sense_id": "c2c6ddaf-6f18-3641-88c9-2b633455c2a8",
                        "entry_id": "1ac3e9ca-1a8b-3aa5-b781-35b29d3b3b66",
                        "glosses": [
                            "Un des multiples monstres de rivières qu’on pensait sévir au Moyen Âge."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f5faab5-5696-48a4-b316-aec6a7db2d64",
                                "sense_id": "c2c6ddaf-6f18-3641-88c9-2b633455c2a8",
                                "text": "La grande goule de Lyon, la goule de Poitiers…"
                            }
                        ]
                    },
                    {
                        "sense_id": "774f7490-5bb7-3b47-a34f-7236b6876a94",
                        "entry_id": "1ac3e9ca-1a8b-3aa5-b781-35b29d3b3b66",
                        "glosses": [
                            "Vampire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62f65c5d-e989-4dc4-984e-d7442229fd14",
                                "sense_id": "774f7490-5bb7-3b47-a34f-7236b6876a94",
                                "text": "Comment lui dire que cette charmante femme était une vampire, une oupire, une goule, un hideux ramassis d’ossements desséchés dont le tombeau, situé quelque part, sur les bords de la Seine, s’emplissait de crânes ayant appartenu à de malheureuses jeunes filles qu’elle avait scalpées à son profit, elle, la comtesse Marcian Gregoryi, la goule, l’oupire, la vampire ?"
                            }
                        ]
                    },
                    {
                        "sense_id": "37d21bb2-7d77-3f3a-8dc6-9f2a822415a3",
                        "entry_id": "1ac3e9ca-1a8b-3aa5-b781-35b29d3b3b66",
                        "glosses": [
                            "Serviteur d’un vampire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "041df1a2-38ac-4416-9b67-5d2756411599",
                                "sense_id": "37d21bb2-7d77-3f3a-8dc6-9f2a822415a3",
                                "text": "Les vampires créés par Dracula ainsi que les goules ou vampires créés par eux sont d’une obéissance totale au comte Dracula."
                            }
                        ]
                    },
                    {
                        "sense_id": "060957c4-8bff-3d67-b87a-b0d30e1383ef",
                        "entry_id": "1ac3e9ca-1a8b-3aa5-b781-35b29d3b3b66",
                        "glosses": [
                            "Femme criminelle et hystérique."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "e4f1ada5-709c-4a9c-be38-9cec94636529",
                                "sense_id": "060957c4-8bff-3d67-b87a-b0d30e1383ef",
                                "text": "Oui, qu’on la voie à mon bras, et elle vaut davantage, elle peut se vendre plus cher que si, goule nocturne, elle s’en allait, rôdant sur les trottoirs et fouillant l’ombre obscène des rues…"
                            },
                            {
                                "example_id": "472b0931-78ce-4c4a-9b63-034bd3381714",
                                "sense_id": "060957c4-8bff-3d67-b87a-b0d30e1383ef",
                                "text": "Le visage des femmes était dur et cruel, quelques-unes ayant dû recourir aux bons offices du fard et des couleurs artificielles pour masquer de véritables mines de goules et de furies."
                            },
                            {
                                "example_id": "e0621c37-95c0-4884-b856-34bac08e8996",
                                "sense_id": "060957c4-8bff-3d67-b87a-b0d30e1383ef",
                                "text": "J’essaie de me rappeler ce qu’ils imaginèrent pour mettre Simon à l’abri de cette goule."
                            },
                            {
                                "example_id": "8ab5068c-5d43-46fd-af45-3e375524e073",
                                "sense_id": "060957c4-8bff-3d67-b87a-b0d30e1383ef",
                                "text": "Il est évidemment pénible de voir quelqu’un qu’on a aimé, avec lequel on a partagé des nuits, des réveils, peut-être des maladies, des soucis pour la santé des enfants, se transformer en quelques jours en une sorte de goule, de harpie dotée d’une avidité financière sans limites."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c482c3fa-3ec8-4e8b-a973-d327d00fdb0e",
                        "source_entry_id": "1ac3e9ca-1a8b-3aa5-b781-35b29d3b3b66",
                        "target_lang_word": "Vamp",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vamp",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "350e45d1-db93-37c1-a669-92cbf1cc5735",
                                        "entry_id": "46ecffe0-8e10-3135-a8aa-65085f58f77d",
                                        "glosses": [
                                            "erotisch anziehende Frau, die gefühlskalt und berechnend ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5223eded-24dd-4dc4-b95c-b0bc9d983fea",
                                                "sense_id": "350e45d1-db93-37c1-a669-92cbf1cc5735",
                                                "text": "Heute macht sie auf sexy Vamp mit dunkel umrandeten Augen."
                                            },
                                            {
                                                "example_id": "fe4ffb50-494c-4000-b03b-c104364582ae",
                                                "sense_id": "350e45d1-db93-37c1-a669-92cbf1cc5735",
                                                "text": "Doch auch wenn sich Megan Fox beruflich gern als sexy Vamp und Hollywood-Diva präsentiert, liebt sie es im Privatleben unkompliziert und bequem."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "85d933c3-462c-4042-9b59-99af2ef9669f",
                        "source_entry_id": "1ac3e9ca-1a8b-3aa5-b781-35b29d3b3b66",
                        "target_lang_word": "Ghul",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ghul",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0e69b60a-bb46-3fe0-820b-803b7d8f04f4",
                                        "entry_id": "1df579ac-66a6-3591-bc17-2ae39eda2f11",
                                        "glosses": [
                                            "(im muslimisch-orientalischen Kontext) zu den Dschinn gehörendes dämonenhaftes Fabelwesen, das unterschiedliche (vor allem menschliche) Gestalten annimmt und das Reisende an abgelegenen, ansonsten unbewohnten Orten (vor allem in der Wüste) irreführt und sie so in den sicheren Tod schickt (nach europäischer Hinzudeutung ab dem 18. Jahrhundert tötet es Menschen an diesen abgelegenen Orten aktiv und verschlingt ihre Leichen oder, wenn es auf keine lebendigen Menschen trifft, treibt es vor allem auf Friedhöfen als Grabräuber und Leichenfresser sein Unwesen)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a658b05a-a4b2-4048-8a3c-15219fd0f6ac",
                                                "sense_id": "0e69b60a-bb46-3fe0-820b-803b7d8f04f4",
                                                "text": "„Abd Hajjāf, Indiens Heldenkönig, erlegt einen Ghūl mit einem Hieb, der Ghūl bittet, er möge noch ein zweites Mal nach ihm hauen, Abd Hajjāf hütet sich wohl davor und verkündet auch in einem Gedichte dieses Grundgesetz der Dämonentödtung: den Hieb nicht wiederholen ([…]).“"
                                            },
                                            {
                                                "example_id": "da991755-0c52-4e4e-af6b-89c1cb4a034e",
                                                "sense_id": "0e69b60a-bb46-3fe0-820b-803b7d8f04f4",
                                                "text": "„Da Soraya befürchtete, daß der Ghul sie nun bald einhole, öffnete sie den Seelenkasten, in dem sie einen kleinen Vogel fand. Sie nahm ihn und begann ihm den Hals umzudrehen. Da stieß der Ghul einen fürchterlichen Schrei aus und stürzte auf Soraya zu, um seine Seele aus ihren Händen zu befreien. Sie erwürgte den Vogel. Der Ghul schrie, daß es durch die ganze Wüste hallte, und fiel tot um.“"
                                            },
                                            {
                                                "example_id": "92e0deef-e069-40e7-a694-5dd07140ab3d",
                                                "sense_id": "0e69b60a-bb46-3fe0-820b-803b7d8f04f4",
                                                "text": "„Er lief und lief, überstieg Gebirge, durchquerte Wüsten und unwirtliche Wadis, bis er schließlich ins Land der Schrecken und der Ghule gelangte.“"
                                            },
                                            {
                                                "example_id": "3fc8e538-d0ef-4019-bdbf-de7795f5ccd0",
                                                "sense_id": "0e69b60a-bb46-3fe0-820b-803b7d8f04f4",
                                                "text": "„Die Tiere und Pflanzen waren gestorben, alles, was lebte und umging, außer den Ghulen und Geistern der Finsternis.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "766a397d-158f-471a-aa53-35902be6ddd5",
                        "source_entry_id": "1ac3e9ca-1a8b-3aa5-b781-35b29d3b3b66",
                        "target_lang_word": "ghoul",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ghoul",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c47341d3-3a2a-3ffc-a142-17d2283297bf",
                                        "entry_id": "e7d4930e-202a-3af6-800b-7cd945327592",
                                        "glosses": [
                                            "A demon said to feed on corpses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "255a4e7b-5e97-409e-ae6f-402cd56aae46",
                                                "sense_id": "c47341d3-3a2a-3ffc-a142-17d2283297bf",
                                                "text": "The other chamber had shown a pack of ghouls and witches over-running the world of our forefathers, but this one brought the horror right into our own daily life!."
                                            },
                                            {
                                                "example_id": "88aa04d4-9f1b-4d10-a1ae-1237b7d7d029",
                                                "sense_id": "c47341d3-3a2a-3ffc-a142-17d2283297bf",
                                                "text": "From my laboratory in the Castle east\nTo the master bedroom, where the vampires feast\nThe ghouls all came from their humble abodes\nTo get a jolt from my electrodes\nThey did the Mash\nThey did the Monster Mash."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e2440bc0-560e-3ba3-b670-9edadd8a90c4",
                                        "entry_id": "e7d4930e-202a-3af6-800b-7cd945327592",
                                        "glosses": [
                                            "A graverobber."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a0ba8830-b378-3454-9f23-c8a43abcfaa6",
                                        "entry_id": "e7d4930e-202a-3af6-800b-7cd945327592",
                                        "glosses": [
                                            "A person with an undue interest in death and corpses, or more generally in things that are revolting and repulsive."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "163bb862-786f-35c2-a3d9-66535965f050",
                                        "entry_id": "e7d4930e-202a-3af6-800b-7cd945327592",
                                        "glosses": [
                                            "A person with a callous or uncaring attitude to human life and suffering, particularly when prioritizing economic concerns."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4aa957e5-a6d7-4754-92fd-a6917a080f1a",
                                                "sense_id": "163bb862-786f-35c2-a3d9-66535965f050",
                                                "text": "Restored to bumptiousness, Peter arrived jauntily in the kitchen, to survey Mrs Dibble's body as a spectacle new to him, and remark, \"So the old trout's done herself in properly this time, I'm told. About time she did, the way she's been going on here.\" \"Shut up, you old ghoul, and help Dr Grimsby to carry her upstairs.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
