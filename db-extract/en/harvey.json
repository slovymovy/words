                "senses": [
                    {
                        "sense_id": "2a8790ac-e720-3e05-8cc1-f3d75d4ed6e2",
                        "entry_id": "4e787474-7642-33f0-9c69-2267959bb45c",
                        "glosses": [
                            "A surname transferred from the given name."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "e8308e22-6930-4dd8-89b4-4d10ba98deb4",
                                "sense_id": "2a8790ac-e720-3e05-8cc1-f3d75d4ed6e2",
                                "text": "Sarah Harvey, an NHS worker from Brighton, was also told by Vodafone that she had to pay a £5,800 bill run up after she was hit on the head by a cyclist, again in Barcelona this summer."
                            },
                            {
                                "example_id": "ec93f5ec-eb85-4d5b-955f-3c70c80b56f1",
                                "sense_id": "2a8790ac-e720-3e05-8cc1-f3d75d4ed6e2",
                                "text": "Naomi Osaka, a Japanese professional tennis player, also responded to the NHK post with a popular gif of “Family Feud” host Steve Harvey expressing bewilderment."
                            }
                        ]
                    },
                    {
                        "sense_id": "56a5f377-79a6-3d5f-bce6-7c30ccaf8a2b",
                        "entry_id": "4e787474-7642-33f0-9c69-2267959bb45c",
                        "glosses": [
                            "A male given name from the Celtic languages, in modern use often transferred back from the surname."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "2c555ad5-69f5-42c4-aed2-e500c8a0b153",
                                "sense_id": "56a5f377-79a6-3d5f-bce6-7c30ccaf8a2b",
                                "text": "Miramax Films cofounders Bob and Harvey Weinstein will end their successful, but often tumultuous, 12-year relationship with The Walt Disney Company to launch their own media company."
                            },
                            {
                                "example_id": "0aa813d9-0e99-4090-97fe-e525183341bf",
                                "sense_id": "56a5f377-79a6-3d5f-bce6-7c30ccaf8a2b",
                                "text": "After getting permisssion from my mom, I personal messaged ten different Harveys from her profile who seemed “obviously” Native and lived in Phoenix."
                            }
                        ]
                    },
