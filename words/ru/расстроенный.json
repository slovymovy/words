{
    "word_family": [
        "расстроить",
        "расстроиться",
        "расстройство",
        "расстроенно"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "315edc80-4ad9-31f6-85e5-076fc897e98a",
                    "sense_definition": "Находящийся в состоянии грусти, огорчения или душевного беспокойства.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "эмоциональное состояние",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Она пришла домой очень <w>расстроенная</w> и не хотела ни с кем разговаривать.",
                            "target_lang_translations": {
                                "en": "She came home very <w>upset</w> and didn't want to talk to anyone."
                            }
                        },
                        {
                            "text": "У него был крайне <w>расстроенный</w> вид после этого телефонного разговора.",
                            "target_lang_translations": {
                                "en": "He looked extremely <w>distressed</w> after that phone call."
                            }
                        }
                    ],
                    "synonyms": [
                        "огорчённый",
                        "опечаленный"
                    ],
                    "antonyms": [
                        "радостный",
                        "весёлый"
                    ],
                    "common_phrases": [
                        "расстроенный вид",
                        "очень расстроенный"
                    ],
                    "target_lang_definitions": {
                        "en": "Being in a state of sadness, distress, or mental anxiety."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "upset",
                                "target_lang_sense_clarification": "sad, distressed, or unhappy"
                            },
                            {
                                "target_lang_word": "distressed",
                                "target_lang_sense_clarification": "deeply anxious or worried"
                            },
                            {
                                "target_lang_word": "sad",
                                "target_lang_sense_clarification": "feeling unhappy"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1cf62fe7-c0df-3379-b90d-ffd5627e5dba",
                    "sense_definition": "Имеющий нарушенный музыкальный строй (о музыкальных инструментах).",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "музыкальные инструменты",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В углу класса стояло старое <w>расстроенное</w> пианино, на котором никто не играл.",
                            "target_lang_translations": {
                                "en": "In the corner of the classroom stood an old, <w>out-of-tune</w> piano that no one played."
                            }
                        },
                        {
                            "text": "Гитара звучала ужасно, так как её струны были совершенно <w>расстроены</w>.",
                            "target_lang_translations": {
                                "en": "The guitar sounded terrible because its strings were completely <w>out of tune</w>."
                            }
                        }
                    ],
                    "antonyms": [
                        "настроенный"
                    ],
                    "common_phrases": [
                        "расстроенное пианино",
                        "расстроенная гитара"
                    ],
                    "target_lang_definitions": {
                        "en": "Having an out-of-tune musical pitch (of musical instruments)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "out of tune",
                                "target_lang_sense_clarification": "not in the correct musical pitch"
                            },
                            {
                                "target_lang_word": "untuned",
                                "target_lang_sense_clarification": "not tuned"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "403edce9-5caf-359a-b545-7fe53cc34c29",
                    "sense_definition": "Пришедший в ненормальное, болезненное или плохое состояние (о здоровье, нервах, делах).",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "состояние здоровья и дел",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Из-за постоянного стресса на работе у него было совершенно <w>расстроенное</w> здоровье.",
                            "target_lang_translations": {
                                "en": "Due to constant stress at work, his health was completely <w>ruined</w>."
                            }
                        },
                        {
                            "text": "Его <w>расстроенные</w> нервы требовали немедленного отдыха и тишины.",
                            "target_lang_translations": {
                                "en": "His <w>shattered</w> nerves demanded immediate rest and quiet."
                            }
                        }
                    ],
                    "antonyms": [
                        "крепкий",
                        "здоровый"
                    ],
                    "common_phrases": [
                        "расстроенное здоровье",
                        "расстроенные нервы"
                    ],
                    "target_lang_definitions": {
                        "en": "Having fallen into an abnormal, unhealthy, or poor state (of health, nerves, or affairs)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "shattered",
                                "target_lang_sense_clarification": "severely damaged or exhausted, especially of nerves"
                            },
                            {
                                "target_lang_word": "ruined",
                                "target_lang_sense_clarification": "destroyed or severely damaged, of health or nerves"
                            },
                            {
                                "target_lang_word": "upset",
                                "target_lang_sense_clarification": "disturbed or unwell, of a stomach or health"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7e732b49-ff4e-31bf-a1df-1bb22f9e4b42",
                    "sense_definition": "Пришедший в упадок, беспорядок или плохое финансовое положение.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "состояние здоровья и дел",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "После кризиса ему досталось полностью <w>расстроенное</w> хозяйство, требовавшее реформ.",
                            "target_lang_translations": {
                                "en": "After the crisis, he inherited a completely <w>disorganized</w> economy that required reforms."
                            }
                        },
                        {
                            "text": "Они пытались восстановить свои <w>расстроенные</w> дела, но безуспешно.",
                            "target_lang_translations": {
                                "en": "They tried to restore their <w>ruined</w> affairs, but without success."
                            }
                        }
                    ],
                    "antonyms": [
                        "налаженный",
                        "процветающий"
                    ],
                    "common_phrases": [
                        "расстроенные дела",
                        "расстроенное хозяйство"
                    ],
                    "target_lang_definitions": {
                        "en": "Having fallen into decline, disorder, or a poor financial state."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "disorganized",
                                "target_lang_sense_clarification": "thrown into disorder"
                            },
                            {
                                "target_lang_word": "ruined",
                                "target_lang_sense_clarification": "financially destroyed or in disarray"
                            },
                            {
                                "target_lang_word": "disordered",
                                "target_lang_sense_clarification": "lacking order or organization"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4cf72e23-147f-3f03-9f81-0510e82de18e",
                    "sense_definition": "Страдательное причастие прошедшего времени совершенного вида от глагола <w>расстроить</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Планы, так тщательно <w>расстроенные</w> соперниками, пришлось полностью пересмотреть.",
                            "target_lang_translations": {
                                "en": "The plans, so carefully <w>disrupted</w> by rivals, had to be completely revised."
                            }
                        },
                        {
                            "text": "Собрание было <w>расстроено</w> неожиданным визитом проверяющих органов.",
                            "target_lang_translations": {
                                "en": "The meeting was <w>disrupted</w> by an unexpected visit from the inspection authorities."
                            }
                        }
                    ],
                    "target_lang_definitions": {
