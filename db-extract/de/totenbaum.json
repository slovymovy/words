                                "sense_id": "343aa29b-e040-376e-aba5-94054d4f3e51",
                                "text": "Der Fund eines Totenbaums begeisterte alle beteiligten Archäologen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "de193908-16a2-3f7d-b65e-1bc0e82fc0ca",
