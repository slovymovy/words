                        "examples": [
                            {
                                "example_id": "8cf0fd0a-5607-499a-8046-76ed76360940",
                                "sense_id": "43f957d5-f115-3495-aa6f-2e246e8bde1c",
                                "text": "„Stehen zwei Werte im Konflikt und lassen sie sich nicht beide realisieren, ohne einen zu gefährden, so spricht die Axiologie von einer Wertantinomie.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
