                ],
                "senses": [
                    {
                        "sense_id": "15f84160-1725-3da5-8d18-537871efb90f",
                        "entry_id": "85d9b2ea-f33a-304b-a9e5-73b191dda1c8",
                        "glosses": [
                            "onbewerkt, ruw materiaal als basis voor een product"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97be52d0-da77-4f32-b592-6260d0e4dcaa",
                                "sense_id": "15f84160-1725-3da5-8d18-537871efb90f",
                                "text": "Het lijkt misschien het makkelijkst om op aarde een kant-en-klare maanmodule te bouwen en die vervolgens naar de maan te sturen. Toch pleit Vermeulen om juist gebruik te maken van de grondstoffen van de maan zelf, om zo onafhankelijk te zijn van de aarde. Een efficiënte manier is om bijvoorbeeld gebruik te maken van de bewoonbare lavatunnels waar een vestiging in gebouwd kan worden. Op die manier biedt het oppervlak van de maan zelf voldoende bescherming"
                            },
                            {
                                "example_id": "0b4e9825-0293-4a0a-a9dd-25c03e70b668",
                                "sense_id": "15f84160-1725-3da5-8d18-537871efb90f",
                                "text": "Nederland verspilt jaarlijks 9.800 kilogram grondstoffen per inwoner."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b09647cc-ca55-4991-998c-6261e9587a0e",
                        "source_entry_id": "85d9b2ea-f33a-304b-a9e5-73b191dda1c8",
                        "source_sense_id": "15f84160-1725-3da5-8d18-537871efb90f",
                        "target_lang_word": "Rohstoff",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rohstoff",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f56d9534-72ef-3b64-9c09-d775cb584cb3",
                                        "entry_id": "0f4336b6-4f6c-38bb-b5af-1c44d2e5f883",
                                        "glosses": [
                                            "zur Verarbeitung bestimmter Ausgangsstoff"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6d07d39-27ba-4a46-9892-7f4aba014537",
                                                "sense_id": "f56d9534-72ef-3b64-9c09-d775cb584cb3",
                                                "text": "Kohle, Stein und Eisen sind Rohstoffe für die Industrie."
                                            },
                                            {
                                                "example_id": "5f4703a1-74a8-4f09-9254-466fa688ed02",
                                                "sense_id": "f56d9534-72ef-3b64-9c09-d775cb584cb3",
                                                "text": "„Auf der Suche nach neuen Rohstoffen und Energieträgern nutzen Forscher Prinzipien der Katalyse, um bisher wenig brauchbare Stoffe in nützliche umzuwandeln.“"
                                            },
                                            {
                                                "example_id": "7333ab86-ea7d-4c39-8c34-e7f31b4f3507",
                                                "sense_id": "f56d9534-72ef-3b64-9c09-d775cb584cb3",
                                                "text": "„Politiker aller Couleur palavern ständig, dass der einzige Rohstoff unseres Landes in den Köpfen unserer Kinder liege.“"
                                            },
                                            {
                                                "example_id": "c1b1bd5a-c101-4278-87c0-cc5d94599071",
                                                "sense_id": "f56d9534-72ef-3b64-9c09-d775cb584cb3",
                                                "text": "„Strenge Vorschriften hinsichtlich der Lagerung der wertvollen Rohstoffe, der bereits damals vorgeschriebenen Banderole und der Steuerkontrolle ließen sich unter der Kuppel der großen Moschee gut realisieren.“"
                                            },
                                            {
                                                "example_id": "63a6dcd0-7e80-4c1d-bdbb-031a2fe869e0",
                                                "sense_id": "f56d9534-72ef-3b64-9c09-d775cb584cb3",
                                                "text": "„Der so gewonnene Rohstoff wurde in großen Öfen geschmolzen und zu Barren gegossen, die mithilfe von Elefanten und Eisenbahn zur Küste transportiert wurden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2789761d-bdca-4043-a134-cadb0b7cfbab",
                        "source_entry_id": "85d9b2ea-f33a-304b-a9e5-73b191dda1c8",
                        "source_sense_id": "15f84160-1725-3da5-8d18-537871efb90f",
                        "target_lang_word": "Grundstoff",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Grundstoff",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dfb00526-399d-3a33-9ee9-c57bd76b9912",
                                        "entry_id": "2e8667db-d8d6-3461-afb8-5061f3a06dc0",
                                        "glosses": [
                                            "Material, aus dem höherwertige Dinge entstehen/entwickelt werden können"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c5f53f5-c42c-4f40-bdf1-a080295ebea8",
                                                "sense_id": "dfb00526-399d-3a33-9ee9-c57bd76b9912",
                                                "text": "„Schwefelsäure gehört übrigens zu jenen chemischen Grundstoffen, an deren Verbrauch sich das industrielle Niveau eines Staates am sichersten erkennen läßt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "13e993e6-82df-43d9-8284-26be778c4314",
                        "source_entry_id": "85d9b2ea-f33a-304b-a9e5-73b191dda1c8",
                        "source_sense_id": "15f84160-1725-3da5-8d18-537871efb90f",
                        "target_lang_word": "raw material",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "raw material",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f12b42d4-3838-3088-a4f8-e52bd27c278d",
                                        "entry_id": "70fcc15f-288f-3cb3-b5ca-f23f24df1fc4",
                                        "glosses": [
                                            "A material in its unprocessed, natural state considered usable for manufacture."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2f78cf81-28d6-46b5-b809-be2a7753521b",
                                                "sense_id": "f12b42d4-3838-3088-a4f8-e52bd27c278d",
                                                "text": "Petroleum is the raw material refined into various fuels and needed for countless chemicals."
                                            },
                                            {
                                                "example_id": "d52caf3e-a247-4f95-8c18-7860e966dbe7",
                                                "sense_id": "f12b42d4-3838-3088-a4f8-e52bd27c278d",
                                                "text": "The three main firms […] are increasing their output capacity and it is estimated that by 1964-5 railborne traffic will be about a third greater than the 1960 figure, reaching a total of something like 13½ million tons per annum, of which some 70 per cent will be inwards raw materials for these firms."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bc866688-578f-3f6d-bf76-56e571b85872",
                                        "entry_id": "70fcc15f-288f-3cb3-b5ca-f23f24df1fc4",
                                        "glosses": [
                                            "Any physical product serving as input to a factory or other installation which processes it."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e1d8b3ec-6410-4c79-953d-6871bb634f83",
                                                "sense_id": "bc866688-578f-3f6d-bf76-56e571b85872",
                                                "text": "The assembly plant's raw materials are finished parts from Asian suppliers."
                                            },
                                            {
                                                "example_id": "8196ab78-1e91-4f7c-b491-dcee087e2a80",
                                                "sense_id": "bc866688-578f-3f6d-bf76-56e571b85872",
                                                "text": "Teams will place all their unassembled raw materials and tools in the competition area along with two provided 5-gallon buckets of contaminated water and two provided stirring sticks."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d228412f-ea72-429c-bc9b-9d89758e50ad",
                        "source_entry_id": "85d9b2ea-f33a-304b-a9e5-73b191dda1c8",
                        "source_sense_id": "15f84160-1725-3da5-8d18-537871efb90f",
                        "target_lang_word": "matière première",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "matière première",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "362a3270-81fc-3a03-93e6-9d9cb8f8acb3",
                                        "entry_id": "0650231a-693e-3d50-a32e-647e6cd331a6",
                                        "glosses": [
                                            "La matière en général, en faisant abstraction de la forme et des autres accidents qui peuvent la modifier."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "62465bb9-26ef-3886-9b0c-ed75aa3c13b2",
                                        "entry_id": "0650231a-693e-3d50-a32e-647e6cd331a6",
                                        "glosses": [
                                            "Ressource naturelle utilisée dans la production de produits semi-finis ou finis, ou comme source d’énergie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "680fb2bd-97ac-4553-b29c-1d29fbd2f255",
                                                "sense_id": "62465bb9-26ef-3886-9b0c-ed75aa3c13b2",
                                                "text": "Le prix des matières premières étant peu considérable, la procure d'un séminaire pourrait livrer les pains d’autel à meilleur marché que ne le font les laïques , et ce serait un revenu net et assuré, que l'on pourrait appliquer à la fondation de quelques bourses."
                                            },
                                            {
                                                "example_id": "ccae7f9c-0e3b-4485-8798-a94f7c7ba867",
                                                "sense_id": "62465bb9-26ef-3886-9b0c-ed75aa3c13b2",
                                                "text": "Toutes ces plantes appartiennent à la classe des cultures dites industrielles, parce qu'elles fournissent des produits qui servent de matières premières à l'industrie."
                                            },
                                            {
                                                "example_id": "b8591ed5-4775-4b7a-be7f-64ac57309191",
                                                "sense_id": "62465bb9-26ef-3886-9b0c-ed75aa3c13b2",
                                                "text": "Pour commencer, il faudrait produire suffisamment de matières premières afin d'obtenir des biocarburants en quantités équivalentes à notre consommation d'énergie fossile."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d033dcd8-dd13-3fa7-9db6-d7cd37aaa360",
                                        "entry_id": "0650231a-693e-3d50-a32e-647e6cd331a6",
                                        "glosses": [
                                            "Toute matière sur laquelle s’exerce l’industrie, pour en augmenter l’utilité et la valeur."
                                        ],
                                        "tags": [
                                            "Industrie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "27008b99-db24-41f9-976c-157c9697d4e1",
                                                "sense_id": "d033dcd8-dd13-3fa7-9db6-d7cd37aaa360",
                                                "text": "On emploie comme matière première soit les déchets de soie naturelle […], soit la substance gélatineuse contenue dans le gros intestin du ver à soie."
                                            },
                                            {
                                                "example_id": "8733841b-a24a-4019-8112-2304486f6d84",
                                                "sense_id": "d033dcd8-dd13-3fa7-9db6-d7cd37aaa360",
                                                "text": "Les matières premières, suif, saindoux, huiles, etc., que la savonnerie emploie dans sa fabrication sont impures ; […]."
                                            },
                                            {
                                                "example_id": "c5eb37f4-f46e-4749-81dd-fd323808e693",
                                                "sense_id": "d033dcd8-dd13-3fa7-9db6-d7cd37aaa360",
                                                "text": "La mention des matières premières pour aliments des animaux incorporées aux aliments composés pour animaux par ordre pondéral décroissant fournit déjà des informations importantes sur la composition."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "96cf9a2a-ef76-3a25-88e3-3383bb29339b",
                                        "entry_id": "0650231a-693e-3d50-a32e-647e6cd331a6",
                                        "glosses": [
                                            "Toute matière sur laquelle s’exerce l’industrie, pour en augmenter l’utilité et la valeur.",
                                            "Produit introduit dans une installation de transformation du gaz naturel."
                                        ],
                                        "tags": [
                                            "Industrie",
                                            "Industrie pétrolière"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "94cfe634-7261-3367-98e5-71e8350bd935",
                                        "entry_id": "0650231a-693e-3d50-a32e-647e6cd331a6",
                                        "glosses": [
                                            "Ce qui permet d’élaborer une chose."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2a018780-ce46-494b-8a9e-3225347b6140",
                                                "sense_id": "94cfe634-7261-3367-98e5-71e8350bd935",
                                                "text": "Les frontières sont souvent indiscernables entre la réalité historique et les mythologisations qui la prennent pour matière première, notamment à partir de rumeurs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
