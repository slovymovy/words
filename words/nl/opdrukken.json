    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1dc9582f-44f7-36cf-be30-049e3d3d6084",
                    "sense_definition": "een krachtoefening uitvoeren waarbij men zich vanuit een liggende positie met de armen omhoog duwt",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "sport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij probeerde zich nog een keer <w>op</w> te <w>drukken</w>, maar hij had echt zijn grens bereikt.",
                            "target_lang_translations": {
                                "en": "He tried to <w>do a push-up</w> one more time, but he had really reached his limit."
                            }
                        },
                        {
                            "text": "Elke ochtend doet hij twintig herhalingen om zich goed <w>op</w> te <w>drukken</w>.",
                            "target_lang_translations": {
                                "en": "Every morning he does twenty repetitions to <w>push himself up</w> properly."
                            }
                        }
                    ],
                    "synonyms": [
                        "pompen"
                    ],
                    "common_phrases": [
                        "zich opdrukken"
                    ],
                    "target_lang_definitions": {
                        "en": "to perform a strength exercise by pushing oneself up from a lying position with the arms"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to do push-ups",
                                "target_lang_sense_clarification": "the physical exercise"
                            },
                            {
                                "target_lang_word": "to press up",
                                "target_lang_sense_clarification": "the action of pushing the body up"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "387466f5-1659-3a51-81b7-02b7684c545d",
                    "sense_definition": "door druk uit te oefenen iets ergens op bevestigen of vastzetten",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "bevestigen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De dopjes werden er daarna weer <w>opgedrukt</w>.",
                            "target_lang_translations": {
                                "en": "The caps were <w>pressed back on</w> afterwards."
                            }
                        },
                        {
                            "text": "Je moet de deksel stevig <w>opdrukken</w> zodat de doos goed dicht blijft zitten.",
                            "target_lang_translations": {
                                "en": "You have to <w>press</w> the lid <w>on</w> firmly so that the box stays closed."
                            }
                        }
                    ],
                    "synonyms": [
                        "vastdrukken",
                        "aandrukken"
                    ],
                    "antonyms": [
                        "lostrekken"
                    ],
                    "common_phrases": [
                        "stevig opdrukken"
                    ],
                    "target_lang_definitions": {
                        "en": "to attach or fix something onto something else by applying pressure"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to press on",
                                "target_lang_sense_clarification": "applying pressure to attach"
                            },
                            {
                                "target_lang_word": "to push on",
                                "target_lang_sense_clarification": "forcing something onto a surface"
                            },
                            {
                                "target_lang_word": "to snap on",
                                "target_lang_sense_clarification": "attaching a lid or cap by pressing"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6b6f6873-a45b-3cbf-b1ae-922fb495f230",
                    "sense_definition": "door druk uit te oefenen iets naar boven verplaatsen of verhogen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "verhogen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In de Saale-ijstijd duwde het landijs ijstongen voor zich uit die de ondergrond <w>opdrukten</w> tot stuwwallen.",
                            "target_lang_translations": {
                                "en": "During the Saale glaciation, the ice sheet pushed ice tongues ahead of it that <w>pushed up</w> the subsoil into terminal moraines."
                            }
                        },
                        {
                            "text": "De enorme kracht van de gletsjer kon de hele bodem <w>opdrukken</w>.",
                            "target_lang_translations": {
                                "en": "The enormous force of the glacier could <w>heave up</w> the entire ground."
                            }
                        }
                    ],
                    "synonyms": [
                        "omhoogduwen",
                        "opstuwen"
                    ],
                    "antonyms": [
                        "neerdrukken"
                    ],
                    "common_phrases": [
                        "de ondergrond opdrukken"
                    ],
                    "target_lang_definitions": {
                        "en": "to move something upwards or raise it by applying pressure from below"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to push up",
                                "target_lang_sense_clarification": "moving something upwards via pressure"
                            },
                            {
                                "target_lang_word": "to force up",
                                "target_lang_sense_clarification": "using great force to elevate something"
                            },
                            {
                                "target_lang_word": "to heave up",
                                "target_lang_sense_clarification": "geological or heavy lifting context"
                            }
                        ]
                    }
                }
            ]
        },
        {
