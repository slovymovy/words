                "senses": [
                    {
                        "sense_id": "a04858e8-0074-3241-9e0c-e0920ad1ec0a",
                        "entry_id": "f25226ae-93ef-3332-aa83-faf3eddc3930",
                        "glosses": [
                            "Schauspielerin, die eine/die Hauptrolle spielt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97257634-705d-4686-898d-eab4a44bc259",
                                "sense_id": "a04858e8-0074-3241-9e0c-e0920ad1ec0a",
                                "text": "„Das Drama der in China geborenen Regisseurin Chloé Zhao (38) holte zudem die Auszeichnungen für beste Regie, Kamera und für Hauptdarstellerin Frances McDormand (63).“"
                            },
                            {
                                "example_id": "79519c80-b91d-4756-a48c-13020c0b6208",
                                "sense_id": "a04858e8-0074-3241-9e0c-e0920ad1ec0a",
                                "text": "„Er interessierte sich nicht mehr für die Hauptdarstellerinnen und weigerte sich, wenn man ihn darum bat, sich die Drehbücher anzusehen oder irgendwelche Ratschläge zu geben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
