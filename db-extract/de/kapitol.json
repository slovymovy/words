                        ],
                        "form": "das Kapitol"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "058d253c-9645-3587-a9b4-262b85468b23",
                        "entry_id": "111da846-07fb-36ac-a80f-5716c94d4233",
                        "glosses": [
                            "einer der sieben Hügel im antiken Rom mit dem Tempel des Jupiters"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "dcd1d936-be83-4882-b6f1-881b6addad97",
                                "sense_id": "058d253c-9645-3587-a9b4-262b85468b23",
                                "text": "„Einer zweifelhaften Legende zufolge hielten sie noch das Kapitol, und auch das nur, weil die heiligen Gänse der Juno, der Gemahlin des obersten römischen Gottes Jupiter, die ebenfalls auf dem Kapitol verehrt wurde, durch ihr aufgeregtes Geschnatter verhindert haben sollen, daß die Kelten in einem nächtlichen Überraschungscoup auch noch diese letzte Bastion eroberten.“"
                            },
                            {
                                "example_id": "cc47ba6f-7008-4b90-9dda-a2a952c877e1",
                                "sense_id": "058d253c-9645-3587-a9b4-262b85468b23",
                                "text": "„Er ritt vom Marsfeld zum Kapitol, vor ihm die Gefangenen und auf Wagen, die reiche Beute aus Ägypten, Geld und Edelmetalle.“"
                            },
                            {
                                "example_id": "4433d9f2-a836-4118-965e-5d393788f09c",
                                "sense_id": "058d253c-9645-3587-a9b4-262b85468b23",
                                "text": "„Ich war an dem Tag, als man die Preise an die jungen Studenten der Malerei und Graphik verteilte, aufs Kapitol gegangen und erblickte dort den Maler Mengs, der zusammen mit Pompeo Bartoni und zwei oder drei anderen die Preisträger bestimmen sollte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "114dbb5d-2a35-3c65-b42d-8ea63d8f7c70",
                        "entry_id": "111da846-07fb-36ac-a80f-5716c94d4233",
                        "glosses": [
                            "Gebäude in Washington, in dem die Legislative sitzt"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c3fd01f9-3448-4d46-9102-894875a12813",
                        "source_entry_id": "111da846-07fb-36ac-a80f-5716c94d4233",
                        "source_sense_id": "058d253c-9645-3587-a9b4-262b85468b23",
                        "source_sense_description": "historisch: einer der sieben Hügel im antiken Rom mit dem Tempel des Jupiters",
                        "target_lang_word": "capitol",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "capitol",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "06a1e760-a58e-35d4-8ad1-e944b7fb052f",
                                        "entry_id": "c509c68b-7295-3558-962b-fd652fe387d4",
                                        "glosses": [
                                            "Any building or complex of buildings in which a legislature meets."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "947576da-c551-47b9-8b89-70b49cee5f55",
                                                "sense_id": "06a1e760-a58e-35d4-8ad1-e944b7fb052f",
                                                "text": "The state capitol is located smack-dab in the middle of the state's capital."
                                            },
                                            {
                                                "example_id": "906397cd-34ce-4582-8812-73241ee6c758",
                                                "sense_id": "06a1e760-a58e-35d4-8ad1-e944b7fb052f",
                                                "text": "The centre of attraction was the City Hall. Two thousand flags and more ...; 2,000 electric lights... combined to make the civic capitol gorgeous... ."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "22758d62-ba71-3bf7-90b9-9e3459558641",
                                        "entry_id": "c509c68b-7295-3558-962b-fd652fe387d4",
                                        "glosses": [
                                            "Any citadel or complex of buildings similar to the Roman Capitol, particularly Italian and Roman citadels including temples to Jupiter, Juno, and Minerva."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "381ca9e1-2ff7-39f1-a7e9-43b462c7b457",
                                        "entry_id": "c509c68b-7295-3558-962b-fd652fe387d4",
                                        "glosses": [
                                            "Alternative form of capitoul (“the former chief magistrates of Toulouse, France”)."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative",
                                            "historical"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0baf9d63-3d62-47ab-8c84-cb505a3a3f29",
                        "source_entry_id": "111da846-07fb-36ac-a80f-5716c94d4233",
                        "source_sense_id": "058d253c-9645-3587-a9b4-262b85468b23",
                        "source_sense_description": "historisch: einer der sieben Hügel im antiken Rom mit dem Tempel des Jupiters",
                        "target_lang_word": "Капитолий",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Капитолий",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "a10ef994-019a-32b5-8fe5-f2178ad701d5",
                                        "entry_id": "554c1f0e-a470-3dac-81b7-829cb3b1f4ac",
                                        "glosses": [
                                            "один из семи холмов, на которых возник Древний Рим"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d88ddde7-520b-4cdc-879d-57d0fafc580d",
                                                "sense_id": "a10ef994-019a-32b5-8fe5-f2178ad701d5",
                                                "text": "Я не намерен вам рассказывать обо всех прогулках по римским улицам, не стану описывать мой восторг при виде Колизея, Пантеона и других остатков древнего Рима, не скажу даже ни слова о том, как я был поражен огромностью и величием храма святого Петра, какие воспоминания пробудились в душе моей при виде Капитолия и с каким наслаждением я смотрел на произведения великих художников Италии, ― все это тысячу раз повторялось каждым путешественником, и этот неизбежный заказной восторг, эти приторные фразы а-ля-Дюпати и казенные восклицания давно уже опротивели и надоели всем до смерти."
                                            },
                                            {
                                                "example_id": "57f305ee-b8bb-4f8c-a9fa-af6271bc3981",
                                                "sense_id": "a10ef994-019a-32b5-8fe5-f2178ad701d5",
                                                "text": "Спустя минут пять проехали мы ворота del Popolo и были в сердце нового Рима, на Corso, улице, которая ведет к Капитолию, римскому Форуму и Палатинской горе, а оттуда уже видны арка Тита и Колизей!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "41c7be1a-1494-35c3-9b65-ca9ef893235b",
                                        "entry_id": "554c1f0e-a470-3dac-81b7-829cb3b1f4ac",
                                        "glosses": [
                                            "здание Конгресса США в Вашингтоне"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09d53df6-da92-4282-8a99-f6b52675c7ab",
                                                "sense_id": "41c7be1a-1494-35c3-9b65-ca9ef893235b",
                                                "text": "В США конгрессмен обладает иммунитетом лишь в здании Капитолия."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
