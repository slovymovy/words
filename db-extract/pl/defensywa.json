                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d8e8a800-8e20-49cc-8982-11f990880e0b",
                                                "sense_id": "da340e78-b0ab-3cd4-bcd6-6cf1d4b1b4a4",
                                                "text": "In der zweiten Hälfte des Zweiten Weltkriegs hatte die deutsche Defensive mächtig zutun."
                                            },
                                            {
                                                "example_id": "74174768-2927-491f-87b7-0a054c432577",
                                                "sense_id": "da340e78-b0ab-3cd4-bcd6-6cf1d4b1b4a4",
                                                "text": "„Wie man allerdings die eigene Existenz aus der Defensive, im friedfertigen Getöse eines Rückzugsgefechts sichern kann, das bleibt das Geheimnis unserer deutschen Nachbarn.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "be2e54a3-991a-384a-8c1d-7542fd4d1c9c",
                                        "entry_id": "afb4d95d-070d-3773-9519-c9631bb4c14d",
                                        "glosses": [
                                            "Teil einer Mannschaft, der vorwiegend gegnerische Angriffe aufhalten soll"
                                        ],
                                        "tags": [
                                            "Mannschaftssport"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "71089103-1a84-4ff9-8df4-6bbd7a1aac43",
                                                "sense_id": "be2e54a3-991a-384a-8c1d-7542fd4d1c9c",
                                                "text": "Die Defensive stand in der zweiten Halbzeit schlecht und fast jeder Ball kam durch."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
