        "fr-extract.jsonl": [
            {
                "entry_id": "8abde6a4-00bd-32c5-95dd-624ec690ba29",
                "word": "gabardine",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "78b7d81e-7c77-4a2b-a31f-257955f39e53",
                        "entry_id": "8abde6a4-00bd-32c5-95dd-624ec690ba29",
                        "tags": [
                            "plural"
                        ],
                        "form": "gabardines"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "99e5417b-8c46-33e0-81ef-ef4f68ab194f",
                        "entry_id": "8abde6a4-00bd-32c5-95dd-624ec690ba29",
                        "glosses": [
                            "Tissu présentant une côte en diagonale sur l’endroit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2344fd0b-cfec-4b51-981c-00678856aa3e",
                                "sense_id": "99e5417b-8c46-33e0-81ef-ef4f68ab194f",
                                "text": "Camille était vêtu de toile brune comme les chasseurs de France […]. Le capitaine Philps, lui, était en fine gabardine beige."
                            }
                        ]
                    },
                    {
                        "sense_id": "8e8dd860-113c-3210-9031-d8132fd62c6e",
                        "entry_id": "8abde6a4-00bd-32c5-95dd-624ec690ba29",
                        "glosses": [
                            "Manteau imperméable fabriqué en gabardine."
                        ],
                        "tags": [
                            "metonymically"
                        ],
                        "examples": [
                            {
                                "example_id": "207cd082-16d9-4c04-9950-24bbdf84796e",
                                "sense_id": "8e8dd860-113c-3210-9031-d8132fd62c6e",
                                "text": "Mais ce bonhomme dont le ventre écarte les pans flottants d’une vieille gabardine et qui abrite son crâne luisant sous un journal à demi déployé, est-ce vraiment Fred ?"
                            },
                            {
                                "example_id": "2f671a37-c103-4cfc-8ba6-a9afd527bec6",
                                "sense_id": "8e8dd860-113c-3210-9031-d8132fd62c6e",
                                "text": "J’enviais ses fils de pouvoir partager avec lui des parties de ping-pong qu’il jouait, comme Columbo, sans quitter sa gabardine."
                            },
                            {
                                "example_id": "ae97683b-932b-492b-bb5b-bb8c9b9474e0",
                                "sense_id": "8e8dd860-113c-3210-9031-d8132fd62c6e",
                                "text": "À l’arrière-plan, des hommes en gabardine appartenaient probablement aux services de sécurité américains."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "309849ba-991c-4571-8015-b8c8d996c553",
                        "source_entry_id": "8abde6a4-00bd-32c5-95dd-624ec690ba29",
                        "source_sense_id": "99e5417b-8c46-33e0-81ef-ef4f68ab194f",
                        "source_sense_description": "Tissu",
                        "target_lang_word": "Gabardine",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gabardine",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bfac6121-966f-321f-9f3b-4db6cccc897a",
                                        "entry_id": "cb32a5c0-e466-3f8b-a32b-8ed6522f9c4b",
                                        "glosses": [
                                            "dichtes Kammgarngewebe aus Wolle oder Baumwolle"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2898ccd2-19dc-4cb1-8bba-17988178e608",
                                                "sense_id": "bfac6121-966f-321f-9f3b-4db6cccc897a",
                                                "text": "Sie trug einen Mantel aus Gabardine."
                                            },
                                            {
                                                "example_id": "7777f4d2-428d-4d0a-8273-76b244700b38",
                                                "sense_id": "bfac6121-966f-321f-9f3b-4db6cccc897a",
                                                "text": "„Stoffe müssen sich gut anfassen lassen. Dafür bieten die Hersteller überraschende Materialien an: trockene Materialien wie gezwirnte Gabardine und Seersuckers oder gecrinkelte und plissierte Gazestoffe oder geblümte Mousseline bis hin zu glänzenden Oberflächen wie Satins und Nylons.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7ff38b20-c479-4510-9b27-ecbed8d01f30",
