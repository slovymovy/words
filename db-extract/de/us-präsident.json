                "senses": [
                    {
                        "sense_id": "7109a7ef-49b5-374d-b6e3-2fbaf74a8776",
                        "entry_id": "c8006630-8bbe-3b09-8ebe-1b86edf60b7f",
                        "glosses": [
                            "Staatsoberhaupt und Regierungschef der Vereinigten Staaten von Amerika (USA) und der Oberbefehlshaber der US-amerikanischen Streitkräfte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9a7b129-d8c8-43fd-bcfa-75cc4d994df9",
                                "sense_id": "7109a7ef-49b5-374d-b6e3-2fbaf74a8776",
                                "text": "Der US-Präsident hält alljährlich eine Ansprache zur Lage der Nation."
                            },
                            {
                                "example_id": "68bc1ba6-2d9f-4d93-bab3-1857c8798296",
                                "sense_id": "7109a7ef-49b5-374d-b6e3-2fbaf74a8776",
                                "text": "„US-Präsidenten werden den Diktator Mobutu als treuesten Verbündeten südlich der Sahara preisen.“"
                            },
                            {
                                "example_id": "c70d7486-848e-4176-b0cd-b6b4d2cab67f",
                                "sense_id": "7109a7ef-49b5-374d-b6e3-2fbaf74a8776",
                                "text": "„Wir hatten im vergangenen Jahr von Straßenkämpfen zwischen rechten und linken Studentengruppen gelesen, und im Februar hatte es hier Demonstrationen gegen den Besuch des US-Präsidenten gegeben.“"
                            },
                            {
                                "example_id": "b19c9d17-51da-40a8-9834-a7ad45f17155",
                                "sense_id": "7109a7ef-49b5-374d-b6e3-2fbaf74a8776",
                                "text": "„Früher inszenierten sich US-Präsidenten als einsame Kämpfer für Freiheit und Gerechtigkeit.“"
                            },
                            {
                                "example_id": "78b10eaf-7291-4c49-979e-bd28816c0dcf",
                                "sense_id": "7109a7ef-49b5-374d-b6e3-2fbaf74a8776",
                                "text": "„Nach Kriegsende druckte das »Berliner Tageblatt« einen offenen Brief Wegners an den US-Präsidenten Wilson, in dem der ehemalige Sanitätsoffizier ein Eingreifen zugunsten der Armenier verlangte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
