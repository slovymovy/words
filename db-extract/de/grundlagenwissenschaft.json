                        "glosses": [
                            "diejenige Wissenschaft, die für ein bestimmtes Studienfach die wissensmäßigen oder philosophischen Voraussetzungen bildet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59b5a70a-9ef0-4da3-95f2-204a063c0cd6",
                                "sense_id": "d13a0b78-5313-39e9-9f50-448836aac395",
                                "text": "„Die Quanteninformatik ist ein wunderbares Beispiel dafür, wie aus reinen Grundlagenwissenschaften neuartige Technologien entstehen können.“"
                            },
                            {
                                "example_id": "a20c991c-5a5b-401f-b06d-5563691d18c9",
                                "sense_id": "d13a0b78-5313-39e9-9f50-448836aac395",
                                "text": "„Die in der Grundlagenwissenschaft gewonnenen Ergebnisse haben mittlerweile Eingang in die Klinik und damit in die chirurgische Versorgung von Knorpeldefekten gefunden, die auch der Arthrose zugrunde liegen.“"
                            }
                        ],
