                ],
                "senses": [
                    {
                        "sense_id": "3fc741ed-1aea-3cac-ba51-6bc5890c3966",
                        "entry_id": "5b6a0bd8-94b9-3071-a208-d7e122a09d72",
                        "glosses": [
                            "niet volmaakt, nog een of meer gebreken hebbend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1379355d-d17a-4cd6-b0b1-3b46be33f580",
                                "sense_id": "3fc741ed-1aea-3cac-ba51-6bc5890c3966",
                                "text": "De situaties zijn vaak kolderiek, het tempo is hoog, blunders stapelen zich op elkaar, het heeft iets weg van ouderwetse slapstick, alsof je naar Charlie Chaplin kijkt. De schepping is imperfect en wij zijn dat ook, maar wie kan lachen is tenminste nog mens."
                            }
                        ]
                    },
                    {
                        "sense_id": "a14f74b9-3421-339b-ab68-216c635662ec",
                        "entry_id": "5b6a0bd8-94b9-3071-a208-d7e122a09d72",
                        "glosses": [
                            "waar bij de slotwoorden van regels die rijmen alleen de klinkers of juist alleen de medeklinkers hetzelfde zijn"
                        ],
                        "tags": [
                            "van rijm"
                        ],
                        "examples": [
                            {
                                "example_id": "31af1bd8-083c-4102-a61c-e54d5b7da9b1",
                                "sense_id": "a14f74b9-3421-339b-ab68-216c635662ec",
                                "text": "De verzen zijn onregelmatig door het gebruik van imperfect rijm en de frequente aanwending van enjambements."
                            }
                        ]
                    },
                    {
                        "sense_id": "dfc3cb80-e646-3bc9-94a0-e4811d182612",
                        "entry_id": "5b6a0bd8-94b9-3071-a208-d7e122a09d72",
                        "glosses": [
                            "gebaseerd op noten met een tijdsduur die een derde korter is"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "6227ea37-46da-446b-949a-eb22961cc508",
                                "sense_id": "dfc3cb80-e646-3bc9-94a0-e4811d182612",
                                "text": "Machauts muziek wordt gerekend tot de Ars Nova, een muzikale vernieuwingsbeweging die zich vooral in de diversificatie van het ritme heeft geuit: er werd een ritmisch systeem van zowel driedelige als tweedelige maten geformuleerd, perfect en imperfect geheten, op verschillende niveaus van grootte der notenwaarden. Men kon daarmee subtiliteiten bereiken die in moderne notatie slechts moeilijk zijn weer te geven."
                            }
                        ]
                    }
                ],
