                        ],
                        "form": "die Luftreiniger"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "491d2038-e975-3acc-b9d3-8f6b2232b7a8",
                        "entry_id": "43027658-99ab-398c-bed7-826c86d1c2a8",
                        "glosses": [
                            "Gerät welches die ihn durchströmende oder an diesem vorbei strömende Luft, reinigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e174690-fad7-4f29-a97b-712d5c510600",
                                "sense_id": "491d2038-e975-3acc-b9d3-8f6b2232b7a8",
                                "text": "In der DIN 44973-100 werden Luftreiniger und Luftbefeuchter im Teil 100 als Elektrische Haushaltsluftreiniger definiert und das Verfahren zur Messung der Gebrauchseigenschaften festgelegt."
                            },
                            {
                                "example_id": "e1e2c6b2-c988-4e75-ac16-a7c2a8585ba4",
                                "sense_id": "491d2038-e975-3acc-b9d3-8f6b2232b7a8",
                                "text": "„Dank neuester Erkenntnisse aus der Weltraum- und Nanotechnik können diese Luftreiniger in speziell konstruierten Anlagen bis zu 110.000 Kubikmeter Luft pro Stunde reinigen.“"
                            },
                            {
                                "example_id": "417b5d34-0352-4f90-bc44-aa1311433522",
                                "sense_id": "491d2038-e975-3acc-b9d3-8f6b2232b7a8",
                                "text": "„Im Rahmen der Studie wird einerseits eine Prüfnorm für Luftreiniger entwickelt. […]“"
                            },
                            {
                                "example_id": "e5fe0e38-9779-44fd-a07f-1166ad50777d",
                                "sense_id": "491d2038-e975-3acc-b9d3-8f6b2232b7a8",
                                "text": "„Elektrostatische Luftreiniger für ölhaltige Aerosole. Energieeinsparung gegenüber herkömmlichen Luftreinigern von bis zu 2000 Euro pro Jahr. Wirksamkeit und Funktion des Luftreinigers durch CFD-Strömungsanalyse belegt.“"
                            },
                            {
                                "example_id": "5a6d184a-cba7-47da-946b-99cb6bbe490b",
                                "sense_id": "491d2038-e975-3acc-b9d3-8f6b2232b7a8",
                                "text": "„Alle in Europa vertriebenen Luftreiniger müssen zunächst CE-konform sein. Lassen Sie sich die CE-Konformität vom Lieferanten jeweils durch Vorlage einer Konformitätserklärung nachweisen, die sich allerdings auch in der Bedienanleitung finden muss.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
