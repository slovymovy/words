                            {
                                "example_id": "a08d881e-dae3-4023-9367-328032f80531",
                                "sense_id": "08cc7309-faef-3eb7-af99-d2d7f5fb4d13",
                                "text": "Onderwijshervorming in Nederland In Nederland vond na mei 1945 eveneens een zuivering plaats, die in de eerste plaats was gericht tegen leden en sympathisanten van de NSB en nevenorganisaties."
                            },
                            {
                                "example_id": "d9723722-99fe-4b78-b7f2-23b0cc1b7244",
                                "sense_id": "08cc7309-faef-3eb7-af99-d2d7f5fb4d13",
                                "text": "Welke rol Brigitte precies krijgt, zal na de inauguratie op zondag duidelijk worden. Gezien haar achtergrond als lerares wordt verwacht dat ze zich zal bezighouden met onderwijshervorming. In elk geval benadrukte Macron dat, wat Brigitte ook zal doen als première dame, ze niet betaald zal worden met belastinggeld."
                            }
                        ]
