        "fr-extract.jsonl": [
            {
                "entry_id": "e953815d-7a51-3247-9be6-aad33c5fb2f5",
                "word": "aromantique",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "5316e063-5ae8-4e7e-a093-f5647fbd36b7",
                        "entry_id": "e953815d-7a51-3247-9be6-aad33c5fb2f5",
                        "tags": [
                            "plural"
                        ],
                        "form": "aromantiques"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3d5358b8-cbda-3ac0-9384-389630f04170",
                        "entry_id": "e953815d-7a51-3247-9be6-aad33c5fb2f5",
                        "glosses": [
                            "Qualifie une personne qui ne ressent pas ou peu d’attirance romantique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "13061f7a-4185-47df-8da3-d5c1fab543d4",
                                "sense_id": "3d5358b8-cbda-3ac0-9384-389630f04170",
                                "text": "Un nombre croissant d'ados refusent l'idée d'être homo ou hétéro, mais explorent des degrés de bisexualité. Un nouveau monde de nuances émerge, ou l'on peut se découvrir neutre, pansexuel, cisgenre, transgenre, demisexuel, grissexuel, aromantique, gynesexuel ou genderfluid..."
                            },
                            {
                                "example_id": "8f00a73c-e990-42e2-87de-f18ec895de5e",
                                "sense_id": "3d5358b8-cbda-3ac0-9384-389630f04170",
                                "text": "Ce qui ne veut pas dire que l’aromantisme est une absence d’émotions, ni que la personne aromantique soit « froide » ou manque d’empathie, précisent les aromantiques."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "50beb0f7-8952-440c-b0d3-17e53df39bad",
                        "source_entry_id": "e953815d-7a51-3247-9be6-aad33c5fb2f5",
                        "source_sense_id": "3d5358b8-cbda-3ac0-9384-389630f04170",
                        "target_lang_word": "aromantic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aromantic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cb2af712-c10e-3bb0-a447-7edaf7ddc4ea",
                                        "entry_id": "ed3ed67b-8acf-3ce3-ac0c-f2ee47710130",
                                        "glosses": [
                                            "That feels little or no romantic attraction to others and/or romantic desire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac38f467-f382-4071-9308-ca3a00ad4643",
                                                "sense_id": "cb2af712-c10e-3bb0-a447-7edaf7ddc4ea",
                                                "text": "Although there are aromantic asexuals who do not experience the instinctual emotional need to be in a romantic relationship, many asexuals seek monogamous partners and value intimate connections just like sexual people."
                                            },
                                            {
                                                "example_id": "70068476-196a-435c-930a-b258ef5ef7aa",
                                                "sense_id": "cb2af712-c10e-3bb0-a447-7edaf7ddc4ea",
                                                "text": "However, if she [Emily Brontë] was asexual, she likely was not aromantic (see chapter 2 for distinction between sex and romance), or at least she had a high-level understanding of romance, as she wrote one of the most intensely romantic novels of her time, Wuthering Heights."
                                            },
                                            {
                                                "example_id": "3b8979c8-e0b3-46e4-844b-a19fc217dc81",
                                                "sense_id": "cb2af712-c10e-3bb0-a447-7edaf7ddc4ea",
                                                "text": "No, just because I’m aromantic does not automatically mean I am also asexual (I happen to really like sex)."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "aromantic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d37166af-d06f-3b64-ac54-6b1cf442fdf3",
                                        "entry_id": "b40e8dac-e72a-32c7-b4a3-744379299cf4",
                                        "glosses": [
                                            "One who does not experience romantic attraction to others."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7416da59-854a-4003-94d6-ac10a6963eab",
                                                "sense_id": "d37166af-d06f-3b64-ac54-6b1cf442fdf3",
                                                "text": "Ours is a generation of aromantics, jaded about matters of the heart — often before gaining firsthand experience."
                                            },
                                            {
                                                "example_id": "898afdca-3bd8-4167-809a-2fbafd8d79ab",
                                                "sense_id": "d37166af-d06f-3b64-ac54-6b1cf442fdf3",
                                                "text": "Anna is an asexual, aromantic. Before discovering those terms, she assumed herself to merely be unusually disinterested in sex or relationships."
                                            },
                                            {
                                                "example_id": "aac2fe5d-fbe6-4e9f-976c-a709e15769f3",
                                                "sense_id": "d37166af-d06f-3b64-ac54-6b1cf442fdf3",
                                                "text": "'I let it slip one time at work that I’m an asexual aromantic [an asexual who is also not interested in making romantic attachments], and they think it’s absolutely hysterical,’ says Jean Wilson, a sales assistant and 63-year-old grandmother from Banbury. 'One of the women I work with said, “I don’t think you’ve met the right man yet.” I said: “Trish, I’m 63. If I haven’t met him by now I don’t think I’m going to.”’"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
