    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f548718c-b7d9-3eba-bca9-12c2b3bfdca7",
                    "sense_definition": "im Laufe der Zeit vorübergehen oder verstreichen",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "zeitverlauf",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wenn man gemeinsam Zeit mit Freunden verbringt, <w>vergeht</w> der Nachmittag wie im Flug."
                        },
                        {
                            "text": "Seit unserem letzten Urlaub am Meer sind schon wieder zwei Jahre <w>vergangen</w>."
                        }
                    ],
                    "synonyms": [
                        "verstreichen",
                        "vorbeigehen"
                    ],
                    "antonyms": [],
                    "common_phrases": [
                        "die Zeit vergeht",
                        "wie im Flug vergehen"
                    ]
                },
                {
                    "sense_id": "3c50ed17-b25b-3c00-b23a-6ce6421bcdaf",
                    "sense_definition": "aufhören zu existieren, allmählich schwinden oder sterben",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "schwinden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mit der Zeit wird auch der stärkste Schmerz nach einer Trennung langsam <w>vergehen</w>."
                        },
                        {
                            "text": "Die Schönheit der bunten Herbstblätter wird bei dem kalten Winterwetter bald <w>vergehen</w>."
                        }
                    ],
                    "synonyms": [
                        "dahinscheiden",
                        "dahinschwinden",
                        "sterben"
                    ],
                    "antonyms": [
                        "werden"
                    ],
                    "common_phrases": [
                        "mit der Zeit vergehen"
                    ]
                },
                {
                    "sense_id": "28be46f2-e0d2-3ca0-8357-45c32c563e49",
                    "sense_definition": "sich an jemandem oder etwas vergehen: eine Straftat oder eine unmoralische Handlung begehen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "verstoss",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der Angeklagte soll sich laut Zeugenaussagen an mehreren hilflosen Personen <w>vergangen</w> haben."
                        },
                        {
                            "text": "In der Nacht haben sich Unbekannte an den Denkmälern im Stadtpark <w>vergangen</w>."
                        }
                    ],
                    "common_phrases": [
                        "sich an jemandem vergehen"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "bcadf59a-f718-3b2f-ae86-cc6f171c4123",
                    "sense_definition": "Handlung, die gegen Regeln, Vorschriften oder moralische Grundsätze verstößt",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "verstoss",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Das wiederholte unentschuldigte Fehlen im Unterricht galt der Schulleitung als schweres <w>Vergehen</w>."
                        },
                        {
                            "text": "Für ein solches <w>Vergehen</w> gegen die internen Richtlinien wurde der Mitarbeiter sofort gekündigt."
                        }
                    ],
                    "common_phrases": [
                        "ein schweres Vergehen",
                        "ein unverzeihliches Vergehen"
                    ],
                    "synonyms": [
                        "Verstoß",
                        "Verfehlung"
                    ]
                },
                {
                    "sense_id": "7860af36-42ce-3658-b8b0-72e966a8d469",
                    "sense_definition": "Straftat von mittlerer Schwere, die im Mindestmaß mit Geldstrafe oder Freiheitsstrafe unter einem Jahr bedroht ist",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "straftat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Im deutschen Strafgesetzbuch unterscheidet man eindeutig zwischen einem Verbrechen und einem <w>Vergehen</w>."
                        },
                        {
                            "text": "Wegen eines <w>Vergehens</w> im Straßenverkehr wurde die Fahrerin zu einer Geldstrafe verurteilt."
                        }
                    ],
                    "antonyms": [
                        "Verbrechen"
                    ],
                    "common_phrases": [
                        "ein Vergehen begehen"
                    ]
                }
            ]
        }
    ]
}