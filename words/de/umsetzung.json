                {
                    "sense_id": "1894a38d-5a47-397f-9ae0-7ceea9d6427d",
                    "sense_definition": "die Zuweisung eines Mitarbeiters oder Beamten zu einem anderen Dienstposten innerhalb derselben Behörde oder Organisation",
