                    "sense_id": "2b8d1d89-b2a7-3bd6-813f-0717b78a6a2b",
                    "sense_definition": "een geheel in kleinere stukken of groepen verdelen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "verdelen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Aan het eind van de 18e eeuw werd Polen <w>opgedeeld</w> tussen zijn buren.",
                            "target_lang_translations": {
                                "en": "At the end of the 18th century, Poland was <w>partitioned</w> between its neighbors."
                            }
                        },
                        {
                            "text": "De leraar besloot de klas in kleine groepjes <w>op te delen</w> voor het project.",
                            "target_lang_translations": {
                                "en": "The teacher decided to <w>divide up</w> the class into small groups for the project."
                            }
                        }
                    ],
                    "synonyms": [
