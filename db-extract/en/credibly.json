                                "target_senses": [
                                    {
                                        "sense_id": "96a47861-fa9a-368d-b80a-69718be88396",
                                        "entry_id": "cab8a8da-2faf-3894-8dd6-29a46e6c6e0b",
                                        "glosses": [
                                            "De façon crédible."
                                        ],
