                    {
                        "sense_id": "42b60d60-1284-3239-a41e-a8c2178afa09",
                        "entry_id": "1f5a9314-0ab5-35c9-b9f8-d24e4a51888f",
                        "glosses": [
                            "Modern Standard Hindi, a standardized and Sanskritized version of the Hindustani language, which is based on Khariboli."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b80fc8e-fc82-4a54-becd-9cf76323ff3d",
                                "sense_id": "42b60d60-1284-3239-a41e-a8c2178afa09",
                                "text": "Farmer gave us the backstory on several of the words he’s invented, including “well walla,” a mix of English and Hindi. Well walla is a disparaging term for a Belter who acts like an Earther (well is for the “gravity well” of Earth, and walla means person in Hindi)."
                            }
                        ]
                    },
                    {
                        "sense_id": "590a41f6-d8e4-35fc-a52a-ac3427e38e87",
                        "entry_id": "1f5a9314-0ab5-35c9-b9f8-d24e4a51888f",
                        "glosses": [
                            "The Central Zone of Indo-Aryan languages. These are also spoken in Fiji, Guyana and as a second language by Indians in many other countries."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "cfb65b85-8988-3f0f-8f0c-e6b6416fb8a9",
                        "entry_id": "1f5a9314-0ab5-35c9-b9f8-d24e4a51888f",
                        "glosses": [
                            "All the lects in the Hindi Belt, which also includes lects that do not belong to the Central Zone of Indo-Aryan languages."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "532381cf-bf98-3297-b801-7a903d3f97d3",
                        "entry_id": "1f5a9314-0ab5-35c9-b9f8-d24e4a51888f",
                        "glosses": [
                            "A dialect spoken in Delhi, now known as Hindustani."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "89e2e1cc-9c08-472e-a5bb-20659a556255",
                                "sense_id": "532381cf-bf98-3297-b801-7a903d3f97d3",
                                "text": "‘teġh kī hindī agar talvār hai, fārsī pagḌī kī bhī dastār hai.’",
                                "translation": "Teg of Hindi is Talwar; Pagri in Persian is called Dastar",
                                "english": "Teg of Hindi is Talwar; Pagri in Persian is called Dastar"
                            }
                        ]
