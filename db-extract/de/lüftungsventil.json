                "senses": [
                    {
                        "sense_id": "a4e7c38d-954b-365b-9f72-a6a54a6bff08",
                        "entry_id": "e0b87d99-3781-35ea-8dca-7fa1b1bf2d64",
                        "glosses": [
                            "mechanische oder von Hand gesteuerte, absperrbare Durchtrittsvorrichtung für Luft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd54b8f7-aea1-4776-af01-0f6e7b1bd4fb",
                                "sense_id": "a4e7c38d-954b-365b-9f72-a6a54a6bff08",
                                "text": "„Abhilfe schafft nur, das Lüftungsventil aufzudrehen und die Heizkörper zu entlüften.“"
                            },
                            {
                                "example_id": "9cbdef65-8999-4985-94ff-b243d66771f6",
                                "sense_id": "a4e7c38d-954b-365b-9f72-a6a54a6bff08",
                                "text": "„Reduzieren Sie die Luftmenge, indem Sie das Lüftungsventil in einem ersten Schritt um eine halbe Drehung schliessen und warten Sie danach zwei Wochen, bevor Sie einen weiteren Schritt unter nehmen.“"
                            },
                            {
                                "example_id": "8ef8fbc7-c070-4dbc-ae31-2df6f2c6c274",
                                "sense_id": "a4e7c38d-954b-365b-9f72-a6a54a6bff08",
                                "text": "„Aber nicht nur das Wo, sondern auch das Wie ist beim Einsatz von Lüftungsventilen wichtig.“"
                            },
                            {
                                "example_id": "6137bb78-43ed-4d2e-97cc-a85911d7e466",
                                "sense_id": "a4e7c38d-954b-365b-9f72-a6a54a6bff08",
                                "text": "„Sie sind für das Lüftungsventil gedacht, das sich zumeist seitlich links oder rechts am Heizkörper befindet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
