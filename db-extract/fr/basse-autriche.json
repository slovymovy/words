                        "translation_id": "07e03c53-22f3-4abf-9220-78e26b4cda92",
                        "source_entry_id": "17f2d51c-fc21-3b35-a289-89eda441c809",
                        "source_sense_id": "a9c3dfc2-4340-3d4a-a013-0516d837df0a",
                        "target_lang_word": "Niederösterreich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Niederösterreich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7f4f52fb-2430-3033-b8eb-13065db175d6",
                                        "entry_id": "0ecd80a1-bc42-3d39-af0f-ffad0df9c039",
                                        "glosses": [
                                            "das flächenmäßig größte Bundesland der Republik Österreich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00d399ad-51b9-410d-a796-a5f456e441f5",
                                                "sense_id": "7f4f52fb-2430-3033-b8eb-13065db175d6",
                                                "text": "„Ein Sauvignon aus der Steiermark, ein Grüner Veltliner aus Niederösterreich und ein Blaufränkischer aus dem Burgenland“ passen laut dem auf einem Weingut in Niederösterreich groß gewordenen Finanzminister am besten zur Krise."
                                            },
                                            {
                                                "example_id": "e798ebcb-a7e1-425a-88b5-c47702f863a0",
                                                "sense_id": "7f4f52fb-2430-3033-b8eb-13065db175d6",
                                                "text": "Über den Sommer befänden sich die Profis unter den berühmten weißen Pferden \"im wohlverdienten Urlaub\" in Niederösterreich, so Gürtler."
                                            },
                                            {
                                                "example_id": "f9a948e4-f23c-4188-84ef-d69ceacaceee",
                                                "sense_id": "7f4f52fb-2430-3033-b8eb-13065db175d6",
                                                "text": "Nach der Ankündigung des Landes Niederösterreich, die Thayatalbahn zuzusperren, geht der Streit um die Verbindung in die nächste Runde."
                                            },
                                            {
                                                "example_id": "2fb37262-e874-4874-aebd-4756e97db7c6",
                                                "sense_id": "7f4f52fb-2430-3033-b8eb-13065db175d6",
                                                "text": "Eisiger Wind jagt über die Station, dort, wo das Marchfeld im Osten ausläuft, noch in Niederösterreich, aber nahe an der slowakischen Grenze."
                                            },
                                            {
                                                "example_id": "ba66a809-dd09-4ebb-a825-d2cdff08c922",
                                                "sense_id": "7f4f52fb-2430-3033-b8eb-13065db175d6",
                                                "text": "Ähnliches erzählen Unternehmer aus den Industriebetrieben, die Niederösterreichs Wirtschaft dominieren: Das Land sei wirtschaftsfreundlicher geworden, die Behörden würden nun pragmatischer arbeiten."
                                            },
                                            {
                                                "example_id": "8472de89-f454-4e78-ae0a-79bf21a1caa3",
                                                "sense_id": "7f4f52fb-2430-3033-b8eb-13065db175d6",
                                                "text": "Man taucht ein in das Niederösterreich der 1930iger Jahre, das geprägt ist von Armut, politischem Umbruch und dem aufkommenden Nationalsozialismus."
                                            },
                                            {
                                                "example_id": "4db55110-c2ba-4104-985c-81200cb51d53",
                                                "sense_id": "7f4f52fb-2430-3033-b8eb-13065db175d6",
                                                "text": "Das Niederösterreich der einfachen Landbevölkerung hingegen war und ist von einer dörflichen Struktur geprägt, wo in kleinen Siedlungseinheiten die Land- und Forstarbeit für die Herren oder für den eigenen Hof erbracht wurde."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
