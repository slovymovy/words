                    {
                        "translation_id": "de07488c-af6d-476d-a4c8-d5576eb53239",
                        "source_entry_id": "a17ccf7d-298a-37c3-aa21-3a19bdf0363f",
                        "source_sense_id": "6e0db219-7e7d-346c-a763-b5e882bc906a",
