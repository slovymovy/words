                                    {
                                        "sense_id": "40198136-abd6-31fc-9256-0d9b20ded836",
                                        "entry_id": "ee577132-752a-38ad-8749-061495b55594",
                                        "glosses": [
                                            "lade met veel verschillende kleine vakjes waarin de loden drukletters worden bewaard door de drukker; letterkast is de professionele benaming"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "459c9a52-d7c7-407d-8744-fd235e205733",
                                                "sense_id": "40198136-abd6-31fc-9256-0d9b20ded836",
                                                "text": "Wie heeft er nog steeds een letterbak aan de muur hangen? In de jaren zeventig waren de bruine stofnesten helemaal in. Wat zijn uw herinneringen aan deze toch licht bizarre manier van verzamelen?"
                                            },
                                            {
                                                "example_id": "e9d6c58c-3ec3-4e44-990d-3edbd4523ef1",
                                                "sense_id": "40198136-abd6-31fc-9256-0d9b20ded836",
                                                "text": "Ook mijn ouders ontkwamen niet aan de letterbak. Dat moet ik misschien uitleggen. De letterbakken - waarin de drukker zijn loden letters bewaarde - werden in groten getale afgedankt toen men overstapte naar de snellere en goedkopere offsetpers, en toen de Libelle of de Margriet vervolgens beschreef hoe lieflijk zo'n bak aan de muur zou hangen als je er kleine prulletjes in etaleerde, ontstond er een letterbakkenrage."
                                            }
                                        ]
                                    }
