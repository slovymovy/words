                    {
                        "translation_id": "6748ee7e-74a4-41e2-8218-985abeb788ab",
                        "source_entry_id": "e708859b-6ccd-34ce-9f7d-1487f4979f22",
                        "source_sense_id": "1a8ab43b-87d0-3b20-8b74-2e56dd2e6a1b",
                        "source_sense_description": "group of compounds in soil",
                        "target_lang_word": "próchnica",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "próchnica",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "15ae5627-5dc2-3f1e-9982-03071f00eabd",
                                        "entry_id": "411f0644-3aec-38e0-8c29-5ad8e1a50720",
                                        "glosses": [
                                            "choroba bakteryjna twardych tkanek zębów, powodująca powstawanie ubytków"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69566f08-7a79-4bfa-8c72-04ce9cc4bc56",
                                                "sense_id": "15ae5627-5dc2-3f1e-9982-03071f00eabd",
                                                "text": "Żując za dużo, narażasz swój żołądek na spore nieprzyjemności. Guma do żucia rozluźnia nerwy i mięśnie, pomaga również w walce z próchnicą. Jednak, według stomatologów, takie działanie ma tylko guma bez cukru - jej żucie między posiłkami wydatnie zmniejsza ryzyko próchnicy. Jedynym problemem jest zawarty w niej słodzik - sorbitol."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
