                ],
                "senses": [
                    {
                        "sense_id": "76b0b999-ef13-38eb-b5f0-11383c83a873",
                        "entry_id": "61c78841-ea50-3d11-8558-c30404680337",
                        "glosses": [
                            "człowiek wygłaszający mowę, dający przemówienie; ten, który zabiera głos podczas kongresu, zebrania"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bec09932-0663-4c89-b631-1a28f0fd2c6c",
                        "source_entry_id": "61c78841-ea50-3d11-8558-c30404680337",
                        "source_sense_id": "76b0b999-ef13-38eb-b5f0-11383c83a873",
                        "target_lang_word": "speaker",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "speaker",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0e475abc-2d54-3376-8f0f-51cad5df5937",
                                        "entry_id": "09f39362-80e0-3b32-bf38-17dceb2dbd3d",
                                        "glosses": [
                                            "One who speaks."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e2d9f0e-d9ec-47fc-aea7-5db654326f8d",
                                                "sense_id": "0e475abc-2d54-3376-8f0f-51cad5df5937",
                                                "text": "There were three different speakers, but I couldn't make out their accents."
                                            },
                                            {
                                                "example_id": "f5692ef3-a75f-4548-9ded-49575cfb9fb0",
                                                "sense_id": "0e475abc-2d54-3376-8f0f-51cad5df5937",
                                                "text": "This title is derived from the first verse of the book (1.1), which is a heading or colophon informing the reader who this Qoheleth was: he was the author of the book, or at least the speaker of the words which are contained in it ..."
                                            },
                                            {
                                                "example_id": "9fe402ea-2cfa-4ddc-8ff7-32b4cd38a3f3",
                                                "sense_id": "0e475abc-2d54-3376-8f0f-51cad5df5937",
                                                "text": "As [David] Bellos points out, those born as English speakers are now a minority of English speakers: most speak it as a second language. English is the world’s biggest interlanguage."
                                            },
                                            {
                                                "example_id": "4534b1aa-9fcf-4665-8369-11d481d0d803",
                                                "sense_id": "0e475abc-2d54-3376-8f0f-51cad5df5937",
                                                "text": "Each written word when spoken is mutually incomprehensible between a Mandarin speaker in Beijing and a Cantonese speaker in Hong Kong. If you think that’s odd, consider our number system: the symbol “9” is universally recognized but it’s pronounced “nine” in English and “devet” in Slovenian."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3d846129-1116-3bfe-af70-4be9bdccea18",
                                        "entry_id": "09f39362-80e0-3b32-bf38-17dceb2dbd3d",
                                        "glosses": [
                                            "Loudspeaker."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8fc469b6-5c94-4693-a1fe-dda3a6fb6c99",
                                                "sense_id": "3d846129-1116-3bfe-af70-4be9bdccea18",
                                                "text": "She lost her hearing after standing too close to the speaker at the festival."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "479d9d94-0dcf-3f7f-87dd-6b89127e2575",
                                        "entry_id": "09f39362-80e0-3b32-bf38-17dceb2dbd3d",
                                        "glosses": [
                                            "Speakerphone."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d2d89a3-200f-4523-9ee5-c3c6a625c00f",
                                                "sense_id": "479d9d94-0dcf-3f7f-87dd-6b89127e2575",
                                                "text": "you're on speaker"
                                            },
                                            {
                                                "example_id": "b806f216-ade0-4d79-9cd9-eda68c7ba621",
                                                "sense_id": "479d9d94-0dcf-3f7f-87dd-6b89127e2575",
                                                "text": "I'm gonna put you on speaker now"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "43531dd1-0ac0-3955-a88f-628d5913f00b",
                                        "entry_id": "09f39362-80e0-3b32-bf38-17dceb2dbd3d",
                                        "glosses": [
                                            "The chair or presiding officer of certain legislative bodies, such as the U.K. House of Commons or the U.S. House of Representatives."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "33998d6f-9369-36be-9c3b-a584a13c7c13",
                                        "entry_id": "09f39362-80e0-3b32-bf38-17dceb2dbd3d",
                                        "glosses": [
                                            "One who makes a speech to an audience."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c06ae97-eb80-4cf9-ad73-b681533dd53c",
                                                "sense_id": "33998d6f-9369-36be-9c3b-a584a13c7c13",
                                                "text": "Near-synonyms: orator, presenter, announcer"
                                            },
                                            {
                                                "example_id": "4ba59a91-8120-433d-b72d-1b5dc2acaeef",
                                                "sense_id": "33998d6f-9369-36be-9c3b-a584a13c7c13",
                                                "text": "hired speaker;   motivational speaker"
                                            },
                                            {
                                                "example_id": "75c53a82-6ced-44d6-9456-43404ce338be",
                                                "sense_id": "33998d6f-9369-36be-9c3b-a584a13c7c13",
                                                "text": "The company hired a motivational speaker to boost morale."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "adab38ed-fa7e-3de2-a246-6a7e80b73dae",
                                        "entry_id": "09f39362-80e0-3b32-bf38-17dceb2dbd3d",
                                        "glosses": [
                                            "A book containing passages of text for use in speeches."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "71aa6ade-020c-3134-b984-5eeac813234b",
                                        "entry_id": "09f39362-80e0-3b32-bf38-17dceb2dbd3d",
                                        "glosses": [
                                            "The producer of a given utterance, whether speech or text."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ec4966f-37ed-41bc-b1c7-0a7aa513382e",
                                                "sense_id": "71aa6ade-020c-3134-b984-5eeac813234b",
                                                "text": "The speaker spelled out the words to be communicated, letter by letter, while the reader's hand read the speaker's message. In its original form the hand alphabet assumed that both speaker and reader could already speak and spell the words ..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6595afce-46a5-36fe-a723-624b92c0c78b",
                                        "entry_id": "09f39362-80e0-3b32-bf38-17dceb2dbd3d",
                                        "glosses": [
                                            "The producer of a given utterance, whether speech or text.",
                                            "The literary character uttering the lyrics of a poem or song, as opposed to the author writing the words of that character."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "935a2544-b1bb-4b2a-bfef-6619022a514b",
                                                "sense_id": "6595afce-46a5-36fe-a723-624b92c0c78b",
                                                "text": "Popular culture often incorrectly attributes quotes from the speakers of poems or songs to the authors thereof, as when \"I took the one less traveled by\" is attributed to Robert Frost rather than to the speaker in Frost's \"The Road Not Taken\"."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "89fffa2e-c0c8-39ef-a9c6-8d9d9e61080e",
                                        "entry_id": "09f39362-80e0-3b32-bf38-17dceb2dbd3d",
                                        "glosses": [
                                            "A key on a woodwind instrument of the clarinet family (compare octave key on other instruments) which induces the instrument to overblow."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dc646c44-65a9-3e7c-a486-fb0b62f32ee4",
                                        "entry_id": "09f39362-80e0-3b32-bf38-17dceb2dbd3d",
                                        "glosses": [
                                            "A wooden pole or spike used by hedgers to carry loads on their shoulders. Possibly Dorset dialect."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2b220d34-8813-4c24-85d3-abe1e5afc029",
                                                "sense_id": "dc646c44-65a9-3e7c-a486-fb0b62f32ee4",
                                                "text": "With a speäker, or stake, he tossed the outlying scraps of fuel on the into the conflagration."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9435214c-1c16-485d-9e0f-a1bbd83aeb30",
                        "source_entry_id": "61c78841-ea50-3d11-8558-c30404680337",
                        "source_sense_id": "76b0b999-ef13-38eb-b5f0-11383c83a873",
                        "target_lang_word": "Sprecher",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sprecher",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dd7f0526-1ea1-37db-8322-9ed9ab9f2f4a",
                                        "entry_id": "2e873693-c85a-3851-a727-b0a7ee2962ce",
                                        "glosses": [
                                            "Person, die spricht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0fccede1-d511-4d7a-8e3e-520abe006be7",
                                                "sense_id": "dd7f0526-1ea1-37db-8322-9ed9ab9f2f4a",
                                                "text": "Der Sprecher dieser Sprachaufnahme hat eine besonders angenehme Stimme."
                                            },
                                            {
                                                "example_id": "b820af6e-7935-4ab6-b86e-c5ce62dfd533",
                                                "sense_id": "dd7f0526-1ea1-37db-8322-9ed9ab9f2f4a",
                                                "text": "„Der Wunsch vieler Schreiber und Sprecher nach Normierung und damit Orientierung muss als wichtiges Bedürfnis wahrgenommen und akzeptiert werden.“"
                                            },
                                            {
                                                "example_id": "c6dbc163-a1d5-46b5-b08f-630a3b2ef3ea",
                                                "sense_id": "dd7f0526-1ea1-37db-8322-9ed9ab9f2f4a",
                                                "text": "„Es gibt zahlreiche weitere Demonstrationsbeispiele, die uns gute Einblicke in die Unsicherheiten von Sprecherinnen und Sprechern vermitteln.“"
                                            },
                                            {
                                                "example_id": "a8cae3a4-7bec-45a7-8e40-49321075854e",
                                                "sense_id": "dd7f0526-1ea1-37db-8322-9ed9ab9f2f4a",
                                                "text": "„Die Fähigkeit des Sprechers, über die Regeln der Sprache nachzudenken und somit seine eigene Sprache wie auch die der anderen zu beurteilen, hat in der linguistischen Theoriebildung methodologisch eine wichtige Rolle gespielt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3338322f-7c81-366d-a6d0-0ec0d1875495",
                                        "entry_id": "2e873693-c85a-3851-a727-b0a7ee2962ce",
                                        "glosses": [
                                            "Person, die beauftragt ist, für andere zu sprechen/Person, die gewählt ist, um für einen Vorstand oder andere Gremien zu sprechen; Amt oder Ehrenamt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e3aa9f9-3150-4aed-a06e-1d2f8c5cff79",
                                                "sense_id": "3338322f-7c81-366d-a6d0-0ec0d1875495",
                                                "text": "Wir haben Hans zu unserem Sprecher bestimmt."
                                            },
                                            {
                                                "example_id": "5697f2a6-a1a3-4305-8cae-e996d823aeb2",
                                                "sense_id": "3338322f-7c81-366d-a6d0-0ec0d1875495",
                                                "text": "Da Walter nun schon in Berlin wohnt, kann er auch Sprecher in einem Ministerium werden."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "e1c3a0ea-0d8e-30c7-bf41-bdf4ab388a7e",
                                        "entry_id": "2e873693-c85a-3851-a727-b0a7ee2962ce",
                                        "glosses": [
                                            "Ansager/Kommentator/Erzähler/Moderator bei Rundfunk, Film, Fernsehen, Internetproduktionen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3661a6a9-44e0-40f6-8460-cff293e52f88",
                                                "sense_id": "e1c3a0ea-0d8e-30c7-bf41-bdf4ab388a7e",
                                                "text": "Der Sprecher hat sich ein paar Mal versprochen, da er mehrere Nachtschichten hinter sich hat und nicht konzentriert genug ist."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "d682dd7c-2136-3f9b-9df8-3b0573d0b14a",
                                        "entry_id": "2e873693-c85a-3851-a727-b0a7ee2962ce",
                                        "glosses": [
                                            "Person, die in der Lage ist, eine bestimmte Sprache zu sprechen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a0c1a9e-679d-408c-8f93-0ef5b7081bea",
                                                "sense_id": "d682dd7c-2136-3f9b-9df8-3b0573d0b14a",
                                                "text": "Er ist ein hervorragender Sprecher des Französischen."
                                            },
                                            {
                                                "example_id": "46e48422-1fdb-4b59-b18a-1b8f7699ea36",
                                                "sense_id": "d682dd7c-2136-3f9b-9df8-3b0573d0b14a",
                                                "text": "Wie viele Sprecher hat eigentlich das Armenische?"
                                            },
                                            {
                                                "example_id": "fff9fc33-4c6d-4ca6-bb85-70e86722a352",
                                                "sense_id": "d682dd7c-2136-3f9b-9df8-3b0573d0b14a",
                                                "text": "„So ist grundsätzlich die Rolle der Sprache für die Identität ihrer Sprecherinnen und Sprecher kaum zu überschätzen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
