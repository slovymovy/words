{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "df801316-9ff7-3423-92b7-328cca1c0e96",
                    "sense_definition": "A meal, especially an elaborate or formal one, or the food served at such an occasion.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "food_meal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After a long journey through the mountains, the weary travelers enjoyed a hearty <w>repast</w>.",
                            "target_lang_translations": {
                                "ru": "После долгого перехода через горы утомленные путники с удовольствием насладились сытной <w>трапезой</w>."
                            }
                        },
                        {
                            "text": "The host prepared a sumptuous <w>repast</w> of roasted meats and fine wine to welcome his guests.",
                            "target_lang_translations": {
                                "ru": "Чтобы поприветствовать гостей, хозяин приготовил роскошное <w>угощение</w> из жареного мяса и изысканного вина."
                            }
                        }
                    ],
                    "synonyms": [
                        "meal",
                        "refection"
                    ],
                    "common_phrases": [
                        "sumptuous repast",
                        "hearty repast",
                        "frugal repast",
                        "evening repast"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прием пищи, особенно плотный или торжественный, а также поданная еда; трапеза."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "трапеза",
                                "target_lang_sense_clarification": "прием пищи, застолье (книжное или торжественное)"
                            },
                            {
                                "target_lang_word": "пиршество",
                                "target_lang_sense_clarification": "обильное угощение, пышный обед"
                            },
                            {
                                "target_lang_word": "угощение",
                                "target_lang_sense_clarification": "поданная еда, стол"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "360365cb-7e6b-3712-a175-6ba5d4353fec",
                    "sense_definition": "A period or act of refreshment or rest.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "rest_refreshment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The laborers were granted a brief <w>repast</w> beneath the cool shade of the trees.",
                            "target_lang_translations": {
                                "ru": "Рабочим предоставили краткую <w>передышку</w> в прохладной тени деревьев."
                            }
                        },
                        {
                            "text": "He sought quiet <w>repast</w> away from the noise of the busy city streets.",
                            "target_lang_translations": {
                                "ru": "Он искал спокойного <w>отдыха</w> вдали от шума оживленных городских улиц."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used historically to describe rest or refreshment in general"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Период отдыха или восстановления сил; передышка (устаревшее)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отдых",
                                "target_lang_sense_clarification": "восстановление сил"
                            },
                            {
                                "target_lang_word": "передышка",
                                "target_lang_sense_clarification": "краткий перерыв, передых"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d70e7549-f1f4-3e4e-a4c3-97fcb149b4d0",
                    "sense_definition": "To eat or drink; to feast or feed, often followed by on or upon.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "eat_feed",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The wanderers sat by the campfire and <w>repasted</w> on dried fruits and roasted grain.",
                            "target_lang_translations": {
                                "ru": "Странники сидели у костра и <w>вкушали</w> сухофрукты и жареные зерна."
                            }
                        },
                        {
                            "text": "They gathered at the banquet table to <w>repast</w> after many days of deprivation.",
                            "target_lang_translations": {
                                "ru": "Они собрались за банкетным столом, чтобы <w>потрапезничать</w> после долгих дней лишений."
                            }
                        }
                    ],
                    "common_phrases": [
                        "repast on"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rare and archaic verb form"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Принимать пищу, трапезничать, насыщаться (устаревшее)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "трапезничать",
                                "target_lang_sense_clarification": "принимать пищу"
                            },
                            {
                                "target_lang_word": "вкушать",
                                "target_lang_sense_clarification": "есть, лакомиться (высокий стиль)"
                            },
                            {
                                "target_lang_word": "насыщаться",
                                "target_lang_sense_clarification": "утолять голод"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "965ab67b-cf2d-31a2-adbd-9dc04dec5027",
                    "sense_definition": "To feed or provide someone with food or refreshment.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "eat_feed",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The villagers kindly offered to <w>repast</w> the hungry soldiers who passed through town.",
                            "target_lang_translations": {
                                "ru": "Жители деревни любезно вызвались <w>накормить</w> голодных солдат, проходивших через городок."
                            }
                        },
                        {
                            "text": "The innkeeper strove to <w>repast</w> every exhausted traveler who arrived at his door.",
                            "target_lang_translations": {
                                "ru": "Трактирщик старался <w>приветить и накормить</w> каждого изможденного путника, переступавшего его порог."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rare and archaic transitive usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Кормить, угощать или предоставлять пищу кому-либо (устаревшее)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "угощать",
                                "target_lang_sense_clarification": "потчевать едой"
                            },
                            {
                                "target_lang_word": "потчевать",
                                "target_lang_sense_clarification": "радушно кормить (устаревшее)"
                            },
                            {
                                "target_lang_word": "кормить",
                                "target_lang_sense_clarification": "давать пищу"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}