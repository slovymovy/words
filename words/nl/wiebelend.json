    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "58114caa-e630-3520-9527-389cc18f1eb0",
                    "sense_definition": "Snel en onregelmatig heen en weer bewegend, niet stevig staand.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "beweging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het is erg moeilijk om drinken in te schenken in een <w>wiebelende</w> trein.",
                            "target_lang_translations": {
                                "pl": "Bardzo trudno nalać coś do picia w <w>kołyszącym się</w> pociągu."
                            }
                        },
                        {
                            "text": "Hij durfde niet op de <w>wiebelende</w> ladder te klimmen om het raam te zemen.",
                            "target_lang_translations": {
                                "pl": "Nie odważył się wejść na <w>chwiejną</w> drabinę, żeby umyć okno."
                            }
                        }
                    ],
                    "synonyms": [
                        "wankelend",
                        "schommelend"
                    ],
                    "common_phrases": [
                        "wiebelende tafel",
                        "wiebelende ladder"
                    ],
                    "target_lang_definitions": {
                        "pl": "Poruszający się szybko i nieregularnie tam i z powrotem, niestojący stabilnie; chwiejny."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "chwiejny",
                                "target_lang_sense_clarification": "niestabilny, kiwający się"
                            },
                            {
                                "target_lang_word": "kołyszący się",
                                "target_lang_sense_clarification": "poruszający się z boku na bok"
                            },
                            {
                                "target_lang_word": "chwiejący się",
                                "target_lang_sense_clarification": "o przedmiocie niemającym stabilnego oparcia"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8b595cf1-40a6-381e-b5a1-bd004ceb96e1",
                    "sense_definition": "Onvoltooid deelwoord van <w>wiebelen</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het kind zat onrustig met zijn benen <w>wiebelend</w> op de hoge stoel te wachten.",
                            "target_lang_translations": {
                                "pl": "Dziecko czekało niespokojnie na wysokim krześle, <w>machając</w> nóżkami."
                            }
                        },
                        {
                            "text": "Zenuwachtig <w>wiebelend</w> op haar voeten probeerde ze haar evenwicht te bewaren.",
                            "target_lang_translations": {
                                "pl": "Nerwowo <w>chwiejąc się</w> na nogach, próbowała utrzymać równowagę."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "deelwoord"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Imiesłów przysłówkowy współczesny od czasownika wiebelen (wiercąc się, kołysząc się, dyndając)."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "bujając",
                                "target_lang_sense_clarification": "np. nogami"
                            },
                            {
                                "target_lang_word": "kołysząc się",
                                "target_lang_sense_clarification": "chwiejąc się na boki"
                            },
                            {
                                "target_lang_word": "dyndając",
                                "target_lang_sense_clarification": "machając swobodnie nogami"
                            },
                            {
                                "target_lang_word": "wiercąc się",
                                "target_lang_sense_clarification": "ruszając się niespokojnie"
                            }
                        ]
                    }
                }
            ]
        }
    ]
