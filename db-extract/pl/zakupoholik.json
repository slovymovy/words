                                        "glosses": [
                                            "One who shops excessively; a shopping addict."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e53385e-eee2-462c-8c0a-fa862252d24b",
                                                "sense_id": "39762ac2-27bb-35b9-8695-ad4388893925",
                                                "text": "Shopaholics lose a lot of their money and possibly go broke because they've spent all of it."
                                            }
