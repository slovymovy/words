                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ebdf2e38-29e1-4e47-a1db-3e2709365e18",
                                "sense_id": "559fee81-fb6a-34f2-a5e7-7151f1989204",
                                "text": "Sprechen Sie Taroko?"
                            },
                            {
                                "example_id": "60ee6d12-5055-4f62-99cb-a382f1374e98",
                                "sense_id": "559fee81-fb6a-34f2-a5e7-7151f1989204",
                                "text": "Wie heißt das auf Taroko?"
                            },
                            {
                                "example_id": "ba500fe8-2eaa-449b-95db-668c4e0346d8",
                                "sense_id": "559fee81-fb6a-34f2-a5e7-7151f1989204",
                                "text": "Wie kann ich mein Taroko verbessern?"
                            },
                            {
                                "example_id": "155bc361-3d63-471c-b713-3e95b05b139d",
                                "sense_id": "559fee81-fb6a-34f2-a5e7-7151f1989204",
                                "text": "Das Taroko ist fast ausgestorben."
                            }
                        ],
