                    {
                        "translation_id": "b076c235-1195-4b58-85c7-2168e81a9eaf",
                        "source_entry_id": "8f7e4ab6-291e-3430-8f08-f2d8b50de880",
                        "source_sense_id": "c684f35b-98f0-3409-851a-82215d0434f4",
                        "target_lang_word": "Porträtist",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Porträtist",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "de966afc-8a29-3576-9b51-e59d14274a1c",
                                        "entry_id": "3c5d52e4-884f-36ad-a949-4a14cd5c84e3",
                                        "glosses": [
                                            "Person, die Porträts anfertigt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d925f39-92ca-40a6-b038-802d357b54ee",
                                                "sense_id": "de966afc-8a29-3576-9b51-e59d14274a1c",
                                                "text": "„Der Porträtist hatte das offenbar selbst empfunden und das Bild nicht wirklich zu Ende gemalt.“"
                                            },
                                            {
                                                "example_id": "fb688b8d-3448-463e-82b3-0c8e225372ce",
                                                "sense_id": "de966afc-8a29-3576-9b51-e59d14274a1c",
                                                "text": "„Im Übrigen war er, besonders in den frühen, ab 1936 erscheinenden Bänden seines Werkes, ein großer, um Redlichkeit bemühter Porträtist nicht nur seiner Helden, sondern auch der Gegner seiner Helden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "02b2a3f0-bc58-46e9-8be5-b21fb3dcb86e",
                        "source_entry_id": "8f7e4ab6-291e-3430-8f08-f2d8b50de880",
                        "source_sense_id": "c684f35b-98f0-3409-851a-82215d0434f4",
                        "target_lang_word": "Porträtmaler",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Porträtmaler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8da970ec-0ccf-3a88-8c04-042ad94313c9",
                                        "entry_id": "a434ddcf-0982-303f-96ef-aab8c6c7e3f8",
                                        "glosses": [
                                            "Maler, der vornehmlich oder ausschließlich Porträts anfertigt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4beb342b-01ff-4c9e-928b-368052bd7d6e",
                                                "sense_id": "8da970ec-0ccf-3a88-8c04-042ad94313c9",
                                                "text": "„Viele Porträtmaler bestätigen, dass Kunden häufig etwas von ihrem Besitz verewigt haben möchten – ganz wie frühere Patriarchen.“"
                                            },
                                            {
                                                "example_id": "66344724-5727-4f05-a2bd-bd190581d958",
                                                "sense_id": "8da970ec-0ccf-3a88-8c04-042ad94313c9",
                                                "text": "„Unausbleiblich entbrennen die heftigsten Ähnlichkeitsdebatten vor der Staffelei der Porträtmaler.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e88a3dfb-84df-4f1c-8e93-a40f3aa79901",
                        "source_entry_id": "8f7e4ab6-291e-3430-8f08-f2d8b50de880",
