{
    "word_family": [
        "sea-urchin"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1fc5588f-b6c4-37bf-8d94-8afd18d70342",
                    "sense_definition": "A poor, raggedly clothed child who lives or spends most of their time on the streets.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "child",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The young <w>urchin</w> begged for spare change near the busy train station.",
                            "target_lang_translations": {
                                "pl": "Młody <w>ulicznik</w> żebrał o drobne w pobliżu ruchliwej stacji kolejowej."
                            }
                        },
                        {
                            "text": "A homeless <w>urchin</w> was seen wandering through the market looking for food.",
                            "target_lang_translations": {
                                "pl": "Widziano bezdomnego <w>obdartusa</w> błąkającego się po targu w poszukiwaniu jedzenia."
                            }
                        }
                    ],
                    "synonyms": [
                        "waif",
                        "ragamuffin",
                        "street child"
                    ],
                    "common_phrases": [
                        "street urchin",
                        "homeless urchin"
                    ],
                    "target_lang_definitions": {
                        "pl": "Biedne, obdarte dziecko, które mieszka lub spędza większość czasu na ulicy."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "ulicznik",
                                "target_lang_sense_clarification": "biedne dziecko z ulicy"
                            },
                            {
                                "target_lang_word": "obdartus",
                                "target_lang_sense_clarification": "ubogie, brudne dziecko"
                            },
                            {
                                "target_lang_word": "znajda",
                                "target_lang_sense_clarification": "bezdomne dziecko"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "390b70d6-8a35-3535-ba9f-28d7536f329a",
                    "sense_definition": "A mischievous, playful, or cheeky child.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "child",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The little <w>urchin</w> giggled as he hid his sister's favorite toy behind the sofa.",
                            "target_lang_translations": {
                                "pl": "Mały <w>urwis</w> zachichotał, chowając ulubioną zabawkę siostry za sofą."
                            }
                        },
                        {
                            "text": "A group of noisy <w>urchins</w> ran through the garden, knocking over the flower pots.",
                            "target_lang_translations": {
                                "pl": "Grupa hałaśliwych <w>łobuziaków</w> biegała po ogrodzie, przewracając doniczki z kwiatami."
                            }
                        }
                    ],
                    "synonyms": [
                        "rascal",
                        "scamp",
                        "imp"
                    ],
                    "common_phrases": [
                        "mischievous urchin"
                    ],
                    "target_lang_definitions": {
                        "pl": "Psotne, skore do zabawy lub zuchwałe dziecko."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "urwis",
                                "target_lang_sense_clarification": "chłopiec lubiący płatać figle"
                            },
                            {
                                "target_lang_word": "łobuziak",
                                "target_lang_sense_clarification": "młody łobuz, psotnik"
                            },
                            {
                                "target_lang_word": "hultaj",
                                "target_lang_sense_clarification": "psotne dziecko"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "89040663-5398-3645-a6bd-c880c2be8b18",
                    "sense_definition": "A sea urchin, a small, round sea creature with a spiny shell.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "animal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "While diving near the coral reef, we had to be careful not to step on a spiny <w>urchin</w>.",
                            "target_lang_translations": {
                                "pl": "Podczas nurkowania w pobliżu rafy koralowej musieliśmy uważać, aby nie nadepnąć na kolczastego <w>jeżowca</w>."
                            }
                        },
                        {
                            "text": "The chef prepared a delicate dish using fresh <w>urchin</w> harvested from the local coast.",
                            "target_lang_translations": {
                                "pl": "Szef kuchni przygotował wykwintne danie ze świeżego <w>jeżowca</w> wyłowionego z lokalnego wybrzeża."
                            }
                        }
                    ],
                    "synonyms": [
                        "sea urchin"
                    ],
                    "common_phrases": [
                        "sea urchin"
                    ],
                    "target_lang_definitions": {
                        "pl": "Jeżowiec, małe, okrągłe stworzenie morskie z kolczastą skorupą."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "jeżowiec",
                                "target_lang_sense_clarification": "stworzenie morskie"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d2d43bae-adce-3803-afcb-09bf9d4ed1b3",
                    "sense_definition": "A hedgehog.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "animal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In old English folklore, the spiky <w>urchin</w> was believed to carry apples on its back.",
                            "target_lang_translations": {
                                "pl": "W dawnym angielskim folklorze wierzono, że kolczasty <w>jeż</w> nosi jabłka na grzbiecie."
                            }
                        },
                        {
                            "text": "The dog barked excitedly at the small, curled-up <w>urchin</w> in the garden hedge.",
                            "target_lang_translations": {
                                "pl": "Pies szczekał podekscytowany na małego, zwiniętego w kulkę <w>jeża</w> w ogrodowym żywopłocie."
                            }
                        }
                    ],
                    "synonyms": [
                        "hedgehog"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used historically to refer to a hedgehog"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Jeż (archaicznym językiem)."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "jeż",
                                "target_lang_sense_clarification": "archaicznym językiem"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f7594fa5-1ada-3804-9c7b-6a5a4ebaac6e",
                    "sense_definition": "A mischievous elf or sprite, sometimes believed to take the form of a hedgehog.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mythology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old play featured actors dressed as fairies, ouphes, and mischievous <w>urchins</w>.",
                            "target_lang_translations": {
                                "pl": "W starej sztuce występowali aktorzy przebrani za wróżki, elfy i psotne <w>chochliki</w>."
                            }
                        },
                        {
                            "text": "Superstitious villagers blamed the woodland <w>urchin</w> for souring their milk overnight.",
                            "target_lang_translations": {
                                "pl": "Przesądni wieśniacy obwiniali leśnego <w>skrzata</w> o to, że przez noc skwaśniało im mleko."
                            }
                        }
                    ],
                    "synonyms": [
                        "elf",
                        "sprite",
                        "goblin"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in folklore and historical literature"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Psotny elf lub duszek, czasami uważany za przybierającego postać jeża."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "chochlik",
                                "target_lang_sense_clarification": "psotny duszek"
                            },
                            {
                                "target_lang_word": "skrzat",
                                "target_lang_sense_clarification": "postać z folkloru"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "98ad99fd-1b15-3d2a-970f-c2d1e85d2a90",
                    "sense_definition": "One of a pair of small carding cylinders in a carding machine.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "machinery",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mechanic adjusted the spacing between the main drum and the rotating <w>urchin</w>.",
                            "target_lang_translations": {
                                "pl": "Mechanik wyregulował odstęp między bębnem głównym a obracającym się <w>wałkiem zgrzebnym</w>."
                            }
                        },
                        {
                            "text": "Fibers are transferred from the worker cylinder to the <w>urchin</w> during the carding process.",
                            "target_lang_translations": {
                                "pl": "Podczas procesu zgrzebna włókna są przenoszone z cylindra roboczego na <w>wałek zgrzebny</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "urchin card"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical term in textile manufacturing"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Jeden z pary małych wałków zgrzebnych w zgrzeblarce."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "wałek zgrzebny",
                                "target_lang_sense_clarification": "element maszyny włókienniczej"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2c62cc11-1cbb-3849-b720-0e93bbb2ca0a",
                    "sense_definition": "An early neutron-generating trigger device used in plutonium atomic bombs.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "military",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The physicists analyzed the design of the polonium-beryllium <w>urchin</w> used in the test.",
                            "target_lang_translations": {
                                "pl": "Fizycy przeanalizowali konstrukcję polonowo-berylowego <w>inicjatora</w> użytego w teście."
                            }
                        },
                        {
                            "text": "Inside the weapon, the <w>urchin</w> served as the initiator to start the chain reaction.",
                            "target_lang_translations": {
                                "pl": "Wewnątrz broni <w>inicjator</w> służył do rozpoczęcia reakcji łańcuchowej."
                            }
                        }
                    ],
                    "synonyms": [
                        "initiator"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "historical military technology term"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Wczesny zapalnik generujący neutrony, używany w plutonowych bombach atomowych."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "urchin",
                                "target_lang_sense_clarification": "nazwa kodowa inicjatora neutronowego"
                            },
                            {
                                "target_lang_word": "inicjator",
                                "target_lang_sense_clarification": "zapalnik neutronowy"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}