                "senses": [
                    {
                        "sense_id": "5e503fd4-19bd-3ec0-a200-b0fa3cbf601e",
                        "entry_id": "bbf3f513-9d3a-3b2b-850c-c32965d28038",
                        "glosses": [
                            "(meist aus persönlicher Perspektive verfasster) Bericht über ein absolviertes Laufereignis"
                        ],
                        "tags": [
                            "Laufsport"
                        ],
                        "examples": [
                            {
                                "example_id": "b7deeb72-0239-433d-b065-5fc7ce984986",
                                "sense_id": "5e503fd4-19bd-3ec0-a200-b0fa3cbf601e",
                                "text": "„Welche Erfahrungen ich beim Nachtmarathon in Luxemburg machte, könnt ihr in meinem Laufbericht nachlesen.“"
                            },
                            {
                                "example_id": "ab65b49c-f1f2-4525-aa7c-787dcc149de7",
                                "sense_id": "5e503fd4-19bd-3ec0-a200-b0fa3cbf601e",
                                "text": "„Da Überlänge und erzählerisches Chaos drohen, teile ich meinen Laufbericht ausnahmsweise in einige hoffentlich leichter verdauliche Häppchen ein.“"
                            },
                            {
                                "example_id": "080ebf18-c9da-49a6-9ac2-02fd7901e545",
                                "sense_id": "5e503fd4-19bd-3ec0-a200-b0fa3cbf601e",
                                "text": "„In meinem Laufbericht erfahrt ihr, wieso ich während der Veranstaltung baden ging und welches ungewöhnliche Ende dieser Wettkampf für mich bereithielt.“"
                            },
                            {
                                "example_id": "1778b34c-2a01-479b-ac40-2289e8284b9c",
                                "sense_id": "5e503fd4-19bd-3ec0-a200-b0fa3cbf601e",
                                "text": "„Wenn du also etwas zu erzählen hast und mir helfen möchtest, mit deinen Laufberichten noch mehr Leser zu erreichen, dann melde dich bei mir!“"
                            },
                            {
                                "example_id": "0602cdf9-256c-4c0b-8f21-45dec70bc90a",
                                "sense_id": "5e503fd4-19bd-3ec0-a200-b0fa3cbf601e",
                                "text": "„Wie es bei dem Mannheimer 10-km-Rennen für mich lief, erfahrt ihr in meinem Laufbericht.“"
                            },
                            {
                                "example_id": "85602742-34ce-426f-8fb5-d7e000eeaefb",
                                "sense_id": "5e503fd4-19bd-3ec0-a200-b0fa3cbf601e",
                                "text": "„Seine Laufberichte zum FKT auf dem Mosel-Our-Weg von Vianden (Luxemburg) bis Alf an der Mosel oder seinen ersten Ultra am Rursee findet ihr natürlich in den Shownotes.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
