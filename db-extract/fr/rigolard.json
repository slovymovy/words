                                                "sense_id": "d7c417ac-86f9-3d65-91b7-5b2d37bd27fc",
                                                "text": "Opa plätschert lustig in der Badewanne."
                                            },
                                            {
                                                "example_id": "9cb5b832-781c-4b70-99ed-4c55c64a5fad",
                                                "sense_id": "d7c417ac-86f9-3d65-91b7-5b2d37bd27fc",
                                                "text": "Sie hat immer ein lustiges Lied auf den Lippen."
                                            }
