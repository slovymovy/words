                    },
                    {
                        "sense_id": "8a6aced6-d7eb-32a4-a35a-a1a9e76a895d",
                        "entry_id": "49018994-1ce3-3641-988c-c78a970f6bf3",
                        "glosses": [
                            "Quantité plus ou moins consistante de quelque chose, d’un amas; → voir flòc."
                        ],
                        "tags": [
                            "Languedoc-Roussillon"
                        ],
                        "examples": [
                            {
                                "example_id": "a198c902-11db-45be-b4a5-f2e7e77908b8",
                                "sense_id": "8a6aced6-d7eb-32a4-a35a-a1a9e76a895d",
                                "text": "Ce navire échoué n’est plus qu’un floc de rouille."
                            },
                            {
                                "example_id": "23e88020-34c3-4c4a-a07f-84d27823ce98",
                                "sense_id": "8a6aced6-d7eb-32a4-a35a-a1a9e76a895d",
                                "text": "J’ai mis un floc de beurre dans les pâtes."
