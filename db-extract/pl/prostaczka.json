                "senses": [
                    {
                        "sense_id": "873de1bb-f4bb-3043-83ba-599b286f057b",
                        "entry_id": "a14a5a56-2d15-379c-a9aa-f7a9721d36c1",
                        "glosses": [
                            "osoba płci żenskiej zachowująca się w sposób prymitywny, niekulturalny bądź chamski"
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "067dbaea-69f0-400c-8a64-24f588e2aa1f",
                                "sense_id": "873de1bb-f4bb-3043-83ba-599b286f057b",
                                "text": "Otrzymawszy ogładę damy z towarzystwa, stała się jednocześnie ofiarą społeczeństwa kastowego. (…) Dla młodych mężczyzn ze środowiska, które opuściła, była zbyt uczona, dla epuzerów ze środowiska, o którym marzyła, pozostała zbyt wielką prostaczką"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2f4cb905-f367-4a89-b205-bc4db72172cd",
                        "source_entry_id": "a14a5a56-2d15-379c-a9aa-f7a9721d36c1",
                        "source_sense_id": "873de1bb-f4bb-3043-83ba-599b286f057b",
