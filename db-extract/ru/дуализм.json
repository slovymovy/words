                                        "glosses": [
                                            "ustrój polityczny polegający na złączeniu się dwóch państw na zasadzie całkowitej równorzędności ( Austro-Węgry)"
                                        ],
                                        "tags": [
                                            "np."
                                        ],
                                        "examples": [
