        "fr-extract.jsonl": [
            {
                "entry_id": "b0ba0d88-744d-3b20-a2ca-8334c11049eb",
                "word": "soliloque",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "672e50fe-1be3-475a-9dea-971b9444952a",
                        "entry_id": "b0ba0d88-744d-3b20-a2ca-8334c11049eb",
                        "tags": [
                            "plural"
                        ],
                        "form": "soliloques"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b685253f-a5b1-30f4-b2a7-f21e21903977",
                        "entry_id": "b0ba0d88-744d-3b20-a2ca-8334c11049eb",
                        "glosses": [
                            "Monologue d’une personne qui réfléchit à haute voix."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e4d21f0b-c904-4986-b80f-05ea13f6633a",
                                "sense_id": "b685253f-a5b1-30f4-b2a7-f21e21903977",
                                "text": "Je dois savoir endurer le ridicule et le blâme, pourvu qu’ils ne soient pas mérités. Après ce petit soliloque, je me raffermis si bien que j’aurais été intrépide, si j’eusse eu besoin de l’être."
                            },
                            {
                                "example_id": "22b094d4-4343-4b38-9e4a-d3f7823a3ad2",
                                "sense_id": "b685253f-a5b1-30f4-b2a7-f21e21903977",
                                "text": "Il parlait, il parlait tout seul, le jour, la nuit, campé devant les choses inertes, les poteaux télégraphiques et les arbres des chemins, dans des soliloques qui n’en finissaient pas."
                            },
                            {
                                "example_id": "64d44b2b-188d-49c7-be2c-072b8b70add3",
                                "sense_id": "b685253f-a5b1-30f4-b2a7-f21e21903977",
                                "text": "Colombe aurait donné n’importe quoi pour interrompre ce soliloque..."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "48a0579d-1530-4aa9-9ea5-15836b2a3b32",
                        "source_entry_id": "b0ba0d88-744d-3b20-a2ca-8334c11049eb",
                        "source_sense_id": "b685253f-a5b1-30f4-b2a7-f21e21903977",
                        "target_lang_word": "Selbstgespräch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Selbstgespräch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fcd33539-97e0-3e27-b3be-a6a914934578",
                                        "entry_id": "9d25c926-bca7-34d2-a3e8-53b5fe2fedda",
                                        "glosses": [
                                            "ein Gespräch mit sich selbst; Gespräch, das sich an keinen anderen Gesprächspartner richtet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b06284d4-bdfb-42d2-975b-1135dd8b26b4",
                                                "sense_id": "fcd33539-97e0-3e27-b3be-a6a914934578",
                                                "text": "Er führte ein Selbstgespräch."
                                            },
                                            {
                                                "example_id": "36ddb1d2-fcdd-40fc-8973-701425b585f5",
                                                "sense_id": "fcd33539-97e0-3e27-b3be-a6a914934578",
                                                "text": "„Selbstgespräche können natürlich auch still geführt werden, so daß Sie keinen Laut äußern und ein Kassettenrekorder entsprechend auch nichts aufzeichnen kann.“"
                                            },
                                            {
                                                "example_id": "cf18a6f5-7f4d-464f-974b-fc987952210f",
                                                "sense_id": "fcd33539-97e0-3e27-b3be-a6a914934578",
                                                "text": "„Unter solchem Selbstgespräche trat er vom Fenster zurück und ließ alles, was der Tag gebracht, noch einmal an seiner Seele vorüberziehen.“"
                                            },
                                            {
                                                "example_id": "84cc47d2-993b-4d1a-a633-d2851be55c82",
                                                "sense_id": "fcd33539-97e0-3e27-b3be-a6a914934578",
                                                "text": "„Aber sie schien keine Antwort zu erwarten, sie sank teilnahmslos zurück und bewegte die Lippen in lautlosem Selbstgespräch.“"
                                            },
                                            {
                                                "example_id": "bc026b33-35f8-468f-86a1-aaaa90906753",
                                                "sense_id": "fcd33539-97e0-3e27-b3be-a6a914934578",
                                                "text": "„Dem Selbstgespräche machte die eintretende Indianerin ein Ende.“"
                                            },
                                            {
                                                "example_id": "167492da-1c06-4e3d-bd22-06ae7255af91",
                                                "sense_id": "fcd33539-97e0-3e27-b3be-a6a914934578",
                                                "text": "„Sabine hatte schon begonnen, im Geiste Selbstgespräche mit diesen beiden Schattengestalten zu führen.“"
                                            },
                                            {
                                                "example_id": "b106eb32-d127-415f-9ad6-6d1a877ca0cd",
                                                "sense_id": "fcd33539-97e0-3e27-b3be-a6a914934578",
                                                "text": "„Sabine führt wieder einmal Selbstgespräche, während sie im Wohnzimmer aufgeregt zwischen ihrer Arbeitsecke und der Terrassentür hin und her rennt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "58a62705-1cf1-43d8-8811-ee8e0023a02b",
                        "source_entry_id": "b0ba0d88-744d-3b20-a2ca-8334c11049eb",
                        "source_sense_id": "b685253f-a5b1-30f4-b2a7-f21e21903977",
                        "target_lang_word": "soliloquy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "soliloquy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "04140fff-ec2d-30f0-afa6-357cd0528eeb",
                                        "entry_id": "fe5c568e-1b34-36ca-8190-3a8908c70284",
                                        "glosses": [
                                            "The act of a character speaking to themselves so as to reveal their thoughts to the audience."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aa802582-a42e-4ccd-9f9a-7026ef46cb83",
                                                "sense_id": "04140fff-ec2d-30f0-afa6-357cd0528eeb",
                                                "text": "At the end of the second act the main villain gave a soliloquy detailing his plans to attack the protagonist."
                                            },
                                            {
                                                "example_id": "1731fceb-fc95-464f-9cfb-8708034855d8",
                                                "sense_id": "04140fff-ec2d-30f0-afa6-357cd0528eeb",
                                                "text": "Yet if I were to say […] that Hamlet's soliloquy had been much over-rated, it would not be said, on this account, that I was unable to appreciate Shakespeare."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e2c6d848-ff56-3fb9-80db-1f03a1b774ca",
                                        "entry_id": "fe5c568e-1b34-36ca-8190-3a8908c70284",
                                        "glosses": [
                                            "A speech or written discourse in this form."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff36bbfc-3044-436d-bb00-cd964e714d38",
                                                "sense_id": "e2c6d848-ff56-3fb9-80db-1f03a1b774ca",
                                                "text": "The feeling of Singleton's bosom grew heightened in its tone of melancholy, and a more passionate emphasis of thought broke forth in his half-muttered soliloquy:— ¶\"How I remember as I look […]"
                                            },
                                            {
                                                "example_id": "44372d0d-9a64-446d-af4b-378fa65023af",
                                                "sense_id": "e2c6d848-ff56-3fb9-80db-1f03a1b774ca",
                                                "text": "Here is a very over-simplified example, this time expressed in the form of a subjective soliloquy rather than a computer simulation."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "soliloquy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4cf2e5c7-a1af-3906-99c6-574d9e86825c",
                                        "entry_id": "03676629-5020-3c86-a65f-e194b7258915",
                                        "glosses": [
                                            "To issue a soliloquy."
                                        ],
