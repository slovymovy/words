                ],
                "senses": [
                    {
                        "sense_id": "74acfa7d-22e3-3e62-b00a-be4744a3905a",
                        "entry_id": "02f73993-8836-3339-bbc8-e3c0e05ed3a7",
                        "glosses": [
                            "durch Ereignisse eines Lebens angeeignete Erkenntnisse"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a90483e2-a389-4c8a-996c-e25bd099be03",
                                "sense_id": "74acfa7d-22e3-3e62-b00a-be4744a3905a",
                                "text": "Mit über sechzig Jahren hatte er trotzdem erst wenig Lebenserfahrung."
                            },
                            {
                                "example_id": "e1a35bb8-0f64-4eb0-9808-9338b719b3d0",
                                "sense_id": "74acfa7d-22e3-3e62-b00a-be4744a3905a",
                                "text": "„Ich habe keine Eigentumswohnung, keine lange Karriere und wenig Lebenserfahrung vorzuweisen.“"
                            },
                            {
                                "example_id": "8808b15a-6639-4e0d-a289-1091be49bc3b",
                                "sense_id": "74acfa7d-22e3-3e62-b00a-be4744a3905a",
                                "text": "„Er verachtete sie angesichts seines Alters und seiner Lebenserfahrung.“"
                            },
                            {
                                "example_id": "32460d59-3196-4d62-922c-3654c48f96b8",
                                "sense_id": "74acfa7d-22e3-3e62-b00a-be4744a3905a",
                                "text": "„Was ich gewann, betraf meine Lebenserfahrung.“"
                            },
                            {
                                "example_id": "9ea7f1b0-016e-48e4-82a3-6885586f356b",
                                "sense_id": "74acfa7d-22e3-3e62-b00a-be4744a3905a",
                                "text": "„Der Alte erfüllt nämlich eine wesentliche Aufgabe; er ist überaus nützlich, weil ihm wie dem einhundertundzehn Jahre alten Ptahhotep die Aufgabe zufällt, seine große Lebenserfahrung und Weisheit an die Jungen weiterzugeben.“"
                            },
                            {
                                "example_id": "ad6eaf9b-cd66-4f8e-8390-0fe0ff6f1186",
                                "sense_id": "74acfa7d-22e3-3e62-b00a-be4744a3905a",
                                "text": "„Wenn ich mehr Lebenserfahrung hab, dann hab ich einen Preis dafür bezahlt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
