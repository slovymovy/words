{
    "word_family": [
        "thudding"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e80ec64e-7dc4-3afc-85cf-b4e6c6e54a49",
                    "sense_definition": "The sound of a dull impact.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "impact sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I heard a dull <w>thud</w> far up the passage and knew that someone had jumped down.",
                            "target_lang_translations": {
                                "ru": "Я услышал глухой <w>звук удара</w> в конце коридора и понял, что кто-то спрыгнул вниз."
                            }
                        },
                        {
                            "text": "The heavy book hit the floor with a <w>thud</w> that echoed through the quiet library.",
                            "target_lang_translations": {
                                "ru": "Тяжелая книга упала на пол с глухим <w>стуком</w>, который эхом разнесся по тихой библиотеке."
                            }
                        }
                    ],
                    "synonyms": [
                        "flump",
                        "plunk",
                        "thump",
                        "bump"
                    ],
                    "common_phrases": [
                        "dull thud",
                        "heavy thud",
                        "land with a thud"
                    ],
                    "target_lang_definitions": {
                        "ru": "Звук глухого удара."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "глухой звук",
                                "target_lang_sense_clarification": "звук падения или удара"
                            },
                            {
                                "target_lang_word": "глухой стук",
                                "target_lang_sense_clarification": "звук удара о поверхность"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "859d3279-f544-3765-8d80-72fe628460a5",
                    "sense_definition": "A hard, dull impact or blow.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "impact",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He felt the <w>thud</w> of the heavy object against his shoulder as he turned the corner.",
                            "target_lang_translations": {
                                "ru": "Он почувствовал <w>удар</w> тяжелого предмета о плечо, когда поворачивал за угол."
                            }
                        },
                        {
                            "text": "The boxer felt a solid <w>thud</w> when the punch landed on his ribs.",
                            "target_lang_translations": {
                                "ru": "Боксер почувствовал сильный глухой <w>удар</w>, когда кулак попал ему по ребрам."
                            }
                        }
                    ],
                    "common_phrases": [
                        "feel the thud",
                        "solid thud"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сильный, глухой удар или толчок."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "глухой удар",
                                "target_lang_sense_clarification": "физическое ощущение удара"
                            },
                            {
                                "target_lang_word": "толчок",
                                "target_lang_sense_clarification": "ощутимое воздействие"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "88986c40-2afb-3a13-8b46-201a9cc3d155",
                    "sense_definition": "A slower, dull impact with a wide surface area, often contrasted with a sharp sting.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "impact",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soft flogger created a sensation of a solid <w>thud</w> rather than a sharp sting.",
                            "target_lang_translations": {
                                "ru": "Мягкая плеть создавала ощущение плотного глухого <w>удара</w>, а не резкого жжения."
                            }
                        },
                        {
                            "text": "A pillowcase is almost all <w>thud</w> and very little sting in the sensations it creates.",
                            "target_lang_translations": {
                                "ru": "Наволочка дает почти исключительно ощущение глухого <w>удара</w> и почти никакого жжения."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Медленный, глухой удар большой площадью поверхности, часто противопоставляемый резкому жжению."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "глухой удар",
                                "target_lang_sense_clarification": "ощущение тяжелого воздействия без боли"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "584866ec-643f-34c5-bac7-b832af6d2211",
                    "sense_definition": "To make the sound of a dull impact.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "impact sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Two arrows <w>thudded</w> into the wooden target one after another.",
                            "target_lang_translations": {
                                "ru": "Две стрелы одна за другой глухо <w>ударились</w> в деревянную мишень."
                            }
                        },
                        {
                            "text": "The dog's tail <w>thudded</w> in perfect time against the wooden floor as he wagged it.",
                            "target_lang_translations": {
                                "ru": "Хвост собаки ритмично <w>стучал</w> по деревянному полу, пока она им виляла."
                            }
                        }
                    ],
                    "synonyms": [
                        "flump",
                        "plunk",
                        "thump",
                        "beat"
                    ],
                    "common_phrases": [
                        "thud against",
                        "thud into"
                    ],
                    "target_lang_definitions": {
                        "ru": "Издавать звук глухого удара."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "глухо стучать",
                                "target_lang_sense_clarification": "издавать звук при ударе"
                            },
                            {
                                "target_lang_word": "шлепаться",
                                "target_lang_sense_clarification": "падать с глухим звуком"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "c3128043-c0f3-3103-8776-ea320f88e3c8",
                    "sense_definition": "A nickname for the Republic F-105 Thunderchief jet ground attack fighter.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "aircraft",
                    "name_type": "other",
                    "examples": [
                        {
                            "text": "Of the hundreds of <w>Thuds</w> built for the military, many were lost during the conflict.",
                            "target_lang_translations": {
                                "ru": "Из сотен <w>«Тадов»</w>, построенных для армии, многие были потеряны во время конфликта."
                            }
                        },
                        {
                            "text": "Pilots knew that <w>Thuds</w> were very fast and could take a beating during missions.",
                            "target_lang_translations": {
                                "ru": "Пилоты знали, что <w>«Тады»</w> были очень быстрыми и могли выдерживать серьезные повреждения во время заданий."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Military slang for a specific aircraft"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прозвище истребителя-бомбардировщика Republic F-105 Thunderchief."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "«Тад»",
                                "target_lang_sense_clarification": "военное прозвище самолета"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}