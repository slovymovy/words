                        "examples": [
                            {
                                "example_id": "d45ef660-c928-4195-af49-ef61dbf8005d",
                                "sense_id": "9548b82c-c753-3bfd-9217-5de4af614f6b",
                                "text": "„Wir versprachen, im Sommer wiederzukommen, und die Bäuerin gab mir noch eine hausgemachte Mettwurst und eine Kerze, eine Osterkerze vom vergangenen Jahr, dem Todesjahr, mit auf den Weg.“"
                            },
                            {
                                "example_id": "d75570c7-ea32-49c6-90d1-c18068433ee4",
                                "sense_id": "9548b82c-c753-3bfd-9217-5de4af614f6b",
                                "text": "„1915, im Todesjahr seines Vaters, erschienen Walter Mehrings Gedichte im »Sturm«.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
