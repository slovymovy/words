                    "sense_id": "1ad550df-711c-355b-a953-d65c6beda8f7",
                    "sense_definition": "stoppen met een activiteit of niet langer meedoen aan een proces of afspraak",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "stoppen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De marathon was erg zwaar en veel lopers moesten halverwege <w>afhaken</w>.",
                            "target_lang_translations": {
                                "en": "The marathon was very tough and many runners had to <w>drop out</w> halfway through.",
                                "fr": "Le marathon était très dur et de nombreux coureurs ont dû <w>abandonner</w> à mi-chemin."
                            }
                        },
                        {
                            "text": "Als de prijs nog verder stijgt, zullen veel potentiële kopers helaas <w>afhaken</w>.",
                            "target_lang_translations": {
                                "en": "If the price rises even further, many potential buyers will unfortunately <w>pull out</w>.",
                                "fr": "Si le prix augmente encore, de nombreux acheteurs potentiels vont malheureusement <w>se désister</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "opgeven",
                        "uittreden",
                        "stoppen"
                    ],
                    "antonyms": [
                        "aanhaken"
                    ],
                    "common_phrases": [
                        "vroegtijdig afhaken",
                        "moeten afhaken"
                    ],
                    "target_lang_definitions": {
                        "en": "to stop an activity or no longer participate in a process or agreement",
                        "fr": "arrêter une activité ou ne plus participer à un processus ou à un accord"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to drop out",
