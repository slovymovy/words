                                        "sense_id": "49e2246b-59f2-3e88-a2b1-9a11d37c1c76",
                                        "entry_id": "5d24406a-9004-31ff-bc57-ef6af01dd792",
                                        "glosses": [
                                            "formlose (meist feuchte) zusammengeballte Masse, oft formbaren Materials"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e71c5cd-c006-4db4-a78b-16e53d741c72",
                                                "sense_id": "49e2246b-59f2-3e88-a2b1-9a11d37c1c76",
                                                "text": "Die Kinder formen den feuchten Lehm mit ihren Händen zu einem Klumpen."
                                            },
                                            {
                                                "example_id": "f308f4de-eb07-436d-b562-860b7911efd9",
                                                "sense_id": "49e2246b-59f2-3e88-a2b1-9a11d37c1c76",
                                                "text": "Aus dem Teig wird ein Klumpen geformt und man lässt ihn für eine Stunde an einem warmen Platz gehen."
                                            },
                                            {
                                                "example_id": "64069136-dc8c-42b0-aea0-c99be2378793",
                                                "sense_id": "49e2246b-59f2-3e88-a2b1-9a11d37c1c76",
                                                "text": "Als der Bauer vom Feld kam hingen Klumpen aus Erde an seinen Schuhen und an der Hose."
                                            },
                                            {
                                                "example_id": "8f0e3fa3-be7c-4535-a97e-60cae9a43367",
                                                "sense_id": "49e2246b-59f2-3e88-a2b1-9a11d37c1c76",
                                                "text": "„Solowjew blieb stehen, um einen Klumpen schmutzigen Schnee aufzuheben, der den Sonnenstrahlen in einer kleinen Mulde entgangen war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
