                    {
                        "translation_id": "64853631-4015-4bed-b71d-1c8af0323973",
                        "source_entry_id": "f4d682f7-52fe-3e7b-a1d2-16be26d31345",
                        "source_sense_id": "24a41a25-2d4d-3e3f-a8cf-0e6f9a99c85f",
                        "source_sense_description": "in Unruhe versetzend; alarmierend, beunruhigend, bedrohlich",
                        "target_lang_word": "bedrohlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bedrohlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5388437a-f0c3-375a-879b-d281e23e7a84",
                                        "entry_id": "2bddb7a7-e853-300d-b980-c2437a87918e",
                                        "glosses": [
                                            "eine Empfindung von kurz bevorstehender Gefahr oder Not"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c661fba4-af4a-4469-bbd3-e5f60a8288f4",
                                                "sense_id": "5388437a-f0c3-375a-879b-d281e23e7a84",
                                                "text": "Jeder Zweite empfindet den Islam als bedrohlich"
                                            },
                                            {
                                                "example_id": "c4a702d3-6e20-4672-9b10-7a2648a72be8",
                                                "sense_id": "5388437a-f0c3-375a-879b-d281e23e7a84",
                                                "text": "Die C02-Emissionen steigen so bedrohlich, dass wir einen Klimawandel verursachen."
                                            },
                                            {
                                                "example_id": "762e833e-8220-46bd-9143-ffeae3eb3914",
                                                "sense_id": "5388437a-f0c3-375a-879b-d281e23e7a84",
                                                "text": "Die Höhe der Staatsverschuldung in Europa nimmt bedrohliche Ausmaße an."
                                            },
                                            {
                                                "example_id": "a8c811e3-1078-40b0-9c83-2949faa68898",
                                                "sense_id": "5388437a-f0c3-375a-879b-d281e23e7a84",
                                                "text": "Manchmal schweben sie hell und luftig über den blauen Sommerhimmel, manchmal türmen sie sich dunkel und bedrohlich am Horizont auf: Wolken."
                                            },
                                            {
                                                "example_id": "bcdd28d9-0840-4d92-acc3-6d1f70810284",
                                                "sense_id": "5388437a-f0c3-375a-879b-d281e23e7a84",
                                                "text": "Hochwasser: Bei Sonnenschein und einem strahlend blauen Himmel wirkt das Ganze sehr entspannt und wenig bedrohlich. Doch die Elbe ist im Stadtteil Kleinwittenberg dem Ufer schon bedrohlich nahegekommen, und das ist von keinem Deich geschützt. Lediglich eine schmale Straße trennt die ersten Häuser von der Elbe, die stündlich breiter wird."
                                            },
                                            {
                                                "example_id": "0837ceaa-3940-4389-bc3f-fb0abe7921b2",
                                                "sense_id": "5388437a-f0c3-375a-879b-d281e23e7a84",
                                                "text": "Die Regisseure setzten suggestive Schwarz-Weiß-Bilder, gespenstisch geschminkte Darsteller und eine nicht selten bedrohlich wirkende Filmmusik ein, um das Grauen und den Horror auf die Leinwand zu bannen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
