                                "example_id": "429060ff-a84f-4e68-9226-7a9c48486c6d",
                                "sense_id": "ee7ba13a-d694-3c20-ab57-79098999c461",
                                "text": "Overigens is de markt voor vleesvervangers in vergelijking met de vleesmarkt nog klein. Een gemiddeld huishouden gaf volgens de bank vorig jaar zo'n 13 euro uit aan vleesvervangers, terwijl dat voor bewerkt vlees zo'n 224 euro was."
                            },
                            {
                                "example_id": "aff7d45c-13c7-4db5-8c14-288f0ff89cba",
                                "sense_id": "ee7ba13a-d694-3c20-ab57-79098999c461",
                                "text": "Ook het Centraal Bureau voor de Statistiek bevestigt tegenover de NOS dat de vleesmarkt op dit moment geen krimp vertoont."
                            }
                        ]
                    }
