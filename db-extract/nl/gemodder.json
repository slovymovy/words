        "nl-extract.jsonl": [
            {
                "entry_id": "5802bb86-e474-3c44-847a-c122716e369a",
                "word": "gemodder",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "a71e4086-c5d0-333d-b5c4-341bd6b7184a",
                        "entry_id": "5802bb86-e474-3c44-847a-c122716e369a",
                        "glosses": [
                            "het aanhoudend iets niet goed doen; het aanhoudend slordig werken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "acee949c-2d27-4c44-86bf-b2828d4dadaa",
                                "sense_id": "a71e4086-c5d0-333d-b5c4-341bd6b7184a",
                                "text": "Na de nationale titels in november reed ik nog worldcup. Dat ging ook goed. Daarna begon het gemodder. Met school, drukte, alles tegelijk. Er is niet één oorzaak, het is een combinatie van factoren."
                            },
                            {
                                "example_id": "dd8b2b80-149f-4c4a-b62c-8aab91ec0385",
                                "sense_id": "a71e4086-c5d0-333d-b5c4-341bd6b7184a",
                                "text": "We zijn dringend toe aan herwaardering van ”de moeder” à la Nijhoff. Zonder hen geen volgende generatie. Tijd voor meer ”gemoeder” en minder ”gemodder”."
                            },
                            {
                                "example_id": "34f2a0dc-e660-4b31-a71f-d31179435a79",
                                "sense_id": "a71e4086-c5d0-333d-b5c4-341bd6b7184a",
                                "text": "België wordt stilaan een land waar de leiders – de poëtische boutade van Bertolt Brecht indachtig – het juiste volk willen verkiezen, in plaats van andersom. Infantiel gemodder Moeheid is wat onze media overmant, ondanks hun onuitputtelijke appetijt voor conflict en oneliners."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d13545c9-46d0-46ea-b526-4a4b87b448e7",
                        "source_entry_id": "5802bb86-e474-3c44-847a-c122716e369a",
                        "source_sense_id": "a71e4086-c5d0-333d-b5c4-341bd6b7184a",
                        "target_lang_word": "muddling",
