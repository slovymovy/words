                ],
                "senses": [
                    {
                        "sense_id": "6be6fb34-9211-314e-ae9b-b98e77d9c8ba",
                        "entry_id": "421a37d2-f528-3cc3-adbf-e4b5fa82c9df",
                        "glosses": [
                            "Vol à très basse altitude."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d537f2fa-a04a-4181-8452-363983d796d8",
                                "sense_id": "6be6fb34-9211-314e-ae9b-b98e77d9c8ba",
                                "text": "La démonstration de voltige a supprimé tous les vols en rase-motte de son programme, car le public craint un accident comparable à celui qui avait fait de nombreuses victimes l’an passé."
                            },
                            {
                                "example_id": "dd5b70db-072c-4f1b-962e-52b99d1b183a",
                                "sense_id": "6be6fb34-9211-314e-ae9b-b98e77d9c8ba",
                                "text": "J’écrivais des choses définitives sur le thème « Penser l’infini » quand je fus soudain dérangé par une mouche en rase-motte."
                            },
                            {
                                "example_id": "1fde5619-9445-4c79-896a-fcc72b1bd42e",
                                "sense_id": "6be6fb34-9211-314e-ae9b-b98e77d9c8ba",
                                "text": "Ils font du rase-motte au dessus de la piscine et laissent tomber les déjections de leur nichée dans l’eau."
                            },
                            {
                                "example_id": "a3694815-dacc-44c9-b033-273d0e1f4162",
                                "sense_id": "6be6fb34-9211-314e-ae9b-b98e77d9c8ba",
                                "text": "Vers neuf heures néanmoins, une dizaine de bombardiers alliés, escortés de chasseurs, arrivèrent en rase-motte, passèrent le col et bombardèrent sérieusement le djebel, où était concentré le gros des forces ennemies."
                            }
                        ]
                    }
