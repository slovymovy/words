                ],
                "senses": [
                    {
                        "sense_id": "5732cfda-2aa5-3501-9a4e-a32c4b9fff0e",
                        "entry_id": "d2fca580-4830-34e7-be6c-851db9e563ca",
                        "glosses": [
                            "относящийся к древнейшему, общему для всех славян периоду их истории, языку"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "80610e2e-03e7-4ef1-8a78-067efd7482e5",
                                "sense_id": "5732cfda-2aa5-3501-9a4e-a32c4b9fff0e",
                                "text": "V-VII веками завершается последний период праславянской истории."
                            },
                            {
                                "example_id": "2bf9e805-e63f-45d6-b8e7-bf89cb4872c0",
                                "sense_id": "5732cfda-2aa5-3501-9a4e-a32c4b9fff0e",
                                "text": "Мы говорили о южной половине восточнославянских земель — исконных праславянских областях."
                            },
                            {
                                "example_id": "88564f60-d51c-4bc5-aaf0-a7abede73c11",
                                "sense_id": "5732cfda-2aa5-3501-9a4e-a32c4b9fff0e",
                                "text": "Слышались в нём отзвуки южной малороссийской речи и ещё дальше, ещё глубже какие-то уже совсем забытые, праславянские слова и звучания."
                            }
                        ]
                    },
                    {
                        "sense_id": "a682b8bc-85f7-39af-b6e1-0f2724846b26",
                        "entry_id": "d2fca580-4830-34e7-be6c-851db9e563ca",
                        "glosses": [
                            "субстантивир. то же, что праславянский язык"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
