                    {
                        "sense_id": "cf85d769-708d-3ec7-a946-e8af2f59894c",
                        "entry_id": "7925eca5-adbf-3643-a8c4-a0fc7230efae",
                        "glosses": [
                            "разг. лично, сам, собственной особой"
