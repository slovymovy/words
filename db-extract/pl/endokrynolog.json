                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8170152-8209-4cbc-b473-e5f88990374b",
                                                "sense_id": "8365be11-8338-389b-9610-2fa220536e92",
                                                "text": "Ainsi pensons-nous exposer les faits les plus utiles à l’endocrinologiste et au médecin-praticien, tout en conférant à notre exposé une sorte d’unité."
                                            }
