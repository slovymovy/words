                                    },
                                    {
                                        "sense_id": "b7aeaf8f-cb20-3901-8174-b7e55cf7b9e0",
                                        "entry_id": "decc0021-69cb-3310-8210-52d271583fc0",
                                        "glosses": [
                                            "A unit of length, exactly equal to 22 yards, which is 4 rods or 100 links, and approximately equal to 20.12 metres; the length of a Gunter's surveying chain; the length of a cricket pitch."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9c3c2e3-4b52-4e73-9b4f-e2f0827eb65b",
                                                "sense_id": "b7aeaf8f-cb20-3901-8174-b7e55cf7b9e0",
                                                "text": "\"But it's too far—must be a quarter of a mile—and I've a portmanteau to carry.\" […]\n\"Garn!\" shouted the guard. \"Taint ten chain. […]\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b2a5c033-df61-3e22-afcd-21d97d33b719",
                                        "entry_id": "decc0021-69cb-3310-8210-52d271583fc0",
                                        "glosses": [
                                            "A totally ordered set, especially a totally ordered subset of a poset."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01350d22-c4ee-4201-874f-3909f4817c2e",
                                                "sense_id": "b2a5c033-df61-3e22-afcd-21d97d33b719",
                                                "text": "We first find an approximation of the chain partition, i.e. a small but not minimum size set of chains which cover all elements of the poset."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fce477a6-aced-3624-9284-9cace89c881a",
                                        "entry_id": "decc0021-69cb-3310-8210-52d271583fc0",
                                        "glosses": [
                                            "A formal sum of cells in a CW complex of a certain dimension k (in which case the formal sums are called k'''-chains); a formal sum of simplices or cubes of a certain dimension in a simplical complex or cubical complex (respectively)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f9c205fb-00ad-3499-a9b1-b90bdd219ff9",
                                        "entry_id": "decc0021-69cb-3310-8210-52d271583fc0",
                                        "glosses": [
                                            "An element of a group (or module) in a chain complex."
                                        ],
                                        "tags": [
                                            "broadly"
