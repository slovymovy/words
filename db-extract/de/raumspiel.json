                "senses": [
                    {
                        "sense_id": "18e024bf-7fbf-39df-a7be-b8d9c94f13c1",
                        "entry_id": "f4a82fbe-8372-30ea-ba2f-1893cf2fbc89",
                        "glosses": [
                            "künstlerische Bewegung in abgegrenztem Rahmen, Spiel mit Räumlichkeiten, inszenierte Räume"
                        ],
                        "tags": [
                            "Musik"
                        ],
                        "examples": [
                            {
                                "example_id": "f8347d96-2a74-4968-b416-0befed31635e",
                                "sense_id": "18e024bf-7fbf-39df-a7be-b8d9c94f13c1",
                                "text": "„Derart läßt sich der Besucher auf ein verwirrendes Raumspiel ein.“"
                            },
                            {
                                "example_id": "365f4b5e-ce0d-42e2-9e46-71048a2db903",
                                "sense_id": "18e024bf-7fbf-39df-a7be-b8d9c94f13c1",
                                "text": "„Unter Raumspielen im engeren Sinne sind an dieser Stelle Raumspiele zu verstehen, bei denen vorrangig bühnentechnische oder aber auch filmtechnische Spielbewegungen im Vordergrund stehen.“"
                            },
                            {
                                "example_id": "3efda16d-b332-4fe6-94a4-7792f0a98b60",
                                "sense_id": "18e024bf-7fbf-39df-a7be-b8d9c94f13c1",
                                "text": "„Aus diesem ‚Raumspiel‘ ist Ernst geworden.“"
                            },
                            {
                                "example_id": "425274a9-dec4-4858-88aa-77dc85491533",
                                "sense_id": "18e024bf-7fbf-39df-a7be-b8d9c94f13c1",
                                "text": "„In Jesus Raphael Sotos begehbarem Wald aus Schnüren wird Spielraum und Raumspiel zum Erlebnis.“"
                            },
                            {
                                "example_id": "8d1b5251-8552-46f1-bbf0-f173197808c0",
                                "sense_id": "18e024bf-7fbf-39df-a7be-b8d9c94f13c1",
                                "text": "„Der Sammelband erschließt das Begriffspaar von Spielraum und Raumspiel durch theoretische Grundlagen sowie exemplarische Analysen deutschsprachiger, französischer, (hispano)amerikanischer und afrikanischer Texte erstmals für die Literaturwissenschaft.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "3e701607-281d-3354-8048-f2edd728fb4f",
                        "entry_id": "f4a82fbe-8372-30ea-ba2f-1893cf2fbc89",
                        "glosses": [
                            "großflächiges Ausnutzen des Spielfeldes bei Bewegungsspielen für taktische Kombinationen, Distanzspiel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf89b951-8d39-468e-8754-dec6b65efefb",
                                "sense_id": "3e701607-281d-3354-8048-f2edd728fb4f",
                                "text": "„Dafür schoß man den Ball sooft wie möglich über die Mittellinie hin und her oder auch mal zurück in die eigene Hälfte (Raumspiel).“"
                            },
                            {
                                "example_id": "2118087e-a436-4b28-bf7e-1305bb2b2163",
                                "sense_id": "3e701607-281d-3354-8048-f2edd728fb4f",
                                "text": "weitere Literaturbeispiele erwünscht"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "9afa09fb-f625-34a9-9a7a-6affe1e673f5",
                        "entry_id": "f4a82fbe-8372-30ea-ba2f-1893cf2fbc89",
                        "glosses": [
                            "Spiel in und mit einem abgegrenzten, geschlossenem Bereich, Indoorspiel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "abd22eac-9689-445b-8c75-9fa38d986712",
                                "sense_id": "9afa09fb-f625-34a9-9a7a-6affe1e673f5",
                                "text": "„In diesem Kapitel werden Spielweisen wie das Raumspiel beschrieben, die bereits im 2. Lebensjahr auftreten und die sich im Alter von 3 und 4 Jahren weiterentwickeln.“"
                            },
                            {
