                "senses": [
                    {
                        "sense_id": "09553268-68d5-3af3-8b78-66143ffd1339",
                        "entry_id": "dce2f666-53b8-3f1e-a1be-0ad04037e18e",
                        "glosses": [
                            "Arkebuse, Hakenbüchse"
                        ],
                        "tags": [
                            "historische Waffe"
                        ],
                        "examples": [
                            {
                                "example_id": "1c8eacff-11b9-470f-94d3-3cb4590ba541",
                                "sense_id": "09553268-68d5-3af3-8b78-66143ffd1339",
                                "text": "The next day we passed, and found sixteen thieves in a narrow passage, before whom we set a good guard of harquebuzes and pistols, till the weaker fort passed by; so in three days we came safe to Belgrada.",
                                "translation": "Am nächsten Tag zogen wir los und trafen an einer schmalen Stelle auf sechzehn Räuber, und noch vor ihnen setzen wir eine gute Menge von Arkebusen und Pistolen ein, bis die Schwächeren ihre Stellung aufgaben. Auf diese Weise kamen wir innerhalb von drei Tagen sicher nach Belgrad."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "09b0a9f8-1503-4dfb-9b4e-c23fd70c1b4b",
                        "source_entry_id": "dce2f666-53b8-3f1e-a1be-0ad04037e18e",
                        "source_sense_id": "09553268-68d5-3af3-8b78-66143ffd1339",
                        "source_sense_description": "historische Waffe: Arkebuse, Hakenbüchse",
                        "target_lang_word": "Arkebuse",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Arkebuse",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c2d925aa-45dd-355d-8bed-4ca61f714393",
                                        "entry_id": "74db41d9-026d-3a9c-845a-87aaa3a7e1ff",
                                        "glosses": [
                                            "Vorderlader des 15. und 16. Jahrhunderts mit Luntenschloss"
                                        ],
                                        "tags": [
                                            "Waffenkunde"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "df9f3959-5a4b-48f4-bc95-6f2a955e4473",
                                                "sense_id": "c2d925aa-45dd-355d-8bed-4ca61f714393",
                                                "text": "„Rund 650 mit Arkebusen bewaffnete Soldaten gehören zu Barretos Leuten sowie 2000 Träger, 200 einheimische Führer, zwei Dutzend Ochsenwagen, acht Esel und fünf Kamele.“"
                                            },
                                            {
                                                "example_id": "1488adda-f369-47d1-841f-4a348ca91418",
                                                "sense_id": "c2d925aa-45dd-355d-8bed-4ca61f714393",
                                                "text": "„Die Arkebuse ist eine Hakenbüchse mit Luntenschloss.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
