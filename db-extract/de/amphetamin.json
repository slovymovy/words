                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d1b0370b-fe9a-4604-a5e4-f22b8bdfab36",
                                                "sense_id": "b1f3371f-7da0-3628-a922-024aa9c06013",
                                                "text": "Le MDMA est une amphète vendue entre 50 et 300 balles, sous forme de cacheton ou de gélule."
                                            },
                                            {
                                                "example_id": "9efbb268-1a4b-4014-8c93-248588ed56db",
                                                "sense_id": "b1f3371f-7da0-3628-a922-024aa9c06013",
                                                "text": "Gober un amphète."
                                            },
                                            {
                                                "example_id": "cbad9fae-5513-4d2f-b4d9-66ded53904b5",
                                                "sense_id": "b1f3371f-7da0-3628-a922-024aa9c06013",
                                                "text": "Mais eux, les ouvriers de la septième génération, ils rigolaient bien, à chevaucher leurs bulldozers comme des taureaux, transistor à fond la caisse, une amphète sous la langue."
                                            }
                                        ]
