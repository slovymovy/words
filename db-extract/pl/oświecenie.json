                "senses": [
                    {
                        "sense_id": "9558788c-7104-3169-b907-e372007a1486",
                        "entry_id": "36c48d16-780d-3b01-b2e0-189812f8834a",
                        "glosses": [
                            "koncepcja uwypuklająca rolę rozumu i wiedzy, dominująca w filozofii europejskiej od końca XVII w."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f163b3f2-41ef-4bc3-bd20-5466e41a0c8f",
                                "sense_id": "9558788c-7104-3169-b907-e372007a1486",
                                "text": "W opozycji do oświecenia pojawiła się ideologia konserwatywna."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "6d8fcf2c-557d-3f89-ba47-9c85869c3e05",
                        "entry_id": "36c48d16-780d-3b01-b2e0-189812f8834a",
                        "glosses": [
                            "okres w kulturze europejskiej od końca XVII w., związany z dominacją idei oświeceniowych"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e686b7f0-2aa1-4c75-9e00-d1aff650a702",
                                "sense_id": "6d8fcf2c-557d-3f89-ba47-9c85869c3e05",
                                "text": "Dynamiczny rozwój literatury rosyjskiej nastąpił w okresie oświecenia pod koniec XVIII w.."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "66c09b48-a811-38ac-bd38-0a0e5a48c9f2",
                        "entry_id": "36c48d16-780d-3b01-b2e0-189812f8834a",
                        "glosses": [
                            "osiągnięcie świadomości, poznanie prawdy"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d0deb22-a489-4408-ae4d-2b1eb4f4b232",
                                "sense_id": "66c09b48-a811-38ac-bd38-0a0e5a48c9f2",
                                "text": "Według św. Augustyna: wiedzy, o którą na próżno zabiegamy przyrodzonymi władzami naszego umysłu, Bóg udziela duszy drogą oświecenia."
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    },
                    {
                        "sense_id": "4981317e-2117-37fe-a7e5-990229bf0195",
                        "entry_id": "36c48d16-780d-3b01-b2e0-189812f8834a",
                        "glosses": [
                            "szerzenie wiedzy, osiągnięcie postępu"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.4\""
                    },
                    {
                        "sense_id": "7f027993-0b67-3cc2-92bc-db1fa873da31",
                        "entry_id": "36c48d16-780d-3b01-b2e0-189812f8834a",
                        "glosses": [
                            "w religiach Wschodu: stan osiągnięty przez wytrwałą medytację"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81ceeffb-9d40-4574-aa8c-af48309a0898",
                                "sense_id": "7f027993-0b67-3cc2-92bc-db1fa873da31",
                                "text": "Nieco bliższe (choć wciąż niewystarczające) są opisy oświecenia, dokonane przez ludzi, którzy twierdzą, że go doświadczyli."
                            }
                        ],
                        "sense_index_json": "\"1.5\""
                    },
                    {
                        "sense_id": "6fc14768-d4e7-3039-a7c2-f4cb2df72a08",
                        "entry_id": "36c48d16-780d-3b01-b2e0-189812f8834a",
                        "glosses": [
                            "oświata"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "a573f1cf-57ec-4bf5-a07e-3b4fef04ac94",
                                "sense_id": "6fc14768-d4e7-3039-a7c2-f4cb2df72a08",
                                "text": "Terminy te nie zostały dotrzymane, ale już w maju wszystkie biura Ministerstwa Wyznań Religijnych i Oświecenia Publicznego przeprowadzono do nowego gmachu."
                            }
                        ],
                        "sense_index_json": "\"1.6\""
                    },
                    {
                        "sense_id": "9b416fb3-a331-3fc1-a561-b3cd1d02539b",
                        "entry_id": "36c48d16-780d-3b01-b2e0-189812f8834a",
                        "glosses": [
                            "wykształcenie"
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1.7\""
                    },
                    {
