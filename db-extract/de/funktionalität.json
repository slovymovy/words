                    {
                        "sense_id": "eacc8a9e-d3e3-3d6f-ae80-c371540a8603",
                        "entry_id": "40059a9b-2570-3618-93ed-7f82d9f653b8",
                        "glosses": [
                            "die Fähigkeit eines Produktes oder einer Komponente, bestimmte Aufgaben zu lösen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e93d5fe-e784-4cb0-b3f8-0b8c9afde6ba",
                                "sense_id": "eacc8a9e-d3e3-3d6f-ae80-c371540a8603",
                                "text": "„Diesen Siegeszug hat ein Kleidungsstück vollendet, das in seiner Funktionalität und seiner Bedeutungsprägnanz zum modischen Signum der liberalen Gesellschaften geworden ist: die Jeans.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c79f8cb9-db54-44b1-9501-8b12546cb864",
                        "source_entry_id": "40059a9b-2570-3618-93ed-7f82d9f653b8",
                        "source_sense_id": "eacc8a9e-d3e3-3d6f-ae80-c371540a8603",
                        "source_sense_description": "die Fähigkeit eines Produktes oder einer Komponente, bestimmte Aufgaben zu lösen",
                        "target_lang_word": "functionality",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "functionality",
