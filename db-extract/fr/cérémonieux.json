                        ]
                    },
                    {
                        "translation_id": "4c287b7b-37e4-47ab-9c79-6defd2fd2b43",
                        "source_entry_id": "73cc6073-b73d-3c73-8726-177f784e95a4",
                        "source_sense_id": "b5741c49-9c4e-3351-bf17-731562dcdedb",
                        "source_sense_description": "Qui fait beaucoup de cérémonies",
                        "target_lang_word": "ceremonious",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ceremonious",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1a7d9a7f-3217-3c32-9cfa-561037d51b77",
                                        "entry_id": "34051761-3d58-3d3f-8fc3-fa80c666f065",
                                        "glosses": [
                                            "According to the required or usual ceremonies, formalities, or rituals; specifically (Christianity, obsolete), to ceremonial laws in the Bible."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df7fe8ec-a4cb-4a36-80c3-3039112f4795",
                                                "sense_id": "1a7d9a7f-3217-3c32-9cfa-561037d51b77",
                                                "text": "[L]et vs take a ceremonious leaue, / And louing farevvell of our ſeuerall friends."
                                            },
                                            {
                                                "example_id": "b6911c9e-2028-48bd-b164-8b05ab0a8399",
                                                "sense_id": "1a7d9a7f-3217-3c32-9cfa-561037d51b77",
                                                "text": "VVhen vve deſcribe our ſenſations of another's ſorrovvs, either in friendly or ceremonious condolence, the cuſtoms of the vvorld ſcarcely admit of rigid veracity."
                                            },
                                            {
                                                "example_id": "7d913a16-e02a-4671-b193-9770513e1937",
                                                "sense_id": "1a7d9a7f-3217-3c32-9cfa-561037d51b77",
                                                "text": "Bingley, she had likewise seen for an instant, and in that short period saw him looking both pleased and embarrassed. He was received by Mrs. Bennet with a degree of civility, which made her two daughters ashamed, especially when contrasted with the cold and ceremonious politeness of her curtsey and address to his friend."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7e310144-7f24-3485-88c7-60739cb79f9f",
                                        "entry_id": "34051761-3d58-3d3f-8fc3-fa80c666f065",
                                        "glosses": [
                                            "Involving much ceremony; ostentatious, showy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a77c2c57-0e23-4e8c-928b-7e0f3bcb2812",
                                                "sense_id": "7e310144-7f24-3485-88c7-60739cb79f9f",
                                                "text": "O, the Sacrifice, / Hovv ceremonious, ſolemne, and vn-earthly / It vvas i'th' Offring?"
                                            },
                                            {
                                                "example_id": "31e49cf9-5419-4700-8a6b-d0544cc594d8",
                                                "sense_id": "7e310144-7f24-3485-88c7-60739cb79f9f",
                                                "text": "This is the day, when, in a foreign grave, / King Owen [Owain Gwynedd]'s relics shall be laid to rest. / […] / No mitred abbots, and no tonsured train, / Lengthened the pomp of ceremonious woe."
                                            },
                                            {
                                                "example_id": "a5810b7e-f45d-4a65-aa3f-ebf8ca7ecf91",
                                                "sense_id": "7e310144-7f24-3485-88c7-60739cb79f9f",
                                                "text": "He descended to the cabin to bid a ceremonious, and, it may be, tacitly rebukeful adieu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f878f697-8f1c-3c9f-8a7c-d36369ee5571",
                                        "entry_id": "34051761-3d58-3d3f-8fc3-fa80c666f065",
                                        "glosses": [
                                            "Of a person: fond of ceremony or ritual, or of observing strict etiquette or formality; punctilious."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70a3bb1f-5694-44be-9134-831b228e6612",
                                                "sense_id": "f878f697-8f1c-3c9f-8a7c-d36369ee5571",
                                                "text": "[S]ome VVriters do almoſt nothing contrary to yͤ cuſtome, and ſome by vertue of that Priuiledge, dare doe any thing. I am neither of that firſt order, nor of this laſt. The one is too fondly-ceremonious, the other too impudently audacious. I vvalke in the midſt (ſo vvell as I can) betvveene both."
                                            },
                                            {
                                                "example_id": "5f0bea87-e0f8-4622-a736-fef9e2c21f23",
                                                "sense_id": "f878f697-8f1c-3c9f-8a7c-d36369ee5571",
                                                "text": "His onely delight is building, he ſpends himſelfe to get curious intricate models and plots, another is vvholly ceremonious about titles, degrees, inſcriptions."
                                            },
                                            {
                                                "example_id": "5b485497-e73e-487d-a4ce-d0223c622f83",
                                                "sense_id": "f878f697-8f1c-3c9f-8a7c-d36369ee5571",
                                                "text": "Ancient and oriental cultures are in many ways more conventional, more ceremonious, and more courteous than our own."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0bee4fce-4cb4-304b-9174-51303667f95d",
                                        "entry_id": "34051761-3d58-3d3f-8fc3-fa80c666f065",
                                        "glosses": [
                                            "Synonym of ceremonial (“of, relating to, consisting of, or used in a ceremony or rite”); formal, ritual."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a70072a4-297d-4343-9ccc-6a9f3aaea93d",
                                                "sense_id": "0bee4fce-4cb4-304b-9174-51303667f95d",
                                                "text": "They [gentiles] may alſo theſiyer [the easier] bee allured to the Chriſtian fayth, for that it is more agreable to the lawe of nature then eyther the cerimonious lawe of Moiſes, or portentous fables of Mahometes Alcharon."
                                            },
                                            {
                                                "example_id": "019b03a3-ab7b-4c96-8d81-251744afb194",
                                                "sense_id": "0bee4fce-4cb4-304b-9174-51303667f95d",
                                                "text": "The other Princes vvere reſerued to a more opportune maſſacre, vntil Sultan Currovvn had entred Agra, and receiued the Imperial Crovvne and Scepter, vvith other Ceremonious rites due to the Coronation, of the Great Moguls."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
