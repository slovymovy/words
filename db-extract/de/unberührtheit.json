                            "emotional neutrale Verfassung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7852efdb-8374-4cd3-840f-80c10292a6ae",
                                "sense_id": "e9f3bf9a-d588-3efb-8a8f-0ca2cc21f313",
                                "text": "Wie kann man nur eine solche Unberührtheit zur Schau stellen, gehen dir die Bilder nicht nahe?"
                            }
                        ],
