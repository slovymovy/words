                    {
                        "translation_id": "d1d6871b-b386-4abd-89b5-75dac5067662",
                        "source_entry_id": "56f9c920-a96c-3cf0-9040-dc03c07ba7ae",
                        "source_sense_id": "999bca62-eb59-3fc9-93c8-663c58125341",
                        "source_sense_description": "not obtrusive",
                        "target_lang_word": "bescheiden",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bescheiden",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a47ddd7c-cf75-3c8f-a615-0368d3ea2f32",
                                        "entry_id": "5addd4e5-ec0d-35ad-b905-f8484383a8c2",
                                        "glosses": [
                                            "zurückhaltend; seine Erfolge oder sein Können in Erzählungen schmälernd oder nicht erwähnend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c11dc880-743c-467c-829d-c3f260fb62cf",
                                                "sense_id": "a47ddd7c-cf75-3c8f-a615-0368d3ea2f32",
                                                "text": "Obwohl er der Beste von allen ist, bleibt er stets bescheiden."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "82747f20-6466-36af-b2cb-31dfbecd7751",
                                        "entry_id": "5addd4e5-ec0d-35ad-b905-f8484383a8c2",
                                        "glosses": [
                                            "einfach, schlicht und ohne großen Luxus"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58ed097f-851a-4ec1-8801-6722ac840288",
                                                "sense_id": "82747f20-6466-36af-b2cb-31dfbecd7751",
                                                "text": "Willkommen in meinem bescheidenen Heim."
                                            },
                                            {
                                                "example_id": "7dd1a9ee-c6d8-4ca8-81ba-fcf51d12872d",
                                                "sense_id": "82747f20-6466-36af-b2cb-31dfbecd7751",
                                                "text": "„Seine Gläubiger waren so anständig gewesen, ihn im Besitz eines kleinen Restes seines väterlichen Vermögens zu lassen, dessen Zinsen bei äußerster Sparsamkeit zu einem sehr bescheidenen Leben hinreichten, ihm jedoch auch nicht den kleinsten Luxus gestatteten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "fb8e28bd-d47e-32b2-9f87-758dec8b803f",
                                        "entry_id": "5addd4e5-ec0d-35ad-b905-f8484383a8c2",
                                        "glosses": [
                                            "anstelle von scheiße oder beschissen benutzt, als weniger vulgäre Variante zu verstehen, weil sonst eine Strafe oder Verwarnung drohen kann"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c133b2cd-1ade-4d67-bd63-ad812507d24b",
                                                "sense_id": "fb8e28bd-d47e-32b2-9f87-758dec8b803f",
                                                "text": "Das ist ja echt bescheiden, dass wir heute schon wieder so viel auf haben."
                                            },
                                            {
                                                "example_id": "8aebd6dc-2e1c-4b00-bd90-dc0716d78140",
                                                "sense_id": "fb8e28bd-d47e-32b2-9f87-758dec8b803f",
                                                "text": "Im Vergleich zum Aufwand war das aber eine bescheidene Leistung."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            },
                            {
                                "target_word": "bescheiden",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "216a0c25-5687-309c-bf8a-f8d64aced233",
                                        "entry_id": "58855955-d324-31ec-adba-33d95eb908ad",
                                        "glosses": [
                                            "anweisen, sich zu jemandem oder an eine bestimmte Stelle zu begeben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20feb9ba-ef37-4486-9b7f-ba254619c6e5",
                                                "sense_id": "216a0c25-5687-309c-bf8a-f8d64aced233",
                                                "text": "„Dieser, der nie an eine Herausgabe derselben gedacht hatte, war nun in seiner Bescheidenheit nicht wenig erstaunt und beschämt, als er zu seinem Vorgesetzten beschieden dort das günstige Urtheil über seine Arbeiten vernahm zugleich mit dem Befehle, sie herauszugeben.“"
                                            },
                                            {
                                                "example_id": "39619649-e8d0-40c8-8243-d2c5bbfa235c",
                                                "sense_id": "216a0c25-5687-309c-bf8a-f8d64aced233",
                                                "text": "„Aber die elf Jünger gingen nach Galiläa auf den Berg, wohin Jesus sie beschieden hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c9c5aad3-6e25-3b0a-ab7f-8fce6fb3bfac",
                                        "entry_id": "58855955-d324-31ec-adba-33d95eb908ad",
                                        "glosses": [
                                            "jemandem zukommen lassen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "80a4748a-bb1f-4782-a4cf-44f6fd856e80",
                                                "sense_id": "c9c5aad3-6e25-3b0a-ab7f-8fce6fb3bfac",
                                                "text": "„Dieser unkomplizierten Musik war von Anfang an beim breiten Publikum großer Erfolg beschieden, der sich nicht zuletzt auch dadurch manifestierte, dass Stricker durchwegs mit virtuosem Geigenspiel als Interpret seiner eigenen Kompositionen in Erscheinung trat.“"
                                            },
                                            {
                                                "example_id": "c710574c-0f99-4679-82e4-5e250c55a188",
                                                "sense_id": "c9c5aad3-6e25-3b0a-ab7f-8fce6fb3bfac",
                                                "text": "„Es ist dir noch ein langes Leben beschieden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "c18babb9-1af7-3598-89b0-eec30608b6f9",
                                        "entry_id": "58855955-d324-31ec-adba-33d95eb908ad",
                                        "glosses": [
                                            "mit wenig zufrieden sein"
                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b3159658-b2c0-4c33-b832-028bfb1f0630",
                                                "sense_id": "c18babb9-1af7-3598-89b0-eec30608b6f9",
                                                "text": "„Warum saß sie jetzt auf einem der größten Höfe und er musste sich bescheiden?“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "08511c24-5a7e-36d1-92f1-aa2033616a23",
                                        "entry_id": "58855955-d324-31ec-adba-33d95eb908ad",
                                        "glosses": [
                                            "auf offiziellem Weg zur Kenntnis bringen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9fdef283-3113-406c-916b-fcbae42fcd36",
                                                "sense_id": "08511c24-5a7e-36d1-92f1-aa2033616a23",
                                                "text": "„Ein Ansuchen des Beschwerdeführers um Nachsicht des genannten Abgabenbetrages wurde mit dem im Instanzenzug ergangenen angefochtenen Bescheid abschlägig beschieden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a14cc8cf-9bd5-41c6-a328-fd0ea1a15118",
                        "source_entry_id": "56f9c920-a96c-3cf0-9040-dc03c07ba7ae",
