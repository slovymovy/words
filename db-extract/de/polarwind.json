                        "entry_id": "a1b95d07-2b92-35a4-8c6e-251e1a10beb2",
                        "glosses": [
                            "Wind, der vom Pol her weht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "64b6fcba-d49a-4eb2-b08e-9f7070784274",
                                "sense_id": "5c68ae15-5641-3ae4-ab56-63ad98c086d3",
                                "text": "„Mit dem kalten Polarwind im Rücken hatten die Mannschaften in ein zerklüftetes Land geschaut, dessen Berge sich bis auf 1600 Meter erhoben.“"
                            },
                            {
                                "example_id": "62bf0945-aaca-41f1-9615-50b693295796",
                                "sense_id": "5c68ae15-5641-3ae4-ab56-63ad98c086d3",
                                "text": "„In der Winternacht vermehren sich Geister und Tote, das Rentier flieht über das Eis der gefrorenen Sunde, der Polarwind wirft Schnee und verwischt die Spuren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
