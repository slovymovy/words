                "senses": [
                    {
                        "sense_id": "37b73df3-b836-36f7-b741-3a1147d3ea1b",
                        "entry_id": "d2f669f7-486f-31f2-9a2f-0663542b629a",
                        "glosses": [
                            "Körper mit vier dreieckigen Seitenflächen"
                        ],
                        "tags": [
                            "geometry"
                        ],
                        "examples": [
                            {
                                "example_id": "268169aa-1c6f-40e4-ae8f-241ab0f1cd85",
                                "sense_id": "37b73df3-b836-36f7-b741-3a1147d3ea1b",
                                "text": "Die Lehrerin trug ihren Schülern auf, das Netz eines Tetraeders zu zeichnen."
                            },
                            {
                                "example_id": "fa2cb3a3-8c45-4b8e-a7e3-03bbb66599e7",
                                "sense_id": "37b73df3-b836-36f7-b741-3a1147d3ea1b",
                                "text": "„Ich ziehe meine Schuhe aus und stelle sie auf einen großen Tetraeder aus Beton.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "65bc3cc7-d7fd-3af3-8cf7-27ebbd7301ee",
                        "entry_id": "d2f669f7-486f-31f2-9a2f-0663542b629a",
                        "glosses": [
                            "Körper mit vier dreieckigen Seitenflächen",
                            "regelmäßiger Tetraeder; Körper, der von vier gleichseitigen Dreiecken begrenzt wird"
                        ],
                        "tags": [
                            "geometry"
                        ],
                        "examples": [
                            {
                                "example_id": "145ab9ec-38af-4990-ad7a-6c34cd5f1ddd",
                                "sense_id": "65bc3cc7-d7fd-3af3-8cf7-27ebbd7301ee",
                                "text": "Der Tetraeder ist dual zu sich selbst."
                            }
                        ],
                        "sense_index_json": "\"1a\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5e18d36a-7bed-41b8-9537-edf820dfcd7a",
                        "source_entry_id": "d2f669f7-486f-31f2-9a2f-0663542b629a",
                        "target_lang_word": "tetrahedron",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tetrahedron",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8390798b-ff32-395a-8920-6272abcf7292",
                                        "entry_id": "c58dfa4f-455a-3d9f-a531-a468a5970fe2",
                                        "glosses": [
                                            "A polyhedron with four faces; the regular tetrahedron, the faces of which are equal equilateral triangles, is one of the Platonic solids."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7d411f93-81aa-4831-a928-128c94a35a0c",
                        "source_entry_id": "d2f669f7-486f-31f2-9a2f-0663542b629a",
                        "target_lang_word": "tétraèdre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tétraèdre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d583cd7e-9a80-3fc8-97fd-a1dfb211ae22",
                                        "entry_id": "7187182f-970a-3094-8b28-6404ec0357f4",
                                        "glosses": [
                                            "Solide dont la surface est formée de quatre triangles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da05f4d0-8dbf-408a-9c21-285624ac2123",
                                                "sense_id": "d583cd7e-9a80-3fc8-97fd-a1dfb211ae22",
                                                "text": "Nous n'essayerons pas de donner au lecteur une idée de ce nez tétraèdre, de cette bouche en fer à cheval, de ce petit œil gauche obstrué d'un sourcil roux en broussailles tandis que l'œil droit disparaissait entièrement sous une énorme verrue …"
                                            },
                                            {
                                                "example_id": "7a43e996-3397-4070-be56-27558fe3e920",
                                                "sense_id": "d583cd7e-9a80-3fc8-97fd-a1dfb211ae22",
                                                "text": "Il la regarda, il mourait très vite, et il eut un dernier regard étonné en constatant que son coeur avait la forme d'un tétraèdre."
                                            },
                                            {
                                                "example_id": "eb30f885-1f90-49bd-9e37-dd805706f85a",
                                                "sense_id": "d583cd7e-9a80-3fc8-97fd-a1dfb211ae22",
                                                "text": "Quand il est régulier (ses faces et les angles qui les séparent sont alors identiques), on parle de solide platonicien. Il existe cinq solides platoniciens distincts, le tétraèdre, le cube, l’octaèdre, le dodécaèdre et l’icosaèdre qui comportent respectivement 4, 6, 8, 12 et 20 côtés."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0042d20b-9903-4834-bd02-57f233bda969",
                        "source_entry_id": "d2f669f7-486f-31f2-9a2f-0663542b629a",
