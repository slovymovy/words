                {
                    "sense_id": "e56c409e-22d2-364a-9103-4dbf81541532",
                    "sense_definition": "A female servant or cleaner, especially one working in a hotel or a large house.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>maid</w> changed the sheets and towels in our hotel room.",
                            "target_lang_translations": {
                                "ru": "<w>Горничная</w> поменяла простыни и полотенца в нашем номере отеля.",
                                "zh": "<w>客房服务员</w>更换了我们酒店房间里的床单和毛巾。"
                            }
                        },
                        {
                            "text": "They decided to hire a <w>maid</w> to help with the cleaning.",
                            "target_lang_translations": {
                                "ru": "Они решили нанять <w>служанку</w>, чтобы она помогала с уборкой.",
                                "zh": "他们决定雇一名<w>女佣</w>来帮忙打扫卫生。"
                            }
                        }
                    ],
                    "synonyms": [
                        "cleaning lady",
                        "chambermaid",
                        "servingmaid",
                        "cleaner"
                    ],
                    "common_phrases": [
                        "hotel maid",
                        "live-in maid",
                        "kitchen maid"
                    ],
                    "target_lang_definitions": {
                        "ru": "Женщина, работающая прислугой или занимающаяся уборкой, особенно в отеле или большом доме.",
                        "zh": "主要在酒店或大宅中从事清洁工作的女性佣人。"
                    },
