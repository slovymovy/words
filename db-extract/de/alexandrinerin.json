                            {
                                "target_word": "Alexandrian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d6693079-4d6c-37ba-b930-2c5f34066e69",
                                        "entry_id": "0ad66993-0921-3f89-bad8-e946e1381343",
                                        "glosses": [
                                            "Applied to a kind of heroic verse; synonym of alexandrine."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "05606de5-ac06-3a86-ad19-03707fdc3bd0",
                                        "entry_id": "0ad66993-0921-3f89-bad8-e946e1381343",
                                        "glosses": [
                                            "Of or pertaining to Alexander the Great, or his reign, era etc."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Alexandrian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e458ca94-412f-33a3-a46b-c219ae3a01c1",
                                        "entry_id": "292a7bab-e39d-35be-877d-77cbfeba9b56",
                                        "glosses": [
                                            "Synonym of alexandrine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "530bd021-e1e7-4932-9da6-ea1f8ff8a498",
                                                "sense_id": "e458ca94-412f-33a3-a46b-c219ae3a01c1",
                                                "text": "Theſe Triplets and Alexandrians were brought in by Dryden, and other Poets in the Reign of Charles II. They were the mere Effect of Haſte, Idleneſs, and want of Money; and have been wholly avoided by the beſt Poets, ſince theſe Verſes were written."
                                            },
                                            {
                                                "example_id": "9bf65cdf-3cda-4b34-bf48-89edcf2825ee",
                                                "sense_id": "e458ca94-412f-33a3-a46b-c219ae3a01c1",
                                                "text": "The Fall of Troy is in blank verse, and may pass muster; but the Dido is in Alexandrians, a most monotonous measure, quite unsuited to a long piece in English."
                                            },
                                            {
                                                "example_id": "0f1efe22-dace-4179-a985-75c9c7c8ef0f",
                                                "sense_id": "e458ca94-412f-33a3-a46b-c219ae3a01c1",
                                                "text": "It follows the pompous versification (the elegant, rhyming Alexandrians), the proverb-like diction, the courteous form of address, and the antithetical reasoning in the portrayal of the struggle in the soul of the hero."
                                            },
                                            {
                                                "example_id": "64bcaeeb-0d65-4063-af82-0705f473e22b",
                                                "sense_id": "e458ca94-412f-33a3-a46b-c219ae3a01c1",
                                                "text": "Usually the Alexandrian breaks into two phrases of three iambic feet each."
                                            }
                                        ]
                                    }
                                ]
                            },
