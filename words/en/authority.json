{
    "word_family": [
        "author",
        "authorize",
        "authorization",
        "authoritative",
        "authoritarian"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3b2c80a7-50d6-3a62-ba15-3a9f59425483",
                    "sense_definition": "The power or right to give orders, make decisions, and enforce obedience.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "power_control",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Only the manager has the <w>authority</w> to sign these checks.",
                            "target_lang_translations": {
                                "ru": "Только у менеджера есть <w>право</w> подписывать эти чеки.",
                                "zh": "只有经理才有<w>职权</w>签署这些支票。",
                                "pl": "Tylko menedżer ma <w>uprawnienia</w> do podpisywania tych czeków."
                            }
                        },
                        {
                            "text": "Parents must exercise their <w>authority</w> to keep children safe.",
                            "target_lang_translations": {
                                "ru": "Родители должны использовать свою <w>власть</w>, чтобы обезопасить детей.",
                                "zh": "父母必须行使他们的<w>权力</w>来保障孩子的安全。",
                                "pl": "Rodzice muszą korzystać ze swojej <w>władzy</w>, aby zapewnić dzieciom bezpieczeństwo."
                            }
                        }
                    ],
                    "synonyms": [
                        "command",
                        "power",
                        "control"
                    ],
                    "common_phrases": [
                        "have authority",
                        "exercise authority",
                        "respect authority"
                    ],
                    "target_lang_definitions": {
                        "ru": "Право или возможность отдавать приказы, принимать решения и добиваться послушания.",
                        "zh": "行使命令、做出决定并强制执行的权力或权利。",
                        "pl": "Moc lub prawo do wydawania poleceń, podejmowania decyzji i egzekwowania posłuszeństwa."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "власть",
                                "target_lang_sense_clarification": "способность управлять и контролировать"
                            },
                            {
                                "target_lang_word": "право",
                                "target_lang_sense_clarification": "законное основание для действий"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "权力",
                                "target_lang_sense_clarification": "支配和控制的能力"
                            },
                            {
                                "target_lang_word": "职权",
                                "target_lang_sense_clarification": "职务范围内的权力"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "władza",
                                "target_lang_sense_clarification": "zdolność do rządzenia i kontrolowania"
                            },
                            {
                                "target_lang_word": "uprawnienia",
                                "target_lang_sense_clarification": "oficjalne prawo do wykonywania określonych czynności"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5f8eb0ab-5b68-3ea8-b4cb-2eaa01f9af7b",
                    "sense_definition": "The group of people with official power to enforce laws or make decisions, such as the police or government.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "official_entities",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>authorities</w> were called to investigate the accident.",
                            "target_lang_translations": {
                                "ru": "<w>Власти</w> были вызваны для расследования происшествия.",
                                "zh": "<w>当局</w>已被召集来调查这起事故。",
                                "pl": "<w>Władze</w> zostały wezwane do zbadania wypadku."
                            }
                        },
                        {
                            "text": "You must report any suspicious activity to the <w>authorities</w> immediately.",
                            "target_lang_translations": {
                                "ru": "Вы должны немедленно сообщить о любой подозрительной деятельности <w>властям</w>.",
                                "zh": "你必须立即向<w>当局</w>报告任何可疑活动。",
                                "pl": "Musisz natychmiast zgłosić wszelką podejrzaną aktywność <w>władzom</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "local authorities",
                        "report to the authorities"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "usually plural"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Группа людей или организаций, обладающих официальной властью для обеспечения соблюдения законов (например, полиция или правительство).",
                        "zh": "拥有官方权力以执行法律或做出决策的群体或机构，如警察或政府。",
                        "pl": "Grupa osób lub instytucji posiadających oficjalną władzę do egzekwowania prawa lub podejmowania decyzji, np. policja lub rząd."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "власти",
                                "target_lang_sense_clarification": "должностные лица или органы управления"
                            },
                            {
                                "target_lang_word": "органы власти",
                                "target_lang_sense_clarification": "официальные государственные структуры"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "当局",
                                "target_lang_sense_clarification": "掌握权力的政府机构"
                            },
                            {
                                "target_lang_word": "官方",
                                "target_lang_sense_clarification": "代表政府的机构"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "władze",
                                "target_lang_sense_clarification": "organy administracyjne lub państwowe"
                            },
                            {
                                "target_lang_word": "organy ścigania",
                                "target_lang_sense_clarification": "instytucje odpowiedzialne za przestrzeganie prawa"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "66d9fed3-9b5a-3314-b0c4-c91486c7490d",
                    "sense_definition": "A person or book with extensive knowledge and the power to influence opinions on a subject.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "expertise",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is a leading <w>authority</w> on ancient history.",
                            "target_lang_translations": {
                                "ru": "Она ведущий <w>авторитет</w> в области древней истории.",
                                "zh": "她是古代史领域的一位顶尖<w>权威</w>。",
                                "pl": "Jest czołowym <w>autorytetem</w> w dziedzinie historii starożytnej."
                            }
                        },
                        {
                            "text": "This textbook is the final <w>authority</w> on grammar rules.",
                            "target_lang_translations": {
                                "ru": "Этот учебник — высший <w>авторитет</w> в правилах грамматики.",
                                "zh": "这本教科书是语法规则的最终<w>权威</w>。",
                                "pl": "Ten podręcznik jest ostatecznym <w>autorytetem</w> w kwestii zasad gramatyki."
                            }
                        }
                    ],
                    "common_phrases": [
                        "leading authority",
                        "authority on"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек или источник, обладающий обширными знаниями и способностью влиять на мнения в определенной области.",
                        "zh": "在某一领域拥有渊博知识并能影响他人观点的人或著作。",
                        "pl": "Osoba lub źródło posiadające rozległą wiedzę i zdolność wpływania na opinie w danej dziedzinie."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "авторитет",
                                "target_lang_sense_clarification": "признанный эксперт или знаток"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "权威",
                                "target_lang_sense_clarification": "在学术或专业领域受尊崇的专家"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "autorytet",
                                "target_lang_sense_clarification": "uznany ekspert lub znawca w danej dziedzinie"
                            },
                            {
                                "target_lang_word": "ekspert",
                                "target_lang_sense_clarification": "osoba posiadająca specjalistyczną wiedzę"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "72046ea2-1aff-3c0c-8c72-2415d404fa81",
                    "sense_definition": "The confidence or respect that someone inspires because of their knowledge, position, or personality.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "expertise",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The professor spoke with such <w>authority</w> that no one questioned him.",
                            "target_lang_translations": {
                                "ru": "Профессор говорил с таким <w>авторитетом</w>, что никто не усомнился в его словах.",
                                "zh": "教授说话时带着一种令人信服的<w>威信</w>，以至于没人质疑他。",
                                "pl": "Profesor mówił z takim <w>autorytetem</w>, że nikt mu nie przerywał."
                            }
                        },
                        {
                            "text": "He lacks the <w>authority</w> needed to lead this difficult project.",
                            "target_lang_translations": {
                                "ru": "Ему не хватает <w>авторитета</w>, необходимого для руководства этим сложным проектом.",
                                "zh": "他缺乏领导这个困难项目所需的<w>威信</w>。",
                                "pl": "Brakuje mu <w>autorytetu</w> potrzebnego do kierowania tym trudnym projektem."
                            }
                        }
                    ],
                    "synonyms": [
                        "gravitas",
                        "cred"
                    ],
                    "common_phrases": [
                        "speak with authority",
                        "air of authority"
                    ],
                    "target_lang_definitions": {
                        "ru": "Уверенность или уважение, которые кто-то внушает благодаря своим знаниям, положению или личности.",
                        "zh": "因知识、地位或个性而令人信服或受人尊敬的特质。",
                        "pl": "Pewność siebie lub szacunek, który ktoś wzbudza dzięki swojej wiedzy, pozycji lub osobowości."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "авторитет",
                                "target_lang_sense_clarification": "влияние и уважение"
                            },
                            {
                                "target_lang_word": "вес",
                                "target_lang_sense_clarification": "значимость в обществе или коллективе"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "威信",
                                "target_lang_sense_clarification": "令人信服的声望"
                            },
                            {
                                "target_lang_word": "权威感",
                                "target_lang_sense_clarification": "表现出的专业与自信"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "autorytet",
                                "target_lang_sense_clarification": "wpływ i szacunek w oczach innych"
                            },
                            {
                                "target_lang_word": "powaga",
                                "target_lang_sense_clarification": "cecha osoby budzącej respekt"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e87c8dcc-0337-3c8d-b71c-0edc3ccda5dc",
                    "sense_definition": "Official permission or power granted to do something.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "power_control",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He signed the contract without the proper <w>authority</w>.",
                            "target_lang_translations": {
                                "ru": "Он подписал контракт, не имея надлежащих <w>полномочий</w>.",
                                "zh": "他在没有适当<w>授权</w>的情况下签署了合同。",
                                "pl": "Podpisał umowę bez odpowiedniego <w>upoważnienia</w>."
                            }
                        },
                        {
                            "text": "We are acting under the <w>authority</w> of the director.",
                            "target_lang_translations": {
                                "ru": "Мы действуем на основании <w>полномочий</w>, данных директором.",
                                "zh": "我们是在董事的<w>授权</w>下行事。",
                                "pl": "Działamy na podstawie <w>pełnomocnictw</w> dyrektora."
                            }
                        }
                    ],
                    "common_phrases": [
                        "without authority",
                        "under the authority of"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официальное разрешение или полномочия, предоставленные для выполнения каких-либо действий.",
                        "zh": "被授予执行某事的官方许可或权力。",
                        "pl": "Oficjalne pozwolenie lub pełnomocnictwo przyznane do wykonania czegoś."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "полномочия",
                                "target_lang_sense_clarification": "служебные права и обязанности"
                            },
                            {
                                "target_lang_word": "разрешение",
                                "target_lang_sense_clarification": "позволение на действие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "授权",
                                "target_lang_sense_clarification": "给予执行某事的权力"
                            },
                            {
                                "target_lang_word": "权限",
                                "target_lang_sense_clarification": "职权范围内的许可"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "pełnomocnictwo",
                                "target_lang_sense_clarification": "formalne prawo do działania w czyimś imieniu"
                            },
                            {
                                "target_lang_word": "upoważnienie",
                                "target_lang_sense_clarification": "zgoda na podjęcie określonych działań"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fef03008-1ff5-3c24-a979-673016a1c01d",
                    "sense_definition": "A government organization responsible for a specific public service.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "official_entities",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local transit <w>authority</w> announced a delay in bus services.",
                            "target_lang_translations": {
                                "ru": "Местное транспортное <w>управление</w> объявило о задержке автобусных рейсов.",
                                "zh": "当地交通<w>管理局</w>宣布公交服务将延误。",
                                "pl": "Lokalny <w>zarząd</w> transportu ogłosił opóźnienia w kursowaniu autobusów."
                            }
                        },
                        {
                            "text": "She works for the port <w>authority</w> managing shipping logistics.",
                            "target_lang_translations": {
                                "ru": "Она работает в <w>администрации</w> порта, управляя логистикой перевозок.",
                                "zh": "她在港口<w>管理局</w>工作，负责管理航运物流。",
                                "pl": "Pracuje w <w>zarządzie</w> portu, zarządzając logistyką przewozów."
                            }
                        }
                    ],
                    "common_phrases": [
                        "transit authority",
                        "housing authority"
                    ],
                    "target_lang_definitions": {
                        "ru": "Государственная организация, ответственная за определенную общественную услугу.",
                        "zh": "负责特定公共服务的政府组织。",
                        "pl": "Organizacja rządowa odpowiedzialna za określoną usługę publiczną."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "управление",
                                "target_lang_sense_clarification": "административный орган"
                            },
                            {
                                "target_lang_word": "администрация",
                                "target_lang_sense_clarification": "руководящий орган учреждения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "管理局",
                                "target_lang_sense_clarification": "负责特定公共事务的行政机构"
                            },
                            {
                                "target_lang_word": "部门",
                                "target_lang_sense_clarification": "负责特定职能的机构"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "urząd",
                                "target_lang_sense_clarification": "instytucja administracyjna"
                            },
                            {
                                "target_lang_word": "zarząd",
                                "target_lang_sense_clarification": "organ zarządzający daną usługą"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}