                                        ]
                                    },
                                    {
                                        "sense_id": "fb54cf6d-0842-3fc7-a356-04f9d2039d38",
                                        "entry_id": "2d00ca4f-1cc5-3ab8-8de3-3c9c974bea90",
                                        "glosses": [
                                            "Démarche par laquelle on demande une jeune fille en mariage à ses parents."
