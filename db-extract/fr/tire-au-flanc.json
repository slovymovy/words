                "senses": [
                    {
                        "sense_id": "2d954654-17aa-30e7-b0ef-88b63a20d0fd",
                        "entry_id": "7f7ceb1b-ecb1-3537-885b-e937ff6243d7",
                        "glosses": [
                            "ou Quelqu’un qui cherche à échapper à une tâche, à un travail, à une corvée."
                        ],
                        "tags": [
                            "colloquial",
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "180fb127-9506-46b5-86d6-ff5e3fd7d0e7",
                                "sense_id": "2d954654-17aa-30e7-b0ef-88b63a20d0fd",
                                "text": "Assimilés à des parasites suçant le lait déjà avarié de notre Hexagone déclinant, tantôt à des tire-au-flanc dont le poil dans la main prendrait, à écouter leurs contempteurs plus remontés que des coucous suisses, des allures de poutre de Bamako, ils sont devenus l'ennemi public numéro un."
                            },
                            {
                                "example_id": "df8ccb9b-d7be-4d69-8098-afc2ed9d76f4",
                                "sense_id": "2d954654-17aa-30e7-b0ef-88b63a20d0fd",
                                "text": "Mais il fallait bien t’apporter ta feuille de température, non ? C’est quand même indispensable pour reconnaître les vrais malades des tire-au-flanc."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "aec62da0-a1f4-45f5-ab9a-eca2239c3485",
                        "source_entry_id": "7f7ceb1b-ecb1-3537-885b-e937ff6243d7",
                        "source_sense_id": "2d954654-17aa-30e7-b0ef-88b63a20d0fd",
                        "target_lang_word": "Drückeberger",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Drückeberger",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f89abe10-21f0-3b95-886d-61d9f109d52b",
                                        "entry_id": "0e596b6a-0a06-365a-bc83-cc6fb203096c",
                                        "glosses": [
                                            "jemand, der sich der Ausführung einer Aufgabe entzieht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee226764-875c-4e93-8abd-28a069f743d6",
                                                "sense_id": "f89abe10-21f0-3b95-886d-61d9f109d52b",
                                                "text": "Er ist ein richtiger Drückeberger, immer wenn er einen Eintrag belegen soll, verschwindet er."
                                            },
                                            {
                                                "example_id": "b5b51f27-a36b-4310-bf16-f4d195e99179",
                                                "sense_id": "f89abe10-21f0-3b95-886d-61d9f109d52b",
                                                "text": "„Die Stimmung in der Kompanie wurde immer schärfer gegen die Banden hinter der Front, vor allem, als die Nachricht kam, dass in Brüssel die Drückeberger aus den Spelunken gekrochen wären, in denen sie sich bei den Einwohnern verborgen gehalten hätten.“"
                                            },
                                            {
                                                "example_id": "798aa86e-42fe-4a8d-9fc5-1e9f3c08fbce",
                                                "sense_id": "f89abe10-21f0-3b95-886d-61d9f109d52b",
                                                "text": "„Ich habe keinen Grund dazu, aber ich fühle mich wie ein Drückeberger.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "19e5e9df-bf63-4bfc-962a-af1100a90ebc",
                        "source_entry_id": "7f7ceb1b-ecb1-3537-885b-e937ff6243d7",
