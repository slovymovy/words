            "senses": [
                {
                    "sense_id": "70e1e5f9-477b-3051-9525-a3adfea5f8d6",
                    "sense_definition": "dodać coś do całości, aby stała się pełna lub kompletna",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "uzupełnianie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Musimy <w>dopełnić</w> ten formularz brakującymi danymi osobowymi.",
                            "target_lang_translations": {
                                "ru": "Мы должны <w>дополнить</w> эту форму недостающими личными данными."
                            }
                        },
                        {
                            "text": "Przed podróżą kierowca postanowił <w>dopełnić</w> bak paliwem do pełna.",
                            "target_lang_translations": {
                                "ru": "Перед поездкой водитель решил <w>заправить</w> бак топливом доверху."
                            }
                        }
                    ],
                    "synonyms": [
                        "uzupełnić"
                    ],
                    "common_phrases": [
                        "dopełnić braków"
                    ],
                    "target_lang_definitions": {
                        "ru": "добавить что-то, чтобы сделать целое полным или завершённым"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дополнить",
                                "target_lang_sense_clarification": "данные, информацию"
                            },
                            {
                                "target_lang_word": "заполнить",
                                "target_lang_sense_clarification": "добавить недостающее"
                            },
                            {
                                "target_lang_word": "долить",
                                "target_lang_sense_clarification": "долить жидкость до краёв"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8434dc1d-64ab-3226-9584-deba62d3ccee",
                    "sense_definition": "uczynić zadość jakiemuś obowiązkowi, procedurze lub formalności",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "realizacja",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Przed podpisaniem umowy trzeba najpierw <w>dopełnić</w> wszelkich formalności.",
                            "target_lang_translations": {
                                "ru": "Перед подписанием договора нужно сначала <w>соблюсти</w> все формальности."
                            }
                        },
                        {
                            "text": "Urzędnik przypomniał klientowi, że musi <w>dopełnić</w> ciążącego na nim obowiązku.",
                            "target_lang_translations": {
                                "ru": "Чиновник напомнил клиенту, что тот обязан <w>исполнить</w> возложенную на него обязанность."
                            }
                        }
                    ],
                    "synonyms": [
                        "spełnić",
                        "wypełnić"
                    ],
                    "common_phrases": [
                        "dopełnić formalności",
                        "dopełnić obowiązku"
                    ],
                    "target_lang_definitions": {
                        "ru": "выполнить обязанность, соблюсти процедуру или формальность"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выполнить",
                                "target_lang_sense_clarification": "обязанность, требования"
                            },
                            {
                                "target_lang_word": "соблюсти",
                                "target_lang_sense_clarification": "формальности, процедуры"
                            },
                            {
                                "target_lang_word": "исполнить",
                                "target_lang_sense_clarification": "долг, обязанность"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b2097510-84d0-3cad-9a2a-4e6b2dfa0a7d",
                    "sense_definition": "o różnych elementach lub osobach: stworzyć zgraną, harmonijną całość (zwykle z «się»)",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "uzupełnianie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ich różne charaktery idealnie się <w>dopełniły</w> podczas wspólnej pracy.",
                            "target_lang_translations": {
                                "ru": "Их разные характеры идеально <w>дополнили друг друга</w> во время совместной работы."
                            }
                        },
                        {
                            "text": "Nowoczesne meble świetnie <w>dopełniły</w> tradycyjne wnętrze starego salonu.",
                            "target_lang_translations": {
                                "ru": "Современная мебель отлично <w>дополнила</w> традиционный интерьер старой гостиной."
                            }
                        }
                    ],
                    "synonyms": [
                        "zharmonizować"
                    ],
                    "target_lang_definitions": {
                        "ru": "гармонично сочетаться, образовывать единое целое (часто с «się»)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дополнить",
                                "target_lang_sense_clarification": "гармонично завершить образ, интерьер"
                            },
                            {
                                "target_lang_word": "дополнить друг друга",
                                "target_lang_sense_clarification": "взаимно (дополниться)"
                            }
                        ]
                    }
                }
            ]
