{
    "word_family": [
        "obedient",
        "obey"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2e93af1a-7679-3722-9e6d-c238e7bc26aa",
                    "sense_definition": "The quality of being willing to follow orders or rules.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Strict <w>obedience</w> to the rules is required in this facility.",
                            "target_lang_translations": {
                                "ru": "В этом учреждении требуется строгое <w>повиновение</w> правилам."
                            }
                        },
                        {
                            "text": "The dog showed complete <w>obedience</w> to its trainer during the session.",
                            "target_lang_translations": {
                                "ru": "Во время занятия собака проявила полное <w>послушание</w> своему дрессировщику."
                            }
                        }
                    ],
                    "synonyms": [
                        "submission"
                    ],
                    "antonyms": [
                        "disobedience",
                        "defiance",
                        "rebellion"
                    ],
                    "common_phrases": [
                        "strict obedience",
                        "blind obedience"
                    ],
                    "target_lang_definitions": {
                        "ru": "Качество, выражающееся в готовности следовать приказам или правилам."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "повинове́ние",
                                "target_lang_sense_clarification": "беспрекословное исполнение чьих-либо распоряжений"
                            },
                            {
                                "target_lang_word": "послуша́ние",
                                "target_lang_sense_clarification": "готовность подчиняться, покорность"
                            },
                            {
                                "target_lang_word": "подчине́ние",
                                "target_lang_sense_clarification": "состояние зависимости от чьей-либо власти"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5b4dbd31-4791-3a2b-b95a-760743ee7f10",
                    "sense_definition": "A group of people who are under the authority of a specific leader or organization.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The religious <w>obedience</w> gathered to hear the bishop speak.",
                            "target_lang_translations": {
                                "ru": "Религиозная <w>община</w> собралась, чтобы послушать выступление епископа."
                            }
                        },
                        {
                            "text": "He was a member of a monastic <w>obedience</w> for many years.",
                            "target_lang_translations": {
                                "ru": "Он много лет был членом монашеской <w>общины</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Группа людей, находящихся под властью определенного лидера или организации."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "монашеская община",
                                "target_lang_sense_clarification": "группа монахов, подчиняющихся уставу"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "463370ec-7bf9-380d-95d8-aac6610b4779",
                    "sense_definition": "A formal written order given by a religious superior to their subordinates.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "document",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The monk received an <w>obedience</w> to travel to a new monastery.",
                            "target_lang_translations": {
                                "ru": "Монах получил <w>послушание</w> отправиться в новый монастырь."
                            }
                        },
                        {
                            "text": "He followed the <w>obedience</w> issued by his superior without question.",
                            "target_lang_translations": {
                                "ru": "Он беспрекословно выполнил <w>послушание</w>, данное ему настоятелем."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Официальное письменное распоряжение, отданное религиозным начальником своим подчиненным."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "послуша́ние",
                                "target_lang_sense_clarification": "церковное поручение или обязанность"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "69efe59a-6537-3ee8-a404-6c8c41f3aa55",
                    "sense_definition": "An official role or duty assigned within a monastery under an abbot.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "role",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His primary <w>obedience</w> was to manage the monastery library.",
                            "target_lang_translations": {
                                "ru": "Его основным <w>послушанием</w> было управление монастырской библиотекой."
                            }
                        },
                        {
                            "text": "The abbot assigned him a new <w>obedience</w> in the kitchen.",
                            "target_lang_translations": {
                                "ru": "Настоятель дал ему новое <w>послушание</w> на кухне."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Официальная роль или обязанность, возложенная в монастыре настоятелем."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "послуша́ние",
                                "target_lang_sense_clarification": "работа или обязанность, выполняемая монахом"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}