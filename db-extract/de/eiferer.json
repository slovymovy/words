                "senses": [
                    {
                        "sense_id": "8b8e8f2d-40a5-3bf0-bd84-7b64456e3512",
                        "entry_id": "ee3410b8-7ac9-3024-ac0c-141874b00826",
                        "glosses": [
                            "jemand, der sehr zielstrebig und bestimmt vorgeht, sich fanatisch für eine Idee einsetzt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e1964a0-271f-410a-a407-cf6c8ca57bae",
                                "sense_id": "8b8e8f2d-40a5-3bf0-bd84-7b64456e3512",
                                "text": "Der Angriff erfolgte durch einen religiösen Eiferer."
                            },
                            {
                                "example_id": "25fbc3f1-1673-4f30-8fa5-e421c9890d88",
                                "sense_id": "8b8e8f2d-40a5-3bf0-bd84-7b64456e3512",
                                "text": "„Eiferer haben, so liest man, eine bronzene Frauenfigur mit ihrem Namenszug, die im Stadtpark an sie erinnern sollte, mit Farbe übergossen und aus ihrem Sockel zu reißen versucht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "23fe3323-c031-4c6d-9d9b-48173fbcaea9",
                        "source_entry_id": "ee3410b8-7ac9-3024-ac0c-141874b00826",
                        "source_sense_id": "8b8e8f2d-40a5-3bf0-bd84-7b64456e3512",
                        "source_sense_description": "Person, die sich übertrieben für etwas einsetzt",
                        "target_lang_word": "zealot",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zealot",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bcbdd9a2-4695-3d31-8eb7-c114f02c9e80",
                                        "entry_id": "9acfd3ce-8772-308e-a51d-21f31e621433",
                                        "glosses": [
                                            "One who is zealous, one who is full of zeal for their own specific beliefs or objectives, usually in the negative sense of being too passionate; a fanatic."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a790f5c6-2cc3-4706-986a-f23991ebdc71",
                                                "sense_id": "bcbdd9a2-4695-3d31-8eb7-c114f02c9e80",
                                                "text": "For Modes of Faith let graceleſs zealots fight; / His can't be wrong whoſe life is in the right:"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "07b1640a-9567-3f9c-b80f-61594572e63c",
                                        "entry_id": "9acfd3ce-8772-308e-a51d-21f31e621433",
                                        "glosses": [
                                            "A member of a radical, warlike, ardently patriotic group of Jews in Judea, particularly prominent in the first century, who advocated the violent overthrow of Roman rule and vigorously resisted the efforts of the Romans and their supporters to convert the Jews."
                                        ],
                                        "tags": [
                                            "Judaism",
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "622d50b2-5456-3d3a-8aa8-6fa0ca33dd31",
                                        "entry_id": "9acfd3ce-8772-308e-a51d-21f31e621433",
                                        "glosses": [
                                            "A member of an anti-aristocratic political group in Thessalonica from 1342 until 1350."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ca20bb74-448e-4abf-a33f-b6e4d4f17f5d",
                        "source_entry_id": "ee3410b8-7ac9-3024-ac0c-141874b00826",
                        "source_sense_id": "8b8e8f2d-40a5-3bf0-bd84-7b64456e3512",
                        "source_sense_description": "Person, die sich übertrieben für etwas einsetzt",
                        "target_lang_word": "bigot",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bigot",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "156f425c-e558-342d-84b1-cacb8d3cef5a",
                                        "entry_id": "11c5b80e-13c6-3b70-8e40-dce733ed2ec4",
                                        "glosses": [
                                            "One who is narrow-mindedly devoted to their own ideas and groups, and intolerant of (people of) differing ideas, races, genders, religions, politics, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "45f98776-21d3-43d1-8ccd-eed4a90c50c1",
                                                "sense_id": "156f425c-e558-342d-84b1-cacb8d3cef5a",
                                                "text": "A former senior minister from Boris Johnson’s government told the Guardian they believed Braverman was a “real racist bigot”."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "98a0efc1-f622-3be4-bf01-326b99d2b7e3",
                                        "entry_id": "11c5b80e-13c6-3b70-8e40-dce733ed2ec4",
                                        "glosses": [
                                            "One who is overly pious in matters of religion, often hypocritically or else superstitiously so."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cffaf8e9-49ae-49dc-af84-83df7301686c",
                                                "sense_id": "98a0efc1-f622-3be4-bf01-326b99d2b7e3",
                                                "text": "He is no bigot or hypocrite, he is not torn and divided betwixt reality and appearance, no wretch of a rugged and peevish disposition, but honest, jovial, resolute, and a good fellow."
                                            },
                                            {
                                                "example_id": "1bf63e6c-5f6c-40db-8d88-8d8f988e804f",
                                                "sense_id": "98a0efc1-f622-3be4-bf01-326b99d2b7e3",
                                                "text": "Thus one part of their Church becomes Sotts and Bigots; and the other that behold this Scene of things, though they profess themselves of their Church, become a company of profane Atheists and clancular Deriders of all Religion. […] Nay it is a question whether those that do more superstitiously cleave to them, doe it not rather in a kind of confusion and obstupefaction of mind out of fear and suspicion, then any determinate assurance or firm belief of the things they outwardly profess."
                                            },
                                            {
                                                "example_id": "ed89d576-1e61-434e-b75a-9b1a6f3806c0",
                                                "sense_id": "98a0efc1-f622-3be4-bf01-326b99d2b7e3",
                                                "text": "Donna Clara was a woman of a cold and grave temper, with all the solemnity of a Spaniard, and all the austerity of a bigot."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
