                                "target_senses": [
                                    {
                                        "sense_id": "eb45fd4d-6d58-3a50-b6b8-6095d3dea328",
                                        "entry_id": "715f5f19-f5fa-3486-b19c-fcc1c9ee8f59",
                                        "glosses": [
                                            "zur Histologie gehörend; die Histologie betreffend; die Gewebe betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1bb1ecf-0ce2-4d05-a58b-6a2ff330a36f",
                                                "sense_id": "eb45fd4d-6d58-3a50-b6b8-6095d3dea328",
                                                "text": "Diese Gewebsprobe wird dann histologisch untersucht."
                                            },
                                            {
                                                "example_id": "a4412e37-f157-4506-9c77-2e04c521c298",
                                                "sense_id": "eb45fd4d-6d58-3a50-b6b8-6095d3dea328",
                                                "text": "Selbst Ärzte haben oft ein unbegrenztes Vertrauen zur histologisch \"gesicherten\" Diagnose."
                                            },
                                            {
                                                "example_id": "c6a7ef34-5a4f-44e7-a51c-abaea109452c",
                                                "sense_id": "eb45fd4d-6d58-3a50-b6b8-6095d3dea328",
                                                "text": "Und doch gibt es kein eindeutiges Kriterium der histologischen Krebsdiagnose, das nicht auch bei gutartigen Krankheiten vorkommen kann."
                                            },
                                            {
                                                "example_id": "1fde2d71-7c38-421d-ba26-7612c64943ae",
                                                "sense_id": "eb45fd4d-6d58-3a50-b6b8-6095d3dea328",
                                                "text": "Hinter dem gängigen Ausdruck, ein Befund sei \"histologisch gesichert\", also durch Begutachtung unter dem Mikroskop, komme die persönliche Leistung dieses Facharztes \"meist gar nicht zum Ausdruck\"."
                                            },
                                            {
                                                "example_id": "0cafde0a-4589-45d8-befd-07ad17b4ff20",
                                                "sense_id": "eb45fd4d-6d58-3a50-b6b8-6095d3dea328",
                                                "text": "Die Röhren gibt es ohne Zweifel nicht, und die angegebenen Verbindungslinien stimmen auch nicht mit den histologisch bekannten Nervenbahnen überein."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
