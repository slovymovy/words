                                    },
                                    {
                                        "sense_id": "f470076a-94c4-32ac-94b2-b47092d9b6b1",
                                        "entry_id": "a7e6f25d-01c5-36f2-9425-e8a0e479a5cb",
                                        "glosses": [
                                            "gezwollen plek"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88115bc4-f42d-4987-9073-241de06ab7e1",
                                                "sense_id": "f470076a-94c4-32ac-94b2-b47092d9b6b1",
                                                "text": "Kanker uit zich soms in een zwelling."
                                            },
                                            {
                                                "example_id": "67ee98eb-cbdf-488b-905a-d2d33c4780ea",
                                                "sense_id": "f470076a-94c4-32ac-94b2-b47092d9b6b1",
                                                "text": "Ik nam snel twee antihistaminepillen in de hoop dat de zwelling weg zou trekken."
                                            },
                                            {
                                                "example_id": "3cba0065-2f91-4fe1-9279-58a997b52924",
                                                "sense_id": "f470076a-94c4-32ac-94b2-b47092d9b6b1",
                                                "text": "'Als de zwellingen afnemen door de cortisonen, zorgt dat voor de patiënt in eerste instantie voor verlichting."
                                            },
                                            {
                                                "example_id": "96897c45-a6c4-4dca-9a9b-1802965de709",
                                                "sense_id": "f470076a-94c4-32ac-94b2-b47092d9b6b1",
                                                "text": "Later verdwenen de zwellingen en ook de huidziekte verdween."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
