                    {
                        "sense_id": "9e2762b5-1cb0-3e34-ac57-35df7dc3e488",
                        "entry_id": "a3bc7431-5d2d-3ce7-8a79-5f16806d2bf9",
                        "glosses": [
                            "Gebirge, Bergkette in Mitteleuropa, im Südosten Deutschlands, im Westen Tschechiens und Norden Österreichs; das sich etwa über 200 km erstreckt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "76b6a1c7-6706-436d-b8e7-4e0525e06d17",
                                "sense_id": "9e2762b5-1cb0-3e34-ac57-35df7dc3e488",
                                "text": "„Tief drin im Böhmerwald, da liegt mein Heimatort; es ist gar lang schon her, dass ich von dort bin fort. Doch die Erinnerung, die bleibt mir stets gewiss, dass ich den Böhmerwald gar nie vergiss. Es war im Böhmerwald, wo meine Wiege stand …“"
                            }
                        ],
                        "sense_index_json": "\"1\""
