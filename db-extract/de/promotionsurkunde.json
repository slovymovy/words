                "senses": [
                    {
                        "sense_id": "bea0aa39-ce7c-3cc3-9903-d25eeadac18f",
                        "entry_id": "c2b899ef-1566-381e-a8fe-e806eddc29a9",
                        "glosses": [
                            "eine Urkunde über eine erfolgreiche Promotion"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "56920213-e64c-42ae-b33b-41fa60bf1a12",
                                "sense_id": "bea0aa39-ce7c-3cc3-9903-d25eeadac18f",
                                "text": "Für seine Behauptung, dass er nach seinem medizinischen Staatsexamen noch mit einer Arbeit in Medizin promovierte, blieb er den Nachweis durch Vorlage der Promotionsurkunde schuldig."
                            },
                            {
                                "example_id": "97802822-98ca-4a16-a775-f4e09c94d60e",
                                "sense_id": "bea0aa39-ce7c-3cc3-9903-d25eeadac18f",
                                "text": "„Am 1. August 1871 wurde ihm die Promotionsurkunde mit der Note insigni cum laude überreicht.“"
                            },
                            {
                                "example_id": "9267c646-2629-4276-81e1-8e864a452ef6",
                                "sense_id": "bea0aa39-ce7c-3cc3-9903-d25eeadac18f",
                                "text": "Nach Abschaffung der Talare wurden Diplomzeugnisse und Promotionsurkunden einfach mit der Post zugestellt."
                            },
                            {
                                "example_id": "41c07b46-6b33-41e8-935a-b5ce3acd9bd0",
                                "sense_id": "bea0aa39-ce7c-3cc3-9903-d25eeadac18f",
                                "text": "„An seinem Schreibtisch hingen ein Poster von Homer Simpson, ein Kalender der NASA, ein Poster mit dem Namen »Pale Blue Dot« und eine Kopie seiner Promotionsurkunde, die lediglich mit einer Heftzwecke an der Wand fixiert war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
