                                "target_senses": [
                                    {
                                        "sense_id": "b98f7d1f-edfa-3422-800b-b37c11efe788",
                                        "entry_id": "efbc0175-48f4-3bad-a32d-def152eeb12a",
                                        "glosses": [
                                            "a principal hormona sexual masculina produzida nos testículos que induz as alterações da puberdade e ajuda a formar músculos e ossos fortes. A mulher também produz nos ovários testosterona em pequenas quantidades"
                                        ],
