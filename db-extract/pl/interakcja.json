                        "glosses": [
                            "wzajemne oddziaływanie na siebie obiektów (osób, przedmiotów, zjawisk itp.); zetknięcie, spotkanie kilku akcji lub dążeń"
                        ],
                        "tags": [],
                        "examples": [
