                    "frequency": "Middle",
                    "semantic_group_id": "general_behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her deliberate <w>nonconformity</w> in dress and lifestyle often drew curious stares from her neighbors."
                        },
                        {
                            "text": "The strict school had little tolerance for any kind of <w>nonconformity</w> among its students."
                        }
                    ],
                    "synonyms": [
