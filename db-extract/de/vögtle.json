                ],
                "senses": [
                    {
                        "sense_id": "f443eda1-f8af-3d03-9ed1-9dcd4cb0ad9a",
                        "entry_id": "25e2a2d0-eaf1-3091-a9ba-9646e06be9e4",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a66a6cec-2843-4cbe-b49c-25513a10d3b7",
                                "sense_id": "f443eda1-f8af-3d03-9ed1-9dcd4cb0ad9a",
                                "text": "Frau Vögtle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "06e8a956-f67c-4588-8630-d1c1e9016f99",
                                "sense_id": "f443eda1-f8af-3d03-9ed1-9dcd4cb0ad9a",
                                "text": "Herr Vögtle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "7863b7bf-a320-474b-a55b-0249dea5f44c",
                                "sense_id": "f443eda1-f8af-3d03-9ed1-9dcd4cb0ad9a",
                                "text": "Die Vögtles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "1ea78d03-105f-4531-8841-dcf626180ce0",
                                "sense_id": "f443eda1-f8af-3d03-9ed1-9dcd4cb0ad9a",
                                "text": "Der Vögtle trägt nie die Schals, die die Vögtle ihm strickt."
                            },
                            {
                                "example_id": "4241d2cb-551a-4d16-a580-0dcc2cc45cc3",
                                "sense_id": "f443eda1-f8af-3d03-9ed1-9dcd4cb0ad9a",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Vögtle kommt, geht der Herr Vögtle.“"
                            },
                            {
                                "example_id": "9efb539c-e180-407c-b640-f17f16dc4df8",
                                "sense_id": "f443eda1-f8af-3d03-9ed1-9dcd4cb0ad9a",
                                "text": "Vögtle kommt und geht."
                            },
                            {
                                "example_id": "3bf618db-a16d-4998-af0a-b5edf307c7f9",
                                "sense_id": "f443eda1-f8af-3d03-9ed1-9dcd4cb0ad9a",
                                "text": "Vögtles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
