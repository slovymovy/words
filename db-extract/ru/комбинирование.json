                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6f70f921-9ca0-3790-a601-ccdf46af8b7b",
                                        "entry_id": "b0882891-f49c-3d26-89c4-9c2c8b568013",
                                        "glosses": [
                                            "The process of rearranging."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc0babf5-822f-4937-829d-f64a3b24f892",
                                                "sense_id": "6f70f921-9ca0-3790-a601-ccdf46af8b7b",
                                                "text": "They form part of the vast electrification and reconstruction schemes which have been in hand for a number of years at Liverpool Street, and in suburban Essex, and include the rearrangement of tracks, of which the Ilford flyover forms part; the modern signal boxes, now needed only at key points; the electric control or sub-stations; and a large electric car shed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9f01ee7f-94fd-38b2-bf0e-c45cf4cc6d6d",
                                        "entry_id": "b0882891-f49c-3d26-89c4-9c2c8b568013",
                                        "glosses": [
                                            "A rearrangement reaction."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e32a9962-2493-40b4-a5c5-74fafc8f5e5b",
                        "source_entry_id": "ff96b531-5067-31e7-a3d9-b51576d7396b",
                        "source_sense_description": "~ сочетание",
                        "target_lang_word": "Kombination",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kombination",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b97497ec-53cb-36e4-8c3a-690030cdf8cd",
                                        "entry_id": "57ceec92-5473-36de-a7e2-d9233b2f0305",
                                        "glosses": [
                                            "logische Verknüpfung von Informationen, die zu einer Schlussfolgerung führt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7bdc8d93-6b72-4bfd-9a2d-5ca94f09b01f",
                                                "sense_id": "b97497ec-53cb-36e4-8c3a-690030cdf8cd",
                                                "text": "Die Kombination von Zeit, Raum und Mathematik ermöglichte es A. Einstein, das theoretische Raumzeitkontinuum zu definieren, welches erst jetzt, durch den teuersten Versuch aller Zeiten, praktisch bewiesen wurde."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7795d47a-fb56-3531-b14c-7cd85052dfe4",
                                        "entry_id": "57ceec92-5473-36de-a7e2-d9233b2f0305",
                                        "glosses": [
                                            "Verbindung, Verknüpfung, Zusammenstellung von Verschiedenem (z.B. Handlungen, Dingen, Eigenschaften)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "921b4890-4d0d-4d5b-9d2b-3298a9f45a08",
                                                "sense_id": "7795d47a-fb56-3531-b14c-7cd85052dfe4",
                                                "text": "Das ist die neueste Kombination: gelb und orange für das Sommerkleid."
                                            },
                                            {
                                                "example_id": "44afc87f-e305-422c-b54d-af653e8f572f",
                                                "sense_id": "7795d47a-fb56-3531-b14c-7cd85052dfe4",
                                                "text": "Diese Kombination von Schönheit und Esprit ist schon sehr beeindruckend."
                                            },
                                            {
                                                "example_id": "da0668d6-3cf8-41e4-9a12-47356e4af795",
                                                "sense_id": "7795d47a-fb56-3531-b14c-7cd85052dfe4",
                                                "text": "Zum Nachtisch gab es eine Kombination von heißen Früchten und kaltem Sorbet."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "41638f06-8b61-3aeb-b950-1a81b3313afb",
                                        "entry_id": "57ceec92-5473-36de-a7e2-d9233b2f0305",
                                        "glosses": [
                                            "eine Abfolge von geplanten Schritten oder Zügen, um ein bestimmtes Ziel zu erreichen, zum Beispiel ein Tor zu erzielen oder im Schach eine Figur zu erobern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b9194a3-d461-47a4-ab4f-4025b88e86df",
                                                "sense_id": "41638f06-8b61-3aeb-b950-1a81b3313afb",
                                                "text": "Mit einer geradezu genialen Kombination gewann sie die Oberhand auf dem Schachbrett zurück."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "8b003a1c-766e-3b1d-bc71-3a207ca79258",
                                        "entry_id": "57ceec92-5473-36de-a7e2-d9233b2f0305",
                                        "glosses": [
                                            "Wettkampf, der nicht nur aus einer Disziplin besteht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57b1f748-7ff1-45a5-8ddd-8eb6e492d2d1",
                                                "sense_id": "8b003a1c-766e-3b1d-bc71-3a207ca79258",
                                                "text": "Sie lag in der alpinen Kombination vorne."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "8017baa3-0436-3220-8432-8208dd4e8bfd",
                                        "entry_id": "57ceec92-5473-36de-a7e2-d9233b2f0305",
                                        "glosses": [
                                            "Zusammenstellung von Kleidungsstücken, zum Beispiel Ober- und Unterteil, speziell Anzugjacke und legerere Hose"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "738ba18c-49e7-4cdd-badc-b91114b73ddd",
                                                "sense_id": "8017baa3-0436-3220-8432-8208dd4e8bfd",
                                                "text": "Ich glaube, man kann auch eine Kombination anziehen, es ist wohl kein Anzug- und Krawattenzwang."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "94846224-6659-333d-9f7d-0530cff12aa1",
                                        "entry_id": "57ceec92-5473-36de-a7e2-d9233b2f0305",
                                        "glosses": [
                                            "Ziffernfolge, oft als Zugangscode für etwas, zum Beispiel einen Safe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "167fb6a5-ca16-469a-a61e-6a0f4c5af95d",
                                                "sense_id": "94846224-6659-333d-9f7d-0530cff12aa1",
                                                "text": "Kannst du bitte die Kombination an der Schließanlage neu einstellen? Der Maler hat gesehen, was ich gedrückt habe."
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    }
                                ]
                            }
                        ]
