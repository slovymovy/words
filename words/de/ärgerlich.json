                                "cs": "Vedoucí oddělení reagoval dost <w>podrážděně</w>, když se dozvěděl o špatných číslech.",
                                "tr": "Bölüm müdürü kötü rakamları öğrendiğinde oldukça <w>kızgın</w> bir tepki verdi.",
                                "es": "El jefe de departamento reaccionó bastante <w>enfadado</w> cuando se enteró de las malas cifras.",
                                "zh": "部门主管得知糟糕的业绩数据时反应相当<w>生气</w>。"
                            }
                        },
                        {
                            "text": "Die Kundin wurde allmählich <w>ärgerlich</w>, weil niemand im Geschäft auf ihre Fragen antwortete.",
                            "target_lang_translations": {
                                "en": "The customer was gradually getting <w>annoyed</w> because no one in the shop was answering her questions.",
                                "ru": "Клиентка постепенно становилась <w>раздражённой</w>, потому что никто в магазине не отвечал на её вопросы.",
                                "nl": "De klant werd langzamerhand <w>boos</w> omdat niemand in de winkel haar vragen beantwoordde.",
                                "pl": "Klientka stawała się powoli <w>poirytowana</w>, ponieważ nikt w sklepie nie odpowiadał na jej pytania.",
                                "fr": "La cliente devenait peu à peu <w>agacée</w>, car personne dans le magasin ne répondait à ses questions.",
                                "it": "La cliente diventava via via più <w>irritata</w>, poiché nessuno nel negozio rispondeva alle sue domande.",
                                "cs": "Zákaznice začínala být <w>naštvaná</w>, protože v obchodě nikdo neodpovídal na její otázky.",
                                "tr": "Mağazada kimse sorularına cevap vermediği için müşteri gitgide <w>öfkelendi</w>.",
                                "es": "La clienta se fue mostrando cada vez más <w>molesta</w> porque nadie en la tienda respondía a sus preguntas.",
                                "zh": "因为店里没人回答她的问题，那位女顾客渐渐<w>恼火</w>起来。"
                            }
                        }
