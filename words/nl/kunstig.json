    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "00e35692-7897-3834-88ea-2bce4315e156",
                    "sense_definition": "Op een bekwame, ingenieuze en vakkundige manier gemaakt of gedaan.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "vakkundig",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De timmerman maakte een <w>kunstig</w> houten kistje met ingewikkelde patronen.",
                            "target_lang_translations": {
                                "en": "The carpenter made an <w>ingenious</w> wooden box with intricate patterns.",
                                "ru": "Плотник сделал <w>искусную</w> деревянную шкатулку со сложными узорами."
                            }
                        },
                        {
                            "text": "Dit bloemstuk was op een <w>kunstige</w> wijze in elkaar gezet.",
                            "target_lang_translations": {
                                "en": "This flower arrangement was put together in a <w>skillful</w> way.",
                                "ru": "Эта цветочная композиция была составлена <w>искусным</w> образом."
                            }
                        }
                    ],
                    "synonyms": [
                        "vernuftig",
                        "vakkundig",
                        "knap"
                    ],
                    "antonyms": [
                        "onbeholpen",
                        "onhandig"
                    ],
                    "common_phrases": [
                        "op kunstige wijze",
                        "een kunstig ontwerp"
                    ],
                    "target_lang_definitions": {
                        "en": "Made or done in a skillful, ingenious, and expert manner.",
                        "ru": "Сделанный или выполненный умелым, искусным и высокопрофессиональным образом."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "ingenious",
                                "target_lang_sense_clarification": "cleverly and skillfully made"
                            },
                            {
                                "target_lang_word": "skillful",
                                "target_lang_sense_clarification": "showing great skill or expertise"
                            },
                            {
                                "target_lang_word": "artful",
                                "target_lang_sense_clarification": "crafted with skill and cleverness"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "искусный",
                                "target_lang_sense_clarification": "сделанный с большим умением и тонкостью"
