                "senses": [
                    {
                        "sense_id": "d1b0ca99-259e-3d8f-97e3-47488303eee2",
                        "entry_id": "3150b973-c534-3468-b657-5bed7d8d23ff",
                        "glosses": [
                            "французское мужское имя, соответствующее русскому имени Павел"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4745f907-f0ac-4b45-b83c-55af4c6cee5c",
                                "sense_id": "d1b0ca99-259e-3d8f-97e3-47488303eee2",
                                "text": "Мы попрощались и вернулись в отель, куда через два часа пришёл и Поль."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "eab6823c-cafe-49df-8c9f-eff78d30d49d",
                        "source_entry_id": "3150b973-c534-3468-b657-5bed7d8d23ff",
                        "source_sense_id": "d1b0ca99-259e-3d8f-97e3-47488303eee2",
                        "target_lang_word": "Paul",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Paul",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9ec663a2-3c07-328f-8a15-c03df8334e1f",
                                        "entry_id": "f3aabee7-6838-362c-a3c4-92b1b3203609",
                                        "glosses": [
                                            "Prénom masculin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb90e002-1641-4744-9e72-fb9987ec3494",
                                                "sense_id": "9ec663a2-3c07-328f-8a15-c03df8334e1f",
                                                "text": "Quand ma mère lui avait demandé, à mon propos : « Qui est-ce ?… » elle lui avait répondu : « C’est Paul !… – Qui ? Paul ?… avait répliqué ma mère. – Mais, ton fils !… »"
                                            },
                                            {
                                                "example_id": "2c56748b-f36b-4297-a2f1-247dfee11fe7",
                                                "sense_id": "9ec663a2-3c07-328f-8a15-c03df8334e1f",
                                                "text": "Paul Berval, chanteur, humoriste et comédien québécois."
                                            },
                                            {
                                                "example_id": "860ad334-8441-457c-873f-a77bd72ee49b",
                                                "sense_id": "9ec663a2-3c07-328f-8a15-c03df8334e1f",
                                                "text": "À la fin des année 1970, à l'époque du trio humoristique Paul et Paul, les sketches de Claude Meunier faisaient hurler de rire des auditoires de cégépiens médusés par son style absurde, alors totalement nouveau."
                                            },
                                            {
                                                "example_id": "298f6534-dbe5-4128-bd9d-edaed324a81e",
                                                "sense_id": "9ec663a2-3c07-328f-8a15-c03df8334e1f",
                                                "text": "Paul, quant à lui, avait sauté sur son cheval et foncé chez son oncle Marius."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa2b272c-1ca9-3057-9ba7-945d66a6e97b",
                                        "entry_id": "f3aabee7-6838-362c-a3c4-92b1b3203609",
                                        "glosses": [
                                            "Paul de Tarse, également appelé saint Paul, auteur de la plupart des épîtres du Nouveau Testament et grand prédicateur des premiers temps du christianisme."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "acaddb45-020e-473f-8581-27e9097ca1e3",
                                                "sense_id": "aa2b272c-1ca9-3057-9ba7-945d66a6e97b",
                                                "text": "« Je ne vous croyais pas si sensible au ridicule, lui dit mademoiselle Théodelinde, quand madame de Chasteller eut quitté le salon ; est-ce parce que madame de Chasteller vous a vu dans la situation peu brillante de saint Paul, lorsqu’il eut la vision du troisième ciel, que sa présence vous a interdit à ce point ? »"
                                            },
                                            {
                                                "example_id": "8d3d1132-d8d4-4f6a-8925-558573246eff",
                                                "sense_id": "aa2b272c-1ca9-3057-9ba7-945d66a6e97b",
                                                "text": "Son nom est Paul. Il est dit-on né à Tarse, en Asie. Il était juif, fils de Juifs, pharisien dit-il de lui-même, c'est-à-dire un Juif qui étudiait ardemment les Écritures et observait tous les commandements de la Loi de Moïse."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Paul",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2e7ff6b7-f677-39f2-a26b-2c22823b8dd8",
                                        "entry_id": "f0c69e7c-e6b1-3bac-8602-87185d8e6455",
                                        "glosses": [
                                            "Nom de famille."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2e7248e-7232-43ad-86f6-e14e1bcb2806",
                                                "sense_id": "2e7ff6b7-f677-39f2-a26b-2c22823b8dd8",
                                                "text": "Son père avait joué un 8ᵉ de finale à Melbourne. Ben Shelton, lui, y joue un quart, ce mercredi matin, face à son compatriote Tommy Paul."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Paul",
                                "target_lang_code": "fr",
                                "target_senses": [
