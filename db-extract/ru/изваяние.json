                                        "entry_id": "19e06bdc-970b-30ac-bde8-ce1750f5d60e",
                                        "glosses": [
                                            "Troisième personne du singulier du subjonctif présent de statuer."
                                        ],
                                        "tags": [
                                            "form-of"
