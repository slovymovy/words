    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "6869ea31-e56f-398c-8470-01d4fa7219cd",
                "word": "introversion",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "aafc20e5-8b75-4636-9214-2d3f0de37db9",
                        "entry_id": "6869ea31-e56f-398c-8470-01d4fa7219cd",
                        "tags": [
                            "plural"
                        ],
                        "form": "introversions"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9eb28764-4ff5-3a2e-ad15-028cfcfbbd7c",
                        "entry_id": "6869ea31-e56f-398c-8470-01d4fa7219cd",
                        "glosses": [
                            "A turning inward, particularly"
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "764a0cb8-998f-49b7-94c3-3faf3687d82d",
                                "sense_id": "9eb28764-4ff5-3a2e-ad15-028cfcfbbd7c",
                                "text": "This disease is sometimes produced by the introversion of the edge of the lower eyelid."
                            }
                        ]
                    },
                    {
                        "sense_id": "48ec8f21-3ff5-3063-9a29-7bf63884159c",
                        "entry_id": "6869ea31-e56f-398c-8470-01d4fa7219cd",
                        "glosses": [
                            "A turning inward",
                            "The action of turning one's thoughts upon internal or spiritual matters."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "ef011ff8-e198-4a8c-b656-06b57fe85d72",
                                "sense_id": "48ec8f21-3ff5-3063-9a29-7bf63884159c",
                                "text": "...their... Fastings, Prayings,... Introversions,... Humiliations, Mortifications..."
                            },
                            {
                                "example_id": "39da1392-ec94-4863-b29a-0ee371e2261f",
                                "sense_id": "48ec8f21-3ff5-3063-9a29-7bf63884159c",
                                "text": "The attending to the voice of Christ within you is what [mystics] term Introversion."
                            },
                            {
                                "example_id": "07baa0cc-d96b-4e71-8e1e-59cdcb82304e",
                                "sense_id": "48ec8f21-3ff5-3063-9a29-7bf63884159c",
                                "text": "... Hamlet, who so perfectly typifies the introversion and complexity of modern thought as compared with ancient..."
                            }
                        ]
                    },
                    {
                        "sense_id": "45187290-ddc6-3dec-843f-00c4231bbdd4",
                        "entry_id": "6869ea31-e56f-398c-8470-01d4fa7219cd",
                        "glosses": [
                            "A turning inward",
                            "A personality orientation towards the self and mental abstraction; behavior expressing such orientation."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "0c418a8d-bc4a-40c8-a22f-4ca7308febf3",
                                "sense_id": "45187290-ddc6-3dec-843f-00c4231bbdd4",
                                "text": "...so that when in later life there occurs an introversion (in the sense of Jung), it consists of a harking back to regressive, reminiscent, infantile material."
                            },
                            {
                                "example_id": "7c669376-3a58-420e-b523-38390d8dda15",
                                "sense_id": "45187290-ddc6-3dec-843f-00c4231bbdd4",
                                "text": "I called the hysterical type the extraversion type and the psychasthénic type the introversion type."
                            },
                            {
                                "example_id": "2d1368b2-90fb-4a79-ad90-187af5335705",
                                "sense_id": "45187290-ddc6-3dec-843f-00c4231bbdd4",
                                "text": "Patients with this disease are at times completely withdrawn from the world around them and give the picture of the very extreme of introversion."
                            },
                            {
                                "example_id": "68769826-d719-476b-887b-47864874c3af",
                                "sense_id": "45187290-ddc6-3dec-843f-00c4231bbdd4",
                                "text": "Eysenck has suggested the three dimensions of neuroticism, psychoticism and introversion-extraversion."
                            },
                            {
                                "example_id": "bda5bdfe-26cf-4472-a89f-30d82f5ad838",
                                "sense_id": "45187290-ddc6-3dec-843f-00c4231bbdd4",
                                "text": "The roots of what are popularly taken to be introversion and extroversion show up in infancy: positive emotionality, or extroversion, and negative emotionality, or neuroticism."
                            }
                        ]
                    },
                    {
                        "sense_id": "21627064-d1f7-3609-bfee-10aa61c8e39c",
                        "entry_id": "6869ea31-e56f-398c-8470-01d4fa7219cd",
                        "glosses": [
                            "A turning inward",
                            "Arrangement of two similar words, lines, etc. to form the middle part of a structure."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "9cd7580e-6fde-4bce-beaf-8ca97e9e3a8c",
                                "sense_id": "21627064-d1f7-3609-bfee-10aa61c8e39c",
                                "text": "Such introversion is merely a matter of form."
                            }
                        ]
                    }
                ],
