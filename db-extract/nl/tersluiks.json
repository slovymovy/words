            {
                "entry_id": "0082b776-aeae-348f-8b84-7e0fee957c18",
                "word": "tersluiks",
                "pos": "adv",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "26e2dc9b-5fc2-3d8a-8018-d42c2fe4f860",
                        "entry_id": "0082b776-aeae-348f-8b84-7e0fee957c18",
                        "glosses": [
                            "op tersluikse wijze"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a07ba6f9-a9dc-48b1-b864-9c8eba044d57",
                                "sense_id": "26e2dc9b-5fc2-3d8a-8018-d42c2fe4f860",
                                "text": "Hij trachtte tersluiks wat zout in haar koffie te doen, maar de kwade aap werd gelukkig betrapt."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f62de0b0-1319-40c3-ba66-cdc4554d707d",
                        "source_entry_id": "0082b776-aeae-348f-8b84-7e0fee957c18",
                        "source_sense_id": "26e2dc9b-5fc2-3d8a-8018-d42c2fe4f860",
                        "target_lang_word": "furtively",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "furtively",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fba0a30c-8ef1-3f03-b113-65b1c69a3f5c",
                                        "entry_id": "2a45fd33-56a9-3219-9032-6665bbd29f8a",
                                        "glosses": [
                                            "In a furtive manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "556c893d-16d1-416a-b3ab-8913b7f7eecd",
                                                "sense_id": "fba0a30c-8ef1-3f03-b113-65b1c69a3f5c",
                                                "text": "And furtively Time looked him in the face and edged towards him fingering with his dripping fingers the hilt of his nimble sword."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "26c38500-8395-4a18-8a88-bf335e55c5e0",
                        "source_entry_id": "0082b776-aeae-348f-8b84-7e0fee957c18",
                        "source_sense_id": "26e2dc9b-5fc2-3d8a-8018-d42c2fe4f860",
                        "target_lang_word": "clandestinely",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "clandestinely",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2c7d8162-217e-3ab4-a0f3-1d31f270f24f",
                                        "entry_id": "dca0d7cb-d205-3c4b-9431-765569e83789",
                                        "glosses": [
                                            "In a secret or covert manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d893cd1f-1477-4be9-9186-62bbb949a535",
                                                "sense_id": "2c7d8162-217e-3ab4-a0f3-1d31f270f24f",
                                                "text": "In another moment, Louisa's arms were around her also, welcoming her to Violet Lodge, and pouring on her a thousand thanks, yet asking, with trepidation, \"have you brought the dear girls clandestinely?\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e7f18ada-6eca-38e8-96bb-09c4b5769d87",
                                        "entry_id": "dca0d7cb-d205-3c4b-9431-765569e83789",
                                        "glosses": [
                                            "In an illicit way, i.e. not permitted by the law or regulations."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f61016c1-a99a-4e37-9c7c-3962ce4fc46c",
                        "source_entry_id": "0082b776-aeae-348f-8b84-7e0fee957c18",
                        "source_sense_id": "26e2dc9b-5fc2-3d8a-8018-d42c2fe4f860",
                        "target_lang_word": "secretly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "secretly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fa212b37-1bd2-3683-ac35-9914de12ec2b",
                                        "entry_id": "f750af24-1b9f-391b-bacc-1a1b741fa738",
                                        "glosses": [
                                            "In secret, covertly."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "955eb3c7-3628-4239-b56d-95885089fe35",
                                                "sense_id": "fa212b37-1bd2-3683-ac35-9914de12ec2b",
                                                "text": "Mary cheated secretly in the test, and never got caught."
                                            },
                                            {
                                                "example_id": "0700bdb5-d9fa-46ff-b7bd-e8349ca073f2",
                                                "sense_id": "fa212b37-1bd2-3683-ac35-9914de12ec2b",
                                                "text": "Sometimes her prose hyperventilates (\"Once, years ago, his and N.'s love for each other had glowed like phosphorescent fire on the surfaces of their bodies\"), and she has a weakness for epiphanies (\"There was a man, no longer young, though not yet old, who, traveling alone in northern Europe, began to feel that his soul was being drained slowly, almost secretly from him, drop by drop\")."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a1e080b8-fe00-4025-9231-e2169d3a6e5a",
                        "source_entry_id": "0082b776-aeae-348f-8b84-7e0fee957c18",
                        "source_sense_id": "26e2dc9b-5fc2-3d8a-8018-d42c2fe4f860",
                        "target_lang_word": "stealthily",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stealthily",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "06807067-8591-3619-a031-483a788f954b",
                                        "entry_id": "78bb9ecb-388d-3e6e-8715-e6e77961026e",
                                        "glosses": [
                                            "In a stealthy manner, furtively."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "796ff500-915d-4a3d-be6e-a0bba09abe23",
                                                "sense_id": "06807067-8591-3619-a031-483a788f954b",
                                                "text": "The dog obeyed the significant beck of his finger, and they drew off, stealthily, together."
                                            },
                                            {
                                                "example_id": "52d5ac8f-3791-483f-8436-773568419032",
                                                "sense_id": "06807067-8591-3619-a031-483a788f954b",
                                                "text": "So intent was he upon this personal appraisement of his features that he did not hear the parting of the tall grass behind him as a great body pushed itself stealthily through the jungle; nor did his companion, the ape, hear either, for he was drinking and the noise of his sucking lips and gurgles of satisfaction drowned the quiet approach of the intruder."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
