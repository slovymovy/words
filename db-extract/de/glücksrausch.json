                        "examples": [
                            {
                                "example_id": "f0ecb8e7-042a-4fed-8ba0-0e9db0e0ddf2",
                                "sense_id": "e97f97c3-e772-330d-b749-571906b1ee79",
                                "text": "„Ein Glücksrausch hebt an, denn Opium macht einen zu aller Welt Freund.“"
                            },
                            {
                                "example_id": "f0aafc42-8047-44d7-94f9-7b4a1b302ff6",
                                "sense_id": "e97f97c3-e772-330d-b749-571906b1ee79",
                                "text": "„Virginia Woolf hat die fiktive Biographie des und der Orlando in einem Glücksrausch geschrieben.“"
                            },
                            {
                                "example_id": "380155b9-6c68-4a00-8feb-5ea9c8149879",
                                "sense_id": "e97f97c3-e772-330d-b749-571906b1ee79",
                                "text": "„Der Übergang von der Angst zu einem unerwarteten Glücksrausch warf mich in einen Paroxysmus, wie ihn der stärkste Fieberanfall nicht ärger hätte verursachen können.“"
                            }
                        ],
