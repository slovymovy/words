                        "tags": [],
                        "examples": [
                            {
                                "example_id": "24fe3967-0def-43d3-8f8e-8dd31c4afa85",
                                "sense_id": "fd5da8cc-4ba3-34bf-92c8-f80b7cc137b0",
                                "text": "„Einzelstandhaltung: eine Haltungsform, bei der jedes Tier einzeln durch ein Behältnis (Einzelboxen, Kastenstand, Käfig) auf einem Standplatz fixiert ist.“"
                            },
                            {
                                "example_id": "3aa0d82f-b984-4db5-8020-20c4462378ae",
                                "sense_id": "fd5da8cc-4ba3-34bf-92c8-f80b7cc137b0",
                                "text": "„Gruppenhaltung tragender Sauen (hochgeklappte Kastenstände) und Einzelhaltung während der Deckperiode (Kastenstände unten = geschlossen) in einer Bucht ohne Umstallen ist möglich.“"
                            }
                        ],
