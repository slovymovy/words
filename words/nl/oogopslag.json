                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "look",
                                "target_lang_sense_clarification": "the expression in someone's eyes"
                            },
                            {
                                "target_lang_word": "glance",
                                "target_lang_sense_clarification": "a brief look"
                            }
                        ]
                    }
                }
