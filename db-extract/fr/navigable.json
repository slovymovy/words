                "forms": [
                    {
                        "form_id": "3c1f8084-5e27-4c8d-9852-2599d6c76c0e",
                        "entry_id": "ef250005-cb90-39f0-893d-3d43ff207329",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "navigables"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "17304971-9f79-3a33-a4ad-daa0c0f50a5c",
                        "entry_id": "ef250005-cb90-39f0-893d-3d43ff207329",
                        "glosses": [
                            "Où l’on peut naviguer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8182c307-6344-434e-8332-b599f57a3a81",
                                "sense_id": "17304971-9f79-3a33-a4ad-daa0c0f50a5c",
                                "text": "Il est d'ailleurs impossible de compter pendant les sécheresses sur la totalité du produit alimentaire parce que les riverains de la Bar profitant de ce qu'elle n'est pas considérée comme rivière navigable en amont de la prise d'eau y font de nombreuses saignées pour l'irrigation de leurs prairies ; […]."
                            },
                            {
                                "example_id": "bfefa9f1-7ae2-4e0f-a11b-92be42b90998",
                                "sense_id": "17304971-9f79-3a33-a4ad-daa0c0f50a5c",
                                "text": "D'après la chute très-considérable de la Sée dans la commune de Brouains, où les moulins sont entassés en grand nombre dans un court espace, on ne peut pas songer à rendre la Sée navigable plus haut que Chérencé-le-Roussel."
                            },
                            {
                                "example_id": "3b2f6756-ef02-47ba-915b-005561536552",
                                "sense_id": "17304971-9f79-3a33-a4ad-daa0c0f50a5c",
                                "text": "Autrefois le Lot était une voie navigable : ses écluses, ses relais faisaient vivre un peuple de mariniers. On a déclassé le Lot."
                            },
                            {
                                "example_id": "b958d478-8efe-4b8d-ab2a-b06ecf619d1e",
                                "sense_id": "17304971-9f79-3a33-a4ad-daa0c0f50a5c",
                                "text": "Les propriétaires riverains de cours d’eau non navigables ni flottables peuvent constituer une association syndicale en vue des travaux de mise en valeur piscicole de ces cours d’eau."
                            },
                            {
                                "example_id": "798d3125-cffb-46e4-8804-f3fef69e3c36",
                                "sense_id": "17304971-9f79-3a33-a4ad-daa0c0f50a5c",
                                "text": "[…] le fleuve Sumida est le seul du pays à mériter ce nom, preuve qu’il est navigable. Les autres fleuves japonais que j’ai pu voir ressemblent à des rivières ou à des torrents."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "eeca5a0b-b961-4027-9cd6-37524b565540",
                        "source_entry_id": "ef250005-cb90-39f0-893d-3d43ff207329",
                        "source_sense_id": "17304971-9f79-3a33-a4ad-daa0c0f50a5c",
                        "target_lang_word": "schiffbar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "schiffbar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "458ddff0-a6b2-3ac7-80ff-c8c8dddd5c3a",
                                        "entry_id": "a108545c-2016-3646-9620-5391eaed3b3f",
                                        "glosses": [
                                            "mit einem Schiff befahrbar"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ad704e1-f509-4ab0-9d9e-b868f3c9bab5",
                                                "sense_id": "458ddff0-a6b2-3ac7-80ff-c8c8dddd5c3a",
                                                "text": "„Die Regnitz und die Altmühl, die Nebenflüsse des Mains und der Donau, sollten durch einen schiffbaren Graben miteinander verbunden werden.“"
                                            },
                                            {
                                                "example_id": "a708cda1-fccd-4d9d-9c9f-39fa712ed6b7",
                                                "sense_id": "458ddff0-a6b2-3ac7-80ff-c8c8dddd5c3a",
                                                "text": "„Bundessache ist die Gesetzgebung und die Vollziehung in folgenden Angelegenheiten: […] 10. Bergwesen; Regulierung und Instandhaltung der schiffbaren und flößbaren Gewässer, dann solcher Gewässer, die die Grenze gegen das Ausland oder zwischen Ländern bilden oder die zwei oder mehrere Länder durchfließen; …“"
                                            },
                                            {
                                                "example_id": "fce16af0-3055-46af-8790-f7319d89a881",
                                                "sense_id": "458ddff0-a6b2-3ac7-80ff-c8c8dddd5c3a",
                                                "text": "„Viel mehr als fruchtbaren Boden und ein Flusssystem aus fast 9700 schiffbaren Kilometern, das den Handel erleichtern könnte, vermag Stanley dem Monarchen nicht in Aussicht zu stellen.“"
                                            },
                                            {
                                                "example_id": "0f047b2a-c7da-483d-a372-8f19b96218a6",
                                                "sense_id": "458ddff0-a6b2-3ac7-80ff-c8c8dddd5c3a",
                                                "text": "„Im Grenzfluss Rio Grande kann sie nicht stehen, weil der Fluss schiffbar bleiben muss.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "45f221b6-e27a-43ad-b1aa-7c231ff3ef02",
                        "source_entry_id": "ef250005-cb90-39f0-893d-3d43ff207329",
