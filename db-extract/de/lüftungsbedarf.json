                ],
                "senses": [
                    {
                        "sense_id": "51e31ea5-37e7-34d8-acae-93a60ad6b79d",
                        "entry_id": "00f4722c-0061-39fe-84d2-5d1b89825f9b",
                        "glosses": [
                            "Bedarf an Luft der zur Verfügung stehen muss"
                        ],
                        "tags": [
                            "jargon"
                        ],
                        "examples": [
                            {
                                "example_id": "b72d70df-3078-44e1-bdc5-d418eb1edea8",
                                "sense_id": "51e31ea5-37e7-34d8-acae-93a60ad6b79d",
                                "text": "„Energiesparfenster vermeiden unkontrollierte Wärmeverluste, dafür steigt der Lüftungsbedarf.“"
                            },
                            {
                                "example_id": "e891e58e-bce8-43ec-b542-394515f0886a",
                                "sense_id": "51e31ea5-37e7-34d8-acae-93a60ad6b79d",
                                "text": "„Der Lüftungsbedarf in den Stallabteilen ist aufgrund der Größe der Schweine unterschiedlich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "be650164-7dbf-36dc-b88c-fb1d25399093",
                        "entry_id": "00f4722c-0061-39fe-84d2-5d1b89825f9b",
                        "glosses": [
                            "technische Teile und Komponenten für [1]"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8bee5cc2-04f0-40f8-bfc4-af401ecf9b4a",
                                "sense_id": "be650164-7dbf-36dc-b88c-fb1d25399093",
                                "text": "„Man kann also nicht nur aus einem augenblicklichen Zustand heraus den grundsätzlichen Lüftungsbedarf ermitteln sondern über einen langen Beobachtungszeitraum.“"
                            },
                            {
                                "example_id": "e002c61b-d87e-4990-bc60-b33bb44e2020",
                                "sense_id": "be650164-7dbf-36dc-b88c-fb1d25399093",
                                "text": "„Mit bedarfsgesteuerter Lüftung ist es möglich, den Lüftungsbedarf automatisch auf die Luftqualität abzustimmen. Raumklimasensoren (CO2 und/oder RF = Relative Feuchtigkeit) messen die Luftqualität in den Räumen und passen die Lüftung automatisch daran an.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
