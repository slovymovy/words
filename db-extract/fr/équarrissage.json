            {
                "entry_id": "e69638ee-7bed-3bc9-bf6c-be5d09f9a6a4",
                "word": "équarrissage",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "b7e3141f-7c2f-45cb-a7e2-f8ff3b28c0fa",
                        "entry_id": "e69638ee-7bed-3bc9-bf6c-be5d09f9a6a4",
                        "tags": [
                            "plural"
                        ],
                        "form": "équarrissages"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b9f68442-07b6-39ac-b640-abff2c02eea7",
                        "entry_id": "e69638ee-7bed-3bc9-bf6c-be5d09f9a6a4",
                        "glosses": [
                            "Dépeçage des carcasses animales, impropres à la consommation, ou des déchets d’abattoirs (os, peau, etc.)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25b0a33a-cb1a-4a21-afba-aa2ad89038b1",
                                "sense_id": "b9f68442-07b6-39ac-b640-abff2c02eea7",
                                "text": "Lorsqu'on dispose d'un assez grand nombre d'animaux morts et qu'un atelier d’équarrissage se trouve à proximité, le meilleur parti à prendre est de les y envoyer."
                            },
                            {
                                "example_id": "0ea18c22-2eaf-40a9-97ee-a35e26df1bd1",
                                "sense_id": "b9f68442-07b6-39ac-b640-abff2c02eea7",
                                "text": "En se nourrissant des cadavres de brebis, les vautours assurent une mission d'équarrissage naturel."
                            }
                        ]
                    },
                    {
                        "sense_id": "e99be233-8f46-3c03-9d26-121a767976de",
                        "entry_id": "e69638ee-7bed-3bc9-bf6c-be5d09f9a6a4",
                        "glosses": [
                            "Action de donner à des pièces de bois, de pierre, des surfaces parallèles entre elles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "29a5dee3-af1c-40b2-9694-0047884ffcaa",
                                "sense_id": "e99be233-8f46-3c03-9d26-121a767976de",
                                "text": "Les chênes abattus correspondaient précisément aux sections recherchées par les charpentiers et leur équarrissage se faisait a minima au plus près de la surface du tronc avec peu de perte de bois."
                            }
                        ]
                    },
                    {
                        "sense_id": "123cc9ba-bbc2-30f2-a2e6-7c380bbd226a",
                        "entry_id": "e69638ee-7bed-3bc9-bf6c-be5d09f9a6a4",
                        "glosses": [
                            "Chacune des deux dimensions transversales d’une poutre façonnée."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "f6fde031-582d-4b28-9d2e-84807f994f54",
                                "sense_id": "123cc9ba-bbc2-30f2-a2e6-7c380bbd226a",
                                "text": "[…] ; comptant un sixième de ces longueurs en billes de desciage de 9 à 10 pouces d’équarrissage, un tiers en pièces solives de 7 à 8 pouces et moitié en chevrons de 4 pouces, on aurait, par hectare, un produit supérieur à 20,000 pieds cubes de bois en grume, non compris les branches."
                            },
                            {
                                "example_id": "0cf01c1e-0905-47fa-bf45-da651574719d",
                                "sense_id": "123cc9ba-bbc2-30f2-a2e6-7c380bbd226a",
                                "text": "Sur les plans de coffrage, les équarrissages des pièces doivent être fixés et cotés et n’ont en principe pas à être modifiés par le bureau d’exécution."
                            }
                        ]
                    }
                ],
