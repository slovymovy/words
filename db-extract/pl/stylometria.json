                                "target_senses": [
                                    {
                                        "sense_id": "8ed645da-d1f4-3436-8042-5fd046c9c412",
                                        "entry_id": "ffd5116e-6e20-3e6d-9a5c-cee561b0705c",
                                        "glosses": [
                                            "A statistical method of analyzing a text to determine its author."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "48cebf34-3595-4f7b-a244-d42e9e7a9416",
                                                "sense_id": "8ed645da-d1f4-3436-8042-5fd046c9c412",
                                                "text": "Stylometry is a tool to be used when external evidence is lacking and the solution to the problem must come from the study of the texts which present the problem. Stylometry is therefore particularly useful in classical studies, especially for Greek texts which were written and reproduced by hand in an era when the rights of authors were limited, […]."
                                            },
                                            {
                                                "example_id": "18c000e1-f38f-4ef6-8018-2c3597783e45",
                                                "sense_id": "8ed645da-d1f4-3436-8042-5fd046c9c412",
                                                "text": "Later WS bends it, stops mid-line, wraps around lines. This is early. Comp stylometry will confirm."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
