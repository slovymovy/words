                {
                    "sense_id": "005bc626-4a9c-3346-9c19-5f0aff4133e9",
                    "sense_definition": "Qui est légitime, convenable ou exigé par la morale, la loi ou l'usage.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "devoir_moral",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tout citoyen doit agir avec le respect <w>dû</w> aux lois de la République.",
                            "target_lang_translations": {
                                "en": "Every citizen must act with the respect <w>due</w> to the laws of the Republic.",
                                "ru": "Каждый гражданин должен действовать с <w>должным</w> уважением к законам Республики.",
                                "de": "Jeder Bürger muss den Gesetzen der Republik mit dem <w>gebührenden</w> Respekt begegnen.",
                                "es": "Todo ciudadano debe actuar con el <w>debido</w> respeto a las leyes de la República.",
                                "zh": "每个公民都应当对共和国的法律怀有<w>应有的</w>尊重。"
                            }
                        },
                        {
                            "text": "Le contrat a été signé en <w>due</w> forme devant le notaire.",
                            "target_lang_translations": {
                                "en": "The contract was signed in <w>due</w> form before the notary.",
                                "ru": "Договор был подписан в <w>надлежащей</w> форме перед нотариусом.",
                                "de": "Der Vertrag wurde vor dem Notar in <w>gehöriger</w> Form unterzeichnet.",
                                "es": "El contrato se firmó en <w>debida</w> forma ante el notario.",
                                "zh": "合同是在公证人面前以<w>规定的</w>形式签署的。"
                            }
                        }
                    ],
                    "synonyms": [
                        "légitime",
                        "mérité"
                    ],
                    "antonyms": [
                        "illégitime",
                        "indu"
                    ],
                    "common_phrases": [
                        "en due forme",
                        "respect dû"
                    ],
                    "target_lang_definitions": {
                        "en": "Legitimate, proper, or required by morality, law, or custom.",
                        "ru": "Соответствующий морали, закону или обычаю; законный и требуемый.",
                        "de": "Rechtmäßig, angemessen oder durch Moral, Gesetz oder Brauch verlangt.",
                        "es": "Legítimo, adecuado o exigido por la moral, la ley o la costumbre.",
                        "zh": "符合道德、法律或习俗要求的，正当而合乎规定的。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "due",
                                "target_lang_sense_clarification": "formal, as in 'due form'"
                            },
                            {
                                "target_lang_word": "proper",
                                "target_lang_sense_clarification": "correct, conventional, as required"
                            },
                            {
                                "target_lang_word": "rightful",
                                "target_lang_sense_clarification": "legitimate, justly deserved"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "должный",
                                "target_lang_sense_clarification": "должное уважение, в должной форме"
                            },
                            {
                                "target_lang_word": "надлежащий",
                                "target_lang_sense_clarification": "официальный стиль, правильный порядок"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "gebührend",
                                "target_lang_sense_clarification": "Respekt, Achtung, Anerkennung"
                            },
                            {
                                "target_lang_word": "gehörig",
                                "target_lang_sense_clarification": "in gehöriger Form, korrekt"
                            },
                            {
                                "target_lang_word": "schuldig",
                                "target_lang_sense_clarification": "Respekt, der geschuldet wird"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "debido",
                                "target_lang_sense_clarification": "respeto o forma exigidos"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "应有的",
                                "target_lang_sense_clarification": "应当具有的，如尊重"
                            },
                            {
                                "target_lang_word": "规定的",
                                "target_lang_sense_clarification": "按规则或法律规定的"
                            },
                            {
                                "target_lang_word": "正当的",
                                "target_lang_sense_clarification": "合法合理，多指权利"
                            }
                        ]
                    }
