                        "examples": [
                            {
                                "example_id": "3a9c0593-989f-4de3-ae1e-42c906e5b9ab",
                                "sense_id": "2214aef1-a287-3e80-aebb-f17b39175216",
                                "text": "Merkartikelen zijn in, maar superduur. De markt in nagemaakte kleding, horloges en tassen floreert."
                            },
                            {
                                "example_id": "427ac7e0-cd99-4451-adc6-aac1663468e5",
                                "sense_id": "2214aef1-a287-3e80-aebb-f17b39175216",
                                "text": "Door de vriendelijke, behulpzame Thai en de vele goede hotel- en openbaar vervoer voorzieningen (van superduur tot spotgoedkoop) is dit hét all exclusive land bij uitstek."
                            },
                            {
                                "example_id": "9886c9a0-ecef-40d8-8d3d-b98692c6deaa",
                                "sense_id": "2214aef1-a287-3e80-aebb-f17b39175216",
                                "text": "Van zoet en fruitig tot bitter en groen: je struikelt tegenwoordig over het aanbod 'koudgeperste' sappen. Superhip, maar ook superduur én - als we voedingsdeskundige Jaap Seidell mogen geloven - superonzinnig, want net zo gezond als gewoon geperst sap. Gewoon een sapje op de Cuyp halen dus."
                            }
                        ]
                    }
