                                        "entry_id": "a9a0dcef-c34a-38c6-8a57-c939dce130e5",
                                        "glosses": [
                                            "odbywający się między ludźmi, mający miejsce pomiędzy ludźmi"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca032f9e-e555-41e3-a868-df8d8d3d5bde",
                                                "sense_id": "aa9ff2ca-d1b6-3a67-9c55-ebc09b1c9d27",
                                                "text": "Komputer będzie stanowił wówczas podstawowe medium kontaktów międzyludzkich, reguły takie będą więc niezwykle potrzebne"
                                            }
                                        ],
