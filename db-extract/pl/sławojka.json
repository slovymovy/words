                ],
                "translations": [
                    {
                        "translation_id": "f3ce185b-4b1f-4b35-9211-ba65e810a7a9",
                        "source_entry_id": "0de6f3eb-8469-347a-b256-0992381ffea0",
                        "source_sense_id": "d6fbba0f-1b29-3ae3-ae4b-82b4fffa1c1a",
                        "target_lang_word": "сортир",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "сортир",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "a76a6c69-6ffb-33dd-bc9d-589e2befbbb1",
                                        "entry_id": "59b74efb-c7f0-34d4-b52c-1d8ec4716355",
                                        "glosses": [
                                            "прост. отхожее место; уборная"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b36cafbb-fde8-48e5-8540-010596317700",
                                                "sense_id": "a76a6c69-6ffb-33dd-bc9d-589e2befbbb1",
                                                "text": "Пошатываясь, дошагал до сортира, спустил штаны и уселся на стульчак, не закрыв за собой дверь."
                                            },
                                            {
                                                "example_id": "f10195ef-2d82-49b4-9388-0ca676128e02",
                                                "sense_id": "a76a6c69-6ffb-33dd-bc9d-589e2befbbb1",
                                                "text": "Они пользуются сортиром, они пользуются кухней, они пользуются телефоном"
                                            },
                                            {
                                                "example_id": "0677814b-d8e6-4d9f-ad54-24afc0b82cd3",
                                                "sense_id": "a76a6c69-6ffb-33dd-bc9d-589e2befbbb1",
                                                "text": "Бывало, человек сортир чистит, смотришь на него ― мнет ситник, сыт и весел, а теперь этот же самый человек, ведь они теперь все те же самые люди, стоит чистит нужник, ситника ему теперь нет, а нужник остался."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "daa96f2f-a84b-3021-a1f8-9b639185db3c",
                                        "entry_id": "59b74efb-c7f0-34d4-b52c-1d8ec4716355",
                                        "glosses": [
                                            "прост. положение без возможности хода"
                                        ],
                                        "tags": [
                                            "в шашках"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
