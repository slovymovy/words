                    {
                        "translation_id": "f3b54958-9bde-4aed-a672-90b4a2019e49",
                        "source_entry_id": "368daac2-8811-3f93-9ce9-9d114c1daf4a",
                        "source_sense_description": "forceful or brutal person",
                        "target_lang_word": "Machthaber",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Machthaber",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e57713de-5b3f-32d2-84e2-6ad4671957ef",
                                        "entry_id": "4ad6eaad-b60e-3059-b1dc-a1806749373a",
                                        "glosses": [
                                            "Person, die Macht und/oder Regierungsgewalt innehat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fdad82a9-be4e-49d4-86b8-b19d9d767bb9",
                                                "sense_id": "e57713de-5b3f-32d2-84e2-6ad4671957ef",
                                                "text": "„Doch statt für die braunen Machthaber zu werben, protzte der Korsar in eigener Sache.“"
                                            },
                                            {
                                                "example_id": "a62217e4-2c74-42d2-a632-00a34288f1b1",
                                                "sense_id": "e57713de-5b3f-32d2-84e2-6ad4671957ef",
                                                "text": "„Ein Militärgouverneur ist der Machthaber in einem von fremden Truppen besetzten, annektierten oder sonst wie nicht unter Eigen-, sondern fremder Militärregierung stehenden Land.“"
                                            },
                                            {
                                                "example_id": "9e455d7c-4551-4ff7-8f7d-daee2dad6477",
                                                "sense_id": "e57713de-5b3f-32d2-84e2-6ad4671957ef",
                                                "text": "„Für mehr als ein Jahr nach dem Ende der Kampfhandlungen blieben die Militärs die alleinigen Machthaber auf diesem Territorium.“"
                                            },
                                            {
                                                "example_id": "70446563-2eff-43ed-9fbc-5bf602780da3",
                                                "sense_id": "e57713de-5b3f-32d2-84e2-6ad4671957ef",
                                                "text": "„Als Machthaber der Insel gaben die Deutschen auch Briefmarken heraus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "88f946c9-0c88-467f-ac00-5cce059a74d5",
                        "source_entry_id": "368daac2-8811-3f93-9ce9-9d114c1daf4a",
                        "source_sense_description": "forceful or brutal person",
                        "target_lang_word": "Diktator",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Diktator",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ede18aad-2f3d-345c-acc9-7eafd4d745a4",
                                        "entry_id": "2305f68a-4c16-36e9-8445-5cdfe5068a4b",
                                        "glosses": [
                                            "Herrscher mit uneingeschränkter Machtfülle"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e5693a4c-9835-42b8-a1f0-96d73d2ca299",
                                                "sense_id": "ede18aad-2f3d-345c-acc9-7eafd4d745a4",
                                                "text": "Nordkorea wird nach wie vor von einem Diktator beherrscht."
                                            },
                                            {
                                                "example_id": "f101ae37-3c74-4894-bb81-490870cea0bd",
                                                "sense_id": "ede18aad-2f3d-345c-acc9-7eafd4d745a4",
                                                "text": "„Immer wieder erhält sie Morddrohungen, weil sie Russland als Terrorstaat bezeichnete und Putin als Diktator.“"
                                            },
                                            {
                                                "example_id": "c5144df0-11c3-4f0d-b054-492f377e1487",
                                                "sense_id": "ede18aad-2f3d-345c-acc9-7eafd4d745a4",
                                                "text": "„Als sich die Führer der arabischen Welt vorigen Mittwoch im ägyptischen Scharm-al-Scheich trafen, fehlte Tunesiens Diktator Ben Ali zum ersten Mal in dieser Runde.“"
                                            },
                                            {
                                                "example_id": "37f3c287-8439-4750-aac4-0fe7bac764b2",
                                                "sense_id": "ede18aad-2f3d-345c-acc9-7eafd4d745a4",
                                                "text": "„Mit dem Partisanenführer Tito, der bereits große Teile Jugoslawiens beherrschte, hatte der sowjetische Diktator verabredet, daß die Rote Armee zu ihm und dann gemeinsam weiter westwärts durchstoßen werde.“"
                                            },
                                            {
                                                "example_id": "47bcc5d6-e362-4c93-81bb-84baa8477295",
                                                "sense_id": "ede18aad-2f3d-345c-acc9-7eafd4d745a4",
                                                "text": "„Alle nachfolgenden Diktatoren Venezuelas beriefen sich auf ihn, und er ist bis heute ein Heros der weißen Elite, aus der er stammte, und auch das Idol der Armen.“"
                                            },
                                            {
                                                "example_id": "1b921a74-1fb1-442d-bb4b-c5a32da1d6c7",
                                                "sense_id": "ede18aad-2f3d-345c-acc9-7eafd4d745a4",
                                                "text": "„Oft wandten sich die Gespräche dem Schicksal von Frankreich in einem sich nahezu täglich wandelnden Europa zu, mit einem Krieg in Spanien und einem Diktator in Deutschland, dessen Versprechungen nicht mehr wert waren als Toilettenpapier, wie Gide sich ausdrückte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "84800f22-7929-4e53-a258-f85fc4be4ccb",
                        "source_entry_id": "368daac2-8811-3f93-9ce9-9d114c1daf4a",
