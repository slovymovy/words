                        "sense_id": "59284898-a6ac-3318-adb7-a16100401334",
                        "entry_id": "119234d2-2a71-38d7-9ce2-33cbb5da217a",
                        "glosses": [
                            "manier waarop de bespeler van een muziekinstrument snaren of toetsen aanraakt voor zover die van invloed is op de klank van de muziek"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "06c3d2a6-2698-45c8-ae53-b5a057ee1bef",
                                "sense_id": "59284898-a6ac-3318-adb7-a16100401334",
                                "text": "Het is bekend dat het groot historisch orgel te Alkmaar zwaar is om te bespelen, zeker met gekoppelde klavieren. Maar met het juiste armgewicht en een goed toucher is het niet onmogelijk."
                            },
                            {
                                "example_id": "c14f3f26-df01-4f1e-b70d-7bc536e82cad",
                                "sense_id": "59284898-a6ac-3318-adb7-a16100401334",
                                "text": "Zijn pianospel betoverde, zijn toucher was onweerstaanbaar."
                            },
                            {
                                "example_id": "ff65de18-0466-48f9-ae11-e1ce3e174eb5",
                                "sense_id": "59284898-a6ac-3318-adb7-a16100401334",
                                "text": "Mevr. Laskine heeft altijd nog die kwasi oneindig genuanceerde gevoeligheid in de vingertoppen en in de palm der handen (te vergelijken met de verfijnde sensibiliteit van blinden), welke haar toucher uniek maakt en de harp het meest melodieuze, het expressiefste der instrumenten; (…)"
                            }
                        ]
                    },
                    {
                        "sense_id": "21e94f36-1e45-3724-84b4-a0ee3ddcee60",
                        "entry_id": "119234d2-2a71-38d7-9ce2-33cbb5da217a",
                        "glosses": [
                            "betasting met de wijsvinger in een opening van het onderlichaam"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f5f6793f-7291-4f8a-ae31-621586c5de36",
                                "sense_id": "21e94f36-1e45-3724-84b4-a0ee3ddcee60",
                                "text": "Mijn montere patiënt, de oude Gé,\nzit even vaak voor 't raam als op de plee:\nprostaatvergroting blijkens het toucher,\nmet stuwing in het urinaal tracé,(…)"
                            }
                        ]
                    }
