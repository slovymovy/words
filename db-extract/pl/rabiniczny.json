                "senses": [
                    {
                        "sense_id": "83b7364b-cb4d-334f-afc7-a01d453722a8",
                        "entry_id": "1fc89410-1935-3f32-bd00-84a47622b198",
                        "glosses": [
                            "związany z doktryną rabinów, dotyczący doktryny rabinów"
                        ],
                        "tags": [],
