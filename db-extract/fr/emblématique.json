                                            {
                                                "example_id": "f6dfeff6-96da-4dce-80a7-7bfcbe40f8d9",
                                                "sense_id": "a5cbabb0-73ec-352f-a8ef-1bc02a22a35c",
                                                "text": "„Für einen solchen öffentlichen Friedensdialog sei der symbolischste Ort der Kölner Dom, regte Bap-Sänger Wolfgang Niedecken anschließend an.“"
