                "senses": [
                    {
                        "sense_id": "ac1f5817-e70b-3bfb-927d-f8d12437bf91",
                        "entry_id": "123f339b-9b7a-3b62-b6f7-b5c05f54a8fe",
                        "glosses": [
                            "Celui qui abandonne ses amis, malgré ce qui était organisé avec eux (ou éventuellement qui abandonne son parti, ses principes, etc.)."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "db74f98c-6de5-41c2-913a-315083b79f8e",
                                "sense_id": "ac1f5817-e70b-3bfb-927d-f8d12437bf91",
                                "text": "Tu es un joli lâcheur. N’importe !... monte et conduis-moi au cercle. J'en ai long à te conter."
                            },
                            {
                                "example_id": "77fcee9c-17f2-4f56-8934-b302d243dfb5",
                                "sense_id": "ac1f5817-e70b-3bfb-927d-f8d12437bf91",
                                "text": "Léontine. — Mais vous me disiez qu’il y avait longtemps que vous n’aviez pas vu M. Duchotel ?\nCassagne. — Oh ! il y a belle lurette, au moins six mois !\nLéontine. — Six mois !\nCassagne. — Vous lui direz que c’est un lâcheur !"
                            },
                            {
                                "example_id": "d095493d-3a7f-4c50-813d-fa82e89ec58b",
                                "sense_id": "ac1f5817-e70b-3bfb-927d-f8d12437bf91",
                                "text": "Paul : Je suis fidèle aux gens que je fais bosser, si je pars je suis un lâcheur."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1dde50be-f565-49e8-ac3c-05c169c7599b",
                        "source_entry_id": "123f339b-9b7a-3b62-b6f7-b5c05f54a8fe",
                        "source_sense_id": "ac1f5817-e70b-3bfb-927d-f8d12437bf91",
                        "target_lang_word": "flake",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "flake",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b91a87be-3c09-3ea1-afbe-1b46caf304e9",
                                        "entry_id": "117d312a-9af4-33f6-a327-ad3d795d53b1",
                                        "glosses": [
                                            "A loose filmy mass or a thin chiplike layer of anything"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97f89e5a-54b3-4712-9348-23ec1e08a992",
                                                "sense_id": "b91a87be-3c09-3ea1-afbe-1b46caf304e9",
                                                "text": "There were a few flakes of paint on the floor from when we were painting the walls."
                                            },
                                            {
                                                "example_id": "c17a20e0-0b22-4c8a-ad4a-038f2348e5e0",
                                                "sense_id": "b91a87be-3c09-3ea1-afbe-1b46caf304e9",
                                                "text": "flakes of dandruff"
                                            },
                                            {
                                                "example_id": "005d37ba-3ce3-493a-b468-8d0a0881a389",
                                                "sense_id": "b91a87be-3c09-3ea1-afbe-1b46caf304e9",
                                                "text": "And you treated my woman to a flake of your life. And when she came back she was nobody's wife."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "efda029b-656c-3a2b-baad-98b93a787ced",
                                        "entry_id": "117d312a-9af4-33f6-a327-ad3d795d53b1",
                                        "glosses": [
                                            "A scale of a fish or similar animal"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9a9e57a4-9771-3a07-a913-db59b68532e4",
                                        "entry_id": "117d312a-9af4-33f6-a327-ad3d795d53b1",
                                        "glosses": [
                                            "A prehistoric tool chipped out of stone."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9e2400b1-d817-38e5-a7a4-aff793413763",
                                        "entry_id": "117d312a-9af4-33f6-a327-ad3d795d53b1",
                                        "glosses": [
                                            "A person who is impractical, flighty, unreliable, or inconsistent; especially with maintaining a living."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5d69089a-6960-4860-be75-9fb87d0ec2b9",
                                                "sense_id": "9e2400b1-d817-38e5-a7a4-aff793413763",
                                                "text": "She makes pleasant conversation, but she's kind of a flake when it comes time for action."
                                            },
                                            {
                                                "example_id": "16172a5b-e331-49bb-a687-c835d4353954",
                                                "sense_id": "9e2400b1-d817-38e5-a7a4-aff793413763",
                                                "text": "The center encouraged its devotees to wear lucky red strings around one wrist, which Neumann did for quite a while, until a more sober-minded business person warned him to lose the item or risk confirming his burgeoning reputation as a flake."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c30e7f25-7dc1-3f92-92ea-55f31750f0fc",
                                        "entry_id": "117d312a-9af4-33f6-a327-ad3d795d53b1",
                                        "glosses": [
                                            "A carnation with only two colours in the flower, the petals having large stripes."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "11a5023c-d2ec-310e-8c22-90dced49addd",
                                        "entry_id": "117d312a-9af4-33f6-a327-ad3d795d53b1",
                                        "glosses": [
                                            "A flat turn or tier of rope."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3073084d-22e7-46ab-88b7-afd04691d552",
                                                "sense_id": "11a5023c-d2ec-310e-8c22-90dced49addd",
                                                "text": "Admiral: What mean you by flakes?\nCaptain: They are only those several circles or rounds of the roapes or cables, that are quoiled up round."
                                            },
                                            {
                                                "example_id": "019a7d9f-be25-4595-a84d-c14cfc3f8feb",
                                                "sense_id": "11a5023c-d2ec-310e-8c22-90dced49addd",
                                                "text": "A flake is the sailor's term for a turn in an ordinary coil, or for a complete tier in a flat coil, as a French or Flemish flake. The current dictionary form of the word is fake, a word that I have never heard used with this meaning.\nA Flemish flake is a spiral coil of one layer only."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "91993bd5-1d4f-3b2f-8ead-836bc1046bc3",
                                        "entry_id": "117d312a-9af4-33f6-a327-ad3d795d53b1",
                                        "glosses": [
                                            "A corrupt arrest, e.g. to extort money for release or merely to fulfil a quota."
                                        ],
                                        "tags": [
                                            "US",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d5bc5dcc-cb1d-4596-a64a-86a34123705f",
                                                "sense_id": "91993bd5-1d4f-3b2f-8ead-836bc1046bc3",
                                                "text": "When police decided to score gamblers, they would most often flake people with gambling slips, then demand $25 or $50 for not arresting them. Other times, they would simply threaten a flake and demand money."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "617e00f9-5265-34ff-9281-155fc11b4cc7",
                                        "entry_id": "117d312a-9af4-33f6-a327-ad3d795d53b1",
                                        "glosses": [
                                            "A wire rack for drying fish."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "flake",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "baba735a-37f6-3609-a3d0-055fdf7ee9c7",
                                        "entry_id": "d6c8501a-3997-35b9-b365-d17615b35ae8",
                                        "glosses": [
                                            "To break or chip off in a flake."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac6bf92d-9c5a-46ef-86f2-f854382d34ee",
                                                "sense_id": "baba735a-37f6-3609-a3d0-055fdf7ee9c7",
                                                "text": "The paint flaked off after only a year."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b43fc228-073a-3fbd-bf58-cc02ce0153c1",
                                        "entry_id": "d6c8501a-3997-35b9-b365-d17615b35ae8",
                                        "glosses": [
                                            "To prove unreliable or impractical; to abandon or desert, to fail to follow through."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "db3e8d5b-b690-4988-911c-d5692189a10c",
                                                "sense_id": "b43fc228-073a-3fbd-bf58-cc02ce0153c1",
                                                "text": "He said he'd come and help, but he flaked."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d36b428-4d64-36ef-b2ad-44f1f9e5d40d",
                                        "entry_id": "d6c8501a-3997-35b9-b365-d17615b35ae8",
                                        "glosses": [
                                            "To store an item such as rope or sail in layers"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "555017bd-f438-421e-858b-53862c647b5f",
                                                "sense_id": "1d36b428-4d64-36ef-b2ad-44f1f9e5d40d",
                                                "text": "The line is flaked into the container for easy attachment and deployment."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "04382c23-c706-34d1-b3e7-3f4dbfb76532",
                                        "entry_id": "d6c8501a-3997-35b9-b365-d17615b35ae8",
