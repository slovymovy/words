                    }
                ],
                "senses": [
                    {
                        "sense_id": "2b7001a2-bd7d-307c-9ead-6cd89c24e09b",
                        "entry_id": "e6947c71-a657-36d3-b1a7-4cda74b0cf6a",
                        "glosses": [
                            "Person, die Violine spielt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0181d6e-3d18-4229-b88d-fabdd7c4e357",
                                "sense_id": "2b7001a2-bd7d-307c-9ead-6cd89c24e09b",
                                "text": "„Schließlich ist der Mann ein gefeierter Violinist und Dirigent, der im zarten Alter von sieben Jahren im japanischen Fernsehen als Geigen-Wunderkind herumgereicht wurde, und obendrein Spross einer der einflussreichsten Familien Japans.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bf9f3546-5e7f-489c-b717-96268c959ff9",
                        "source_entry_id": "e6947c71-a657-36d3-b1a7-4cda74b0cf6a",
                        "source_sense_id": "2b7001a2-bd7d-307c-9ead-6cd89c24e09b",
                        "source_sense_description": "Person, die Violine spielt",
                        "target_lang_word": "violoniste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "violoniste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9854544c-6b41-3286-a363-a885e07d21f7",
                                        "entry_id": "6fdfbf59-46e7-3138-953c-3e5a41001092",
                                        "glosses": [
                                            "Celui ou celle qui joue du violon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "940d3aeb-fabd-49d9-a037-e4a4f78161eb",
                                                "sense_id": "9854544c-6b41-3286-a363-a885e07d21f7",
                                                "text": "Avec Sophie Belloir, mezzo-soprano ; Maël Fauvy, guitariste et compositeur, et Chani Stroobant, violoniste."
                                            },
                                            {
                                                "example_id": "a6a42e47-68c9-4f5e-aa52-a84c24bd35f9",
                                                "sense_id": "9854544c-6b41-3286-a363-a885e07d21f7",
                                                "text": "Un soir, attendant l'heure du dîner, Claire et Marcelle, cédant je suppose à une prière générale, jouèrent quelques morceaux ensemble, la pianiste accompagnant sa sœur violoniste."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
