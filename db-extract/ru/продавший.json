                ],
                "senses": [
                    {
                        "sense_id": "cba39d5c-36f2-3208-bd5f-ee35b3409e81",
                        "entry_id": "62183942-f701-3a05-be65-e280f817b73d",
                        "glosses": [
                            "действ. прич. прош. вр. от продать"
                        ],
                        "tags": [
                            "participle"
                        ],
                        "examples": [
                            {
                                "example_id": "699ca902-8990-462e-b40d-c20df5e2bfa6",
                                "sense_id": "cba39d5c-36f2-3208-bd5f-ee35b3409e81",
                                "text": "Продавший ниже положенной цены обязан заплатить известную денежную пеню и лишается права торговать в том году на ярмарке."
                            },
                            {
                                "example_id": "0c478226-8c0e-4b37-b05a-7920ebb67855",
                                "sense_id": "cba39d5c-36f2-3208-bd5f-ee35b3409e81",
                                "text": "Корыстолюбивая девочка, мгновенно продавшая свою подругу Веру, ту самую, которая отключила по просьбе Кати аппарат искусственной вентиляции легких в палате несчастного Сергея Якунина."
                            }
                        ]
                    }
