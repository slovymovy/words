                "senses": [
                    {
                        "sense_id": "ba61dc29-daa0-32ea-9558-b755ddb237ec",
                        "entry_id": "01884cee-9eb8-373a-9597-79d25a088d59",
                        "glosses": [
                            "Anhängerin der zaristischen Monarchie in Russland"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "0dfdec14-76e4-404e-8b86-3637bf49f43f",
                                "sense_id": "ba61dc29-daa0-32ea-9558-b755ddb237ec",
                                "text": "Lisa konnte als unverbesserliche Zaristin die Bolschewiki, wie sie das derzeitige Regime nannte, nicht leiden."
                            },
                            {
                                "example_id": "a5d97dc5-33a9-49b0-b77f-53862962093c",
                                "sense_id": "ba61dc29-daa0-32ea-9558-b755ddb237ec",
                                "text": "Da ihre Ideen bloße Attitüden sind, ist es ihnen gleichgültig, wie überholt die Sache, für die sie eintreten, sein mag: sie können 1914 Legitimistinnen und 1949 Zaristinnen sein."
                            },
                            {
                                "example_id": "d420dc3b-c3b5-4576-ae9e-3f48a391cca4",
                                "sense_id": "ba61dc29-daa0-32ea-9558-b755ddb237ec",
                                "text": "…, zum anderen lässt Lenin im Dezember 1917 eine Spezialeinheit bilden, die anfangs die Aufstände der ZaristInnen [sic], in den darauffolgenden Monaten auch die Aufstände hungernder Bauern im Inneren unterdrücken soll, die ab 1918 auch Lager mit mehreren zehntausend Oppositionellen errichtet und als Geheimdienst Tscheka bekannt wurde."
                            },
                            {
                                "example_id": "abdfbb15-213b-4665-ba6b-dc21219a1364",
                                "sense_id": "ba61dc29-daa0-32ea-9558-b755ddb237ec",
                                "text": "Sie war eine Zaristin, die keine Umerziehung durchgemacht hatte."
                            },
                            {
                                "example_id": "48651134-6065-40c8-afb6-b402a8534a40",
                                "sense_id": "ba61dc29-daa0-32ea-9558-b755ddb237ec",
                                "text": "Eleonore Schiemann war und ist keine Zaristin. „Kunst ist Kunst, und Politik ist Politik“, sagt sie."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
