                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e5637714-7eb0-4424-95ba-ba4703d48202",
                                                "sense_id": "f9e816e3-bf86-3942-b6b5-faf56cf43c4e",
                                                "text": "He hoped to win the princess's heart by mixing the love potion the witch gave him into her drink."
                                            }
