                        "glosses": [
                            "имеющий тёмный оттенок карего цвета"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c297198e-d78f-4840-b36c-39e358758ece",
                                "sense_id": "6d461c22-7234-32d9-8ae6-7fd24a7e05a3",
                                "text": "Черты его смуглого лица отлиты грозным величием; тёмно-карие глаза, прикованные к одному предмету, горят восторгом: так мог только смотреть бог на море, усмирённое его державным трезубцем!"
                            }
                        ]
                    }
