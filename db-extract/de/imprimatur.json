                                        "sense_id": "84dfe897-f3a5-34ae-87e4-ecbe8cf24d2f",
                                        "entry_id": "542c676c-6e66-30b8-87ce-c2c62fe0103d",
                                        "glosses": [
                                            "An official license to publish or print something, especially when censorship applies."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93cea79d-87ef-4dd2-a224-e0e2af587baf",
                                                "sense_id": "84dfe897-f3a5-34ae-87e4-ecbe8cf24d2f",
                                                "text": "The Cheats · A Comedy · Written in the Year, M.DC.LXII. Imprimatur, Roger L'estrange. Nov. 5. 1663. By John Wilson"
                                            },
                                            {
                                                "example_id": "a404f86f-2e09-4435-b7f4-694274d8f84f",
                                                "sense_id": "84dfe897-f3a5-34ae-87e4-ecbe8cf24d2f",
                                                "text": "Sometimes 5 Imprimaturs are ſeen together dialogue-wiſe in the Piatza of one Title page, complementing and ducking each other with their ſhav'n reverences, whether the Author, who ſtands by in perplexity at the foot of his Epiſtle, ſhall to the Preſſe or to the ſpunge."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "532498eb-a593-325d-9ed1-5fb39e3cba25",
                                        "entry_id": "542c676c-6e66-30b8-87ce-c2c62fe0103d",
                                        "glosses": [
                                            "Any mark of official approval."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2c347c0b-f7af-456e-9f95-6cec293f2edb",
                                                "sense_id": "532498eb-a593-325d-9ed1-5fb39e3cba25",
                                                "text": "Children, the final imprimatur to family life, are being borrowed, adopted, created by artificial insemination."
                                            },
                                            {
                                                "example_id": "1612c518-1017-477c-8dd8-603bcbba0119",
                                                "sense_id": "532498eb-a593-325d-9ed1-5fb39e3cba25",
                                                "text": "Even with the imprimatur of Tynan and Hobson, the play was not an instant hit."
                                            },
                                            {
                                                "example_id": "b1a41b40-638f-42e7-a7a6-f24ce7af3954",
                                                "sense_id": "532498eb-a593-325d-9ed1-5fb39e3cba25",
                                                "text": "The author suggests that Grace is hoping to meet at church a respectable marriage candidate who will have the imprimatur of her pastor and the church community."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
