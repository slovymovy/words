                                    {
                                        "sense_id": "ddb3a1b3-d1d8-3dd9-8f56-fbc0b080dc70",
                                        "entry_id": "6c8da6ad-e6f8-3775-90f3-461e00fd3b4d",
                                        "glosses": [
                                            "A building, often found on a farm, used for storage or keeping animals such as cattle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "849970b5-e06a-4524-bec5-8c9cc5b63f89",
                                                "sense_id": "ddb3a1b3-d1d8-3dd9-8f56-fbc0b080dc70",
                                                "text": "One day I was out in the barn and he drifted in. I was currying the horse and he set down on the wheelbarrow and begun to ask questions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c83cfdc-3115-3ae4-9f59-7b25ffc2ea15",
                                        "entry_id": "6c8da6ad-e6f8-3775-90f3-461e00fd3b4d",
                                        "glosses": [
                                            "A unit of surface area equal to 10⁻²⁸ square metres."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e3300a02-ad0c-3dd4-bc10-4b90c8be3f40",
                                        "entry_id": "6c8da6ad-e6f8-3775-90f3-461e00fd3b4d",
                                        "glosses": [
                                            "An arena."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
