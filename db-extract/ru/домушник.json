                        "translation_id": "0dd077df-8ab9-490d-b6f4-1e09217fccc0",
                        "source_entry_id": "51eff737-be76-3b40-a35a-ef830ccbe9ed",
                        "source_sense_id": "b7613d55-d744-3804-be6f-77f67644ef39",
                        "target_lang_word": "burglar",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "burglar",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4baf8ceb-e8d4-3e9d-bdcf-f39b9f2ca710",
                                        "entry_id": "e50bb4d8-0ab7-3513-83ed-fa0f4b74835c",
                                        "glosses": [
                                            "A person who breaks in to premises with the intent of committing theft."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c613a06-fffe-4426-b151-a8f1afa99202",
                                                "sense_id": "4baf8ceb-e8d4-3e9d-bdcf-f39b9f2ca710",
                                                "text": "The burglar made off with a large diamond from the museum."
                                            },
                                            {
                                                "example_id": "6de9896d-8722-4425-a1ee-2cd531a41eeb",
                                                "sense_id": "4baf8ceb-e8d4-3e9d-bdcf-f39b9f2ca710",
                                                "text": "In the village itself his lionheartedness had been a legend ever since he had brained a burglar with a number seven iron, and the jury in Guildford had, despite the clear direction of the judge, resolutely declined to convict him for the use of unnecessary force."
                                            },
                                            {
                                                "example_id": "1d04e474-7b8d-445a-bbe7-c3a62618d0d6",
                                                "sense_id": "4baf8ceb-e8d4-3e9d-bdcf-f39b9f2ca710",
                                                "text": "There’s good reason to worry. In an earlier memoir, “Five-Finger Discount,” Stapinski recreated the terrifying world of swindlers, embezzlers, burglars and mobster wannabes who made up her extended Jersey City family."
                                            },
                                            {
                                                "example_id": "b35edd3d-fb7b-4d1d-8558-a49c82e29109",
                                                "sense_id": "4baf8ceb-e8d4-3e9d-bdcf-f39b9f2ca710",
                                                "text": "Corona, who carries a pistol filled not with bullets but with tequila and drives around in his pickup truck that says “Porder Batrol” on the side, says he was playing pickleball at the time, which allowed the burglar free rein to the territory."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "burglar",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "363a85b6-6ebb-3d7e-8dc9-18be66b053f4",
                                        "entry_id": "05a92250-63b5-3f9d-aab4-87d5edebf0af",
                                        "glosses": [
                                            "To commit burglary."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "76e2edf9-8491-44b9-b65e-8e81c1fc5eb7",
                                                "sense_id": "363a85b6-6ebb-3d7e-8dc9-18be66b053f4",
                                                "text": "The latter, with another constable, remained to watch the burglared premises both back and front, […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c8fd97ae-fe55-4db8-bab4-04dc6b9c0166",
                        "source_entry_id": "51eff737-be76-3b40-a35a-ef830ccbe9ed",
                        "source_sense_id": "b7613d55-d744-3804-be6f-77f67644ef39",
                        "target_lang_word": "cat burglar",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cat burglar",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f606cd09-56e4-369f-a6e2-1e671999fd3b",
                                        "entry_id": "94af92ca-b501-316b-a03a-aaba265eb315",
                                        "glosses": [
                                            "A particularly stealthy burglar, especially one who gains undetected entry through the use of agility."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c75fea5f-71cf-40be-96f3-66b493641111",
                                                "sense_id": "f606cd09-56e4-369f-a6e2-1e671999fd3b",
                                                "text": "The police were baffled by the exploits of a cat burglar who only stole from the upper floors of high-rise apartments."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "613c8aa4-3005-4edc-bfdc-561845d12885",
                        "source_entry_id": "51eff737-be76-3b40-a35a-ef830ccbe9ed",
                        "source_sense_id": "b7613d55-d744-3804-be6f-77f67644ef39",
                        "target_lang_word": "second-story man",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "second-story man",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0da6f49d-9e62-3f96-b6a2-01c75853c5ac",
                                        "entry_id": "e33b10cd-7ac8-3757-8118-e982e1d09946",
                                        "glosses": [
                                            "A burglar, especially one who performs a legitimate service at a residence and returns later to perform the theft, usually by way of an unconventional access point above ground level that was identified in the initial visit."
                                        ],
                                        "tags": [
                                            "US",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d514ff5b-0979-4565-80ac-9bf0643950c4",
                                                "sense_id": "0da6f49d-9e62-3f96-b6a2-01c75853c5ac",
                                                "text": "For a brief period in Warsaw in the 1890s, Kornblum had been forced into a life of crime, as a second-story man, and the prospect of prizing the Golem out of its current home, unsuspected, awoke wicked old memories of gaslight and stolen gems."
                                            },
                                            {
                                                "example_id": "1b414cbc-1f8d-446e-a835-e6b281c57dca",
                                                "sense_id": "0da6f49d-9e62-3f96-b6a2-01c75853c5ac",
                                                "text": "They were appalled by his idea of making a spy service out of a scattershot collection of Wall Street brokers, Ivy League eggheads, soldiers of fortune, ad men, news men, stunt men, second-story men, and con men."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
