                    {
                        "sense_id": "c68f6ef3-5c59-3531-9309-c3361becefc6",
                        "entry_id": "0ac79acd-059d-3a8a-b766-fd7a6dfea9dd",
                        "glosses": [
                            "Balken, die im Bereich einer Dachkonstruktion verwendet werden."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9eba9f9-d223-4c74-b71b-a0d8e489f625",
                                "sense_id": "c68f6ef3-5c59-3531-9309-c3361becefc6",
                                "text": "Die Dachbalken unseres Hauses sind aus Eichenholz."
                            },
                            {
                                "example_id": "1872d34c-1a12-43dd-8bef-e8a11ea1dc8a",
                                "sense_id": "c68f6ef3-5c59-3531-9309-c3361becefc6",
                                "text": "„Selbst die Dachbalken über unseren Köpfen waren von großen feierlichen Vögeln besetzt, die träge ihr Gewicht von einem Bein aufs andere verlagerten, als unsere Stimmen ihren Schlummer störten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
