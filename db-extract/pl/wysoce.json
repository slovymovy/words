                "translations": [
                    {
                        "translation_id": "c943debf-d031-4d67-a303-4b908e05e66a",
                        "source_entry_id": "5ba1aef2-8a45-3a51-828b-052e9dcbd67c",
                        "source_sense_id": "338f39d0-0cee-3a52-9565-93858a2cbbb2",
                        "target_lang_word": "highly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "highly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "972ec5d3-7ebc-3a4b-9e78-0d5b7281cd3f",
                                        "entry_id": "2c2101c1-929d-3a7f-b513-4289ad20c1af",
                                        "glosses": [
                                            "In a high or esteemed manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a9566f3-6e08-4ca7-9d55-708ca1b50b43",
                                                "sense_id": "972ec5d3-7ebc-3a4b-9e78-0d5b7281cd3f",
                                                "text": "He spoke highly of you."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cc337a98-e529-37c8-bde4-406b8cc55e2d",
                                        "entry_id": "2c2101c1-929d-3a7f-b513-4289ad20c1af",
                                        "glosses": [
                                            "Extremely; greatly; very much."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01ee1f4e-b78e-4dc7-a387-9cf4039fb45e",
                                                "sense_id": "cc337a98-e529-37c8-bde4-406b8cc55e2d",
                                                "text": "He is in a highly visible job."
                                            },
                                            {
                                                "example_id": "5a0826b4-0abc-4585-b96c-9019b2698eb6",
                                                "sense_id": "cc337a98-e529-37c8-bde4-406b8cc55e2d",
                                                "text": "The book was highly controversial yet sold unbelievably well."
                                            },
                                            {
                                                "example_id": "337e5178-3406-45b2-a5a6-96edd439480b",
                                                "sense_id": "cc337a98-e529-37c8-bde4-406b8cc55e2d",
                                                "text": "There are those who value a seat sufficiently highly that they prefer to make their daily journeys by the Western Region Vine Street line."
                                            },
                                            {
                                                "example_id": "723f4fdf-51cb-4e27-9b38-cb754c8af5e5",
                                                "sense_id": "cc337a98-e529-37c8-bde4-406b8cc55e2d",
                                                "text": "Plant breeding is always a numbers game.[…]The wild species we use are rich in genetic variation, and individual plants are highly heterozygous and do not breed true. In addition, we are looking for rare alleles, so the more plants we try, the better."
                                            },
                                            {
                                                "example_id": "10075024-0d30-4850-ba81-5d58a7b4bc01",
                                                "sense_id": "cc337a98-e529-37c8-bde4-406b8cc55e2d",
                                                "text": "The highly anticipated all-American matchup between Taylor Fritz and Frances Tiafoe — marking the first US Open semifinals between two US men in nearly 20 years — will cost you quite a few Honey Deuces to attend."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "76ae2bd9-540d-4837-bf11-af8b9d93c44e",
                        "source_entry_id": "5ba1aef2-8a45-3a51-828b-052e9dcbd67c",
                        "source_sense_id": "338f39d0-0cee-3a52-9565-93858a2cbbb2",
                        "target_lang_word": "eminently",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "eminently",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "60f196f1-af95-3478-8e10-4f481443fb91",
                                        "entry_id": "2c446332-53e6-3bf2-b551-11036ddbfcf7",
                                        "glosses": [
                                            "In an eminent or prominent manner."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1acde108-7997-3fd7-87e7-1068b1fea638",
                                        "entry_id": "2c446332-53e6-3bf2-b551-11036ddbfcf7",
                                        "glosses": [
                                            "To a great degree; notably; highly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1551d64c-33b9-4301-a42f-bd0f0cc68901",
                                                "sense_id": "1acde108-7997-3fd7-87e7-1068b1fea638",
                                                "text": "Everyone supported the nominee because she was eminently qualified."
                                            },
                                            {
                                                "example_id": "1d23e994-fe1d-4c16-94d2-f3c200a883b7",
                                                "sense_id": "1acde108-7997-3fd7-87e7-1068b1fea638",
                                                "text": "Here Mr. Bandparts at once proceeded to put the position as between master and pupil on an eminently sound footing, clearly exulting in this opportunity of exercising some baritone oratory that had suffered a period of disuse.",
                                                "translation": "Redheap",
                                                "english": "Redheap"
                                            },
                                            {
                                                "example_id": "a616a2a0-19ad-4907-9379-94c77f49ba2c",
                                                "sense_id": "1acde108-7997-3fd7-87e7-1068b1fea638",
                                                "text": "So while Ralph generally seems to inhabit a different, more glorious and joyful universe than everyone else here his yearning and heartbreak are eminently relateable."
                                            },
                                            {
                                                "example_id": "8afd0767-d7f7-4c1a-a70b-32259cde3b59",
                                                "sense_id": "1acde108-7997-3fd7-87e7-1068b1fea638",
                                                "text": "There's far more than just hot dogs to feast on too. The pizzas—gigantic, floppy, with a hyperreal waxy sheen—are mythic. They arrive exclusively in cheese, pepperoni, or supreme—the holy trinity—and will run you an eminently affordable $1.99 for a ridiculously huge wedge-shaped slice."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "07dd0621-4f5c-431a-b2e3-e897c650f968",
                        "source_entry_id": "5ba1aef2-8a45-3a51-828b-052e9dcbd67c",
                        "source_sense_id": "338f39d0-0cee-3a52-9565-93858a2cbbb2",
                        "target_lang_word": "höchst",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "höchst",
                                "target_lang_code": "de",
