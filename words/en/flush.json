{
    "word_family": [
        "flusher"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "41cf8859-feef-397c-a772-a2f8cd3d16d0",
                    "sense_definition": "To clean a toilet by causing a large amount of water to flow through it.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "cleaning_water",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please remember to <w>flush</w> the toilet before you leave the bathroom.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, не забудь <w>смыть</w> воду в туалете перед выходом из ванной.",
                                "zh": "离开洗手间前，请记得<w>冲水</w>。",
                                "cs": "Před odchodem z koupelny nezapomeň <w>spláchnout</w> toaletu."
                            }
                        },
                        {
                            "text": "The handle was broken, so I could not <w>flush</w> it properly.",
                            "target_lang_translations": {
                                "ru": "Ручка была сломана, поэтому я не мог нормально <w>смыть</w> воду.",
                                "zh": "把手坏了，所以我没法正常<w>冲水</w>。",
                                "cs": "Rukojeť byla rozbitá, takže jsem nemohl pořádně <w>spláchnout</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "flush the toilet",
                        "flush the loo"
                    ],
                    "target_lang_definitions": {
                        "ru": "Смывать воду в туалете, пуская сильный поток воды.",
                        "zh": "指通过大量水流冲洗厕所。",
                        "cs": "Očistit toaletu tím, že jí necháte protéct velké množství vody."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "смывать",
                                "target_lang_sense_clarification": "воду в туалете"
                            },
                            {
                                "target_lang_word": "смыть",
                                "target_lang_sense_clarification": "воду в туалете (совершенный вид)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "冲水",
                                "target_lang_sense_clarification": "指冲洗厕所"
                            },
                            {
                                "target_lang_word": "冲厕所",
                                "target_lang_sense_clarification": "指冲洗厕所的动作"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "spláchnout",
                                "target_lang_sense_clarification": "použít vodu k vyčištění toalety"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c9c527dd-ccef-304b-998c-6615643ed582",
                    "sense_definition": "To become red in the face, especially as a result of strong emotion, heat, or alcohol.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "redness_emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She felt her cheeks <w>flush</w> with embarrassment when everyone looked at her.",
                            "target_lang_translations": {
                                "ru": "Она почувствовала, как её щёки <w>вспыхнули</w> от смущения, когда все посмотрели на неё.",
                                "zh": "当大家都看向她时，她感到双颊因尴尬而<w>涨红</w>了。",
                                "cs": "Cítila, jak jí tváře <w>zrudly</w> studem, když se na ni všichni podívali."
                            }
                        },
                        {
                            "text": "His face started to <w>flush</w> with anger as he read the letter.",
                            "target_lang_translations": {
                                "ru": "Его лицо начало <w>краснеть</w> от гнева, пока он читал письмо.",
                                "zh": "读信时，他的脸因愤怒而开始<w>涨红</w>。",
                                "cs": "Když četl ten dopis, obličej mu začal <w>rudnout</w> hněvem."
                            }
                        }
                    ],
                    "synonyms": [
                        "blush"
                    ],
                    "common_phrases": [
                        "flush with anger",
                        "flush with embarrassment"
                    ],
                    "target_lang_definitions": {
                        "ru": "Краснеть лицом, особенно от сильных эмоций, жары или алкоголя.",
                        "zh": "指因强烈情绪、高温或饮酒而脸红。",
                        "cs": "Zčervenat v obličeji, zejména v důsledku silných emocí, horka nebo alkoholu."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "краснеть",
                                "target_lang_sense_clarification": "становиться красным"
                            },
                            {
                                "target_lang_word": "вспыхнуть",
                                "target_lang_sense_clarification": "внезапно покраснеть"
                            },
                            {
                                "target_lang_word": "залиться краской",
                                "target_lang_sense_clarification": "сильно покраснеть от смущения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "脸红",
                                "target_lang_sense_clarification": "因情绪或生理原因变红"
                            },
                            {
                                "target_lang_word": "涨红",
                                "target_lang_sense_clarification": "因激动或愤怒而脸部充血"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "zčervenat",
                                "target_lang_sense_clarification": "v obličeji"
                            },
                            {
                                "target_lang_word": "zrudnout",
                                "target_lang_sense_clarification": "v obličeji (např. studem nebo hněvem)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e5464dfe-6674-3b17-be55-1aae31bfe933",
                    "sense_definition": "To clean or wash something by letting water or another fluid flow over or through it.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "cleaning_water",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should <w>flush</w> the wound with clean water to prevent infection.",
                            "target_lang_translations": {
                                "ru": "Тебе следует <w>промыть</w> рану чистой водой, чтобы предотвратить инфекцию.",
                                "zh": "你应该用清水<w>冲洗</w>伤口以防感染。",
                                "cs": "Ránu byste měli <w>propláchnout</w> čistou vodou, abyste předešli infekci."
                            }
                        },
                        {
                            "text": "The mechanic needs to <w>flush</w> the radiator to remove the rust and debris.",
                            "target_lang_translations": {
                                "ru": "Механику нужно <w>промыть</w> радиатор, чтобы удалить ржавчину и мусор.",
                                "zh": "技工需要<w>冲洗</w>散热器以清除铁锈和杂物。",
                                "cs": "Mechanik musí <w>propláchnout</w> chladič, aby odstranil rez a nečistoty."
                            }
                        }
                    ],
                    "common_phrases": [
                        "flush the system",
                        "flush with water"
                    ],
                    "target_lang_definitions": {
                        "ru": "Очищать или мыть что-либо, пропуская через это поток воды или другой жидкости.",
                        "zh": "指通过水流或其他液体冲洗以达到清洁目的。",
                        "cs": "Vyčistit nebo omýt něco tím, že přes to nebo skrz to necháte téct vodu či jinou tekutinu."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "промывать",
                                "target_lang_sense_clarification": "очищать жидкостью"
                            },
                            {
                                "target_lang_word": "промыть",
                                "target_lang_sense_clarification": "очистить жидкостью (совершенный вид)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "冲洗",
                                "target_lang_sense_clarification": "用水流清洁"
                            },
                            {
                                "target_lang_word": "清洗",
                                "target_lang_sense_clarification": "通过液体流动进行清洁"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "propláchnout",
                                "target_lang_sense_clarification": "vyčistit proudem tekutiny"
                            },
                            {
                                "target_lang_word": "vypláchnout",
                                "target_lang_sense_clarification": "vyčistit vnitřek tekutinou"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8dc6c70f-ec64-3e8f-bde2-a5335aa568f8",
                    "sense_definition": "To force a person or animal to leave a place where they are hiding.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "drive_out",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hunters used trained dogs to <w>flush</w> the birds from the tall grass.",
                            "target_lang_translations": {
                                "ru": "Охотники использовали обученных собак, чтобы <w>выгнать</w> птиц из высокой травы.",
                                "zh": "猎人们利用训练有素的狗将鸟儿从高草丛中<w>惊起</w>。",
                                "cs": "Lovci použili vycvičené psy, aby <w>vyhnali</w> ptáky z vysoké trávy."
                            }
                        },
                        {
                            "text": "Police used tear gas to <w>flush</w> the suspect out of the building.",
                            "target_lang_translations": {
                                "ru": "Полиция применила слезоточивый газ, чтобы <w>выкурить</w> подозреваемого из здания.",
                                "zh": "警方使用催泪瓦斯将嫌疑人从大楼里<w>赶出</w>。",
                                "cs": "Policie použila slzný plyn, aby <w>vypudila</w> podezřelého z budovy."
                            }
                        }
                    ],
                    "synonyms": [
                        "flush out",
                        "drive",
                        "scare up"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заставлять человека или животное покинуть место, где они прячутся.",
                        "zh": "指强迫人或动物离开藏身之处。",
                        "cs": "Přinutit osobu nebo zvíře opustit místo, kde se skrývají."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выгонять",
                                "target_lang_sense_clarification": "из укрытия"
                            },
                            {
                                "target_lang_word": "спугивать",
                                "target_lang_sense_clarification": "дичь, птиц"
                            },
                            {
                                "target_lang_word": "выкуривать",
                                "target_lang_sense_clarification": "заставлять выйти (разг.)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "赶出",
                                "target_lang_sense_clarification": "迫使离开藏身处"
                            },
                            {
                                "target_lang_word": "惊起",
                                "target_lang_sense_clarification": "指使鸟兽从隐蔽处飞出或跑出"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "vyhnat",
                                "target_lang_sense_clarification": "z úkrytu"
                            },
                            {
                                "target_lang_word": "vypudit",
                                "target_lang_sense_clarification": "přinutit k opuštění úkrytu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "572ebbc1-ee10-3513-a30e-6dcc30fd2221",
                    "sense_definition": "To clear data from a computer's memory buffer or cache.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The system automatically <w>flushes</w> the cache every few minutes to free up memory.",
                            "target_lang_translations": {
                                "ru": "Система автоматически <w>очищает</w> кэш каждые несколько минут для освобождения памяти.",
                                "zh": "系统每隔几分钟会自动<w>清空</w>缓存以释放内存。",
                                "cs": "Systém každých pár minut automaticky <w>vyprázdní</w> mezipaměť, aby uvolnil paměť."
                            }
                        },
                        {
                            "text": "You must <w>flush</w> the buffer to ensure all data is written to the disk.",
                            "target_lang_translations": {
                                "ru": "Вы должны <w>сбросить</w> буфер, чтобы убедиться, что все данные записаны на диск.",
                                "zh": "你必须<w>清空</w>缓冲区，以确保所有数据都已写入磁盘。",
                                "cs": "Musíte <w>vyprázdnit</w> vyrovnávací paměť, abyste zajistili, že všechna data budou zapsána na disk."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Очищать буфер памяти или кэш компьютера.",
                        "zh": "指清除计算机内存缓冲区或缓存中的数据。",
                        "cs": "Vymazat data z paměťové vyrovnávací paměti nebo mezipaměti počítače."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "очищать",
                                "target_lang_sense_clarification": "память, кэш"
                            },
                            {
                                "target_lang_word": "сбрасывать",
                                "target_lang_sense_clarification": "буфер данных"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "清空",
                                "target_lang_sense_clarification": "清除缓存或缓冲区"
                            },
                            {
                                "target_lang_word": "刷新",
                                "target_lang_sense_clarification": "指清除并更新数据"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "vyprázdnit",
                                "target_lang_sense_clarification": "vyrovnávací paměť nebo cache"
                            },
                            {
                                "target_lang_word": "vymazat",
                                "target_lang_sense_clarification": "data z paměti"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "359346b8-c66d-3b2e-83b3-3bbe7fdc3118",
                    "sense_definition": "The act of cleaning a toilet with a sudden flow of water, or the mechanism used to do this.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "cleaning_water",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>flush</w> on this toilet is broken and needs to be repaired.",
                            "target_lang_translations": {
                                "ru": "<w>Смыв</w> в этом туалете сломан, и его нужно починить.",
                                "zh": "这个马桶的<w>冲水装置</w>坏了，需要修理。",
                                "cs": "<w>Splachovač</w> na této toaletě je rozbitý a potřebuje opravit."
                            }
                        },
                        {
                            "text": "With a loud <w>flush</w>, the water swirled away down the drain.",
                            "target_lang_translations": {
                                "ru": "С громким <w>сливом</w> вода устремилась в канализацию.",
                                "zh": "伴随着一声响亮的<w>冲水</w>声，水旋转着流进了下水道。",
                                "cs": "S hlasitým <w>spláchnutím</w> voda odtekla do odpadu."
                            }
                        }
                    ],
                    "common_phrases": [
                        "toilet flush",
                        "give it a flush"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие смыва воды в туалете или механизм, используемый для этого.",
                        "zh": "指冲洗厕所的动作或相关装置。",
                        "cs": "Akt spláchnutí toalety proudem vody nebo mechanismus, který to umožňuje."
                    },
                    "translations": {
