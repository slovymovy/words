                "senses": [
                    {
                        "sense_id": "a0384787-97b6-3434-9b4f-3899033f5d00",
                        "entry_id": "2d8ca0d4-82e2-39ce-9d89-5dee5bc4c795",
                        "glosses": [
                            "dun plakje geroosterd of gegrild brood, het liefst ingewreven met een teentje knoflook"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a4ca3406-a9fb-4299-94c0-68c637c7e646",
                                "sense_id": "a0384787-97b6-3434-9b4f-3899033f5d00",
                                "text": "Een wat modernere variant van het klassieke Melbatoastje is de Italiaanse bruschetta: dunne plakjes geroosterd of gegrild brood, het liefst ingewreven met een teentje knoflook."
                            },
                            {
                                "example_id": "04d743a4-c750-4749-9b09-b8aec1f19729",
                                "sense_id": "a0384787-97b6-3434-9b4f-3899033f5d00",
                                "text": "Vandaag beginnen we met een hapje vooraf, een antipasti zo u wilt, van pesto van zongedroogde tomaten die u overal op kunt smeren of bij kunt gebruiken, bijvoorbeeld met bruschetta, in een verse tomatensaus en in sladressings."
                            },
                            {
                                "example_id": "a866745b-6bdb-44e4-8248-62cdea630f3b",
                                "sense_id": "a0384787-97b6-3434-9b4f-3899033f5d00",
                                "text": "Heerlijk met een paar sneeën geroosterd volkoren speltbrood. Met een verse groene salade erbij heb je een complete maaltijd. Voor de extra smaak kun je je broodjes besmeren met bruschetta of pesto."
                            },
                            {
                                "example_id": "4590db6f-a49e-412b-bc43-bf761ea57aa1",
                                "sense_id": "a0384787-97b6-3434-9b4f-3899033f5d00",
                                "text": "In de keuken wordt ondertussen hard gewerkt om de bezoekers te voorzien van bruschetta’s en bescheiden kommetjes risotto met worst."
                            }
                        ]
                    }
                ],
