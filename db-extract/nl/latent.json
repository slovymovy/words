                                "target_senses": [
                                    {
                                        "sense_id": "b6d3d9a8-a2af-398c-ba71-d7902903e5e2",
                                        "entry_id": "0bd21088-03e0-333a-befd-2d91485fd803",
                                        "glosses": [
                                            "vorhanden, aber noch nicht erkennbar, versteckt, verborgen, nicht offenkundig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2205faf5-0122-48ce-9b5c-aa3019a3a478",
                                                "sense_id": "b6d3d9a8-a2af-398c-ba71-d7902903e5e2",
                                                "text": "Diese Gefahr ist noch latent."
                                            }
                                        ],
