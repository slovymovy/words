                "senses": [
                    {
                        "sense_id": "6b12a0a6-cc15-309b-9fd8-a763fe681477",
                        "entry_id": "ecbf3930-7d23-39ce-a779-82bc80abdfc3",
                        "glosses": [
                            "Glas-Röhrchen, das bestimmte Reagenzien enthält und das der Analyse von hindurch gepumpten Gasgemischen dient"
                        ],
                        "tags": [
                            "Messtechnik"
                        ],
                        "examples": [
                            {
                                "example_id": "a0e02295-e308-4c0f-868f-5651c6784f35",
                                "sense_id": "6b12a0a6-cc15-309b-9fd8-a763fe681477",
                                "text": "Mit einem Prüfröhrchen und passender Gasspürpumpe, lässt sich der qualitative und quantitative Nachweis von bekannten Stoffen 100%ig erbringen und identifizieren (z.B. Chlorgasausbruch Schwimmhalle)."
                            },
                            {
                                "example_id": "cea276e3-d356-4d33-9c1c-8bcca12bdc1e",
                                "sense_id": "6b12a0a6-cc15-309b-9fd8-a763fe681477",
                                "text": "„Prüfröhrchen sind geeichte, beidseitig zugeschmolzene Glasröhrchen, deren jeweiliges Füllmaterial spezifisch mit einem bestimmten gasförmigen Stoff reagiert.“"
                            },
                            {
                                "example_id": "8ad0b35c-4cef-4166-8940-d87daf71258c",
                                "sense_id": "6b12a0a6-cc15-309b-9fd8-a763fe681477",
                                "text": "„Prüfröhrchen sind sehr nützlich für Übersichtsmessungen des Schichtmittelwertes und weniger für Grenzwert-Vergleichsmessungen oder periodische Messungen.“"
                            },
                            {
                                "example_id": "668b2b3c-6be4-4897-8751-885bb8cd406c",
                                "sense_id": "6b12a0a6-cc15-309b-9fd8-a763fe681477",
                                "text": "„Das Dräger-Röhrchen-Mess-System besteht aus Prüfröhrchen und einer Gasspürpumpe. Das Aufspüren von gefährlichen Stoffen ist die häufigste Variante eines Einsatzes von Prüfröhrchen.“"
                            },
                            {
                                "example_id": "aba4d350-54d4-4a01-84f9-f2944afd70b9",
                                "sense_id": "6b12a0a6-cc15-309b-9fd8-a763fe681477",
                                "text": "„Als geeignete Hilfsmittel haben sich zur Messung der Ozonkonzentration in der Raumluft Prüfröhrchen und zum Feststellen von Undichtigkeiten Kalium-Iodid-Stärkepapier bewährt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
