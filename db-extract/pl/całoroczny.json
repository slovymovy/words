                        "glosses": [
                            "trwający cały rok; czynny cały rok; obejmujący cały rok"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1185d83a-2ab1-43c3-a5e4-2a5e222c0ebf",
                                "sense_id": "6785e422-5c1d-34ba-9c04-c8cdda112fd7",
                                "text": "Czterdziestotrzyletni pacjent trafił do poradni alergologicznej z powodu całorocznego kataru i zapalenia spojówek"
                            }
