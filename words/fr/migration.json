            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3be1ce43-d75c-3bd5-b671-bb13cc8db25d",
                    "sense_definition": "Déplacement périodique et saisonnier de certaines espèces animales vers un autre lieu.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "deplacement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "À l'automne, la <w>migration</w> des oiseaux vers des régions plus chaudes commence."
                        },
                        {
                            "text": "Les scientifiques étudient la <w>migration</w> annuelle des baleines à travers l'océan."
                        }
                    ],
                    "common_phrases": [
                        "migration des oiseaux",
                        "période de migration"
                    ]
                },
                {
                    "sense_id": "16556f8e-f88e-33db-8df7-956bdca3b2bb",
                    "sense_definition": "Déplacement de personnes ou de populations d'un pays ou d'une région à un autre pour s'y établir.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "deplacement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les facteurs économiques et climatiques expliquent souvent cette vaste <w>migration</w> de populations."
                        },
                        {
                            "text": "Une grande vague de <w>migration</w> a transformé la démographie de cette région industrielle."
                        }
                    ],
                    "synonyms": [
                        "exode",
                        "émigration",
                        "immigration"
                    ],
                    "common_phrases": [
                        "flux de migration",
                        "migration clandestine",
                        "vague de migration"
                    ]
                },
                {
                    "sense_id": "e69ef546-1d43-3406-b9e7-675a13533682",
                    "sense_definition": "Passage de données, d'un logiciel ou d'un système informatique vers un nouvel environnement technique.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "technique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'entreprise a réussi la <w>migration</w> de toutes ses données vers le nouveau serveur sans interruption."
                        },
                        {
                            "text": "Cette <w>migration</w> logicielle nécessite plusieurs jours de tests avant son déploiement complet."
