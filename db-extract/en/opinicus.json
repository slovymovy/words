                "senses": [
                    {
                        "sense_id": "b418687e-8392-397f-8bbf-c364c2d485b3",
                        "entry_id": "5d415eb0-41a5-3db3-8965-ca3ff3cf7b0b",
                        "glosses": [
                            "A heraldic imaginary creature with an eagle's head, a short tail, and sometimes wings."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd17361e-ba02-4977-b8f9-ca1ce393fa67",
                                "sense_id": "b418687e-8392-397f-8bbf-c364c2d485b3",
                                "text": "Two opinici vert, beaked sable, wings gules, support the insignia of the Plasterers’ Company."
                            },
                            {
                                "example_id": "1042101e-08b6-4265-b29d-f3c0bc90b007",
                                "sense_id": "b418687e-8392-397f-8bbf-c364c2d485b3",
                                "text": "Urcheons, bagwyns, opinici and musimons, represented statant, sejant or segreant, and in every variety of metal, colour and fur, completed an exhibition which was both boastfully heraldic and pompously powerful."
                            },
                            {
                                "example_id": "da76c24e-d283-40b7-acab-4bf773d87c76",
                                "sense_id": "b418687e-8392-397f-8bbf-c364c2d485b3",
                                "text": "No blood need be shed in settling these anatomical problems, as opinici are of little importance, there being barely a dozen examples."
                            },
                            {
                                "example_id": "dfa5f856-2b34-46d9-ac78-bfc0c8f6772b",
                                "sense_id": "b418687e-8392-397f-8bbf-c364c2d485b3",
                                "text": "Even when they ascend to the loftiest perch for their kind and earn the right to serve on the Council of Keythongs, the wingless ones are still not permitted the same rights as gryphons and opinici."
                            }
                        ]
                    }
                ],
