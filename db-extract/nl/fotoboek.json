                "senses": [
                    {
                        "sense_id": "f67fb85c-2dd2-364a-9b17-8c6419b52554",
                        "entry_id": "cfee4366-b0a8-3b48-9efc-b45a40f7757f",
                        "glosses": [
                            "een boek waarin vooral foto's staan afgedrukt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1df16b84-fd5d-4ab5-b1b1-11e127fc525b",
                                "sense_id": "f67fb85c-2dd2-364a-9b17-8c6419b52554",
                                "text": "Voor haar fotoboek Border, a journey along the edges of Russia, reisde ze 60.000 kilometer langs de Russische grensgebieden (inclusief de wateren) en fotografeerde desolate plekken waar de restanten van het Sovjet-tijdperk - muurschilderingen, half vergane hamer-en-sikkelsymbolen - nog terug te vinden zijn. In hoeverre verwijzen die culturele en politieke overblijfselen nog naar de mensen die er nu wonen en werken? Dat is de voornaamste vraag die Gruzdeva in Border aankaart en uitwerkt in haar foto’s en dagboekaantekeningen. Het resultaat is een nuchtere én melancholische zoektocht."
                            }
                        ]
                    },
                    {
                        "sense_id": "e960506b-459f-3889-bcea-0653abde5297",
                        "entry_id": "cfee4366-b0a8-3b48-9efc-b45a40f7757f",
                        "glosses": [
                            "een boek met lege bladzijden waarin met foto's kan plakken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54de676e-054e-4013-acf8-6a3862a70d9f",
                                "sense_id": "e960506b-459f-3889-bcea-0653abde5297",
                                "text": "Wij hadden een groot fotoboek gekregen op onze trouwdag met foto's van onze families."
                            }
                        ]
                    }
