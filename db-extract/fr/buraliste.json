        "fr-extract.jsonl": [
            {
                "entry_id": "13d3c86e-de7c-3d9a-a35d-c32bcb2b50b3",
                "word": "buraliste",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "a59d610a-8e24-4a0b-82af-b3d8812ba0f0",
                        "entry_id": "13d3c86e-de7c-3d9a-a35d-c32bcb2b50b3",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "buralistes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "aebd7271-5cda-33f3-8f04-3070b79d0fbb",
                        "entry_id": "13d3c86e-de7c-3d9a-a35d-c32bcb2b50b3",
                        "glosses": [
                            "Personne préposée à un bureau de paiement, de distribution, de recette, etc."
                        ],
                        "tags": [
                            "France"
                        ],
                        "note": "Il se dit aussi en apposition",
                        "examples": [
                            {
                                "example_id": "2c17cc85-e041-49a1-8d81-248f7a12cc10",
                                "sense_id": "aebd7271-5cda-33f3-8f04-3070b79d0fbb",
                                "text": "[…]; j’ai lieu de penser qu’un paquet a été perdu. Dans notre petite ville du Berry, nous avons un buraliste fort négligent, et toutes nos lettres ne nous arrivent pas toujours."
                            },
                            {
                                "example_id": "aae23def-ae79-4644-8127-9ff176223a04",
                                "sense_id": "aebd7271-5cda-33f3-8f04-3070b79d0fbb",
                                "text": "une de ces buralistes qui, à la veillée, manient leur machine à coudre comme leur télégraphe, sans chercher à savoir si elles piquent des chemises ou des mouchoirs."
                            },
                            {
                                "example_id": "da6713f9-70d4-4ec0-a573-3b70a214ce49",
                                "sense_id": "aebd7271-5cda-33f3-8f04-3070b79d0fbb",
                                "text": "Le buraliste, plutôt lève-tard et de mauvaise humeur, montait à peine son rideau de fer récalcitrant en poussant quelques jurons."
                            }
                        ]
                    },
                    {
                        "sense_id": "d72e71e9-f980-3dc9-9e34-100d51d65175",
                        "entry_id": "13d3c86e-de7c-3d9a-a35d-c32bcb2b50b3",
                        "glosses": [
                            "Particulièrement personne qui tient un bureau de tabac (seul autorisé, en France et dans ses ex-colonies, à vendre du tabac et produits dérivés)."
                        ],
                        "tags": [
                            "France"
                        ],
                        "examples": [
                            {
                                "example_id": "c207ca85-69ff-4460-bb1e-9a871308a7b6",
                                "sense_id": "d72e71e9-f980-3dc9-9e34-100d51d65175",
                                "text": "Or, ce matin, Françoise Cozzano, la buraliste, l’a apostrophé : « Où vas-tu comme ça, Pierrot ? »"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8818a556-ad1c-49b7-8ee4-e0dafbd1918c",
