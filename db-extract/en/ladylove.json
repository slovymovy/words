                                    {
                                        "sense_id": "82cb7496-2ce6-3b29-8db8-19e477539286",
                                        "entry_id": "23286753-2afb-377a-a6c0-54522f267444",
                                        "glosses": [
                                            "Liebste, Geliebte"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ceb0eb6e-69e6-4d89-9f84-b3e09c399cee",
                                                "sense_id": "82cb7496-2ce6-3b29-8db8-19e477539286",
                                                "text": "Horch, was kommt von draußen rein? … Wird wohl mein Feinsliebchen sein … (Volkslied)"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bb3842f9-dd55-435d-87a0-e5c09c1d3977",
                        "source_entry_id": "04f2e2c5-2cf4-318e-b346-246c55778c71",
                        "source_sense_id": "c0692225-7629-330c-9899-9a797ddbd514",
                        "source_sense_description": "woman who is loved by someone",
                        "target_lang_word": "Geliebte",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Geliebte",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d240644a-fc2f-36b8-8ba7-f79cb84da7ad",
                                        "entry_id": "50e71f8b-d9fc-3ff4-aaae-1f8e66b15a1b",
                                        "glosses": [
                                            "weiblicher Partner, für den Liebe empfunden wird oder mit dem eine sexuelle Beziehung aufrechterhalten wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f638d43-e50b-40a4-8261-8479eae1d344",
                                                "sense_id": "d240644a-fc2f-36b8-8ba7-f79cb84da7ad",
                                                "text": "Nachts traf er sich immer mit seiner Geliebten."
                                            },
                                            {
                                                "example_id": "47f39eec-7d68-4311-8065-446843ad3e3b",
                                                "sense_id": "d240644a-fc2f-36b8-8ba7-f79cb84da7ad",
                                                "text": "Er hatte die ganze Zeit eine Geliebte gehabt."
                                            },
                                            {
                                                "example_id": "fa0ec12b-1dcc-4420-ad59-a16c27248a48",
                                                "sense_id": "d240644a-fc2f-36b8-8ba7-f79cb84da7ad",
                                                "text": "„Sadie ist vor Trauer außer sich und macht einen Skandal, als sie die offizielle Ehefrau und eine weitere Geliebte, von der Clarence zwei Kinder hat, auftauchen sieht, ganz abgesehen von mehreren Mätressen, die alle behaupten, die einzigen zu sein, die ihn je geliebt haben.“"
                                            },
                                            {
                                                "example_id": "b6914c84-dace-4618-b072-1878da2a339f",
                                                "sense_id": "d240644a-fc2f-36b8-8ba7-f79cb84da7ad",
                                                "text": "„Man munkelte, er habe eine junge Geliebte.“"
                                            },
                                            {
                                                "example_id": "5917f683-0c89-4ac5-8b15-67dd745a94bc",
                                                "sense_id": "d240644a-fc2f-36b8-8ba7-f79cb84da7ad",
                                                "text": "„Er hat keine Geliebte unterhalten.“"
                                            },
                                            {
                                                "example_id": "c39d010f-2776-46a2-8a50-c89f107cc4a8",
                                                "sense_id": "d240644a-fc2f-36b8-8ba7-f79cb84da7ad",
                                                "text": "„Dreimal waren sie zusammen in Feldafing, mein Vater hatte seine Geliebte einfach als Putzhilfe ausgegeben und als unabkömmlich für seinen Haushalt eingestuft.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
