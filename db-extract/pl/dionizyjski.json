                ],
                "senses": [
                    {
                        "sense_id": "bc5e6ccc-6f9b-383a-a0f2-d338e28a162d",
                        "entry_id": "6ef26404-6e08-3c41-bd63-30d0b189343e",
                        "glosses": [
                            "związany z kultem Dionizosa"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e40fc8ba-97a1-4dfa-8c24-d5eac69f67c8",
                                "sense_id": "bc5e6ccc-6f9b-383a-a0f2-d338e28a162d",
                                "text": "Orfeusz nie uznawał misteriów dionizyjskich, natomiast wielką czcią otaczał Apollina."
                            },
                            {
                                "example_id": "a2a178ef-6b8a-4ac5-a3bb-6e91a1ec3686",
                                "sense_id": "bc5e6ccc-6f9b-383a-a0f2-d338e28a162d",
                                "text": "Zachował przy tym kult dionizyjskiego sensualizmu i pełni życia, zderzając go następnie z buddyjską ascezą i radykalnym nihilizmem samotnika żyjącego poza społeczeństwem."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "bf872f31-b7c0-3efb-b06b-68edd1e79be8",
                        "entry_id": "6ef26404-6e08-3c41-bd63-30d0b189343e",
                        "glosses": [
                            "w filozofii nietzscheańskiej związany z nurtem tragicznym i symbolicznym w sztuce greckiej"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4849d2a3-57c3-4010-8450-2c0e453a9ea4",
                                "sense_id": "bf872f31-b7c0-3efb-b06b-68edd1e79be8",
                                "text": "Unika przepychu, subiektywności, mistycyzmu. Jakby zarzucając nurt dionizyjski na rzecz nurtu apollińskiego."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "f808cb01-ed9e-36de-a661-c6de6cc84adb",
                        "entry_id": "6ef26404-6e08-3c41-bd63-30d0b189343e",
                        "glosses": [
                            "żywiołowy, dynamiczny, beztroski"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.3\""
                    },
                    {
                        "sense_id": "4bd71feb-c3c0-39ad-9231-1f93249eba01",
                        "entry_id": "6ef26404-6e08-3c41-bd63-30d0b189343e",
                        "glosses": [
                            "związany z wczesnochrześcijańskim mnichem i pisarzem Dionizym Małym"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4227a15c-3e80-4829-bc09-a98e4f11c6a5",
                                "sense_id": "4bd71feb-c3c0-39ad-9231-1f93249eba01",
                                "text": "Od roku następującego po tej dacie (rok 1 n.e.) zaczął liczyć erę chrześcijańską, od jego imienia zwaną także erą dionizyjską."
                            }
                        ],
                        "sense_index_json": "\"1.4\""
                    }
                ],
