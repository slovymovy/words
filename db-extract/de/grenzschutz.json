                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "229393eb-b476-3a84-84e2-988e2159cbdd",
                        "entry_id": "39c012f3-efd4-35c4-8c8a-b2fd26766246",
                        "glosses": [
                            "für den Schutz staatlicher Landesgrenzen zuständige Kräfte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b93980c5-4fa4-4b11-b918-def559ca8f8c",
                                "sense_id": "229393eb-b476-3a84-84e2-988e2159cbdd",
                                "text": "„Wie von ihm geplant, hat Rudi Böhme nach einer angemessenen Zeit angeblicher Suche den Grenzschutz und die Polizei über Wotans Tod und dessen mögliche Ursache informiert; worauf ein mittelstarkes Aufgebot an BGS-Kräften das Revier der beiden durchkämmt hat, vor allem den Nahbereich der Grenzanlagen, in dem Wotan angeblich getötet wurde.“"
                            },
                            {
                                "example_id": "d034546b-186e-4971-b73f-d4b5685ab394",
                                "sense_id": "229393eb-b476-3a84-84e2-988e2159cbdd",
                                "text": "„Aber würde uns das geglaubt, wo wir doch beim russischen Grenzschutz aktenkundig geworden waren?“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
