                                    {
                                        "sense_id": "629b5f32-87fb-3c7e-a46e-3ee1ed165d68",
                                        "entry_id": "778110dd-ca74-36be-afd3-cea48800ca00",
                                        "glosses": [
                                            "Gesamtzahl der unterschiedlichen Wörter (einer Sprache, eines Textes,…)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9fd1db34-7486-4d2c-8e93-d9d0980a3ff7",
                                                "sense_id": "629b5f32-87fb-3c7e-a46e-3ee1ed165d68",
                                                "text": "„Aber alle Kultursprachen der Welt leben von einer gewaltigen Anreicherung ihres Wortbestandes über die Jahrhunderte, ja, es ist dies vielleicht überhaupt das Definitionsmerkmal einer Kultursprache.“"
                                            },
                                            {
                                                "example_id": "44cdb4f0-602a-4f48-b5a5-e157975144c7",
                                                "sense_id": "629b5f32-87fb-3c7e-a46e-3ee1ed165d68",
                                                "text": "„Der Grundwortschatz umfaßt nur einen verhältnismäßig kleinen Teil des gesamten Wortbestandes.“"
                                            },
                                            {
                                                "example_id": "a7c8ed98-9111-4197-8440-896df00e8f69",
                                                "sense_id": "629b5f32-87fb-3c7e-a46e-3ee1ed165d68",
                                                "text": "„Der Wortbestand einer Sprache geht rein quantitativ prinzipiell gegen unendlich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
