                ],
                "senses": [
                    {
                        "sense_id": "a4b263ed-8d6e-3b7a-aa91-1d924b72482b",
                        "entry_id": "157fb8c5-ed04-3df1-bacd-9934827691e7",
                        "glosses": [
                            "упадок, культурный регресс"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d39638af-436b-4273-8835-f81c7e595d85",
                                "sense_id": "a4b263ed-8d6e-3b7a-aa91-1d924b72482b",
                                "text": "Это уже декаданс декаданса, упадок упадка и нельзя не возблагодарить за него Создателя…"
                            }
                        ]
                    },
                    {
                        "sense_id": "2e464b5e-b0c6-36c5-88bc-fbf80561c20d",
                        "entry_id": "157fb8c5-ed04-3df1-bacd-9934827691e7",
                        "glosses": [
                            "искусств. направление в искусстве конца XIX — начала XX века, характеризующееся упадочничеством, формализмом, индивидуализмом; декадентство"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "17b85dca-91bc-4e3c-90dc-ea3cb9aa79ca",
                        "source_entry_id": "157fb8c5-ed04-3df1-bacd-9934827691e7",
                        "target_lang_word": "decadence",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "decadence",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e9993180-6f53-3c51-9ba7-0842fce45971",
                                        "entry_id": "581deec9-b54b-3dc4-8e5b-7b6366a37250",
                                        "glosses": [
                                            "A state of moral or artistic decline or deterioration; decay"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "70ada182-f466-4266-877f-11f23dcebcac",
                                                "sense_id": "e9993180-6f53-3c51-9ba7-0842fce45971",
                                                "text": "\"Stability, however, is not enough. It leads too easily to stagnation, and thence to decadence.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "38d9ea6a-38fe-3cd1-8191-0f7c9f64d294",
                                        "entry_id": "581deec9-b54b-3dc4-8e5b-7b6366a37250",
                                        "glosses": [
                                            "The quality of being luxuriously self-indulgent."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad10846c-edb1-42bc-bcd8-f6fc988bf9f3",
                                                "sense_id": "38d9ea6a-38fe-3cd1-8191-0f7c9f64d294",
                                                "text": "the decadence of a five-star hotel"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ef88cbb7-e9c2-4b44-b47a-574163105cdd",
                        "source_entry_id": "157fb8c5-ed04-3df1-bacd-9934827691e7",
                        "target_lang_word": "décadence",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "décadence",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b786b163-edce-3f15-abe8-da4755f4c1c0",
                                        "entry_id": "25b01c90-694e-3913-9c7e-821aaa365346",
                                        "glosses": [
                                            "Dégradation, abaissement général des valeurs, des comportements que reconnaît une société, un peuple ou un pouvoir politique comme étant la norme à devoir respecter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cfe39896-5368-4a0f-9534-dbcdb7fa1422",
                                                "sense_id": "b786b163-edce-3f15-abe8-da4755f4c1c0",
                                                "text": "… ouvrez vos cellules de marbre et laissez partager votre repos à un frère fatigué, qui aimerait mieux avoir à combattre cent mille païens que d’être témoin de la décadence de notre ordre sacré !"
                                            },
                                            {
                                                "example_id": "2d63ffea-b789-4c1c-9ea5-3dc1cc10c6c8",
                                                "sense_id": "b786b163-edce-3f15-abe8-da4755f4c1c0",
                                                "text": "Cependant, le caractère vraiment ornemental et architectural des armoiries, qui ne tolérait pas une représentation des objets sous leur forme parfaitement naturelle, se conserva […] jusqu’au milieu du 16ᵉ [siècle]. Depuis, les bonnes traditions allèrent s’affaiblissant, jusqu’au 19ᵉ qui a été témoin de la décadence complète de cet art vénérable, dont il semble qu’on eût oublié même les principes les plus élémentaires."
                                            },
                                            {
                                                "example_id": "633126bd-102d-40ce-831f-3b62c827d1aa",
                                                "sense_id": "b786b163-edce-3f15-abe8-da4755f4c1c0",
                                                "text": "Sommes-nous donc dans une époque d’irrémédiable décadence ? Plus nous approchons de la fin de ce siècle, plus notre décomposition s’aggrave et s’accélère, et plus nos cœurs, nos cerveaux, nos virilités vont se vidant de ce qui est l’âme, les nerfs et le sang même d’un peuple."
                                            },
                                            {
                                                "example_id": "1ceffc1c-00d4-4ba1-b543-2a74803528c9",
                                                "sense_id": "b786b163-edce-3f15-abe8-da4755f4c1c0",
                                                "text": "Bismark jugea tout autrement. La République devait causer, à son avis, la décadence définitive des Gaules alors que le quasi-absolutisme germanique maintiendrait la prééminence allemande. Les événements de 1914 ont tranché le différend."
                                            },
                                            {
                                                "example_id": "6bf04018-5650-454e-9910-301b003c9830",
                                                "sense_id": "b786b163-edce-3f15-abe8-da4755f4c1c0",
                                                "text": "Le pays des terribles Cadets de Gascogne, le pays de madrés, des malins, des finauds, des habiles, […] ce pays là ne serait plus qu’un pays de hongres, voué à la décadence et à la destruction ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ec461fc4-b084-355a-84a1-351d0815723f",
                                        "entry_id": "25b01c90-694e-3913-9c7e-821aaa365346",
                                        "glosses": [
                                            "Dégradation, disparition, offense."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c0cd9cc2-0beb-4929-9306-2a505436021c",
                                                "sense_id": "ec461fc4-b084-355a-84a1-351d0815723f",
                                                "text": "L’humanité avait-elle les moyens de prévenir ce désastre de la guerre dans les airs ? Question oiseuse, aussi oiseuse que de demander si elle aurait pu empêcher la décadence qui transforma l’Assyrie et Babylone en des déserts arides."
                                            },
                                            {
                                                "example_id": "2d705b53-3ad6-4ea9-8005-4c3732bd69bd",
                                                "sense_id": "ec461fc4-b084-355a-84a1-351d0815723f",
                                                "text": "On s’accorde à signaler la décadence progressive de l’élevage du mouton en Russie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e00fdfb-ed3f-337f-8bc5-bf1d4ad17f5c",
                                        "entry_id": "25b01c90-694e-3913-9c7e-821aaa365346",
                                        "glosses": [
                                            "Derniers siècles de l’empire romain."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "03eec876-2e8c-41d3-8511-616fe838cd6d",
                                                "sense_id": "0e00fdfb-ed3f-337f-8bc5-bf1d4ad17f5c",
                                                "text": "Les Romains de la décadence."
                                            },
                                            {
                                                "example_id": "86d3f995-3a71-48a8-b503-fc27867fe5c7",
                                                "sense_id": "0e00fdfb-ed3f-337f-8bc5-bf1d4ad17f5c",
                                                "text": "Les poètes latins de la décadence."
                                            }
                                        ]
                                    }
                                ]
                            },
