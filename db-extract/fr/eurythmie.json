        "fr-extract.jsonl": [
            {
                "entry_id": "728966e9-a177-31ce-a3ff-7eb58207871d",
                "word": "eurythmie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "c17b8244-ffe4-4aa0-8589-9452ce7e7416",
                        "entry_id": "728966e9-a177-31ce-a3ff-7eb58207871d",
                        "tags": [
