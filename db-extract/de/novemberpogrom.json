                ],
                "senses": [
                    {
                        "sense_id": "6e9dd190-8605-3d66-828e-2f239e3a96ce",
                        "entry_id": "7eddbdde-7761-3477-a597-f767c63a6d70",
                        "glosses": [
                            "systematische staatliche Verfolgung/Ermordung von Juden und Zerstörung ihres Besitzes und ihrer Einrichtungen (beispielsweise Geschäfte, Synagogen, Friedhöfe) insbesondere am 9. und 10. November 1938 in Deutschland und Österreich"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e6cb09c6-6c54-48b7-b435-93fe5050e4fa",
                                "sense_id": "6e9dd190-8605-3d66-828e-2f239e3a96ce",
                                "text": "„Insgesamt sterben infolge des Novemberpogroms 1938 in Deutschland mehr als 1.300 Menschen, rund 30.000 Jüdinnen und Juden werden verhaftet oder in Konzentrationslager verschleppt.“"
                            },
                            {
                                "example_id": "a51f384f-08f3-459a-bdf8-c921626f0438",
                                "sense_id": "6e9dd190-8605-3d66-828e-2f239e3a96ce",
                                "text": "„Während der Novemberpogrome 1938 wurden die meisten Synagogen zerstört.“"
                            },
                            {
                                "example_id": "345a34cc-aa6c-493e-bdcf-ce375470da05",
                                "sense_id": "6e9dd190-8605-3d66-828e-2f239e3a96ce",
                                "text": "„Alleine in Wien wurden im Zuge der Novemberpogrome 1938 42 Synagogen und Gebetshäuser von den Nationalsozialisten zerstört.“"
                            },
                            {
                                "example_id": "9fa1b8cd-fd65-4206-bda9-6e12abd421b9",
                                "sense_id": "6e9dd190-8605-3d66-828e-2f239e3a96ce",
                                "text": "„Bei den Novemberpogromen wurde am Morgen des 10. November 1938 die 1917 erbaute Synagoge in Brand gesteckt.“"
                            },
                            {
                                "example_id": "e806f0b7-04e0-4818-81e5-74ae3cc32d4b",
                                "sense_id": "6e9dd190-8605-3d66-828e-2f239e3a96ce",
                                "text": "[Jüdischer Friedhof Steinbach (Fernwald):] „Beim Novemberpogrom 1938 wurde der Friedhof durch SA-Männer zerstört.“"
                            },
                            {
                                "example_id": "19e62f6c-f135-45c8-a74d-6c3b213428e4",
                                "sense_id": "6e9dd190-8605-3d66-828e-2f239e3a96ce",
                                "text": "„Der Novemberpogrom rund um die Nacht vom 9. auf den 10. November bildet den Höhepunkt antijüdischer Gewaltaktionen im Jahr 1938.“"
                            },
                            {
                                "example_id": "a278d038-5fbb-4fa3-8b36-60205db5b882",
                                "sense_id": "6e9dd190-8605-3d66-828e-2f239e3a96ce",
                                "text": "„Mit dem Novemberpogrom […] geht das NS-Regime von der Diskriminierung der jüdischen Bevölkerung zur systematischen Verfolgung über.“"
                            },
                            {
                                "example_id": "6e94c3fd-2485-4f95-b364-0ec8067e851c",
                                "sense_id": "6e9dd190-8605-3d66-828e-2f239e3a96ce",
                                "text": "„Abseits von Finanzfragen sehen Geschichtsforscher in den Novemberpogromen den Übergang der NS-Machthaber zur offenen Gewalt.“"
                            },
                            {
                                "example_id": "e251ca0c-3112-4bc8-8b23-d550175ad8e9",
                                "sense_id": "6e9dd190-8605-3d66-828e-2f239e3a96ce",
                                "text": "„Vor allem in Folge der Novemberpogrome um den 9. November 1938 wird eine Reihe von Verordnungen erlassen, um den jüdischen Bürgern jegliche Existenzgrundlage zu nehmen.“"
                            },
                            {
                                "example_id": "a953aabc-6f4f-4d68-b018-b5b3e2285742",
                                "sense_id": "6e9dd190-8605-3d66-828e-2f239e3a96ce",
                                "text": "„Im Deutschen Reich war bereits seit den Novemberpogromen im Jahr 1938 jüdisches Vermögen staatlicherseits und auch privat geplündert worden.“"
                            },
                            {
                                "example_id": "74405d77-dce0-4c14-813a-c7a640f84f9a",
                                "sense_id": "6e9dd190-8605-3d66-828e-2f239e3a96ce",
                                "text": "„Mit den Novemberpogromen 1938 war dann das vorläufige Ende des organisierten jüdischen Sports besiegelt.“"
                            },
                            {
                                "example_id": "6afcdfb7-b123-4cbf-a43f-9c3b08ba0cdd",
                                "sense_id": "6e9dd190-8605-3d66-828e-2f239e3a96ce",
                                "text": "„Seit der Machtergreifung bis zu den Novemberpogromen waren 20.000 bis über 35.000 Jüdinnen und Juden jährlich aus dem Deutschen Reich geflohen.“"
                            },
                            {
                                "example_id": "61a54427-0171-4dbd-999a-99c1d984905c",
                                "sense_id": "6e9dd190-8605-3d66-828e-2f239e3a96ce",
                                "text": "„Er beginnt sein Tagebuch am 4. November 1938. Ursprünglich hat er vor, in dem Buch seine geplante Auswanderung zu dokumentieren, doch rasch werden seine Aufzeichnungen zu einem Zeugnis der Novemberpogrome.“"
                            },
                            {
                                "example_id": "a14536e3-178a-45f6-9ec8-fe2dd86b91f4",
                                "sense_id": "6e9dd190-8605-3d66-828e-2f239e3a96ce",
                                "text": "„Selbst Präsident Roosevelt weigerte sich nach den Novemberpogromen von 1938, jüdische Deutsche Ausnahmeregelungen zu befürworten, die eine höhere Einwanderungszahl als die gesetzlich festgelegte zugelassen hätten.“"
                            },
                            {
                                "example_id": "64e1d643-58ba-40ec-b7b1-3c4aad754ff7",
                                "sense_id": "6e9dd190-8605-3d66-828e-2f239e3a96ce",
                                "text": "[…] „Er wollte nach Kriegsende in sein altes, bayrisches Heimatdorf Gaukönigshofen zurück. Dort wollte er sicherstellen, dass all jenen der Prozess gemacht wird, die an den Novemberpogromen von 1938 beteiligt gewesen waren.“"
                            },
                            {
                                "example_id": "1e6d0535-d1ee-4b18-8646-13a409904ac9",
                                "sense_id": "6e9dd190-8605-3d66-828e-2f239e3a96ce",
                                "text": "„Die Rede des Bundestagspräsidenten Philipp Jenninger zum 50. Jahrestag der Novemberpogrome löste einen Skandal aus.“"
                            },
                            {
                                "example_id": "4cf62787-bf42-40ac-971d-c5334aeb68f6",
                                "sense_id": "6e9dd190-8605-3d66-828e-2f239e3a96ce",
                                "text": "„1994 wurde in Lübeck erstmals seit dem nationalsozialistischen Novemberpogrom von 1938 wieder eine Synagoge in Brand gesetzt.“"
                            },
                            {
                                "example_id": "ff6d9913-f7a0-4c41-81df-bbee60af5ff7",
                                "sense_id": "6e9dd190-8605-3d66-828e-2f239e3a96ce",
                                "text": "[Schlagzeile:] „Ende der parlamentarischen Zurückhaltung: NPD weist Juden Schuld an Novemberpogromen zu“"
                            },
                            {
                                "example_id": "69751b98-960f-45dc-8d00-78a331f728db",
                                "sense_id": "6e9dd190-8605-3d66-828e-2f239e3a96ce",
                                "text": "„Ein ökumenisches Gedenken an die Opfer der Novemberpogrome ist am Donnerstag in der Stadt Salzburg nach dem Auftakt um 18.00 Uhr am Alten Markt ab 19.00 Uhr in der Kollegienkirche geplant.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
