    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1370797c-87d9-3763-ab0a-8b15474983cf",
                    "sense_definition": "Rendre plus faible en diminuant la force, la vigueur ou l'intensité.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "diminution de force",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette longue maladie a beaucoup <w>affaibli</w> le vieil homme au cours des derniers mois.",
                            "target_lang_translations": {
                                "en": "This long illness has greatly <w>weakened</w> the old man over the past few months.",
                                "ru": "Эта долгая болезнь сильно <w>ослабила</w> старика за последние месяцы.",
                                "de": "Diese lange Krankheit hat den alten Mann in den letzten Monaten stark <w>geschwächt</w>.",
                                "es": "Esta larga enfermedad ha <w>debilitado</w> mucho al anciano en los últimos meses.",
                                "zh": "这场长期的疾病在过去几个月里大大地<w>削弱</w>了这位老人的身体。"
                            }
                        },
                        {
                            "text": "Le manque chronique de sommeil risque d'<w>affaiblir</w> votre système immunitaire avant l'hiver.",
                            "target_lang_translations": {
                                "en": "Chronic lack of sleep risks <w>weakening</w> your immune system before winter.",
                                "ru": "Хронический недостаток сна рискует <w>ослабить</w> вашу иммунную систему до наступления зимы.",
                                "de": "Chronischer Schlafmangel droht, Ihr Immunsystem vor dem Winter zu <w>schwächen</w>.",
                                "es": "La falta crónica de sueño puede <w>debilitar</w> su sistema inmunitario antes del invierno.",
                                "zh": "长期睡眠不足可能会在入冬前<w>削弱</w>您的免疫系统。"
                            }
                        }
                    ],
                    "synonyms": [
                        "diminuer",
                        "amoindrir",
                        "atténuer"
                    ],
                    "antonyms": [
                        "renforcer",
                        "fortifier",
                        "consolider"
                    ],
                    "common_phrases": [
                        "affaiblir la position",
                        "affaiblir le système immunitaire",
                        "affaiblir l'économie"
                    ],
                    "target_lang_definitions": {
                        "en": "Make weaker by reducing strength, vigour or intensity.",
                        "ru": "Делать слабее, уменьшая силу, мощь или интенсивность.",
                        "de": "Etwas in seiner Kraft, Stärke oder Intensität verringern, sodass es schwächer wird.",
                        "es": "Hacer más débil disminuyendo la fuerza, el vigor o la intensidad.",
                        "zh": "通过减少力量、体力或强度，使某事物变得更弱。"
                    },
