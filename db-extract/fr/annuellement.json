                    {
                        "sense_id": "d5337998-1278-3efa-b81c-cee067ca18b1",
                        "entry_id": "9c0783ff-07a9-34b4-8e65-ffb29acda31c",
                        "glosses": [
                            "Par chaque année."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "80d40688-8db9-4152-8fbd-ba1389201691",
                                "sense_id": "d5337998-1278-3efa-b81c-cee067ca18b1",
                                "text": "La bière est une boisson rafraîchissante, saine et nourrissante […] à Londres, par exemple, la consommation locale s’élève annuellement au-delà de 250 millions de litres."
                            },
                            {
                                "example_id": "8a6a1196-9359-48b5-8c05-125771791454",
                                "sense_id": "d5337998-1278-3efa-b81c-cee067ca18b1",
                                "text": "Dans le port flottaient les pavillons de toutes les nations, et plus de deux millions d’êtres humains s’y embarquaient annuellement."
                            },
                            {
                                "example_id": "401fcc52-d877-4643-bde1-0af10234a03f",
                                "sense_id": "d5337998-1278-3efa-b81c-cee067ca18b1",
                                "text": "Alors que la France entière fournit annuellement environ 55 millions d’hectolitres de vin, l’Hérault à lui seul en donne de 11 à 12 millions : plus du cinquième !"
                            },
                            {
                                "example_id": "74d97c13-c666-45c0-b03c-dd331f0950e1",
                                "sense_id": "d5337998-1278-3efa-b81c-cee067ca18b1",
                                "text": "D’après les estimations des professionnels, environ 3 millions de tonnes de composts contenant du déchet vert sont produites annuellement en France pour servir d’amendements organiques en espaces verts, dans les jardins et en agriculture."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f85058bd-33de-44d0-a650-d3f4bcbb9a04",
                        "source_entry_id": "9c0783ff-07a9-34b4-8e65-ffb29acda31c",
                        "source_sense_id": "d5337998-1278-3efa-b81c-cee067ca18b1",
                        "target_lang_word": "jährlich",
