                    },
                    {
                        "form_id": "405edd66-3e4d-4cfe-ba10-5865b2586035",
                        "entry_id": "be1c5634-e01f-3eec-84c7-254afcb5d265",
                        "tags": [
                            "plural"
                        ],
                        "form": "cambia"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3971e20a-cb8e-3479-9cac-3e0d8a180e1e",
                        "entry_id": "be1c5634-e01f-3eec-84c7-254afcb5d265",
                        "glosses": [
                            "A layer of cells between the xylem and the phloem that is responsible for the secondary growth of roots and stems."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "388c5620-7ff6-4901-8c9c-c89e4bbcdb97",
                                "sense_id": "3971e20a-cb8e-3479-9cac-3e0d8a180e1e",
                                "text": "During winter we perceive no change in the cells of the cambium layer, which are filled with nutritive matter […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "1c339036-32d0-318b-8eb3-2624f9ed58c9",
                        "entry_id": "be1c5634-e01f-3eec-84c7-254afcb5d265",
                        "glosses": [
                            "Periosteum, a membrane that covers the outer surface of bones"
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "8f921bf1-cbff-3a53-8328-b3705fd8b34d",
                        "entry_id": "be1c5634-e01f-3eec-84c7-254afcb5d265",
                        "glosses": [
                            "One of the humours formerly believed to nourish the bodily organs."
                        ],
                        "tags": [
                            "countable",
                            "obsolete",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "6f3c6c4e-2950-4aa7-85d5-7dd9f1d83545",
                                "sense_id": "8f921bf1-cbff-3a53-8328-b3705fd8b34d",
                                "text": "The radical or innate is daily supplied by nourishment, which some call cambium, and make those secondary humours of ros and gluten to maintain it […]"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
