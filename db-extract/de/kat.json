                "senses": [
                    {
                        "sense_id": "883bbc67-2fe2-3cde-bbb9-c347b9d3ca83",
                        "entry_id": "8a524167-066f-3b98-9641-25a8e60c8def",
                        "glosses": [
                            "leichtes Rauschgift im nördlichen Ostafrika"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b135435-e670-4f99-8644-044d448bfa58",
                                "sense_id": "883bbc67-2fe2-3cde-bbb9-c347b9d3ca83",
                                "text": "Kat enthält das Alkaloid Cathin, das für die aufputschende Wirkung sorgt."
                            }
                        ],
                        "sense_index_json": "\"1\""
