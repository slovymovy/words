                "senses": [
                    {
                        "sense_id": "e73b05eb-cce3-3b53-b985-ff7380e93192",
                        "entry_id": "55ad823e-7bc8-3f60-83ec-089b47bb28a6",
                        "glosses": [
                            "kürzerer Film, der im Kino vor dem eigentlichen Spielfilm gezeigt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ec3610a-b93c-4e06-a0e2-80f987c2358f",
                                "sense_id": "e73b05eb-cce3-3b53-b985-ff7380e93192",
                                "text": "„Der Beifilm ist in seinem Rezeptionsumfeld prinzipiell kein Zielgruppenfilm. Er spreche breiteste, sozialintegrative Interessen an. Beifilm als Beifilm. Er ist Beilage, Konterbande, die Kopplung für das Publikum zudem nicht ersichtlich.“ (1984)"
                            },
                            {
                                "example_id": "9b22566f-03fc-494a-96a7-acd7edc25f41",
                                "sense_id": "e73b05eb-cce3-3b53-b985-ff7380e93192",
                                "text": "„Schön — es gibt nicht genügend Beifilme und besonders nicht so köstliche, wie den Katzentrickfilm gestern: „Eine Fabel Aesops\" (Pathe-Film der Ufa).“ (1959)"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
