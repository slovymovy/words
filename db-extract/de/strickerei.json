                            {
                                "target_word": "knitting",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f26e534d-99ff-3269-830f-ded2c3b3ca49",
                                        "entry_id": "19d4043f-5283-3afa-92c8-7318de2582bc",
                                        "glosses": [
                                            "The action of the verb to knit; the process of producing knitted material."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c24ba468-d3ed-4325-8b32-b0a0137ea976",
                                                "sense_id": "f26e534d-99ff-3269-830f-ded2c3b3ca49",
                                                "text": "I find knitting very relaxing."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "490f5a85-f068-36da-8152-27ce97ee8ac7",
                                        "entry_id": "19d4043f-5283-3afa-92c8-7318de2582bc",
                                        "glosses": [
                                            "Material that has been, or is being knitted."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "16e8fbcd-3449-43c3-8b2d-7a3e2a8c2d87",
                                                "sense_id": "490f5a85-f068-36da-8152-27ce97ee8ac7",
                                                "text": "She put down her knitting and went to answer the phone."
                                            },
                                            {
                                                "example_id": "2f7d2b43-ce07-4c11-8867-8c0f546cee46",
                                                "sense_id": "490f5a85-f068-36da-8152-27ce97ee8ac7",
                                                "text": "At Kiwi, 40 miles from Nelson [New Zealand], eight women installed themselves in the goods shed, taking with them their knitting, and a supply of food and magazines. The demolition crew was unable to pull the building down without injuring them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fe387765-4a55-325e-8800-b1d2ce8dbefb",
                                        "entry_id": "19d4043f-5283-3afa-92c8-7318de2582bc",
                                        "glosses": [
                                            "overhead electrification wires, OHLE"
                                        ],
                                        "tags": [
                                            "UK",
                                            "countable",
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "69499aa1-feba-4941-9481-aec1de33e850",
                                                "sense_id": "fe387765-4a55-325e-8800-b1d2ce8dbefb",
                                                "text": "Fair point. Instead of tearing down the knitting and using diesel, tear down the knitting and use turbines."
                                            },
                                            {
                                                "example_id": "3a061ec0-9ebc-4149-a94e-33095871ffe0",
                                                "sense_id": "fe387765-4a55-325e-8800-b1d2ce8dbefb",
                                                "text": "It also helps, if: [...] the knitting is aligned with the track below, or rather vice versa, something else that went after 1996."
                                            },
                                            {
                                                "example_id": "09b036a4-4a1e-452c-8b89-905935b9aae7",
                                                "sense_id": "fe387765-4a55-325e-8800-b1d2ce8dbefb",
                                                "text": "My suggestion would be to electrify the uphill bits only, in each direction, and to use diesel traction when coming down the other side. Massive savings on posts and knitting for a start."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
