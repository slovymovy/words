                "senses": [
                    {
                        "sense_id": "030a5983-76e7-3316-9c7b-f4292604b248",
                        "entry_id": "c289a5a3-1d5b-351b-a5fa-93bf7c0a141a",
                        "glosses": [
                            "im schlechtesten denkbaren Fall"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a3fae8af-c5ed-4199-9784-f0e4586b9a14",
                                "sense_id": "030a5983-76e7-3316-9c7b-f4292604b248",
                                "text": "Schlimmstenfalls müssen wir unterwegs irgendwo ein Nachtlager einrichten."
                            }
                        ],
