                "senses": [
                    {
                        "sense_id": "72054666-e6af-3c72-acf2-6c8186553126",
                        "entry_id": "54720e74-a7fe-3e4c-973f-23978276141f",
                        "glosses": [
                            "женское отчество от имени Павел"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "12cf424e-ad28-4fc2-bcda-9635c311aded",
                                "sense_id": "72054666-e6af-3c72-acf2-6c8186553126",
                                "text": "У дяди Романа была жена ― Галина Павловна."
                            },
                            {
                                "example_id": "517a623c-8689-4915-999d-bc47b2a7c26a",
                                "sense_id": "72054666-e6af-3c72-acf2-6c8186553126",
                                "text": "В январе 1818 года отец мой женился на дочери нижегородского исправника, надворного советника Павла Петровича Сергеева, Анне Павловне."
                            },
                            {
                                "example_id": "ad70a181-b424-4a9f-9100-bdd58803f1f9",
                                "sense_id": "72054666-e6af-3c72-acf2-6c8186553126",
                                "text": "Лакей вошел и доложил о приезде Александры Павловны и ее брата."
                            }
                        ]
                    }
                ],
