                        "tags": [],
                        "examples": [
                            {
                                "example_id": "20644273-81b0-41c4-a1f4-5626cac8fafa",
                                "sense_id": "08ad6f3d-b092-3353-b76d-19085afe1366",
                                "text": "„Um Punkt fünf Uhr Morgens setzte sich die Panzerkolonne von der Kaserne Arsenal in Bewegung und rollte über den Schwarzenbergplatz entlang der Ringstraße auf den Wiener Heldenplatz.“"
                            },
                            {
                                "example_id": "0e51f645-2bd8-45bb-a509-8ac19c55e7c0",
                                "sense_id": "08ad6f3d-b092-3353-b76d-19085afe1366",
                                "text": "„Und die Straßen hier unten waren verstopft von unseren Panzerkolonnen.“"
                            }
                        ],
