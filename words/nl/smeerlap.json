                            "comment": "Historisch of verouderd gebruik"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A greasy rag or cloth used to lubricate parts to reduce friction."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "grease rag",
                                "target_lang_sense_clarification": "a cloth soaked in grease or oil for lubrication"
                            },
                            {
                                "target_lang_word": "lubricating cloth",
                                "target_lang_sense_clarification": "a cloth used to apply lubricant"
                            }
                        ]
                    }
