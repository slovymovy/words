        "nl-extract.jsonl": [
            {
                "entry_id": "b47c83b7-1d4c-363f-8f75-a92b5bceeab1",
                "word": "sprookje",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "fbdb458c-005e-42f9-ae4f-a5a54ecad182",
                        "entry_id": "b47c83b7-1d4c-363f-8f75-a92b5bceeab1",
                        "tags": [
                            "diminutive",
                            "plural"
                        ],
                        "form": "sprookjes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ad32ed9d-2824-3804-82e8-f78ef8c7ee51",
                        "entry_id": "b47c83b7-1d4c-363f-8f75-a92b5bceeab1",
                        "glosses": [
                            "een meestal moraliserend verhaal voor kinderen waarin fantasiewezens en magie een belangrijke rol spelen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e212df4c-f4db-436f-aece-b03c0866d30d",
                                "sense_id": "ad32ed9d-2824-3804-82e8-f78ef8c7ee51",
                                "text": "Hans en Grietje, Sneeuwwitje, de Gelaarsde kat zijn bekende sprookjes."
                            },
                            {
                                "example_id": "edd1b7c9-a410-4407-9c3a-cc85395cd8c2",
                                "sense_id": "ad32ed9d-2824-3804-82e8-f78ef8c7ee51",
                                "text": "In de prachtige film Boyhood vraagt het jongetje Mason: ‘Papa, sprookjes zijn niet echt, hè? Ik bedoel, zoals elfjes enzo. Dat hebben mensen gewoon verzonnen.’"
                            }
                        ]
                    },
                    {
                        "sense_id": "d46108a4-7e69-32bf-9dcb-8e82e9f312d1",
                        "entry_id": "b47c83b7-1d4c-363f-8f75-a92b5bceeab1",
                        "glosses": [
                            "iets wat te mooi is om waar te zijn"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "6846a5a7-93df-45ab-98e0-f1b427c7dee5",
                                "sense_id": "d46108a4-7e69-32bf-9dcb-8e82e9f312d1",
                                "text": "Het leek wel een sprookje zo mooi maar toch voelde ik me niet op mijn gemak en ik wilde hier zo snel mogelijk weg."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8648ee6b-2e80-42df-aa17-535c037e58db",
                        "source_entry_id": "b47c83b7-1d4c-363f-8f75-a92b5bceeab1",
                        "source_sense_id": "ad32ed9d-2824-3804-82e8-f78ef8c7ee51",
                        "source_sense_description": "verzonnen vertelling",
                        "target_lang_word": "Märchen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Märchen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1ee4e92a-6362-36f3-bd74-dd43ca61faa6",
                                        "entry_id": "7821e0fe-87d3-35fb-b804-4b86870e1244",
                                        "glosses": [
                                            "auf mündlicher Überlieferung beruhende, kurze Erzählung, oft mit fantastischen und wunderbaren Begebenheiten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf4f5b44-a112-42b9-a15c-b5ed5237be3a",
                                                "sense_id": "1ee4e92a-6362-36f3-bd74-dd43ca61faa6",
                                                "text": "Dornröschen war auch ein schönes Märchen."
                                            },
                                            {
                                                "example_id": "3f885c3d-d550-44d7-ab9c-f8c4211d9160",
                                                "sense_id": "1ee4e92a-6362-36f3-bd74-dd43ca61faa6",
                                                "text": "„Spüren wir nun einigen Sagen und Märchen nach, die sich rund um das Wesen und Wirken guter und böser Hexen, vor allem aber auch rund um den Brocken und seine Region im Hochharz ranken.“"
                                            },
                                            {
                                                "example_id": "49dc3930-93f2-4955-8b1c-2d9fe9337336",
                                                "sense_id": "1ee4e92a-6362-36f3-bd74-dd43ca61faa6",
                                                "text": "„Der Tag wird interessanter, wenn man Märchen erzählt.“"
                                            },
                                            {
                                                "example_id": "3b8b7ab5-c4d3-412e-a8d9-4602b2e3c693",
                                                "sense_id": "1ee4e92a-6362-36f3-bd74-dd43ca61faa6",
                                                "text": "„Wie jedes Märchen führt es in Zustände, die uns etwas von der Tiefe und der Unbegreiflichkeit des Daseins erkennen lassen.“"
                                            },
                                            {
                                                "example_id": "105806b2-04e9-40c0-bd8b-b3a1791d2341",
                                                "sense_id": "1ee4e92a-6362-36f3-bd74-dd43ca61faa6",
                                                "text": "„Deutsche Märchen sind durch jahrhundertelanges Umschreiben verweichlicht worden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "70802f96-01b0-3ff9-a044-cd051124a1a9",
                                        "entry_id": "7821e0fe-87d3-35fb-b804-4b86870e1244",
                                        "glosses": [
                                            "unwahre, erfundene Geschichte"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa357e25-5a26-404a-8a4c-4348de947a20",
                                                "sense_id": "70802f96-01b0-3ff9-a044-cd051124a1a9",
                                                "text": "„Erzähl doch keine Märchen!“"
                                            },
                                            {
                                                "example_id": "c11927dc-f326-4b3f-9f0d-ea8952ef1c56",
                                                "sense_id": "70802f96-01b0-3ff9-a044-cd051124a1a9",
                                                "text": "„Die Klimaleugner der Erdölindustrie erzählten das verführerischste aller Märchen, nämlich dass alles so weitergehen könne wie bisher.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "707f9aac-3729-42ae-b5e4-7e96136a92c0",
                        "source_entry_id": "b47c83b7-1d4c-363f-8f75-a92b5bceeab1",
                        "source_sense_id": "ad32ed9d-2824-3804-82e8-f78ef8c7ee51",
                        "source_sense_description": "verzonnen vertelling",
                        "target_lang_word": "fairy tale",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fairy tale",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5249cbe1-0c04-342c-a7c0-882c78854c94",
                                        "entry_id": "7c2b235c-9d44-30f1-867b-d104f349e4b7",
                                        "glosses": [
                                            "A folktale or literary story featuring fairies or similar fantasy characters."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27f0f434-1ea9-4d7e-97b5-797c4c897ab3",
                                                "sense_id": "5249cbe1-0c04-342c-a7c0-882c78854c94",
                                                "text": "I used to love reading fairy tales when I was a child."
                                            },
                                            {
                                                "example_id": "388331c8-b211-403c-a4d8-d65fd2c7224d",
                                                "sense_id": "5249cbe1-0c04-342c-a7c0-882c78854c94",
                                                "text": "The Wife of Bathes Tale is evidently a Fairy-tale. It thus commences: In olde dayes of the king Artour, / Of which that Bretons speken gret honour, / All was this land fulfilled of faerie."
                                            },
                                            {
                                                "example_id": "99f0739e-f2eb-4393-b3e5-3a27e1b433b8",
                                                "sense_id": "5249cbe1-0c04-342c-a7c0-882c78854c94",
                                                "text": "The Arabian Nights rehears'd in bed! / The Fairy Tales in school-time read."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ae16a890-6610-32c8-9aa4-c2d1612fffb9",
                                        "entry_id": "7c2b235c-9d44-30f1-867b-d104f349e4b7",
                                        "glosses": [
                                            "The literary genre of these stories."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0a4afda4-4b97-4aeb-9c01-8227d91c1be2",
                                                "sense_id": "ae16a890-6610-32c8-9aa4-c2d1612fffb9",
                                                "text": "Their dresses were rich, and when they came bounding forward, their shapes of silver tissue, with their feathered diadems and faces of animated beauty, they might be imagined into scarcely less than the creations of fairy tale."
                                            },
                                            {
                                                "example_id": "cf918547-8a03-4d4a-88e7-a7751906af8a",
                                                "sense_id": "ae16a890-6610-32c8-9aa4-c2d1612fffb9",
                                                "text": "Mr. Shimerda kneels in front of the tree in prayer; a praying figure under a magic tree is a common one in fairy tale."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ec85b314-46ab-3df0-a76d-68fd9c3f53f7",
                                        "entry_id": "7c2b235c-9d44-30f1-867b-d104f349e4b7",
                                        "glosses": [
                                            "A story presented as true that is not believable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e4dff712-96c5-44ce-9958-1c898536b03e",
                                                "sense_id": "ec85b314-46ab-3df0-a76d-68fd9c3f53f7",
                                                "text": "He's telling us another fairy tale about how great the software will be."
                                            },
                                            {
                                                "example_id": "5895ec9d-739f-4443-947e-dbf7339b4c59",
                                                "sense_id": "ec85b314-46ab-3df0-a76d-68fd9c3f53f7",
                                                "text": "If emigrants will submit to the \"fairy tales\" of Mr. Thomas, and fall in with his suggestions, they must patiently submit to the disagreeable consequences."
                                            },
                                            {
                                                "example_id": "87b7aab7-e81e-4f6f-8bc5-21a66f5eb41f",
                                                "sense_id": "ec85b314-46ab-3df0-a76d-68fd9c3f53f7",
                                                "text": "Comedy as satire is acceptable, as fun it is a pleasant haven of escape, but the fairy tale of happiness ever after cannot be taken seriously; it belongs to the never-never land of childhood, which is protected from the realities that will become terribly known soon enough[.]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "471eaf86-fd3a-34d6-997a-2d7ccb9912c8",
                                        "entry_id": "7c2b235c-9d44-30f1-867b-d104f349e4b7",
                                        "glosses": [
                                            "A delightful and ideal situation of a kind attained by very few."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57342547-2caf-40a6-9cb0-083e72c877c1",
                                                "sense_id": "471eaf86-fd3a-34d6-997a-2d7ccb9912c8",
                                                "text": "I've been living in a fairy tale since I met Joe."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "07816234-b7a2-4417-8f63-cfbc75e16814",
                        "source_entry_id": "b47c83b7-1d4c-363f-8f75-a92b5bceeab1",
                        "source_sense_id": "ad32ed9d-2824-3804-82e8-f78ef8c7ee51",
                        "source_sense_description": "verzonnen vertelling",
                        "target_lang_word": "conte de fées",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "conte de fées",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1a9edfc5-91a5-3478-a745-5e11cda34ed6",
                                        "entry_id": "6c51fb38-8761-364e-93ce-cdf50bc4eccd",
                                        "glosses": [
                                            "Récit fabuleux de la littérature, qui met en scène des personnages merveilleux, ou encore des créatures imaginaires."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa1ed2c1-ccd3-446e-b3a9-9fbc9823727a",
                                                "sense_id": "1a9edfc5-91a5-3478-a745-5e11cda34ed6",
                                                "text": "S’il ne s’agissait pas d’un conte de fées, mais d’une aventure réelle, trop réelle, on verrait la femme de Barbe-Bleue obtenir que son mari lui ouvrît lui-même la porte du cabinet tragique, après lui avoir juré ses grands dieux qu’elle ne l’en aimerait que davantage […]"
                                            },
                                            {
                                                "example_id": "535e5c37-e78b-41d9-b765-be311931e6ab",
                                                "sense_id": "1a9edfc5-91a5-3478-a745-5e11cda34ed6",
                                                "text": "Elle était pleine d’histoires. C’est d’elle que j’appris les contes de fées qu’une paysanne eût rougi de conter à ses enfants."
                                            },
                                            {
                                                "example_id": "994ca0c0-e6a2-4eb3-a918-b6862f34002c",
                                                "sense_id": "1a9edfc5-91a5-3478-a745-5e11cda34ed6",
                                                "text": "Ai-je cru vraiment, à cette époque ? Il me semble que j’ai marché dans la chose de la sainte religion, comme dans les images d’Épinal, ou dans mes bouquins de contes de fées à tranches dorées."
                                            },
                                            {
                                                "example_id": "3c17c919-583b-4942-aec1-6de2ce277a66",
                                                "sense_id": "1a9edfc5-91a5-3478-a745-5e11cda34ed6",
                                                "text": "Le haras s’étend sur plusieurs hectares d'une herbe de contes de fées. J'emprunte une allée bordée de fusains et débouche sur la cour centrale où un palefrenier et un maître de manège s'engueulent virilement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b660069d-50e9-39c5-803a-714c153914b9",
                                        "entry_id": "6c51fb38-8761-364e-93ce-cdf50bc4eccd",
                                        "glosses": [
                                            "Livre sur lequel est imprimé ce récit."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "69651b50-2a81-3bb9-8a0d-a6a1de6beb21",
                                        "entry_id": "6c51fb38-8761-364e-93ce-cdf50bc4eccd",
                                        "glosses": [
                                            "Tromperie niaise."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "af8325ae-5699-3863-8bd9-075f20cbfb0a",
                                        "entry_id": "6c51fb38-8761-364e-93ce-cdf50bc4eccd",
                                        "glosses": [
                                            "Événement particulièrement favorable, circonstances idéales."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80e5fcdb-01a4-43fd-898a-d297ad7e0536",
                                                "sense_id": "af8325ae-5699-3863-8bd9-075f20cbfb0a",
                                                "text": "C’était aussi un vrai conte de fées pour Brune Moulin, 15 ans qui faisait ses débuts dans La Plus Belle pour aller danser, de Victoria Bedos, et qui a remporté le Prix d’interprétation féminine."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
