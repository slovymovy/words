            "senses": [
                {
                    "sense_id": "93321a7e-7863-3f77-996f-3d11453f1c3f",
                    "sense_definition": "En nul temps, à aucun moment, généralement employé avec la négation « ne ».",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "negation_temporelle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je ne bois <w>jamais</w> de café le soir pour pouvoir bien dormir."
                        },
                        {
                            "text": "Il n'est <w>jamais</w> venu visiter notre nouvelle maison à la campagne."
                        }
                    ],
                    "antonyms": [
                        "toujours"
                    ],
                    "common_phrases": [
                        "ne jamais",
                        "jamais plus",
                        "presque jamais"
                    ]
                },
                {
                    "sense_id": "7c4f3ae7-5ad8-33ba-ac25-893df4f8bdb8",
                    "sense_definition": "À un moment quelconque, un jour, dans une phrase hypothétique, interrogative ou comparative.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "temps_indefini",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Si <w>jamais</w> tu passes par Paris, viens nous rendre visite."
                        },
                        {
                            "text": "Cette ville historique reste aujourd'hui plus vivante et dynamique que <w>jamais</w>."
                        }
                    ],
                    "common_phrases": [
