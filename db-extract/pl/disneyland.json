                "senses": [
                    {
                        "sense_id": "8305081f-3c5f-3c24-b48a-8cf1a8c14d61",
                        "entry_id": "58337792-dab8-32dd-8811-5927e467ce32",
                        "glosses": [
                            "wspólna nazwa kilku parków rozrywki tematycznie związanych z produkcjami The Walt Disney Company"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c08f3ed9-c6ef-4393-ae40-7ab35d36cbef",
                                "sense_id": "8305081f-3c5f-3c24-b48a-8cf1a8c14d61",
                                "text": "Ten obrzydliwy incydent wydarzył się w ubiegły piątek, ok. 21.00 w Disneylandzie w Los Angeles"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "799e5867-ed3d-42d6-8b9d-4f1084bfc178",
                        "source_entry_id": "58337792-dab8-32dd-8811-5927e467ce32",
                        "source_sense_id": "8305081f-3c5f-3c24-b48a-8cf1a8c14d61",
                        "target_lang_word": "Disneyland",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Disneyland",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "52cf9d5e-f9ec-3cd1-bc66-21af69d598c9",
                                        "entry_id": "4b5798c7-0e9d-3515-b451-4709e369066f",
                                        "glosses": [
                                            "The archetypical theme park, located in Anaheim, California. Other Disneyland theme parks exist in other cities such as Chessy (Seine-et-Marne, France), Tokyo, Shanghai, and Hong Kong."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Disneyland",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "71bbd2f3-68ec-3abb-a816-16bfa8ea7cbf",
                                        "entry_id": "799b2b78-ef0e-3c03-9bc0-66edb72f127d",
                                        "glosses": [
                                            "A place resembling the Disneyland theme park, often typified by a corporately-designed cheerfulness."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "informal",
                                            "often"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fabf5880-481c-4cc9-a188-30c5b7240279",
                                                "sense_id": "71bbd2f3-68ec-3abb-a816-16bfa8ea7cbf",
                                                "text": "With its talking statuary, its enormous and elaborate monuments and museums, and its variety of daily shows, it has become a Disneyland of the dead..."
                                            },
                                            {
                                                "example_id": "e9456fd3-2900-4a08-8f46-3c0b6f987167",
                                                "sense_id": "71bbd2f3-68ec-3abb-a816-16bfa8ea7cbf",
                                                "text": "Certainly anyone devoted to maintaining Christ as a lacquered benevolent spirit in a Disneyland of happiness is not going to like this movie."
                                            },
                                            {
                                                "example_id": "cea1a4b4-5e7c-472d-8686-b661cb138a98",
                                                "sense_id": "71bbd2f3-68ec-3abb-a816-16bfa8ea7cbf",
                                                "text": "This approach can lead to a Disneyland of a garden that busily vies for attention with the view, bringing out the best in neither."
                                            },
                                            {
                                                "example_id": "7f1ef4c5-1429-415f-82a5-7e1964689dd6",
                                                "sense_id": "71bbd2f3-68ec-3abb-a816-16bfa8ea7cbf",
                                                "text": "But there is another future that these statistics and our nostalgic reaction to them might produce: the research library as a Disneyland of books, with banker’s lamps and never-cracked spines providing the suggestion of, but not the true interaction with, knowledge old and new."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
