                ],
                "senses": [
                    {
                        "sense_id": "494c820d-e70b-3ed2-b757-d0f00d4f8e81",
                        "entry_id": "f6af02f8-69d3-3e1a-a6cd-772bd02b0dcc",
                        "glosses": [
                            "imię męskie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ff166aa-65a9-4bf7-b2e1-98f4e923dcf0",
                                "sense_id": "494c820d-e70b-3ed2-b757-d0f00d4f8e81",
                                "text": "Nasz stary zakrystian ma na imię Florian."
                            },
                            {
                                "example_id": "cd21f834-11a0-4f84-916f-c578b0f34656",
                                "sense_id": "494c820d-e70b-3ed2-b757-d0f00d4f8e81",
                                "text": "Florian Kowalewski był budowniczym, który pracował przy montażu mostów, m.in.: w Wilnie przez Wilię, Grodnie przez Niemen, Warszawie przez Wisłę."
                            },
                            {
                                "example_id": "d14719cf-2e74-4370-ab29-021b6ad8f45f",
                                "sense_id": "494c820d-e70b-3ed2-b757-d0f00d4f8e81",
                                "text": "W Kościele katolickim na 4 maja przypada wspomnienie św. Floriana z Lauriacum, patrona strażaków i hutników oraz chroniącego od pożarów."
                            },
                            {
                                "example_id": "e90501ae-7542-4f62-a2e6-7f658913911d",
                                "sense_id": "494c820d-e70b-3ed2-b757-d0f00d4f8e81",
                                "text": "Florianowie dzień swego patrona, czyli imieniny, obchodzą 4 maja, a także 5 listopada i 17 grudnia."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5831b0f7-a499-41dd-b8ef-af05501d0a89",
                        "source_entry_id": "f6af02f8-69d3-3e1a-a6cd-772bd02b0dcc",
                        "source_sense_id": "494c820d-e70b-3ed2-b757-d0f00d4f8e81",
