                    "sense_definition": "extreem boos of kwaad zijn",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "emotie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij werd <w>razend</w> toen hij hoorde dat zijn nieuwe fiets was gestolen.",
                            "target_lang_translations": {
                                "en": "He became <w>furious</w> when he heard that his new bicycle had been stolen.",
                                "ru": "Он пришел в <w>ярость</w>, когда услышал, что его новый велосипед украли.",
                                "fr": "Il est devenu <w>furieux</w> lorsqu'il a appris que son nouveau vélo avait été volé."
                            }
                        },
                        {
                            "text": "De klant was <w>razend</w> over de slechte service in het restaurant.",
                            "target_lang_translations": {
                                "en": "The customer was <w>enraged</w> about the poor service in the restaurant.",
                                "ru": "Клиент был <w>взбешен</w> плохим обслуживанием в ресторане.",
                                "fr": "Le client était <w>furieux</w> du mauvais service dans le restaurant."
