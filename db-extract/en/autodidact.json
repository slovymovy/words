                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c4493a82-7239-4689-b3b2-6b588eed1348",
                                                "sense_id": "f3c3bc06-e3c0-3d31-af4a-938f70f7deeb",
                                                "text": "Le grand frère fraîchement déjonqué s’autodidacte le français"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "44129afc-a95e-3270-9dad-b91f4451b66a",
                                        "entry_id": "9c24be8c-109a-33b6-8220-00d638145555",
