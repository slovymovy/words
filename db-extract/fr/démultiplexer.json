                "senses": [
                    {
                        "sense_id": "965c6a1a-9eef-3def-a5e6-08192a898ab1",
                        "entry_id": "3aa1d81d-9b3c-37c0-ab20-7b325c9fd3f3",
                        "glosses": [
                            "Restituer les signaux originaux à partir d'un signal composite obtenu par multiplexage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ee1630e-91b2-44ac-afdc-fdff0c9667ba",
                                "sense_id": "965c6a1a-9eef-3def-a5e6-08192a898ab1",
                                "text": "Le cerveau humain utilise très mal l’interpolation de Shannon mais est capable de démultiplexer en temps."
                            },
                            {
                                "example_id": "1450cbd8-c4e4-42b1-a004-4fe9fdd42d08",
                                "sense_id": "965c6a1a-9eef-3def-a5e6-08192a898ab1",
                                "text": "Pour faire fonctionner le panneau, il faut d’abord démultiplexer le courant des données à l’aide d’un décodeur."
                            }
                        ]
                    }
                ],
