                        "glosses": [
                            "een voertuig voor het transport van overledenen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8af59285-270c-4729-9024-e00a7abe224d",
                                "sense_id": "9982b27d-efa3-3ac1-a54a-a54fbe213d38",
                                "text": "Vanuit de rouwauto zie ik hoe een medewerker van het uitvaartcentrum, een andere dan de konijnenman, zwarte vlaggetjes uitdeelt aan de bestuurders van de auto's die meerijden in de stoet."
                            },
                            {
                                "example_id": "73feaaa3-e5ce-4df4-898d-8b861afed1d8",
                                "sense_id": "9982b27d-efa3-3ac1-a54a-a54fbe213d38",
                                "text": "Vanaf 14.15 uur kunnen supporters zich verzamelen bij de Kuip, waar de rouwauto met Gyan langs zal rijden. ,,Vanwege de coronamaatregelen worden alle aanwezigen verzocht om zich zoveel mogelijk over het voorplein te verspreiden en de afstand tot de familie van Gyan te respecteren."
                            }
                        ]
                    }
