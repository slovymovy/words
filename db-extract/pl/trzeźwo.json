                "forms": [],
                "senses": [
                    {
                        "sense_id": "ff8ce74a-654f-3a34-9bc1-7b87a18beac4",
                        "entry_id": "82a5d679-df06-3331-bcd5-025bc33d269b",
                        "glosses": [
                            "nie będąc pod wpływem alkoholu"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "8d58cafe-c0e8-3b45-9539-ae8a20ab798b",
                        "entry_id": "82a5d679-df06-3331-bcd5-025bc33d269b",
                        "glosses": [
                            "mając jasny umysł, myśląc z rozsądkiem"
                        ],
                        "tags": [
                            "metaphoric"
                        ],
                        "examples": [
                            {
                                "example_id": "98b1b4f3-ec78-4083-b8b3-9783a0ab8684",
                                "sense_id": "8d58cafe-c0e8-3b45-9539-ae8a20ab798b",
                                "text": "Od sędziego wymaga się czterech rzeczy: aby słuchał grzecznie, odpowiadał mądrze, rozważał sprawę trzeźwo i decydował bezstronnie"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fd4cb2df-bff6-4f17-9abf-9514bef28486",
                        "source_entry_id": "82a5d679-df06-3331-bcd5-025bc33d269b",
                        "source_sense_id": "ff8ce74a-654f-3a34-9bc1-7b87a18beac4",
                        "target_lang_word": "soberly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "soberly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6782ef86-d623-3ba5-ba02-d2aeb36c676d",
                                        "entry_id": "c556fbb5-8000-3ffc-adcc-5cd3eb78a648",
                                        "glosses": [
                                            "In a sober manner; temperately; coolly; calmly; gravely; seriously."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "739d8a01-4f75-42a7-a2e2-afe15a3cf2f1",
                                                "sense_id": "6782ef86-d623-3ba5-ba02-d2aeb36c676d",
                                                "text": "Amongst this number of cordials and alteratives I do not find a more present remedy than a cup of wine or strong drink, if it be soberly and opportunely used."
                                            },
                                            {
                                                "example_id": "5633b79f-7765-4297-a45b-c1bbc5771442",
                                                "sense_id": "6782ef86-d623-3ba5-ba02-d2aeb36c676d",
                                                "text": "They gathered soberly in the farthest recess of the ward and gossiped about him in malicious, offended undertones, rebelling against his presence as a ghastly imposition and resenting him malevolently for the nauseating truth of which he was bright reminder."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "074615ff-51b0-4ff5-a8d5-0103eb125307",
                        "source_entry_id": "82a5d679-df06-3331-bcd5-025bc33d269b",
                        "source_sense_id": "ff8ce74a-654f-3a34-9bc1-7b87a18beac4",
                        "target_lang_word": "nüchtern",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nüchtern",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "73f3bb14-6b7f-37f8-b91a-c645a1f48d8f",
                                        "entry_id": "6bd73a55-cac5-39c7-a37d-843714a005ab",
                                        "glosses": [
                                            "ohne Alkohol im Blut"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "058572c8-e0ec-4c05-a449-8cf307901d5c",
                                                "sense_id": "73f3bb14-6b7f-37f8-b91a-c645a1f48d8f",
                                                "text": "Beim Autofahren sollte man besser nüchtern sein."
                                            },
                                            {
                                                "example_id": "992deaee-9f27-498c-807d-d10d4d2fb3d1",
                                                "sense_id": "73f3bb14-6b7f-37f8-b91a-c645a1f48d8f",
                                                "text": "Nüchtern betrachtet ist besoffen besser als nüchtern.(Spruch an Kneipenklotür)"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f979598a-16ff-3b3c-a0de-02d93d7718cf",
                                        "entry_id": "6bd73a55-cac5-39c7-a37d-843714a005ab",
                                        "glosses": [
                                            "mit leerem Magen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "084a2f56-6085-4768-8755-521277f888fc",
                                                "sense_id": "f979598a-16ff-3b3c-a0de-02d93d7718cf",
                                                "text": "Zur prä-operativen Untersuchung erscheinen Sie bitte nüchtern."
                                            },
                                            {
                                                "example_id": "326ab334-2fc5-4ec6-8efc-6e67603486d1",
                                                "sense_id": "f979598a-16ff-3b3c-a0de-02d93d7718cf",
                                                "text": "Beim Menschen betragen die Normalwerte [des Blutzuckers]: - nüchtern: 70–99 mg/dl, entsprechend 3,9–5,5 mmol/l; - nach einer kohlenhydratreichen Mahlzeit: maximal bis zu 160 mg/dl, entsprechend 8,9 mmol/l"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "9a344ab6-0c71-32c3-9319-addbb68c37e1",
                                        "entry_id": "6bd73a55-cac5-39c7-a37d-843714a005ab",
                                        "glosses": [
                                            "sehr rational denkend und handelnd; auf Wesentliches, Sachliches beschränkt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "73d436fb-9b44-44e3-ab4c-e2de008ff04a",
                                                "sense_id": "9a344ab6-0c71-32c3-9319-addbb68c37e1",
                                                "text": "Informatiker sind häufig sehr nüchtern denkende Menschen."
                                            },
                                            {
                                                "example_id": "34d043f9-5908-4d1c-be12-0ed21b606b40",
                                                "sense_id": "9a344ab6-0c71-32c3-9319-addbb68c37e1",
                                                "text": "Houellebecq [stellt] sein Zukunftsszenario [eines muslimischen französischen Präsidenten] scheinbar nüchtern und emotionslos dar. Doch das ist typisch für diesen Autor."
                                            },
                                            {
                                                "example_id": "e3980db0-2668-473a-a761-77573a6806ea",
                                                "sense_id": "9a344ab6-0c71-32c3-9319-addbb68c37e1",
                                                "text": "Nüchtern betrachtet ist besoffen besser als nüchtern.(Spruch an Kneipenklotür)"
                                            },
                                            {
                                                "example_id": "9f385970-2296-44d0-b7ee-1e2e4e06999f",
                                                "sense_id": "9a344ab6-0c71-32c3-9319-addbb68c37e1",
                                                "text": "„Es ist wohl möglich, daß später einmal irgendein besonderer Geist sich findet, der meine anscheinend phantastischen Berichte als nüchterne Selbstverständlichkeiten zu erklären vermag – ein klarer und scharfer Geist, weniger exaltiert als ich, der in den Umständen, die ich mit bebender Scheu enthülle, nichts weiter sieht als die einfache Folge ganz natürlicher Ursachen und Wirkungen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "393d981a-1d66-39ab-8dcb-21121c82ce45",
                                        "entry_id": "6bd73a55-cac5-39c7-a37d-843714a005ab",
                                        "glosses": [
                                            "ungesalzene, ungewürzte Speise"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32c7cf31-7f34-4c55-a254-035e0f092e06",
                                                "sense_id": "393d981a-1d66-39ab-8dcb-21121c82ce45",
                                                "text": "Dabei spielten Disziplinierungstechniken eine wichtige Rolle, die vor den Anfeindungen der Lust oder des Sexualtriebes schützen sollten. ›Eros‹ wurde geistig verstanden, aber das hob die Triebnatur nicht auf, daher musste etwas getan werden. Gemeint waren Maßnahmen wie • gezielte körperliche Anstrengung, • erschöpfende manuelle Arbeit, • nüchternes Essen, • Überwachung der Aufenthaltsorte, • Kontrolle in den Schlafzimmern • und Nacktheit."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bc52361d-1e70-4341-afe0-7d14645c1b45",
                        "source_entry_id": "82a5d679-df06-3331-bcd5-025bc33d269b",
                        "source_sense_id": "ff8ce74a-654f-3a34-9bc1-7b87a18beac4",
                        "target_lang_word": "трезво",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "трезво",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "e1bd398f-7c02-396e-bb3e-8464238ddd0c",
                                        "entry_id": "6882dcf5-2954-3c77-b417-c793eb49a294",
                                        "glosses": [
                                            "не находясь в состоянии алкогольного опьянения"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2fb99f9c-b319-4623-be96-73478e5bc8d2",
                                                "sense_id": "e1bd398f-7c02-396e-bb3e-8464238ddd0c",
                                                "text": "Отец Кабани вдруг громко и трезво сказал: «Благородный дон Рэба! Гиена вы, вот и все»."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a5e18261-3e37-32ef-a275-175e83d59459",
                                        "entry_id": "6882dcf5-2954-3c77-b417-c793eb49a294",
                                        "glosses": [
                                            "соблюдая трезвость, не выпивая"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c0fd14b-4fb9-46fd-bde6-64a951887cb3",
                                                "sense_id": "a5e18261-3e37-32ef-a275-175e83d59459",
                                                "text": "Вместо того, чтобы быть образцами честного жития, — вы стали наставниками всякого бесчиния, соблазном для верных и неверных, объедаетесь, упиваетесь, друг другу досаждаете; во дни божественных праздников моих, вместо того чтобы вести себя трезво и благочинно, показывать другим пример, вы предаетесь пьянству и бесчинству."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "25d19c72-b314-3208-a108-2dcab4f2d719",
                                        "entry_id": "6882dcf5-2954-3c77-b417-c793eb49a294",
                                        "glosses": [
                                            "здраво, рассудительно"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d4d02a2-45e5-4279-bd27-c9a83b35f665",
                                                "sense_id": "25d19c72-b314-3208-a108-2dcab4f2d719",
                                                "text": "Сейчас заварю чайку покрепче, сяду на кухне, Калям вспрыгнет мне на колени, я буду гладить его, прихлёбывать чай и попробую наконец трезво и спокойно все это продумать."
                                            },
                                            {
                                                "example_id": "6dc0a085-70f4-4486-8771-05230d9eb133",
                                                "sense_id": "25d19c72-b314-3208-a108-2dcab4f2d719",
                                                "text": "Во-первых, я совершенно трезво отдаю себе отчёт в том, что не идти вперёд — значит идти назад."
                                            },
                                            {
                                                "example_id": "f27caf72-4fb0-4acb-a9ae-d9076ee951f6",
                                                "sense_id": "25d19c72-b314-3208-a108-2dcab4f2d719",
                                                "text": "А потом эта тишина делается такая глубокая, что в ней начинает рождаться возможность что-то сказать; и тогда говоришь осторожно, трезво, немногоречиво, тихо, и каждое слово выбираешь так, чтобы в нём была правда и чтобы оно не разбивало эту Богом данную тишину."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
