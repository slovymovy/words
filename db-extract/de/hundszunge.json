                        "cross_references": [
                            {
                                "target_word": "witch",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e5c7105f-a26a-39d3-99c5-28a6f13d61d0",
                                        "entry_id": "a1330e26-16e4-3205-afcb-d703eaabcba5",
                                        "glosses": [
                                            "A person (now usually particularly a woman) who uses magical or similar supernatural powers to influence or predict events."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9dd78377-09fd-4ae3-8418-fcda4b892ecc",
                                                "sense_id": "e5c7105f-a26a-39d3-99c5-28a6f13d61d0",
                                                "text": "He cannot abide the old woman of Brentford; he swears she's a witch."
                                            },
                                            {
                                                "example_id": "74618e99-4e91-47f3-be20-41f8890331b5",
                                                "sense_id": "e5c7105f-a26a-39d3-99c5-28a6f13d61d0",
                                                "text": "It was easy to understand that they were witches, who had turned themselves into ravens."
                                            },
                                            {
                                                "example_id": "91354c5d-eef7-4a01-8ec1-57832fd0ddbf",
                                                "sense_id": "e5c7105f-a26a-39d3-99c5-28a6f13d61d0",
                                                "text": "However, the word \"witch\" came to be applied almost exclusively to women who were believed to achieve their power by making a blood pact with the Devil, sealed with their blood. They were usually old and ugly, and for this reason many unfortunate old ladies, whose only crimes were loneliness and a lack of beauty, went to the stake."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b83b8936-a954-3c57-bbe3-30f16d8ba562",
                                        "entry_id": "a1330e26-16e4-3205-afcb-d703eaabcba5",
                                        "glosses": [
                                            "A woman who follows Wicca or similar New Age pagan beliefs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "291490b4-3204-44e3-93d6-0efb0d2af37d",
                                                "sense_id": "b83b8936-a954-3c57-bbe3-30f16d8ba562",
                                                "text": "To be considered a Witch of a particular tradition you will have to be initiated into that tradition by someone else within that tradition, after following their specific program of study."
                                            },
                                            {
                                                "example_id": "e5ca1ff2-162d-4fa9-857a-b7401d63cb4b",
                                                "sense_id": "b83b8936-a954-3c57-bbe3-30f16d8ba562",
                                                "text": "For many neopagan witch traditions the moon is seen as both a symbol of the Goddess and of the witch's power, symbolically, and the belief is that the full moon is the best time for all acts of magic."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "727c75a7-5d3f-3b10-b83d-2e497de1f32e",
                                        "entry_id": "a1330e26-16e4-3205-afcb-d703eaabcba5",
                                        "glosses": [
                                            "An ugly or unpleasant woman."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4c589f1b-af81-4e11-a139-60b0399c38d7",
                                                "sense_id": "727c75a7-5d3f-3b10-b83d-2e497de1f32e",
                                                "text": "I hate that old witch."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "68e86b5f-f25b-3c2d-affa-928082b516ad",
                                        "entry_id": "a1330e26-16e4-3205-afcb-d703eaabcba5",
                                        "glosses": [
                                            "One who exercises more-than-common power of attraction; a charming or bewitching person."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9559fbb0-2f00-38bb-ab0c-e93dbfd27e71",
                                        "entry_id": "a1330e26-16e4-3205-afcb-d703eaabcba5",
                                        "glosses": [
                                            "One given to mischief, especially a woman or child."
                                        ],
                                        "tags": [],
