                ],
                "senses": [
                    {
                        "sense_id": "c513d789-ffdd-36f8-a8c6-ca0a3038ca58",
                        "entry_id": "ed19db2e-051d-38d3-8645-52a55a168eea",
                        "glosses": [
                            "ein farbloses Wirtschaftsglas für hochwertige, oft geschliffene Gebrauchs- und Luxuswaren wie beispielweise Trinkgläser"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2710cd8e-92f0-4e14-886f-83826b2b40a8",
                                "sense_id": "c513d789-ffdd-36f8-a8c6-ca0a3038ca58",
                                "text": "„Nach dem Gesetz zur Kennzeichnung von Bleikristall und Kristallglas vom 25.07.1971 steht Kristallglas für Glas, das Bleioxid […], Bariumoxid […], Kaliumoxid […] oder Zinkoxid […] allein oder zusammen zu mindestens 10% enthält, eine Dichte von mindestens 2,45 g/cm³ und dessen Brechzahl mindestens 1,520 beträgt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "7b82bbd5-2e27-32fb-a188-9630a10348fa",
                        "entry_id": "ed19db2e-051d-38d3-8645-52a55a168eea",
                        "glosses": [
                            "ein Trinkgefäß aus Kristallglas"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a3897713-f865-46a9-ade5-90a806022047",
                                "sense_id": "7b82bbd5-2e27-32fb-a188-9630a10348fa",
                                "text": "Pass' auf, dass keines der teuren Kristallgläser beim Spülen zerbricht."
                            },
                            {
                                "example_id": "ded14981-6fb5-42e7-82f2-a2af27816a35",
                                "sense_id": "7b82bbd5-2e27-32fb-a188-9630a10348fa",
                                "text": "„Vorsichtig halte ich die feinen Kristallgläser an ihrem Stiel, damit keines zerbricht.“"
                            },
                            {
                                "example_id": "dae9524d-ba88-45ac-9349-a64cc8749148",
                                "sense_id": "7b82bbd5-2e27-32fb-a188-9630a10348fa",
                                "text": "„Oberst Débras füllte Kristallgläser.“"
                            },
                            {
                                "example_id": "07918a5e-6791-4e1b-9ebe-3dca8bffb48d",
                                "sense_id": "7b82bbd5-2e27-32fb-a188-9630a10348fa",
                                "text": "„Þórný holte zwei Kristallgläser aus einem großen Glasschrank und befüllte sie zur Hälfte mit Portwein.“"
                            },
                            {
                                "example_id": "ecd0007f-e2e8-4f9f-899b-b3ed331c671a",
                                "sense_id": "7b82bbd5-2e27-32fb-a188-9630a10348fa",
                                "text": "„Sie werden mir zuhause niemals glauben, wenn ich das beschreibe, denkt sie, Kronleuchter, Kristallgläser, Silberbesteck, Rotwein in drei bauchigen Kristallglaskaraffen, und das aufgetragene Essen sieht so verlockend aus und duftet so gut, dass sich der Knoten in Guđriđurs Magen löst und heftiger Vorfreude weicht.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
