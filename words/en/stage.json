                {
                    "sense_id": "11e3c319-2dca-3e30-8d91-5c1c072c5b28",
                    "sense_definition": "An unpaid internship in a restaurant where a cook learns new culinary techniques.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "internship_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He completed a three-month <w>stage</w> at a famous restaurant in Paris.",
                            "target_lang_translations": {
                                "ru": "Он прошел трехмесячную <w>стажировку</w> в известном ресторане в Париже.",
                                "tr": "Paris'teki ünlü bir restoranda üç aylık bir <w>staj</w> tamamladı.",
                                "zh": "他在巴黎一家著名的餐厅完成了为期三个月的<w>实习</w>。"
                            }
                        },
                        {
                            "text": "During his <w>stage</w>, the young chef learned how to prepare complex sauces.",
                            "target_lang_translations": {
                                "ru": "Во время своей <w>стажировки</w> молодой повар научился готовить сложные соусы.",
                                "tr": "<w>Stajı</w> sırasında genç şef karmaşık sosları hazırlamayı öğrendi.",
                                "zh": "在<w>实习</w>期间，这位年轻的厨师学会了如何制作复杂的酱汁。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "culinary jargon"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Неоплачиваемая стажировка в ресторане для обучения повара новым кулинарным техникам.",
                        "tr": "Bir aşçının yeni mutfak teknikleri öğrendiği, bir restorandaki ücretsiz staj.",
