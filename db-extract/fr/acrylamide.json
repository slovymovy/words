                "senses": [
                    {
                        "sense_id": "9946c546-6ae2-3d8c-9a6a-3f1fd6f98860",
                        "entry_id": "284c26ab-a169-3f76-ba16-75b47e16f411",
                        "glosses": [
                            "Amide de formule semi-développée CH₂-CO-NH₂."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d92200e0-4326-4d39-809d-632794b0d151",
                                "sense_id": "9946c546-6ae2-3d8c-9a6a-3f1fd6f98860",
                                "text": "L'acrylamide peut apparaître lors de la cuisson à plus de 120 °C (friture, rôtissage) d'aliments riches en amidon ou en sucres et présente un risque pour la santé humaine."
                            },
                            {
                                "example_id": "4eb6e595-e455-41dc-a2d0-a35ee039dea4",
                                "sense_id": "9946c546-6ae2-3d8c-9a6a-3f1fd6f98860",
                                "text": "L'Agence sanitaire européenne s'est mise à réévaluer les risques liés à l'acrylamide ingérée. On en trouve notamment dans les chips, le café, les frites, les biscuits, les crackers, les céréales du petit déjeuner, les nuggets..., dont il faut de toute façon limiter la consommation."
                            },
                            {
                                "example_id": "0bd2aa83-c235-4bad-bc9a-5da926be9711",
                                "sense_id": "9946c546-6ae2-3d8c-9a6a-3f1fd6f98860",
                                "text": "Des études ont aussi suggéré que l’acrylamide serait neurotoxique et reprotoxique."
                            },
                            {
                                "example_id": "fdc78ee5-5e3e-4063-91b3-de0ed7bdbffd",
                                "sense_id": "9946c546-6ae2-3d8c-9a6a-3f1fd6f98860",
                                "text": "Selon la réaction classique, le chlorure d’acryle, traité par l’ammoniaque ou les ammoniaques composés, donne l’acrylamide ou les acrylamides substituées."
                            }
                        ]
                    }
                ],
