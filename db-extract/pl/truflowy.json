                "senses": [
                    {
                        "sense_id": "c079f143-753c-399c-9739-c316fc87e3f1",
                        "entry_id": "a09b7af4-7ece-3654-812e-5ac604d70dfa",
                        "glosses": [
                            "związany z truflą"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f6c2e332-61ba-4072-a868-bdcd1d67ff07",
                                "sense_id": "c079f143-753c-399c-9739-c316fc87e3f1",
                                "text": "Proszę, podaj mi ze dwie czekoladki truflowe z zielonego pudełeczka."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "38bd34f5-108b-40a2-8baf-77824d2ece68",
                        "source_entry_id": "a09b7af4-7ece-3654-812e-5ac604d70dfa",
                        "source_sense_id": "c079f143-753c-399c-9739-c316fc87e3f1",
                        "target_lang_word": "truffle",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "truffle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0ce59b1e-8b41-3fac-ae2c-589c2c8dc6c4",
                                        "entry_id": "701b9a46-7f7e-3d26-9c44-dca898ebb054",
                                        "glosses": [
                                            "Any of various edible fungi, of the genus Tuber, that grow in the soil in southern Europe; the earthnut."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f1559cd-926e-4c97-827f-b5a8b9f5ed5a",
                                                "sense_id": "0ce59b1e-8b41-3fac-ae2c-589c2c8dc6c4",
                                                "text": "In ancient times, the Romans imported truffles, credited with marked aphrodisiac virtue, from Libya as well as Greece."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "704fd5c4-f5b8-32de-80a8-0420c6baa756",
                                        "entry_id": "701b9a46-7f7e-3d26-9c44-dca898ebb054",
                                        "glosses": [
                                            "Ellipsis of chocolate truffle (“creamy chocolate confection, in the form of a ball, covered with cocoa powder”)."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "85dd576f-e833-4f77-82e8-f04eb1836c6f",
                        "source_entry_id": "a09b7af4-7ece-3654-812e-5ac604d70dfa",
                        "source_sense_id": "c079f143-753c-399c-9739-c316fc87e3f1",
                        "target_lang_word": "truffier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "truffier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "03a90d3e-688d-3aea-91c5-7f1d1ecc6e47",
                                        "entry_id": "af60a9ea-8678-36a6-89b2-b44922390965",
                                        "glosses": [
                                            "Qui a rapport aux truffes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f94897ea-d180-4575-b1ee-22d4bd81f34c",
                                                "sense_id": "03a90d3e-688d-3aea-91c5-7f1d1ecc6e47",
                                                "text": "C'est dans le département de Vaucluse qu'ont été créées les premières cultures en vue de production truffière ; c'est là aussi qu'aurait été faite pour la première fois, par les paysans du Ventoux, l'observation de l'avantage qu'offrent les glands truffiers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8319d833-5f9c-39c8-9068-c2d7c458b9fa",
                                        "entry_id": "af60a9ea-8678-36a6-89b2-b44922390965",
                                        "glosses": [
                                            "Qui produit des truffes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c648bc69-dc6b-4af1-8ace-ebbd5d2f9a0a",
                                                "sense_id": "8319d833-5f9c-39c8-9068-c2d7c458b9fa",
                                                "text": "Puis il désigna une chênaie truffière coupée d'une large bande dévastée, comme foulée de milliers de sabots furieux."
                                            },
                                            {
                                                "example_id": "3e9682aa-fa25-41d8-b3c7-d7d08ecdd5e9",
                                                "sense_id": "8319d833-5f9c-39c8-9068-c2d7c458b9fa",
                                                "text": "Le marché des arbres truffiers (dont les racines ont été mycorhizées, c’est-à-dire plongées dans un bain de fragments de truffes) s’est internationalisé et le même pépiniériste fournit à la fois les marchés italien, français et espagnol. — (« Truffes : Spores à part », Malbouffe, le dico, Les Dossiers du Canard enchaîné nᵒ 147, avril 2018, page 81)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e1289f75-f6fb-3919-8ce3-b7d1e601e93e",
                                        "entry_id": "af60a9ea-8678-36a6-89b2-b44922390965",
                                        "glosses": [
                                            "Qui cherche les truffes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27e53233-e01f-47c0-85c4-60ea065b3ec3",
                                                "sense_id": "e1289f75-f6fb-3919-8ce3-b7d1e601e93e",
                                                "text": "Vous savez ce qu'est un cochon truffier ? C'est un cochon dressé pour détecter les truffes. Tant qu'il en trouve, on est très gentil avec lui. Mais s'il perd son flair, hop! au saloir ! Vous êtes un cochon truffier."
                                            },
                                            {
                                                "example_id": "1d665e95-11b2-4e27-87b5-72abbe08ba1e",
                                                "sense_id": "e1289f75-f6fb-3919-8ce3-b7d1e601e93e",
                                                "text": "La recherche avec le chien n'est pas récente et Louis XV, dit-on, cherchait les truffes de cette façon. Jusqu'en 1960 le dressage du chien truffier était considéré comme un secret transmis de génération en génération."
                                            },
                                            {
                                                "example_id": "34eb416b-7556-47f5-9f63-9f82c742dd65",
                                                "sense_id": "e1289f75-f6fb-3919-8ce3-b7d1e601e93e",
                                                "text": "Le singulier commissaire Laviolette, […], s'installe et enquête dans ce coin si tranquille où Rosalie, la truie truffière d’Alyre Morelon, se met à faire de curieuses embardées et ne déniche pas que des truffes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
