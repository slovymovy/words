                        "examples": [
                            {
                                "example_id": "f92e922b-b033-43e7-8288-bcc73f0551ed",
                                "sense_id": "69bb3a96-b8b5-3436-a839-8d06a27b7701",
                                "text": "„Am Tage, wenn die Leiterwagen über das Pflaster klapperten, schwebte das Geklimper aus dem geöffneten Fenster über den Anger.“"
                            },
                            {
                                "example_id": "ef18cac2-7de3-4b32-9cb2-2b67a8d52045",
                                "sense_id": "69bb3a96-b8b5-3436-a839-8d06a27b7701",
                                "text": "„Doch auch das Geklimper dauerte meist nicht lange.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
