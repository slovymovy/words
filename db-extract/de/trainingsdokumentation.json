                "senses": [
                    {
                        "sense_id": "c323506d-2f09-3048-9ba2-86faed0a29ea",
                        "entry_id": "7f58c059-2b90-3aca-8fdf-83de6c6524cc",
                        "glosses": [
                            "(systematische) Aufzeichnung von Trainingsdaten (Trainingsaktivitäten, -inhalten oder -verläufen)"
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "243fbee5-fdba-48e2-870c-53df34dfa48a",
                                "sense_id": "c323506d-2f09-3048-9ba2-86faed0a29ea",
                                "text": "Damit du alle Inhalte des Buches auch direkt dokumentieren kannst, sind im Anhang des Buches und Online zum Ausdrucken Vorlagen zur Trainingsdokumentation und der Auswertung beigefügt.“"
                            },
                            {
                                "example_id": "b0ff0137-2c7d-465e-a505-a5b0fb055352",
                                "sense_id": "c323506d-2f09-3048-9ba2-86faed0a29ea",
                                "text": "„Das Tagebuch kann nicht nur zur Reit- sondern auch zur Trainingsdokumentation und als Pflege- und Kommunikationsbuch genutzt werden.“"
                            },
                            {
                                "example_id": "199f0980-4503-4730-b29e-175bebd54486",
                                "sense_id": "c323506d-2f09-3048-9ba2-86faed0a29ea",
                                "text": "„Sämtliche Aufzeichnungen, Fehler und Korrekturen werden während der Stunde ganz einfach per USB Stick oder E-Mail zur professionellen und nachhaltigen Trainingsdokumentation an Sie übermittelt.“"
                            },
                            {
                                "example_id": "fde0d4fb-f5f7-4093-a61a-3fda35afbdd7",
                                "sense_id": "c323506d-2f09-3048-9ba2-86faed0a29ea",
                                "text": "„Die folgenden Tipps helfen Ihnen bei der Vorbereitung der Inhalte einer effektiven Trainingsdokumentation – und Ihren Mitarbeitern bei der fehlerfreien Nutzung des ERP Systems.“"
                            },
                            {
                                "example_id": "bcd7e98e-9939-48f6-8260-e9c0c32a0f24",
                                "sense_id": "c323506d-2f09-3048-9ba2-86faed0a29ea",
                                "text": "„Die Einheiten wurden über eine Trainingsdokumentation mit Satz-/Wiederholungszahlen und Trainingsgewichten von den Teilnehmern festgehalten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
