                                                "example_id": "d0cee3de-dab3-4132-9646-f2568e4c7eb0",
                                                "sense_id": "eec36141-4038-3cda-8212-cdfc70392ad2",
                                                "text": "Introducing a foreign species can upset the ecological balance."
                                            },
                                            {
                                                "example_id": "015ba906-63cb-49de-b0c8-a306c2837dc9",
                                                "sense_id": "eec36141-4038-3cda-8212-cdfc70392ad2",
                                                "text": "The fatty meat upset his stomach."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "208bcaa7-e1e3-3447-8e16-c78c8fb455a0",
                                        "entry_id": "6807df98-b533-373e-b311-c139f87f02b3",
                                        "glosses": [
                                            "To tip or overturn (something)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b507f4dc-c8ca-4252-873d-f0d95723f8d2",
                                                "sense_id": "208bcaa7-e1e3-3447-8e16-c78c8fb455a0",
                                                "text": "1924, W. D. Ross translator, Aristitle, Metaphysics, Book 1, Part 9, The Classical Library, Nashotah, Wisconsin, 2001.\nBut this argument, which first Anaxagoras and later Eudoxus and certain others used, is very easily upset; for it is not difficult to collect many insuperable objections to such a view."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cca4b445-9851-3e02-9e14-ec9463c0a916",
                                        "entry_id": "6807df98-b533-373e-b311-c139f87f02b3",
                                        "glosses": [
                                            "To defeat unexpectedly."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a2f19cbb-5e22-4d15-9385-639de3416dbb",
                                                "sense_id": "cca4b445-9851-3e02-9e14-ec9463c0a916",
                                                "text": "Truman upset Dewey in the 1948 US presidential election."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5947b0cc-2975-3bb4-bed9-d71f167b2514",
                                        "entry_id": "6807df98-b533-373e-b311-c139f87f02b3",
                                        "glosses": [
                                            "To be upset or knocked over."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "05bea4f8-26c3-4348-8aea-2f147497d310",
                                                "sense_id": "5947b0cc-2975-3bb4-bed9-d71f167b2514",
                                                "text": "The carriage upset when the horse bolted."
                                            },
                                            {
                                                "example_id": "882543f2-83fe-4b80-a32f-30a08c9da9de",
                                                "sense_id": "5947b0cc-2975-3bb4-bed9-d71f167b2514",
                                                "text": "[T]he locomotive exploded and upset, and was completely wrecked."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "06424229-da8f-3ff1-a356-0e0e1f3140d4",
                                        "entry_id": "6807df98-b533-373e-b311-c139f87f02b3",
                                        "glosses": [
                                            "To set up; to put upright."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d20fea0a-4b7e-4109-b964-0bd39cbd7039",
                                                "sense_id": "06424229-da8f-3ff1-a356-0e0e1f3140d4",
                                                "text": "R. of Brunne\nwith sail on mast upset"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7a15db95-bf6f-30bc-a850-ada6bad28853",
                                        "entry_id": "6807df98-b533-373e-b311-c139f87f02b3",
                                        "glosses": [
                                            "To thicken and shorten, as a heated piece of iron, by hammering on the end."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f9bf20cd-3f61-3ef1-92fb-45910f363bb1",
                                        "entry_id": "6807df98-b533-373e-b311-c139f87f02b3",
                                        "glosses": [
                                            "To shorten (a tire) in the process of resetting, originally by cutting it and hammering on the ends."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8b3a2ab7-fb8c-3459-8c28-52c9bb6104bc",
                                        "entry_id": "6807df98-b533-373e-b311-c139f87f02b3",
                                        "glosses": [
                                            "To support with an upset (type of woven row)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c6517e78-9e7b-493d-a9b7-9d1591da1b4a",
                                                "sense_id": "8b3a2ab7-fb8c-3459-8c28-52c9bb6104bc",
                                                "text": "Very coarse work is sided up without an upsett, or is upsetted with a pair instead of a wale."
                                            }
