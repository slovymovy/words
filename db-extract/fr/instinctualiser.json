                "senses": [
                    {
                        "sense_id": "dc57bacc-755e-3ac9-9ce9-e3bdf2718f71",
                        "entry_id": "062009fb-cc8c-348c-933d-4acc2e91ee3a",
                        "glosses": [
                            "Donner un caractère instinctuel à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bec0d202-3b62-41e5-a46b-a7aac30f3262",
                                "sense_id": "dc57bacc-755e-3ac9-9ce9-e3bdf2718f71",
                                "text": "De que l'humanité, qui en entreprenant son existence se voit en train de la rationaliser (au lieu de l'instinctualiser), c'est son sort qui se dessine (destine !) et qui ne fait que changer son apparence (c’est ce qui apparait ! or, qu’en ce faisant c’et le réel qui change)."
                            },
                            {
                                "example_id": "b98a1ff7-a2d5-4d54-8665-d0dea692432a",
                                "sense_id": "dc57bacc-755e-3ac9-9ce9-e3bdf2718f71",
                                "text": "Il ne réussit sans doute qu'à rationaliser ses sentiments pour aboutir à instinctualiser sa raison."
                            },
                            {
                                "example_id": "60bfd7e2-2712-4f2d-9cb7-395c745b292a",
                                "sense_id": "dc57bacc-755e-3ac9-9ce9-e3bdf2718f71",
                                "text": "Instinctualiser et ne plus penser."
                            }
                        ]
                    }
                ],
