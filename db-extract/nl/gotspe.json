                    {
                        "sense_id": "3cd7c9fe-8b3b-3e38-9641-eb9f92f040e0",
                        "entry_id": "c3775477-9e07-368d-b04d-67850c0fbb6f",
                        "glosses": [
                            "bijzonder grote brutaliteit"
                        ],
                        "tags": [
