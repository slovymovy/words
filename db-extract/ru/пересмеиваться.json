                        "examples": [
                            {
                                "example_id": "42439335-8cd4-409f-81e8-25ac4030f3cf",
                                "sense_id": "95a70bcb-a7b3-31d2-abfe-008e55560651",
                                "text": "Потом супруги Субочевы опять что-нибудь читали, или пересмеивались с карлицей Пуфкой, или пели вдвоем старинные романсы (голоса у них были совершенно одинакие, высокие, слабые, несколько дрожащие и хриплые — особенно после сна, — но не лишенные приятности), или, наконец, играли в карты, но тоже все в старинные игры: в кребс, в ламуш или даже в бостон сампрандер!"
                            }
                        ]
                    }
