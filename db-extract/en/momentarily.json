{
    "word": "momentarily",
    "lang_code": "en",
    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "7ec917b4-5a6f-316e-a7ec-5f897804bef9",
                "word": "momentarily",
                "pos": "adv",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "35bd044b-0d3a-350e-89a3-6d058ff57900",
                        "entry_id": "7ec917b4-5a6f-316e-a7ec-5f897804bef9",
                        "glosses": [
                            "In a momentary manner; for a moment or instant."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "81c9a1d9-beaa-4f6b-9a56-d69b36c1a792",
                                "sense_id": "35bd044b-0d3a-350e-89a3-6d058ff57900",
                                "text": "I imagined momentarily that it was four score and seven years ago, that I had just been brought forth from my mother[…]"
                            },
                            {
                                "example_id": "f10d2760-7949-4d58-9887-abaf8c2d01f6",
                                "sense_id": "35bd044b-0d3a-350e-89a3-6d058ff57900",
                                "text": "The numbers thin out the further we get from London, so I don't feel guilty when I remove my mask momentarily to scoff some of the snacks I'd bought at Marylebone."
                            }
                        ]
                    },
                    {
                        "sense_id": "cf257a63-22ff-3217-bb23-8b41d292d6a6",
                        "entry_id": "7ec917b4-5a6f-316e-a7ec-5f897804bef9",
                        "glosses": [
                            "In a moment or very soon; any minute now, any time now."
                        ],
                        "tags": [
                            "US",
                            "not-comparable",
                            "proscribed"
                        ],
                        "examples": [
                            {
                                "example_id": "2b256458-4a4d-4c4c-97dc-993a3ff92442",
                                "sense_id": "cf257a63-22ff-3217-bb23-8b41d292d6a6",
                                "text": "The system will restart momentarily."
                            },
                            {
                                "example_id": "939d3a26-ac2b-4eec-8207-3d397c1bf94f",
                                "sense_id": "cf257a63-22ff-3217-bb23-8b41d292d6a6",
                                "text": "He told me, further, that the second coming was at hand--was looked for momentarily in Jerusalem."
                            }
                        ]
                    },
                    {
                        "sense_id": "b30611a6-ea1a-30bc-addb-b4844b6f5839",
                        "entry_id": "7ec917b4-5a6f-316e-a7ec-5f897804bef9",
                        "glosses": [
                            "Progressively; moment by moment."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2a741ccd-bdf6-4eb1-bf93-930734c4304c",
                        "source_entry_id": "7ec917b4-5a6f-316e-a7ec-5f897804bef9",
                        "source_sense_description": "In a momentary manner",
                        "target_lang_word": "even",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "even",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "a4b7bd46-1765-39e2-becc-73b7dfbfe096",
                                        "entry_id": "503a3302-99d5-33cf-8261-f4c9b0597557",
                                        "glosses": [
                                            "deelbaar door twee (d.w.z. met een ander rond [3] getal als uitkomst)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c389ae5c-731a-477c-af9a-70326a8a9c48",
                                                "sense_id": "a4b7bd46-1765-39e2-becc-73b7dfbfe096",
                                                "text": "De som van twee even getallen is weer een even getal."
                                            },
                                            {
                                                "example_id": "56c77b2e-ddbf-428e-adb1-36f10749123b",
                                                "sense_id": "a4b7bd46-1765-39e2-becc-73b7dfbfe096",
                                                "text": "Een even aantal kun je in twee even grote delen verdelen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "40141f4a-1a54-3c15-8ff1-0c6e732312f9",
                                        "entry_id": "503a3302-99d5-33cf-8261-f4c9b0597557",
                                        "glosses": [
                                            "egaal, effen, gelijk"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ecdbfb3a-a635-4d37-83b4-5325b177e899",
                                                "sense_id": "40141f4a-1a54-3c15-8ff1-0c6e732312f9",
                                                "text": "Je kunt alleen bouwen als de grond even is."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "even",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "0ef26254-a5e8-35de-9d2c-0cb1ff25a90b",
                                        "entry_id": "c21c674b-de4b-3ea6-ac31-ddd6c01bbadd",
                                        "glosses": [
                                            "zonder moeite of met slechts weinig moeite"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f476960b-c8b1-44ec-aa35-b8133ca95f75",
                                                "sense_id": "0ef26254-a5e8-35de-9d2c-0cb1ff25a90b",
                                                "text": "Zet de stoel even recht."
                                            },
                                            {
                                                "example_id": "f1580f79-8e41-484a-adca-5c6013ea97b4",
                                                "sense_id": "0ef26254-a5e8-35de-9d2c-0cb1ff25a90b",
                                                "text": "Ik heb die spelfout even verbeterd."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "683f90cd-2200-3d5d-a925-ffb2f0fb6a67",
                                        "entry_id": "c21c674b-de4b-3ea6-ac31-ddd6c01bbadd",
                                        "glosses": [
                                            "in korte tijd"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d8c786e-6cde-492f-b643-727d13faa30f",
                                                "sense_id": "683f90cd-2200-3d5d-a925-ffb2f0fb6a67",
                                                "text": "Ik zou nou toch nog maar wel eens even goed nadenken!"
                                            },
                                            {
                                                "example_id": "e10683ae-19a0-4a60-83e7-1d8b3e41c7fc",
                                                "sense_id": "683f90cd-2200-3d5d-a925-ffb2f0fb6a67",
                                                "text": "Het puntje van haar sigaret knetterde even tot de tabak knisperend in blauwe rookkringels veranderde."
                                            },
                                            {
                                                "example_id": "a3252fad-a973-406c-af7a-df1f088dadc0",
                                                "sense_id": "683f90cd-2200-3d5d-a925-ffb2f0fb6a67",
                                                "text": "\"Dat wordt straks wel even wennen\", zegt machinist Jos van der Veen tegen RTV Noord. Hij had gisteravond zijn laatste rit naar het \"oude hoofdstation\"\". \"Ik vind het mooi om een stukje spoorweggeschiedenis mee te maken, zowel aan het einde van iets of het begin van iets. Nu mag ik het einde meemaken, hartstikke leuk.\""
                                            },
                                            {
                                                "example_id": "7828567c-3bb6-4a3f-8c86-cf660abee5be",
                                                "sense_id": "683f90cd-2200-3d5d-a925-ffb2f0fb6a67",
                                                "text": "Net als de mogelijkheid om tijdelijk afstand te nemen van de constante druk in Amsterdam en even helemaal te doen waar ik zelf zin in had."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "42463b88-9f17-3899-9358-3f3ee6012acd",
                                        "entry_id": "c21c674b-de4b-3ea6-ac31-ddd6c01bbadd",
                                        "glosses": [
                                            "in dezelfde, gelijke mate"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82acb02a-e997-4138-8d93-10e22e1185e1",
                                                "sense_id": "42463b88-9f17-3899-9358-3f3ee6012acd",
                                                "text": "Dat is even goed."
                                            },
                                            {
                                                "example_id": "98a0aba2-c333-4690-adf4-3630d2cbf5f5",
                                                "sense_id": "42463b88-9f17-3899-9358-3f3ee6012acd",
                                                "text": "Deze fabrikanten proberen elkaar flink af te troeven. \"Er is echt een innovatie-oorlog gaande. Omdat er nu zo veel concurrentie is, probeert iedereen nieuwe functies in een auto te stoppen\", zegt Van Dillen. Niet elke innovatie is volgens hem even geslaagd. \"Veel van de nieuwe Chinese auto's hebben een waslijst aan innovaties waar mensen waarschijnlijk niet veel van zullen gebruiken.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "758d5239-b41f-3ca4-94d1-5582ee9930a5",
                                        "entry_id": "c21c674b-de4b-3ea6-ac31-ddd6c01bbadd",
                                        "glosses": [
                                            "een klein eindje"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7e4ee63f-93d9-39f1-a133-1025d42e3cb4",
                                        "entry_id": "c21c674b-de4b-3ea6-ac31-ddd6c01bbadd",
                                        "glosses": [
                                            "amper, net, ternauwernood"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5b2d5bc-28ec-4ba8-8da7-d56187851aa0",
                                                "sense_id": "7e4ee63f-93d9-39f1-a133-1025d42e3cb4",
                                                "text": "Hij was een man van even dertig jaar."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5b88cf0d-f47a-3f99-96bb-70155432b011",
                                        "entry_id": "c21c674b-de4b-3ea6-ac31-ddd6c01bbadd",
                                        "glosses": [
                                            "versterkende toevoeging"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b5b193d-d78f-463c-b19f-eea9dfb4387f",
                                                "sense_id": "5b88cf0d-f47a-3f99-96bb-70155432b011",
                                                "text": "Valt dat even mee!"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "even",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "dc35f3b4-a18d-3ba1-99eb-93d24df4bfa6",
                                        "entry_id": "4ad1655b-ad33-361f-8b13-69ff464d57e9",
                                        "glosses": [
