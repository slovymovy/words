                        "glosses": [
                            "Relatif aux sinogrammes ; utilisant des sinogrammes."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "b8825d07-2821-47ee-b2b4-e1b484097420",
                                "sense_id": "1613e352-b2c6-36ac-bb19-c690401bffe0",
                                "text": "Le coréen s’est écrit pendant quinze siècles à l’aide de sinogrammes, ou, plus exactement, l’écrit était sinogrammatique, quelque langue qu’il essaye de transcrire."
                            },
                            {
                                "example_id": "ffcdc300-0dd7-4a8f-add8-1bf72dd31947",
                                "sense_id": "1613e352-b2c6-36ac-bb19-c690401bffe0",
                                "text": "L’écriture chinoise, si l’on prend cet exemple, n’est pas plus concrète que la nôtre : si elle a été au départ composée de pictogrammes (des dessins figuratifs stylisés), elle est vite devenue idéogrammatique ou mieux sinogrammatique (c’est-à-dire composée de sinogrammes, qui sont les unités de l’écriture logographique chinoise)."
                            }
                        ]
                    }
