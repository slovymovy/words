                        "entry_id": "e084f080-3018-3303-a389-8b345178af57",
                        "tags": [
                            "adverbial",
                            "participle",
                            "past"
                        ],
                        "form": "возведя́сь"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "968690f6-33ce-3852-a898-d3add5480fb8",
                        "entry_id": "e084f080-3018-3303-a389-8b345178af57",
                        "glosses": [
                            "приобрести особое значение; приравняться к чему-либо, подняться до уровня чего-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66060aa8-81fe-46f0-8239-a208ffbfdfa0",
                                "sense_id": "968690f6-33ce-3852-a898-d3add5480fb8",
                                "text": "Но что будет, если состояние отказа от личной жизни (смерть души) возведётся в принцип бытия, сделается обязательным."
                            },
                            {
                                "example_id": "8acc3d6f-34f4-4514-ba2c-2bd98c920bcf",
                                "sense_id": "968690f6-33ce-3852-a898-d3add5480fb8",
                                "text": "После потрясений прежней эпохи спокойствие и лояльность, граничащие с апатией, возвелись в главную общественную добродетель; несоответствие общепринятому стандарту вызывало опасения и порицалось."
                            }
                        ]
                    },
                    {
                        "sense_id": "d3be2237-716d-34db-bfd2-6d91d2411a1f",
                        "entry_id": "e084f080-3018-3303-a389-8b345178af57",
                        "glosses": [
                            "страд. к возводить"
                        ],
                        "tags": [
                            "passive"
                        ],
                        "examples": [
                            {
                                "example_id": "86db87fe-2f0f-4ad4-a064-da21e4cac052",
                                "sense_id": "d3be2237-716d-34db-bfd2-6d91d2411a1f",
                                "text": "И в невиданные, в общем, сроки лопатно-грабарским способом возвелись по окраинам Яминска один за другим всамделишные заводы-гиганты."
                            }
                        ]
                    }
                ],
