                                                "sense_id": "2b9ecca7-27cf-37c9-91a3-c650ad5916fe",
                                                "text": "Wenn man sich beim Blasen Zeit läßt, wird die Glaskugel schön rund."
                                            },
                                            {
                                                "example_id": "80f80012-bce7-4a80-bdce-08659580da0c",
                                                "sense_id": "2b9ecca7-27cf-37c9-91a3-c650ad5916fe",
                                                "text": "Es gibt Laubsauger zum Saugen und Laubläser zum Blasen."
                                            },
                                            {
                                                "example_id": "f6893936-c2f2-4696-992f-3a07d9773c42",
                                                "sense_id": "2b9ecca7-27cf-37c9-91a3-c650ad5916fe",
                                                "text": "Beim Blasen eines Sand-Luft-Gemisches und Schießen wird der Formstoff pneumatisch beschleunigt und während des Aufpralls verdichtet."
                                            },
                                            {
                                                "example_id": "01b2f60a-0111-48f9-b6c2-a2aa21a90bbd",
                                                "sense_id": "2b9ecca7-27cf-37c9-91a3-c650ad5916fe",
                                                "text": "Das Blasen und Heulen des Sturmes währte die ganze Nacht."
                                            }
                                        ],
