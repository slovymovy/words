                                "example_id": "2661463a-f7df-487a-8427-cb5424fd472c",
                                "sense_id": "5391990f-d5e0-34dd-b791-7be466bd70ae",
                                "text": "' Terwijl hij voor de muur van zijn partiële amnesie stond, bedacht Schaller dat Susanne vast en zeker precies de vrouw was die hij graag in dit huis had aangetroffen."
                            }
                        ]
                    }
