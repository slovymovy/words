                                "target_senses": [
                                    {
                                        "sense_id": "0d30dee4-9d73-32a2-840f-348b361e52e0",
                                        "entry_id": "bb5ae266-3e20-356e-a2d2-4bedda1c4d3d",
                                        "glosses": [
                                            "A Christian sacrament, by which one is received into a church and sometimes given a name, generally involving the candidate to be anointed with or submerged in water."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e60fa22e-5809-458a-9b71-3f1a11f1e15a",
                                                "sense_id": "0d30dee4-9d73-32a2-840f-348b361e52e0",
                                                "text": "The child’s baptism was held at the old church."
                                            },
                                            {
                                                "example_id": "26c9ec22-52f9-4dfb-8097-634060f34932",
                                                "sense_id": "0d30dee4-9d73-32a2-840f-348b361e52e0",
                                                "text": "The ceremony of baptism symbolizes spiritual rebirth."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "80ea9a69-6007-3ba0-817b-ecaf27c5cd8b",
