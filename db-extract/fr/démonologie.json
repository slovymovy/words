        "fr-extract.jsonl": [
            {
                "entry_id": "92d7006e-751f-3d31-8e57-9a2651256259",
                "word": "démonologie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "02a5a408-d9f0-4760-88b3-d326cb48a7e5",
                        "entry_id": "92d7006e-751f-3d31-8e57-9a2651256259",
                        "tags": [
                            "plural"
                        ],
                        "form": "démonologies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "edff9747-c17d-3d3f-8ede-e2a0b0f47ac1",
                        "entry_id": "92d7006e-751f-3d31-8e57-9a2651256259",
                        "glosses": [
                            "Science ayant trait au démon, aux démons."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9974e8ae-b6a6-4bc4-adeb-c390da351f3e",
                                "sense_id": "edff9747-c17d-3d3f-8ede-e2a0b0f47ac1",
                                "text": "Nous devions avoir encore un autre ami à moi, […], qui tient tête à la fois à Alliette sur la cartomancie, à Moulle sur la démonologie, au chevalier Lenoir sur les antiquités ; […]"
                            },
                            {
                                "example_id": "3e8f387e-1d61-4604-821c-c8ca6ddea090",
                                "sense_id": "edff9747-c17d-3d3f-8ede-e2a0b0f47ac1",
                                "text": "De là vinrent la démonologie, l’astrologie judiciaire, la sorcellerie, enfin toutes les divinations fondées sur des accidents essentiellement transitoires, parce qu’ils variaient selon les tempéraments, au gré de circonstances encore complètement inconnues."
                            },
                            {
                                "example_id": "90372dd0-8d48-4059-b709-afa3d6d5dc09",
                                "sense_id": "edff9747-c17d-3d3f-8ede-e2a0b0f47ac1",
                                "text": "En 1659, au milieu de ce XVIIe siècle qui a plus de droits que le Moyen Age à être considéré comme l’âge d’or de la démonologie, Pierre Bieswal et Jean Cleenewerck signent, avec vingt-cinq de leurs collègues, les procès-verbaux de torture et de condamnation à mort d’un sorcier."
                            }
                        ]
                    },
                    {
                        "sense_id": "db41c05e-347c-3716-9c60-c048619c69ac",
                        "entry_id": "92d7006e-751f-3d31-8e57-9a2651256259",
                        "glosses": [
                            "Diabolisation, art de donner une forte connotation négative à une situation, une idée…"
                        ],
                        "tags": [
                            "broadly",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "3ff73ac7-0926-4493-b752-ff644b7beae9",
                                "sense_id": "db41c05e-347c-3716-9c60-c048619c69ac",
                                "text": "La gauche et l'extrême gauche voudraient rejeter le Front National dans les ténèbres. Elles ont substitué la démonologie à la discussion politique."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b4fcb77f-099b-44ac-b85a-6d43e45fd21f",
                        "source_entry_id": "92d7006e-751f-3d31-8e57-9a2651256259",
                        "target_lang_word": "demonology",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "demonology",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c39bd16f-8395-32c8-ace3-0ee41020dc62",
                                        "entry_id": "735eb0cf-b363-308a-9490-ad24599da030",
                                        "glosses": [
                                            "The study of demons, especially the incantations required to summon and control them."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c34be19b-3eea-4b9b-b615-292be483bbc1",
                                                "sense_id": "c39bd16f-8395-32c8-ace3-0ee41020dc62",
                                                "text": "But it wasn't all that strange, because any wizard bright enough to survive for five minutes was also bright enough to realize that if there was any power in demonology, then it lay with the demons."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
