                        "examples": [
                            {
                                "example_id": "cfa76bcc-0829-4509-9a3d-5410ca6f8084",
                                "sense_id": "a5ceb887-aa4a-323b-8c8a-2a6abffd77f4",
                                "text": "Die Dichterin bemerkte: „Das muß sie noch ordinärer bringen. Es sind doch Parvenüs.“ Und Diederich lächelte zustimmend, obwohl er arg betreten war durch diese Zustände in einem Heim, das dem seinen glich."
                            }
                        ]
                    }
