                "senses": [
                    {
                        "sense_id": "1531f0c4-22a3-3ad8-9667-7ec4fcaacd2c",
                        "entry_id": "31181cea-97cc-3657-9ac9-6aa7033f93b2",
                        "glosses": [
                            "Zeitpunkt, zu dem ein Test stattfindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0064ff8e-c8aa-4fb7-bfc7-4719b77a265c",
                                "sense_id": "1531f0c4-22a3-3ad8-9667-7ec4fcaacd2c",
                                "text": "„Ab Anfang kommender Woche sollen diese per Terminbuchungsplattform einen Testtermin in der Nähe ihres Wohnorts buchen können, bundesweit stehen dafür laut Schreiben 100 Teststationen zur Verfügung.“"
                            },
                            {
                                "example_id": "ced087fa-b86d-44e9-860a-7596d55dd222",
                                "sense_id": "1531f0c4-22a3-3ad8-9667-7ec4fcaacd2c",
                                "text": "„Trotz der voraussehbaren Rückzüge von rund einem Fünftel der Bewerbungen vor dem Testtermin ist laut SUK deshalb insbesondere in der Human- und Veterinärmedizin, aber auch in der Zahnmedizin mit einer Überschreitung der Aufnahmekapazitäten zu rechnen.“"
                            },
                            {
                                "example_id": "ceb68842-ed5d-4ae1-a7fa-770f1831ebb8",
                                "sense_id": "1531f0c4-22a3-3ad8-9667-7ec4fcaacd2c",
                                "text": "„Rund 500 Zuschauer konnten vor Ort einen Testtermin buchen, die anderen bekamen Termine andernorts in der Stadt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
