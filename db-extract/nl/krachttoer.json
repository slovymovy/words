                "senses": [
                    {
                        "sense_id": "7de60db7-28e4-33ee-ae5e-a9694299e781",
                        "entry_id": "7a611767-ad9b-3b67-a4cf-738fb945c14f",
                        "glosses": [
                            "een project dat heel veel lichamelijke of geestelijke kracht vereist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1620a6bd-82de-4bad-b7c5-edf0de8113c8",
                                "sense_id": "7de60db7-28e4-33ee-ae5e-a9694299e781",
                                "text": "Het enorme rotsblok aarzelde, wankelde, besloot niet meer terug te vallen, maakte zich los, stortte omlaag, sloeg tegen de helling, wentelde, zoefde door de lucht en sloeg een diep gat in het bladerdak van het oerwoud. Echo's en vogels vlogen op, een wolk van wit en roze stof stoof op, het bos beneden dreunde alsof er een getergd monster voorbijkwam. Toen werd het stil op het eiland. `Joepie!' `Net een bom!' `Jaaa-hoeoeoer Het duurde vijf minuten voor ze zich van hun geslaagde krachttoer konden losrukken. Maar ten slotte gingen ze toch verder."
                            },
                            {
                                "example_id": "67decaeb-a07e-449a-9518-0fd71ebe583b",
                                "sense_id": "7de60db7-28e4-33ee-ae5e-a9694299e781",
                                "text": "Het is makkelijker om 100.000 euro te verdubbelen dan om diezelfde krachttoer met een miljard uit te halen."
                            }
                        ]
                    }
