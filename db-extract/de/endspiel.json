                ],
                "senses": [
                    {
                        "sense_id": "19c5264b-5929-3a2f-9ff3-e4c2c3e7f524",
                        "entry_id": "dd661269-02ed-3eee-bf82-2a5ffe49f87f",
                        "glosses": [
                            "Begegnung zweier Teilnehmer eines Turniers bzw. einer Meisterschaft, in der der Gesamtsieger des Turniers bzw. der Meisterschaft ermittelt wird."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "76146f58-23f8-41b2-ba7b-1ecf17619fa6",
                                "sense_id": "19c5264b-5929-3a2f-9ff3-e4c2c3e7f524",
                                "text": "Gerade die Deutschen, die so oft nach durchwachsenen Turnieren im Endspiel landeten, die 1974 gegen eine bessere Mannschaft siegten und 1990 einen zweifelhaften Elfmeter für den Finalsieg benötigten, müßten solche Mäkeleien der Unterlegenen vertraut klingen. (FAZ.net Der missgönnte Triumph, 03. Januar 2007)"
                            },
                            {
                                "example_id": "ddd87518-336b-4310-99e1-5480203e88c6",
                                "sense_id": "19c5264b-5929-3a2f-9ff3-e4c2c3e7f524",
                                "text": "„Das Endspiel dauerte und dauerte, aber dann kam der Schlußpfiff, und wir waren Weltmeister, zum ersten Mal seit zwanzig Jahren wieder!“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "fbe60e9f-cc9e-34c3-8a4a-cc8e4c2f87db",
                        "entry_id": "dd661269-02ed-3eee-bf82-2a5ffe49f87f",
                        "glosses": [
                            "Endphase in einer Partie Schach"
                        ],
                        "tags": [
                            "Schach"
                        ],
                        "examples": [
                            {
                                "example_id": "3a6fe978-9841-4a1d-94f0-9bb5d85e1941",
                                "sense_id": "fbe60e9f-cc9e-34c3-8a4a-cc8e4c2f87db",
                                "text": "Nach dem frühzeitigen Tausch der Damen ergab sich ein interessantes Endspiel, in dem aber keine Seite zum Erfolg kommen konnte. (Der Tagesspiegel online, Deep Fritz ist nicht zu knacken, 04.12.2006)"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "aabd4911-85e6-3991-ae03-9447326b02d2",
                        "entry_id": "dd661269-02ed-3eee-bf82-2a5ffe49f87f",
                        "glosses": [
                            "Drama von Samuel Beckett: Menschliche Existenz in der Endphase des Verfalls und der vergeblichen Suche nach einem Ausweg"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "325eb79a-9912-48d1-aab3-ec0fa5ace30a",
                                "sense_id": "aabd4911-85e6-3991-ae03-9447326b02d2",
                                "text": "„Versucht man nämlich, Becketts Endspiel ohne metaphysischen Ballast, als Folge bloßer Spielvorgänge zu inszenieren, zählt nur noch eines: die Kraft der Details.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bdca2460-89d7-44a8-95c7-a08e0f47c26b",
                        "source_entry_id": "dd661269-02ed-3eee-bf82-2a5ffe49f87f",
                        "source_sense_id": "19c5264b-5929-3a2f-9ff3-e4c2c3e7f524",
