                    "sense_id": "1fe69e89-f298-3101-897c-7700c8f18a93",
                    "sense_definition": "деепричастие настоящего времени несовершенного вида от глагола <w>родить</w>",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Женщина перенесла операцию, так и не <w>родя</w> ребенка самостоятельно.",
                            "target_lang_translations": {
                                "en": "The woman underwent surgery, without ever <w>giving birth to</w> the child on her own."
                            }
                        },
                        {
                            "text": "Она тяжело страдала, <w>родя</w> первенца в деревенской избе без помощи врача.",
                            "target_lang_translations": {
                                "en": "She suffered greatly, <w>giving birth to</w> her firstborn in a village hut without a doctor's assistance."
                            }
                        }
                    ],
                    "synonyms": [
                        "рожая"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "деепричастие"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "present adverbial participle of the verb 'родить': giving birth to, delivering"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "giving birth",
                                "target_lang_sense_clarification": "adverbial participle, while giving birth"
                            },
                            {
                                "target_lang_word": "delivering",
                                "target_lang_sense_clarification": "adverbial participle, bringing forth a child"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "e0e348e2-ea51-32a6-bb4c-a3ac5d990b04",
                    "sense_definition": "уменьшительно-ласкательная форма мужского имени <w>Родион</w>",
                    "learner_level": "A2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Мать ласково звала сына: «<w>Родя</w>, иди обедать, суп уже на столе».",
                            "target_lang_translations": {
                                "en": "The mother called her son affectionately: '<w>Rodya</w>, come have lunch, the soup is already on the table.'"
                            }
                        },
                        {
                            "text": "В романе Достоевского близкие часто называли Раскольникова просто <w>Родя</w>.",
                            "target_lang_translations": {
                                "en": "In Dostoevsky's novel, loved ones often called Raskolnikov simply <w>Rodya</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "Родион"
                    ],
                    "traits": [
