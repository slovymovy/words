                                        "entry_id": "74537b03-e311-3bcd-a134-ed08c42f5751",
                                        "glosses": [
                                            "Fortpflanzung durch ein Elternpaar, bei dem die beiden Eltern eng miteinander verwandt sind"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "458a0922-c3b9-428a-bf8c-b01f7121163d",
                                                "sense_id": "dc3a9037-d002-3a05-8cc0-ba4917880e28",
                                                "text": "Inzucht hat sich oft als biologisch problematisch erwiesen."
                                            },
                                            {
                                                "example_id": "3829da0f-db9d-40bf-93ca-30f1dc99bf7c",
                                                "sense_id": "dc3a9037-d002-3a05-8cc0-ba4917880e28",
                                                "text": "„Eine weitere Verkleinerung des Genpools könnte langfristig das Risiko für Inzucht und damit verbundene Gesundheitsprobleme erhöhen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7197d7a0-f746-40c9-a1d7-43dac7b87fce",
                        "source_entry_id": "bf4c7a3a-b590-32c9-8c14-b58617f9320f",
