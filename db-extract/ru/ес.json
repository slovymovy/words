                                        "sense_id": "80f0b4e2-fe48-3dd4-8cdd-51c35f2cfc45",
                                        "entry_id": "211a662d-576d-3c12-94fb-4227d8c94a5c",
                                        "glosses": [
                                            "1993 gegründeter europäischer Staatenverbund eigener Prägung mit 27 Mitgliedstaaten und 447 Mio. Einwohnern; größter Binnenmarkt der Welt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed6db18a-4c6f-40ac-a9f8-51c4356fda3f",
                                                "sense_id": "80f0b4e2-fe48-3dd4-8cdd-51c35f2cfc45",
                                                "text": "Früher hieß die Europäische Union „Europäische Gemeinschaft“."
                                            },
                                            {
                                                "example_id": "17f176b9-1ae3-430b-b480-405509792f0f",
                                                "sense_id": "80f0b4e2-fe48-3dd4-8cdd-51c35f2cfc45",
                                                "text": "„In der Europäischen Union sind zurzeit ca. 300 Zusatzstoffe zugelassen, die im Klartext auf der Packung aufgeführt oder durch Angabe der E-Nummern kenntlich gemacht werden müssen.“"
                                            },
                                            {
                                                "example_id": "ab689cd1-854c-4a44-9906-52d8d3a89871",
                                                "sense_id": "80f0b4e2-fe48-3dd4-8cdd-51c35f2cfc45",
                                                "text": "„Heutzutage ist das in der Europäischen Union genauso: Deutschland ist als stärkste Wirtschaftsmacht automatisch die führende Kraft in der Europäischen Union.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
