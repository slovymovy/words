                                "target_senses": [
                                    {
                                        "sense_id": "d3e6ea7d-c9ee-3faa-b2d1-83cc5d1eacb4",
                                        "entry_id": "bee8be0c-da65-3f04-a7f7-705d42fe34f4",
                                        "glosses": [
                                            "mit der Zungenspitze an den Zähnen gebildeter Laut"
                                        ],
                                        "tags": [
                                            "speziell Phonetik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f692063f-0b08-49eb-ad88-9d16d1af1fa2",
                                                "sense_id": "d3e6ea7d-c9ee-3faa-b2d1-83cc5d1eacb4",
                                                "text": "„Wenn der Stamm auf Dentallaut endet, fallen die Flexionsendungen und Personenendungen in der 3. Person Singular und der 2. Person Plural in der Aussprache zusammen - in der Schrift nur bei identischem Schriftzeichen, also tes, das heißt t-Laut.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "15eb8fb2-05b9-4c07-b3db-acef8cf779ca",
                        "source_entry_id": "48d75a90-17d3-3208-b831-5ba9a8a5f561",
                        "source_sense_id": "103e88d9-cd7a-3d77-ac7b-6d96b93f53e7",
                        "target_lang_word": "Zahnlaut",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zahnlaut",
