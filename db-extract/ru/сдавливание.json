                                        "examples": [
                                            {
                                                "example_id": "8648c428-a6d3-405e-bdce-95beb29bb53c",
                                                "sense_id": "9e7bb125-139c-3b75-b267-079b9116d8ab",
                                                "text": "L’huile d’olive est obtenue par le pressage d’olives."
                                            },
                                            {
                                                "example_id": "1550bf53-076c-44f7-864c-70af37063998",
                                                "sense_id": "9e7bb125-139c-3b75-b267-079b9116d8ab",
                                                "text": "Oui, le pressage du miel reste possible, mais il est très mal adapté à l’apiculture moderne."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
