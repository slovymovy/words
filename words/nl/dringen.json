    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "99810454-0994-3eda-8b92-ebe239b81ad1",
                    "sense_definition": "weinig tijd of ruimte beschikbaar hebben; spoed vereisen",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "tijd_en_spoed",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We moeten nu echt een beslissing nemen, want de tijd <w>dringt</w> enorm.",
                            "target_lang_translations": {
                                "en": "We really need to make a decision now, because time is <w>pressing</w>."
                            }
                        },
                        {
                            "text": "De deadline komt dichterbij en de tijd <w>dringt</w> voor het hele team.",
                            "target_lang_translations": {
                                "en": "The deadline is approaching and time is <w>running out</w> for the whole team."
                            }
                        }
                    ],
                    "common_phrases": [
                        "de tijd dringt"
                    ],
                    "target_lang_definitions": {
                        "en": "to have little time or space available; to be urgent"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "be pressing",
                                "target_lang_sense_clarification": "of time or a situation"
                            },
                            {
                                "target_lang_word": "be urgent",
                                "target_lang_sense_clarification": "requiring immediate action"
                            },
                            {
                                "target_lang_word": "run out",
                                "target_lang_sense_clarification": "of time"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dbb1f63f-ef3b-3a8e-afc6-1238b4c5f7be",
                    "sense_definition": "met het lichaam tegen anderen duwen om vooruit te komen in een menigte",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "fysiek_duwen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De menigte begon te <w>dringen</w> en dit leidde tot een gevaarlijke toestand bij de ingang.",
                            "target_lang_translations": {
                                "en": "The crowd began to <w>push</w> and this led to a dangerous situation at the entrance."
                            }
                        },
                        {
                            "text": "Niet <w>dringen</w> in de rij, iedereen komt uiteindelijk wel aan de beurt.",
                            "target_lang_translations": {
                                "en": "Don't <w>jostle</w> in the queue; everyone will get their turn eventually."
                            }
                        }
                    ],
                    "synonyms": [
                        "persen"
                    ],
                    "common_phrases": [
                        "niet dringen"
                    ],
                    "target_lang_definitions": {
                        "en": "to push with the body against others to move forward in a crowd"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "crowd",
                                "target_lang_sense_clarification": "to press forward by pushing"
                            },
                            {
                                "target_lang_word": "push",
                                "target_lang_sense_clarification": "to shove in a group"
                            },
                            {
                                "target_lang_word": "jostle",
                                "target_lang_sense_clarification": "to push roughly in a crowd"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ebb29ffa-ef15-35bf-8543-5c900edad12b",
                    "sense_definition": "met klem verzoeken of ergens op blijven staan",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "verzoeken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De oppositie blijft <w>dringen</w> op een snelle verklaring van de minister.",
                            "target_lang_translations": {
                                "en": "The opposition continues to <w>press</w> for a quick explanation from the minister."
                            }
                        },
                        {
                            "text": "Zij bleef <w>dringen</w> bij haar baas voor een loonsverhoging.",
                            "target_lang_translations": {
                                "en": "She kept <w>pushing</w> her boss for a raise."
                            }
                        }
                    ],
                    "common_phrases": [
                        "dringen op"
                    ],
                    "target_lang_definitions": {
                        "en": "to request urgently or to insist on something"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "insist",
                                "target_lang_sense_clarification": "to demand forcefully"
                            },
                            {
                                "target_lang_word": "press",
                                "target_lang_sense_clarification": "to urge someone for something"
                            },
                            {
                                "target_lang_word": "push for",
                                "target_lang_sense_clarification": "to advocate strongly for a result"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6ba91b8c-3b52-3aae-8b15-208e5f4f22c7",
                    "sense_definition": "met kracht ergens naar binnen gaan of doorheen gaan",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "binnengaan",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het water begon door de kleine kieren van de oude dijk te <w>dringen</w>.",
                            "target_lang_translations": {
                                "en": "The water began to <w>seep</w> through the small cracks of the old dike."
                            }
                        },
                        {
                            "text": "De zon probeerde door de dikke mist heen te <w>dringen</w> op deze koude ochtend.",
                            "target_lang_translations": {
                                "en": "The sun tried to <w>pierce</w> through the thick fog on this cold morning."
                            }
                        }
                    ],
                    "common_phrases": [
                        "naar binnen dringen"
                    ],
                    "target_lang_definitions": {
                        "en": "to enter or pass through something with force"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "penetrate",
                                "target_lang_sense_clarification": "to go through or into"
                            },
                            {
                                "target_lang_word": "pierce",
                                "target_lang_sense_clarification": "to go through a barrier"
                            },
                            {
                                "target_lang_word": "seep",
                                "target_lang_sense_clarification": "of liquids or light through small openings"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}