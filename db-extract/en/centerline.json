                        "sense_id": "83da497f-7bc9-3e3a-88ca-b8f133858c26",
                        "entry_id": "1e4c6beb-bb2c-3c0c-baa2-2967c021294c",
                        "glosses": [
                            "A line down the center of a road, generally one that divides traffic moving in opposite directions."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c53b50e-efea-4d35-8df7-771d38fc6937",
                                "sense_id": "83da497f-7bc9-3e3a-88ca-b8f133858c26",
                                "text": "It is particularly confusing when the motorist is channelized across the highway centerline. For long-term closures conflicting pavement markings must be removed or obliterated before relaning the roadway."
                            }
                        ]
                    },
                    {
                        "sense_id": "6e5c8cac-a249-3fca-8890-3d661ea83680",
                        "entry_id": "1e4c6beb-bb2c-3c0c-baa2-2967c021294c",
                        "glosses": [
                            "A line, either demarcated or imagined, representing the precise center (middle) of something (such that what lies on one side of it is precisely equal in size to what lies on the other side); the central axis represented by this line."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "5c285bb7-193f-37fe-a550-572ba835b469",
                        "entry_id": "1e4c6beb-bb2c-3c0c-baa2-2967c021294c",
                        "glosses": [
                            "An imaginary line connecting the center of two fighters' bodies while they face each other."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "abd9e686-958d-4daf-96f1-f57da5a191cc",
                                "sense_id": "5c285bb7-193f-37fe-a550-572ba835b469",
                                "text": "You might already know that, I don't know, but since you are training at home I didn't want you to be weaving wildly on each side of the rope - the goal is to pop up as tight as possible to the center line."
                            },
                            {
                                "example_id": "c4e9f524-7151-4aaf-9a32-6e8d76156352",
                                "sense_id": "5c285bb7-193f-37fe-a550-572ba835b469",
                                "text": "take his lead leg out from under him. Just dont it when he is going for a power jab, just make sure your heads out of the center line"
                            }
                        ]
                    }
