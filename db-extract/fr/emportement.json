        "pl-extract.jsonl": [],
        "fr-extract.jsonl": [
            {
                "entry_id": "986af85b-bdd4-34a6-a067-7c45261de4be",
                "word": "emportement",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "9c17a3da-5cf2-4205-ba3e-c6a288f47ac5",
                        "entry_id": "986af85b-bdd4-34a6-a067-7c45261de4be",
                        "tags": [
                            "plural"
                        ],
                        "form": "emportements"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "cfeb76db-e394-321e-8fc5-840dade5b894",
                        "entry_id": "986af85b-bdd4-34a6-a067-7c45261de4be",
                        "glosses": [
                            "Action de s’emporter."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0767102-3c71-4423-947d-8059a692c024",
                                "sense_id": "cfeb76db-e394-321e-8fc5-840dade5b894",
                                "text": "Je lui demandai pardon de mon emportement."
                            },
                            {
                                "example_id": "95a0a85b-f50a-4dde-93b4-7da6e3dc62a9",
                                "sense_id": "cfeb76db-e394-321e-8fc5-840dade5b894",
                                "text": "Sa course avait l'emportement invincible d'un corps qui descendrait une montagne trop rapide."
                            },
                            {
                                "example_id": "9824f48f-4b0a-4509-a056-c1dc1bde1485",
                                "sense_id": "cfeb76db-e394-321e-8fc5-840dade5b894",
                                "text": "Quel était ce jeune homme, quelle était cette jeune fille, qui se donnaient des rendez-vous furtifs, et qui, se croyant parfaitement seuls à l’abri des curieux ou des importuns, ayant toutes les facilités pour se jeter dans les bras l’un de l’autre et passer leur temps dans les ivresses et les emportements de la passion, se contentaient de se contempler à distance, en parlant politique ?"
                            },
                            {
                                "example_id": "04392163-d673-485f-8378-dab1e7eac900",
                                "sense_id": "cfeb76db-e394-321e-8fc5-840dade5b894",
                                "text": "Toujours triste et grave, ne parlant presque jamais, je n’avais aucun des emportements, des curiosités, des folies de mon âge ; on eût dit que mon intelligence sommeillait toujours dans les limbes de la gestation maternelle."
                            }
                        ]
                    },
                    {
                        "sense_id": "886cd850-6910-35ef-b642-0afd6e4266ff",
                        "entry_id": "986af85b-bdd4-34a6-a067-7c45261de4be",
                        "glosses": [
                            "Colère qui se manifeste par une insolence méprisante, des propos insultants, de la violence."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0960eb07-c2f6-47bc-ad1c-53ca031140b8",
                                "sense_id": "886cd850-6910-35ef-b642-0afd6e4266ff",
                                "text": "Aux premiers mots proférés dans cet étrange débat, j'ai ressenti les bouillons du patriotisme jusqu'au plus violent emportement."
                            },
                            {
                                "example_id": "e40c5c55-7d6a-4ead-a963-59c3a60f9d0c",
                                "sense_id": "886cd850-6910-35ef-b642-0afd6e4266ff",
                                "text": "Pierre ne connaissait ni les emportements ni les rêveries maladives des louveteaux de Macquart."
                            },
                            {
                                "example_id": "ee4d3ecb-bca8-47ae-b6af-120023cf1834",
                                "sense_id": "886cd850-6910-35ef-b642-0afd6e4266ff",
                                "text": "Mes parents s’inquiétaient de ces emportements ; ils supputaient toujours les drames qui pourraient en découler : coups et blessures, voire meurtre, un jour que mon frère aîné aurait « vu rouge » ; gifle à un supérieur, quand il serait au régiment, ce qui entraînerait le conseil de guerre."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c6e09eaa-61de-4073-9743-3e5bad0c10eb",
                        "source_entry_id": "986af85b-bdd4-34a6-a067-7c45261de4be",
                        "target_lang_word": "anger",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anger",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "71d9b4c7-28ad-36c2-b9b1-e3cd155491c2",
                                        "entry_id": "95341ba8-02d1-3e51-be9f-d656bcb1f033",
                                        "glosses": [
                                            "A strong and unpleasant feeling of displeasure, hostility, or antagonism towards someone or something, usually combined with an urge to yell, say curse words, and/or physically harm or cause damage or destruction to things or attack or assault living beings, often stemming from perceived provocation, hurt, threat, insults, or unfair or unjust treatment, or a situation not going the way one had desired or planned."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "47c34131-a1ec-4ed2-893b-b0a6fe3f90da",
                                                "sense_id": "71d9b4c7-28ad-36c2-b9b1-e3cd155491c2",
                                                "text": "vent one's anger"
                                            },
                                            {
                                                "example_id": "5e4048cd-275d-4c02-b086-a1d50175633f",
                                                "sense_id": "71d9b4c7-28ad-36c2-b9b1-e3cd155491c2",
                                                "text": "relieve one's anger"
                                            },
                                            {
                                                "example_id": "7c0eed0f-3e0f-4ca8-84b9-d25b07f05065",
                                                "sense_id": "71d9b4c7-28ad-36c2-b9b1-e3cd155491c2",
                                                "text": "manage one's anger"
                                            },
                                            {
                                                "example_id": "9f7851cc-c981-4cf8-8627-3665547f95de",
                                                "sense_id": "71d9b4c7-28ad-36c2-b9b1-e3cd155491c2",
                                                "text": "soothe one's anger"
                                            },
                                            {
                                                "example_id": "be2983c1-2c45-4846-9269-cf02589d35bc",
                                                "sense_id": "71d9b4c7-28ad-36c2-b9b1-e3cd155491c2",
                                                "text": "show one's anger"
                                            },
                                            {
                                                "example_id": "2097656a-09af-433e-808c-4da739cef82a",
                                                "sense_id": "71d9b4c7-28ad-36c2-b9b1-e3cd155491c2",
                                                "text": "do something in anger"
                                            },
                                            {
                                                "example_id": "1a6b0116-55d0-4856-97f6-f1cd1eeeda65",
                                                "sense_id": "71d9b4c7-28ad-36c2-b9b1-e3cd155491c2",
                                                "text": "You need to control your anger."
                                            },
                                            {
                                                "example_id": "6f0c1b52-995e-48f9-94e3-25db9f114ac3",
                                                "sense_id": "71d9b4c7-28ad-36c2-b9b1-e3cd155491c2",
                                                "text": "Seeing the British establishment struggle with the financial sector is like watching an alcoholic […]. Until 2008 there was denial over what finance had become. When a series of bank failures made this impossible, there was widespread anger, leading to the public humiliation of symbolic figures."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ddf99fba-4710-308e-9494-14c06b4eefe4",
                                        "entry_id": "95341ba8-02d1-3e51-be9f-d656bcb1f033",
                                        "glosses": [
                                            "Pain or stinging."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "16c6fe22-7d16-41eb-a956-6beb3f43af19",
                                                "sense_id": "ddf99fba-4710-308e-9494-14c06b4eefe4",
                                                "text": "It heals the Wounds that Sin hath made; and takes away the Anger of the Sore; […]"
                                            },
                                            {
                                                "example_id": "a16fb572-366c-4d58-aa7d-d0412c73fe6f",
                                                "sense_id": "ddf99fba-4710-308e-9494-14c06b4eefe4",
                                                "text": "I immediately made the Experiment, ſetting the Moxa where the firſt Violence of my Pain began, which was the Joint of the great Toe, and where the greateſt Anger and Soreneſs ſtill continued, [...]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "anger",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4bce7dc6-53a2-3d07-9388-a6556159f9dd",
                                        "entry_id": "7d104f94-bad5-3eae-b170-00de3568e4f0",
                                        "glosses": [
                                            "To cause such a feeling of antagonism in."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb85cb83-827c-454b-b743-027ea7635953",
                                                "sense_id": "4bce7dc6-53a2-3d07-9388-a6556159f9dd",
                                                "text": "He who angers you conquers you."
                                            },
                                            {
                                                "example_id": "2d0d2a67-b36c-4557-8e25-bbc354fd546d",
                                                "sense_id": "4bce7dc6-53a2-3d07-9388-a6556159f9dd",
                                                "text": "“Poetling, fret thyself not! / I will not one tittle imperil / Thy sorry cockboat; / Nor yet thy poor dear life will I harass / With over-hazardous tossings. / For thou, little poet, ne’er angeredst me; / Thou hast me no least little pinnacle harmed / Of Priamus’ sacrosanct stronghold; / Nor even the least little lash hast thou singed / Of the eye of my son Polyphemus; / And thee with her counsels protected hath ne’er / The Goddess of Wisdom, Pallas Athené.”"
                                            },
                                            {
                                                "example_id": "e0d5a2ee-46eb-4e9a-9286-1659cc93f4f0",
                                                "sense_id": "4bce7dc6-53a2-3d07-9388-a6556159f9dd",
                                                "text": "President Donald Trump’s offer to most federal employees to resign now and be paid through September stunned the workers who received it – angering some, confusing many and raising questions about whether the offer is even legal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "91d9dccf-cd37-3fd6-8777-8c184f0ccbcb",
                                        "entry_id": "7d104f94-bad5-3eae-b170-00de3568e4f0",
                                        "glosses": [
                                            "To become angry."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a62e0c0c-2bf4-47aa-9183-134383eb130b",
                                                "sense_id": "91d9dccf-cd37-3fd6-8777-8c184f0ccbcb",
                                                "text": "You anger too easily."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
