                "senses": [
                    {
                        "sense_id": "dd56e893-c61c-3883-80d8-0c5c117f6981",
                        "entry_id": "21ecdded-2080-3fed-bd4a-a6cdfb401065",
                        "glosses": [
                            "Runde der (meist vier) Teilnehmer, bei der sich die besten (meist zwei) für das Finale qualifizieren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb164f7f-9470-4853-8995-55c018c309e8",
                                "sense_id": "dd56e893-c61c-3883-80d8-0c5c117f6981",
                                "text": "„Im Halbfinale scheiterte er als 13.“"
                            },
                            {
                                "example_id": "54cfbf12-e894-4b4a-8182-3c4c8db96bfd",
                                "sense_id": "dd56e893-c61c-3883-80d8-0c5c117f6981",
                                "text": "Die Mannschaft erreichte mit einem klaren Sieg das Halbfinale."
                            },
                            {
                                "example_id": "f5c4e9a2-d6d3-40a2-8ce3-111481bc0e2e",
                                "sense_id": "dd56e893-c61c-3883-80d8-0c5c117f6981",
                                "text": "„Die Niederösterreicherin stieg nach den Vorläufen als Zwölfte in das Halbfinale der besten 15 am Donnerstag (15.15 Uhr MESZ) auf.“"
                            },
                            {
                                "example_id": "4df4d3f7-0dee-40c9-8296-1d372d43cbef",
                                "sense_id": "dd56e893-c61c-3883-80d8-0c5c117f6981",
                                "text": "„Wir gehen noch einmal nach Brasilien, in die Halbfinale und das Finale der WM 2014.“"
                            },
                            {
                                "example_id": "e2f53612-542b-420a-8b8c-407c59455fa6",
                                "sense_id": "dd56e893-c61c-3883-80d8-0c5c117f6981",
                                "text": "[Tennis:] „Alexander Zverev hat bei den French Open den Einzug ins Halbfinale verpasst. […] Der Vorjahresfinalist verlor sein Viertelfinale in Paris gegen den Serben Novak Djokovic mit 6:4, 3:6, 2:6, 4:6.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ccd41b51-4ddd-4919-b223-c2d9e2350a63",
                        "source_entry_id": "21ecdded-2080-3fed-bd4a-a6cdfb401065",
