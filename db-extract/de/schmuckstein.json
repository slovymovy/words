                "senses": [
                    {
                        "sense_id": "3d761d5c-c1ad-3165-85f1-a35a7e10edd9",
                        "entry_id": "540604ca-b488-3f29-b439-361a99efccf1",
                        "glosses": [
                            "Minerale oder Gesteine (teilweise auch organische Stoffe), die wegen ihrer Schönheit zu Schmuck verarbeitet werden, jedoch keine Edelsteine im Sinne der Mineralogie sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d6652f73-1689-4172-bbc7-31a18aa2b7ad",
                                "sense_id": "3d761d5c-c1ad-3165-85f1-a35a7e10edd9",
                                "text": "Schmucksteine werden geschliffen und poliert, um daraus Ketten, Ringe, Broschen und andere Schmuckstücke herzustellen."
                            },
                            {
                                "example_id": "73345151-19e9-4f21-96c7-6af477448e5c",
                                "sense_id": "3d761d5c-c1ad-3165-85f1-a35a7e10edd9",
                                "text": "Die Brosche war aus Stücken verschiedener Schmucksteine gefertigt."
                            },
                            {
                                "example_id": "5e98fa73-3b75-4e3e-8b2c-378a0d15d320",
                                "sense_id": "3d761d5c-c1ad-3165-85f1-a35a7e10edd9",
                                "text": "„Der Schmuckstein des Ringes hatte die Form eines Skorpions.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
