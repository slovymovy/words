        "fr-extract.jsonl": [
            {
                "entry_id": "75da3c31-a424-3489-8d5a-7d036697d425",
                "word": "affouillement",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "2322dbf8-e65e-4ca4-ae47-dc0d01e0c557",
                        "entry_id": "75da3c31-a424-3489-8d5a-7d036697d425",
                        "tags": [
                            "plural"
                        ],
                        "form": "affouillements"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8f26fc88-a633-3da2-a31a-83be823c5178",
                        "entry_id": "75da3c31-a424-3489-8d5a-7d036697d425",
                        "glosses": [
                            "Phénomène d’érosion causé par le mouvement de l’eau courante et qui consiste en un creusement des berges, du littoral et de tout ce qui fait obstacle au courant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db448993-39c7-4aff-9c6b-cff5b41fa5da",
                                "sense_id": "8f26fc88-a633-3da2-a31a-83be823c5178",
                                "text": "Pour les contraintes : il faut distinguer les vraies et les fausses contraintes, chercher à se désempiéger de routines médiocres, retrouver le goût de l’érudition, de l’affouillement, de la trouvaille, du plaisir de la quête que ne peut donner l’histoire \"résumée\" ou l’histoire \"idéologique\"."
                            },
                            {
                                "example_id": "56b781fa-f970-43cb-a070-ccee777076d7",
                                "sense_id": "8f26fc88-a633-3da2-a31a-83be823c5178",
                                "text": "Ces infiltrations eurent pour effet de dissoudre la glace inférieure en de certains endroits et de produire des affouillements suspects."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7270e514-f735-495b-a136-25afc361bf4b",
                        "source_entry_id": "75da3c31-a424-3489-8d5a-7d036697d425",
                        "source_sense_id": "8f26fc88-a633-3da2-a31a-83be823c5178",
                        "target_lang_word": "scouring",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "scouring",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0fd9b2e2-5762-355b-99b4-c81d4455a5ff",
                                        "entry_id": "6f888d67-e701-3626-b811-2e65a5cec95b",
                                        "glosses": [
                                            "The act of cleaning a surface by rubbing it with a brush, soap and water."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4215ebb3-369f-378f-bf1e-6ba171136b4c",
                                        "entry_id": "6f888d67-e701-3626-b811-2e65a5cec95b",
                                        "glosses": [
                                            "Diarrhea. (Now used only of livestock, though also sometimes used of humans into the 1600s.)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2336f6e-e905-42b3-93ca-b7f7e6def1cb",
                                                "sense_id": "4215ebb3-369f-378f-bf1e-6ba171136b4c",
                                                "text": "Another for a violent scouring. Take the Entrails of a Pullet, or great Chicken, all but the Gizzard, and mix with tbem of Spikenard one Ounce, ' and make him swallow it, and this will infallibly stay his Scouring, yea, though it be a Bloody-Flux."
                                            },
                                            {
                                                "example_id": "2e24cece-264c-4770-9f07-4fa1582314ff",
                                                "sense_id": "4215ebb3-369f-378f-bf1e-6ba171136b4c",
                                                "text": "For that kind of lax and scouring called bloody flux, see the article BLOODY FLUX."
                                            },
                                            {
                                                "example_id": "4804a9c2-be2c-422a-ada4-d15250ac1be1",
                                                "sense_id": "4215ebb3-369f-378f-bf1e-6ba171136b4c",
                                                "text": "Thus in 1670 the London bills ascribe 142 deaths to “bloody flux, scouring, and flux,” and 3,690 to “griping in the guts.”"
                                            },
                                            {
                                                "example_id": "976e1702-5810-4423-9b3b-80f7415256d7",
                                                "sense_id": "4215ebb3-369f-378f-bf1e-6ba171136b4c",
                                                "text": "Flux, bloody flux and scouring feature from the first, but were overtaken in the 1650s by 'plague in the guts', soon renamed 'griping in the guts'. An apparent decline in bloody flux was more than matched by high levels of 'griping in the guts'."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ed954e8c-357c-39cd-8ca5-846b02be9ff1",
                                        "entry_id": "6f888d67-e701-3626-b811-2e65a5cec95b",
                                        "glosses": [
                                            "Erosion by water, especially in watercourses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f6dbe6e-c581-46c9-8564-865dcbfc32ed",
                                                "sense_id": "ed954e8c-357c-39cd-8ca5-846b02be9ff1",
                                                "text": "It was also found that scouring had occurred in the bed of the mill lade, which passes between the first and second piers."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "scouring",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6e84c6ca-c9c0-3a30-9af7-05be2b49bd27",
                                        "entry_id": "3c09a9aa-32a3-3e2a-b235-1d4dfb8878fa",
                                        "glosses": [
                                            "present participle and gerund of scour"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "gerund",
                                            "participle",
                                            "present"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e1ebc123-089f-4561-8117-77042a67fc1c",
                                                "sense_id": "6e84c6ca-c9c0-3a30-9af7-05be2b49bd27",
                                                "text": "Scouring the entire area revealed nothing."
                                            }
                                        ]
