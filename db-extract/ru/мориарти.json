                "senses": [
                    {
                        "sense_id": "686b492b-740c-3335-be12-dbbb5e27fc1c",
                        "entry_id": "c096cfdb-5905-31a5-ac01-c13c9f8b105c",
                        "glosses": [
                            "ирландская фамилия"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "36b0d82c-015e-41cf-9f4b-7f80755fa7f1",
                                "sense_id": "686b492b-740c-3335-be12-dbbb5e27fc1c",
                                "text": "Однако в архиве Госдепа сохранилась (ныне обнародованная) телеграмма, которую отправил высокопоставленный сотрудник «Бектала» Юджин Мориарти своему иорданскому коллеге по переговорам."
                            },
                            {
                                "example_id": "ce4a2430-7fd0-43ed-8239-9312dc165cbf",
                                "sense_id": "686b492b-740c-3335-be12-dbbb5e27fc1c",
                                "text": "Настоящая гибель Шерлока Холмса в схватке у Рейхенбахского водопада с профессором Мориарти впоследствии оказывается мнимой."
                            }
                        ]
                    }
