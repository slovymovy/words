            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "8938c881-cb85-3679-9d80-26a6179c5ef4",
                    "sense_definition": "Qui est chargé ou couvert de brume, où l'atmosphère est opaque.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "meteorologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Par ce matin <w>brumeux</w>, la visibilité sur l'autoroute est très réduite."
                        },
                        {
                            "text": "Le temps <w>brumeux</w> enveloppait le port d'une atmosphère calme et mystérieuse."
                        }
                    ],
                    "synonyms": [
                        "embrumé"
                    ],
                    "antonyms": [
                        "clair",
                        "dégagé",
                        "ensoleillé"
                    ],
                    "common_phrases": [
                        "temps brumeux",
                        "matin brumeux",
                        "ciel brumeux"
                    ]
                },
                {
                    "sense_id": "d20cce5d-583b-365d-af20-7f4de42f8543",
                    "sense_definition": "Qui manque de clarté ou de netteté dans l'expression ou dans l'esprit ; confus.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "comprehension",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Son explication était tellement <w>brumeuse</w> que personne n'a compris le problème."
                        },
                        {
                            "text": "Il ne conserve qu'un souvenir <w>brumeux</w> des événements survenus pendant son enfance."
                        }
                    ],
                    "synonyms": [
                        "confus",
                        "nébuleux",
                        "obscur"
                    ],
                    "antonyms": [
                        "clair",
                        "lucide",
                        "net",
                        "précis"
                    ],
                    "common_phrases": [
                        "souvenir brumeux",
                        "discours brumeux"
                    ]
                },
                {
                    "sense_id": "0223c790-72a8-3e49-a49c-f2c469309ee5",
                    "sense_definition": "Qui est voilé ou terne, comme couvert de brume, en parlant du regard ou des yeux.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "regard",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle le fixait avec des yeux <w>brumeux</w> après cette longue nuit sans sommeil."
                        },
                        {
                            "text": "Son regard <w>brumeux</w> semblait errer sans but à travers la pièce silencieuse."
                        }
                    ],
                    "synonyms": [
                        "embrumé",
                        "voilé"
                    ],
                    "antonyms": [
                        "étincelant",
                        "limpide",
                        "vif"
                    ],
                    "common_phrases": [
                        "yeux brumeux",
                        "regard brumeux"
                    ]
                }
            ]
        }
    ]
