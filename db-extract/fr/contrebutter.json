                "senses": [
                    {
                        "sense_id": "b6054961-f5d6-3053-b226-61c39738e5b2",
                        "entry_id": "3de3534c-8b58-30ac-915b-be2248e35352",
                        "glosses": [
                            "Opposer à la poussée d’un mur, d'un plafond, d'une voûte, d’un édifice, une force opposée, afin de les consolider."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "614ff5eb-0706-454d-bd27-cf969704982b",
                                "sense_id": "b6054961-f5d6-3053-b226-61c39738e5b2",
                                "text": "Le procédé qui consiste à contrebutter la poussée des voûtes par des contreforts de la même forme est bien connu dans l'architecture de Constantinople ."
                            },
                            {
                                "example_id": "099c0efa-c0fb-4e32-8a8a-f1497308d3a5",
                                "sense_id": "b6054961-f5d6-3053-b226-61c39738e5b2",
                                "text": "Mais les arcs-boutants, destinés à contrebutter la poussée des voûtes, n’atteignaient pas le niveau des corniches supérieures."
                            }
                        ]
                    }
