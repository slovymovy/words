{
    "word_family": [
        "taan",
        "taankleur",
        "getaand"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "01ec3c83-c75a-3cd2-8e25-7a99f1614086",
                    "sense_definition": "In kracht, glans of belang afnemen; minder worden.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "afname",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De roem van de oude filmster begon na enkele jaren flink te <w>tanen</w>.",
                            "target_lang_translations": {
                                "en": "The old movie star's fame began to <w>fade</w> significantly after a few years."
                            }
                        },
                        {
                            "text": "Zijn enthousiasme voor het project begon langzaam te <w>tanen</w> door de vele tegenslagen.",
                            "target_lang_translations": {
                                "en": "His enthusiasm for the project slowly began to <w>wane</w> due to the many setbacks."
                            }
                        }
                    ],
                    "synonyms": [
                        "verzwakken",
                        "afnemen",
                        "slinken",
                        "verflauwen",
                        "verminderen",
                        "aflopen"
                    ],
                    "antonyms": [
                        "groeien",
                        "toenemen",
                        "bloeien"
                    ],
                    "common_phrases": [
                        "roem taant",
                        "enthousiasme taant",
                        "belangstelling taant"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vaak in figuurlijke zin gebruikt"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To decrease in strength, brilliance, or importance; to diminish or fade away."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "fade",
                                "target_lang_sense_clarification": "to lose strength or importance over time"
                            },
                            {
                                "target_lang_word": "wane",
                                "target_lang_sense_clarification": "to decrease in vigor or power"
                            },
                            {
                                "target_lang_word": "diminish",
                                "target_lang_sense_clarification": "to become less or smaller"
                            },
                            {
                                "target_lang_word": "decline",
                                "target_lang_sense_clarification": "to gradually become less or weaker"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c398845e-a1f6-32b6-a632-854a59bcc6f3",
                    "sense_definition": "Een vaalgele of bruine kleur krijgen of geven.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "kleuren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Door de felle zon begon het witte doek langzaam te <w>tanen</w>.",
                            "target_lang_translations": {
                                "en": "The white canvas slowly began to <w>tan</w> because of the bright sun."
                            }
                        },
                        {
                            "text": "De oude zeilen waren prachtig <w>getaand</w> door jarenlang gebruik op zee.",
                            "target_lang_translations": {
                                "en": "The old sails were beautifully <w>weathered</w> by years of use at sea."
                            }
                        }
                    ],
                    "synonyms": [
                        "verkleuren"
                    ],
                    "common_phrases": [
                        "bruin tanen"
                    ],
                    "target_lang_definitions": {
                        "en": "To acquire or give a pale yellow or brown color."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "tan",
                                "target_lang_sense_clarification": "to turn brown from exposure to the sun"
                            },
                            {
                                "target_lang_word": "discolor",
                                "target_lang_sense_clarification": "to change color, often due to light or age"
                            },
                            {
                                "target_lang_word": "weather",
                                "target_lang_sense_clarification": "to change appearance due to exposure to the elements"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3c4dfde1-04af-3fdc-b8ec-a6e2d77f7177",
                    "sense_definition": "Netten, zeilen of leer behandelen met een vloeistof (taan) om ze te conserveren.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "conserveren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De vissers waren vroeger dagenlang bezig met het <w>tanen</w> van hun katoenen netten.",
                            "target_lang_translations": {
                                "en": "In the past, fishermen spent days <w>tanning</w> their cotton nets."
                            }
                        },
                        {
                            "text": "Men moet de zeilen regelmatig <w>tanen</w> om ze tegen rot te beschermen.",
                            "target_lang_translations": {
                                "en": "One must regularly <w>treat</w> the sails to protect them against rot."
                            }
                        }
                    ],
                    "synonyms": [
                        "looien"
                    ],
                    "common_phrases": [
                        "netten tanen",
                        "zeilen tanen"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vissersterm"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To treat nets, sails, or leather with a specific liquid (tannin) to preserve them."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "tan",
                                "target_lang_sense_clarification": "to treat hides or materials with tannin for preservation"
                            },
                            {
                                "target_lang_word": "cure",
                                "target_lang_sense_clarification": "to preserve materials through a chemical process"
                            },
                            {
                                "target_lang_word": "bark",
                                "target_lang_sense_clarification": "to treat with a bark-based infusion (archaic/technical)"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}