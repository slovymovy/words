                "senses": [
                    {
                        "sense_id": "b4b44ade-c7bb-3477-ac50-faffa9fd2525",
                        "entry_id": "e7b574d6-0aad-3309-824d-e4a5a6f2ec64",
                        "glosses": [
                            "Bahnkurve, auf der ein Objekt die Erde umkreist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df087f74-e4b8-4b2f-aa2d-714b3ca24507",
                                "sense_id": "b4b44ade-c7bb-3477-ac50-faffa9fd2525",
                                "text": "„Zum ersten Mal hob von koreanischem Staatsboden eine Rakete ab, die einen Satelliten in den Erdorbit brachte.“"
                            },
                            {
                                "example_id": "6e964a8a-eaa0-49e2-9d2d-64cebacf5da5",
                                "sense_id": "b4b44ade-c7bb-3477-ac50-faffa9fd2525",
                                "text": "„Die Nasa plant, Menschen wieder über den Erdorbit hinaus ins All zu schicken.“"
                            },
                            {
                                "example_id": "6e7c9435-c86c-4511-9745-b8e22ff002e1",
                                "sense_id": "b4b44ade-c7bb-3477-ac50-faffa9fd2525",
                                "text": "„Laut Simulationen gibt es derzeit 150 Millionen Weltraumschrott-Objekte im Erdorbit, die größer als einen Millimeter sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
