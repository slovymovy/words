                "senses": [
                    {
                        "sense_id": "d56b2fcd-0fe4-3a15-8064-627342233cf7",
                        "entry_id": "3859b44c-1add-3d2b-a50f-83e978cd9ea7",
                        "glosses": [
                            "Donner un caractère mithraïque à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3724a6f4-3943-43ee-850d-9b89709256f8",
                                "sense_id": "d56b2fcd-0fe4-3a15-8064-627342233cf7",
                                "text": "Comme l’écrit F. Buffière, «la sagesse de Zoroastre y vient épauler celle de Platon» et «ce qu’Homère ne dit pas, on le tire de Moïse, d'Orphée ou de Zoroastre» ou, pour être plus précis, d’un Zoroastre mithraïsé par les philosophes grecs, car les théories religieuses du De antro Nympharum n’ont bien évidemment rien à voir avec le zoroastrisme de Zarathustra."
                            },
                            {
                                "example_id": "ecb0be8d-6674-4fdc-8c1b-209a454ef79a",
                                "sense_id": "d56b2fcd-0fe4-3a15-8064-627342233cf7",
                                "text": "Aussi peut-on douter que le monde ait couru le hasard de se mithraïser."
                            }
                        ]
                    }
                ],
