                "translations": [
                    {
                        "translation_id": "3281bb29-5255-4334-b350-c74219ba4798",
                        "source_entry_id": "68112560-c77f-3481-8365-69ca92401547",
                        "target_lang_word": "cherry picker",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cherry picker",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f9a91ffe-a918-3df6-87ff-3c3e9721bc00",
                                        "entry_id": "71c84ecc-460e-38e8-bfb7-983c6d91b4f7",
                                        "glosses": [
                                            "A piece of equipment consisting of a large basket at the end of an extensible boom, often mounted on a truck body, and used by workers to reach inaccessible places such as power lines and tall trees."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7afdcb6-4929-4366-9883-70bb226e6d2e",
                                                "sense_id": "f9a91ffe-a918-3df6-87ff-3c3e9721bc00",
                                                "text": "Earlier police used a cherry picker to clear protesters perched on a wooden structure built to block the road at Oxford Circus."
                                            },
                                            {
                                                "example_id": "ecacf9c9-0d2a-43a3-8f2d-911a380c2a7f",
                                                "sense_id": "f9a91ffe-a918-3df6-87ff-3c3e9721bc00",
                                                "text": "Near-synonym: man lift"
                                            },
                                            {
                                                "example_id": "8023fc95-8a31-46fd-86a9-f20ef197129f",
                                                "sense_id": "f9a91ffe-a918-3df6-87ff-3c3e9721bc00",
                                                "text": "Between filling the sandwiches, Nicole Moy and Shazza McCormack collect donations for the flags and pass on quietly offered suggestions by local people, anxious about possible illegality, as to where the flaggers should visit next with their ladders and cherrypickers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3e09aaf0-5975-33a8-83cd-be9b2fdb4c9d",
                                        "entry_id": "71c84ecc-460e-38e8-bfb7-983c6d91b4f7",
                                        "glosses": [
                                            "A cantilevered tool for installing or removing a vehicle's engine block."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3496173a-4f78-30a1-a2c3-f868a7f2d382",
                                        "entry_id": "71c84ecc-460e-38e8-bfb7-983c6d91b4f7",
                                        "glosses": [
                                            "A person or device that harvests cherries, or that aids in the harvesting of cherries."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "07018784-b96c-4ef5-825f-7b1f9d1ed26b",
                                                "sense_id": "3496173a-4f78-30a1-a2c3-f868a7f2d382",
                                                "text": "A relatively high proportion of the cost of production of RSP cherries is in the picking. Pickers are paid […]. There is considerable interest in a mechanical cherry picker which is reported to be able to double each picker's output."
                                            },
                                            {
                                                "example_id": "d062abf2-6613-49d2-8afe-afcb66d1faa9",
                                                "sense_id": "3496173a-4f78-30a1-a2c3-f868a7f2d382",
                                                "text": "A mechanical cherry picker shakes a cherry tree to loosen the fruit. The cherries drop onto outstretched cloths, roll onto a conveyor, and are deposited in a tank of salt water. The fruit floats in the water and thus is […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dba341c3-87f2-34d1-a075-3ae76814533e",
                                        "entry_id": "71c84ecc-460e-38e8-bfb7-983c6d91b4f7",
                                        "glosses": [
                                            "A person or group that picks the best for themselves; one who cherry-picks."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "65b6c314-0cbf-3a1d-a9ce-c3d20cea1571",
                                        "entry_id": "71c84ecc-460e-38e8-bfb7-983c6d91b4f7",
                                        "glosses": [
                                            "A person or group that picks only evidence which supports an argument and ignores evidence which contradicts it; one who cherry-picks."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f9388a0a-b1c5-4b28-b576-9493724cf068",
                                                "sense_id": "65b6c314-0cbf-3a1d-a9ce-c3d20cea1571",
                                                "text": "Two conclusions stand out: The Bible is a cherry-picker's paradise, and human beings cannot function without double standards."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
