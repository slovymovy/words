                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "69165a5c-d540-3c77-9a31-18d409d9c753",
                                        "entry_id": "a09e22ed-4618-3a5b-9839-39f1eb0cfe9f",
                                        "glosses": [
                                            "The bottom of a shoe or boot."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
