                    {
                        "form_id": "d9703f1b-b7a1-4c80-8938-d346eb1def82",
                        "entry_id": "803d8bee-8367-3190-b062-ef7cd53ceb87",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Eindringlinge"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e376fe98-89b3-3039-99dc-d0dcd3826e24",
                        "entry_id": "803d8bee-8367-3190-b062-ef7cd53ceb87",
                        "glosses": [
                            "jemand, der sich unerlaubt/unerwünscht Zutritt verschafft hat/verschafft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "84024386-0d49-4d70-bcaa-ae377a9b76f2",
                                "sense_id": "e376fe98-89b3-3039-99dc-d0dcd3826e24",
                                "text": "Eindringlinge werden erschossen."
                            },
                            {
                                "example_id": "b8c8d75b-b995-4c6c-88e6-4c36e2947216",
                                "sense_id": "e376fe98-89b3-3039-99dc-d0dcd3826e24",
                                "text": "„Wir sind keine Eindringlinge, sondern Ehrengäste.“"
                            },
                            {
                                "example_id": "8e834410-32af-48f4-b67f-bd58f03fd6c1",
                                "sense_id": "e376fe98-89b3-3039-99dc-d0dcd3826e24",
                                "text": "„Vor allem die rohe Gewalt der Eindringlinge traumatisiert die Römer zutiefst.“"
                            },
                            {
                                "example_id": "6f3aaa9e-418d-4787-a245-af07c8dfd179",
                                "sense_id": "e376fe98-89b3-3039-99dc-d0dcd3826e24",
                                "text": "„Rücksichtslos schickt er seine Sklaven zwei Sommer nacheinander auf Thorsteins Land - obwohl er weiß, dass der Nachbar angekündigt hat, solche Eindringlinge zu erschlagen.“"
                            },
                            {
                                "example_id": "755992f3-262b-479c-b92e-37df3cb33051",
                                "sense_id": "e376fe98-89b3-3039-99dc-d0dcd3826e24",
                                "text": "„»Rus« nennen die Einheimischen die Eindringlinge - wahrscheinlich abgeleitet von einem Wort, mit dem die Finnen die Schweden bezeichnen.“"
                            },
                            {
                                "example_id": "574bc812-cf55-422f-9d8f-7653f5a4f3d7",
                                "sense_id": "e376fe98-89b3-3039-99dc-d0dcd3826e24",
                                "text": "„Die Mauer soll Amerika uneinnehmbar für Eindringlinge machen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a453060f-13aa-4691-a8e7-42a73848efdf",
                        "source_entry_id": "803d8bee-8367-3190-b062-ef7cd53ceb87",
