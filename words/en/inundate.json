{
    "word_family": [
        "inundation",
        "inundator",
        "inundatory"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6637c90b-20c9-35f2-8cc7-2d6faf42a955",
                    "sense_definition": "To overwhelm someone with things, requests, or information that are too much to deal with.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "overwhelm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The customer service agency was <w>inundated</w> with phone calls after the system failure.",
                            "target_lang_translations": {
                                "ru": "Агентство по обслуживанию клиентов было <w>завалено</w> телефонными звонками после сбоя в системе."
                            }
                        },
                        {
                            "text": "Fans will <w>inundate</w> with requests any celebrity who shares their personal email address online.",
                            "target_lang_translations": {
                                "ru": "Фанаты <w>засыплют</w> просьбами любую знаменитость, которая опубликует свой личный адрес электронной почты в сети."
                            }
                        }
                    ],
                    "synonyms": [
                        "swamp",
                        "flood",
                        "deluge"
                    ],
                    "common_phrases": [
                        "inundate with requests",
                        "inundate with calls",
                        "inundate with information"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заваливать кого-либо делами, просьбами или информацией в количестве, с которым трудно справиться."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заваливать",
                                "target_lang_sense_clarification": "просьбами, работой или письмами"
                            },
                            {
                                "target_lang_word": "наводнять",
                                "target_lang_sense_clarification": "большим количеством чего-либо"
                            },
                            {
                                "target_lang_word": "засыпать",
                                "target_lang_sense_clarification": "вопросами или жалобами"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f81f25c9-a91a-30a5-9ed7-24b39e5aa163",
                    "sense_definition": "To cover a place or area with a large amount of water.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "flood",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heavy seasonal rains threatened to <w>inundate</w> the low-lying farmland near the river.",
                            "target_lang_translations": {
                                "ru": "Сильные сезонные дожди грозили <w>затопить</w> низменные сельскохозяйственные угодья у реки."
                            }
                        },
                        {
                            "text": "The Dutch would sometimes <w>inundate</w> the land to hinder the progress of the Spanish army.",
                            "target_lang_translations": {
                                "ru": "Голландцы иногда специально <w>затапливали</w> земли, чтобы помешать продвижению испанской армии."
                            }
                        }
                    ],
                    "synonyms": [
                        "flood",
                        "deluge",
                        "beflood"
                    ],
                    "common_phrases": [
                        "inundate the land",
                        "inundate the fields"
                    ],
                    "target_lang_definitions": {
                        "ru": "Покрывать какую-либо территорию или место большим количеством воды."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "затоплять",
                                "target_lang_sense_clarification": "территорию водой"
                            },
                            {
                                "target_lang_word": "заливать",
                                "target_lang_sense_clarification": "поверхность жидкостью"
                            },
                            {
                                "target_lang_word": "наводнять",
                                "target_lang_sense_clarification": "устар. или книжн. о местности"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}