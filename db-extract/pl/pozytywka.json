                        ]
                    },
                    {
                        "translation_id": "e2134c46-dafa-4870-8aee-b32d24bdb41a",
                        "source_entry_id": "4cf0d770-b162-383f-9561-957de32d13f1",
                        "source_sense_id": "2746405e-d30f-33f8-ae5f-29adefda4120",
                        "target_lang_word": "musical box",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "musical box",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c1bd08da-a50b-3f7e-987e-eea2eba1a240",
                                        "entry_id": "af85deec-893b-30b8-be09-3260f3be46fb",
                                        "glosses": [
                                            "Any of various devices that play tunes by means of pins, on a rotating disk or revolving drum, that strike or pluck metal teeth; a music box."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "59ff5796-9809-4403-a5b7-a6b37c384528",
                                                "sense_id": "c1bd08da-a50b-3f7e-987e-eea2eba1a240",
                                                "text": "There was a battered brass speaking-trumpet, very discoloured, a tambourine, a musical-box, and a number of smaller objects."
                                            },
                                            {
                                                "example_id": "b1f1e084-f80f-4745-a215-51389150a56a",
                                                "sense_id": "c1bd08da-a50b-3f7e-987e-eea2eba1a240",
                                                "text": "Beneath the clothes [of the poupard] a squeaker would be concealed, and more elaborate ones would have a musical-box, the music being played by twirling the doll around."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "58fc8c1a-fb7b-4596-a60c-7143356cf17f",
                        "source_entry_id": "4cf0d770-b162-383f-9561-957de32d13f1",
                        "source_sense_id": "2746405e-d30f-33f8-ae5f-29adefda4120",
                        "target_lang_word": "boîte à musique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "boîte à musique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ddf0bbe4-35f6-32c8-b217-80812c8f03eb",
                                        "entry_id": "0ee7765d-b648-36c7-91b9-0c61ab6b4066",
                                        "glosses": [
                                            "Coffret dont l’ouverture déclenche un mécanisme reproduisant un ou plusieurs airs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab1a3e5b-f25a-4df5-ae75-c3d56527b7ea",
                                                "sense_id": "ddf0bbe4-35f6-32c8-b217-80812c8f03eb",
                                                "text": "Elle en avait de préférées qu'elle faisait toujours revenir dans ses rêves, comme une boîte à musique dont on remonte la manivelle répète interminablement le même air."
                                            },
                                            {
                                                "example_id": "c2f4be72-8527-4062-a060-05c006d4d91f",
                                                "sense_id": "ddf0bbe4-35f6-32c8-b217-80812c8f03eb",
                                                "text": "Ils plaçaient aussi des phonographes à bon marché et tiraient quelques profits de la vente des boîtes à musique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
