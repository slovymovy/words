                                "ru": "Офис был наполнен <w>постоянным</w> шумом телефонных звонков и стука клавиш."
                            }
                        },
                        {
                            "text": "He lived in a state of <w>perpetual</w> fear that his secret would be discovered.",
                            "target_lang_translations": {
                                "ru": "Он жил в состоянии <w>постоянного</w> страха, что его секрет будет раскрыт."
                            }
                        }
                    ],
                    "synonyms": [
                        "continuous",
                        "nonstop",
                        "persistent",
                        "endless",
                        "unending"
                    ],
                    "antonyms": [
                        "intermittent",
                        "occasional",
                        "sporadic",
                        "periodic"
                    ],
                    "common_phrases": [
