                        "entry_id": "8cf11455-cfba-331f-95d2-17bf263c1298",
                        "glosses": [
                            "osoba zajmująca się nielegalnym przewozem lub przenoszeniem ludzi lub rzeczy między granicami państw"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a7f7d035-642e-4092-8ba5-9e3e6548a86d",
                                "sense_id": "ecf27000-ef4b-384b-8e4d-5bb2c2f0fd6c",
                                "text": "O słynnych w całej Polsce białogardzkich przemytnikach papierosów znowu jest głośno"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2b9525c8-fdc3-41d7-b3d3-c80e862df2fe",
                        "source_entry_id": "8cf11455-cfba-331f-95d2-17bf263c1298",
                        "source_sense_id": "ecf27000-ef4b-384b-8e4d-5bb2c2f0fd6c",
                        "target_lang_word": "smuggler",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "smuggler",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f57e9544-7727-351f-8522-6a19ac319321",
                                        "entry_id": "8b77ceff-2ed0-345f-ad56-295d09a2b007",
                                        "glosses": [
                                            "One who smuggles things."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "576c4913-d862-42f0-b5a0-f44596305763",
                                                "sense_id": "f57e9544-7727-351f-8522-6a19ac319321",
                                                "text": "Every time the little gate creaks--I'm in the shed with the tanks at the end of the garden--I wonder from which of my pasts the person is arriving, seeking me out even here: maybe it is only the past of yesterday and of this same suburb, the squat Arab garbage collector who in October begins his rounds for tips, house by house, with a Happy New Year card, because he says that his colleagues keep all the December tips for themselves and he never gets a penny; but it could also be the more distant pasts pursuing old Ruedi, finding the little gate in the Impasse: smugglers from Valais, mercenaries from Katanga, croupiers from the Veradero casino and the days of Fulgencio Batista."
                                            },
                                            {
                                                "example_id": "80f98722-0eb2-4be4-9b54-2920830f7984",
                                                "sense_id": "f57e9544-7727-351f-8522-6a19ac319321",
                                                "text": "Cabbage Moh, a Cantonese smuggler and drug dealer from triad-controlled Shumchun on the Hong Kong border, sees an opportunity to the north and opens dens supplying dope and philopon ferried up the Soochow Creek and distributed out of Fah Wah Village, adjacent to the new sin strip."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "daeee875-05bb-315a-88b6-34258499b826",
                                        "entry_id": "8b77ceff-2ed0-345f-ad56-295d09a2b007",
                                        "glosses": [
                                            "A vessel employed in smuggling."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "51cd7598-f53c-46b2-950a-1ad31d5e1379",
                        "source_entry_id": "8cf11455-cfba-331f-95d2-17bf263c1298",
                        "source_sense_id": "ecf27000-ef4b-384b-8e4d-5bb2c2f0fd6c",
                        "target_lang_word": "pašerák",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pašerák",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "ec170e65-c0e9-3180-ac31-24bd707258e9",
                                        "entry_id": "247a4ab0-cb7a-3be2-8d5e-bb2f0eed6224",
                                        "glosses": [
                                            "muž, dopravující ilegálně zboží nebo lidi přes hranici mezi státy"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "008f3b52-31ea-44b8-a167-9532cee88a90",
                                                "sense_id": "ec170e65-c0e9-3180-ac31-24bd707258e9",
                                                "text": "„Odvedli mě třeba ze Súdánu do Libye a zavolali příbuzným o peníze. Když jsem se dostal do Itálie, řekli si o další,“ popisuje Etiopan propracovaný systém, jak pašeráci vydělávají na zoufalé situaci běženců."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
