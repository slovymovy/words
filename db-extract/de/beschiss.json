                    {
                        "translation_id": "be47ea3b-f666-47a5-9e5a-751f0b15937a",
                        "source_entry_id": "bf5a9ea7-fc73-31dc-8bd0-12ee2cfbbf61",
                        "source_sense_id": "35f009a7-250e-3631-91e4-b1c119fcd935",
                        "source_sense_description": "umgangssprachlich, salopp: bewusste Täuschung",
                        "target_lang_word": "arnaque",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
