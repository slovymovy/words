                        ],
                        "form": "das Reiseziel"
                    },
                    {
                        "form_id": "0c87d73c-d8d7-42cf-862e-8be01b350b05",
                        "entry_id": "c2093e35-8d16-3d0b-8ce2-681a6843880b",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Reiseziele"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5f605e62-2cbd-39dd-90a2-208244bf5af5",
                        "entry_id": "c2093e35-8d16-3d0b-8ce2-681a6843880b",
                        "glosses": [
                            "der Bestimmungsort, an den eine Reise führen soll"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b47e0156-0575-4dfa-bf94-52381886d49e",
                                "sense_id": "5f605e62-2cbd-39dd-90a2-208244bf5af5",
                                "text": "Nach sechs Stunden hatten sie ihr Reiseziel erreicht."
                            },
                            {
                                "example_id": "7149d7e0-5b02-48e8-af0d-dd18b5c62edd",
                                "sense_id": "5f605e62-2cbd-39dd-90a2-208244bf5af5",
                                "text": "„ Wird infolge einer Zugverspätung der Anschluß an einen anderen Zug versäumt oder fällt ein Zug ganz oder auf Teilstrecken aus und will der Reisende seine Reise fortsetzen, so hat die Eisenbahn, soweit möglich, den Reisenden mit seinem Hand- und Reisegepäck ohne Preiszuschlag mit einem Zug zu befördern, der auf der gleichen oder auf einer anderen Linie der am ursprünglichen Beförderungsweg beteiligten Eisenbahnen zum selben Bestimmungsbahnhof fährt und der es dem Reisenden ermöglicht, sein Reiseziel mit der geringsten Verspätung zu erreichen.“"
                            },
                            {
                                "example_id": "c575996d-edf0-402e-91f6-53751382894d",
                                "sense_id": "5f605e62-2cbd-39dd-90a2-208244bf5af5",
                                "text": "„Island ist ein beliebtes Reiseziel geworden und nicht länger nur ein Traum vieler Menschen.“"
                            },
                            {
                                "example_id": "27edc433-45d5-4538-b1a4-cf4ce1eb4d6d",
                                "sense_id": "5f605e62-2cbd-39dd-90a2-208244bf5af5",
                                "text": "„Für viele ältere Autoren, und auch ein paar nicht ganz so alte, ist Afrika das letzte Reiseziel gewesen.\""
                            },
                            {
                                "example_id": "22eb3839-bc81-4b31-a618-dba61264d67d",
                                "sense_id": "5f605e62-2cbd-39dd-90a2-208244bf5af5",
                                "text": "„Sein Stolz hatte ihn gewiß davon abgehalten, mir ein anderes Reiseziel anzuraten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
