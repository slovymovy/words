                        "examples": [
                            {
                                "example_id": "79310b3e-14ea-41a7-9976-38a22f3549e6",
                                "sense_id": "5730fb15-b675-36ed-9827-c92cacb44888",
                                "text": "De Hemsterhuisbrug werd in 1885 gebouwd door de Haagse ijzergieterij en pletterij L.I. Enthoven & Cie. Datzelfde bedrijf was onder meer verantwoordelijk voor de pilaren op station Holland Spoor en de voetgangersbrug bij het centraal station in de stad."
                            },
                            {
                                "example_id": "5885d7a7-f1b1-4dac-85cb-3011962bfa3c",
                                "sense_id": "5730fb15-b675-36ed-9827-c92cacb44888",
                                "text": "Bij een ijzergieterij in het Gelderse Terborg heeft een grote brand gewoed. Een bak met tweehonderd liter bijna pure alcohol vloog in brand. Twee mensen raakten gewond."
                            }
