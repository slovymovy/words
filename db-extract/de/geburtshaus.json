                                    {
                                        "sense_id": "5f11eed0-5d53-3941-bdb8-e032e01f3fef",
                                        "entry_id": "b910c431-6e87-3862-b1d9-6c24bc287b30",
                                        "glosses": [
                                            "The location where a person was born."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25eef6d2-0838-4fa2-9155-6f36c59efc29",
                                                "sense_id": "5f11eed0-5d53-3941-bdb8-e032e01f3fef",
                                                "text": "Portsmouth was Charles Dickens’ birthplace."
                                            },
                                            {
                                                "example_id": "62a5faae-1043-4e19-b504-ff8b2e5c4643",
                                                "sense_id": "5f11eed0-5d53-3941-bdb8-e032e01f3fef",
                                                "text": "At Scotswood, the main line crosses to the south bank of the Tyne, but an alternative route, on the north side of the river, used by a few trains, rejoins the Carlisle line beyond North Wylam, the birthplace of George Stephenson."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b0286a01-cc12-33e3-864f-f72851ae1475",
                                        "entry_id": "b910c431-6e87-3862-b1d9-6c24bc287b30",
                                        "glosses": [
                                            "The location where something was created or devised."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "293563c2-e103-4ee1-bb08-8612125bf65d",
                                                "sense_id": "b0286a01-cc12-33e3-864f-f72851ae1475",
                                                "text": "Coney Island was the birthplace of the hot dog."
                                            },
                                            {
                                                "example_id": "09eb9a65-96bf-43ad-a146-8c8a20d70b7e",
                                                "sense_id": "b0286a01-cc12-33e3-864f-f72851ae1475",
                                                "text": "Most foreigners who have heard of Bhutan know two things: the country charges international visitors a $100/day sustainable development fee (aka tourist tax), and that it is the birthplace of the Gross National Happiness Index, a system intended to look after the well-being of citizens and the environment."
                                            }
                                        ]
                                    }
                                ]
