                                        "sense_id": "822631d9-86c9-395c-9b65-a51902b60321",
                                        "entry_id": "15b22536-06bb-3d93-bca9-7b99542249f0",
                                        "glosses": [
                                            "A person from Rwanda or of Rwandan descent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2862242-cb0f-428d-a3a2-5e7fbe019c44",
                                                "sense_id": "822631d9-86c9-395c-9b65-a51902b60321",
                                                "text": "But for so many, this city remains tied to the genocide, which saw between 800,000 and one million Rwandans murdered in a brutal tribal conflict in 1994."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Rwandan",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "67ea30ed-ec7e-3550-a6d5-2bd8f976eb3b",
                                        "entry_id": "93bf29ca-cf8c-322e-a8b2-24057a473f95",
                                        "glosses": [
                                            "Of, from, or pertaining to Rwanda, the Rwandan people or language."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3fa7b4fe-3b46-4c8d-bb9e-500aea117633",
                                                "sense_id": "67ea30ed-ec7e-3550-a6d5-2bd8f976eb3b",
                                                "text": "This is known as Umuganda, which translates as “coming together in common purpose.” It’s an old Rwandan concept, which was officially revived in its current, compulsory form in 2009."
                                            },
                                            {
                                                "example_id": "c32e12ff-9c82-4fc8-ae30-e634d65d576e",
                                                "sense_id": "67ea30ed-ec7e-3550-a6d5-2bd8f976eb3b",
                                                "text": "Rwanda is in the early stages of talks to receive immigrants deported from the United States, Rwandan Foreign Minister Olivier Nduhungirehe said on television late on Sunday."
                                            }
                                        ]
                                    }
                                ]
