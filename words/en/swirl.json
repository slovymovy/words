{
    "word_family": [
        "swirly",
        "swirler",
        "unswirled"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3a6fca95-1b47-3769-8ba2-5ef24778a701",
                    "sense_definition": "To move or cause to move in a twisting or spiraling pattern.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "circular_motion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I <w>swirled</w> my brush around in the paint to mix the colors together.",
                            "target_lang_translations": {
                                "ru": "Я <w>поводил</w> кистью в краске, чтобы смешать цвета.",
                                "zh": "我把画笔在颜料里<w>搅动</w>，把颜色混合在一起。"
                            }
                        },
                        {
                            "text": "The autumn leaves <w>swirled</w> in the wind across the empty playground.",
                            "target_lang_translations": {
                                "ru": "Осенние листья <w>кружились</w> на ветру по пустой детской площадке.",
                                "zh": "秋叶在空荡荡的操场上随风<w>盘旋</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "whirl",
                        "spin",
                        "twirl",
                        "circle",
                        "rotate"
                    ],
                    "common_phrases": [
                        "swirl around",
                        "swirl in the wind"
                    ],
                    "target_lang_definitions": {
                        "ru": "Двигаться или заставлять что-либо двигаться по спирали или кругу.",
                        "zh": "指以旋转或螺旋的方式移动或使某物移动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кружиться",
                                "target_lang_sense_clarification": "в воздухе или воде"
                            },
                            {
                                "target_lang_word": "размешивать",
                                "target_lang_sense_clarification": "круговыми движениями"
                            },
                            {
                                "target_lang_word": "вихриться",
                                "target_lang_sense_clarification": "о ветре или пыли"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "旋转",
                                "target_lang_sense_clarification": "物体或液体做圆周运动"
                            },
                            {
                                "target_lang_word": "搅动",
                                "target_lang_sense_clarification": "用工具在液体中做圆周运动"
                            },
                            {
                                "target_lang_word": "盘旋",
                                "target_lang_sense_clarification": "指风或叶子在空中飞舞"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "15cb8eb4-2d0e-39fa-9d1c-6f8ee4eb0a98",
                    "sense_definition": "To circulate or spread rapidly, especially regarding rumors, thoughts, or news.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "circulation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Rumors began to <w>swirl</w> about the company's potential bankruptcy after the CEO resigned.",
                            "target_lang_translations": {
                                "ru": "После отставки генерального директора начали <w>ползти</w> слухи о возможном банкротстве компании.",
                                "zh": "首席执行官辞职后，关于公司可能破产的传言开始<w>流传</w>开来。"
                            }
                        },
                        {
                            "text": "Many questions <w>swirled</w> in her mind as she waited for the test results.",
                            "target_lang_translations": {
                                "ru": "В её голове <w>роилось</w> множество вопросов, пока она ждала результатов анализов.",
                                "zh": "等待检查结果时，许多问题在她脑海中<w>萦绕</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "circulate",
                        "spread",
                        "propagate"
                    ],
                    "common_phrases": [
                        "rumors swirl",
                        "controversy swirls"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быстро распространяться или циркулировать (о слухах, мыслях или новостях).",
                        "zh": "指迅速传播或流传，尤指谣言、想法或新闻。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "роиться",
                                "target_lang_sense_clarification": "о мыслях"
                            },
                            {
                                "target_lang_word": "циркулировать",
                                "target_lang_sense_clarification": "о слухах"
                            },
                            {
                                "target_lang_word": "ползти",
                                "target_lang_sense_clarification": "о слухах"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "流传",
                                "target_lang_sense_clarification": "指谣言或消息在人群中传播"
                            },
                            {
                                "target_lang_word": "萦绕",
                                "target_lang_sense_clarification": "指想法或问题在脑海中挥之不去"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "60fa8e2e-589e-390c-a0dc-010ada030710",
                    "sense_definition": "To be arranged in a twist, spiral, or whorl shape.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "shape_arrangement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patterns <w>swirled</w> across the marble floor in beautiful shades of blue.",
                            "target_lang_translations": {
                                "ru": "Узоры <w>извивались</w> по мраморному полу красивыми оттенками синего.",
                                "zh": "大理石地面上的图案以美丽的蓝色调<w>盘绕</w>延伸。"
                            }
                        },
                        {
                            "text": "Her hair <w>swirled</w> elegantly into a bun at the back of her head.",
                            "target_lang_translations": {
                                "ru": "Её волосы были элегантно <w>закручены</w> в пучок на затылке.",
                                "zh": "她的头发优雅地<w>卷曲</w>盘在脑后。"
                            }
                        }
                    ],
                    "synonyms": [
                        "coil",
                        "spiral"
                    ],
                    "target_lang_definitions": {
                        "ru": "Располагаться в форме спирали, завитка или воронки.",
                        "zh": "指呈扭曲、螺旋或漩涡状排列。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "извиваться",
                                "target_lang_sense_clarification": "о линиях или узорах"
                            },
                            {
                                "target_lang_word": "закручиваться",
                                "target_lang_sense_clarification": "в форме спирали"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "盘绕",
                                "target_lang_sense_clarification": "指形状呈螺旋状"
                            },
                            {
                                "target_lang_word": "卷曲",
                                "target_lang_sense_clarification": "指线条或头发的形状"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3e5ac45d-bd25-3dd6-a932-8cabd6186e48",
                    "sense_definition": "To engage in interracial dating or relationships.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "interracial_mingling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The documentary explored why some people choose to <w>swirl</w> in modern urban environments.",
                            "target_lang_translations": {
                                "ru": "В документальном фильме исследовалось, почему некоторые люди выбирают <w>межрасовые отношения</w> в современной городской среде.",
                                "zh": "这部纪录片探讨了为什么有些人选择在现代城市环境中进行<w>跨种族恋爱</w>。"
                            }
                        },
                        {
                            "text": "They have been <w>swirling</w> for years and recently decided to get married.",
                            "target_lang_translations": {
                                "ru": "Они <w>встречались</w> много лет, несмотря на разное происхождение, и недавно решили пожениться.",
                                "zh": "他们<w>跨种族交往</w>多年，最近决定结婚。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "informal usage regarding interracial dating"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вступать в межрасовые романтические отношения (сленг).",
                        "zh": "指进行跨种族约会或恋爱关系（俚语）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "встречаться",
                                "target_lang_sense_clarification": "с представителем другой расы"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "跨种族恋爱",
                                "target_lang_sense_clarification": "指不同种族背景的人建立恋爱关系"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "bc7a7764-062f-302e-9408-2e652fec1fc8",
                    "sense_definition": "A twist, coil, or spiral shape of something.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "shape_arrangement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cake was decorated with a beautiful <w>swirl</w> of chocolate frosting.",
                            "target_lang_translations": {
                                "ru": "Торт был украшен красивым <w>завитком</w> шоколадной глазури.",
                                "zh": "蛋糕上装饰着漂亮的巧克力糖霜<w>卷纹</w>。"
                            }
                        },
                        {
                            "text": "She noticed a small <w>swirl</w> of smoke rising from the extinguished candle.",
                            "target_lang_translations": {
                                "ru": "Она заметила маленькую <w>струйку</w> дыма, поднимающуюся от погасшей свечи.",
                                "zh": "她注意到熄灭的蜡烛上升起一缕细小的烟雾<w>漩涡</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "coil",
                        "spiral",
                        "curl",
                        "twist",
                        "loop",
                        "whorl"
                    ],
                    "common_phrases": [
                        "swirl of frosting",
                        "swirl of color"
                    ],
                    "target_lang_definitions": {
                        "ru": "Спиралевидная форма, завиток или кольцо чего-либо.",
                        "zh": "指某物的扭曲、盘绕或螺旋形状。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "завиток",
                                "target_lang_sense_clarification": "спиралевидная форма"
                            },
                            {
                                "target_lang_word": "спираль",
                                "target_lang_sense_clarification": "форма узора"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "漩涡状",
                                "target_lang_sense_clarification": "指装饰或图案的形状"
                            },
                            {
                                "target_lang_word": "卷纹",
                                "target_lang_sense_clarification": "指物体表面的螺旋花纹"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "62ffda6b-12e0-3b9e-bb74-427488db4805",
                    "sense_definition": "A whirling motion or an eddy in a fluid.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "circular_motion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The boat was caught in a dangerous <w>swirl</w> of water near the rocks.",
                            "target_lang_translations": {
                                "ru": "Лодка попала в опасный <w>водоворот</w> рядом со скалами.",
                                "zh": "小船在岩石附近被卷入了一个危险的<w>漩涡</w>中。"
                            }
                        },
                        {
                            "text": "A sudden <w>swirl</w> of dust blinded the hikers for a few seconds.",
                            "target_lang_translations": {
                                "ru": "Внезапный <w>вихрь</w> пыли на несколько секунд ослепил туристов.",
                                "zh": "一阵突如其来的尘土<w>旋风</w>让徒步旅行者瞬间失明了几秒钟。"
                            }
                        }
                    ],
                    "synonyms": [
                        "eddy",
                        "vortex",
                        "whirlpool"
                    ],
                    "common_phrases": [
                        "swirl of water",
                        "swirl of dust"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вращательное движение или водоворот в жидкости или газе.",
                        "zh": "指流体中的旋转运动或漩涡。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "водоворот",
                                "target_lang_sense_clarification": "круговое движение воды"
                            },
                            {
                                "target_lang_word": "вихрь",
                                "target_lang_sense_clarification": "движение воздуха или пыли"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "漩涡",
                                "target_lang_sense_clarification": "液体或气体的旋转运动"
                            },
                            {
                                "target_lang_word": "旋风",
                                "target_lang_sense_clarification": "指空气或尘土的旋转"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6289a1bf-440c-39e5-af31-13e5d03e5c7c",
                    "sense_definition": "The practice of interracial dating or mingling.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "interracial_mingling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She told the boy she wasn't down with the <w>swirl</w> and walked away.",
                            "target_lang_translations": {
                                "ru": "Она сказала парню, что не одобряет <w>межрасовые свидания</w>, и ушла.",
                                "zh": "她告诉那个男孩她不接受<w>跨种族交往</w>，然后走开了。"
                            }
                        },
                        {
                            "text": "The blog post discussed the social dynamics of the <w>swirl</w> in the fashion industry.",
                            "target_lang_translations": {
                                "ru": "В посте блога обсуждалась социальная динамика <w>межрасового общения</w> в индустрии моды.",
                                "zh": "那篇博文讨论了时尚界中<w>跨种族交往</w>的社会动态。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "informal usage regarding interracial dating"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Практика межрасовых свиданий или общения (сленг).",
                        "zh": "指跨种族约会或交往的社会实践（俚语）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "межрасовые отношения",
                                "target_lang_sense_clarification": "социальный контекст"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "跨种族交往",
                                "target_lang_sense_clarification": "指不同种族背景的人之间的社交或恋爱实践"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "220f7e47-606f-345a-a29c-dcd48d372779",
                    "sense_definition": "The upward rushing of a fish through the water to take bait.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "fishing_terms",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fisherman saw a massive <w>swirl</w> on the surface as the trout struck.",
                            "target_lang_translations": {
                                "ru": "Рыбак увидел мощный <w>всплеск</w> на поверхности, когда форель заглотила наживку.",
                                "zh": "当鳟鱼咬钩时，渔夫看到水面上激起了一大片<w>水花</w>。"
                            }
                        },
                        {
                            "text": "A sudden <w>swirl</w> in the reeds indicated that a large predator was hunting.",
                            "target_lang_translations": {
                                "ru": "Внезапное <w>движение воды</w> в камышах указывало на то, что охотится крупный хищник.",
                                "zh": "芦苇丛中突然的<w>翻腾</w>表明有大型捕食者正在狩猎。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "specific to angling/fishing contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Резкое движение рыбы к поверхности воды за наживкой.",
                        "zh": "指鱼类为捕食诱饵而冲向水面的动作。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "всплеск",
                                "target_lang_sense_clarification": "от рыбы на поверхности"
                            },
                            {
                                "target_lang_word": "бурун",
                                "target_lang_sense_clarification": "след на воде"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "水花",
                                "target_lang_sense_clarification": "鱼类冲出水面时激起的波纹"
                            },
                            {
                                "target_lang_word": "翻腾",
                                "target_lang_sense_clarification": "指鱼类在水下活动引起的水面波动"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}