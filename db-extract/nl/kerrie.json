                                        "entry_id": "c3a06928-adfa-3245-999f-822204f63a5f",
                                        "glosses": [
                                            "To cover (a distance); (of a projectile) to traverse (its range)."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ea7a6cb4-a1fb-41e9-a53b-99676037136e",
                                                "sense_id": "b134bc8e-b5af-39f5-86b9-25cf09f55d02",
                                                "text": "I am not hee that can ... by midnight leape my horse, curry seauen miles."
                                            },
                                            {
                                                "example_id": "72335e1f-a1ae-4115-8db2-e61f9ca11ac5",
                                                "sense_id": "b134bc8e-b5af-39f5-86b9-25cf09f55d02",
                                                "text": "All these shots shall curry or finish their ranges in times equal to each other."
                                            }
