    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e0c61104-6759-3c56-ae2b-b188898d15de",
                    "sense_definition": "The actual object, person, or concept in the real world that a word or phrase points to.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "linguistics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the sentence 'The cat is sleeping', the <w>referent</w> of the word 'cat' is the specific animal currently resting on the rug."
                        },
                        {
                            "text": "Linguists often study how a <w>referent</w> is identified by different speakers in various contexts."
                        }
                    ],
                    "synonyms": [
                        "denotatum"
                    ],
                    "common_phrases": [
                        "identify the referent",
                        "specific referent"
                    ]
                },
                {
                    "sense_id": "93f3c1ad-515a-3a30-8489-0b11dd73eed4",
                    "sense_definition": "Something that is being pointed to or mentioned in a text or discussion.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "linguistics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The document contains a clear <w>referent</w> to the previous agreement made by the committee."
                        },
                        {
                            "text": "Every footnote in the academic paper provides a <w>referent</w> to the source of the data."
                        }
                    ],
                    "synonyms": [
                        "reference"
                    ],
                    "common_phrases": [
                        "clear referent",
                        "provide a referent"
                    ]
                }
            ]
        }
