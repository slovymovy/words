                        "form": "gedrochtelijkers"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3cd5315e-8060-3f51-8fcc-dabd883979c4",
                        "entry_id": "25ca32fc-bbff-36e8-ad72-75ad8a9391f3",
                        "glosses": [
                            "een heel lelijke lichaamsbouw hebbend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6081c95e-1d47-410b-bc85-3ab0e1d5cb53",
                                "sense_id": "3cd5315e-8060-3f51-8fcc-dabd883979c4",
                                "text": "Hij was dat jaar zo dik geworden dat hij gedrochtelijk zou zijn geweest als hij niet zo lang was geweest, niet zulke machtige ledematen had bezeten en niet zo sterk was geweest dat hij zijn dikte met kennelijk gemak droeg."
                            },
                            {
                                "example_id": "5bcfd62f-3a90-4854-b361-38d634383636",
                                "sense_id": "3cd5315e-8060-3f51-8fcc-dabd883979c4",
                                "text": "Maar het bleek lang geen onschuldig kinderfeest. Showgirls en als kinderen en jongvolwassenen ogende mensen verdwenen achter genummerde deuren. Daar wachtten hun allerlei gedrochtelijke wezens."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0770403c-3bd9-43f2-9677-20f7df9d9524",
                        "source_entry_id": "25ca32fc-bbff-36e8-ad72-75ad8a9391f3",
                        "source_sense_id": "3cd5315e-8060-3f51-8fcc-dabd883979c4",
                        "source_sense_description": "een heel lelijke lichaamsbouw hebbend",
                        "target_lang_word": "monstrous",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "monstrous",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7f51922f-09a3-3871-9d7e-df1f4bda3e6d",
                                        "entry_id": "608075af-17ca-3564-a70e-491eb9ebc7ef",
                                        "glosses": [
                                            "Hideous or frightful."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a02cb996-04c2-4f36-b82e-63829adc83a5",
                                                "sense_id": "7f51922f-09a3-3871-9d7e-df1f4bda3e6d",
                                                "text": "So bad a death argues a monstrous life."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a3a08c21-5392-33f4-ac2d-6bfff155d249",
                                        "entry_id": "608075af-17ca-3564-a70e-491eb9ebc7ef",
                                        "glosses": [
                                            "Enormously large."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f9e1263-b5b3-45e0-9786-895aef863578",
                                                "sense_id": "a3a08c21-5392-33f4-ac2d-6bfff155d249",
                                                "text": "a monstrous height"
                                            },
                                            {
                                                "example_id": "6fc90a4a-698b-45d5-abcd-f0b5fc357ec3",
                                                "sense_id": "a3a08c21-5392-33f4-ac2d-6bfff155d249",
                                                "text": "The chiding billovv ſeemes to pelt the cloudes, / The vvinde ſhak'd ſurge, vvith high and monſtrous mayne, / Seemes to caſt vvater, on the burning Beare, […]"
                                            },
                                            {
                                                "example_id": "2772c079-3f99-4cb7-b7a7-1c385a0f331a",
                                                "sense_id": "a3a08c21-5392-33f4-ac2d-6bfff155d249",
                                                "text": "Possibly monster pumpkins may become still more monstrous by the shoots being ringed, and so may other vegetables and fruits where quality is of less importance than mere size."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7667d022-84a2-3ffa-a681-7a435c348877",
                                        "entry_id": "608075af-17ca-3564-a70e-491eb9ebc7ef",
                                        "glosses": [
                                            "Freakish or grotesque."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "45df9910-880e-4942-a050-eaf8ea2568c2",
                                                "sense_id": "7667d022-84a2-3ffa-a681-7a435c348877",
                                                "text": "The irregular and monstrous births"
                                            },
                                            {
                                                "example_id": "b318bb71-e8a6-469a-b502-ab45ede02d3f",
                                                "sense_id": "7667d022-84a2-3ffa-a681-7a435c348877",
                                                "text": "He, therefore, that refuses to do good to them whom he is bound to love […] is unnatural and monstrous in his affections."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b4358430-2825-334c-808e-5cf1210cb660",
                                        "entry_id": "608075af-17ca-3564-a70e-491eb9ebc7ef",
                                        "glosses": [
                                            "Of, or relating to a mythical monster; full of monsters."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c7ffbfe8-8ebd-4250-91fa-ca12dfb84527",
                                                "sense_id": "b4358430-2825-334c-808e-5cf1210cb660",
                                                "text": "Where thou, perhaps, under the whelming tide / Visitest the bottom of the monstrous world."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e2ac623-9f64-39ff-9e35-58c871f5fa09",
                                        "entry_id": "608075af-17ca-3564-a70e-491eb9ebc7ef",
                                        "glosses": [
                                            "Marvellous; exceedingly strange; fantastical."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6569f36a-261b-462f-960c-77612311d486",
                                                "sense_id": "1e2ac623-9f64-39ff-9e35-58c871f5fa09",
                                                "text": "The whole story was monstrous, and only worthy of the superstitious days in which it was written."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "908e4e1b-4912-3dc0-8293-f3a4d9450c10",
                                        "entry_id": "608075af-17ca-3564-a70e-491eb9ebc7ef",
                                        "glosses": [
                                            "A severe insult that is used to describe a disabled person."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "offensive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
