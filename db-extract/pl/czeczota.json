                "senses": [
                    {
                        "sense_id": "e41cb2aa-e491-34b7-b028-91fcf9b35d69",
                        "entry_id": "ef094b9c-24c5-3660-98e1-04bd24d35546",
                        "glosses": [
                            "drewno pochodzące głównie z brzozy lub topoli o splątanym układzie włókien, stosowane jako okleina albo materiał do wyrobu niewielkich przedmiotów ozdobnych"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8518342-c3e8-487b-9998-1573f8b8a217",
                                "sense_id": "e41cb2aa-e491-34b7-b028-91fcf9b35d69",
                                "text": "Dekoracyjnie splecione słoje, jasne i ciemne oczka, plamki oraz żyłki charakterystyczne dla czeczoty powstają m.in. w wyniku choroby pnia drzewa."
                            },
                            {
                                "example_id": "b8d44b96-8d9b-41b9-9fa0-2abec2423362",
                                "sense_id": "e41cb2aa-e491-34b7-b028-91fcf9b35d69",
                                "text": "Oni z Panterą założyli w izbie warsztat stolarski i obrabiali brzozową czeczotę na skrzynki, które Pantera fabrykował bardzo kunsztownie zimą."
                            }
                        ],
