                "senses": [
                    {
                        "sense_id": "956d020b-df39-3b97-a23a-22d39d509890",
                        "entry_id": "ccf0e848-5aa7-3503-b0f8-2c04fbd3b4b0",
                        "glosses": [
                            "zakład wytwarzający alkohol etylowy metodą fermentacyjną, na ogół z surowców skrobiowych"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b94a3b2-ef81-4fa5-b346-01a8377dc130",
                                "sense_id": "956d020b-df39-3b97-a23a-22d39d509890",
                                "text": "Oskar Rudziński rozbudował gospodarstwo: przebudował stawy, w których hodowano ryby, odwodnił ziemię, zbudował cegielnię i gorzelnię, założył bażantarnię."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ff8a5116-f0c5-4d80-82b4-74eff1e0c2ef",
                        "source_entry_id": "ccf0e848-5aa7-3503-b0f8-2c04fbd3b4b0",
                        "source_sense_id": "956d020b-df39-3b97-a23a-22d39d509890",
                        "target_lang_word": "distillery",
