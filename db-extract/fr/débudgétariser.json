                "senses": [
                    {
                        "sense_id": "c5920e82-8ff1-3e88-aace-620c927bde79",
                        "entry_id": "95841e64-d325-3c55-a22b-18b4f0c05d36",
                        "glosses": [
                            "Sortir du budget."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9eb40955-15bb-4298-9114-6e8775d03847",
                                "sense_id": "c5920e82-8ff1-3e88-aace-620c927bde79",
                                "text": "L’option retenue consiste à débudgétariser la construction des autoroutes, dont le financement a été transféré à ÁAK, en lui demandant de chercher des financements sur le marché financier par le biais d’émissions obligataires pour 25 ans et plus (voir financement)."
                            },
                            {
                                "example_id": "da10a3ef-81b0-46bb-b97c-d7e34119f20f",
                                "sense_id": "c5920e82-8ff1-3e88-aace-620c927bde79",
                                "text": "Cette décision prise au Palais revenait à débudgétariser les bénéfices de la privatisation, à l’insu de tout contrôle gouvernemental ou ministériel."
                            },
                            {
                                "example_id": "eed35267-e79d-488f-ac59-56f3e1205d42",
                                "sense_id": "c5920e82-8ff1-3e88-aace-620c927bde79",
                                "text": "Lorsque des collectivités territoriales et l’État créent une association selon la loi de 1901 pour débudgétariser une activité et, comme elles le reconnaissent souvent, sortir des contraintes de la comptabilité publique et de la fonction publique, pour intervenir dans un cadre de droit privé, un tel comportement relève des prévisions de cet article 3 de la loi du 1ᵉʳ juillet 1901."
                            }
                        ]
                    }
                ],
