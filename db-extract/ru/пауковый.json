                                                "sense_id": "94197b02-76f1-3488-ab27-f3b09ff30a97",
                                                "text": "2002, Katharine Gasparini, Cranberry and vanilla ice cream spider, recipe in Cool Food, page 339."
                                            }
                                        ]
                                    },
