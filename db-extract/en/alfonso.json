                                "target_senses": [
                                    {
                                        "sense_id": "e14fedd0-b80a-3f4f-845e-5f393462c8d3",
                                        "entry_id": "dbe693d8-d9ff-3bf5-ba76-d492aa4141dd",
                                        "glosses": [
                                            "Prénom masculin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "31f6e528-5a0d-4ba2-bd4f-1eff7d722b5d",
                                                "sense_id": "e14fedd0-b80a-3f4f-845e-5f393462c8d3",
                                                "text": "Alphonse lui-même, qui semblait encore le meilleur de tous, eh bien ! ma chère, il s’est brouillé avec moi pour une misère."
                                            },
                                            {
                                                "example_id": "fdf3327a-a04e-407b-9c21-6b490e244198",
                                                "sense_id": "e14fedd0-b80a-3f4f-845e-5f393462c8d3",
                                                "text": "« Inscrivez une nouvelle victoire contre le crime au tableau du capitaine Opossum Alphonse.\n— C’est exceptionnel Monsieur. »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3e95d21d-0798-32e6-a0eb-62cdafe8566e",
                                        "entry_id": "dbe693d8-d9ff-3bf5-ba76-d492aa4141dd",
                                        "glosses": [
                                            "Homme vivant de la prostitution."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ad1eff1-2cba-46c7-b184-2bca3aac8758",
                                                "sense_id": "3e95d21d-0798-32e6-a0eb-62cdafe8566e",
                                                "text": "Il y a, dans le monde, des Alphonses de bien des genres et des catégories."
                                            },
                                            {
                                                "example_id": "ab0621f3-722c-46ea-95cf-3035c0e66b44",
                                                "sense_id": "3e95d21d-0798-32e6-a0eb-62cdafe8566e",
                                                "text": "Il est probable que la déférence montrée par Nguyen Van Chung ou Nguyen Van Truoc à l’égard du ly truong de son village ou des autorités mandarinales ne sera pas accrue du fait de sa fréquentation en France des Alphonses et des rôdeuses."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
