                "senses": [
                    {
                        "sense_id": "07b4a1b8-81a5-3b95-921c-b5b8ccedc716",
                        "entry_id": "e93e3994-90bf-39ba-8172-10f15d564be0",
                        "glosses": [
                            "Exprimer avec des trémolos, accompagner de trémolos."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "abecb19a-791a-4204-a387-f6f2988c501e",
                                "sense_id": "07b4a1b8-81a5-3b95-921c-b5b8ccedc716",
                                "text": "Il n’y manque qu’une chose : l’orchestre destiné à trémoliser les entrées du traître et à ponctuer noblement les sorties du héros."
                            },
                            {
                                "example_id": "250a0726-e890-4208-927b-726d6b7730b7",
                                "sense_id": "07b4a1b8-81a5-3b95-921c-b5b8ccedc716",
                                "text": "On trémolise quand on parle des pauvres, des exclus, des handicapés."
                            },
                            {
                                "example_id": "2318638e-3f3a-4f7a-a476-cd4721649776",
                                "sense_id": "07b4a1b8-81a5-3b95-921c-b5b8ccedc716",
                                "text": "C'est ce que Sarkozy leur avait suggéré dans son discours de Dakar lequel a fait longuement trémoliser les bonnes âmes de la gauche française et au delà."
                            }
                        ]
                    }
