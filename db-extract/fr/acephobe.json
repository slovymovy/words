                                        "entry_id": "ed20bab9-9219-3450-974a-b825531d58c6",
                                        "glosses": [
                                            "Characteristic of or exhibiting acephobia."
                                        ],
                                        "tags": [
                                            "neologism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4e5f1d7d-d4c5-49fb-81ea-954544cfb333",
                                                "sense_id": "8f48c7e9-2518-37ad-bd36-d1aa9d8984ff",
                                                "text": "“Cold” and “emotionless” are simply acephobic and ignorant."
                                            },
                                            {
                                                "example_id": "d7d6fbe6-0af3-4f3b-811c-c158a93dc88e",
                                                "sense_id": "8f48c7e9-2518-37ad-bd36-d1aa9d8984ff",
                                                "text": "The relationship between these two parts of me is underpinned by homophobic and acephobic assumptions."
                                            },
                                            {
                                                "example_id": "02dd6979-b646-44c1-a292-3039d5914b60",
                                                "sense_id": "8f48c7e9-2518-37ad-bd36-d1aa9d8984ff",
                                                "text": "Even those in the LGBTQ+ community can be acephobic."
                                            }
                                        ]
                                    }
