                    {
                        "sense_id": "b27c57bd-4aad-36f2-b35e-b856e692f0af",
                        "entry_id": "33a52d22-63eb-3ba7-962c-ad9768b09f4d",
                        "glosses": [
                            "Gestalt aus der Bibel, die angeblich von den Toten auferweckt wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d9a4dfd3-5b73-41f5-9e6e-375f8cc1229f",
                                "sense_id": "b27c57bd-4aad-36f2-b35e-b856e692f0af",
                                "text": "„’ch glaub, dem Lazarus war dann genauso zum Heulen, wie er nach vier Tagen Grabesruh wieder in dem Jammertal hier gelandet iss.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
