                ],
                "senses": [
                    {
                        "sense_id": "cf98148c-8d44-3586-b991-d0c69becf57e",
                        "entry_id": "29a6563a-4b6c-3516-98a4-eb418012476d",
                        "glosses": [
                            "Déception causée par un insuccès."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0aa85b47-bf97-4613-afeb-6c0509a3a08b",
                                "sense_id": "cf98148c-8d44-3586-b991-d0c69becf57e",
                                "text": "Là dessus il conta, sans en rien oublier,\nToute sa déconvenuë,\nPuis vint à celle du Roy."
                            },
                            {
                                "example_id": "4357c81c-d2ce-43e5-9a01-049e36c42b60",
                                "sense_id": "cf98148c-8d44-3586-b991-d0c69becf57e",
                                "text": "Je pourrai me permettre d’aller au théâtre rire de mes propres déconvenues, ou bien chercher mon lait chez le boutiquier du coin sans craindre les badauds."
                            },
                            {
                                "example_id": "631fa15c-c206-4fd7-b2aa-af7e458d45f9",
                                "sense_id": "cf98148c-8d44-3586-b991-d0c69becf57e",
                                "text": "Plus grandiose est le rêve, plus sombre est la déconvenue."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6011ea57-d520-4c2c-b6e8-2077680f0497",
                        "source_entry_id": "29a6563a-4b6c-3516-98a4-eb418012476d",
                        "source_sense_id": "cf98148c-8d44-3586-b991-d0c69becf57e",
                        "target_lang_word": "Enttäuschung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Enttäuschung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ec47896a-7f81-31be-8066-9def4b39adc0",
                                        "entry_id": "97175493-5ecc-3b77-a477-705cf4ae6093",
                                        "glosses": [
                                            "die Nicht-Erfüllung einer Hoffnung, eines Wunsches oder einer Erwartung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "697da005-5203-46ef-b72e-359ed9201a0d",
                                                "sense_id": "ec47896a-7f81-31be-8066-9def4b39adc0",
                                                "text": "Seine Enttäuschung über das Ergebnis war an seinem Gesichtsausdruck abzulesen."
                                            },
                                            {
                                                "example_id": "4738b157-0a1e-466d-8bd9-cd019ce56e85",
                                                "sense_id": "ec47896a-7f81-31be-8066-9def4b39adc0",
                                                "text": "„Zur Enttäuschung gehört die Erkenntnis, dass man sich hat täuschen lassen.“"
                                            },
                                            {
                                                "example_id": "b5cb0803-e666-497a-ac33-6b96d6cf57da",
                                                "sense_id": "ec47896a-7f81-31be-8066-9def4b39adc0",
                                                "text": "„Zu Bolívars Enttäuschung waren die Meinungen gespalten.“"
                                            },
                                            {
                                                "example_id": "84a99927-6c90-4e47-b664-c6947ae8bd66",
                                                "sense_id": "ec47896a-7f81-31be-8066-9def4b39adc0",
                                                "text": "„Doch trotz Barths Enttäuschung beim ersten Anblick Timbuktus ist seine Reise eine Zäsur.“"
                                            },
                                            {
                                                "example_id": "b803400e-4d9c-4d8e-b6d0-61a757bb292b",
                                                "sense_id": "ec47896a-7f81-31be-8066-9def4b39adc0",
                                                "text": "„Ihr Blick spiegelt ihre Enttäuschung wider.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "28674adf-f6c9-3f9e-b11c-73e92fbcf2ae",
                                        "entry_id": "97175493-5ecc-3b77-a477-705cf4ae6093",
                                        "glosses": [
                                            "der Verursacher oder das Objekt der Enttäuschung (nach [1])"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ec8f4e3-b5b7-4d50-9d27-f92ad907c082",
                                                "sense_id": "28674adf-f6c9-3f9e-b11c-73e92fbcf2ae",
                                                "text": "Du warst eine große Enttäuschung!"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "0105db49-33fc-36b1-a944-a33a70d1875d",
                                        "entry_id": "97175493-5ecc-3b77-a477-705cf4ae6093",
                                        "glosses": [
                                            "Aufhebung einer Täuschung"
                                        ],
