                                "target_senses": [
                                    {
                                        "sense_id": "bd058aa0-f18f-360d-9e4e-c89570cef0eb",
                                        "entry_id": "f74161a1-54d2-3dd2-a52f-03cbb787f95b",
                                        "glosses": [
                                            "Art de la combustion des matériaux sans participation de l’oxygène de l’air, pour la préparation de feux d’artifice, de matériaux pour les mines et carrières, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af6e2893-1d63-4395-9902-7668f3d82402",
                                                "sense_id": "bd058aa0-f18f-360d-9e4e-c89570cef0eb",
                                                "text": "Dans un angle, un poêle démantibulé qui, selon toute apparence, a dû être utilisé dans le temps pour des expériences de pyrotechnie."
                                            },
                                            {
                                                "example_id": "2d303136-3864-4184-bafc-bafe7740ada0",
                                                "sense_id": "bd058aa0-f18f-360d-9e4e-c89570cef0eb",
                                                "text": "Rendez-vous incontournable des amoureux de la pyrotechnie, de la musique et de la poésie, le spectacle pyromélodique de Saint-Hilaire-de-Riez a lieu chaque année le troisième vendredi de juillet."
                                            },
                                            {
                                                "example_id": "e4b4599c-2ee3-4615-be7b-7a61f17c7b3f",
                                                "sense_id": "bd058aa0-f18f-360d-9e4e-c89570cef0eb",
                                                "text": "Pyrotechnie militaire, art de préparer les obus, les grenades, les fusées de guerre, etc."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "679d6e89-d955-449d-bcfd-756bfc58fb17",
                        "source_entry_id": "7dee88aa-d1dc-32b0-83af-b001b236fd6e",
