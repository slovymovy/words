                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "respect",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij deden hun werk in alle <w>eer</w> en deugd zonder bijbedoelingen.",
                            "target_lang_translations": {
                                "en": "They did their work in all <w>honor</w> and virtue without ulterior motives."
                            }
                        },
                        {
                            "text": "De ridder beloofde zijn <w>eer</w> te verdedigen tegen de valse beschuldigingen.",
                            "target_lang_translations": {
                                "en": "The knight promised to defend his <w>honor</w> against the false accusations."
                            }
                        }
                    ],
                    "common_phrases": [
                        "in alle eer en deugd"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "vaak gebruikt in vaste uitdrukkingen"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "moral purity or chastity, often in a traditional or ethical context"
                    },
                    "translations": {
