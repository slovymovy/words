                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f9ebe5c-3b37-465d-a218-faa95724a1fe",
                                "sense_id": "9cdb1427-ce13-3b1e-a235-d7ffa0ac103f",
                                "text": "„Die DSU verließ die Allianz, zog nie wieder in einen Land- oder Bundestag ein und existiert heute nur noch als Kleinstpartei im sächsischen Vogtland.“"
                            },
                            {
                                "example_id": "5ab75abc-ce48-40fd-8919-3d33ff41b078",
                                "sense_id": "9cdb1427-ce13-3b1e-a235-d7ffa0ac103f",
                                "text": "„Vonseiten der Kleinstparteien wird das Reformprojekt vor allem mit Blick auf die Urteile des Bundesverfassungsgerichts kritisiert.“"
                            }
                        ],
