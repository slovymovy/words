                        "entry_id": "b0494feb-9ff3-35f8-a874-5043852e69e7",
                        "glosses": [
                            "Tisch zum Schreiben, meist mit Schubfächern zur Aufbewahrung von Schreibmaterialien und Akten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "383f5b64-a536-40e5-be64-5887a2039575",
                                "sense_id": "5757e6ce-dfc7-3833-b2d4-a0b02c227d86",
                                "text": "I write a letter on my escritoire.",
                                "translation": "Ich schreibe einen Brief an meinem Schreibpult."
