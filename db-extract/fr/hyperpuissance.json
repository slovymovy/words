            {
                "entry_id": "9d42407b-6f91-3744-a56e-b290737553f5",
                "word": "hyperpuissance",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "49f3d87a-fbe8-4a95-883d-f658aa79875b",
                        "entry_id": "9d42407b-6f91-3744-a56e-b290737553f5",
                        "tags": [
                            "plural"
                        ],
                        "form": "hyperpuissances"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "941e33c1-61fb-3c98-a157-5a0e2a8cf039",
                        "entry_id": "9d42407b-6f91-3744-a56e-b290737553f5",
                        "glosses": [
                            "Pays ayant la suprématie simultanée dans les principaux domaines (militaire, économique, technologique et culturel)."
                        ],
                        "tags": [],
                        "note": "Généralement utilisé pour décrire la situation des États-Unis d'Amérique après l'effondrement de l'URSS",
                        "examples": [
                            {
                                "example_id": "d184d03c-eb7c-4d3c-a052-023fb7b07b26",
                                "sense_id": "941e33c1-61fb-3c98-a157-5a0e2a8cf039",
                                "text": "La supériorité militaire écrasante de l’hyperpuissance américaine lui permet certes d’organiser ses expéditions sans l’aide de personne. Mais ces opérations punitives ne peuvent fonder un nouvel ordre du monde."
                            },
                            {
                                "example_id": "e806387c-d8cf-4dc0-b7aa-cd2d3dee717c",
                                "sense_id": "941e33c1-61fb-3c98-a157-5a0e2a8cf039",
                                "text": "Après vingt ans d'éclipse au profit de ce qu'on appelait naguère encore l’« hyperpuissance » américaine, voici le grand retour de l'ours russe sur la scène internationale."
                            },
                            {
                                "example_id": "cc8673e2-114c-4dd6-b43d-ccb8e047c1e6",
                                "sense_id": "941e33c1-61fb-3c98-a157-5a0e2a8cf039",
                                "text": "Avec l'effondrement de l'URSS, les États-Unis sont en effet passés du statut de « superpuissance » à celui d'« hyperpuissance », incontestée, hégémonique."
                            }
                        ]
                    },
                    {
                        "sense_id": "e2df954a-b2e4-3714-81b3-1096ea825692",
                        "entry_id": "9d42407b-6f91-3744-a56e-b290737553f5",
                        "glosses": [
                            "Tétration."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "75cba5ce-db35-48b0-bcfb-88c9098021b7",
                        "source_entry_id": "9d42407b-6f91-3744-a56e-b290737553f5",
                        "target_lang_word": "hyperpower",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hyperpower",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3bb99ff8-8eb2-38e6-9204-2e3a0714631a",
                                        "entry_id": "64433f14-369c-3ecf-8acc-ae67b555245e",
                                        "glosses": [
                                            "An international hegemon, more powerful than a superpower."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3fd6c9b2-83fe-49cc-a8e2-44c64a7bd100",
                                                "sense_id": "3bb99ff8-8eb2-38e6-9204-2e3a0714631a",
                                                "text": "“We have entered a period of historical transition in which the United States will become first among equals, rather than […] hyperpower and unquestioned hegemon,” said Timothy Garton Ash, a professor of European studies at Oxford."
                                            },
                                            {
                                                "example_id": "68c289cd-9dfa-4bff-bd1e-55ca9dd66f41",
                                                "sense_id": "3bb99ff8-8eb2-38e6-9204-2e3a0714631a",
                                                "text": "The hegemony of the United States, which Hubert Védrine, a former French foreign minister, liked to call the world’s “hyperpower,” is increasingly questioned, even ignored."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "145b4c55-7ebc-3af3-833a-eec28d8b1ba6",
                                        "entry_id": "64433f14-369c-3ecf-8acc-ae67b555245e",
                                        "glosses": [
                                            "Tetration."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
