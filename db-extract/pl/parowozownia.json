                "translations": [
                    {
                        "translation_id": "2bdd04ea-c7b3-4087-8fe4-8c0298638877",
                        "source_entry_id": "cca37363-222f-38ec-ba9c-a95f6b9a7527",
                        "source_sense_id": "f1dfa7d6-e95e-3b63-bbcd-0269633d85ae",
                        "target_lang_word": "engine shed",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "engine shed",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8735b885-f170-36f4-a2af-c273d6e05a5d",
                                        "entry_id": "47225290-f9f1-3741-8696-b986bccae281",
                                        "glosses": [
                                            "A building for housing railway locomotives."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f26338b8-fcbf-490e-a277-1a434c765f90",
                                                "sense_id": "8735b885-f170-36f4-a2af-c273d6e05a5d",
                                                "text": "Modern engine sheds of advanced design have also been built at Radyr, Abercynon, and elsewhere, whilst other depots have been remodelled and re-equipped."
                                            },
                                            {
                                                "example_id": "85ec328e-836c-4ddc-9715-78c224de4d03",
                                                "sense_id": "8735b885-f170-36f4-a2af-c273d6e05a5d",
                                                "text": "Tons of engine sheds would bite the dust with the end of steam, and many would be demolished with their time in the spotlight over. We're lucky that the one at Didcot survived into preservation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
