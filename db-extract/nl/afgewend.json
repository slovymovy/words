                ],
                "senses": [
                    {
                        "sense_id": "60ab4952-0c7d-3528-a2c5-961fa977b117",
                        "entry_id": "c6eae9b2-0c27-3168-b144-d5593f7b24b5",
                        "glosses": [
                            "dat iets dat voorkomen is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "24ee02bd-c972-41cd-a158-49a39c8b5557",
                                "sense_id": "60ab4952-0c7d-3528-a2c5-961fa977b117",
                                "text": "Nu het afgewende gevaar geen bedreiging meer was, waren alle mensen weer even zorgeloos als vroeger."
                            },
                            {
                                "example_id": "84109267-153e-4b5a-b432-54162c291df9",
                                "sense_id": "60ab4952-0c7d-3528-a2c5-961fa977b117",
                                "text": "'Ze keken elkaar aan, en barstten toen in lachen uit, dronken van de avond die komen ging en van het geweld dat naar hun mening was afgewend, omdat het zich voor hun tijd had afgespeeld, omdat ze geen van beiden een 'ding' hadden, en omdat ze veilig boven op zolder zaten."
                            }
                        ]
                    }
                ],
