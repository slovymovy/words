                                        "entry_id": "98a5feb1-a04d-38a1-bb77-0f760042d864",
                                        "glosses": [
                                            "Any of several medium to large flies, of the family Tabanidae, that suck the blood of mammals (not to be confused with Stomoxys calcitrans, the stable fly, or dog fly)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d4a5b886-7c11-463e-93fc-4e751357bf70",
                                                "sense_id": "34469d8e-6f8f-3c4b-af6c-61f97b5f0c5d",
                                                "text": "It was not a horsefly and it was not a deerfly; it was bigger than either."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
