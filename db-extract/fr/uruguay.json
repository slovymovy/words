        "fr-extract.jsonl": [
            {
                "entry_id": "95770ba3-3bd4-34b8-a51f-846908a627db",
                "word": "Uruguay",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "45dcb7a1-b311-3a27-b496-2ca896483ae4",
                        "entry_id": "95770ba3-3bd4-34b8-a51f-846908a627db",
                        "glosses": [
                            "Pays d’Amérique du Sud situé au sud du Brésil et à l’est de l’Argentine, dont il est séparé par le fleuve éponyme, et dont la capitale est Montevideo."
                        ],
                        "tags": [
                            "Pays"
                        ],
                        "examples": [
                            {
                                "example_id": "1165e2fa-508f-4213-a631-e1a8f12de746",
                                "sense_id": "45dcb7a1-b311-3a27-b496-2ca896483ae4",
                                "text": "Je fus obligé moi-même de parler de mes voyages, parce que, le comte Szémioth m’ayant félicité sur la manière dont je montais à cheval, et ayant dit qu’il n’avait jamais rencontré de ministre ni de professeur qui pût fournir si lestement une traite telle que celle que nous venions de faire, je dus lui expliquer que, chargé par la Société biblique d’un travail sur la langue des Charruas, j’avais passé trois ans et demi dans la république de l’Uruguay, presque toujours à cheval et vivant dans les pampas, parmi les Indiens."
                            },
                            {
                                "example_id": "b895f6e7-625a-4eec-9f16-8e7dd1e9f59d",
                                "sense_id": "45dcb7a1-b311-3a27-b496-2ca896483ae4",
                                "text": "Le président de l’Uruguay, Luis Lacalle Pou, a renoncé à son projet de fondre un vestige nazi, un aigle en bronze issu d’un cuirassé allemand de la Seconde Guerre mondiale, pour en faire une colombe de la paix."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f922e649-9026-4174-865d-046537fb0807",
                        "source_entry_id": "95770ba3-3bd4-34b8-a51f-846908a627db",
                        "source_sense_id": "45dcb7a1-b311-3a27-b496-2ca896483ae4",
                        "target_lang_word": "Uruguay",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Uruguay",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f4e9f8cf-3d48-327b-b865-790ae3e1e37b",
                                        "entry_id": "9e822e05-e02e-3f6f-9dee-a83d07497fe3",
                                        "glosses": [
                                            "Land in Südamerika"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b350b64c-4186-4fa4-83be-27416ceb4be9",
                                                "sense_id": "f4e9f8cf-3d48-327b-b865-790ae3e1e37b",
                                                "text": "„Uruguay hat ein Rechtssystem, das auf dem Code civil und dem spanischen Zivilrechtsystem beruht.“"
                                            },
                                            {
                                                "example_id": "c8b9ac20-a074-4f07-b00d-dd31a28c05ed",
                                                "sense_id": "f4e9f8cf-3d48-327b-b865-790ae3e1e37b",
                                                "text": "In Montevideo, der Hauptstadt Uruguays, wohnt fast die Hälfte der Bevölkerung."
                                            },
                                            {
                                                "example_id": "f3c66b53-dadd-43d3-bbe2-46b5fcbdad13",
                                                "sense_id": "f4e9f8cf-3d48-327b-b865-790ae3e1e37b",
                                                "text": "„Einen außerplanmäßigen Bankfeiertag wie am Dienstag hat es in Uruguay seit siebzig Jahren nicht mehr gegeben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9335587d-b353-416c-847c-89915010ac51",
                        "source_entry_id": "95770ba3-3bd4-34b8-a51f-846908a627db",
