                "senses": [
                    {
                        "sense_id": "493d2f9c-2601-35a0-9e9b-9fb39f14d2f7",
                        "entry_id": "83ed7c61-b2bd-3d13-be22-582e5b734ef1",
                        "glosses": [
                            "Phänomen im Zusammenhang einer Quantentheorie"
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [
                            {
                                "example_id": "0d640fe8-402d-42d0-a325-c91b4f2aecc2",
                                "sense_id": "493d2f9c-2601-35a0-9e9b-9fb39f14d2f7",
                                "text": "„Bei der experimentellen Untersuchung verschiedener grundlegender Quantenphänomene wurden in den letzten Jahrzehnten erhebliche experimentelle Fortschritte erzielt.“"
                            },
                            {
                                "example_id": "7474a3fe-0d94-4862-9aa8-3502e1a9d540",
                                "sense_id": "493d2f9c-2601-35a0-9e9b-9fb39f14d2f7",
                                "text": "„In den letzten Jahren haben mehrere Experimente Quantenphänomene auch in makroskopischen Systemen beobachtet, beispielsweise in Salzkristallen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
