                "senses": [
                    {
                        "sense_id": "c7f0a78e-590f-3e28-b723-321a4ddf2eb8",
                        "entry_id": "68514352-bdbb-3a03-b7d8-2efca2a97cb8",
                        "glosses": [
                            "Qui picore."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8c11574-2243-4b78-91da-492047dfabb9",
                                "sense_id": "c7f0a78e-590f-3e28-b723-321a4ddf2eb8",
                                "text": "Oiseau picoreur, s’enfuyant le gosier plein, et gazouillant un air pour tout remerciement."
                            },
                            {
                                "example_id": "f5c24f0b-fa61-44d9-9608-7b84910a6791",
                                "sense_id": "c7f0a78e-590f-3e28-b723-321a4ddf2eb8",
                                "text": "Cette petite graine a trouvé la parade, dans la nature, pour se protéger contre les oiseaux picoreurs."
                            },
                            {
                                "example_id": "ee564939-92f5-4b33-8762-d2231a1adc6b",
                                "sense_id": "c7f0a78e-590f-3e28-b723-321a4ddf2eb8",
                                "text": "On rapporte qu’il refusèrent les lopins de terre qu’on leur offrait pour prix de leur concours : la vie agricole n’était point le fait de ces aventuriers, c’était la perle à laquelle la poule picoreuse préfère le moindre grain de mil."
                            }
                        ]
                    }
