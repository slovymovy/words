                {
                    "sense_id": "a4fefed7-07de-3ae8-b4ce-6eb9e06ab510",
                    "sense_definition": "À un endroit situé plus bas ; en bas.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "position",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Regarde l'appartement du premier étage, nous habitons juste <w>au-dessous</w>."
                        },
                        {
                            "text": "La boîte que tu cherches se trouve sur l'étagère juste <w>au-dessous</w>."
                        }
                    ],
                    "synonyms": [
                        "en bas",
                        "en dessous"
                    ],
                    "antonyms": [
