                "senses": [
                    {
                        "sense_id": "9692ffe2-60f7-3045-aeb0-551f30d62e57",
                        "entry_id": "6b645503-3d13-35b9-8d69-f33af0bb2032",
                        "glosses": [
                            "Übergang in einem monarchischen System auf einen neuen Regenten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e00f4262-7a66-448e-b1e1-db2fceb6ff6f",
                                "sense_id": "9692ffe2-60f7-3045-aeb0-551f30d62e57",
                                "text": "„Das einzige Interesse der Beamten war, ihre Ämter nach dem Thronwechsel zu behalten.“"
                            },
                            {
                                "example_id": "8811f7db-32bf-4969-8ed9-95608b4f833b",
                                "sense_id": "9692ffe2-60f7-3045-aeb0-551f30d62e57",
                                "text": "„Auf der anderen Seite war es nicht zuletzt die große Unruhe durch den Thronwechsel im ganzen Lande, die dem Marquis – einem rechtens zum Tode Verurteilten! – bei der heimlichen Rückkehr zustatten kam.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
