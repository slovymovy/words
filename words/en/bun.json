                {
                    "sense_id": "d0e83223-81ed-3ede-a886-715e032298c4",
                    "sense_definition": "To shoot someone with a firearm.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "violence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lyrics describe how the gang members intend to <w>bun</w> their rivals.",
                            "target_lang_translations": {
                                "ru": "В тексте песни описывается, как члены банды намерены <w>пристрелить</w> своих соперников.",
                                "zh": "歌词描述了帮派成员打算如何<w>枪杀</w>他们的对手。"
                            }
                        },
                        {
                            "text": "Don't care about your crew, <w>bun</w> them any day.",
                            "target_lang_translations": {
                                "ru": "Плевать на твою банду, <w>шлепну</w> их в любой день.",
                                "zh": "别管你的团伙，随时都能<w>枪杀</w>他们。"
                            }
                        }
