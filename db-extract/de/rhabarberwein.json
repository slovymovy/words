                "senses": [
                    {
                        "sense_id": "b370bb1c-fbeb-34bb-9003-f8b1963bbe0e",
                        "entry_id": "71042d28-de92-30b7-9c6c-e21b4f31d6f7",
                        "glosses": [
                            "Obstwein, der aus Rhabarber hergestellt wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d7a2e8e8-e70a-408b-95f6-a53ea16e6729",
                                "sense_id": "b370bb1c-fbeb-34bb-9003-f8b1963bbe0e",
                                "text": "„Wir tranken nicht mehr viel von dem kostbaren Rhabarberwein der Leute, auch weil die Kopfschmerzen sich schon leicht ankündigten.“"
                            },
                            {
                                "example_id": "de8926f9-b776-4781-bf92-8372b6378262",
                                "sense_id": "b370bb1c-fbeb-34bb-9003-f8b1963bbe0e",
                                "text": "„Die Bauern, bei denen Staszek unterkommt, geben ihm Brot zu essen und Rhabarberwein zutrinken - verlangen dafür allerdings Westwaren wie Strumpfhosen, Kaffee und Socken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
