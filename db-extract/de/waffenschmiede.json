                "senses": [
                    {
                        "sense_id": "d3a11037-d27a-39c0-b0e5-76bb1b17fe22",
                        "entry_id": "d0fd2131-408f-357b-a649-f93dd4d7d17e",
                        "glosses": [
                            "Betrieb, in dem Waffen hergestellt werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52613070-3234-4e2a-9e62-a16e62b4c9e2",
                                "sense_id": "d3a11037-d27a-39c0-b0e5-76bb1b17fe22",
                                "text": "„Selbst die Kontrolle des Rüstungsexportes ist den Regionen übertragen, damit die wallonischen Waffenschmieden nach Afrika liefern können, ohne dass die Flamen ein schlechtes Gewissen haben müssen.“"
                            },
                            {
                                "example_id": "a5f6b55d-8fcd-44f7-91b1-c835710e69e8",
                                "sense_id": "d3a11037-d27a-39c0-b0e5-76bb1b17fe22",
                                "text": "„Aus dem weitverzweigten Stollensystem wurde eine unterirdische Waffenschmiede für die Wehrmacht, in der vor allem Teile für die V1- und V2-Raketen und die Flugzeuge der Messerschmitt- und Junkers-Werke sowie Zünder für Granaten produziert wurden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
