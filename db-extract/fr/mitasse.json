                "senses": [
                    {
                        "sense_id": "f8a87d42-8fe4-3b8f-97d6-6eb6c1a01c1b",
                        "entry_id": "e7a116b3-dc00-3446-a40c-7721c2564e92",
                        "glosses": [
                            "Tube en peaux que portaient les autochtones d'Amérique par temps froids. Ils étaient retenus par des lanières à la ceinture et complétaient, avec le pagne, un vêtement de nature comparable au pantalon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "24052f8a-2bf4-4a71-abdd-e82f63611095",
                                "sense_id": "f8a87d42-8fe4-3b8f-97d6-6eb6c1a01c1b",
                                "text": "Elles sont d’origine autochtone et il paraît que le mot mitasse provient de mitassone en langue indigène."
                            },
                            {
                                "example_id": "e4532de1-fe95-4dcd-892b-7d070c135f3b",
                                "sense_id": "f8a87d42-8fe4-3b8f-97d6-6eb6c1a01c1b",
                                "text": "Les jambes s’engageaient, jusqu’à mi-hauteur seulement, dans des tubes appelés mitasses, que retenaient des lanières assujetties à la ceinture. Une sorte de pagne sauvegardait la décence."
                            }
                        ]
                    }
