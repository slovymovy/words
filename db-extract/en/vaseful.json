                        "sense_id": "0c76c348-8728-3aac-be33-0d2c81ec8648",
                        "entry_id": "d4194794-879d-3be8-a18a-5b4859f61d00",
                        "glosses": [
                            "As much as a vase will hold."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d696438-1af5-46bb-a906-63aeea7d185b",
                                "sense_id": "0c76c348-8728-3aac-be33-0d2c81ec8648",
                                "text": "a vaseful of red roses"
                            },
                            {
                                "example_id": "8629a0b9-4ef8-4bac-99ff-1d46c6bbcec1",
                                "sense_id": "0c76c348-8728-3aac-be33-0d2c81ec8648",
                                "text": "Once or twice indeed she has asked for the shears and gone out alone as in old times returning with a load of roses, and has then demanded vases and arranged them at the pier-table in the dining-room, and carried the various vasesful to their places without any thought of weakness or difficulty."
                            },
                            {
                                "example_id": "64ea4e64-43f9-4d56-9dc1-c7ebc338fe2c",
                                "sense_id": "0c76c348-8728-3aac-be33-0d2c81ec8648",
                                "text": "A three-course luncheon in pink and white appointments was served, carnations and narcissus adorning the table and being present in fragrant vasesful about the rooms as well."
                            },
                            {
                                "example_id": "5536fde1-8430-496d-8fc9-df1732e981fe",
                                "sense_id": "0c76c348-8728-3aac-be33-0d2c81ec8648",
                                "text": "Here are hundreds of vases-ful brought by the manufacturer for this three-day showing starting tomorrow."
                            },
                            {
                                "example_id": "4b362710-ffb8-4da1-8daf-296131f0cb39",
                                "sense_id": "0c76c348-8728-3aac-be33-0d2c81ec8648",
                                "text": "I bought from a waiter, at a large fee, two vasesful of their expensive table decoration."
                            },
                            {
                                "example_id": "12fc3b7b-2333-4c33-8678-0df375f278b6",
                                "sense_id": "0c76c348-8728-3aac-be33-0d2c81ec8648",
                                "text": "There were flowers: huge vasesful of them."
                            }
                        ]
                    }
