{
    "word_family": [
        "singularity",
        "singularly",
        "singularize"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "c143a1a6-66b3-398c-9c0d-360cf0b2fe9b",
                    "sense_definition": "Relating to the form of a word that refers to only one person or thing.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "grammar_sense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The word 'child' is <w>singular</w>, while 'children' is plural.",
                            "target_lang_translations": {
                                "ru": "Слово «child» стоит в <w>единственном числе</w>, а «children» — во множественном.",
                                "zh": "单词“child”是<w>单数</w>，而“children”是复数。"
                            }
                        },
                        {
                            "text": "You must use a <w>singular</w> verb when the subject is only one person.",
                            "target_lang_translations": {
                                "ru": "Нужно использовать глагол в <w>единственном числе</w>, когда подлежащее обозначает только одного человека.",
                                "zh": "当主语只有一个人时，你必须使用<w>单数</w>动词。"
                            }
                        }
                    ],
                    "antonyms": [
                        "plural"
                    ],
                    "common_phrases": [
                        "third person singular",
                        "singular noun",
                        "singular form"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "grammatical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к грамматической форме, обозначающей одного человека или предмет.",
                        "zh": "指代单个事物或人的语法形式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "еди́нственный",
                                "target_lang_sense_clarification": "грамматический термин, обычно в словосочетании «единственное число»"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "单数",
                                "target_lang_sense_clarification": "语法术语，指代单个对象"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d5e3c368-17f1-3fb9-a77d-3ec2d5e62649",
                    "sense_definition": "Unusual, strange, or deviating from what is normal or expected.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "quality_strange",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He showed a <w>singular</w> lack of interest in the important news.",
                            "target_lang_translations": {
                                "ru": "Он проявил <w>странное</w> отсутствие интереса к важным новостям.",
                                "zh": "他对这则重要新闻表现出了<w>异常的</w>冷漠。"
                            }
                        },
                        {
                            "text": "It was a <w>singular</w> coincidence that we met in such a remote village.",
                            "target_lang_translations": {
                                "ru": "То, что мы встретились в такой глухой деревне, было <w>необычным</w> совпадением.",
                                "zh": "我们在如此偏远的村庄相遇，真是一个<w>奇特的</w>巧合。"
                            }
                        }
                    ],
                    "synonyms": [
                        "strange",
                        "odd",
                        "peculiar",
                        "curious",
                        "bizarre",
                        "eccentric",
                        "unusual"
                    ],
                    "common_phrases": [
                        "singular lack",
                        "singular appearance",
                        "singular event"
                    ],
                    "target_lang_definitions": {
                        "ru": "Необычный, странный или отклоняющийся от нормы.",
                        "zh": "不寻常的、奇怪的或偏离常态的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "своеобра́зный",
                                "target_lang_sense_clarification": "отличающийся от обычного, специфический"
                            },
                            {
                                "target_lang_word": "стра́нный",
                                "target_lang_sense_clarification": "вызывающий недоумение, необычный"
                            },
                            {
                                "target_lang_word": "необы́чный",
                                "target_lang_sense_clarification": "не такой, как всегда или как у всех"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "奇特的",
                                "target_lang_sense_clarification": "与众不同，令人感到奇怪"
                            },
                            {
                                "target_lang_word": "异常的",
                                "target_lang_sense_clarification": "不符合常规"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cfed8220-df49-3e9a-9434-3a71a4de83b7",
                    "sense_definition": "Exceptionally good, great, or unique; being the only one of its kind.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "quality_exceptional",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was a woman of <w>singular</w> beauty and intelligence.",
                            "target_lang_translations": {
                                "ru": "Она была женщиной <w>исключительной</w> красоты и ума.",
                                "zh": "她是一位拥有<w>非凡</w>美貌与智慧的女性。"
                            }
                        },
                        {
                            "text": "The artist's <w>singular</w> style makes his work instantly recognizable.",
                            "target_lang_translations": {
                                "ru": "<w>Уникальный</w> стиль художника делает его работы мгновенно узнаваемыми.",
                                "zh": "这位艺术家<w>独特</w>的风格使他的作品一眼就能被认出来。"
                            }
                        }
                    ],
                    "synonyms": [
                        "unique",
                        "exceptional",
                        "extraordinary",
                        "remarkable",
                        "unparalleled",
                        "peerless"
                    ],
                    "common_phrases": [
                        "singular beauty",
                        "singular honor",
                        "singular talent"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "often literary or formal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Исключительный, выдающийся или уникальный; единственный в своем роде.",
                        "zh": "极其优秀的、伟大的或独一无二的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "исключи́тельный",
                                "target_lang_sense_clarification": "выделяющийся своими достоинствами"
                            },
                            {
                                "target_lang_word": "необыкнове́нный",
                                "target_lang_sense_clarification": "поразительный, очень хороший"
                            },
                            {
                                "target_lang_word": "уника́льный",
                                "target_lang_sense_clarification": "неповторимый"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "非凡的",
                                "target_lang_sense_clarification": "超出一般水平"
                            },
                            {
                                "target_lang_word": "独特的",
                                "target_lang_sense_clarification": "独一无二，与众不同"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a7aad946-d561-3a54-b3ed-41203a7f7b5b",
                    "sense_definition": "Having a determinant equal to zero and therefore having no inverse (of a square matrix).",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "math_sense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A <w>singular</w> matrix cannot be used to solve the system of linear equations.",
                            "target_lang_translations": {
                                "ru": "<w>Вырожденную</w> матрицу нельзя использовать для решения системы линейных уравнений.",
                                "zh": "<w>奇异</w>矩阵不能用于求解线性方程组。"
                            }
                        },
                        {
                            "text": "If the determinant is zero, the matrix is defined as <w>singular</w>.",
                            "target_lang_translations": {
                                "ru": "Если определитель равен нулю, матрица определяется как <w>вырожденная</w>.",
                                "zh": "如果行列式为零，该矩阵被定义为<w>奇异</w>矩阵。"
                            }
                        }
                    ],
                    "synonyms": [
                        "non-invertible"
                    ],
                    "antonyms": [
                        "invertible",
                        "non-singular"
                    ],
                    "common_phrases": [
                        "singular matrix"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "mathematics"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий определитель, равный нулю (о квадратной матрице).",
                        "zh": "指行列式为零且无逆矩阵的方阵。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вы́рожденный",
                                "target_lang_sense_clarification": "математический термин"
                            },
                            {
                                "target_lang_word": "сингуля́рный",
                                "target_lang_sense_clarification": "научный термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "奇异的",
                                "target_lang_sense_clarification": "数学术语，指矩阵行列式为零"
                            },
                            {
                                "target_lang_word": "退化的",
                                "target_lang_sense_clarification": "数学术语，指矩阵不可逆"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9b668213-ff75-3d47-8845-75ba3a35ea74",
                    "sense_definition": "The form of a word used to refer to one person or thing.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "grammar_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>singular</w> of 'mice' is 'mouse'.",
                            "target_lang_translations": {
                                "ru": "<w>Единственное число</w> от «mice» — это «mouse».",
                                "zh": "“mice”的<w>单数形式</w>是“mouse”。"
                            }
                        },
                        {
                            "text": "Please write the <w>singular</w> next to the plural form in the table.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, напишите форму <w>единственного числа</w> рядом с множественным в таблице.",
                                "zh": "请在表格中将<w>单数形式</w>写在复数形式旁边。"
                            }
                        }
                    ],
                    "antonyms": [
                        "plural"
                    ],
                    "common_phrases": [
                        "in the singular"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "grammar"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Форма слова, используемая для обозначения одного лица или предмета.",
                        "zh": "用于指代单个事物或人的词形。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "еди́нственное число́",
                                "target_lang_sense_clarification": "грамматическая категория"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "单数形式",
                                "target_lang_sense_clarification": "语法中的单数类别"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}