                        "sense_id": "2f14bdb8-320a-3390-b8a5-954f56d04912",
                        "entry_id": "d6cd19b4-d41d-393d-ad4f-510ebf1f0c68",
                        "glosses": [
                            "In a secure or firm manner; securely"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "83bfaf57-939f-4ecf-9d06-87ba94fe31e2",
                                "sense_id": "2f14bdb8-320a-3390-b8a5-954f56d04912",
                                "text": "We tied the rope fastly this time; we didn't want it to get away again."
                            },
                            {
                                "example_id": "140dad1f-1ad5-4755-b343-b42eb36c4385",
                                "sense_id": "2f14bdb8-320a-3390-b8a5-954f56d04912",
                                "text": "Before them was a door which apparently led into the grand apartments; this was fastly secured, but it yielded to their united strength, and they entered a lofty hall, whose concave top was supported by pillars."
                            }
                        ]
                    }
                ],
