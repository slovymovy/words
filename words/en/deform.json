{
    "word_family": [
        "deformation",
        "deformity",
        "deformed"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3e7b0c4b-236f-3cbf-bcdf-248045b97202",
                    "sense_definition": "To change the physical shape of an object, often making it irregular or abnormal.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "change_shape",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heavy weight caused the metal beam to <w>deform</w> under the pressure."
                        },
                        {
                            "text": "Extreme heat can <w>deform</w> plastic objects if they are left too close to the fire."
                        }
                    ],
                    "synonyms": [
                        "distort",
                        "contort"
                    ],
                    "common_phrases": [
                        "deform under pressure"
                    ]
                },
                {
                    "sense_id": "5bcf6489-1669-32c2-b469-fbcf55dab383",
                    "sense_definition": "To spoil the appearance of something, making it look unattractive or imperfect.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "spoil_appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Graffiti began to <w>deform</w> the beauty of the historic city walls."
                        },
                        {
                            "text": "The scars on his face seemed to <w>deform</w> his otherwise gentle expression."
                        }
                    ],
                    "synonyms": [
                        "disfigure",
                        "deface"
                    ]
                },
                {
                    "sense_id": "f6ad2f86-04a4-3b31-a134-ce69df50add8",
                    "sense_definition": "To ruin the quality or character of something abstract, such as a situation or a system.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "spoil_quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His speech was <w>deform</w>ed by unnecessary technical jargon that confused the audience."
                        },
                        {
                            "text": "Jealousy can <w>deform</w> even the strongest of friendships over time."
                        }
                    ],
                    "synonyms": [
                        "mar"
                    ]
                },
                {
                    "sense_id": "1f0d8f0e-498c-3f43-8d87-993075a96411",
                    "sense_definition": "To undergo a change in shape or become misshapen.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "change_shape",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Soft metals will <w>deform</w> easily when struck with a hammer."
                        },
                        {
                            "text": "The structure began to <w>deform</w> as the foundation shifted during the earthquake."
                        }
                    ],
                    "synonyms": [
                        "distort"
                    ],
                    "antonyms": [
                        "undeform"
                    ]
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "73d57f6c-2bc5-3ac2-bf86-ee943d42a6eb",
                    "sense_definition": "Having an unusual, unattractive, or misshapen appearance.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "spoil_appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old gargoyle had a <w>deform</w> face that frightened the children."
