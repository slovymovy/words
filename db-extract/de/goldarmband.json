                "senses": [
                    {
                        "sense_id": "9b74b48b-6869-3cf6-a3d4-cfc9f6e900c8",
                        "entry_id": "8fe44cc9-a35b-37b0-a92d-b6c223017763",
                        "glosses": [
                            "Armband, hergestellt aus Gold"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48c25609-24ef-487e-87e9-1303e1386b92",
                                "sense_id": "9b74b48b-6869-3cf6-a3d4-cfc9f6e900c8",
                                "text": "Ein Goldarmband ist ein prestigeträchtiger Schmuck und zugleich eine Wertanlage."
                            },
                            {
                                "example_id": "ab609b97-c810-4aa1-96dd-c7db8e3ef72a",
                                "sense_id": "9b74b48b-6869-3cf6-a3d4-cfc9f6e900c8",
                                "text": "„Ein älterer Mann wird kontrolliert. Er hat ein Goldarmband in Istanbul gekauft, den Wert mit 150 Euro angegeben.“"
                            },
                            {
                                "example_id": "edd583d1-47a6-4221-9ecf-5632c81e78cc",
                                "sense_id": "9b74b48b-6869-3cf6-a3d4-cfc9f6e900c8",
                                "text": "„Er trug ein schweres Goldarmband und hatte zu viele Zähne.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
