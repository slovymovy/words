                ],
                "senses": [
                    {
                        "sense_id": "58c5a48a-d61b-3793-aec3-4c1fd5868b8f",
                        "entry_id": "c057ae71-2628-38cb-b224-068e285235e0",
                        "glosses": [
                            "eine Halle, die für die Ausübung unterschiedlicher Sportarten ausgelegt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec321ea4-877d-43b9-b404-2cdb43b06e77",
                                "sense_id": "58c5a48a-d61b-3793-aec3-4c1fd5868b8f",
                                "text": "In vielen Sporthallen ist das Betreten des dortigen Bodens mit normalen Straßenschuhen nicht erwünscht."
                            },
                            {
                                "example_id": "a33f9a3e-991a-46ef-ba02-35070e412e1a",
                                "sense_id": "58c5a48a-d61b-3793-aec3-4c1fd5868b8f",
                                "text": "„Mikaela Shiffrin steht in der Sporthalle der Volkshochschule Flachau, Salzburger Land, und lächelt unter ihrer weißen Pudelmütze hervor.“"
                            },
                            {
                                "example_id": "70c40776-e7a3-42cd-9879-10fed41c089e",
                                "sense_id": "58c5a48a-d61b-3793-aec3-4c1fd5868b8f",
                                "text": "„Offenbar hatte Ernest auch Ezra mit seiner Begeisterung angesteckt, denn sie erfuhr, dass die zwei stundenlang in einer nahegelegenen Sporthalle schwitzten, während der jüngere Schriftsteller dem älteren die Feinheiten des Boxens beibrachte.“"
                            },
                            {
                                "example_id": "4b605e52-d924-48c4-949b-88a38e8deb3d",
                                "sense_id": "58c5a48a-d61b-3793-aec3-4c1fd5868b8f",
                                "text": "„Von ihrem Schreibtisch aus sah sie den Sportplatz und die Sporthalle, wo beim Bau etwas schiefgegangen war, denn die Dachplatten hatten unterschiedliche Farben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
