                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "71d64347-b73c-47b9-8ad7-53956ef98fc6",
                                "sense_id": "95ca65d6-7239-36ba-9a06-21cb3ab43b74",
                                "text": "In Utrecht vond ik onderdak bij de Vakgroep Literatuurwetenschap, waar met name mijn kamergenoot Frank Brandsma mij heeft moeten verduren in mijn somtijdse rusteloosheid en lawaaierige wijze van werken."
                            }
                        ]
                    }
                ],
                "translations": [],
