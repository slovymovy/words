                        "examples": [
                            {
                                "example_id": "45b1073e-c8af-4766-b090-12d7eb809c12",
                                "sense_id": "b7a14b60-cf21-3a81-b9d4-5eca54bcd668",
                                "text": "Quand nous disons qu'il faut couper rez tronc les branches jugées trop basses , nous ne voulons pas dire qu'il faille les couper si près du tronc que l'écorce en soit entamée, […]."
                            },
                            {
                                "example_id": "6f68b2d0-07e3-4002-92c4-40ee6abdcf43",
                                "sense_id": "b7a14b60-cf21-3a81-b9d4-5eca54bcd668",
                                "text": "Dans le mois de février de la deuxième année, on coupe rez souche les sarments les plus faibles et l'on taille à un ou deux yeux le sarment le plus fort."
                            },
                            {
                                "example_id": "28675b66-52f2-4485-8ea3-66d47c993bcb",
                                "sense_id": "b7a14b60-cf21-3a81-b9d4-5eca54bcd668",
                                "text": "Quel que soit l’instrument employé, la section doit toujours être faite rez sol, afin que les rejets qui se développent soient bien assis sur la souche, et puissent émettre des racines qui concourreront dans une large mesure à leur nutrition."
                            }
                        ]
                    }
