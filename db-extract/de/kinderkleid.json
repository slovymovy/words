                "senses": [
                    {
                        "sense_id": "7ebe4939-5ed5-39d1-9150-380feccb5191",
                        "entry_id": "128e8d62-5562-3f0e-9690-fb3d0d9a0a18",
                        "glosses": [
                            "Kleid, das von Mädchen/Kindern getragen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0873e8c9-24d8-43b3-af36-6d7cca6edc59",
                                "sense_id": "7ebe4939-5ed5-39d1-9150-380feccb5191",
                                "text": "In unserem Second-Hand-Laden kriegen sie auch Kinderkleider, die hängen da rechts auf der Stange."
                            },
                            {
                                "example_id": "db9a316b-6702-4f88-995d-ddbbbc9cead8",
                                "sense_id": "7ebe4939-5ed5-39d1-9150-380feccb5191",
                                "text": "„Auf einer Auktion kam das Kinderkleid aus dem Filmklassiker «Der Zauberer von Oz» für über 1,5 Millionen Dollar unter den Hammer.“"
                            },
                            {
                                "example_id": "d58ec5d2-e677-460e-870d-6a07dd7b5445",
                                "sense_id": "7ebe4939-5ed5-39d1-9150-380feccb5191",
                                "text": "Seit einigen Jahren entwirft und näht Gesa […] Kinderkleider."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "0dc0a130-ffe2-309e-a44c-8bed753575b3",
                        "entry_id": "128e8d62-5562-3f0e-9690-fb3d0d9a0a18",
                        "glosses": [
                            "von Kindern getragene Kleidung"
                        ],
                        "tags": [
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "dab27029-d104-4f22-b7e2-22594dddf76c",
                                "sense_id": "0dc0a130-ffe2-309e-a44c-8bed753575b3",
                                "text": "Seit einigen Jahren entwirft und näht Gesa […] Kinderkleider."
                            },
                            {
                                "example_id": "ff42e816-3956-4371-9675-d43abf8db3ce",
                                "sense_id": "0dc0a130-ffe2-309e-a44c-8bed753575b3",
                                "text": "[Museum:] „Die Sammlung geht weit über Spielsachen hinaus. Das Museum zeigt auch Kinderkleider, Schulutensilien oder Kinderwerbung.“"
                            },
                            {
                                "example_id": "9bea3137-665f-4e6b-b240-bb86961a30c1",
                                "sense_id": "0dc0a130-ffe2-309e-a44c-8bed753575b3",
                                "text": "„Nutzen Sie den Ausverkauf [Anmerkung: im Januar]. Sparen lässt sich vor allem bei Bettwäsche, Haushaltsartikeln, Kinderkleidern und Sportartikeln.“"
                            },
                            {
                                "example_id": "77be0b43-06a8-4947-a799-5864a28c3d53",
                                "sense_id": "0dc0a130-ffe2-309e-a44c-8bed753575b3",
                                "text": "„[…] Kinderkleider sind im Alltag höchsten Belastungen ausgesetzt.“"
                            },
                            {
                                "example_id": "c0978c80-2b4a-403d-86fe-d08604dcfd1c",
                                "sense_id": "0dc0a130-ffe2-309e-a44c-8bed753575b3",
                                "text": "„Bei allen getesteten Kleidermarken waren krebserregende Stoffe […] zu finden. Und dies auch bei Kinderkleidern, die in der Schweiz zu kaufen sind.“"
                            },
                            {
                                "example_id": "c32f7813-ddfa-4995-abc9-d527e6e8a591",
                                "sense_id": "0dc0a130-ffe2-309e-a44c-8bed753575b3",
                                "text": "[Kinderarbeit:] „Schlagzeilen machte im letzten Herbst die amerikanische Modekette Gap. Kinderkleider bestickt von Kindern. Kleine Hände arbeiten geschickt mit Perlen und Pailletten - und kosten fast nichts.“"
                            },
                            {
                                "example_id": "41606738-d2ea-4727-a53b-6b6127a67526",
                                "sense_id": "0dc0a130-ffe2-309e-a44c-8bed753575b3",
                                "text": "[Corona in Italien:] „Neuerdings dürfen Buchhandlungen, Schreibwarengeschäfte und Läden mit Kinderkleidern offen haben.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
