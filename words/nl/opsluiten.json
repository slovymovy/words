                                "target_lang_sense_clarification": "to secure someone or something in a room or container"
                            },
                            {
                                "target_lang_word": "shut in",
                                "target_lang_sense_clarification": "to confine someone in a room"
                            },
                            {
                                "target_lang_word": "confine",
                                "target_lang_sense_clarification": "to keep within certain limits or space"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "запереть",
                                "target_lang_sense_clarification": "в комнате или помещении"
                            },
                            {
                                "target_lang_word": "закрыть",
                                "target_lang_sense_clarification": "внутри чего-либо"
