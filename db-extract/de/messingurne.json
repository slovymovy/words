                                "example_id": "2d4d169d-f3fd-4c8b-b4a5-abe40afc7afa",
                                "sense_id": "5be45e01-8de3-344c-bdde-20211fce9916",
                                "text": "„Fertility zieht eine glänzende Messingurne aus ihrer Reisetasche.“"
                            },
                            {
                                "example_id": "31788e97-447d-4ba4-b2e5-fdab1b1366de",
                                "sense_id": "5be45e01-8de3-344c-bdde-20211fce9916",
                                "text": "„Noch vor ein paar Jahren war hier alles enorm gepflegt gewesen, das Mahagoni war auf Hochglanz poliert, und wenn man an einer der Messingurnen in der Lobby rieb, glaubte man fast, dass gleich ein guter Hotelgeist daraus hervorkommen würde.“"
                            }
