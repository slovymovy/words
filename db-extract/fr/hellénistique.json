                            "feminine"
                        ],
                        "form": "hellénistiques"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0583a4b3-1e86-32b4-be6b-a319b2105862",
                        "entry_id": "61b6dde0-964f-3270-ad5e-6cca3fd10509",
                        "glosses": [
                            "Relatif à la civilisation grecque depuis Alexandre le Grand jusqu’à la conquête romaine, soit de 323 à 31 avant J.-C."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": [
                            {
                                "example_id": "4610b931-af0d-4e8d-a593-8967c90271d7",
                                "sense_id": "0583a4b3-1e86-32b4-be6b-a319b2105862",
                                "text": "Sa marchandise sous le bras, il se faufilait entre deux malades, déballait un masque égyptien ou une tanagra hellénistique."
                            }
                        ]
                    },
                    {
                        "sense_id": "1d55c62e-abb5-3ca0-9eec-3fe67602d0a9",
                        "entry_id": "61b6dde0-964f-3270-ad5e-6cca3fd10509",
                        "glosses": [
                            "Se rapporte aux Juifs hellénisants."
                        ],
                        "tags": [
                            "Judaism"
                        ],
                        "examples": [
                            {
                                "example_id": "f37a29d0-c16d-4d38-9336-7d00e7841678",
                                "sense_id": "1d55c62e-abb5-3ca0-9eec-3fe67602d0a9",
                                "text": "On parle du christianisme hellénistique pour celui qui s’est développé dans la partie hellénisée du monde, par une mise en rapport de l’Évangile avec la philosophie grecque."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bb5c26f4-49cc-4f2d-ac3a-d5983a611736",
                        "source_entry_id": "61b6dde0-964f-3270-ad5e-6cca3fd10509",
                        "source_sense_id": "0583a4b3-1e86-32b4-be6b-a319b2105862",
                        "target_lang_word": "hellenistisch",
                        "target_lang_code": "de",
