{
    "word_family": [
        "rowdiness",
        "rowdyism"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "fad447c1-764b-35a0-b218-1e42ee965cb8",
                    "sense_definition": "Loud, noisy, and behaving in a way that is difficult to control.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "disorderly behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>rowdy</w> crowd at the concert began to push against the security barriers.",
                            "target_lang_translations": {
                                "ru": "<w>Буйная</w> толпа на концерте начала напирать на заграждения безопасности.",
                                "nl": "De <w>luidruchtige</w> menigte bij het concert begon tegen de veiligheidshekken aan te duwen."
                            }
                        },
                        {
                            "text": "The neighbors complained about the <w>rowdy</w> party that lasted until three in the morning.",
                            "target_lang_translations": {
                                "ru": "Соседи пожаловались на <w>шумную</w> вечеринку, которая продолжалась до трех часов утра.",
                                "nl": "De buren klaagden over het <w>luidruchtige</w> feest dat tot drie uur 's ochtends duurde."
                            }
                        }
                    ],
                    "synonyms": [
                        "unruly",
                        "disorderly"
                    ],
                    "antonyms": [
                        "orderly",
                        "peaceful",
                        "quiet"
                    ],
                    "common_phrases": [
                        "rowdy crowd",
                        "rowdy behavior",
                        "rowdy party"
                    ],
                    "target_lang_definitions": {
                        "ru": "Шумный, буйный и ведущий себя так, что его трудно контролировать.",
                        "nl": "Luidruchtig, onstuimig en zich gedragend op een manier die moeilijk te beheersen is."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "буйный",
                                "target_lang_sense_clarification": "о поведении или толпе"
                            },
                            {
                                "target_lang_word": "шумный",
                                "target_lang_sense_clarification": "о вечеринке или компании"
                            },
                            {
                                "target_lang_word": "неугомонный",
                                "target_lang_sense_clarification": "о человеке или группе"
                            },
                            {
                                "target_lang_word": "дебоширский",
                                "target_lang_sense_clarification": "нарушающий порядок"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "luidruchtig",
                                "target_lang_sense_clarification": "over een feest of groep mensen"
                            },
                            {
                                "target_lang_word": "onstuimig",
                                "target_lang_sense_clarification": "over gedrag of een menigte"
                            },
                            {
                                "target_lang_word": "baldadig",
                                "target_lang_sense_clarification": "verstorend en onbeheerst gedrag"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3699251a-7afa-33e1-aef2-94fac1a4a54d",
                    "sense_definition": "A person who is loud, noisy, and prone to causing trouble or fighting.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "disorderly behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local <w>rowdies</w> were known for starting fights in the town square every weekend.",
                            "target_lang_translations": {
                                "ru": "Местные <w>буяны</w> были известны тем, что каждые выходные затевали драки на городской площади.",
                                "nl": "De lokale <w>relschoppers</w> stonden erom bekend elk weekend vechtpartijen op het stadsplein te beginnen."
                            }
                        },
                        {
                            "text": "The police were called to disperse a group of <w>rowdies</w> outside the stadium.",
                            "target_lang_translations": {
                                "ru": "Полицию вызвали, чтобы разогнать группу <w>хулиганов</w> возле стадиона.",
                                "nl": "De politie werd opgeroepen om een groep <w>herrieschoppers</w> buiten het stadion uiteen te drijven."
                            }
                        }
                    ],
                    "synonyms": [
                        "brawler",
                        "ruffian"
                    ],
                    "common_phrases": [
                        "local rowdies"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который ведет себя шумно, буйно и склонен к созданию проблем или дракам.",
                        "nl": "Iemand die luidruchtig is en geneigd is om problemen te veroorzaken of te vechten."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "буян",
                                "target_lang_sense_clarification": "тот, кто ведет себя буйно"
                            },
                            {
                                "target_lang_word": "хулиган",
                                "target_lang_sense_clarification": "нарушитель общественного порядка"
                            },
                            {
                                "target_lang_word": "дебошир",
                                "target_lang_sense_clarification": "участник скандалов и драк"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "herrieschopper",
                                "target_lang_sense_clarification": "iemand die lawaai maakt en overlast veroorzaakt"
                            },
                            {
                                "target_lang_word": "relschopper",
                                "target_lang_sense_clarification": "iemand die betrokken is bij wanordelijkheden"
                            },
                            {
                                "target_lang_word": "vechtersbaas",
                                "target_lang_sense_clarification": "iemand die snel geneigd is tot vechten"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3ea1ca85-f43c-3869-91bc-c996bde4a05e",
                    "sense_definition": "A slang term for money, especially cash that is ready for use.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "money",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He didn't care much for the man's personality, as long as he had the <w>rowdy</w> to pay his debts.",
                            "target_lang_translations": {
                                "ru": "Его не особо заботил характер этого человека, лишь бы у того была <w>наличка</w>, чтобы оплатить долги.",
                                "nl": "De persoonlijkheid van de man kon hem weinig schelen, zolang hij maar de <w>poen</w> had om zijn schulden te betalen."
                            }
                        },
                        {
                            "text": "The old merchant asked where the <w>rowdy</w> was before he would hand over the goods.",
                            "target_lang_translations": {
                                "ru": "Старый купец спросил, где <w>деньги</w>, прежде чем передать товар.",
                                "nl": "De oude koopman vroeg waar de <w>contanten</w> waren voordat hij de goederen zou overhandigen."
                            }
                        }
                    ],
                    "common_phrases": [
                        "got the rowdy"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "archaic slang for money"
                        },
                        {
                            "trait_type": "dated",
                            "comment": "primarily found in 19th-century literature"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сленговое обозначение денег, особенно наличных, готовых к использованию.",
                        "nl": "Een verouderde slangterm voor geld, met name contant geld."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наличка",
                                "target_lang_sense_clarification": "деньги (устаревший сленг)"
                            },
                            {
                                "target_lang_word": "бабки",
                                "target_lang_sense_clarification": "деньги (сленг)"
                            },
                            {
                                "target_lang_word": "капуста",
                                "target_lang_sense_clarification": "деньги (сленг)"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "poen",
                                "target_lang_sense_clarification": "informele term voor geld"
                            },
                            {
                                "target_lang_word": "contanten",
                                "target_lang_sense_clarification": "fysiek geld"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}