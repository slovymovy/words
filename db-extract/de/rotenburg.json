                        "examples": [
                            {
                                "example_id": "5428e324-0a5d-41d0-9ff4-2df93ea63aa2",
                                "sense_id": "c2be2ca0-96e3-3bf6-b94c-d29c03d72ea0",
                                "text": "Rotenburg liegt in Hessens Norden."
                            },
                            {
                                "example_id": "2a370385-2360-4dca-aa9c-e85a4436ff1a",
                                "sense_id": "c2be2ca0-96e3-3bf6-b94c-d29c03d72ea0",
                                "text": "„Rotenburg hat außerdem weitere historische Kirchen sowie interessante Wohnbauten aufzuweisen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e0958dff-599f-3323-a30a-9d539e262fe8",
                        "entry_id": "757e7315-4d52-39ec-9b44-b1cb697c43e4",
                        "glosses": [
                            "eine Stadt in Niedersachsen, Deutschland"
                        ],
                        "tags": [],
                        "examples": [
                            {
