                "senses": [
                    {
                        "sense_id": "c9082916-aaf8-3289-ad1f-246742f42cdf",
                        "entry_id": "a3b1342d-f216-3957-b19e-05f982ff38dd",
                        "glosses": [
                            "Hieb- oder Stichwaffe, die so schwer und groß ist, dass sie mit zwei Händen geführt werden muss"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "919cefa4-cd2c-42a4-afeb-79178ae95251",
                                "sense_id": "c9082916-aaf8-3289-ad1f-246742f42cdf",
                                "text": "Die \"Verlorenen\" waren Plänkler und hatten die Aufgabe, den Gegner auch in der Flanke und im Rücken zu attackieren und mit dem Schlachtschwert, dem Bihänder, Lücken in den gegnerischen Wald von Spießen zu schlagen."
                            },
                            {
                                "example_id": "715e0152-851f-4e32-8838-2752534bf7c6",
                                "sense_id": "c9082916-aaf8-3289-ad1f-246742f42cdf",
                                "text": "„An Hau- und Stichwaffen sind hervorzuheben der Bihänder, ein beidhändig zu führendes, anderthalb Meter langes Schwert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a34ef606-ecfe-40f9-895d-701ef776a747",
                        "source_entry_id": "a3b1342d-f216-3957-b19e-05f982ff38dd",
                        "source_sense_id": "c9082916-aaf8-3289-ad1f-246742f42cdf",
                        "source_sense_description": "beidhändig geführte Hieb- und Stichwaffe",
                        "target_lang_word": "espadon",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "espadon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b46fb157-e0ab-3f39-b539-2f41d24ae567",
                                        "entry_id": "8f27a218-5486-339c-8814-2096e4e98cd8",
                                        "glosses": [
                                            "Grande et large épée, à double tranchant, qu’on tenait à deux mains."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f54946c9-05ec-421d-a627-4c66a4fd986c",
                                                "sense_id": "b46fb157-e0ab-3f39-b539-2f41d24ae567",
                                                "text": "Mais il faut savoir gré à cet archevêque de Braga, armé et équipé pour la guerre, avec sa cotte de mailles, son espadon suspendu à l’arçon de sa mule et son heaume à vantail, d’être allé aussi loin sur la voie de la spéculation théologique, peut-être que toutes ces armes dont il est affublé l’empêchent d’aboutir à des conclusions d’une logique toute humanitaire, car déjà à l’époque on pouvait voir combien les engins de guerre sont susceptibles d’amener un homme à penser différemment, nous le savons bien mieux aujourd’hui, encore que pas suffisamment pour retirer leurs armes à ceux qui généralement s’en servent comme unique cerveau."
                                            },
                                            {
                                                "example_id": "035348f0-e971-4c50-8294-a9f5639e8fab",
                                                "sense_id": "b46fb157-e0ab-3f39-b539-2f41d24ae567",
                                                "text": "Jouer de l’espadon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc7a98cb-9886-3429-9e09-91e91d0be207",
                                        "entry_id": "8f27a218-5486-339c-8814-2096e4e98cd8",
                                        "glosses": [
                                            "Sabre dont on apprend à se servir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5820bed4-d79d-41c9-bda1-362c08640724",
                                                "sense_id": "fc7a98cb-9886-3429-9e09-91e91d0be207",
                                                "text": "Maître d’espadon."
                                            },
                                            {
                                                "example_id": "3e2a6575-f42e-4212-a8ab-64151efe4099",
                                                "sense_id": "fc7a98cb-9886-3429-9e09-91e91d0be207",
                                                "text": "Apprendre l’espadon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6ae8b007-5084-37f3-9e95-5296f1fc3eba",
                                        "entry_id": "8f27a218-5486-339c-8814-2096e4e98cd8",
                                        "glosses": [
                                            "Homosexuel."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e0110048-a3ad-3877-af42-6720832cc3d2",
                                        "entry_id": "8f27a218-5486-339c-8814-2096e4e98cd8",
                                        "glosses": [
                                            "Espèce de grand poisson osseux marin pélagique, qui possède un long nez (le rostre) plutôt aplati qui représente le tiers de la longueur totale de l'animal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "063689bc-baa1-45b6-88a8-9f2b22e5b221",
                                                "sense_id": "e0110048-a3ad-3877-af42-6720832cc3d2",
                                                "text": "Quelle que soit l’espèce visée, du thon à l’anchois en passant par l’espadon, les professionnels de la pêche pélagique n’ont de cesse lors de leurs marées, d’essayer de diminuer les coûts du poste recherche du poisson."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7f89bf9d-17c9-3b6c-a725-8362465b76ea",
                                        "entry_id": "8f27a218-5486-339c-8814-2096e4e98cd8",
                                        "glosses": [
                                            "Chair cuisinée de ce poisson."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
