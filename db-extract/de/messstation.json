                "senses": [
                    {
                        "sense_id": "966b97ce-2f9a-34ea-b72e-cc95f35e291b",
                        "entry_id": "e7f08a4a-8892-3532-ace8-266a9842e1ea",
                        "glosses": [
                            "Station zum Durchführen von Messungen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bbbfc557-540a-4984-a5f1-e03cb3e2edad",
                                "sense_id": "966b97ce-2f9a-34ea-b72e-cc95f35e291b",
                                "text": "Diese Messstation misst die Luftqualität und Feinstaubbelastung."
                            },
                            {
                                "example_id": "35076202-5aca-4b39-9755-06a7466ef9c9",
                                "sense_id": "966b97ce-2f9a-34ea-b72e-cc95f35e291b",
                                "text": "„Als Erfolg der Anhörung wertet Matthée, dass die Stadt Lünen eine weitere Messstation beantragen werde, das die Stadt Waltrop ihr Nein zum Kraftwerk bestätigt habe und das die Umweltverbände bei weiteren Teilgenehmigungen beteiligt werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
