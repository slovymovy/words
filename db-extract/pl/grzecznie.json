                        ]
                    },
                    {
                        "translation_id": "296f9de0-78d8-440d-86b4-b52d5cf3eabb",
                        "source_entry_id": "69d91e2e-67cc-3bd5-ab50-2404915a6ea9",
                        "source_sense_id": "f180e623-d8e9-33d7-a8da-492753690fff",
                        "target_lang_word": "poliment",
