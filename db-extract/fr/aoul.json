                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "aul",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "26ef909d-2cab-3804-8070-56b2233e6a88",
                                        "entry_id": "c686ce06-a453-394e-9a53-60bf91590b0b",
                                        "glosses": [
                                            "Obsolete spelling of awl."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8c70ccc1-9608-4e5d-9bb4-02e87f181f76",
                                                "sense_id": "26ef909d-2cab-3804-8070-56b2233e6a88",
                                                "text": "[…] and his master shall bore his ear through with an aul […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c10f1a39-71f2-48a3-91cc-a16b843f16fe",
                        "source_entry_id": "56ae025e-d059-31a7-856e-7fb74dae43f0",
                        "source_sense_id": "7e11857e-f054-3278-8d7a-1f10dae9697c",
