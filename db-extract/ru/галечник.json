                                        "entry_id": "8ac195dd-8824-3067-ab7c-eb91b4129cc5",
                                        "glosses": [
                                            "A small signboard designating a professional office; this may be both a physical signboard or a metaphoric term for a small production company (a production shingle)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f5a471b-255b-432d-8bb1-a3f099923e76",
                                                "sense_id": "bfea92e2-2a4a-3e68-8c25-ff56982e7361",
                                                "text": "He [...] hung a shingle as a barber."
                                            },
                                            {
                                                "example_id": "2b1ecbc5-a567-4da6-b0c0-ee43b2c67e6e",
                                                "sense_id": "bfea92e2-2a4a-3e68-8c25-ff56982e7361",
                                                "text": "When [these attorneys] were born, in the early decades of the 19th century, being a lawyer meant putting out a shingle and representing your neighbors."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "18fb5354-c853-3518-b382-86505d6a8d37",
                                        "entry_id": "8ac195dd-8824-3067-ab7c-eb91b4129cc5",
                                        "glosses": [
                                            "A word-based n-gram."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a74539c2-8a75-4dc6-bdae-7fe51d6aebcd",
                                                "sense_id": "18fb5354-c853-3518-b382-86505d6a8d37",
                                                "text": "In the second phase, we produce a list of all the shingles and the documents they appear in, sorted by shingle value."
                                            }
                                        ]
