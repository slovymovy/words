                "senses": [
                    {
                        "sense_id": "2105a072-96cf-33b7-9600-15ddade41eea",
                        "entry_id": "d68c94e4-2e71-3c07-9802-29599697f1ab",
                        "glosses": [
                            "een groep van mensen die samen turnen in club verband"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "90db948a-e668-4764-8fd1-accfd4a4b61c",
                                "sense_id": "2105a072-96cf-33b7-9600-15ddade41eea",
                                "text": "Tachina Peeters (Gymplus) heeft zich donderdag geplaatst voor de tumblingfinale op het EK trampoline en tumbling in de Azerbeidzjaanse hoofdstad Baku. Ook op de dubbele minitrampoline verzekerden Wannes Geens (Sterk en Lenig Drongen) en Anna Hulsens (Turnkring Altis Hulshout) zich van een finaleticket na afloop van de kwalificaties."
                            },
                            {
                                "example_id": "b45397c7-bdb1-47e6-a464-f72c78592d92",
                                "sense_id": "2105a072-96cf-33b7-9600-15ddade41eea",
                                "text": "Dennis Goossens (Turnkring Kerels Waasmunster) heeft zich woensdag op de Wereldbekerwedstrijd toestelturnen in de Qatarese hoofdstad Doha geplaatst voor de finale aan de ringen."
                            }
                        ]
                    }
