                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Viele lokale Betriebe <w>geschäften</w> seit vielen Jahren erfolgreich mit ausländischen Partnern.",
                            "target_lang_translations": {
                                "en": "Many local enterprises have been successfully <w>doing business</w> with foreign partners for many years.",
                                "ru": "Многие местные предприятия уже много лет успешно <w>ведут дела</w> с зарубежными партнерами.",
                                "nl": "Veel lokale bedrijven <w>handelen</w> al vele jaren met succes met buitenlandse partners.",
                                "pl": "Wiele lokalnych przedsiębiorstw od wielu lat z powodzeniem <w>robi interesy</w> z zagranicznymi partnerami.",
                                "fr": "De nombreuses entreprises locales <w>font des affaires</w> avec succès depuis de nombreuses années avec des partenaires étrangers.",
                                "it": "Molte imprese locali <w>fanno affari</w> con successo con partner stranieri da molti anni.",
                                "cs": "Mnoho místních podniků již mnoho let úspěšně <w>obchoduje</w> se zahraničními partnery.",
                                "tr": "Birçok yerel işletme uzun yıllardır yabancı ortaklarla başarılı bir şekilde <w>iş yapıyor</w>.",
                                "es": "Muchas empresas locales llevan muchos años <w>haciendo negocios</w> con éxito con socios extranjeros.",
                                "zh": "许多当地企业多年来一直成功地与外国伙伴<w>做生意</w>。"
                            }
                        },
                        {
                            "text": "Unser Unternehmen hat schon lange nicht mehr mit diesem unzuverlässigen Lieferanten <w>geschäftet</w>.",
                            "target_lang_translations": {
                                "en": "Our company has not <w>done business</w> with this unreliable supplier for a long time.",
                                "ru": "Наша компания уже давно не <w>вела дела</w> с этим ненадежным поставщиком.",
                                "nl": "Ons bedrijf heeft al lange tijd geen <w>zaken gedaan</w> met deze onbetrouwbare leverancier.",
                                "pl": "Nasza firma już od dawna nie <w>robiła interesów</w> z tym niesolidnym dostawcą.",
                                "fr": "Notre entreprise n'a plus <w>fait d'affaires</w> avec ce fournisseur peu fiable depuis longtemps.",
                                "it": "La nostra azienda non ha più <w>fatto affari</w> con questo fornitore inaffidabile da molto tempo.",
                                "cs": "Naše společnost s tímto nespolehlivým dodavatelem už dlouho <w>neobchodovala</w>.",
                                "tr": "Şirketimiz bu güvenilmez tedarikçiyle uzun zamandır <w>iş yapmadı</w>.",
                                "es": "Nuestra empresa hace mucho tiempo que no ha <w>hecho negocios</w> con este proveedor informal.",
                                "zh": "我们公司已经很久没有和这家不可靠的供应商<w>做生意</w>了。"
                            }
                        }
