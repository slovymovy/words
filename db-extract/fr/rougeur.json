                        "cross_references": [
                            {
                                "target_word": "румянец",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "2edae0fc-cc26-3515-bb7c-78ac7f29edce",
                                        "entry_id": "0383e546-436c-32fe-b0b5-92787e78f895",
                                        "glosses": [
                                            "розовый или алый цвет щёк"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c163fb2-673b-4f1c-80fe-09b5320863ee",
                                                "sense_id": "2edae0fc-cc26-3515-bb7c-78ac7f29edce",
                                                "text": "Молодой человек, казалось, был за то ей благодарен: она видела острым взором молодости, как быстрый румянец покрывал его бледные щёки всякий раз, когда взоры их встречались."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c71c694c-4c63-3144-b179-4409c8632022",
                                        "entry_id": "0383e546-436c-32fe-b0b5-92787e78f895",
                                        "glosses": [
                                            "краснота от прилива кро́ви к лицу"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "95988fa0-e360-4b38-b29c-37d65abfd5c9",
                                                "sense_id": "c71c694c-4c63-3144-b179-4409c8632022",
                                                "text": "Лицо его, недавно в багровых пятнах смятения, теперь покрывал ровный и густо-розовый румянец от выпитого вина́, такой цвет бывает у марципановых яблочек, которые вешают на ёлку."
                                            },
                                            {
                                                "example_id": "cdc59e06-2018-465d-940f-39bd38a7a58c",
                                                "sense_id": "c71c694c-4c63-3144-b179-4409c8632022",
                                                "text": "По её лицу заметался румянец."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dbe8bab6-e14c-3c9e-88a3-122ccf3964cf",
                                        "entry_id": "0383e546-436c-32fe-b0b5-92787e78f895",
                                        "glosses": [
                                            "перен., поэт. отражённый свет утренней или вечерней зари на чём-либо"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
