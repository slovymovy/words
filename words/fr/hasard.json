                    ]
                },
                {
                    "sense_id": "3a082ee9-397f-30c3-9fc0-4ef6d5ab7ddb",
                    "sense_definition": "Risque, danger ou éventualité incertaine liée aux événements futurs.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "risque",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les navigateurs devaient affronter tous les <w>hasards</w> de la mer sans équipement moderne."
                        },
                        {
                            "text": "Il a préféré tenter le coup et courir le <w>hasard</w> d'un refus."
