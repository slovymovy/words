                ],
                "senses": [
                    {
                        "sense_id": "e97e10b0-6a94-3c6c-b039-f74d070b460b",
                        "entry_id": "50942792-4fcd-3e85-b7d8-142f712aa88c",
                        "glosses": [
                            "de wijze waarop men denkt een aanval op de vijand met succes te kunnen uitvoeren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0dd9fb6-cf08-43ee-b68c-3b4f0194fc96",
                                "sense_id": "e97e10b0-6a94-3c6c-b039-f74d070b460b",
                                "text": "„Ze gaan te maken krijgen met vuur en woede die de wereld nog nooit gezien heeft”, zo luidde een tweet van de Amerikaanse president Trump aan het adres van Noord-Korea. De leider van dat land, Kim Jong-un, antwoordde met een aanvalsplan op Guam, een eiland in de Stille Zuidzee, dat valt onder Amerikaans grondgebied."
                            }
                        ]
                    },
                    {
                        "sense_id": "867d88df-a823-3fdc-b1cd-1af1d98d63f0",
                        "entry_id": "50942792-4fcd-3e85-b7d8-142f712aa88c",
                        "glosses": [
                            "de wijze waarop men denkt een probleem te kunnen oplossen"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "d88e1bd6-22ed-4c80-94f6-0f7c0fac5322",
                                "sense_id": "867d88df-a823-3fdc-b1cd-1af1d98d63f0",
                                "text": "Het eiland zou vergrijzen. Wij hebben besloten om dat niet te laten gebeuren en zijn met een aanvalsplan gekomen”, zegt Van der Vlugt."
                            },
                            {
                                "example_id": "329e72c1-55cd-4e7b-9b9f-86a17670af29",
                                "sense_id": "867d88df-a823-3fdc-b1cd-1af1d98d63f0",
                                "text": "In 2011 lanceerde de politie een zogenoemd aanvalsplan om de rammelende informatiehuishouding op orde te krijgen. Dat volgde op een het rapport ’ict politie 2010’ van de Rekenkamer. Hiervoor werd 374 miljoen euro uitgetrokken."
                            },
                            {
                                "example_id": "81516e3b-f702-4fb8-b878-f2b22a50754f",
                                "sense_id": "867d88df-a823-3fdc-b1cd-1af1d98d63f0",
                                "text": "'Wat is het aanvalsplan?' vroeg papa. Niets doen is voor hem nooit een optie. Als het nodig was, zou hij de helft van zijn eigen hersenen doneren om mij in leven te houden. Op blote voeten een berg beklimmen."
                            }
                        ]
                    }
