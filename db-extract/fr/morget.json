                "senses": [
                    {
                        "sense_id": "73002097-7788-35ea-9258-2c4a387c9c70",
                        "entry_id": "b727e385-18bd-3a5d-848b-4e2514b35b2e",
                        "glosses": [
                            "Un des types de vent qui souffle sur le lac Léman."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6cb65409-47e5-4265-aa78-6d573672d256",
                                "sense_id": "73002097-7788-35ea-9258-2c4a387c9c70",
                                "text": "Le joran qui descend du Jura, le morget du matin, le vaudaire qui déboule de la vallée du Rhône, le foehn qui fait fondre la neige, le vent-blanc, ainsi appelé parce qu’à son passage le lac moutonne, le séchard, le fraidieu qui bouscule les après-midi calmes, et d’autres encore."
                            },
                            {
                                "example_id": "0791df3b-2c2b-4953-8298-5ca1f39e191a",
                                "sense_id": "73002097-7788-35ea-9258-2c4a387c9c70",
                                "text": "Le morget, qui se fait sentir jusque sur la côte de Savoie, se confond d’ailleurs avec la brise de montagne."
                            },
                            {
                                "example_id": "83be441d-defb-400b-85cc-306a91492e93",
                                "sense_id": "73002097-7788-35ea-9258-2c4a387c9c70",
                                "text": "Cela ne veut pas dire que le morget est insignifiant. Sans doute, il ne peut pas rivaliser avec le violent joran qui renverse les bateaux sur le lac, mais il fait son petit ouvrage de vent."
                            }
                        ]
                    }
