                    }
                ],
                "senses": [
                    {
                        "sense_id": "5df2e9ad-b222-398f-8b93-d7e78fabb60b",
                        "entry_id": "200bef3f-d1ee-3bc4-9128-768a4faf1124",
                        "glosses": [
                            "To upload a video of something to YouTube."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "a843ad29-ec50-4dfe-93e3-3f98134864d3",
                                "sense_id": "5df2e9ad-b222-398f-8b93-d7e78fabb60b",
                                "text": "The revolution will not be televised. It will be YouTubed."
                            }
                        ]
                    },
                    {
                        "sense_id": "36db07fb-0a36-3304-a7c2-f25ad2de9fe7",
                        "entry_id": "200bef3f-d1ee-3bc4-9128-768a4faf1124",
                        "glosses": [
                            "To search for and view on YouTube."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "e67deeb9-d265-4ce5-840d-d020e973296a",
                                "sense_id": "36db07fb-0a36-3304-a7c2-f25ad2de9fe7",
                                "text": "Inquiry elicited that he was a pop singer. I YouTubed him, revealing another ghastly microphone-gripping, anguished nasal wailer."
                            },
                            {
                                "example_id": "a3c91372-f4da-4a0b-818e-154e71cba2e2",
                                "sense_id": "36db07fb-0a36-3304-a7c2-f25ad2de9fe7",
                                "text": "If you don't know me, YouTube me, because soon the whole world is going to know me."
                            }
                        ]
                    },
                    {
                        "sense_id": "83a39aca-3280-3e3e-9f2e-b6185cc8d49e",
                        "entry_id": "200bef3f-d1ee-3bc4-9128-768a4faf1124",
                        "glosses": [
                            "To upload or watch videos on YouTube."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "88d88835-ecf2-4b7d-8fd5-a09ea4a68495",
                                "sense_id": "83a39aca-3280-3e3e-9f2e-b6185cc8d49e",
                                "text": "He had discussed joining Atlanta United in MLS and following his retirement, there was an outside chance that Hugo Lloris’ current injury at Tottenham Hotspur would create an opening there. Other offers came and went, but it was YouTubing and podcasting that filled [Ben] Foster’s time, not football, albeit with the door to a comeback left slightly ajar."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "de713980-3909-4da8-b821-106d7efc8e34",
                        "source_entry_id": "200bef3f-d1ee-3bc4-9128-768a4faf1124",
                        "source_sense_description": "to upload a video of something to YouTube",
                        "target_lang_word": "youtuben",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "youtuben",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "96484f1c-4b02-353e-89c9-ba20a5c4af8a",
                                        "entry_id": "0e27b2da-8815-3874-bddf-ab693a7ec74e",
                                        "glosses": [
                                            "naar video's op de website YouTube kijken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70ab1e26-dcf0-4a07-9114-b3cf9d326a16",
                                                "sense_id": "96484f1c-4b02-353e-89c9-ba20a5c4af8a",
                                                "text": "„Ik moet jullie iets laten zien”, zeg ik tegen mijn dochters. We liggen – afgeschminkt en getandenpoetst – in mijn bedstee op de laptop te youtuben. Ik zoek de documentaire op."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0fa91e12-1e85-35e8-b3e3-9c80c9c946c9",
                                        "entry_id": "0e27b2da-8815-3874-bddf-ab693a7ec74e",
                                        "glosses": [
                                            "gebruik maken van de website YouTube om zelfgemaakte video breed te verspreiden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2662df66-fc1d-4b35-8d97-573541ccbbfc",
                                                "sense_id": "0fa91e12-1e85-35e8-b3e3-9c80c9c946c9",
                                                "text": "Ik noemde mezelf DutchVlogs, want tja, ik kende dat verschil tussen vloggen en youtuben toen nog niet zo goed."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2f68257f-64eb-46f2-b4db-1c16c194b93a",
                        "source_entry_id": "200bef3f-d1ee-3bc4-9128-768a4faf1124",
                        "source_sense_description": "to upload a video of something to YouTube",
                        "target_lang_word": "youtuben",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "youtuben",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e45b233c-1d1b-3c4f-8c8b-825c01335892",
                                        "entry_id": "5d073138-4087-33b5-b440-ba705f0f8350",
                                        "glosses": [
                                            "ein Video (für das Videoportal YouTube®) erstellen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c0dcb110-1591-4e78-95f2-7435b5c3566b",
                                                "sense_id": "e45b233c-1d1b-3c4f-8c8b-825c01335892",
                                                "text": "„Youtuber aber tun andere Dinge, sie youtuben, auch wenn niemand dieses Verb benutzt […].“"
                                            },
                                            {
                                                "example_id": "46814637-2255-4ace-9fd3-8668b17927f0",
                                                "sense_id": "e45b233c-1d1b-3c4f-8c8b-825c01335892",
                                                "text": "„Auf ‚LeNews‘ präsentiert und kommentiert er zweimal wöchentlich Nachrichten - von reißerischen Schlagzeilen bis skurrilen News - alles aufbereitet im Jugendslang. Außerdem youtubt er zu Games und Kurzfilmen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c9b1d398-89f8-35f0-b5b2-cd4bfe6d8ee9",
                                        "entry_id": "5d073138-4087-33b5-b440-ba705f0f8350",
                                        "glosses": [
                                            "das Videoportal YouTube® nutzen, etwa dort Videos ansehen oder Videos suchen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43172298-4568-47b5-aa2b-2e64ec018120",
                                                "sense_id": "c9b1d398-89f8-35f0-b5b2-cd4bfe6d8ee9",
                                                "text": "„Ok, wir sind in 2018, ich gebe zu, ich habe gar nichts herausgekramt, sondern das Smartphone in die Hand genommen und gegoogelt, geyoutubt und gelacht und geweint.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1157a042-c88e-4079-bec6-cff58b858000",
                        "source_entry_id": "200bef3f-d1ee-3bc4-9128-768a4faf1124",
                        "source_sense_description": "to search for and view on YouTube",
                        "target_lang_word": "youtuben",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "youtuben",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "96484f1c-4b02-353e-89c9-ba20a5c4af8a",
                                        "entry_id": "0e27b2da-8815-3874-bddf-ab693a7ec74e",
                                        "glosses": [
                                            "naar video's op de website YouTube kijken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70ab1e26-dcf0-4a07-9114-b3cf9d326a16",
                                                "sense_id": "96484f1c-4b02-353e-89c9-ba20a5c4af8a",
                                                "text": "„Ik moet jullie iets laten zien”, zeg ik tegen mijn dochters. We liggen – afgeschminkt en getandenpoetst – in mijn bedstee op de laptop te youtuben. Ik zoek de documentaire op."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0fa91e12-1e85-35e8-b3e3-9c80c9c946c9",
                                        "entry_id": "0e27b2da-8815-3874-bddf-ab693a7ec74e",
                                        "glosses": [
                                            "gebruik maken van de website YouTube om zelfgemaakte video breed te verspreiden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2662df66-fc1d-4b35-8d97-573541ccbbfc",
                                                "sense_id": "0fa91e12-1e85-35e8-b3e3-9c80c9c946c9",
                                                "text": "Ik noemde mezelf DutchVlogs, want tja, ik kende dat verschil tussen vloggen en youtuben toen nog niet zo goed."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c6376d0c-a2da-4ba2-9a53-aed9e1980e2d",
                        "source_entry_id": "200bef3f-d1ee-3bc4-9128-768a4faf1124",
                        "source_sense_description": "to search for and view on YouTube",
                        "target_lang_word": "youtuben",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "youtuben",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e45b233c-1d1b-3c4f-8c8b-825c01335892",
                                        "entry_id": "5d073138-4087-33b5-b440-ba705f0f8350",
                                        "glosses": [
                                            "ein Video (für das Videoportal YouTube®) erstellen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c0dcb110-1591-4e78-95f2-7435b5c3566b",
                                                "sense_id": "e45b233c-1d1b-3c4f-8c8b-825c01335892",
                                                "text": "„Youtuber aber tun andere Dinge, sie youtuben, auch wenn niemand dieses Verb benutzt […].“"
                                            },
                                            {
                                                "example_id": "46814637-2255-4ace-9fd3-8668b17927f0",
                                                "sense_id": "e45b233c-1d1b-3c4f-8c8b-825c01335892",
                                                "text": "„Auf ‚LeNews‘ präsentiert und kommentiert er zweimal wöchentlich Nachrichten - von reißerischen Schlagzeilen bis skurrilen News - alles aufbereitet im Jugendslang. Außerdem youtubt er zu Games und Kurzfilmen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c9b1d398-89f8-35f0-b5b2-cd4bfe6d8ee9",
                                        "entry_id": "5d073138-4087-33b5-b440-ba705f0f8350",
                                        "glosses": [
                                            "das Videoportal YouTube® nutzen, etwa dort Videos ansehen oder Videos suchen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43172298-4568-47b5-aa2b-2e64ec018120",
                                                "sense_id": "c9b1d398-89f8-35f0-b5b2-cd4bfe6d8ee9",
                                                "text": "„Ok, wir sind in 2018, ich gebe zu, ich habe gar nichts herausgekramt, sondern das Smartphone in die Hand genommen und gegoogelt, geyoutubt und gelacht und geweint.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
