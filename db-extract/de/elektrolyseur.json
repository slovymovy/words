                        "entry_id": "f886534d-052c-3d66-92fc-dce5796b5246",
                        "glosses": [
                            "Gerät, das zur Durchführung einer Elektrolyse dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ee0ec9d-0eb2-49d9-a111-032149576530",
                                "sense_id": "23170caf-e7fb-348e-ae58-89c4f9e8087d",
                                "text": "„Es braucht nur Strom aus erneuerbaren Energiequellen und eine technische Vorrichtung, den Elektrolyseur, mittels derer Wasser in Sauerstoff und Wasserstoff gespalten wird.“"
                            },
                            {
                                "example_id": "0d489a67-d148-4516-a881-04b57057e18c",
                                "sense_id": "23170caf-e7fb-348e-ae58-89c4f9e8087d",
                                "text": "„Platin beschleunigt Prozesse in Brennstoffzellen, Iridium in Elektrolyseuren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
