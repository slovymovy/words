                        "glosses": [
                            "To move backwards to an earlier stage; to devolve."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "81dde224-0c5e-3d9a-a6ed-a9c47ba99b16",
                        "entry_id": "0a54be34-d447-3335-9c27-b4d5ded84d71",
                        "glosses": [
                            "To move backwards to an earlier stage; to devolve.",
                            "To re-develop behavior one had previously grown out of, particularly a behavior left behind in childhood."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "509fae05-1a3f-4571-895b-b3d55fb7823b",
                                "sense_id": "81dde224-0c5e-3d9a-a6ed-a9c47ba99b16",
                                "text": "Your nightmares stopped when you were eight years old, but after the house burned down, you regressed."
                            }
                        ]
                    },
                    {
                        "sense_id": "4c93d5f0-118a-31e4-aa62-83b22b6147e6",
                        "entry_id": "0a54be34-d447-3335-9c27-b4d5ded84d71",
                        "glosses": [
                            "To move in the retrograde direction."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "682b8c66-b314-3740-b4a4-9c4bc1321afa",
                        "entry_id": "0a54be34-d447-3335-9c27-b4d5ded84d71",
                        "glosses": [
                            "To reduce in severity or size (as of a tumor), without reaching total remission."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "1a60ba9e-9f76-39fa-a3d7-aa173a34a6b4",
                        "entry_id": "0a54be34-d447-3335-9c27-b4d5ded84d71",
                        "glosses": [
                            "To perform a regression on an explanatory variable."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "cd6a2019-54fc-4d02-8c9f-918573c3a76c",
                                "sense_id": "1a60ba9e-9f76-39fa-a3d7-aa173a34a6b4",
                                "text": "When we regress Y on X, we use the values of variable X to predict those of Y."
                            }
                        ]
                    },
                    {
                        "sense_id": "fe3de8c6-5bd5-3eda-9c1b-40e14211133f",
                        "entry_id": "0a54be34-d447-3335-9c27-b4d5ded84d71",
                        "glosses": [
                            "To interrogate a person in a state of trance about forgotten elements of their past."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "29670939-897e-4995-a652-328d5abfa728",
                                "sense_id": "fe3de8c6-5bd5-3eda-9c1b-40e14211133f",
                                "text": "They regressed me, putting me under hypnosis. Then, through the hypnosis, they found out that our car was abducted right off the road and into a craft."
                            }
                        ]
                    }
                ],
