                        ]
                    },
                    {
                        "translation_id": "43bdb921-cff4-4e40-b7e5-f03833ea7248",
                        "source_entry_id": "8255e152-0546-36e3-84ab-221d6c93b153",
                        "source_sense_description": "разъяснение, объяснение",
                        "target_lang_word": "explanation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "explanation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dcba4dc7-09bc-3a91-93f8-db9aaf29acb2",
                                        "entry_id": "c41814ee-a326-3aa0-a00c-b21c1adfd30b",
                                        "glosses": [
                                            "The act or process of explaining."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "60906a1d-055d-4ea9-9831-60470e103713",
                                                "sense_id": "dcba4dc7-09bc-3a91-93f8-db9aaf29acb2",
                                                "text": "The explanation was long and drawn-out."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "30fa8df3-2483-3919-80b8-67bb5439ac16",
                                        "entry_id": "c41814ee-a326-3aa0-a00c-b21c1adfd30b",
                                        "glosses": [
                                            "Something that explains or makes understandable."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf764402-80f1-4def-944f-8a53943d6e83",
                                                "sense_id": "30fa8df3-2483-3919-80b8-67bb5439ac16",
                                                "text": "An explanation for the UFO sightings was easily found."
                                            },
                                            {
                                                "example_id": "cd63b806-2b9c-4ecc-960a-4e7860d0e759",
                                                "sense_id": "30fa8df3-2483-3919-80b8-67bb5439ac16",
                                                "text": "The socialist will, of course, see in this merely a proof that the more intelligent person is today bound to become a socialist. But this is far from being the necessary or even the most likely explanation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "42a55c3b-bc18-3e85-ad5a-82d715911072",
                                        "entry_id": "c41814ee-a326-3aa0-a00c-b21c1adfd30b",
                                        "glosses": [
                                            "A resolution of disputed points pursuant to discussion; a mutual clarification of disputed points; reconciliation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c5ace244-1b22-4335-8a9a-4abdf818a43f",
                                                "sense_id": "42a55c3b-bc18-3e85-ad5a-82d715911072",
                                                "text": "This little explanation with Mr. Knightley gave Emma considerable pleasure."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f557afc7-506b-468f-8148-ac0d152c034c",
                        "source_entry_id": "8255e152-0546-36e3-84ab-221d6c93b153",
                        "source_sense_description": "разъяснение, объяснение",
                        "target_lang_word": "interpretation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "interpretation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b22fccf2-d9de-3ca1-9243-35f8a85addb0",
                                        "entry_id": "a8a9e7fe-3d94-31a2-b162-2115eb15919f",
                                        "glosses": [
                                            "An act of interpreting or explaining something unclear; a translation; a version."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "259b9816-c505-488e-9daa-85c255deb149",
                                                "sense_id": "b22fccf2-d9de-3ca1-9243-35f8a85addb0",
                                                "text": "The interpretation of a dream, or of an enigma"
                                            },
                                            {
                                                "example_id": "f90d7db0-f741-4c2e-b059-298b3e18ff9f",
                                                "sense_id": "b22fccf2-d9de-3ca1-9243-35f8a85addb0",
                                                "text": "The interpretation of the rules"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "01dad0b6-834a-3ff7-8354-9f5d5694b5cc",
                                        "entry_id": "a8a9e7fe-3d94-31a2-b162-2115eb15919f",
                                        "glosses": [
                                            "A sense given by an interpreter; an exposition or explanation given; meaning."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3057e3ce-e758-41a0-9319-045d29b0bb6b",
                                                "sense_id": "01dad0b6-834a-3ff7-8354-9f5d5694b5cc",
                                                "text": "Commentators give various interpretations of the same passage of Scripture."
                                            },
                                            {
                                                "example_id": "7631e98d-4538-4bad-8ab1-2ce97ceafa3b",
                                                "sense_id": "01dad0b6-834a-3ff7-8354-9f5d5694b5cc",
                                                "text": "Again, the multiplist would hold that the grounds for separating admissible from inadmissible interpretations cannot be the same as the grounds for preferability among admissible interpretations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "22f1cec3-109d-301e-bac9-df9d35f81330",
                                        "entry_id": "a8a9e7fe-3d94-31a2-b162-2115eb15919f",
                                        "glosses": [
                                            "The discipline or study of translating one spoken or signed language into another (as opposed to translation, which concerns itself with written language)."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "186170c5-d787-410f-858d-9b27b9b71dd7",
                                                "sense_id": "22f1cec3-109d-301e-bac9-df9d35f81330",
                                                "text": "I believe that interpretation, particularly consecutive interpretation, is an art. I also believe, however, that the skill of consecutive interpretation can be taught, but only up to a point."
                                            },
                                            {
                                                "example_id": "06d6dab0-3c53-4d71-a869-c7474efc668c",
                                                "sense_id": "22f1cec3-109d-301e-bac9-df9d35f81330",
                                                "text": "Interpretation studies is a young discipline, much younger than translation studies, and it cannot claim a long tradition and history of reflexions ^([sic]) and studies."
                                            },
                                            {
                                                "example_id": "7f386ad8-9838-4a6e-846f-7d27de247280",
                                                "sense_id": "22f1cec3-109d-301e-bac9-df9d35f81330",
                                                "text": "The most pervasive need of non-English-speaking immigrants and refugees is interpretation for every English transaction. Interpretation is needed in stores, schools, and job training, and it is of critical importance in health care."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce058036-e177-3982-962e-5adac78ebb1d",
                                        "entry_id": "a8a9e7fe-3d94-31a2-b162-2115eb15919f",
                                        "glosses": [
                                            "The power of explaining."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "864fd0a4-4d6c-3945-87ae-cb1dcfda0332",
                                        "entry_id": "a8a9e7fe-3d94-31a2-b162-2115eb15919f",
                                        "glosses": [
                                            "An artist's way of expressing thought or embodying a conception of nature through art."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "88069b6c-76bf-355d-a35a-1d4716efa98d",
                                        "entry_id": "a8a9e7fe-3d94-31a2-b162-2115eb15919f",
                                        "glosses": [
                                            "An act or process of applying general principles or formulae to the explanation of the results obtained in special cases."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d8d39647-813a-322f-9a61-ecdf9e41b0d5",
                                        "entry_id": "a8a9e7fe-3d94-31a2-b162-2115eb15919f",
                                        "glosses": [
                                            "An approximation that allows aspects of a mathematical theory to be discussed in ordinary language."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e79c8774-3cb8-37c3-b696-b58d94876067",
                                        "entry_id": "a8a9e7fe-3d94-31a2-b162-2115eb15919f",
                                        "glosses": [
                                            "An assignment of a truth value to each propositional symbol of a propositional calculus."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a5d41749-3198-39cb-9ff9-ec409798e394",
                                        "entry_id": "a8a9e7fe-3d94-31a2-b162-2115eb15919f",
                                        "glosses": [
                                            "Short for heritage interpretation"
                                        ],
                                        "tags": [
