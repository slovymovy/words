                            {
                                "example_id": "ba7648ab-a9eb-4b31-8eea-1bcadec6b531",
                                "sense_id": "fa1d9fb1-2c40-35fa-a2d5-f059d9087c8e",
                                "text": "Au total, 148 ferristes (combatants) composés de femmes et d’hommes se sont affrontés dans 10 catégories."
                            },
                            {
                                "example_id": "14d550dd-e4e2-4edd-b3bc-7e1a2f15cd6e",
                                "sense_id": "fa1d9fb1-2c40-35fa-a2d5-f059d9087c8e",
                                "text": "La ferriste tient à relever que son sport de prédilection a bien évolué au cours de ces dernières années."
                            },
                            {
                                "example_id": "dadb7093-3063-4f36-a5ed-41eabab92c44",
                                "sense_id": "fa1d9fb1-2c40-35fa-a2d5-f059d9087c8e",
                                "text": "Contrairement à certaines idées préconçues, on ne s’improvise pas «ferriste» du jour au lendemain."
                            },
                            {
                                "example_id": "22f1c33a-005c-41f9-bc75-048a2b718acc",
                                "sense_id": "fa1d9fb1-2c40-35fa-a2d5-f059d9087c8e",
                                "text": "Un bon ferriste doit savoir tourner le poignet de l’adversaire, jouer des pectoraux et de la torsion du corps. C’est pas le tout d’être un balèze..."
                            }
                        ]
