                    "sense_definition": "Support de fixation fixé au mur pour soutenir la main courante d'un escalier.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "architecture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le menuisier a vissé solidement chaque <w>écuyer</w> dans le mur pour fixer la rampe en bois."
                        },
                        {
                            "text": "Un <w>écuyer</w> en métal noir assure le maintien de la main courante le long des marches."
                        }
                    ]
                }
            ]
