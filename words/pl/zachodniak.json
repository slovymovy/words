                    "sense_definition": "Mieszkaniec zachodniej części jakiegoś obszaru, kraju lub kontynentu, na przykład Europy Zachodniej.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wielu <w>zachodniaków</w> przyjeżdża do Krakowa, bo ceny są tu dużo niższe niż u nich w kraju.",
                            "target_lang_translations": {
                                "ru": "Многие <w>жители Запада</w> приезжают в Краков, потому что цены здесь намного ниже, чем у них на родине."
                            }
                        },
                        {
                            "text": "Jako typowy <w>zachodniak</w> musiał długo przyzwyczajać się do tutejszych zwyczajów i kultury.",
                            "target_lang_translations": {
                                "ru": "Как типичный <w>житель Запада</w>, он должен был долго привыкать к местным обычаям и культуре."
                            }
                        }
                    ],
                    "antonyms": [
                        "wschodniak"
                    ],
                    "common_phrases": [
                        "typowy zachodniak",
                        "bogaty zachodniak"
                    ],
