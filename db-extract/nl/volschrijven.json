        "nl-extract.jsonl": [
            {
                "entry_id": "b12e17c6-f25f-3fdf-a157-b7344d4b4b20",
                "word": "volschrijven",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "968b3332-940e-3456-a0d5-888d718bdae4",
                        "entry_id": "b12e17c6-f25f-3fdf-a157-b7344d4b4b20",
                        "glosses": [
                            "helemaal vullen met geschreven tekst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "08ece018-e19e-4405-9dd0-78e385bede48",
                                "sense_id": "968b3332-940e-3456-a0d5-888d718bdae4",
                                "text": "„Hij zal ruim tweeduizend vellen volschrijven, 1 liter inkt verbruiken en ruim 1 kilometer papier nodig hebben”, zei mediakunstenaar Matthias Gommel, die de Bijbelrobot met collega’s heeft geprogrammeerd."
                            },
                            {
                                "example_id": "d0003e77-5a3b-48cc-8cba-915d18366f6e",
                                "sense_id": "968b3332-940e-3456-a0d5-888d718bdae4",
                                "text": "Kijk je door haar ogen, dan zie je één zwarte pop tussen het speelgoed op de crèche van mijn kinderen. Je ziet dat de vrouwen in reclames en op foto's in tijdschriften bijna allemaal wit zijn. Dat de mensen die onze kranten volschrijven bijna allemaal een andere huidskleur hebben dan jij. Dat je een opleiding gaat doen en bijna alle docenten wit zijn."
                            },
                            {
                                "example_id": "51bd7f19-db5c-4f98-b36d-588704e74694",
                                "sense_id": "968b3332-940e-3456-a0d5-888d718bdae4",
                                "text": "De chef was onlangs in Amsterdam voor de presentatie van zijn boek en daar vertelde hij het leuk te vinden als mensen zijn boeken volschrijven met aantekeningen en de recepten aanpassen. „Dat is het mooiste compliment”, zei hij, „want dan leeft een recept voort”."
                            }
                        ]
                    }
                ],
