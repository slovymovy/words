                        "entry_id": "2866f103-739e-3150-9f85-e4a8125b82dd",
                        "glosses": [
                            "A type of garnet having a deep red color, inclining to purple, with the chemical formula Fe₃Al₂(SiO₄)₃."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "c8a4d210-2c77-457d-99f8-f2fc1513951d",
                                "sense_id": "f48851af-ed9d-30e2-88c7-5f247f28730f",
                                "text": "Almandine, the variety found here, is stable at temperatures of 540 to 900°C at a pressure of 200 GPa."
                            }
                        ]
                    }
                ],
