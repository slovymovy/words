                    }
                ],
                "senses": [
                    {
                        "sense_id": "6c98b271-ab38-3175-844c-b4e6a8d1e66e",
                        "entry_id": "85c07fc1-e89e-3aef-8a91-890e26bdddd6",
                        "glosses": [
                            "To be inherent; to be an essential or intrinsic part of; to be fixed or permanently incorporated with something."
                        ],
                        "tags": [
                            "uncommon"
                        ],
                        "examples": [
                            {
                                "example_id": "2f596e76-07c7-406f-aebb-752142084ffc",
                                "sense_id": "6c98b271-ab38-3175-844c-b4e6a8d1e66e",
                                "text": "He [Massinger] inherits the traditions of conduct, female chastity, hymeneal sanctity, the fashion of honour, without either criticizing or informing them from his own experience. In the earlier drama these conventions are merely a framework, or an alloy necessary for working the metal; the metal itself consisted of unique emotions resulting inevitably from the circumstances, resulting or inhering as inevitably as the properties of a chemical compound."
                            },
                            {
                                "example_id": "991d9bfd-32a0-4cc4-8f69-f7a091ccc731",
                                "sense_id": "6c98b271-ab38-3175-844c-b4e6a8d1e66e",
                                "text": "We had already been claimed by the split infinitives of Star Trek, were already preparing to boldly go into a world where ethics, so far from inhering in the very structure of the cosmos, was a matter of personal taste […]."
                            },
                            {
                                "example_id": "e4ed3adf-e9ba-4452-810f-db175c291b5a",
                                "sense_id": "6c98b271-ab38-3175-844c-b4e6a8d1e66e",
                                "text": "[…]such developments are attributable in part to the tendencies for parallel 'drift' that inhere in genetically related languages because of the perseverance of typological similarities – an idea originally put forward by Sapir."
                            },
                            {
                                "example_id": "8624275e-8f61-4f0e-ab39-6234d2ab8ba5",
                                "sense_id": "6c98b271-ab38-3175-844c-b4e6a8d1e66e",
                                "text": "Sovereignty should inhere in the people and not the government, so governments forfeit sovereignty when they commit crimes against humanity."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5a763a01-8c85-4570-b3eb-1678c3be61fd",
                        "source_entry_id": "85c07fc1-e89e-3aef-8a91-890e26bdddd6",
                        "source_sense_id": "6c98b271-ab38-3175-844c-b4e6a8d1e66e",
                        "source_sense_description": "To be inherent; to be an essential or intrinsic part of; to be fixed or permanently incorporated with something",
                        "target_lang_word": "inhouden",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inhouden",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "977a3974-ad53-3680-a3bb-a52162656754",
                                        "entry_id": "0e5a8cdd-d90d-303d-a59f-6f7362bf324c",
                                        "glosses": [
                                            "een deel van het loon niet uitbetalen om het voor een ander doel te bestemmen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b3847c44-080e-4088-a37e-16df156c6ac7",
                                                "sense_id": "977a3974-ad53-3680-a3bb-a52162656754",
                                                "text": "Er worden zowel belasting als sociale premies ingehouden ."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bb41cd78-f1ba-33c8-9f22-c914fd8c93ea",
                                        "entry_id": "0e5a8cdd-d90d-303d-a59f-6f7362bf324c",
                                        "glosses": [
                                            "niet uitademen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "002dc591-4b96-4ad0-bc3b-e49d0dbbe4e2",
                                                "sense_id": "bb41cd78-f1ba-33c8-9f22-c914fd8c93ea",
                                                "text": "Hij hield zijn adem in om de schuwe vogel niet weg te jagen."
                                            },
                                            {
                                                "example_id": "9cf56732-9883-4412-90f0-79da8fb01fe4",
                                                "sense_id": "bb41cd78-f1ba-33c8-9f22-c914fd8c93ea",
                                                "text": "Iedereen hield zijn adem in toen Christa's sombere ogen in de spiegel keken en iedereen ademde opgelucht uit toen er een vage maar gemeende glimlach op haar gezicht verscheen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f57f9284-90c2-378a-9248-e95b655370ab",
                                        "entry_id": "0e5a8cdd-d90d-303d-a59f-6f7362bf324c",
                                        "glosses": [
                                            "zijn mening of emoties niet uiten"
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a82f91d9-439a-40f2-b724-15dbff24403f",
                                                "sense_id": "f57f9284-90c2-378a-9248-e95b655370ab",
                                                "text": "De laatste weken kon de vorige president zich niet meer inhouden, en bekritiseerde hij Trumps aanpak van de coronacrisis (‘chaos’) en diens dreigende taal over het neerslaan van de protesten tegen racisme, zo nodig door het leger."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "56d482f6-b6cf-3f2e-bc12-c65001d9c31c",
                                        "entry_id": "0e5a8cdd-d90d-303d-a59f-6f7362bf324c",
                                        "glosses": [
                                            "een niet onmiddellijk duidelijke betekenis hebben"
                                        ],
                                        "tags": [
                                            "absolute"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d8b5dcac-dfdb-489d-b3e2-d7e5e0498472",
                                                "sense_id": "56d482f6-b6cf-3f2e-bc12-c65001d9c31c",
                                                "text": "De voorgenomen regels in verband met Homeland Security in New York zouden inhouden dat er voor alle meetapparatuur die men in de stad gebruiken wil eerst bij de politie een vergunning gehaald moet worden."
                                            },
                                            {
                                                "example_id": "10f47620-32ca-4f97-b1cd-a44f57e5a9cd",
                                                "sense_id": "56d482f6-b6cf-3f2e-bc12-c65001d9c31c",
                                                "text": "In het normale leven denk ik zelden aan de dood, maar hier stond ik elke dag voor beslissingen die weleens fataal af konden lopen, zoals het wel of niet oversteken van een woeste rivier of een hoge pas overgaan tijdens noodweer. Al deze ervaringen maakten dat ik ging nadenken over wat de dood precies inhield."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
