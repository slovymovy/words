{
    "word_family": [
        "sod"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "abb20e79-00e2-3efb-a6e7-7c4f3ee53007",
                    "sense_definition": "Soaked or drenched with liquid; soggy, saturated.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "wet",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her <w>sodden</w> coat dripped water all over the hallway floor.",
                            "target_lang_translations": {
                                "ru": "С её <w>промокшего насквозь</w> пальто капала вода на весь пол в прихожей."
                            }
                        },
                        {
                            "text": "The heavy rain turned the ground into <w>sodden</w> mud.",
                            "target_lang_translations": {
                                "ru": "Сильный дождь превратил землю в <w>раскисшую</w> грязь."
                            }
                        }
                    ],
                    "synonyms": [
                        "waterlogged",
                        "wet"
                    ],
                    "common_phrases": [
                        "sodden ground"
                    ],
                    "target_lang_definitions": {
                        "ru": "Промокший насквозь, пропитанный водой или другой жидкостью; сырой, хлюпающий."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "промокший",
                                "target_lang_sense_clarification": "насквозь пропитанный водой"
                            },
                            {
                                "target_lang_word": "намокший",
                                "target_lang_sense_clarification": "сильно смоченный жидкостью"
                            },
                            {
                                "target_lang_word": "сырой",
                                "target_lang_sense_clarification": "пропитанный влагой, хлюпающий"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1fc7663c-34fe-3db0-bf68-5de4d027cf44",
                    "sense_definition": "Dull and expressionless in appearance.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "dull",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He stared at the wall with a <w>sodden</w> expression that revealed nothing of his thoughts.",
                            "target_lang_translations": {
                                "ru": "Он смотрел в стену с <w>отупелым</w> выражением лица, не выдававшим никаких мыслей."
                            }
                        },
                        {
                            "text": "The long hours of work left her with a <w>sodden</w> look on her face.",
                            "target_lang_translations": {
                                "ru": "Долгие часы работы оставили на её лице <w>бессмысленный</w> взгляд."
                            }
                        }
                    ],
                    "synonyms": [
                        "blank",
                        "stonefaced"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тусклый, вялый и лишенный выражения (о взгляде, лице)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отупелый",
                                "target_lang_sense_clarification": "лишенный выражения, безжизненный"
                            },
                            {
                                "target_lang_word": "бессмысленный",
                                "target_lang_sense_clarification": "о взгляде или выражении лица"
                            },
                            {
                                "target_lang_word": "тупой",
                                "target_lang_sense_clarification": "невыразительный, остекленевший"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cf22ba5b-d225-3aee-911f-62000ef7a354",
                    "sense_definition": "Drunk or stupid due to excessive alcohol consumption.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "drunk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>sodden</w> man could barely stand up after drinking all night.",
                            "target_lang_translations": {
                                "ru": "<w>Отупевший от пьянства</w> мужчина едва мог стоять на ногах после того, как пил всю ночь."
                            }
                        },
                        {
                            "text": "His <w>sodden</w> brain made it impossible for him to follow the simple instructions.",
                            "target_lang_translations": {
                                "ru": "Его <w>пропитой</w> мозг не позволял ему следовать даже простым указаниям."
                            }
                        }
                    ],
                    "synonyms": [
                        "drunk"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Often used in older literature to describe someone heavily intoxicated."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Отупевший или пьяный от чрезмерного употребления алкоголя."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отупевший",
                                "target_lang_sense_clarification": "от алкоголя или опьянения"
                            },
                            {
                                "target_lang_word": "пропитой",
                                "target_lang_sense_clarification": "деградировавший от пьянства"
                            },
                            {
                                "target_lang_word": "пьяный",
                                "target_lang_sense_clarification": "сильно захмелевший, невменяемый"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c5cbeda1-306c-3219-8120-64c284671da1",
                    "sense_definition": "Boiled or cooked in liquid.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "cooked",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The recipe called for <w>sodden</w> meat that had been simmered for several hours.",
                            "target_lang_translations": {
                                "ru": "По рецепту требовалось <w>разваренное</w> мясо, томившееся в течение нескольких часов."
                            }
                        },
                        {
                            "text": "They served the <w>sodden</w> vegetables alongside the main course.",
                            "target_lang_translations": {
                                "ru": "Они подали <w>варёные</w> овощи вместе с основным блюдом."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This usage is largely obsolete in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сваренный или вываренный в жидкости (устар.)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разваренный",
                                "target_lang_sense_clarification": "сильно сваренный в воде"
                            },
                            {
                                "target_lang_word": "варёный",
                                "target_lang_sense_clarification": "приготовленный в жидкости"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c3efac39-4ada-332e-8b1a-657b1a182445",
                    "sense_definition": "To drench, soak or saturate.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "wet",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The constant rain began to <w>sodden</w> the fields until they were impassable.",
                            "target_lang_translations": {
                                "ru": "Непрекращающийся дождь начал так <w>размачивать</w> поля, что по ним стало невозможно пройти."
                            }
                        },
                        {
                            "text": "The spilled water started to <w>sodden</w> the papers on the desk.",
                            "target_lang_translations": {
                                "ru": "Пролитая вода начала <w>пропитывать</w> бумаги на столе."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Промачивать насквозь, напитывать влагой или жидкостью."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "промачивать",
                                "target_lang_sense_clarification": "делать насквозь мокрым"
                            },
                            {
                                "target_lang_word": "размачивать",
                                "target_lang_sense_clarification": "насыщать влагой до размягчения"
                            },
                            {
                                "target_lang_word": "пропитывать",
                                "target_lang_sense_clarification": "насыщать жидкостью"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b1f57b7a-1c2b-3fdc-b9e9-f22223c8261f",
                    "sense_definition": "To become soaked.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "wet",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dry earth began to <w>sodden</w> as the storm intensified.",
                            "target_lang_translations": {
                                "ru": "Сухая земля начала <w>размокать</w> по мере усиления бури."
                            }
                        },
                        {
                            "text": "Watch the fabric <w>sodden</w> as it absorbs the spilled liquid.",
                            "target_lang_translations": {
                                "ru": "Посмотри, как ткань <w>намокает</w>, впитывая пролитую жидкость."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Промокать насквозь, напитываться водой или влагой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "промокать",
                                "target_lang_sense_clarification": "пропитываться жидкостью"
                            },
                            {
                                "target_lang_word": "намокать",
                                "target_lang_sense_clarification": "становиться влажным, мокрым"
                            },
                            {
                                "target_lang_word": "размокать",
                                "target_lang_sense_clarification": "раскисать от влаги"
                            }
                        ]
                    }
                }
            ]
        }
    ]
