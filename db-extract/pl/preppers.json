                                "target_senses": [
                                    {
                                        "sense_id": "96837cfa-2fa7-3fda-9644-87736ace07ce",
                                        "entry_id": "c39b58a5-675e-3ca0-8446-5e5928d38e08",
                                        "glosses": [
                                            "A student at a prep school."
                                        ],
                                        "tags": [
                                            "UK",
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3787d318-ae23-3baa-b62d-4f47e14c5fff",
                                        "entry_id": "c39b58a5-675e-3ca0-8446-5e5928d38e08",
                                        "glosses": [
                                            "A prep school."
                                        ],
                                        "tags": [
                                            "UK",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c8feb3af-d25d-4671-bb00-5649bd7d1062",
                                                "sense_id": "3787d318-ae23-3baa-b62d-4f47e14c5fff",
                                                "text": "‘We have a vacancy at a very nice little prepper in North Yorkshire. Cundall Manor.’"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "prepper",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0f411be3-6c2b-349a-8492-be27edbb9b77",
                                        "entry_id": "0fdcdf01-2e76-3c5c-a91f-e4fc88a0fb27",
                                        "glosses": [
                                            "A survivalist; one who actively prepares for emergencies."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8fe9450f-8457-4ff5-95e7-eff945d74ba1",
                                                "sense_id": "0f411be3-6c2b-349a-8492-be27edbb9b77",
                                                "text": "Preppers are keen not to be seen as survivalists – the stereotypically anti-government, wood-dwelling, gun-toting hermits of past decades. Rather than isolating themselves in preparation for Armageddon, preppers tend to have normal jobs, mingle with their communities and take a more relaxed view about looming disasters."
                                            },
                                            {
                                                "example_id": "d48dc59b-4cae-4cc7-8d50-455f1adb62f6",
                                                "sense_id": "0f411be3-6c2b-349a-8492-be27edbb9b77",
                                                "text": "After all, Pinterest co-founder Evan Sharp says it was always meant to be a utility: “It’s a tool people use to plan their futures,” he told ReadWrite earlier this year. Preppers just happen to think the future looks bleak."
                                            },
                                            {
                                                "example_id": "0342716b-f8d4-437f-9c57-fe8d02178bce",
                                                "sense_id": "0f411be3-6c2b-349a-8492-be27edbb9b77",
                                                "text": "Earlier today, I found myself taking it down and flicking through its index — “handcranked lanterns”; “pandemic”; “panic, avoidance of” — in a manner that felt remarkably different to how I had flicked through it in the past. The themes and motifs of the prepper movement are having a moment in the mainstream."
                                            },
                                            {
                                                "example_id": "42102360-60b2-4d9a-9b97-a1919b68c387",
                                                "sense_id": "0f411be3-6c2b-349a-8492-be27edbb9b77",
                                                "text": "The preppers were living in flush times in a beautiful region, but it seemed like the first thing they did with money was steel for the apocalypse."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "62084b0f-9648-4662-a500-0e40e98d809f",
                        "source_entry_id": "4f83f9e1-1c10-3ce4-82a5-be817a102dcd",
                        "source_sense_id": "31f829af-bb83-372d-897b-948d3c8c18a7",
