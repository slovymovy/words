        "ru-extract.jsonl": [
            {
                "entry_id": "ccbbd8b7-8226-360b-9606-65457ca15827",
                "word": "Марков",
                "pos": "name",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "d30543eb-8c5c-3785-8b2b-ae9fa6a45a63",
                        "entry_id": "ccbbd8b7-8226-360b-9606-65457ca15827",
                        "glosses": [
                            "русская фамилия"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "428331a9-a8a8-4e66-aa66-d81f7a814ff3",
                                "sense_id": "d30543eb-8c5c-3785-8b2b-ae9fa6a45a63",
                                "text": "К середине дня в Москве было около 350 задержанных. Среди них оказался фотограф Дмитрий Марков. Суд над Навальным ещё шёл, когда Марков выложил в сеть фотографию, сделанную в ОВД, куда его доставили после задержания .."
                            }
                        ]
                    },
                    {
                        "sense_id": "109b3ed4-e1a2-374a-aff4-333973510e47",
                        "entry_id": "ccbbd8b7-8226-360b-9606-65457ca15827",
                        "glosses": [
                            "болгарская фамилия"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dfae2be3-20c1-4476-9d80-f7db88cd9799",
                                "sense_id": "109b3ed4-e1a2-374a-aff4-333973510e47",
                                "text": "В сентябре 1978 года в Лондоне был убит болгарский диссидент Георгий Марков, сотрудник Би-би-си. Проходя по мосту Ватерлоо, он получил укол зонтиком. Дома Марков почувствовал себя плохо и был госпитализирован. Но и в больнице не сразу обнаружили след от укола — микроскопическую ранку на бедре. Через четыре дня Марков скончался."
                            }
                        ]
                    }
                ],
