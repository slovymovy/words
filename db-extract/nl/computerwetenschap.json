                    },
                    {
                        "translation_id": "57870a5a-43ec-4b00-978b-6045fe381d7d",
                        "source_entry_id": "9ee365db-ddf8-34fc-9ee2-d73338631cf8",
                        "source_sense_id": "34a7e002-e6b7-3ccd-bf86-ef3d9f1d42b8",
