                ],
                "senses": [
                    {
                        "sense_id": "d63f3cbc-6bfc-39fb-9df2-ffaccfbcc7c5",
                        "entry_id": "496e1134-6140-3c11-b83a-3bda4093571d",
                        "glosses": [
                            "кулин. кондитерское изделие из тестообразной фруктово-ягодной массы, сбитой с сахаром и яичными белками"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "300cd16f-1d6c-4930-8712-1460dbb0eb99",
                                "sense_id": "d63f3cbc-6bfc-39fb-9df2-ffaccfbcc7c5",
                                "text": "Мы ели пастилу едва ли не каждый день."
                            },
                            {
                                "example_id": "7fb4b53b-889a-44c6-bfaa-7f7ae650d032",
                                "sense_id": "d63f3cbc-6bfc-39fb-9df2-ffaccfbcc7c5",
                                "text": "[Хавронья:] В горшечке, да в муравленом, .. французский пирог из подрукавной муки, а начинка из брусничной пастилы."
                            },
                            {
                                "example_id": "ce12df73-0310-4945-9a24-124552ec89b0",
                                "sense_id": "d63f3cbc-6bfc-39fb-9df2-ffaccfbcc7c5",
                                "text": "Хозяйка сделалась словоохотнее и открывала сама, без просьбы, множество секретов насчет делания пастилы и сушения груш."
                            },
                            {
                                "example_id": "7a9acf7a-849b-450c-8db1-d6e103db90ea",
                                "sense_id": "d63f3cbc-6bfc-39fb-9df2-ffaccfbcc7c5",
                                "text": "Она .. угощала гостей вареньем и яблочной пастилой."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "151e593e-2b47-42d6-8e91-7e5b69d7f7ae",
                        "source_entry_id": "496e1134-6140-3c11-b83a-3bda4093571d",
                        "source_sense_id": "d63f3cbc-6bfc-39fb-9df2-ffaccfbcc7c5",
                        "target_lang_word": "pastila",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pastila",
