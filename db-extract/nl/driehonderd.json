                        "examples": [
                            {
                                "example_id": "f35c6671-d5e9-43e2-af84-3138a5c8e4c7",
                                "sense_id": "7abf8b54-4ff8-338b-883d-10fcbc9ca932",
                                "text": "Want dezelve had kunnen boven de driehonderd penningen verkocht, en die den armen gegeven worden; en zij vergrimden tegen haar.",
                                "translation": "Ибо можно было бы продать его более нежели за триста динариев и раздать нищим. И роптали на нее."
                            }
                        ]
                    }
                ],
