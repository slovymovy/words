                        "sense_id": "1dbdec4f-e086-347f-9a18-834682e7ec37",
                        "entry_id": "dd205024-8829-3a09-ae3d-0fdd52cf3c53",
                        "glosses": [
                            "Depression nach einer Geburt, bei Frauen nach der Entbindung auftretende Depression"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94932aa4-64e5-4cb8-9254-3ae3e5e32ac1",
                                "sense_id": "1dbdec4f-e086-347f-9a18-834682e7ec37",
                                "text": "„Da Terra unter Wochenbettdepressionen litt, vermuteten Charles und auch Terras Therapeutin, sie hätte sich einfach nur einen Tapetenwechsel gegönnt.“"
                            },
                            {
                                "example_id": "49088c7f-dc0f-4c74-8a20-ca0b7fd1aeac",
                                "sense_id": "1dbdec4f-e086-347f-9a18-834682e7ec37",
                                "text": "„›Es war sehr viel schlimmer als die übliche Wochenbettdepression, die man so kennt.‹“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
