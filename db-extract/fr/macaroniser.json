                                "example_id": "97b49249-646c-40ed-bd1c-716486d60cc6",
                                "sense_id": "d3835a78-6617-3821-8bae-6438a040caab",
                                "text": "Il était également forcé de macaroniser le mot Margot en Margota, comme il avait déjà fait de Chicot en Chicotus, attendu que, pour bien dire, il eût fallu traduire Chicot par Chicôt, et Margot par Margôt, ce qui n’était plus latin, mais grec."
                            }
                        ]
                    }
