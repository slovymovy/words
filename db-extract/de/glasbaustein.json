                                            {
                                                "example_id": "ffc910f9-c68d-4101-86b8-6309d5baa46f",
                                                "sense_id": "7812e9de-a70c-3ad6-9bad-57b4aac8bc85",
                                                "text": "Voici quelques détails sur cette partie du Musée :\nD’abord, dans le grand vestibule d’entrée, bien connu par le phénomène acoustique de sa voûte, on remarque d’intéressants échantillons d’objets de verre destinés à la construction : tuiles à crochets pour toitures, pavés de verre, énormes plaques transparentes pour dallages, disques de verre épais."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2283af7a-8dc0-40e5-8273-24f0e0fc50cd",
                        "source_entry_id": "6faa9cac-6013-3e91-ab09-0a46b49f726a",
                        "source_sense_id": "8add94ec-7581-330e-8bac-552bccc0570d",
