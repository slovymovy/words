                "senses": [
                    {
                        "sense_id": "c8f6bb8f-db83-3714-a04e-b05820a43162",
                        "entry_id": "d889a21a-bb93-3618-ab0f-b9a10c376382",
                        "glosses": [
                            "Zahnbehandler, der auf einer Fachschule vor allem zahnmedizinisch-zahntechnische Kenntnisse erlernte, dessen Ausbildung staatlich anerkannt, dem aber keine staatliche Bestallung (Approbation) erteilt wurde und der keine Hochschulabschlussprüfung für seine berufliche Tätigkeit nachzuweisen brauchte, und deshalb – im Gegensatz zum Zahnarzt – nur eingeschränkt die Zahnheilkunde ausüben durfte; nichtapprobierter Zahnbehandler"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "bfec3e90-dcc9-4def-8052-44c9808aa05b",
                                "sense_id": "c8f6bb8f-db83-3714-a04e-b05820a43162",
                                "text": "„So wurden etwa 1933 neben 10885 approbierten Zahnärzten rund 18000 Dentisten registriert.“"
                            },
                            {
                                "example_id": "8d8e9d30-4e90-47ef-93de-05edbc7f5fc5",
                                "sense_id": "c8f6bb8f-db83-3714-a04e-b05820a43162",
                                "text": "„Der Dentist will protestieren, schon führt man ihn ab.“"
                            },
                            {
                                "example_id": "a350c7fb-5e6f-43d9-99e7-2b31f6246a54",
                                "sense_id": "c8f6bb8f-db83-3714-a04e-b05820a43162",
                                "text": "„Er hatte 1938 eine Lehre als Zahntechniker begonnen, bei einem Dr. Grünbaum, der sich nicht mehr Zahnarzt nennen durfte, sondern nur noch Dentist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "1ac2f04d-f9df-3435-8c90-45e1efcaa8e2",
                        "entry_id": "d889a21a-bb93-3618-ab0f-b9a10c376382",
                        "glosses": [
                            "Facharzt, der sich mit der Zahnheilkunde beziehungsweise mit der Zahnmedizin beschäftigt; approbierter Zahnbehandler"
                        ],
                        "tags": [
                            "manchmal auch abwertend oder scherzhaft"
                        ],
                        "examples": [
                            {
                                "example_id": "3434fcc2-bf47-4901-b40d-e7d0deb056ea",
                                "sense_id": "1ac2f04d-f9df-3435-8c90-45e1efcaa8e2",
                                "text": "„Die Yorios haben keine Türsteher-Gesichter. Sie zeigen ihre Zähne so oft, dass man denkt, ihr Dentist hätte sie für Werbung bezahlt.“"
                            },
                            {
                                "example_id": "76009800-a40a-4e02-b691-bdb85205f4f3",
                                "sense_id": "1ac2f04d-f9df-3435-8c90-45e1efcaa8e2",
                                "text": "„Als Schmerzmittel und Kühlung mit Eis nicht halfen, ging er zum Zahnarzt, in dessen Praxis seine Schwester Lisa Metcalse arbeitet – und der Dentist entdeckte dann auch schnell die Wurzel des Übels: ein zehn Zentimeter langer Nagel steckte im Gaumen des 23-jährigen Bauarbeiters.“"
                            },
                            {
                                "example_id": "1b108336-b51f-44c8-b749-294a55a256f8",
                                "sense_id": "1ac2f04d-f9df-3435-8c90-45e1efcaa8e2",
                                "text": "„Der Computer hält Einzug in die Zahnarztpraxis der Zukunft: Nach knapp eineinhalb Stunden soll die neue Prothese aus der digital-gesteuerten Fräsmaschine kommen, den lästigen Zahnstein bekämpft der Dentist der Zukunft mit dem Laser.“"
                            },
                            {
                                "example_id": "fe5609f5-2e0d-4e30-a750-5ea544ea7ad3",
                                "sense_id": "1ac2f04d-f9df-3435-8c90-45e1efcaa8e2",
                                "text": "„Die Kids von heute gehen mit Zahnpastagrinsen durch die Welt, die kollektive Urangst vorm Dentisten ist auch passé.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
