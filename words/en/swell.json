{
    "word_family": [
        "swelling",
        "swollen",
        "swellhead",
        "swellish"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d358cc23-0abe-32b0-b882-ba429c697ad8",
                    "sense_definition": "To become bigger, especially due to being engorged.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "increase-in-size",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My ankle began to <w>swell</w> immediately after I tripped on the stairs.",
                            "target_lang_translations": {
                                "ru": "Моя лодыжка начала <w>опухать</w> сразу после того, как я споткнулся на лестнице."
                            }
                        },
                        {
                            "text": "The injury caused his hand to <w>swell</w> up like a balloon.",
                            "target_lang_translations": {
                                "ru": "Из-за травмы его рука <w>раздулась</w>, как воздушный шар."
                            }
                        }
                    ],
                    "synonyms": [
                        "expand",
                        "distend",
                        "bloat"
                    ],
                    "antonyms": [
                        "shrink",
                        "contract"
                    ],
                    "common_phrases": [
                        "swell up"
                    ],
                    "target_lang_definitions": {
                        "ru": "Увеличиваться в размерах, особенно из-за воспаления или наполнения жидкостью."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "опухать",
                                "target_lang_sense_clarification": "о частях тела"
                            },
                            {
                                "target_lang_word": "раздуваться",
                                "target_lang_sense_clarification": "увеличиваться в объеме"
                            },
                            {
                                "target_lang_word": "отекать",
                                "target_lang_sense_clarification": "из-за жидкости"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "83eaa801-c402-3d16-911a-bf86d6973eee",
                    "sense_definition": "To cause to become bigger.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "increase-in-size",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Heavy rains in the mountains will <w>swell</w> the rivers by tomorrow morning.",
                            "target_lang_translations": {
                                "ru": "Сильные дожди в горах заставят реки <w>разлиться</w> к завтрашнему утру."
                            }
                        },
                        {
                            "text": "The new members helped to <w>swell</w> the ranks of the local charity.",
                            "target_lang_translations": {
                                "ru": "Новые участники помогли <w>пополнить</w> ряды местной благотворительной организации."
                            }
                        }
                    ],
                    "synonyms": [
                        "enlarge",
                        "augment",
                        "increase"
                    ],
                    "antonyms": [
                        "diminish",
                        "reduce"
                    ],
                    "common_phrases": [
                        "swell the ranks"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вызывать увеличение чего-либо в размере или количестве."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "увеличивать",
                                "target_lang_sense_clarification": "количество или объем"
                            },
                            {
                                "target_lang_word": "пополнять",
                                "target_lang_sense_clarification": "ряды или запасы"
                            },
                            {
                                "target_lang_word": "раздувать",
                                "target_lang_sense_clarification": "делать больше"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b4dfcf91-b016-32a4-9dc2-51cc07b79e3e",
                    "sense_definition": "To grow gradually in force or loudness.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "intensity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sound of the orchestra began to <w>swell</w> as the climax approached.",
                            "target_lang_translations": {
                                "ru": "Звучание оркестра начало <w>нарастать</w> по мере приближения к кульминации."
                            }
                        },
                        {
                            "text": "The cheers of the crowd started to <w>swell</w> when the team scored.",
                            "target_lang_translations": {
                                "ru": "Ликование толпы начало <w>усиливаться</w>, когда команда забила гол."
                            }
                        }
                    ],
                    "synonyms": [
                        "crescendo",
                        "intensify",
                        "surge"
                    ],
                    "antonyms": [
                        "fade",
                        "subside"
                    ],
                    "common_phrases": [
                        "swell with pride"
                    ],
                    "target_lang_definitions": {
                        "ru": "Постепенно нарастать по силе или громкости."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нарастать",
                                "target_lang_sense_clarification": "о звуке или чувстве"
                            },
                            {
                                "target_lang_word": "усиливаться",
                                "target_lang_sense_clarification": "становиться мощнее"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "71a1914d-38b8-3a1a-8147-b4b0d3f51827",
                    "sense_definition": "To protuberate; to bulge out.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "increase-in-size",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old wooden barrel started to <w>swell</w> in the middle from the pressure.",
                            "target_lang_translations": {
                                "ru": "Старая деревянная бочка начала <w>раздуваться</w> посередине от давления."
                            }
                        },
                        {
                            "text": "The sails began to <w>swell</w> as they caught the morning breeze.",
                            "target_lang_translations": {
                                "ru": "Паруса начали <w>надуваться</w>, поймав утренний бриз."
                            }
                        }
                    ],
                    "synonyms": [
                        "bulge",
                        "protrude",
                        "billow"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выпячиваться, раздуваться наружу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "раздуваться",
                                "target_lang_sense_clarification": "о парусах или бочках"
                            },
                            {
                                "target_lang_word": "выгибаться",
                                "target_lang_sense_clarification": "под давлением"
                            },
                            {
                                "target_lang_word": "набухать",
                                "target_lang_sense_clarification": "от влаги"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "38490925-4661-353f-a7f4-b386f68ea1c2",
                    "sense_definition": "To raise to arrogance; to puff up; to inflate.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "arrogance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Success can often <w>swell</w> a person's head and make them difficult to work with.",
                            "target_lang_translations": {
                                "ru": "Успех часто может <w>вскружить</w> человеку голову и сделать его трудным в общении."
                            }
                        },
                        {
                            "text": "He allowed the praise to <w>swell</w> his ego beyond reason.",
                            "target_lang_translations": {
                                "ru": "Он позволил похвалам безмерно <w>раздуть</w> его эго."
                            }
                        }
                    ],
                    "synonyms": [
                        "elate",
                        "inflate"
                    ],
                    "antonyms": [
                        "humble"
                    ],
                    "common_phrases": [
                        "swell with arrogance"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "often used figuratively"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вызывать высокомерие; заставлять важничать."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "раздувать",
                                "target_lang_sense_clarification": "эго или самомнение"
                            },
                            {
                                "target_lang_word": "вскружить",
                                "target_lang_sense_clarification": "голову успехом"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "70b1ae37-86e8-33af-804d-880c8de85a11",
                    "sense_definition": "A long series of ocean waves, generally produced by wind, and lasting after the wind has ceased.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "water-movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The boat rocked gently on the heavy <w>swell</w> of the Atlantic.",
                            "target_lang_translations": {
                                "ru": "Лодка мерно покачивалась на сильной атлантической <w>зыби</w>."
                            }
                        },
                        {
                            "text": "Surfers waited for a high <w>swell</w> to arrive at the coast.",
                            "target_lang_translations": {
                                "ru": "Серферы ждали, когда к берегу придет высокая <w>волна</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "billow",
                        "surge",
                        "wave"
                    ],
                    "common_phrases": [
                        "heavy swell",
                        "ocean swell"
                    ],
                    "target_lang_definitions": {
                        "ru": "Длинная серия океанских волн, сохраняющаяся после прекращения ветра."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зыбь",
                                "target_lang_sense_clarification": "мерное волнение моря"
                            },
                            {
                                "target_lang_word": "волнение",
                                "target_lang_sense_clarification": "на воде"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a3dfb6b7-e9e2-3dd5-97ef-3c9fd866124f",
                    "sense_definition": "The act of swelling; increase in size.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "increase-in-size",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor noticed a significant <w>swell</w> in the patient's lymph nodes.",
                            "target_lang_translations": {
                                "ru": "Врач заметил значительное <w>увеличение</w> лимфатических узлов пациента."
                            }
                        },
                        {
                            "text": "The sudden <w>swell</w> of the river caused minor flooding in the valley.",
                            "target_lang_translations": {
                                "ru": "Внезапный <w>подъем</w> уровня реки вызвал небольшое наводнение в долине."
                            }
                        }
                    ],
                    "synonyms": [
                        "enlargement",
                        "expansion",
                        "increase"
                    ],
                    "antonyms": [
                        "reduction",
                        "shrinkage"
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт увеличения в размере или объеме."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разбухание",
                                "target_lang_sense_clarification": "процесс увеличения"
                            },
                            {
                                "target_lang_word": "подъем",
                                "target_lang_sense_clarification": "уровня воды"
                            },
                            {
                                "target_lang_word": "опухоль",
                                "target_lang_sense_clarification": "медицинское"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3432e360-fbae-3331-8708-cfda58718956",
                    "sense_definition": "A gradual crescendo followed by diminuendo.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "music",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The music reached a magnificent <w>swell</w> before fading into silence.",
                            "target_lang_translations": {
                                "ru": "Музыка достигла величественного <w>нарастания</w>, прежде чем затихнуть."
                            }
                        },
                        {
                            "text": "The organist used the pedal to create a beautiful <w>swell</w> during the hymn.",
                            "target_lang_translations": {
                                "ru": "Органист использовал педаль, чтобы создать красивое <w>усиление</w> звука во время гимна."
                            }
                        }
                    ],
                    "synonyms": [
                        "crescendo"
                    ],
                    "target_lang_definitions": {
                        "ru": "Постепенное нарастание громкости звука с последующим затуханием."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нарастание",
                                "target_lang_sense_clarification": "звука"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bae56c6e-94f6-30b4-a429-6070099a5ed7",
                    "sense_definition": "A person who is stylish, fancy, or elegant.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "person-type",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He dressed like a real <w>swell</w> for the gala, wearing a silk top hat.",
                            "target_lang_translations": {
                                "ru": "На гала-вечер он оделся как настоящий <w>щеголь</w>, надев шелковый цилиндр."
                            }
                        },
                        {
                            "text": "The club was filled with young <w>swells</w> looking for a night of luxury.",
                            "target_lang_translations": {
                                "ru": "Клуб был полон молодых <w>франтов</w>, ищущих роскошного отдыха."
                            }
                        }
                    ],
                    "synonyms": [
                        "dandy",
                        "fop",
                        "toff",
                        "beau"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Victorian era slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Стильный, модно одетый или элегантный человек."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "щеголь",
                                "target_lang_sense_clarification": "модник"
                            },
                            {
                                "target_lang_word": "франт",
                                "target_lang_sense_clarification": "элегантно одетый"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
