                "senses": [
                    {
                        "sense_id": "878db6e4-853c-32c5-b99b-0a9702885140",
                        "entry_id": "229a96e1-5a6b-36ff-8111-88d163dd5902",
                        "glosses": [
                            "wanker, masturbator"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "08ac0984-0092-46aa-9b12-c5fd9be27d96",
                                "sense_id": "878db6e4-853c-32c5-b99b-0a9702885140",
                                "text": "Интере́сно, ду́мает Ксе́ния, что в голове́ у э́тих люде́й? Почему́ на за́пах кро́ви слета́ются несмышлёные подро́стки, шутники́-самоу́чки, прыща́вые дрочи́лы?",
                                "translation": "I wonder, thinks Ksenia, what these people have inside their heads? Why do clueless teenagers, smart-ass jokers and pimply-faced wankers all come flocking to the smell of blood?",
                                "english": "I wonder, thinks Ksenia, what these people have inside their heads? Why do clueless teenagers, smart-ass jokers and pimply-faced wankers all come flocking to the smell of blood?"
                            }
                        ]
                    }
