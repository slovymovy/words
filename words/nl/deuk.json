                    "semantic_group_id": "werkwoordsvorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Als ik hard op het blikje sla, <w>deuk</w> ik het metaal direct.",
                            "target_lang_translations": {
                                "en": "If I hit the can hard, I <w>dent</w> the metal immediately."
                            }
                        },
                        {
