{
    "word_family": [
        "create",
        "creation",
        "creator",
        "creativity",
        "creatively",
        "uncreative"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "7342b70e-9e1a-3499-84a0-ea0eff3a809b",
                    "sense_definition": "Having the ability or power to create things, especially in an original or novel way.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "ability_to_create",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is a <w>creative</w> dramatist who avoids cliche in her plays.",
                            "target_lang_translations": {
                                "ru": "Она <w>творческий</w> драматург, избегающий клише в своих пьесах.",
                                "zh": "她是一位<w>有创造力的</w>剧作家，在剧本中避免使用陈词滥调。"
                            }
                        },
                        {
                            "text": "The future belongs to those <w>creative</w> enough to build something better.",
                            "target_lang_translations": {
                                "ru": "Будущее принадлежит тем, кто достаточно <w>созидателен</w>, чтобы построить что-то лучшее.",
                                "zh": "未来属于那些足够<w>有创造力</w>、能够构建更美好事物的人。"
                            }
                        }
                    ],
                    "synonyms": [
                        "inventive",
                        "imaginative"
                    ],
                    "antonyms": [
                        "imitative"
                    ],
                    "common_phrases": [
                        "creative mind",
                        "creative thinking",
                        "creative team"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обладающий способностью создавать что-то новое; созидательный, творческий.",
                        "zh": "具有创造事物能力的人，尤指以原创或新颖的方式进行创作。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "творческий",
                                "target_lang_sense_clarification": "связанный с творчеством, созданием нового"
                            },
                            {
                                "target_lang_word": "созидательный",
                                "target_lang_sense_clarification": "направленный на создание, конструктивный"
                            },
                            {
                                "target_lang_word": "креативный",
                                "target_lang_sense_clarification": "современный термин, часто о нестандартном мышлении"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "有创造力的",
                                "target_lang_sense_clarification": "形容人具备创新思维或能力"
                            },
                            {
                                "target_lang_word": "富有想象力的",
                                "target_lang_sense_clarification": "形容人思维活跃，能想出新点子"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fa56819b-db5b-3bcb-b7d4-30b43f908e0c",
                    "sense_definition": "Involving the use of imagination or original ideas to produce something.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "ability_to_create",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We need a <w>creative</w> new solution to solve this old problem.",
                            "target_lang_translations": {
                                "ru": "Нам нужно новое <w>креативное</w> решение, чтобы справиться с этой старой проблемой.",
                                "zh": "我们需要一个<w>创造性的</w>新方案来解决这个老问题。"
                            }
                        },
                        {
                            "text": "The students enjoyed the <w>creative</w> writing exercise in class.",
                            "target_lang_translations": {
                                "ru": "Студентам понравилось упражнение по <w>творческому</w> письму на уроке.",
                                "zh": "学生们很喜欢课堂上的<w>创意</w>写作练习。"
                            }
                        }
                    ],
                    "synonyms": [
                        "original",
                        "inventive",
                        "innovative",
                        "imaginative"
                    ],
                    "antonyms": [
                        "imitative"
                    ],
                    "common_phrases": [
                        "creative writing",
                        "creative process",
                        "creative arts"
                    ],
                    "target_lang_definitions": {
                        "ru": "Связанный с использованием воображения или оригинальных идей для создания чего-либо.",
                        "zh": "涉及运用想象力或原创想法来产生某物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "творческий",
                                "target_lang_sense_clarification": "относящийся к искусству или процессу создания"
                            },
                            {
                                "target_lang_word": "креативный",
                                "target_lang_sense_clarification": "оригинальный, изобретательный (об идеях, решениях)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "创造性的",
                                "target_lang_sense_clarification": "指过程或产物具有创新特质"
                            },
                            {
                                "target_lang_word": "独创的",
                                "target_lang_sense_clarification": "指想法或方案与众不同"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aea914c5-6287-37ed-a936-03c5e19fa6e3",
                    "sense_definition": "Designed or executed to deceive or mislead, often used to describe manipulative financial practices.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The director was fired for using <w>creative</w> accounting to hide the company's losses.",
                            "target_lang_translations": {
                                "ru": "Директора уволили за использование <w>креативной</w> бухгалтерии для сокрытия убытков компании.",
                                "zh": "这位主管因使用<w>投机取巧的</w>会计手段掩盖公司亏损而被解雇。"
                            }
                        },
                        {
                            "text": "His <w>creative</w> interpretation of the rules got him into trouble with the committee.",
                            "target_lang_translations": {
                                "ru": "Его <w>творческая</w> трактовка правил привела к проблемам с комитетом.",
                                "zh": "他对规则<w>投机取巧的</w>解读让他与委员会之间产生了麻烦。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "creative accounting"
                    ],
                    "target_lang_definitions": {
                        "ru": "Изобретательный с целью обмана или манипуляции (часто о финансовых отчетах или правилах).",
                        "zh": "旨在欺骗或误导，常用于描述操纵性的财务行为。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "изобретательный",
                                "target_lang_sense_clarification": "хитрый, ловкий в обходе правил"
                            },
                            {
                                "target_lang_word": "креативный",
                                "target_lang_sense_clarification": "ироничное использование (напр. креативная бухгалтерия)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "投机取巧的",
                                "target_lang_sense_clarification": "指通过钻空子或不正当手段达到目的"
                            },
                            {
                                "target_lang_word": "虚假的",
                                "target_lang_sense_clarification": "指通过伪造或掩盖事实来误导他人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8c4e3c4c-d1da-3ec0-b42d-d9c870d6adbd",
                    "sense_definition": "Relating to a specific type of set of natural numbers in mathematical logic.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The professor explained the complex properties of a <w>creative</w> set.",
                            "target_lang_translations": {
                                "ru": "Профессор объяснил сложные свойства <w>креативного</w> множества.",
                                "zh": "教授解释了<w>创造性集合</w>的复杂属性。"
                            }
                        },
                        {
                            "text": "In mathematical logic, a <w>creative</w> set is recursively enumerable but not recursive.",
                            "target_lang_translations": {
                                "ru": "В математической логике <w>креативное</w> множество является рекурсивно перечислимым, но не рекурсивным.",
                                "zh": "在数理逻辑中，<w>创造性集合</w>是递归可枚举的，但不是递归的。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "creative set"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к определенному типу множеств натуральных чисел в математической логике.",
                        "zh": "在数理逻辑中，指代特定类型自然数集合的术语。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "креативный",
                                "target_lang_sense_clarification": "математический термин (креативное множество)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "创造性集合",
                                "target_lang_sense_clarification": "数学逻辑中的专业术语"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "37e1da2c-4591-3207-b6e5-cc99125ce24b",
                    "sense_definition": "A person who works in a creative profession, especially in advertising, marketing, or design.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is a visionary <w>creative</w> who has won many awards for his campaigns.",
                            "target_lang_translations": {
                                "ru": "Он дальновидный <w>креативщик</w>, получивший множество наград за свои кампании.",
                                "zh": "他是一位富有远见的<w>创意人员</w>，凭借其广告活动赢得了许多奖项。"
                            }
                        },
                        {
                            "text": "The agency hired two new <w>creatives</w> to bring fresh ideas to the team.",
                            "target_lang_translations": {
                                "ru": "Агентство наняло двух новых <w>креативщиков</w>, чтобы привнести свежие идеи в команду.",
                                "zh": "该代理公司聘请了两名新的<w>创意人员</w>，为团队带来新鲜想法。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "team of creatives"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "industry jargon"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек творческой профессии, особенно в рекламе, маркетинге или дизайне.",
                        "zh": "从事创意行业的人，尤指在广告、营销或设计领域。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "креативщик",
                                "target_lang_sense_clarification": "разговорное, профессиональный жаргон"
                            },
                            {
                                "target_lang_word": "творческий работник",
                                "target_lang_sense_clarification": "формальное обозначение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "创意人员",
                                "target_lang_sense_clarification": "指从事创意工作的专业人士"
                            },
                            {
                                "target_lang_word": "创意工作者",
                                "target_lang_sense_clarification": "对从事艺术或设计类职业者的统称"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "91288257-93ee-3653-8763-51149f954201",
                    "sense_definition": "Artistic material used in advertising, such as designs, images, or videos.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The design team has completed the <w>creative</w> for next month's ad campaign.",
                            "target_lang_translations": {
                                "ru": "Дизайнерская группа закончила <w>креатив</w> для рекламной кампании следующего месяца.",
                                "zh": "设计团队已经完成了下个月广告活动的<w>创意素材</w>。"
                            }
                        },
                        {
                            "text": "Please send the <w>creative</w> to the client for final approval.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, отправьте <w>креатив</w> клиенту на окончательное утверждение.",
                                "zh": "请将<w>创意素材</w>发送给客户进行最终确认。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "industry jargon"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Рекламные материалы, такие как макеты, изображения или видеоролики.",
                        "zh": "广告中使用的艺术素材，如设计稿、图像或视频。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "креатив",
                                "target_lang_sense_clarification": "профессиональный жаргон в рекламе"
                            },
                            {
                                "target_lang_word": "рекламные материалы",
                                "target_lang_sense_clarification": "общее описание"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "创意素材",
                                "target_lang_sense_clarification": "广告行业中指代具体的视觉或文案内容"
                            },
                            {
                                "target_lang_word": "广告物料",
                                "target_lang_sense_clarification": "指用于广告投放的成品文件"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}