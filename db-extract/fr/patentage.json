                        "entry_id": "578dc10f-9fc6-39de-adee-27569020a3b9",
                        "glosses": [
                            "Action de patenter, austénitisation de fils ou de feuillards suivie d’un refroidissement pour donner au métal une structure favorable au travail ultérieur de déformation à froid."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6584cb77-6d47-41ff-86e9-dd92c59c4423",
                                "sense_id": "9a3ad324-cefa-3715-b9f4-bd98815f7983",
                                "text": "Après patentage le fil subit plusieurs tréfilages pour l’amener au diamètre final."
                            },
                            {
                                "example_id": "4bbba6a8-7d91-4948-8fdb-4b9a7c81fd99",
                                "sense_id": "9a3ad324-cefa-3715-b9f4-bd98815f7983",
                                "text": "le patentage est avantageusement effectué dans des conditions permettant d'obtenir une structure perlitique la plus fine possible."
                            },
                            {
                                "example_id": "dee60d3c-3ba3-49ab-8f21-0d3c852d5cb6",
                                "sense_id": "9a3ad324-cefa-3715-b9f4-bd98815f7983",
                                "text": "Ces bains sont utilisés dans le recuit continu et le patentage."
                            }
                        ]
                    }
