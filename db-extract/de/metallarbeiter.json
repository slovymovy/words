                        "entry_id": "c2d414f8-c4d7-3669-a3ea-3f0ff4abd53a",
                        "glosses": [
                            "jemand, der berufsmäßig mit der Be- und Verarbeitung von Metallen beschäftigt ist; Arbeiter in der Metallindustrie"
                        ],
                        "tags": [
                            "heute vor allem"
                        ],
                        "examples": [
                            {
                                "example_id": "3986e75e-408a-46b4-b986-d02346ba04bf",
                                "sense_id": "9de20096-86d7-3dde-86be-fae280f7ac0a",
                                "text": "„Das älteste und wichtigste Handwerkszeug (…) des Metallarbeiters sind Hammer und Amboss.“"
                            },
                            {
                                "example_id": "7d4c9693-d834-4097-b79d-5a5d221364cf",
                                "sense_id": "9de20096-86d7-3dde-86be-fae280f7ac0a",
                                "text": "„Unter der neuen Regierung vermehrten sich binnen neun Jahren die Dampfmaschinen der Berliner Fabriken von 29 mit 392 Pferdekräften auf 193 mit 1265 Pferdekräften, und die Kopfzahl der Berliner Metallarbeiter hob sich in 13 Jahren von 3000 auf 4500.“"
                            }
                        ],
