                ],
                "senses": [
                    {
                        "sense_id": "96350dc1-3d56-342b-93f1-7265a23fb0dc",
                        "entry_id": "11b3dcfa-43d9-35c7-ac2b-b127261bca2d",
                        "glosses": [
                            "Se faire éclairer par la lune."
                        ],
                        "tags": [
                            "poetic",
                            "pronominal",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "bd13589b-7b8e-4f2d-bab6-2b5bb5e26e76",
                                "sense_id": "96350dc1-3d56-342b-93f1-7265a23fb0dc",
                                "text": "Quand, lavé des odeurs du jour, le jardinet\nDerrière la maison, en hiver, s’illunait,\nGisant au pied d’un mur, enterré dans la marne\nEt pour des visions écrasant son œil darne,\nIl écoutait grouiller les galeux espaliers."
                            },
                            {
                                "example_id": "f713b041-7339-4209-bacd-c285e2ad9f59",
                                "sense_id": "96350dc1-3d56-342b-93f1-7265a23fb0dc",
                                "text": "Gigantesque boucan à la dérive, le village reculait dans les ténèbres tandis que s’illunait la voile lancée dans l’estuaire."
                            }
                        ]
                    },
                    {
                        "sense_id": "807fa86d-8974-35bc-a423-347bcadf81f6",
                        "entry_id": "11b3dcfa-43d9-35c7-ac2b-b127261bca2d",
                        "glosses": [
                            "Former comme le croissant de la lune."
                        ],
                        "tags": [
                            "literary",
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "c3c071c4-87fe-4ef1-9308-623ae67e8a23",
                                "sense_id": "807fa86d-8974-35bc-a423-347bcadf81f6",
                                "text": "Quand elles passent près de lui, les pupilles siciliennes brasillent, les dents s’illunent. Elle hésite avant de lui accorder une danse seule à seul."
                            }
                        ]
                    },
                    {
                        "sense_id": "b5bd17aa-d773-3ff4-82f4-67bf5fe110b3",
                        "entry_id": "11b3dcfa-43d9-35c7-ac2b-b127261bca2d",
                        "glosses": [
                            "Éclairer d’une clarté lunaire."
                        ],
                        "tags": [
                            "poetic",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "18520d26-cf03-4147-a3e0-974679583386",
                                "sense_id": "b5bd17aa-d773-3ff4-82f4-67bf5fe110b3",
                                "text": "[…] quels fleuves palmés d’armes\n illunent les cœurs\n bordant la yole damée d’air\n dans les traversées du miracle"
                            }
                        ]
                    }
                ],
