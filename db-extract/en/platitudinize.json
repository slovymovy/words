                "senses": [
                    {
                        "sense_id": "18a35788-ec13-3424-8678-e54cbf31b346",
                        "entry_id": "168509ce-d0b2-3db4-a090-79c262ec1cad",
                        "glosses": [
                            "To utter one or more platitudes; to make obvious, trivial, or clichéd remarks concerning a topic."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "aaf6f004-8cb0-49f1-8f90-8fb2079ac6e3",
                                "sense_id": "18a35788-ec13-3424-8678-e54cbf31b346",
                                "text": "He does not attempt lofty flights of eloquence or try to disguise thought under ponderous platitudinising sentences."
                            },
                            {
                                "example_id": "7bbd8bdf-82f3-406f-b55f-fb469c02fd12",
                                "sense_id": "18a35788-ec13-3424-8678-e54cbf31b346",
                                "text": "If we keep our knowledge strictly to ourselves we know exactly how we stand, and that if there has been any leakage, it had been from some other source. But I need not platitudinize to an experienced and learned counsel."
                            },
                            {
                                "example_id": "5e38001c-801a-496e-ae0f-21949732a1c5",
                                "sense_id": "18a35788-ec13-3424-8678-e54cbf31b346",
                                "text": "The people in this show don't talk like normal people—they lecture, they argue, they negotiate, they strategize, they philosophize, they platitudinize, they deliver speeches about destiny, liberty, and bravery."
                            }
                        ]
                    },
                    {
                        "sense_id": "a7654fdf-380d-3f26-b2fc-861cb0550abf",
                        "entry_id": "168509ce-d0b2-3db4-a090-79c262ec1cad",
                        "glosses": [
                            "To express as or reduce to one or more clichés or truisms."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "f70fc925-b01d-40b5-98fa-fbb4008834c9",
                                "sense_id": "a7654fdf-380d-3f26-b2fc-861cb0550abf",
                                "text": "Mendelssohn had misunderstood, platitudinized, and misinterpreted the holy concept of revelation."
                            },
                            {
                                "example_id": "0c31eff8-9f74-44e5-88f7-be410044a429",
                                "sense_id": "a7654fdf-380d-3f26-b2fc-861cb0550abf",
                                "text": "“It's better to have to struggle when you're young, I think, than when you're older,” she platitudinized."
                            },
                            {
                                "example_id": "ac07eaf9-252a-4fea-8d5e-0d1f0039b5b7",
                                "sense_id": "a7654fdf-380d-3f26-b2fc-861cb0550abf",
                                "text": "A modern campaign, not just in America, is so fine-tuned, so honed and platitudinised, that mistakes are the only way of bringing it into focus."
                            }
                        ]
                    }
                ],
