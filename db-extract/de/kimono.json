                        "cross_references": [
                            {
                                "target_word": "kimono",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3f168b30-d9c4-370d-b3b1-541033bfab82",
                                        "entry_id": "a788acb1-239c-32f4-9250-6abd743bb0c0",
                                        "glosses": [
                                            "A traditional Japanese T-shaped, wrapped-front garment with square sleeves and a rectangular body, now generally worn only on formal occasions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d10f65bb-618a-4103-aab1-461890e2fbd0",
                                                "sense_id": "3f168b30-d9c4-370d-b3b1-541033bfab82",
                                                "text": "Presenting 84 kimonos dating as far back as the 1660s, the show traces how the kimono became a truly global garment worn, sold, riffed on and reinvented by artisans, designers and fashion-lovers around the world."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "20688b59-3444-3ff7-981e-e330604dc67d",
                                        "entry_id": "a788acb1-239c-32f4-9250-6abd743bb0c0",
                                        "glosses": [
                                            "A long robe-like garment in Western fashion, which may be open at the front, loosely inspired by the Japanese garment."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3961a9e0-a48e-3a39-8174-c926083efd79",
                                        "entry_id": "a788acb1-239c-32f4-9250-6abd743bb0c0",
                                        "glosses": [
                                            "A bathrobe or dressing gown."
                                        ],
                                        "tags": [
                                            "regional"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9d6f409f-9b73-4b33-9933-5eefc0c7cbcc",
                        "source_entry_id": "e12af3a8-58e7-3576-9e71-cb346aea47f5",
                        "source_sense_id": "22b399ea-f9af-3034-aaeb-d39c1f7b91de",
                        "source_sense_description": "japanisches Gewand",
                        "target_lang_word": "kimono",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kimono",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "90c1385a-5b88-31b5-8811-f5a92f213d13",
                                        "entry_id": "0fcd4671-8ae6-3562-aae8-ba04bd9932a1",
                                        "glosses": [
                                            "Vêtement japonais traditionnel flottant et à manches."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fbaba128-e31d-4b30-a3f5-5fcf74460310",
                                                "sense_id": "90c1385a-5b88-31b5-8811-f5a92f213d13",
                                                "text": "Arrivé au Japon au VIIᵉ siècle, le kimono s’y est développé au XIVᵉ siècle, selon des codes précis : tissu et couleur indiquaient la classe sociale ou le statut marital. Dans un pays désormais occidentalisé, le kimono est aujourd’hui plutôt réservé aux événements traditionnels."
                                            },
                                            {
                                                "example_id": "1f93a049-52ec-4666-af7a-5e09841c601f",
                                                "sense_id": "90c1385a-5b88-31b5-8811-f5a92f213d13",
                                                "text": "Cette scène menaçant de s’éterniser, la Caille se levait en silence et, ficelé dans un kimono, ouvrait la fenêtre, s’accoudait…"
                                            },
                                            {
                                                "example_id": "b04fd0e2-7d1f-433f-b2cd-baaf3eabdfd6",
                                                "sense_id": "90c1385a-5b88-31b5-8811-f5a92f213d13",
                                                "text": "Sept lés de tissu assemblés les uns aux autres. Le côté droit se rabat sur le côté gauche, la taille se laisse ceindre d’une large bande de quatre ou cinq mètres de long pour environ 35 centimètres de large. Le kimono est à la fois un vêtement très simple et l’expression d'un univers infiniment complexe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6c506266-d46a-3335-a08e-13056eac520f",
                                        "entry_id": "0fcd4671-8ae6-3562-aae8-ba04bd9932a1",
                                        "glosses": [
                                            "(Usage critiqué) référence nécessaire (résoudre le problème) Vêtement d’entraînement des arts martiaux japonais, et des par extension d’autres arts martiaux.\\nL’appellation correcte est dogi ou keikogi."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
