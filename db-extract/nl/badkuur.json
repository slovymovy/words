                        "glosses": [
                            "een medische behandeling in een kuuroord met medicinale baden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b5984dc-a861-4ec6-9a24-c093771d01a6",
                                "sense_id": "fe2181da-ac7a-32d9-8f3f-4dd1c4f7eca3",
                                "text": "Ik deed 35 jaar staand werk in een grafisch bedrijf. In 1990 dreigde ik in de WAO te belanden door verkrampingen, maar een badkuur in Boedapest bracht me uitkomst. Ik kon daarna weer zonder enig probleem werken!"
                            },
                            {
                                "example_id": "d7778f9e-19fe-4494-a6c2-69e7ca3dd205",
                                "sense_id": "fe2181da-ac7a-32d9-8f3f-4dd1c4f7eca3",
                                "text": "Het effect van de badkuur was opzienbarend: bij 17 patiënten was de huid na twee weken helemaal genezen en bij negen bijna helemaal (voor 90 procent schoon)."
                            }
                        ]
                    }
