                        "examples": [
                            {
                                "example_id": "1d1db5a2-d708-4427-9605-afd5b61298a8",
                                "sense_id": "beae0516-91c4-3ced-a39c-19adeb6111f3",
                                "text": "Hoelang was het geleden dat Catharina's handen hem hadden beroerd? Wat als Elza nu binnen zou komen? Toen dacht hij aan Tinus, aan zijn goedhartigheid, zijn vertrouwen in hem en stond hij op."
                            },
                            {
                                "example_id": "241e2826-742e-4538-950a-35a929315e05",
                                "sense_id": "beae0516-91c4-3ced-a39c-19adeb6111f3",
                                "text": "Op de Balkan wordt er altijd van alles bijgehaald in een mix van melancholie, liefde voor het land, goedhartigheid en de wens om hard en strijdbaar te zijn. Je bent voor of tegen iets en iemand. Polderen bestaat niet."
                            }
                        ]
                    },
                    {
                        "sense_id": "91cb8088-10af-3505-858b-cd8ffd8bd7cc",
                        "entry_id": "7ac90ecd-9b2e-380c-9c2d-0a10a743c30b",
                        "glosses": [
                            "iets dat een teken van grote vriendelijkheid is"
