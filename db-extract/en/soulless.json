    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "def77e0a-7a62-3a2b-9b4a-a234df498f82",
                "word": "soulless",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "2ef60fae-1517-4765-8c8a-370ebcf5c2c9",
                        "entry_id": "def77e0a-7a62-3a2b-9b4a-a234df498f82",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more soulless"
                    },
                    {
                        "form_id": "90cd4e96-8956-4a8e-92be-331dbeb7799d",
                        "entry_id": "def77e0a-7a62-3a2b-9b4a-a234df498f82",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most soulless"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4038d14a-84ea-3a53-9447-de3993dba381",
                        "entry_id": "def77e0a-7a62-3a2b-9b4a-a234df498f82",
                        "glosses": [
                            "As if without a soul; insensitive, unfeeling."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b834b775-9162-43ba-bd5e-bc7fd150cfad",
                                "sense_id": "4038d14a-84ea-3a53-9447-de3993dba381",
                                "text": "Go backe I warrant thee: but Ile catch thine eyes / Though they had wings. Slaue, Soule-leſſe, Villain, Dog. / O rarely baſe!"
                            },
                            {
                                "example_id": "5d6cb5fd-93bd-48c2-a873-38e894e13356",
                                "sense_id": "4038d14a-84ea-3a53-9447-de3993dba381",
                                "text": "Oh! who young Leila's glance could read / And keep that portion of his creed / Which saith, that woman is but dust, / A soulless toy for tyrant's lust?"
                            },
                            {
                                "example_id": "16af6e79-2bdb-4131-bc2e-7b4722ba340d",
                                "sense_id": "4038d14a-84ea-3a53-9447-de3993dba381",
                                "text": "“Done?” he said, with a soulless sneer in the word."
                            },
                            {
                                "example_id": "93317e17-5491-485c-a452-29f5f82eb68b",
                                "sense_id": "4038d14a-84ea-3a53-9447-de3993dba381",
                                "text": "Number One had never before seen a woman, but the sight of this one awoke in the unplumbed depths of his soulless breast a great desire to lay his hands upon her."
                            },
                            {
                                "example_id": "6a2e74b7-1c78-4205-b116-ae49f11a2224",
                                "sense_id": "4038d14a-84ea-3a53-9447-de3993dba381",
                                "text": "But I do believe there’s another path—one that fuels growth and innovation, and offers the clearest route to individual opportunity and national success. It does not require succumbing to a soulless capitalism that benefits only the few, but rather recognizes that economies are more successful when we close the gap between rich and poor, and growth is broadly based."
                            },
                            {
                                "example_id": "cd8affb3-3d64-4d74-8757-b976f807e313",
                                "sense_id": "4038d14a-84ea-3a53-9447-de3993dba381",
                                "text": "St Pancras is no longer soulless. The NRA accolade says it all: its soul is back where it truly belongs!"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b0d778da-e338-4951-b4df-63e5427f5fe5",
                        "source_entry_id": "def77e0a-7a62-3a2b-9b4a-a234df498f82",
                        "source_sense_id": "4038d14a-84ea-3a53-9447-de3993dba381",
