                        "glosses": [
                            "overeenkomst tussen een zelfstandig ondernemer en het bedrijf dat een bepaalde bedrijfsformule exploiteert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0987bda9-0a3d-4aa9-ac7a-565ce8c1643d",
                                "sense_id": "a444ab3d-2fd6-394a-bdfd-ffe4f49c3f5e",
                                "text": "Toch moet een deel gehoor geven aan de verplichting van het moederbedrijf omdat in de franchiseovereenkomst expliciet middagopeningstijden zijn opgenomen. Dat is het geval bij overeenkomsten die recent zijn afgesloten. Bij oudere contracten is daar geen sprake van en dus kan het moederbedrijf dat ook niet opleggen. Een dwangsom bij onwil wees de rechtbank af."
                            },
                            {
                                "example_id": "cdf0dbbc-1117-4a4e-a06c-69a8ff8a92e1",
                                "sense_id": "a444ab3d-2fd6-394a-bdfd-ffe4f49c3f5e",
                                "text": "In de franchiseovereenkomst is afgesproken dat inkoopprijzen één op één worden doorgegeven aan de ondernemers. De franchisers vermoeden dat het hoofdkantoor lucratieve deals maakt waar zij niet van profiteren en de eigen AH-winkels wel."
                            }
                        ]
                    }
