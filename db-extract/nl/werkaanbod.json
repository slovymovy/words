                    {
                        "sense_id": "044dec64-5b36-329a-b592-45f9d6a7f215",
                        "entry_id": "dead3cc8-6ae4-32fc-87f3-2aac41b6ec13",
                        "glosses": [
                            "de hoeveelheid betaald werk dat door werkgevers wordt aangeboden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "32349cd0-3833-49c5-b0ab-72d8778ae358",
                                "sense_id": "044dec64-5b36-329a-b592-45f9d6a7f215",
                                "text": "Opmerkelijk is dat in Rijssen-Holten de werkloosheid onder mannen (212) lager is dan onder vrouwen (233). In alle andere Twentse gemeenten is het andersom. Een verklaring ligt in de overheersende types werkaanbod in deze gemeente. Er bevinden zich relatief veel bedrijven in de sectoren bouw, techniek en transport."
                            },
                            {
                                "example_id": "4ee0596c-7c9e-4f78-bd01-aa5da240b88c",
                                "sense_id": "044dec64-5b36-329a-b592-45f9d6a7f215",
                                "text": "De gegevens over de tweede stad van Twente worden ontleend aan de Atlas van gemeenten 2009 die jaarlijks wordt uitgegeven en waarin alle relevante cijfers over de steden zijn verzameld. Als een paal boven water staat dat Hengelo op belangrijke terreinen als wonen, sociale economie en werkaanbod beter scoort dan Enschede en Almelo."
                            },
                            {
                                "example_id": "fe969a02-3cfc-429a-b0fb-a20ae8d736a1",
                                "sense_id": "044dec64-5b36-329a-b592-45f9d6a7f215",
                                "text": "Aanvankelijk wilde het ministerie van Defensie de locatie in Aadorp op 1 januari 2007 sluiten, maar het werkaanbod bleek zo groot dat de sluiting tot juli 2008 werd uitgesteld."
                            }
                        ]
                    }
