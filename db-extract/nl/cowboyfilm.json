                        "entry_id": "d3c45a61-8c19-3fe1-b7d1-48630e8abad0",
                        "glosses": [
                            "een wildwestfilm waarin cowboys en indianen de hoofdrol spelen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "70ec738d-e1d9-4421-880b-403c2d885342",
                                "sense_id": "b973da8c-f77b-310f-97df-6d62a836ef34",
                                "text": ",Ik wilde sorry zeggen, duidelijk maken dat het niet persoonlijk bedoeld was. Het neerschieten -met zo'n revolver uit de cowboyfilm- gebeurde gewoon per ongeluk, Nou ja, wel per ongeluk heel ernstig."
                            },
                            {
                                "example_id": "d46fcf3a-7dbc-41fc-9b4f-f2a632a0ceb9",
                                "sense_id": "b973da8c-f77b-310f-97df-6d62a836ef34",
                                "text": "In de Nieuwe Kerk kun je ook nog zien dat de manier waarop indianen worden voorgesteld in cowboyfilms en in stripverhalen vaak helemaal niet klopt."
                            }
                        ]
                    }
