        "fr-extract.jsonl": [
            {
                "entry_id": "0f6543d5-0711-39a8-a5d6-054a31f58b49",
                "word": "stagnation",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "188e1728-856a-42be-a433-123c2cdfa9df",
                        "entry_id": "0f6543d5-0711-39a8-a5d6-054a31f58b49",
                        "tags": [
                            "plural"
                        ],
                        "form": "stagnations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "956fbe2c-24c0-3228-a352-8da989b40b06",
                        "entry_id": "0f6543d5-0711-39a8-a5d6-054a31f58b49",
                        "glosses": [
                            "État de ce qui est stagnant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "efdcfe55-dc5c-4ad4-86fc-1678bdf13bad",
                                "sense_id": "956fbe2c-24c0-3228-a352-8da989b40b06",
                                "text": "La stagnation des eaux. - La stagnation du sang, des humeurs."
                            },
                            {
                                "example_id": "b924c128-2406-4c98-9f9b-59a738f107e8",
                                "sense_id": "956fbe2c-24c0-3228-a352-8da989b40b06",
                                "text": "Les Turcs ont l’amour du passé, l’amour de l’immobilité et de la stagnation."
                            },
                            {
                                "example_id": "b1fd0aaf-4eb1-4aa5-a273-be92a5cc720a",
                                "sense_id": "956fbe2c-24c0-3228-a352-8da989b40b06",
                                "text": "Je dis que des sociétés musulmanes stagnent ou régressent. En stagnation, l'Arabie saoudite, qui abrite les lieux saints, c'est pour cela que je dis que la maladie est au cœur de l'islam."
                            }
                        ]
                    },
                    {
                        "sense_id": "82b2a411-2413-3b5e-baa7-97a0b127f44f",
                        "entry_id": "0f6543d5-0711-39a8-a5d6-054a31f58b49",
                        "glosses": [
                            "Absence de croissance, en parlant des revenus, des affaires de commerce ou de banque."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "573171a4-bbfd-4581-a0df-d66694db1d32",
                                "sense_id": "82b2a411-2413-3b5e-baa7-97a0b127f44f",
                                "text": "Cet indicateur donne par conséquent une image encore moins dynamique de la progression des salaires : il conclut à leur quasi-stagnation sur ces trente dernières années."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c64b7e29-fa69-4b14-b3a4-c5f3ba1ac78d",
                        "source_entry_id": "0f6543d5-0711-39a8-a5d6-054a31f58b49",
                        "target_lang_word": "Stagnation",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Stagnation",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a7797188-f55f-326b-8074-24bcd82d3b25",
                                        "entry_id": "e46aa0fa-18fc-3f26-a96e-ef0c7aa740e0",
                                        "glosses": [
                                            "Zustand, in dem kein Zuwachs, Wachstum, Anstieg (mehr) stattfindet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a55af64c-0952-4f32-8397-12985577bbcb",
                                                "sense_id": "a7797188-f55f-326b-8074-24bcd82d3b25",
                                                "text": "Aufgrund der mangelnden Nachfrage kam es zu einer Stagnation der Absätze."
                                            },
                                            {
                                                "example_id": "f7302fb4-1318-4b2d-9b71-5dd3b674e679",
                                                "sense_id": "a7797188-f55f-326b-8074-24bcd82d3b25",
                                                "text": "Der Diskussionsverlauf unterliegt aufgrund festgefahrender Meinungen einer zunehmenden Stagnation."
                                            },
                                            {
                                                "example_id": "e0543ca7-b0ae-4a6e-ac0b-f099f6101b4c",
                                                "sense_id": "a7797188-f55f-326b-8074-24bcd82d3b25",
                                                "text": "„Von einem kurzen Nachkriegsboom abgesehen, erlebte Großbritannien in den 20er Jahren eine Stagnation der traditionellen Branchen der Textilindustrie, des Kohlenbergbaus oder des Schiffbaus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4d0889df-c85c-49cb-8f34-c2993a9163be",
                        "source_entry_id": "0f6543d5-0711-39a8-a5d6-054a31f58b49",
