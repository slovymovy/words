                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "niepokojenie",
                                "target_lang_sense_clarification": "zakłócanie czyjegoś spokoju"
                            },
                            {
                                "target_lang_word": "naprzykrzanie się",
                                "target_lang_sense_clarification": "uporczywe bycie uciążliwym"
                            },
                            {
                                "target_lang_word": "dokuczanie",
                                "target_lang_sense_clarification": "celowe sprawianie komuś przykrości"
                            }
                        ]
                    }
                }
            ]
        }
