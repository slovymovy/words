                "senses": [
                    {
                        "sense_id": "27daa815-c476-3d52-843d-2647b2880e55",
                        "entry_id": "1761e64c-3d44-3855-97e4-23f0b0424d6c",
                        "glosses": [
                            "unter bestimmten Bedingungen äußerst explosives Phenol mit der Summenformel C₆H₃N₃O₇"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ebb56be4-bdbc-4ea4-9361-6c48fbdeed6e",
                                "sense_id": "27daa815-c476-3d52-843d-2647b2880e55",
                                "text": "Die Pikrinsäure reagiert mit Alkoholen zu Estern."
                            },
                            {
                                "example_id": "5f107c84-1950-45bf-bd12-b79f7105ca4a",
                                "sense_id": "27daa815-c476-3d52-843d-2647b2880e55",
                                "text": "„Eigentlich sollte es sich inzwischen herumgesprochen haben: Pikrinsäure hat in Schulen nichts verloren.“"
                            },
                            {
                                "example_id": "ed1118f6-c983-4aeb-915f-48b447f24dbc",
                                "sense_id": "27daa815-c476-3d52-843d-2647b2880e55",
                                "text": "„Im kanadischen Halifax kollidierte ein französisches Munitionsschiff mit 2300 Tonnen Pikrinsäure […] und 200 Tonnen TNT an Bord mit einem anderen Schiff und explodierte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "03921c89-eaad-4d59-9d28-5108ce64c0ce",
                        "source_entry_id": "1761e64c-3d44-3855-97e4-23f0b0424d6c",
