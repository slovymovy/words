                                "target_senses": [
                                    {
                                        "sense_id": "e448d1f0-e8ac-3a04-bf3a-271784979bf8",
                                        "entry_id": "e6efc4d7-9d4f-3964-aeab-6f5218012674",
                                        "glosses": [
                                            "Province du Canada (symbole postal MB), bordée par le Nunavut au nord, la baie d’Hudson au nord-est, l’Ontario à l’est, les États-Unis au sud, et la Saskatchewan à l’ouest, dont la capitale est Winnipeg."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05e68bf7-bb38-48a8-babd-32e7833bbb0c",
                                                "sense_id": "e448d1f0-e8ac-3a04-bf3a-271784979bf8",
                                                "text": "L’émigration islandaise a commencé en 1870, […]. On a cherché à concentrer le mouvement, mais la difficulté était de trouver une contrée convenable; on a proposé la Nouvelle-Écosse, l’Ontario, le Wisconsin, le Nebraska, le Manitoba."
                                            },
                                            {
                                                "example_id": "79139407-1601-4dc8-bc2d-890fc5deb116",
                                                "sense_id": "e448d1f0-e8ac-3a04-bf3a-271784979bf8",
                                                "text": "La concentration des terres agricoles du Manitoba, de la Saskatchewan et de l’Alberta aux mains de grands propriétaires terriens pourrait obliger la moitié des fermes familiales de plus petite envergure à mettre la clé sous la porte d’ici quelques décennies, selon une étude du Centre canadien de politiques alternatives (CCPA)."
                                            },
                                            {
                                                "example_id": "6da3f668-9922-4453-90e6-bbb82fc4848c",
                                                "sense_id": "e448d1f0-e8ac-3a04-bf3a-271784979bf8",
                                                "text": "J’habite au Manitoba."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5b6fadec-8836-4a9d-b7ac-eaafa0790a03",
                        "source_entry_id": "2b373bf7-3e75-3dfd-ae6b-d9b45ad7922d",
                        "source_sense_id": "04f58de2-d54b-3da2-9055-c1cda36c5851",
                        "source_sense_description": "Provinz im zentralen Kanada",
                        "target_lang_word": "Манитоба",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Манитоба",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "476c65ce-2d5a-3df2-a323-1269c25ab6e4",
                                        "entry_id": "41b615ef-bc4d-370a-bf9b-45e9c0c5075c",
                                        "glosses": [
                                            "провинция в центре южной части Канады"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2453477e-e802-44a4-85d7-ebe2846ec71a",
                                                "sense_id": "476c65ce-2d5a-3df2-a323-1269c25ab6e4",
                                                "text": "Я был на двух фермах в канадской провинции Онтарио. Фермы здесь, как правило, молочно-животноводческие, хлеб сеют в степных провинциях Саскачеван, Манитоба."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "facdc1c9-81ce-3194-92c6-8649735da357",
                                        "entry_id": "41b615ef-bc4d-370a-bf9b-45e9c0c5075c",
                                        "glosses": [
                                            "озеро в Канаде, в провинции Манитоба [1]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "37d9b9ef-cda2-4e01-a55d-3b5d452d73c7",
                                                "sense_id": "facdc1c9-81ce-3194-92c6-8649735da357",
                                                "text": "А вот глобус мне понравился. Хотя почему-то он был развернут к зрителям американской стороной. Скульптор добросовестно вылепил миниатюрные Кордильеры, Аппалачи, Гвианское нагорье. Не забыл про озёра и реки ― Гурон, Атабаска, Манитоба…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
