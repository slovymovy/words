                            {
                                "example_id": "b20dca2a-3fb9-4a67-9534-898effe292ca",
                                "sense_id": "6d49ee9c-95ee-38fc-99e5-96daa8bad8a1",
                                "text": "„Mich erinnert mein Taschenkalender daran, dass er paradox umgekehrt funktioniert wie ich als Person.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
