                                "target_senses": [
                                    {
                                        "sense_id": "aa2a1ff4-4c09-3e88-8a98-65c63bdb1fd7",
                                        "entry_id": "6405a6cd-0047-3c80-b140-b3b465da6223",
                                        "glosses": [
                                            "příslušník náboženství založeného prorokem Mohamedem"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f0053e3-8933-4a2e-99bd-6a38e88093aa",
                                                "sense_id": "aa2a1ff4-4c09-3e88-8a98-65c63bdb1fd7",
                                                "text": "„Host jako host,“ řekl Palivec, „třebas Turek. Pro nás živnostníky neplatí žádná politika. Zaplať si pivo a seď v hospodě a žvaň si, co chceš. To je moje zásada. Jestli to tomu našemu Ferdinandovi udělal Srb nebo Turek, katolík nebo mohamedán, anarchista nebo mladočech, mně je to všechno jedno.“"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a28b10f8-c88f-4fbe-af7f-064bd302eb2b",
                        "source_entry_id": "538a8d5e-01df-309e-8a14-9855395262af",
