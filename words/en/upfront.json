{
    "word_family": [
        "upfrontness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "afca2292-af78-312b-86f8-e7261fa93811",
                    "sense_definition": "Paid or required in advance, before goods are delivered or services are performed.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "money_time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The landlord requires an <w>upfront</w> deposit equal to one month's rent.",
                            "target_lang_translations": {
                                "ru": "Арендодатель требует <w>авансовый</w> залог в размере месячной арендной платы.",
                                "zh": "房东要求支付相当于一个月房租的<w>预付的</w>押金。"
                            }
                        },
                        {
                            "text": "There are no <w>upfront</w> fees to join the program, but you pay a monthly subscription later.",
                            "target_lang_translations": {
                                "ru": "Для вступления в программу нет никаких <w>предварительных</w> взносов, но позже вы платите ежемесячную подписку.",
                                "zh": "加入该项目没有<w>前期</w>费用，但之后你要按月支付订阅费。"
                            }
                        }
                    ],
                    "synonyms": [
                        "advance"
                    ],
                    "antonyms": [
                        "deferred"
                    ],
                    "common_phrases": [
                        "upfront cost",
                        "upfront payment",
                        "upfront fee"
                    ],
                    "target_lang_definitions": {
                        "ru": "Оплачиваемый или требуемый заранее, до доставки товаров или оказания услуг.",
                        "zh": "指在商品交付或服务提供之前就已支付或被要求支付的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "авансовый",
                                "target_lang_sense_clarification": "о платеже или депозите"
                            },
                            {
                                "target_lang_word": "предварительный",
                                "target_lang_sense_clarification": "о взносе или оплате"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "预付的",
                                "target_lang_sense_clarification": "指费用、押金等在提供商品或服务前就要支付"
                            },
                            {
                                "target_lang_word": "前期的",
                                "target_lang_sense_clarification": "强调在开始前就收取"
                            },
                            {
                                "target_lang_word": "预先支付的",
                                "target_lang_sense_clarification": "用于付款、收费等语境"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f884868b-30ff-3628-9bac-d8537d0c0a6c",
                    "sense_definition": "Honest, frank, and straightforward about one's opinions, intentions, or situation.",
                    "learner_level": "C1",
                    "frequency": "High",
                    "semantic_group_id": "character",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was completely <w>upfront</w> about his lack of experience in this field.",
                            "target_lang_translations": {
                                "ru": "Он был совершенно <w>откровенен</w> по поводу отсутствия у него опыта в этой области.",
                                "zh": "他对自己在这个领域缺乏经验这件事完全<w>坦诚</w>。"
                            }
                        },
                        {
                            "text": "I appreciate you being <w>upfront</w> with me regarding the potential risks.",
                            "target_lang_translations": {
                                "ru": "Я ценю, что вы <w>честны</w> со мной касательно возможных рисков.",
                                "zh": "我很感谢你就潜在风险对我这么<w>坦诚</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "frank",
                        "candid",
                        "direct",
                        "open"
                    ],
                    "antonyms": [
                        "secretive",
                        "evasive",
                        "dishonest"
                    ],
                    "common_phrases": [
                        "be upfront about",
                        "be upfront with"
                    ],
                    "target_lang_definitions": {
                        "ru": "Честный, откровенный и прямой в выражении своих мнений или намерений.",
                        "zh": "指对自己的观点、意图或处境诚实、坦率、直截了当。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "откровенный",
                                "target_lang_sense_clarification": "искренний, не скрывающий правды"
                            },
                            {
                                "target_lang_word": "честный",
                                "target_lang_sense_clarification": "правдивый"
                            },
                            {
                                "target_lang_word": "прямой",
                                "target_lang_sense_clarification": "без увиливаний"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "坦诚的",
                                "target_lang_sense_clarification": "真诚直接，不隐瞒事实"
                            },
                            {
                                "target_lang_word": "直率的",
                                "target_lang_sense_clarification": "说话做事直白、不回避"
                            },
                            {
                                "target_lang_word": "开诚布公的",
                                "target_lang_sense_clarification": "强调公开说明、不遮掩"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "8d013ff0-8229-334a-9ff8-ec9bdae7e1ee",
                    "sense_definition": "In advance; before other processes start, especially regarding payment.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "money_time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You need to pay for the concert tickets <w>upfront</w> to secure your seats.",
                            "target_lang_translations": {
                                "ru": "Вам нужно заплатить за билеты на концерт <w>заранее</w>, чтобы забронировать места.",
                                "zh": "为了确保座位，你需要<w>预先</w>支付演唱会门票费用。"
                            }
                        },
                        {
                            "text": "The contractors demanded cash <w>upfront</w> before they would begin the renovation.",
                            "target_lang_translations": {
                                "ru": "Подрядчики потребовали наличные <w>вперёд</w> перед началом ремонта.",
                                "zh": "承包商要求<w>先</w>付现金，然后才肯开始翻修。"
                            }
                        }
                    ],
                    "synonyms": [
                        "beforehand",
                        "in advance"
                    ],
                    "antonyms": [
                        "later"
                    ],
                    "common_phrases": [
                        "pay upfront",
                        "cash upfront",
                        "money upfront"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заранее; до начала других процессов (особенно касательно оплаты).",
                        "zh": "提前地；在其他程序开始前，尤指在付款方面。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "авансом",
                                "target_lang_sense_clarification": "в счет будущих услуг"
                            },
                            {
                                "target_lang_word": "вперёд",
                                "target_lang_sense_clarification": "наперед (об оплате)"
                            },
                            {
                                "target_lang_word": "заранее",
                                "target_lang_sense_clarification": "заблаговременно"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "预先",
                                "target_lang_sense_clarification": "在付款等情境中，表示提前进行"
                            },
                            {
                                "target_lang_word": "事先",
                                "target_lang_sense_clarification": "表示事前、提前"
                            },
                            {
                                "target_lang_word": "先",
                                "target_lang_sense_clarification": "常用于先付款再开始服务的情况"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7dbb0fb7-892c-338c-b079-c925cfdbd5d9",
                    "sense_definition": "In the attacking position of a team sport, particularly football (soccer).",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sports_pos",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manager decided to play two strikers <w>upfront</w> to put pressure on the defense.",
                            "target_lang_translations": {
                                "ru": "Тренер решил выпустить двух нападающих <w>впереди</w>, чтобы оказать давление на защиту.",
                                "zh": "教练决定让两名前锋<w>顶在前面</w>，以给对方防线施压。"
                            }
                        },
                        {
                            "text": "He is very fast and effective when playing <w>upfront</w>.",
                            "target_lang_translations": {
                                "ru": "Он очень быстр и эффективен, когда играет <w>в нападении</w>.",
                                "zh": "他<w>在前场</w>时速度很快，效率也很高。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "play upfront"
                    ],
                    "target_lang_definitions": {
                        "ru": "В атакующей позиции в командном спорте, особенно в футболе.",
                        "zh": "指在团队运动中处于进攻位置，尤指足球中的前场或锋线位置。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "в нападении",
                                "target_lang_sense_clarification": "на позиции атаки"
                            },
                            {
                                "target_lang_word": "впереди",
                                "target_lang_sense_clarification": "на передней линии поля"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "顶在前面",
                                "target_lang_sense_clarification": "指处在进攻线最前面"
                            },
                            {
                                "target_lang_word": "在前场",
                                "target_lang_sense_clarification": "指处于前场、进攻区域"
                            },
                            {
                                "target_lang_word": "在进攻端",
                                "target_lang_sense_clarification": "用于足球等运动中表示在攻击位置活动"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5c7e10d7-d55f-3207-a6fc-0407723b5a33",
                    "sense_definition": "A meeting of television network executives with the press and advertisers to present the new season's schedule.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The network announced several new drama series at this year's <w>upfronts</w>.",
                            "target_lang_translations": {
                                "ru": "Телесеть анонсировала несколько новых драматических сериалов на <w>апфронтах</w> этого года.",
                                "zh": "这家电视网在今年的<w>新季推介会</w>上宣布了几部新的剧情类剧集。"
                            }
                        },
                        {
                            "text": "Advertisers are waiting for the <w>upfronts</w> to decide where to allocate their budgets.",
                            "target_lang_translations": {
                                "ru": "Рекламодатели ждут <w>апфронтов</w>, чтобы решить, куда распределить свои бюджеты.",
                                "zh": "广告主正在等<w>新季推介会</w>，以决定把预算投向哪里。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Встреча руководителей телесетей с прессой и рекламодателями для презентации расписания нового сезона.",
                        "zh": "指电视网高管向媒体和广告主介绍新一季节目安排的发布或推介活动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "апфронт",
                                "target_lang_sense_clarification": "профессиональный термин"
                            },
                            {
                                "target_lang_word": "презентация телесезона",
                                "target_lang_sense_clarification": "описательный перевод"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "新季推介会",
                                "target_lang_sense_clarification": "电视行业中向媒体和广告主介绍新一季节目的活动"
                            },
                            {
                                "target_lang_word": "电视网广告招商会",
                                "target_lang_sense_clarification": "强调电视网向广告主集中推介新节目"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6b9a3f84-3d93-38c8-8a94-518de737eb67",
                    "sense_definition": "To bring to the fore; to place at the front for consideration.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The author <w>upfronts</w> the main argument in the very first chapter.",
                            "target_lang_translations": {
                                "ru": "Автор <w>выдвигает на первый план</w> главный аргумент в самой первой главе.",
                                "zh": "作者在第一章一开始就<w>突出</w>了核心论点。"
                            }
                        },
                        {
                            "text": "This report <w>upfronted</w> the voices of the community members involved in the study.",
                            "target_lang_translations": {
                                "ru": "Этот отчет <w>акцентировал</w> голоса членов сообщества, участвовавших в исследовании.",
                                "zh": "这份报告把参与研究的社区成员的声音<w>置于首位</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "highlight",
                        "foreground"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выдвигать на передний план; ставить во главу угла для рассмотрения.",
                        "zh": "把某事物提到最前面；使其成为优先考虑或重点关注的内容。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выдвигать на первый план",
                                "target_lang_sense_clarification": "делать главным"
                            },
                            {
                                "target_lang_word": "акцентировать",
                                "target_lang_sense_clarification": "подчеркивать важность"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "突出",
                                "target_lang_sense_clarification": "使某事成为最显眼、最重要的部分"
                            },
                            {
                                "target_lang_word": "置于首位",
                                "target_lang_sense_clarification": "把某事放到优先考虑的位置"
                            },
                            {
                                "target_lang_word": "放在前面强调",
                                "target_lang_sense_clarification": "强调并放到前面加以关注"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}