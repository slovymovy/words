            {
                "entry_id": "6bfcb0be-612b-3711-b303-eb7f54162587",
                "word": "gevangene",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "70cc0a63-d4e7-4be0-a2a4-5f12b32e1313",
                        "entry_id": "6bfcb0be-612b-3711-b303-eb7f54162587",
                        "tags": [
