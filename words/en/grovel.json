    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7fd9b3df-0ad8-3b4a-9f1c-10643b945767",
                    "sense_definition": "To act in a humble or submissive way to show respect or fear before someone.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "submissive_behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She refused to <w>grovel</w> in front of the bully, standing her ground."
                        },
                        {
                            "text": "The prisoner was forced to <w>grovel</w> before the king to beg for mercy."
                        }
                    ],
                    "synonyms": [
                        "cringe",
                        "kowtow",
                        "fawn"
                    ],
                    "common_phrases": [
                        "grovel before"
                    ]
                },
                {
                    "sense_id": "2143eea1-aca4-3320-a86e-7547d9236472",
                    "sense_definition": "To behave in an overly apologetic or flattering way to gain favor or a benefit.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "submissive_behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He had to <w>grovel</w> before his boss after missing the important meeting."
                        },
                        {
                            "text": "He hated to <w>grovel</w>, but he knew it was the only way to save his job."
                        }
                    ],
                    "synonyms": [
                        "toady",
                        "suck up"
                    ],
                    "common_phrases": [
                        "grovel for"
                    ]
                },
                {
                    "sense_id": "02909e64-2216-3ad0-9015-eceeebc5426c",
                    "sense_definition": "To move along the ground on hands and knees.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "physical_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The injured soldier had to <w>grovel</w> through the mud to reach safety."
                        },
                        {
                            "text": "They watched the children <w>grovel</w> in the dirt while playing outside."
                        }
                    ],
                    "synonyms": [
                        "crawl",
                        "creep"
                    ]
                },
                {
                    "sense_id": "fd73520d-ed54-3b32-af0e-17210f95369c",
                    "sense_definition": "To lie face down on the ground.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "physical_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The worshippers would <w>grovel</w> on the floor during the sacred ceremony."
                        },
                        {
                            "text": "He was found <w>groveling</w> in the dust after the explosion."
                        }
                    ],
                    "synonyms": [
                        "prostrate"
                    ]
                },
                {
                    "sense_id": "c8a15ba3-e35d-3463-8fe7-89b551ae6099",
                    "sense_definition": "To find satisfaction in low or trivial activities.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He seemed to <w>grovel</w> in the petty gossip of his small town."
                        },
                        {
                            "text": "Some people <w>grovel</w> in their own misery rather than seeking change."
                        }
                    ],
                    "synonyms": [
