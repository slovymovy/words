                    }
                ],
                "senses": [
                    {
                        "sense_id": "fdfe3eac-a649-33c3-aca2-da6acc24d806",
                        "entry_id": "635c690e-c751-30a8-af23-02d60db3b241",
                        "glosses": [
                            "Designed to offer little resistance to the flow of fluid, especially by having sleek, graceful lines."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "acac9d4c-2237-3452-9d5f-53c0448ac1db",
                        "entry_id": "635c690e-c751-30a8-af23-02d60db3b241",
                        "glosses": [
                            "Having been made more simple and straight forward."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "557d66a3-f7f8-4324-8cb8-c63de07ad390",
                                "sense_id": "acac9d4c-2237-3452-9d5f-53c0448ac1db",
                                "text": "Commercial pilots would benefit from streamlined rules on flight time, duty and rest requirements in a proposal being announced Friday by federal regulators."
                            },
                            {
                                "example_id": "43b608e6-611c-4ab5-80fd-e97e2917b6f9",
                                "sense_id": "acac9d4c-2237-3452-9d5f-53c0448ac1db",
                                "text": "He boasted about how quickly the company had brought the 737 Max to market — and praised the Federal Aviation Administration’s “streamlined” certification process."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "63052b39-7466-4c04-9784-943ef5ef9ab6",
                        "source_entry_id": "635c690e-c751-30a8-af23-02d60db3b241",
                        "source_sense_description": "designed to offer little resistance to the flow of fluid; having sleek, graceful lines",
                        "target_lang_word": "aérodynamique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aérodynamique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6c38f9e0-4710-3af1-bd7b-8c4c9c5e7ccc",
                                        "entry_id": "2d785c7b-03fd-3423-8955-ddb65356c6d1",
                                        "glosses": [
                                            "Relatif à l’aérodynamique (la science)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea920e60-7943-4ccd-9485-42783dc5f070",
                                                "sense_id": "6c38f9e0-4710-3af1-bd7b-8c4c9c5e7ccc",
                                                "text": "Nous pourrions envisager d’inclure dans notre programme une phase de calcul du moment aérodynamique total."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8f4c33ba-7f9a-345b-807b-bc1e5a29272a",
                                        "entry_id": "2d785c7b-03fd-3423-8955-ddb65356c6d1",
                                        "glosses": [
                                            "Qui réduit au maximum sa traînée en parlant d’un objet, animé ou non."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c2cfc30-5f9b-4a7e-8c8e-9920ad5fbfaa",
                                                "sense_id": "8f4c33ba-7f9a-345b-807b-bc1e5a29272a",
                                                "text": "Deux ans après avoir décroché le bronze lors des championnats du monde de Bad Gastein, en Autriche, Jean Vuarnet avait donc été sacré champion olympique à Squaw Valley (Etats-Unis). Le descendeur français est notamment célèbre pour avoir inventé la position aérodynamique de l’œuf."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "aérodynamique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1fecea30-e68b-3215-93f0-6f1342d0950a",
                                        "entry_id": "a91f7b54-c5d2-3155-b621-364e9a88d60d",
                                        "glosses": [
                                            "Partie de la physique qui étudie les lois et les mouvements des gaz."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc82dfff-d2d9-4827-afea-3047d7aba1c1",
                                                "sense_id": "1fecea30-e68b-3215-93f0-6f1342d0950a",
                                                "text": "Aérodynamique.\nC’est la science qui s’occupe de rechercher l’effet produit par le déplacement des corps dans l’air ou par le déplacement de l’air autour de corps immobiles. L’expérience montre que les résultats sont les mêmes dans les deux cas. Dans tout ce qui suivra, nous ne considérerons donc que le déplacement, l’un par rapport à l’autre, du corps et de l’air."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6c060cc6-dda1-409c-80e1-2d82e3a3faf8",
                        "source_entry_id": "635c690e-c751-30a8-af23-02d60db3b241",
                        "source_sense_description": "designed to offer little resistance to the flow of fluid; having sleek, graceful lines",
                        "target_lang_word": "windschnittig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "windschnittig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f06a6399-c6f6-3660-b690-3922463a85ae",
                                        "entry_id": "b95798b4-03c8-3606-b5cc-38a81e28dd01",
                                        "glosses": [
                                            "eine Form aufweisend, die gegenüber der umströmenden Luft nur einen geringen Widerstand erzeugt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72c73f95-3d4c-4ce8-820f-015ded9c4f59",
                                                "sense_id": "f06a6399-c6f6-3660-b690-3922463a85ae",
                                                "text": "„Formel 1-Rennwagen sehen zwar windschnittig aus, ihr echter Luftwiderstand ist aber keineswegs gering. Der cw-Wert liegt etwa bei 1,2.“"
                                            },
                                            {
                                                "example_id": "9a4caf9d-18f7-4dbf-b20b-46fcab189d92",
                                                "sense_id": "f06a6399-c6f6-3660-b690-3922463a85ae",
                                                "text": "„Federleichte Materialien und ein windschnittiges Design machen den Lightyear One sparsam.“"
                                            },
                                            {
                                                "example_id": "75e98523-7cce-436c-b705-4d2834ebf4f8",
                                                "sense_id": "f06a6399-c6f6-3660-b690-3922463a85ae",
                                                "text": "„Für die Firma Spitzer ließ sich der Designer einen Lastwagen einfallen, dessen Fahrerhaus einem Fischkopf nachempfunden ist, windschnittig und deshalb sparsam.“"
                                            },
                                            {
                                                "example_id": "b9aeec3a-3f6c-4929-b6be-a271901093df",
                                                "sense_id": "f06a6399-c6f6-3660-b690-3922463a85ae",
                                                "text": "Ein Liegerad ist windschnittiger, als ein normales Fahrrad, auf dem man aufrecht sitzt."
                                            },
                                            {
                                                "example_id": "1460953c-049a-4e6f-81bd-9bc5828393a5",
                                                "sense_id": "f06a6399-c6f6-3660-b690-3922463a85ae",
                                                "text": "„Diese Reisezugwagen waren besonders windschnittig gestaltet, um den Luftwiderstand bei den damals angestrebten höheren Fahrgeschwindigkeiten zu minimieren.“"
                                            },
                                            {
                                                "example_id": "6d34df01-cfe0-43f1-8f3f-6f19b89a11f6",
                                                "sense_id": "f06a6399-c6f6-3660-b690-3922463a85ae",
                                                "text": "„Der windschnittige Triebwagen SVT der Deutschen Reichsbahn sorgte einst für internationales Renommee.“"
                                            },
                                            {
                                                "example_id": "8bf18380-b33f-4c03-9649-2def45dd3175",
                                                "sense_id": "f06a6399-c6f6-3660-b690-3922463a85ae",
                                                "text": "„Stromlinienförmig verkleidet kam die neue Schnellfahr-Tenderlokomotive der Baureihe 61 mit ihren vier windschnittigen Schnellzugwagen immerhin auf 185 Stundenkilometer.“"
                                            },
                                            {
                                                "example_id": "55981a7c-7e7a-4d51-ad75-1774025e18f4",
                                                "sense_id": "f06a6399-c6f6-3660-b690-3922463a85ae",
                                                "text": "[Wintersport:] Bobs sind sehr windschnittig, sie werden im Windkanal optimiert."
                                            },
                                            {
                                                "example_id": "344ab71c-7457-4a51-b554-66ec6bf68155",
                                                "sense_id": "f06a6399-c6f6-3660-b690-3922463a85ae",
                                                "text": "[Galopprennsport:] „Dann bejubeln die Fans die kleinen, in bunten und glänzenden Renntrikots gekleideten Jockeys, die möglichst windschnittig auf ihren Pferden hocken und im Einlauf wild mit der Peitsche rudern, um auch das Letzte aus ihren Pferden herauszuholen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
