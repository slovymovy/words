                ],
                "senses": [
                    {
                        "sense_id": "5f5ba12e-4949-3a41-9520-64e6a6572790",
                        "entry_id": "8f4094e7-a7bc-3f2f-bbd2-790bc7c0ef02",
                        "glosses": [
                            "Not pleased or happy with something."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e8eb58a2-53e0-4a74-9b79-f8ca0c973c64",
                                "sense_id": "5f5ba12e-4949-3a41-9520-64e6a6572790",
