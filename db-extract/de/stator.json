                        "tags": [],
                        "examples": [
                            {
                                "example_id": "65328947-3277-4d30-a018-1e0489aec9c5",
                                "sense_id": "b6bb8e45-ebda-31bf-ba48-cd9fca67c2ea",
                                "text": "Die Bürsten werden mittels Federkraft gegen den Kollektor gedrückt, wobei der Bürstenhalter isoliert am Stator montiert werden muss, um einen Kurzschluss zu vermeiden."
                            },
                            {
                                "example_id": "dff354ed-b7e6-41f1-99da-554724a86677",
                                "sense_id": "b6bb8e45-ebda-31bf-ba48-cd9fca67c2ea",
                                "text": "„Der feststehende Stator hat ebenfalls Schlitze,durch die das Medium zum Homogenisator-Ausgang gelangt.“"
                            }
                        ],
