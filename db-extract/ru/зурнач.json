                            {
                                "example_id": "4d95ddc9-fc1c-4d4b-9712-915ec6896231",
                                "sense_id": "f3a2d422-f89f-3419-962a-d55bf54f7403",
                                "text": "В углу сидели зурначи и старательно наигрывали на своих инструментах"
                            },
                            {
                                "example_id": "d6468b79-d743-416f-8870-e33ace3a558c",
                                "sense_id": "f3a2d422-f89f-3419-962a-d55bf54f7403",
                                "text": "Там весь день наигрывали на дудках, как оркестр зурначей, недовольные шмели"
                            }
                        ]
                    }
