                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a71f5ea5-7943-459a-a59b-718490ad8933",
                                                "sense_id": "0951951a-7d67-3c8b-b011-7cacc9b31c7a",
                                                "text": "Die Verlierer forderten eine Revanche."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "a3e65e9f-d5a0-3f51-823a-124a88e32426",
                                        "entry_id": "c6e1f16b-c403-35cf-b46f-ee52d985f7e5",
                                        "glosses": [
                                            "Ausgleich einer erhaltenen Leistung oder eines erlittenen Schadens"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e3ca912-82a8-4dbd-b980-d524ca6546f4",
                                                "sense_id": "a3e65e9f-d5a0-3f51-823a-124a88e32426",
                                                "text": "Als Revanche für euere Hilfe lade ich euch alle zum Pizzaessen ein."
                                            },
                                            {
                                                "example_id": "bf61892a-e422-46e7-ba87-6400e498b595",
                                                "sense_id": "a3e65e9f-d5a0-3f51-823a-124a88e32426",
                                                "text": "Das ist die Revanche dafür, dass du mir damals die Freundin ausgespannt hast."
                                            }
                                        ],
