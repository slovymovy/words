                "senses": [
                    {
                        "sense_id": "17d83850-9ae0-3f1f-98d8-907319dd270c",
                        "entry_id": "bef5fed9-f03e-3cc0-a562-666413f911bb",
                        "glosses": [
                            "to hang out (to spend time doing nothing in particular)"
                        ],
                        "tags": [
                            "Jamaica",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "8d543706-185e-431c-bfc0-6737437f5b27",
                                "sense_id": "17d83850-9ae0-3f1f-98d8-907319dd270c",
                                "text": "But everyday,^([sic]) while all of this was going on, there'd be some lyming (hanging out)—and this is how the spirit of the music was absorbed, how apprentices both learned and caught on."
                            },
                            {
                                "example_id": "019cfe68-c5c0-4d3f-a121-bf41a0fd5915",
                                "sense_id": "17d83850-9ae0-3f1f-98d8-907319dd270c",
                                "text": "[…] in Carlton's living room one Saturday evening, spending a few hours lyming over rum and, of all things, codfish dumplings, another thing Carlton loved, even in the evening […]"
                            },
                            {
                                "example_id": "713cff42-aede-44db-b13d-1da5d685bfa5",
                                "sense_id": "17d83850-9ae0-3f1f-98d8-907319dd270c",
                                "text": "Guests were directed to the cocktail area where they lymed and enjoyed finger food with a choice of sorrel or fruit punch."
                            },
                            {
                                "example_id": "0e16d3b7-b8df-4ff7-baf9-70e0d07cbcd4",
                                "sense_id": "17d83850-9ae0-3f1f-98d8-907319dd270c",
                                "text": "Barnes, who organised the day's activities which involved several fathers and their children lyming at DaCosta Farms and Adventures, was very adamant that it is important for fathers to bond with their kids while they are still young."
                            }
                        ]
                    }
