                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "support",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il est monté avec prudence sur le dernier <w>barreau</w> de l'échelle pour réparer le toit."
