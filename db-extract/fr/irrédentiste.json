                        "form_id": "d10c9ccd-c42c-4c64-8252-e2b8620acdfe",
                        "entry_id": "4eca564c-47c6-36a9-8dc4-b3d06abc316c",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "irrédentistes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8c337065-52ac-3569-b08e-0947a2a35df0",
                        "entry_id": "4eca564c-47c6-36a9-8dc4-b3d06abc316c",
                        "glosses": [
                            "Relatif à l’irrédentisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e66612f6-ef6a-4ee9-8a24-e6b7486a24b4",
                                "sense_id": "8c337065-52ac-3569-b08e-0947a2a35df0",
                                "text": "La grande majorité des juifs étant irrédentiste et n’entendant nullement subir le joug germanique aussitôt après le traité de Francfort, un grand mouvement d’émigration se dessina."
                            },
                            {
                                "example_id": "f8d995cd-332b-4412-ad1f-2381264ad566",
                                "sense_id": "8c337065-52ac-3569-b08e-0947a2a35df0",
                                "text": "Comme il n’est secondé que par une servante (Autrichienne, mais irrédentiste) et que nous sommes vingt clients, il s’empresse, bondit d’un bout à l'autre de la salle."
                            },
                            {
                                "example_id": "a3be8062-e830-492f-8d27-b95ef69ee658",
                                "sense_id": "8c337065-52ac-3569-b08e-0947a2a35df0",
                                "text": "Mais écartons –pour le moment du moins- la conquête brutale de la joie. Ne risquons pas de tout gâter et de faire une Jacqueline irrédente"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "132365d8-f654-482e-a4d6-849702d29431",
                        "source_entry_id": "4eca564c-47c6-36a9-8dc4-b3d06abc316c",
                        "source_sense_id": "8c337065-52ac-3569-b08e-0947a2a35df0",
                        "target_lang_word": "irredentist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "irredentist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4ef5e0f4-41a8-372e-b2ff-27b86a49fb5e",
                                        "entry_id": "3dbc8461-3aef-38fa-842c-5284c10bf4b1",
                                        "glosses": [
                                            "Someone who calls for the seizure or recovery of territories or states currently subject to other countries; an adherent of irredentism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25dc5685-a860-49d3-a445-6679633db78f",
                                                "sense_id": "4ef5e0f4-41a8-372e-b2ff-27b86a49fb5e",
                                                "text": "As the assassination of Sadat proved, the Arab irredentists, like the Zionist ultras, have always been unerring in picking off any incipient mediators."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "irredentist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fc784eff-4774-3e9d-8906-1c976001fe9f",
                                        "entry_id": "8979e944-1371-3b6b-8689-a5dfbcb9775a",
                                        "glosses": [
                                            "Of or relating to irredentists or their policies."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8497d03a-f5b9-4c70-abe4-5968e634367a",
                                                "sense_id": "fc784eff-4774-3e9d-8906-1c976001fe9f",
                                                "text": "In 1885, a Bulgarian irredentist movement seized control of neighbouring Ottoman-ruled Eastern Roumelia and announced the creation of a Greater Bulgaria."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
