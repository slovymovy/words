{
    "word_family": [
        "shagginess"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "a3369191-fe87-33dc-9b3c-fd679ee502e1",
                    "sense_definition": "Having long, thick, and uncombed hair, fur, or wool.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "texture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>shaggy</w> dog ran through the tall grass.",
                            "target_lang_translations": {
                                "ru": "<w>Косматая</w> собака бежала через высокую траву."
                            }
                        },
                        {
                            "text": "He brushed his <w>shaggy</w> hair before the meeting.",
                            "target_lang_translations": {
                                "ru": "Перед встречей он причесал свои <w>лохматые</w> волосы."
                            }
                        }
                    ],
                    "synonyms": [
                        "hairy",
                        "woolly",
                        "unkept"
                    ],
                    "antonyms": [
                        "smooth",
                        "sleek"
                    ],
                    "common_phrases": [
                        "shaggy dog"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий длинную, густую и нечесаную шерсть, мех или волосы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "косматый",
                                "target_lang_sense_clarification": "о животном или человеке с густой, спутанной шерстью или волосами"
                            },
                            {
                                "target_lang_word": "лохматый",
                                "target_lang_sense_clarification": "о ком-либо с растрепанными, взъерошенными волосами или шерстью"
                            },
                            {
                                "target_lang_word": "мохнатый",
                                "target_lang_sense_clarification": "покрытый густой шерстью или мехом"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cc3fb951-ee4d-32ff-b88c-68ac46ac2bab",
                    "sense_definition": "Having a rough, uneven surface similar to long hair.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "texture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The room felt cozy with its <w>shaggy</w> carpet.",
                            "target_lang_translations": {
                                "ru": "Комната казалась уютной благодаря <w>ворсистому</w> ковру."
                            }
                        },
                        {
                            "text": "She bought a <w>shaggy</w> rug for the living room floor.",
                            "target_lang_translations": {
                                "ru": "Она купила <w>лохматый</w> коврик на пол в гостиную."
                            }
                        }
                    ],
                    "synonyms": [
                        "rough",
                        "coarse"
                    ],
                    "antonyms": [
                        "smooth"
                    ],
                    "common_phrases": [
                        "shaggy carpet",
                        "shaggy rug"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий грубую, неровную поверхность, напоминающую длинный ворс."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ворсистый",
                                "target_lang_sense_clarification": "о ткани или ковре с длинным ворсом"
                            },
                            {
                                "target_lang_word": "лохматый",
                                "target_lang_sense_clarification": "о ковре с длинным, неровным ворсом"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c9f6ce86-1ec3-3511-a749-b0e53db6d3cc",
                    "sense_definition": "Lacking focus or structure; muddled or disorganized.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The plot of the movie became quite <w>shaggy</w> in the final act.",
                            "target_lang_translations": {
                                "ru": "Сюжет фильма стал довольно <w>бессвязным</w> в последнем акте."
                            }
                        },
                        {
                            "text": "His argument was a bit <w>shaggy</w> and hard to follow.",
                            "target_lang_translations": {
                                "ru": "Его аргументация была немного <w>нечеткой</w> и трудной для восприятия."
                            }
                        }
                    ],
                    "synonyms": [
                        "disorganized",
                        "muddled",
                        "loose"
                    ],
                    "antonyms": [
                        "structured",
                        "precise"
                    ],
                    "target_lang_definitions": {
                        "ru": "Лишенный четкости или структуры; запутанный или неорганизованный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нечеткий",
                                "target_lang_sense_clarification": "о структуре или аргументации, лишенной ясности"
                            },
                            {
                                "target_lang_word": "бессвязный",
                                "target_lang_sense_clarification": "о сюжете или речи, в которых отсутствует логическая последовательность"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}