                            },
                            {
                                "target_lang_word": "przeszły",
                                "target_lang_sense_clarification": "odnoszący się do dawnych czasów"
                            },
                            {
                                "target_lang_word": "miniony",
                                "target_lang_sense_clarification": "o dniach lub latach"
                            }
                        ]
                    }
