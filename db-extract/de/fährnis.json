                                ]
                            },
                            {
                                "target_word": "peril",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0cbf4738-748d-34f6-80c6-fb28a84d2cca",
                                        "entry_id": "2008c485-9adb-339c-8258-1e89319391dd",
                                        "glosses": [
                                            "To cause to be in danger; to imperil; to risk."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd4b7fc5-4993-49b6-ad98-f6bb5c53d834",
                                                "sense_id": "0cbf4738-748d-34f6-80c6-fb28a84d2cca",
                                                "text": "And are we, Mr. President, who stood by our country then, who threw open our coffers, who bared our bosoms, who freely perilled all in that conflict, to be reproached with want of attachment to the Union?"
                                            },
                                            {
                                                "example_id": "81e995ac-9303-4985-a370-c79254fdcbe1",
                                                "sense_id": "0cbf4738-748d-34f6-80c6-fb28a84d2cca",
                                                "text": "\"I will have nothing to do with this matter, whatever it is. Do you think I am going to peril my reputation for you?\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2126c961-a7d4-4262-b045-c5e09e85a9a3",
                        "source_entry_id": "ecebae99-72db-3256-a656-e5f48cd4910c",
                        "source_sense_id": "5a2e11a2-74c1-36ed-ba63-49531794d476",
                        "source_sense_description": "poetisch: Gefahr",
                        "target_lang_word": "danger",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "danger",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e3d51dc3-0e1d-32ee-a72f-da14f7a33872",
                                        "entry_id": "7b3083c2-aed6-3090-97a8-f513bd6908a2",
                                        "glosses": [
                                            "Ce qui est ordinairement suivi d’un malheur, ou qui expose à une perte, à un dommage, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3457c18e-d37c-4334-848c-119f8043a9a2",
                                                "sense_id": "e3d51dc3-0e1d-32ee-a72f-da14f7a33872",
                                                "text": "Hervé, du reste, s’était précautionné dès le matin contre les inconvénients et contre les dangers d'une conférence nocturne sur une berge écartée, en plein hiver."
                                            },
                                            {
                                                "example_id": "636a2668-a818-405b-9b75-8161c95f5717",
                                                "sense_id": "e3d51dc3-0e1d-32ee-a72f-da14f7a33872",
                                                "text": "J’ai appelé l’attention sur le danger que présentent pour l’avenir d’une civilisation les révolutions qui se produisent dans une ère de déchéance économique; […]."
                                            },
                                            {
                                                "example_id": "21fe2148-da80-47fc-acba-d6f829a11977",
                                                "sense_id": "e3d51dc3-0e1d-32ee-a72f-da14f7a33872",
                                                "text": "[…], des phares éloignent les navires des dangers ou les conduisent dans les ports abrités par des digues construites en luttant contre les tempêtes."
                                            },
                                            {
                                                "example_id": "53a26283-4499-4a8a-8b69-633a832964ef",
                                                "sense_id": "e3d51dc3-0e1d-32ee-a72f-da14f7a33872",
                                                "text": "Je suivis une route en zigzags qui devaient me faire éviter tous les dangers."
                                            },
                                            {
                                                "example_id": "1dd7f0a5-470d-40fa-ab57-e3ab54679861",
                                                "sense_id": "e3d51dc3-0e1d-32ee-a72f-da14f7a33872",
                                                "text": "Parfois on côtoie le danger sans le percevoir, parce qu’on n’y réfléchit pas, ou que l’on ne croit pas à sa menace."
                                            },
                                            {
                                                "example_id": "42acfdb8-0df1-409e-bfc8-4738ab4deab6",
                                                "sense_id": "e3d51dc3-0e1d-32ee-a72f-da14f7a33872",
                                                "text": "J’avais été beaucoup plus rarement bombardé du haut des airs, et je me trouvai, devant ce danger-là, presque aussi béjaune que mes conscrits."
                                            },
                                            {
                                                "example_id": "3af84452-843a-4c24-906e-304dc9f2babf",
                                                "sense_id": "e3d51dc3-0e1d-32ee-a72f-da14f7a33872",
                                                "text": "Dans l’espace, de graves dangers nous guettent, parmi lesquels : micrométéorites, radiations cosmiques mortelles et vieillissement accéléré en apesanteur."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "47f6ceb7-2e5b-4bf2-8c9e-44b175c62457",
                        "source_entry_id": "ecebae99-72db-3256-a656-e5f48cd4910c",
                        "source_sense_id": "5a2e11a2-74c1-36ed-ba63-49531794d476",
                        "source_sense_description": "poetisch: Gefahr",
                        "target_lang_word": "péril",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "péril",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e15d7040-b2b7-3354-9e17-d8c81c09a9e7",
                                        "entry_id": "9c67daf3-54d6-3443-8861-5b7709f48936",
                                        "glosses": [
                                            "Danger, risque, état où il y a quelque chose de fâcheux à craindre."
                                        ],
                                        "tags": [
                                            "formal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c4f7be7-195f-42e6-ac66-ef67870ab2ba",
                                                "sense_id": "e15d7040-b2b7-3354-9e17-d8c81c09a9e7",
                                                "text": "À vaincre sans péril, on triomphe sans gloire."
                                            },
                                            {
                                                "example_id": "9dfd132e-1c49-462f-83a3-d2df2b866498",
                                                "sense_id": "e15d7040-b2b7-3354-9e17-d8c81c09a9e7",
                                                "text": "Maurin crut que la République était en péril."
                                            },
                                            {
                                                "example_id": "3b73a93d-346b-42f9-9619-362f427c6230",
                                                "sense_id": "e15d7040-b2b7-3354-9e17-d8c81c09a9e7",
                                                "text": "[…] il se demandait s’il avait bien réellement le droit d’associer à cette vie de périls et d’embûches continuelles une jeune fille de l’âge de sa nièce."
                                            },
                                            {
                                                "example_id": "2cb69c7b-d856-4a4d-b5e8-2a2e6c3350ff",
                                                "sense_id": "e15d7040-b2b7-3354-9e17-d8c81c09a9e7",
                                                "text": "Loin du danger, il ne rêve qu’exploits héroïques, entreprises surhumaines et gigantesques ; mais, quand vient le péril, son imagination trop vive lui représente la douleur des blessures, le visage camard de la mort, et le cœur lui manque ; […]."
                                            },
                                            {
                                                "example_id": "032f50d3-d1c9-4430-b7a9-2107993343a0",
                                                "sense_id": "e15d7040-b2b7-3354-9e17-d8c81c09a9e7",
                                                "text": "C’était le coffret qu’Ayrton avait sauvé au péril de sa vie."
                                            },
                                            {
                                                "example_id": "1f26e85f-52e5-4771-956a-eb9eba19945f",
                                                "sense_id": "e15d7040-b2b7-3354-9e17-d8c81c09a9e7",
                                                "text": "Aussi, lorsque, après avoir franchi une porte vitrée immense, donnant sur un vestibule un peu moins vaste que le Square du temple, nous nous engageâmes dans un large escalier aux marches déclives, usées et traîtresses, mais qu’une rampe remarquablement ciselée aidait à gravir sans péril, je me contentai, toujours prudent, d’admirer l’élégante rampe en silence."
                                            },
                                            {
                                                "example_id": "2bb59130-a24d-4bea-ba92-4564d035cc5e",
                                                "sense_id": "e15d7040-b2b7-3354-9e17-d8c81c09a9e7",
                                                "text": "— Ma foi, mon cher Sorel, à vos risques et périls."
                                            },
                                            {
                                                "example_id": "53259f8d-4032-4ac0-bbd7-37ac80f9effd",
                                                "sense_id": "e15d7040-b2b7-3354-9e17-d8c81c09a9e7",
                                                "text": "Il se peut qu’à l’heure du péril de guerre, le syndicalisme souffrît d’un léger fléchissement."
                                            },
                                            {
                                                "example_id": "8b4c7b41-e10a-4795-b070-3409b904640d",
                                                "sense_id": "e15d7040-b2b7-3354-9e17-d8c81c09a9e7",
                                                "text": "Qu’y a-t-il Héloïse ?\n Le prénom familier rompait l’envoûtement, conjurait le péril. Il la rejetait vers l’enfance, niait sa flamboyante puberté […]."
                                            },
                                            {
                                                "example_id": "45ab2254-6f50-4ed8-b78a-dda5f6b3628e",
                                                "sense_id": "e15d7040-b2b7-3354-9e17-d8c81c09a9e7",
                                                "text": "Lorsque le pays est menacé d’un péril imminent dans ses institutions, dans son indépendance ou dans son intégrité territoriale, le Président de la République décrète l’état d’exception."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f09884ac-7747-43f4-93a8-0b54de273ece",
                        "source_entry_id": "ecebae99-72db-3256-a656-e5f48cd4910c",
                        "source_sense_id": "5a2e11a2-74c1-36ed-ba63-49531794d476",
                        "source_sense_description": "poetisch: Gefahr",
