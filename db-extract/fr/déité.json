        "fr-extract.jsonl": [
            {
                "entry_id": "a6f76ac0-8b1f-36c1-b53e-9a9bd98e39cf",
                "word": "déité",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "beb69c44-3a63-49fe-aaf1-29cc9235fd73",
                        "entry_id": "a6f76ac0-8b1f-36c1-b53e-9a9bd98e39cf",
                        "tags": [
                            "plural"
                        ],
                        "form": "déités"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7038543a-fc65-3946-b769-225bc3046c2b",
                        "entry_id": "a6f76ac0-8b1f-36c1-b53e-9a9bd98e39cf",
                        "glosses": [
                            "Essence divine."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "d602d463-defe-3934-a823-2ac20b8f7a70",
                        "entry_id": "a6f76ac0-8b1f-36c1-b53e-9a9bd98e39cf",
                        "glosses": [
                            "Dieu ou déesse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5888b985-5779-418d-8480-140b93802cf8",
                                "sense_id": "d602d463-defe-3934-a823-2ac20b8f7a70",
                                "text": "Les Grecs et les Romains ont fait régner de fausses déités."
                            },
                            {
                                "example_id": "ddc8b029-f04d-4de9-b142-9c75e8bca951",
                                "sense_id": "d602d463-defe-3934-a823-2ac20b8f7a70",
                                "text": "[…] Déités immortelles ! Mon fils serait vengé ! N’est-ce point une erreur ?"
                            }
                        ]
                    },
                    {
                        "sense_id": "42d9b607-5d00-3c80-a34b-f2e3e402b67c",
                        "entry_id": "a6f76ac0-8b1f-36c1-b53e-9a9bd98e39cf",
                        "glosses": [
                            "Dieu ou déesse de la fable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e628f49f-b53a-40e1-8ab0-0191da91720f",
                                "sense_id": "42d9b607-5d00-3c80-a34b-f2e3e402b67c",
                                "text": "Vous avez fait la femme en voulant vous venger ; faites la déité [montrez-vous déesse], le sauvant du danger."
                            },
                            {
                                "example_id": "39eee8bf-1902-4c74-a7f0-5662cf6858d5",
                                "sense_id": "42d9b607-5d00-3c80-a34b-f2e3e402b67c",
                                "text": "Elle jura par Pluton que toute l’engeance humaine serait bientôt du domaine des déités de là-bas."
                            },
                            {
                                "example_id": "bfdae59d-6816-4db1-a521-e7a921196c7b",
                                "sense_id": "42d9b607-5d00-3c80-a34b-f2e3e402b67c",
                                "text": "Pour voir ces déités nouvelles, le soleil tient encor ses coursiers arrêtés."
                            },
                            {
                                "example_id": "a8d10ed3-02c5-444a-8ad5-4c7d13fe39e2",
                                "sense_id": "42d9b607-5d00-3c80-a34b-f2e3e402b67c",
                                "text": "Bientôt, incommodée sans doute par la chaleur de la salle ou peut-être voulant faire aux mortels une générosité dont ils ne sont guère dignes, la jeune déité ôta l’odieux morceau de carton qui éclipsait la moitié de sa splendeur."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bd261927-3b9b-4270-a345-a26f008cebfd",
                        "source_entry_id": "a6f76ac0-8b1f-36c1-b53e-9a9bd98e39cf",
                        "source_sense_description": "dieu ou déesse",
                        "target_lang_word": "Gottheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gottheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4964b51a-e37a-34b5-b7db-2da9eb640699",
                                        "entry_id": "80343115-82f6-355a-8389-632156951c79",
                                        "glosses": [
                                            "von Menschen verehrtes fiktives, übernatürliches, meist unsterbliches Wesen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "99de1404-52f6-4d0d-a5fe-68cd03c2a1e6",
                                                "sense_id": "4964b51a-e37a-34b5-b7db-2da9eb640699",
                                                "text": "Amor ist eine römische Gottheit."
                                            },
                                            {
                                                "example_id": "d967d193-f500-4a3c-b542-cda014d953e4",
                                                "sense_id": "4964b51a-e37a-34b5-b7db-2da9eb640699",
                                                "text": "„Zahlreiche keltische Gottheiten stehen in einem besonderen Verhältnis zu Tieren.“"
                                            },
                                            {
                                                "example_id": "1f67630d-0dd4-4dd8-bf1b-01d882c44f97",
                                                "sense_id": "4964b51a-e37a-34b5-b7db-2da9eb640699",
                                                "text": "„Sie kommen in der gesamten antiken Welt nur in Gebieten mit keltischer Bevölkerung, aber in der Zeit nach der römischen Okkupation vor, sie sind auch zum größten Teil gallischen Gottheiten gewidmet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "891c6008-c623-36ca-87ca-51d5c08ad095",
                                        "entry_id": "80343115-82f6-355a-8389-632156951c79",
                                        "glosses": [
                                            "göttliches Sein"
                                        ],
                                        "tags": [
                                            "literary",
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2f58dadc-61f6-4779-85ef-4f92480379d7",
                                                "sense_id": "891c6008-c623-36ca-87ca-51d5c08ad095",
                                                "text": "Als ich in dem Grunde, in dem Boden, in dem Fluss und in der Quelle der Gottheit stand, da fragte mich niemand, wohin ich wollte oder was ich täte: da war niemand, der mich fragte."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "75439896-9e9f-4b30-852c-ee70be535aa2",
                        "source_entry_id": "a6f76ac0-8b1f-36c1-b53e-9a9bd98e39cf",
                        "source_sense_description": "dieu ou déesse",
                        "target_lang_word": "deity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "deity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e2d532ec-02d0-3b06-9091-453ea7454590",
                                        "entry_id": "c1ff945e-a69b-3e8c-9a28-add5831fb359",
                                        "glosses": [
                                            "Synonym of divinity: the state, position, or fact of being a god."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f7a7167a-92bf-4386-99e8-462938656557",
                                                "sense_id": "e2d532ec-02d0-3b06-9091-453ea7454590",
                                                "text": "Thou seest all, yet none at all sees thee: / All that is by the working of thy Deitee."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6c567694-dbdf-360a-861c-5a94f8f208d3",
                                        "entry_id": "c1ff945e-a69b-3e8c-9a28-add5831fb359",
                                        "glosses": [
                                            "A supernatural divine being; a god or goddess."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "44dafd62-c29e-4f06-aa09-e72e947c3cef",
                                                "sense_id": "6c567694-dbdf-360a-861c-5a94f8f208d3",
                                                "text": "The fact that in most lands the moon was originally a female deity has led many historians to dispute the superiority of the moon over the sun in ancient mythology."
                                            },
                                            {
                                                "example_id": "76181e68-1833-40b1-876f-79812cac767d",
                                                "sense_id": "6c567694-dbdf-360a-861c-5a94f8f208d3",
                                                "text": "Every act of a Roman, from birth to death, from dawn to night, was controlled and supervised by some presiding deity."
                                            },
                                            {
                                                "example_id": "77d1e89a-d7c5-47b5-9b34-705d8958d319",
                                                "sense_id": "6c567694-dbdf-360a-861c-5a94f8f208d3",
                                                "text": "The crux of monotheism is not only belief in a single deity but belief in a deity who is different from everything else."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "29add7d3-c22c-4178-9a91-583ced0010ad",
                        "source_entry_id": "a6f76ac0-8b1f-36c1-b53e-9a9bd98e39cf",
                        "source_sense_description": "dieu ou déesse",
                        "target_lang_word": "godhead",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "godhead",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "824fd29c-d44b-365e-83ec-682438d5798c",
                                        "entry_id": "84395a05-4bf5-3366-84ab-2ebb39d98f8d",
                                        "glosses": [
                                            "Divinity or godhood, divine essence or nature."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "52b0a43b-7123-47b9-a1f2-c67bb52ad732",
                                                "sense_id": "824fd29c-d44b-365e-83ec-682438d5798c",
                                                "text": "For the inuisible things of him from the Creation of the world, are clearely seene, being vnderstood by the things that are made, euen his eternall Power and Godhead, so that they are without excuse:"
                                            },
                                            {
                                                "example_id": "c565fd33-eb3f-4ec7-a64b-fee31b5e2251",
                                                "sense_id": "824fd29c-d44b-365e-83ec-682438d5798c",
                                                "text": "It was at Fort Yukon that White Fang saw his first white men. As compared with the Indians he had known, they were to him another race of beings, a race of superior gods. They impressed him as possessing superior power, and it is on power that god-head rests."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ecc19ace-47e4-3147-b3b7-4a29172e554e",
                                        "entry_id": "84395a05-4bf5-3366-84ab-2ebb39d98f8d",
                                        "glosses": [
                                            "God."
                                        ],
                                        "tags": [
                                            "capitalized",
                                            "countable",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a7a38f3d-9e40-4d5d-8f0b-edf1cb0b7abd",
                                                "sense_id": "ecc19ace-47e4-3147-b3b7-4a29172e554e",
                                                "text": "For in him dwelleth all the fulneſſe of the Godhead bodily."
                                            },
                                            {
                                                "example_id": "aee6751d-fc4e-4612-832c-c697aca6b3d5",
                                                "sense_id": "ecc19ace-47e4-3147-b3b7-4a29172e554e",
                                                "text": "when at the holy mount / Of Heav'ns high-ſeated top, th' Impereal Throne / Of Godhead, fixed for ever firm and ſure,"
                                            },
                                            {
                                                "example_id": "0c448482-48bb-4e7d-b72c-10b7dcc4bf0d",
                                                "sense_id": "ecc19ace-47e4-3147-b3b7-4a29172e554e",
                                                "text": "They unanimously pronounced, that the worship of images is agreeable to Scripture and reason, to the fathers and councils of the church: but they hesitate whether that worship be relative or direct; whether the Godhead, and the figure of Christ, be entitled to the same mode of adoration."
                                            },
                                            {
                                                "example_id": "ad7206aa-b129-4281-b857-21199db3cb65",
                                                "sense_id": "ecc19ace-47e4-3147-b3b7-4a29172e554e",
                                                "text": "Stern Lawgiver! yet thou dost wear / The Godhead's most benignant grace; / Nor know we any thing so fair / As is the smile upon thy face;"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "51dc9ad3-1672-3bc6-948e-ad96fe40ca43",
                                        "entry_id": "84395a05-4bf5-3366-84ab-2ebb39d98f8d",
                                        "glosses": [
                                            "Any deity or idol."
                                        ],
                                        "tags": [
                                            "countable",
                                            "rare",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "944ca0c5-61a4-4871-b3e0-42b8faf8bd1f",
                                                "sense_id": "51dc9ad3-1672-3bc6-948e-ad96fe40ca43",
                                                "text": "Adoring firſt the Genius of the Place, / Then Earth, the Mother of the Heav'nly Race, / The Nymphs, and native Godheads yet unknown, / And Night, and all the Stars that gild her ſable Throne,"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4e88f909-f405-3b41-a917-9ca67a63a52a",
                                        "entry_id": "84395a05-4bf5-3366-84ab-2ebb39d98f8d",
                                        "glosses": [
                                            "An admired or influential person or entity."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "20169a05-43a5-4bed-911e-b05eaf5c8bde",
                                                "sense_id": "4e88f909-f405-3b41-a917-9ca67a63a52a",
                                                "text": "He pauses, as if hesitant to mention the godhead of computer design aloud, and adds, \"Maybe even something Apple would be interested in.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
