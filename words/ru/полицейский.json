                {
                    "sense_id": "a9d5cfbc-7075-34ba-a4d5-29f19262092d",
                    "sense_definition": "Сотрудник государственных органов, занимающийся охраной общественного порядка.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "На перекрёстке стоит <w>полицейский</w> и внимательно следит за движением машин.",
                            "target_lang_translations": {
                                "en": "A <w>police officer</w> is standing at the intersection, watching the traffic closely.",
                                "nl": "Op het kruispunt staat een <w>politieagent</w> die het verkeer aandachtig in de gaten houdt."
                            }
                        },
                        {
                            "text": "Если вы потерялись в городе, найдите любого <w>полицейского</w> и попросите о помощи.",
                            "target_lang_translations": {
                                "en": "If you get lost in the city, find any <w>police officer</w> and ask for help.",
                                "nl": "Als je verdwaald bent in de stad, zoek dan een <w>agent</w> en vraag om hulp."
                            }
                        }
                    ],
                    "synonyms": [
                        "милиционер",
                        "страж порядка"
                    ],
                    "antonyms": [
                        "преступник"
                    ],
                    "common_phrases": [
                        "вызвать полицейского",
                        "дежурный полицейский",
                        "местный полицейский"
                    ],
                    "target_lang_definitions": {
                        "en": "A law enforcement officer responsible for maintaining public order.",
                        "nl": "Een medewerker van de politie die verantwoordelijk is voor de handhaving van de openbare orde."
                    },
