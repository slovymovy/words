            {
                "entry_id": "21bf96d5-e66b-3810-af8a-7b771b5e9c95",
                "word": "na'vi",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "f4d48cd5-6c41-3aed-9bbd-60087e5f8c8c",
                        "entry_id": "21bf96d5-e66b-3810-af8a-7b771b5e9c95",
                        "glosses": [
                            "Langue construite créée par Paul Frommer pour les extraterrestres dans le film américain Avatar."
                        ],
                        "tags": [
                            "Science-fiction"
                        ],
                        "examples": [
                            {
                                "example_id": "71940a1b-da39-415d-b20a-95ac949c169a",
                                "sense_id": "f4d48cd5-6c41-3aed-9bbd-60087e5f8c8c",
                                "text": "Fan de la première heure comme beaucoup des membres du groupe Discord, Mako apprend le na’vi depuis 2010 et estime avoir mis six ans pour le parler couramment."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0191b486-5270-4142-a659-ab1f29f960bf",
                        "source_entry_id": "21bf96d5-e66b-3810-af8a-7b771b5e9c95",
                        "source_sense_id": "f4d48cd5-6c41-3aed-9bbd-60087e5f8c8c",
                        "target_lang_word": "Na’vi-Sprache",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "ce82c644-eff2-41cb-9021-2cdc5a5ac6ec",
                        "source_entry_id": "21bf96d5-e66b-3810-af8a-7b771b5e9c95",
                        "source_sense_id": "f4d48cd5-6c41-3aed-9bbd-60087e5f8c8c",
                        "target_lang_word": "Naʼvi",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Naʼvi",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "92900ce7-6cf0-3968-9d09-8b8e8ccfca9d",
                                        "entry_id": "0b485bc0-e5af-3618-b1bb-5f414f84977e",
                                        "glosses": [
                                            "A member of a fictional alien race in the 2009 film Avatar, depicted as tall blue humanoids."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8843c15b-7c05-483e-ba73-52c8678b0b24",
                                                "sense_id": "92900ce7-6cf0-3968-9d09-8b8e8ccfca9d",
                                                "text": "Still, the Na’vi—the race of 10-foot smurfs who inhabit the distant planet Pandora in Cameron’s upcoming, $400 million science fiction epic, Avatar—had to speak something."
                                            },
                                            {
                                                "example_id": "3a41af48-263e-4d8d-b0ef-d86817d51b5b",
                                                "sense_id": "92900ce7-6cf0-3968-9d09-8b8e8ccfca9d",
                                                "text": "We are Harry Potter and William Wallace, the Na’vi and Han Solo. We’re escaping from Shawshank and blowing up the Death Star. We are fighting with the Harkonnens and challenging Thanos. Ukraine is hosting one of the great epics of this century."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Naʼvi",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f417a766-f1d7-3646-940b-28f41b9919fa",
                                        "entry_id": "90747606-6f77-3e5e-9a21-31f67c2d3af6",
                                        "glosses": [
                                            "A constructed language designed by Paul Frommer to be spoken by fictional extraterrestrials in the 2009 film Avatar."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83fd7a6d-6755-4b70-99de-5a0f5f7dc755",
                                                "sense_id": "f417a766-f1d7-3646-940b-28f41b9919fa",
                                                "text": "Frommer is holding out hope that Na’vi will follow the example of Klingon, which he calls the “gold standard for this alien language niche.”"
                                            },
                                            {
                                                "example_id": "58710252-d93a-49bd-b6b9-8a550f9f8c19",
                                                "sense_id": "f417a766-f1d7-3646-940b-28f41b9919fa",
                                                "text": "You might be familiar with more a priori conlangs than you think: The Klingon language from the television series \"Star Trek,\" the Na’vi language from the movie \"Avatar,\" and the Dothraki language from the television series \"Game of Thrones\" are all examples of a priori languages."
                                            },
                                            {
                                                "example_id": "466b1e6b-b5e0-401b-8009-d8f1bdf33118",
                                                "sense_id": "f417a766-f1d7-3646-940b-28f41b9919fa",
                                                "text": "Speakers of toki pona have formed a large online community. On Discord, the largest toki pona community claims approximately 13,000 members (as of February 1, 2024), more than the largest Na’vi community at approximately 9,600 members, the largest Interslavic community at approximately 8,000 members, or the largest Esperanto community at approximately 7,400 members."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
