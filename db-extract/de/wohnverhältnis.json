                "senses": [
                    {
                        "sense_id": "4a74b110-81a2-302f-8d9f-0bb25e519956",
                        "entry_id": "447b52a8-8607-3cee-83b6-500953acbc19",
                        "glosses": [
                            "Art, wie jemand wohnt"
                        ],
                        "tags": [
                            "plural-normally"
                        ],
                        "examples": [
                            {
                                "example_id": "8e7d9ea6-316a-4462-9f45-bf4bca495257",
                                "sense_id": "4a74b110-81a2-302f-8d9f-0bb25e519956",
                                "text": "„Die demokratische Gesellschaftsordnung westlicher Prägung ist, aufbauend auf historisch gewachsene Strukturen, durch eine soziale Schichtung mit unterschiedlicher sozialer Mobilität gekennzeichnet, die u.a. durch Berufsposition, Schulbildung, Einkommen und Wohnverhältnisse bestimmt wird.“"
                            },
                            {
                                "example_id": "d45529f5-49de-458a-b67d-f0803c2ac6e3",
                                "sense_id": "4a74b110-81a2-302f-8d9f-0bb25e519956",
                                "text": "„Die Arbeitsminister der Bundesländer setzen sich auf einer Tagung in Hamburg für bessere Wohnverhältnisse der Gastarbeiter ein.“"
                            },
                            {
                                "example_id": "f9c2d1ed-dfa9-4b72-bf99-d2e695e7b619",
                                "sense_id": "4a74b110-81a2-302f-8d9f-0bb25e519956",
                                "text": "„Langsam ging es bergauf für die kleine Familie, aber auf Dauer waren die Wohnverhältnisse untragbar, weshalb sich meine Großmutter beim Arolser Wohnungsamt um eine größere Wohnung bewarb.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
