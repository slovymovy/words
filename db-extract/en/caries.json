                    {
                        "translation_id": "aaab95f1-4f8a-4d05-8054-960e43145fbe",
                        "source_entry_id": "3aa1f7f3-1e0d-3e03-9e59-2010babe1398",
                        "source_sense_description": "progressive destruction of bone or tooth by decay",
                        "target_lang_word": "caries",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "caries",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "c1888d9e-964e-3aca-9ee9-3b88eb9c7496",
                                        "entry_id": "d2a2daa6-1f3d-32df-9d34-6d0872ba10b1",
                                        "glosses": [
                                            "Destrucción progresiva del diente por la acción de bacterias presentes en la placa dental."
                                        ],
                                        "tags": [
                                            "Enfermedades"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e317f24-56b1-4772-ada0-3fa683c5ce2a",
                                                "sense_id": "c1888d9e-964e-3aca-9ee9-3b88eb9c7496",
                                                "text": "«Las bacterias en la placa dental producen ácidos que pueden dañar los dientes y hacer que se formen huecos en el esmalte ([…] conocidas como caries)»."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0859cad3-d6f5-3628-b380-30e8c6166509",
                                        "entry_id": "d2a2daa6-1f3d-32df-9d34-6d0872ba10b1",
                                        "glosses": [
                                            "Destrucción o daño localizado del tejido óseo y otros tejidos duros."
                                        ],
                                        "tags": [
                                            "Enfermedades"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2c7697aa-8a4a-4946-83c2-a7f17729dc5e",
                                                "sense_id": "0859cad3-d6f5-3628-b380-30e8c6166509",
                                                "text": "«Ya la lepra ulcerosa, que se ceba en la epidermis y en la carne, llegando con sus caries hasta la médula de los huesos, haciendo del cuerpo vivo conjunto de viscosa fetidez, despojo informe, roído por otras partes, como están los cadáveres en el osario, animado sólo de un espíritu para sufrir»."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
