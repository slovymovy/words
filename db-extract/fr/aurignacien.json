                        "entry_id": "fd7fad93-074d-3012-ba6e-c9b4441b631b",
                        "glosses": [
                            "Rare graphie de la période préhistorique de l’Aurignacien."
                        ],
                        "tags": [
                            "Préhistoire"
                        ],
                        "examples": [
                            {
                                "example_id": "28501bfd-7c8f-4d4a-83dd-f3eb3d69c48d",
                                "sense_id": "0e7c213f-9445-3144-9ed2-1eda03c042d7",
                                "text": "Le paléolithique supérieur débute avec l’aurignacien (industrie d’Aurignac, Haute-Garonne), se continue par le solutréen (industrie de Solutré, Saône-et-Loire}, et s’achève par le Magdalénien (industrie de la Madeleine, Dordogne)."
                            }
                        ]
                    }
