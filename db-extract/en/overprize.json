                "senses": [
                    {
                        "sense_id": "3792b03d-312e-3b35-9615-f81b698b82d3",
                        "entry_id": "06229300-7661-3502-aa92-2172cdbb85fc",
                        "glosses": [
                            "To prize excessively; to overvalue."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "2365beea-8c1b-455e-b177-3e29dd1ccf9e",
                                "sense_id": "3792b03d-312e-3b35-9615-f81b698b82d3",
                                "text": "[…] a very pardonable facility in the Parents themselves to overprize their own Children, while thy behold them through the vapors of affection which alter the appearance […]"
                            },
                            {
                                "example_id": "eeea6169-39d5-4f47-8447-566871a0c77c",
                                "sense_id": "3792b03d-312e-3b35-9615-f81b698b82d3",
                                "text": "1777, Granville Sharp, A Tract on the Law of Nature, and Principles of Action in Man, London: B. White and E. & C. Dilly, p. 120, note 42,\nA Man apt to over-prize himself, and jealous withal of contempt, of wrong, or of gross abuse, is not so easily appeased with streams of blood, as a calm and gentle spirit is with an ingenuous acknowledgment of wrongs done, or with a courteous answer for wrongs suspected."
                            },
                            {
                                "example_id": "36bc9f45-f86f-4f48-9959-fe4bd9e300b3",
                                "sense_id": "3792b03d-312e-3b35-9615-f81b698b82d3",
                                "text": "[Mr. Balfe] has the gift—now rare, in late days—of melody, and a certain facile humour for the stage, which can hardly be over-prized."
                            },
                            {
                                "example_id": "ac0aac35-7a10-44ca-b3c4-6d452b4e667c",
                                "sense_id": "3792b03d-312e-3b35-9615-f81b698b82d3",
                                "text": "1983, John Gardner (American writer), On Becoming a Novelist, Open Road Media, 2010, Part II,\nAnother reason workshops become “workshoppy” is that often teachers slide unconsciously into overprizing the kind of narrative writing that teaches well, undervaluing and even dismissing work that does not."
                            }
                        ]
                    }
