                    {
                        "sense_id": "bb014a75-2a66-36a5-b522-118c32d7df10",
                        "entry_id": "e2e49c51-072c-3cd3-a783-e043ce47ee6d",
                        "glosses": [
                            "To speak or write using jargon."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "10504c28-4a84-4620-9724-3889e9adf75e",
                                "sense_id": "bb014a75-2a66-36a5-b522-118c32d7df10",
                                "text": "He provokes, inspires, pontificates and jargonizes unto \"hegemony\" and \"archaic parental imagos.\""
                            },
                            {
                                "example_id": "de08e579-e424-40a6-b9b6-aacfd60693e3",
                                "sense_id": "bb014a75-2a66-36a5-b522-118c32d7df10",
                                "text": "[C]ontemporary BBC executives are far too busy jargonising to each other about delivery platforms and multichoice environments."
                            }
                        ]
                    },
                    {
                        "sense_id": "f0a8e7ab-19b5-3c71-8767-28d8dcb095cc",
                        "entry_id": "e2e49c51-072c-3cd3-a783-e043ce47ee6d",
                        "glosses": [
                            "To convert into jargon; to express using jargon."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "3bfd9dc1-c66f-4322-a50e-dadd219eb0b4",
                                "sense_id": "f0a8e7ab-19b5-3c71-8767-28d8dcb095cc",
                                "text": "But the committeemen were not to be diverted by the long-winded, jargonized explanations of the Nielsen modus operandi."
                            },
                            {
                                "example_id": "295adb81-bd6b-44d7-a934-c08552e446c7",
                                "sense_id": "f0a8e7ab-19b5-3c71-8767-28d8dcb095cc",
                                "text": "You can jargonize many words by adding \"ize\" to the end of them."
                            }
                        ]
                    }
