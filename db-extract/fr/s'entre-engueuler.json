                "senses": [
                    {
                        "sense_id": "d9514366-1268-3b59-9a19-bc10174d5391",
                        "entry_id": "23e75851-3e0c-3b3d-83c8-39e8e69ac2aa",
                        "glosses": [
                            "S’engueuler mutuellement."
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "be69eb49-287a-42fd-be35-be783d0e243d",
                                "sense_id": "d9514366-1268-3b59-9a19-bc10174d5391",
                                "text": "Deux bonshommes, dans un doris, pendant dix-huit jours, ça ne fait que s’entre-engueuler…"
                            },
                            {
                                "example_id": "6a57ae46-2b94-45f8-a43f-41c748cf5f87",
                                "sense_id": "d9514366-1268-3b59-9a19-bc10174d5391",
                                "text": "Mais qu'on aille pas jusqu'à s'entre-engueuler, ah non, car si c'est le cas, moi, je me battrai !"
                            },
                            {
                                "example_id": "9333525b-ac9b-4e59-a831-6d80266c58d7",
                                "sense_id": "d9514366-1268-3b59-9a19-bc10174d5391",
                                "text": "La deuxième espèce est celle des croque-crocos, toujours prêts à s'entre-engueuler, au sens le plus propre du verbe."
                            }
                        ]
                    }
                ],
