                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f03d40b5-898a-4f6d-a8c8-ad039fe6e297",
                                "sense_id": "b675cfd9-6edf-3782-ad53-9435405ec460",
                                "text": "Założycielem alkantarynów był franciszkański mistyk i asceta św. Piotr z Alkantary."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "70b6da58-da56-3ae1-ba6f-c5accd0031f5",
                        "entry_id": "d4d3b888-01e0-3d3f-b246-45eb26dbb137",
