                "translations": [
                    {
                        "translation_id": "b948031b-4731-4f64-bcea-0c140babafea",
                        "source_entry_id": "2599b7a1-4057-3808-ab41-41a6ced5ac38",
                        "source_sense_id": "3ecb3cca-0e06-3a44-93f6-dcc56a4d893b",
