                },
                {
                    "sense_id": "a272edd1-c2d9-3c9c-adc9-3a89f3e69579",
                    "sense_definition": "Passer très près d'une surface ou d'un obstacle en l'effleurant presque.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mouvement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les hirondelles volent à vive allure et viennent <w>raser</w> la surface tranquille du lac."
                        },
                        {
                            "text": "Dans ce virage serré, la voiture a failli <w>raser</w> le mur de la maison."
