{
    "word_family": [
        "mieć",
        "niemanie"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d0908458-fd9b-34b3-8a8f-a7975eae2f8b",
                    "sense_definition": "często posiadać coś lub doświadczać czegoś w pewnych odstępach czasu",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "posiadanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W dzieciństwie <w>miewał</w> częste bóle głowy.",
                            "target_lang_translations": {
                                "ru": "В детстве он <w>часто страдал от</w> головных болей."
                            }
                        },
                        {
                            "text": "Często <w>miewam</w> ciekawe sny po obejrzeniu dobrego filmu.",
                            "target_lang_translations": {
                                "ru": "Мне часто <w>снятся</w> интересные сны после просмотра хорошего фильма."
                            }
                        }
                    ],
                    "common_phrases": [
                        "miewać problemy",
                        "miewać sny"
                    ],
                    "target_lang_definitions": {
                        "ru": "часто обладать чем-либо или испытывать что-либо через определенные промежутки времени"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "время от времени иметь",
                                "target_lang_sense_clarification": "указывает на периодическое возникновение состояния или явления"
                            },
                            {
                                "target_lang_word": "часто сталкиваться с",
                                "target_lang_sense_clarification": "используется в контексте регулярного повторения ситуаций или проблем"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bef3ca08-0c26-388b-b8e8-27cc7bb545b6",
                    "sense_definition": "czuć się w określony sposób, przechodzić przez określony stan",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "samopoczucie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Jak się <w>miewasz</w> w nowym mieście?",
                            "target_lang_translations": {
                                "ru": "Как ты <w>поживаешь</w> в новом городе?"
                            }
                        },
                        {
                            "text": "Dziś <w>miewam</w> się znacznie lepiej niż wczoraj.",
                            "target_lang_translations": {
                                "ru": "Сегодня я <w>чувствую себя</w> значительно лучше, чем вчера."
                            }
                        }
                    ],
                    "synonyms": [
                        "czuć się"
                    ],
                    "common_phrases": [
                        "jak się miewasz"
                    ],
                    "target_lang_definitions": {
                        "ru": "чувствовать себя определенным образом, находиться в определенном состоянии"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чувствовать себя",
                                "target_lang_sense_clarification": "основной эквивалент для описания физического или эмоционального состояния"
                            },
                            {
                                "target_lang_word": "поживать",
                                "target_lang_sense_clarification": "используется в вопросах о самочувствии или делах, например: как поживаешь?"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}