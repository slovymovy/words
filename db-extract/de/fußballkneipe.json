                                "example_id": "69dad62b-e0fe-4ef2-8401-1f620757d44e",
                                "sense_id": "8f6393d0-bbbb-34c4-ab1d-54fedd09a8e1",
                                "text": "„Fußball und Bier heißt die Dauerveranstaltungsreihe bei Tante Käthe, der Fußballkneipe am Mauerpark in Prenzlauer Berg.“"
                            },
                            {
                                "example_id": "c58d7c3f-d233-4f39-8e80-3c953e03821b",
                                "sense_id": "8f6393d0-bbbb-34c4-ab1d-54fedd09a8e1",
                                "text": "„Die Kleine Fußballkneipe in Neukölln ist einer der Anlaufpunkte für Borussia-Dortmund-Fans in Berlin.“"
                            },
                            {
                                "example_id": "4b1a29e2-e9fc-4764-9983-6fafe51fd20c",
                                "sense_id": "8f6393d0-bbbb-34c4-ab1d-54fedd09a8e1",
                                "text": "„In der Fußballkneipe Stadion in der Schleißheimer Straße ist die Decke des Lokals fußballfeldgrün und das Licht schummrig.“"
                            }
                        ],
