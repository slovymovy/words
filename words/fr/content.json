                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il est trop <w>content</w> de lui et n'écoute jamais les conseils des autres."
                        },
                        {
                            "text": "Elle est très <w>contente</w> de sa petite personne et ne parle que d'elle-même."
                        }
                    ],
                    "common_phrases": [
