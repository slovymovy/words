                "senses": [
                    {
                        "sense_id": "4ebc8811-e6b9-3d6d-8820-4610415a72ef",
                        "entry_id": "e2354afe-e331-3e03-b656-93baca6a5b4c",
                        "glosses": [
                            "Faire un bœuf."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62b73ea0-02e7-4996-a9a5-e81f9c657b2f",
                                "sense_id": "4ebc8811-e6b9-3d6d-8820-4610415a72ef",
                                "text": "Dedans, Pirate et ses Capitaines, le groupe de Michel, des presque trentenaires qui n'ont pas lâché le rock, bœuffent avec Bâtiment C, les mêmes avec dix ans de moins."
                            },
                            {
                                "example_id": "88c5987c-247a-4795-afe9-e31074c284b3",
                                "sense_id": "4ebc8811-e6b9-3d6d-8820-4610415a72ef",
                                "text": "Le bistrot Neil a réussi à rameuter quelques zicos pour ma venue, délicate attention en souvenir des années passées à bœuffer et composer ensemble."
                            },
                            {
                                "example_id": "7a3d934b-47ec-4fb0-a260-f78723b0b328",
                                "sense_id": "4ebc8811-e6b9-3d6d-8820-4610415a72ef",
                                "text": "Ensuite Louis et Corine bœuffent avec Ronnie, il y a Bill Wyman, Charlie et Paul Rodgers. Ils font une jam qui restera un souvenir d'anthologie. Ils jouent « Johnny B. Goode » façon reggae – comme Keith aurait pu faire, […]."
                            },
                            {
                                "example_id": "ca0263b9-6567-4a91-8be0-8029cc3300eb",
                                "sense_id": "4ebc8811-e6b9-3d6d-8820-4610415a72ef",
                                "text": "Ils interpréterons quelques compositions de leur cru avant de vous inviter à bœuffer sur des standards de jazz !"
                            }
                        ]
                    }
                ],
