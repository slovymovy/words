                    "semantic_group_id": "sports_offside",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The referee blew the whistle and called an <w>offside</w> against the attacking team."
                        },
                        {
                            "text": "The striker was caught in an <w>offside</w> position, so the goal did not count."
                        }
