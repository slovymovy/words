                                                "sense_id": "a9576b85-b318-3ec2-b28e-e21ca08b40d6",
                                                "text": "An der Erhöhung dort vorne können wir eine Pause einlegen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "e74831a6-81b1-38eb-8040-63ae2851f7fd",
                                        "entry_id": "563acd5b-4e51-3230-aadf-b7ee939bac32",
                                        "glosses": [
