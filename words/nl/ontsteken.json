                    "synonyms": [
                        "aansteken",
                        "aanzetten"
                    ],
                    "antonyms": [
                        "doven",
                        "uitdoen"
                    ],
                    "common_phrases": [
                        "kaarsen ontsteken",
                        "het licht ontsteken"
                    ],
                    "target_lang_definitions": {
