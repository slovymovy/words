{
    "word_family": [
        "delà",
        "voilà"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "d836499f-b7a9-3c3c-98c4-0ccfc92a6e65",
                    "sense_definition": "En cet endroit, désigne un lieu plus ou moins éloigné de la personne qui parle.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "lieu",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pose ton sac <w>là</w> sur la table près de la fenêtre."
                        },
                        {
                            "text": "Regarde cette maison au bout de la rue, j'ai habité <w>là</w> pendant dix ans."
                        }
                    ],
                    "antonyms": [
                        "ici"
                    ],
                    "common_phrases": [
                        "par là",
                        "juste là",
                        "par-ci par-là"
                    ]
                },
                {
                    "sense_id": "c4ace3be-95a5-32e7-bb0c-936727e4b02f",
                    "sense_definition": "Ici, à l'endroit où l'on se trouve actuellement.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "lieu",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Viens <w>là</w> immédiatement et écoute ce que j'ai à te dire."
                        },
                        {
                            "text": "Il fait bien trop chaud <w>là</w> pour continuer à travailler dehors."
                        }
                    ],
                    "synonyms": [
                        "ici"
                    ],
                    "common_phrases": [
                        "viens là"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "souvent employé à l'oral à la place de ici"
                        }
                    ]
                },
                {
                    "sense_id": "ca629b11-4243-3624-bca1-af335cde9ddb",
                    "sense_definition": "Présent, disponible ou existant à un endroit donné.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "presence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je serai bien <w>là</w> demain matin à l'ouverture du magasin."
                        },
                        {
                            "text": "Son médecin n'est pas <w>là</w> aujourd'hui, vous devriez rappeler demain."
                        }
                    ],
                    "common_phrases": [
                        "être là",
                        "toujours là",
                        "ne pas être là"
                    ]
                },
                {
                    "sense_id": "63404232-7821-3684-8faf-ec1071f7e894",
                    "sense_definition": "À ce moment précis, dans le temps.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "temps",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "C'est <w>là</w> que tout a basculé au cours de la réunion."
                        },
                        {
                            "text": "D'ici <w>là</w>, essayez de vous reposer le plus possible chez vous."
                        }
                    ],
                    "common_phrases": [
                        "d'ici là",
                        "c'est là que"
                    ]
                },
                {
                    "sense_id": "bff2db37-ed41-306d-abbe-fd9cdec36def",
                    "sense_definition": "À ce point, à ce stade d'une action ou d'une situation.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "degre",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous en resterons <w>là</w> pour aujourd'hui et reprendrons la suite plus tard."
                        },
                        {
                            "text": "Comment avons-nous pu en arriver <w>là</w> après tant d'efforts communs ?"
                        }
                    ],
                    "common_phrases": [
                        "en rester là",
                        "en arriver là"
                    ]
                },
                {
                    "sense_id": "56e58ba1-c33c-303b-9074-b63e92bc8801",
                    "sense_definition": "Sert à insister ou à donner du relief à ce que l'on dit.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "emphase",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Vous avez fait <w>là</w> une proposition tout à fait remarquable pour l'entreprise."
                        },
                        {
                            "text": "Que dites-vous <w>là</w>, pensez-vous vraiment que c'est une sage décision ?"
                        }
                    ],
                    "common_phrases": [
                        "que dites-vous là"
                    ]
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "9e9f3124-cc71-3974-93c0-5ba1bdb847ed",
                    "sense_definition": "S'emploie pour apaiser, réconforter ou intimer l'ordre de se calmer.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Là</w>, <w>là</w>, ne pleure plus, tout va s'arranger très bientôt."
                        },
                        {
                            "text": "<w>Là</w>, calmez-vous un instant et expliquez-moi la situation calmement."
                        }
                    ],
                    "common_phrases": [
                        "là là"
                    ]
                }
            ]
        }
    ]
}