                "senses": [
                    {
                        "sense_id": "60a02e7d-b9e0-3152-8b5c-4998abb24bbf",
                        "entry_id": "07f62e50-a62c-38f7-8f11-0d1733f1a652",
                        "glosses": [
                            "Gemeinschaft aller, die sich zu einer bestimmten Religion bekennen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c5f7158-3dd5-458e-8a59-ccf8ff3bc5fd",
                                "sense_id": "60a02e7d-b9e0-3152-8b5c-4998abb24bbf",
                                "text": "„In all diesen Religionsgemeinschaften kommt es immer wieder zu Ehrenmorden, auch unter Christen.“"
                            },
                            {
                                "example_id": "bc3e1c0e-87c3-4c39-b162-c7561ddaed10",
                                "sense_id": "60a02e7d-b9e0-3152-8b5c-4998abb24bbf",
                                "text": "„Der Schulbesuch wurde abgebrochen, die deutsche Staatsangehörigkeit aufgegeben, die Verbindung zur israelischen Religionsgemeinschaft gelöst.“"
                            },
                            {
                                "example_id": "4de4e035-cf7d-4e6d-bc4f-c3e3a07283b0",
                                "sense_id": "60a02e7d-b9e0-3152-8b5c-4998abb24bbf",
                                "text": "„Und je mehr Kirchen, je mehr Religionsgemeinschaften, je mehr widersprechende Meinungen es gibt, desto lebendiger wird diese Wertediskussion.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
