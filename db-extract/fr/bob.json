                ],
                "senses": [
                    {
                        "sense_id": "5c86c557-c916-31d5-aa0e-baeb8b8d21bd",
                        "entry_id": "bfa186af-9ce3-3730-81a6-bd674b89c732",
                        "glosses": [
                            "Dé à jouer."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "0218f3ea-071c-466c-b616-57027f958e3f",
                                "sense_id": "5c86c557-c916-31d5-aa0e-baeb8b8d21bd",
                                "text": "Dès qu'on se mêle de peloter une brême ou un bob, on est sûr d’en prendre plein la liquette."
                            },
                            {
                                "example_id": "90889978-0243-4a90-8665-8f30948efa50",
                                "sense_id": "5c86c557-c916-31d5-aa0e-baeb8b8d21bd",
                                "text": "Les bobs étaient jetés et la belligérance déclarée."
                            }
                        ]
                    }
                ],
