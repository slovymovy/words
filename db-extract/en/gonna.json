                    {
                        "sense_id": "bf80f15f-125e-39d2-b5ee-27b6fc42d993",
                        "entry_id": "73815a6d-9cef-3247-9df7-bca51a811318",
                        "glosses": [
                            "a modal used to express a future action that is being planned or prepared for in the present."
                        ],
                        "tags": [
                            "auxiliary",
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "35be6fa3-94e5-444e-9474-c040c5394176",
                                "sense_id": "bf80f15f-125e-39d2-b5ee-27b6fc42d993",
                                "text": "I'm gonna hafta find a new job soon."
                            },
                            {
                                "example_id": "d9e3c97b-55ec-4496-aa34-5f914358c031",
                                "sense_id": "bf80f15f-125e-39d2-b5ee-27b6fc42d993",
                                "text": "Well, you ain't got much longer to laugh. I'm coming, and I'm gonna put one in your dirty hide for every lying crack that you made about me, see?"
                            },
                            {
                                "example_id": "db1632da-cd6f-4566-b0c4-6c7c83dd9abd",
                                "sense_id": "bf80f15f-125e-39d2-b5ee-27b6fc42d993",
                                "text": "Never gonna give you up, / Never gonna let you down, / Never gonna run around and desert you. / Never gonna make you cry, / Never gonna say goodbye, / Never gonna tell a lie and hurt you."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
