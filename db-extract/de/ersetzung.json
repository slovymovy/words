                "senses": [
                    {
                        "sense_id": "7282ef94-a5f7-3fa4-8145-7e091f281ebc",
                        "entry_id": "7eebd3e1-14d6-3af9-9c45-fc23527f58f7",
                        "glosses": [
                            "Austausch von etwas; das, was an die Stelle von etwas Entferntem tritt"
                        ],
                        "tags": [
                            "oder auch seltener"
                        ],
                        "examples": [
                            {
                                "example_id": "6ec1f542-3109-49ba-9c5a-b070ccfef1ae",
                                "sense_id": "7282ef94-a5f7-3fa4-8145-7e091f281ebc",
                                "text": "Meist ist eine Ersetzung von Mutterboden durch Granulat völlig problemlos."
                            },
                            {
                                "example_id": "08d450fe-f8bc-45f2-8124-89dae34141d4",
                                "sense_id": "7282ef94-a5f7-3fa4-8145-7e091f281ebc",
                                "text": "Die Ersetzung von Genehmigungsverfahren durch Anzeigeverfahren im Bausektor hat zu Vereinfachungen und damit Zeitersparnissen beigetragen."
                            },
                            {
                                "example_id": "5ac34399-f22a-4dee-b14a-0315e7bbef47",
                                "sense_id": "7282ef94-a5f7-3fa4-8145-7e091f281ebc",
                                "text": "Keine der Ersetzungen hat bisher meine volle Zustimung gefunden. Jede hat so ihre Nachteile."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "49e63777-a0ec-4c30-8341-c429dabff0a1",
                        "source_entry_id": "7eebd3e1-14d6-3af9-9c45-fc23527f58f7",
                        "source_sense_id": "7282ef94-a5f7-3fa4-8145-7e091f281ebc",
                        "source_sense_description": "Austausch von etwas; oder auch seltener: das, was an die Stelle von etwas Entferntem tritt",
                        "target_lang_word": "remplacement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "remplacement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "387d6719-d1ba-3c5e-8fa1-bc13f9c247d1",
                                        "entry_id": "2de527b7-799f-3b1f-ab83-1f93b41b0b92",
                                        "glosses": [
                                            "Action de remplacer une chose par une autre ou résultat de cette action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24856779-4b07-4cca-9b16-5914c288b986",
                                                "sense_id": "387d6719-d1ba-3c5e-8fa1-bc13f9c247d1",
                                                "text": "Les arrêts sont en effet plus fréquents au renvideur par suite des réparations, remplacements de cordes et de câbles et nettoyages plus difficultueux."
                                            },
                                            {
                                                "example_id": "5b2e311c-eb1c-4115-8132-aab4b3049fd3",
                                                "sense_id": "387d6719-d1ba-3c5e-8fa1-bc13f9c247d1",
                                                "text": "L'utilisation des additions minérales dans les bétons en remplacement au ciment est une pratique courante depuis de nombreuses années."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "04fd1e67-0a1d-3eca-aebd-4621bba9d025",
                                        "entry_id": "2de527b7-799f-3b1f-ab83-1f93b41b0b92",
                                        "glosses": [
                                            "Action de remplacer une personne par une autre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b9b40bb-2f64-4c31-960d-8476c88e17b8",
                                                "sense_id": "04fd1e67-0a1d-3eca-aebd-4621bba9d025",
                                                "text": "Le concept de remplacement des gens que l'on fréquente et qui nous sont proches par des humanoïdes est évidemment puissant et traumatisant car il suscite le doute et la paranoïa aiguë."
                                            },
                                            {
                                                "example_id": "85cf2b9e-08ad-4b79-8e64-2272aaef7464",
                                                "sense_id": "04fd1e67-0a1d-3eca-aebd-4621bba9d025",
                                                "text": "Pourvoir au remplacement d’un juge, d’un employé, d’un commis. — Le remplacement d’un titulaire par un remplaçant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c84834b3-0c78-3fbf-b874-64bf1eeb2860",
                                        "entry_id": "2de527b7-799f-3b1f-ab83-1f93b41b0b92",
                                        "glosses": [
                                            "Substitution d'un conscrit par un volontaire moyennant rétribution."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "672f3db6-fbfe-4293-80db-17abce18fb85",
                                                "sense_id": "c84834b3-0c78-3fbf-b874-64bf1eeb2860",
                                                "text": "Le remplacement a été aboli en France par la loi Berteaux du 21 mars 1905 instaurant le service militaire universel ."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b58239da-a19f-43df-ad42-1fe1105266ec",
                        "source_entry_id": "7eebd3e1-14d6-3af9-9c45-fc23527f58f7",
                        "source_sense_id": "7282ef94-a5f7-3fa4-8145-7e091f281ebc",
                        "source_sense_description": "Austausch von etwas; oder auch seltener: das, was an die Stelle von etwas Entferntem tritt",
                        "target_lang_word": "réparation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "réparation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9cb1e089-bfbb-3195-b77c-05cdd2fdd010",
                                        "entry_id": "7c0c4a9b-4ead-3206-949b-d0c3c9b74e3a",
                                        "glosses": [
                                            "Action de réparer ou résultat de cette action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bbe3c3a2-3b2f-4113-911c-274f26eb0a5e",
                                                "sense_id": "9cb1e089-bfbb-3195-b77c-05cdd2fdd010",
                                                "text": "Les arrêts sont en effet plus fréquents au renvideur par suite des réparations, remplacements de cordes et de câbles et nettoyages plus difficultueux."
                                            },
                                            {
                                                "example_id": "0b8609af-6ff7-4154-87eb-117cc6f10074",
                                                "sense_id": "9cb1e089-bfbb-3195-b77c-05cdd2fdd010",
                                                "text": "Sur l’établi du charpentier, un pied de chaise en réparation gisait à côté du ciseau qui ne l’avait qu’entamé […]"
                                            },
                                            {
                                                "example_id": "29877759-8ec8-4aac-a329-7e8f03bbb26d",
                                                "sense_id": "9cb1e089-bfbb-3195-b77c-05cdd2fdd010",
                                                "text": "Au jour, j’inspecte minutieusement les avaries et consolide les réparations provisoires de la nuit."
                                            },
                                            {
                                                "example_id": "2a5d13b4-5cec-4564-b42c-a21b73ae93ad",
                                                "sense_id": "9cb1e089-bfbb-3195-b77c-05cdd2fdd010",
                                                "text": "La performance du réparateur d’électroménager n'en est une qu’au regard du temps qu'il passe pour effectuer sa réparation."
                                            },
                                            {
                                                "example_id": "061a0b5e-e36c-4296-9d30-de8edad1f7a1",
                                                "sense_id": "9cb1e089-bfbb-3195-b77c-05cdd2fdd010",
                                                "text": "Ici aussi, on vivait de la récup, de la réparation d’appareils usagés, de la vente de métaux. Des coups de marteau s'élevaient derrière des palissades formées de frigos ou de congélateurs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0ae24601-9370-3ed5-a900-0475aa227493",
                                        "entry_id": "7c0c4a9b-4ead-3206-949b-d0c3c9b74e3a",
                                        "glosses": [
                                            "Travaux d’entretien et de maintenance que l’on fait aux bâtisses."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9b871b60-c883-46a0-937a-961b4d300807",
                                                "sense_id": "0ae24601-9370-3ed5-a900-0475aa227493",
                                                "text": "Les habitants de Bessancourt demandent qu'ils ne soient plus chargés de payer la reconstruction et les grosses réparations de l'église, du presbytère, du vicariat et des maisons du maître et de la maîtresse d'école, […]."
                                            },
                                            {
                                                "example_id": "732c16e6-074d-451b-b015-d2589cbc3ede",
                                                "sense_id": "0ae24601-9370-3ed5-a900-0475aa227493",
                                                "text": "La commune d’Épineau-les-Voves, sur le territoire de laquelle sont bâties deux églises, demande que les matériaux de celle que le district de Joigny vient de mettre en vente au profit de la Nation soient employés aux réparations de l’autre […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fa3db1ea-4acf-3868-a622-6972082876df",
                                        "entry_id": "7c0c4a9b-4ead-3206-949b-d0c3c9b74e3a",
                                        "glosses": [
                                            "Correction d’une défectuosité d’un produit, mais sans garantir la conformité avec les spécifications (contrairement à la reprise)."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "53bb856c-e30c-4644-ada6-d4eb6de2aad6",
                                                "sense_id": "fa3db1ea-4acf-3868-a622-6972082876df",
                                                "text": "Si un circuit ne satisfait pas aux tests à 100%, il devra être écarté du lot et la fiche de suivi des tests mise à jour (numéro de la carte défectueuse, raison du rejet). Aucune réparation de PCB n’est autorisée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1f9d035b-996b-3768-b176-d4060bda2336",
                                        "entry_id": "7c0c4a9b-4ead-3206-949b-d0c3c9b74e3a",
                                        "glosses": [
                                            "Exercice collectif d'entretien de la mémoire de ce que l'on a appris."
                                        ],
                                        "tags": [
                                            "analogy",
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c982546e-0eb0-44a7-bcff-c664081ae0d0",
                                                "sense_id": "1f9d035b-996b-3768-b176-d4060bda2336",
                                                "text": "Les exercices pour apprendre étaient la réparation et la dispute. Par la réparation les écoliers se recordaient mutuellement l'objet de la leçon exposée , jusqu'à ce qu'ils fussent en état de la répéter tous à peu près dans les mêmes termes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ed31048b-8aae-33a2-ab2a-9ddbe44a3d63",
                                        "entry_id": "7c0c4a9b-4ead-3206-949b-d0c3c9b74e3a",
                                        "glosses": [
                                            "Acte de corriger ce qui a été dit."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6e62e49c-78bd-3de0-b009-8752041eec2b",
                                        "entry_id": "7c0c4a9b-4ead-3206-949b-d0c3c9b74e3a",
                                        "glosses": [
                                            "Compensation ou dédommagement pour un préjudice, une injure ou une offense faite à quelqu’un."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a601431-a80e-48fe-8877-23362b793996",
                                                "sense_id": "6e62e49c-78bd-3de0-b009-8752041eec2b",
                                                "text": "Réparation d’honneur."
                                            },
                                            {
                                                "example_id": "6dbccf48-1975-4434-8699-ba0bfb44297a",
                                                "sense_id": "6e62e49c-78bd-3de0-b009-8752041eec2b",
                                                "text": "Faire réparation à quelqu’un."
                                            },
                                            {
                                                "example_id": "fe8395ab-92c5-4f72-82f3-51c765bc9093",
                                                "sense_id": "6e62e49c-78bd-3de0-b009-8752041eec2b",
                                                "text": "Accepter, refuser la réparation."
                                            },
                                            {
                                                "example_id": "a2217edd-3ad4-4746-8ce9-07665d82ae26",
                                                "sense_id": "6e62e49c-78bd-3de0-b009-8752041eec2b",
                                                "text": "Réparation par les armes."
                                            },
                                            {
                                                "example_id": "d59d9f46-4ffc-451d-8f69-216fb456c9e9",
                                                "sense_id": "6e62e49c-78bd-3de0-b009-8752041eec2b",
                                                "text": "Elle pleura longtemps. Ces larmes étaient comme une réparation d’honneur qu’elle se faisait à elle-même."
                                            },
                                            {
                                                "example_id": "e528fa9e-af44-4746-aaae-3341798962c3",
                                                "sense_id": "6e62e49c-78bd-3de0-b009-8752041eec2b",
                                                "text": "Manicamp. – Sais-tu qu’il serait en droit de me demander une réparation ?… nous pourrions croiser le fer."
                                            },
                                            {
                                                "example_id": "63f77810-c3d2-4757-a939-c750d84b050e",
                                                "sense_id": "6e62e49c-78bd-3de0-b009-8752041eec2b",
                                                "text": "En cas de cessation de ses relations avec le mandant, l’agent commercial a droit à une indemnité compensatrice en réparation du préjudice subi."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ec996ad8-a7c3-3aa9-a196-470fc8864086",
                                        "entry_id": "7c0c4a9b-4ead-3206-949b-d0c3c9b74e3a",
                                        "glosses": [
                                            "Sommes adjugées par un tribunal pour un dédommagement"
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5d798647-9bae-3590-9088-98b95c2c9ed1",
                                        "entry_id": "7c0c4a9b-4ead-3206-949b-d0c3c9b74e3a",
                                        "glosses": [
                                            "Remboursement des dommages de guerre, après la Première Guerre mondiale."
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "57193ea1-aa23-46df-a842-d897cbd6a8bf",
                                                "sense_id": "5d798647-9bae-3590-9088-98b95c2c9ed1",
                                                "text": "La question des réparations."
                                            },
                                            {
                                                "example_id": "9b8423cb-e0fc-4751-be25-1b1c8351e9e8",
                                                "sense_id": "5d798647-9bae-3590-9088-98b95c2c9ed1",
                                                "text": "La Commission des réparations."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "713391f8-0083-43b1-a47b-dbe7c0ea4b56",
                        "source_entry_id": "7eebd3e1-14d6-3af9-9c45-fc23527f58f7",
                        "source_sense_id": "7282ef94-a5f7-3fa4-8145-7e091f281ebc",
                        "source_sense_description": "Austausch von etwas; oder auch seltener: das, was an die Stelle von etwas Entferntem tritt",
                        "target_lang_word": "compensation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "compensation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "20c3a8db-4d61-3cef-9edf-1cae3bd84e95",
                                        "entry_id": "44d3a4aa-68c9-38b9-82b0-3746155da170",
                                        "glosses": [
                                            "Action d'établir un équilibre entre deux choses complémentaires ou antagonistes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "642bfd1d-85d3-4a6e-bc1c-2d3f597cfcc5",
                                                "sense_id": "20c3a8db-4d61-3cef-9edf-1cae3bd84e95",
                                                "text": "Par un savant jeu d’avances et de compensations, ils laissaient successivement croire aux fervents des deux partis qu’ils étaient leurs hommes pourvu toutefois que le confident eût provoqué cet aveu par l’offre de deux ou trois bouteilles de picolo de l’année […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5304ebc6-19c5-3339-b7cb-762655e74027",
                                        "entry_id": "44d3a4aa-68c9-38b9-82b0-3746155da170",
                                        "glosses": [
                                            "Dédommagement d’un mal par un bien, d’une perte par un profit, d’un inconvénient par un avantage, d’une valeur moindre par un supplément."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ef9dfca-31d0-4714-855d-50ba24d386be",
                                                "sense_id": "5304ebc6-19c5-3339-b7cb-762655e74027",
                                                "text": "Le brave homme se fit payer deux ducats, mais en compensation il m'enveloppa de sa grosse houppelande, et me chanta deux ou trois chansons mecklembourgeoises qui me parurent assez jolies."
                                            },
                                            {
                                                "example_id": "cff13d8e-0771-4e41-9619-0eac2c0ada92",
                                                "sense_id": "5304ebc6-19c5-3339-b7cb-762655e74027",
                                                "text": "Mais le temps n’est pas à philosopher ; il nous faut éclairer le lecteur, que l’on gruge assez souvent pour lui fournir, en compensation, un conseil utile ; quel prix devez-vous mettre à votre parlementaire ?"
                                            },
                                            {
                                                "example_id": "ed319940-e57e-487c-b1b0-a6fe926bf23d",
                                                "sense_id": "5304ebc6-19c5-3339-b7cb-762655e74027",
                                                "text": "En compensation de leur temps donné, ces indispensables personnes reçoivent un t-shirt et une casquette souvenir et sont bien entendu nourries."
                                            },
                                            {
                                                "example_id": "2212ec76-a30b-4ff2-b63f-6b165e050284",
                                                "sense_id": "5304ebc6-19c5-3339-b7cb-762655e74027",
                                                "text": "Cela doit entrer en compensation de la perte qu’il a faite."
                                            },
                                            {
                                                "example_id": "b20fd2ff-cb47-496d-98b9-fe8ab9d02adf",
                                                "sense_id": "5304ebc6-19c5-3339-b7cb-762655e74027",
                                                "text": "Il n’y a pas lieu à compensation."
                                            },
                                            {
                                                "example_id": "21188e6c-428f-4d14-b5f7-0f21142b121e",
                                                "sense_id": "5304ebc6-19c5-3339-b7cb-762655e74027",
                                                "text": "Il lui céda cela en compensation."
                                            },
                                            {
                                                "example_id": "63b472a5-ab1f-4dce-ae6a-e9ac59e75872",
                                                "sense_id": "5304ebc6-19c5-3339-b7cb-762655e74027",
                                                "text": "Caisse de compensation, organisme d’assurance, sous forme de mutuelle entre les employeurs, destiné à supprimer tout risque d’inégalité dans les charges de famille de leurs employés."
                                            },
                                            {
                                                "example_id": "b6beed3c-1428-40a7-9db8-68c60fd0e3ef",
                                                "sense_id": "5304ebc6-19c5-3339-b7cb-762655e74027",
                                                "text": "Système des compensations, système qui prétend qu’il y a compensation de bien et de mal dans toutes les conditions de la vie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8b045a66-f11b-3a7f-a3a0-2ac59179bf20",
                                        "entry_id": "44d3a4aa-68c9-38b9-82b0-3746155da170",
                                        "glosses": [
                                            "Libération réciproque entre deux personnes qui se trouvent être à la fois créancières et débitrices l’une de l’autre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7a2ed7f-acd5-4a0d-84a8-781b900d17d5",
                                                "sense_id": "8b045a66-f11b-3a7f-a3a0-2ac59179bf20",
                                                "text": "La compensation s’opère de plein droit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "21384c22-11eb-3786-8fb8-f0b8d9a2fb7b",
                                        "entry_id": "44d3a4aa-68c9-38b9-82b0-3746155da170",
                                        "glosses": [
                                            "Mécanisme consistant à faire le bilan des positions (ordres d'achats et de ventes) pour en établir le solde net. Cela permet de limiter les échanges entre les établissements bancaires."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "41523f27-79d9-3415-a1d2-48c777d35142",
                                        "entry_id": "44d3a4aa-68c9-38b9-82b0-3746155da170",
                                        "glosses": [
                                            "Opération par laquelle celui qui a acheté et revendu une valeur à terme se substitue, au terme fixé, à celui à qui il a vendu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f84ed5f6-fe65-4afc-803b-ae4ff3a296f4",
                                                "sense_id": "41523f27-79d9-3415-a1d2-48c777d35142",
                                                "text": "Cours de compensation, prix fixé, selon les cours, pour la liquidation périodique des marchés à terme sur les valeurs cotées à la Bourse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c4a852d4-1d7b-385d-b358-fcab7f414b5a",
                                        "entry_id": "44d3a4aa-68c9-38b9-82b0-3746155da170",
                                        "glosses": [
                                            "Correction de l'effet des réactions aérodynamiques sur les gouvernes d'un avion en vue de réduire les efforts sur les commandes de vol généralement obtenue à l'aide de surfaces auxiliaires appelées « compensateurs »."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ef0e4aff-a1c9-336c-95b5-21bea59d0bdf",
                                        "entry_id": "44d3a4aa-68c9-38b9-82b0-3746155da170",
                                        "glosses": [
                                            "Réaction de l'organisme qui compense les effets d'une maladie pour maintenir l’équilibre physiologique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e255caca-9e17-4028-976d-943bb2353609",
                                                "sense_id": "ef0e4aff-a1c9-336c-95b5-21bea59d0bdf",
                                                "text": "Les stress psychoémotionnels sont également à prendre en compte ; car, lorsqu’ils entraînent un état de frustration, une compensation de type alimentaire peut survenir."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
