                        "glosses": [
                            "van een motor dat deze door te draaien de goede temperatuur krijgt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c7aa982-f4e7-42eb-8989-b5fab96b08ed",
                                "sense_id": "103db6c2-ba8e-3f25-afa2-f055bad043cf",
                                "text": "Het is inmiddels alweer ruim een halfjaar geleden dat de BMW M2 CS voor het eerst warmdraaide op de bekende Nordschleife.de Telegraaf WOUTER SPANJAART"
                            }
                        ]
                    },
                    {
                        "sense_id": "0260a753-1e25-3972-a27a-f4ca7fdf7afa",
                        "entry_id": "b428214e-ee31-34d8-9cac-94f360c6cdaf",
                        "glosses": [
                            "dat je door werken je vaardigheid verhoogt"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "fd4be93a-acd6-4c71-9888-0185b300f012",
                                "sense_id": "0260a753-1e25-3972-a27a-f4ca7fdf7afa",
                                "text": "Oude inkoopteams van De Bijenkorf en V&D lopen nu rond bij Hudson's Bay dat zich warmdraait in een concurrentiestrijd met H&M, Zara en Primark. Het opent onder meer in Hoog Catherijne in Utrecht, Amstelveen en Almere."
                            },
                            {
                                "example_id": "84fdf29e-22c1-4e61-aae9-0895b1fc6d11",
                                "sense_id": "0260a753-1e25-3972-a27a-f4ca7fdf7afa",
                                "text": "Bogense mag komend seizoen al warmdraaien tijdens het wereldbekercircuit."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "57278b56-44a0-4bef-aaa3-725163de1cb5",
                        "source_entry_id": "b428214e-ee31-34d8-9cac-94f360c6cdaf",
