                                "target_senses": [
                                    {
                                        "sense_id": "9e38f827-2189-3e09-b873-465b29cfdcad",
                                        "entry_id": "ede2a3e1-3d82-3028-9faa-17c8e1d011ea",
                                        "glosses": [
                                            "Peintre de portraits."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa59f053-ecae-47d5-8680-3b9a78cad077",
                                                "sense_id": "9e38f827-2189-3e09-b873-465b29cfdcad",
                                                "text": "Un peintre est invariablement enfermé dans la catégorie des paysagistes, des portraitistes, des peintres d’histoire, de marine ou de genre."
                                            },
                                            {
                                                "example_id": "944e1540-48fa-4879-a2eb-3c17fa7675c5",
                                                "sense_id": "9e38f827-2189-3e09-b873-465b29cfdcad",
                                                "text": "Il a épousé en secondes noces la portraitiste française Micheline Roquebrue en 1975."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
