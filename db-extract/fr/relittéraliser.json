                "senses": [
                    {
                        "sense_id": "a1403756-2dc5-368f-9b80-b136fce3ba7b",
                        "entry_id": "f6dc4dcb-e62f-3591-bd83-aa759340effc",
                        "glosses": [
                            "Redonner un caractère littéral à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "318584a6-7c9b-426f-9cbd-d235f5120865",
                                "sense_id": "a1403756-2dc5-368f-9b80-b136fce3ba7b",
                                "text": "Le monde est à relittéraliser, plus de métaphores, car ce ne sont plus que des problèmes."
                            },
                            {
                                "example_id": "c190c0e2-0a01-43fb-abc7-c3f5481bf114",
                                "sense_id": "a1403756-2dc5-368f-9b80-b136fce3ba7b",
                                "text": "Si l’on compare Kahane et Couturier, Kahane semble délittéraliser l’original en l’explicitant, Couturier, à l’inverse, semble le relittéraliser en lui redonnant sa forme implicite."
                            }
                        ]
                    }
