                "senses": [
                    {
                        "sense_id": "0d254315-12aa-362d-a14e-a05dc8f46dd8",
                        "entry_id": "a1ab7d5d-6ed7-3bce-9dda-450790a226d1",
                        "glosses": [
                            "Tête."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "46042fa7-4bbc-4a82-bf26-6a8e3e1ce525",
                                "sense_id": "0d254315-12aa-362d-a14e-a05dc8f46dd8",
                                "text": "Il n’en est pas moins vrai que les sociétés rivales ne savent comment se débarrasser de ces encombrants cadavres, ni le moyen de les enjamber sans crever dessus, avant d’avoir eu le temps de se joindre et de se couper réciproquement cabèche."
                            },
                            {
                                "example_id": "d80cf2db-06ae-4881-b034-48c32c9f3f34",
                                "sense_id": "0d254315-12aa-362d-a14e-a05dc8f46dd8",
                                "text": "Il vaut bien mieux un coup de cabèche dans le stoumac. Alors, il se baisse, et toi tu relèves ton genou à la rencontre de son nez et ça éclate comme une figue."
                            },
                            {
                                "example_id": "c46bec6d-4e9a-47f2-b835-d20514ab794e",
                                "sense_id": "0d254315-12aa-362d-a14e-a05dc8f46dd8",
                                "text": "Que l’on zyeute le canon d'une carabine ou la crosse du moindre bulldog, et vous êtes fait. Coupé cabèche !"
                            },
                            {
                                "example_id": "7c828453-5844-4b3b-9d7e-7fe685d274ba",
                                "sense_id": "0d254315-12aa-362d-a14e-a05dc8f46dd8",
                                "text": "La tête peut être la bobine, la binette, le bourrichon, la cabèche, la cafetière, la calebasse, le ciboulot, la fiole, la trombine, etc."
                            },
                            {
                                "example_id": "51557045-c806-45fd-8748-4247fd063e51",
                                "sense_id": "0d254315-12aa-362d-a14e-a05dc8f46dd8",
                                "text": "En plus que je somme le putois ! damné faux-semblant défonceur ! Il se l'éclatera pas la cabèche !"
                            }
                        ]
                    },
                    {
                        "sense_id": "e7d5accd-08a7-3dd2-8f4f-033ef4d448b5",
                        "entry_id": "a1ab7d5d-6ed7-3bce-9dda-450790a226d1",
                        "glosses": [
                            "WC ; toilettes"
                        ],
                        "tags": [
                            "plural"
                        ],
                        "examples": [
                            {
                                "example_id": "e2d75845-184f-4e56-82d7-96690c0487be",
                                "sense_id": "e7d5accd-08a7-3dd2-8f4f-033ef4d448b5",
                                "text": "Et puis je dois garder le sac\nDe ma copine qui est aux « cabèches ».\nEt en plus toi tu marques mal !\nTu me laisse la figue sèche !"
                            }
                        ]
                    }
