                "senses": [
                    {
                        "sense_id": "4d4486f4-43c1-3f1e-8bd3-3e068f595c70",
                        "entry_id": "bebbefb4-307f-3d19-8e82-1f963506f760",
                        "glosses": [
                            "Frisur, bei der die Haare zu Zöpfen geflochten sind, welche zu einem Kranz aufgesteckt sind"
                        ],
                        "tags": [
                            "österreichisch,",
                            "bayrisch"
                        ],
                        "examples": [
                            {
                                "example_id": "2f38176a-b9b7-4f2c-b961-64fc33ac7ca0",
                                "sense_id": "4d4486f4-43c1-3f1e-8bd3-3e068f595c70",
                                "text": "„Natürlich hat dann auch Bernhard bei den ersten Literaturtagen gelesen, seine Zuhörer saßen noch in Pinzgauer Festtracht, mit Gretlfrisur und langem Seidendirndl in Reih und Glied.“"
                            },
                            {
                                "example_id": "fea6b02f-59a1-4584-aea7-163d9a382270",
                                "sense_id": "4d4486f4-43c1-3f1e-8bd3-3e068f595c70",
                                "text": "„Und Marianne Schreiner hat geschimpft: ‚Gell, da habts ihr euch wieder eine Pfarrköchin vorgestellt, so eine mit Gretlfrisur und fromm geschlossenen Augen.‘“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
